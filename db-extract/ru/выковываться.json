                "senses": [
                    {
                        "sense_id": "07aee457-c8e0-3e90-8fdd-2ce731a9bb6a",
                        "entry_id": "b33f6d02-aff2-3003-abbd-457627fad177",
                        "glosses": [
                            "страд. к выковывать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "66a6ebf9-687b-4669-a7f7-215ec2ce58c6",
                                "sense_id": "07aee457-c8e0-3e90-8fdd-2ce731a9bb6a",
                                "text": "Тогда, значит, разум, совесть, добро, гуманность — всё, всё, что выковывалось тысячелетиями и считалось целью существования человечества, ровно ничего не стоит."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb63cb13-da97-47e2-af83-d186d454d6db",
                        "source_entry_id": "b33f6d02-aff2-3003-abbd-457627fad177",
                        "source_sense_id": "07aee457-c8e0-3e90-8fdd-2ce731a9bb6a",
                        "target_lang_word": "forge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb3284fb-ba2e-37f4-9719-62594b998ec7",
                                        "entry_id": "6bea0392-226d-347c-bd7f-2db5eaa97a03",
                                        "glosses": [
                                            "A furnace or hearth where metals are heated prior to hammering them into shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aea5286-2427-43a6-8ee0-7a7bded13c98",
                                                "sense_id": "bb3284fb-ba2e-37f4-9719-62594b998ec7",
                                                "text": "Close to the hump-backed bridge on the lane leading into the Hambleden Valley is a mid-19th-century smithy, its inside walls hung with tools of the blacksmith's trade, though decorative wrought-ironwork is now the main product from its glowing forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44561f79-8664-35ae-bc5f-013ae0984c36",
                                        "entry_id": "6bea0392-226d-347c-bd7f-2db5eaa97a03",
                                        "glosses": [
                                            "A workshop in which metals are shaped by heating and hammering them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee4e20dc-33bb-340a-9064-095cfe6f92ef",
                                        "entry_id": "6bea0392-226d-347c-bd7f-2db5eaa97a03",
                                        "glosses": [
                                            "The act of beating or working iron or steel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99eeb329-31de-4506-b673-35ab77ee5103",
                                                "sense_id": "ee4e20dc-33bb-340a-9064-095cfe6f92ef",
                                                "text": "In the greater bodies the forge was easy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d369ab-3d50-30f3-8b8e-ebe7b90b34b0",
                                        "entry_id": "6bea0392-226d-347c-bd7f-2db5eaa97a03",
                                        "glosses": [
                                            "A web-based collaborative platform for developing and sharing software."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d30824-3e22-4ab1-bed7-cce8aced9f70",
                                                "sense_id": "72d369ab-3d50-30f3-8b8e-ebe7b90b34b0",
                                                "text": "If the project uses a forge like GitLab, GitHub, or BitBucket, it can be very easy to search all past commit logs […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f8e29f-41ef-3000-914d-66660b864479",
                                        "entry_id": "a0506554-ff18-3123-a560-2edfed2dd842",
                                        "glosses": [
                                            "To shape a metal by heating and hammering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af181741-e424-4e98-819e-472a5c473120",
                                                "sense_id": "f9f8e29f-41ef-3000-914d-66660b864479",
                                                "text": "On Mars's armor forged for proof eterne"
                                            },
                                            {
                                                "example_id": "2c644201-6312-46cb-b819-6c08052e31da",
                                                "sense_id": "f9f8e29f-41ef-3000-914d-66660b864479",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89b10b4-99c8-3952-9139-f4df013fc88b",
                                        "entry_id": "a0506554-ff18-3123-a560-2edfed2dd842",
                                        "glosses": [
                                            "To form or create with concerted effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5356ca5b-ef05-4de9-90a8-80c04aee3b8c",
                                                "sense_id": "c89b10b4-99c8-3952-9139-f4df013fc88b",
                                                "text": "The politician's recent actions are an effort to forge a relationship with undecided voters."
                                            },
                                            {
                                                "example_id": "eb6b277e-a442-4b97-9aa2-984a1bf55dac",
                                                "sense_id": "c89b10b4-99c8-3952-9139-f4df013fc88b",
                                                "text": "Those names that the schools forged, and put into the mouth of scholars, could never get admittance into common use."
                                            },
                                            {
                                                "example_id": "95627931-4eed-414b-8dd9-32d10a821192",
                                                "sense_id": "c89b10b4-99c8-3952-9139-f4df013fc88b",
                                                "text": "O purblind race of miserable men, / How many among us at this very hour / Do forge a life-long trouble for ourselves. / By taking true for false, or false for true."
                                            },
                                            {
                                                "example_id": "ca393771-7a73-4bb5-8c23-1482bbdf9ffb",
                                                "sense_id": "c89b10b4-99c8-3952-9139-f4df013fc88b",
                                                "text": "In The Last Guardian, a kidnapped boy forges an uneasy relationship with a frightening beast in order to survive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "999f0466-976b-3504-91f4-75ebdaac7117",
                                        "entry_id": "a0506554-ff18-3123-a560-2edfed2dd842",
                                        "glosses": [
                                            "To create a forgery of; to make a counterfeit item of; to copy or imitate unlawfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d7b00c-9d6c-44d2-9591-8f2b49a09f1a",
                                                "sense_id": "999f0466-976b-3504-91f4-75ebdaac7117",
                                                "text": "He had to forge his ex-wife's signature.  The jury learned the documents had been forged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7894eebb-c384-3487-8f7d-9c4541b95d54",
                                        "entry_id": "a0506554-ff18-3123-a560-2edfed2dd842",
                                        "glosses": [
                                            "To make falsely; to produce, as that which is untrue or not genuine; to fabricate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6d23a8-95de-443b-b20a-82b971d3980e",
                                                "sense_id": "7894eebb-c384-3487-8f7d-9c4541b95d54",
                                                "text": "That paltry story is untrue, / And forged to cheat such gulls as you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc9e759e-85d4-3eb0-b04b-07873fc46e2e",
                                        "entry_id": "4646c730-c242-31c5-9c1b-5b9b77da41db",
                                        "glosses": [
                                            "To move forward heavily and slowly (originally as a ship); to advance gradually but steadily; to proceed towards a goal in the face of resistance or difficulty."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a881b0b-9516-4a5d-ac28-5c515cc490a8",
                                                "sense_id": "cc9e759e-85d4-3eb0-b04b-07873fc46e2e",
                                                "text": "The party of explorers forged through the thick underbrush."
                                            },
                                            {
                                                "example_id": "3f338608-bdf7-433f-a2a5-10f0ae663671",
                                                "sense_id": "cc9e759e-85d4-3eb0-b04b-07873fc46e2e",
                                                "text": "We decided to forge ahead with our plans even though our biggest underwriter backed out."
                                            },
                                            {
                                                "example_id": "3b3cff5a-a52f-44b5-aecd-15f88bec941a",
                                                "sense_id": "cc9e759e-85d4-3eb0-b04b-07873fc46e2e",
                                                "text": "And off she [a ship] forged without a shock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec482d89-4d82-3bbe-b8f6-2d03ab1e4094",
                                        "entry_id": "4646c730-c242-31c5-9c1b-5b9b77da41db",
                                        "glosses": [
                                            "To advance, move or act with an abrupt increase in speed or energy."
                                        ],
                                        "tags": [
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594e89bb-ca37-480a-b871-4d825f4d0c42",
                                                "sense_id": "ec482d89-4d82-3bbe-b8f6-2d03ab1e4094",
                                                "text": "With seconds left in the race, the runner forged into first place."
                                            },
                                            {
                                                "example_id": "32919edf-b7f3-4d4d-a8ee-138842cd1d44",
                                                "sense_id": "ec482d89-4d82-3bbe-b8f6-2d03ab1e4094",
                                                "text": "Let's forge past that runner on the inside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1cd219f-212a-4a5a-b0b5-98fd582fdad0",
                        "source_entry_id": "b33f6d02-aff2-3003-abbd-457627fad177",
                        "source_sense_id": "07aee457-c8e0-3e90-8fdd-2ce731a9bb6a",
                        "target_lang_word": "to be forged",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09702bfb-a943-4156-99d4-2f5d7e57815f",
                        "source_entry_id": "b33f6d02-aff2-3003-abbd-457627fad177",
                        "source_sense_id": "07aee457-c8e0-3e90-8fdd-2ce731a9bb6a",
                        "target_lang_word": "hammer out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hammer out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf8aa66-b35a-3f54-918b-f89891c4336c",
                                        "entry_id": "3d6f9601-64e8-344f-a3a8-e6f7e3d170f0",
                                        "glosses": [
                                            "To come to (a difficult agreement or settlement) after much arguing and conflict."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cecf3a3-9325-4b3a-934b-c6fd32e7c70a",
                                                "sense_id": "7bf8aa66-b35a-3f54-918b-f89891c4336c",
                                                "text": "Two years after the flood, my lawyer managed to hammer out a settlement with my insurance company over the damages."
                                            },
                                            {
                                                "example_id": "0cbe0e66-daf8-4aec-ac12-054027d9f74a",
                                                "sense_id": "7bf8aa66-b35a-3f54-918b-f89891c4336c",
                                                "text": "In New York City, property owners seeking to rebound from the storm will have to feel their way through a wilderness of new flood maps, revamped building codes and land-use ordinances, along with a host of other measures addressing the specific needs of storm-battered communities — all of which have yet to be hammered out and adopted."
                                            },
                                            {
                                                "example_id": "3c07451e-da54-4a9b-ac1d-61f5d0c19e97",
                                                "sense_id": "7bf8aa66-b35a-3f54-918b-f89891c4336c",
                                                "text": "Over the next week and a half, diplomats will have to hammer out rules around international carbon markets and figure out how to deliver on a still-unmet promise from more than a decade ago to deliver $100 billion annually by 2020 to help poor countries pivot away from fossil fuels and prepare for the impact of climate change."
                                            },
                                            {
                                                "example_id": "101d6609-1fb8-4309-bcd9-e6a2bd8e290f",
                                                "sense_id": "7bf8aa66-b35a-3f54-918b-f89891c4336c",
                                                "text": "He really doesn't know when to shut up and leave it to those at the heart of the negotiations, who fully understand and appreciate all the nuances, to try and hammer out a deal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db8c8c8d-5ff2-4fe3-95b1-5be5ebd2d390",
