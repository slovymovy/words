                "senses": [
                    {
                        "sense_id": "b64094ec-d4db-33b0-b84b-9a483814356c",
                        "entry_id": "700f812d-4dac-36c1-93d1-ffeb014ec8d0",
                        "glosses": [
                            "Jambe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "68328fae-e1fc-4e1a-b93f-e6c53a557cd3",
                                "sense_id": "b64094ec-d4db-33b0-b84b-9a483814356c",
                                "text": "Je croyais qu’elle plaisantait, mais je la vis soudain ouvrir la fenêtre, sortir sur le balcon et passer une guibole par-dessus la barrière."
                            },
                            {
                                "example_id": "edd89e62-6178-4f4b-9dcc-52da010eb26d",
                                "sense_id": "b64094ec-d4db-33b0-b84b-9a483814356c",
                                "text": "– Triple andouille ! Le jour où un type meurt d’une décharge de chevrotine dans la guibole, les cochons apprendront à voler."
                            },
                            {
                                "example_id": "c681c996-10c1-46f8-afbc-696e0539125b",
                                "sense_id": "b64094ec-d4db-33b0-b84b-9a483814356c",
                                "text": "Ma guibole se consolide, mais je boiterai pendant longtemps. Il y a eu dans l’articulation des désordres très graves. Quant à la fracture du péroné, c’est une bagatelle."
                            }
                        ]
                    }
                ],
