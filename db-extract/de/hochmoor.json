                            "singular"
                        ],
                        "form": "das Hochmoor"
                    },
                    {
                        "form_id": "cb0feb39-a3be-4b0a-88a8-c9f099b2bf14",
                        "entry_id": "a2e3f042-3d98-35df-921f-e1874d3d2b36",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hochmoore"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                        "entry_id": "a2e3f042-3d98-35df-921f-e1874d3d2b36",
                        "glosses": [
                            "nährstoffarmes, saures Moor, das ausschließlich aus Niederschlägen und durch aus der Luft eingetragene Nährstoffe genährt wird"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "4cb64ccb-06f7-44d7-81c0-217b80758b7d",
                                "sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                                "text": "„Hochmoore sind durch Torfabbau und Nährstoffeinträge aus der Umgebung (Landwirtschaft, Industrie) stark gefährdet. … Die letzten großen Hochmoorgebiete befinden sich in Westsibirien und Kanada.“"
                            },
                            {
                                "example_id": "537b8e75-fd23-43ea-8682-25dde5b23031",
                                "sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                                "text": "„Die Tierwelt wilder Hochmoore ist besonders arten- und auch individuenarm; Regenwürmer, Egel, Muschelkrebse, Asseln, Eintagsfliegen, Weichtiere, Fische und Lurche fehlen meist. Reich vertreten sind dagen die beschalten Amöben, die Bauchhaarlinge und Libellen“."
                            },
                            {
                                "example_id": "1c528c17-0e30-48be-bfd7-eb2f99c28836",
                                "sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                                "text": "„Die Verstorbenen endeten in jenen gewaltigen Hochmooren, die sich vor 2000 Jahren im germanischen Hinterland an der Nordseeküste erstreckten.“"
                            },
                            {
                                "example_id": "202bfa7e-a7c3-4595-bb67-ef6a2dd09fb0",
                                "sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                                "text": "„Man unterscheidet die flachen meist nährstoffreichen Niedermoore, in denen verschiedene Laubmoose, vor allem aber Seggen und Binsen wachsen, und die und die nährstoffarmen, in der Mitte uhrglasartig aufgewölbten Hochmoore, auf denen vor allem Torfmoose gedeihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d4e336-efdf-457f-852d-81e49ea0223a",
                        "source_entry_id": "a2e3f042-3d98-35df-921f-e1874d3d2b36",
                        "source_sense_id": "823c8e00-95ef-34b5-8207-22d0932b38bd",
                        "source_sense_description": "Moor, das ausschließlich aus Niederschlägen und durch aus der Luft eingetragene Nährstoffe genährt wird",
                        "target_lang_word": "moor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16adb73e-82b5-3372-8d30-b6ea7af80548",
                                        "entry_id": "158475b2-fb51-3fea-a711-8d4f8c02b8b9",
                                        "glosses": [
                                            "An extensive waste covered with patches of heath, and having a poor, light (and usually acidic) soil, but sometimes marshy, and abounding in peat; a heath. (Compare bog, peatland, marsh, swamp, fen.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30a2270-9abb-4763-aaea-d941f6892508",
                                                "sense_id": "16adb73e-82b5-3372-8d30-b6ea7af80548",
                                                "text": "A cold, biting wind blew across the moor, and the travellers hastened their step."
                                            },
                                            {
                                                "example_id": "027f8fe0-72f2-4fd8-831b-291ace218a24",
                                                "sense_id": "16adb73e-82b5-3372-8d30-b6ea7af80548",
                                                "text": "In her girlish age, she kept sheep on the moor."
                                            },
                                            {
                                                "example_id": "c96aa813-4514-4317-8e2f-cf74a23dad9b",
                                                "sense_id": "16adb73e-82b5-3372-8d30-b6ea7af80548",
                                                "text": "the ruins yet resting in the wild moors"
                                            },
                                            {
                                                "example_id": "1e4298a5-080c-4cf5-9a6b-f7c5817a8ffd",
                                                "sense_id": "16adb73e-82b5-3372-8d30-b6ea7af80548",
                                                "text": "And now, without a word of warning from the Ghost, they stood upon a bleak and desert moor, where monstrous masses of rude stone were cast about, as though it were the burial-place of giants; and water spread itself wheresoever it listed, or would have done so, but for the frost that held it prisoner; and nothing grew but moss and furze, and coarse rank grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319263a1-b5d4-32df-84b2-a0f7a001be25",
                                        "entry_id": "158475b2-fb51-3fea-a711-8d4f8c02b8b9",
                                        "glosses": [
                                            "A game preserve consisting of moorland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "moor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed86d486-d24b-3b9b-a2f0-ca276e514be6",
                                        "entry_id": "d185793e-512e-3be6-b5e3-3490d41d7f6a",
                                        "glosses": [
                                            "To cast anchor or become fastened."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54fb8268-ba4b-4551-9a4f-14411d41a881",
                                                "sense_id": "ed86d486-d24b-3b9b-a2f0-ca276e514be6",
                                                "text": "The vessel moored in the stream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d489cb55-5e38-3d42-9720-3e0a78905aaa",
                                        "entry_id": "d185793e-512e-3be6-b5e3-3490d41d7f6a",
                                        "glosses": [
                                            "To fix or secure (e.g. a vessel) in a particular place by casting anchor, or by fastening with ropes, cables or chains or the like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b96907-cc44-4cea-971c-4d05dee26084",
                                                "sense_id": "d489cb55-5e38-3d42-9720-3e0a78905aaa",
                                                "text": "They moored the boat to the wharf."
                                            },
                                            {
                                                "example_id": "66c898bd-9efd-4006-80a8-5a54f2d11b9d",
                                                "sense_id": "d489cb55-5e38-3d42-9720-3e0a78905aaa",
                                                "text": "His thought is tied, the curving prow\nOf motion moored to rock;\nAnd minutes burst upon a brow\nInsentient to shock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f96558e-f91e-3b08-a277-d8ee94e23508",
                                        "entry_id": "d185793e-512e-3be6-b5e3-3490d41d7f6a",
                                        "glosses": [
                                            "To secure or fix firmly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
