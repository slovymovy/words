                        ],
                        "examples": [
                            {
                                "example_id": "48f7ef1e-282f-4934-bd89-48fe6386b960",
                                "sense_id": "ac3b7e18-2ab7-3044-a947-83f067489c77",
                                "text": "De ruimtesonde New Horizons is dinsdagochtend aangekomen in de buitenste regionen van ons zonnestelsel."
                            }
                        ]
                    },
                    {
                        "sense_id": "23451e07-1c38-3a73-a3c6-b0d540bc66b9",
                        "entry_id": "b12af699-e8ca-3f40-a3cf-370bf68cc371",
                        "glosses": [
                            "gebieden in het geestelijk leven"
                        ],
                        "tags": [
                            "figuratively",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b4ccfb03-925c-4ec9-b88a-21f82262a9dc",
                                "sense_id": "23451e07-1c38-3a73-a3c6-b0d540bc66b9",
                                "text": "Terwijl Trump zondag via Twitter zijn aanvallen op Justin Trudeau en de internationale handelsorde voortzette, probeerden de leiders van de G6 na het debacle in Quebec zondag en maandag de diplomatieke betrekkingen in normale regionen te houden."
                            },
                            {
                                "example_id": "ea2d7b47-fe17-4ba4-9a05-aa4a3ca4c187",
                                "sense_id": "23451e07-1c38-3a73-a3c6-b0d540bc66b9",
                                "text": "Het boek is spannend (die orkaan) en grappig (die drie jonge Amerikanen), origineel en typisch Woltz, en leert ons iets over opgroeien, in het bijzonder in het digitale tijdperk. Heeft Woltz dan een gouden ei gelegd, of is er meer aan de hand in de hoogste regionen van de kwaliteitsjeugdboeken?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b181e47-38e5-3898-a638-14043a2655f2",
                        "entry_id": "b12af699-e8ca-3f40-a3cf-370bf68cc371",
                        "glosses": [
                            "groepen of lagen in het sociale leven"
                        ],
                        "tags": [
                            "figuratively",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "19b8a25d-a62f-4f5e-9672-6b482329318d",
                                "sense_id": "5b181e47-38e5-3898-a638-14043a2655f2",
                                "text": "Het coronavirus circuleert wereldwijd ook in de hoogste regionen van de macht. Meerdere staatshoofden raakten besmet en een aantal van hen maakte de ziekte door."
                            },
                            {
                                "example_id": "54ad9efc-ce98-414d-90f6-7253cb6a9559",
                                "sense_id": "5b181e47-38e5-3898-a638-14043a2655f2",
                                "text": "In de onderste regionen van de eredivisie kan elk punt het verschil tussen eredivisie en eerste divisie betekenen."
                            }
                        ]
                    }
                ],
