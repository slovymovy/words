                                        "entry_id": "e6655626-2270-3341-b3bb-31f03e45feda",
                                        "glosses": [
                                            "The written account of a revelation of hidden things given by God to a chosen prophet."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2adaee81-ce77-45ed-9610-486401a0974a",
                                                "sense_id": "10a8db8c-51cf-3771-b558-aad201c7d424",
                                                "text": "Apocalypses of Adam and Abraham (Epiphanius) and of Elias (Jerome) are also mentioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd66c544-a5fb-3c9f-a10c-300b97a2eef8",
                                        "entry_id": "e6655626-2270-3341-b3bb-31f03e45feda",
                                        "glosses": [
                                            "Revelation (last book of the Bible, composed of twenty-two chapters, which narrates a vision of the end times)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf1315d-975e-431e-80ab-03c7023bed45",
                                                "sense_id": "cd66c544-a5fb-3c9f-a10c-300b97a2eef8",
                                                "text": "He's been reading the Apocalypse again, and doomscrolling social media content that fixates on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c09a529e-e69a-3f71-ab31-702b21a083cf",
                                        "entry_id": "e6655626-2270-3341-b3bb-31f03e45feda",
                                        "glosses": [
                                            "Armageddon: the destructive end of the world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a0bf9f-f6e7-43f6-9b0d-58234697ca4e",
                                                "sense_id": "c09a529e-e69a-3f71-ab31-702b21a083cf",
                                                "text": "They keep predicting that the Apocalypse is nigh, but I notice that they have books and supplies that they're trying to sell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
