                ],
                "senses": [
                    {
                        "sense_id": "679fbd0b-234f-3a88-af87-53c030fb8e1e",
                        "entry_id": "d7dc9384-7197-3a84-b725-bdbec2e9c5ef",
                        "glosses": [
                            "Dienstrangabzeichen auf den Schulterpartien einer Uniform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4544fc67-5396-4de2-8ccd-e079326be59b",
                                "sense_id": "679fbd0b-234f-3a88-af87-53c030fb8e1e",
                                "text": "„Den Offizieren wurden in den ersten Tagen die Achselstücke von den Schultern gerissen, das Volk wollte nicht einmal ihren Trägern wehe tun, es wollte das Symbol des Herrentums und des Kadavergehorsams zerstören, weil es mit sicherem Instinkt erkannte, daß in Symbolen Traditionen, Gefühle und Wünsche der herrschenden Klasse eingefangen sind.“"
                            },
                            {
                                "example_id": "28fe1fe3-eb3a-4f2f-bd42-838679dd00d0",
                                "sense_id": "679fbd0b-234f-3a88-af87-53c030fb8e1e",
                                "text": "„Und die hätten den Offizieren die Achselstücke von den Schultern gerissen.“"
                            },
                            {
                                "example_id": "4efde419-c9fb-4d50-ae8a-81914dee68fb",
                                "sense_id": "679fbd0b-234f-3a88-af87-53c030fb8e1e",
                                "text": "„Die Achselstücke fehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
