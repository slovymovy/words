                        ]
                    },
                    {
                        "translation_id": "98a90835-7a94-4df5-b38d-8baedfa44d33",
                        "source_entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "source_sense_id": "c5a21f3f-fa3a-348a-92a8-3ff2be46206b",
                        "target_lang_word": "decrease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decrease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ae5fc7-e491-38d8-b23e-28e32e038d28",
                                        "entry_id": "02f64d49-ae9b-342d-8a04-b8215471a345",
                                        "glosses": [
                                            "Of a quantity, to become smaller."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cc3c4ef-75bc-4f69-b495-7171a47a3692",
                                                "sense_id": "93ae5fc7-e491-38d8-b23e-28e32e038d28",
                                                "text": "The quality of our products has decreased since the main designer left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3b6e2a-6072-3e0f-a261-f30a13511c6c",
                                        "entry_id": "02f64d49-ae9b-342d-8a04-b8215471a345",
                                        "glosses": [
                                            "To make (a quantity) smaller."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c66aff-c3a4-4e9a-9c13-e6c078722d94",
                                                "sense_id": "9c3b6e2a-6072-3e0f-a261-f30a13511c6c",
                                                "text": "Let's decrease the volume a little so we can hear each other talking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decrease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a30b3972-089e-30e1-a765-204d35d3afcf",
                                        "entry_id": "8a0c5b42-152c-3875-8d08-8f8b53413812",
                                        "glosses": [
                                            "An amount by which a quantity decreases or is decreased."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07de2ef6-77b8-4e42-8908-05c33063c0c4",
                                                "sense_id": "a30b3972-089e-30e1-a765-204d35d3afcf",
                                                "text": "After six years of constant growth, the company reported a slight decrease in sales last year."
                                            },
                                            {
                                                "example_id": "99f82605-188c-4079-8f00-2b29cf3a3a61",
                                                "sense_id": "a30b3972-089e-30e1-a765-204d35d3afcf",
                                                "text": "One research team has recorded Baishui’s decrease at about 27 meters per year over the last 10 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf5a522-4256-3e0f-a0e9-e677700f9e54",
                                        "entry_id": "8a0c5b42-152c-3875-8d08-8f8b53413812",
                                        "glosses": [
                                            "A reduction in the number of stitches, usually accomplished by suspending the stitch to be decreased from another existing stitch or by knitting it together with another stitch. See Decrease (knitting)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
