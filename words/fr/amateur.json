{
    "word_family": [
        "amateurisme",
        "amateuriste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "922cf642-e2fd-30eb-8b61-5143cb9b52c3",
                    "sense_definition": "Personne qui a du goût ou de la passion pour quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon oncle est un grand <w>amateur</w> de vin et possède une très belle cave."
                        },
                        {
                            "text": "Ce festival de musique attire chaque année des <w>amateurs</w> venus du monde entier."
                        }
                    ],
                    "common_phrases": [
                        "grand amateur de",
                        "amateur de vin"
                    ]
                },
                {
                    "sense_id": "2d7b4c76-65bf-32f7-8cc7-75ff2fc4b93f",
                    "sense_definition": "Personne qui pratique une activité physique ou sportive pour son plaisir sans en tirer profit financier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette compétition de course à pied est réservée aux <w>amateurs</w> désireux de participer."
                        },
                        {
                            "text": "Même s'il s'entraîne tous les jours, il reste un simple <w>amateur</w> sans contrat officiel."
                        }
                    ],
                    "antonyms": [
                        "professionnel"
                    ],
                    "common_phrases": [
                        "réservé aux amateurs"
                    ]
                },
                {
                    "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                    "sense_definition": "Personne qui cultive un art ou une science pour son agrément sans être un spécialiste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce riche <w>amateur</w> de peinture collectionne des toiles modernes depuis plusieurs décennies."
                        },
                        {
                            "text": "Il a restauré ce vieux tableau en véritable <w>amateur</w> passionné d'antiquités."
                        }
                    ],
                    "synonyms": [
                        "dilettante"
                    ],
                    "common_phrases": [
                        "amateur d'art",
                        "amateur éclairé"
                    ]
                },
                {
                    "sense_id": "5db05bcd-1731-3f98-84f9-b00a605882d3",
                    "sense_definition": "Personne qui accomplit une tâche sans compétence technique ou avec peu de rigueur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réparation est mal faite, on voit tout de suite que c'est un travail d'<w>amateur</w>."
                        },
                        {
                            "text": "Il ne faut pas confier la gestion de cette entreprise à un <w>amateur</w> sans expérience."
                        }
                    ],
                    "common_phrases": [
                        "travail d'amateur",
                        "agir en amateur"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2cdc5bcc-9c7d-3706-9393-e312d744d984",
                    "sense_definition": "Qui pratique une activité sans en faire sa profession ou qui relève d'une pratique non professionnelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle joue dans une troupe de théâtre <w>amateur</w> tous les vendredis soirs."
                        },
                        {
                            "text": "Ce tournoi de tennis <w>amateur</w> réunit des joueurs de tous les âges."
                        }
                    ],
                    "antonyms": [
                        "professionnel"
                    ],
                    "common_phrases": [
                        "théâtre amateur",
                        "sport amateur"
                    ]
                },
                {
                    "sense_id": "5d1467ba-eedf-3482-8911-44d8ca49db75",
                    "sense_definition": "Qui manifeste un attachement ou un vif intérêt pour un domaine particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public <w>amateur</w> de musique classique a applaudi la performance du violoniste."
                        },
                        {
                            "text": "Très <w>amatrice</w> de bonne cuisine, elle essaie souvent de nouvelles recettes originales."
                        }
                    ],
                    "common_phrases": [
                        "public amateur"
                    ]
                }
            ]
        }
    ]
}