                "senses": [
                    {
                        "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                        "entry_id": "5a71b604-883f-326b-9058-a2706eed004b",
                        "glosses": [
                            "Any of a class of blood cells that play various roles in cell-mediated immunity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fcfda1d-050f-4241-9c68-ee007f6ce84c",
                                "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                                "text": "In disease of the spleen, especially Banti's disease or fibro-adenia of the spleen, the increase of leukocytes is absent or slight, with no relative lymphocytosis."
                            },
                            {
                                "example_id": "42fd31c4-ad31-4279-aa80-6df8d6f73d06",
                                "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                                "text": "Iberdomide, a cereblon modulator promoting degradation of the transcription factors Ikaros and Aiolos, which affect leukocyte development and autoimmunity, is being evaluated for the treatment of systemic lupus erythematosus (SLE)."
                            }
                        ]
                    }
                ],
