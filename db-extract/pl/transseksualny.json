                "senses": [
                    {
                        "sense_id": "f3100675-7fd1-3b22-855d-8fc99a68b9b6",
                        "entry_id": "bd5c20e4-cb5d-319d-926d-2f83c2ad99dd",
                        "glosses": [
                            "związany z transseksualizmem, dotyczący transseksualizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e7b98dd-0736-4e7b-a8e3-7ab6de4a7bd8",
                                "sense_id": "f3100675-7fd1-3b22-855d-8fc99a68b9b6",
                                "text": "Osoby transseksualne, oprócz pomocy medycznej, potrzebują wsparcia psychoterapeuty, gdyż nie potrafią na ogół poradzić sobie z bólem, jaki zadają im najbliżsi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c0842c8-0e16-4338-893a-87f59b15f2fd",
                        "source_entry_id": "bd5c20e4-cb5d-319d-926d-2f83c2ad99dd",
                        "source_sense_id": "f3100675-7fd1-3b22-855d-8fc99a68b9b6",
                        "target_lang_word": "transsexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transsexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af828636-4cce-3fa2-9a50-4c6430702bca",
                                        "entry_id": "7d598dbb-4829-3bf1-a5d5-bb325a9c17b5",
                                        "glosses": [
                                            "Of a person, having changed, or being in the process of changing, physical sex by undergoing medical treatment, such as hormone replacement therapy (HRT) and/or optionally sex reassignment surgery (SRS)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4de5094d-ebc7-3b63-88ca-47dc76057dff",
                                        "entry_id": "7d598dbb-4829-3bf1-a5d5-bb325a9c17b5",
                                        "glosses": [
                                            "Of or relating to such a change."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a64cc06-bca2-4fd8-a654-ef4c12f6bb43",
                                                "sense_id": "4de5094d-ebc7-3b63-88ca-47dc76057dff",
                                                "text": "\"'I'm in the process of going through surgery, a transsexual operation.'\" She [Sharon Davis] continued, \"He [my partner] said that made no difference to him. And when he said that, just like that, I just stopped crying. I was so happy.\" They've been together ever since."
                                            },
                                            {
                                                "example_id": "b4df67a0-45f1-4b50-99ec-ba6376d7d12e",
                                                "sense_id": "4de5094d-ebc7-3b63-88ca-47dc76057dff",
                                                "text": "Stormy […] […] returned from Morocco, where she'd had transsexual surgery."
                                            },
                                            {
                                                "example_id": "46208460-f074-4162-98c0-ad1bc801be32",
                                                "sense_id": "4de5094d-ebc7-3b63-88ca-47dc76057dff",
                                                "text": "Before the Iranian Revolution, transsexual treatments were tacitly allowed, but Molkara wanted a ruling that provided clerical legitimacy. After the Revolution, she met with Khomeini and got a fatwa or ruling that transsexual transition was permitted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transsexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                        "entry_id": "3f84e632-9fab-3d6f-9952-76c3e62e3511",
                                        "glosses": [
                                            "A transsexual person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a8c297-7224-407b-b5f5-8c00b049994b",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "Lesbians for Justice therefore appeals to the organizers of the Michigan Womyn's Music Festival to nullify its \"womyn-born-womyn only\" policy, and to allow the attendance of post-operative male-to-female transsexuals at all future festivals."
                                            },
                                            {
                                                "example_id": "06d54aad-62ce-4e5c-90be-ccfa818bc135",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "When a man is a woman trapped in a man's body, and has a little operation, he is a transsexual."
                                            },
                                            {
                                                "example_id": "7b3b31d7-7e85-463b-9439-6b8ec1f37664",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "He claimed that they had this wonderful and loving relationship in which the transsexual-to-be had felt that his suitor truly loved him the way he was and didn’t want him to have the surgery, […]"
                                            },
                                            {
                                                "example_id": "375fd3b2-1c73-440e-acdf-078c735e4b7c",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "Hundreds of women every year are taken completely by surprise when their husbands announce they want to undergo sex-change surgery — and the news is even more shocking when comes, as it often does, from a burly he-man who’d given no clue to his inner girl. ¶ But the signs are definitely there if your husband is dreaming of becoming a transsexual, says a new study by a top sexologist."
                                            },
                                            {
                                                "example_id": "ef9d586d-7b04-44b1-a78c-803082898845",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "He was wearing women’s clothes before he had the surgery; then, he actually became a transsexual, and they (amazingly) stayed together."
                                            },
                                            {
                                                "example_id": "e384f90d-d8b0-469f-b5f5-4348697dd816",
                                                "sense_id": "737834f8-a666-3a7e-9eae-5546db2d3b80",
                                                "text": "Being a transsexual is not something that can be ignored or suppressed forever. Unlike the fascinations of the cross dresser or the partially altered transgenderist, the absolute compulsion of classical transsexualism is a matter of life and death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6512b766-3ed0-4ee6-bd0f-5be95786e6ef",
                        "source_entry_id": "bd5c20e4-cb5d-319d-926d-2f83c2ad99dd",
                        "source_sense_id": "f3100675-7fd1-3b22-855d-8fc99a68b9b6",
