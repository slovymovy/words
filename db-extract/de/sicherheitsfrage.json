                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8904c4-33e3-47fc-8ca4-9d9efef49276",
                                "sense_id": "dac390ee-5401-36d8-aa85-2af41e417797",
                                "text": "„Ben Gurion war ein Autokrat, ein Pedant und geradezu besessen von Sicherheitsfragen; in seinem Tagebuch finden sich noch andere, geringfügige Probleme, die mit der systematischen Zerstörung Palästinas einhergingen.“"
                            },
                            {
                                "example_id": "399adbea-fae8-4723-a8a4-093deac406a7",
                                "sense_id": "dac390ee-5401-36d8-aa85-2af41e417797",
                                "text": "„Jeder Flug nach Kaliningrad führt zwangsläufig über Nato-Gebiet und ist für den russischen Präsidenten zu einer Sicherheitsfrage geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
