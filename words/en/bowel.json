{
    "word_family": [
        "disembowel",
        "bowelless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c1a7dd0-dd93-3fa1-980e-54d7a1e278f8",
                    "sense_definition": "The intestine or a part of it, especially the large intestine in humans.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained how a high-fiber diet helps maintain healthy <w>bowel</w> function.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, как диета с высоким содержанием клетчатки помогает поддерживать здоровую функцию <w>кишечника</w>."
                            }
                        },
                        {
                            "text": "He suffered from chronic <w>bowel</w> irritation and had to change his eating habits.",
                            "target_lang_translations": {
                                "ru": "Он страдал от хронического раздражения <w>кишечника</w> и был вынужден изменить свои пищевые привычки."
                            }
                        }
                    ],
                    "synonyms": [
                        "gut",
                        "intestine"
                    ],
                    "common_phrases": [
                        "bowel movement",
                        "irritable bowel syndrome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кишечник или его часть, особенно толстая кишка у человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишечник",
                                "target_lang_sense_clarification": "орган пищеварения в целом"
                            },
                            {
                                "target_lang_word": "кишка",
                                "target_lang_sense_clarification": "отдельная часть кишечника"
                            },
                            {
                                "target_lang_word": "толстая кишка",
                                "target_lang_sense_clarification": "конечный отдел пищеварительного тракта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc45078b-42ab-3e50-9738-10fe1d6eec6c",
                    "sense_definition": "The deep inner parts of something, such as the earth, a building, or a ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners descended deep into the <w>bowels</w> of the earth to extract coal.",
                            "target_lang_translations": {
                                "ru": "Шахтеры спустились глубоко в <w>недра</w> земли, чтобы добывать уголь."
                            }
                        },
                        {
                            "text": "Valuable historical documents were kept safe in the <w>bowels</w> of the ship.",
                            "target_lang_translations": {
                                "ru": "Ценные исторические документы хранились в безопасности в <w>трюме</w> корабля."
                            }
                        }
                    ],
                    "synonyms": [
                        "depths",
                        "interior",
                        "innards"
                    ],
                    "common_phrases": [
                        "bowels of the earth",
                        "bowels of the ship"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the plural form 'bowels' to describe deep interiors metaphorically."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокие внутренние части чего-либо, например, земли, здания или корабля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недра",
                                "target_lang_sense_clarification": "глубины земли или пространства"
                            },
                            {
                                "target_lang_word": "утроба",
                                "target_lang_sense_clarification": "глубокая внутренняя часть корабля или здания"
                            },
                            {
                                "target_lang_word": "внутренности",
                                "target_lang_sense_clarification": "внутренние помещения или механизмы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d708dce-3969-36cf-8d29-6443e054b6a5",
                    "sense_definition": "The internal organs of a person or animal; the entrails.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient warrior's spear pierced through the armor and spilled his <w>bowels</w> onto the ground.",
                            "target_lang_translations": {
                                "ru": "Копье древнего воина пробило доспехи, и его <w>кишки</w> вывалились на землю."
                            }
                        },
                        {
                            "text": "The butcher carefully removed the <w>bowels</w> of the animal before preparing the meat.",
                            "target_lang_translations": {
                                "ru": "Мясник аккуратно удалил <w>внутренности</w> животного перед приготовлением мяса."
                            }
                        }
                    ],
                    "synonyms": [
                        "entrails",
                        "guts",
                        "viscera"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренние органы человека или животного; внутренности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренности",
                                "target_lang_sense_clarification": "органы брюшной полости"
                            },
                            {
                                "target_lang_word": "кишки",
                                "target_lang_sense_clarification": "внутренние органы, извлекаемые при разделке"
                            },
                            {
                                "target_lang_word": "потроха",
                                "target_lang_sense_clarification": "внутренности животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28f0872a-8160-3e8e-8147-0a3e8bb241bc",
                    "sense_definition": "The seat of pity, mercy, or the gentler emotions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tyrant showed that he was a man of no <w>bowels</w>, refusing to spare the prisoners.",
                            "target_lang_translations": {
                                "ru": "Тиран показал, что он человек без <w>сердца</w>, отказавшись пощадить пленных."
                            }
                        },
                        {
                            "text": "She appealed to his <w>bowels</w> of compassion, begging him to help her family.",
                            "target_lang_translations": {
                                "ru": "Она взывала к его <w>милосердию</w>, умоляя помочь ее семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "compassion",
                        "pity",
                        "mercy"
                    ],
                    "common_phrases": [
                        "bowels of compassion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historically used to represent the source of compassion."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник жалости, милосердия или нежных чувств (устаревшее/архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сердце",
                                "target_lang_sense_clarification": "как средоточие чувств и жалости"
                            },
                            {
                                "target_lang_word": "утроба",
                                "target_lang_sense_clarification": "в архаичном значении источника милосердия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c387cca-3d8c-3539-9acf-dda79ed98455",
                    "sense_definition": "One's offspring or children.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not bear to see the suffering of his own <w>bowels</w>.",
                            "target_lang_translations": {
                                "ru": "Он не мог вынести страданий собственной <w>плоти и крови</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "offspring",
                        "progeny",
                        "children"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to refer to children as coming from one's body."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собственное потомство или дети (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоть и кровь",
                                "target_lang_sense_clarification": "собственные дети, потомство"
                            },
                            {
                                "target_lang_word": "чада",
                                "target_lang_sense_clarification": "дети, рожденные кем-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81a7e933-ed13-373e-9c44-5c7f7db01397",
                    "sense_definition": "To remove the entrails or intestines from; to <w>disembowel</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters would <w>bowel</w> the deer immediately after the kill to preserve the meat.",
                            "target_lang_translations": {
                                "ru": "Охотники <w>потрошили</w> оленя сразу после убийства, чтобы сохранить мясо."
                            }
                        },
                        {
                            "text": "In medieval times, some traitors were sentenced to be hanged, drawn, and <w>bowelled</w>.",
                            "target_lang_translations": {
                                "ru": "В средневековье некоторых предателей приговаривали к повешению, волочению и <w>выпусканию кишок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disembowel",
                        "eviscerate",
                        "gut"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verb form is rare and largely replaced by 'disembowel'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять внутренности или кишечник; потрошить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать кишки",
                                "target_lang_sense_clarification": "удалять внутренности"
                            },
                            {
                                "target_lang_word": "потрошить",
                                "target_lang_sense_clarification": "очищать тушу от внутренностей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}