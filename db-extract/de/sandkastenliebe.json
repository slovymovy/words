                        "glosses": [
                            "Mensch, den jemand als seine erste Liebe im Kindesalter (im Sandkasten) ansieht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dc7c5054-e797-4404-a529-c24a80be13e7",
                                "sense_id": "b5bc5095-e7aa-3714-b6db-b533c1b7c503",
                                "text": "„Die Sandkastenliebe führte das Paar am 15. August 1959 vor die Standesbeamten.“"
                            },
                            {
                                "example_id": "6a6b4f79-1ea3-427d-9551-3ef750a54b0b",
                                "sense_id": "b5bc5095-e7aa-3714-b6db-b533c1b7c503",
                                "text": "„Meldet er sich nur noch selten bei seiner Sandkastenliebe, so ist diese sauer.“"
                            }
                        ],
