    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c9bc8f8c-0297-3557-ac78-80874a932a43",
                "word": "codpiece",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "42f4628a-e083-4305-be0a-a2a698810837",
                        "entry_id": "c9bc8f8c-0297-3557-ac78-80874a932a43",
                        "tags": [
                            "plural"
                        ],
                        "form": "codpieces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c821ac68-0b11-394d-8778-4d64bbe24555",
                        "entry_id": "c9bc8f8c-0297-3557-ac78-80874a932a43",
                        "glosses": [
                            "A part of male dress in the 15th and 16th centuries, worn in front of the breeches to cover the male genitals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55bd6d9c-a2c9-42bd-b202-4950fe0bf74d",
                                "sense_id": "c821ac68-0b11-394d-8778-4d64bbe24555",
                                "text": ", Act III, Scene III, line 130.\nBorachio: Seest thou not, I say, what a deformed thief this fashion is, how giddily ’a turns about all the hot-bloods between fourteen and five-and-thirty, sometimes fashioning them like Pharaoh’s soldiers in the reechy painting, sometime like god Bel’s priests in the old church-window, sometime like the shaven Hercules in the smirch’d worm-eaten tapestry, where his codpiece seems as massy as his club?"
                            },
                            {
                                "example_id": "d47dd81e-cd12-4022-ac0d-76e767e71ef4",
                                "sense_id": "c821ac68-0b11-394d-8778-4d64bbe24555",
                                "text": "Once Francis lifts her hand. She pulls back, half-resisting, and for one moment it seems he intends to lay her little fingers upon his unspeakable codpiece."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d66558a-317a-31cb-95f0-0ee1e31aca10",
                        "entry_id": "c9bc8f8c-0297-3557-ac78-80874a932a43",
                        "glosses": [
                            "A conspicuous protection for the male genitals in a suit of plate armor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8b6910-ff04-4433-bf4f-9c1debe8abe7",
                                "sense_id": "2d66558a-317a-31cb-95f0-0ee1e31aca10",
                                "text": "On some suits were screwed large iron cod-pieces; these, according to tradition, were intended to prevent the ill consequences of those violent shocks received in charging, either in battle, or at a tournament. Same say, they were meant to contain sponges for receiving the water of knights, who in the heat of an engagement might not have any more convenient method of discharging it. But most probably, they were rather constructed in conformity to a reigning fashion in the make of the breeches of those times."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb3cae2e-9530-4efb-839d-f4b0f06bcb24",
                        "source_entry_id": "c9bc8f8c-0297-3557-ac78-80874a932a43",
                        "source_sense_description": "part of male dress to cover genitals",
                        "target_lang_word": "gulp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gulp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f4bc656-a6d6-36ce-9aee-9c620f79f6a4",
                                        "entry_id": "670a7b18-872f-36c2-9c27-0f99fa8b84fd",
                                        "glosses": [
                                            "een door een strook stof afgesloten opening aan de voorzijde van een broek van de man, bedoeld om het plassen te vergemakkelijken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28c79a29-2d8b-4bce-b3b7-eed55e9af562",
                                                "sense_id": "9f4bc656-a6d6-36ce-9aee-9c620f79f6a4",
                                                "text": "Je gulp staat open!"
                                            },
                                            {
                                                "example_id": "a14b4268-7f8f-40e2-a48c-b0288a026caa",
                                                "sense_id": "9f4bc656-a6d6-36ce-9aee-9c620f79f6a4",
                                                "text": "Daarna maakte ik gebruik van hun verbazing, schudde mijn hoofd en zei iets als dat die rechtse stoot niet veel voorstelde, draaide me snel om, sloeg mijn arm om Vleugelmoer heen, die net zijn gulp dichttrok, en leidde hem naar de uitgang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edefb745-1190-3c04-bfba-6fab51195178",
                                        "entry_id": "670a7b18-872f-36c2-9c27-0f99fa8b84fd",
                                        "glosses": [
                                            "een plotseling binnenkomende straal of golf water"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca77a4a-242e-466a-8ce1-9362c1461b3e",
                                                "sense_id": "edefb745-1190-3c04-bfba-6fab51195178",
                                                "text": "Als je een gulp zeewater inslikt is dat niet lekker, maar je gaat er niet dood van."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e936d3ab-8749-3a81-b43c-0c14a01d5499",
                                        "entry_id": "5d969a16-108c-32b0-872f-32a23de462bd",
                                        "glosses": [
