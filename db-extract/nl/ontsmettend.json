                            {
                                "example_id": "d93b86d1-ea08-4ecc-b03b-9e49b937b765",
                                "sense_id": "5698f41e-a1dc-3afc-8e86-5ec15c1818d7",
                                "text": "'Door de grote druk van steeds resistenter wordende bacteriën is er dringend nood aan nieuwe soorten antibiotica', stelt dokter Xiuwen Yan. Vanuit het DNA van de reuzenpanda konden de onderzoekers een artificiële variant van de molecule cathelicidin-AM maken, van waaruit nu nieuwe medicatie en ontsmettende middelen kunnen worden ontwikkeld."
                            },
                            {
                                "example_id": "debaf357-1c30-4261-bf16-f4aa7ca03c3a",
                                "sense_id": "5698f41e-a1dc-3afc-8e86-5ec15c1818d7",
                                "text": "Eucalyptusolie is heerlijk fris en heeft ontsmettende eigenschappen. Idee: druppel wat op het filter van de stofzuiger of op de bodem van de vuilnisbak."
                            }
                        ]
