                                "target_lang_sense_clarification": "past participle of to corrode"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rouillé",
                                "target_lang_sense_clarification": "participe passé du verbe rouiller"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5baa7a56-e5ad-3937-83a9-e6a53a5bfe01",
                    "sense_definition": "de gebiedende wijs van <w>verroesten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verroest</w> maar lekker in die oude schuur, ik koop wel een nieuwe fiets!",
                            "target_lang_translations": {
                                "en": "Just <w>rust</w> away in that old shed, I'll just buy a new bike!",
                                "fr": "<w>Rouille</w> donc tranquillement dans cette vieille grange, moi je m'achète un nouveau vélo !"
                            }
                        },
                        {
                            "text": "Laat dat gereedschap daar maar liggen en <w>verroest</w> samen met de rest van de troep.",
                            "target_lang_translations": {
                                "en": "Just leave those tools there and <w>rust</w> along with the rest of the junk.",
                                "fr": "Laisse ces outils là et <w>rouille</w> avec le reste du barda."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
