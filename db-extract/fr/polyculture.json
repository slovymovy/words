                "forms": [
                    {
                        "form_id": "671432c2-a7f6-4854-93d9-603ec9b42401",
                        "entry_id": "a1abfc50-f01b-3e10-a135-ad3fcc05ffbe",
                        "tags": [
                            "plural"
                        ],
                        "form": "polycultures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b79d214-dd25-344c-b969-e0edc185defa",
                        "entry_id": "a1abfc50-f01b-3e10-a135-ad3fcc05ffbe",
                        "glosses": [
                            "Fait de cultiver plusieurs espèces de plantes dans une même exploitation agricole ou une même région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3046286a-45d8-49c7-890b-c975602d3396",
                                "sense_id": "1b79d214-dd25-344c-b969-e0edc185defa",
                                "text": "La ferme a abandonné la polyculture traditionnelle pour se spécialiser dans les framboises."
                            },
                            {
                                "example_id": "1b731130-41e4-42d8-ae2a-38bf129c846c",
                                "sense_id": "1b79d214-dd25-344c-b969-e0edc185defa",
                                "text": "La polyculture est le fait de cultiver plusieurs espèces végétales de famille différente au sein d’un même espace, c’est l'inverse de la monoculture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb3c5f1f-b339-409a-8253-812a5b0b8b49",
                        "source_entry_id": "a1abfc50-f01b-3e10-a135-ad3fcc05ffbe",
                        "source_sense_id": "1b79d214-dd25-344c-b969-e0edc185defa",
                        "target_lang_word": "polyculture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyculture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59b80c95-5197-36a4-8eb5-c80aa7e33298",
                                        "entry_id": "ac7327bc-f9ec-39b0-92fa-b7c19cb4bcb9",
                                        "glosses": [
                                            "The planting of two or more crops in the same place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea5700c8-bee1-3876-a16e-a7ff2b0a8907",
                                        "entry_id": "ac7327bc-f9ec-39b0-92fa-b7c19cb4bcb9",
                                        "glosses": [
                                            "A multiculture; a polycultural society, sometimes especially one in which multiple cultures exist without one dominating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d113f96a-228d-47c5-a2a9-f3d1458548ba",
                                                "sense_id": "ea5700c8-bee1-3876-a16e-a7ff2b0a8907",
                                                "text": "What we have here is not a 'multiculture' as it is represented in multiculturalism, not a pluralist order of discrete patches of culture, all somehow, 'equally valid' within the polity, but—to form a Greek/Roman Creole—a polyculture, or at any rate a collection of cultural entities that are not (a) discrete and complete in themselves; (b) that are not in any sense 'intrinsically' 'equal'; and (c) are active together and hence bound up with change."
                                            },
                                            {
                                                "example_id": "03c29328-57c8-443c-9143-b04c01cb84c2",
                                                "sense_id": "ea5700c8-bee1-3876-a16e-a7ff2b0a8907",
                                                "text": "Marsdsen, R. (1993) 'Global Monoculture, Multiculture and Polyculture', Social Research 60 (3): 493–523."
                                            },
                                            {
                                                "example_id": "4b767441-d0d4-461a-9e09-47e75408c5b2",
                                                "sense_id": "ea5700c8-bee1-3876-a16e-a7ff2b0a8907",
                                                "text": "Finally, but equal in importance, this book aims to engage with the ongoing dialogue among scholars of race and ethnicity in America, specifically regarding conversations on the issues of multiculture, polyculture, and the persistence of race."
                                            },
                                            {
                                                "example_id": "5264daaa-f5cf-40b1-92ea-edd8d6063e53",
                                                "sense_id": "ea5700c8-bee1-3876-a16e-a7ff2b0a8907",
                                                "text": "Europe/the EU's internal collective group identity is polycultural and not yet multicultural as per its “United in Diversity” motto. The concept of polyculture is a borrowed term from the discipline of agriculture. […] This paper adds a third definition to these two definitions by proposing to include the dominant culture within the fold of the polyculture to make it a multicultural society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
