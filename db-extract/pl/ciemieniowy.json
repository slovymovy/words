                "senses": [
                    {
                        "sense_id": "c8046903-7b2d-3b96-9c74-b711d88e0580",
                        "entry_id": "9a3ab602-4fea-31d1-8aad-437892356137",
                        "glosses": [
                            "związany z okolicą czaszki, otaczającej jej szczyt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b9a764-ec82-4844-b7d1-cc3f332fe8d9",
                                "sense_id": "c8046903-7b2d-3b96-9c74-b711d88e0580",
                                "text": "Pszczoła posiada oczy dwojakiego rodzaju. Są to (…) oczy złożone, umieszczone po bokach głowy, następnie zaś oczka proste, znajdujące się w części ciemieniowej"
                            },
                            {
                                "example_id": "7ba7995e-5c08-4bf7-8d08-53212242c651",
                                "sense_id": "c8046903-7b2d-3b96-9c74-b711d88e0580",
                                "text": "Z mózgiem łączy się charakterystyczny dla jaszczurek narząd ciemieniowy, znajdujący się pod otworem ciemieniowym czaszki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
