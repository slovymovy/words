                "senses": [
                    {
                        "sense_id": "9f6991dc-a9fc-3a8f-a959-bd54c2d22fa2",
                        "entry_id": "f61b73ee-52a1-3d74-a448-7c81bd169981",
                        "glosses": [
                            "hek met verticale stangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4ef4f3-2fae-489b-9a5b-427b33a0eb57",
                                "sense_id": "9f6991dc-a9fc-3a8f-a959-bd54c2d22fa2",
                                "text": "Onmiddellijk erachter zat - veel solider - een ijzeren traliehek, dat met een Lipsslot was afgesloten."
                            },
                            {
                                "example_id": "7fb2481b-6282-47e0-a6ad-cbfc67e3d500",
                                "sense_id": "9f6991dc-a9fc-3a8f-a959-bd54c2d22fa2",
                                "text": "Maar eenrichtingsverkeer kan ook slecht uitpakken: de politieke partij Denk kreeg onlangs felle kritiek doordat ze media bij het Rotterdamse hoofdkantoor niet persoonlijk te woord wilden staan, maar slechts stilzwijgend opgerolde persberichten door een traliehek schoven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "538eb47e-0250-44e6-a6bc-17b267ba7d9f",
                        "source_entry_id": "f61b73ee-52a1-3d74-a448-7c81bd169981",
                        "source_sense_id": "9f6991dc-a9fc-3a8f-a959-bd54c2d22fa2",
