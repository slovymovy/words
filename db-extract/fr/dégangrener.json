                "senses": [
                    {
                        "sense_id": "c1e10dfa-c4bd-378d-830c-8a771f0c0991",
                        "entry_id": "064f1b24-3502-39c3-881d-556610901c8a",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère gangrené."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17ebae0-e28e-4b62-af00-c611dc2f32c8",
                                "sense_id": "c1e10dfa-c4bd-378d-830c-8a771f0c0991",
                                "text": "C’est par le travail que l’on arrivera à \"dégangrener\" cette situation."
                            },
                            {
                                "example_id": "58f7f1cc-e64d-4973-a09d-4cf0d754a7c7",
                                "sense_id": "c1e10dfa-c4bd-378d-830c-8a771f0c0991",
                                "text": "Et comment fait-on pour « dégangrener » notre ultime Défense Nationale sauf à remigrer sans vergogne ?"
                            },
                            {
                                "example_id": "31ed06d3-29b7-4287-ba10-3e3e97093314",
                                "sense_id": "c1e10dfa-c4bd-378d-830c-8a771f0c0991",
                                "text": "De manière générale cela fait bien longtemps qu’on exclut dans le management tout ce qui participe au stress négatif, mais certaines firmes ont bien du mal à se dégangrener…"
                            }
                        ]
                    }
