                        "glosses": [
                            "Halluciner de nouveau."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9487cb5c-96ce-4fab-82e1-6b47fbb19268",
                                "sense_id": "de272e1d-df30-3711-a3ef-a8e0a40b6107",
                                "text": "Puis on a re-halluciné quand elle nous a proposé de tenir une chronique qu’elle illustrerait de ses belles mains."
                            },
                            {
                                "example_id": "aec6de4d-816b-413c-9eae-a4e29efc5065",
                                "sense_id": "de272e1d-df30-3711-a3ef-a8e0a40b6107",
                                "text": "Il a re-halluciné quand il a vu la tronche de ma télé. Son âge surtout."
                            },
                            {
                                "example_id": "fa7f899d-e5fd-4b13-a6a3-6adeff12c1ff",
                                "sense_id": "de272e1d-df30-3711-a3ef-a8e0a40b6107",
                                "text": "la VF devrait nous aider à re-halluciner!"
                            },
                            {
                                "example_id": "71b58f34-2150-4564-abff-858badcd6d1e",
                                "sense_id": "de272e1d-df30-3711-a3ef-a8e0a40b6107",
                                "text": "et je me suis empressé de rentrer, et je n'arrive plus à dormir les stores ouverts de peur de re-halluciner et voir quelque chose passer derrière ma vitre et je dors avec ma lampe de chevet allumée"
                            }
                        ]
                    }
