                "senses": [
                    {
                        "sense_id": "ef263a93-559c-34db-ae41-aff6ab429a70",
                        "entry_id": "6e28d7bb-dcf2-313e-890c-38ab521f2ea7",
                        "glosses": [
                            "разбросать всё или многое (одно за другим)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dded3975-8424-4eea-bba6-fcc91248ae5f",
                                "sense_id": "ef263a93-559c-34db-ae41-aff6ab429a70",
                                "text": "Ну, поездил у теплых морей, поразбросал рублей и домой его потянуло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33963c62-2bf0-4a2b-8779-a77da49b1370",
                        "source_entry_id": "6e28d7bb-dcf2-313e-890c-38ab521f2ea7",
                        "source_sense_id": "ef263a93-559c-34db-ae41-aff6ab429a70",
