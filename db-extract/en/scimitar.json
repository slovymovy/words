                                                "sense_id": "ffc20532-d303-38dd-8405-4e1dc3895b5f",
                                                "text": "Je křivý jak turecká šavle."
                                            },
                                            {
                                                "example_id": "d9ee23bf-8ace-4302-9bf8-70c7623a1b31",
                                                "sense_id": "ffc20532-d303-38dd-8405-4e1dc3895b5f",
                                                "text": "Vytasil šavli a usekl mu hlavu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cc4f2d-7e25-33a6-9e8c-02a9d07dcc29",
                                        "entry_id": "30f4848c-2632-316a-85e1-5574303b9e84",
                                        "glosses": [
                                            "zvracení, proud zvratků"
                                        ],
