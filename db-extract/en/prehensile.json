                    {
                        "sense_id": "68b8fda9-14dd-317b-9007-225cd9b55ed0",
                        "entry_id": "b02aee66-b34f-36f1-b83d-690bbe838ac4",
                        "glosses": [
                            "Able to take hold of and clasp objects; adapted for grasping especially by wrapping around an object."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0972164-8c18-4a10-a4ca-2b8505ca3a56",
                                "sense_id": "68b8fda9-14dd-317b-9007-225cd9b55ed0",
                                "text": "Some monkeys have prehensile tails which they use to pick things up."
                            }
                        ]
                    }
                ],
                "translations": [
