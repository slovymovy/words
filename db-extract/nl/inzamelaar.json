                        "sense_id": "c958edd9-20bc-34a2-80d1-32511c9505ea",
                        "entry_id": "5463ad57-364a-39c6-8cd6-5f994b52c808",
                        "glosses": [
                            "persoon of bedrijf die afgedankte goederen inzamelt voor hergebruik"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef8c6b5-03c6-4794-910d-389d42336fc8",
                                "sense_id": "c958edd9-20bc-34a2-80d1-32511c9505ea",
                                "text": "Volgens directeur Marc Vooges van de inzamelaar gaat het niet om gelegenheidsdieven die een kledingstuk uit de container hengelen. \"Ze rijden heel bewust met een grote bestelbus langs containers en halen die dan leeg.\" De gestolen kleding wordt doorverkocht."
                            },
                            {
                                "example_id": "9168b580-5fca-489d-a250-05d346bc0c0e",
                                "sense_id": "c958edd9-20bc-34a2-80d1-32511c9505ea",
                                "text": "Een kleding-inzamelaar vermoedde dat er werd gestolen uit kledingcontainers in de gemeente. Hij verstopte een zender in een laars, die hij in een zak in de container legde."
                            }
                        ]
                    }
