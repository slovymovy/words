                    {
                        "translation_id": "8784b810-abd9-4ec5-81c2-829ce0a4c9de",
                        "source_entry_id": "20ce09ef-496b-37aa-add1-f0d9d61ded13",
                        "source_sense_id": "fef3fb1b-e505-3ec5-b5b6-f0f868d91eb2",
                        "source_sense_description": "ein schmerzlindernder und fiebersenkender Arzneistoff aus der Gruppe der Nichtopioid-Analgetika",
                        "target_lang_word": "парацетамол",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "парацетамол",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f60b02-33ca-3d27-ba54-0c1a69a463be",
                                        "entry_id": "cadbc5ce-5c1a-3aa5-8a44-f8d95551b83a",
                                        "glosses": [
                                            "фарм. обезболивающее и жаропонижающее лекарственное средство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825d70a0-e346-47d4-9cd0-b65f1c9a730a",
                                                "sense_id": "c6f60b02-33ca-3d27-ba54-0c1a69a463be",
                                                "text": "С наступлением холодов в аптеках резко вырос спрос на безрецептурные препараты, широко используемые для лечения гриппа и прочих ОРЗ (острых респираторных заболеваний), — в первую очередь, на парацетамол и аспирин."
                                            },
                                            {
                                                "example_id": "247b4e6c-2dc9-497c-8375-883ae01bad89",
                                                "sense_id": "c6f60b02-33ca-3d27-ba54-0c1a69a463be",
                                                "text": "Есть ли альтернатива анальгину и аспирину (когда они выступают в роли жаропонижающих)? К счастью, на этот вопрос можно ответить утвердительно. Альтернатива эта — всеми в мире признанный и везде применяемый парацетамол."
                                            },
                                            {
                                                "example_id": "7948715c-11ef-4c0b-b351-85e1f16261bc",
                                                "sense_id": "c6f60b02-33ca-3d27-ba54-0c1a69a463be",
                                                "text": "На ночь она выпила две таблетки парацетамола и пять аскорбинок — верное средство от простуды, которое давно ставило её на ноги. Так лечилась мама."
                                            },
                                            {
                                                "example_id": "1faea167-730a-45a6-b6f2-cd831fb600fa",
                                                "sense_id": "c6f60b02-33ca-3d27-ba54-0c1a69a463be",
                                                "text": "Петров сходил в ванную, чтобы остудить голову под струёй холодной воды, причём от этого жар только подступил к лицу, тогда он .. спросил, нет ли в доме аспирина или парацетамола."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
