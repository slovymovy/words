                        "examples": [
                            {
                                "example_id": "da1190ea-7f43-4091-a662-3a52e5ea5b45",
                                "sense_id": "c308a3fa-200a-314c-821d-681ca83cb690",
                                "text": "Dislère allait plus loin que Touchard : alors que ce dernier se bornait à condamner le cuirassage du réduit central au bénéfice d’un cuirassage limité à l’artillerie, Dislère condamnait le cuirassé d’escadre en bloc."
                            },
                            {
                                "example_id": "89fa6e75-edf5-4aa5-b2e4-235d743fb6db",
                                "sense_id": "c308a3fa-200a-314c-821d-681ca83cb690",
                                "text": "A la fin des années 1890, on passa à une phase supérieure en adjoignant des productions complémentaires: ateliers de réparations, d’armement et de cuirassage des navires de guerre."
                            }
                        ]
                    },
