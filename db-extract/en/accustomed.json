                        "target_lang_word": "accoutumé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accoutumé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fbe38e-57d3-30ed-8d8c-2987cbac03e9",
                                        "entry_id": "569ba7c7-effc-3706-822e-949e0f0fe4a0",
                                        "glosses": [
                                            "Habitué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4cd2cf7-ea41-468b-8ab5-db9441bcdc08",
                                                "sense_id": "f4fbe38e-57d3-30ed-8d8c-2987cbac03e9",
                                                "text": "[…] D’ailleurs, un État accoutumé à la liberté est plus aisément gouverné par ses propres citoyens que par d’autres."
                                            },
                                            {
                                                "example_id": "12af82cf-7279-42d2-a21a-54db2077fead",
                                                "sense_id": "f4fbe38e-57d3-30ed-8d8c-2987cbac03e9",
                                                "text": "— Et ce serait pour la seconde fois de la journée, cria M. de Sanréal, de l’air triomphant d’un sot peu accoutumé à être écouté et qui a un fait curieux à dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1520ab7-5dc8-3ce6-9016-cc335edc226a",
                                        "entry_id": "569ba7c7-effc-3706-822e-949e0f0fe4a0",
                                        "glosses": [
                                            "Habituel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d210360f-2943-4ac9-879a-9b4b1c9b8d88",
                                                "sense_id": "d1520ab7-5dc8-3ce6-9016-cc335edc226a",
                                                "text": "Il faut remarquer, cependant, que la mauvaise saison ne s’annonça pas avec sa rigueur accoutumée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
