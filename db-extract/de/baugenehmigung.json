                ],
                "senses": [
                    {
                        "sense_id": "050fd1c0-a261-332c-95c1-20dd7260b01d",
                        "entry_id": "a3bdf5cd-6318-3901-b04a-16d559ed2700",
                        "glosses": [
                            "Erlaubnis einer zuständigen Stelle, zu bauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ce1db9-6882-412b-a37c-029c88f17a54",
                                "sense_id": "050fd1c0-a261-332c-95c1-20dd7260b01d",
                                "text": "Auf die Erteilung einer Baugenehmigung muss man oft einige Zeit warten."
                            },
                            {
                                "example_id": "a2b87061-c982-4aca-8ed8-32c76fdbf3e1",
                                "sense_id": "050fd1c0-a261-332c-95c1-20dd7260b01d",
                                "text": "„Abends machten Mama und Papa eine Flasche Sekt auf, weil sie die Baugenehmigung gekriegt hatten.“"
                            },
                            {
                                "example_id": "57a73d98-72c0-466c-bc85-4d51b06e6b41",
                                "sense_id": "050fd1c0-a261-332c-95c1-20dd7260b01d",
                                "text": "„Die Wogen glätten sich, denn zunächst einmal muss man eine Baugenehmigung einreichen.“"
                            },
                            {
                                "example_id": "b84093ba-fb04-4232-9902-edde773f83c6",
                                "sense_id": "050fd1c0-a261-332c-95c1-20dd7260b01d",
                                "text": "„Gestern hat er einen Anruf bekommen: Seiner Werkstatt fehle die Baugenehmigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
