                "senses": [
                    {
                        "sense_id": "eff6ea9d-4935-350e-bbf7-e63dc027667c",
                        "entry_id": "c2b894d8-7713-32a8-a418-ffc123c4c5aa",
                        "glosses": [
                            "gegenseitige Verpflichtungen eingehende (natürliche oder juristische) Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b3ea72-d470-407f-bed4-55c1f2bf1d43",
                                "sense_id": "eff6ea9d-4935-350e-bbf7-e63dc027667c",
                                "text": "„Nach ständiger Rechtsprechung ist der als Vertragserrichter mehrerer Vertragspartner einschreitende Rechtsanwalt allen Vertragspartnern gegenüber zur sorgfältigen Wahrung ihrer Interessen verpflichtet.“"
                            },
                            {
                                "example_id": "455ba8e0-b0a0-41c7-9121-9cb888d8bd49",
                                "sense_id": "eff6ea9d-4935-350e-bbf7-e63dc027667c",
                                "text": "„Wieland ist Professor an der Universität Erfurt, berufen vom Kurfürsten von Mainz, und der ist eben nicht nur Vertragspartner, sondern Landesherr, und Wieland ist nicht nur sein Angestellter, sondern sein Untertan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
