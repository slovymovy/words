                                "ru": "Я всегда <w>разогреваю</w> вчерашний суп на обед.",
                                "nl": "Ik <w>warm</w> de soep van gisteren altijd <w>op</w> voor de lunch.",
                                "de": "Ich <w>wärme</w> die Suppe von gestern zum Mittagessen immer <w>auf</w>.",
                                "fr": "Je <w>réchauffe</w> toujours la soupe d'hier pour le déjeuner.",
                                "it": "Per pranzo <w>scaldo</w> sempre la zuppa di ieri.",
                                "cs": "Vždycky si k obědu <w>ohřívám</w> včerejší polévku.",
                                "tr": "Öğle yemeği için dünkü çorbayı her zaman <w>ısıtırım</w>.",
                                "es": "Siempre <w>caliento</w> la sopa de ayer para el almuerzo.",
                                "zh": "我午饭总是把昨天的汤<w>热</w>一下喝。"
                            }
                        },
