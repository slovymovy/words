                        "entry_id": "78f62698-8821-314b-afee-9f27440cc394",
                        "glosses": [
                            "Science humaine visant à définir le but de l'art et son fonctionnement."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "06c9d95a-d42f-497d-99de-c326b741ff84",
                                "sense_id": "7c93b9dc-12e0-3d15-9120-e32d9617d847",
                                "text": "Le rôle de l’« artologie » est de tenter de définir ce but ainsi que les lois, s’il y en a, du fonctionnement du phénomène art."
                            },
                            {
                                "example_id": "8502ab7a-7fe8-4575-9043-1b2a9ba19ee8",
                                "sense_id": "7c93b9dc-12e0-3d15-9120-e32d9617d847",
                                "text": "Le dernier chapitre de son essai pose les bases et les méthodes de recherche pour la création de l’« artologie »."
                            }
                        ]
                    }
