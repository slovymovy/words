                ],
                "senses": [
                    {
                        "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "glosses": [
                            "Rustic, pastoral, country-styled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3ff309-99c7-41a2-9ef6-09970c0dd6d5",
                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                "text": "The countryside was filled with charming, bucolic scenery, complete with rolling hills, fields of wildflowers, and quaint farmhouses."
                            },
                            {
                                "example_id": "7791ed6d-25d1-4db1-8ee5-de1421aff551",
                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                "text": "A couple of years later the Metropolitan had reached its own most northerly point, Verney Junction, which was as bucolic as it sounds."
                            },
                            {
                                "example_id": "9bdc0aab-50f1-48a0-af19-3b5123e7a2c0",
                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                "text": "Before the area was a tech epicenter, it was a bucolic land of fruit orchards."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "glosses": [
                            "Relating to the pleasant aspects of rustic country life."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6554485-b33b-4869-adb2-8290bc1b470a",
                                "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                                "text": "The cozy bed and breakfast was located in a picturesque, bucolic setting, offering guests a chance to escape the city and enjoy the simple pleasures of the countryside."
                            },
                            {
                                "example_id": "a91f797b-74cc-4426-9b49-f707965fb301",
                                "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                                "text": "In a sense, Mr. Maillier is living the classic French dream – working the land in the bucolic countryside, feeding his children good food, and keeping France’s gastronomic heritage alive."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "glosses": [
                            "Pertaining to herdsmen or peasants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0cab98b-aa6c-42de-b3e8-9d94a1a365be",
                                "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                                "text": "Their traditional clothing and simple way of life reflected their bucolic roots as a community of shepherds and farmers."
                            },
                            {
                                "example_id": "124b211a-a258-4369-ba5d-1bb52a23f4f5",
                                "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                                "text": "Here we consider a bucolic example."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74110511-c09f-4120-8d13-edb364ef5e71",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "rustic, pastoral, country-styled",
                        "target_lang_word": "rustiek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1cce22b1-7c5e-363d-a763-8956d7a1c07e",
                                        "entry_id": "d6b904c3-c989-3f19-9c9a-0286ecc4f9c3",
                                        "glosses": [
                                            "betrekking hebbend op het platteland buiten de stad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338f8232-9c06-430f-8928-33dccc1d9991",
                                                "sense_id": "1cce22b1-7c5e-363d-a763-8956d7a1c07e",
                                                "text": "Hoe het landgoed Irma heeft doorstaan, is nog niet geweten. Wel heeft de Franse minister van Binnenlandse Zaken Gérard Collomb donderdag gezegd dat de meest solide gebouwen op het Frans-Nederlandse eiland verwoest zijn. Meer rustieke structuren zijn waarschijnlijk helemaal of gedeeltelijk verwoest."
                                            },
                                            {
                                                "example_id": "d04d4b1b-830f-4e27-ad03-c1b35ce126af",
                                                "sense_id": "1cce22b1-7c5e-363d-a763-8956d7a1c07e",
                                                "text": "Architectenbureau Theo Verburg uit Ede tekende voor het nieuwe gebouw van het crematorium. Qua vorm komen de vijvers rondom erin terug. Vanuit de grote zaal van het crematorium lijkt het centrale looppad door te lopen in een rustiek boslaantje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "275735e4-93ad-4201-9816-2929dc57ab9e",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "rustic, pastoral, country-styled",
                        "target_lang_word": "landelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                        "entry_id": "e64781c1-8cd6-3d35-80dc-bc083b670303",
                                        "glosses": [
                                            "met betrekking tot of geldend voor het hele land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a40a3a-3fce-4e55-bf69-3e8bb7bcf707",
                                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                                "text": "De gemeentelijke verkiezingen worden overschaduwd door de landelijke politiek."
                                            },
                                            {
                                                "example_id": "9c50e952-cbf4-453d-978c-6179acef93c0",
                                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                                "text": "De landelijke museumdag trok veel bezoekers."
                                            },
                                            {
                                                "example_id": "9e10a735-4bef-4c64-bb59-895a8368d226",
                                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                                "text": "'Duurzame mijlpaal': De rechter oordeelt dat de gemeente bevoegd is om zo'n verbod op te leggen en vindt de argumenten van Den Haag voldoende onderbouwd. Dat de bijdrage van het verbod op landelijk en wereldwijd niveau \"gering is\", doet daar niet aan af, aldus de rechter."
                                            },
                                            {
                                                "example_id": "1ff37b8e-1c57-4d2c-ac3b-07f37561572a",
                                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                                "text": "Vanaf 1971 was hij elf jaar landelijk politicus, waarvan negen jaar als leider van D66. Als het vleesgeworden redelijk alternatief gaf hij de partij na het vertrek van de flamboyante oprichter Hans van Mierlo een nieuw gezicht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2c3da91-ecfb-31db-b49f-8d9b0c2e97ff",
                                        "entry_id": "e64781c1-8cd6-3d35-80dc-bc083b670303",
                                        "glosses": [
                                            "met betrekking tot minder bevolkte, niet-stedelijke gebieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0603b527-dc2e-49db-8b22-2d8081837acf",
                                                "sense_id": "c2c3da91-ecfb-31db-b49f-8d9b0c2e97ff",
                                                "text": "Het aantal inwoners in een landelijke omgeving neemt gestaag af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23699282-b77c-46a2-87df-8e71469c4c6b",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "rustic, pastoral, country-styled",
                        "target_lang_word": "bucolisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bucolisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b1aea927-ced3-3167-b273-280a040c0744",
                                        "entry_id": "db71c130-7b31-3d8e-a475-9468b7d7d6dc",
                                        "glosses": [
                                            "betrekking hebbend op het land- en herdersleven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0ec83a-2fa6-4522-ac2b-1f2a481a85f4",
                                                "sense_id": "b1aea927-ced3-3167-b273-280a040c0744",
                                                "text": "Hij is een specialist op het gebied van bucolische poëzie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e557f983-208f-44d6-893f-e51923948f91",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "rustic, pastoral, country-styled",
                        "target_lang_word": "bucolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bucolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6962d462-8a6e-3de1-ba5e-4520f5c216ea",
                                        "entry_id": "8febaf34-7ea7-3ef7-a336-7a122c90ccdb",
                                        "glosses": [
                                            "Relatif à la poésie pastorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f6a574-3ef8-45ed-a594-d70391e65237",
                                                "sense_id": "6962d462-8a6e-3de1-ba5e-4520f5c216ea",
                                                "text": "Tu as commencé par un poème, tu finiras par une idylle bucolique en essayant de surprendre le vrai caractère de ces messieurs dans quelques aventures champêtres, la chasse ou la pêche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e167fe-dda9-3a74-b782-8f62777da269",
                                        "entry_id": "8febaf34-7ea7-3ef7-a336-7a122c90ccdb",
                                        "glosses": [
                                            "Qui se rapporte à la vie simple et paisible en campagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45029f64-0af7-450a-9359-ac5256a59383",
                                                "sense_id": "46e167fe-dda9-3a74-b782-8f62777da269",
                                                "text": "— Je souhaite aussi que vous participiez à ma chasse au trésor annuelle de demain, ainsi qu'à mon pique-nique bucolique avec divertissements ripariens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c4687d-09ef-3fef-91d7-ec9e1ede283e",
                                        "entry_id": "8febaf34-7ea7-3ef7-a336-7a122c90ccdb",
                                        "glosses": [
                                            "Relatif à une ancienne branche du Nil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15609f73-03d7-4fa7-b170-744282d5717f",
                                                "sense_id": "f1c4687d-09ef-3fef-91d7-ec9e1ede283e",
                                                "text": "Le canal Bucolique a été creusé de mains d’homme : il est entre la branche Sébennytique & la Mendésienne."
                                            },
                                            {
                                                "example_id": "8b93391c-5c2a-446b-af14-f03cbd7b584e",
                                                "sense_id": "f1c4687d-09ef-3fef-91d7-ec9e1ede283e",
                                                "text": "BUCOLIQUE (BRANCHE) (géogr. anc.), petite branche du Nil, faite selon Hérodote par la main des hommes. Elle est placée entre les branches Sébennitique et Mendésienne. Strabon l’appelle Phatmétique."
                                            },
                                            {
                                                "example_id": "1e9bb2d6-f304-4b62-ac24-4f4c1f2867bf",
                                                "sense_id": "f1c4687d-09ef-3fef-91d7-ec9e1ede283e",
                                                "text": "Cette embouchure du Nil, appellée Héracléotique, ne seroit-elle pas la mème qui est nommée Bucolique dans Hérodote ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bucolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce017344-b7e9-355b-bf7f-df70b2aed0fd",
                                        "entry_id": "641179e9-e287-3aa2-aff6-96750489dcdb",
                                        "glosses": [
                                            "Un poème bucolique."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0fc58b9-e8c0-4c93-947d-43028ff10f1b",
                                                "sense_id": "ce017344-b7e9-355b-bf7f-df70b2aed0fd",
                                                "text": "Note : On ne l’emploie guère qu’au pluriel et dans cette expression : « Les Bucoliques de Virgile »."
                                            },
                                            {
                                                "example_id": "7700ff10-5792-4737-b3d3-afabdf3bbe2f",
                                                "sense_id": "ce017344-b7e9-355b-bf7f-df70b2aed0fd",
                                                "text": "Cette bucolique, mademoiselle, s’est toujours écrite sur des tables d’or, dit le poète."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b089b7d-f269-458e-8743-55d9ac2e3ae9",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "rustic, pastoral, country-styled",
                        "target_lang_word": "пасторальный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пасторальный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "264a7da4-e1cf-37ab-bffc-75ec445108ea",
                                        "entry_id": "0e2ed78a-0118-3e1d-b403-346a42275647",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным пастораль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10e1f43-c354-47f5-ae36-9c67d464a426",
                                                "sense_id": "264a7da4-e1cf-37ab-bffc-75ec445108ea",
                                                "text": "В конце XVI в., когда распространились сначала пасторальные драмы, а затем опера (первая опера «Дафна» Ринуччини и Пери — была поставлена в 1594 г.), потребовалось освоение глубины сцены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da5fd441-2220-3aab-98a5-408a4a24136b",
                                        "entry_id": "0e2ed78a-0118-3e1d-b403-346a42275647",
                                        "glosses": [
                                            "обладающий чертами пасторали; умиротворённый, тихий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdd54a8-d26d-46cd-8595-909df1f18cc2",
                                                "sense_id": "da5fd441-2220-3aab-98a5-408a4a24136b",
                                                "text": "Мягкая, пасторальная, детская безмятежность пронизывает крепость, будто канули навсегда в прошлое войны, костры и кровь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
