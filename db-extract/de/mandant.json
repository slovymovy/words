                                        "sense_id": "9015fe9e-a48a-3de9-8209-fa515685d2fc",
                                        "entry_id": "e61c8f5d-ffe2-3d0f-aca5-b3645dfcb38b",
                                        "glosses": [
                                            "A person who receives help or services from a professional such as a lawyer or accountant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d37f17-1718-45d5-aa59-e08d1ce88251",
                                                "sense_id": "9015fe9e-a48a-3de9-8209-fa515685d2fc",
                                                "text": "I corralled the judge, and we started off across the fields[…]. And thus we came by a circuitous route to Mohair,[…]. My client welcomed the judge […] and they disappeared together into the Ethiopian card-room, which was filled with the assegais and exclamation point shields Mr. Cooke had had made at the sawmill at Beaverton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb117d9c-5a65-3c7d-bae9-2fb675752311",
                                        "entry_id": "e61c8f5d-ffe2-3d0f-aca5-b3645dfcb38b",
                                        "glosses": [
                                            "A person who employs or retains an attorney to represent him or her in any legal matter, or one who merely divulges confidential matters to an attorney while pursuing professional assistance without subsequently retaining the attorney."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d265eb55-3d23-3ba9-b1e5-7520d1c52487",
                                        "entry_id": "e61c8f5d-ffe2-3d0f-aca5-b3645dfcb38b",
                                        "glosses": [
                                            "In ancient Rome, retainers and followers associated with a gens."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f149ed-47ea-45cd-91a3-24003117de1a",
                                                "sense_id": "d265eb55-3d23-3ba9-b1e5-7520d1c52487",
                                                "text": "The nomen belonged to all members of a gens and to all those attached to it (women, clients, and freedmen included)."
                                            }
