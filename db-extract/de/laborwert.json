                "senses": [
                    {
                        "sense_id": "a3954b52-de4d-332f-b728-2afba595fa23",
                        "entry_id": "f4deeca1-0898-3ea1-a143-906c06290cf9",
                        "glosses": [
                            "Messwert, der in einem Labor bestimmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4816a2-5437-4e32-bc76-5eb474122e66",
                                "sense_id": "a3954b52-de4d-332f-b728-2afba595fa23",
                                "text": "„Ist dieser Laborwert allein ausreichend, wenn es um die Entscheidung für oder gegen Therapie geht?“"
                            },
                            {
                                "example_id": "fd1b140c-4e5f-4d9b-9039-3f8e8fb2d494",
                                "sense_id": "a3954b52-de4d-332f-b728-2afba595fa23",
                                "text": "„Der deutsche Konzern war durch ICCT-Untersuchungen ins Visier der Behörde geraten. Dessen Experten fanden vor allem bei den Dieselmodellen Jetta und Passat massive Abweichungen der realen Emissionen vom Laborwert.“"
                            },
                            {
                                "example_id": "1d019f27-afad-487f-8367-1de22da39b35",
                                "sense_id": "a3954b52-de4d-332f-b728-2afba595fa23",
                                "text": "„2001 hatten die europäischen Autos auf der Strasse im Schnitt bloss 8% mehr verbraucht als offiziell gemessen. Doch seither ist der Abstand zwischen Realität und Laborwert auf über 40% angewachsen.“"
                            },
                            {
                                "example_id": "667a91d2-757b-48be-900d-9f9c4cdf7bc0",
                                "sense_id": "a3954b52-de4d-332f-b728-2afba595fa23",
                                "text": "„Tatsächlich verlor der Patient bei der OP viel Blut, und seine Laborwerte sanken lebensgefährlich tief ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
