                    {
                        "translation_id": "fa23a46c-d2fa-431a-bba3-b785fdbba7b7",
                        "source_entry_id": "77e6c73f-4e23-32df-9fa2-24059d2b61b8",
                        "source_sense_id": "acbb3daf-8147-3a08-a896-301cfda3f959",
