                    "sense_definition": "To feel deep regret or repentance for a past action or decision.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will live to <w>rue</w> the day he made that foolish decision.",
                            "target_lang_translations": {
                                "de": "Er wird den Tag noch <w>bereuen</w>, an dem er diese törichte Entscheidung getroffen hat."
                            }
                        },
                        {
                            "text": "She came to <w>rue</w> her harsh words after learning the truth.",
                            "target_lang_translations": {
                                "de": "Sie begann ihre harten Worte zu <w>bereuen</w>, nachdem sie die Wahrheit erfahren hatte."
                            }
