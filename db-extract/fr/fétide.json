                "entry_id": "e136544a-5585-3fa1-bc0a-32d1d0395c25",
                "word": "fétide",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d12b9219-37dd-488e-a852-10e49a696b08",
                        "entry_id": "e136544a-5585-3fa1-bc0a-32d1d0395c25",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fétides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd73c745-4e9f-33c3-86ad-8e8ae20765d4",
                        "entry_id": "e136544a-5585-3fa1-bc0a-32d1d0395c25",
                        "glosses": [
                            "Qui a une odeur répugnante et nauséabonde, puant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e515d3-1fa8-49b2-892b-91ee29e99442",
                                "sense_id": "fd73c745-4e9f-33c3-86ad-8e8ae20765d4",
                                "text": "Je sentais son haleine fétide."
                            },
                            {
                                "example_id": "5440a932-6123-42f8-9fa3-00d7ceaef3ad",
                                "sense_id": "fd73c745-4e9f-33c3-86ad-8e8ae20765d4",
                                "text": "Les bas-fonds ne sont passionnants que lorsqu'on en explore les profondeurs fétides en calèche, en habit et pour rien."
                            },
                            {
                                "example_id": "a553c085-7e03-4b01-8990-ef2eae265b3b",
                                "sense_id": "fd73c745-4e9f-33c3-86ad-8e8ae20765d4",
                                "text": "Il pâlit un peu, puis, tentant un effort désespéré, réussit à dégager un pied, tandis que l’autre restait prisonnier de la glu mouvante et fétide des profondeurs."
                            },
                            {
                                "example_id": "324d780d-0632-4793-8d15-ede85ef59427",
                                "sense_id": "fd73c745-4e9f-33c3-86ad-8e8ae20765d4",
                                "text": "C'est ainsi que parmi les insectes nous trouvons beaucoup d'espèces d'animaux comme la punaise qui exhalent une odeur fétide."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3e89431-a6aa-30a3-aaba-24397f3a09bb",
                        "entry_id": "e136544a-5585-3fa1-bc0a-32d1d0395c25",
                        "glosses": [
                            "Qui manifeste des sentiments ou une attitude inconvenante."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4f0d2c-3028-4707-8c46-7955a49ebcd5",
                                "sense_id": "b3e89431-a6aa-30a3-aaba-24397f3a09bb",
                                "text": "« Quelle gaieté fétide ! disait-il en donnant à sa bouche une expression de dégoût si forte qu’il avait lui-même la sensation musculaire de sa grimace jusque dans son cou révulsé contre le col de sa chemise. Et comment une créature dont le visage est fait à l’image de Dieu peut-elle trouver matière à rire dans ces plaisanteries nauséabondes ? Toute narine un peu délicate se détournerait avec horreur pour ne pas se laisser offusquer par de tels relents."
                            },
                            {
                                "example_id": "4c181d77-8ed9-4089-b31c-b2f74a403ce6",
                                "sense_id": "b3e89431-a6aa-30a3-aaba-24397f3a09bb",
                                "text": "Il imaginait qu’elle subissait avec dégoût les assauts furtifs de ce mâle honteux qui, avec des précautions irritantes, faisait prendre l’air à ses envies malingres, enfermées dans un sentiment fétide des convenances."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc75f774-bf44-4956-b0cb-037b0bdb6521",
                        "source_entry_id": "e136544a-5585-3fa1-bc0a-32d1d0395c25",
                        "source_sense_description": "nauséabond",
                        "target_lang_word": "fetid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fetid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94c48abe-2285-3105-841d-08b8d44e9487",
                                        "entry_id": "dec7dc73-95a7-3ab4-88b8-9d4f492af7a6",
                                        "glosses": [
                                            "Foul-smelling, stinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c95504-7e04-4188-84e3-6feb994cfb01",
                                                "sense_id": "94c48abe-2285-3105-841d-08b8d44e9487",
                                                "text": "I caught the fetid odor of dirty socks."
                                            },
                                            {
                                                "example_id": "8dcf6118-942e-4e51-ab66-cd849bc59c5a",
                                                "sense_id": "94c48abe-2285-3105-841d-08b8d44e9487",
                                                "text": "[…] this room, where misfortune seems to ooze, where speculation lurks in corners, and of which Madame Vauquer inhales the warm, fetid air without being nauseated."
                                            },
                                            {
                                                "example_id": "b185f0d3-f85b-4bee-806a-baca8c585ff7",
                                                "sense_id": "94c48abe-2285-3105-841d-08b8d44e9487",
                                                "text": "Hiro fakes toward the whorehouse, then cuts directly toward an exposed section of wall. The fabric of the building is tough, but his katana slices a six-foot rent through it with a single gliding motion, and then he's outside, spat out of the hole on a jet of fetid air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fetid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d699718a-c6f5-39f3-b8e7-914c8566b4b3",
