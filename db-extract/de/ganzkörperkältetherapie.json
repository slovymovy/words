                "senses": [
                    {
                        "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                        "entry_id": "84791951-d91f-3494-9de0-11f6f258e198",
                        "glosses": [
                            "kurzzeitige Anwendung von Kälte unter −100 Grad Celsius auf die gesamte Körperoberfläche zur Hemmung entzündlicher Prozesse oder Hämatombildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfbc4b9-443c-4015-b4d1-30f7fb8d9094",
                                "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                                "text": "Im Bikini oder Badehose für drei Minuten in eine eiskalte Kammer bei minus 110 Grad Celsius – das klingt mörderisch. Und doch bieten einige Kliniken diese Ganzkörperkältetherapie (GKT) gegen chronische Schmerzen an, etwa bei Rheuma, Fibromyalgie und Rückenleiden."
                            },
                            {
                                "example_id": "28ffca2c-9a29-4ba2-ad92-0646e1a9b745",
                                "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                                "text": "Die Liste der Erkrankungen bzw. der damit verbundenen Beschwerden, die mit Hilfe der Ganzkörperkältetherapie (auch Cryo-Therapie genannt) gelindert werden können, ist lang."
                            },
                            {
                                "example_id": "671d1a2d-25df-4157-afd9-a34bb25eb29e",
                                "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                                "text": "Wir haben die wissenschaftlichen Datenbanken auf alle Arten von Ganzkörperkältetherapie durchforstet. … Anhand dieser Daten ist es keinesfalls möglich zu beurteilen, ob eine Ganzkörperkältetherapie wirksam und sinnvoll ist."
                            },
                            {
                                "example_id": "1c8f61f4-f0bb-44d8-bd98-baee9e043f72",
                                "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                                "text": "Im Leistungssport ist die Ganzkörperkältetherapie besonders beliebt."
                            },
                            {
                                "example_id": "a8438d84-1f26-4c35-8e75-1ea1498b73d6",
                                "sense_id": "5e1d13d0-23b2-3eaa-953d-d1c73f6f8e1c",
                                "text": "Unter den berichteten Indikationen für die Ganzkörperkältetherapie sind die entzündlich-rheumatischen Erkrankungen (rheumatoide Arthritis und ankylosierende Spondylitis) am besten untersucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
