                {
                    "sense_id": "91b29290-2e6e-3281-b1f7-0c7088b1334c",
                    "sense_definition": "Een vloeibaar product dat speciaal bedoeld is om het haar te wassen en te verzorgen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "haarverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet nieuwe <w>shampoo</w> kopen omdat de fles bijna leeg is.",
                            "target_lang_translations": {
                                "en": "I need to buy new <w>shampoo</w> because the bottle is almost empty.",
                                "ru": "Мне нужно купить новый <w>шампунь</w>, потому что бутылка почти пуста."
                            }
                        },
                        {
                            "text": "Welke <w>fles</w> <w>shampoo</w> gebruik jij meestal voor je haar?",
                            "target_lang_translations": {
                                "en": "Which bottle of <w>shampoo</w> do you usually use for your hair?",
                                "ru": "Какую <w>бутылку</w> <w>шампуня</w> ты обычно используешь для волос?"
                            }
                        }
                    ],
                    "synonyms": [
                        "haarwasmiddel"
                    ],
                    "common_phrases": [
                        "fles shampoo",
                        "milde shampoo",
                        "shampoo gebruiken"
                    ],
                    "target_lang_definitions": {
                        "en": "A liquid product specifically intended for washing and caring for the hair.",
                        "ru": "Жидкое средство, специально предназначенное для мытья и ухода за волосами."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shampoo",
                                "target_lang_sense_clarification": "hair care product"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шампунь",
                                "target_lang_sense_clarification": "средство для мытья волос"
                            }
                        ]
                    }
                }
            ]
        },
