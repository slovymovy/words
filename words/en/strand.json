                                "target_lang_word": "tel",
                                "target_lang_sense_clarification": "kablo veya halatın içindeki parça"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "股",
                                "target_lang_sense_clarification": "绳、线、缆等拧合成整体前的组成部分"
                            },
                            {
                                "target_lang_word": "绞股",
                                "target_lang_sense_clarification": "电缆或绳索中的一股、一缕"
                            },
                            {
                                "target_lang_word": "绳股",
                                "target_lang_sense_clarification": "较技术性的说法，如钢缆、纤维束"
                            }
                        ]
