                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical usage of the term."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Běžné rčení nebo metaforické vyjádření používané k popsání něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rčení",
