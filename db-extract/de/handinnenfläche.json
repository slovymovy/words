                                "target_senses": [
                                    {
                                        "sense_id": "e3e305f5-1bbc-35dd-bd45-2b55cd9d29fc",
                                        "entry_id": "3f370aca-326e-351e-a823-ca6cae5e3d5f",
                                        "glosses": [
                                            "Face intérieure de la main, entre le poignet et les doigts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d46d10ea-f36c-4b32-8266-49faba25ad66",
                                                "sense_id": "e3e305f5-1bbc-35dd-bd45-2b55cd9d29fc",
                                                "text": "Me voici allongée au bord de la grève, les paumes aplaties sur le sable que je caresse comme un pelage soyeux."
                                            },
                                            {
                                                "example_id": "44687fb4-aba3-4ae6-9144-17f800e691f4",
                                                "sense_id": "e3e305f5-1bbc-35dd-bd45-2b55cd9d29fc",
                                                "text": "Chaque fois qu’elle nous rencontrait sur son chemin, elle se contentait de nous dire : « Allez jouer », avec un geste des mains que je revois encore, les paumes tournées en dedans, l’une vers l’autre, et s’écartant ensuite à plusieurs reprises, comme pour chasser des moineaux."
                                            },
                                            {
                                                "example_id": "72fd9d84-88c9-41e5-8ba1-ec1b966522b7",
                                                "sense_id": "e3e305f5-1bbc-35dd-bd45-2b55cd9d29fc",
                                                "text": "Henri fit claquer ses phalanges contre ses paumes crispées."
                                            },
                                            {
                                                "example_id": "9adb30d1-d567-4b02-8fb7-a705fca3e3b7",
                                                "sense_id": "e3e305f5-1bbc-35dd-bd45-2b55cd9d29fc",
                                                "text": "Cette fois, je fermai les poings à m'enfoncer les ongles dans la paume. J'étais décidé à ne plus remuer les doigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4bf3f0-78d2-319d-bd24-2df64639fbf1",
                                        "entry_id": "3f370aca-326e-351e-a823-ca6cae5e3d5f",
                                        "glosses": [
                                            "Jeu de paume."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac8f937-743e-456c-8240-dfa79704133d",
                                                "sense_id": "be4bf3f0-78d2-319d-bd24-2df64639fbf1",
                                                "text": "[…] une apparence de jardin public que précisaient encore toutes sortes de jeux, des manèges de chevaux de bois, des balançoires, des appareils de gymnastique, des jeux de boules, de quilles, des tirs à l’arc, à l’arbalète, à la carabine et au fusil de guerre, des mâts de cocagne, des terrains pour la paume, des pistes pour vélocipèdes, un théâtre de marionnettes, une estrade pour des musiciens."
                                            },
                                            {
                                                "example_id": "8767a811-568f-43fb-bef7-f982a4d3b80f",
                                                "sense_id": "be4bf3f0-78d2-319d-bd24-2df64639fbf1",
                                                "text": "Plusieurs jeunes gens s'amusaient d'un jeu de balles analogue à la paume avec d'énormes raquettes recouvertes de cuir de bœuf, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c9fea16-cab5-31d6-8ceb-5dc54bdb8b74",
                                        "entry_id": "3f370aca-326e-351e-a823-ca6cae5e3d5f",
                                        "glosses": [
                                            "Ancienne unité de mesure de longueur valant environ environ 7,5 cm."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
