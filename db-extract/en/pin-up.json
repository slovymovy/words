                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "краса́вчик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                        "entry_id": "d72b0acc-d061-3060-b094-94d401ddc565",
                                        "glosses": [
                                            "ирон., пренебр. уменьш. к красавец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff6b551e-a936-4644-87db-1b72a7ea01ed",
                                                "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                                "text": "А вот карточка моего отца: голубоглазый блондин, изящный, нежный и застенчивый красавчик, мамин и папин любимчик."
                                            },
                                            {
                                                "example_id": "e1fc48c0-1c3a-4212-a4f3-32474a8c0c8a",
                                                "sense_id": "2e7e2d99-bc3d-32fb-8f8c-88f2a65f206e",
                                                "text": "Многим девчонкам нравятся смазливые красавчики типа Алена Делона и Жерара Филиппа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580af748-d87f-3417-af31-4a6f36772813",
                                        "entry_id": "d72b0acc-d061-3060-b094-94d401ddc565",
                                        "glosses": [
                                            "мол. для выражения одобрения, похвалы за какой-нибудь ловкий, отличный поступок, удачное действие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811c2a97-0818-44b7-92db-dd59e6610f80",
                                                "sense_id": "580af748-d87f-3417-af31-4a6f36772813",
                                                "text": "Где находятся камеры, знаю. ― Молодец, Серж, красавчик, ― похвалил друга Герман. ― Зачем оттягивать?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec7bfe9-8cdd-4702-b686-148df1681751",
                        "source_entry_id": "a83d7e41-9822-33db-af7e-581ff7f87d5d",
                        "source_sense_description": "person",
                        "target_lang_word": "красо́тка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "красо́тка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ecaebac-a7c4-319b-a52a-8f992ab76dae",
                                        "entry_id": "b98a811b-c1a6-30fc-877d-eb75d8145178",
                                        "glosses": [
                                            "разг. хорошенькая, миловидная женщина, девушка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6865ef3-dd96-435f-922b-346481b4970c",
                                                "sense_id": "3ecaebac-a7c4-319b-a52a-8f992ab76dae",
                                                "text": "В ближней деревне жила одна красотка, дочь тамошнего крестьянина."
                                            },
                                            {
                                                "example_id": "7471b55e-6209-4fb9-882d-a8524e80546e",
                                                "sense_id": "3ecaebac-a7c4-319b-a52a-8f992ab76dae",
                                                "text": "Таскались мы много по России, Польше и турецким землям, и везде знавали меня под именем красотки и везде сулили нашим старухам горсти золота, лишь бы меня сманить в западню."
                                            },
                                            {
                                                "example_id": "148bac5b-4553-432e-b8f1-b25df9f00f69",
                                                "sense_id": "3ecaebac-a7c4-319b-a52a-8f992ab76dae",
                                                "text": "Но и то было ненадолго, одна за другой являлись новые красотки, и с ними проводил время Алексей, забывал жену и всё, что получил от неё."
                                            },
                                            {
                                                "example_id": "cc54123f-a99e-4ce1-bfc4-c59f9e576003",
                                                "sense_id": "3ecaebac-a7c4-319b-a52a-8f992ab76dae",
                                                "text": "Но вдруг узнали, что в первую ночь брака молодой супруг поступил с красоткой весьма невежливо, мстя ей за свою поруганную честь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
