                                        "glosses": [
                                            "Licht, das von einer brennenden Kerze ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d667232-2155-4115-9f3d-1b1171c3bc19",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Tagsüber am Strand, im warmen Gegenlicht, werden sie davon fast aufgesogen, nachts erscheinen sie im spärlichen Kerzenschein wie von alten Meistern ausgeleuchtet.“"
                                            },
                                            {
                                                "example_id": "0b25746d-9624-46be-b740-81a8a672ab89",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Mit einem Bad bei Kerzenschein hat ein 39-jähriger Bremer eine Wohnung in Schutt und Asche gelegt.“"
                                            },
                                            {
                                                "example_id": "d29f2014-6721-4105-866c-2b45ee2e387f",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Der Kapitän sah Pierre beim Kerzenschein an, und offenbar machte ihn jetzt das verstörte Gesicht seines Gesprächspartners stutzig.“"
                                            },
                                            {
                                                "example_id": "d6a31ea8-1672-4c63-ac17-faf8bd450d5f",
                                                "sense_id": "3d3b3318-764c-3759-b278-b14344f47d92",
                                                "text": "„Durch das bunte Glas der Fenster fällt das Licht von draußen gedämpft herein und mischt sich mit dem Kerzenschein zu einem sanften, rot und blau überwehten Gold.“"
                                            }
                                        ],
