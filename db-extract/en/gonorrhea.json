                        "source_entry_id": "a3f5c00c-1cb8-33f2-b54a-da155a39cee1",
                        "source_sense_id": "6bc2e0c8-2904-3095-8c64-ec9199b403b0",
                        "source_sense_description": "STD",
                        "target_lang_word": "три́ппер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "три́ппер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                        "entry_id": "eb07d480-3684-38cf-916f-bd2ca1e94d12",
                                        "glosses": [
                                            "инфекционное венерическое заболевание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb122dc-8792-40b3-8d94-c1172836b3b5",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "Препарат чудодейственный: триппер излечивает в 1–2 дня, сифилис — в месяц."
                                            },
                                            {
                                                "example_id": "52658735-8b62-40da-8a00-8544e12c7ec3",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "Кисло попахивало краской и тем особым специфическим лекарством, — я забыл сейчас его название, — каким залечивали в то время триппер."
                                            },
                                            {
                                                "example_id": "e22dbaef-7786-4ffc-9a18-5556e68845ef",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "Все снуют — из бардака в клинику, из клиники опять в бардак. И кругом столько трипперу, что дышать трудно."
                                            },
                                            {
                                                "example_id": "b821b462-4b89-42d0-b252-9c91593cecf9",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "А тогда доктор Кац лечил в своё удовольствие триппер и трихомонаду на дому, и от входной двери до его комнат то и дело шныряли личности съёженные, глаз не поднимавшие."
                                            },
                                            {
                                                "example_id": "634666ba-b146-409e-a045-b6d3fa1e6727",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "— У нас в базе болезнь такая среди мужчин и женщин ходит, триппер, от которого сладу нет, ни один пенициллин не помогает."
                                            },
                                            {
                                                "example_id": "8feda733-6e6c-4bdc-a799-eb548a1ac553",
                                                "sense_id": "b2105a5a-a47c-3d51-9d41-5cda9b905348",
                                                "text": "В сорок втором году, чтобы получить разрешение на выход за ворота, он одними травами вылечил от триппера тогдашнего коменданта."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
