                    {
                        "translation_id": "71ee4337-6f88-43d5-9035-ddd641dbe3d9",
                        "source_entry_id": "2e38022b-e5b7-3b7c-b6ee-51b13e52cae8",
                        "source_sense_description": "one who practices alchemy",
                        "target_lang_word": "alchimiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
