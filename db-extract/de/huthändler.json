                        "glosses": [
                            "jemand, der professionell Hüte kauft und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9c24a7-fc61-4ca5-9cc7-d485e44350ed",
                                "sense_id": "760440f4-f7ab-3976-9245-ddf15641ebb6",
                                "text": "„Der Huthändler kam herauf und zeigte mir eine goldene Repetieruhr mit einer goldenen Kette, die neu war und aus Paris von einem bekannten Hersteller stammte.“"
                            }
