                                                "sense_id": "1685caa4-5db9-3a7c-86e1-7638295d159a",
                                                "text": "There were no elections during Franco's dictatorship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ecabfc7-a93f-3a83-bdc7-7702e9816290",
                                        "entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
