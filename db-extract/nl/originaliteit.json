                "translations": [
                    {
                        "translation_id": "89889d4f-a779-4604-a851-5e63bb81d657",
                        "source_entry_id": "2a81042a-eb7f-3eb6-84df-c535501fbe7a",
                        "source_sense_id": "3b25ea55-339f-3634-b7bf-f49bb664e31c",
                        "target_lang_word": "originalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "originalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b79255e-ff1f-31ec-8f1d-89f2f1000cf2",
                                        "entry_id": "6fdf13f6-6e91-3dfe-a87c-8b276e397ec1",
                                        "glosses": [
                                            "Qualité globale de ce qui est original, caractère de ce qui est neuf, sans modèle de même nature, unique, créatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6733e6a6-989d-4a75-8099-a37f73e384b4",
                                                "sense_id": "3b79255e-ff1f-31ec-8f1d-89f2f1000cf2",
                                                "text": "La culture intensive de l’oignon, pratiquée sur les rives du Mayo Binder, contribue pour beaucoup à l’originalité du canton de Binder dans la zone soudanienne."
                                            },
                                            {
                                                "example_id": "de6e43fb-2bce-40fb-b64e-41e17d300de6",
                                                "sense_id": "3b79255e-ff1f-31ec-8f1d-89f2f1000cf2",
                                                "text": "L’architecture de l'hôtel Burj Al Arab à Dubaï est un bon exemple d’originalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685e5a14-1d5c-3848-9953-eb416515b060",
                                        "entry_id": "6fdf13f6-6e91-3dfe-a87c-8b276e397ec1",
                                        "glosses": [
                                            "(Pour les choses) Élément original, caractère partiel peu courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e33cc75-fcb9-4446-9a30-6d5c830bc06a",
                                                "sense_id": "685e5a14-1d5c-3848-9953-eb416515b060",
                                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu'il eut la gentillesse de rendre intelligentes, ce qui dut lui donner beaucoup de mal, car, honnêtement, nos déplacements rugbystiques n'ont jamais vraiment brillé ni par leur originalité, ni par la pertinence de nos pensées."
                                            },
                                            {
                                                "example_id": "83c6b3c5-ffb4-49d0-ab1a-1eefa98c7f0d",
                                                "sense_id": "685e5a14-1d5c-3848-9953-eb416515b060",
                                                "text": "Les portes en ailes de papillon (ou de mouette pour les Américains) étaient la grande originalité de la Mercedes 300 SL"
                                            },
                                            {
                                                "example_id": "557def34-3c3d-4a23-ba8f-dd60b85e8957",
                                                "sense_id": "685e5a14-1d5c-3848-9953-eb416515b060",
                                                "text": "La glace arrière inclinée en dévers était la grande originalité de la Citroën AMI 6"
                                            },
                                            {
                                                "example_id": "8503c8d7-528b-4c11-8b70-85bef450cb06",
                                                "sense_id": "685e5a14-1d5c-3848-9953-eb416515b060",
                                                "text": "La piscine sur le toit fait partie, avec le lustre en cristal de Swarowski, des originalités du Marina Bay Sands Hotel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e7b7d92-27ff-3534-92d4-ada23825a795",
                                        "entry_id": "6fdf13f6-6e91-3dfe-a87c-8b276e397ec1",
                                        "glosses": [
                                            "(Pour les personnes) Capacité de quelqu’un à produire quelque chose de nouveau, d'original"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f024825-2096-4a82-a905-b3d9b37b73a0",
                                                "sense_id": "5e7b7d92-27ff-3534-92d4-ada23825a795",
                                                "text": "Toutes les bonnes choses qui existent sont les fruits de l’originalité."
                                            },
                                            {
                                                "example_id": "108550dd-b8e4-4f97-98e4-1b633c619c3e",
                                                "sense_id": "5e7b7d92-27ff-3534-92d4-ada23825a795",
                                                "text": "Nous n’eûmes pas le temps d’en visiter l’intérieur, et nous le regrettâmes peu, car tous les palais se ressemblent. Il en est de même des courtisans : l’originalité ne se trouve que dans le peuple, et la canaille semble avoir conservé le privilège de la poésie."
                                            },
                                            {
                                                "example_id": "551d2950-120c-497b-baf6-024528368780",
                                                "sense_id": "5e7b7d92-27ff-3534-92d4-ada23825a795",
                                                "text": "Il faut, après mûre réflexion, après méditation sérieuse, agir conformément à son propre caractère. L’originalité est donc indispensable même dans la vie pratique ; sans elle, ce qu’on fait ne s’accorde pas avec ce qu’on est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d84392-3dc6-3ce9-a6ad-145f26e1e2a0",
                                        "entry_id": "6fdf13f6-6e91-3dfe-a87c-8b276e397ec1",
                                        "glosses": [
                                            "(Pour les personnes) Singularité, bizarrerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af06b8b-7051-4236-807e-ed48bdbc626f",
                                                "sense_id": "e4d84392-3dc6-3ce9-a6ad-145f26e1e2a0",
                                                "text": "Monsieur Hector y découvre moins d’originalité réelle qu’un orgueil bien assis, une volonté de contemption toute proche de l’irrespect."
                                            },
                                            {
                                                "example_id": "4192aedb-68ca-41cf-87ce-18d3294b1e6d",
                                                "sense_id": "e4d84392-3dc6-3ce9-a6ad-145f26e1e2a0",
                                                "text": "Ceux qui fayotent avec l’originalité et qui à force d'abuser de fausses excentricités, de se mentir à eux-mêmes dans le but de se distinguer, ne sont plus que des pantins. Oui, on en perd du temps à s'affranchir des tabous, des flux et reflux des modes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
