{
    "word_family": [
        "mash",
        "masher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2684d4d6-9ffb-3d58-95fb-076bf38d270a",
                    "sense_definition": "Crushed or beaten into a soft, pulpy state.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pulpy_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We served the roasted chicken with a large bowl of <w>mashed</w> potatoes.",
                            "target_lang_translations": {
                                "ru": "Мы подали жареную курицу с большой миской <w>картофельного пюре</w>.",
                                "zh": "我们用一大碗<w>土豆泥</w>搭配烤鸡。"
                            }
                        },
                        {
                            "text": "The recipe requires <w>mashed</w> bananas to make the bread moist.",
                            "target_lang_translations": {
                                "ru": "Для рецепта требуются <w>размятые</w> бананы, чтобы хлеб получился влажным.",
                                "zh": "这个食谱需要用<w>捣烂的</w>香蕉来增加面包的湿润度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pulped"
                    ],
                    "common_phrases": [
                        "mashed potatoes",
                        "mashed bananas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздавленный или взбитый до мягкого, кашицеобразного состояния.",
                        "zh": "被压碎或捣烂成柔软、糊状的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчёный",
                                "target_lang_sense_clarification": "измельченный путем толчения"
                            },
                            {
                                "target_lang_word": "пюрированный",
                                "target_lang_sense_clarification": "доведенный до состояния пюре"
                            },
                            {
                                "target_lang_word": "размятый",
                                "target_lang_sense_clarification": "раздавленный до мягкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捣烂的",
                                "target_lang_sense_clarification": "指食物被捣碎成泥状"
                            },
                            {
                                "target_lang_word": "泥状的",
                                "target_lang_sense_clarification": "形容食物呈现出糊状或泥状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae257615-1150-3009-b875-c43b95b21b14",
                    "sense_definition": "Severely intoxicated by alcohol or drugs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They got completely <w>mashed</w> at the party last night and could barely walk home.",
                            "target_lang_translations": {
                                "ru": "Вчера на вечеринке они напились <w>в стельку</w> и едва смогли дойти до дома.",
                                "zh": "他们昨晚在派对上<w>烂醉</w>如泥，几乎走不回家。"
                            }
                        },
                        {
                            "text": "He was too <w>mashed</w> to remember anything that happened during the concert.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>никакой</w>, чтобы помнить что-либо из происходившего на концерте.",
                                "zh": "他当时醉得太厉害，对音乐会期间发生的事毫无记忆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "common_phrases": [
                        "completely mashed",
                        "get mashed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to describe extreme intoxication."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии сильного алкогольного или наркотического опьянения.",
                        "zh": "指因酒精或药物影响而处于极度醉酒或神志不清的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный в стельку",
                                "target_lang_sense_clarification": "крайне нетрезвый"
                            },
                            {
                                "target_lang_word": "укуренный",
                                "target_lang_sense_clarification": "под воздействием веществ, сленг"
                            },
                            {
                                "target_lang_word": "никакой",
                                "target_lang_sense_clarification": "в состоянии сильного опьянения, разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烂醉的",
                                "target_lang_sense_clarification": "形容醉得非常厉害"
                            },
                            {
                                "target_lang_word": "大醉的",
                                "target_lang_sense_clarification": "指处于严重的醉酒状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4afc8517-e8d3-3579-8ace-478a38fdf1ba",
                    "sense_definition": "Simple past tense and past participle of <w>mash</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>mashed</w> the potatoes with butter and milk until they were smooth.",
                            "target_lang_translations": {
                                "ru": "Она <w>растолкла</w> картофель со сливочным маслом и молоком до однородного состояния.",
                                "zh": "她加入黄油和牛奶，把土豆<w>捣</w>成了细腻的泥。"
                            }
                        },
                        {
                            "text": "He has <w>mashed</w> all the ingredients together to make the sauce.",
                            "target_lang_translations": {
                                "ru": "Он <w>размял</w> все ингредиенты вместе, чтобы приготовить соус.",
                                "zh": "他把所有配料<w>捣</w>在一起做成了酱汁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола mash (разминать, толочь).",
                        "zh": "动词 mash 的过去式和过去分词，意为捣碎、压烂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размял",
                                "target_lang_sense_clarification": "прошедшее время от разминать"
                            },
                            {
                                "target_lang_word": "растолок",
                                "target_lang_sense_clarification": "прошедшее время от толочь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捣碎",
                                "target_lang_sense_clarification": "将食物压成泥状"
                            },
                            {
                                "target_lang_word": "压烂",
                                "target_lang_sense_clarification": "用力将物体压成糊状"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}