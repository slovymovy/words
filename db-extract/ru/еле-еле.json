        "ru-extract.jsonl": [
            {
                "entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                "word": "еле-еле",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ea956c4-954c-333a-9188-328fd9d34bbc",
                        "entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "glosses": [
                            "слегка, очень слабо, незначительно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4270e5f-9817-45f8-bb86-c0a971f148a3",
                                "sense_id": "1ea956c4-954c-333a-9188-328fd9d34bbc",
                                "text": "И снова на колокольне вызванивают часы, медленно, печально, еле-еле колебля тишину."
                            }
                        ]
                    },
                    {
                        "sense_id": "dee535c3-8395-3180-8545-02bfc92fe030",
                        "entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "glosses": [
                            "с большим трудом, насилу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060606a0-289a-4e85-8d24-a5d4fad2f4e5",
                                "sense_id": "dee535c3-8395-3180-8545-02bfc92fe030",
                                "text": "Шёл большаком, день был жаркий, измучился, еле-еле шёл."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cc10848-6244-48b6-821d-1234e0312eac",
                        "source_entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "source_sense_description": "слегка",
                        "target_lang_word": "à peine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à peine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Par une faible marge ; de peu ; seulement ; rien que."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcc0a2e-b346-4881-a688-4bee43b9857e",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Cette torture par laquelle vous venez de passer, vous me l'avez fait subir, il y a une heure à peine : il était juste que vous fissiez connaissance avec elle."
                                            },
                                            {
                                                "example_id": "b6f7ab06-9c8f-47f4-859e-ad14dbe70de2",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Le sucre était connu des anciens qui ne l'employaient qu'en très-petite quantité et comme médicament ; il y a 200 ans à peine, il se vendait seulement chez les pharmaciens, à un prix très-élevé."
                                            },
                                            {
                                                "example_id": "be5fbb8b-69e6-47d4-abc6-58d6f5b2e367",
                                                "sense_id": "f335946d-0e93-3b33-86cb-336b14eb7530",
                                                "text": "Wan-nien-sseu est un très vieux temple bouddhique, qui s'élève à quelques lis à peine des murailles de la ville, la courbe élégante de ses toits vernissés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "À l’instant, avec peu de temps qui s’est écoulé, depuis que la chose dont on parle est arrivée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e591e82-c0c3-424b-84d5-48cc65c11e31",
                                                "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                                "text": "Il fait doux, il fait clair. L’hiver commence à peine et je ne sais quoi de printanier flotte dans l’air subtil."
                                            },
                                            {
                                                "example_id": "94dfaf4d-bb0f-4036-9873-bc44b5824e16",
                                                "sense_id": "cdce2265-9807-3cc3-94dd-6159820f297d",
                                                "text": "À peine désécroué de son château-prison de Wilhelmshoe, le vieux criminel de Décembre organisait des réceptions et des raouts à Chislehurst, village des environs de Londres, où il avait pris une villa que j’ai visitée pendant mon dernier exil, le jour où on en a vendu le mobilier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Tout juste."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee623e9e-ab12-4d86-9ac9-bde5bff765d8",
                                                "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                                "text": "Il s’habilla bien vite et se rendit chez M. Walter, quoiqu’il fût à peine huit heures du matin."
                                            },
                                            {
                                                "example_id": "417e54b0-a847-4612-a1e6-01f9960f445b",
                                                "sense_id": "8ccde48c-27f5-3eec-aecd-34e18b3cf775",
                                                "text": "En temps normal, les régiments zoulous, les iButho, étaient constitués par classes d’âge. Mais compte tenu de son inexpérience, Abraham eut droit à un traitement particulier. Il fut versé dans une unité de très jeunes gens, se retrouvant en compagnie de garçons d’à peine treize ans qui n’avaient jamais combattu – des amabutu – voire de simples izinDibi, des porteurs d’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Difficilement, presque pas."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e280e35-4e48-4061-9a00-fc60f1a8a4c6",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Les cheminées et les toits de chaume, à droite et à gauche de la route, dépassaient à peine les montagnes de neige, […]."
                                            },
                                            {
                                                "example_id": "1cb0e83a-98c7-4f77-b5ab-d7ae6437128d",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Quand une pompe paraît à l’horizon, sa silhouette de télégraphe Chappe bat la mesure pour rien. Son teuf-teuf paisible se semble faire aucun bruit, mais s’amalgamer au silence de l’univers, qu’il ponctue à peine."
                                            },
                                            {
                                                "example_id": "39cfe1ff-671b-4e9c-8476-9d8bb985f81d",
                                                "sense_id": "d63e928c-3617-30fd-a40e-736034c525e8",
                                                "text": "Bien protégé derrière le pare-brise, le déplacement d'air provoqué par la rotation de l'hélice m'effleurait à peine les joues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "Dans une forte mesure ; énormément."
                                        ],
                                        "tags": [
                                            "euphemism",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61f3faf-060b-4d50-bb60-7a1d92abf302",
                                                "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                                "text": "Il l’a à peine enflé en lui refourguant sa camelote ; je ne sais pas comment cet idiot s’y prend pour se faire avoir à chaque fois."
                                            },
                                            {
                                                "example_id": "b8354432-6094-4e53-8dc8-4b3a6b44e5dd",
                                                "sense_id": "ae3423f7-8c11-3e00-963c-d2b02fcd5304",
                                                "text": "Avec 5 litres d’écart, ça a à peine débordé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                        "entry_id": "03d0768d-6292-3b5c-99aa-b732174c7158",
                                        "glosses": [
                                            "De façon flagrante, visible, ouvertement."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796e0a09-e560-43a4-b927-b79d690161f9",
                                                "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                                "text": "— Pour réussir à te débarrasser de ton tacot t’as dû bien l’endormir le client, non ?\n— Non, à peine."
                                            },
                                            {
                                                "example_id": "5a6962f1-599a-4161-a647-57de15f9e606",
                                                "sense_id": "8fc812ff-c84d-3b08-adc2-e182eec75ea0",
                                                "text": "— Dis-moi, tu ne serais pas en train de te foutre de ma gueule, par hasard ?\n — À peine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0109fb6b-63e1-453a-8aee-045e5556a21e",
                        "source_entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "source_sense_description": "слегка",
                        "target_lang_word": "faiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                        "entry_id": "14424ab6-2bdf-36a5-9c96-bb1962545589",
                                        "glosses": [
                                            "D’une manière faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fea9e79-66f1-45be-8f48-08adab7dab91",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Nos malheurs jusqu'ici vous touchent faiblement."
                                            },
                                            {
                                                "example_id": "65b86657-f031-4316-a654-68af1fb43f99",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Que le cœur d’une femme est mal connu de vous, Et que vous savez peu ce qu’il veut faire entendre, Lorsque si faiblement on le voit se défendre !"
                                            },
                                            {
                                                "example_id": "1a34a869-ed44-4ae3-96fd-cf3b4b2bbfff",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Rome s'accroissait, mais faiblement."
                                            },
                                            {
                                                "example_id": "a4b8fef1-48cf-4baf-b2bd-0b378efc9451",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il faut prendre sur soi certaines choses décisives où l’on ne peut vous conseiller que faiblement."
                                            },
                                            {
                                                "example_id": "3e783c80-b78a-49fe-a1aa-666bd1f3bca7",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je m’en plaignis, mais si faiblement que je n'insistai point."
                                            },
                                            {
                                                "example_id": "bcd5a1ba-a5bb-4f21-91d2-0d3817a77d33",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Après cette paix, la France se rétablit faiblement."
                                            },
                                            {
                                                "example_id": "717a70bf-75e9-4639-ac73-4b4dac49a498",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Le marquis d’Argens vient d’imprimer à Berlin le discours de l’empereur Julien contre les Galiléens, discours à la vérité un peu faible, mais beaucoup plus faiblement réfuté par saint Cyrille."
                                            },
                                            {
                                                "example_id": "f8eb718e-c0a9-4072-8e3b-a248b6fd47d5",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je me croirais haï, d’être aimé faiblement."
                                            },
                                            {
                                                "example_id": "a9bd1883-1ce0-4d91-9fba-b0e426d9ac17",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "J'ai peur que la raison, l’amitié filiale Combattent faiblement l’illusion fatale."
                                            },
                                            {
                                                "example_id": "9d8a9543-88ae-4ee2-9257-05b939eb2ce2",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "C'est la plus faiblement écrite de mes pièces de théâtre, mais la plus pathétique."
                                            },
                                            {
                                                "example_id": "83f09052-3857-46ad-b747-67b551d26a65",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2613bf77-bbb2-4126-84c8-61d9a36ebc0e",
                        "source_entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "source_sense_description": "с большим трудом",
                        "target_lang_word": "avec peine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avec peine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "977b291d-313b-3387-b4f2-4c31b7e1fbca",
                                        "entry_id": "482d71ff-0241-3d6c-9b0b-02a83cda7634",
                                        "glosses": [
                                            "Avec difficulté, avec effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b0b25b3-295b-4e19-a3e9-4b00065821c3",
                                                "sense_id": "977b291d-313b-3387-b4f2-4c31b7e1fbca",
                                                "text": "Au lieu de courir comme autrefois, elle traînait ses pieds avec peine et ne paraissait même plus coquette"
                                            },
                                            {
                                                "example_id": "460779fc-3e3a-492c-b219-2991cadfa653",
                                                "sense_id": "977b291d-313b-3387-b4f2-4c31b7e1fbca",
                                                "text": "Le soleil avait déjà décrit la moitié de sa courbe et il ne réchauffait qu’avec peine l’air de l’hiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89dd582b-499c-4eaf-becf-720e940b002c",
                        "source_entry_id": "41ea9a40-2b17-3b3a-9fc0-f1161035a786",
                        "source_sense_description": "с большим трудом",
                        "target_lang_word": "péniblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péniblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c7f17e-612b-4d24-9d06-49075e5822a3",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Péniblement, il se releva et regagna, en trébuchant, sa place."
                                            },
                                            {
                                                "example_id": "f01698ba-845b-443f-83bd-ae1415e42950",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Quand Jacques parut, les malades se levèrent, quelques-uns péniblement, et saluèrent militairement, gauches."
                                            },
                                            {
                                                "example_id": "bd8d6a43-cd0b-42ad-9505-a5b2665b5284",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Selon une autre version, Isaac aurait habité un port de mer où il gagnait péniblement sa vie comme arrimeur."
                                            },
                                            {
                                                "example_id": "ca5a1ea0-5ff8-40ac-8784-e94ccc7a30be",
                                                "sense_id": "9fd89339-84f7-36be-924b-b51f063c96d0",
                                                "text": "Quand tante Claire donnait le signal du départ, Vincent bougonnait que les femmes étaient des casseuses de veillée. Il finissait par se lever péniblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cd5fac-8c48-3494-a864-70d45f696cc0",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e426394-aedb-4c8c-838b-aece60e48ad8",
                                                "sense_id": "88cd5fac-8c48-3494-a864-70d45f696cc0",
                                                "text": "Il parlait mal et péniblement notre langue,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                        "entry_id": "325ea42b-a5da-3195-95e6-889147a56da9",
                                        "glosses": [
                                            "Avec difficulté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d825f20-aa9e-4587-bb58-8c2fae6e8b59",
                                                "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                                "text": "[…] ; la cellulose, restant polymérisée à son degré maximum, ne se dissout alors que péniblement dans l'ammoniure de cuivre."
                                            },
                                            {
                                                "example_id": "a2ab21d7-a0f8-44cd-a770-a13425a10d0d",
                                                "sense_id": "ebede1f4-d647-349c-b535-8a1402ae95c1",
                                                "text": "La rue de Normandie est une de ces vieilles rues à chaussée fendue, où la ville de Paris n’a pas encore mis de bornes-fontaines, et dont le ruisseau noir roule péniblement les eaux ménagères de toutes les maisons, qui s’infiltrent sous les pavés et y produisent cette boue particulière à la ville de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "3dd9ec3a-f2d0-437f-8f8d-0311c1ea370e",
