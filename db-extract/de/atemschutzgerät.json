                "senses": [
                    {
                        "sense_id": "099f38b8-4213-3799-a9e0-2374a9644854",
                        "entry_id": "8a9104e0-495d-3c44-8b13-a17da48c9438",
                        "glosses": [
                            "Gerät mit Sauerstoffmaske, durch welches das Atmen in verschmutzter Luft ermöglicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10511604-db1d-467f-9e63-3d12562159f3",
                                "sense_id": "099f38b8-4213-3799-a9e0-2374a9644854",
                                "text": "„Darüber hinaus enthält das Kaschagan-Öl eine so hohe Konzentration an Schwefelwasserstoff, dass die Arbeiter Atemschutzgeräte tragen müssen.“"
                            },
                            {
                                "example_id": "dcfe8136-581b-43e1-80a4-a201afe208bd",
                                "sense_id": "099f38b8-4213-3799-a9e0-2374a9644854",
                                "text": "„Ich würde nicht zulassen, dass Brown Jenkin ihn in seine Klauen bekam, ob mit oder ohne Atemschutzgerät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
