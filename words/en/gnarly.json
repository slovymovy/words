                                "ru": "Команда всю ночь пыталась решить <w>заковыристую</w> проблему в программном коде."
                            }
                        },
                        {
                            "text": "Driving through the mountains during the blizzard was a truly <w>gnarly</w> experience for everyone.",
                            "target_lang_translations": {
                                "ru": "Поездка через горы во время метели была по-настоящему <w>жестким</w> испытанием для всех."
                            }
                        }
                    ],
                    "synonyms": [
                        "nasty"
                    ],
                    "antonyms": [
                        "easy",
                        "simple"
                    ],
                    "common_phrases": [
                        "gnarly problem",
                        "gnarly situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe intense or difficult situations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опасный, трудный или бросающий вызов; требующий больших усилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жесткий",
                                "target_lang_sense_clarification": "о ситуации или проблеме"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "об условиях или опыте"
                            },
                            {
                                "target_lang_word": "заковыристый",
                                "target_lang_sense_clarification": "о сложной задаче"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad8e3610-c6a8-3ecb-8b7c-92d9474dc02e",
                    "sense_definition": "Unpleasant, awful, or physically ugly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negative_evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>gnarly</w> scar running down his cheek from the accident years ago.",
                            "target_lang_translations": {
                                "ru": "У него на щеке был <w>жуткий</w> шрам, оставшийся после аварии много лет назад."
                            }
                        },
                        {
                            "text": "The kitchen was in a <w>gnarly</w> state after the party, with food spilled everywhere.",
                            "target_lang_translations": {
                                "ru": "После вечеринки кухня была в <w>ужасном</w> состоянии: повсюду была разбросана еда."
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "dreadful",
                        "nasty"
                    ],
                    "antonyms": [
                        "beautiful",
                        "pleasant"
                    ],
                    "common_phrases": [
                        "gnarly scar",
                        "gnarly injury"
                    ],
                    "traits": [
