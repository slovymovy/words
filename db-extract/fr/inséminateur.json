                        "glosses": [
                            "Qui possède la capacité d’inséminer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b6d307-ade0-4740-a662-40261ff73d62",
                                "sense_id": "21c9262d-59a6-39df-b724-159dfde83d72",
                                "text": "Propagation de la mycorrhization par la truffe à partir de racines excisées et de plantules inséminatrices."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc2bcb65-a52d-3745-8fef-c618ba2953cc",
                        "entry_id": "f4e43712-a516-3b63-ba3e-1395363259a5",
                        "glosses": [
                            "Relatif à l'insémination artificielle."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "557097e6-4ee7-4b82-a16b-769efbd056d8",
                                "sense_id": "bc2bcb65-a52d-3745-8fef-c618ba2953cc",
                                "text": "On les utilise avec un pistolet inséminateur ([…]). Il existe deux types de paillettes : danoise et française.\nLa paillette danoise est en cellophane ; elle est paraffinée intérieurement et fermée à une extrémité par un tampon de coton."
                            }
                        ]
                    }
