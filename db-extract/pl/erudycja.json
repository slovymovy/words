                ],
                "senses": [
                    {
                        "sense_id": "ad07c1d0-9483-3133-8f1c-aaf2ba298c6a",
                        "entry_id": "438dc3e6-411e-3549-b2f4-0ab0168b12b5",
                        "glosses": [
                            "rozległy zasób książkowej wiedzy; gruntowne wykształcenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d8843f-401a-44bf-9b73-3adb91707c46",
                                "sense_id": "ad07c1d0-9483-3133-8f1c-aaf2ba298c6a",
                                "text": "Dzięki swojej erudycji mógłby brać udział w dyskusjach praktycznie z dowolnym rozmówcą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5e5d7df-4551-417a-b697-c362bd133345",
                        "source_entry_id": "438dc3e6-411e-3549-b2f4-0ab0168b12b5",
                        "source_sense_id": "ad07c1d0-9483-3133-8f1c-aaf2ba298c6a",
                        "target_lang_word": "erudition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erudition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b79c7be5-e148-365a-ac2f-8d814332e9bc",
                                        "entry_id": "046391b0-271b-3751-9275-3170210944e8",
                                        "glosses": [
                                            "Profound knowledge acquired from learning and scholarship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d23cf0-fcfe-47a4-90ae-3798b90c4c38",
                                                "sense_id": "b79c7be5-e148-365a-ac2f-8d814332e9bc",
                                                "text": "Professor Archimedes Q. Porter was their only immediate anxiety. Fully assured in his own mind that his daughter had been picked up by a passing steamer, he gave over the last vestige of apprehension concerning her welfare, and devoted his giant intellect solely to the consideration of those momentous and abstruse scientific problems which he considered the only proper food for thought in one of his erudition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4906a857-443a-311a-8252-9029962e612c",
                                        "entry_id": "046391b0-271b-3751-9275-3170210944e8",
                                        "glosses": [
                                            "The refinement, polish and knowledge that education confers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb1be215-c95a-4bac-ae17-b29d2cc7b1ba",
                        "source_entry_id": "438dc3e6-411e-3549-b2f4-0ab0168b12b5",
                        "source_sense_id": "ad07c1d0-9483-3133-8f1c-aaf2ba298c6a",
                        "target_lang_word": "érudition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "érudition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                        "entry_id": "2eb77444-3e72-3850-9129-2753d1b1ed1b",
                                        "glosses": [
                                            "Savoir minutieux dans un domaine restreint d'histoire littéraire, de la philologie classique, en histoire événementielle, ou dans les sciences annexes de l’histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebf6cd6-e59a-4138-bc76-f1eee522dd4d",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "Vaste, solide érudition. Érudition mal digérée, sans critique, dénuée de critique. Une érudition poussiéreuse, mal contrôlée et gonflante. Ouvrages d’érudition. Travaux d’érudition. Recherches d’érudition."
                                            },
                                            {
                                                "example_id": "1202978d-b3ed-41e3-ac45-7cea3211fb8e",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "L'érudition ne remplace pas le génie. (Schopenhauer)"
                                            },
                                            {
                                                "example_id": "6f381fef-121f-4c10-9f0e-9b359c40ea74",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "Il ne faudrait pas croire cependant que Rarahu fût sans érudition; elle savait lire dans sa bible tahitienne, et écrire, avec une grosse écriture très ferme, les mots doux de la langue maorie; elle était même très forte sur l'orthographe conventionnelle fixée par les frères Picpus, – lesquels ont fait, en caractères latins, un vocabulaire des mots polynésiens."
                                            },
                                            {
                                                "example_id": "8b947374-c69e-4e6b-9d71-b1ed45254307",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "Il est constant que le texte le plus inintelligible a toujours un sens pour celui qui le traduit. Sans cela l’érudition n’aurait point de raison d’être."
                                            },
                                            {
                                                "example_id": "103e5f69-e6f0-471f-8168-b960973b4ef6",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "Il avait eu comme condisciple à Stanislas Marcel Bouteron, grand spécialiste de Balzac ; il en parlait avec commisération : il trouvait dérisoire que l’on consumât sa vie dans de poussiéreux travaux d’érudition."
                                            },
                                            {
                                                "example_id": "e72d35f4-fd00-4ee3-8608-d45af8ac3ea1",
                                                "sense_id": "46a579c6-0e2c-35a5-afd2-f916ce71437e",
                                                "text": "Ne valait-il pas mieux s’abstenir de toute étude que de s’embarrasser d’érudition ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c48088-d707-3314-b02c-d4e3d40b0f7f",
                                        "entry_id": "2eb77444-3e72-3850-9129-2753d1b1ed1b",
                                        "glosses": [
                                            "L’ensemble des érudits (en un domaine donné)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1de4353-0ea8-4e5e-a125-f7b2c8ba5631",
                                                "sense_id": "f3c48088-d707-3314-b02c-d4e3d40b0f7f",
                                                "text": "Cette recension sera en même temps un éloge funèbre; l’auteur, frappé d’un coup subit et ridicule du sort, ne saura pas ce que l’érudition pense de son livre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
