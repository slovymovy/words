                        "examples": [
                            {
                                "example_id": "b507ce9f-41e5-4d81-bcb0-470ed1f32fff",
                                "sense_id": "78959879-3113-3282-a051-a7ab35d33e72",
                                "text": "Хоана, Хоана. — Что ты делаешь? — строго спросила Кристина, в то время как испанец доставал из кармана ручку и записную книжку."
                            }
