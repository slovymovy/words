                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "604baed8-2060-4736-9f9a-c69a41a1fa85",
                                                "sense_id": "9541610d-4c3c-3e1a-a3c9-57adfeebdb4f",
                                                "text": "Our stowage disappeared down the chute, into the employee only cargo area, never to be seen again by man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad72907-9556-3bd3-877d-6d96e6c3b5c5",
                                        "entry_id": "c4039df8-3081-346e-b020-1a2c2a16955d",
                                        "glosses": [
                                            "Amount of room for storing things."
                                        ],
                                        "tags": [
