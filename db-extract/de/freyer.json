                ],
                "senses": [
                    {
                        "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                        "entry_id": "d731ef45-696b-3785-b37c-735a1ad85160",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec53558-3ce3-4b1d-a88e-3024c071f01b",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Frau Freyer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8e7a32b3-6204-45aa-ae07-57d773a2252c",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Herr Freyer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "78e0cfe9-523f-4caa-83ce-1f5eacfc7d52",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Die Freyers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "98b0bcb6-a536-4f94-ac3e-477d308c2612",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Der Freyer trägt nie die Schals, die die Freyer ihm strickt."
                            },
                            {
                                "example_id": "293647d9-2073-4f80-9db8-e0b25a7c5ff5",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Freyer kommt, geht der Herr Freyer.“"
                            },
                            {
                                "example_id": "fbf0fcff-d9eb-4522-95d6-2d43deca3330",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Freyer kommt und geht."
                            },
                            {
                                "example_id": "983ffd6a-b63b-43c3-bd39-5e1571ec1487",
                                "sense_id": "82103382-f341-38ec-8463-9b6e159516eb",
                                "text": "Freyers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
