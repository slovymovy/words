                        "sévèrement touché"
                    ]
                },
                {
                    "sense_id": "3a443487-a48c-3443-92f3-e23b81797ef1",
                    "sense_definition": "Beaucoup, fortement ou de façon excessivement pénible.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit incessant du marteau-piqueur commence à taper <w>sévèrement</w> sur le système des voisins."
