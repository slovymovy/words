                                        "entry_id": "265c65de-95b5-3b15-8ac3-b3086e9a8f98",
                                        "glosses": [
                                            "pronome personale; si riferisce a una o più persone, animali o cose già nominate in precedenza:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22a09b1-6b93-4a6d-82e1-b2e91fc4f21e",
                                                "sense_id": "1f6129dd-3b13-3a91-9984-e12ad077aa2c",
                                                "text": "C'era tanta gente? - Non ne ho vista molta."
                                            },
                                            {
                                                "example_id": "70eee881-c56e-4d5e-b072-353bae82f428",
                                                "sense_id": "1f6129dd-3b13-3a91-9984-e12ad077aa2c",
                                                "text": "Hai comprato le tazzine? - Ne ho comprate due."
                                            },
                                            {
                                                "example_id": "895bc197-c55f-480d-9dc1-574b90ea70a4",
                                                "sense_id": "1f6129dd-3b13-3a91-9984-e12ad077aa2c",
                                                "text": "Quante cianfrusaglie! - La soffitta ne era piena."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
