                "senses": [
                    {
                        "sense_id": "4a42b4bc-b6f4-3b8c-9e41-64a2643f8ff4",
                        "entry_id": "16b7cc2a-8fbe-34b3-8240-f6e662f67ba4",
                        "glosses": [
                            "Entwicklung des gesamten Pflanzen- und Tierreiches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f38f83-582f-4b20-ada9-03cf8a33903d",
                                "sense_id": "4a42b4bc-b6f4-3b8c-9e41-64a2643f8ff4",
                                "text": "Nach der nicht mehr gültigen biogenetischen Grundregel von Ernst Haeckel stellt die Ontogenese eine kurze Rekapitulation der Phylogenese dar."
                            },
                            {
                                "example_id": "b3f9c13e-baf9-4f5c-b34b-6354153f0e10",
                                "sense_id": "4a42b4bc-b6f4-3b8c-9e41-64a2643f8ff4",
                                "text": "„Er stellt aber nur das individuelle, also ontogenetische Analogon zur Phylogenese, also der Entwicklungsgeschichte der gesamten Gattung dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
