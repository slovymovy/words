    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                "word": "perceptible",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3f20abf3-692a-4623-962d-e8ab3af0565c",
                        "entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more perceptible"
                    },
                    {
                        "form_id": "75cef76d-00a6-498e-89d9-f0d1a11538cd",
                        "entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most perceptible"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                        "entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "glosses": [
                            "Able to be perceived, sensed, or discerned."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3924da3f-2ac3-48c2-80bc-3deef2f15b68",
                                "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                                "text": "Her voice was barely perceptible over the noise, but her gestures made her meaning clear."
                            },
                            {
                                "example_id": "9f2059cd-e815-47a4-8ff7-0c3e8e556de3",
                                "sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes.[…]But withal there was a perceptible acumen about the man which was puzzling in the extreme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04959f0d-13a3-4fcf-954c-af5ac171d829",
                        "source_entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "source_sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                        "source_sense_description": "able to be perceived",
                        "target_lang_word": "perceptible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perceptible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9abe314-3ee9-31db-a974-5d5716dacb08",
                                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                                        "glosses": [
                                            "Qui peut être perçu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f1aee0-24ac-4250-9025-2cec750668a5",
                                                "sense_id": "d9abe314-3ee9-31db-a974-5d5716dacb08",
                                                "text": "Un impôt perceptible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                                        "glosses": [
                                            "Qui peut être perçu par les sens."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ac5a0b7-f7c7-44c4-b892-3ab3ea86082a",
                                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                                "text": "Le mouvement du ballon, son trajet sinueux, ses plongeons et ses remontées, étaient nettement perceptibles, et l’incessante trépidation des moteurs semblait se ralentir et s’accélérer tour à tour."
                                            },
                                            {
                                                "example_id": "ce1fd2f9-d5ff-4a4e-ae43-0b7e3c5a7483",
                                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                                "text": "En réalité, au delà de l'octroi, sans interruption perceptible, s'étale une zone de grosses communes industrielles où la population est de 65 000 âmes."
                                            },
                                            {
                                                "example_id": "fd702261-20f1-451b-948e-2fc5de3f1ab6",
                                                "sense_id": "8fdc54a5-1b93-36a5-b1c1-b68bad916941",
                                                "text": "L'haleine de la mousson d'été s'était faite moins chaude, quoique encore des éclairs lointains fulgurassent et illuminassent la mer, sans coups de tonnerre perceptibles, là-bas, vers la côte d'Asie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ebc3e63-d355-340b-b8fe-c5bb84000575",
                                        "entry_id": "1e633495-479d-38df-803e-34f180c601b3",
                                        "glosses": [
                                            "Ce qui peut être perçu par l’esprit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4a5967-6c93-44c9-87ee-1f9a50754e20",
                                                "sense_id": "1ebc3e63-d355-340b-b8fe-c5bb84000575",
                                                "text": "Il y a dans son discours une ironie à peine perceptible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c89f499-90db-43c2-bc43-40ea4f2f029f",
                        "source_entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "source_sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                        "source_sense_description": "able to be perceived",
                        "target_lang_word": "wahrnehmbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wahrnehmbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e40f7531-7fcb-3d7a-94dd-58af83b2c68e",
                                        "entry_id": "0d2bbc43-b60d-3a73-b929-cfe6044f8cb5",
                                        "glosses": [
                                            "so, dass es der Wahrnehmung/den Sinnen zugänglich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7997feb8-3fe5-45a3-9640-a1b050599bad",
                                                "sense_id": "e40f7531-7fcb-3d7a-94dd-58af83b2c68e",
                                                "text": "Das Kätzchen machte kaum wahrnehmbare Geräusche."
                                            },
                                            {
                                                "example_id": "f5dddcff-fc54-411c-86e3-fe7f056129b6",
                                                "sense_id": "e40f7531-7fcb-3d7a-94dd-58af83b2c68e",
                                                "text": "Die Farbunterschiede sind gerade noch wahrnehmbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e93a6c47-0901-4fef-82ff-b0718edaeb27",
                        "source_entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "source_sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                        "source_sense_description": "able to be perceived",
                        "target_lang_word": "spürbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spürbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                        "entry_id": "5b41c3dc-278d-3d42-bca6-44d6410096d9",
                                        "glosses": [
                                            "so, dass man es körperlich wahrnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab8f933-8fff-408a-a034-4c421c6593fe",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "Der Schlag war zwar schwach, aber noch spürbar."
                                            },
                                            {
                                                "example_id": "132ba6bb-c18f-40e9-a276-17fe53866136",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "Es wird zu spürbaren Kürzungen der Sozialleistungen kommen."
                                            },
                                            {
                                                "example_id": "ae131761-2520-4f5d-a62a-18d326bdc357",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "„Die spürbarsten Einschnitte für Normalverdiener gibt es beim Elterngeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba8dc88f-a38c-3df7-a5a7-e4bc2b818ded",
                                        "entry_id": "5b41c3dc-278d-3d42-bca6-44d6410096d9",
                                        "glosses": [
                                            "innerlich wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f922ecfd-13b0-4a0b-bd86-e3aa3ea3fa6a",
                        "source_entry_id": "074ddd0b-749b-3419-8c7c-405bf8fab72c",
                        "source_sense_id": "6b5f1945-2e92-3556-944e-e937cf5a0f46",
                        "source_sense_description": "able to be perceived",
                        "target_lang_word": "fühlbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fühlbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                        "entry_id": "ded493d9-0ad5-361c-a60b-0fd98d17bc6b",
                                        "glosses": [
                                            "so, dass es sich leicht erkennen oder bemerken lässt; deutlich wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82aab2c6-52e9-4b75-a260-1c71f8c1a131",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "Die Spannung im Raum war deutlich, fast körperlich, fühlbar."
                                            },
                                            {
                                                "example_id": "11ebd02e-9bac-4885-b58c-82bbe9deb6f7",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "[Im Knast] wird die Enge fühlbar, ebenso wie die Unmöglichkeit auszuweichen. Jeder Sinn ist betroffen."
                                            },
                                            {
                                                "example_id": "926e698f-6719-4c61-a8c5-4f564b10236b",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "[…] der Südostasienwissenschaftler Carlyle Thayer [schreibt] in einer Analyse der chinesisch-vietnamesischen Beziehungen 2011: „Es gibt fühlbar anti-chinesische Ressentiments in großen Teilen der politischen Elite Vietnams.[…]“"
                                            },
                                            {
                                                "example_id": "0a7d40cf-84c1-4b7f-bfed-e71ce2b57801",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "„Das ist das Blut meines Freundes Joseph. Er lag auf mir, als er starb. Sein Körper hat mich geschützt“, sagt der alte Mann unvermittelt. Die grausame Erfahrung, die Tat [des Massakers von Oradour durch die deutsche Waffen-SS] ist plötzlich ganz nah, fühlbar geworden."
                                            },
                                            {
                                                "example_id": "d4ee18c0-9f6d-4c50-827d-34e1a12f5ce2",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "Überschrift: Die Skirennfahrer Hirscher und Kristoffersen - Wo Selbstsicherheit fühlbar ist - Marcel Hirscher und Henrik Kristoffersen gewinnen die Rennen in Val-d'Isère. Ihre Überlegenheit ist offensichtlich – ebenso ihr Selbstbewusstsein. Sie haben andere Ansprüche als die meisten Gegner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                        "entry_id": "ded493d9-0ad5-361c-a60b-0fd98d17bc6b",
                                        "glosses": [
                                            "körperlich durch die Sinne, insbesondere den Tastsinn, wahrnehmen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8d04bb-8c9f-44de-8699-fa8d043e1513",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Sie lag im Sterben, ihr Puls war kaum noch fühlbar."
                                            },
                                            {
                                                "example_id": "51157c4b-fbf7-4e70-ba5e-9feba5e2c193",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Wind ist nicht sicht-, aber fühlbar."
                                            },
                                            {
                                                "example_id": "afed14b1-cdb9-433c-959a-d434810d7ff5",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Die Hitze lastet bleischwer auf der Ruhrgebietsstadt [Dortmund], von den Temperaturen her machen Tag und Nacht kaum einen fühlbaren Unterschied […]"
                                            },
                                            {
                                                "example_id": "dc064135-0d2b-465b-b948-47bc401bd2b1",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Die Patienten [einer Alkoholerkrankung] haben eine fühlbar vergrößerte Leber, sind aber meist beschwerdefrei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
