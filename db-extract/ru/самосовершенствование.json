                    },
                    {
                        "translation_id": "2376c775-bdf6-4568-941a-b8ea53b57006",
                        "source_entry_id": "2a19bddc-8c37-3393-8aac-172e734002ac",
                        "source_sense_description": "сознательное развитие в себе каких-либо положительных качеств, способностей, умений",
                        "target_lang_word": "self-improvement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-improvement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45326b5f-81a4-3eee-8e14-f45cf1c04560",
                                        "entry_id": "686ec220-275a-39f0-8f85-f75850c5a686",
                                        "glosses": [
                                            "The following of a disciplined programme to improve one's physical health, mental health or character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86b83700-8ae4-421a-a9dd-0d4d3450e8d2",
                                                "sense_id": "45326b5f-81a4-3eee-8e14-f45cf1c04560",
                                                "text": "He believes that self-improvement and its growing popularity are symptoms of what he calls individualism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c4156d-2d57-3b08-a25b-6fd44417ed93",
                                        "entry_id": "686ec220-275a-39f0-8f85-f75850c5a686",
                                        "glosses": [
                                            "The bettering of one's status."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74859433-e535-495d-b8eb-55651c286452",
                                                "sense_id": "a9c4156d-2d57-3b08-a25b-6fd44417ed93",
                                                "text": "In the year 1851 a small group of workmen in the Locomotive Department of the old Midland Railway Company at Derby met for self-improvement, and formed what was then known as a \"reading society\"."
                                            },
                                            {
                                                "example_id": "bf3fc66b-da51-4bdb-8dd5-e7b43f890de4",
                                                "sense_id": "a9c4156d-2d57-3b08-a25b-6fd44417ed93",
                                                "text": "Ambition and self-improvement are certainly not negatives, although one potential downside to being more self-conscious—especially for punk bands—is muted urgency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
