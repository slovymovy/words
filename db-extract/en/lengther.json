                        "examples": [
                            {
                                "example_id": "65fa1125-d91c-49dd-bd94-27b4b12d6c51",
                                "sense_id": "ddfbe00f-4827-35bb-a800-cf48b427e88b",
                                "text": "This year, the London terpsters are offering only two of their famous full-lengthers, Swan Lake and Sleeping Princess, altho their own two-act version of Giselle will get a preem unveiling here."
                            },
                            {
                                "example_id": "1906b14b-6292-406b-a462-26cd6f0ac287",
                                "sense_id": "ddfbe00f-4827-35bb-a800-cf48b427e88b",
                                "text": "A mix of Fenwick, G. Loomis, and Deerfield rods, there are almost as many even-lengthers (7's, 8's, etc.) designed for the same lines."
                            },
                            {
                                "example_id": "b54a61ee-bd4f-408d-ab8c-e3e58f02b131",
                                "sense_id": "ddfbe00f-4827-35bb-a800-cf48b427e88b",
                                "text": "The editor called the new \"novels\" book-lengthers without the trivialities and slow development of the usual novel. \"They have all the plot complications, meat and excitement that readers demand,\" he stated."
                            }
                        ]
                    }
