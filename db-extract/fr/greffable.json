                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91871df9-b2bc-40af-94be-54b70ea31dda",
                                "sense_id": "282c29e3-959a-3227-8995-834fa19297be",
                                "text": "Les boutures-pépinières sont coupées à 0,55 m environ et talonnées comme les boutures greffables."
                            },
                            {
                                "example_id": "5bf19469-06ae-46a1-9590-933dcedda2d5",
                                "sense_id": "282c29e3-959a-3227-8995-834fa19297be",
                                "text": "Car jusqu’ici, au-delà de quelques minutes d’arrêt circulatoire, les organes n'étaient plus greffables, explique le docteur Jean-Etienne Bazin, chef du pôle de médecine périopératoire du CHU de Clermont-Ferrand."
                            }
                        ]
                    },
