{
    "word_family": [
        "stomper",
        "stomping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "427030b6-64fa-3b5f-9248-ce568c45f4e0",
                    "sense_definition": "To walk with heavy, forceful steps, often to show anger or to make noise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer began to <w>stomp</w> toward the double doors after the argument.",
                            "target_lang_translations": {
                                "ru": "Разгневанный покупатель начал <w>топать</w> к двойным дверям после спора.",
                                "zh": "争吵后，那位愤怒的顾客开始<w>跺脚走</w>向双开门。"
                            }
                        },
                        {
                            "text": "I could hear him <w>stomp</w> upstairs because the floorboards are very thin.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как он <w>топочет</w> наверху, потому что половицы очень тонкие.",
                                "zh": "我能听见他在楼上<w>重步走</w>，因为地板很薄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stamp",
                        "clomp"
                    ],
                    "common_phrases": [
                        "stomp upstairs",
                        "stomp around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти тяжелыми, решительными шагами, часто выражая гнев или создавая шум.",
                        "zh": "指用力且沉重地行走，通常用来表达愤怒或制造噪音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "идти с шумом"
                            },
                            {
                                "target_lang_word": "топотать",
                                "target_lang_sense_clarification": "громко шагать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跺脚走",
                                "target_lang_sense_clarification": "带有情绪地重重行走"
                            },
                            {
                                "target_lang_word": "重步走",
                                "target_lang_sense_clarification": "发出沉重脚步声的行走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "412b27bd-ae87-3e6f-bce5-bc174f8efa91",
                    "sense_definition": "To bring down one's foot forcibly onto the ground or an object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child started to <w>stomp</w> his feet in a temper tantrum.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>топать</w> ногами в приступе гнева.",
                                "zh": "孩子发脾气时开始<w>跺</w>脚。"
                            }
                        },
                        {
                            "text": "You need to <w>stomp</w> on the pedal to make the machine start.",
                            "target_lang_translations": {
                                "ru": "Вам нужно сильно <w>наступить</w> на педаль, чтобы запустить машину.",
                                "zh": "你需要用力<w>踩</w>踏板才能启动机器。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp your feet",
                        "stomp on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить ногой по земле или какому-либо предмету.",
                        "zh": "用力将脚踩在地面或物体上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топнуть",
                                "target_lang_sense_clarification": "однократное действие ногой"
                            },
                            {
                                "target_lang_word": "наступить",
                                "target_lang_sense_clarification": "с силой нажать ногой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跺",
                                "target_lang_sense_clarification": "用力踩地"
                            },
                            {
                                "target_lang_word": "踩",
                                "target_lang_sense_clarification": "用力踏下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0fa64c8-767e-30e2-ab46-7da943499916",
                    "sense_definition": "To crush grapes with one's feet as a traditional method of making wine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "crushing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, workers would <w>stomp</w> grapes in large wooden vats.",
                            "target_lang_translations": {
                                "ru": "В прежние времена рабочие <w>давили</w> виноград в больших деревянных чанах.",
                                "zh": "过去，工人们会在大木桶里<w>踩踏</w>葡萄。"
                            }
                        },
                        {
                            "text": "The festival allows tourists to <w>stomp</w> grapes just like they did centuries ago.",
                            "target_lang_translations": {
                                "ru": "Фестиваль позволяет туристам <w>топтать</w> виноград точно так же, как это делали столетия назад.",
                                "zh": "这个节日允许游客像几个世纪前的人那样<w>踩踏</w>葡萄。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp grapes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давить виноград ногами как традиционный метод виноделия.",
                        "zh": "一种传统的酿酒方法，即用脚踩踏葡萄以榨取汁液。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "ногами виноград"
                            },
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "приминать ногами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踩踏",
                                "target_lang_sense_clarification": "用脚压榨葡萄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091f5f44-58c8-3215-934e-ea5c329ca65f",
                    "sense_definition": "To completely defeat or overwhelm an opponent, especially in a competition or sports.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team managed to <w>stomp</w> the competition in the final round of the tournament.",
                            "target_lang_translations": {
                                "ru": "Нашей команде удалось <w>разгромить</w> конкурентов в финальном раунде турнира.",
                                "zh": "我们的队伍在锦标赛决赛中成功<w>完胜</w>了对手。"
                            }
                        },
                        {
                            "text": "They expected a close game, but the home team proceeded to <w>stomp</w> their rivals.",
                            "target_lang_translations": {
                                "ru": "Они ожидали равной игры, но хозяева поля <w>растоптали</w> своих соперников.",
                                "zh": "他们本以为比赛会很胶着，但主队随后<w>碾压</w>了对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp the competition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a decisive victory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью победить или разгромить противника, особенно в соревновании или спорте.",
                        "zh": "在比赛或竞争中彻底击败或压倒对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "одержать полную победу"
                            },
                            {
                                "target_lang_word": "растоптать",
                                "target_lang_sense_clarification": "переносное значение поражения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完胜",
                                "target_lang_sense_clarification": "彻底击败对手"
                            },
                            {
                                "target_lang_word": "碾压",
                                "target_lang_sense_clarification": "以绝对优势获胜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b01e890-ea83-34c2-b30b-b237108217f8",
                    "sense_definition": "To severely beat someone physically or figuratively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened to <w>stomp</w> anyone who got in his way.",
                            "target_lang_translations": {
                                "ru": "Хулиган угрожал <w>избить</w> любого, кто встанет у него на пути.",
                                "zh": "那个恶霸威胁说要<w>暴打</w>任何挡他路的人。"
                            }
                        },
                        {
                            "text": "The critics will <w>stomp</w> that movie because the acting is so poor.",
                            "target_lang_translations": {
                                "ru": "Критики <w>растопчут</w> этот фильм, потому что актерская игра очень слабая.",
                                "zh": "影评人会<w>痛批</w>那部电影，因为演员的表演太差了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crush"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often implies physical violence or harsh criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко избить кого-либо физически или подвергнуть резкой критике.",
                        "zh": "指对他人的身体进行暴力殴打，或对其进行严厉的批评。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избивать",
                                "target_lang_sense_clarification": "физическое насилие"
                            },
                            {
                                "target_lang_word": "растоптать",
                                "target_lang_sense_clarification": "жестоко раскритиковать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴打",
                                "target_lang_sense_clarification": "身体上的暴力行为"
                            },
                            {
                                "target_lang_word": "痛批",
                                "target_lang_sense_clarification": "严厉的言语批评"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
