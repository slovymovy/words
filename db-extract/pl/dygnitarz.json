                ],
                "senses": [
                    {
                        "sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "glosses": [
                            "ktoś piastujący wysoki urząd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4370b8d0-66a4-4204-bf10-e3acc97ac67c",
                                "sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                                "text": "Był zbyt wysoko postawionym dygnitarzem partyjnym szczebla wojewódzkiego i gmina to nie był jego poziom"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c020e608-7000-41a1-95ec-bc890d5732de",
                        "source_entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "source_sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "target_lang_word": "dignitary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54c5545a-97dc-388c-9668-53dec668975c",
                                        "entry_id": "f43bda07-3c73-399b-9a54-dc7e4698bb78",
                                        "glosses": [
                                            "An important or influential person, or one of high rank or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be46d0ae-3cf1-4c33-8247-77091febee9a",
                                                "sense_id": "54c5545a-97dc-388c-9668-53dec668975c",
                                                "text": "Chinese dignitaries traveled with us from place to place, and when ready to depart from Urumchi, or Tihwa, we were introduced to the high officials who were going along in the plane."
                                            },
                                            {
                                                "example_id": "b2c2911f-d7db-48ab-a009-c691354dfab2",
                                                "sense_id": "54c5545a-97dc-388c-9668-53dec668975c",
                                                "text": "It was a remarkable climax to a match that ended with another of those disappearing acts from John Terry only to re-emerge, in full kit, so he could climb the steps, shake the hands of Eusébio, Michel Platini and all the other dignitaries, then help Frank Lampard to lift the trophy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dignitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "324e1f5d-18a1-380a-a7db-fdb5f0733559",
                                        "entry_id": "9d461881-4e31-3ddd-b1dc-9d9ca428fa4d",
                                        "glosses": [
                                            "Relating to dignity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57778a8d-b0fc-4aac-a305-e7fd7cc91d00",
                                                "sense_id": "324e1f5d-18a1-380a-a7db-fdb5f0733559",
                                                "text": "The badness of a dignitary harm derives from the victim's belief that a perpetrator is willing to override or ignore her standing as a person with rights, with dignity, as evidenced by the wrongful criminal deed; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d547af4-e4a1-4320-a02d-2c6e951d9f1b",
                        "source_entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "source_sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "target_lang_word": "dignitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3c4e46-857e-335e-bbfe-da829c6f15d3",
                                        "entry_id": "6dd858ef-8033-31ac-8951-519e3d3cc9c9",
                                        "glosses": [
                                            "Celui qui est revêtu d’une dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82efad68-4296-4100-92af-da5a2f489a52",
                                                "sense_id": "eb3c4e46-857e-335e-bbfe-da829c6f15d3",
                                                "text": "La propriété individuelle était encore très peu développée. Il y a cinquante ans, les rares propriétaires fonciers étaient des chorfa, des zaouïas, des dignitaires du makhzen qui avaient obtenu leurs terres par dahir chérifien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f30b40-de42-3254-9442-fe9019a035ae",
                                        "entry_id": "6dd858ef-8033-31ac-8951-519e3d3cc9c9",
                                        "glosses": [
                                            "Personne qui a reçu une charge, une fonction ou un titre qui lui confère le respect ou la considération ainsi qu’un rang d’importance dans la société, que ce soit à travers l’État, la religion ou l’armée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39497014-f830-41bf-aff3-d76a1fee96fc",
                                                "sense_id": "71f30b40-de42-3254-9442-fe9019a035ae",
                                                "text": "Ces deux dignitaires étaient suivis de leurs serviteurs respectifs, et, à une plus humble distance, venait leur guide, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0edfa903-5e67-467f-859f-47a7831c78e5",
                        "source_entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "source_sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "target_lang_word": "dignatario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignatario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a33af211-5999-3886-9bb8-76529bc8972b",
                                        "entry_id": "6fc69af8-ff97-3e3a-9abb-d560968081c5",
                                        "glosses": [
                                            "Persona que ocupa un cargo o rango importante o influyente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7954bb57-f7f7-4c77-9bb4-5c8ce9355b23",
                                                "sense_id": "a33af211-5999-3886-9bb8-76529bc8972b",
                                                "text": "Se trajeron, pues, los vasos de oro y plata tomados de la Casa de Dios en Jerusalén, y en ellos bebieron el rey, sus dignatarios, sus mujeres y sus concubinas"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0278ee0-7e1f-4868-839f-54ac5d644864",
                        "source_entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "source_sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "target_lang_word": "Würdenträger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Würdenträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                        "entry_id": "bd9a2a31-f181-36fc-a60b-fa118b9302e7",
                                        "glosses": [
                                            "Person mit einer ranghohen und ehrenvollen Stellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c282f0e4-a334-4a70-ab1c-a56628cfec47",
                                                "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                                "text": "„Barth wirft dem Briten vor, er gefährde das Unternehmen durch allzu große Geldgeschenke an örtliche Würdenträger, verhalte sich in Verhandlungen ungeschickt und sei bei der wissenschaftlichen Arbeit nicht sorgfältig genug.“"
                                            },
                                            {
                                                "example_id": "76737285-4ad0-4585-bf36-aac4164a5044",
                                                "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                                "text": "„Das Galadiner war miserabel, doch die Würdenträger der Republik hatten sich alle versammelt.“"
                                            },
                                            {
                                                "example_id": "2c003b6d-c6d0-4679-967f-c86cb0e7c73a",
                                                "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                                "text": "„Die Würdenträger runzelten die Stirnen.“"
                                            },
                                            {
                                                "example_id": "4898dd48-a22f-49a1-aa36-564ecf423e70",
                                                "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                                "text": "„Zu Hunderten folgen hohe Würdenträger dem Beispiel ihres Königs und bekennen sich ihrerseits zu Jesus Christus.“"
                                            },
                                            {
                                                "example_id": "bb2580cb-d559-46e4-85be-60e432afe635",
                                                "sense_id": "d3e3a134-232f-3351-975f-eea052d9267d",
                                                "text": "„Häufig wird betont, dass die paschtunischen Stammesstrukturen den Einfluss religiöser Würdenträger begrenzten, da Mullahs außerhalb des Stammes ständen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a59af5a-6bc9-4618-9650-b7f9949f5d46",
                        "source_entry_id": "e30ff13e-4cde-3886-86ee-3565d4139c04",
                        "source_sense_id": "b1fa6fef-5de9-3999-8d3b-77eb3edf9291",
                        "target_lang_word": "сановник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сановник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "70905ebd-454b-3268-a5b2-f551854e880d",
                                        "entry_id": "54921875-e6b7-39ab-8ae9-e1c70705a962",
                                        "glosses": [
                                            "устар. влиятельное лицо, обладавшее высоким саном, занимавшее высокое положение в государстве; вельможа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1edf1a8-2090-4fb7-af26-483c9bfd45f9",
                                                "sense_id": "70905ebd-454b-3268-a5b2-f551854e880d",
                                                "text": "Весь следующий день посвящен был визитам; приезжий отправился делать визиты всем городским сановникам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
