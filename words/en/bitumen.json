                    "frequency": "Middle",
                    "semantic_group_id": "petroleum_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers spread hot <w>bitumen</w> over the gravel to create a smooth surface for the highway."
                        },
                        {
                            "text": "A thick coating of <w>bitumen</w> was applied to the roof to prevent water leaks during heavy rain."
                        }
                    ],
                    "common_phrases": [
                        "hot bitumen",
                        "layer of bitumen"
                    ]
                },
                {
                    "sense_id": "0d841aa0-aa6d-3e5a-852e-acdbfe187a40",
