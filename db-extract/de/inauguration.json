                                    {
                                        "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                        "entry_id": "b2533370-9b3a-35eb-b3a0-9416009cf773",
                                        "glosses": [
                                            "de feestelijke of plechtige inwijding in een ambt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5594eaf3-6c4a-453d-91b9-4d68e4be3a06",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "De inauguratie van Barack Obama verliep zonder problemen."
                                            },
                                            {
                                                "example_id": "d4d351e9-e6e8-4e1d-b506-ea389bb3b1d1",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "Honderdduizenden mensen wereldwijd demonstreren zaterdag tegen ongelijkheid en intolerantie naar aanleiding van de inauguratie van de Amerikaanse president Donald Trump"
                                            },
                                            {
                                                "example_id": "a5c19e1c-21b8-44b2-ab09-bc37ef683fe3",
                                                "sense_id": "89d9420b-aa95-3e5d-b081-3cec297ee375",
                                                "text": "De controversiële betrokkenheid van Musk bij de regering van Trump, de openlijke steun van de techmiljardair aan de extreemrechtse partij AfD in Duitsland en een vermeende Hitlergroet van Musk na de inauguratie van Trump, hebben veel Tesla-eigenaren in verlegenheid gebracht"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
