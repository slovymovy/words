                                        "glosses": [
                                            "A male given name from Latin, feminine equivalent Lauren."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce07d739-a40e-4244-9263-745ba30e7eb4",
                                                "sense_id": "d4252c24-ada7-3b79-9a0d-06e50bd92267",
                                                "text": "Romeo: Bid her devise / Some means to come to shrift this afternoon; / And there she shall at Friar Laurence' cell / Be shriv'd and married."
                                            },
                                            {
                                                "example_id": "e819d715-221c-4a93-a915-b0629c446cdd",
                                                "sense_id": "d4252c24-ada7-3b79-9a0d-06e50bd92267",
                                                "text": "\"I will do any thing, however impossible, if you will only not call me Mr Hervey. Why am I not Laurence to you - Miss Vivian calls me Laurence - I am Laurence to every one but you - let me hear you call me Laurence,\" in an earnest manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813b0cd4-2e1f-3bab-a8c1-3472d4a7baaa",
