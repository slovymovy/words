                        "glosses": [
                            "En Thaïlande, petite rue partant d’une voie principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85cdfec-1ee8-4aac-9f1d-52928a46b0e3",
                                "sense_id": "093d0d21-1549-3800-a57f-8b6d0a333e58",
                                "text": "Il traversa la cour de l’hôtel et s’enfonça dans le petit soï coincé entre les deux murs de briques aveugles pour rejoindre l’avenue Surawong."
                            },
                            {
                                "example_id": "61d24574-5669-4a66-bb56-27d339d8a252",
                                "sense_id": "093d0d21-1549-3800-a57f-8b6d0a333e58",
                                "text": "Une ruelle plongée dans les ténèbres, plus étroite qu’un soï, se dessine sur la droite, à quelques mètres des spots du quartier des lumières."
                            },
                            {
                                "example_id": "54cfd296-bb75-4ff8-8f84-4fa0fad20ffa",
                                "sense_id": "093d0d21-1549-3800-a57f-8b6d0a333e58",
                                "text": "Les soïs pairs se situent d'un côté de l’axe principal, les impairs de l’autre."
                            }
                        ]
                    }
