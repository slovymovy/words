                "translations": [
                    {
                        "translation_id": "ced8d53d-6679-4292-90dc-385099dd87c0",
                        "source_entry_id": "323d6d8a-f653-3e0a-bc06-60c577e9d56e",
                        "source_sense_id": "8e6deb65-246d-37c7-992b-856a49e229ab",
