                                                "example_id": "d32595d0-e003-4828-bb29-cf21173bf677",
                                                "sense_id": "86fa640d-9c49-3d7d-8a76-a59c3592c9fb",
                                                "text": "Ich will nur noch zügig einen Happen essen."
                                            }
