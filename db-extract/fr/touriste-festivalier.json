                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc302a58-28ea-4eef-9737-0d8f3f311266",
                                "sense_id": "4ea5a415-7d65-3628-99ad-c2a85b85804d",
                                "text": "Parmi ces touristes-festivaliers certains viennent de loin pour profiter de l’air maritime et musical."
                            },
                            {
                                "example_id": "678dfb55-9327-4cee-b8b5-3ea0b81d5a4a",
                                "sense_id": "4ea5a415-7d65-3628-99ad-c2a85b85804d",
                                "text": "À l’accueil du camping, c’est l’effervescence des grands jours : les touristes-festivaliers demandent leurs factures et s’apprêtent à quitter la ville."
                            },
                            {
                                "example_id": "1d188a23-bb6b-4ea4-94f1-364394863822",
                                "sense_id": "4ea5a415-7d65-3628-99ad-c2a85b85804d",
                                "text": "Enfin, un partenariat a été passé avec l’office de tourisme Grand Carcassonne, pour proposer un pack hébergement, restaurant, et festival aux touristes-festivaliers."
                            }
                        ]
