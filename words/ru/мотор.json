                    "sense_definition": "Автомобиль.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К парадному входу подъехал блестящий чёрный <w>мотор</w>.",
                            "target_lang_translations": {
                                "en": "A shiny black <w>motor car</w> pulled up to the main entrance.",
                                "fr": "Une <w>automobile</w> noire et rutilante s'est arrêtée devant l'entrée principale."
                            }
                        },
                        {
                            "text": "Шумный <w>мотор</w> промчался по улице, пугая лошадей.",
                            "target_lang_translations": {
                                "en": "A noisy <w>motor</w> sped down the street, scaring the horses.",
                                "fr": "Une bruyante <w>voiture</w> passa à toute allure dans la rue, effrayant les chevaux."
                            }
                        }
                    ],
