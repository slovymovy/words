                                    {
                                        "sense_id": "0a436f18-ec55-3d07-8097-435fc5a3d6ea",
                                        "entry_id": "51ad3aae-4051-314d-bf76-b0cabe454cba",
                                        "glosses": [
                                            "A period of exceptionally hot weather."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a9e8d7-2934-48ce-a058-69be68a4f42a",
                                                "sense_id": "0a436f18-ec55-3d07-8097-435fc5a3d6ea",
                                                "text": "We're havin a heat wave / A tropical heat wave / The temperatures rising, it isn't surprising / She certainly can, can can! / She started a heat wave / By letting her seat wave, / in such a way that the customers say / that she certainly can, can-can!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07c36f3-2717-37dc-8dc7-a8438c9f46ee",
                                        "entry_id": "51ad3aae-4051-314d-bf76-b0cabe454cba",
                                        "glosses": [
                                            "A period of exceptionally hot weather.",
                                            "Three consecutive days with daytime high temperature of 90 degrees Fahrenheit or higher."
                                        ],
                                        "tags": [
                                            "US",
                                            "idiomatic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa0f2cbe-db56-348c-9439-78062314748e",
                                        "entry_id": "51ad3aae-4051-314d-bf76-b0cabe454cba",
                                        "glosses": [
                                            "A period of exceptionally hot weather.",
                                            "A period of at least three consecutive days with daily high temperatures of the respective county's temperature threshold or higher."
                                        ],
