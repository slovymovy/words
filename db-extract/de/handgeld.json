                "senses": [
                    {
                        "sense_id": "063132a1-e3f5-3b94-87b2-8a25f73ba13c",
                        "entry_id": "1014d8bf-4717-3983-b2a9-476b28287950",
                        "glosses": [
                            "Betrag, der bei Abschluss eines Vertrags dem Vertragspartner ausgezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47988826-5dde-40d1-bdde-0f5ada0827a2",
                                "sense_id": "063132a1-e3f5-3b94-87b2-8a25f73ba13c",
                                "text": "„Jeder von uns bekam vier Pfund Handgeld, und beide Parteien schienen über das Geschäft entzückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ed034d6-3114-4bbe-9f0d-76298d45b370",
                        "source_entry_id": "1014d8bf-4717-3983-b2a9-476b28287950",
                        "source_sense_id": "063132a1-e3f5-3b94-87b2-8a25f73ba13c",
                        "source_sense_description": "Betrag, der bei Abschluss eines Vertrags dem Vertragspartner ausgezahlt wird",
                        "target_lang_word": "arrhes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrhes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37e5f1c7-897b-30fe-ac27-2314445f02d9",
                                        "entry_id": "cff0b367-bab8-3405-bf00-599273b9fbf3",
                                        "glosses": [
                                            "Somme d’argent versée dès la signature d’un contrat à titre de gage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329f5638-0914-4ccd-9204-3cb0bea4423d",
                                                "sense_id": "37e5f1c7-897b-30fe-ac27-2314445f02d9",
                                                "text": "Si j’annule cette réservation je perdrai les arrhes."
                                            },
                                            {
                                                "example_id": "32f8d62e-8b6c-4778-b754-66bc96962fa7",
                                                "sense_id": "37e5f1c7-897b-30fe-ac27-2314445f02d9",
                                                "text": "Eh bien ! c’est chose dite, continua le prince ; à compter de ce jour vous êtes à mon service. Prenez cette bourse, ce sont les arrhes du marché."
                                            },
                                            {
                                                "example_id": "77a47d05-49af-47d8-83a4-259b0a0eab75",
                                                "sense_id": "37e5f1c7-897b-30fe-ac27-2314445f02d9",
                                                "text": "Xavier avait déjà pris des engagements pour la vente de son étude, et bien qu’il ne dût la céder que dans deux ans, il venait de toucher des arrhes qui dépassaient de beaucoup ce qu’il avait espéré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3321f991-18f2-344a-a3b7-52e13f78ee56",
                                        "entry_id": "cff0b367-bab8-3405-bf00-599273b9fbf3",
                                        "glosses": [
                                            "Argent qu’un acquéreur ou un locataire donne pour garantir l’exécution d’un marché verbal et qu’il perd s’il rompt le marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2d46bc-f589-4568-8b40-8a7cec2dfd12",
                                                "sense_id": "3321f991-18f2-344a-a3b7-52e13f78ee56",
                                                "text": "Le marché est-il conclu ? donnez des arrhes."
                                            },
                                            {
                                                "example_id": "cc5420bd-5156-4e52-9efc-784276db035a",
                                                "sense_id": "3321f991-18f2-344a-a3b7-52e13f78ee56",
                                                "text": "Il s’est engagé, puisqu’il a pris des arrhes."
                                            },
                                            {
                                                "example_id": "9a0febe8-200f-46f3-baa7-cb43d8866bb4",
                                                "sense_id": "3321f991-18f2-344a-a3b7-52e13f78ee56",
                                                "text": "Donner des arrhes à un tailleur."
                                            },
                                            {
                                                "example_id": "0c18be83-e56c-4a42-b9cf-f547c0979eb7",
                                                "sense_id": "3321f991-18f2-344a-a3b7-52e13f78ee56",
                                                "text": "— Les arrhes ?\n— Voici la moitié du prix, vingt-cinq livres, dit John Mangles, en comptant la somme au master, qui l’empocha sans dire merci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb53e49b-01f7-312b-9236-d740f30ac66e",
                                        "entry_id": "cff0b367-bab8-3405-bf00-599273b9fbf3",
                                        "glosses": [
                                            "Assurance, gage."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "393fe050-d357-443f-b5b0-68a448975bcc",
                                                "sense_id": "fb53e49b-01f7-312b-9236-d740f30ac66e",
                                                "text": "Tenez, Babillard, dit le capitaine en remettant au guide une magnifique épingle en diamants qu’il portait piquée dans sa blouse de chasse, voici mes arrhes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8544e739-5afd-3b4e-8b0c-b4125334348a",
                                        "entry_id": "cff0b367-bab8-3405-bf00-599273b9fbf3",
                                        "glosses": [
                                            "Preuve, démonstration, gage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acba2794-8736-422c-acad-c73b5c10d73a",
                                                "sense_id": "8544e739-5afd-3b4e-8b0c-b4125334348a",
                                                "text": "Cette rue était un long bourbier, bordé de planches et de marais, où les maisons se trouvaient seulement vers la rue de Vaugirard, et ce passage était si peu fréquenté, qu'au moment où Paris dîne, deux amants pouvaient s'y quereller et s'y donner les arrhes d'un raccommodement sans crainte d'y être vus."
                                            }
                                        ]
                                    }
                                ]
                            },
