{
    "word_family": [
        "amelioration",
        "ameliorative",
        "ameliorator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "255492a4-6f12-3c99-882b-761f62f75e61",
                    "sense_definition": "To make something bad or unpleasant better, more tolerable, or improved.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "improve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They offered several compromises in an effort to <w>ameliorate</w> the difficult situation.",
                            "target_lang_translations": {
                                "ru": "Они предложили несколько компромиссов в попытке <w>улучшить</w> непростую ситуацию."
                            }
                        },
                        {
                            "text": "The government introduced new economic policies to <w>ameliorate</w> living conditions for poor families.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новую экономическую политику, чтобы <w>облегчить</w> условия жизни малоимущих семей."
                            }
                        }
                    ],
                    "synonyms": [
                        "improve",
                        "better"
                    ],
                    "antonyms": [
                        "worsen",
                        "deteriorate"
                    ],
                    "common_phrases": [
                        "ameliorate the situation",
                        "ameliorate conditions",
                        "ameliorate poverty",
                        "help ameliorate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо плохое, неприятное или трудное лучше, терпимее или благоприятнее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "делать положение или условия более благоприятными"
                            },
                            {
                                "target_lang_word": "улучшить",
                                "target_lang_sense_clarification": "завершённое действие по улучшению ситуации"
                            },
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "сглаживать тяжелые условия, страдания или бремя"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "уменьшать остроту неблагоприятной ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e96b0976-f404-3fce-b895-91299d03ada5",
                    "sense_definition": "To become better or show improvement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "improve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors hope that his physical condition will gradually <w>ameliorate</w> over the next few weeks.",
                            "target_lang_translations": {
                                "ru": "Врачи надеются, что его физическое состояние постепенно <w>улучшится</w> в течение следующих нескольких недель."
                            }
                        },
                        {
                            "text": "As diplomatic relations began to <w>ameliorate</w>, cross-border trade slowly resumed.",
                            "target_lang_translations": {
                                "ru": "По мере того как дипломатические отношения стали <w>налаживаться</w>, приграничная торговля постепенно возобновилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "improve"
                    ],
                    "antonyms": [
                        "deteriorate",
                        "worsen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться лучше, налаживаться или показывать положительную динамику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшаться",
                                "target_lang_sense_clarification": "переходить в более благоприятное состояние"
                            },
                            {
                                "target_lang_word": "налаживаться",
                                "target_lang_sense_clarification": "нормализоваться, приходить в порядок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}