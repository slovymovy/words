                        ],
                        "examples": [
                            {
                                "example_id": "70711e39-5d57-4a9b-9c57-00df22f8b094",
                                "sense_id": "f80982b4-e48a-3a4c-8061-9c2543216f8d",
                                "text": "Ewoluując, człowiek tylko doskonalił charakterystyczne dla gatunku zachowania opiekuńcze, które są z jednej strony instynktowne, a z drugiej uwarunkowane kulturowo"
                            },
                            {
                                "example_id": "bb62a3a0-1fac-4c7f-be67-c3d0f836eb7a",
                                "sense_id": "f80982b4-e48a-3a4c-8061-9c2543216f8d",
                                "text": "Prawdziwa miłość nie jest instynktowna, nie jest fizycznym zauroczeniem ani chęcią posiadania na wyłączność, nie jest akceptacją rozumianą jako nagroda za posłuszeństwo czy sukcesy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
