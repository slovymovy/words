                                        "examples": [
                                            {
                                                "example_id": "00fbf398-c765-4c59-b164-44654bfade14",
                                                "sense_id": "ee9eb93c-060d-35b8-b87a-ad22e9388850",
                                                "text": "September 1971, Germaine Greer, \"My Mailer Problem\", in Esquire\nThe tragedy of machismo is that a man is never quite man enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233a9e1f-05c3-3876-8348-41e3c38f4e35",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "characteristic, behavior or particularity of Male; Macheza."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                        "entry_id": "260d5556-4376-3dce-a9ae-99dbd2659c93",
                                        "glosses": [
                                            "male chauvinism, misogyny"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eaf5353-a94a-4530-8fbd-adfd580bdda7",
                                                "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                                "text": "PSP [Puerto Rican Socialist Party] spokesperson Victor Lopez-Tosado told GCN: \"[…] The party is mainly organized in a Latin American country where oppression, as a result of machismo, etc., to homosexuals is very common.\""
                                            },
                                            {
                                                "example_id": "59744483-37bb-4ab5-b83a-f5862e27f847",
                                                "sense_id": "92589950-76d2-32f8-b28d-75942b5f9ad5",
                                                "text": "The Dominican Republic is traditionally regarded as a patriarchal island brimming with machismo — where, indeed, a recent U.S. ambassador was publicly vilified for bringing his husband to his posting. It was, and is, an unlikely place to find an enclave of acceptance. So what explains this unique tolerance?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
