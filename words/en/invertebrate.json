{
    "word_family": [
        "vertebrate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3454f17b-13b4-3297-89e3-3a16ed9cfdb1",
                    "sense_definition": "An animal that does not have a backbone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many marine <w>invertebrates</w> live on the ocean floor.",
                            "target_lang_translations": {
                                "zh": "许多海洋<w>无脊椎动物</w>生活在海底。",
                                "nl": "Veel mariene <w>ongewervelden</w> leven op de oceaanbodem."
                            }
                        },
                        {
                            "text": "The study focused on the diversity of <w>invertebrates</w> in the local forest.",
                            "target_lang_translations": {
                                "zh": "这项研究聚焦于当地森林中<w>无脊椎动物</w>的多样性。",
                                "nl": "Het onderzoek richtte zich op de diversiteit van <w>ongewervelde dieren</w> in het lokale bos."
                            }
                        }
                    ],
                    "antonyms": [
                        "vertebrate"
                    ],
                    "common_phrases": [
                        "marine invertebrates"
                    ],
                    "target_lang_definitions": {
                        "zh": "指没有脊椎的动物。",
                        "nl": "Een dier dat geen ruggengraat of wervelkolom heeft."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无脊椎动物",
                                "target_lang_sense_clarification": "生物学分类术语，指体内没有脊柱的动物。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ongewervelde",
                                "target_lang_sense_clarification": "dier zonder wervelkolom"
                            },
                            {
                                "target_lang_word": "ongewerveld dier",
                                "target_lang_sense_clarification": "dier zonder ruggengraat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06345511-8205-3e9b-8bf2-37eaec7148ad",
                    "sense_definition": "A person who lacks courage or strength of character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was seen as an <w>invertebrate</w> who could never stand up for his own beliefs.",
                            "target_lang_translations": {
                                "zh": "他被视为一个<w>软骨头</w>，从不敢坚持自己的信念。",
                                "nl": "Hij werd gezien als een <w>slappeling</w> die nooit voor zijn eigen overtuigingen kon opkomen."
                            }
                        },
                        {
                            "text": "The manager was a total <w>invertebrate</w> when it came to dealing with difficult employees.",
                            "target_lang_translations": {
                                "zh": "在处理棘手的员工问题时，这位经理简直是个<w>软骨头</w>。",
                                "nl": "De manager was <w>totaal zonder ruggengraat</w> als het ging om de omgang met lastige werknemers."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指缺乏勇气或性格软弱的人。",
                        "nl": "Iemand die geen moed of ruggengraat heeft; een zwakkeling."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "软骨头",
                                "target_lang_sense_clarification": "比喻性格软弱、没有骨气的人。"
                            },
                            {
                                "target_lang_word": "没骨气的人",
                                "target_lang_sense_clarification": "指缺乏原则和坚定立场的人。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "slappeling",
                                "target_lang_sense_clarification": "iemand zonder wilskracht of moed"
                            },
                            {
                                "target_lang_word": "iemand zonder ruggengraat",
                                "target_lang_sense_clarification": "figuurlijk voor een karakterloos persoon"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66c01231-0668-3836-a943-6a40c73fbcce",
                    "sense_definition": "Lacking a backbone or vertebrae.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sponges are <w>invertebrate</w> organisms that live in water.",
                            "target_lang_translations": {
                                "zh": "海绵是生活在水中的<w>无脊椎</w>生物。",
                                "nl": "Sponzen zijn <w>ongewervelde</w> organismen die in het water leven."
                            }
                        },
                        {
                            "text": "The <w>invertebrate</w> species are often overlooked in conservation efforts.",
                            "target_lang_translations": {
                                "zh": "<w>无脊椎</w>物种在保护工作中往往被忽视。",
                                "nl": "De <w>ongewervelde</w> soorten worden bij natuurbeschermingsprojecten vaak over het hoofd gezien."
                            }
                        }
                    ],
                    "antonyms": [
                        "vertebrate"
                    ],
                    "common_phrases": [
                        "invertebrate species"
                    ],
                    "target_lang_definitions": {
                        "zh": "指没有脊椎的。",
                        "nl": "Zonder wervelkolom of ruggengraat."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无脊椎的",
                                "target_lang_sense_clarification": "形容词，描述生物缺乏脊椎结构。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ongewerveld",
                                "target_lang_sense_clarification": "biologisch, geen ruggengraat hebbend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dab811d-0e1c-30e4-9d1d-3ab58ce8a76e",
                    "sense_definition": "Lacking courage or moral character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>invertebrate</w> response to the crisis disappointed everyone.",
                            "target_lang_translations": {
                                "zh": "他面对危机时<w>没骨气</w>的反应让每个人都感到失望。",
                                "nl": "Zijn <w>ruggengraatloze</w> reactie op de crisis stelde iedereen teleur."
                            }
                        },
                        {
                            "text": "The politician made an <w>invertebrate</w> decision to avoid the controversy.",
                            "target_lang_translations": {
                                "zh": "这位政客做出了一个<w>软弱</w>的决定以规避争议。",
                                "nl": "De politicus nam een <w>slap</w> besluit om de controverse te vermijden."
                            }
                        }
                    ],
                    "synonyms": [
                        "spineless"
                    ],
                    "antonyms": [
                        "vertebrate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指缺乏勇气或道德品质的。",
                        "nl": "Zonder moed, daadkracht of morele ruggengraat; weekhartig of slap."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "没骨气的",
                                "target_lang_sense_clarification": "形容人缺乏勇气或立场。"
                            },
                            {
                                "target_lang_word": "软弱的",
                                "target_lang_sense_clarification": "形容行为或态度缺乏坚定性。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ruggengraatloos",
                                "target_lang_sense_clarification": "karakterloos of laf"
                            },
                            {
                                "target_lang_word": "slap",
                                "target_lang_sense_clarification": "zonder daadkracht of moed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}