                "senses": [
                    {
                        "sense_id": "f4d790e2-5c17-3a20-a34d-71075604d99e",
                        "entry_id": "da9846db-c075-3548-9da9-d0e8526100d6",
                        "glosses": [
                            "Überzeugung, dass die Menschen und die Erde beziehungsweise das Universum in einem sehr wörtlichen Sinne das Schöpfungswerk eines Gottes sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29b5b30-8b55-4172-a6cc-f25e59f4aa21",
                                "sense_id": "f4d790e2-5c17-3a20-a34d-71075604d99e",
                                "text": "Der Kreationismus lehnt die Evolutionstheorie ab."
                            },
                            {
                                "example_id": "cda27b62-8550-4225-8896-dfd255ea57fc",
                                "sense_id": "f4d790e2-5c17-3a20-a34d-71075604d99e",
                                "text": "„Der Kreationismus als Gegenreaktion auf Darwin und die Moderne überhaupt kann dabei in den USA auf eine lange Tradition zurückblicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f439d51-9eb7-4909-a1b4-6da15f2ec81d",
                        "source_entry_id": "da9846db-c075-3548-9da9-d0e8526100d6",
                        "source_sense_id": "f4d790e2-5c17-3a20-a34d-71075604d99e",
                        "target_lang_word": "creationism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creationism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3db2d7-a757-364e-8b2d-387ed4dbc2dc",
                                        "entry_id": "9a8cf216-f5a0-3543-a638-0de0b2d13732",
                                        "glosses": [
                                            "The Abrahamic doctrine that each individual human soul is created by God, as opposed to traducianism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc6899c-deb2-499f-a2c8-1bd7062836cc",
                                                "sense_id": "0b3db2d7-a757-364e-8b2d-387ed4dbc2dc",
                                                "text": "the preservation of the race of man is made to grow out of that quickening impulse, which we call the life of humanity. This notion, which was called Traducianism by the schoolmen (the system opposed to it being termed Creatianism ^([sic]))"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df551f54-aa10-305e-9001-743bad3f58ae",
                                        "entry_id": "9a8cf216-f5a0-3543-a638-0de0b2d13732",
                                        "glosses": [
                                            "Any creationary belief, especially a belief that the origin of things is due to an event or process of creation brought about by the deliberate act of any divine agency, such as a Creator God."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60bb9212-eab1-375f-bf59-cdb9886e4bb9",
                                        "entry_id": "9a8cf216-f5a0-3543-a638-0de0b2d13732",
                                        "glosses": [
                                            "The belief that a deity created the world, especially as described in a particular religious text, such as the Quran or the Book of Genesis."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6971f4a4-9dba-441a-b430-2a9adf644609",
                                                "sense_id": "60bb9212-eab1-375f-bf59-cdb9886e4bb9",
                                                "text": "It must be reasonably clear to all who have taken pains to understand the matter that the true issue as regards design is not between Darwinism and direct Creationism, but between design and fortuity, between any intention or intellectual cause and no intention nor predicable first cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
