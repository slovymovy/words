                "forms": [],
                "senses": [
                    {
                        "sense_id": "46ef1bfa-5bc5-346e-90eb-1e12023a0b13",
                        "entry_id": "0e9b208d-9de2-372f-b82b-85bbf63e829a",
                        "glosses": [
                            "Rivière asséchée en Afrique australe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bdb3dab-89ed-4fd5-9121-3fdd9ca22e06",
                                "sense_id": "46ef1bfa-5bc5-346e-90eb-1e12023a0b13",
                                "text": "Lorsque nous approchâmes de la donga, nous dûmes faire volte-face pour surveiller la retraite. En me retournant, je vis un parti de Zoulous qui nous poursuivaient."
                            },
                            {
                                "example_id": "2c31fdb3-5f15-4637-bee4-f93d0a6b8d93",
                                "sense_id": "46ef1bfa-5bc5-346e-90eb-1e12023a0b13",
                                "text": "Autre chose, j’aimerais qu’une équipe remonte les traces partant de la grange en direction du sud. Le véhicule d’Aron a dû être abandonné quelque part, probablement dans un donga."
                            },
                            {
                                "example_id": "bff08065-ba90-46d7-a657-28d7242f6c74",
                                "sense_id": "46ef1bfa-5bc5-346e-90eb-1e12023a0b13",
                                "text": "D’autres fois, il fallait lancer une pierre dans les eaux brunes de l’étang, le plus loin qu’ils le pouvaient. Ou bien encore ils s’amusaient à pisser le plus haut contre la paroi d’argile d’une donga."
                            }
                        ]
                    }
                ],
