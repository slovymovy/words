                                        "entry_id": "ba4948c9-d8ad-3a33-a10e-fdc3bbd849fe",
                                        "glosses": [
                                            "schlimmster, langjähriger Feind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9b0757-75a5-4230-9f75-66abe84bb5fa",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "Prof. Dr. Feinfinger ist Käpt’n Blaubärs Erzfeind und Fernschachgegner."
                                            },
                                            {
                                                "example_id": "f05d91d6-3506-47a5-86b7-d6baa059f6e6",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Der Erzfeind des Okzidents hängt an meiner Zimmerwand, und, was soll ich sagen, ich mag ihn.“"
                                            },
                                            {
                                                "example_id": "a98587e2-b09e-4257-8775-942c4621fc34",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Die äthiopische Regierung hat das unfruchtbare Land, rund sechzig Kilometer südlich der Grenze zum Erzfeind Eritrea, für die Errichtung eines Flüchtlingslagers ausgewiesen.“"
                                            },
                                            {
                                                "example_id": "1052a0da-afc7-43db-be94-c46aacaf99f0",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Irgendwann Anfang der Sechzigerjahre hatten die Magyaren bei den Landtagswahlen in den ungarischen Komitaten einfach alle Erzfeinde der Habsburger Monarchie zu Abgeordneten gewählt, nicht nur den eigenen Revolutionär Kossuth, sondern auch Garribaldi und sogar Napoleon III.“"
                                            },
                                            {
                                                "example_id": "67d4fa81-a6a8-4d7a-8843-3549779fd243",
                                                "sense_id": "38f4eec4-1a5b-3108-85ba-86cfea009aa9",
                                                "text": "„Aurangzeb verlegte nun seine Hauptstadt nach Aurangabad, um seine Erzfeinde aus nächster Nähe bekämpfen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
