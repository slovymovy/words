                                "sense_id": "a79a1ca2-7d2d-3cf8-8cea-1fc1f3188955",
                                "text": "Het kadaver verkeert in staat van ontbinding.",
                                "translation": "The cadaver is decomposing.",
                                "english": "The cadaver is decomposing."
                            },
                            {
                                "example_id": "fede43fe-164c-4c59-ae01-f9a600400dbf",
                                "sense_id": "a79a1ca2-7d2d-3cf8-8cea-1fc1f3188955",
                                "text": "De ontbinding van 46 in zijn priemfactoren geeft 2 en 23.",
                                "translation": "The decomposition of 46 into its underlying primes yields 2 and 23.",
                                "english": "The decomposition of 46 into its underlying primes yields 2 and 23."
                            }
