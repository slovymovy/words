                    {
                        "sense_id": "42feeb32-e878-3cf2-a1f1-514291ae2112",
                        "entry_id": "e4c83384-0210-3103-b98f-ad8fe7f7061e",
                        "glosses": [
                            "An ancient Athenian statesman and lawgiver, one of the Seven Sages (c.630-c.560 BC)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced85ea2-4a1d-436c-a16b-fbf5c8eda92f",
                                "sense_id": "42feeb32-e878-3cf2-a1f1-514291ae2112",
                                "text": "Now if your Majesty would have our bristles\nTo bind your mortar with, or fill our colons\nWith rich blood, or make brawn out of our gristles,\nIn policy—ask else your royal Solons—\nYou ought to give us hog-wash and clean straw,\nAnd sties well thatched; besides it is the law!"
                            },
                            {
                                "example_id": "f3078539-938d-44a6-9dab-ee4ec8ccdc98",
                                "sense_id": "42feeb32-e878-3cf2-a1f1-514291ae2112",
                                "text": "[T]he law codes drafted in Athens in the late seventh and early sixth centuries were the work of individuals, Drakon and then Solon."
                            }
                        ]
                    },
