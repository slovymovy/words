            {
                "entry_id": "fba7dab2-5b9c-3011-b90c-0f817b5be710",
                "word": "halbwinds",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a055e40e-f972-3c1b-9877-fbe7e1965cf5",
                        "entry_id": "fba7dab2-5b9c-3011-b90c-0f817b5be710",
                        "glosses": [
                            "von der Seite; 90°-Richtung des Windes im Verhältnis zur Mittelachse des Schiffes"
                        ],
                        "tags": [
                            "Segeln",
                            "Richtungsangabe über den Wind"
                        ],
                        "examples": [
                            {
                                "example_id": "d64793fb-8d3f-45bf-8b44-64d70bc7682e",
                                "sense_id": "a055e40e-f972-3c1b-9877-fbe7e1965cf5",
                                "text": "Halbwinds segeln ist das Tollste, was es gibt: voll draussen im Trapez stehen und du kriegst eine irre Geschwindigkeit drauf."
                            },
                            {
                                "example_id": "2ed70f6e-5bd4-47d3-a89b-6ecc5c9dc924",
                                "sense_id": "a055e40e-f972-3c1b-9877-fbe7e1965cf5",
                                "text": "Auch halbwinds hat man eine leichte Abdrift wenn man das Schwert zu hoch zieht."
                            },
                            {
                                "example_id": "ddd6f77e-cac5-4b64-a9c6-65469886b4d3",
                                "sense_id": "a055e40e-f972-3c1b-9877-fbe7e1965cf5",
                                "text": "Wir entschieden uns dafür halbwinds auf der Linie zu fahren und den Spinnacker erst beim Startsignal zu setzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "013a1ca7-7ae5-4cf3-bf7e-730fd1823f0c",
                        "source_entry_id": "fba7dab2-5b9c-3011-b90c-0f817b5be710",
                        "source_sense_id": "a055e40e-f972-3c1b-9877-fbe7e1965cf5",
                        "target_lang_word": "abeam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abeam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c09b1e2b-be93-355a-88cf-10edb375ebcf",
                                        "entry_id": "9d18f75e-e63c-301e-81f1-397a5f16cdec",
                                        "glosses": [
                                            "On the beam; at a right angle to the centerline or keel of a vessel or aircraft; being at a bearing approximately 090 Degrees or 270 Degrees relative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e207ae0-8f0a-4b82-8fb9-311b5af11ca5",
                                                "sense_id": "c09b1e2b-be93-355a-88cf-10edb375ebcf",
                                                "text": "We were heading S.S.W., and had a steady breeze abeam and a quiet sea."
                                            },
                                            {
                                                "example_id": "5154fb0e-f79b-4050-95f8-f914c85c4e4e",
                                                "sense_id": "c09b1e2b-be93-355a-88cf-10edb375ebcf",
                                                "text": "[…] waves striking the ship abeam pushed her always south of their new course, and rolled her, and filled her with water so that bailing must be ceaseless […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46cc7e07-5ab8-3df8-ae7f-a8eb49c5c2e3",
                                        "entry_id": "9d18f75e-e63c-301e-81f1-397a5f16cdec",
                                        "glosses": [
                                            "Alongside or abreast; opposite the center of the side of the ship or aircraft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abeam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                        "entry_id": "3b8c7056-8228-32bd-b4ec-1b04b26dec8e",
                                        "glosses": [
                                            "Alongside or abreast; opposite the center of the side of the ship or aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5732d4-74ee-42cc-928c-9c2c9706dc72",
                                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                                "text": "The island was directly abeam of us."
                                            },
                                            {
                                                "example_id": "c1ad895a-37c5-4d2f-ad3b-8034a5231985",
                                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                                "text": "The sound shifted its place markedly, but without coming nearer. It even grew a little more distant right abeam of the lighter, and then ceased again."
                                            },
                                            {
                                                "example_id": "0df4cbd5-c4a6-44bb-ae69-a623cf35c2a1",
                                                "sense_id": "4c4932cb-e7fe-3da5-a450-cd0a308058ca",
                                                "text": "The attack on the abeam ship, Louisville, killed Commander Cruiser Division Four […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abeam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41754a63-ca0d-3e4f-9d71-c9ae1c1c43a4",
                                        "entry_id": "d7115a0a-c638-34eb-97ad-e8c890e7aa96",
                                        "glosses": [
                                            "Alongside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bfa2aa9-345b-47ed-9920-c07aa27a27a9",
                                                "sense_id": "41754a63-ca0d-3e4f-9d71-c9ae1c1c43a4",
                                                "text": "She came abeam the crippled ship."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abeam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                        "entry_id": "44bc12d9-9e77-3d22-bf1b-7792e541f8f9",
                                        "glosses": [
                                            "Beaming, shining (especially with reference to a person's face or eyes)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad68bdd-a757-4bcc-921b-8296d7462b78",
                                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                                "text": "1876, William Davidson, Sermons on the Parables, Cincinnati: Western Tract Society, Sermon 1, p. 41,\n[…] the hearts of the saints [will] be all attention and their faces all abeam for the consolation;"
                                            },
                                            {
                                                "example_id": "c5861dc3-6078-48e4-9d33-f9c25cb3abc9",
                                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                                "text": "[…] the waiters fly about abeam with good will and on excellent terms with those they serve […]"
                                            },
                                            {
                                                "example_id": "0b75ece1-9bb8-4563-8f9e-55f360eab0c1",
                                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                                "text": "[…] since he refused to be intimidated, stage two of their introduction consisted of Sheba sitting round in attitudes of beleaguered desperation while Seeley, his face abeam with adulation, sat determinedly beside her."
                                            },
                                            {
                                                "example_id": "e2c77c4d-e709-4223-b380-8dda972e3b03",
                                                "sense_id": "63021efe-1d42-339c-a50d-216296a0fd51",
                                                "text": "When we met for another lunch […] he was all abeam with pride as he handed me a newly minted paperback reissue of Wodehouse […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
