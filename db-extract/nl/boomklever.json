                        "target_lang_word": "torchepot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torchepot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9fb4897-2446-38a4-98bb-d13ee9bd7f95",
                                        "entry_id": "f617dc83-fe52-356f-8f6e-56973148f882",
                                        "glosses": [
                                            "Qualifie la sittelle torchepot (voir exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4407da3-0515-41fa-8dd2-9a8eaa98ce4a",
                                                "sense_id": "a9fb4897-2446-38a4-98bb-d13ee9bd7f95",
                                                "text": "La sittelle torchepot niche dans des trous, des crevasses, d'anciennes loges de pic ou des nichoirs, garni d'écorce et de feuilles. Elle applique de la boue séchée pour réduire l'entrée (ce qui lui a valu le nom de torchepot) des sites de nidification qu'elle utilise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
