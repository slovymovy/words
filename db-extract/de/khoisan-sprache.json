                ],
                "senses": [
                    {
                        "sense_id": "171efd89-e741-357e-97b6-575ba9cbd959",
                        "entry_id": "cb59e62a-8a18-3fbf-b8a1-d5c662559076",
                        "glosses": [
                            "Sprachstamm, der – je nach Quelle – etwa 30 bis etwa 45 (teilweise ausgestorbene oder im Aussterben begriffene) Tonsprachen im südwestlichen Afrika (Angola, Botswana, Namibia, Südafrika) und Tansania umfasst, für die insbesondere zahlreiche Klicklaute charakteristisch sind"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "4cfc5620-6f03-4438-80ea-2d351f271c63",
                                "sense_id": "171efd89-e741-357e-97b6-575ba9cbd959",
                                "text": "„Die Khoisan-Sprachen bilden keine genetische Einheit (Sprachfamilie), sondern umfassen als Sammelbegriff mindestens drei Sprachfamilien sowie einige isolierte Sprachen.“"
                            },
                            {
                                "example_id": "4ef289fa-5ff7-4d0c-a977-3cedee4d9540",
                                "sense_id": "171efd89-e741-357e-97b6-575ba9cbd959",
                                "text": "„Charakteristisch für die Khoisan-Sprachen sind die Klicklaute und umfangreiche Phoneminventare[.]“"
                            },
                            {
                                "example_id": "1ff75dad-2b57-4d8e-b91c-266886baea37",
                                "sense_id": "171efd89-e741-357e-97b6-575ba9cbd959",
                                "text": "„Das Internationale Phonetische Alphabet verwendet das !, um Laute anzuzeigen, bei denen die Zunge sich direkt hinter der oberen Zahnreihe befindet und einen Klicklaut erzeugt, den man etwa in mehreren südwestafrikanischen Khoisan-Sprachen wie »!Kung« findet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c701730-4f8b-33c5-823f-b9cf891066a4",
                        "entry_id": "cb59e62a-8a18-3fbf-b8a1-d5c662559076",
                        "glosses": [
                            "Sprache oder Sprachfamilie, die Vertreter dieses Sprachstammes ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd72609-28e1-4a3a-8fa7-5f6338373809",
                                "sense_id": "0c701730-4f8b-33c5-823f-b9cf891066a4",
                                "text": "ǃXóõ ist eine Khoisan-Sprache mit rund 4000 Sprechern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
