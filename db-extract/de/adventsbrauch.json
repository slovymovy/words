                ],
                "senses": [
                    {
                        "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                        "entry_id": "4ae11052-cd03-3f1f-aa46-075e6de5e990",
                        "glosses": [
                            "traditionelle, an Advent ausgeübte Sitte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44a6f3f-141d-41cf-a563-eb70b4205f4a",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "Sie pflegen keine besonderen Adventsbräuche."
                            },
                            {
                                "example_id": "239230e6-8fe9-4866-94bc-4cb5f18d227d",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "Ein auch heute noch in Deutschland gepflegter Adventsbrauch ist das Basteln eines Adventskalenders."
                            },
                            {
                                "example_id": "38c0f331-7e83-4a85-a4b5-bd25a6d5902a",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Der Adventsbrauch hat seine Wurzeln im alpenländischen Raum.“"
                            },
                            {
                                "example_id": "70b8ff97-4ec6-43a0-90f1-279462490949",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Beim Adventsbrauch der Herbergssuche wird die erfolglose Quartiersuche von Maria und Josef nachgestellt. Der Weg von Hof zu Hof war dabei oftmals ein kleines Abenteuer, wie unsere #BR24Zeitreise aus dem winterlichen Bayerischen Wald von 1963 zeigt.“"
                            },
                            {
                                "example_id": "97a7277e-c786-472c-96a6-3bdf04c87ee2",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "[Schlagzeile:] „Woher kommt der Adventsbrauch?“"
                            },
                            {
                                "example_id": "263dc585-0400-455b-98d7-b955e8eb9238",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Für die deutschen Weihnachts- und Adventsbräuche sei es typisch gewesen, dass evangelische und katholische Christen Traditionen voneinander übernommen und mit der Zeit gemeinsame Rituale entwickelt hätten, sagt Angelika Mark-Zobel: […]“"
                            },
                            {
                                "example_id": "d7f5df26-ea1f-41f5-b18f-4285d1cc3af7",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Entstanden ist dieser ganz besondere Adventsbrauch vor 34 Jahren.“"
                            },
                            {
                                "example_id": "5562a55a-5496-42cc-ab4d-c8c99edbc1a6",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Der Rundgang erzählt die Tradition der Advents- und Weihnachtsbräuche.“"
                            },
                            {
                                "example_id": "0cca87fe-183b-448e-ba08-1b874026aeaa",
                                "sense_id": "0b33922f-10db-3045-b17d-05440d72c10d",
                                "text": "„Es gibt aber einen speziell friesischen Adventsbrauch: Vor jedem Adventssonntag stellen die Kinder einen Teller auf die Fensterbank, und zum Advent liegen Süßigkeiten darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
