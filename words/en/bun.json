                                "target_lang_word": "плюшка",
                                "target_lang_sense_clarification": "кусочек гашиша"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻烟",
                                "target_lang_sense_clarification": "毒品相关"
                            }
