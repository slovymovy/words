                        "examples": [
                            {
                                "example_id": "97bcb5a7-1393-4955-af5f-a28e05f5e4d1",
                                "sense_id": "90099030-1dce-3305-9088-41fe83af5ad7",
                                "text": "„Die Flanellbezüge des Betts sind mit Scotchterriern bedruckt.“"
                            },
                            {
                                "example_id": "22ca2c5d-c8d1-4f1f-a21f-9804f132a85f",
                                "sense_id": "90099030-1dce-3305-9088-41fe83af5ad7",
                                "text": "„Sie faselte von der Liebe ihres Lebens, ihrem Scotchterrier Dimples, und davon, dass er im letzten Jahr gestorben war.“"
                            },
                            {
                                "example_id": "35cee66e-5395-44bb-865e-1cadb5a884e5",
                                "sense_id": "90099030-1dce-3305-9088-41fe83af5ad7",
                                "text": "„Der Schäferhund fiel zu sehr auf, ähnlich wie der weiße Scotchterrier, also musste Bert herhalten, seine treue Promenadenmischung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
