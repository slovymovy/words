                                                "sense_id": "1cc35b80-f167-3792-b61a-dc2c50e9f95e",
                                                "text": "Za pohřebním vozem stálo tu několik fiakrů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "067d0f9a-f431-4f6e-ab6e-5fc71676fd02",
                        "source_entry_id": "721700b1-9cfa-3274-8f16-09e709fac313",
                        "source_sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
