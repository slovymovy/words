{
    "word_family": [
        "bedenken",
        "bedenking",
        "bedenkelijkheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79df89a9-cf03-32c3-a0d1-67681d4c1fff",
                    "sense_definition": "wat bezorgdheid of afkeuring opwekt door een twijfelachtige of gevaarlijke aard",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zorgwekkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De medische toestand van de patiënt is en blijft helaas zeer <w>bedenkelijk</w>.",
                            "target_lang_translations": {
                                "en": "The patient's medical condition unfortunately is and remains very <w>concerning</w>."
                            }
                        },
                        {
                            "text": "Het bedrijf vertoont <w>bedenkelijk</w> gedrag door de veiligheidsregels volledig te negeren.",
                            "target_lang_translations": {
                                "en": "The company is showing <w>questionable</w> behavior by completely ignoring safety regulations."
                            }
                        }
                    ],
                    "synonyms": [
                        "dubieus",
                        "zorgwekkend",
                        "twijfelachtig",
                        "hachelijk"
                    ],
                    "antonyms": [
                        "geruststellend",
                        "onbetwistbaar",
                        "vertrouwenwekkend"
                    ],
                    "common_phrases": [
                        "bedenkelijk gedrag",
                        "bedenkelijke toestand",
                        "bedenkelijke kwaliteit"
                    ],
                    "target_lang_definitions": {
                        "en": "causing concern, disapproval, or doubt due to a questionable or dangerous nature"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "concerning",
                                "target_lang_sense_clarification": "causing worry or anxiety"
                            },
                            {
                                "target_lang_word": "questionable",
                                "target_lang_sense_clarification": "of doubtful morality or honesty"
                            },
                            {
                                "target_lang_word": "dubious",
                                "target_lang_sense_clarification": "hesitating or doubting; not to be relied upon"
                            },
                            {
                                "target_lang_word": "precarious",
                                "target_lang_sense_clarification": "dangerously likely to fall or collapse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0297fbb2-7105-3abe-9cb4-393d38aa894b",
                    "sense_definition": "een uitdrukking of houding die blijk geeft van twijfel, afkeuring of diep nadenken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chef keek met een <w>bedenkelijke</w> blik naar de matige prestaties van zijn personeel.",
                            "target_lang_translations": {
                                "en": "The boss looked at his staff's mediocre performance with a <w>doubtful</w> look."
                            }
                        },
                        {
                            "text": "Hij had de <w>bedenkelijke</w> uitdrukking op haar gezicht direct opgemerkt tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "He had immediately noticed the <w>dubious</w> expression on her face during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "peinzend",
                        "zorgelijk"
                    ],
                    "antonyms": [
                        "vastberaden",
                        "overtuigd"
                    ],
                    "common_phrases": [
                        "bedenkelijke blik",
                        "bedenkelijke uitdrukking",
                        "bedenkelijk gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "an expression or attitude showing doubt, disapproval, or deep thought"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "doubtful",
                                "target_lang_sense_clarification": "feeling or appearing uncertain"
                            },
                            {
                                "target_lang_word": "dubious",
                                "target_lang_sense_clarification": "expressing hesitation or suspicion"
                            },
                            {
                                "target_lang_word": "pensive",
                                "target_lang_sense_clarification": "engaged in deep or serious thought"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "28cb34ed-2969-3b3b-b962-29ed9cd4d29d",
                    "sense_definition": "op een manier die twijfel, bezorgdheid of aarzeling uitdrukt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schudde <w>bedenkelijk</w> met het hoofd toen hij de hoge rekening zag.",
                            "target_lang_translations": {
                                "en": "He shook his head <w>doubtfully</w> when he saw the high bill."
                            }
                        },
                        {
                            "text": "De leraar keek <w>bedenkelijk</w> naar het antwoord van de student.",
                            "target_lang_translations": {
                                "en": "The teacher looked <w>thoughtfully</w> at the student's answer."
                            }
                        }
                    ],
                    "synonyms": [
                        "twijfelend",
                        "zorgelijk"
                    ],
                    "antonyms": [
                        "instemmend",
                        "resoluut"
                    ],
                    "common_phrases": [
                        "bedenkelijk kijken",
                        "bedenkelijk schudden"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that expresses doubt, concern, or hesitation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "doubtfully",
                                "target_lang_sense_clarification": "in a way that shows lack of certainty"
                            },
                            {
                                "target_lang_word": "dubiously",
                                "target_lang_sense_clarification": "with hesitation or suspicion"
                            },
                            {
                                "target_lang_word": "thoughtfully",
                                "target_lang_sense_clarification": "in a way that suggests deep thinking, often with concern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}