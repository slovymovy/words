    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9e36f9e-0813-3987-aa34-0b7d6ebb0fcd",
                    "sense_definition": "Sommet rocheux, pointu ou escarpé d'une montagne ou d'une colline.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château fort se dresse fièrement sur un <w>piton</w> rocheux qui domine toute la vallée."
                        },
                        {
                            "text": "Après cinq heures d'ascension éprouvante, les randonneurs ont enfin atteint le <w>piton</w> balayé par les vents."
                        }
                    ],
                    "common_phrases": [
                        "piton rocheux",
                        "piton volcanique"
                    ]
                },
                {
                    "sense_id": "bf9cb343-5a75-3b2e-8c54-8056abaf7fe7",
                    "sense_definition": "Lame ou tige métallique terminée par un œillet, que l'on enfonce dans la roche pour s'assurer en escalade.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escalade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le premier de cordée a planté un <w>piton</w> solide dans la fissure avant de poursuivre la montée."
                        },
                        {
                            "text": "N'oublie pas de vérifier la solidité de ce vieux <w>piton</w> avant d'y fixer ton mousqueton."
                        }
                    ],
                    "common_phrases": [
                        "planter un piton",
                        "piton de rappel"
                    ]
                },
                {
                    "sense_id": "b5074db9-e08e-3a01-be33-bc5df49cf4ab",
                    "sense_definition": "Pièce de quincaillerie métallique en forme de clou ou de vis dont la tête forme un anneau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bricolage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a vissé deux <w>pitons</w> dans le plafond en bois pour pouvoir suspendre un hamac."
                        },
                        {
                            "text": "Pour maintenir cette tringle à rideaux, il suffit d'utiliser un <w>piton</w> en métal solide."
                        }
                    ],
                    "synonyms": [
                        "clou"
                    ],
                    "common_phrases": [
                        "piton à vis",
                        "piton à œillet"
                    ]
                },
                {
                    "sense_id": "7c4818dc-f095-3b65-9cd4-f5c8daba1151",
                    "sense_definition": "Bouton ou touche de commande sur un appareil électrique ou électronique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut simplement appuyer sur le gros <w>piton</w> rouge pour démarrer la machine à café."
                        },
                        {
                            "text": "Cette télécommande comporte bien trop de <w>pitons</w> minuscules pour une utilisation quotidienne agréable."
                        }
                    ],
                    "common_phrases": [
                        "peser sur le piton"
                    ],
