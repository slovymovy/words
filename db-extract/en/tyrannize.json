                ],
                "senses": [
                    {
                        "sense_id": "2d589035-73dc-3e50-b8ca-e1581320f32a",
                        "entry_id": "23d6351b-4b88-3e75-8692-a5d6c948f810",
                        "glosses": [
                            "To oppress (someone)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1b8b4026-86d4-4862-a0a7-aa07a669a5c9",
                                "sense_id": "2d589035-73dc-3e50-b8ca-e1581320f32a",
                                "text": "In truth he was the type of man who is spoilt by the submission of weaker people than himself. There are such men, who must either be tyrannized or be tyrants […]"
                            },
                            {
                                "example_id": "f96036fd-012f-435d-8208-3b47cde38c7f",
                                "sense_id": "2d589035-73dc-3e50-b8ca-e1581320f32a",
                                "text": "2001, Breena Clarke, “Roots of Success” (review of On Her Own Ground: The Life and Times of Madam C. J. Walker by A’Lelia Bundles), Chicago Tribune, 18 February, 2001,\nI spent the first 18 years of my life tyrannized by a red-hot hair-pressing comb. Well, maybe tyrannized is an exaggeration. But covering your ears while hot grease sizzles nearby is not a young girl's idea of a fun time."
                            }
                        ]
                    },
                    {
                        "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                        "entry_id": "23d6351b-4b88-3e75-8692-a5d6c948f810",
                        "glosses": [
                            "To rule as a tyrant."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9d6c4341-194d-4e64-8f1a-5743b675cdfb",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "The prince tyrannized over his subjects."
                            },
                            {
                                "example_id": "a0f54319-4de4-46d8-b042-929435edd8b3",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "What? will they tyrannize vpon the Church?"
                            },
                            {
                                "example_id": "7b378663-cef5-4132-b618-647c65b18a44",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "Ah, Rome! Well, well; I made thee miserable\nWhat time I threw the people’s suffrages\nOn him that thus doth tyrannize o’er me."
                            },
                            {
                                "example_id": "66e5043c-a331-482b-a4c4-bfcbe0bb809c",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "[…] lest som should perswade ye, Lords and Commons, that these arguments of lerned mens discouragement at this your order, are meer flourishes, and not reall, I could recount what I have seen and heard in other Countries, where this kind of inquisition tyrannizes […]"
                            },
                            {
                                "example_id": "2172244b-bed4-46f7-9e18-bd316fe8c058",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "Parental affection, indeed, in many minds, is but a pretext to tyrannize where it can be done with impunity, for only good and wise men are content with the respect that will bear discussion."
                            },
                            {
                                "example_id": "2991c13a-ac02-48d3-9fc0-25d2b966282e",
                                "sense_id": "e88c2a5b-45b6-300f-b581-3206ce48400b",
                                "text": "General Secretary Xi is not destined to tyrannize inside and outside of China forever, unless we allow it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59b3c544-3220-4307-9575-c001fd5e0020",
                        "source_entry_id": "23d6351b-4b88-3e75-8692-a5d6c948f810",
                        "source_sense_description": "oppress someone",
                        "target_lang_word": "tyranniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyranniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fec2907-39fa-32e0-870b-6258330c67f5",
                                        "entry_id": "d90fdd1d-7fa6-300f-b10b-a67cb1589fb1",
                                        "glosses": [
                                            "Gouverner comme un tyran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a7dcbe-c84b-4bc9-9908-bb2a3e057145",
                                                "sense_id": "9fec2907-39fa-32e0-870b-6258330c67f5",
                                                "text": "Ce prince, ce gouverneur, ce magistrat tyrannise les peuples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dce71ff-4a49-36ec-a92e-74e5f1a4ee0d",
                                        "entry_id": "d90fdd1d-7fa6-300f-b10b-a67cb1589fb1",
                                        "glosses": [
                                            "Traiter tyranniquement, d’une manière injuste, violente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f40895-ec17-4c4e-bcdf-1bbaa446175e",
                                                "sense_id": "6dce71ff-4a49-36ec-a92e-74e5f1a4ee0d",
                                                "text": "Tyranniser les consciences."
                                            },
                                            {
                                                "example_id": "85d43858-842c-4ea6-b5b2-834257fda9b6",
                                                "sense_id": "6dce71ff-4a49-36ec-a92e-74e5f1a4ee0d",
                                                "text": "Vous me tyrannisez."
                                            },
                                            {
                                                "example_id": "ec72abe8-3d6c-4d2c-88f3-c788b13c6e7d",
                                                "sense_id": "6dce71ff-4a49-36ec-a92e-74e5f1a4ee0d",
                                                "text": "Il tyrannise sa femme, toute sa famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937423b4-85c1-3bfc-9e8b-a622e667af9e",
                                        "entry_id": "d90fdd1d-7fa6-300f-b10b-a67cb1589fb1",
                                        "glosses": [
                                            "Exercer un pouvoir irrésistible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a26ff1b-d446-4989-bcb9-a28cff702520",
                                                "sense_id": "937423b4-85c1-3bfc-9e8b-a622e667af9e",
                                                "text": "De tous les sentiments qui tyrannisent notre âme, il n’en est aucun de plus funeste […] qu’une ambition déréglée, qu’un désir excessif de fausse gloire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e80b55b-e8f1-4202-ba90-404a59ca4d1b",
                        "source_entry_id": "23d6351b-4b88-3e75-8692-a5d6c948f810",
