                            },
                            {
                                "target_lang_word": "неотложность",
                                "target_lang_sense_clarification": "необходимость незамедлительных действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea381f1b-f38a-3544-af4c-60e17cf543e8",
                    "sense_definition": "nagły, niespodziewany i ostry atak bólu lub dolegliwości",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poczuł w klatce piersiowej dziwną <w>nagłość</w>, która odebrała mu na chwilę oddech.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал в груди странный <w>приступ боли</w>, от которого у него на мгновение перехватило дыхание."
                            }
                        },
                        {
                            "text": "Taka niespodziewana <w>nagłość</w> bólu w boku zmusiła go do natychmiastowej wizyty u lekarza.",
                            "target_lang_translations": {
                                "ru": "Такой неожиданный <w>приступ</w> боли в боку вынудил его немедленно обратиться к врачу."
                            }
                        }
                    ],
                    "traits": [
