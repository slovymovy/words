                "senses": [
                    {
                        "sense_id": "81023452-492c-33dd-ad93-fcccb4d52bdd",
                        "entry_id": "e7d06aa9-36a5-381a-a174-079c46fac9c4",
                        "glosses": [
                            "укоротить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "958ef941-1359-3f23-9145-1383ede32da6",
                        "entry_id": "e7d06aa9-36a5-381a-a174-079c46fac9c4",
                        "glosses": [
                            "перен. понять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc76358c-0d67-4f0e-aafb-15107f8af550",
                                "sense_id": "958ef941-1359-3f23-9145-1383ede32da6",
                                "text": "И все снова прибегали читать, пока Туся не усекла, что написано что-то запретное, и не сорвала статью."
                            },
                            {
                                "example_id": "becd8cfd-cb13-4bd1-b6cf-d83b9826b80b",
                                "sense_id": "958ef941-1359-3f23-9145-1383ede32da6",
                                "text": "— Скажите спасибо, что я всё вовремя усекла и подыграла, — сказала пышечка, — другая дура по глупости раскололась бы!"
                            },
                            {
                                "example_id": "a23bf166-2ba1-43b8-be20-89db9738fbd4",
                                "sense_id": "958ef941-1359-3f23-9145-1383ede32da6",
                                "text": "Джекки усекла манёвр противницы и притворилась, что тоже её не видит."
                            }
                        ]
                    }
                ],
