                "senses": [
                    {
                        "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                        "entry_id": "d4076bd8-3a3e-3749-95b2-05653e957b0e",
                        "glosses": [
                            "iemand die bezet, meer in het bijzonder de bezetter van een overwonnen natie in oorlogstijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890870ce-ee13-46db-ae6f-41b204789da4",
                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                "text": "De bezetter was bezig het veel te nationalistische Nationaal Front buiten spel te zetten."
                            },
                            {
                                "example_id": "e64c9658-3657-4ef0-8452-15759d01322d",
                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                "text": "Volgens de overlevering vluchtten meisjes uit Plancher-Les-Mines gedurende de Dertigjarige Oorlog (1618-1648) de bossen in om te ontkomen aan bloeddorstige huurlingen in dienst van de Zweedse bezetter."
                            },
                            {
                                "example_id": "738df002-78b8-49ca-9404-beab9cd292b3",
                                "sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                                "text": "Hendrikx zag in 1940 als 16-jarige jongen hoe de Duitse bezetters zijn dorp binnenmarcheerden. Hij vluchtte naar Canada, kreeg een militaire training en vertrok in 1942 naar Engeland om jachtvlieger op de Spitfire te worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c3b4c34-97aa-422b-8b53-8d95799da2fd",
                        "source_entry_id": "d4076bd8-3a3e-3749-95b2-05653e957b0e",
                        "source_sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                        "source_sense_description": "iemand die bezet, meer in het bijzonder de bezetter van een overwonnen natie in oorlogstijd",
                        "target_lang_word": "Besatzungsmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besatzungsmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                        "entry_id": "88c7144b-9237-3424-affa-218a723182a1",
                                        "glosses": [
                                            "Staat, dessen Truppen ein Gebiet besetzt halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46aab73-690e-4597-a5f3-beb1d2892f24",
                                                "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                                "text": "Die USA sind eine Besatzungsmacht im Irak."
                                            },
                                            {
                                                "example_id": "4d23aed5-90be-4370-8eda-52b128ba34b5",
                                                "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                                "text": "„Zur Koordination des Bildungs-, besonders des Hochschulwesens unter den Besatzungsmächten wurden neue Gremien geschaffen.“"
                                            },
                                            {
                                                "example_id": "41d73f81-3acc-4f8b-8109-4da3e7ab9751",
                                                "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                                "text": "„Erst nach einer Woche bin ich halbwegs wieder ansprechbar; ich erzähle meine pommerschen Geschichten und erfahre im Austausch etwas von deutschen Zuständen, von Besatzungsmacht und Besatzungszonen, von den Alliierten in Berlin.“"
                                            },
                                            {
                                                "example_id": "fde450fd-ece6-4aaf-8a28-e43761e19ae9",
                                                "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                                "text": "„Dies hieß, dass jede Besatzungsmacht in ihrer Zone nach Belieben schalten und walten und damit jedwede zonenübergreifende Politik verhindern konnte.“"
                                            },
                                            {
                                                "example_id": "dbc3eca3-b418-4303-a639-12fa9ef7992e",
                                                "sense_id": "0e49f718-7818-3768-8832-37e4a162e747",
                                                "text": "„Die neue Republik, die Bundesrepublik von 1949, war das Werk dreier Besatzungsmächte und eines Grundgesetzes, das sich die damals neuen Bundesländer durch Delegierte am Chiemsee gegeben hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae9addc-7877-465d-b5af-8a5fd5392251",
                        "source_entry_id": "d4076bd8-3a3e-3749-95b2-05653e957b0e",
                        "source_sense_id": "c78c5c95-2273-34ab-a8f6-641abeae3e09",
                        "source_sense_description": "iemand die bezet, meer in het bijzonder de bezetter van een overwonnen natie in oorlogstijd",
                        "target_lang_word": "Besatzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besatzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                        "entry_id": "ff21ff81-e3b3-3556-80eb-b2af35a42145",
                                        "glosses": [
                                            "Angehöriger einer Besatzungsmacht, meist Soldat der Besatzungsarmee"
                                        ],
                                        "tags": [
                                            "oft abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce9cc2d-12ae-456e-8841-080feaadb648",
                                                "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                                "text": "Die Bevölkerung war gespalten: Einige hielten die Besatzer für Befreier, andere für Unterdrücker."
                                            },
                                            {
                                                "example_id": "d32e006c-fc59-47de-a7aa-c8956b8974b7",
                                                "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                                "text": "„Andere Pflanzer blieben und produzierten für die Besatzer.“"
                                            },
                                            {
                                                "example_id": "f44133c5-c47d-4064-a125-cc94d6eed104",
                                                "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                                "text": "„Trotz strenger Rationierung mussten Inselbewohner und Besatzer mehrere Monate lang hungern.“"
                                            },
                                            {
                                                "example_id": "5f79b130-d722-4139-ae0f-0bd40250b8cb",
                                                "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                                "text": "„Sie feierten ihre anfänglichen Siege und versenkten Bruttoregistertonnen und führten sich ausgiebig als Besatzer auf.“"
                                            },
                                            {
                                                "example_id": "da4fefd4-25a9-4f6c-9ab9-21f7170e6cb8",
                                                "sense_id": "1b4dea74-641e-325e-ad70-45ca6101b6cb",
                                                "text": "„Seit Jahrzehnten streiten beide Länder um Reparationen für die Zerstörungen der Kriegsjahre und die Gräueltaten der Besatzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
