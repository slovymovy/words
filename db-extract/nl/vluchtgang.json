                        "examples": [
                            {
                                "example_id": "e37ff12f-5e6f-49cf-a57f-9f04efbcd72c",
                                "sense_id": "162633bb-4466-3de6-8758-8be92b646cdb",
                                "text": "Maandag brak brand uit in een elektrakast in de vluchtgang naast de tunnelbuis. Daardoor raakten ruim zeventig kabels beschadigd en deden de verlichting, ventilatie en camera's het niet meer. De tunnel werd in de richting van Den Haag gesloten, omdat de veiligheid niet kon worden gewaarborgd. Inmiddels zijn de beschadigde kabels vervangen."
                            },
                            {
                                "example_id": "271b47ab-580c-4143-bb86-44624aa9b7a8",
                                "sense_id": "162633bb-4466-3de6-8758-8be92b646cdb",
                                "text": "De weg werd vanmiddag in de richting van Den Haag afgesloten na een brandje in de vluchtgang van de tunnel. Dat was snel geblust, maar het vuur heeft wel de stroomtoevoer beschadigd van de verlichting, de matrixborden en de camera's die het verkeer in de tunnel monitoren. Die moet nu worden hersteld en dat kost tijd, zegt Rijkswaterstaat. Elektronisch verkeerstoezicht is wettelijk vereist voor het openen van een tunnel voor verkeer."
                            }
                        ]
                    }
