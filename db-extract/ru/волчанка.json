                "senses": [
                    {
                        "sense_id": "74a94ff3-7287-3011-8677-43642f2d877d",
                        "entry_id": "531f3b43-f4ef-3627-bf27-9dd63e78c84f",
                        "glosses": [
                            "мед. наименование группы заболеваний различной этиологии, с поражением, в том числе, кожи лица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365d7676-a695-4d67-b816-d1f4da70be1d",
                                "sense_id": "74a94ff3-7287-3011-8677-43642f2d877d",
                                "text": "Проанализированы все основные формы нейроревматизма, нейродерматомиозит, узелковый периартериит, склеродермия, системная красная волчанка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d277215-cc61-4f57-b252-24a55740bba1",
                        "source_entry_id": "531f3b43-f4ef-3627-bf27-9dd63e78c84f",
                        "source_sense_id": "74a94ff3-7287-3011-8677-43642f2d877d",
                        "target_lang_word": "lupus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                                        "glosses": [
                                            "Lupus érythémateux (maladie auto-immune)."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c05b5593-e9de-4899-8778-6f2c760f7ffb",
                                                "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                                                "text": "En 2001, une équipe du CNRS découvre qu’un peptide (un fragment de protéine) pourrait soigner le lupus, pathologie frappant le système immunitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                                        "glosses": [
                                            "Lupus vulgaris (Ulcère tuberculeux)"
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a666e455-d51d-4982-b3aa-2880d0527529",
                                                "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                                                "text": "Le lupus peut être considéré comme une tuberculose primitive, et par suite différer de la tuberculose secondaire de la peau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
