{
    "word_family": [
        "omen",
        "ominous",
        "ominousness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                    "sense_definition": "In a way that suggests something bad or unpleasant is going to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foreboding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds gathered <w>ominously</w> over the valley before the storm began.",
                            "target_lang_translations": {
                                "nl": "Donkere wolken pakten zich <w>onheilspellend</w> samen boven de vallei voordat de storm begon.",
                                "zh": "暴风雨来临前，乌云<w>不祥地</w>笼罩在山谷上空。"
                            }
                        },
                        {
                            "text": "The engine started making an <w>ominously</w> loud noise as we drove up the hill.",
                            "target_lang_translations": {
                                "nl": "De motor begon <w>onheilspellend</w> veel lawaai te maken toen we de heuvel op reden.",
                                "zh": "当我们开车上山时，发动机开始发出<w>令人不安地</w>巨大响声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forebodingly",
                        "sinisterly",
                        "threateningly"
                    ],
                    "antonyms": [
                        "auspiciously",
                        "promisingly"
                    ],
                    "common_phrases": [
                        "loom ominously",
                        "gather ominously",
                        "ominously silent",
                        "creak ominously"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier die doet vermoeden dat er iets slechts of onaangenaams gaat gebeuren.",
                        "zh": "以预示着不好或令人不快的事情即将发生的方式；不祥地，不吉利地。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onheilspellend",
                                "target_lang_sense_clarification": "als voorbode van naderend onheil of gevaar"
                            },
                            {
                                "target_lang_word": "dreigend",
                                "target_lang_sense_clarification": "gevaar of onheil aankondigend"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不祥地",
                                "target_lang_sense_clarification": "预示将有厄运或坏事发生"
                            },
                            {
                                "target_lang_word": "令人不安地",
                                "target_lang_sense_clarification": "使人感到隐隐担忧或恐惧"
                            },
                            {
                                "target_lang_word": "阴森地",
                                "target_lang_sense_clarification": "气氛险恶、充满威胁感"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}