                ],
                "senses": [
                    {
                        "sense_id": "ce1bb90d-a714-3f22-aee4-bb116e1a91eb",
                        "entry_id": "ecae8526-8d43-3ba5-8a73-1ccb74405d95",
                        "glosses": [
                            "Aktivität, um anderen zu helfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a279bf-fcfe-4abf-82bd-44f133751fe2",
                                "sense_id": "ce1bb90d-a714-3f22-aee4-bb116e1a91eb",
                                "text": "„Heute werde ich mich nicht für den Hilfsdienst melden.“"
                            },
                            {
                                "example_id": "82e5141d-9e42-4a7c-af48-87c72de77e31",
                                "sense_id": "ce1bb90d-a714-3f22-aee4-bb116e1a91eb",
                                "text": "„Der Kriegshilfsdienst wird abgeleistet innerhalb des Gebietes des Großdeutschen Reiches 1. durch Hilfsdienst im Bürobetrieb bei Dienststellen der Wehrmacht und bei Behörden, 2. durch Hilfsdienst in Krankenhäusern und bei sozialen Einrichtungen, 3. durch Hilfsdienst bei hilfsbedürftigen, insbesondere kinderreichen Familien.“ (1944)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48a5fdf3-74e8-3fd1-8870-2dfc2403bb58",
                        "entry_id": "ecae8526-8d43-3ba5-8a73-1ccb74405d95",
                        "glosses": [
                            "Organisation, die dazu da ist, Hilfe zu leisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d04416-7981-44bb-a705-086d54badb56",
                                "sense_id": "48a5fdf3-74e8-3fd1-8870-2dfc2403bb58",
                                "text": "„Der Hilfsdienst der evangelischen Kirche sondiert bei der polnischen Regierung die Möglichkeit der Ausreise anhangloser deutscher Kinder aus den polnisch verwalteten deutschen Ostprovinzen.“"
                            },
                            {
                                "example_id": "1b2fd17c-977b-4486-9b3b-f0670aaaed5a",
                                "sense_id": "48a5fdf3-74e8-3fd1-8870-2dfc2403bb58",
                                "text": "Der Hilfsdienst konzentrierte sich bei seiner Arbeit vor allem auf die Bereiche gesundheitliche und humanitäre Hilfe."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
