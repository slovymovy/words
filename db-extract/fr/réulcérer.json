                "senses": [
                    {
                        "sense_id": "e2871724-f7a2-3e29-b6ec-9a6e1b404a9f",
                        "entry_id": "2d494f1e-bf7c-343d-a32d-5649e17ba796",
                        "glosses": [
                            "Ulcérer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0aaf54-bff3-4032-8333-4cbe296a0e4f",
                                "sense_id": "e2871724-f7a2-3e29-b6ec-9a6e1b404a9f",
                                "text": "Du 10 juillet au 50 septembre, l'aspect du moignon ne se modifie pas, mais la petite plaie cachée au fond du pli transversal ne se cicatrise que pour bientôt se réulcérer."
                            },
                            {
                                "example_id": "709e5c67-ebef-447e-bada-16b98b0ecdf5",
                                "sense_id": "e2871724-f7a2-3e29-b6ec-9a6e1b404a9f",
                                "text": "celui-ci survient chez des scrofuleux avérés et est caractérisé par le développement progressif d'une ulcération destructive, débutant à la jonction de la peau et de la muqueuse, ulcération irrégulière, à bords nettement découpés, nullement indurée, pouvant se cicatriser partiellement pour se réulcérer ensuite."
                            }
                        ]
                    }
