                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfwoord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "27c55684-1742-335a-b6de-8992d01416a5",
                                        "entry_id": "265a1af6-2934-3cd5-9547-d118c28988d7",
                                        "glosses": [
                                            "overgeërfd inheems woord, enkelvoudig onderdeel van de woordenschat van een taal dat daar altijd onderdeel van is geweest en dus niet het resultaat is van woordvorming in die taal of ontlening uit een andere taal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf91092e-c1e7-4ce3-983d-75c128b16e23",
                                                "sense_id": "27c55684-1742-335a-b6de-8992d01416a5",
                                                "text": "Woorden als 'roest' en 'ei' zijn erfwoorden."
                                            },
                                            {
                                                "example_id": "fa5cfef5-a832-4cce-9353-0c52d15fd6ea",
                                                "sense_id": "27c55684-1742-335a-b6de-8992d01416a5",
                                                "text": "Het grootste deel van de woorden die we in plaatsnamen vinden, is erfwoord. Dat is logisch: het Nederlands was nog maar net bezig zich te ontwikkelen als aparte taal uit het Germaans. Bovendien duiden de meeste woorden algemene begrippen uit de natuur aan, die bij de Germanen allang bekend waren."
                                            }
                                        ]
                                    }
                                ]
                            }
