{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d7feacf-1779-3171-9dcc-b5b234a05488",
                    "sense_definition": "Appealing to the sense of taste; smelling or looking delicious enough to make one's mouth water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appetizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery window was filled with <w>mouthwatering</w> pastries and fresh breads.",
                            "target_lang_translations": {
                                "ru": "Витрина пекарни была заполнена <w>аппетитнейшей</w> выпечкой и свежим хлебом."
                            }
                        },
                        {
                            "text": "She prepared a <w>mouthwatering</w> meal that delighted all of her dinner guests.",
                            "target_lang_translations": {
                                "ru": "Она приготовила такое <w>аппетитное</w> блюдо, что все гости за ужином пришли в восторг."
                            }
                        }
                    ],
                    "synonyms": [
                        "appetizing",
                        "delicious",
                        "scrumptious"
                    ],
                    "antonyms": [
                        "unappetizing",
                        "distasteful"
                    ],
                    "common_phrases": [
                        "mouthwatering aroma",
                        "mouthwatering food",
                        "mouthwatering dessert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий слюнки; выглядящий или пахнущий настолько аппетитно и вкусно, что хочется съесть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппетитный",
                                "target_lang_sense_clarification": "о еде или ее виде/запахе"
                            },
                            {
                                "target_lang_word": "слюнки текут",
                                "target_lang_sense_clarification": "в предикативном употреблении о вкусной еде"
                            },
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "о блюдах, десертах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "518d745c-47f1-39f3-8203-6a69e69468ea",
                    "sense_definition": "Extremely enticing, tantalizing, or attractive, especially regarding offers, opportunities, or rewards.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enticing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered him a <w>mouthwatering</w> salary package that he could not refuse.",
                            "target_lang_translations": {
                                "ru": "Компания предложила ему настолько <w>заманчивый</w> зарплатный пакет, что он не смог отказаться."
                            }
                        },
                        {
                            "text": "Investors were drawn to the project by the promise of <w>mouthwatering</w> profits.",
                            "target_lang_translations": {
                                "ru": "Инвесторов привлекло в проект обещание <w>соблазнительной</w> прибыли."
                            }
                        }
                    ],
                    "synonyms": [
                        "enticing",
                        "tantalizing",
                        "alluring"
                    ],
                    "antonyms": [
                        "unattractive"
                    ],
                    "common_phrases": [
                        "mouthwatering prospect",
                        "mouthwatering sum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно заманчивый, соблазнительный или привлекательный (о предложениях, перспективах, выгоде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заманчивый",
                                "target_lang_sense_clarification": "о предложении, перспективе"
                            },
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "о выгоде, условиях"
                            },
                            {
                                "target_lang_word": "лакомый",
                                "target_lang_sense_clarification": "о куске, предложении или добыче"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}