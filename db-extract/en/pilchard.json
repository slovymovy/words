                "senses": [
                    {
                        "sense_id": "87b84e43-566a-35a8-97f0-40088eba0ded",
                        "entry_id": "a961f2cf-c561-3823-93ce-175367a0d01e",
                        "glosses": [
                            "Any of various small oily fish related to herrings, family Clupeidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa6add4-8a74-4fb5-8b9c-212449d82933",
                                "sense_id": "87b84e43-566a-35a8-97f0-40088eba0ded",
                                "text": "1839, John Hookham Frere (translator), The Birds, lines 76–77, in Acharnians and two other plays\nHe longs occasionally for human diet,\nHis old Athenian fare: pilchards, for instance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab06d7b1-c6de-49ea-8738-aa5e08dd748a",
                        "source_entry_id": "a961f2cf-c561-3823-93ce-175367a0d01e",
                        "source_sense_id": "87b84e43-566a-35a8-97f0-40088eba0ded",
                        "source_sense_description": "a cigar-shaped fish with a short dorsal fin and forked tail",
                        "target_lang_word": "pilchard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilchard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1a322d-1982-3ec8-bbb5-c1b4f4769318",
                                        "entry_id": "9594eda8-9231-3518-972e-d3af3df19b47",
                                        "glosses": [
                                            "Grande sardine de la Manche qui se vend en boîtes comme les harengs ou les maquereaux. — Sardina pilchardus (wikispecies)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbdd63c-f59f-47ec-a592-f812deb395d7",
                                                "sense_id": "6d1a322d-1982-3ec8-bbb5-c1b4f4769318",
                                                "text": "Qu’est-ce maintenant que le pilchard ? Ce poisson (clupea pilchardus) appartient bien à la famille des harengs; mais il s’en détache par quelques caractères extérieurs : il a la tête plus courte, le corps plus trapu, la nageoire dorsale placée plus en avant, vers le centre de gravité; mais il est surtout recouvert de plus longues écailles que le hareng ordinaire."
                                            },
                                            {
                                                "example_id": "411c30d7-9622-4480-bb55-d602aaf68238",
                                                "sense_id": "6d1a322d-1982-3ec8-bbb5-c1b4f4769318",
                                                "text": "Les écailles miroitantes, les nageoires lumineuses, les queues étincelantes, les yeux nacrés des pilchards formaient une grande masse de lumière liquide qui flottait, palpitait, ondulait, et s'avançait vers les filets, tumultueuse et précipitée."
                                            },
                                            {
                                                "example_id": "e9c94dda-b5b4-4453-a8ff-cb1d24968233",
                                                "sense_id": "6d1a322d-1982-3ec8-bbb5-c1b4f4769318",
                                                "text": "À la première épicerie venue nous achetâmes sur les conseils de Gaston une énorme boîte ovale de pilchards. Personne à part lui ne savait ce que c'était, donc il n'y eut pas d'objection."
                                            },
                                            {
                                                "example_id": "672e878e-92c2-4a73-8dba-f7d4365a200c",
                                                "sense_id": "6d1a322d-1982-3ec8-bbb5-c1b4f4769318",
                                                "text": "Pour les demi-litres, des bouteilles de Fanta ou Coca vides feraient l'affaire, les boites de pilchard tenaient lieu de mesures pour les quarts de litre […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86839054-c213-48ec-bd39-4608e21e3f8e",
                        "source_entry_id": "a961f2cf-c561-3823-93ce-175367a0d01e",
                        "source_sense_id": "87b84e43-566a-35a8-97f0-40088eba0ded",
                        "source_sense_description": "a cigar-shaped fish with a short dorsal fin and forked tail",
                        "target_lang_word": "Sardine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                        "entry_id": "5667098e-1c0e-38b4-bd45-3c4876073f20",
                                        "glosses": [
                                            "ein Meeresfisch (Sardina pilchardus), verwandt mit dem Hering"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acfca031-8e41-4f9b-8a9a-c4f2e61787e3",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "Das ist eine Sardine."
                                            },
                                            {
                                                "example_id": "fe1a672a-0934-4329-887e-f241921a23c2",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Sardinen bevölkern in riesigen Schwärmen nahezu alle Weltmeere.“"
                                            },
                                            {
                                                "example_id": "9eff6a3f-aad6-4bfc-8bce-58232e3a57ae",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Studien belegen zudem, dass Fisch in Blech kaum Nährstoffe einbüßt und gerade klassische Dosenfische wie Makrele, Sardinen und Hering sind gute Lieferanten von Omega3-Fettsäure, die auf jedem Ernährungsplan mit Ausrufezeichen steht.“"
                                            },
                                            {
                                                "example_id": "2d9af4c9-677c-477d-9c2e-1080cbf7bd08",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Ich drehte mich schnell um und beruhigte sie, nur ich sei es, der um Sardinen anstünde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
