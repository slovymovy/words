                                        "sense_id": "5ad819b1-855f-3fef-9895-dbc06280d39c",
                                        "entry_id": "d6fea007-ee52-3374-833e-c6eea08fb1cf",
                                        "glosses": [
                                            "Variante orthographique de abénaquis."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
