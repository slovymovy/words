                        "cross_references": [
                            {
                                "target_word": "ядрышко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98a3e04c-4005-3a0d-81ca-820d65f2a678",
                                        "entry_id": "4fcade5f-0bb5-3884-ab3a-fd29d83f8b31",
                                        "glosses": [
                                            "уменьш.-ласк. к ядро"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0af6819-6826-4549-aec2-5696fcc8ef77",
                                                "sense_id": "98a3e04c-4005-3a0d-81ca-820d65f2a678",
                                                "text": "И всё-таки, несмотря на то, догадливые пушкари забивали калёное ядрышко в медную пушечку и палили в тот во честной монастырь, в Соловецкий."
                                            },
                                            {
                                                "example_id": "637f28d6-6488-4155-913f-276d64aee0f4",
                                                "sense_id": "98a3e04c-4005-3a0d-81ca-820d65f2a678",
                                                "text": "Вставив в уши крошечные пластиковые ядрышки, я нажал клавишу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "addb09d7-535b-3176-94e7-56616ea2c34a",
                                        "entry_id": "4fcade5f-0bb5-3884-ab3a-fd29d83f8b31",
                                        "glosses": [
                                            "внутренняя часть плода (обычно ореха), заключённая в твёрдую оболочку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250fc2ac-94e7-49e9-98d6-f5e34dfa5839",
                                                "sense_id": "addb09d7-535b-3176-94e7-56616ea2c34a",
                                                "text": "Мельник не разгрызал каштаны зубами, а каким-то образом пальцами продавливал кожуру и уже очищенное ядрышко отправлял в рот."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcf2795-a611-3a95-ad4d-9c94c819374a",
                                        "entry_id": "4fcade5f-0bb5-3884-ab3a-fd29d83f8b31",
                                        "glosses": [
                                            "микробиол. немембранный внутриядерный отсек субкомпартмент в клетках эукариотических организмов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e858db21-3520-429e-9d74-cc7273e0afcc",
                                                "sense_id": "0dcf2795-a611-3a95-ad4d-9c94c819374a",
                                                "text": "Ядро имеет ядерную оболочку — нуклеолемму, хроматин, ядрышко и ядерный сок — нуклеоплазму."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
