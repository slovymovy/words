                "senses": [
                    {
                        "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                        "entry_id": "3d359983-fc5d-389c-8183-5d9af8217796",
                        "glosses": [
                            "Video, das zu Übungszwecken beim Erlernen bestimmter Fähigkeiten oder Kenntnisse dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d6a0f5-4889-4cbb-9110-1d81ae0103a0",
                                "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                                "text": "„In dieser Kategorie findet ihr interessante Übungsvideos zur Datenmodellierung.“"
                            },
                            {
                                "example_id": "ece24560-c958-4e38-9aff-d6061fb18c00",
                                "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                                "text": "„Um optimal üben zu können, erhältst du mit dem Schulterretter auch einen kostenfreien Zugang zu Anwendungs- und Übungsvideos.“"
                            },
                            {
                                "example_id": "5059112d-67e1-4c98-b908-c9741c59536b",
                                "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                                "text": "„Starte jetzt und sieh in unseren Übungsvideos, wie du die wahre Ursache deiner Schmerzen mit ganz einfachen Übungen besiegen kannst.“"
                            },
                            {
                                "example_id": "58f90b9a-253b-4ff0-8909-73bc05335c1c",
                                "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                                "text": "„Dann schau dir doch das Fortsetzungsvideo zu den spanischen Zahlen von 11 bis 100 und das dazugehörige Übungsvideo an.“"
                            },
                            {
                                "example_id": "de104164-3044-46b3-a606-71a2a7e564f6",
                                "sense_id": "502d97c1-6ee4-3c91-840f-947e1b163316",
                                "text": "„Zu jedem Übungsvideo gibt es detaillierte Erklärungen, damit Du von Anfang an lernst, die Übungen richtig durchzuführen und Fehler bei deinen Kunden zu erkennen, wenn sie die Übungen ausführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
