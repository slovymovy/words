                    {
                        "translation_id": "6197b5b0-255d-4d84-8217-c9897f950e21",
                        "source_entry_id": "a1e7631c-4af2-3946-91a3-58b0f41623f6",
                        "source_sense_description": "Greek god Hermes",
                        "target_lang_word": "Hermès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hermès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a775bb5-9b83-34ed-87c5-94292c1d16a4",
                                        "entry_id": "bbb0de65-6c50-330a-8c99-3835e9d30395",
                                        "glosses": [
                                            "Dieu de l’éloquence, du commerce, des voyageurs et des voleurs."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f200a9aa-b8dd-4672-a165-63c1078b4fd7",
                                                "sense_id": "2a775bb5-9b83-34ed-87c5-94292c1d16a4",
                                                "text": "Mais dès qu’Hermès volait les flamboyantes vaches\nDu fils d’Hypérion baigné des flots profonds,\nEkhidna, sur le seuil ouvert au flanc des monts,\nS’avançait, dérobant sa croupe aux mille taches."
                                            },
                                            {
                                                "example_id": "4c8fdd81-65b2-4e5c-906c-17d0be734d16",
                                                "sense_id": "2a775bb5-9b83-34ed-87c5-94292c1d16a4",
                                                "text": "Hermès le secourable, le dieu des rencontres, ne deviendrait-il pas pour nous le dieu de l’amitié, ne nous offrirait-il pas avec des hommes plus jeunes ou plus vieux que nous-mêmes de recommencer la vie ?"
                                            },
                                            {
                                                "example_id": "e7937164-6ea3-4f31-80e1-58fad6b89b2a",
                                                "sense_id": "2a775bb5-9b83-34ed-87c5-94292c1d16a4",
                                                "text": "Souvent, un moment plus tard, Egon quitte silencieusement son fauteuil de rotin, et rejoint Jeanne au bord de la mer, portant sur l’épaule Axel comme l’Hermès des musées porte l’enfant Bacchus."
                                            },
                                            {
                                                "example_id": "af739a8b-1760-41cc-8ef5-8b9a2d373b8d",
                                                "sense_id": "2a775bb5-9b83-34ed-87c5-94292c1d16a4",
                                                "text": "Il dépêcha son fidèle Hermès sous la terre, afin de convaincre cette fois Hadès de délivrer Perséphone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a2eb302-ec14-3236-a223-4405bd8bad62",
                                        "entry_id": "bbb0de65-6c50-330a-8c99-3835e9d30395",
                                        "glosses": [
                                            "Forme courte de l’enseigne Hermès Paris, groupe commercial d’articles de luxe spécialisé dans la maroquinerie, la parfumerie, l’horlogerie, le prêt-à-porter et les arts de la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f5a2ab-4615-4249-a051-e8ce383a5d24",
                                                "sense_id": "9a2eb302-ec14-3236-a223-4405bd8bad62",
                                                "text": "Je suis allée chez Hermès parce que j’adore leurs parfums unisexes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
