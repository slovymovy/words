        "fr-extract.jsonl": [
            {
                "entry_id": "fa661c59-9fa0-3cdb-98a5-fd4bd6d02709",
                "word": "envisageable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a42f743b-adf4-4597-bf3c-b69b9f9c703d",
                        "entry_id": "fa661c59-9fa0-3cdb-98a5-fd4bd6d02709",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "envisageables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                        "entry_id": "fa661c59-9fa0-3cdb-98a5-fd4bd6d02709",
                        "glosses": [
                            "Qui peut être envisagé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7cebd6-343b-4d6b-8200-a57772eb368b",
                                "sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                                "text": "L’après-midi même on me téléphonait mais pour me dire très aimablement qu’il n'était pas envisageable de savoir quoi que ce soit jusqu’à nouvel ordre."
                            },
                            {
                                "example_id": "eeead7dc-3137-483d-a5ee-b5d755a65b5f",
                                "sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                                "text": "Jean-François Delfraissy pense qu’il sera envisageable de lever le pass vaccinal dès le printemps."
                            },
                            {
                                "example_id": "d48c996a-9274-4bc0-8d89-32c8405f898e",
                                "sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                                "text": "En moins de 24h, les tensions entre l’Ukraine et la Russie se sont accrues de manière significative. Alors qu’une proposition de paix restait encore envisageable, la Russie annonçait ce lundi l’indépendance des séparatistes prorusses d’Ukraine."
                            },
                            {
                                "example_id": "8c73f669-086a-43a3-83e3-8044d003c5d9",
                                "sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                                "text": "On est dans la même galère. La seule solution envisageable, c'est que l'un s'occupe du cadavre pendant que l'autre s'occupe de Krazy-8."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51c6547d-67fc-4f36-b1a5-379aa5dc692e",
                        "source_entry_id": "fa661c59-9fa0-3cdb-98a5-fd4bd6d02709",
                        "source_sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
                        "target_lang_word": "vorstellbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorstellbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                        "entry_id": "ee61d281-6521-30a4-bf51-2804922ddff5",
                                        "glosses": [
                                            "sich etwas vorstellen können, sich ein Bild von etwas machen können; Verwendung: häufig negativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8cb469-b727-4399-948e-9138585067bb",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Dass Herr Meier unser neuer Abteilungsleiter wird, ist durchaus vorstellbar."
                                            },
                                            {
                                                "example_id": "e0bf8d7f-abbb-4006-96d2-c047dbf5bad1",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es ist für kaum vorstellbar, dass wir in diesem Jahr von Umweltkatastrophen verschont bleiben werden."
                                            },
                                            {
                                                "example_id": "40182d86-0973-4ea8-bb24-97d4bc5176e0",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Profisportler, egal ob Radfahrer, Fußballer oder Basketballer, ist heute kaum noch vorstellbar ohne Werbung irgendwo auf der Kleidung. Aber wenn man Bilder aus den 50er und 60ern sieht, wird man eines besseren belehrt."
                                            },
                                            {
                                                "example_id": "34584982-0768-420f-aca3-2edc528f58da",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Noch vor wenigen Monaten war es kaum vorstellbar: Jetzt erlaubt die US-Regierung zum ersten Mal seit über 50 Jahren einige Importe aus Kuba."
                                            },
                                            {
                                                "example_id": "b4b529fb-6f26-4266-8d8c-8ae65f2933af",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Es schien eigentlich kaum vorstellbar, dass es zwischen Deutschland und Israel nach dem Holocaust noch \"normale\" Beziehungen geben könne. Und doch gibt es Normalität in der Anormalität, meint Alexander Kudascheff."
                                            },
                                            {
                                                "example_id": "fc632778-ca9d-4af8-a79a-e5cf7e8ae826",
                                                "sense_id": "706b9bb7-3aa0-3a24-9dae-7a360578081d",
                                                "text": "Ein Rockkonzert, ohne die Musik zu hören? Für die meisten ist das nicht vorstellbar. Doch Laura Schwengber macht durch Zeichensprache, Bewegung und Tanz auch für Gehörlose ein lebendiges Konzerterlebnis möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69509ca1-cede-4470-93a3-b398b2f58939",
                        "source_entry_id": "fa661c59-9fa0-3cdb-98a5-fd4bd6d02709",
                        "source_sense_id": "772ec2bd-9d99-305e-bca0-f92badcb9e71",
