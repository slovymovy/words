                                        "entry_id": "f8964dc7-10f9-3579-a355-ee95758571a4",
                                        "glosses": [
                                            "Plante annuelle à fleurs jaunes, commune en Europe, Asie occidentale et centrale et Afrique du Nord, proche des deux espèces cultivées à des fins alimentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d2ca33-bd10-407d-915f-eab8363f8a99",
                                                "sense_id": "528507bd-e932-34c3-82b8-c5ea88f4b419",
                                                "text": "Dans quelques cantons, on mange les feuilles de la moutarde des champs, ou crues, ou cuites, assaisonnées de diverses manières."
                                            },
                                            {
                                                "example_id": "e4688eb4-3265-4093-8228-ec00eb909a58",
                                                "sense_id": "528507bd-e932-34c3-82b8-c5ea88f4b419",
                                                "text": "C’est en mars et en avril que les levées de moutarde des champs sont habituellement les plus nombreuses et les plus actives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39528284-af48-4c47-8817-162593e1de36",
                        "source_entry_id": "152fe74a-aace-37c8-a4da-f5083be834ee",
