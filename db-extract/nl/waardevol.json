                        "examples": [
                            {
                                "example_id": "bf37a890-d7f5-41ed-a4d9-4951da2695c9",
                                "sense_id": "3d592131-f0ff-3bb4-90ba-679e640b7b55",
                                "text": "Dit is zijn waardevolste bezit."
                            },
                            {
                                "example_id": "188d1dae-c249-4a0d-aaf2-a2593b9b7667",
                                "sense_id": "3d592131-f0ff-3bb4-90ba-679e640b7b55",
                                "text": "Duidelijk blijkt dat de diepere betekenis voor ons nog even waardevol is. Voor de viering zullen wij, terugdenkend aan vroeger, zeker veel mogelijkheden vinden."
                            },
                            {
                                "example_id": "ac23ee97-3b1e-4cdc-896a-0ec6046fcc1d",
                                "sense_id": "3d592131-f0ff-3bb4-90ba-679e640b7b55",
                                "text": "Wat moest ik hiermee, al dat zweverige gepraat over het universum? Toch was het een waardevolle ontmoeting."
                            }
                        ]
                    }
                ],
