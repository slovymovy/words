                "senses": [
                    {
                        "sense_id": "2cb46967-8c59-32d7-9939-6d22de20ecf2",
                        "entry_id": "5beadefe-a974-37e2-ab8e-a90450042c6e",
                        "glosses": [
                            "Se faire concurrence."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5134d8-11da-423b-83cb-f09af6126007",
                                "sense_id": "2cb46967-8c59-32d7-9939-6d22de20ecf2",
                                "text": "La façon dont la Ville nous remercie : on augmente nos taxes et on ouvre des commerces qui essentiellement, nous compétitionnent."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d1651cd-fccb-3b47-a6f7-83c7888cbaf0",
                        "entry_id": "5beadefe-a974-37e2-ab8e-a90450042c6e",
                        "glosses": [
                            "Être en compétition."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "caa502ab-5e86-447c-9f1c-ad7a32e172b8",
                                "sense_id": "5d1651cd-fccb-3b47-a6f7-83c7888cbaf0",
                                "text": "À la boxe, comme parfois à la lutte ou même dans les arts martiaux mixtes, les athlètes compétitionnent dans la catégorie la plus légère qu’ils peuvent atteindre à la pesée."
                            }
                        ]
                    }
