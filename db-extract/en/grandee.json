                                "target_senses": [
                                    {
                                        "sense_id": "51d3361a-89b8-36fe-8078-65694dd8ad62",
                                        "entry_id": "7175cafa-7981-3ce2-8867-c65e3e60f84e",
                                        "glosses": [
                                            "iemand die behoort tot de machtigste mannen van een rijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4bf50f5-0b2f-44d4-b3b3-3e605767b480",
                                                "sense_id": "51d3361a-89b8-36fe-8078-65694dd8ad62",
                                                "text": "Het museo Correale is een paleisachtige villa, een adellijk bezit. Een van de grandes van het hof van de Bourbonnenkoning heeft er gewoond en schilderijen gekocht."
                                            },
                                            {
                                                "example_id": "a75280c5-4b6a-46ee-94ab-f960084d6807",
                                                "sense_id": "51d3361a-89b8-36fe-8078-65694dd8ad62",
                                                "text": "\"Eenheid van recht\" woei van het admiraalsschip; \"Vooruitgang\" juichten alle sloepen. De grandes van Amsterdam II, Breukelen en Apeldoorn wedijverden in heilbeden, terwijl zij zee koos. Wel mocht de minister, die haar zoo zag henenzeilen, dankbaar en hoopvol lachen over zijn Armada, zijn Welbewapende. Wie zou haar keeren?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36c89fa0-885a-367d-9a36-dff44ab6675e",
                                        "entry_id": "7175cafa-7981-3ce2-8867-c65e3e60f84e",
                                        "glosses": [
                                            "titel voor hoogste adel"
                                        ],
                                        "tags": [
                                            "Spanje, Portugal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c70d6ac-377c-4bac-9b99-8c19cee526ce",
                                                "sense_id": "36c89fa0-885a-367d-9a36-dff44ab6675e",
                                                "text": "De hertog van Alva, één van dé grandes van Spanje, is meer geweest dan alleen maar landvoogd en duivel-in-persoon van de Nederlanden."
                                            },
                                            {
                                                "example_id": "7dba003d-f859-4184-8839-41b511464664",
                                                "sense_id": "36c89fa0-885a-367d-9a36-dff44ab6675e",
                                                "text": "Iedere grande van Spanje vormde zijne bende uit personen van rang; (…)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
