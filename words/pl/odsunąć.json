    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f81c115d-8d03-39eb-8516-5841963dff37",
                    "sense_definition": "sunąc, oddalić coś na pewną odległość od kogoś lub od czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przemieszczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę, <w>odsuń</w> krzesło od stołu, żebym mógł swobodnie przejść.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>отодвинь</w> стул от стола, чтобы я мог спокойно пройти."
                            }
                        },
                        {
                            "text": "Mężczyzna szybko <w>odsunął</w> talerz, dając do zrozumienia, że skończył już obiad.",
                            "target_lang_translations": {
                                "ru": "Мужчина быстро <w>отодвинул</w> тарелку, давая понять, что уже закончил обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesunąć"
                    ],
                    "common_phrases": [
                        "odsunąć krzesło",
                        "odsunąć talerz"
                    ],
                    "target_lang_definitions": {
                        "ru": "переместить скольжением предмет на некоторое расстояние от кого-то или чего-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отодвинуть",
                                "target_lang_sense_clarification": "предмет в сторону или дальше от себя"
                            },
                            {
                                "target_lang_word": "двинуть",
                                "target_lang_sense_clarification": "в сторону от чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "117cf38c-c4e5-3fcf-ad72-c60de8a6ece8",
                    "sense_definition": "przesunąć coś na bok, aby to otworzyć lub odsłonić",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przemieszczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy rano wstała, od razu <w>odsunęła</w> zasłony, aby wpuścić do sypialni trochę światła.",
                            "target_lang_translations": {
                                "ru": "Проснувшись утром, она сразу <w>раздвинула</w> шторы, чтобы впустить в спальню немного света."
                            }
                        },
                        {
                            "text": "Chłopiec ostrożnie <w>odsunął</w> wieko ciężkiej drewnianej skrzyni znalezionej na strychu.",
                            "target_lang_translations": {
                                "ru": "Мальчик осторожно <w>отодвинул</w> крышку тяжелого деревянного сундука, найденного на чердаке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odsunąć zasłony",
                        "odsunąć firankę"
                    ],
                    "target_lang_definitions": {
                        "ru": "сдвинуть в сторону, чтобы открыть или обнажить что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распахнуть",
                                "target_lang_sense_clarification": "шторы или занавески"
                            },
                            {
                                "target_lang_word": "раздвинуть",
                                "target_lang_sense_clarification": "шторы, створки"
                            },
                            {
                                "target_lang_word": "отодвинуть",
                                "target_lang_sense_clarification": "крышку, засов или занавеску"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741e6f3f-120e-3cb4-92f6-f3db5b2e4ba5",
                    "sense_definition": "przesunąć się, przemieścić nieco dalej, robiąc miejsce lub unikając bliskości",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch_własny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażerka natychmiast <w>odsunęła</w> się od okna, gdy zauważyła nadchodzącego kontrolera.",
                            "target_lang_translations": {
                                "ru": "Пассажирка тут же <w>отодвинулась</w> от окна, когда заметила приближающегося контролёра."
                            }
                        },
                        {
                            "text": "Usiądź wygodnie na ławce, a ja <w>odsunę</w> się kawałek dalej.",
                            "target_lang_translations": {
                                "ru": "Садись поудобнее на скамейку, а я <w>подвинусь</w> чуть дальше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odsunąć się od okna",
                        "odsunąć się na bok"
                    ],
                    "target_lang_definitions": {
                        "ru": "переместиться, сдвинуться немного в сторону, освобождая место или избегая близости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отодвинуться",
                                "target_lang_sense_clarification": "от кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "подвинуться",
                                "target_lang_sense_clarification": "освобождая место"
                            },
                            {
                                "target_lang_word": "отстраниться",
                                "target_lang_sense_clarification": "физически назад или в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb865f2-fee0-3e52-85db-9e691a8d06f0",
                    "sense_definition": "przenieść realizację czegoś na późniejszy czas; oddalić w czasie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodu nagłej choroby prezesa musieliśmy <w>odsunąć</w> spotkanie na kolejny tydzień.",
                            "target_lang_translations": {
                                "ru": "Из-за внезапной болезни председателя нам пришлось <w>перенести</w> встречу на следующую неделю."
                            }
                        },
                        {
                            "text": "Rząd postanowił <w>odsunąć</w> decyzję o wprowadzeniu nowych podatków do jesieni.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>отложить</w> решение о введении новых налогов до осени."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesunąć"
                    ],
                    "common_phrases": [
                        "odsunąć w czasie",
                        "odsunąć decyzję"
                    ],
                    "target_lang_definitions": {
                        "ru": "перенести исполнение чего-либо на более поздний срок; отсрочить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "на более поздний срок"
                            },
                            {
                                "target_lang_word": "перенести",
                                "target_lang_sense_clarification": "мероприятие или встречу"
                            },
                            {
                                "target_lang_word": "отодвинуть",
                                "target_lang_sense_clarification": "сроки во времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bb14c99-0fb3-30b7-b4a3-d85fa2bbf23f",
                    "sense_definition": "pozbawić kogoś wpływu, stanowiska lub wykluczyć z udziału w czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wykluczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor postanowił <w>odsunąć</w> nielojalnego pracownika od prowadzenia kluczowego projektu.",
                            "target_lang_translations": {
                                "ru": "Директор решил <w>отстранить</w> нелояльного сотрудника от ведения ключевого проекта."
                            }
                        },
                        {
                            "text": "Po ostatnich wyborach całkowicie <w>odsunięto</w> opozycję od podejmowania decyzji w parlamencie.",
                            "target_lang_translations": {
                                "ru": "После последних выборов оппозицию полностью <w>отстранили</w> от принятия решений в парламенте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odsunąć od władzy",
                        "odsunąć od projektu"
                    ],
                    "target_lang_definitions": {
                        "ru": "лишить кого-либо влияния, должности или исключить из участия в чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстранить",
                                "target_lang_sense_clarification": "от должности, дел, власти"
                            },
                            {
                                "target_lang_word": "отодвинуть",
                                "target_lang_sense_clarification": "на задний план, от принятия решений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b895dfbd-58e3-3771-bdcc-bb5b5425532a",
                    "sense_definition": "zaprzestać utrzymywania relacji lub bliskiego kontaktu z kimś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po przeprowadzce do innego miasta Marek powoli <w>odsunął</w> się od dawnych kolegów.",
                            "target_lang_translations": {
                                "ru": "После переезда в другой город Марек постепенно <w>отдалился</w> от старых друзей."
                            }
                        },
                        {
                            "text": "Zamiast szukać pomocy w trudnej chwili, zupełnie <w>odsunęła</w> się od rodziny.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы искать помощи в трудную минуту, она совсем <w>отдалилась</w> от семьи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odsunąć się od ludzi",
                        "odsunąć się od rodziny"
                    ],
                    "target_lang_definitions": {
                        "ru": "прекратить поддерживать близкие отношения или контакт с кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдалиться",
                                "target_lang_sense_clarification": "друг от друга или от близких"
                            },
                            {
                                "target_lang_word": "отстраниться",
                                "target_lang_sense_clarification": "эмоционально, от людей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}