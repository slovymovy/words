                "senses": [
                    {
                        "sense_id": "a33102d1-01d1-3edc-ac39-c02cfd31b415",
                        "entry_id": "c061171a-34cd-302e-929c-129ff831ee9e",
                        "glosses": [
                            "Circuler sur une corniche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52155f00-532e-4c21-81b3-17d918495528",
                                "sense_id": "a33102d1-01d1-3edc-ac39-c02cfd31b415",
                                "text": "Nous secouons contre eux la poussière de nos souliers, et nous prenons le large. Par malheur, M. R***, qui l’a déjà pris, s’est trompé de route, et au lieu de cornicher le long de la mer, il s’est enfoncé dans le continent."
                            },
                            {
                                "example_id": "23e7225b-22c6-4bec-987f-80e629187803",
                                "sense_id": "a33102d1-01d1-3edc-ac39-c02cfd31b415",
                                "text": "C’est bien évidemment d’un scooter décidé et radieux que je me cornichai au-dessus de l’océan avant d’atteindre Abbadia, porte irlandaise du savoir et de la découverte à Hendaye, et de descendre au ras de la mer sur le boulevard du même nom."
                            }
                        ]
                    }
