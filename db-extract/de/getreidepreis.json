                        "entry_id": "b32292f7-b044-3c5e-b15c-b7806f44e98e",
                        "glosses": [
                            "Preis, der für Getreide zu entrichten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f28938-702f-4eb1-84e7-8758d1d5e63c",
                                "sense_id": "e137394b-45ae-3ec8-b56f-ddc3ea307019",
                                "text": "Der Getreidepreis ist im Vorjahr stark gestiegen."
                            },
                            {
                                "example_id": "a99471f3-b603-4e7d-b0f0-937624c69322",
                                "sense_id": "e137394b-45ae-3ec8-b56f-ddc3ea307019",
                                "text": "„Während angespannt wurde, tranken Alpatytsch und Ferapontow Tee und sprachen dabei über Getreidepreise, über das zu erwartende Ernteergebnis und das günstige Erntewetter.“"
                            }
                        ],
