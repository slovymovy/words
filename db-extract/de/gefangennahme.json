                                    {
                                        "sense_id": "511915e0-030e-3f84-a6a2-fe00599ee4d1",
                                        "entry_id": "6378cb2f-1afa-30e2-9119-08773828ac94",
                                        "glosses": [
                                            "A particular match found for a pattern in a text string."
                                        ],
