                "senses": [
                    {
                        "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                        "entry_id": "546cf903-3d73-3e5e-813e-eaa3a76d3f3f",
                        "glosses": [
                            "het uiteenvallen van dode organismen of dood organisch materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8360af2-4ad6-4bfc-8f72-76ea08942ace",
                                "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                                "text": "Zodra Rostov de deur van het gebouw binnenging werd hij bevangen door een stank van verrotting vermengd met de ziekenhuislucht."
                            },
                            {
                                "example_id": "7325f730-6cf0-4ead-9924-835b3356cc37",
                                "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                                "text": "Voor veel soldaten maakte het ook niet meer uit; duizenden overleefden de gevechten niet. Een ooggetuige die het slagveld een paar dagen later bezocht, schreef in een brief: \"Duizenden liggen daar nog onbegraven, de sedert twee dagen heersende warmte heeft de verrotting sterk bevorderd. Op een kwartier uur van het slagveld ontwaart men reeds de verpestende reuk\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97f57654-335d-4147-8ea2-031e908a75e5",
                        "source_entry_id": "546cf903-3d73-3e5e-813e-eaa3a76d3f3f",
                        "source_sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                        "target_lang_word": "deterioration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deterioration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                        "entry_id": "4a6f2bbc-4907-3092-9819-626079333bc3",
                                        "glosses": [
                                            "The process of making or growing worse, or the state of having grown worse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f7f8cc-b41d-49a2-942d-07954607e9ba",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "From 1945 onwards, deterioration in the condition of the brickwork in the arch soffits was kept under close observation, and in 1951 it was decided that strengthening must be undertaken."
                                            },
                                            {
                                                "example_id": "c59d2a83-488e-48c1-9b31-6eb794224a14",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "The Queen may be celebrating her jubilee but the Queen's English Society, which has railed against the misuse and deterioration of the English language, is to fold."
                                            },
                                            {
                                                "example_id": "a601fc3f-ee5d-4cf9-8d92-ec4e6bc2b8c9",
                                                "sense_id": "a4971ec7-2bdb-3716-96e4-36e5a7a52f12",
                                                "text": "\"The quantum sensors will provide highly accurate measurements that will help to detect the rate of change of the track and subsequently, any deteriorations which might lead to faults.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd2cfcf4-a55c-4e16-8369-4bc358249e83",
                        "source_entry_id": "546cf903-3d73-3e5e-813e-eaa3a76d3f3f",
                        "source_sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
