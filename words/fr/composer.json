    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae1bdf62-65ae-31cd-ae49-002a2460af6b",
                    "sense_definition": "Former un numéro de téléphone touche par touche pour joindre un correspondant.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "telephonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>composer</w> le neuf pour obtenir une ligne extérieure."
                        },
                        {
                            "text": "Il <w>compose</w> immédiatement le numéro d'urgence pour signaler l'accident."
                        }
                    ],
                    "common_phrases": [
                        "composer un numéro"
                    ]
                },
                {
                    "sense_id": "6d9ea4fe-e384-336f-a075-cbd6b2667dc2",
                    "sense_definition": "Créer ou écrire une œuvre musicale ou une chanson.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune musicien aime <w>composer</w> de belles mélodies au piano."
                        },
                        {
                            "text": "Elle a <w>composé</w> plusieurs chansons pour son nouvel album acoustique."
                        }
                    ],
                    "common_phrases": [
                        "composer un morceau",
                        "composer une chanson"
                    ]
                },
                {
                    "sense_id": "b5168587-51ea-3abf-a9be-5c5fa884b4fd",
                    "sense_definition": "Former un tout en assemblant différentes parties ou éléments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier <w>compose</w> une salade originale avec des produits de saison."
                        },
                        {
                            "text": "Plusieurs spécialistes <w>composent</w> cette commission scientifique indépendante."
                        }
                    ],
                    "common_phrases": [
                        "composer un menu",
                        "composer une équipe"
                    ]
                },
                {
                    "sense_id": "1cb49224-c295-3ae2-8548-eb62311e757c",
                    "sense_definition": "Être formé ou constitué d'un ensemble d'éléments ou de membres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sauce savoureuse se <w>compose</w> de crème fraîche et de fines herbes."
                        },
                        {
                            "text": "Le comité directeur se <w>composera</w> bientôt de dix personnes qualifiées."
                        }
                    ],
                    "common_phrases": [
                        "se composer de"
                    ]
                },
                {
                    "sense_id": "2f1a0eda-be09-34e7-b293-c8e42cb9ccce",
                    "sense_definition": "S'adapter à une contrainte ou trouver un compromis avec une personne ou une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>composer</w> avec ces nouvelles règles administratives strictes."
                        },
                        {
                            "text": "Le directeur refuse de <w>composer</w> avec des exigences déraisonnables."
                        }
                    ],
                    "synonyms": [
                        "transiger"
                    ],
                    "common_phrases": [
                        "composer avec"
                    ]
                },
                {
                    "sense_id": "94d0a681-5870-30bc-8ed3-37c2a4842a7a",
                    "sense_definition": "Rédiger une épreuve écrite lors d'un concours ou d'un examen scolaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants <w>composent</w> en histoire dans le grand amphithéâtre ce matin."
                        },
                        {
                            "text": "Les candidats <w>composeront</w> pendant quatre heures sur ce sujet difficile."
                        }
                    ],
                    "common_phrases": [
                        "composer pour un concours"
                    ]
                },
                {
                    "sense_id": "1b56b3e8-5ca1-301b-a990-e43d153c2b4b",
                    "sense_definition": "Assembler des caractères pour préparer un texte avant son tirage en imprimerie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier typographe <w>compose</w> soigneusement chaque page à la main."
                        },
                        {
                            "text": "Il fallait plusieurs jours pour <w>composer</w> un journal complet autrefois."
                        }
                    ],
                    "common_phrases": [
                        "composer une page"
                    ]
                }
            ]
        }
    ]
}