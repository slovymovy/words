                "senses": [
                    {
                        "sense_id": "3e3bb2f0-3b73-324a-bb15-2f44e4e66b15",
                        "entry_id": "4017147b-6fdc-3804-9225-24f085acc6a8",
                        "glosses": [
                            "A monument that serves as a reminder of a tragic event and a warning that the event should not be allowed to occur again."
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d34e74d1-1e78-46fb-b5bd-ba1f6ed3e8f7",
                                "sense_id": "3e3bb2f0-3b73-324a-bb15-2f44e4e66b15",
                                "text": "(Es gibt kein Hiroshima-Mahnmal in Washington.)",
                                "translation": "(There is no monument in Washington [D.C.] to remind people of Hiroshima.)",
                                "english": "(There is no monument in Washington [D.C.] to remind people of Hiroshima.)"
                            },
                            {
                                "example_id": "e3f0f9ec-fb1b-4716-94d9-5935f285a617",
                                "sense_id": "3e3bb2f0-3b73-324a-bb15-2f44e4e66b15",
                                "text": "Ein mit leeren Regalen versehener Raum, in den man vom Bebelplatz durch eine Glasscheibe hinunterschauen kann, erinnert dort als Mahnmal an die Bücherverbrennungen vom 10. Mai 1933.",
                                "translation": "A room full of empty bookshelves, which one can look down into from the Bebelplatz via a glass panel, serves as a monument to remind people of the book-burnings of 10 May 1933.",
                                "english": "A room full of empty bookshelves, which one can look down into from the Bebelplatz via a glass panel, serves as a monument to remind people of the book-burnings of 10 May 1933."
                            }
                        ]
                    }
                ],
