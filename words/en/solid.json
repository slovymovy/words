                        "tr": "Güçlü, kolay kırılmayan veya bozulmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "крепкий"
                            },
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "устойчивый"
