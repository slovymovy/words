                    },
                    {
                        "sense_id": "e6a91c01-95a1-345b-bc24-7cbb24f6b6c1",
                        "entry_id": "8cc453b9-5307-34fd-b8ab-dbc72ce83c10",
                        "glosses": [
                            "Petit navire de pêche en usage sur la côte de Normandie, portant deux mâts et un tapecul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a67f587-d0fb-4769-a7bf-54b6723bd551",
                                "sense_id": "e6a91c01-95a1-345b-bc24-7cbb24f6b6c1",
                                "text": "Grâce au dévouement des gens du port, deux flambarts de pêche avaient été sauvés pendant la tempête, mais on savait qu'un grand navire avait péri dans le voisinage du Plessis, car la mer, de ce côté, rejetait de nombreux débris, des tonneaux, des tronçons de mât."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c90526e-3f7e-36af-a9e6-12229a8f1042",
                        "entry_id": "8cc453b9-5307-34fd-b8ab-dbc72ce83c10",
                        "glosses": [
                            "Nom qui s’est donné quelquefois aux pirates portant avec eux le fer et la flamme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "200a5625-4b94-3ec0-acd6-9ff526c2eb82",
                        "entry_id": "8cc453b9-5307-34fd-b8ab-dbc72ce83c10",
                        "glosses": [
                            "Charbon à demi consumé qui jette encore de la flamme et de la fumée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dbe4cdac-24c3-3746-8b01-7d70ff8785bd",
                        "entry_id": "8cc453b9-5307-34fd-b8ab-dbc72ce83c10",
                        "glosses": [
                            "Graisse que les charcutiers recueillent à la surface de l’eau dans laquelle ils font cuire les diverses parties du porc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbef127-1d7a-4a46-918e-c274d6b0c1a4",
                                "sense_id": "dbe4cdac-24c3-3746-8b01-7d70ff8785bd",
                                "text": "Ne pourra être employé aucunes graisses appelées flambart pour l’ensimage des draps et serges, mais seulement du saindoux de porc du plus blanc, Règl. sur les manuf. août 1669, art. 53."
                            }
