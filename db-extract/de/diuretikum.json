                                        "glosses": [
                                            "A drug or a substance that increases the rate of urine excretion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6239be-98e5-4fd8-b02a-3a5bc8df5b99",
                                                "sense_id": "1f13b185-01e1-3da1-9fd9-5642fbd4847f",
                                                "text": "Blackcurrant leaf has a diuretic action [11,12,14], therefore it should not be taken concurrently with diuretics indicated for cardiac or renal insufficiency except on medical advice."
