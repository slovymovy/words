                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1142a7d-97c2-4c7a-9f7c-2d5fb744e2e9",
                                "sense_id": "83f37aee-149a-3e4a-bcee-66c94aa07d00",
                                "text": "The Korite is a hydrous labradorite; it is in dull brown grains, and is associated with Sideromelane, which has the same composition excepting the absence of water."
                            },
                            {
                                "example_id": "bc6d6d2a-cf52-4032-bef3-725598c638bc",
                                "sense_id": "83f37aee-149a-3e4a-bcee-66c94aa07d00",
                                "text": "The crystallization sequences observed in the one-atmosphere melting experiments are summarized in Table 16, where they are compared with the crystallization sequence deduced from petrographic examination of nearly holocrystalline rocks and of naturally occurring materials (which contain 80-95% glass), such as near-vent sideromelanes and dike selvedges."
                            },
                            {
                                "example_id": "132c04a5-8fe5-4908-af55-17e30564065d",
                                "sense_id": "83f37aee-149a-3e4a-bcee-66c94aa07d00",
                                "text": "In younger deposits, irregular patches of black fresh glassy sideromelane occur as “islands\" coated by brownish palagonite envelopes of varying thickness."
                            }
                        ]
                    }
