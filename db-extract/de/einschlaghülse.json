                "senses": [
                    {
                        "sense_id": "ac92323f-a25b-3443-a0b1-f5e3d46d5160",
                        "entry_id": "19b58421-f488-3f0a-bf47-6c45e0e1c447",
                        "glosses": [
                            "spitz zulaufender Metallkörper zur Befestigung von (Zaun-)Pfosten im Boden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64ff260-6926-4751-915f-54a0924a9b05",
                                "sense_id": "ac92323f-a25b-3443-a0b1-f5e3d46d5160",
                                "text": "„Versenken Sie dazu zunächst Einschlaghülsen im Boden.“"
                            },
                            {
                                "example_id": "86690bc2-7305-4b46-a8e6-6f6ce8829309",
                                "sense_id": "ac92323f-a25b-3443-a0b1-f5e3d46d5160",
                                "text": "„Durch die extremen Windlasten, die auf so einen Bau drücken, konnte hier nicht mit der Einschlaghülse gearbeitet werden.“"
                            },
                            {
                                "example_id": "2ce1c9ed-0cf3-4a77-a140-37c62dad0193",
                                "sense_id": "ac92323f-a25b-3443-a0b1-f5e3d46d5160",
                                "text": "„18 Tonnen Feldsteine waren zur Wärmespeicherung am Hang verteilt, 21 dicke Kiefernpfosten mit Einschlaghülsen in den Boden gebracht, mit einem halben Kilometer Spanndraht spalierartig verbunden worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
