                    {
                        "translation_id": "7a193739-bdcb-4850-9adf-ea23c77bbddd",
                        "source_entry_id": "296daaa9-9496-3a31-8068-73ccbe29e4a8",
                        "target_lang_word": "verbinding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbinding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "296c1fda-c780-3dae-a01c-369261eca435",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "iets verbinden of samenvoegen; iets dat twee of meer afzonderlijke delen verbindt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75772d03-f9dc-4a7d-8cec-828d1fe204b1",
                                                "sense_id": "296c1fda-c780-3dae-a01c-369261eca435",
                                                "text": "Ik kon niet bewegen, ik kon geen verbinding maken tussen mijn brein en mijn hand."
                                            },
                                            {
                                                "example_id": "7b39da6a-b656-4d0e-af68-2824fabfbcd3",
                                                "sense_id": "296c1fda-c780-3dae-a01c-369261eca435",
                                                "text": "Daar weer achter is de kippenren, die via een luik met een 'kippentrapje' in verbinding staat met de schuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296e2516-1eb3-3fad-93fe-b727dfd894a6",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "een chemische stof die bestaat uit twee of meer scheikundig elementen, het gaat hierbij om een stof met andere eigenschappen dan de elementen waar het uit is samengesteld"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe295fc-6530-39f9-97e5-f81516b301e8",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "een mogelijkheid een bepaalde plek te bereiken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb6f109-dbf6-4e39-a978-c01cd94d90f9",
                                                "sense_id": "3fe295fc-6530-39f9-97e5-f81516b301e8",
                                                "text": "Hij hing de telefoon op toen de verbinding verbroken werd."
                                            },
                                            {
                                                "example_id": "745b3dde-ef7c-4b1d-a036-18dc52b593b6",
                                                "sense_id": "3fe295fc-6530-39f9-97e5-f81516b301e8",
                                                "text": "Teresa zei niets, ze luisterde naar de vrouw, die naar adem leek te happen en toen de verbinding verbrak."
                                            },
                                            {
                                                "example_id": "8cb71a75-9e7f-47a9-99b1-4e4f5c0a9e8f",
                                                "sense_id": "3fe295fc-6530-39f9-97e5-f81516b301e8",
                                                "text": "Zwart was hij door het roet van de hel. En natuurlijk moest hij zich door de schoorsteen ( de oudste offerplaats èn de verbinding van de geestenwereld met die der mensen ) laten zakken, om de cadeautjes bij de kinderschoenen te leggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec8637a-19ac-38b3-aaae-5f37bdc26325",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "aansluiting op een ander vervoermiddel of lijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e075a090-15e8-44f2-a967-fea655269a59",
                                                "sense_id": "5ec8637a-19ac-38b3-aaae-5f37bdc26325",
                                                "text": "Die buslijn is maar een slechte verbinding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a0e023-f339-358c-ba8d-4bf60c169d8f",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "overeenkomst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a94de3-cc4d-4883-beb5-e6f910c1680d",
                                                "sense_id": "e0a0e023-f339-358c-ba8d-4bf60c169d8f",
                                                "text": "Een zwart-wit beeld uit de jaren vijftig van de vorige eeuw: regen op het Lodewijk Napoleonplein in Assen, een man met een paraplu laat zijn honden uit, huizen van baksteen onder steile driehoekige daken. Er is maar een verbinding met het beeld van de schamele behuizingen in Tutwiler, Mississippi: de blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef892b63-2eee-3332-a682-baeda1f3c59b",
                                        "entry_id": "d62d6937-8b2c-3b5e-b889-279f2b8d6d35",
                                        "glosses": [
                                            "onderling begrip en waardering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1209612c-1bd3-48c9-9137-6a7fbaa2afbe",
                                                "sense_id": "ef892b63-2eee-3332-a682-baeda1f3c59b",
                                                "text": "Dan komt er altijd vanzelf een moment waarop ego's openbreken en er verzachting en verbinding kan ontstaan."
                                            },
                                            {
                                                "example_id": "4f214d6a-b6ea-457d-a9d5-d72f94a3cb5b",
                                                "sense_id": "ef892b63-2eee-3332-a682-baeda1f3c59b",
                                                "text": "Daar weer achter is de kippenren, die via een luik met een 'kippentrapje' in verbinding staat met de schuur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bce5bd46-ccdd-449b-b635-c94304c0f882",
                        "source_entry_id": "296daaa9-9496-3a31-8068-73ccbe29e4a8",
