                    }
                ],
                "senses": [
                    {
                        "sense_id": "8387b25d-350a-3b00-8ecb-a44a8684b616",
                        "entry_id": "9cdadf38-7cec-3429-9833-e118716240f9",
                        "glosses": [
                            "pojemny, obszerny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24405335-8234-4bd3-8e9e-09d9e0623480",
                                "sense_id": "8387b25d-350a-3b00-8ecb-a44a8684b616",
                                "text": "Śpiew i muzyka Björk poniosły mnie w przepastne krainy imaginacji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74c16e42-d439-4c11-80f7-293fbc14d7bb",
                        "source_entry_id": "9cdadf38-7cec-3429-9833-e118716240f9",
                        "source_sense_id": "8387b25d-350a-3b00-8ecb-a44a8684b616",
                        "target_lang_word": "capacious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capacious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                        "entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                                        "glosses": [
                                            "Having a lot of space inside; roomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c57f2fe-3448-47e2-a306-5ca7660c6eb0",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "I turnd my thoughts, and with capacious mind / Conſiderd all things viſible in Heav'n"
                                            },
                                            {
                                                "example_id": "a5c7ee5c-c085-4157-809c-f7648332defb",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "‘There’s rummer things than women in this world though, mind you,’ said the man with the black eye, slowly filling a large Dutch pipe, with a most capacious bowl."
                                            },
                                            {
                                                "example_id": "a3517ebd-004d-4cba-9a31-01a23f11b449",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "The Malabar, that huge sea monster, in whose capacious belly so many human creatures lived and suffered, had dwindled to a walnut-shell, and yet beside her bulk how infinitely small had their own frail cockboat appeared as they shot out from under her towering stern!"
                                            },
                                            {
                                                "example_id": "73bb62ba-688d-4018-902b-8c956050c229",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "There comes an end to all things; the most capacious measure is filled at last; and this brief condescension to my evil finally destroyed the balance of my soul."
                                            },
                                            {
                                                "example_id": "142b28b0-0b67-42d5-87df-d5bead8bdc50",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            },
                                            {
                                                "example_id": "a71d2ecd-dc4e-4b47-b61b-eea61f303991",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                                            },
                                            {
                                                "example_id": "2cb0342e-4583-47ec-acec-29d2fd535311",
                                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                                "text": "The only outfit I could conjure up was a capacious linen shift and a saggy cotton-wool cardigan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                                        "entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                                        "glosses": [
                                            "Capable, able."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13ee416-f6ab-4071-b3eb-834fd7a7dc4e",
                                                "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                                                "text": "[T]he fresh brave school-life, so full of games, adventures, and good fellowship, so ready at forgetting, so capacious at enjoying, so bright at forecasting, outweighed a thousandfold their troubles with the master of their form, and the occasional ill-usage of the big boys in the house."
                                            },
                                            {
                                                "example_id": "dfaa175a-436a-4e79-b7c1-0014a9d9241a",
                                                "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                                                "text": "As you will read, Trump himself has a capacious understanding of his power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf945f5c-f8fa-4973-843a-49ae2f2eee1b",
                        "source_entry_id": "9cdadf38-7cec-3429-9833-e118716240f9",
                        "source_sense_id": "8387b25d-350a-3b00-8ecb-a44a8684b616",
                        "target_lang_word": "cavernous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cavernous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8566307-262e-3a79-8d5f-b12a56446f0a",
                                        "entry_id": "d82ee1c0-3734-349d-8f3b-4b14fe84adf3",
                                        "glosses": [
                                            "Resembling a cavern in size, shape, or atmosphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50477997-3b26-4958-816b-41c704375d55",
                                                "sense_id": "b8566307-262e-3a79-8d5f-b12a56446f0a",
                                                "text": "The last stop on the West Coast Main Line before you cross the border into Scotland, the strategically placed Carlisle Citadel is a station steeped in history. Opened on September 1 1847, the cavernous station was once home to seven railway companies in the pre-Grouping years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b84e0796-86e4-3a39-824b-e09b33f0e6c3",
                                        "entry_id": "d82ee1c0-3734-349d-8f3b-4b14fe84adf3",
                                        "glosses": [
                                            "Resembling a cavern in size, shape, or atmosphere.",
                                            "Giving the impression of vast, dark depths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c0aca6-1359-4d3f-843a-87193d4204b3",
                                                "sense_id": "b84e0796-86e4-3a39-824b-e09b33f0e6c3",
                                                "text": "cavernous eyes"
                                            },
                                            {
                                                "example_id": "f61e5725-ba3a-44fe-ae68-320c9c444574",
                                                "sense_id": "b84e0796-86e4-3a39-824b-e09b33f0e6c3",
                                                "text": "While the filmmakers behind Dear Evan Hansen have maintained that their biggest motivation for adapting the popular Broadway musical was to immortalize Platt’s Tony-winning titular performance, what they’ve actually done by having the 27-year-old play a high school senior is highlight the stage show’s cavernous weaknesses while failing to transport just about any of its strengths to the new medium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320221d2-24ab-306b-a845-510574653d94",
                                        "entry_id": "d82ee1c0-3734-349d-8f3b-4b14fe84adf3",
                                        "glosses": [
                                            "Having many caverns.",
                                            "Composed largely of vascular sinuses and capable of dilating with blood to bring about the erection of a body part."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c6f1a11-38de-3e61-b8ad-5b574fde3beb",
                                        "entry_id": "d82ee1c0-3734-349d-8f3b-4b14fe84adf3",
                                        "glosses": [
                                            "Having many caverns.",
                                            "Having cavities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
