                                        "entry_id": "229a385b-f256-36e1-beaf-9c4629b2f922",
                                        "glosses": [
                                            "complesso di gare disputate da una squadra in sedi non contemplate dai regolamenti sportivi"
                                        ],
                                        "tags": [
