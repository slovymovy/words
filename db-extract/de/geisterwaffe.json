                "senses": [
                    {
                        "sense_id": "912c74e5-3041-3d5e-ad66-6b51f4a3d71f",
                        "entry_id": "80c8fb7e-cd53-33de-8965-d38842485ab2",
                        "glosses": [
                            "von einer Privatperson selbst hergestellte Schusswaffe, die über keine Zulassung und Seriennummer verfügt und damit nicht registriert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8aeeeb-0840-4468-aeec-f116d02c8113",
                                "sense_id": "912c74e5-3041-3d5e-ad66-6b51f4a3d71f",
                                "text": "„Laut Polizei soll er eine Geisterwaffe verwendet haben.“"
                            },
                            {
                                "example_id": "4f0a34e4-cfad-44ab-946a-f8227b17fc03",
                                "sense_id": "912c74e5-3041-3d5e-ad66-6b51f4a3d71f",
                                "text": "„Biden bekräftigte, sogenannte Geisterwaffen ohne Registrierung verbieten zu wollen.“"
                            },
                            {
                                "example_id": "1fd7d8c5-d707-4b5c-9a87-b354989ac485",
                                "sense_id": "912c74e5-3041-3d5e-ad66-6b51f4a3d71f",
                                "text": "„Geisterwaffen können wie ein Spielzeug als Bausatz online oder beim Waffenhändler gekauft werden und sind in kürzester Zeit zusammengebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
