{
    "word_family": [
        "unbolt",
        "deadbolt",
        "thunderbolt",
        "bolter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "113a635a-3183-358a-99b0-6b4410e6e3a5",
                    "sense_definition": "A metal fastener consisting of a threaded cylindrical body with a head, designed to be used with a nut.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastener_lock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tightened the <w>bolt</w> with a wrench to secure the wheel.",
                            "target_lang_translations": {
                                "ru": "Он затянул <w>болт</w> гаечным ключом, чтобы закрепить колесо.",
                                "zh": "他用扳手拧紧了<w>螺栓</w>以固定车轮。"
                            }
                        },
                        {
                            "text": "The machine is held together by nuts and <w>bolts</w>.",
                            "target_lang_translations": {
                                "ru": "Машина держится на гайках и <w>болтах</w>.",
                                "zh": "这台机器靠螺母和<w>螺栓</w>连接在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fastener",
                        "screw"
                    ],
                    "common_phrases": [
                        "nuts and bolts",
                        "bolt cutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический крепеж, состоящий из цилиндрического стержня с резьбой и головкой, предназначенный для использования с гайкой.",
                        "zh": "一种金属紧固件，由带螺纹的圆柱体和头部组成，通常与螺母配合使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болт",
                                "target_lang_sense_clarification": "крепежная деталь"
                            },
                            {
                                "target_lang_word": "винт",
                                "target_lang_sense_clarification": "крепеж с резьбой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "螺栓",
                                "target_lang_sense_clarification": "机械紧固件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255be4c2-797c-30d5-b379-8b4889a5aab4",
                    "sense_definition": "A sliding metal bar or pin in a lock mechanism used to fasten a door or window.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener_lock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slid the <w>bolt</w> across to lock the door for the night.",
                            "target_lang_translations": {
                                "ru": "Она задвинула <w>засов</w>, чтобы запереть дверь на ночь.",
                                "zh": "她插上了<w>插销</w>，把门锁好过夜。"
                            }
                        },
                        {
                            "text": "The rusty <w>bolt</w> stuck and would not move easily.",
                            "target_lang_translations": {
                                "ru": "Ржавый <w>засов</w> застрял и не двигался.",
                                "zh": "生锈的<w>插销</w>卡住了，不容易移动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bar"
                    ],
                    "common_phrases": [
                        "slide the bolt",
                        "dead bolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скользящий металлический стержень в замковом механизме, используемый для запирания двери или окна.",
                        "zh": "锁具中用于固定门窗的滑动金属杆或插销。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засов",
                                "target_lang_sense_clarification": "запирающее устройство"
                            },
                            {
                                "target_lang_word": "задвижка",
                                "target_lang_sense_clarification": "небольшой засов"
                            },
                            {
                                "target_lang_word": "щеколда",
                                "target_lang_sense_clarification": "простой запор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插销",
                                "target_lang_sense_clarification": "门窗锁闭装置"
                            },
                            {
                                "target_lang_word": "门闩",
                                "target_lang_sense_clarification": "横木或金属杆锁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d699dd69-cd5a-355f-839a-b3f5ca17d44e",
                    "sense_definition": "A flash of lightning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bright <w>bolt</w> of lightning struck the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Яркая <w>молния</w> ударила в старый дуб.",
                                "zh": "一道明亮的<w>闪电</w>击中了那棵老橡树。"
                            }
                        },
                        {
                            "text": "We saw a sudden <w>bolt</w> flash across the dark sky.",
                            "target_lang_translations": {
                                "ru": "Мы увидели, как внезапная <w>молния</w> сверкнула в темном небе.",
                                "zh": "我们看到一道<w>闪电</w>划过漆黑的夜空。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "stroke"
                    ],
                    "common_phrases": [
                        "lightning bolt",
                        "bolt of lightning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспышка молнии.",
                        "zh": "一道闪电。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молния",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "разряд молнии",
                                "target_lang_sense_clarification": "электрическая вспышка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪电",
                                "target_lang_sense_clarification": "大气放电现象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9d57af-ce18-3eb2-8969-54d35d390be8",
                    "sense_definition": "A sudden movement or attempt to escape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sudden_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief made a sudden <w>bolt</w> for the open window.",
                            "target_lang_translations": {
                                "ru": "Вор сделал внезапный <w>рывок</w> к открытому окну.",
                                "zh": "小偷突然向敞开的窗户<w>猛冲</w>过去。"
                            }
                        },
                        {
                            "text": "With a <w>bolt</w> of energy, the horse jumped over the fence.",
                            "target_lang_translations": {
                                "ru": "С <w>приливом</w> энергии лошадь перепрыгнула через забор.",
                                "zh": "马儿充满活力地一跃，跳过了栅栏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "sprint",
                        "rush"
                    ],
                    "common_phrases": [
                        "make a bolt for",
                        "bolt from the blue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное движение или попытка убежать.",
                        "zh": "突然的移动或逃跑尝试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "бегство",
                                "target_lang_sense_clarification": "побег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛冲",
                                "target_lang_sense_clarification": "突然的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c98f5ca-939d-33a2-a7ec-3bf3187683f9",
                    "sense_definition": "A large roll of fabric, canvas, or similar material.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor purchased a <w>bolt</w> of silk to make the wedding dress.",
                            "target_lang_translations": {
                                "ru": "Портной купил <w>рулон</w> шёлка, чтобы сшить свадебное платье.",
                                "zh": "裁缝买了一<w>卷</w>丝绸来制作婚纱。"
                            }
                        },
                        {
                            "text": "She unrolled the <w>bolt</w> of cloth on the cutting table.",
                            "target_lang_translations": {
                                "ru": "Она развернула <w>рулон</w> ткани на раскройном столе.",
                                "zh": "她在裁剪台上展开了那<w>卷</w>布料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roll"
                    ],
                    "common_phrases": [
                        "bolt of cloth",
                        "bolt of fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой рулон ткани, холста или подобного материала.",
                        "zh": "一大卷布料、帆布或类似材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рулон",
                                "target_lang_sense_clarification": "сверток ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一卷",
                                "target_lang_sense_clarification": "布料的计量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f868091-06da-3725-8a53-f49094ffda7b",
                    "sense_definition": "A short, heavy arrow intended to be shot from a crossbow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "projectile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval archer loaded a <w>bolt</w> into his crossbow.",
                            "target_lang_translations": {
                                "ru": "Средневековый лучник зарядил <w>болт</w> в свой арбалет.",
                                "zh": "中世纪的弓箭手将一支<w>弩箭</w>装入弩中。"
                            }
                        },
                        {
                            "text": "A steel <w>bolt</w> pierced the target with great force.",
                            "target_lang_translations": {
                                "ru": "Стальной <w>болт</w> пронзил мишень с огромной силой.",
                                "zh": "一支钢制<w>弩箭</w>以巨大的力量穿透了靶子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quarrel",
                        "arrow"
                    ],
                    "common_phrases": [
                        "crossbow bolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая тяжелая стрела, предназначенная для стрельбы из арбалета.",
                        "zh": "一种用于弩的短而重的箭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болт",
                                "target_lang_sense_clarification": "снаряд для арбалета"
                            },
                            {
                                "target_lang_word": "стрела",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弩箭",
                                "target_lang_sense_clarification": "弩的弹药"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "651b1f9f-2ed8-3efe-834e-955f551013d9",
                    "sense_definition": "A sieve, especially one used for sifting flour or meal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sifting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miller used a fine <w>bolt</w> to separate the flour from the bran.",
                            "target_lang_translations": {
                                "ru": "Мельник использовал мелкое <w>сито</w>, чтобы отделить муку от отрубей.",
                                "zh": "磨坊主用细<w>筛子</w>将面粉和麸皮分开。"
                            }
                        },
                        {
                            "text": "Old machinery often included a wooden <w>bolt</w> for processing grain.",
                            "target_lang_translations": {
                                "ru": "Старое оборудование часто включало деревянное <w>сито</w> для обработки зерна.",
                                "zh": "旧式机械常包含一个用于加工谷物的木制<w>筛子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sieve",
                        "sifter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical milling context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сито, особенно используемое для просеивания муки.",
                        "zh": "筛子，尤指用于筛面粉或谷物的工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сито",
                                "target_lang_sense_clarification": "инструмент для просеивания"
                            },
                            {
                                "target_lang_word": "решето",
                                "target_lang_sense_clarification": "крупное сито"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筛子",
                                "target_lang_sense_clarification": "过滤工具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c930f802-0377-3e6a-8b5d-fde677679e30",
                    "sense_definition": "To attach or secure objects together firmly, often using bolts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastener_lock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>bolt</w> the heavy shelves to the wall for safety.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>прикрутите</w> тяжёлые полки к стене для безопасности.",
                                "zh": "为了安全起见，请把沉重的架子<w>用螺栓固定</w>在墙上。"
                            }
                        },
                        {
                            "text": "They <w>bolted</w> the metal plates together to form the frame.",
                            "target_lang_translations": {
                                "ru": "Они <w>скрепили</w> металлические пластины болтами, чтобы собрать раму.",
                                "zh": "他们把金属板<w>用螺栓固定</w>在一起，组成了框架。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure",
                        "screw",
                        "fix"
                    ],
                    "antonyms": [
                        "unbolt"
                    ],
                    "common_phrases": [
                        "bolt down",
                        "bolt together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно соединять или скреплять предметы, часто с помощью болтов.",
                        "zh": "用螺栓将物体牢固地连接或固定在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скреплять болтами",
                                "target_lang_sense_clarification": "соединять крепежом"
                            },
                            {
                                "target_lang_word": "привинчивать",
                                "target_lang_sense_clarification": "крепить винтами"
                            },
                            {
                                "target_lang_word": "прикручивать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用螺栓固定",
                                "target_lang_sense_clarification": "机械连接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffe0382d-6c34-34fa-8c3a-8b0cdce0ed32",
                    "sense_definition": "To secure a door or window by sliding a bar or engaging a lock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener_lock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to <w>bolt</w> the front door before you go to bed.",
                            "target_lang_translations": {
                                "ru": "Не забудь <w>запереть на засов</w> входную дверь перед сном.",
                                "zh": "睡觉前别忘了把前门<w>插上</w>。"
                            }
                        },
                        {
                            "text": "He <w>bolted</w> the gate to keep the dog inside the yard.",
                            "target_lang_translations": {
                                "ru": "Он <w>запер на засов</w> ворота, чтобы удержать собаку во дворе.",
                                "zh": "他把大门<w>插上</w>，以防狗跑出院子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lock",
                        "bar",
                        "latch"
                    ],
                    "antonyms": [
                        "unlock",
                        "unbolt"
                    ],
                    "common_phrases": [
                        "bolt the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запирать дверь или окно, задвигая засов или используя замок.",
                        "zh": "通过滑动插销或锁闭装置来锁住门窗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирать на засов",
                                "target_lang_sense_clarification": "закрывать"
                            },
                            {
                                "target_lang_word": "задвигать засов",
                                "target_lang_sense_clarification": "действие с засовом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插上",
                                "target_lang_sense_clarification": "锁门动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f62bf9-a11e-36c0-8942-b85807596add",
                    "sense_definition": "To run away suddenly and quickly, often to escape from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened horse <w>bolted</w> when it heard the loud noise.",
                            "target_lang_translations": {
                                "ru": "Испуганная лошадь <w>понесла</w>, когда услышала громкий шум.",
                                "zh": "受惊的马听到巨响后<w>惊逃</w>了。"
                            }
                        },
                        {
                            "text": "As soon as the alarm rang, the thieves <w>bolted</w> from the store.",
                            "target_lang_translations": {
                                "ru": "Как только зазвенела сигнализация, воры <w>рванули</w> из магазина.",
                                "zh": "警报一响，小偷们就从店里<w>逃窜</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flee",
                        "dash",
                        "sprint",
                        "run away"
                    ],
                    "common_phrases": [
                        "bolt for the exit",
                        "bolt from the room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и быстро убегать, часто чтобы скрыться от чего-либо.",
                        "zh": "突然且快速地逃跑，通常是为了躲避某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвануть",
                                "target_lang_sense_clarification": "резко побежать"
                            },
                            {
                                "target_lang_word": "удрать",
                                "target_lang_sense_clarification": "сбежать"
                            },
                            {
                                "target_lang_word": "понести",
                                "target_lang_sense_clarification": "о лошади"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逃窜",
                                "target_lang_sense_clarification": "快速逃跑"
                            },
                            {
                                "target_lang_word": "惊逃",
                                "target_lang_sense_clarification": "指动物受惊奔跑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44b0c38-8b4c-3a85-bc6b-7ff96f1d6c02",
                    "sense_definition": "To swallow food very quickly without chewing it properly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sudden_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog <w>bolted</w> its dinner in just a few seconds.",
                            "target_lang_translations": {
                                "ru": "Голодная собака <w>заглотила</w> свой ужин всего за несколько секунд.",
                                "zh": "饥饿的狗在几秒钟内就<w>狼吞虎咽</w>地吃完了晚餐。"
                            }
                        },
                        {
                            "text": "You should not <w>bolt</w> your food; take time to enjoy it.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует <w>глотать</w> еду не жуя; удели время тому, чтобы насладиться ею.",
                                "zh": "你不应该<w>狼吞虎咽</w>地吃东西，要慢慢享受。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp",
                        "wolf",
                        "devour"
                    ],
                    "common_phrases": [
