                "senses": [
                    {
                        "sense_id": "3b36d2bd-b821-3912-9eef-6c9496e94079",
                        "entry_id": "88fa6e1d-80ae-3e24-92fe-ae0674eba79d",
                        "glosses": [
                            "organisierter Zusammenschluss der abhängigen beschäftigten Arbeiterschaft mit dem Ziel, Verbesserungen der eigenen Arbeits- und Lebensbedingungen zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "804a5837-c30c-4f6f-aba7-be8ba1af43aa",
                                "sense_id": "3b36d2bd-b821-3912-9eef-6c9496e94079",
                                "text": "„Früher gab es in der SPD einen Stolz, gerade aus der Arbeiterbewegung heraus, wenn Adelige wie Klaus von Dohnanyi oder vornehme Bourgeois wie Philip Rosenthal für die sozial Schwachen kämpften. Das hatte ein gute Tradition, siehe Lassalle.“"
                            },
                            {
                                "example_id": "d990e3cb-8634-410b-86c9-1b82ff02e8bd",
                                "sense_id": "3b36d2bd-b821-3912-9eef-6c9496e94079",
                                "text": "„Die ersten Anläufe, die Frauen als Mitträgerinnen der Arbeiterbewegung zu gewinnen und zu organisieren, sind zweifelsohne auf den klärenden und treibenden Einfluß der I. Internationale zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
