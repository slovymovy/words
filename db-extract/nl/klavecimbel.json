                ],
                "senses": [
                    {
                        "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                        "entry_id": "b9a9f7c4-3f1a-3c3c-8013-b5497fc68a3e",
                        "glosses": [
                            "toetsinstrument waarbij de in het verlengde van de toetsen geplaatste snaren worden getokkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad581abf-349b-46c2-abbc-c43ca4672283",
                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                "text": "Een klavecimbel heeft vaak twee manualen."
                            },
                            {
                                "example_id": "e9f5e2ce-5a7a-4a15-8d37-90d1cce87005",
                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                "text": "Ze regelen alles, tot en met een huurbusje waar het klavecimbel straks precies in past."
                            },
                            {
                                "example_id": "40a10aee-6985-4a17-a440-c3ffebc7f952",
                                "sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                                "text": "Op het Parijse conservatorium ontdekte Haïm de klavecimbel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "388c8ec2-d909-4696-9e04-bba9a2177b1c",
                        "source_entry_id": "b9a9f7c4-3f1a-3c3c-8013-b5497fc68a3e",
                        "source_sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
                        "source_sense_description": "toetsinstrument",
                        "target_lang_word": "Cembalo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cembalo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                        "entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                                        "glosses": [
                                            "Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1747224b-1603-461a-b886-b8523e194c95",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                                            },
                                            {
                                                "example_id": "7858d390-c157-4a4f-a417-b9760526fb98",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Er entdeckte auf dem Cembalo zehn oder zwölf Datteln und aß sie auf.“"
                                            },
                                            {
                                                "example_id": "5ea580cd-9a13-4301-90c2-1519df963d9e",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Der dünne Silberklang des Cembalos zitterte manchmal ein wenig wie das Werk einer Spieldose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de309771-7994-4f03-8672-871b56f79bcd",
                        "source_entry_id": "b9a9f7c4-3f1a-3c3c-8013-b5497fc68a3e",
                        "source_sense_id": "a13da93c-aca8-35f3-9494-fea16542f61d",
