                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0c60c195-56d1-41be-a8a1-1a99dfb36eb8",
                        "entry_id": "f779bdf0-bf86-337d-9c3a-0fc1d2c9ae7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ultonians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49908cbb-771d-3729-a848-0996b41e7c95",
                        "entry_id": "f779bdf0-bf86-337d-9c3a-0fc1d2c9ae7f",
                        "glosses": [
                            "A native or inhabitant of Ulster."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "868f980d-4321-43c8-919d-81370e7b09f9",
                                "sense_id": "49908cbb-771d-3729-a848-0996b41e7c95",
                                "text": "If the Scots failed to subdue the south thoroughly, they succeeded in crushing the Ultonians, and driving them ultimately into the southeastern corner of the province."
                            },
                            {
                                "example_id": "fbf1be73-ae6f-4589-a10c-93a9de16690e",
                                "sense_id": "49908cbb-771d-3729-a848-0996b41e7c95",
                                "text": "One day Crundchu prepared himself to go to a great fair or assembly of the Ultonians, where there would be feasting and horse-racing, tournaments and music, and merrymaking of all kinds."
                            },
                            {
                                "example_id": "66ca9e3f-5237-4d15-9a9c-ad8425ea2995",
                                "sense_id": "49908cbb-771d-3729-a848-0996b41e7c95",
                                "text": "Mac an Ultaig / Son of an Ultonian or Ulsterman / Originally founded in Donegal, the name later took root in Mayo."
                            }
                        ]
                    }
                ],
