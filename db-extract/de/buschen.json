                "senses": [
                    {
                        "sense_id": "f8a9a2e8-d5a5-3b4f-b50a-758ef166d065",
                        "entry_id": "abb58466-c771-38f7-bfaa-33a2523ff0ac",
                        "glosses": [
                            "Blumenstrauß, gebündelte Zweige, Kräuter oder Ähnliches"
                        ],
                        "tags": [
                            "Austrian German",
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fe8cce25-5fca-4e1d-95f3-69f50f518a18",
                                "sense_id": "f8a9a2e8-d5a5-3b4f-b50a-758ef166d065",
                                "text": "Wir haben heute einen großen Buschen Butterblumen gepflückt."
                            },
                            {
                                "example_id": "ff6a8bc9-13ae-45a6-99c3-c3114d694889",
                                "sense_id": "f8a9a2e8-d5a5-3b4f-b50a-758ef166d065",
                                "text": "„Nach der Kräuterweihe beim Gottesdienst kann man die Buschen vom Familienkreis gegen eine Spende mit nach Hause nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d91fe9c-538a-459f-9c24-7829c827d6f0",
                        "source_entry_id": "abb58466-c771-38f7-bfaa-33a2523ff0ac",
                        "source_sense_id": "f8a9a2e8-d5a5-3b4f-b50a-758ef166d065",
                        "source_sense_description": "bairisch, österreichisch, umgangssprachlich: Blumenstrauß, gebündelte Zweige, Kräuter oder Ähnliches",
                        "target_lang_word": "bouquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d13e690-8479-36fe-84fb-516de24b09a3",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Assemblage de fleurs coupées et serrées les unes contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c44c49-b158-4085-af71-501eb7c83480",
                                                "sense_id": "8d13e690-8479-36fe-84fb-516de24b09a3",
                                                "text": "Avec Christine Conforti, elles ont transmis à leurs clients leur passion pour la création florale et les beaux bouquets !"
                                            },
                                            {
                                                "example_id": "05c26304-cd57-4ee5-95d8-ffc21498d90b",
                                                "sense_id": "8d13e690-8479-36fe-84fb-516de24b09a3",
                                                "text": "Il était allé lui cueillir un bouquet de coucous pour mettre au pied de la statue de la Vierge qui trônait sur un vieux confiturier reconverti en fourre-tout de laines et de tissus où elle puisait pour occuper ses doigts."
                                            },
                                            {
                                                "example_id": "cc20232f-d427-4702-98cb-a54c1d87a35b",
                                                "sense_id": "8d13e690-8479-36fe-84fb-516de24b09a3",
                                                "text": "Il est aussitôt déchu de sa victoire. Et le 2ᵉ est déclaré officiellement vainqueur. […]. Le coureur auquel les organisateurs remettent le bouquet de la victoire se nomme Cino Cinelli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c29bbcc7-0722-3e35-ae6f-ad187c25785a",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Petit faisceau de plantes aromatiques culinaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad658103-2223-44a3-91d3-0e0f7d7fc6aa",
                                                "sense_id": "c29bbcc7-0722-3e35-ae6f-ad187c25785a",
                                                "text": "Piquez votre foie de veau de gros lard assaisonné; foncez une braisière de bardes de lard; mettez-y le foie avec des carottes, un bouquet garni, des oignons, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a063e782-826d-3e5a-b184-9132a5a30760",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Ensemble d’arbres formant un bosquet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5afa58c4-5813-4eb4-b29e-996c0f6f0573",
                                                "sense_id": "a063e782-826d-3e5a-b184-9132a5a30760",
                                                "text": "Et tout à coup, l’église, qui, en face de moi, montrait son toit gauchi et sa vieille tour d’ardoise, mal d’aplomb au-dessus d’un bouquet d’acacias et de marronniers roses, les cloches tintèrent."
                                            },
                                            {
                                                "example_id": "925265c1-bb87-40cc-b363-34a9957a65f9",
                                                "sense_id": "a063e782-826d-3e5a-b184-9132a5a30760",
                                                "text": "Arrivés au sommet d'une forte côte et au débouché d'un bouquet de bois, nous aperçûmes, tout à coup, dans un bas-fond et entourée de hauteurs, la ville de Sedan."
                                            },
                                            {
                                                "example_id": "4465b7e1-de30-47f1-bc55-42bbed08ac60",
                                                "sense_id": "a063e782-826d-3e5a-b184-9132a5a30760",
                                                "text": "[…] c’étaient de hautes falaises rocheuses, des cascades et de larges fleuves bouillonnants et désolés, des bouquets d’arbres et des fourrés de plus en plus rabougris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f5f1569-1a8b-3d84-af6f-a8b3d30576e6",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Peuplement de moins de 50 ares."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3281bc8d-379a-4e2d-92e9-36ae5388c038",
                                                "sense_id": "7f5f1569-1a8b-3d84-af6f-a8b3d30576e6",
                                                "text": "Toutefois, compte tenu du caractère plutôt héliophile des chênes, tant sessile que pédonculé, il se peut que la structure des peuplements s’organise naturellement en bouquets (notamment sur sol acide)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04411de2-3897-39e1-bc3b-0fe915f96dd1",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Assemblage de choses liées ou qui tiennent naturellement l’une avec l’autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27585e5-dfed-4662-b436-be5bf1fe6bfe",
                                                "sense_id": "04411de2-3897-39e1-bc3b-0fe915f96dd1",
                                                "text": "Un bouquet de plumes, de cerises, etc."
                                            },
                                            {
                                                "example_id": "64c10d2b-5397-4666-94d5-8e9164773700",
                                                "sense_id": "04411de2-3897-39e1-bc3b-0fe915f96dd1",
                                                "text": "Mais la plus forte tête du salon jaune était à coup sûr le commandant Sicardot, le beau-père d’Aristide. Taillé en Hercule, le visage rouge brique, couturé et planté de bouquets de poil gris, il comptait parmi les plus glorieuses ganaches de la grande armée."
                                            },
                                            {
                                                "example_id": "aaab4269-ac23-4fce-b580-60267294fe6d",
                                                "sense_id": "04411de2-3897-39e1-bc3b-0fe915f96dd1",
                                                "text": "Aujourd’hui, l’utilisation de la voiture est tellement satisfaisante qu’aucune offre de transport en commun, aussi performante soit-elle, n’entraînera nécessairement un report. Il est nécessaire de développer un bouquet de services de mobilité beaucoup plus divers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb190c1-08c1-3ff1-9ace-cc1a46d2633a",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Paquet de différentes pièces d’artifice qui partent ensemble."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f773a5a3-9ee5-4391-ab4f-567c1cbd8a97",
                                                "sense_id": "6cb190c1-08c1-3ff1-9ace-cc1a46d2633a",
                                                "text": "Il la pénétrait bestialement, dans une hébétude sensuelle qui n’atteignait à la lucidité qu’à la minute où l’on voit, par une nuit d’été, la fusée d’un feu d’artifice fondre en un riche bouquet d’étoiles pâmées qui retombent au néant."
                                            },
                                            {
                                                "example_id": "cdec1619-4f61-488e-a042-8068af0ee18e",
                                                "sense_id": "6cb190c1-08c1-3ff1-9ace-cc1a46d2633a",
                                                "text": "Le moindre événement prenait de l’importance, et nous sentions que Paris était bien à l’extrême bord de la civilisation, qu’il terminait le monde moderne comme un bouquet termine quelque feu d’artifice, qu’il vibrait « au point doré de périr », eût dit Paul Valéry."
                                            },
                                            {
                                                "example_id": "0c4e5e08-e096-431b-b89a-6972e89c9a2c",
                                                "sense_id": "6cb190c1-08c1-3ff1-9ace-cc1a46d2633a",
                                                "text": "Une à une les fusées partirent, les belles bleues, celles à trois étages et celles qui gardent un instant leurs fleurs éteintes. Puis le bouquet, la fontaine d’argent et la mitraillade finale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ccd8591-ffe8-3c89-bf01-9ae2f69ef653",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Ce qu’il y a de mieux et qui a été réservé pour la fin dans un récit, une fête…"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735eca1a-d6ff-44ce-8dcb-a346cf7105a3",
                                                "sense_id": "4ccd8591-ffe8-3c89-bf01-9ae2f69ef653",
                                                "text": "Je réservais cela pour le bouquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cbf7d3-8ad6-3d2c-b858-98d876289c55",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Désagrément qui vient s’ajouter à une série de mauvaises nouvelles."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94ecc37-e84f-4637-8d54-3aea96f83cd2",
                                                "sense_id": "51cbf7d3-8ad6-3d2c-b858-98d876289c55",
                                                "text": "Et j’en passe. Le bouquet, c’est l’énumération de mes récentes tentatives d’extorsion de fonds."
                                            },
                                            {
                                                "example_id": "61315af9-0607-4e57-8f65-d1a6ca15cfc5",
                                                "sense_id": "51cbf7d3-8ad6-3d2c-b858-98d876289c55",
                                                "text": "C’est le bouquet!"
                                            },
                                            {
                                                "example_id": "aafa28de-9fa4-480f-84b3-778f150b1b29",
                                                "sense_id": "51cbf7d3-8ad6-3d2c-b858-98d876289c55",
                                                "text": "C’est le bouquet !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa7c50c-03b0-32d3-8e6a-a12db7bd49a6",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Sensation olfactive parvenant à la cavité nasale par l’arrière, depuis la gorge. Parfum du vin, sensible à la fois à l'odorat et au goût, qui distingue certaines de ses qualités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0668274c-471c-4aa7-a252-96a1570b2eba",
                                                "sense_id": "4aa7c50c-03b0-32d3-8e6a-a12db7bd49a6",
                                                "text": "Dans son bouquet tertiaire apparaîtront des arômes suaves de kumquat confit, de fruit de la passion, d’épices douces et d’amande grillée, toujours sur le fond citronné ma foi assagi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da64201b-7668-3f02-9356-83782f028045",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Petit texte en vers adressé à une personne le jour de son anniversaire."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a969137-3124-4ad2-ae2f-7195d39b1257",
                                                "sense_id": "da64201b-7668-3f02-9356-83782f028045",
                                                "text": "Envoyer un bouquet à une jeune personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef7f4d1-2c07-3a3c-a850-364ed79f1c32",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Capital versé par l’acheteur dans le cadre d’une rente viagère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9faa76-289d-4753-b09e-bb5714b28f45",
                                                "sense_id": "6ef7f4d1-2c07-3a3c-a850-364ed79f1c32",
                                                "text": "Le jeune couple ignorerait longtemps que, pour faire partir la vieille dame dans une maison de retraite, les Bioni lui avaient lâché un important bouquet par-dessous la table."
                                            },
                                            {
                                                "example_id": "90637bbd-2e56-4dcf-9e74-bfd0b48a3923",
                                                "sense_id": "6ef7f4d1-2c07-3a3c-a850-364ed79f1c32",
                                                "text": "Tout le bouquet de la rente viagère s’était fané dans cette prodigalité musicale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25730ea3-e7cb-3f07-8851-778b8fdcfaeb",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Variété d’artichaut, de couleur violette, récolté avant maturité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5172f2-a58a-41d2-ab77-bb34e8494eab",
                                                "sense_id": "25730ea3-e7cb-3f07-8851-778b8fdcfaeb",
                                                "text": "Le poivrade (ou bouquet), un petit violet dépourvu de foin parce que récolté avant maturité, se consomme entier, cru sous un nuage de de tapenade ou poêlé, par exemple."
                                            },
                                            {
                                                "example_id": "678e67e6-0ca8-4f7f-969d-9b2d91d5a23f",
                                                "sense_id": "25730ea3-e7cb-3f07-8851-778b8fdcfaeb",
                                                "text": "Recette d’artichaut barigoule, des artichauts « bouquet » cuisinés avec des lardons, 1 botte d’oignons nouveaux et du vin blanc."
                                            },
                                            {
                                                "example_id": "7d936e8f-ed17-459a-87a5-e17ecd7d57ad",
                                                "sense_id": "25730ea3-e7cb-3f07-8851-778b8fdcfaeb",
                                                "text": "Les artichauts bouquet se prêtent à de nombreuses préparations culinaires : en salade, en gratin, farcis, en vinaigrette ou simplement cuits à l'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc061472-f6fe-3ef8-86c9-7ec6a25b6fad",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Ensemble de chaînes de télévision regroupées dans une offre commerciale."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c88933c-7c3c-4041-8094-d12b43924022",
                                                "sense_id": "dc061472-f6fe-3ef8-86c9-7ec6a25b6fad",
                                                "text": "De longues batailles judiciaires s’engagèrent avec les câblo-opérateurs (Numericable et Noos, devenus SFR) qui, mauvais payeurs, refusaient d’acquitter les droits dus sur les films qui étaient diffusés sur leurs bouquets de chaînes, estimant que les sommes acquittées par les chaînes elles-mêmes devaient suffire à rémunérer les producteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78577d55-be9c-3b8f-8391-0ab03f734269",
                                        "entry_id": "5af0e19e-7acd-33dd-a6e2-06b561c12452",
                                        "glosses": [
                                            "Réunion de deux espaces topologiques en identifiant un de leurs points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bouquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cba2b847-3afe-3c1f-ab16-b5129b083910",
                                        "entry_id": "a9f29cf8-8da4-34bf-b530-396451465e7b",
                                        "glosses": [
                                            "Espèce de palémon (ou crevette rose) translucide de la famille des palémonidés, parmi les meilleures espèces comestibles, et que l’on retrouve dans l’Atlantique ainsi que dans la mer Méditerranée et la mer Noire, de nom scientifique Palaemon serratus."
                                        ],
                                        "tags": [
                                            "Invertébrés"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6d8f699-f04f-4a4c-a7a7-f64446a769b2",
                                                "sense_id": "cba2b847-3afe-3c1f-ab16-b5129b083910",
                                                "text": "Beautrelet, on me prévient de Dieppe que des pêcheurs de bouquet ont trouvé ce matin, sur les rochers, le cadavre d’une jeune femme."
                                            },
                                            {
                                                "example_id": "6b67770f-d744-497c-a4e3-a37117a0a93a",
                                                "sense_id": "cba2b847-3afe-3c1f-ab16-b5129b083910",
                                                "text": "Cependant la crevette grise, que l’on ne transporte guère, est d’un goût beaucoup plus fin que l’autre, plus généralement appelée bouquet. La crevette grise est au bouquet, pour le goût, ce qu’est le gibier à la volaille."
                                            },
                                            {
                                                "example_id": "04e626ad-579f-4ce8-925e-96392806640a",
                                                "sense_id": "cba2b847-3afe-3c1f-ab16-b5129b083910",
                                                "text": "Tantôt avec les lassets, tantôt à l’aide de la bourraque, il faisait une petite récolte de ces belles crevettes roses (quand elles sont cuites) et qu’on appelle le bouquet; muni de l’attirail que j’ai décrit plus haut, il se livrait à une guerre acharnée contre toute la légion des crabes, pouparts, claquarts et craparagdis, sans compter les célèbres pieuvres, dont il avait un talent particulier pour découvrir les trous sous les rochers, et qui, si horribles qu’elles soient, n’en constituent pas moins une boîte très prisée des tendeurs de cordes, et qu’ils achètent fort bien."
                                            }
                                        ]
                                    }
                                ]
