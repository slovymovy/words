                                    },
                                    {
                                        "sense_id": "63a9e10e-9093-31b4-b42c-b4296d7bb537",
                                        "entry_id": "3420828d-35d4-3e1c-be8d-a544b386b5d3",
                                        "glosses": [
                                            "The stiffening of a joint as the result of such abnormal fusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "462884c4-f3ba-3ef1-8077-63687987b9ce",
                                        "entry_id": "3420828d-35d4-3e1c-be8d-a544b386b5d3",
                                        "glosses": [
                                            "An onset of stiffness or inflexibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbf790de-df74-40ad-a7aa-e07fea6cc635",
                                                "sense_id": "462884c4-f3ba-3ef1-8077-63687987b9ce",
                                                "text": "Yet in using the word democracy, one must plead for a distinction, or, better, a reversion, indicated by the curious anchylosis that, at a certain point in their maturity, usually sets in upon words newly put in use to express some august and large spiritual reality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d2258c-5a5e-436a-a608-075d499b57ae",
                        "source_entry_id": "0b5b51b5-6963-3546-8103-17a2c9425c0c",
                        "source_sense_id": "5fc5a750-2014-394c-a474-9b8e62262ef2",
                        "source_sense_description": "Medizin: Versteifung eines natürlicherweise beweglichen Gelenks",
                        "target_lang_word": "ankylose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ankylose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                                        "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                                        "glosses": [
                                            "Arrêt complet ou incomplet du mouvement dans les articulations, dans les jointures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43187aa1-dba2-477d-8227-477d9440ee53",
                                                "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                                                "text": "Le cas de Hoinemann se rapporte à une fille de 12 ans opérée par Langenbeek pour une ankylose du coude à angle obtus et qui succomba 4 mois 1/2 seulement après l’opération."
                                            },
                                            {
                                                "example_id": "c29e01cc-8745-46aa-a11c-ada43e67614b",
                                                "sense_id": "cc1e211c-d814-3948-afdf-9644d4715826",
                                                "text": "Il est si ému qu’il n’ose s’installer confortablement. Il gardera longtemps sa pose en biais, bien qu’il soit sensible à l’ankylose et au torticolis. Il a sa valise sur les genoux et il attend…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                                        "entry_id": "3ae86b10-e3cd-3455-bf80-d21208540346",
                                        "glosses": [
                                            "Raidissement, affaiblissement ou insensibilité des membres dus à une immobilité prolongée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8702419b-0693-4546-aa43-2907e628a5d6",
                                                "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                                                "text": "L’ankylose fondait, dans son épaule, laissant place à des éclairs fulgurants de douleur."
                                            },
                                            {
                                                "example_id": "dbc00459-19b2-4e10-b7cb-2a13f079cc7f",
                                                "sense_id": "f1519b02-84b9-39a3-af78-39998b6170f3",
                                                "text": "Le tête-à-tête avec Meurtzer n'avait que trop duré. Une sournoise migraine s'était emparée de moi, en même temps que l’ankylose. Je ne sentais plus mes jambes."
                                            }
                                        ]
                                    }
                                ]
                            },
