                        "zh": "测量或分析有关流程质量或有效性的数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерять",
                                "target_lang_sense_clarification": "проводить измерения"
                            },
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "анализировать показатели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衡量",
                                "target_lang_sense_clarification": "评估或分析数据"
                            },
                            {
                                "target_lang_word": "量化",
