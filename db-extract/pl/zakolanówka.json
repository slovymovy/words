                "senses": [
                    {
                        "sense_id": "e1b373ff-088d-3bc5-9a35-eb6cf0e566bf",
                        "entry_id": "c7189339-5ea7-33b2-8b6b-c37e767d0193",
                        "glosses": [
                            "długa skarpetka sięgająca ponad kolana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b6bb6b-c1e5-4a1c-9987-aa3704320b3a",
                                "sense_id": "e1b373ff-088d-3bc5-9a35-eb6cf0e566bf",
                                "text": "Jesienią i zimą wiele młodych kobiet nosi zakolanówki. Nic w tym dziwnego – są miękkie, ciepłe i wygodne w noszeniu."
                            },
                            {
                                "example_id": "864731b2-dca8-4193-ae12-632b1ec0f681",
                                "sense_id": "e1b373ff-088d-3bc5-9a35-eb6cf0e566bf",
                                "text": "Niektórzy uważają, że zakolanówki są urocze i bardzo kobiece, zaś według innych to infantylny i wyzywający element damskiej garderoby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
