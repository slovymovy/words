                                    },
                                    {
                                        "sense_id": "f0736f5d-959f-3e11-b78c-6cd4200fa481",
                                        "entry_id": "7477a137-8105-3f8a-9f14-f7c6e816f447",
                                        "glosses": [
                                            "A dog with an orange-coloured coat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e245559f-6342-3f17-9248-a13b1f6134dc",
                                        "entry_id": "7477a137-8105-3f8a-9f14-f7c6e816f447",
                                        "glosses": [
                                            "The junction of the brain and brain stem on a target, used as an aiming point to ensure a one-shot kill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6e4302-f9a1-4855-bbf6-6dee5197df5a",
                                                "sense_id": "e245559f-6342-3f17-9248-a13b1f6134dc",
                                                "text": "Seven hundred and seventy-eight yards, though I didn't know the exact measurement at the time, plus the fact that the bullet ripped through the victim's apricot tipped me to the fact that we were probably dealing with an experienced sniper."
                                            },
                                            {
                                                "example_id": "7dd3e73e-e5bb-49d9-8884-4e86cb97c3ea",
                                                "sense_id": "e245559f-6342-3f17-9248-a13b1f6134dc",
                                                "text": "I'd aim right for the apricot. The medulla. You'd die instantly."
                                            },
                                            {
                                                "example_id": "8e7b3d10-5be5-489e-9b6e-7b427c0a8131",
                                                "sense_id": "e245559f-6342-3f17-9248-a13b1f6134dc",
                                                "text": "“See the nose?” Slater asked. He’d drawn a face on the watermelon with a Sharpie. “Aim right below it, at the philtrum. That way, the bullet's gonna go straight through and hit the apricot. Carmen told you about the apricot?”\nIn my first lesson. The apricot was the sniper's nickname for the medulla oblongata, the cone-shaped mass of neurons that connected the brain to the spinal cord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf76a8c-fac4-3b4f-8498-a43504e9685b",
                                        "entry_id": "7477a137-8105-3f8a-9f14-f7c6e816f447",
                                        "glosses": [
                                            "A testicle."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "dated",
                                            "plural-normally",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
