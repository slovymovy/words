                                        "entry_id": "66b53398-ed7f-3679-baa8-4a364038ef4e",
                                        "glosses": [
                                            "Vertreter der Familie der Haie Sphyrnidae; Hai mit hammerförmig verbreiterter Schnauze"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabfeeed-701f-4484-8371-5b60f7800a24",
                                                "sense_id": "e342f688-9f4a-3f84-a8aa-43a947d689ec",
                                                "text": "Hammerhaie haben einen stromlinienförmigen Körper."
                                            },
                                            {
                                                "example_id": "0ec00ac7-5a81-4034-8828-50f3be9c9df5",
                                                "sense_id": "e342f688-9f4a-3f84-a8aa-43a947d689ec",
                                                "text": "„Wie Forscher um Yuuki Watanabe vom nationalen japanischen Institut für Polarforschung berichten, schwimmen Große Hammerhaie (Sphyrna mokarran) gerne in Seitenlage, in einem Winkel von etwa 60 Grad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
