                        "sense_id": "ef8cea13-972d-3023-b869-4ffbb20d465d",
                        "entry_id": "68fe16eb-bbd8-396d-b1bd-13dc99714489",
                        "glosses": [
                            "Transformer en cire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d7bdb1e8-4e34-411d-a2b4-070b96104bf1",
                                "sense_id": "ef8cea13-972d-3023-b869-4ffbb20d465d",
                                "text": "le second est un dégagment de leur hidrogène, qui brûle à leur surface, forme de l’eau, et les dessèche elles-mêmes sans les cérifier ;"
                            },
                            {
                                "example_id": "37335d63-0c6b-458f-b27f-68ec6753949a",
                                "sense_id": "ef8cea13-972d-3023-b869-4ffbb20d465d",
                                "text": "L’huile, en s’oxidant , se cérifie d’autant plus facilement que sa combinaison avec l’oxigène est plus grande et plus intime."
                            },
                            {
                                "example_id": "8d68603d-2e6c-4f1f-9b3d-691e359de31c",
                                "sense_id": "ef8cea13-972d-3023-b869-4ffbb20d465d",
                                "text": "Le thermoxigène naissant se combine au métal et à l’huile. Le premier se thermoxide et se dissout dans l’acide nitrique, et l’huile se cérifie."
                            }
                        ]
                    }
