                "senses": [
                    {
                        "sense_id": "aff5e9cb-07a6-3b7f-a34a-75b59a5d60a8",
                        "entry_id": "63e6ae1c-a205-382a-885b-effdc1db6034",
                        "glosses": [
                            "benepen, gierig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8089ec44-4bdc-488b-8483-4bb5fe5016bc",
                                "sense_id": "aff5e9cb-07a6-3b7f-a34a-75b59a5d60a8",
                                "text": "“Deze onteigening (-) wordt met een nietsontziend vandalisme en onder druk van de schandelijkste, smerigste, enghartigste en gemeenste hartstochten voltooid.”"
                            },
                            {
                                "example_id": "e9d9cb31-cb66-436b-9742-64be1d5b4678",
                                "sense_id": "aff5e9cb-07a6-3b7f-a34a-75b59a5d60a8",
                                "text": "Allereerst, alleen met een ruim hart houd je het vol (Rom. 12:1-2). Is een van de oorzaken van malaise niet dat we onder de voortdurende druk van de (kerkelijke) cultuur zo beïnvloed worden dat we ”enghartig” worden?"
                            },
                            {
                                "example_id": "10e97e67-013a-416a-8524-49a15bd8958c",
                                "sense_id": "aff5e9cb-07a6-3b7f-a34a-75b59a5d60a8",
                                "text": "We leven in de hoop dat God vrijgevig is en niet enghartig."
                            }
                        ]
                    }
                ],
