                    {
                        "translation_id": "4791a13a-836c-4132-8332-061b68b60cd7",
                        "source_entry_id": "acbbc9c8-7e81-3d4c-8c35-45afca9c403e",
                        "source_sense_id": "55b0dfaf-c62a-30e3-beee-858fa9aa1162",
                        "target_lang_word": "Berechnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berechnung",
