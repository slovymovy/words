{
    "word_family": [
        "wonderful",
        "wonderfully",
        "wonderland",
        "wonderment",
        "wondrous"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4226adea-ef00-3168-bb9f-17a752eaa8c1",
                    "sense_definition": "To think about something and ask oneself about it, often because of curiosity, doubt, or a desire to know more.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_think",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>wonder</w> if it will rain later today.",
                            "target_lang_translations": {
                                "ru": "Мне <w>интересно</w>, пойдет ли сегодня дождь.",
                                "tr": "Bugün ilerleyen saatlerde yağmur yağacak mı acaba <w>merak ediyorum</w>."
                            }
                        },
                        {
                            "text": "She <w>wondered</w> where he had gone after the meeting.",
                            "target_lang_translations": {
                                "ru": "Она <w>задавалась вопросом</w>, куда он пошел после собрания.",
                                "tr": "Toplantıdan sonra nereye gittiğini <w>kendi kendine sordu</w>."
                            }
                        },
                        {
                            "text": "I was <w>wondering</w> if you could help me with this problem.",
                            "target_lang_translations": {
                                "ru": "Я <w>хотел поинтересоваться</w>, не могли бы вы помочь мне с этой проблемой.",
                                "tr": "Bu sorun konusunda bana yardımcı olup olamayacağınızı <w>merak ediyordum</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ponder",
                        "think"
                    ],
                    "common_phrases": [
                        "I wonder if",
                        "wonder why",
                        "I was wondering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Думать о чем-то и задавать себе вопросы, часто из любопытства, сомнения или желания узнать больше.",
                        "tr": "Genellikle merak, şüphe veya daha fazlasını öğrenme arzusu nedeniyle bir şey hakkında düşünmek ve kendi kendine sormak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интересоваться",
                                "target_lang_sense_clarification": "проявлять любопытство или желание узнать"
                            },
                            {
                                "target_lang_word": "задаваться вопросом",
                                "target_lang_sense_clarification": "спрашивать самого себя"
                            },
                            {
                                "target_lang_word": "гадать",
                                "target_lang_sense_clarification": "строить предположения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "merak etmek",
                                "target_lang_sense_clarification": "bir şeyi öğrenmeyi istemek"
                            },
                            {
                                "target_lang_word": "kendi kendine sormak",
                                "target_lang_sense_clarification": "düşüncelere dalmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17ffb962-d39a-3743-8e04-afc4d412717b",
                    "sense_definition": "To feel a strong feeling of surprise, admiration, or amazement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_feel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped to <w>wonder</w> at the magnificent view from the mountain top.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы <w>подивиться</w> великолепному виду с вершины горы.",
                                "tr": "Dağ zirvesinden görünen muhteşem manzaraya <w>hayran kalmak</w> için durduk."
                            }
                        },
                        {
                            "text": "He <w>wondered</w> at her ability to remain calm in such a crisis.",
                            "target_lang_translations": {
                                "ru": "Он <w>изумлялся</w> её способности сохранять спокойствие в такой кризис.",
                                "tr": "Böyle bir krizde sakin kalabilme yeteneğine <w>şaşırdı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wonder at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное чувство удивления, восхищения или изумления.",
                        "tr": "Güçlü bir sürpriz, hayranlık veya şaşkınlık hissetmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удивляться",
                                "target_lang_sense_clarification": "испытывать удивление"
                            },
                            {
                                "target_lang_word": "дивиться",
                                "target_lang_sense_clarification": "восхищаться или поражаться (часто в книжном стиле)"
                            },
                            {
                                "target_lang_word": "изумляться",
                                "target_lang_sense_clarification": "быть крайне удивленным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaşırmak",
                                "target_lang_sense_clarification": "hayret etmek"
                            },
                            {
                                "target_lang_word": "hayran kalmak",
                                "target_lang_sense_clarification": "büyük bir takdirle şaşırmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c330e023-d9ae-330d-a7cc-f9ddb8d10ae4",
                    "sense_definition": "A feeling of surprise, admiration, and amazement caused by something beautiful, unexpected, or unfamiliar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched the fireworks with eyes full of <w>wonder</w>.",
                            "target_lang_translations": {
                                "ru": "Дети смотрели на фейерверк с глазами, полными <w>удивления</w>.",
                                "tr": "Çocuklar havai fişekleri gözleri <w>hayranlıkla</w> dolu izlediler."
                            }
                        },
                        {
                            "text": "She felt a deep sense of <w>wonder</w> as she walked through the ancient forest.",
                            "target_lang_translations": {
                                "ru": "Она испытывала глубокое чувство <w>благоговения</w>, гуляя по древнему лесу.",
                                "tr": "Kadim ormanda yürürken derin bir <w>hayranlık</w> hissetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of wonder",
                        "filled with wonder",
                        "gaze in wonder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство удивления, восхищения и изумления, вызванное чем-то прекрасным, неожиданным или незнакомым.",
                        "tr": "Güzel, beklenmedik veya yabancı bir şeyin neden olduğu hayranlık, şaşkınlık ve sürpriz hissi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удивление",
                                "target_lang_sense_clarification": "эмоция реакции на неожиданное"
                            },
                            {
                                "target_lang_word": "изумление",
                                "target_lang_sense_clarification": "сильная степень удивления"
                            },
                            {
                                "target_lang_word": "восхищение",
                                "target_lang_sense_clarification": "восторг от чего-то прекрасного"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hayranlık",
                                "target_lang_sense_clarification": "derin takdir duygusu"
                            },
                            {
                                "target_lang_word": "şaşkınlık",
                                "target_lang_sense_clarification": "hayret duygusu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddea8ff6-a246-3d21-b41e-ff82c3ed3739",
                    "sense_definition": "Something that causes amazement or admiration, often because it is beautiful, strange, or inexplicable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Great Pyramid is one of the ancient <w>wonders</w> of the world.",
                            "target_lang_translations": {
                                "ru": "Великая пирамида — одно из древних <w>чудес</w> света.",
                                "tr": "Büyük Piramit, dünyanın antik <w>harikalarından</w> biridir."
                            }
                        },
                        {
                            "text": "Modern technology is a <w>wonder</w> that has changed how we live.",
                            "target_lang_translations": {
                                "ru": "Современные технологии — это <w>чудо</w>, которое изменило нашу жизнь.",
                                "tr": "Modern teknoloji, yaşama biçimimizi değiştiren bir <w>mucizedir</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wonders of the world",
                        "natural wonder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, вызывающее изумление или восхищение, часто благодаря своей красоте, необычности или необъяснимости.",
                        "tr": "Genellikle güzel, garip veya açıklanamaz olduğu için hayranlık veya şaşkınlığa neden olan şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "нечто поразительное или сверхъестественное"
                            },
                            {
                                "target_lang_word": "диво",
                                "target_lang_sense_clarification": "диковина, чудо (разговорное или поэтическое)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harika",
                                "target_lang_sense_clarification": "olağanüstü şey"
                            },
                            {
                                "target_lang_word": "mucize",
                                "target_lang_sense_clarification": "insanı hayran bırakan şey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70db19b9-8c3a-34fe-955c-8a75d6994099",
                    "sense_definition": "A surprising or fortunate fact or event; often used in phrases to express that something is not surprising or is very lucky.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>wonder</w> that nobody was hurt in the accident.",
                            "target_lang_translations": {
                                "ru": "Просто <w>чудо</w>, что никто не пострадал в аварии.",
                                "tr": "Kazada kimsenin yaralanmamış olması bir <w>mucize</w>."
                            }
                        },
                        {
                            "text": "No <w>wonder</w> you are tired after working all night.",
                            "target_lang_translations": {
                                "ru": "<w>Неудивительно</w>, что ты устал, проработав всю ночь.",
                                "tr": "Bütün gece çalıştıktan sonra yorgun olmana <w>şaşmamalı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "no wonder",
                        "it is a wonder",
                        "small wonder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удивительный или удачный факт или событие; часто используется во фразах, выражающих отсутствие удивления или удачу.",
                        "tr": "Şaşırtıcı veya şanslı bir olay veya durum; genellikle bir şeyin şaşırtıcı olmadığını veya çok şanslı olduğunu belirtmek için kalıplarda kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "удивительное событие"
                            },
                            {
                                "target_lang_word": "удивление",
                                "target_lang_sense_clarification": "в контексте фраз 'неудивительно'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mucize",
                                "target_lang_sense_clarification": "şaşırtıcı şanslı olay"
                            },
                            {
                                "target_lang_word": "şaşılacak şey",
                                "target_lang_sense_clarification": "hayret verici durum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cf260ff-c9db-3557-b23a-4ec005eb1b8c",
                    "sense_definition": "Beneficial results or achievements that are surprisingly effective or good.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A week of rest and relaxation will do <w>wonders</w> for your health.",
                            "target_lang_translations": {
                                "ru": "Неделя отдыха и расслабления сотворит <w>чудеса</w> для твоего здоровья.",
                                "tr": "Bir haftalık dinlenme ve rahatlama sağlığınız için <w>mucizeler</w> yaratacaktır."
                            }
                        },
                        {
                            "text": "The new manager has worked <w>wonders</w> with the sales team.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер сотворил <w>чудеса</w> с отделом продаж.",
                                "tr": "Yeni müdür satış ekibiyle harika <w>işler başardı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do wonders",
                        "work wonders"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полезные результаты или достижения, которые удивительно эффективны или хороши.",
                        "tr": "Şaşırtıcı derecede etkili veya iyi olan faydalı sonuçlar veya başarılar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудеса",
                                "target_lang_sense_clarification": "поразительные результаты (обычно во мн. числе)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mucizeler",
                                "target_lang_sense_clarification": "olağanüstü sonuçlar"
                            },
                            {
                                "target_lang_word": "harikalar",
                                "target_lang_sense_clarification": "büyük başarılar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "640e4970-ef02-3cea-acde-94065b1b2992",
                    "sense_definition": "A person who is extremely skillful, talented, or successful at something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>wonder</w> at fixing old engines.",
                            "target_lang_translations": {
                                "ru": "Он просто <w>чудо</w> в починке старых двигателей.",
                                "tr": "Eski motorları tamir etme konusunda tam bir <w>dâhi</w>."
                            }
                        },
                        {
                            "text": "The young pianist was considered a musical <w>wonder</w> by her teachers.",
                            "target_lang_translations": {
                                "ru": "Учителя считали юную пианистку музыкальным <w>вундеркиндом</w>.",
                                "tr": "Genç piyanist, öğretmenleri tarafından müzikal bir <w>harika çocuk</w> olarak görülüyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boy wonder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который чрезвычайно искусен, талантлив или успешен в чем-либо.",
                        "tr": "Bir konuda son derece yetenekli, becerikli veya başarılı olan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вундеркинд",
                                "target_lang_sense_clarification": "одаренный человек, чудо-ребенок"
                            },
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "о человеке с исключительными качествами"
                            },
                            {
                                "target_lang_word": "самородок",
                                "target_lang_sense_clarification": "природный талант"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dâhi",
                                "target_lang_sense_clarification": "üstün yetenekli kişi"
                            },
                            {
                                "target_lang_word": "deha",
                                "target_lang_sense_clarification": "olağanüstü zekaya sahip kimse"
                            },
                            {
                                "target_lang_word": "harika çocuk",
                                "target_lang_sense_clarification": "üstün yetenekli genç"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}