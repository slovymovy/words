                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fed08b07-75e0-43b6-a08c-282cb9528254",
                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "tags": [
                            "plural"
                        ],
                        "form": "dominances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "glosses": [
                            "Exercice d’une influence ou d’une action prépondérante ; état qui en résulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcffb114-49f8-4376-8dca-50fd9061f1b4",
                                "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                                "text": "Paul Broca est le père de la théorie de la dominance cérébrale de l’hémisphère gauche dans le langage articulé qu’il esquisse dès 1861."
                            },
                            {
                                "example_id": "9530e9e9-6c3b-4a0a-96ae-74e9f0bdbb82",
                                "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                                "text": "L’intérêt de la bourgeoisie étant de conserver avant tout ses prérogatives hiérarchiques de dominance …, elle accepte bien volontiers de diffuser une culture, surtout si elle se vend."
                            }
                        ]
                    },
                    {
                        "sense_id": "d61ad273-6db0-3882-8fb5-2052dd138b76",
                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "glosses": [
                            "Qualité de ce qui domine en importance ou en quantité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16dcd3e4-dd1c-4fff-a636-5b30405cd3ed",
                                "sense_id": "d61ad273-6db0-3882-8fb5-2052dd138b76",
                                "text": "[…] pourtant la dominance toute locale du Genêt à balai ou de la Callune ou même de la Fougère Aigle, espèces sociales de « premier plan », confère à la lande une physionomie particulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f4b4a7d-2620-3cf7-a721-9383b709b000",
                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "glosses": [
                            "Suprématie hiérarchique d’un animal qui exerce une autorité sur les autres."
                        ],
                        "tags": [
                            "Éthologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "603bedaa-a2f4-3a5d-9a1e-0e203ed53e6f",
                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "glosses": [
                            "Qualité d’un gène capable de s’exprimer quel que soit l’autre gène de la même paire."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "244d0234-1164-4b6d-8943-9e0b3335ada7",
                        "source_entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                        "target_lang_word": "dominance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dominance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8da1fa8c-0305-3801-ac73-bec4f37bd19f",
                                        "entry_id": "b64cd3cb-a700-360e-8209-9a06a1240f5b",
                                        "glosses": [
                                            "The state of being dominant; of prime importance; supremacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39fc122d-6524-4c7c-9886-94e378c1af5a",
                                                "sense_id": "8da1fa8c-0305-3801-ac73-bec4f37bd19f",
                                                "text": "But with the lively Dos Santos pulling the strings behind strikers Pavlyuchenko and Defoe, Spurs controlled the first half without finding the breakthrough their dominance deserved."
                                            },
                                            {
                                                "example_id": "2787cd25-314c-4a02-8ee0-52b31b7ec994",
                                                "sense_id": "8da1fa8c-0305-3801-ac73-bec4f37bd19f",
                                                "text": "Thus approximately 98% of signs contained English, and 93.5% of signs were wholly in English. As far as linguistic landscapes go, this is a case of extreme monolingual dominance in a multilingual setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c313264-2dd4-378c-8298-7c9907828e49",
                                        "entry_id": "b64cd3cb-a700-360e-8209-9a06a1240f5b",
                                        "glosses": [
                                            "Being in a position of power, authority or ascendancy over others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d6857-ba3c-4733-a023-36db1482ab74",
                                                "sense_id": "7c313264-2dd4-378c-8298-7c9907828e49",
                                                "text": "Shepard: Too many lives were lost at that base. I'm not sorry it's gone.\nIllusive Man: The first of many lives.\nIllusive Man: The technology from that base could have secured human dominance in the galaxy. Against the Reapers and beyond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0fa45bd-1fa7-3cab-86ea-57106fc502ef",
                                        "entry_id": "b64cd3cb-a700-360e-8209-9a06a1240f5b",
                                        "glosses": [
                                            "The superior development of or preference for one side of the body or one of a pair of organs; such as being right-handed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d92eae07-53a4-3172-ab35-e7a74466ea5e",
                                        "entry_id": "b64cd3cb-a700-360e-8209-9a06a1240f5b",
                                        "glosses": [
                                            "of an allele, the degree to which it expresses its phenotype when heterozygous, such as whether it is dominant or recessive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
