                    {
                        "sense_id": "900a03b5-80eb-3fb8-b558-03830cdfdc34",
                        "entry_id": "00c0fbfd-bd4e-3d5c-b4c0-4b4a90628ed2",
                        "glosses": [
                            "Bündnisse mit antidemokratischen Bestrebungen zwischen Nationalisten und Sozialisten in der Weimarer Republik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe34e5a8-de2b-4d63-8700-c8416df7e375",
                                "sense_id": "900a03b5-80eb-3fb8-b558-03830cdfdc34",
                                "text": "„Ausgangspunkt der «Querfront»-Bemühungen war, dass sich die ADGB-Führung am 30. Juli 1932, nur zehn Tage nach dem Staatsstreich in Preußen, der autoritären Refierung Papen als stabilisierender Faktor anbot und sich damit von der SPD zu distanzieren begann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5ffe94c-abb8-39c6-b7f6-65aa1053a49a",
                        "entry_id": "00c0fbfd-bd4e-3d5c-b4c0-4b4a90628ed2",
                        "glosses": [
                            "gemeinsame antidemokratische und antiemanzipatorische Bestrebungen politisch linker und rechter Personen oder Gruppen (in der Regel geprägt von Antisemitismus, Rassismus und Antifeminismus sowie Feindseligkeit gegenüber homosexuellen und transsexuellen Personen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11192510-bdb7-4b5c-9c1f-2e81387820ad",
                                "sense_id": "a5ffe94c-abb8-39c6-b7f6-65aa1053a49a",
                                "text": "„Der Antisemitismus gehört in der Querfront zur DNA. Da wird der Staat Israel schon mal mit dem Apartheidsregime in Südafrika verglichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
