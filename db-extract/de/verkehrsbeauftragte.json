                ],
                "senses": [
                    {
                        "sense_id": "771bea49-8b9c-3040-abd5-97930f43a1d8",
                        "entry_id": "13e3775e-c9a8-35e3-9114-bee9bb08a9c2",
                        "glosses": [
                            "amtlich oder institutsintern bestellte weibliche Person, die als Verkehrsexpertin Verkehrsfragen klären beziehungsweise als Multiplikatorin die Förderung der Verkehrserziehung betreiben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba6d654-6862-4770-abf4-74db17e34305",
                                "sense_id": "771bea49-8b9c-3040-abd5-97930f43a1d8",
                                "text": "„‚Frau Dr. Spargel, Sie sind die Verkehrsbeauftragte der Stadt. Wie gedenken Sie, die Situation in den Griff zu bekommen?‘“"
                            },
                            {
                                "example_id": "755a7476-af94-4c12-8fdf-e68ccda2d75e",
                                "sense_id": "771bea49-8b9c-3040-abd5-97930f43a1d8",
                                "text": "„ […], die Verkehrsbeauftragte Luz Gónzalez Rambay, Gloria Torres, die für die Kontrolle im Rathaus zuständig war, und die Leiterin des Bauwesens, Ingenieurin Gloria Grisales Muñoz.“"
                            },
                            {
                                "example_id": "9f4564f8-02ed-498f-8b02-8939c88813bf",
                                "sense_id": "771bea49-8b9c-3040-abd5-97930f43a1d8",
                                "text": "„Mit der Anmeldung verpflichtet sich die meldende Schule zur Unterstützung der ausgebildeten Mentorinnen und Mentoren durch den/die Verkehrsbeauftragte/n.“"
                            },
                            {
                                "example_id": "7cae9729-ed79-48b9-aa45-5fb08fa0b354",
                                "sense_id": "771bea49-8b9c-3040-abd5-97930f43a1d8",
                                "text": "„Die Verkehrsbeauftragte bindet in Absprache mit der Schulleitung das Kollegium in die Planung für die Verkehrstage ein, die im Herbst stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
