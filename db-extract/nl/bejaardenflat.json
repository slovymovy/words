                        "glosses": [
                            "woongebouw dat bestaat uit woningen voor mensen met hogere leeftijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ed79e1-db64-4d34-a937-2bf5539be902",
                                "sense_id": "c45ca6b3-0a91-39d1-aa26-eb81b63d8e31",
                                "text": "Soms zijn de tafereeltjes van straten en pleinen weergaloos wezenloos of aandoenlijk, zoals de trotse foto van een voor die tijd moderne bejaardenflat naast een oude katholieke kerk in Gendringen."
                            }
                        ]
                    },
