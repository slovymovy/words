                                        "entry_id": "962b2f7b-d3a7-3408-b9c7-81beae9073f9",
                                        "glosses": [
                                            "The act or means by which something is tethered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6170de3-a0ac-43cf-96cd-71643da5317b",
                                                "sense_id": "da2978b5-562e-3675-ba22-399b3e4849b7",
                                                "text": "Early childhood takes the fact for what it is best worth, and sets about finding not alone its qualities and attributes, but its affiliations, its tetherings, its implications, its adaptability to other purposes than those it serves to common sense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11cbae2f-7d24-3373-8bd3-7190f3e9c1c5",
