                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd991fc1-6994-3e83-9369-5023e1b1fdd4",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A disposition of property, or the act of granting it."
                                        ],
