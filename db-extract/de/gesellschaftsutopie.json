                "senses": [
                    {
                        "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                        "entry_id": "017683cc-3db0-35b8-8a93-c97a22d679e2",
                        "glosses": [
                            "utopisches Idealbild einer zukünftigen Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31947733-c6bc-4773-a75b-807045059579",
                                "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                                "text": "„Im Folgenden wird Nachhaltigkeit zunächst als eine gegenwärtige Form der Gesellschaftsutopie fokussiert […].“"
                            },
                            {
                                "example_id": "7021cc97-6e5c-40ba-a7ad-67543b4e3a16",
                                "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                                "text": "„Kleists Erzählung hat drei Teile: Befreiung aus Gewalt durch Katastrophe, Gesellschaftsutopie in der Natur, Niederschlagung der Utopie durch Gewalt.“"
                            },
                            {
                                "example_id": "1957202e-9890-423a-9b7d-433a1ed65fa8",
                                "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                                "text": "„In dieser phantasierten Zukunft siedeln sich in der Regel auch Gesellschaftsutopien an.“"
                            },
                            {
                                "example_id": "f0fc71dd-fa60-4b70-9e44-05624ebb32dd",
                                "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                                "text": "„UdSSR, DDR, zwei verschiedene Länder mit denselben Gesellschaftsutopien, die in Wirklichkeit Diktaturen waren.“"
                            },
                            {
                                "example_id": "cbcadc57-5d98-4b8f-9419-8ffef29195be",
                                "sense_id": "66d4b1a6-d4cb-37d7-9109-f22c57114e06",
                                "text": "„Im Mittelpunkt der Arbeit wird ein inhaltlicher Vergleich von Lockes politischen Schriften, der Dialektik der Aufklärung und den negativen Gesellschaftsutopien stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
