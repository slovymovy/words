                    "sense_id": "f3a40b4d-679d-33c9-9b38-709538caf5bd",
                    "sense_definition": "Форма глагола <w>идти</w> (3-е лицо, единственное число, настоящее время), написанная без буквы «ё».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По расписанию этот скорый поезд <идет> в Москву.",
                            "target_lang_translations": {
                                "en": "According to the schedule, this express train <goes> to Moscow.",
                                "zh": "按照时刻表，这趟特快列车正<w>开往</w>莫斯科。"
                            }
                        },
                        {
                            "text": "На улице уже второй день <идет> сильный дождь.",
                            "target_lang_translations": {
                                "en": "Heavy rain <has been falling> outside for the second day.",
                                "zh": "外面已经连续两天<w>下</w>大雨了。"
                            }
                        },
                        {
                            "text": "Тебе очень <идет> это красивое красное платье.",
                            "target_lang_translations": {
                                "en": "That beautiful red dress really <suits> you.",
                                "zh": "这条漂亮的红裙子非常<w>适合</w>你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "двигаться",
                        "подходить"
                    ],
                    "antonyms": [
                        "стоит"
                    ],
                    "common_phrases": [
                        "идет дождь",
                        "время идет",
                        "все идет по плану",
                        "идет снег"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "написание без «ё»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the verb 'идти' (to go) — 3rd person singular, present tense; written without the letter 'ё'.",
                        "zh": "动词“идти”（走）的第三人称单数现在时形式，书写时省略了字母“ё”。"
                    },
