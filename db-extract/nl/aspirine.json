                    {
                        "sense_id": "0fe5a7a6-c76e-3998-aa2d-f0c977eced4c",
                        "entry_id": "fb98c0fa-9682-321c-86d3-c5dad31114c9",
                        "glosses": [
                            "een middel tegen allerlei kwalen met als werkzame stof acetylsalicylzuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f447bfe9-181f-4c1b-9909-d4a27bec3f73",
                                "sense_id": "0fe5a7a6-c76e-3998-aa2d-f0c977eced4c",
                                "text": "We gebruiken tegenwoordig vaker paracetamol in plaats van aspirine bij pijn en koorts."
