                "senses": [
                    {
                        "sense_id": "12cf0b1e-cc22-3794-99fa-6c16a64f4424",
                        "entry_id": "d74e0a05-0b21-351a-aaaf-ad14892c9e39",
                        "glosses": [
                            "mit Gas betriebene Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45eb485f-ae79-4ad8-a6b4-81f3d2ae4da6",
                                "sense_id": "12cf0b1e-cc22-3794-99fa-6c16a64f4424",
                                "text": "„Die erste funktionierende Gaslampe nahm 1785 in den Niederlanden Johannes Petrus Minckeleers in Betrieb.“"
                            },
                            {
                                "example_id": "8de7861d-d6af-4489-bb85-efad08a4078a",
                                "sense_id": "12cf0b1e-cc22-3794-99fa-6c16a64f4424",
                                "text": "„Langsam bindet sie sich die Tanzschuhe auf unter der Gaslampe.“"
                            },
                            {
                                "example_id": "dc8542b8-39f8-42fa-a55f-d5a9c3b1af9d",
                                "sense_id": "12cf0b1e-cc22-3794-99fa-6c16a64f4424",
                                "text": "„Ich hatte bislang keine Gelegenheit, sie an ihm festzustellen, denn abends spenden Gaslampen oder Kerzen Licht.“"
                            },
                            {
                                "example_id": "4ff6408d-cc08-4044-8a12-b325b2edb193",
                                "sense_id": "12cf0b1e-cc22-3794-99fa-6c16a64f4424",
                                "text": "„Abends setzt sich der Papa mit der Gaslampe ins Vorzelt, trinkt bis tief in die Nacht mehrere Flaschen Rosé, raucht unzählige halbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
