                "senses": [
                    {
                        "sense_id": "c72ceef5-c722-31a0-a9a3-b48df3ff2938",
                        "entry_id": "308721bd-068a-3150-9b78-71cac72dea6b",
                        "glosses": [
                            "Qui a un rapport avec le Mozambique ou ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553885c7-7f2d-4956-aa14-ab11ad0327ce",
                                "sense_id": "c72ceef5-c722-31a0-a9a3-b48df3ff2938",
                                "text": "Le cyclone Idai, qui a frappé la côte mozambicaine dans la nuit du 14 et 15 mars, a fait 468 morts au Mozambique et plus de 250 au Zimbabwe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "773323bc-3036-4e87-917e-f271dd864ab9",
                        "source_entry_id": "308721bd-068a-3150-9b78-71cac72dea6b",
                        "source_sense_id": "c72ceef5-c722-31a0-a9a3-b48df3ff2938",
