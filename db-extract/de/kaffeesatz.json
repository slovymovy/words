                        ]
                    },
                    {
                        "translation_id": "6e666865-5f89-44c0-a854-a6642a3e8e7c",
                        "source_entry_id": "231f2248-312e-3278-a632-655b8d27c943",
                        "source_sense_id": "50ab89cf-b664-39d8-9a33-c2e3776482a6",
                        "source_sense_description": "meist Singular: ausgelaugtes Pulver vom Bohnenkaffee, das nach der Zubereitung zurückbleibt",
                        "target_lang_word": "marc de café",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marc de café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55bb4d73-f619-3aac-a454-021655045a36",
                                        "entry_id": "bfd2a193-f135-376a-b2eb-1b41f8f5b005",
                                        "glosses": [
                                            "Résidu de l’infusion du café, et par extension d’autres produits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f4c6d3-fd81-4b18-9686-304b517db280",
                                                "sense_id": "55bb4d73-f619-3aac-a454-021655045a36",
                                                "text": "Maxime. — Comment, Mademoiselle, vous avez étudié l’amour ?\nVictoire. — Dame ! comme tout le monde.\nMaxime. — Dans Descartes ?\nVictoire. — Non !… Dans du marc de café !\nMaxime. — Je crois, Mademoiselle, que vous vous méprenez !"
                                            },
                                            {
                                                "example_id": "ec5f1317-fb78-488e-ba86-04be8010f92e",
                                                "sense_id": "55bb4d73-f619-3aac-a454-021655045a36",
                                                "text": "Il ne comprenait pas pourquoi il avait confié sa main à cette apparition du diable, lui qui n’avait jamais voulu qu’on lise dans les lignes de sa main, qu’on lui tire les cartes ou qu’on prédise son avenir de quelque manière que ce soit, boule de cristal ou marc de café."
                                            },
                                            {
                                                "example_id": "be71d147-e6ca-498d-ae0a-23a5dc5e389e",
                                                "sense_id": "55bb4d73-f619-3aac-a454-021655045a36",
                                                "text": "Vous pouvez aussi conserver thé et marc de café et les mettre directement aux pieds des végétaux, autant d’éléments nutritifs plus utiles en terre que dans la poubelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89ad0dd-221d-368c-a5ca-96f6b6d5a2ff",
                                        "entry_id": "bfd2a193-f135-376a-b2eb-1b41f8f5b005",
                                        "glosses": [
                                            "Résidu de café, riche en azote, utilisé comme amendement ou répulsif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
