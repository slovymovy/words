                ],
                "senses": [
                    {
                        "sense_id": "3bb468df-a5f4-3a07-bf20-6505bb221675",
                        "entry_id": "07042336-2f1d-30bd-afc0-05da239f8cc6",
                        "glosses": [
                            "der Übergang, die Wende von einem Jahrtausend zum nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a355d79-c6fa-4759-ba48-c04758d39520",
                                "sense_id": "3bb468df-a5f4-3a07-bf20-6505bb221675",
                                "text": "„Seit der Jahrtausendwende könne jedoch ein Rückgang der Deutschlernenden bei gleichzeitigem Anstieg der Englischlernenden festgestellt werden.“"
                            },
                            {
                                "example_id": "e81f6e51-9c6b-4591-b434-e94443927a0d",
                                "sense_id": "3bb468df-a5f4-3a07-bf20-6505bb221675",
                                "text": "„Durch den Beitritt zur EU übernahm Finnland um die Jahrtausendwende den Euro als Währung und schaffte die alte, eigene Währung ab.“"
                            },
                            {
                                "example_id": "1bc5cfcf-f346-47e3-a3f2-5575fdae486a",
                                "sense_id": "3bb468df-a5f4-3a07-bf20-6505bb221675",
                                "text": "„Ich war absichtlich allein und spielte Klavier, denn ich wollte die Feiern zur Jahrtausendwende ignorieren.“"
                            },
                            {
                                "example_id": "b24aafef-732e-491e-90b0-01e6c398f8e7",
                                "sense_id": "3bb468df-a5f4-3a07-bf20-6505bb221675",
                                "text": "„Gleichwohl konnte Mugabe seine Position wiederholt durchsetzen, was ihm nach der Jahrtausendwende sogar immer besser gelang, weil er Südafrikas Präsidenten Thabo Mbeki als Verbündeten gewann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
