                "senses": [
                    {
                        "sense_id": "fb5d5cd7-96e0-3441-af5d-a5d5e2d3e9e0",
                        "entry_id": "6375ef3f-dc50-3250-b53c-3126b6e870b1",
                        "glosses": [
                            "zabawa dziecięca, w której jeden z uczestników z zawiązanymi oczami goni i próbuje chwytać innych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90291e2c-c1ad-4c57-a963-de0ad3812219",
                                "sense_id": "fb5d5cd7-96e0-3441-af5d-a5d5e2d3e9e0",
                                "text": "Nasze dzieci pół wieczora bawiły się w ciuciubabkę."
                            },
                            {
                                "example_id": "467006e2-2a78-434c-b7b4-4f632ee5365a",
                                "sense_id": "fb5d5cd7-96e0-3441-af5d-a5d5e2d3e9e0",
                                "text": "Wystarczy tylko w krąg ustawić się • chusteczkę jedną mieć • i ciuciubabkę szybko wybrać; raz, dwa, trzy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b16e2610-8577-3653-b3d7-ded142800d37",
                        "entry_id": "6375ef3f-dc50-3250-b53c-3126b6e870b1",
                        "glosses": [
                            "sytuacja, w której działa się bez właściwego rozeznania, na ślepo, po omacku"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "6c4b26ae-437a-465b-83f7-9776115914b3",
                                "sense_id": "b16e2610-8577-3653-b3d7-ded142800d37",
                                "text": "Powiedział, że wyjaśni jej wszystko, jak już będą na miejscu, ale ona dość już miała tej ciuciubabki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a6c0ce4-b3de-457b-a3bb-5ddf956249eb",
                        "source_entry_id": "6375ef3f-dc50-3250-b53c-3126b6e870b1",
                        "source_sense_id": "fb5d5cd7-96e0-3441-af5d-a5d5e2d3e9e0",
