                "translations": [
                    {
                        "translation_id": "8645650d-fa9c-410a-8161-9017c2584cba",
                        "source_entry_id": "ba8fc0d4-4738-3c0c-86eb-b5863ab55443",
                        "source_sense_id": "274bdaa9-c6cd-3828-952a-a3d9c304cb87",
                        "source_sense_description": "druivensuiker",
                        "target_lang_word": "Glukose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glukose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b22dc3cc-ce74-3db8-b9a4-c421ca1e7b3c",
                                        "entry_id": "ee84a165-1524-3770-bb0b-fcc12c931620",
                                        "glosses": [
                                            "Traubenzucker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4536829-479a-4e06-9a5e-3725f086eb6a",
                                                "sense_id": "b22dc3cc-ce74-3db8-b9a4-c421ca1e7b3c",
                                                "text": "„Nach den Todesfällen durch vergiftete Glukose aus einer Kölner Apotheke hat das Gesundheitsamt sein Handeln gerechtfertigt.“"
                                            },
                                            {
                                                "example_id": "98223372-7cf0-41fa-856c-26e61ef81b78",
                                                "sense_id": "b22dc3cc-ce74-3db8-b9a4-c421ca1e7b3c",
                                                "text": "„Gehirnzellen verbrauchen rund zehn Esslöffel Glukose pro Tag.“"
                                            },
                                            {
                                                "example_id": "6f9547dc-de5d-4982-a1b4-720b71a81d6b",
                                                "sense_id": "b22dc3cc-ce74-3db8-b9a4-c421ca1e7b3c",
                                                "text": "„Die Lösung enthält 75 Gramm Glukose (Traubenzucker), was etwa sieben Esslöffeln Zucker entspricht, aufgelöst in 300 Milliliter Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abc66787-d6fc-4da9-be71-ebe89297bbe9",
                        "source_entry_id": "ba8fc0d4-4738-3c0c-86eb-b5863ab55443",
                        "source_sense_id": "274bdaa9-c6cd-3828-952a-a3d9c304cb87",
