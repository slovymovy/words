                                                "example_id": "818f66da-40b7-4672-a3b9-63e87e4b859a",
                                                "sense_id": "14268068-ba77-3952-ab29-a8e3bc8e2568",
                                                "text": "\"They are all very suspicious about the wording. I am always thinking up new ways of kidding them.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a619fd8-fd14-324a-9d08-175441790c68",
                                        "entry_id": "0895a7a7-31ea-37d3-936c-bf8e1bb1011d",
                                        "glosses": [
                                            "To dupe or deceive.",
                                            "To deceive or dupe as a joke."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15ad05d6-965a-4c0f-8fe4-3b5ec64b802e",
                                                "sense_id": "4a619fd8-fd14-324a-9d08-175441790c68",
                                                "text": "Stop kidding me! It's not funny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d2d6f2f-4723-388f-8314-a8baba13dfb3",
                                        "entry_id": "0895a7a7-31ea-37d3-936c-bf8e1bb1011d",
                                        "glosses": [
                                            "To dupe or deceive.",
                                            "To deceive oneself by having unrealistic expectations."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive",
                                            "transitive"
