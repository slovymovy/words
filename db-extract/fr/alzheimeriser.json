                                "example_id": "2e64829f-3496-4bb3-bf62-0fe0b511fd12",
                                "sense_id": "f6eb8728-f8a0-3d45-b886-f9955590bfc7",
                                "text": "Moira mémoire se voyait commençant à s’alzheimeriser, à disparaître."
