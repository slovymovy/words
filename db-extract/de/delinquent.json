                    }
                ],
                "senses": [
                    {
                        "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                        "entry_id": "e524d8e4-e9be-3c50-bf86-413aec7a96e7",
                        "glosses": [
                            "Ausführender eines Delikts; jemand, der ein Delikt (Straftat) begangen hat"
                        ],
                        "tags": [
                            "Kriminologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9a0f3ee6-4e51-4d5c-abb3-d750ac4a606e",
                                "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                                "text": "„Die im ganzen Deutschen Reich beliebte Folter diente der Erreichung eines schnellen Geständnisses des Delinquenten.“"
                            },
                            {
                                "example_id": "5b5156ad-1396-4ecb-9286-b92f8b04514d",
                                "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                                "text": "„In der Geschichte praktizierten verschiedene Mächte wie bspw. Russland oder Großbritannien die Verbannung von Delinquenten besonders auch zum Zwecke der Kolonisierung abgelegener oder weit entfernter Gebiete (Sibirien, Australien).“"
                            },
                            {
                                "example_id": "21a6ebc2-67af-46c5-9f03-84cffe549047",
                                "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                                "text": "„Um die harte Linie zu rechtfertigen, brauchte die Union wenigstens einen Fall, in dem der Delinquent auch nach heutigen Maßstäben ein schweres Verbrechen begangen hätte.“"
                            },
                            {
                                "example_id": "d1babf14-e288-4e7b-91ee-7617058f3d7c",
                                "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                                "text": "„Sykes und Matza wandten sich damit gegen die Annahme der Subkulturtheorie, nach der jugendliche Delinquente abweichenden Gruppen-Normen folgen.“"
                            },
                            {
                                "example_id": "911ddbe4-856a-4403-9b25-96cbd644c4fe",
                                "sense_id": "45a4936a-31c1-3062-a1da-6da57d8a966c",
                                "text": "„Unten auf dem Platz trat der Scharfrichter hinter den Delinquenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
