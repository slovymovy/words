                        "glosses": [
                            "ocena stanu środowiska naturalnego lub określenie właściwości jakiegoś czynnika środowiskowego (np. poziomu zanieczyszczeń) za pomocą wskaźników biologicznych, którymi są organizmy (bioindykatory)"
                        ],
