                                    {
                                        "sense_id": "304130cb-bf58-324e-b370-f0bcc50df7a8",
                                        "entry_id": "1e0804a0-77a8-3e17-93a2-3fd57ba356c5",
                                        "glosses": [
                                            "cosa futile, di poca importanza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f67a635b-551d-45e1-9de6-8d126b849ded",
                                                "sense_id": "304130cb-bf58-324e-b370-f0bcc50df7a8",
                                                "text": "dalla sciocchezza alla menzogna, un batter d'occhio... nessun gioco regna"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb5b277-8655-3401-b406-1df2782f127c",
                                        "entry_id": "1e0804a0-77a8-3e17-93a2-3fd57ba356c5",
                                        "glosses": [
                                            "cosa ritenuta \\\"impossibile\\\" perché giudicata senza \\\"senso logico\\\" né razionalità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf9d1e8-8b61-4e19-8f60-e7602ca56abf",
                                                "sense_id": "6fb5b277-8655-3401-b406-1df2782f127c",
                                                "text": "qualche volta le sciocchezze della fantasia sono utili alla speranza"
                                            },
                                            {
                                                "example_id": "68f52443-07ff-433b-bd42-438c4f547c1d",
                                                "sense_id": "6fb5b277-8655-3401-b406-1df2782f127c",
                                                "text": "\"Lo so io e lo sai tu, non facciamo sciocchezze... Ok?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bee713e-fc2a-37d2-9a2c-cc11d9860232",
                                        "entry_id": "1e0804a0-77a8-3e17-93a2-3fd57ba356c5",
                                        "glosses": [
                                            "\\\"invenzione\\\", talvolta pretestuosa; \\\"chiacchierare\\\" vanamente"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a720ce-16c5-436f-af86-5782b5cfe21a",
                                                "sense_id": "7bee713e-fc2a-37d2-9a2c-cc11d9860232",
                                                "text": "ha detto solo sciocchezze per tutta la giornata"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b196585-0441-4133-86f3-1d5c2c15426b",
                        "source_entry_id": "c8c2c686-0329-3073-a32c-3a56648c51b3",
                        "source_sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                        "source_sense_description": "unsinniger oder ungehöriger Zustand; unsinnige oder ungehörige Handlung",
                        "target_lang_word": "глупость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глупость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b22c5c9c-3659-3f24-9b5c-f125ffe06f98",
                                        "entry_id": "8828222a-0bf6-3007-a865-1c7931477171",
                                        "glosses": [
                                            "свойство по значению прилагательного глупый; умственная ограниченность, неспособность к здравому рассуждению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbf306d-a8b6-4817-9d06-3ece03dc1f91",
                                                "sense_id": "b22c5c9c-3659-3f24-9b5c-f125ffe06f98",
                                                "text": "Не умалчивают они и о недостатках своего соперника: если он умён, доказывают его глупость, если он дурак, изображают его безнадёжным идиотом."
                                            },
                                            {
                                                "example_id": "fa047d57-56bf-4e00-ad95-95f4bb6b65b9",
                                                "sense_id": "b22c5c9c-3659-3f24-9b5c-f125ffe06f98",
                                                "text": "Однако, несмотря на всю свою глупость, он, конечно, досмотрел бы неприемлемость этой возмутительной странички, если бы прочел её."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b849fbf-6e2c-3e66-8bca-e43c1ff94b5f",
                                        "entry_id": "8828222a-0bf6-3007-a865-1c7931477171",
                                        "glosses": [
                                            "свойство по значению прилагательного глупый; нелогичность, несоответствие здравому смыслу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b85b028-2a02-452a-a8bc-4ad21595299d",
                                                "sense_id": "6b849fbf-6e2c-3e66-8bca-e43c1ff94b5f",
                                                "text": "Мать начинает понимать весь идиотизм, глупость и сумасшествие всей этой её затеи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66b3be2-ef22-3d69-af3d-654d75e5d71e",
                                        "entry_id": "8828222a-0bf6-3007-a865-1c7931477171",
                                        "glosses": [
                                            "глупая мысль, высказывание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe1ee197-ab68-44fe-bfd7-a902ce0ad71f",
                                                "sense_id": "f66b3be2-ef22-3d69-af3d-654d75e5d71e",
                                                "text": "— Глупости говорите… — вмешался суровый Филипп Филиппович, но Борменталь его перебил: — Не беспокойтесь, Филипп Филиппович, я сам. Вы, Шариков, чепуху говорите, и возмутительнее всего то, что говорите её безапелляционно и уверенно."
                                            },
                                            {
                                                "example_id": "33dc86c6-80d8-44c9-937c-4ca85935c944",
                                                "sense_id": "f66b3be2-ef22-3d69-af3d-654d75e5d71e",
                                                "text": "— Вы стоите на самой низшей ступени развития, — перекричал Филипп Филиппович, — вы ещё только формирующееся, слабое в умственном отношении существо, все ваши поступки чисто звериные, и вы в присутствии двух людей с университетским образованием позволяете себе с развязностью совершенно невыносимой подавать какие-то советы космического масштаба и космической же глупости о том, как всё поделить… А в то же время вы наглотались зубного порошку…"
                                            },
                                            {
                                                "example_id": "cfe091f6-b632-4701-a56a-035b88e6fc52",
                                                "sense_id": "f66b3be2-ef22-3d69-af3d-654d75e5d71e",
                                                "text": "Врач замолчал на полуслове, увидев улыбку на лице Осинского, и понял, что сказал глупость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a253f8-4666-32c9-b112-035b4928c1c4",
                                        "entry_id": "8828222a-0bf6-3007-a865-1c7931477171",
                                        "glosses": [
                                            "глупый, нелогичный поступок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185c9c31-c8d3-40b8-a72e-2bf86a5bccd6",
                                                "sense_id": "d0a253f8-4666-32c9-b112-035b4928c1c4",
                                                "text": "Недаром же она, не послушав добрых советов Ады Борисовны, сделала глупость — вышла замуж за грубого, без гроша матроса и тем огорчила её."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
