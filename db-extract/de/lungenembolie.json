                        "cross_references": [
                            {
                                "target_word": "pulmonary embolism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "696be1b4-ae10-3bff-b862-8ee4f6ba2635",
                                        "entry_id": "45f369f1-c5e6-3fe5-9adf-7ff7c0e0042c",
                                        "glosses": [
                                            "The embolism or obstruction of a pulmonary artery, usually by a detached blood clot from a leg or pelvic vein, which causes a stoppage of blood into the lungs; symptoms include shortness of breath, chest pain, fainting, and sometimes death."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea800085-0c72-4da5-abb8-862507a685b8",
                        "source_entry_id": "a61ec2df-cc3f-36b1-959b-17407d524b8b",
                        "source_sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                        "target_lang_word": "embolie pulmonaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embolie pulmonaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b9bed6d-cf6f-3119-8356-29ab87ba1ca0",
                                        "entry_id": "cb45ed81-3406-3e82-8bce-c9e6d7cc04e9",
                                        "glosses": [
                                            "Obstruction d’une artère pulmonaire ou de l'une de ses branches par un caillot sanguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3dcf737-43f0-457a-9319-0a0c2fdb1562",
                                                "sense_id": "8b9bed6d-cf6f-3119-8356-29ab87ba1ca0",
                                                "text": "— Diagnostic ?\n— Ce que vous pensiez ! fait-il. Embolie pulmonaire.\n— Pronostic ?\n— Vous ne l’ignorez pas.\nIl traverse le vestibule pour s’arrêter au milieu de la salle :\n— C’est la forme asphyxique, dit-il. Avertissez tout le monde."
                                            },
                                            {
                                                "example_id": "76f5632d-6733-43c8-baff-470315060bfd",
                                                "sense_id": "8b9bed6d-cf6f-3119-8356-29ab87ba1ca0",
                                                "text": "Une embolie pulmonaire est une obstruction par un caillot de sang de l’une des artères qui mènent aux poumons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
