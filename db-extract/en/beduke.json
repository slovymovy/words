                        "entry_id": "c6979b63-f788-3aee-940e-a955c563a08f",
                        "glosses": [
                            "To behave or dress as a duke."
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "be59d22a-dc27-44ff-9b7c-486977108231",
                                "sense_id": "64398086-9981-3126-8d3b-f61c932dd670",
                                "text": "Like a simple American citizen beduking himself in his lodge."
                            }
                        ]
                    }
