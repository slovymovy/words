                                    {
                                        "sense_id": "12871bbe-8a4f-356f-9db8-c1d71ff732ec",
                                        "entry_id": "89306dd1-826f-3335-94b1-fe72d45c7e0d",
                                        "glosses": [
                                            "Frimeur, vantard."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff6e2957-b270-4d60-aa27-584fc0e93cbf",
                                                "sense_id": "12871bbe-8a4f-356f-9db8-c1d71ff732ec",
                                                "text": "En voilà un crâneur ! disait-elle, ça a l’air de se croire le président de la République !"
                                            },
                                            {
                                                "example_id": "a5112d25-947f-48fb-b1eb-d12766f1402e",
                                                "sense_id": "12871bbe-8a4f-356f-9db8-c1d71ff732ec",
                                                "text": "En voyant Carmen, il enleva son chapeau gris ; ses cheveux, sous son chapeau, étaient gris et fins comme si on les avait tamisés à travers de la gaze. Ses sourcils gris et fournis lui donnaient un certain petit air crâneur."
                                            },
                                            {
                                                "example_id": "92eef4f7-ba57-4b5a-9a7d-f51aa4c5b8d1",
                                                "sense_id": "12871bbe-8a4f-356f-9db8-c1d71ff732ec",
                                                "text": "Laissons courir ce faux jeton, Bill… du moment que nous tenons ce crâneur de shérif…"
                                            }
                                        ]
                                    }
                                ]
