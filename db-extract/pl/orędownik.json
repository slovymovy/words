                                "target_senses": [
                                    {
                                        "sense_id": "3a364fb0-92ee-3adf-838a-dbace2f7b363",
                                        "entry_id": "7aad1504-3ca4-3f09-9e5f-c01822997b6b",
                                        "glosses": [
                                            "One who supports something; an advocate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187a7d72-962d-4504-88b3-975a556d6c25",
                                                "sense_id": "3a364fb0-92ee-3adf-838a-dbace2f7b363",
                                                "text": "Proponents of the race — notably Mayor Michael R. Bloomberg and Mary Wittenberg, director of the marathon — said the event would provide a needed morale boost, as well as an economic one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8225ac63-4561-39c3-8a71-748d046f43f4",
                                        "entry_id": "7aad1504-3ca4-3f09-9e5f-c01822997b6b",
                                        "glosses": [
                                            "One who makes a proposal or proposition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be540430-feb9-3f61-ad26-30752a818fd6",
                                        "entry_id": "7aad1504-3ca4-3f09-9e5f-c01822997b6b",
                                        "glosses": [
                                            "One who propounds a will for probate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "proponent",
