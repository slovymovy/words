                        ],
                        "examples": [
                            {
                                "example_id": "7961d368-5d64-4b73-8402-a038b32c5d06",
                                "sense_id": "1522166a-5fc0-3f18-861e-ccedc072631a",
                                "text": "Er zijn een paar lichtpunten: de waardering voor de publieke omroep blijft hoger dan die voor de commerci[ële], de zenderkleuring bij radio werpt af en toe zijn vruchten af, er worden regelmatig wonderschone programma's gemaakt, en niet onbelangrijk: de publieke omroep zit vol met goede en gedreven programmamakers."
                            },
                            {
                                "example_id": "5db8b496-cf36-465a-8f6c-01dff5fcb0b7",
                                "sense_id": "1522166a-5fc0-3f18-861e-ccedc072631a",
                                "text": "Door de zogeheten \"zenderkleuring\", die bepaalt dat op een zender vooral nieuws of amusement te zien moet zijn, worden ze teveel in een keurslijf gedwongen."
                            },
                            {
                                "example_id": "2e13133f-4a28-4a6d-bbe3-b17217b14ae0",
                                "sense_id": "1522166a-5fc0-3f18-861e-ccedc072631a",
                                "text": "Zapp, dat programma’s uitzendt voor kinderen van 8 tot 12 jaar, paste in 2008 de ‘zenderkleuring’ aan om een stoerder imago te creëren."
                            }
                        ]
                    }
