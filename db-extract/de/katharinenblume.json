                "senses": [
                    {
                        "sense_id": "5be392e5-ed0d-34aa-a7dd-9ef275821ff2",
                        "entry_id": "c8289cf5-c039-3023-9135-b6dd61fda4fa",
                        "glosses": [
                            "im späten November weiß-gelblich blühende Blume, die am Allerseelentag auf die Gräber der Verstorbenen gebracht wird (Volksname für das „gemeine Leinkraut“, wissenschaftlich: „Linaria vulgaris“)"
                        ],
                        "tags": [
                            "katholisches Brauchtum"
                        ],
                        "examples": [
                            {
                                "example_id": "218b6d3d-9294-4a46-9c97-4b8dff4cfffe",
                                "sense_id": "5be392e5-ed0d-34aa-a7dd-9ef275821ff2",
                                "text": "„Für das Echte Leinkraut sind oder waren, zum Teil nur regional, auch die Bezeichnungen […] Frauenflachs (Schlesien, Mark, Ostpreußen), … Katharinenblumen (Schlesien), Katharinenflachs (Sachsen), Katharinenkraut (Sachsen), […] Unser Frauen Flachs und Unser Frau Har gebräuchlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aebb7051-0f73-3f9b-ae9f-fc9993389899",
                        "entry_id": "c8289cf5-c039-3023-9135-b6dd61fda4fa",
                        "glosses": [
                            "Volksname für den Echten Schwarzkümmel, dessen Blüte dem Folterrad Katharinas ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae72de50-462a-4e3b-9e1b-a661c501dd19",
                                "sense_id": "aebb7051-0f73-3f9b-ae9f-fc9993389899",
                                "text": "„Fuchs […] gibt die hübsche Benennung St. Katharinenblume, weil die Blüthe einem Rade, dem Marterzeichen der heiligen Katharina, gleichen soll, […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "01450565-ca5a-3d57-95ce-a699c34fbb53",
                        "entry_id": "c8289cf5-c039-3023-9135-b6dd61fda4fa",
                        "glosses": [
                            "Volksname für die Herbstzeitlose (Colchicum autumnale)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eaa5c73-6468-485a-ba72-db42fcfd9059",
                                "sense_id": "01450565-ca5a-3d57-95ce-a699c34fbb53",
                                "text": "Im Rheinland wird die Herbstzeitlose auch Katharinenblume genannt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
