{
    "word_family": [
        "récusation",
        "récusable",
        "irrécusable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c08d8f75-17ae-3908-a663-a0ff2969cce9",
                    "sense_definition": "Rejeter la compétence, l'autorité ou la valeur de quelqu'un pour porter un jugement sur un sujet donné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a déclaré qu'il <w>récusait</w> la commission d'enquête car il doutait de sa neutralité."
                        },
                        {
                            "text": "Face aux critiques, le directeur <w>récuse</w> toute personne qui n'a pas lu le rapport complet."
                        }
                    ],
                    "synonyms": [
                        "rejeter",
                        "contester"
                    ],
                    "antonyms": [
                        "admettre",
                        "accepter"
                    ],
                    "common_phrases": [
                        "récuser la compétence",
                        "récuser l'autorité"
                    ]
                },
                {
                    "sense_id": "93b0daf6-a1e4-3454-9a5b-8963a86a5daf",
                    "sense_definition": "Rejeter une preuve, une affirmation ou un témoignage en refusant de lui accorder la moindre valeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre <w>récuse</w> formellement ces allégations sans fondement parues dans la presse."
                        },
                        {
                            "text": "Le chercheur <w>récusa</w> ces résultats scientifiques obtenus avec des méthodes douteuses."
                        }
                    ],
                    "synonyms": [
                        "nier",
                        "démentir",
                        "rejeter"
                    ],
                    "antonyms": [
                        "valider",
                        "reconnaître"
                    ],
                    "common_phrases": [
                        "récuser un témoignage",
                        "récuser des accusations"
                    ]
                },
                {
                    "sense_id": "711c76ff-5072-3649-afbe-eb9cfa860d06",
                    "sense_definition": "Refuser légalement qu'un juge, un juré ou un tribunal instruise une affaire, en raison d'un soupçon de partialité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense a immédiatement demandé à <w>récuser</w> un juré lié à la victime."
                        },
                        {
                            "text": "Ayant un lien de parenté avec le prévenu, le magistrat a décidé de se <w>récuser</w>."
                        }
                    ],
                    "synonyms": [
                        "contester"
                    ],
                    "common_phrases": [
                        "récuser un juge",
                        "récuser un juré",
                        "se récuser"
                    ]
                },
                {
                    "sense_id": "38ad2148-bef5-38f8-b9e8-4d4f8b1a3c19",
                    "sense_definition": "Opposer en justice une fin de non-recevoir contre un témoin ou un expert que l'on juge partial ou incompétent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La partie civile a choisi de <w>récuser</w> un témoin dont la crédibilité semblait compromise."
                        },
                        {
                            "text": "Le tribunal a examiné la requête visant à <w>récuser</w> un expert mandaté par l'entreprise."
                        }
                    ],
                    "common_phrases": [
                        "récuser un témoin",
                        "récuser un expert"
                    ]
                }
            ]
        }
    ]
}