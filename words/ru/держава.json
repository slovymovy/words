{
    "word_family": [
        "державный",
        "самодержавие",
        "державность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45452c2c-9c0c-3614-b9bc-63166e179aca",
                    "sense_definition": "Сильное, независимое государство, обладающее большим политическим влиянием и весом в мире.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Страна быстро превращалась в мощную индустриальную <w>державу</w>.",
                            "target_lang_translations": {
                                "en": "The country was quickly turning into a powerful industrial <w>power</w>.",
                                "tr": "Ülke hızla güçlü bir sanayi <w>gücüne</w> dönüşüyordu."
                            }
                        },
                        {
                            "text": "Каждая великая <w>держава</w> стремится укрепить свои позиции на международной арене.",
                            "target_lang_translations": {
                                "en": "Every great <w>power</w> seeks to strengthen its position on the international stage.",
                                "tr": "Her büyük <w>devlet</w> uluslararası arenadaki konumunu güçlendirmeye çalışır."
                            }
                        }
                    ],
                    "synonyms": [
                        "государство",
                        "страна"
                    ],
                    "common_phrases": [
                        "великая держава",
                        "ядерная держава",
                        "морская держава",
                        "мировая держава"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "высок."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A strong, independent state possessing great political influence and weight in the world.",
                        "tr": "Dünyada büyük siyasi nüfuza ve ağırlığa sahip, güçlü ve bağımsız devlet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "power",
                                "target_lang_sense_clarification": "a state with international influence"
                            },
                            {
                                "target_lang_word": "superpower",
                                "target_lang_sense_clarification": "an extremely powerful nation"
                            },
                            {
                                "target_lang_word": "empire",
                                "target_lang_sense_clarification": "a major political unit or large state"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güç",
                                "target_lang_sense_clarification": "uluslararası nüfuza sahip devlet"
                            },
                            {
                                "target_lang_word": "devlet",
                                "target_lang_sense_clarification": "büyük ve güçlü ülke"
                            },
                            {
                                "target_lang_word": "süper güç",
                                "target_lang_sense_clarification": "çok büyük siyasi ve askeri gücü olan devlet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "805376f4-3158-3550-a44c-28501978c243",
                    "sense_definition": "Золотой шар с крестом или короной, служащий символом монархической власти.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "royal_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во время церемонии император принял в руки скипетр и <w>державу</w>.",
                            "target_lang_translations": {
                                "en": "During the ceremony, the emperor took the scepter and <w>orb</w> in his hands.",
                                "tr": "Tören sırasında imparator asayı ve <w>hükümranlık küresini</w> eline aldı."
                            }
                        },
                        {
                            "text": "На гербе изображён двуглавый орёл, сжимающий в лапах скипетр и <w>державу</w>.",
                            "target_lang_translations": {
                                "en": "The coat of arms depicts a double-headed eagle clutching a scepter and <w>orb</w> in its talons.",
                                "tr": "Armada, pençelerinde asa ve <w>saltanat küresi</w> tutan çift başlı bir kartal tasvir edilmiştir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скипетр и держава",
                        "шапка Мономаха и держава"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "истор."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A golden sphere surmounted by a cross or crown, serving as a symbol of monarchical authority.",
                        "tr": "Monarşik iktidarın sembolü olan, üzerinde haç veya taç bulunan altın küre."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "orb",
                                "target_lang_sense_clarification": "royal regalia symbolizing power"
                            },
                            {
                                "target_lang_word": "globus cruciger",
                                "target_lang_sense_clarification": "technical term for the cross-bearing orb"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hükümranlık küresi",
                                "target_lang_sense_clarification": "monarşi sembolü olan haçlı altın küre"
                            },
                            {
                                "target_lang_word": "saltanat küresi",
                                "target_lang_sense_clarification": "hükümdarlık alameti olan küre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac695cfa-b514-33a2-9069-9cdcf0421814",
                    "sense_definition": "Власть, владычество или управление.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstract_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие земли были объединены под его единой <w>державой</w>.",
                            "target_lang_translations": {
                                "en": "Many lands were united under his single <w>dominion</w>.",
                                "tr": "Birçok toprak onun tek bir <w>egemenliği</w> altında birleştirildi."
                            }
                        },
                        {
                            "text": "Хоть был он парень бравый, но под его <w>державой</w> стал бунтовать народ.",
                            "target_lang_translations": {
                                "en": "Although he was a brave fellow, the people began to rebel under his <w>rule</w>.",
                                "tr": "Yiğit bir adam olmasına rağmen, onun <w>yönetimi</w> altında halk isyan etmeye başladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Authority, dominion, or governance.",
                        "tr": "İktidar, egemenlik veya yönetim."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dominion",
                                "target_lang_sense_clarification": "sovereignty or control"
                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "exercise of authority"
                            },
                            {
                                "target_lang_word": "realm",
                                "target_lang_sense_clarification": "poetic reference to a kingdom or domain"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "egemenlik",
                                "target_lang_sense_clarification": "yönetim yetkisi ve gücü"
                            },
                            {
                                "target_lang_word": "hükümranlık",
                                "target_lang_sense_clarification": "hükmetme gücü, otorite"
                            },
                            {
                                "target_lang_word": "iktidar",
                                "target_lang_sense_clarification": "yönetim gücü"
                            }
                        ]
                    }
                }
            ]
        }
    ]
