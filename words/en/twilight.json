{
    "word_family": [
        "twilit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                    "sense_definition": "The period of the day between daylight and darkness, usually occurring after sunset.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go for a walk along the beach at <w>twilight</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили прогуляться по пляжу в <w>сумерках</w>.",
                                "zh": "我们决定在<w>黄昏</w>时分去海滩散步。"
                            }
                        },
                        {
                            "text": "It was already <w>twilight</w> when they finally arrived at the remote cabin.",
                            "target_lang_translations": {
                                "ru": "Когда они наконец добрались до удаленной хижины, уже сгустились <w>сумерки</w>.",
                                "zh": "当他们最终到达那间偏僻的小屋时，天色已近<w>黄昏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dimmet",
                        "gloaming",
                        "crepuscule",
                        "blue hour",
                        "dusk",
                        "sundown"
                    ],
                    "common_phrases": [
                        "at twilight",
                        "twilight zone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время суток между дневным светом и темнотой, обычно наступающее после захода солнца.",
                        "zh": "日落后到天黑之间的一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумерки",
                                "target_lang_sense_clarification": "время суток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄昏",
                                "target_lang_sense_clarification": "指日落前后的一段时间"
                            },
                            {
                                "target_lang_word": "傍晚",
                                "target_lang_sense_clarification": "指临近夜晚的时候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                    "sense_definition": "The soft, diffused light from the sky seen when the sun is below the horizon.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could just make out the shape of the mountains in the fading <w>twilight</w>.",
                            "target_lang_translations": {
                                "ru": "Я едва мог разглядеть очертания гор в угасающем <w>сумраке</w>.",
                                "zh": "在逐渐消逝的<w>暮色</w>中，我勉强能辨认出山的轮廓。"
                            }
                        },
                        {
                            "text": "The painting captured the beautiful purple <w>twilight</w> over the city.",
                            "target_lang_translations": {
                                "ru": "Картина запечатлела прекрасные пурпурные <w>сумерки</w> над городом.",
                                "zh": "这幅画捕捉到了城市上空美丽的紫色<w>暮色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crepuscule",
                        "gloaming",
                        "crepusculum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, рассеянный свет с неба, видимый, когда солнце находится за горизонтом.",
                        "zh": "太阳在地平线以下时，天空中呈现的柔和、弥散的光线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумрак",
                                "target_lang_sense_clarification": "полутьма, качество света"
                            },
                            {
                                "target_lang_word": "полумрак",
                                "target_lang_sense_clarification": "слабое освещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暮色",
                                "target_lang_sense_clarification": "指黄昏时的光线或景色"
                            },
                            {
                                "target_lang_word": "微光",
                                "target_lang_sense_clarification": "指昏暗的光线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                    "sense_definition": "A final or declining stage of a period, career, or life, characterized by a gradual loss of strength or glory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote his most famous memoirs during the <w>twilight</w> of his life.",
                            "target_lang_translations": {
                                "ru": "Он написал свои самые известные мемуары на <w>закате</w> своей жизни.",
                                "zh": "他在<w>晚年</w>写下了他最著名的回忆录。"
                            }
                        },
                        {
                            "text": "The empire was in its <w>twilight</w> after centuries of dominance.",
                            "target_lang_translations": {
                                "ru": "Империя переживала свой <w>закат</w> после столетий господства.",
                                "zh": "在经历了几个世纪的统治后，这个帝国已处于<w>末期</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twilight years",
                        "twilight of one's life"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary or rhetorical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительный этап или стадия упадка периода, карьеры или жизни, характеризующаяся постепенной потерей силы или славы.",
                        "zh": "指事物、事业或生命走向终结或衰落的阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "метафорически: конец жизни или эпохи"
                            },
                            {
                                "target_lang_word": "сумерки",
                                "target_lang_sense_clarification": "состояние упадка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚年",
                                "target_lang_sense_clarification": "指人生的最后阶段"
                            },
                            {
                                "target_lang_word": "末期",
                                "target_lang_sense_clarification": "指事物发展的最后阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81688866-86b4-3777-91dd-4f9e828e0d3c",
                    "sense_definition": "Characterized by or resembling the faint light of dusk; dim or obscure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_desc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with a <w>twilight</w> gloom that made it hard to read.",
                            "target_lang_translations": {
                                "ru": "Комната была наполнена <w>сумеречным</w> мраком, из-за которого было трудно читать.",
                                "zh": "房间里充满了<w>昏暗</w>的阴影，让人难以阅读。"
                            }
                        },
                        {
                            "text": "They wandered through the <w>twilight</w> forest, looking for the path.",
                            "target_lang_translations": {
                                "ru": "Они бродили по <w>сумеречному</w> лесу в поисках тропинки.",
                                "zh": "他们在<w>昏暗</w>的森林中徘徊，寻找着小路。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся слабым светом, напоминающим сумерки; тусклый или смутный.",
                        "zh": "具有黄昏微光特征的；昏暗的或模糊的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумеречный",
                                "target_lang_sense_clarification": "тусклый, неясный"
                            },
                            {
                                "target_lang_word": "полутёмный",
                                "target_lang_sense_clarification": "слабо освещенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昏暗的",
                                "target_lang_sense_clarification": "形容光线不足"
                            },
                            {
                                "target_lang_word": "朦胧的",
                                "target_lang_sense_clarification": "形容光线柔和且模糊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "104ff8e6-acfb-30b4-87d6-00f4e7a0346f",
                    "sense_definition": "Relating to the layer of the ocean between the sunlit surface and the pitch-black depths, where very little light penetrates.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many strange bioluminescent creatures inhabit the <w>twilight</w> zone of the ocean.",
                            "target_lang_translations": {
                                "ru": "Многие странные биолюминесцентные существа обитают в <w>сумеречной</w> зоне океана.",
                                "zh": "许多奇异的生物发光体栖息在海洋的<w>中层带</w>。"
                            }
                        },
                        {
                            "text": "The submarine descended into the <w>twilight</w> waters where the sunlight barely reached.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка опустилась в <w>сумеречные</w> воды, куда едва проникал солнечный свет.",
                                "zh": "潜水艇下潜到了阳光几乎无法到达的<w>中层带</w>水域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mesopelagic"
                    ],
                    "common_phrases": [
                        "twilight zone"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "scientific/oceanography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к слою океана между освещенной солнцем поверхностью и черными глубинами, куда проникает очень мало света.",
                        "zh": "指海洋中位于透光层与深海黑暗层之间，光线极弱的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумеречный",
                                "target_lang_sense_clarification": "термин океанологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中层带",
                                "target_lang_sense_clarification": "海洋学中的微光层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22ed80fe-1198-374d-babd-9506e605e5c2",
                    "sense_definition": "To illuminate something with a faint, soft light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun <w>twilights</w> the valley in soft purple hues.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>окутывает сумерками</w> долину в мягких пурпурных тонах.",
                                "zh": "落日将山谷<w>笼罩</w>在柔和的紫色光晕中。"
                            }
                        },
                        {
                            "text": "A few candles <w>twilighted</w> the small room.",
                            "target_lang_translations": {
                                "ru": "Несколько свечей <w>озаряли полумраком</w> маленькую комнату.",
                                "zh": "几支蜡烛将小房间<w>映照</w>得朦朦胧胧。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещать что-либо слабым, мягким светом.",
                        "zh": "用微弱、柔和的光线照亮某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать сумерками",
                                "target_lang_sense_clarification": "поэтическое"
                            },
                            {
                                "target_lang_word": "озарять полумраком",
                                "target_lang_sense_clarification": "освещать тускло"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "指光线覆盖在物体上"
                            },
                            {
                                "target_lang_word": "映照",
                                "target_lang_sense_clarification": "指光线投射在物体上"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}