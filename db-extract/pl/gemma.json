                                "target_senses": [
                                    {
                                        "sense_id": "0df87cc0-2c78-39f1-b619-2007bf158ef3",
                                        "entry_id": "4c369dc7-338f-3583-b23e-a964e6df7175",
                                        "glosses": [
                                            "A female given name from Italian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d60e034-c96c-47a6-9636-d205b2137586",
                                                "sense_id": "0df87cc0-2c78-39f1-b619-2007bf158ef3",
                                                "text": "Gemma. A curious name. He didn't think he had ever come across it before. She would have an outlandish name, either because her equally eccentric parents had labelled her with it or—more likely—she had adopted it herself on the grounds of originality."
                                            },
                                            {
                                                "example_id": "b320b503-f937-4d5d-a142-dd27553a68ea",
                                                "sense_id": "0df87cc0-2c78-39f1-b619-2007bf158ef3",
                                                "text": "Gemma gave him another gushing smile. She wanted to make amends for almost fouling up Blake's deal. \"Gemma. What a beautiful name. You are indeed a jewel.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5adb5e-2583-3bc9-b83e-35386fe7e750",
                                        "entry_id": "4c369dc7-338f-3583-b23e-a964e6df7175",
                                        "glosses": [
                                            "A bright binary star in the constellation Corona Borealis; Alpha (α) Coronae Borealis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
