    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58d2d36d-a2c0-325b-83dc-50c6b361133d",
                    "sense_definition": "Een geconcentreerde oplossing van keukenzout in water, vaak gebruikt om voedsel te conserveren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zoutoplossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kaas moet minstens een dag in een bad van <w>pekel</w> liggen voor de smaak.",
                            "target_lang_translations": {
                                "en": "The cheese needs to sit in a bath of <w>brine</w> for at least a day for flavor."
                            }
                        },
                        {
                            "text": "Vroeger werd vis langdurig in sterke <w>pekel</w> bewaard zodat het niet bedierf.",
                            "target_lang_translations": {
                                "en": "In the past, fish was kept in strong <w>brine</w> for a long time so that it wouldn't spoil."
                            }
                        }
                    ],
                    "synonyms": [
                        "brijn"
                    ],
                    "target_lang_definitions": {
                        "en": "A concentrated solution of salt in water, often used to preserve food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brine",
                                "target_lang_sense_clarification": "saltwater solution for food preservation"
                            },
                            {
                                "target_lang_word": "pickle",
                                "target_lang_sense_clarification": "saline solution or preservative liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f1cc70-7d06-31cb-b54b-a084d3b5c19f",
                    "sense_definition": "Zoutoplossing of strooizout vermengd met water die over wegen wordt verspreid om gladheid door ijs of sneeuw te bestrijden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gladheidbestrijding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de winter moet je de auto goed wassen om alle aangekoekte <w>pekel</w> te verwijderen.",
                            "target_lang_translations": {
                                "en": "After winter, you need to wash the car thoroughly to remove all the caked-on <w>road salt</w>."
                            }
                        },
                        {
                            "text": "De strooiwagens reden de hele nacht rond om <w>pekel</w> op de snelweg te sproeien.",
                            "target_lang_translations": {
                                "en": "The salt trucks drove around all night to spray <w>brine</w> onto the highway."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Salt solution or road salt mixed with water spread on roads to combat slipperiness caused by ice or snow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "road salt",
                                "target_lang_sense_clarification": "salt or brine used on roads"
                            },
                            {
                                "target_lang_word": "brine",
                                "target_lang_sense_clarification": "liquid saltwater sprayed on roads"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
