                        ],
                        "examples": [
                            {
                                "example_id": "cad0ffde-5248-4e6c-8694-9eab300e415b",
                                "sense_id": "28f0cc69-3810-3079-9967-3db5fefb576f",
                                "text": "an amphibious vehicle"
                            },
                            {
                                "example_id": "b548fec3-fb82-43da-bb06-5aa37388574e",
                                "sense_id": "28f0cc69-3810-3079-9967-3db5fefb576f",
                                "text": "Most Dutch cities began on a terp or artificial mound to which the prehistoric amphibious folk rushed for refuge when floods rolled in."
                            }
                        ]
                    },
                    {
                        "sense_id": "9133980b-b259-3763-b653-0b545d8e3f6b",
                        "entry_id": "20e96413-71a9-3d89-9f8d-c5ee84be1ca2",
                        "glosses": [
                            "Occurring on both land and water."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
