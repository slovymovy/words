                "senses": [
                    {
                        "sense_id": "b4a46e21-0a60-31c5-9bbd-25e3324e6256",
                        "entry_id": "2b6da2db-5356-30c2-b1c7-b9ebd0a2292e",
                        "glosses": [
                            "Bus, der Strecken auch außerhalb von Städten bedient"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "657f784e-d2cf-4238-97dc-d98bf7a44e63",
                                "sense_id": "b4a46e21-0a60-31c5-9bbd-25e3324e6256",
                                "text": "„In Moshi, dem Zweihunderttausend-Seelen-Ort, finde ich einen Überlandbus, der, so hoffe ich, bis Dar es Salaam fährt.“"
                            },
                            {
                                "example_id": "48093610-bd34-4ad9-9017-6b04179d64fb",
                                "sense_id": "b4a46e21-0a60-31c5-9bbd-25e3324e6256",
                                "text": "„Aber in Überlandbussen kriegte ich immer Verstopfung, und es saß unweigerlich irgendein alter Union Jack drin, der einen ranzigen Bart hatte und schnarchte.“"
                            },
                            {
                                "example_id": "f08666a6-7096-4a27-948a-b0f26609c76b",
                                "sense_id": "b4a46e21-0a60-31c5-9bbd-25e3324e6256",
                                "text": "„Ein paar Tage später nimmt sie den Überlandbus nach Hólmavík.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
