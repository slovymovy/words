{
    "word_family": [
        "snobbery",
        "snobbish",
        "snobbishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                    "sense_definition": "A person who believes they are superior to others because of their social status or refined tastes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>snob</w> that he refuses to talk to anyone who does not own a luxury car."
                        },
                        {
                            "text": "She acts like a total <w>snob</w> whenever we discuss art or classical music."
                        }
                    ],
                    "common_phrases": [
                        "elitist snob",
                        "total snob"
                    ]
                },
                {
                    "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                    "sense_definition": "A person belonging to the lower social classes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, the wealthy often referred to the common working man as a <w>snob</w>."
                        },
                        {
                            "text": "The aristocrat looked down upon the <w>snob</w> as if he were invisible."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a historical context to refer to commoners."
                        }
                    ]
                },
                {
                    "sense_id": "c69bae15-4eed-37d2-9ce7-ca2c97f35f0b",
                    "sense_definition": "A person who repairs or makes shoes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>snob</w> repaired the worn heels of my leather boots."
                        },
                        {
                            "text": "He worked as a <w>snob</w> in the village for over forty years."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "An old-fashioned term for a shoemaker."
                        }
                    ]
                },
                {
                    "sense_id": "9aa8097f-d9cf-34d3-8e9c-5e103f1f0633",
                    "sense_definition": "A worker who refuses to join a strike or works for lower wages than others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "labor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striking workers were angry at the <w>snob</w> who crossed the picket line."
                        },
                        {
                            "text": "He was labeled a <w>snob</w> by his colleagues for accepting the lower pay rate."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical labor slang."
                        }
                    ]
                },
                {
                    "sense_id": "6805bded-0970-3ff6-b509-7052dc3bf768",
                    "sense_definition": "A person who is not a university student, specifically in a university town.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tension between the student and the local <w>snob</w> was common in the town."
                        },
                        {
                            "text": "The university rules often distinguished between the gownsman and the <w>snob</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical academic slang."
                        }
                    ]
                }
            ]
        }
    ]
}