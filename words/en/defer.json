    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1d2a354-c1d4-3db8-b5a5-dd28186e8a90",
                    "sense_definition": "To put off an action or event to a later time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>defer</w> the final decision until we have more information."
                        },
                        {
                            "text": "The company had to <w>defer</w> the project launch due to unexpected budget cuts."
                        }
                    ],
                    "common_phrases": [
                        "defer a decision",
                        "defer payment"
                    ]
                },
                {
                    "sense_id": "e74bc164-0406-3fec-8551-57e900bf0009",
                    "sense_definition": "To accept or follow the opinion or authority of someone else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>defer</w> to your expertise since you have more experience in this field."
                        },
                        {
                            "text": "The committee chose to <w>defer</w> to the chairperson regarding the final policy changes."
                        }
                    ],
                    "synonyms": [
                        "submit"
                    ],
                    "common_phrases": [
                        "defer to judgment",
                        "defer to authority"
                    ]
                }
            ]
        }
    ]
