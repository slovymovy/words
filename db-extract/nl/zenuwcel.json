                    {
                        "sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "glosses": [
                            "een zeer belangrijke cel in het zenuwstelsel die prikkels en impulsen opvangt, geleidt en doorgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b496c0-4a7e-49b3-8656-241470945938",
                                "sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                                "text": "In de hersenen zitten zo'n 100 miljard zenuwcellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "061186d2-b40d-4696-8b94-4823fae65cd4",
                        "source_entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "source_sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "source_sense_description": "een zeer belangrijke cel in het zenuwstelsel",
                        "target_lang_word": "Nervenzelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nervenzelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53740d3f-cb6c-3556-bfd8-48f71c02e5c1",
                                        "entry_id": "1c441fc9-079f-3a05-aa94-40d839560a88",
                                        "glosses": [
                                            "Zelle, die Erregungen weiterleitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "479d7429-3df2-4978-8981-440d979710e4",
                                                "sense_id": "53740d3f-cb6c-3556-bfd8-48f71c02e5c1",
                                                "text": "Die meisten Nervenzellen befinden sich im Gehirn und im Rückenmark."
                                            },
                                            {
                                                "example_id": "dd61da8b-eb65-419a-8ace-c3fdab5b7860",
                                                "sense_id": "53740d3f-cb6c-3556-bfd8-48f71c02e5c1",
                                                "text": "„Jede neue Erfahrung verknüpft auch die Nervenzellen immer wieder neu miteinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d559452-06a9-4b5b-ae21-cecbb350e3bf",
                        "source_entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "source_sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "source_sense_description": "een zeer belangrijke cel in het zenuwstelsel",
                        "target_lang_word": "Neuron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95a4ebb9-07bf-3913-ad09-2b56fbffe635",
                                        "entry_id": "14a989f3-bc11-3c5f-8dd7-0b39d68e88f2",
                                        "glosses": [
                                            "elementarer Bestandteil, einzelne Zelle innerhalb des zentralen Nervensystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54278a7b-4fe9-48a5-be76-d2a929f52da6",
                                                "sense_id": "95a4ebb9-07bf-3913-ad09-2b56fbffe635",
                                                "text": "Das Neuron bei Säugetieren ist auf die Aufnahme und Verarbeitung von Signalen spezialisiert."
                                            },
                                            {
                                                "example_id": "4621cf73-4221-425b-ba2e-cfe66adc62d8",
                                                "sense_id": "95a4ebb9-07bf-3913-ad09-2b56fbffe635",
                                                "text": "„Jedes Lebewesen, das mehr als hundert Neuronen besitzt, möchte frei sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce379b9c-650b-332a-bc38-877cb1818afc",
                                        "entry_id": "14a989f3-bc11-3c5f-8dd7-0b39d68e88f2",
                                        "glosses": [
                                            "Element eines künstlichen neuronalen Netzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1357497e-00e4-4455-afca-ced5bb4244a8",
                                                "sense_id": "ce379b9c-650b-332a-bc38-877cb1818afc",
                                                "text": "Jeder kleinsten Aussage wird ein Neuron zugeordnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28644792-8e20-46b0-a16e-0d35d305e298",
                        "source_entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "source_sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "source_sense_description": "een zeer belangrijke cel in het zenuwstelsel",
                        "target_lang_word": "neuron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neuron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "678c75a6-ea5e-3e9c-a29e-258653fc1dd5",
                                        "entry_id": "c7a34fb5-6123-3bd6-8d53-96f89648b3d7",
                                        "glosses": [
                                            "A cell of the nervous system, which conducts nerve impulses; consisting of an axon and several dendrites. Neurons are connected by synapses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f83adbd-8587-4816-a03a-2e4dedaee1e4",
                                                "sense_id": "678c75a6-ea5e-3e9c-a29e-258653fc1dd5",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4925b5c-e114-3ae3-8714-65b4cec7059e",
                                        "entry_id": "c7a34fb5-6123-3bd6-8d53-96f89648b3d7",
                                        "glosses": [
                                            "A nervure of an insect's wing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abe13480-64d2-3f1a-bdbe-41fde7da3041",
                                        "entry_id": "c7a34fb5-6123-3bd6-8d53-96f89648b3d7",
                                        "glosses": [
                                            "A mathematical function serving as an essential unit of an artificial neural network."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48d19112-8d12-4d0d-8f90-df4feafad54b",
                        "source_entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "source_sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "source_sense_description": "een zeer belangrijke cel in het zenuwstelsel",
                        "target_lang_word": "nerve cell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerve cell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c112709d-229b-3343-b067-4bf7a1a6c063",
                                        "entry_id": "3d9db043-cd04-33d4-90fc-3afbd1e7a083",
                                        "glosses": [
                                            "A cell of the nervous system which conducts nerve impulses; a neuron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c16db8-25d5-45a8-b86d-8cdfc1718de2",
                                                "sense_id": "c112709d-229b-3343-b067-4bf7a1a6c063",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "899b1e27-e7d7-4ecb-8680-9763a18176e2",
                        "source_entry_id": "ce09f066-3437-31c1-be9d-9644533b1d7e",
                        "source_sense_id": "d7852edf-3f62-37f9-a48c-a0118bbfd7a8",
                        "source_sense_description": "een zeer belangrijke cel in het zenuwstelsel",
                        "target_lang_word": "neurone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de7e0ade-f1d4-30c3-be41-bc69bf9418ef",
                                        "entry_id": "64e0f4c8-f1e4-32ae-9dbd-30fe7b7723a3",
                                        "glosses": [
                                            "Type de cellule différenciée composant, avec les cellules gliales, le tissu nerveux. Ces cellules sont excitables et excitatrices, et elles conduisent l’influx nerveux. Le neurone possède un axone et des dendrites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9955163b-f999-4c87-9495-14a0838b81be",
                                                "sense_id": "de7e0ade-f1d4-30c3-be41-bc69bf9418ef",
                                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l'axone."
                                            },
                                            {
                                                "example_id": "5b46ff89-07f0-4f57-879a-6e5451e848ef",
                                                "sense_id": "de7e0ade-f1d4-30c3-be41-bc69bf9418ef",
                                                "text": "Mais surtout, on a appris qu’en détruisant certains neurones dans le cerveau, on peut modifier définitivement les pensées d’un homme."
                                            },
                                            {
                                                "example_id": "d0c762f1-0cf5-410e-9630-5c1cd3501fcb",
                                                "sense_id": "de7e0ade-f1d4-30c3-be41-bc69bf9418ef",
                                                "text": "Soupçonnés sur la coexistence d'une production astrocytaire et sur l'existence de récepteurs fonctionnels sur les neurones adjacents, les effets neurologiques autocrines et paracrines de l'Epo produite au niveau cérébral apparaissent indépendants de la production systémique endocrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4f95a7-5c46-3e89-9041-297d7f22fbdc",
                                        "entry_id": "64e0f4c8-f1e4-32ae-9dbd-30fe7b7723a3",
                                        "glosses": [
                                            "Cerveau."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ad47535-532b-4280-8f4b-5ce992c9a79e",
                                                "sense_id": "4c4f95a7-5c46-3e89-9041-297d7f22fbdc",
                                                "text": "Ça lui semble fou que les gens ne comprennent pas, qu’ils insistent. Qu’il n’y en ait pas un doté du tout petit neurone suffisant pour se dire que peut-être que cette femme qui ne boit pas de vin à table mène une guerre secrète et sans relâche contre la maladie de l’alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
