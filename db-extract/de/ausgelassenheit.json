                        "target_lang_word": "exubérance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exubérance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e919b98-9bfc-3130-9724-b3237be2cdb9",
                                        "entry_id": "ad8a45d6-eb69-3106-a9be-58164539bbfe",
                                        "glosses": [
                                            "Production excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608636f3-8bfe-4c79-a61e-e53949a389ad",
                                                "sense_id": "3e919b98-9bfc-3130-9724-b3237be2cdb9",
                                                "text": "L'exploitation des registres paroissiaux de Jerez de la Frontera, ville espagnole située en Andalousie près du port de Cadix, démontre notamment l’exubérance de la vie sous l'Ancien Régime, mais aussi l'omniprésence de la mort."
                                            },
                                            {
                                                "example_id": "9a45cd65-f445-4206-b683-a4b3084d4560",
                                                "sense_id": "3e919b98-9bfc-3130-9724-b3237be2cdb9",
                                                "text": "Exubérance de végétation."
                                            },
                                            {
                                                "example_id": "86bd7fe2-f97d-4cc8-911f-4e2fc50f7d43",
                                                "sense_id": "3e919b98-9bfc-3130-9724-b3237be2cdb9",
                                                "text": "Exubérance de mots, d’images, d’idées."
                                            },
                                            {
                                                "example_id": "8948275c-2c8f-41ff-8c9c-13b7ff155041",
                                                "sense_id": "3e919b98-9bfc-3130-9724-b3237be2cdb9",
                                                "text": "Peut-être eût-on pu lui reprocher une exubérance de gestes qui n'était pas du meilleur goût, il avait une façon de se camper qui sentait son matamore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83394d29-fd57-3c11-be5b-86d184b66fa2",
                                        "entry_id": "ad8a45d6-eb69-3106-a9be-58164539bbfe",
                                        "glosses": [
                                            "Tempérament excessif, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff82f7a-682e-4c7e-af4e-04b799f34a77",
                                                "sense_id": "83394d29-fd57-3c11-be5b-86d184b66fa2",
                                                "text": "Cet homme est fatigant par son exubérance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
