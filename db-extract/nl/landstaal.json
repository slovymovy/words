                        "entry_id": "b9405ed1-42ba-3dcf-986a-6aa6d19798b9",
                        "glosses": [
                            "de taal van het land zelf, de voertaal, de volkstaal, het hoeft dus niet de officiële taal te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e7e21f-dc33-49f5-bfff-e12bd547d454",
                                "sense_id": "2d1f5748-0f93-3a09-be98-4a55af590b60",
                                "text": "Engels is in Ghana de officiële taal terwijl in grote delen Twi de landstaal is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f6e7b6e-91b2-41f8-a251-9ba2d3cdf97d",
                        "source_entry_id": "b9405ed1-42ba-3dcf-986a-6aa6d19798b9",
                        "source_sense_id": "2d1f5748-0f93-3a09-be98-4a55af590b60",
                        "target_lang_word": "Landessprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landessprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                        "entry_id": "d251fbd0-f934-313b-a805-d6972cb3c1a1",
                                        "glosses": [
                                            "diejenige Sprache, die in einem Land oder wenigstens in einer Region überwiegend gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81428c0b-3c84-4763-b612-db9db6de4efe",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "In der Schweiz gibt es vier Landessprachen."
                                            },
                                            {
                                                "example_id": "8a3f2b98-3fd5-4b38-954b-c54fb23d0f0c",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "Wenn man in einem Land lebt, muss man auch die Landessprache beherrschen."
                                            },
                                            {
                                                "example_id": "33503dfb-75fd-48c0-9464-727ba8f60ffe",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "Die Landessprache Deutsch ist in Deutschland zugleich die Amtssprache."
                                            },
                                            {
                                                "example_id": "5f3c17c3-10e9-43e7-9194-0370f0e86661",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "„Sondern wir diskutieren auch darüber, ob Anglizismen verboten werden sollen, ob Deutsch als Landessprache in die Verfassung aufgenommen werden muss und ob im Radio eine Mindestquote für deutsches Liedgut festzuschreiben ist."
                                            },
                                            {
                                                "example_id": "30736012-7bfc-4b63-a507-c2cacdf91a7a",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "„Das Verhältnis zwischen den Landessprachen in der Schweiz beschäftigte den 1904 gegründeten Verein in den Anfangsjahren sehr stark.“"
                                            },
                                            {
                                                "example_id": "6ee3398a-f843-44d1-bedb-42214c786de6",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "„Es lag darum nahe, sie zum Schreiben der Landessprachen beizubehalten…“"
                                            },
                                            {
                                                "example_id": "8a0bb257-064a-4c6a-bdd4-5440511da309",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "„Je nach Beruf und anderen Faktoren wurden die Landessprachen in unterschiedlichem Grade beherrscht.“"
                                            },
                                            {
                                                "example_id": "69296416-78e2-4493-b8b3-68fb7c2f3490",
                                                "sense_id": "7f9556bc-f664-3219-b54c-1257c521e643",
                                                "text": "„Sehr rasch wurde nun im deutschsprachigen Gebiete und westlich davon das Jiddisch zugunsten der Landessprachen preisgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
