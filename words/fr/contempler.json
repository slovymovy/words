                {
                    "sense_id": "c0ff246b-46ea-30b3-ab3e-20d456147621",
                    "sense_definition": "Examiner ou considérer attentivement par la pensée, méditer sur un projet ou une idée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Retiré à la campagne, le vieux savant <w>contemplait</w> en esprit les grandes questions de l'existence.",
                            "target_lang_translations": {
                                "en": "Retired in the countryside, the old scholar <w>contemplated</w> the great questions of existence in his mind.",
                                "ru": "Удалившись от дел и поселившись в деревне, старый учёный мысленно <w>обдумывал</w> великие вопросы существования.",
                                "nl": "Teruggetrokken op het platteland <w>overdacht</w> de oude geleerde in gedachten de grote vragen van het bestaan.",
                                "de": "Auf dem Land zurückgezogen <w>überdachte</w> der alte Gelehrte in Gedanken die großen Fragen des Daseins.",
                                "pl": "Osiadły na wsi, stary uczony w myślach <w>rozważał</w> wielkie pytania o istnienie.",
                                "it": "Ritiratosi in campagna, il vecchio studioso <w>meditava</w> tra sé sulle grandi questioni dell'esistenza.",
                                "cs": "Na venkově, kam se odebral do ústraní, starý učenec v duchu <w>rozjímal</w> o velkých otázkách existence.",
                                "tr": "Kırsala çekilen yaşlı bilgin, varoluşun büyük sorularını zihninde <w>düşünüyordu</w>.",
                                "es": "Retirado en el campo, el viejo sabio <w>meditaba</w> en su mente las grandes cuestiones de la existencia.",
                                "zh": "老学者隐居乡间，默默<w>思索</w>着人生的重大问题。"
                            }
                        },
                        {
                            "text": "Assis dans son bureau, il <w>contemple</w> l'avenir de son entreprise avec un certain optimisme.",
                            "target_lang_translations": {
                                "en": "Sitting at his desk, he <w>contemplates</w> the future of his company with a certain optimism.",
                                "ru": "Сидя в своём кабинете, он с некоторым оптимизмом <w>обдумывает</w> будущее своей компании.",
                                "nl": "Zittend aan zijn bureau <w>overdenkt</w> hij de toekomst van zijn bedrijf met enig optimisme.",
                                "de": "Am Schreibtisch sitzend <w>überdenkt</w> er die Zukunft seines Unternehmens mit einem gewissen Optimismus.",
                                "pl": "Siedząc za biurkiem, z pewnym optymizmem <w>rozważa</w> przyszłość swojej firmy.",
                                "it": "Seduto alla scrivania, <w>considera</w> il futuro della sua azienda con un certo ottimismo.",
                                "cs": "Sedí u svého psacího stolu a s jistým optimismem <w>uvažuje</w> o budoucnosti své firmy.",
                                "tr": "Masasında oturup şirketinin geleceğini biraz iyimserlikle <w>düşünüyor</w>.",
                                "es": "Sentado en su despacho, <w>considera</w> el futuro de su empresa con cierto optimismo.",
                                "zh": "他坐在办公桌前，以几分乐观的心情<w>思索</w>公司的未来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "envisager",
                        "méditer",
                        "songer"
                    ],
                    "common_phrases": [
                        "contempler l'avenir",
                        "contempler une possibilité"
                    ],
                    "target_lang_definitions": {
                        "en": "To consider or examine carefully in the mind, reflecting on a plan or idea.",
                        "ru": "Внимательно рассматривать что-либо мысленно, обдумывать план или идею.",
                        "nl": "Iets zorgvuldig in gedachten overwegen, bijvoorbeeld een plan of idee.",
                        "de": "Etwas in Gedanken prüfen und abwägen, etwa einen Plan oder eine Idee.",
                        "pl": "Dokładnie rozważać coś w myślach, na przykład plan lub ideę.",
                        "it": "Esaminare o considerare attentamente con la mente, riflettendo su un progetto o un'idea.",
                        "cs": "Mentálně zvažovat a důkladně promýšlet plán nebo myšlenku.",
                        "tr": "Bir plan veya fikri zihninde dikkatle ele alıp üzerinde düşünmek.",
                        "es": "Considerar o examinar algo detenidamente en la mente, reflexionando sobre un proyecto o una idea.",
                        "zh": "在脑海中仔细考虑或审视某个计划或想法，反复思量。"
                    },
