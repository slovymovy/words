                    {
                        "sense_id": "37f70433-f5a6-31fa-9493-b318b701a74e",
                        "entry_id": "157c9e14-a525-3314-9e9e-8827c8ca91de",
                        "glosses": [
                            "frühere Bezeichnung für ein schnelles Segelschiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a8e3d9-2cf1-48fe-ae1e-dc758bc68710",
                                "sense_id": "37f70433-f5a6-31fa-9493-b318b701a74e",
                                "text": "„Denn damals, zur großen Zeit der schnellen Klipper, heuerten zwar viele angebliche Seeleute in den Häfen der US-Ostküste bereitwillig für eine Passage nach Kalifornien an, verschwanden dort aber auf Nimmerwiedersehen zu den Goldfeldern, so daß die Kapitäne große Schwierigkeiten hatten, Männer für die Rückreise zur Ostküste zu finden .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "535c27f3-3923-31a7-8dd7-b3a4dbf14333",
                        "entry_id": "157c9e14-a525-3314-9e9e-8827c8ca91de",
                        "glosses": [
                            "veraltend: großes Flugzeug"
                        ],
                        "tags": [],
