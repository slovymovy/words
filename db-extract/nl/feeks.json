                    }
                ],
                "translations": [
                    {
                        "translation_id": "690ac42d-392b-406e-a48c-deae2fd7fb5b",
                        "source_entry_id": "e11bc876-d15d-35e5-b286-bad420865b7d",
                        "source_sense_id": "33384337-5581-3118-8a8a-4b815b48f002",
                        "target_lang_word": "Hexe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0f50f30-839f-355b-9fb8-1cbe7c4396e9",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "weibliches, bösgesinntes und dämonisches Märchen- oder Sagenwesen zumeist in Gestalt einer hässlichen, zauberkräftigen Greisin mit einem Buckel und einer langen, krummen Nase, die Schadenszauber auf den Menschen ausüben kann und mit dem Teufel durch einen Pakt oder Buhlschaft verbündet ist"
                                        ],
                                        "tags": [
                                            "Volksglauben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7964453d-31bb-41ae-bebb-1957ecfa5240",
                                                "sense_id": "d0f50f30-839f-355b-9fb8-1cbe7c4396e9",
                                                "text": "übertragen: „Maika ist eine Hexe.“"
                                            },
                                            {
                                                "example_id": "7a9bb7ec-9d92-4c0a-9877-febbc9d6b5fb",
                                                "sense_id": "d0f50f30-839f-355b-9fb8-1cbe7c4396e9",
                                                "text": "„Hexen waren angeblich Giftmischerinnen, verübten Schadenszauber und geisterten übers Land.“"
                                            },
                                            {
                                                "example_id": "f6dfcbf1-985e-4420-ba5c-a19e3f54e4b9",
                                                "sense_id": "d0f50f30-839f-355b-9fb8-1cbe7c4396e9",
                                                "text": "„Glaubst du, fragte sie, daß Hänsel und Gretel zusammengeblieben sind, nachdem sie die Hexe verbrannt haben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "343489bf-6a14-31eb-840c-7cee2b9fa061",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "(weibliche) Person, die angeblich Zauberkräfte besitzen und mit dem Teufel verbündet sein soll"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e6da27-6457-44fb-8804-ad1c04fc673d",
                                                "sense_id": "343489bf-6a14-31eb-840c-7cee2b9fa061",
                                                "text": "„Sämtliche Salemer Hexen waren unschuldige Opfer der allgemeinen Angst.“"
                                            },
                                            {
                                                "example_id": "9fea01da-2276-48b8-8714-4b94d63de192",
                                                "sense_id": "343489bf-6a14-31eb-840c-7cee2b9fa061",
                                                "text": "„Ich denke mir, daß dort eine barmherzige Frau als Hexe verbrannt würde, eine Frau, die es nicht für Geld und nicht aus Leidenschaft für den Mann tut, nur aus Barmherzigkeit mit der männlichen Natur.“"
                                            },
                                            {
                                                "example_id": "d00798c1-cf0f-46a5-adb4-cb95ca7b9ac7",
                                                "sense_id": "343489bf-6a14-31eb-840c-7cee2b9fa061",
                                                "text": "„Zwei von ihnen sind Urururururururururururururgroßneffen einer Hexe.“"
                                            },
                                            {
                                                "example_id": "88fcb43b-512d-4282-b7d3-fd643cb25c3c",
                                                "sense_id": "343489bf-6a14-31eb-840c-7cee2b9fa061",
                                                "text": "„Bei diesen Worten begriff ich sogleich, daß ich bei einer Hexe war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "547c6814-b86d-344b-9a91-d66aade137c8",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "Anhänger einer neopaganen Religion oder Tradition; Anhänger des Hexentums"
                                        ],
                                        "tags": [
                                            "geschlechtsneutrale Bezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eba06690-6af3-4ddb-8eb5-6a0e7fca4bf1",
                                                "sense_id": "547c6814-b86d-344b-9a91-d66aade137c8",
                                                "text": "„Von Vulkangestein gesäumt wie von Skulpturen eines Heidenkults. Annelie Franz? Wieso hatte sie das nicht sofort durchschaut? So blind darf man nicht sein! Wo man einen Schuß Esoterik brauchte, trat die doch unverblümt als Hexe auf.“"
                                            },
                                            {
                                                "example_id": "b9171e49-13de-4b75-8906-b02642d55374",
                                                "sense_id": "547c6814-b86d-344b-9a91-d66aade137c8",
                                                "text": "„Die Gesamtzahl aller Hexen und Anhänger anderer neuheidnischer Bewegungen liegt seiner Einschätzung nach bei mehreren Zehntausend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "(betagte) weibliche Person, die als bösartig, zänkisch, unangenehm (und hässlich) empfunden wird"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b57e6e8-9029-46de-a19e-ae706ae2efe1",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Tatsache nun aber ist, daß wirklich Volk immer Volk bleibt, wenigstens in einer bestimmten Schicht seines Wesens, eben der archaischen, und daß Leute und Nachbarn vom Kleinen Gelbgießer-Gang, die am Wahltage einen sozialdemokratischen Stimmzettel abgaben, gleichzeitig imstande waren, in der Armut eines Mütterchens, das sich keine oberirdische Wohnung leisten konnte, etwas Dämonisches zu sehen, und bei ihrer Annäherung nach ihren Kindern zu greifen, um sie vor dem bösen Blick der Hexe zu schützen.“"
                                            },
                                            {
                                                "example_id": "f3e87c02-270e-42c3-9f41-6da0699a4229",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "Was will denn die alte Hexe schon wieder von uns?"
                                            },
                                            {
                                                "example_id": "7ec073ca-001d-4319-aaa3-0d7b3ff1fd89",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Aber Hanns-Martin, laß dich doch nicht von der alten Hexe ins Boxhorn jagen!“"
                                            },
                                            {
                                                "example_id": "59fcc6b4-ee42-4402-9073-222a79422662",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Die Geschichte der Ilse Koch, der ‚rothaarigen, grünäugigen Hexe von Buchenwald‘ rauscht durch die Weltpresse.“"
                                            },
                                            {
                                                "example_id": "4366fe41-dffd-4698-be5f-ae88b1581580",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„»Du siehst aus wie eine Hexe«, sage ich. »Eine junge und gefährliche Hexe!«“"
                                            },
                                            {
                                                "example_id": "ab235eaa-673c-4e0f-9656-9cc4a23ffdae",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Die Frau Bürgermeisterin wurde als mannstolle Hexe verschrien und ich als verführter Satansbraten.“"
                                            },
                                            {
                                                "example_id": "a4e4d986-4bf2-47ac-b525-d51e32468b71",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Von mir aus kann sie verrecken, die alte Hexe!“"
                                            },
                                            {
                                                "example_id": "5820b488-9be9-48a0-b6ee-398cb39bc7d3",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Meistens führt sie den Beweis so, daß sie hinter einer Boshaftigkeit, die sie einem gerade an den Kopf geworfen hat, herlacht, im Lachen plötzlich in eine alles zerreißende Traurigkeit versackt und aus der heraus tonlos mitteilt, wieviel schöner es wäre, wenn man ihr einmal Gelegenheit gäbe, lieb zu sein, anstatt sie andauernd zu zwingen, die ruppige Hexe zu spielen.“"
                                            },
                                            {
                                                "example_id": "31b16052-08b8-4ed6-87d3-af5c367bc2a4",
                                                "sense_id": "55fc2b8e-564c-3dd7-9374-c76af3c22e56",
                                                "text": "„Sie hat es sich verkniffen, dieser alten Hexe ihre Frauenfeindlichkeit und ihre Moralpredigt um die Ohren zu hauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "82fca9da-2f80-3e4f-8940-7ceea1687e9b",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "weibliche Person, die betörend, verführerisch auf jemanden wirkt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00992b15-42b1-4cfd-8906-3ccf5f4131fe",
                                                "sense_id": "82fca9da-2f80-3e4f-8940-7ceea1687e9b",
                                                "text": "„Wir waren die besten Freunde – jung und hitzig – war schließlich ein Kerl, meine Herren, vor fünfundvierzig Jahren – und sie, die Klara, ich sehe sie immer noch, wie sie mir durchs Dunkel der Peterschen Scheune entgegenleuchtete oder mit nackten Füßen im Konradsweilerwald durch Moos und Laub ging, mit wehenden roten Haaren, biegsam, gertenschlank, zart, eine verteufelt schöne Hexe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f48e5f4f-a6aa-3b29-bef3-faad283f6d39",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "geliebte, weibliche Person; weibliche Person, mit der jemand (außerhalb der Ehe) eine sexuelle Beziehung hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e84d341-5735-4d77-9e8f-5f53d6ef8370",
                                                "sense_id": "f48e5f4f-a6aa-3b29-bef3-faad283f6d39",
                                                "text": "„‚Meine kleine Hexe‘, flüsterte ich.",
                                                "translation": "‚Der Kosename gefällt mir nicht‘, meinte sie schmollend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c28e4761-d101-3a70-99bc-0adf8623d46e",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "kleines Mädchen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd4a3601-b1fd-436b-a41d-a4b77d93a4af",
                                                "sense_id": "c28e4761-d101-3a70-99bc-0adf8623d46e",
                                                "text": "„‚[…] Die Ärzte können ihr nicht helfen. Man muss abwarten. Was ist, wenn meine kleine Hexe …?‘ Der angstvolle Blick des Vaters ließ Melanie das Blut in den Adern stocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "1ced4aa0-4266-3dbf-8b3c-1e276d05c8c9",
                                        "entry_id": "265991a6-dbe0-34e0-91fc-2d002727045d",
                                        "glosses": [
                                            "für Baumaterialien bestimmter Aufzug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b953d7d-49a5-4098-ac11-176207ac0fec",
                                                "sense_id": "1ced4aa0-4266-3dbf-8b3c-1e276d05c8c9",
                                                "text": "„In Schönerlinde wurden die Betonfertigbauteile mit der Hexe, in Buch mit einem kleinen Auslegerkran und Handwinde hochgezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2fb4a24-70c6-4dd6-b6e1-967f4dddc72e",
                        "source_entry_id": "e11bc876-d15d-35e5-b286-bad420865b7d",
                        "source_sense_id": "33384337-5581-3118-8a8a-4b815b48f002",
                        "target_lang_word": "shrew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e85e4754-6457-3c64-946d-51d2e239ba29",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Any of numerous small, mouselike, chiefly nocturnal, mammals of the family Soricidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fb9dfc9-90c6-3217-88f4-d7aa1c80ba09",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "Certain other small mammals that resemble true shrews."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                        "entry_id": "ec31b70f-2762-3aa0-a7b3-78f007c5e5b1",
                                        "glosses": [
                                            "An ill-tempered, nagging woman: a scold."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f1381c-8562-42aa-bff1-e960e3f0b999",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "The clerk had, I'm afraid, a shrew of a wife—shrill, vehement, and fluent. 'Rogue,' 'old miser,' 'old sneak,' and a great many worse names, she called him."
                                            },
                                            {
                                                "example_id": "7b8dfc5d-cfaf-45a2-92b2-f3d56342aa21",
                                                "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                                                "text": "His wife was a shrew with warts on her face and she spoke to him sharply when others were present, but Simcha did not complain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                        "entry_id": "f83f7fc0-4352-37d7-9ba4-1b12b82537da",
                                        "glosses": [
                                            "To beshrew; to curse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1bc33a-2bef-4bcd-8b1e-ea574b2387cd",
                                                "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                                                "text": "I shrew myself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7097973-5e9a-440f-8162-f37b8de92887",
                        "source_entry_id": "e11bc876-d15d-35e5-b286-bad420865b7d",
                        "source_sense_id": "33384337-5581-3118-8a8a-4b815b48f002",
                        "target_lang_word": "mégère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                        "entry_id": "446e25ad-8454-35fa-b265-372126b21258",
                                        "glosses": [
                                            "Femme méchante et emportée, par allusion à l’une des Érinyes."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cfde59-e92a-4671-9843-73fbdcd2ef42",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "On se les figurerait volontiers comme des mégères au regard hardi, au geste forcené, et l’on se tromperait fort : jamais plus doux visage de madone, paupières plus veloutées, sourires plus tendres, ne se sont inclinés sur un enfant Jésus."
                                            },
                                            {
                                                "example_id": "696e5fee-38bb-4ff5-b315-a1fcfd3f0236",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il y avait tout de même chez elle un fond de délicatesse, une loyauté dans les procédés […], qui suffisent à mettre des abîmes entre elle et une mégère comme la Verdurin."
                                            },
                                            {
                                                "example_id": "541dcebb-efea-4e13-9f47-d5b69dab6921",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "C’est une vraie mégère."
                                            },
                                            {
                                                "example_id": "b2bcf1f8-32e0-4b9e-976b-052f5980dff1",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il a épousé une mégère."
                                            },
                                            {
                                                "example_id": "fd8f3da3-929f-49c4-b827-7544474c5ced",
                                                "sense_id": "de453498-eb8e-342f-a6a3-6c1ab9e76d88",
                                                "text": "Il y avait dans cette foule de hideuses mégères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e0b7a1-7bf4-38b8-877f-3c848a66bd2f",
                                        "entry_id": "446e25ad-8454-35fa-b265-372126b21258",
                                        "glosses": [
                                            "Insecte lépidoptère, papillon de jour de la famille des Nymphalidés, dont les ailes sont de couleur jaune orangé marqué de lignes marron avec des ocelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1db66c-1788-4aab-9343-b647780e72ce",
                                                "sense_id": "71e0b7a1-7bf4-38b8-877f-3c848a66bd2f",
                                                "text": "La chenille de la mégère se nourrit sur les graminées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01a5e813-b962-4f7d-a152-b7e2f5b0493e",
                        "source_entry_id": "e11bc876-d15d-35e5-b286-bad420865b7d",
                        "source_sense_id": "33384337-5581-3118-8a8a-4b815b48f002",
                        "target_lang_word": "chipie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chipie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                                        "glosses": [
                                            "Femme ou fille acariâtre, dédaigneuse et désagréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bfaa850-4a8c-4972-a441-a6ae75dcd6ed",
                                                "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                                                "text": "— Je crois avoir entendu que le docteur parlait de cette vieille chipie de Blanche de Castille, si j’ose m’exprimer ainsi."
                                            },
                                            {
                                                "example_id": "0693cc47-5dd2-4c9b-9e30-435ef5c4e3c1",
                                                "sense_id": "c3606efd-54f1-3fce-b554-8e3526cd0c59",
                                                "text": "J’avoue qu’elle a d’assez beaux yeux, mais c’est une chipie, Turner, une chipie, aussi aigre et malfaisante que son mari."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                                        "glosses": [
                                            "Femme ou fille de caractère, et encline à jouer des tours."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a44732fc-e587-45e8-bdc0-506a8b4f879f",
                                                "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                                                "text": "Sa sœur est une vraie chipie !"
                                            },
                                            {
                                                "example_id": "6c1e3dd7-299a-4a2c-a52e-3fec42f9481c",
                                                "sense_id": "5b1c73a0-a043-36ce-8564-bcc88e474038",
                                                "text": "Elles avaient le souvenir d'une adolescente un peu ingrate, volontiers moqueuse, leur mère disait \"un peu chipie\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2caa0386-4d4f-3838-8743-d0344a957688",
                                        "entry_id": "500cf5df-4e1c-31d5-b2b4-1d5666dbeb34",
                                        "glosses": [
                                            "Se dit affectueusement d’une très jeune fille."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2ce32b-4525-4a68-91c2-0754341f67da",
                                                "sense_id": "2caa0386-4d4f-3838-8743-d0344a957688",
                                                "text": "Ah, c’est ma petite chipie d’amour qui réclame son biberon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chipie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e251356d-bcd8-3d09-8e1a-471dd1596e33",
                                        "entry_id": "0742487f-849d-311a-a5b1-32a7408a2f4f",
                                        "glosses": [
                                            "Qui a un comportement désagréable, dédaigneux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98cf293-21d0-4691-85d0-7527d492c3f6",
                                                "sense_id": "e251356d-bcd8-3d09-8e1a-471dd1596e33",
                                                "text": "N’oublions pas que le genre mondain comporte des mines dégoûtés, des airs chipie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
