                                "target_senses": [
                                    {
                                        "sense_id": "62b7a4cf-6a9b-3955-b111-780a94a9087b",
                                        "entry_id": "250ebf8d-3c2f-3088-bdbd-d3011ceb6724",
                                        "glosses": [
                                            "obyvatel Prahy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c59b98-e747-4b66-9813-87f9d85709f8",
                                                "sense_id": "62b7a4cf-6a9b-3955-b111-780a94a9087b",
                                                "text": "Kolár byl rodilý Pražan, jeho otec byl usedlý pražský měšťan a obchodník šatstvem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0dc5001-0623-422a-a098-35349951af2d",
                        "source_entry_id": "0801b145-16ef-3639-9dda-dfb41eac1494",
