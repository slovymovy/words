    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "792c4630-1aaa-359a-9879-671a29fa667d",
                    "sense_definition": "Respected and held in high regard or admiration by others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respected",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is an honour to introduce our <w>esteemed</w> guest speaker tonight.",
                            "target_lang_translations": {
                                "tr": "Bu akşamki <w>saygıdeğer</w> konuk konuşmacımızı takdim etmek bir onurdur.",
                                "ru": "Для меня большая честь представить сегодня вечером нашего <w>глубокоуважаемого</w> приглашённого докладчика."
                            }
                        },
                        {
                            "text": "She sought advice from her <w>esteemed</w> colleague before making the final decision.",
                            "target_lang_translations": {
                                "tr": "Nihai kararı vermeden önce <w>saygın</w> meslektaşından tavsiye istedi.",
                                "ru": "Она обратилась за советом к своему <w>уважаемому</w> коллеге, прежде чем принять окончательное решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "respected",
                        "honored",
                        "distinguished",
                        "venerated"
                    ],
                    "antonyms": [
                        "disreputable",
                        "despised"
                    ],
                    "common_phrases": [
                        "esteemed colleague",
                        "esteemed guest"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkaları tarafından büyük saygı ve hayranlık duyulan, itibarlı ve saygın.",
                        "ru": "Пользующийся всеобщим уважением, авторитетом или восхищением."
                    },
                    "translations": {
                        "tr": [
                            {
