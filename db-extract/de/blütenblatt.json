                                "sense_id": "30b5cbbb-3cb1-371b-a44b-871731191b01",
                                "text": "Apfelblüten haben weiße oder rosarote Blütenblätter.",
                                "translation": "Les fleurs de pomme ont des pétales blancs ou roses."
                            },
                            {
                                "example_id": "2d69b014-3942-49bb-bcee-003287ea75eb",
                                "sense_id": "30b5cbbb-3cb1-371b-a44b-871731191b01",
                                "text": "Die Blütenblätter dienen hauptsächlich der Fortpflanzung.",
                                "translation": "Les pétales permettent principalement la reproduction des plantes."
                            }
                        ]
