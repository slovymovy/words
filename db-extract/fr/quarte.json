                    },
                    {
                        "sense_id": "6e0bd532-721c-3588-a881-a6a61b44d5f9",
                        "entry_id": "660f0f63-f7fa-3d50-87fc-76ddefa6f75e",
                        "glosses": [
                            "Féminin singulier de quart.",
                            "Qualifie une fièvre survenant chaque quatrième jour comme dans certaines formes de paludisme (cas de Plasmodium malariae chez l'humain)."
                        ],
                        "tags": [
                            "dated",
                            "form-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d0674b99-5f02-4edf-9d59-ac69c7a2fc6f",
                                "sense_id": "6e0bd532-721c-3588-a881-a6a61b44d5f9",
                                "text": "Beaucoup d’observateurs admettent l’existence de plusieurs espèces d’hématozoaires du paludisme : hématozoaires des fièvres tropicales, de la tierce et de la quarte. Je pense qu'il s'agit de simples variétés d'une même espèce polymorphe."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                "word": "quarte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b086701-5351-46ae-8438-8a61b0ade841",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "quartes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3fbfd35-eeed-3963-96a0-738ac0274fee",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "glosses": [
                            "Intervalle de quatre notes consécutives, y compris les deux extrêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941ed741-6ea2-451a-8d87-8df6ec8af695",
                                "sense_id": "d3fbfd35-eeed-3963-96a0-738ac0274fee",
                                "text": "Un intervalle de quarte."
                            },
                            {
                                "example_id": "5424b00c-8c44-4b8d-aee7-213c2591c6c3",
                                "sense_id": "d3fbfd35-eeed-3963-96a0-738ac0274fee",
                                "text": "Quarte juste ou simplement Quarte : Celle dont la valeur est de deux tons et demi."
                            },
                            {
                                "example_id": "b693747e-fd51-4846-9add-83f749d06cfb",
                                "sense_id": "d3fbfd35-eeed-3963-96a0-738ac0274fee",
                                "text": "Quarte augmentée : Celle qui comprend trois tons (aussi appelée triton."
                            },
                            {
                                "example_id": "8fcba1ea-f862-4e24-baa0-4efc37f8edcb",
                                "sense_id": "d3fbfd35-eeed-3963-96a0-738ac0274fee",
                                "text": "Quarte diminuée : Celle qui ne comprend qu’un ton et deux demi-tons."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3e391fa-cec5-3454-b96c-33f40b2c91da",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "glosses": [
                            "Manière de porter ou de parer un coup d’épée ou de fleuret en tournant le poignet en dehors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d7ad8a-8329-467a-a0d4-cbbe0eff5745",
                                "sense_id": "a3e391fa-cec5-3454-b96c-33f40b2c91da",
                                "text": "Mais, au contraire, de Wardes furieux fit un bond en avant, et l’épée haute, menaçant Raoul, qui n’eut que le temps d’arriver à une parade de quarte."
                            },
                            {
                                "example_id": "8ad0ee7f-b18b-44a1-997f-50f9ed133e72",
                                "sense_id": "a3e391fa-cec5-3454-b96c-33f40b2c91da",
                                "text": "Un contre de quarte."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d875833-8632-3354-8fb5-746c2cbe62e6",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "glosses": [
                            "Au jeu de piquet, désigne quatre cartes de même couleur qui se suivent. On dit aussi quatrième."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "626096da-1466-427f-ab99-e5ebc5c19830",
                                "sense_id": "9d875833-8632-3354-8fb5-746c2cbe62e6",
                                "text": "As, roi, dame et valet font une quarte majeure."
                            }
                        ]
                    },
                    {
                        "sense_id": "93767fdd-f167-3bdf-9f35-4b79e44bfb5e",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "glosses": [
                            "Soixantième partie de la tierce, qui est elle-même la soixantième partie de la seconde."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2acc6f2d-e3ee-3cec-845b-877cb6458097",
                        "entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
                        "glosses": [
                            "Ancienne mesure de volume valant deux pintes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "31d07d82-6a1a-4b2d-b904-99ec12b83c3c",
                                "sense_id": "2acc6f2d-e3ee-3cec-845b-877cb6458097",
                                "text": "En ce qui concerne les liquides, Jean de Murs indique une contenance de 16 chopines pour un setier et donne l’égalité 69 chopines = 17 quartes = 1 pied cube."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ed0c0dc-cfd3-4357-af73-934e0496a13b",
                        "source_entry_id": "96a712b9-8c85-3791-bf8c-b14a69a279aa",
