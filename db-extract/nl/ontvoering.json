                                    {
                                        "sense_id": "b58e5cdb-ab9e-396c-bf74-2525be08df51",
                                        "entry_id": "f8f30d58-0d30-36c1-bbaf-45068187a6c5",
                                        "glosses": [
                                            "działanie podjęte w celu uprowadzenia kogoś lub czegoś; wywiezienie kogoś lub czegoś, a następnie przetrzymywanie (często w ukryciu)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e5bb3b-0027-4caa-b41c-f0c6a6ffec64",
                                                "sense_id": "b58e5cdb-ab9e-396c-bf74-2525be08df51",
                                                "text": "Porwanie Heleny stało się bezpośrednią przyczyną dziesięcioletniej wojny trojańskiej."
                                            },
                                            {
                                                "example_id": "36ad02ca-f751-45c5-8d62-0c5a458fa7a1",
                                                "sense_id": "b58e5cdb-ab9e-396c-bf74-2525be08df51",
                                                "text": "Przed porwaniem Georgij był śledzony przez dwa miesiące przez oficerów elitarnego zarządu wywiadu śledczego MSW, służącego do walki z przestępczością zorganizowaną."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7137058d-ada5-3d47-8cfe-8e33df8bc38f",
                                        "entry_id": "f8f30d58-0d30-36c1-bbaf-45068187a6c5",
                                        "glosses": [
                                            "rzecz. odczas. od porwać"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46477894-cecc-432c-9867-f74b9696e515",
                                                "sense_id": "7137058d-ada5-3d47-8cfe-8e33df8bc38f",
                                                "text": "Pierwszy raz w życiu jechała wspaniałym automobilem, toteż, mimo wstrząśnień nieuniknionych na obmurowaniach ścieków bocznej ulicy, miała złudzenie, iż uległa porwaniu do nieba."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
