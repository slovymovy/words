                                            {
                                                "example_id": "5912fc20-4b89-40a2-9e9b-7cd5dc923eaf",
                                                "sense_id": "55c6101e-12aa-3868-8e3f-17ff7cef4404",
                                                "text": "What's going on in this weirdo town?"
