                    {
                        "sense_id": "f7de38e8-47f7-32dc-b943-df9c0f2140bc",
                        "entry_id": "e70cf545-ed89-39b6-b8e2-a0e907e80f96",
                        "glosses": [
                            "Hydrocarbure aromatique polycyclique dérivé et composé de naphtène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e3cd5b6-1ff7-41c1-a19a-65aca819c408",
                                "sense_id": "f7de38e8-47f7-32dc-b943-df9c0f2140bc",
                                "text": "Mais l'acénaphtène peut aussi s'obtenir par d'autres moyens que la voie pyrogénée."
                            },
                            {
                                "example_id": "d8da4ca8-7174-45b4-b277-14b382e6c21d",
                                "sense_id": "f7de38e8-47f7-32dc-b943-df9c0f2140bc",
                                "text": "Les 31,9 grs d'acénaphtène consommé correspondent à 46,2 grs de dichlorocénaphtène."
                            },
                            {
                                "example_id": "7c98505a-9690-45d4-9155-9b2b7f376d8b",
                                "sense_id": "f7de38e8-47f7-32dc-b943-df9c0f2140bc",
                                "text": "L'acénaphtène affecte la forme de beaux prismes incolores, brillants, aiguillés et aplatis, terminés aux deux bouts par un double biseau; leur longueur atteint parfois jusqu'à 8 à 10 centimètres."
                            }
                        ]
                    }
