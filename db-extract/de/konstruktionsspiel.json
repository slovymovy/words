                "senses": [
                    {
                        "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                        "entry_id": "951e9686-9025-35e9-935f-7191d7cf0005",
                        "glosses": [
                            "Spielform, bei der materielle oder immaterielle Elemente zusammengefügt werden, um ein Produkt entstehen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85ef5d4-e18e-460b-984d-8d5b230bbbba",
                                "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                                "text": "„Als Konstruktionsspiel werden Spiele bezeichnet, in denen nicht mehr die Bewegung als Selbstzweck, sondern als zielgerichtete, geplante Tätigkeit ausgeführt wird.“"
                            },
                            {
                                "example_id": "54ab5cd2-22ed-4812-b3da-549500d27fd2",
                                "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                                "text": "„Die Konstruktionsspiele werden von Anfang an in wieder einer anderen Untersuchung verfolgt.“"
                            },
                            {
                                "example_id": "206fb270-b84e-4d6e-b40f-5adf72bd60ce",
                                "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                                "text": "„Charlotte Bühler unterscheidet Funktions-, Fiktions-, Rezeptions- und Konstruktionsspiele, […]“"
                            },
                            {
                                "example_id": "18fd3582-02b1-42fd-9005-d9a061eb97f1",
                                "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                                "text": "„Fast durchgängig wird berichtet, daß Mädchen später die Stadien komplexen Bauens erreichen als Jungen und Jungen technische Schwierigkeiten beim Konstruktionsspiel überwiegend besser bewältigen als Mädchen.“"
                            },
                            {
                                "example_id": "2a9e6d62-9f70-4cb5-93fd-65e0b852427a",
                                "sense_id": "2f86f1e9-8a1b-347d-a5d9-6974806de1bf",
                                "text": "„Im Gegensatz zu den raumgreifenden Bewegungsspielen begnügen sich die Bau- und Konstruktionsspiele mit wenig Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
