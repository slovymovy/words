                        "examples": [
                            {
                                "example_id": "ae55d1db-4721-42e5-ab3d-147e1ba73091",
                                "sense_id": "4c7eab54-6dec-3816-b7d1-56270feea8f7",
                                "text": "„Von der Dachbegehung bis hin zum Rauchschutzkonzept wird alles erarbeitet.“"
                            },
                            {
                                "example_id": "8bbd76d7-28c2-43fb-961a-d469b3db314d",
                                "sense_id": "4c7eab54-6dec-3816-b7d1-56270feea8f7",
                                "text": "„Dabei hat ein effizientes Brand- und Rauchschutzkonzept höchste Priorität bei Architekten, Planern und Bauherren.“"
                            },
                            {
                                "example_id": "c2033315-c8f2-4a07-ab4c-2f652e8f91e1",
                                "sense_id": "4c7eab54-6dec-3816-b7d1-56270feea8f7",
                                "text": "„Zudem seien die Fluchtwege und das Rauchschutzkonzept zu beachten.“"
                            },
                            {
                                "example_id": "42cece1b-36ed-4e52-828e-8ecdbd2fd0d7",
                                "sense_id": "4c7eab54-6dec-3816-b7d1-56270feea8f7",
                                "text": "„Besonderen Wert wird auf das Rauchschutzkonzept gelegt.“"
                            },
                            {
                                "example_id": "375beb5e-651b-40b4-a1db-f5036d002f48",
                                "sense_id": "4c7eab54-6dec-3816-b7d1-56270feea8f7",
                                "text": "„Ein solches Evakuierungskonzept muss am Ende gut mit dem anlagentechnischen Rauchschutzkonzept abgestimmt sein.“"
                            }
                        ],
