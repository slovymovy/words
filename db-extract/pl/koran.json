                                "target_senses": [
                                    {
                                        "sense_id": "91ccc668-f054-3cfc-b2e6-f99f821b218b",
                                        "entry_id": "65b5f739-86ad-3a7e-b56e-9d4d56f27f3f",
                                        "glosses": [
                                            "Müslümanlarca Allah kelâmı olarak kabul edilen mukaddes kitap"
                                        ],
                                        "tags": [
                                            "kitap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3032ba63-5cab-4d02-be9f-5d5cc37fee27",
                                                "sense_id": "91ccc668-f054-3cfc-b2e6-f99f821b218b",
                                                "text": "Kur'ancılar, genel mânâda Kur'an'ın herhangi bir açıklamaya ihtiyaç olmaksızın anlaşılabileceğini, bunun yanında hadislerin korunmadığını, korunan kitabın ve sözün yalnız Kur'an olduğunu ve sağlam kabul edilen hadislerin dahî şüphe taşıdığını, şüphe taşıyan hiçbir metnin dinî kaynak olamayacağını söylerler."
                                            },
                                            {
                                                "example_id": "3e4994d7-665a-4033-8810-2f080db29bd6",
                                                "sense_id": "91ccc668-f054-3cfc-b2e6-f99f821b218b",
                                                "text": "„Müslümanlara göre Kur'an âyetleri Allah tarafından Cebrâil adındaki melek aracılığıyla İslâm peygamberi Muhammed'e vahiyler hâlinde indirilen bir kutsal kitaptır.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
