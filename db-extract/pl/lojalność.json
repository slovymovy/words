                                        "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                        "entry_id": "404edfe5-0147-3158-9cba-06a39dbab5d5",
                                        "glosses": [
                                            "anhaltende, zuverlässige Unterstützung für jemand oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55584a99-a2d7-4a98-99cd-5efb17b58215",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Er erwies seinem Betrieb während seiner ganzen Zugehörigkeit Loyalität."
                                            },
                                            {
                                                "example_id": "4ac4395d-a0d0-4c2f-9eef-0b23614fcea9",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Es ist eine Frage der Loyalität, ob wir jetzt bleiben."
                                            },
                                            {
                                                "example_id": "475c3a12-310c-4b51-97b0-a5236b25e0c7",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Seine Loyalität konnte man sicher nicht in Frage stellen."
                                            },
                                            {
                                                "example_id": "114cc829-66a0-49dc-b9f4-75f1b8ce68e2",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Ihr Verhalten war grausam, was seiner Loyalität keinen Abbruch tat."
                                            },
                                            {
                                                "example_id": "5461fb27-6ecd-4ae6-9b74-28855ec17376",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                                            },
                                            {
                                                "example_id": "b9582b07-6a8c-4b6f-b954-3e5861afc3db",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Über meine Loyalität zu Deutschland muss sich niemand Sorgen machen.“"
                                            },
                                            {
                                                "example_id": "ad9abeae-ff61-4df1-9250-6e623e27d948",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Wie Moorcroft erkannten sie, daß Csomas Loyalität gegenüber den Briten aufrichtig und seine Arbeit an der tibetischen Sprache von echtem Wert war.“"
                                            },
                                            {
                                                "example_id": "430e9118-4551-4125-bf51-71c0ebabc107",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Damit gewinnt er die Loyalität jener Menschen, deren Häuser er im Bruderkampf noch niedergebrannt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
