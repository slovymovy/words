                        "sense_id": "7b9b253c-de59-3864-9824-72a1ae2be646",
                        "entry_id": "5dc69897-970b-33da-aa1d-d4f7970c6ba9",
                        "glosses": [
                            "Spécialiste de la phytogéographie."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b73c0b4a-5a50-48a4-a42e-9d5f0483c917",
                                "sense_id": "7b9b253c-de59-3864-9824-72a1ae2be646",
                                "text": "Son fondateur Georges Kuhnholtz-Lordat, disciple du phytogéographe Charles Flahault et du phytosociologue Jules Pavillard, souhaitait voir les sciences forestières s’inspirer davantage encore de l’approche phytogéographique, et emprunter également les fondement s de la phytosociologie sigmatiste, sans toutefois en adopter strictement les méthodes ni la terminologie."
                            },
                            {
                                "example_id": "59322b38-066c-47d2-b5d4-1440c4f3ebc7",
                                "sense_id": "7b9b253c-de59-3864-9824-72a1ae2be646",
                                "text": "Il y a encore de beaux jours pour les phytogéographes."
                            },
                            {
                                "example_id": "123fcbb8-2db6-4ad8-ad28-e8e573ef1778",
                                "sense_id": "7b9b253c-de59-3864-9824-72a1ae2be646",
                                "text": "Une description d’ensemble de la végétation du Haut-Forez, basée sur l'approche « sigmatiste » de Braun-Blanquet, méthode d’étude et système de classification reconnus aujourd’hui par la quasi-unanimité des phytoécologues et phytogéographes européens."
                            }
                        ]
                    }
