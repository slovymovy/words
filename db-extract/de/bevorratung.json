                                    },
                                    {
                                        "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                        "entry_id": "e21085ad-d52b-3806-b6f9-8adb166255ab",
                                        "glosses": [
                                            "The act of procuring or obtaining; obtainment; attainment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ace0d09-bf7b-4896-b37a-7971070c76fd",
                                                "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                                "text": "He was responsible for the procurement of materials and supplies."
                                            },
                                            {
                                                "example_id": "eb17a51d-319a-4bc5-b99a-7bd16f485ff3",
                                                "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                                "text": "I have a lot of experience in the procurement of construction materials and sub-contracts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                        "entry_id": "e21085ad-d52b-3806-b6f9-8adb166255ab",
                                        "glosses": [
                                            "Efficient contrivance; management; agency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d014de-85db-49f0-a272-24a639730722",
                                                "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                                "text": "They think it done by her procurement."
                                            },
                                            {
                                                "example_id": "e0394597-9f41-4b3d-bab1-64923e7c6f20",
                                                "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                                "text": "The plaintiff, in her reply, further denies that she filed the petition, or that it was filed by her procurement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdd00e09-985e-414a-a2ed-984b1e85ce0f",
