                "senses": [
                    {
                        "sense_id": "c6a5a8a0-d5e8-3d99-b4ae-0fbf5aff813e",
                        "entry_id": "4fb678f1-ec39-3cfd-b030-55d84aaaacb8",
                        "glosses": [
                            "книжн. уточнить (уточнять), разработать (разрабатывать) детально, в подробностях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52aeedd-4ecc-42b1-bd93-5566ebe999af",
                                "sense_id": "c6a5a8a0-d5e8-3d99-b4ae-0fbf5aff813e",
                                "text": "Смету необходимо детализировать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6362de24-7266-458b-82c6-bdc403d50ff2",
                        "source_entry_id": "4fb678f1-ec39-3cfd-b030-55d84aaaacb8",
                        "source_sense_id": "c6a5a8a0-d5e8-3d99-b4ae-0fbf5aff813e",
                        "target_lang_word": "detaillieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detaillieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                        "entry_id": "8f084934-d7f6-3c0a-9d36-8ff9835c7ab9",
                                        "glosses": [
                                            "etwas (sehr) genau/im Einzelnen/ausführlich darstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2676380-4334-4530-8c07-cbd2345e4e91",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "Bitte detaillieren Sie Ihre Beschwerde, damit wir Ihnen besser helfen können."
                                            },
                                            {
                                                "example_id": "8b420e5c-0502-40de-8e99-6fce35482642",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "»Könnten Sie das bitte für uns detaillieren?«"
                                            },
                                            {
                                                "example_id": "4b9ef52c-5e7c-4e59-9698-55b3a08746dc",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Die Abrechnung ist auf Verlangen zu detaillieren.“"
                                            },
                                            {
                                                "example_id": "0a6e59ff-e126-49e1-bce5-8a4c6378f140",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Die Fördersumme steht bis 2018 bereit und dient dazu, das Konzept zu detaillieren.“"
                                            },
                                            {
                                                "example_id": "f25393f1-755c-480d-abe0-98015a5a7de3",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Thyssenkrupp will nach Aus für Fusion 6000 Stellen streichen – […] «Was das konkret für welches Geschäft und welche Standorte bedeutet, müssen wir noch detaillieren», hiess es in einer Stellungnahme gegenüber AWP.“"
                                            },
                                            {
                                                "example_id": "d5befda7-d0ff-4805-bcf1-fe7f84405ee8",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Das Programm [Anm.: der DB AG] deckt sich in hohem Maße mit den Vorschlägen dieser Studie, ist aber im Sinne der sechs definierten Hochleistungskorridore noch zu erweitern und zu detaillieren.“"
                                            },
                                            {
                                                "example_id": "25cfc00c-e4ce-4f41-b5b1-50d7a8f9727f",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Die Liste lässt sich deutlich erweitern und detaillieren und damit eine umfangreiche und individuelle Aussage über die Qualität des Softwareprojektes treffen.“"
                                            },
                                            {
                                                "example_id": "da08cd12-9d1f-4f6b-bd8b-4d45cf3c9329",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Im Gespräch detaillieren Wendker und Hodges unter anderem, was es mit den Desktop Class Apps auf dem iPad auf sich hat“ […]."
                                            },
                                            {
                                                "example_id": "c3d63d5e-369a-4e5a-9a46-a9bc12dbbc5a",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„Diese Technik findet potentielle Anwendung, die Temperaturgeschichte von Ablagerungen zu detaillieren.“"
                                            },
                                            {
                                                "example_id": "4d103cbf-e1c7-4cb0-81c9-1c706589c3fe",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "„1753 begleitete er Gaspar de Munive, der den Auftrag hatte, im heutigen Paraguay die im Vertrag von Madrid 1750 festgelegte Grenze zwischen den Kolonialreichen Spaniens und Portugals zu detaillieren und umzusetzen.“"
                                            },
                                            {
                                                "example_id": "c4e196d8-6d7f-488c-b38f-fe68b552da1a",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "Populisten detaillieren nicht, sie pauschalisieren das, was sie sagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1eaacd0-52b0-4b85-bad7-edfbb68003e2",
                        "source_entry_id": "4fb678f1-ec39-3cfd-b030-55d84aaaacb8",
                        "source_sense_id": "c6a5a8a0-d5e8-3d99-b4ae-0fbf5aff813e",
                        "target_lang_word": "detalizować",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37ffaf6c-162f-4c28-96ec-fd95da773a35",
                        "source_entry_id": "4fb678f1-ec39-3cfd-b030-55d84aaaacb8",
                        "source_sense_id": "c6a5a8a0-d5e8-3d99-b4ae-0fbf5aff813e",
                        "target_lang_word": "détailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64f7a0c8-8b8a-3308-8f21-5ee3a9009f27",
                                        "entry_id": "c61dbc63-3c12-3cb9-86a5-fc6f5b35d9e7",
                                        "glosses": [
                                            "Couper en pièces, distribuer par parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de843dc-97ca-4d24-a25d-f13d70db22c9",
                                                "sense_id": "64f7a0c8-8b8a-3308-8f21-5ee3a9009f27",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            },
                                            {
                                                "example_id": "36ef3ded-c131-4e5c-a6ec-a3d1417786e6",
                                                "sense_id": "64f7a0c8-8b8a-3308-8f21-5ee3a9009f27",
                                                "text": "Alors que vider des poivrons tout en les gardant entiers pour pouvoir ensuite les garnir, on n’a jamais fait. Enlever la tige puis le secouer très fort au-dessus de l’évier pour évacuer les graines n’est sans doute pas une méthode que l’on apprend à l’école Bocuse, mais elle fonctionne (et ça détend après avoir détaillé 6 kg de légumes)."
                                            },
                                            {
                                                "example_id": "f03b0a06-495e-4ade-94d6-877fe6083c06",
                                                "sense_id": "64f7a0c8-8b8a-3308-8f21-5ee3a9009f27",
                                                "text": "Agiter le sucre dans sa tasse de café pour qu’il fonde plus vite, couper ses spaghettis, détailler une pomme en petits morceaux piqués ensuite au bout du couteau, autant de gestes oubliés que je retrouvais en lui, de façon troublante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92caf58c-9aab-3d61-8eb5-2c09426c6de8",
                                        "entry_id": "c61dbc63-3c12-3cb9-86a5-fc6f5b35d9e7",
                                        "glosses": [
                                            "Débiter, vendre au détail."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027b9e0a-a5e3-441b-b127-1fdc15a9bd2b",
                                                "sense_id": "92caf58c-9aab-3d61-8eb5-2c09426c6de8",
                                                "text": "Il n’a pu vendre ses marchandises en gros, il a été contraint de les détailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fa6fc0-dc6d-32ae-baac-6bb27ea4906b",
                                        "entry_id": "c61dbc63-3c12-3cb9-86a5-fc6f5b35d9e7",
                                        "glosses": [
                                            "Raconter, exposer en détail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def65747-2147-4d86-85f3-d266d30f8878",
                                                "sense_id": "c1fa6fc0-dc6d-32ae-baac-6bb27ea4906b",
                                                "text": "Dans certains combats, ce n’est pas seulement une lutte chorégraphiée, détaille Loïc Quinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fdac11d-3bc4-3e1e-88d1-67ab36eecd52",
                                        "entry_id": "c61dbc63-3c12-3cb9-86a5-fc6f5b35d9e7",
                                        "glosses": [
                                            "Observer dans les détails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c103f7-4021-4327-a2db-36c510d0001f",
                                                "sense_id": "0fdac11d-3bc4-3e1e-88d1-67ab36eecd52",
                                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, de celles qu'à la campagne on compare volontiers à une pouliche et que les hommes, vieux et jeunes, détaillent avec une basse envie, un violent désir."
                                            },
                                            {
                                                "example_id": "053241e8-3674-44e4-b337-c5358420f0f1",
                                                "sense_id": "0fdac11d-3bc4-3e1e-88d1-67ab36eecd52",
                                                "text": "Il détaillait ma beauté, un cri d'extase pour mes yeux, un béement prolongé pour mes mains, un sifflement coquin pour mes jambes, un silence bien préparé pour ma poitrine."
                                            },
                                            {
                                                "example_id": "4c07fda1-232d-4c7c-9964-22c2f133fbbe",
                                                "sense_id": "0fdac11d-3bc4-3e1e-88d1-67ab36eecd52",
                                                "text": "Il visita la Grande Galerie dont il détailla la splendeur, la parqueterie, les pilastres de marbre, les bronzes et les antiques qui paraissaient s'aboucher à travers les trois cent cinquante-sept miroirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
