                ],
                "senses": [
                    {
                        "sense_id": "12f53c12-527f-3724-9914-57f4fec84d2c",
                        "entry_id": "95ef96b5-6273-37ad-abda-659f46a0ad4c",
                        "glosses": [
                            "Mauerwerk, das ohne Bindemittel wie Mörtel oder Lehm gefügt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72d4d29-57a5-487b-a767-cae37d2c969f",
                                "sense_id": "12f53c12-527f-3724-9914-57f4fec84d2c",
                                "text": "„Mit Spitzkelle und Kreuzhacke scharren Arbeiter aus dem Dorf, die sich bei den Grabungen ein paar Lari verdienen, über die Steine des Höhenrückens. Beißende Kälte nagt an ihren Fingern, auf Knien kratzen die Ausgräber das Trockenmauerwerk des so genannten Heiligtums frei. Es stammt vermutlich aus einer späteren Bauphase, 7. bis 8. Jahrhundert vor Christus.“"
                            },
                            {
                                "example_id": "e1a19f2e-0dec-490b-a031-5f32bf2a2b37",
                                "sense_id": "12f53c12-527f-3724-9914-57f4fec84d2c",
                                "text": "„Noch immer stehen hier sechs aus Trockenmauerwerk errichtete Bienenkorbhütten, in denen die Eremiten vor tausend Jahren lebten - am Ende der Welt, um Gott näher zu sein.“"
                            },
                            {
                                "example_id": "4bb8e055-bc1f-44e8-9a27-2dfd40e944b0",
                                "sense_id": "12f53c12-527f-3724-9914-57f4fec84d2c",
                                "text": "„Denn die fragilen Aussenwände aus Trockenmauerwerk sind nur anspielungsreiches Füllwerk des tragenden Skeletts und Wetterschutz für die dahinter verborgenen Innenwände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
