    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31308473-471c-3c7d-8535-77962940ad69",
                    "sense_definition": "Clear enough to be read, especially in reference to handwriting or printed text.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "readability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite hardly having any energy to lift a pen, she left a <w>legible</w> note on the paper.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что у нее почти не было сил поднять ручку, она оставила на бумаге <w>разборчивую</w> записку."
                            }
                        },
                        {
                            "text": "Please ensure that your signature is <w>legible</w> so that the bank can verify your identity.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что ваша подпись <w>разборчива</w>, чтобы банк мог подтвердить вашу личность."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "decipherable",
                        "readable"
                    ],
                    "antonyms": [
                        "illegible",
                        "unreadable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно четкий, чтобы его можно было прочитать, особенно применительно к почерку или печатному тексту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разборчивый",
                                "target_lang_sense_clarification": "о почерке или тексте"
                            },
                            {
                                "target_lang_word": "четкий",
                                "target_lang_sense_clarification": "хорошо видимый"
                            },
                            {
                                "target_lang_word": "удобочитаемый",
                                "target_lang_sense_clarification": "легко читаемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfe9cf2e-f405-3bd1-a324-25bafff663f2",
                    "sense_definition": "Written or phrased in a way that is easy to understand or follow.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "readability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can make this program code more <w>legible</w> by using meaningful variable names.",
                            "target_lang_translations": {
                                "ru": "Вы можете сделать этот программный код более <w>читабельным</w>, используя значимые имена переменных."
                            }
                        },
                        {
                            "text": "The author revised the complex technical manual to make the instructions more <w>legible</w> for beginners.",
                            "target_lang_translations": {
                                "ru": "Автор переработал сложное техническое руководство, чтобы сделать инструкции более <w>понятными</w> для начинающих."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "readable"
                    ],
                    "antonyms": [
                        "unreadable"
                    ],
                    "common_phrases": [
                        "more legible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Написанный или сформулированный таким образом, что его легко понять или проследить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читабельный",
                                "target_lang_sense_clarification": "легкий для восприятия"
                            },
                            {
                                "target_lang_word": "понятный",
                                "target_lang_sense_clarification": "ясный по смыслу"
                            },
                            {
                                "target_lang_word": "удобочитаемый",
                                "target_lang_sense_clarification": "о коде или структуре текста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
