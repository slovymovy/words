                    {
                        "sense_id": "0d11fcef-6916-3a27-9358-bbf427b46d3c",
                        "entry_id": "1f276fa8-2aca-3f46-b088-54384c9d97ec",
                        "glosses": [
                            "somber, alles moeilijk inzien, te neergeslagen, depressief, zonder hoop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d20629-5895-46f6-882a-3bc9e79111fe",
                                "sense_id": "0d11fcef-6916-3a27-9358-bbf427b46d3c",
                                "text": "De pessimistische man dacht dat zijn leven na de scheiding nooit meer goed zou komen."
                            },
                            {
                                "example_id": "a16cacf0-a1f5-4b96-a091-d6742e2486e8",
                                "sense_id": "0d11fcef-6916-3a27-9358-bbf427b46d3c",
                                "text": "Het had bijna te moeilijk geleken in het begin, toen Clark er pessimistisch op was ingesteld dat hij naar de ambachtsschool zou gaan om blikslager, automonteur of iets dergelijks te worden."
                            }
                        ]
                    }
                ],
                "translations": [
