                        "glosses": [
                            "een schriftelijk verslag waarin de accountant schrijft of het financiële jaarverslag van een onderneming voldoet aan alle wettelijke eisen en aan welke eisen niet voldaan is."
                        ],
                        "tags": [],
                        "examples": [
