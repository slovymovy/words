                    "sense_id": "bc0e42cc-50c4-3445-9abc-fbe54674268f",
                    "sense_definition": "A person who is chosen to speak officially for another person or a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>spokesperson</w> issued a formal statement regarding the recent merger to the press.",
                            "target_lang_translations": {
                                "ru": "<w>Представитель</w> компании сделал официальное заявление для прессы по поводу недавнего слияния."
                            }
                        },
                        {
                            "text": "She was appointed as the official <w>spokesperson</w> for the environmental campaign last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце она была назначена официальным <w>представителем</w> экологической кампании."
                            }
                        },
                        {
                            "text": "A government <w>spokesperson</w> denied the rumors during the morning news briefing.",
                            "target_lang_translations": {
                                "ru": "<w>Пресс-секретарь</w> правительства опроверг слухи во время утреннего брифинга для новостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "spox"
                    ],
                    "common_phrases": [
                        "official spokesperson",
                        "government spokesperson",
                        "company spokesperson",
                        "acting spokesperson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, выбранное для официальных выступлений от имени другого человека или группы."
                    },
