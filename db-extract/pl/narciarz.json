                    },
                    {
                        "translation_id": "3474c2fc-8196-495e-bc84-67af9f2b886b",
                        "source_entry_id": "8049813a-1569-3b3c-858d-df752533410d",
                        "source_sense_id": "f9f77179-2d3a-3501-9806-164440448627",
                        "target_lang_word": "Skifahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skifahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32cd1f0f-1d11-3966-a35e-8ba96d19b732",
                                        "entry_id": "0a70a051-6b1e-3b40-8cf0-5a7ebb976749",
                                        "glosses": [
                                            "jemand, der Ski fährt; jemand, der das Skifahren betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d23292-d86f-4a7a-a71d-b7e10ae959e1",
                                                "sense_id": "32cd1f0f-1d11-3966-a35e-8ba96d19b732",
                                                "text": "Manche Skifahrer wollen sich nicht an die Pistenregeln halten und fahren in gesperrten Gebieten."
                                            },
                                            {
                                                "example_id": "150ff0a7-700a-418a-8bb7-1a39fd831b10",
                                                "sense_id": "32cd1f0f-1d11-3966-a35e-8ba96d19b732",
                                                "text": "„Und dass der Job bei der Bergwacht von vielen unentgeltlich geleistet wird, scheint manche Skifahrer nicht zu kümmern.“"
                                            },
                                            {
                                                "example_id": "d287aa01-8796-4632-9307-c51a075174b1",
                                                "sense_id": "32cd1f0f-1d11-3966-a35e-8ba96d19b732",
                                                "text": "„Bei so tollem Osterwetter musste man mit Skifahrern aus ganz Island rechnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
