                        "sense_id": "8a811ab9-22cd-3eaf-bbe0-35bfc428d760",
                        "entry_id": "e44434b5-8b22-3fb7-b5bd-c7bc6accb794",
                        "glosses": [
                            "A lot (object used to determine a question by chance or independently of human choice)."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "b72c2779-c799-4d63-a0cc-247bcdfcfcbf",
                                "sense_id": "8a811ab9-22cd-3eaf-bbe0-35bfc428d760",
                                "text": "1821 [1802], Walter Scott (transcriber), Fause Foodrage, W. Scott (editor) Minstrelsy of the Scottish Border, Volume 3, 5th edition, Longman, Hurst, Rees, Orme, and Brown, page 4,\nAnd they cast kevils them amang, / And kevils them between; / And they cast kevils them amang, / Wha suld gae kill the king."
                            },
                            {
                                "example_id": "11a64c2b-cd98-46aa-bbc7-851a9f395c52",
                                "sense_id": "8a811ab9-22cd-3eaf-bbe0-35bfc428d760",
                                "text": "1887, Transactions of the Buchan Field Club, Volumes 1-2, Buchan Field Club, page 176,\n\"Casting the kevils\" was and still is a common mode of deciding a thing."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbaa91db-2d93-3881-afb4-3b729f5260b3",
                        "entry_id": "e44434b5-8b22-3fb7-b5bd-c7bc6accb794",
                        "glosses": [
                            "A sturdy belaying pin for the heavier cables of a ship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e43511d-f93c-4907-a27a-a291d054dd83",
                                "sense_id": "dbaa91db-2d93-3881-afb4-3b729f5260b3",
                                "text": "The following new ones will have to be supplied: Two pairs of sheave chocks similar to those now in use on board, and twelve large kevils at least four feet long and of heavy pattern."
                            },
                            {
                                "example_id": "147b512c-f39b-4ca5-9913-b7f93e20527d",
                                "sense_id": "dbaa91db-2d93-3881-afb4-3b729f5260b3",
                                "text": "The halliard is belayed on the kevil with figure-of-eight turns (not hitched), and the coil is carried up to the pin-rail, where the 1-inch rope is passed round it, the eye at the end of this rope being finally passed over the pin."
                            }
                        ]
                    }
