                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3fa94e-28b0-47c1-aa87-c522e88afb48",
                                "sense_id": "3157741a-82b5-3f9b-baf3-8f06feacfa24",
                                "text": "Mam spotkanie z doktorem o jedenastej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee38957a-e238-4897-8333-bd71c87d6b37",
                        "source_entry_id": "c55350ea-f0e6-35a4-a383-463769c4884f",
                        "source_sense_id": "3157741a-82b5-3f9b-baf3-8f06feacfa24",
                        "target_lang_word": "eleven",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eleven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc20fe9-2d4e-30e2-ae10-f36eb6723c33",
                                        "entry_id": "6deb7d2e-e073-39a0-9d9e-c3bee4c6eaac",
                                        "glosses": [
                                            "The cardinal number occurring after ten and before twelve. Represented as 11 in Arabic digits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2146d1-59d1-4352-976c-d814c455d815",
                                                "sense_id": "1fc20fe9-2d4e-30e2-ae10-f36eb6723c33",
                                                "text": "It was a thunderstormy morning, eleven o'clock, with great dashes of rain pounding against the windows."
                                            },
                                            {
                                                "example_id": "3bd5c539-a073-445f-b3b1-006e7dafdd44",
                                                "sense_id": "1fc20fe9-2d4e-30e2-ae10-f36eb6723c33",
                                                "text": "I know most girls say that they've known their bezzies since they started primary school together, bonding over handmade Mother's Day cards or a hatred of the egg-and-spoon race, but I've only known Taryn since I was eleven[…]"
                                            },
                                            {
                                                "example_id": "717536e8-fc58-4118-a644-6f1b0183fbb9",
                                                "sense_id": "1fc20fe9-2d4e-30e2-ae10-f36eb6723c33",
                                                "text": "It was also a work of fiction in which another work of fiction (Gulliver's Travels) was real; that Chinese box of an idea is wonderful to discover when you're eleven."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eleven",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e18bfef-f5e8-356d-a7b2-4cee5c64cfe3",
                                        "entry_id": "609711d4-04e1-3955-87cb-9f30fc6ec440",
                                        "glosses": [
                                            "A cricket team of eleven players. Hence first eleven - the team of best cricket players (at a school), second eleven - the \\\"B\\\" team, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c24ed522-66f1-3737-b024-ca9a329d7933",
                                        "entry_id": "609711d4-04e1-3955-87cb-9f30fc6ec440",
                                        "glosses": [
                                            "A football team of eleven players; the starting lineup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8138c0a6-09ac-4a91-a174-de95f07eac22",
                                                "sense_id": "c24ed522-66f1-3737-b024-ca9a329d7933",
                                                "text": "Sneeze is well known by all followers of U. of D. athletics for his great work at halfback on the Flyers' eleven for the past four seasons [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a8f228-b283-39f4-98e6-0fbf510d25c4",
                                        "entry_id": "609711d4-04e1-3955-87cb-9f30fc6ec440",
                                        "glosses": [
                                            "Deliberate misspelling of !!, used to amplify an exclamation, imitating someone who forgets to press the shift key while typing exclamation points."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "alt-of",
                                            "deliberate",
                                            "misspelling",
                                            "sarcastic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be34441f-d503-47a6-9bb5-6513e9b53998",
                                                "sense_id": "77a8f228-b283-39f4-98e6-0fbf510d25c4",
                                                "text": "A: SUM1 Hl3p ME im alwyz L0ziN!!?!"
                                            },
                                            {
                                                "example_id": "703648e4-6fd3-42b6-94c9-31ca1882e1ad",
                                                "sense_id": "77a8f228-b283-39f4-98e6-0fbf510d25c4",
                                                "text": "B: y d0nt u just g0 away l0zer!!1!!one!!one!!eleven!!1!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "108c4602-0d38-30b0-9c88-5ba7ad1afafc",
                                        "entry_id": "609711d4-04e1-3955-87cb-9f30fc6ec440",
                                        "glosses": [
                                            "A number off the charts of a hypothetical scale of one to ten.",
                                            "An exceptional specimen, (particularly) a physically attractive person."
                                        ],
