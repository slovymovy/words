                    ],
                    "synonyms": [
                        "fading",
                        "wilting",
                        "declining"
                    ],
                    "antonyms": [
                        "flourishing",
                        "thriving"
                    ],
                    "target_lang_definitions": {
                        "cs": "Postupně slábnoucí, zmenšující se nebo ztrácející vitalitu."
                    },
                    "translations": {
