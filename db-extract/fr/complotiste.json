                    {
                        "translation_id": "2054e61a-e695-4ec4-85ce-d6131e1283c8",
                        "source_entry_id": "04194a81-a918-3764-bb86-c2b78ab09a07",
                        "source_sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                        "target_lang_word": "conspiracy theorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspiracy theorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                        "entry_id": "ee2392f4-1938-39bd-b16d-21f495d13de6",
                                        "glosses": [
                                            "One who believes in, follows, or advances a conspiracy theory."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c16d6e-72ec-4ad4-add9-9cbaf4903357",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "Mike's a conspiracy theorist; he thinks NASA faked the moon landings."
                                            },
                                            {
                                                "example_id": "9addbafe-bcee-4d25-945e-f27034d8fcd5",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "And you may have noticed that those who are too quick to shout 'conspiracy theorist' are equally swift, when consequences for authority and consensus impend, to look serious and say 'It's more complicated than that.' These have become standard damage-control reflexes."
                                            },
                                            {
                                                "example_id": "3a39a1dc-8fb4-455f-a67f-d8b19f8775cb",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "“Robert F. Kennedy, Jr. is not an environmentalist. He is a dangerous conspiracy theorist and science denier whose agenda would be a disaster for our communities and the planet,” the letter reads."
                                            },
                                            {
                                                "example_id": "7bfe3737-5fb3-408b-bb61-a9d3859eabdb",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "Rep. Marjorie Taylor Greene (R-Ga.), one of the most notorious conspiracy theorists and MAGA diehards in Congress, told The New York Times that the DOJ’s memo is “a full reversal on what was all said beforehand, and people are just not willing to accept it.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a8facab-e89f-48a5-bc14-7c2290a99cf4",
                        "source_entry_id": "04194a81-a918-3764-bb86-c2b78ab09a07",
                        "source_sense_id": "c3077eaa-ec67-3ecb-bb16-446f33432dcf",
                        "target_lang_word": "complottista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complottista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "7e453d57-2844-3540-a396-5ed3105bd992",
                                        "entry_id": "942f6dd4-4115-32ca-bee7-14c605722671",
                                        "glosses": [
                                            "chi organizza un complotto"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cbc8fc6-24cc-30cf-a491-a55d38b30ff5",
                                        "entry_id": "942f6dd4-4115-32ca-bee7-14c605722671",
                                        "glosses": [
                                            "chi crede (ingiustamente o meno) che vi siano più macchinazioni oppure chi fomenta reazioni disdicevoli contro una o più persone"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009a4367-86ff-4820-b65e-3e552506b9df",
                                                "sense_id": "7cbc8fc6-24cc-30cf-a491-a55d38b30ff5",
                                                "text": "lui, come dici, è di certo un insicuro complottista… ma tu credi proprio a tutto, eh"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc749a2-8d38-3929-bd84-9f79e23aa138",
                                        "entry_id": "942f6dd4-4115-32ca-bee7-14c605722671",
                                        "glosses": [
                                            "per lo più politico, in genere i cosiddetti “intellettuali della sinistra”, s’intende complottista anche chi “stana le notizie false”, dette “fake news”, semi-verità più o meno vere e false appunto, teorie senza senso, informazioni distorte o senza valore quindi “fuorvianti” riguardo a “interi sistemi politico-economici per così dire associati alle spalle dei comuni cittadini”, persino concernenti l’apparente totale veridicità di fatti storici, bellici attuali e non, di dati scientifici, della cultura in generale, sull’origine particolare di molte cose e/o persone, ecc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22a2a2e7-8993-40af-ae0d-40296b1392d0",
                                                "sense_id": "edc749a2-8d38-3929-bd84-9f79e23aa138",
                                                "text": "a parte il “classico” complottista anarchico, effettivamente palesemente criminoso contro quasi tutte le istituzioni, un buon complottista è quello comprensibile che non si spiega come gli astronauti possano letteralmente “prendere al volo” luna o pianeti vari malgrado le orbite a velocità elevatissime…"
                                            },
                                            {
                                                "example_id": "b3ddb71c-5880-472e-9a4c-856bb39c3246",
                                                "sense_id": "edc749a2-8d38-3929-bd84-9f79e23aa138",
                                                "text": "ecco che il solito complottista di sinistra si aggira truffaldino quasi ovunque…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
