                "translations": [
                    {
                        "translation_id": "9018d515-4ed0-452d-ad02-d7f5e97db5b9",
                        "source_entry_id": "3d8b344c-dd2c-3430-a0f6-5af6f8d710b9",
                        "source_sense_id": "3bc51c04-6ba6-315f-859f-c911c1801a53",
                        "source_sense_description": "een druif die wordt gebruikt om wijn van te maken",
                        "target_lang_word": "Weintraube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weintraube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                        "entry_id": "16cfc6c6-fadf-3c6e-be7c-7b51460e89f0",
                                        "glosses": [
                                            "die Frucht der Weinrebe, die Weinbeere"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79fb28f-8ac3-4f35-b955-55041fabc179",
                                                "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                                "text": "Im Herbst werden die Weintrauben gelesen."
                                            },
                                            {
                                                "example_id": "5d9d404a-4bbb-4b00-95dc-c7d1a04dbc94",
                                                "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                                "text": "„Michael korrigierte, daß die im Winter geernteten Trauben eher Rosinen als Weintrauben ähneln.“"
                                            },
                                            {
                                                "example_id": "eaa85132-5dc7-4090-9a42-b043edd7928e",
                                                "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                                "text": "„Mit Weintrauben und warmen Bädern bot Rom mehr Labsal und Luxus als die germanische Provinz.“"
                                            },
                                            {
                                                "example_id": "f94b0d70-90c1-4a18-9df2-e3e7d12a1ce5",
                                                "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                                "text": "„Der Nachtwächter eines Weinbergs hatte Verständnis für die Not der Menschen und ließ sie über den Zaun springen, um Weintrauben zu pflücken.“"
                                            },
                                            {
                                                "example_id": "0e14d96c-e806-4fec-b151-2b59a82298de",
                                                "sense_id": "4de6056e-e70d-3618-9761-71281dfbbb1b",
                                                "text": "„Gegen acht Uhr hatte Pierre sie verlassen, um Weintrauben zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
