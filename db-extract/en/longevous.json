                        "glosses": [
                            "Long-lasting, especially of life."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fabd0664-8374-485f-943f-60b94e96692b",
                                "sense_id": "58d4d505-d420-3402-959c-6bf1695ca2ff",
                                "text": "Grandfather was incredibly longevous: he lived to be 105 years old."
                            }
                        ]
                    }
