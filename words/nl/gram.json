                            },
                            {
                                "target_lang_word": "злоба",
                                "target_lang_sense_clarification": "чувство недоброжелательства"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "чувство горечи"
                            }
                        ]
