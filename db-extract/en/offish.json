                        "entry_id": "c78155d4-ff2d-3bee-9e18-86ae8d81a581",
                        "glosses": [
                            "Aloof, standoffish."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "bcce5358-7790-4411-98cf-0d6852fa8dd5",
                                "sense_id": "41ef7431-e94c-325d-9925-2540fc159afc",
                                "text": "The English, he was perfectly aware, had been held by the American to be offish and haughty, and the American had stiffened itself to show that, since the question was of turning an unconscious back, the game was playable wherever backs were broad enough to show...."
                            },
                            {
                                "example_id": "828b0a07-8707-4def-80af-c859e1c5dde3",
                                "sense_id": "41ef7431-e94c-325d-9925-2540fc159afc",
                                "text": "Called \"The Patron Saint of Swag,\" the self-anointed \"most-confirmed bachelor\" in Nigeria, he made his fortune in cryptocurrency. Now the offish nouveau riche Q spends his nights wasting his cash."
                            }
                        ]
                    }
