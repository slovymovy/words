                        "entry_id": "a895c9f1-94e6-3659-944c-1670f435515d",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "MSTed"
                    },
                    {
                        "form_id": "072afe06-2d8e-4d84-aff7-6c31011a7908",
                        "entry_id": "a895c9f1-94e6-3659-944c-1670f435515d",
                        "tags": [
                            "past"
                        ],
                        "form": "MSTed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3615d2b0-cbb9-3a19-a628-d99e210b5a8d",
                        "entry_id": "a895c9f1-94e6-3659-944c-1670f435515d",
                        "glosses": [
                            "To mock a work (typically a fanfic) by inserting satirical commentary."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ad5b85-7c3f-4587-9289-7b9df57c184d",
                                "sense_id": "3615d2b0-cbb9-3a19-a628-d99e210b5a8d",
                                "text": "But you can't quote large chunks, and MSTing a story would seem to me to be across the line into infringement."
                            },
                            {
                                "example_id": "351850aa-7180-4532-bb13-60f562a8d191",
                                "sense_id": "3615d2b0-cbb9-3a19-a628-d99e210b5a8d",
                                "text": "Maybe that's why its^([sic]) considered bad etiquette to MST without permission."
                            },
                            {
                                "example_id": "662186a3-446b-4327-b0bd-b2b3479c08ba",
                                "sense_id": "3615d2b0-cbb9-3a19-a628-d99e210b5a8d",
                                "text": "Look it up and see if you don't agree that this story deserves to be MSTed, if not completely erased from existance^([sic])..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
