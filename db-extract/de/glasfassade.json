                        "examples": [
                            {
                                "example_id": "c82b033a-1b2e-4db6-87ba-278f3155d392",
                                "sense_id": "b00e1aa8-1bea-3ed9-98f6-b115ba9f9fa5",
                                "text": "Durch die großzügige Glasfassade wirkt der Innenraum der Bibliothek hell und freundlich."
                            },
                            {
                                "example_id": "54152eb9-4e60-464a-944f-218d51c2b82d",
                                "sense_id": "b00e1aa8-1bea-3ed9-98f6-b115ba9f9fa5",
                                "text": "„Etwa die vom Haus der Wirtschaftsförderung in Duisburg, in dessen Glasfassade Mitte der 90er Jahre mehrfach Scheiben sprangen und auf die Straße stürzten.“"
                            }
