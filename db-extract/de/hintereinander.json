                        "source_sense_id": "f6036e56-fcd7-3616-a22a-a0559f5600e9",
                        "source_sense_description": "zeitlich: zeitlich direkt aufeinander folgend",
                        "target_lang_word": "in a row",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
