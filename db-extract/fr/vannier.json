                "senses": [
                    {
                        "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                        "entry_id": "86015b04-a15b-3dbf-8cca-ca862e864fc2",
                        "glosses": [
                            "Ouvrier qui travaille les fibres d'origine végétales et qui fait des vans, des corbeilles, des paniers, des hottes, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b744201-67a1-41b7-b026-10fa8323e14a",
                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                "text": "Il avait fait connaissance, dans un cabaret du faubourg, d’un ouvrier vannier qui travaillait en chambre."
                            },
                            {
                                "example_id": "24737683-7924-4b4f-9df7-ded73ceae424",
                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                "text": "Son allure et ses manières n'étaient pourtant pas celles d'une paysanne et encore moins d'une ancienne vannière du village ; pour qui ne la connaissait pas, elle avait tout d'une soixante-huitarde ayant opéré un retour à la campagne."
                            },
                            {
                                "example_id": "fbadefd0-f1ac-4d61-9830-43cc8bc2c181",
                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                "text": "La mémoire s’effeuille au vent des derniers froids\nComme un épouvantail avec les bras en croix\nL’oubli courbe sa paille aux doigts bruns des vanniers\nL’oubli courbe sa paille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cef00af8-bac9-4166-ab8c-da4018b1537c",
                        "source_entry_id": "86015b04-a15b-3dbf-8cca-ca862e864fc2",
                        "source_sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                        "target_lang_word": "Korbmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korbmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f8a464-8465-35e0-b10e-2a945ef17bb0",
                                        "entry_id": "828a614e-d3da-3388-a4ae-589004fc50ba",
                                        "glosses": [
                                            "jemand, der Körbe herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac2e6c3-9ddf-4d4b-a2fa-0fb04662c232",
                                                "sense_id": "a4f8a464-8465-35e0-b10e-2a945ef17bb0",
                                                "text": "„Danischmend macht sich ein wenig auf dem Acker zu schaffen, später wird er aus Vergnügen an der Sache, nicht aus Gründen der Erwerbsnot, ein feiner Korbmacher, seine Frau Perisadeh gebiert ihm Kinder und sorgt für sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04e4e0ff-ee01-463b-9767-a180dd6a55a2",
                        "source_entry_id": "86015b04-a15b-3dbf-8cca-ca862e864fc2",
                        "source_sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                        "target_lang_word": "mandenvlechter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandenvlechter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7e9e05-7f72-3619-ae36-9f70fed94a0a",
                                        "entry_id": "8be79dac-d55b-33da-9f0d-e9430b4631f9",
                                        "glosses": [
                                            "persoon die uit riet of touw manden maakt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc67d64-9a78-46c9-acb3-fe15ba5774df",
                                                "sense_id": "ad7e9e05-7f72-3619-ae36-9f70fed94a0a",
                                                "text": "Het belooft dit najaar een enorm spektakel te worden. Dus kijk niet raar op als de siepelmarkten in 2021 definitief worden ingeruild voor een soortgelijke expositie. Geen ondernemer die dan nog durft te beginnen over het terughalen van klompenmakers, mandenvlechters of bezembinders."
                                            },
                                            {
                                                "example_id": "080041ea-830f-4e8b-aa84-d5f2e95666b0",
                                                "sense_id": "ad7e9e05-7f72-3619-ae36-9f70fed94a0a",
                                                "text": "De smidse is verhuisd naar de dierentuin en daar weer opgebouwd. De werkzaamheden hebben bijna twee jaar geduurd. Eind 2020 zijn de vrijwillige mandenvlechters Mechthild Schwank en Manfred Meyer twee weken bezig geweest met het maken van het vlechtwerk van de smederij. De bouw kostte 70.000 euro en kon worden bekostigd door een gift van de Grafschafter Sparkassenstiftung."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
