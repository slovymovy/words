                            {
                                "example_id": "43a6669f-ddb6-4e26-b9db-0a6fdb9253c7",
                                "sense_id": "7a7a1cb8-7082-3cf2-a065-9d98bc58a702",
                                "text": "Altbundeskanzlerin Brigitte Bierlein appellierte an das Vertrauen in einen selbst."
                            },
                            {
                                "example_id": "a3695cad-fc72-4392-9c55-2a454633fa8a",
                                "sense_id": "7a7a1cb8-7082-3cf2-a065-9d98bc58a702",
                                "text": "Erst gerade gab sie das Präsidium des Schweizerischen Roten Kreuzes ab, nun ist Altbundeskanzlerin Annemarie Huber-Hotz an einem Herzversagen gestorben."
                            },
                            {
                                "example_id": "f876dd39-ef1a-4ddb-81bb-69f05c8f22aa",
                                "sense_id": "7a7a1cb8-7082-3cf2-a065-9d98bc58a702",
                                "text": "Wie und womit sollte in absehbarer Zeit die Altbundeskanzlerin daraus hervorragen?"
                            }
                        ],
