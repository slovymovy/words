                "senses": [
                    {
                        "sense_id": "6aa7765b-ded8-344a-af62-1c6dab901e29",
                        "entry_id": "3e2d3861-c9bf-3b86-87eb-f21b2e3aa0e7",
                        "glosses": [
                            "Faire subir le même sort que le PASOK (très grave érosion électorale au profit d’un autre parti) à un parti politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e8219d-301c-4367-97e9-09cf131f9fc7",
                                "sense_id": "6aa7765b-ded8-344a-af62-1c6dab901e29",
                                "text": "Jean-Luc Mélenchon pense être sur le point de «pasokiser» le PS."
                            },
                            {
                                "example_id": "4006ad25-5ec7-4131-9515-07fdd535f8ba",
                                "sense_id": "6aa7765b-ded8-344a-af62-1c6dab901e29",
                                "text": "Certes, l'objectif premier de dépasser le PSOE ou de le «pasokiser», comme on le dit dans le parti frère Syriza - n'est finalement pas atteint."
                            },
                            {
                                "example_id": "790b38f4-abcd-427c-8a16-52086720751b",
                                "sense_id": "6aa7765b-ded8-344a-af62-1c6dab901e29",
                                "text": "« Il n’empêche que le PS pourrait bien se \"pasokiser\" s’il fait moins de 10% au premier tour et passe derrière le Parti de gauche et s’il perd encore des circonscriptions aux législatives », affirme Rémi Lefebvre."
                            }
                        ]
                    }
