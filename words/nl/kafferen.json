            "senses": [
                {
                    "sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                    "sense_definition": "op een grove manier vloeken en tieren zonder een specifiek onderwerp te noemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schelden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze onbeschofte jongeman was luid aan het schelden en <w>kafferen</w>.",
                            "target_lang_translations": {
                                "en": "This rude young man was loudly swearing and <w>ranting</w>."
                            }
                        },
                        {
                            "text": "De man begon plotseling te <w>kafferen</w> tegen iedereen die toevallig langs hem liep.",
                            "target_lang_translations": {
                                "en": "The man suddenly started <w>letting fly</w> at everyone who happened to walk past him."
                            }
                        }
                    ],
                    "synonyms": [
                        "briesen",
                        "fulmineren",
                        "razen",
                        "schelden",
                        "tieren",
                        "vloeken"
                    ],
                    "common_phrases": [
                        "schelden en kafferen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en vaak als grof ervaren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To swear and rant in a coarse manner without naming a specific subject"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let fly",
                                "target_lang_sense_clarification": "to unleash an angry outburst of obscenities"
                            },
                            {
                                "target_lang_word": "rant and rave",
                                "target_lang_sense_clarification": "to shout and complain angrily and loudly"
                            },
                            {
                                "target_lang_word": "let rip",
                                "target_lang_sense_clarification": "to utter a tirade or outburst without restraint"
                            },
                            {
                                "target_lang_word": "curse",
                                "target_lang_sense_clarification": "to use offensive language or swear words"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c569b0ee-bf34-3c60-adcd-e8cd5f72e5fe",
                    "sense_definition": "iemand op een zeer onvriendelijke of beledigende manier uitschelden",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schelden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet nodig om zo tegen je collega te <w>kafferen</w> over een kleine fout.",
                            "target_lang_translations": {
                                "en": "There is no need to <w>berate</w> your colleague like that over a small mistake."
                            }
                        },
                        {
                            "text": "Hij bleef maar <w>kafferen</w> tot de hele kamer stilviel van verbazing.",
                            "target_lang_translations": {
                                "en": "He kept on <w>cursing</w> until the whole room fell silent in surprise."
                            }
                        }
                    ],
                    "synonyms": [
                        "schelden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en potentieel beledigend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To scold or abuse someone in a very unfriendly or insulting manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "berate",
                                "target_lang_sense_clarification": "to scold or criticize someone angrily"
                            },
                            {
                                "target_lang_word": "curse out",
                                "target_lang_sense_clarification": "to direct a string of swear words at someone"
                            },
                            {
                                "target_lang_word": "rail at",
                                "target_lang_sense_clarification": "to complain or protest strongly and persistently"
                            },
                            {
                                "target_lang_word": "abuse",
                                "target_lang_sense_clarification": "to speak to someone in an insulting or offensive way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
