                                        "entry_id": "04773858-ad4a-3f17-a75f-7bcb37799a13",
                                        "glosses": [
                                            "Action où l’effet cumulatif de deux composants d’un mélange est plus important que la somme des effets individuels des composants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e857574-852a-421b-b94a-ea86e1362e72",
                                                "sense_id": "7542cc02-0463-335c-906e-6da9e0d7b0ff",
                                                "text": "Agir en synergie."
