                ],
                "senses": [
                    {
                        "sense_id": "4157464d-7204-38f0-88c1-1d97ad29974d",
                        "entry_id": "74b98da0-e371-3ba3-9954-d43652663bf7",
                        "glosses": [
                            "становиться мудрым или более мудрым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad37fa86-cf74-4b16-ba41-5c5f02bc9604",
                                "sense_id": "4157464d-7204-38f0-88c1-1d97ad29974d",
                                "text": "Только ослеплённые и одержимые не мудреют с годами."
                            },
                            {
                                "example_id": "241b2332-7197-48c3-8022-421005ffdeda",
                                "sense_id": "4157464d-7204-38f0-88c1-1d97ad29974d",
                                "text": "В одном из стихотворений он [Сковорода] пишет: «… О, свобода! В тебе я начал мудреть… // До тебе моя природа, в тебе хочу и умреть»."
                            },
                            {
                                "example_id": "7fa5c118-6599-4b68-a6f9-a6faaefa77f5",
                                "sense_id": "4157464d-7204-38f0-88c1-1d97ad29974d",
                                "text": "Идут годы, а с ними мужает и мудреет талант поэта."
                            }
                        ]
                    }
                ],
