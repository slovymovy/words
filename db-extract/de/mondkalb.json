                "senses": [
                    {
                        "sense_id": "d69f56f8-fa62-35df-ba6b-f96b7118fdc1",
                        "entry_id": "3b297982-7cde-3442-981c-a0f38d3a9170",
                        "glosses": [
                            "missgebildete Leibesfrucht, Mole"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0574db1a-d8ec-4e37-bcc4-5fbebcfbdcee",
                                "sense_id": "d69f56f8-fa62-35df-ba6b-f96b7118fdc1",
                                "text": "„Die Muse der Tragödie ist zur Gassenhure geworden, denn jeder deutsche Schlingel notzüchtigt sie nach Belieben und zeugt mit ihr fünfbeinige Mondkälber, welche so abscheulich sind, daß ich den Hund bedauere, der sie anpißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "edc35faa-ff19-3413-9010-aabef34653c3",
                        "entry_id": "3b297982-7cde-3442-981c-a0f38d3a9170",
                        "glosses": [
                            "dummer, einfältiger Mensch"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c456c3d2-ff57-420e-9c0c-b4326f5adc6a",
                                "sense_id": "edc35faa-ff19-3413-9010-aabef34653c3",
                                "text": "Das æsthetische Wiesel",
                                "translation": "tat’s um des Reimes willen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bea269f-f612-4b71-8ad6-2689c2e8f021",
                        "source_entry_id": "3b297982-7cde-3442-981c-a0f38d3a9170",
                        "source_sense_id": "d69f56f8-fa62-35df-ba6b-f96b7118fdc1",
                        "source_sense_description": "veraltete Bedeutung: missgebildete Leibesfrucht, Mole",
                        "target_lang_word": "mooncalf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mooncalf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a10342-fc1b-3915-bfe3-9ce5c0f87a27",
                                        "entry_id": "8c1c30a1-b19f-303e-b9af-b5dbd4d8b077",
                                        "glosses": [
                                            "An abnormal mass within the uterus; a false conception."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f567fb8-247c-431b-8d75-fb65252f2b32",
                                                "sense_id": "15a10342-fc1b-3915-bfe3-9ce5c0f87a27",
                                                "text": "Thou art very Trinculo indeed! How camest thou to be the siege of this moon-calf? Can he vent Trinculos?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bc4af8c-afc1-36ab-9d90-1f0a707f7135",
                                        "entry_id": "8c1c30a1-b19f-303e-b9af-b5dbd4d8b077",
                                        "glosses": [
                                            "A poorly-conceived idea or plan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be958e4d-3e89-365e-afa1-77244f756659",
                                        "entry_id": "8c1c30a1-b19f-303e-b9af-b5dbd4d8b077",
                                        "glosses": [
                                            "A dreamer, someone absent-minded or distracted; a fool, simpleton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703b519f-7f00-437f-8231-62afcada92fc",
                                                "sense_id": "be958e4d-3e89-365e-afa1-77244f756659",
                                                "text": "“[…] you’re a jobbernowl and a doodle, a maundering mooncalf and a blockheaded numps, a gaby and a loon; you’re a Hatter!” I shrieked the last epithet."
                                            },
                                            {
                                                "example_id": "ea922290-b04e-4312-bf6f-55f6d3085338",
                                                "sense_id": "be958e4d-3e89-365e-afa1-77244f756659",
                                                "text": "But I can think of no one but a mooncalf or a gaby\nWho would trust their own child to raise a baby."
                                            },
                                            {
                                                "example_id": "002a3b85-b672-4fff-aeb7-1b049a2d2f99",
                                                "sense_id": "be958e4d-3e89-365e-afa1-77244f756659",
                                                "text": "He slipped it softly onto her unresisting finger and, like the unwise moncalf he was, kissed it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd3ab1d2-9c50-4a73-b773-8112e44968f9",
                        "source_entry_id": "3b297982-7cde-3442-981c-a0f38d3a9170",
