                ],
                "senses": [
                    {
                        "sense_id": "41e7ef3c-a025-3bf0-8c01-aa14939a67c9",
                        "entry_id": "6326b351-3533-36f0-b821-b33a4819b577",
                        "glosses": [
                            "Onomatopée imitant le bruit d’un moteur qui accélère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5fca64-5dd5-40d2-ad72-448349c831e4",
                                "sense_id": "41e7ef3c-a025-3bf0-8c01-aa14939a67c9",
                                "text": "Vroum ! Vroum ! Quelques minutes plus tard, mes amis me voient passer … Vroum ! Vroum ! Quand je me suis arrêtée, j'étais une loque."
                            },
                            {
                                "example_id": "129414f2-6170-442d-bcd8-d6e3a62db255",
                                "sense_id": "41e7ef3c-a025-3bf0-8c01-aa14939a67c9",
                                "text": "Il enfile son costard, croit sincèrement jouer un rôle crucial au sein de son holding, possède une grosse Mercedes qui fait vroum-vroum dans les embouteillages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2da01ee-f4e0-4cf1-8f81-03ace183907f",
                        "source_entry_id": "6326b351-3533-36f0-b821-b33a4819b577",
                        "source_sense_id": "41e7ef3c-a025-3bf0-8c01-aa14939a67c9",
                        "target_lang_word": "brumm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brumm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                        "entry_id": "0f7cd7f8-7381-32cf-ba77-ac1c95557460",
                                        "glosses": [
                                            "Laut, der beim Nachahmen eines Motorengeräusches entsteht."
                                        ],
                                        "tags": [
                                            "kindersprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10fa090-9744-47c5-b7f3-9124793849b7",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "Brumm! fuhr das Auto los."
                                            },
                                            {
                                                "example_id": "b0bab7e0-cf0d-4d8d-8bf0-36b419d80b22",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "„Brumm, brumm, brumm – Paris ist ziemlich dumm.“"
                                            },
                                            {
                                                "example_id": "7ed7c000-b030-480d-bc19-d3c68c573c9c",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "„Wenn 99 % der Leute sagen, so ist es richtig – dann mache ich es anders. Ich bin damit immer gut gefahren – brumm brumm!“"
                                            },
                                            {
                                                "example_id": "366a925b-07e2-440e-9410-fcb6c91d3bf2",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "„\"Als sie das Modell gesehen hat, da hat sie…\" Nein, sie hat eben nicht entzückt \"Opel\" ausgerufen, das wäre ja zu schön gewesen. Auf ein heiteres \"Brumm, brumm\" bezieht sich der ganze Vaterstolz.“"
                                            },
                                            {
                                                "example_id": "b6184233-e237-40c0-b36b-7502c0e6d655",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "„Brumm, macht der Propeller, brumm, brumm.“"
                                            },
                                            {
                                                "example_id": "a1ac443c-9e65-4f32-b5ca-89638d2e97ca",
                                                "sense_id": "aeb0295d-5781-3cd4-b8f0-487dc83fc648",
                                                "text": "„Brumm, brumm! Jaguar fahren!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                        "entry_id": "0f7cd7f8-7381-32cf-ba77-ac1c95557460",
                                        "glosses": [
                                            "Laut, der beim Nachahmen eines Bärens entsteht."
                                        ],
                                        "tags": [
                                            "kindersprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2053302c-51a5-422f-82e1-2b6506934f62",
                                                "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                                "text": "„Wo Salomonis Tempel stand, / Liegt mancher dicke Stein; / […] / Er sprach: ›Den Stein, den nehm' ich mit!‹ / Der Bär, der macht: Brumm brumm! / Das hilft ihm aber alles nit, / Wir kümmern uns nicht drum.“ (Bär muss Reiter und Stein tragen)"
                                            },
                                            {
                                                "example_id": "1ca37946-8029-4acc-a2f2-eb75a311a88a",
                                                "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                                "text": "„Wenn der Tanzbär tanzen muß, / Tanzt er immer mit Verdruß, / Kann und mag nicht fröhlich sein, / Brummt in seinen Bart hinein: / Brumm brumm brumm.“"
                                            },
                                            {
                                                "example_id": "3c8cf719-2051-4a6b-b057-7aaad099f686",
                                                "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                                "text": "„Eines Tages aber stürmte ein großer brauner Bär in die Märchenhöhle. ‚Brumm‘, sagte er und schnaufte heftig dabei, ‚darf ich mich ein wenig an eurem warmen Feuer ausruhen?‘ […] ‚Ich bin Bruno der Bär und Freund des Königs, brumm. Heute war ich ein wenig spazieren im Märchenwald, aber, stellt euch vor, da war ein fremder Jäger, vor dem bin ich geflohen. Brumm brumm.‘“"
                                            },
                                            {
                                                "example_id": "44dff60f-aed0-43fe-a7ed-3e50ebffb6e2",
                                                "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                                "text": "(Kinderlied:) „Quak quak quak macht der Frosch Frosch Frosch… (hüpfen) / Brumm brumm brumm macht der Bär Bär Bär… (stapfen)“"
                                            },
                                            {
                                                "example_id": "08a0c65c-9b6b-4b73-9eaa-d3e83a7ff72d",
                                                "sense_id": "19641a4a-4b75-375d-866e-330a6e8d58b2",
                                                "text": "(Lied, Bären treffen sich im Waschsalon:) „Das gab ein großes Stelldichein… der eine wusch den and‘ren rein… / und alle sangen fröhlich mit, das tolle Bärenlied: / brumm… brumm… brumm… brumm… […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
