                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87b9fad-9b1a-477a-856d-07c06b1b62d6",
                                "sense_id": "5c00873e-cb82-396f-ab3e-35b049187f70",
                                "text": "Leraren in het basisonderwijs verdienen gemiddeld 14 procent minder dan vergelijkbare werknemers in het bedrijfsleven. Om de loonkloof te dichten is ruim 1,6 miljard euro nodig"
                            },
                            {
                                "example_id": "66124256-532f-4168-8b54-6f5fc2067054",
                                "sense_id": "5c00873e-cb82-396f-ab3e-35b049187f70",
                                "text": "Loonkloof bijna nergens zo groot als in Nederland: baas verdient 171 keer modaal"
                            },
                            {
                                "example_id": "12c9ea53-a756-4917-8605-b692543d5aaf",
                                "sense_id": "5c00873e-cb82-396f-ab3e-35b049187f70",
                                "text": "De loonkloof tussen de top van het bedrijfsleven en hun werknemers is zo groot dat de gemiddelde Nederlandse CEO in 3,1 werkdagen het gemiddelde jaarsalaris van een werknemer verdient."
                            }
