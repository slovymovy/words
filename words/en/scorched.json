{
    "word_family": [
        "scorch",
        "scorcher",
        "scorching"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f23bcd81-ff1b-3f93-bbaf-c3d1331959f6",
                    "sense_definition": "Dried, damaged or burnt by exposure to intense heat or sunlight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "heat_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scorched</w> earth was dry and cracked after the long summer heat.",
                            "target_lang_translations": {
                                "cs": "<w>Spálená</w> země byla po dlouhém letním horku suchá a popraskaná."
                            }
                        },
                        {
                            "text": "She accidentally left the iron on the shirt and left a <w>scorched</w> mark.",
                            "target_lang_translations": {
                                "cs": "Omylem nechala žehličku na košili a zanechala na ní <w>spálenou</w> skvrnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "burnt",
                        "charred",
                        "seared"
                    ],
                    "common_phrases": [
                        "scorched earth"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vysušený, poškozený nebo spálený v důsledku vystavení intenzivnímu žáru nebo slunečnímu záření."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spálený",
                                "target_lang_sense_clarification": "obecný výraz pro poškození žárem"
                            },
                            {
                                "target_lang_word": "ožehlý",
                                "target_lang_sense_clarification": "povrchově poškozený žárem"
                            },
                            {
                                "target_lang_word": "sežehnutý",
                                "target_lang_sense_clarification": "intenzivně zasažený plamenem nebo horkem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d95a475a-d42b-3925-9595-c70e10e6bf9b",
                    "sense_definition": "Simple past and past participle of <w>scorch</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "heat_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense fire <w>scorched</w> the wooden walls of the old barn.",
                            "target_lang_translations": {
                                "cs": "Intenzivní oheň <w>sežehl</w> dřevěné stěny staré stodoly."
                            }
                        },
                        {
                            "text": "The hot sun has <w>scorched</w> the grass in the backyard.",
                            "target_lang_translations": {
                                "cs": "Horké slunce <w>spálilo</w> trávu na zahradě."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of scorch"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa 'scorch' (spálit, sežehnout)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spálil",
                                "target_lang_sense_clarification": "minulý čas slovesa spálit"
                            },
                            {
                                "target_lang_word": "sežehl",
                                "target_lang_sense_clarification": "minulý čas slovesa sežehnout"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}