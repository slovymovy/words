                    {
                        "sense_id": "91f3bab8-421c-3435-a417-54e81baa9525",
                        "entry_id": "9db317f4-6e8c-3601-9a58-334175a970fd",
                        "glosses": [
                            "verbogen vorm van de stellende trap van ver"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "afdaed61-058d-4d0e-b4f9-be213d444565",
                                "sense_id": "91f3bab8-421c-3435-a417-54e81baa9525",
                                "text": "Ook nu nog houdt Pablo Picasso zich verre van de Andalusische stad Malaga, hoewel hij haar beroemdste zoon is."
                            },
                            {
                                "example_id": "66fe228d-3599-4c1a-9825-c037d818b4ea",
                                "sense_id": "91f3bab8-421c-3435-a417-54e81baa9525",
                                "text": "Ze was dan ook allang blij dat ze niet met mij mee hoefde op mijn verre reizen, maar was wel vanaf het begin mijn grootste supporter."
                            },
                            {
                                "example_id": "8427954f-7f96-44ed-a187-06d1dc008c77",
                                "sense_id": "91f3bab8-421c-3435-a417-54e81baa9525",
                                "text": "Ik keek naar het witte huis in de verre heuvels: de rode ramen, hoe klein het leek tussen de uitgestrekte, kleurige lappendeken van de velden eromheen."
                            }
                        ]
                    }
                ],
