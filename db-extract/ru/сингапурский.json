                    {
                        "sense_id": "a8b152c3-44fb-3941-aaea-114dc07b790d",
                        "entry_id": "320df9d2-b180-3877-9c18-ac3827053dcb",
                        "glosses": [
                            "Singaporean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b337caa-6035-4791-9cf9-79a87bfe67d1",
                                "sense_id": "a8b152c3-44fb-3941-aaea-114dc07b790d",
                                "text": "Осторо́жно и ме́дленно, как бу́дто высма́тривая та́йного врага́ в заса́де, подходи́ли мы в темноте́ к сингапу́рскому ре́йду.",
                                "translation": "Carefully and slowly, as if watching for a secret enemy in ambush, we sneaked up to the roads of Singapore in darkness.",
                                "english": "Carefully and slowly, as if watching for a secret enemy in ambush, we sneaked up to the roads of Singapore in darkness."
                            }
                        ]
                    }
