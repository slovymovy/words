                                "example_id": "88b45867-0528-43d6-8a34-763894e12a30",
                                "sense_id": "1ac12d26-db61-3981-adb2-f4267418d72f",
                                "text": "Il pratiquait aussi la rhabdomancie, mais en se cachant : à l’époque, ces bizarres pratiques pouvaient encore entraîner l’accusation de sorcellerie."
                            }
                        ]
                    }
