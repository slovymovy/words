                            {
                                "target_word": "gevallen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                        "entry_id": "9f98c53f-0b88-3f45-952f-2c6b7d7191f5",
                                        "glosses": [
                                            "voltooid deelwoord van vallen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eeb2e8e-40a4-433b-b3c5-2b4119f1a133",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Hij was gevallen, maar had zich niet bezeerd."
                                            },
                                            {
                                                "example_id": "2a8e2132-f4ef-4bf0-830b-706a82061c1e",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Er leek een last van mijn schouders gevallen na achtendertig jaar huwelijk."
                                            },
                                            {
                                                "example_id": "c8c9baef-b3c2-4111-b174-e626d9b29432",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "De volgende ochtend viel meteen op hoe stil het buiten was. Ik duwde de deur met beide handen open en zag dat er ’s nachts een dik pak sneeuw was gevallen, waarvan een stukje geel kleurde toen ik er mijn waterfles in leegde."
                                            },
                                            {
                                                "example_id": "65fc7026-0883-4462-a0ac-d8a73bba79f4",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Niet alleen door zijn 'schat', ze heeft ook gezien hoe ik Giorgos vastpakte nadat hij was gevallen en hem in een impuls op zijn mond kuste."
                                            },
                                            {
                                                "example_id": "3d24bf4a-b9da-446e-a4d8-22e9bcbca6c9",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "De gevallen sneeuw zorgde voor veel oponthoud."
                                            },
                                            {
                                                "example_id": "c6d26a5d-805b-488b-9e0a-eb4bae67d3f7",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Zij was een gevallen vrouw."
                                            },
                                            {
                                                "example_id": "2d76edd5-7b17-474c-977a-f8a98c230206",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Ze heeft iets van een gevallen engel, zoals ze daar zit op die steen."
                                            },
                                            {
                                                "example_id": "63d9a30e-a61a-4b4c-9b48-c8340c53c44d",
                                                "sense_id": "4f0c623c-d0dd-3b08-bd0f-6366e8f97169",
                                                "text": "Eenmaal gevallen behoort een demissionair kabinet geen nieuw beleid meer op gang te brengen."
                                            }
                                        ]
                                    }
                                ]
                            },
