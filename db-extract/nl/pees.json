                    {
                        "translation_id": "c2ef68b5-242c-40e2-a99a-df90e852b74c",
                        "source_entry_id": "e5469fd2-c19d-3939-b03c-a2de62674744",
                        "source_sense_id": "d62d0858-1549-32e8-a0cc-834711df0b23",
                        "source_sense_description": "een uitloper van spierweefsel die de spier aanhecht aan het bot",
                        "target_lang_word": "tendon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tendon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                        "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                                        "glosses": [
                                            "Partie fibreuse, blanchâtre, ronde ou aplatie, qui forme l’extrémité des muscles et qui sert à les attacher aux os ou à d’autres parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54c5c270-fe3e-4678-995e-ccbb4032237b",
                                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                                "text": "Le tendon d’un gros muscle."
                                            },
                                            {
                                                "example_id": "aceba367-cda3-4998-80d5-5925b68eed8e",
                                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                                "text": "Il y a des muscles à plusieurs tendons."
                                            },
                                            {
                                                "example_id": "65ad942b-d0e2-4907-9cab-b32ca69262e4",
                                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                                "text": "Avec son menton saillant et les tendons de son cou décharné, qui tirent sa peau, comme les cordes tirent les toiles d’une tente, elle ressemble aux sorcières qui jettent des sorts."
                                            },
                                            {
                                                "example_id": "be04d47c-7bfe-4dd0-99e0-ad2a25a1ff2b",
                                                "sense_id": "d998becf-363d-36ea-9215-60fae6e6ba11",
                                                "text": "Il avait été impressionné par cette tête d’une maigreur de bête sauvage et surtout par les tendons du cou, si apparents qu’ils semblaient des cordes attachant cette tête à ce froc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                        "entry_id": "9e79ca62-6ca7-3421-8ce9-d1c9afb7dba1",
                                        "glosses": [
                                            "Partie postérieure des jambes des chevaux."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42710def-60d8-4178-8adc-ebf266c67d4d",
                                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                                "text": "L’enclouure sera grave, si le pus, après avoir long-temps séjourné dans le pied, a carié l'os, ou si, après avoir fusé dessous la chair de la couronne, il a gâté, ou le tendon extenseur, ou le cartilage latéral, ou l'articulation."
                                            },
                                            {
                                                "example_id": "d7931282-97fc-4abb-9465-54d41e4e8c70",
                                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                                "text": "Ce cheval a le tendon bien détaché, bien net."
                                            },
                                            {
                                                "example_id": "3492f66d-7654-4ed5-883c-785dd78da463",
                                                "sense_id": "3ef7e6d5-7a5c-31e4-8b5e-d0668926659f",
                                                "text": "Il a le tendon engorgé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
