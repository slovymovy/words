                "senses": [
                    {
                        "sense_id": "1c0ca111-bd2c-3a06-bb05-6f5abb9ab28b",
                        "entry_id": "6bcfbba7-132b-3496-8be1-6d6e2df7460d",
                        "glosses": [
                            "In an active manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0528a37-3c1a-4c97-9ee0-e0f440632f22",
                                "sense_id": "1c0ca111-bd2c-3a06-bb05-6f5abb9ab28b",
                                "text": "He was actively listening."
                            },
                            {
                                "example_id": "eb87bfd8-19c2-492e-9867-9914cc68e11f",
                                "sense_id": "1c0ca111-bd2c-3a06-bb05-6f5abb9ab28b",
                                "text": "She was actively working, not “sleeping on the job”."
                            },
                            {
                                "example_id": "4da72efe-6909-42cb-86a0-35161001e5db",
                                "sense_id": "1c0ca111-bd2c-3a06-bb05-6f5abb9ab28b",
                                "text": "Defying this, Western queer culture actively defuses from cisnormative values, yet in so doing may also fuse with their new, queernormative value constructs."
                            },
                            {
                                "example_id": "c6b4ad66-d52e-4934-916f-d728dcff9440",
                                "sense_id": "1c0ca111-bd2c-3a06-bb05-6f5abb9ab28b",
                                "text": "It makes me feel better that I’m not the only one who fantasizes about being struck down by a meteor on my way to work. Mind you, I’m not actively suicidal at all. I just kinda think being dead without actually killing myself would be easier and way less exhausting.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "8c22587c-afac-36d2-ba86-1733b88f7d5a",
                        "entry_id": "6bcfbba7-132b-3496-8be1-6d6e2df7460d",
                        "glosses": [
                            "In the active form; not passive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0d71c6-6071-4a5b-af80-e910c7ad77d8",
                                "sense_id": "8c22587c-afac-36d2-ba86-1733b88f7d5a",
                                "text": "a word used actively"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6eb3c8ee-6cf0-4634-befe-bec6d7b16025",
