                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ece2ed-9add-49b6-b9a7-22274575e36d",
                                                "sense_id": "f53e712b-3067-321f-a8d5-dbb2c2c50eaf",
                                                "text": "Drei mal sieben sind einundzwanzig."
                                            },
                                            {
                                                "example_id": "931f8395-6ee0-4b1e-b804-1d3a960a5cdf",
                                                "sense_id": "f53e712b-3067-321f-a8d5-dbb2c2c50eaf",
                                                "text": "„Der Lieferant arbeitet jetzt schon sechs Monate in diesem Job, nach seinen Maßstäben eine lange und erfüllte Zeit, und hat noch nie länger als einundzwanzig Minuten gebraucht, um eine Pizza zuzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3c6f0b4-f52d-35e3-bee8-9cd4ae1ab917",
                                        "entry_id": "d00ec59f-7f94-3403-bfd8-faa00a8b5602",
                                        "glosses": [
                                            "einundzwanzig Jahre (alt)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55ae8988-a567-4827-acd4-a2e22650d149",
                                                "sense_id": "d3c6f0b4-f52d-35e3-bee8-9cd4ae1ab917",
                                                "text": "Früher wurde man mit einundzwanzig volljährig."
                                            },
                                            {
                                                "example_id": "513653d6-e053-4365-af22-b59bd8ae8cdf",
                                                "sense_id": "d3c6f0b4-f52d-35e3-bee8-9cd4ae1ab917",
                                                "text": "„Ich war einundzwanzig, als ich zur Army gegangen bin, und bei der Grundausbildung war ich in meinem Kurs einer der Ältesten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
