                ],
                "senses": [
                    {
                        "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                        "entry_id": "5fe2b223-4a01-3e25-980a-76485751a9ec",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca75c94-3b77-4bf5-be7d-ac7083d04db3",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Frau Startz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d7f35aa4-b3b1-49b2-9a71-0b89cd62cb05",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Herr Startz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2e5bd68f-9fea-422e-9a46-dcdca31e2b83",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Die Startzens kommen heute aus den Alpen."
                            },
                            {
                                "example_id": "1a188e82-e1fa-4a0e-a711-a711c372f149",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Der Startz trägt nie die Schals, die die Startz ihm strickt."
                            },
                            {
                                "example_id": "0b825925-b520-46b1-bef1-61a7405caf56",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Startz kommt, geht der Herr Startz.“"
                            },
                            {
                                "example_id": "0e76d79b-7a63-467a-994c-58cca787febd",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Startz kommt und geht."
                            },
                            {
                                "example_id": "f252c03e-1c33-4c93-9ba3-3748cc464dbe",
                                "sense_id": "c7ef5186-ba68-3d49-aab7-6b50bcaf729f",
                                "text": "Startzens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
