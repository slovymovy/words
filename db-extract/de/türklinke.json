                "senses": [
                    {
                        "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                        "entry_id": "5fc2f182-d275-3c83-99b0-85b46467b594",
                        "glosses": [
                            "Griff zum Öffnen und Schließen der Tür"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5293550-59b8-4104-8cb5-5101bb95c140",
                                "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                                "text": "Der Detektiv war schon am Gehen und hatte die Türklinke in der Hand, als ihm noch eine wichtige Frage einfiel."
                            },
                            {
                                "example_id": "2a8267b5-9297-4017-8cca-b0397462d0a9",
                                "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                                "text": "„Ich lege die Hand auf die Türklinke der Badezimmertür und halte noch einmal inne.“"
                            },
                            {
                                "example_id": "860070a3-5333-428f-8291-9357b3c9e3a5",
                                "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                                "text": "„Die Türklinke, über deren Unsauberkeit sich die Gräfin so häufig geärgert hatte, gab noch ebenso kraftlos nach wie früher.“"
                            },
                            {
                                "example_id": "660c53bf-be28-45d3-bb88-7f3bd920857a",
                                "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                                "text": "„Ich ließ die Türklinke los und wanderte zurück in das Labyrinth, das ich kannte.“"
                            },
                            {
                                "example_id": "9cb91d98-edfe-408b-9b82-560b03afde0e",
                                "sense_id": "c96aae60-78fb-3288-a51c-11cae62a8977",
                                "text": "„Elma versuchte, ruhig zu atmen, als sie zur kalten Türklinke griff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
