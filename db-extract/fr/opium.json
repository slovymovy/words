                                    {
                                        "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                        "entry_id": "87837576-8f6a-3d8b-9760-9d9ef6846d1f",
                                        "glosses": [
                                            "getrockneter Milchsaft unreifer Samenkapseln des Schlafmohns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c6330ff-6eeb-49a2-8d64-b2aa97e79ce6",
                                                "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                                "text": "Der Anbau von Schlafmohn zur Gewinnung von Opium ist in Afghanistan noch immer verbreitet."
                                            },
                                            {
                                                "example_id": "adab110a-7bee-46b8-92a4-d42ec3b2c3ee",
                                                "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                                "text": "„Sie sind mit Opium getränkt, wenn ihr wißt, was das ist.“"
                                            },
                                            {
                                                "example_id": "5e1cc239-a2ae-41bc-b01c-d25547350158",
                                                "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                                "text": "„Ein Glücksrausch hebt an, denn Opium macht einen zu aller Welt Freund.“"
                                            },
                                            {
                                                "example_id": "cc077333-4e84-42af-ac25-59a42b03d0ff",
                                                "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                                "text": "„Welchen Zoll fordern weltweit alle die anderen bewußtseinsverändernden Drogen wie Kokain, Heroin, Opium und so weiter?“"
                                            },
                                            {
                                                "example_id": "cfa0c5fd-8117-474c-b804-6579bb53f7ce",
                                                "sense_id": "be3a9c91-3685-3963-8900-28ffceaec376",
                                                "text": "„Lieber beschäftigte er sich mit schönen Frauen, rauchte Opium und veranstaltete Hahnenkämpfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
