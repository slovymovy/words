    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e59ee38-dffb-3ff3-91f0-1711554d4015",
                    "sense_definition": "een kapje of deksel dat wordt gebruikt om een fles of tube af te sluiten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om de <w>dop</w> weer op de fles te draaien.",
                            "target_lang_translations": {
                                "en": "Don't forget to screw the <w>cap</w> back onto the bottle."
                            }
                        },
                        {
                            "text": "Hij kon de <w>dop</w> losdraaien om een glas in te schenken.",
                            "target_lang_translations": {
                                "en": "He was able to unscrew the <w>cap</w> to pour a glass."
                            }
                        }
                    ],
                    "synonyms": [
                        "flessendop"
                    ],
                    "common_phrases": [
                        "dop losdraaien",
                        "dop erop draaien"
                    ],
                    "target_lang_definitions": {
                        "en": "A small cap or lid used to seal a bottle or tube."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cap",
                                "target_lang_sense_clarification": "a protective cover or seal for a bottle"
                            },
                            {
                                "target_lang_word": "lid",
                                "target_lang_sense_clarification": "a removable or hinged cover for a container"
                            },
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "the upper part or closure of a bottle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49d1cb70-85da-36b1-8472-60e9c90cdbc6",
                    "sense_definition": "het harde, beschermende omhulsel van een vrucht of zaad, zoals bij een noot",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omhulsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Om de walnoot te kunnen eten, moet je eerst de <w>dop</w> kraken.",
                            "target_lang_translations": {
                                "en": "To be able to eat the walnut, you first have to crack the <w>shell</w>."
                            }
                        },
                        {
                            "text": "De eekhoorn liet de lege <w>dop</w> van de noot op de grond vallen.",
                            "target_lang_translations": {
                                "en": "The squirrel dropped the empty <w>shell</w> of the nut on the ground."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de dop kraken"
                    ],
                    "target_lang_definitions": {
                        "en": "The hard, protective outer covering of a fruit or seed, such as a nut."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "the hard outer case of a nut or seed"
                            },
                            {
                                "target_lang_word": "husk",
                                "target_lang_sense_clarification": "the dry outer covering of some fruits or seeds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac8f6644-bf2a-3404-a8d9-6cd13c1bfd5a",
                    "sense_definition": "de harde buitenkant van een ei; een eierschaal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omhulsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beter een half ei dan een lege <w>dop</w>.",
                            "target_lang_translations": {
                                "en": "Better half an egg than an empty <w>shell</w>."
                            }
                        },
                        {
                            "text": "Er zaten nog kleine stukjes <w>dop</w> in het gebakken ei.",
                            "target_lang_translations": {
                                "en": "There were still small pieces of <w>shell</w> in the fried egg."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lege dop"
                    ],
                    "target_lang_definitions": {
                        "en": "The hard exterior of an egg; an eggshell."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eggshell",
                                "target_lang_sense_clarification": "the brittle outer layer of an egg"
                            },
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "the hard outer covering of an egg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee1f5a7-50b0-3a3b-abeb-93980a1d7c26",
                    "sense_definition": "een metalen hulpstuk van een dopsleutel dat precies over een bout of moer past",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de gereedschapskist ligt een kruisleutel met vier verschillende <w>doppen</w>.",
                            "target_lang_translations": {
                                "en": "In the toolbox is a lug wrench with four different <w>sockets</w>."
                            }
                        },
                        {
                            "text": "Welke maat <w>dop</w> heb ik nodig voor deze wielmoer?",
                            "target_lang_translations": {
                                "en": "What size <w>socket</w> do I need for this wheel nut?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dop van de dopsleutel"
                    ],
                    "target_lang_definitions": {
                        "en": "A metal attachment for a socket wrench that fits precisely over a bolt or nut."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "socket",
                                "target_lang_sense_clarification": "the detachable head for a socket wrench"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a1305b5-76d6-3abd-8d47-680ce740aac3",
                    "sense_definition": "een informele term voor de ogen of oogleden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet goed uit je <w>doppen</w> kijken als je daar oversteekt.",
                            "target_lang_translations": {
                                "en": "You have to keep your <w>eyes</w> peeled when you cross there."
                            }
                        },
                        {
                            "text": "Hij deed zijn <w>doppen</w> pas open toen de wekker voor de derde keer ging.",
                            "target_lang_translations": {
                                "en": "He didn't open his <w>peepers</w> until the alarm went off for the third time."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uit je doppen kijken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik voor ogen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal or slang term for the eyes or eyelids."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peepers",
                                "target_lang_sense_clarification": "slang for eyes"
                            },
                            {
                                "target_lang_word": "eyes",
                                "target_lang_sense_clarification": "the organs of sight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65e8d839-57e5-3a0c-8257-86828c042161",
                    "sense_definition": "een informele term voor een werkloosheidsuitkering",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sociaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zijn ontslag moest hij een tijdje van de <w>dop</w> leven.",
                            "target_lang_translations": {
                                "en": "After his dismissal, he had to live off the <w>dole</w> for a while."
                            }
                        },
                        {
                            "text": "Hij zit al maanden op de <w>dop</w> en zoekt hard naar een nieuwe baan.",
                            "target_lang_translations": {
                                "en": "He has been on <w>unemployment</w> for months and is looking hard for a new job."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de dop zijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "voornamelijk in België gebruikt voor werkloosheidsuitkering"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal term for unemployment benefits, primarily used in Belgium."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dole",
                                "target_lang_sense_clarification": "informal term for unemployment benefit"
                            },
                            {
                                "target_lang_word": "unemployment benefit",
                                "target_lang_sense_clarification": "money paid by the state to unemployed people"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3297bbb-ce8f-393c-a59f-8cd075fd2f99",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>doppen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dop</w> mijn eigen boontjes wel en heb geen hulp nodig.",
                            "target_lang_translations": {
                                "en": "I'll <w>fend</w> for myself and don't need any help."
                            }
                        },
                        {
                            "text": "Elke avond <w>dop</w> ik de verse erwten voor het avondeten.",
                            "target_lang_translations": {
                                "en": "Every evening I <w>shell</w> the fresh peas for dinner."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to shell' or 'to pod'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "to remove the outer covering of peas or beans"
                            },
                            {
                                "target_lang_word": "pod",
                                "target_lang_sense_clarification": "to remove seeds from a pod"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a361eae6-9699-3226-a439-83dd4b1c7ea4",
                    "sense_definition": "de gebiedende wijs van <w>doppen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dop</w> die bonen nu eindelijk eens, we moeten gaan koken!",
                            "target_lang_translations": {
                                "en": "<w>Shell</w> those beans finally, we need to start cooking!"
                            }
                        },
                        {
                            "text": "<w>Dop</w> je eigen boontjes en bemoei je niet met mij.",
                            "target_lang_translations": {
                                "en": "<w>Look after</w> yourself and don't meddle with me."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'to shell' or 'to pod'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "command to remove the outer covering"
                            },
                            {
                                "target_lang_word": "pod",
                                "target_lang_sense_clarification": "command to remove seeds from a pod"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}