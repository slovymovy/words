{
    "word_family": [
        "arm",
        "armament",
        "armored",
        "armory",
        "disarm",
        "rearm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                    "sense_definition": "A large, highly organized military force, concerned mainly with ground operations.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "military_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>army</w> was sent in to quell the uprising in the capital city.",
                            "target_lang_translations": {
                                "ru": "<w>Армия</w> была направлена на подавление восстания в столице."
                            }
                        },
                        {
                            "text": "He decided to join the <w>army</w> right after finishing high school.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти в <w>армию</w> сразу после окончания школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "host"
                    ],
                    "common_phrases": [
                        "join the army",
                        "standing army",
                        "army officer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное, высокоорганизованное военное формирование, предназначенное в основном для наземных операций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армия",
                                "target_lang_sense_clarification": "вооруженные силы государства"
                            },
                            {
                                "target_lang_word": "войско",
                                "target_lang_sense_clarification": "вооруженная сила, армия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "788b475b-f6b1-354b-99cb-269bbb3271c3",
                    "sense_definition": "A specific branch of the armed forces, distinct from the navy or air force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>army</w> received a bigger share of this year's budget increase than the navy.",
                            "target_lang_translations": {
                                "ru": "<w>Сухопутные войска</w> получили большую долю бюджетных средств в этом году, чем флот."
                            }
                        },
                        {
                            "text": "She serves as a pilot in the <w>army</w> rather than the air force.",
                            "target_lang_translations": {
                                "ru": "Она служит пилотом в <w>армейской</w> авиации, а не в ВВС."
                            }
                        }
                    ],
                    "common_phrases": [
                        "regular army"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид вооруженных сил, отличный от военно-морского флота или военно-воздушных сил; сухопутные войска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сухопутные войска",
                                "target_lang_sense_clarification": "вид вооруженных сил"
                            },
                            {
                                "target_lang_word": "армия",
                                "target_lang_sense_clarification": "в противопоставлении флоту и авиации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                    "sense_definition": "A large group of people or animals working toward the same purpose or moving together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "multitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took an <w>army</w> of accountants to uncover the fraud in the company.",
                            "target_lang_translations": {
                                "ru": "Потребовалась целая <w>армия</w> бухгалтеров, чтобы раскрыть мошенничество в компании."
                            }
                        },
                        {
                            "text": "Our house is being attacked by an <w>army</w> of ants in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Наш дом атакует <w>полчище</w> муравьев на кухне."
                            }
                        }
                    ],
                    "synonyms": [
                        "host",
                        "here"
                    ],
                    "common_phrases": [
                        "army of volunteers",
                        "army of ants",
                        "army of supporters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая группа людей или животных, работающих ради общей цели или движущихся вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армия",
                                "target_lang_sense_clarification": "переносное значение, множество"
                            },
                            {
                                "target_lang_word": "полчище",
                                "target_lang_sense_clarification": "огромное количество, обычно о насекомых или врагах"
                            },
                            {
                                "target_lang_word": "орда",
                                "target_lang_sense_clarification": "неорганизованная толпа или масса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "985d988e-d99d-39be-b4a6-74fe457de1f6",
                    "sense_definition": "A very large tactical unit within a military, typically consisting of several divisions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Fourth <w>Army</w> suffered such losses that its remainders were merged into the Second <w>Army</w>.",
                            "target_lang_translations": {
                                "ru": "Четвертая <w>армия</w> понесла такие потери, что ее остатки были слиты со Второй <w>армией</w>."
                            }
                        },
                        {
                            "text": "The general commanded the entire third <w>army</w> during the winter campaign.",
                            "target_lang_translations": {
                                "ru": "Генерал командовал всей третьей <w>армией</w> во время зимней кампании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "field army"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное оперативное объединение в составе вооруженных сил, обычно состоящее из нескольких корпусов или дивизий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армия",
                                "target_lang_sense_clarification": "оперативное войсковое соединение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9146e2-1083-3c73-b244-89b3fd0d2eed",
                    "sense_definition": "An individual fan or the collective fandom of the K-pop boy band BTS.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with <w>ARMYs</w> decked out in their favorite band merchandise.",
                            "target_lang_translations": {
                                "ru": "Комната была заполнена <w>АРМИ</w>, одетыми в мерч их любимой группы."
                            }
                        },
                        {
                            "text": "As a dedicated <w>ARMY</w>, she never misses a single live stream or concert.",
                            "target_lang_translations": {
                                "ru": "Как преданная <w>АРМИ</w>, она не пропускает ни одной трансляции или концерта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to K-pop culture"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Used within fan communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный фанат или коллективное название фан-сообщества K-pop группы BTS."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "АРМИ",
                                "target_lang_sense_clarification": "название фандома группы BTS"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e3aa5969-ae5c-3f0e-b658-2d4cee676b10",
                    "sense_definition": "The sports teams representing the United States Military Academy at West Point.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "<w>Army</w> has several returning starters this year for the football season.",
                            "target_lang_translations": {
                                "ru": "У команды <w>Арми</w> в этом футбольном сезоне вернулись в строй несколько игроков стартового состава."
                            }
                        },
                        {
                            "text": "The annual game between <w>Army</w> and Navy is a major sporting event.",
                            "target_lang_translations": {
                                "ru": "Ежегодная игра между командами <w>Арми</w> и Нейви — важное спортивное событие."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивные команды, представляющие Военную академию США в Вест-Пойнте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Арми",
                                "target_lang_sense_clarification": "название спортивной команды академии Вест-Пойнт"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}