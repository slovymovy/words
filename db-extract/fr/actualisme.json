                    {
                        "translation_id": "630f9795-e14f-4aa7-8ddb-ec35fcea38c2",
                        "source_entry_id": "eb6e2cf2-49b2-386a-9b5b-fdde75068dd1",
                        "source_sense_description": "À trier",
                        "target_lang_word": "Aktualismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktualismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c37960-4d57-3f6e-9fe9-4c9df05ced5d",
                                        "entry_id": "e617a76a-3f49-31a2-8eaa-1256527b1549",
                                        "glosses": [
                                            "Prinzip, dass man aus heutigen geologischen Prozessen auf die Entwicklung in der Vergangenheit schließen könne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f717d3a-54ed-4425-8e4e-bd2b66caa344",
                                                "sense_id": "a8c37960-4d57-3f6e-9fe9-4c9df05ced5d",
                                                "text": "„Der Aktualismus wurde als Hypothese mehrfach angefochten, zuletzt durch die Vertreter der Historizität. Dieser Begriff besagt, dass die Naturgesetze sich mit den Bedingungen in geologischen Zeiträumen geändert haben können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9dbfc1b-d58e-3bec-9f48-f37b155625be",
                                        "entry_id": "e617a76a-3f49-31a2-8eaa-1256527b1549",
                                        "glosses": [
                                            "philosophische Auffassung, dass es ein ewiges Kommen und Gehen, einen ständigen Wandel gebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e93f1a5-ca5a-4124-b4e9-b6876054192d",
                                                "sense_id": "f9dbfc1b-d58e-3bec-9f48-f37b155625be",
                                                "text": "„Aktualismus […] ist in der Philosophie ein mehrdeutiger Ausdruck, der verschiedene Lehren der Betonung des Aktes (der Tätigkeit, des Wirkens, des Prozesses, der Evolution, des Werdens etc.) unter Hintanstellung, Relativierung oder Leugnung der Existenz oder Wirkmacht „unveränderlicher idealer Formen“ (Träger, Substanzen) bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
