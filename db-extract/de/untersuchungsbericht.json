                "senses": [
                    {
                        "sense_id": "e9dc0bcc-438f-3f2c-ad7f-b6fa4a69d86f",
                        "entry_id": "15ef783e-7e3c-32c6-92db-fe7bec208c61",
                        "glosses": [
                            "Bericht über das Ergebnis der Untersuchung eines bestimmten Sachverhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c856b63a-6aa0-4cc1-99ab-a44ac1781e95",
                                "sense_id": "e9dc0bcc-438f-3f2c-ad7f-b6fa4a69d86f",
                                "text": "„Dass aber eine Reaktion erfolgen würde und musste, war klar. Spätestens, wenn der Untersuchungsbericht über den Mordanschlag vorliegen würde, an dem österreichische Kriminalbeamte arbeiteten.“"
                            },
                            {
                                "example_id": "7c4c8bcb-655c-4768-acba-600f56a52383",
                                "sense_id": "e9dc0bcc-438f-3f2c-ad7f-b6fa4a69d86f",
                                "text": "„Auf die Frage, ob und wie das Desaster hätte vermieden werden können, findet sich im Untersuchungsbericht leider keine Antwort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
