{
    "word": "suffocation",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b545f1df-a192-3a12-bb02-1a03af3367b8",
                "word": "suffocation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b9bd9827-9d96-4151-b08d-64465598716a",
                        "entry_id": "b545f1df-a192-3a12-bb02-1a03af3367b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "suffocations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34a19753-ae3c-3f59-9a84-f47bcb01c31b",
                        "entry_id": "b545f1df-a192-3a12-bb02-1a03af3367b8",
                        "glosses": [
                            "Asphyxia—a condition in which an extreme decrease in the concentration of oxygen in the body accompanied by an increase in the concentration of carbon dioxide leads to loss of consciousness or death."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a47513b0-1f50-4a23-8d6d-f64e6145c8eb",
                                "sense_id": "34a19753-ae3c-3f59-9a84-f47bcb01c31b",
                                "text": "A child left unattended may die of suffocation."
                            },
                            {
                                "example_id": "7889939f-cbba-4d30-b9c0-42a75278b595",
                                "sense_id": "34a19753-ae3c-3f59-9a84-f47bcb01c31b",
                                "text": "The moon, directly opposite, flung into the room a long and tremulous line of light, which fell on Guido's face, as he reclined on the pillows which supported his head; he needed the support, for a feeling of suffocation was his constant complaint."
                            }
                        ]
                    },
                    {
                        "sense_id": "f16048b3-1c97-354b-b179-38ba4807b154",
                        "entry_id": "b545f1df-a192-3a12-bb02-1a03af3367b8",
                        "glosses": [
                            "A particular act of death or killing by means of asphyxia."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5a6b94-1bce-42f1-918e-cb9aaafdb69a",
                                "sense_id": "f16048b3-1c97-354b-b179-38ba4807b154",
                                "text": "The coroner reported three suffocations last week."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e76f93cd-546b-4d7e-a912-046f0700bb1f",
                        "source_entry_id": "b545f1df-a192-3a12-bb02-1a03af3367b8",
                        "source_sense_description": "asphyxia",
                        "target_lang_word": "verstikking",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstikking",
