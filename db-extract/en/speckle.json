                                            {
                                                "example_id": "a991a85c-4816-4473-a962-9ece66674cd2",
                                                "sense_id": "794341d1-69a1-3f14-b340-5f1b04efc12c",
                                                "text": "Seit Jahren treffen sie sich am selben Fleck."
