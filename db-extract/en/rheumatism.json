                                "target_senses": [
                                    {
                                        "sense_id": "7fa090e3-8eed-3e6a-ace2-756d8bc0b23b",
                                        "entry_id": "4f87331c-3691-3b9b-a855-5cf307d40713",
                                        "glosses": [
                                            "schorzenie narządów ruchu charakteryzujące się bólami i zmianami zwyrodnieniowymi w stawach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1578ecdb-b066-4342-9c8f-97a438685f8b",
                                                "sense_id": "7fa090e3-8eed-3e6a-ace2-756d8bc0b23b",
                                                "text": "Palce powykręcane przez reumatyzm przypominały sękate brzozowe patyki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0676ebb9-68e8-4a47-9350-7e4cac01c0b1",
                        "source_entry_id": "77bac427-c605-35f7-9c18-f9624054da52",
                        "source_sense_description": "any painful disorder of muscles, tendons, joints, bones and nerves",
                        "target_lang_word": "ревмати́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ревмати́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                        "entry_id": "167f364b-054c-3179-8ddb-3d2816a0aae9",
                                        "glosses": [
                                            "мед. системное воспалительное заболевание соединительной ткани с преимущественным поражением сердечно-сосудистой системы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc434c6e-a729-4c36-9c3f-6676a47d9336",
                                                "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                                "text": "Если перевести монолог Гертруды Борисовны на строгий язык фактов, то получилось бы, что Монька в недавнем времени переболела ревматизмом, осложнённым тяжёлым пороком сердца."
                                            },
                                            {
                                                "example_id": "e0bd1b64-03a3-48df-b6ca-538db189063d",
                                                "sense_id": "c749226a-b4a6-3b75-bd5a-4ff12abadf02",
                                                "text": "Ревматоидный артрит, вопреки тому, что принято о нем думать, никак не связан с ревматизмом, поражающим сердце (с толку сбивает латинский корень «ревма», означающий «длительное течение»)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                        "entry_id": "167f364b-054c-3179-8ddb-3d2816a0aae9",
                                        "glosses": [
                                            "разг. то же, что ревматоидный артрит; заболевание опорно-двигательного аппарата, обычно сопровождающаяся острыми болями и ломотой в суставах, возникающие с возрастом или в результате простуды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380f8048-08aa-43a7-9046-243554817c0b",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Я несколько дней не выходил из дому от сильного ревматизма в правой руке."
                                            },
                                            {
                                                "example_id": "1457e127-c328-440b-a291-a15410b52063",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Он богат и страдает ревматизмами."
                                            },
                                            {
                                                "example_id": "8c14bfe8-d613-439a-9ed1-1879660f56d8",
                                                "sense_id": "2f9c0fa0-1b6c-3508-9c56-108461cd1104",
                                                "text": "Да и руки тоже болели у старика ― сказывался старческий ревматизм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
