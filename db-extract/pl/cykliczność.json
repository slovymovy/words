                                "target_senses": [
                                    {
                                        "sense_id": "8174e312-91ad-321e-89cc-934fa8cacd34",
                                        "entry_id": "a579345f-7e4d-357e-a9eb-b801be3f6867",
                                        "glosses": [
                                            "книжн. свойство по значению прилагательного цикличный; повторяемость, постоянное возвращение к исходному состоянию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b184402c-72ec-49b6-92d3-3903a949ac03",
                                                "sense_id": "8174e312-91ad-321e-89cc-934fa8cacd34",
                                                "text": "Наконец, внимание человека было привлечено цикличностью некоторых биологических процессов, которые по времени совпадали с циклами активности Солнца."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07bd7895-df17-3b5d-a58f-444b9ed9e1b5",
                                        "entry_id": "a579345f-7e4d-357e-a9eb-b801be3f6867",
                                        "glosses": [
                                            "экон. система организации производства, при которой оно состоит из производственных циклов, осуществляемых строго по графику"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6acf3e-4bd3-476b-801c-4013ec889bd3",
                                                "sense_id": "07bd7895-df17-3b5d-a58f-444b9ed9e1b5",
                                                "text": "Хотя нефтяная промышленность отличается от угольной, но на совещании было уделено внимание внедрению цикличности и в нефтяную промышленность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d72993-da57-4575-b998-8caae0b5f3bf",
                        "source_entry_id": "ea2a58db-a508-3c90-9094-e6423db10ad6",
                        "source_sense_id": "c26b2d8d-68ea-39e7-9f27-801bd38c92d2",
                        "target_lang_word": "круговоро́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "круговоро́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d1386a15-539b-36a0-9cf1-1d224cd92feb",
                                        "entry_id": "86c21f42-15a1-3820-bcda-fe9d5ea98ee5",
                                        "glosses": [
                                            "беспрерывный, периодически повторяющийся процесс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b959f93f-ceea-4950-99f5-1051ec8b006b",
                                                "sense_id": "d1386a15-539b-36a0-9cf1-1d224cd92feb",
                                                "text": "Так образовался круговорот: чем больше люди уходили в общественность, тем больше калечилось их сознание, а чем больше оно калечилось, тем жаднее оно бросалось на общественность."
                                            },
                                            {
                                                "example_id": "e0084e9e-90ec-46e1-a59b-98ff554ef8a0",
                                                "sense_id": "d1386a15-539b-36a0-9cf1-1d224cd92feb",
                                                "text": "Участвуя в едином окислительно-восстановительном процессе, растения содействуют круговороту веществ в природе, сохранению постоянства состава кислорода и углекислоты в воздухе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc32d2b-018e-33fd-b643-9aafa0b8f488",
                                        "entry_id": "86c21f42-15a1-3820-bcda-fe9d5ea98ee5",
                                        "glosses": [
                                            "беспрерывное движение, изменение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63a510b-1431-4499-917d-9a44af55c3ec",
                                                "sense_id": "7cc32d2b-018e-33fd-b643-9aafa0b8f488",
                                                "text": "Пришла революция 1848 рода и увлекла меня в свой круговорот, прежде чем я что-нибудь сделал для спасения моего состояния."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
