                                            {
                                                "example_id": "be4760f2-ce6c-4692-a003-d4a48438bb43",
                                                "sense_id": "04038175-5288-33b7-b979-310eaaa5bac0",
                                                "text": "Народная голландская мудрость гласит: «Чтобы сделать пиво, нужны солод, холод и совесть»."
                                            },
                                            {
                                                "example_id": "b9318d33-0a37-46db-896e-7ecae39d13a6",
                                                "sense_id": "04038175-5288-33b7-b979-310eaaa5bac0",
                                                "text": "Недоверие и жадность бродили в нём, как солод и ячмень в молодом пиве."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
