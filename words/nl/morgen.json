        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56a1d063-9655-3d15-a557-50e92164b982",
                    "sense_definition": "Het eerste deel van de dag, vanaf zonsopgang tot de middag.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de <w>morgen</w> drink ik altijd een kopje koffie.",
                            "target_lang_translations": {
                                "en": "In the <w>morning</w> I always drink a cup of coffee.",
                                "ru": "<w>Утром</w> я всегда пью чашку кофе.",
                                "pl": "<w>Rano</w> zawsze piję filiżankę kawy.",
                                "de": "Am <w>Morgen</w> trinke ich immer eine Tasse Kaffee.",
                                "fr": "Le <w>matin</w>, je bois toujours une tasse de café.",
                                "it": "La <w>mattina</w> bevo sempre una tazza di caffè.",
                                "cs": "Ráno (<w>v dopoledních hodinách</w>) piji vždy šálek kávy.",
                                "tr": "<w>Sabahları</w> her zaman bir fincan kahve içerim.",
                                "es": "Por la <w>mañana</w> siempre tomo una taza de café."
                            }
                        },
                        {
                            "text": "Het was een koude <w>morgen</w> in december.",
                            "target_lang_translations": {
                                "en": "It was a cold <w>morning</w> in December.",
                                "ru": "Было холодное декабрьское <w>утро</w>.",
                                "pl": "To był zimny grudniowy <w>poranek</w>.",
                                "de": "Es war ein kalter <w>Morgen</w> im Dezember.",
                                "fr": "C'était un <w>matin</w> froid en décembre.",
                                "it": "Era una fredda <w>mattina</w> di dicembre.",
                                "cs": "Bylo to chladné prosincové <w>ráno</w>.",
                                "tr": "Aralık ayında soğuk bir <w>sabahtı</w>.",
                                "es": "Fue una <w>mañana</w> fría de diciembre."
                            }
                        }
                    ],
