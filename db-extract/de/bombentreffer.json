                "senses": [
                    {
                        "sense_id": "c73f7a20-0507-30d7-9972-e200e0a4360c",
                        "entry_id": "69ae1599-5a16-316c-a851-468326ec4819",
                        "glosses": [
                            "Bombe, die ihr geplantes Ziel erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7009c00c-1093-4ff9-a1bc-a97d37740a8a",
                                "sense_id": "c73f7a20-0507-30d7-9972-e200e0a4360c",
                                "text": "„Strauß wurde verschüttet, ein Freund, der ihn noch gewarnt hatte, war unter den 38 Toten, die bei einem Bombentreffer in der Ichoschule starben.“"
                            },
                            {
                                "example_id": "8b79890f-1a53-4046-bcde-ff98fe3c9462",
                                "sense_id": "c73f7a20-0507-30d7-9972-e200e0a4360c",
                                "text": "„Dass der Dom trotz großer Schäden 70 Bombentreffer im Zweiten Weltkrieg überstanden hat, liegt auch an der Dacheisenkonstruktion des 19. Jahrhunderts.“"
                            },
                            {
                                "example_id": "895aac92-5b8d-4609-8525-19e1796ae6f3",
                                "sense_id": "c73f7a20-0507-30d7-9972-e200e0a4360c",
                                "text": "„Der vertraute Umriß ist noch erhalten, aber schon von weitem sind an hellen Stellen zwei Bombentreffer im Seitenschiff zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
