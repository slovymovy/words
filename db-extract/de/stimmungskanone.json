                                    },
                                    {
                                        "sense_id": "7ca6cbfa-965f-339c-bdb9-6e9911715663",
                                        "entry_id": "e23d0716-c7bd-3476-aca4-06b694b0bb4d",
                                        "glosses": [
                                            "Celui qui excite les autres à la joie, qui met tout le monde en mouvement et en gaieté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce07bf53-455f-475d-811d-c69ed662adb8",
                                                "sense_id": "7ca6cbfa-965f-339c-bdb9-6e9911715663",
                                                "text": "C’est le boutentrain de la compagnie."
                                            },
                                            {
                                                "example_id": "16bd32f4-a291-44a8-a7f1-d1825b7b1b29",
                                                "sense_id": "7ca6cbfa-965f-339c-bdb9-6e9911715663",
                                                "text": "Craignant de ne pas être aimable, l’éternel optimiste s’oblige à porter un masque de bonne humeur permanente et à être le boutentrain de la soirée."
                                            }
                                        ]
                                    }
