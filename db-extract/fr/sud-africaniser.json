                ],
                "senses": [
                    {
                        "sense_id": "2205ee7f-3689-3037-bfb6-9baf0cbb4c3d",
                        "entry_id": "4e42002d-786b-3582-9eec-6500ba2d757a",
                        "glosses": [
                            "Donner un caractère sud-africain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "934dd7d0-bcc6-45dc-92c6-b26f49908a7f",
                                "sense_id": "2205ee7f-3689-3037-bfb6-9baf0cbb4c3d",
                                "text": "Cela signifie également que nous allons en dernier lieu “sud-africaniser l’Afrique du Sud” et rendre représentatives toutes les institutions du pays."
                            },
                            {
                                "example_id": "8211d092-6153-4c4a-b883-0f59770fd45d",
                                "sense_id": "2205ee7f-3689-3037-bfb6-9baf0cbb4c3d",
                                "text": "Avec une compagnie de treize danseuses et danseurs africains, la chorégraphe sud-africaine Dada Masilo revisite ce grand classique de la danse occidentale qu'elle s'approprie avec ses thèmes, la musique de Tchaïkovski, ses tutus et ses pointes et qu'elle « sud-africanise », en lui donnant un nouveau souffle et une nouvelle vie."
                            },
                            {
                                "example_id": "a89ba6f7-9b0a-4ace-a7e6-073a3121c04e",
                                "sense_id": "2205ee7f-3689-3037-bfb6-9baf0cbb4c3d",
                                "text": "Je suis un peu triste de voir cette Coupe du Monde néozélandaise se sud-africaniser à chaque semaine..."
                            }
                        ]
                    }
