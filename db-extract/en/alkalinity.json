                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkalinität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c36d9fe-1782-31fc-a620-224e89c6be71",
                                        "entry_id": "23f151c5-6cd6-3416-bfbd-5b48e74aa272",
                                        "glosses": [
                                            "Säurebindungsvermögen, besonders von Böden, Gesteinen und natürlichem Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bbd05b-25e6-49ba-ad97-7d532e89c458",
                                                "sense_id": "9c36d9fe-1782-31fc-a620-224e89c6be71",
                                                "text": "„Hier kann das Konzept der Azidität und Alkalinität angewandt werden. Azidität und Alkalinität werden auch ‚base neutralizing capacity‘ (BNC) bzw. ‚acid neutralizing capacity‘ (ANC) genannt. Früher wurden sie ausschließlich durch Titration bestimmt; daher unterscheidet man je nach Endpunkt der Titration verschiedene Definitionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df2935c6-f8be-3b60-9aef-9e6a579c7746",
                                        "entry_id": "23f151c5-6cd6-3416-bfbd-5b48e74aa272",
                                        "glosses": [
                                            "Eigenschaft und deren Grad, alkalisch zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b896a85-8465-4436-8888-bf8a5f652947",
                                                "sense_id": "df2935c6-f8be-3b60-9aef-9e6a579c7746",
                                                "text": "„Von der Alkalinität der Lauge hängt die Bleichwirkung und Bleichgeschwindigkeit der Lauge ab. Alkalische Laugen bleichen langsamer, neutrale bis schwach saure, freie unterchlorige Säure enthaltende Laugen schneller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74556b91-4f1e-47f5-b9a5-9bc47770342e",
                        "source_entry_id": "6067c217-9215-3e99-a338-10dd9e0985a9",
                        "source_sense_id": "2ec8d21f-f807-30a9-9b3a-748f936550c5",
                        "source_sense_description": "state of being alkaline",
                        "target_lang_word": "Alkalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d181617-793c-3aa0-96f5-9f665691b301",
                                        "entry_id": "a2126e81-c8cf-3784-ae25-2e717a8c7b0a",
                                        "glosses": [
                                            "Grad der Basenstärke, der basischen (alkalischen) Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c34390-f780-4d4c-a32a-55470118e379",
                                                "sense_id": "2d181617-793c-3aa0-96f5-9f665691b301",
                                                "text": "„Die nach dem Fällungsverfahren gefundenen Alkalitätswerte der untersuchten Salze entsprechen der nach ihrer Zusammensetzung zu verwertenden Alkalität und weichen nur unerheblich von den berechneten Werten ab, während die nach dem direkten Verfahren erhaltenen Werte viel zu hoch nach der positiven Seite ausfallen.“"
                                            },
                                            {
                                                "example_id": "67c6d566-caa3-4fde-ba06-e1a3ac027a9d",
                                                "sense_id": "2d181617-793c-3aa0-96f5-9f665691b301",
                                                "text": "„Weiterhin wurden von sämtlichen Säften die p-Werte und zugehörigen Alkalitäten aufgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
