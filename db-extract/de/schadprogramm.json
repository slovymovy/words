                                "sense_id": "258e549a-98cc-3c86-bd26-4634a769bfad",
                                "text": "Unbekannte E-Mail-Anhänge können Schadprogramme enthalten, die erheblichen Schaden anrichten können."
                            },
                            {
                                "example_id": "8890078d-ee95-4aa5-8187-21025f2a4bf4",
                                "sense_id": "258e549a-98cc-3c86-bd26-4634a769bfad",
                                "text": "„Durch eine Hintertür im PC schleuste der Wurm ein Schadprogramm in den Rechner.“"
                            }
