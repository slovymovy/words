                    }
                ],
                "translations": [
                    {
                        "translation_id": "7910d141-433d-426d-baca-b46fc1761a2a",
                        "source_entry_id": "6b75f156-1602-3772-8921-afb23c6b34ea",
                        "source_sense_id": "0dd5501c-7060-3fc5-94fd-3804a535fafb",
                        "target_lang_word": "break out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "break out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31a86304-1f1c-37c4-909e-d72855713755",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To escape, especially forcefully or defiantly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8978d7e2-b53e-4b9e-b2a5-8e8d1afd6b12",
                                                "sense_id": "31a86304-1f1c-37c4-909e-d72855713755",
                                                "text": "They broke out of prison in the middle of the night."
                                            },
                                            {
                                                "example_id": "e54112da-c723-4720-abab-cd3069d8a8b1",
                                                "sense_id": "31a86304-1f1c-37c4-909e-d72855713755",
                                                "text": "The brigade succeeded in breaking out of the pocket and reunited with friendly forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a16f1b-8a7d-374e-ad34-050e71db4de6",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To rescue someone or aid their escape as in sense 1."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af486eb2-fbb5-4bbe-8063-17707ce43f31",
                                                "sense_id": "89a16f1b-8a7d-374e-ad34-050e71db4de6",
                                                "text": "After Big Tony was sent to prison, his friends got together to break him out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3e50f8-26b4-3682-9662-c4cd2219a876",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To bring out from storage, use, or present."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c08f35c-fc9d-4912-951d-ce0b407c2e7a",
                                                "sense_id": "ed3e50f8-26b4-3682-9662-c4cd2219a876",
                                                "text": "Break out the bubbly and celebrate."
                                            },
                                            {
                                                "example_id": "8aff9a84-ac3b-42ac-9e82-82e9225f043c",
                                                "sense_id": "ed3e50f8-26b4-3682-9662-c4cd2219a876",
                                                "text": "Before you immediately break out calculus, consider that there might be a more elegant way to find the answer in this case."
                                            },
                                            {
                                                "example_id": "90d563ff-7fdb-4170-a1d9-55e84e520876",
                                                "sense_id": "ed3e50f8-26b4-3682-9662-c4cd2219a876",
                                                "text": "Picks and shovels had been perfectly adequate for the sporadic digging we’d had to do over the last month, but when faced with 30 cubic yards of earth to move in at once, we decided to break out the heavy equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0302bac6-dcf5-3e7b-81dd-6f54e13d54f4",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To separate (something) from a bundle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371b851e-bce5-4026-b87a-196b47ae990f",
                                                "sense_id": "0302bac6-dcf5-3e7b-81dd-6f54e13d54f4",
                                                "text": "Break out the cables from the harness once they are inside the frame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc1d0390-c04b-3dbd-8edc-323282735b78",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To take or force out by breaking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dbc33ec-ba5c-413c-a518-c6223d2c4d31",
                                                "sense_id": "bc1d0390-c04b-3dbd-8edc-323282735b78",
                                                "text": "to break out a pane of glass"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To begin suddenly; to emerge in a certain condition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27622a10-3bc4-4185-ad08-29b7106fc6d5",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "He broke out in sweat."
                                            },
                                            {
                                                "example_id": "da7cd322-c5ae-412b-9587-ed5ee8c260b1",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "He broke out in song."
                                            },
                                            {
                                                "example_id": "ee02873b-3aec-4a3e-a741-b173d813d104",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "The First World War broke out in 1914."
                                            },
                                            {
                                                "example_id": "c4ba2af0-0b5d-4bc2-ac3a-30999f2c70d0",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "The pretty lips pouted awhile but then she glanced up and broke out into a joyous little laugh which had in it all the freshness of a young May morning."
                                            },
                                            {
                                                "example_id": "4cf565f0-acef-4b7d-af3c-dccc7e3b8209",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "Governor Lai left today for Neichiang, which is west of Chungking and is about midway between the city and Chengtu where General Yang establishes his headquarters and stations a large portion of his troops. With the Civil Governor and General Teng moving to Neichiang, it is certian^([sic – meaning certain]) that fighting will break out in that section of the province."
                                            },
                                            {
                                                "example_id": "d60bf027-7651-4d0b-ae16-529a77ae8e25",
                                                "sense_id": "bd6623db-5d05-3f36-aa4d-d85cacd55fec",
                                                "text": "In a war of words that has broken out between Khan and Secretary of State for Transport Grant Shapps, the Mayor was accused of sending revenue-raising proposals to Shapps some three weeks late, giving him little choice but to extend negotiations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f993af3-db95-3bd1-a150-42ce67b790e5",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To suddenly get pimples or a rash, especially on one's face."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdcb5ae6-034c-4a3b-b45d-9b0308509699",
                                                "sense_id": "9f993af3-db95-3bd1-a150-42ce67b790e5",
                                                "text": "break out in hives"
                                            },
                                            {
                                                "example_id": "0828fdff-5a3d-44ac-a93f-390f14e9a16c",
                                                "sense_id": "9f993af3-db95-3bd1-a150-42ce67b790e5",
                                                "text": "break out in a rash"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da2b92e3-0548-336f-ab0c-ea8fc53948b1",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "(Of a record, product, or company): to achieve widespread success."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52851fca-041a-4269-a281-d58cefb81eb7",
                                                "sense_id": "da2b92e3-0548-336f-ab0c-ea8fc53948b1",
                                                "text": "It wasn't until later that her album broke out and she hit the big time."
                                            },
                                            {
                                                "example_id": "365897f4-a1ee-4ea7-ab4d-3730166d3a8a",
                                                "sense_id": "da2b92e3-0548-336f-ab0c-ea8fc53948b1",
                                                "text": "The record first happened a few years ago in Florida and had considerable sales. A year later, the record broke out again in Florida and again experienced considerable sales. Both times, it either made the chart or bubbled under."
                                            },
                                            {
                                                "example_id": "0753e06a-886c-46d7-afa3-e7ff19f8b610",
                                                "sense_id": "da2b92e3-0548-336f-ab0c-ea8fc53948b1",
                                                "text": "Avant will finish a radio tour this summer that includes a stop in Chicago, where the single broke out thanks to support from WGCI programmer Elroy Smith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cef9491-2512-3279-bbe9-1ee9bd9cb7bc",
                                        "entry_id": "ec19d647-d04a-3ab8-8d8d-0880ae4b1ed6",
                                        "glosses": [
                                            "To remove snow from a road or sidewalk."
                                        ],
                                        "tags": [
                                            "New-England",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785b1d09-10f8-4ccf-86a1-f73fe322f148",
                                                "sense_id": "3cef9491-2512-3279-bbe9-1ee9bd9cb7bc",
                                                "text": "Art. 24—To see what action the town will take in relation to breaking out highways and what portion of the road money, if any, shall be reserved for this purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
