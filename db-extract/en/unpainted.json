                                "example_id": "e8484931-b246-41b4-a738-fa10ad1a67f1",
                                "sense_id": "8f332f3c-6c85-3b96-af31-82986c94542c",
                                "text": "Near-synonym: paintless"
                            },
                            {
                                "example_id": "5a727a4a-6407-4aca-a772-00e2ae826c6e",
                                "sense_id": "8f332f3c-6c85-3b96-af31-82986c94542c",
                                "text": "Perhaps the surface of the red brick, long unpainted, had scaled off a little more here and there."
                            },
                            {
                                "example_id": "eac22557-c5e0-4431-8358-4a379b06c730",
                                "sense_id": "8f332f3c-6c85-3b96-af31-82986c94542c",
                                "text": "The new cars incorporate many features first introduced in the 1938 tube stock, but major changes include the use of rubber for the bogie bolster and axlebox suspension, fluorescent lighting, and the panelling of the cars in unpainted aluminium alloy."
                            },
                            {
                                "example_id": "2b11d9f6-c539-4fb5-b451-cf6e34f749c5",
                                "sense_id": "8f332f3c-6c85-3b96-af31-82986c94542c",
                                "text": "A few unreliable-looking boats were beached there, unpainted boats built largely of gray driftwood, or so it seemed to me."
                            }
                        ]
                    }
