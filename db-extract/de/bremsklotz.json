                "senses": [
                    {
                        "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                        "entry_id": "a9db7b36-1040-37e9-b707-013d1b592cda",
                        "glosses": [
                            "Teil einer Bremse, der die Umdrehungsgeschwindigkeit von Rädern verringert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a356a1ee-a5cd-407a-a09b-e8d4231da793",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "Bremsklötze sind Verschleißteile."
                            },
                            {
                                "example_id": "052fd173-3bbe-4bbb-816a-14ce4571d932",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "„Der ADFC rät, Bremsklötze auszutauschen, wenn die Querrillen nicht mehr deutlich zu erkennen sind oder sich eine Kante eingebremst hat.“"
                            },
                            {
                                "example_id": "32d2b28d-bd03-4ca4-8242-091b17b99e28",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "„Bei Felgenbremsen erkennt ihr den Verschleiss der Bremsklötze an den Schlitzen: Sind diese kaum noch zu sehen, müssen die Klötze erneuert werden.“ [Anmerkung: Verschleiss ist Schweizer Rechtschreibung, die deutsche Rechtschreibung lautet Verschleiß]"
                            },
                            {
                                "example_id": "4613f661-6651-4d48-aed1-d2ed5d706780",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "[PKWs:] „Viele Werkstätten bieten den Tausch der Bremsklötze zum Komplettpreis an. Die Preise liegen je nach Modell zwischen 80 und 300 Euro.“"
                            },
                            {
                                "example_id": "a1336640-e0ea-420a-b5d1-4a02ff73d13c",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "[Schienenfahrzeuge:] „Die Bremskraft wird durch Bremsklötze erzeugt, die gegen die Lauffläche der Räder gedrückt werden.“"
                            },
                            {
                                "example_id": "353917ad-ba9b-4e83-8057-7bf79e7194e3",
                                "sense_id": "1df49b5d-c618-3a01-8680-0c4a8f18c78e",
                                "text": "„Für viel Diskussionsstoff während des Bürgerdialogs in Pirna sorgten die sogenannten \"Flüsterbremsen\". Diese Bremsklötze aus Verbundkunststoffen bewirken, dass die Schallemissionen direkt an der Schiene reduziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed31d854-c31f-3c13-93e6-b734ac5bcd65",
                        "entry_id": "a9db7b36-1040-37e9-b707-013d1b592cda",
                        "glosses": [
                            "Keil, den man vor oder hinter ein Rad legt, der das Rollen eines Fahrzeugs verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d322ca-51cd-4d18-a670-0b77ff4cf3ec",
                                "sense_id": "ed31d854-c31f-3c13-93e6-b734ac5bcd65",
                                "text": "[Pünktlichkeit von Flugzeugen:] „Gemessen wird dann, wenn die Bremsklötze am Bugrad angelegt sind. Erst dann gilt die Maschine als gelandet.“"
                            },
                            {
                                "example_id": "ca271cf5-6119-4df9-be16-cd782cd00aaf",
                                "sense_id": "ed31d854-c31f-3c13-93e6-b734ac5bcd65",
                                "text": "„Brennender Zug rollt ohne Lokführer durch Gengenbach – […] In der Nähe des Hukla-Areals in Gengenbach wurde der Zug mit Bremsklötzen gestoppt. Dabei sprang der vordere Teil des Triebwagens aus den Gleisen.“"
                            },
                            {
                                "example_id": "32238cb5-9142-424f-bc26-3771da59e452",
                                "sense_id": "ed31d854-c31f-3c13-93e6-b734ac5bcd65",
                                "text": "„Ein Bahnbeamter legte Bremsklötze unter die Räder.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                        "entry_id": "a9db7b36-1040-37e9-b707-013d1b592cda",
                        "glosses": [
                            "jemand oder etwas, der/das eine gewollte/erwünschte Entwicklung verlangsamt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "f3548ae7-848d-41c7-b543-db6417b45d67",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "Größte Bremsklötze für eine gute Schulentwicklung in Deutschland sind die föderale Struktur des Schulsystems und die Kultusministerkonferenz."
                            },
                            {
                                "example_id": "6959231b-454f-44c8-a3ab-2ddb2fd879eb",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "[Ausbau der Windenergie in Deutschland:] „[…] Hamburgs Umweltsenator Jens Kerstan (Grüne) [appellierte] an die Bundesregierung, Regeln zum geplanten Mindestabstand von 1.000 Metern zwischen Windrädern und Siedlungen zu streichen. Die Vorgaben des Bundes seien ein Bremsklotz für den weiteren Ausbau an Land.“"
                            },
                            {
                                "example_id": "b2e6e13d-5153-470d-8a2d-b9b63c2e585f",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„EU-Kommissionschef Juncker, Frankreich und Deutschland sind froh, dass sie mit der Verteidigungsunion ein neues Projekt haben, bei dem sich ausnahmsweise einmal fast alle einig sind. Ironischerweise klappt das nur, weil der größte Bremsklotz, nämlich Großbritannien, freiwillig ausscheidet.“"
                            },
                            {
                                "example_id": "067fb8cb-0a3e-4900-8f4b-3e7203bfa203",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„Der Anteil von Startup-Gründerinnen liegt weiterhin bei mageren 15 Prozent. Warum nur? […] Bremsklotz Nummer Eins ist die weiterhin schwierige Vereinbarkeit von Familie und Beruf. Wer ein Unternehmen gründet, braucht viel Zeit. Gründerinnen ohne Kind arbeiten in der Woche im Schnitt fast sechs Stunden mehr als Mütter. Bei den Männern unterscheidet sich die Arbeitsbelastung bei Vätern und kinderlosen Männern nicht.“"
                            },
                            {
                                "example_id": "46e87a10-8606-4fca-a084-b7b51e2e9bbd",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "[Schlagzeile:] „Stechuhr für alle: Sieg für die Arbeitnehmer oder Bremsklotz für die Wirtschaft 4.0 ?“"
                            },
                            {
                                "example_id": "12b1f5d8-bb1f-4434-99c1-b80421f09652",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„Als Bremsklotz [Anmerkung: für die Errichtung einer Fabrik in Brandenburg] könnte sich das Genehmigungsverfahren erweisen.“"
                            },
                            {
                                "example_id": "b9fa1d24-1bbc-46a4-9fc6-616cfb29c72c",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„[…] das Ausschreibungs- und Beschaffungsrecht [lastet] schwer auf Bussen und Bahnen, was bei Verbesserungen des Angebotes regelmäßig als Bremsklotz wirkt.“"
                            },
                            {
                                "example_id": "62e63b31-11bc-4b16-91be-0cbb96c0a6b0",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "[Iran:] „Problematisch und ein Bremsklotz für eine dynamische Entwicklung bleibt zudem der Umstand, dass die größten Unternehmen des Landes von den Revolutionsgarden, dem Militär, religiösen Stiftungen oder von Revolutionsführer Ali Chamenei kontrolliert werden.“"
                            },
                            {
                                "example_id": "88334faa-9b12-4c81-b7ee-4a3dc8b7a946",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„Die Spitzenkandidatin der Grünen, Sylvia Löhrmann, bezeichnete [Anmerkung: den Politiker Norbert] Röttgen als \"Bremsklotz in der Energiewende\".“"
                            },
                            {
                                "example_id": "c42a16b3-7f97-43d7-a746-c1a874c32282",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„»Wir feiern halt gern hart«, versucht Lagerist Tobi (19) das Dilemma zu beschreiben. »Und da sind die Frauen ja immer ein Bremsklotz mit ihrem ständigen ‚Trink nicht so viel‘ und ‚Was redest du da wieder für eine Kacke?!‘«“"
                            },
                            {
                                "example_id": "534e7de7-456f-46fb-ae92-84103fa862b0",
                                "sense_id": "6ecf6eff-7830-36ca-8678-3c35464b0bd0",
                                "text": "„Was jetzt von der Stadt Frankfurt, von allen Beteiligten zu erwarten ist: Macht doch ernst! Setzt eure Konzepte doch um! Selbstbewusst zeigen, wie Verkehr und Mobilität in Zukunft aussehen können und müssen, damit Ballungsräume nicht im Dreck und Stau ersticken. Der VDA wäre bei diesem Prozess doch bloß ein Bremsklotz.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
