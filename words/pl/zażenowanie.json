                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poczuła ogromne <w>zażenowanie</w>, gdy wszyscy zaczęli się śmiać z jej pomyłki.",
