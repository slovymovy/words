{
    "word_family": [
        "rurality",
        "ruralize",
        "ruralism",
        "rurally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bf71bb5-9bf8-352a-b18c-4b43409e52e4",
                    "sense_definition": "Relating to the countryside, farming, or agriculture rather than a city.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people prefer to live in a <w>rural</w> area because they enjoy the peace and quiet of the countryside.",
                            "target_lang_translations": {
                                "ru": "Многие люди предпочитают жить в <w>сельской</w> местности, потому что им нравится тишина и покой за городом.",
                                "zh": "许多人更喜欢住在<w>农村</w>地区，因为他们享受乡村的宁静。"
                            }
                        },
                        {
                            "text": "The government is investing more money to improve the <w>rural</w> community and its local schools.",
                            "target_lang_translations": {
                                "ru": "Правительство инвестирует больше денег в улучшение <w>сельской</w> общины и местных школ.",
                                "zh": "政府正在投入更多资金以改善<w>农村</w>社区及其当地学校。"
                            }
                        }
                    ],
                    "synonyms": [
                        "campestral",
                        "country",
                        "rustic"
                    ],
                    "antonyms": [
                        "urban",
                        "suburban"
                    ],
                    "common_phrases": [
                        "rural area",
                        "rural community",
                        "rural development",
                        "rural landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к сельской местности, фермерству или сельскому хозяйству, а не к городу.",
                        "zh": "与乡村、农业或农耕有关，而非与城市有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский",
                                "target_lang_sense_clarification": "относящийся к селу или деревне"
                            },
                            {
                                "target_lang_word": "деревенский",
                                "target_lang_sense_clarification": "характерный для деревни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "农村的",
                                "target_lang_sense_clarification": "指与农村地区相关的"
                            },
                            {
                                "target_lang_word": "乡村的",
                                "target_lang_sense_clarification": "指具有乡村风貌或特征的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d19959e3-091b-3058-9b0b-adbbea446ef1",
                    "sense_definition": "A person who lives in or comes from the countryside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>rurals</w> gathered at the town hall to discuss the new farming regulations.",
                            "target_lang_translations": {
                                "ru": "Местные <w>сельские жители</w> собрались в ратуше, чтобы обсудить новые правила ведения сельского хозяйства.",
                                "zh": "当地的<w>农村居民</w>聚集在市政厅，讨论新的农业法规。"
                            }
                        },
                        {
                            "text": "He was a simple <w>rural</w> who had never visited a large city in his entire life.",
                            "target_lang_translations": {
                                "ru": "Он был простым <w>деревенским жителем</w>, который за всю свою жизнь ни разу не бывал в большом городе.",
                                "zh": "他是一个淳朴的<w>乡下人</w>，这辈子从未去过大城市。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который живет в сельской местности или является выходцем из нее.",
                        "zh": "居住在乡村或来自乡村的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский житель",
                                "target_lang_sense_clarification": "человек из сельской местности"
                            },
                            {
                                "target_lang_word": "деревенский житель",
                                "target_lang_sense_clarification": "человек, живущий в деревне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "农村居民",
                                "target_lang_sense_clarification": "居住在农村地区的人"
                            },
                            {
                                "target_lang_word": "乡下人",
                                "target_lang_sense_clarification": "指来自乡村的人，有时带有口语色彩"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}