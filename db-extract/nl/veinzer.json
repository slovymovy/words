                            {
                                "example_id": "3189a723-8780-436c-a43b-d53675d420eb",
                                "sense_id": "d0d85aa3-94d1-39d2-b746-c1c257fb7b32",
                                "text": "Theophrastus onderscheidde dertig mensentypen. In dertien van de dertig herkennen wij duidelijk iets van Trump: de veinzer, de wauwelaar, de behaagzieke, de desperado, de schaamteloze, de vlegel, de achterdochtige, de weerzinwekkende, de lomperik, de ijdeltuit, de verwaande, de kwaadspreker en de opschepper"
                            }
                        ]
                    }
                ],
