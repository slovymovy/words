                ],
                "senses": [
                    {
                        "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                        "entry_id": "e85dbb15-bd57-3ea1-95bb-5905315ea6bb",
                        "glosses": [
                            "Vorgang, bei dem man sich (zum Vergnügen, um sich sportlich zu betätigen) im Wasser aus eigener Kraft (durch Bewegung der Extremitäten) fortbewegt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "0e549fc7-1aa2-41e9-a2ad-38596a113cab",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Frauen, Männer und Kinder genossen gestern einen Schwumm im kühlen Nass, belagerten die Froschinsel und sonnten sich auf den Bänken.“"
                            },
                            {
                                "example_id": "c0020ec9-69af-4cd0-8e53-d4cbdde8f29a",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Für einen Schwumm im See ist es aber auch ihr noch entschieden zu frisch. 15 Grad kalt war das Seewasser gestern.“"
                            },
                            {
                                "example_id": "b3bf2d80-6781-4067-a938-377021f4c3a6",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Politik kennt nicht nur das Bad in der Menge, auch ein Bad im Flusse kann Symbolkraft entfalten - das zeigte Mao Zedongs legendärer Schwumm im Jangtse, mit dem er 1956 mehr Reformtempo forderte.“"
                            },
                            {
                                "example_id": "e9c5fde6-e5a1-4da8-aaf3-7f43d349f93d",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Nach einem Notfalleinsatz der Feuerwehr, die am Mittwoch 2000 Kubikmeter frisches Flusswasser ins Bassin pumpte, ist die Wasserqualität wieder gut genug für einen Schwumm.“"
                            },
                            {
                                "example_id": "0fe0c47b-3468-4d5b-b294-6a504744cc5b",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Der Schwumm im kühlen Wasser sei ein toller Ausgleich zur täglichen Kopfarbeit.“"
                            },
                            {
                                "example_id": "2a1e7753-c61d-4974-a7fe-2c2a697f4612",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Bis zum 18. September hat man noch die Chance, einen letzten «Schwumm» unter freiem Himmel zu machen.“"
                            },
                            {
                                "example_id": "241b1754-fab0-4191-a728-7a4da0af311b",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Ich war heute schon für einen Schwumm im Meer.“"
                            },
                            {
                                "example_id": "1b5fc415-b184-47e5-affc-2faae6c8982c",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Der Schwumm im kühlen Nass muss allerdings noch etwas warten.“"
                            },
                            {
                                "example_id": "fe8dd827-1ef5-4ed9-b7d3-b71bfd86a115",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Im eiskalten Schwarzsee konnte jeder seinen Mut unter Beweis stellen. Bis zum Schluss hatten es fast alle geschafft, einen kurzen Abtaucher oder sogar einen Schwumm zu wagen.“"
                            },
                            {
                                "example_id": "37549a06-0412-4837-bb4a-bf5c00fa522a",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Im Winter könne man abends noch schnell Ski fahren und im Sommer noch schneller einen Schwumm im Bergsee machen.“"
                            },
                            {
                                "example_id": "d7f221a4-017f-404f-bc24-cea8b5398223",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Glitzernde Bergseen laden im Sommer zum erfrischenden Schwumm.“"
                            },
                            {
                                "example_id": "04936915-fdeb-445b-b51f-38eac2768dea",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Für einen ausgiebigen Schwumm war es dann aber doch etwas zu kühl: Bloss 13 Grad betrug die Wassertemperatur gestern.“"
                            },
                            {
                                "example_id": "dac3203f-ba7f-4d39-888b-6474f6a39b94",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Anschliessend kann man die angefutterten Kalorien bei einem Schwumm im kühlen Nass gleich wieder verbrennen.“"
                            },
                            {
                                "example_id": "58aa1c6c-5945-4c87-a185-faf87dd5db19",
                                "sense_id": "e8b5c20f-39de-34c8-8f9d-df420b94e696",
                                "text": "„Eindrücklicher ist ein Schwumm mit Delfinen und Robben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12ab463e-ac94-4ad5-bdd6-d8c386466885",
