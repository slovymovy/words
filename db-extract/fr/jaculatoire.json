                                        "sense_id": "3cc014f9-5752-3591-8951-c6402dd6d83a",
                                        "entry_id": "cb263ebf-300f-338a-9f0b-54fae551b301",
                                        "glosses": [
                                            "A motion or gesture that darts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db53898-5382-40f6-b20c-ba3c93ce404d",
                                                "sense_id": "3cc014f9-5752-3591-8951-c6402dd6d83a",
                                                "text": "During this period, a different set of abnormal mouth-movements made their appearance: forced protrusions of the lips, propulsion of the tongue, and occasional choreic dartings of the tongue."
                                            },
                                            {
                                                "example_id": "49824339-3da9-4292-aca7-dd9bc120fc44",
                                                "sense_id": "3cc014f9-5752-3591-8951-c6402dd6d83a",
                                                "text": "Jane Gibson taught the cast the movements of the various creatures they were representing: the linear shufflings of the hedgehogs, the dozy lollopings of the rabbits, the sinuous dartings of the weasel and so on."
                                            }
                                        ]
                                    }
                                ]
