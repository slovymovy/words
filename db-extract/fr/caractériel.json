                            }
                        ]
                    },
                    {
                        "translation_id": "2c9e3e03-b35b-4cb6-b586-917b23bec9f4",
                        "source_entry_id": "d125abf3-8bdb-3a75-9756-7523423dca64",
                        "target_lang_word": "problem child",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "problem child",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                        "entry_id": "63870929-7152-3bed-859b-bb0cef75756b",
                                        "glosses": [
                                            "A child who is particularly difficult to raise or educate, especially due to a lack of self-control and disruptive and antisocial behavior."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1ff622-7834-4c82-b3a2-7f31263b4a41",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "Of recent times very much has been said regarding the problem child, but as Lady Stradbroke pointed out last week but little is being done to cope with the menace that child is to itself and to the community."
                                            },
                                            {
                                                "example_id": "40210593-38af-4ef3-a9de-fe87b3c1f8a3",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "Hill was a problem child who was sent to Woodlands because his parents couldn't handle him at home."
                                            },
                                            {
                                                "example_id": "3524ec5e-5497-4b5b-9a76-47707f87a470",
                                                "sense_id": "ce84701c-ec02-3a43-937a-b13f5606d8c8",
                                                "text": "An’ here I am. Your dream problem child. A facety ghetto rude gyal grateful for your remarkable lack of judgeyness, an’ ready to be dazzled and inspired by your penetrating insight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                        "entry_id": "63870929-7152-3bed-859b-bb0cef75756b",
                                        "glosses": [
                                            "Someone or something persistently difficult or vexing; a frequent source of trouble or annoyance."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21eb5491-cbd5-43db-add8-3ca5bbb8912f",
                                                "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                                "text": "[A]n ambitious supersonic carrier fighter called the F3H Demon . . . proved too heavy for its Navy-specified Westinghouse engine (in itself a problem child), and turned into a $265 million fiasco."
                                            },
                                            {
                                                "example_id": "0deee237-c488-497f-83d8-b533516897a2",
                                                "sense_id": "cd0b0cbc-eccd-30ac-b4fd-9518fa6433dd",
                                                "text": "Locally and across the nation, middle schools have generally been regarded as the problem child for school systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
