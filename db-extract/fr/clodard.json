                            {
                                "example_id": "9560af9d-4a9e-46ee-a409-fe63393c66f1",
                                "sense_id": "0b82398f-20e3-35b6-915d-74063edc7d8c",
                                "text": "Il a couru d’un trottoir à l’autre, un clodard en cyclo a fait une embardée pour ne pas l’embugner et s’est ramassé en hurlant des douceurs en arabe."
                            },
                            {
                                "example_id": "123be23c-bd7d-44e2-bf44-496e4f0977aa",
                                "sense_id": "0b82398f-20e3-35b6-915d-74063edc7d8c",
                                "text": "C’est toujours comme ça, un clodard vient poser son étron, et regarde même pas les réponses…"
                            },
                            {
                                "example_id": "6f87521f-ae4a-49c6-a3be-a29655694f2d",
                                "sense_id": "0b82398f-20e3-35b6-915d-74063edc7d8c",
                                "text": "Quand il ressort Kit ne veut plus le voir, et Mark est presque devenu un clodard."
                            }
                        ]
                    }
