                ],
                "senses": [
                    {
                        "sense_id": "6279a44b-719e-30e5-a44f-8aca3360f11f",
                        "entry_id": "0bbed296-cb72-3dcd-8074-9aece09b2f1f",
                        "glosses": [
                            "Enlever la carapace de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c202cf00-5f3f-4450-b9aa-31d6a7ee3eae",
                                "sense_id": "6279a44b-719e-30e5-a44f-8aca3360f11f",
                                "text": "D’autre part, faire cuire un homard comme pour l’américaine; une fois cuit le décarapacer ; laisser réduire la cuisson ; la monter au beurre d’écrevisse et la passer à l’étamine."
                            },
                            {
                                "example_id": "93d55075-691f-486e-9428-8d05bbcdf4a0",
                                "sense_id": "6279a44b-719e-30e5-a44f-8aca3360f11f",
                                "text": "Il faut les étêter, donc enlever la tête, décarapacer les crevettes."
                            },
                            {
                                "example_id": "5755068f-d3a2-41d8-acf0-d1af63e355e5",
                                "sense_id": "6279a44b-719e-30e5-a44f-8aca3360f11f",
                                "text": "À l’exception de nos professeurs d’université encore trop imprégnés des défauts dont leurs maîtres européens s’efforcent de se décarapacer (style doctrinal, redondances inutiles, lourdeur dans l'érudition, etc.), les rares critiques littéraires dont l’Afrique dispose se métamorphosent en collaborateurs ubiquitaires qui s’essoufflent à force d’être partout à la fois."
                            }
                        ]
                    }
                ],
