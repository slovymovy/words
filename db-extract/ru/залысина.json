                ],
                "translations": [
                    {
                        "translation_id": "e7e851a7-5c6f-43eb-8d3d-929cd385eb40",
                        "source_entry_id": "a18102d5-0e88-3f3a-84e3-b99c4b8723c5",
                        "source_sense_id": "2a72288a-2970-3260-8dcf-a2c4aab28882",
                        "target_lang_word": "receding hairline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f0a40587-0de5-4366-8b02-6d12f69210b3",
                        "source_entry_id": "a18102d5-0e88-3f3a-84e3-b99c4b8723c5",
                        "source_sense_id": "2a72288a-2970-3260-8dcf-a2c4aab28882",
                        "target_lang_word": "Geheimratsecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimratsecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                        "entry_id": "89db3b7a-fc0e-3b12-9e98-74228675c30d",
                                        "glosses": [
                                            "haarfreie Fläche am Haaransatz oberhalb der Schläfe eines Mannes"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1059b2-d552-4ddd-8c63-1607f4094ff2",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "Egal, ob genetisch bedingt, nach Krankheit oder Chemotherapie: Wenn die Haare ausfallen, ist das erst mal ein Schock. Es gibt allerdings unterschiedliche Wege, mit Glatze oder Geheimratsecken umzugehen."
                                            },
                                            {
                                                "example_id": "30b100bb-b26c-4819-a747-955dad89c07b",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "Die Geheimratsecken lassen sich schwer verbergen."
                                            },
                                            {
                                                "example_id": "0d82233b-5c85-47cc-8468-3f3d637d9824",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "„Ganz ehrlich: Geheimratsecken fände ich wesentlich weniger tragisch, wenn ich sie auf dem Rücken oder in der Nase hätte."
                                            },
                                            {
                                                "example_id": "4f74be68-9828-4fe9-bf38-01a40528d660",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "Der klassische Schönling ist Andrés Iniesta sicher nicht: 1,71 m klein, große Geheimratsecken und nicht gerade eine Stilikone."
                                            },
                                            {
                                                "example_id": "cd47973a-b3ee-4c63-8487-7b8541a199d5",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "So wie vorher wollte auch Carsten Ziegler wieder aussehen. Den Mittvierziger aus Saarbrücken störten seine tiefen Geheimratsecken."
                                            },
                                            {
                                                "example_id": "361760b4-978b-4fc7-b5c4-ce3f8a9fd483",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "Man könnte fast meinen: Da kommt nichts mehr. Und dann hört man wieder ein neues Werk des [alternden britischen Sängers Morrissey] mit der inzwischen ergrauten Tolle und den stetig wachsenden Geheimratsecken […]"
                                            },
                                            {
                                                "example_id": "9ed658ed-65e3-4fd8-a957-84f78e106ebd",
                                                "sense_id": "abc191bf-17be-3348-b29c-2a9b30968868",
                                                "text": "„Bei manchen Frauen treten aber auch Merkmale von männlichem Haarausfall in Form von Geheimratsecken auf – vermehrt nach der Menopause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
