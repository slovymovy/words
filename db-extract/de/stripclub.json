                        "glosses": [
                            "Club, in dem sich Männer oder Frauen gegen Geld ausziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "124b8bfd-699a-4b58-98d4-f796244215bf",
                                "sense_id": "36cdea88-4c6a-307f-b250-ed82898ffe20",
                                "text": "„Laut Aussagen der Feuerwehr von Los Angeles schoss Öl in einer Fontäne in den Nachthimmel. Danach liefen etwa 190.000 Liter Rohöl in die Straßen der Millionenstadt. Besonders davon betroffen: Ein Stripclub direkt neben der Ölfontäne, der evakuiert werden musste.“"
                            },
                            {
                                "example_id": "c6380dd2-4e50-4c54-bb64-cbb66bb0e4dc",
                                "sense_id": "36cdea88-4c6a-307f-b250-ed82898ffe20",
                                "text": "„Sängerin Kylie Minogue ist gegen den Besitzer eines neuseeländischen Stripclubs vorgegangen.“"
                            },
                            {
                                "example_id": "82f7ea1c-2ca0-4ff1-9110-d58dae8bc1cf",
                                "sense_id": "36cdea88-4c6a-307f-b250-ed82898ffe20",
                                "text": "„Tony Soprano war ein Alphatier, das morgens in Puschen die Zeitung vom Hoftor holt, mittags seinen Stripclub besucht, zum Abendbrot heimkehrt und nachts ein paar Feinde kaltmacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
