                    {
                        "translation_id": "de21695b-36b9-4085-b3e7-9d1caf9ba0b1",
                        "source_entry_id": "f0da90ee-1ce3-3abe-bfcc-354f9aecff5e",
                        "source_sense_id": "76e6b4ea-30ba-3851-ae78-86767d6bfd28",
                        "source_sense_description": "lack of adequate nourishment",
                        "target_lang_word": "malnutrition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malnutrition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffdc2be-0938-3489-b966-6e928fa08e8d",
                                        "entry_id": "f7b33db2-af14-3962-a268-6225c1b478a1",
                                        "glosses": [
                                            "État pathologique causé par un apport nutritionnel insuffisant, excessif ou déséquilibré, susceptible d’altérer la santé d’un individu ou d’une population."
                                        ],
                                        "tags": [
                                            "Nutrition publique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60232396-ca21-4df7-8999-7aad9e3af30c",
                                                "sense_id": "1ffdc2be-0938-3489-b966-6e928fa08e8d",
                                                "text": "Certains enfants démunis souffrent de malnutrition."
                                            },
                                            {
                                                "example_id": "49d3ef19-2e1b-4ced-81f7-bcafac10f0f5",
                                                "sense_id": "1ffdc2be-0938-3489-b966-6e928fa08e8d",
                                                "text": "Il convient de reconnaître que les bêtes qui souffrent de malnutrition sont plus sensibles aux maladies que les animaux correctement nourris et sont de ce fait plus susceptibles que les autres d’être atteintes de plusieurs maladies simultanément. Il arrive que le diagnostic en soit rendu difficile ; un animal en mauvais état peut héberger de nombreux parasites internes pour lesquels il sera traité […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1060d51-a7eb-4911-b31c-32d2ae48f21e",
                        "source_entry_id": "f0da90ee-1ce3-3abe-bfcc-354f9aecff5e",
                        "source_sense_id": "76e6b4ea-30ba-3851-ae78-86767d6bfd28",
                        "source_sense_description": "lack of adequate nourishment",
                        "target_lang_word": "Unterernährung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterernährung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60f5b5e8-12d5-37ed-9284-9d0405435cdf",
                                        "entry_id": "4d7da2c4-ed5c-37cb-9b4e-cbabe805a291",
                                        "glosses": [
                                            "quantitative Mangelernährung, bei der weniger Kalorien eingenommen, als verbraucht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf3b6d0-139e-4180-a56c-0b9b29eb127e",
                                                "sense_id": "60f5b5e8-12d5-37ed-9284-9d0405435cdf",
                                                "text": "„Sie sind alle an Unterernährung gestorben.“"
                                            },
                                            {
                                                "example_id": "91a8447b-e4fa-4e77-981a-5f665bb19530",
                                                "sense_id": "60f5b5e8-12d5-37ed-9284-9d0405435cdf",
                                                "text": "„Im Hungerwinter 1916/17 starben Hunderttausende Deutsche an Unterernährung; noch viel mehr entkamen diesem Schicksal nur um Haaresbreite.“"
                                            },
                                            {
                                                "example_id": "dd4f8d6e-06cb-432b-a1b3-28e691c90296",
                                                "sense_id": "60f5b5e8-12d5-37ed-9284-9d0405435cdf",
                                                "text": "„Hunderte starben an Unterernährung und an den Folgen der katastrophalen hygienischen Verhältnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f82fe1-a8b9-4a35-97a9-ae3abf7efb83",
                        "source_entry_id": "f0da90ee-1ce3-3abe-bfcc-354f9aecff5e",
                        "source_sense_id": "76e6b4ea-30ba-3851-ae78-86767d6bfd28",
                        "source_sense_description": "lack of adequate nourishment",
                        "target_lang_word": "Mangelernährung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mangelernährung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                        "entry_id": "8bc0e347-5cf6-3f21-8128-6ecf8087957f",
                                        "glosses": [
                                            "unzureichende Ernährung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9789d5-f9fb-40a8-bfca-8ad35de5dd97",
                                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                                "text": "„Auch in der Demokratischen Republik Kongo leiden als Folge des Bürgerkriegs nach Angaben von Unicef noch immer 1,9 Millionen Kinder unter Mangelernährung.“"
                                            },
                                            {
                                                "example_id": "ad1da35a-303c-4c46-96f2-96c36c5c787d",
                                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                                "text": "„Wer nicht schon der hohen Kindersterblichkeit zum Opfer gefallen war, litt häufig unter Mangelernährung, Strapazen und Krankheiten.“"
                                            },
                                            {
                                                "example_id": "d9842af0-289d-43ae-9453-a8e67e5ede8b",
                                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                                "text": "„Über Monate andauernde Unterkühlung, Frostbeulen und Mangelernährung haben ihre Spuren hinterlassen.“"
                                            },
                                            {
                                                "example_id": "e0093c79-a2b5-42be-92f1-12988f44e7f3",
                                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                                "text": "„Durch Mangelernährung bedingte Eisenarmut führte bei vielen Bewohnern des Chaco Canyons zu Durchfall und Atemwegserkrankungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
