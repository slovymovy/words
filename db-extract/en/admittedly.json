                        "sense_id": "6ee0ad32-796d-3377-b6d7-f9020e6a3930",
                        "entry_id": "55a799cc-baef-3362-a91d-0375bfbe9e4c",
                        "glosses": [
                            "zugegebenermaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8018ba-6d9a-4c14-b317-9af97d7fc2b0",
                                "sense_id": "6ee0ad32-796d-3377-b6d7-f9020e6a3930",
                                "text": "Admittedly I was afraid.",
                                "translation": "Ich gebe zu, ich hatte Angst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5985453d-14f0-4494-9b36-255708f94f37",
                        "source_entry_id": "55a799cc-baef-3362-a91d-0375bfbe9e4c",
                        "source_sense_id": "6ee0ad32-796d-3377-b6d7-f9020e6a3930",
                        "source_sense_description": "zugegebenermaßen",
                        "target_lang_word": "zugegebenermaßen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugegebenermaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                        "entry_id": "50735600-047c-358b-90c6-6390497af765",
                                        "glosses": [
                                            "etwas eingestehend; klein beigebend; eventuell kleinlaut seiend; wohl tatsächlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386b1c15-6555-4e79-8aab-1b5f446c74ba",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "Ich habe zugegebenermaßen zu viel Schokolade gekauft."
                                            },
                                            {
                                                "example_id": "ba3e42cf-067a-4ffc-8239-40cbe1658fc8",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Die Eigner des Schiffes betrachteten die Todesfälle und die Tatsache, dass das Leben so vieler Menschen zerstört wurde, als normale Begleiterscheinung eines zugegebenermaßen schmutzigen Geschäfts.“"
                                            },
                                            {
                                                "example_id": "e97b5bb2-03f2-431b-9175-a2e90f6e4f66",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Dies war meine zugegebenermaßen spießbürgerliche Vorstellung davon, wie mein Leben nach meinem Studium aussehen sollte.“"
                                            },
                                            {
                                                "example_id": "edeaa06c-6484-4697-808f-7d00156fc158",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Abschalten, entspannen, zu sich kommen in der Zürcher Innenstadt − das klingt zugegebenermassen wie ein Widerspruch in sich selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
