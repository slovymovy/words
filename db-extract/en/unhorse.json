                "senses": [
                    {
                        "sense_id": "0aec8e0d-f1c1-35e4-9c6a-b97f981fef7e",
                        "entry_id": "4f7dadef-0187-3039-97e4-2729a572e845",
                        "glosses": [
                            "To forcibly remove from a horse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66617825-aeac-45d4-a22b-357c2d32f122",
                                "sense_id": "0aec8e0d-f1c1-35e4-9c6a-b97f981fef7e",
                                "text": "The knight was unhorsed when his opponent's lance struck his shield."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1c3624d-a161-398f-bef9-70fdad36d20b",
                        "entry_id": "4f7dadef-0187-3039-97e4-2729a572e845",
                        "glosses": [
                            "To disrupt or unseat; to remove from a position."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "05280d53-ac34-4c31-a9ad-7ce3cf9d3089",
                                "sense_id": "c1c3624d-a161-398f-bef9-70fdad36d20b",
                                "text": "The incumbent governor was unhorsed by the scandal that broke during his reelection campaign."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75a4cd02-93cb-4a88-a5bf-9b7f4f98289b",
                        "source_entry_id": "4f7dadef-0187-3039-97e4-2729a572e845",
                        "source_sense_description": "remove from a horse",
                        "target_lang_word": "désarçonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désarçonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "353eebd5-9479-3aa6-bc1c-891c334d25d4",
                                        "entry_id": "474b492b-cf81-3325-a0de-c69cb0fee008",
                                        "glosses": [
                                            "Mettre hors des arçons, jeter hors de la selle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb839eb3-6388-4b4c-8b01-87b69b90074f",
                                                "sense_id": "353eebd5-9479-3aa6-bc1c-891c334d25d4",
                                                "text": "Ce cavalier se laisse rarement désarçonner."
                                            },
                                            {
                                                "example_id": "0d2cc558-b22e-4ead-b520-5dc009afca6e",
                                                "sense_id": "353eebd5-9479-3aa6-bc1c-891c334d25d4",
                                                "text": "Son cheval l’eut vite désarçonné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                        "entry_id": "474b492b-cf81-3325-a0de-c69cb0fee008",
                                        "glosses": [
                                            "Confondre quelqu’un dans une discussion, le mettre hors d’état de répondre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1e11d7-817a-4bbe-bd20-c990c38451dd",
                                                "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                                "text": "Cet avocat eut bientôt désarçonné son adversaire."
                                            },
                                            {
                                                "example_id": "a5ecb9cc-83f5-45c3-8888-54d9a3df8149",
                                                "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                                "text": "Ici, Jacques Coictier, que les répliques fougueuses de l’archidiacre avaient désarçonné, se remit en selle."
                                            },
                                            {
                                                "example_id": "dc8608c9-12ba-4e26-8d5c-275ce139cfa3",
                                                "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                                "text": "Le romancier, que ces propos désarçonnaient, fit effort pour se remettre en selle."
                                            },
                                            {
                                                "example_id": "93af81fa-3a7f-491e-8c5a-fbeefcb7f685",
                                                "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                                "text": "Vous avez fait, dans la chambre de mon mari, une jolie démonstration qui a convaincu l’inspecteur… C’était même si habile qu’un moment j’en ai été désarçonnée… Un moment dont vous avez eu tort de ne pas profiter…"
                                            },
                                            {
                                                "example_id": "63955a2a-315a-49d0-baa0-013187b2fb15",
                                                "sense_id": "0b79c542-ad35-3131-bbd4-352f7a7876b2",
                                                "text": "Lorsqu’on m’interroge sur mes intentions, je suis toujours désarçonné. Quand j’écris, mon intention initiale est, justement, de n’avoir aucune intention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
