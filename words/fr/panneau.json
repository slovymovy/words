                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "menuiserie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a sculpté de délicats motifs floraux sur chaque <w>panneau</w> de porte."
                        },
                        {
                            "text": "Les murs de la bibliothèque sont recouverts de superbes <w>panneaux</w> de bois ciré."
                        }
                    ],
                    "common_phrases": [
                        "panneau de porte",
                        "panneau de bois"
                    ]
                },
                {
