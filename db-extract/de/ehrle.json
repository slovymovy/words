                "senses": [
                    {
                        "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                        "entry_id": "e31fe62f-d94e-36fe-b177-c61a44897df4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f6590a-116f-436f-8a95-d575d75a5238",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Frau Ehrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dad4af2e-8b09-4f07-a9c8-cf2d93752617",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Herr Ehrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c65e3605-126e-4647-983e-9da546935f22",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Die Ehrles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3a7271e5-5596-449d-89a2-c9632a54b0dd",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Der Ehrle trägt nie die Schals, die die Ehrle ihm strickt."
                            },
                            {
                                "example_id": "07ca0026-290f-4159-8e07-496b45412188",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ehrle kommt, geht der Herr Ehrle.“"
                            },
                            {
                                "example_id": "bbb31a56-5a83-45b6-a9e5-b98a8dc98147",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Ehrle kommt und geht."
                            },
                            {
                                "example_id": "507a092e-425a-4476-a1f0-6566d14d2d1c",
                                "sense_id": "33339812-55d1-3ed2-b708-656b5c1dfe48",
                                "text": "Ehrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
