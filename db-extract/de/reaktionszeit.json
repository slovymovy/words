                        "form": "den Reaktionszeiten"
                    },
                    {
                        "form_id": "3f9e62b9-322b-46d6-9c20-b5b1c894bde4",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Reaktionszeit"
                    },
                    {
                        "form_id": "7b07ece4-269e-4e69-98b3-92b70568fd40",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reaktionszeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afb44e82-4a35-3162-b0a6-58d6f7e464f3",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "glosses": [
                            "benötigte Zeitspanne, um auf etwas zu reagieren, anzusprechen oder einzuwirken"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "f861cfaa-4d3f-4bec-a894-edb7fa13ac72",
                                "sense_id": "afb44e82-4a35-3162-b0a6-58d6f7e464f3",
                                "text": "„Die von Reilly et al. (2014) genutzten Längsschnittdaten enthalten Informationen zu den internen und externen Wechseln von Pflegepersonal der untersuchten zwölf Kliniken sowie der Patientenzufriedenheit (z. B. Freundlichkeit und Reaktionszeit des Personals) über fünf Jahre.“"
                            },
                            {
                                "example_id": "fc41881d-1dcf-4302-aa27-dc44a96cf8bb",
                                "sense_id": "afb44e82-4a35-3162-b0a6-58d6f7e464f3",
                                "text": "„Eine kurze Reaktionszeit setzt eine schnelle Datenübertragung voraus. Diese kann nur durch eine Online-Verbindung gewährleistet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9cc38d49-5d13-3e2a-a408-020225d66cf1",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "glosses": [
                            "Zeit, die zwischen der Wahrnehmung und dem Reagieren auf einen Reiz vergeht"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d6fff8be-b48e-49da-a0d3-ddb740d0d351",
                                "sense_id": "9cc38d49-5d13-3e2a-a408-020225d66cf1",
                                "text": "„Selbst unter idealen Verhältnissen beträgt die Reaktionszeit des Menschen etwa 0,1 sec, während in den meisten praktischen Situationen weit mehr Zeit zwischen einem Signal und der ihm zugeordneten Handlung verstreicht.“"
                            },
                            {
                                "example_id": "9fc53016-3bf6-42fe-866d-04102f5db42a",
                                "sense_id": "9cc38d49-5d13-3e2a-a408-020225d66cf1",
                                "text": "„Das Reaktionsgerät aus dem Wiener System (Schuhfried, Mödling) misst die Reaktionszeit auf optische und akustische Signale. Der Proband legt dazu einen Finger auf eine Ruhetaste und betätigt von hier aus die Drucktaste, wenn er die geforderten Signale oder die Signalkombination wahrnimmt.“"
                            },
                            {
                                "example_id": "bdd367ce-6a16-4dd1-85ad-1b9d373a0d19",
                                "sense_id": "9cc38d49-5d13-3e2a-a408-020225d66cf1",
                                "text": "„Bekanntlich ist die Reaktionszeit des Probanden um so größer, je mehr Information er zu verarbeiten hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "41d9e3ab-b9ef-34c5-ab80-e30468dcbe3e",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "glosses": [
                            "Zeit, die ein elektronisches Gerät oder Teil benötigt, um auf ein Signal zu reagieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5945f453-06b9-4dc8-bc7f-dcf35be42508",
                                "sense_id": "41d9e3ab-b9ef-34c5-ab80-e30468dcbe3e",
                                "text": "„Eine kurze Reaktionszeit setzt eine schnelle Datenübertragung voraus. Diese kann nur durch eine Online-Verbindung gewährleistet werden.“"
                            },
                            {
                                "example_id": "969376ba-1c7c-4632-87c4-476c3b837a27",
                                "sense_id": "41d9e3ab-b9ef-34c5-ab80-e30468dcbe3e",
                                "text": "„Sowohl die Reaktionszeit des Rechners als auch die tendenziell fotorealistische Darstellung sorgen für den virtuell plausiblen Eindruck.“"
                            },
                            {
                                "example_id": "9c3062bb-9d35-4268-b3e4-da5dbb8ce8cf",
                                "sense_id": "41d9e3ab-b9ef-34c5-ab80-e30468dcbe3e",
                                "text": "„Die Reaktionszeit des Sensormoduls kann in zwei Anteile aufgeteilt werden. Der erste Anteil betrifft die Zeit vom Berühren der Fläche bis zur Beleuchtung der entsprechenden Anzeige auf der Dekorfläche und somit der visuellen Rückmeldung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4b2f2af5-e754-39c6-b6c6-b8d85a8c4b93",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "glosses": [
                            "Geschwindigkeit, in der etwas chemisch reagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ccc28f1-8ac2-41a3-96d2-a1d789e43f05",
                                "sense_id": "4b2f2af5-e754-39c6-b6c6-b8d85a8c4b93",
                                "text": "„Im Versuch 2 ist die Konzentration an Bromat gegenüber derjenigen des Versuches 1 verdoppelt, die Reaktionszeit ist auf die Hälfte gesunken.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "780d3e4a-b0be-311c-bd81-dd1c5302cdbb",
                        "entry_id": "d1a85332-4217-3fe3-b63a-7138434cc54e",
                        "glosses": [
                            "Zeit nach dem Ende der Revolution von 1848 mit der Wiederherstellung des Deutschen Bundes und der Unterdrückung oppositioneller Bewegungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df1a4a00-630b-4dc0-b1ec-05f198f8def8",
                                "sense_id": "780d3e4a-b0be-311c-bd81-dd1c5302cdbb",
                                "text": "„Es erhoffte sich eine steile Hochschulkarriere, doch seine Pläne wurden durch die Reaktionszeit nach 1848 vereitelt.“"
                            },
                            {
                                "example_id": "15180e27-b146-4abd-a627-fafc682c1bd3",
                                "sense_id": "780d3e4a-b0be-311c-bd81-dd1c5302cdbb",
                                "text": "„Betrachtet man die Literatur zu den einzelnen Abschnitten der kurhessischen Geschichte näher, so fällt auf, daß die Zeit des Vormärz deutlich mehr Aufmerksamkeit findet als die Reaktionszeit nach 1848/49.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
