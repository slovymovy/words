                "senses": [
                    {
                        "sense_id": "c542e790-dfcb-33bc-aa2f-0f2b07e00974",
                        "entry_id": "114aa4bf-0985-3331-ba59-18ce3ee19aa4",
                        "glosses": [
                            "einem Schloss angegliedertes Gebäude, in dem Bedienstete, Beamte oder Gäste des Hofes wohnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d34457-bf66-4f2d-b065-b4f662307771",
                                "sense_id": "c542e790-dfcb-33bc-aa2f-0f2b07e00974",
                                "text": "„Im Kavaliershäuschen, das nach dem Auszug der Musikwissenschaftler renoviert wird, richtet die Universität eine Beratungsstelle für Doktoranden aller Fachbereiche ein.“"
                            },
                            {
                                "example_id": "dc6c15db-9502-4403-9d7b-7fae659ba95a",
                                "sense_id": "c542e790-dfcb-33bc-aa2f-0f2b07e00974",
                                "text": "„Im Musikvideo wählt Nyno deshalb den Weg der bewussten Verwirrung. ‚Camouflage und Leopard, Phyl Nyno ist wieder da, jetzt wird Hip-Hop wieder brav, ey, hör’ doch mal in den nächsten Part‘, singt er, während er im Leoparden-Kapuzenpulli vor den Kavaliershäuschen des Schloss Solitude entlang spaziert und im Hintergrund Maschinengewehrfeuer ertönt.“"
                            },
                            {
                                "example_id": "8c771024-fb44-4737-94e0-f9e529f94bf0",
                                "sense_id": "c542e790-dfcb-33bc-aa2f-0f2b07e00974",
                                "text": "„Lempke brachte aus Frankfurt ihren Lebensgefährten Toni Hyseni mit, der sich nach Vermittlung des THC-Präsidenten Karsten Döring als Pächter im Kavaliershäuschen selbstständig machte.“"
                            },
                            {
                                "example_id": "0fcd3eb9-b98e-4cf3-97c6-dadb9a9da0a6",
                                "sense_id": "c542e790-dfcb-33bc-aa2f-0f2b07e00974",
                                "text": "„Überall schwingen Geschichten mit: Auch, wenn Heinrich Kunst beim Gröönkohl-Äten 1960 in Bonn Heinrich Lübke ein lebendes Schwein überreicht oder wenn Männer in der Öffentlichen Badeanstalt an der Huntestraße 6 in einem der Kavaliershäuschen baden – das Badewasser wurde aus der Hunte hineingepumpt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
