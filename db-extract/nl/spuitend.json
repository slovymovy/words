                "forms": [],
                "senses": [
                    {
                        "sense_id": "bbb553a7-77ae-3db8-a533-1d88d391d107",
                        "entry_id": "28bf0f15-e434-3b64-821e-4272ee46def0",
                        "glosses": [
                            "met kracht een vloeistof uit een opening persend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5501f8d2-64f8-43b5-8e97-97ed2da8b6c0",
                                "sense_id": "bbb553a7-77ae-3db8-a533-1d88d391d107",
                                "text": "Het vuur ontstond door kortsluiting in de meterkast. De hitte die daardoor ontstond was zo groot dat de naastgelegen waterleiding smolt. Het rond spuitende water doofde de vlammen. Een sprinklerinstallatie had het resultaat niet kunnen verbeteren."
                            },
                            {
                                "example_id": "63e3416f-416a-469d-bc71-edd2e8a0705d",
                                "sense_id": "bbb553a7-77ae-3db8-a533-1d88d391d107",
                                "text": "Om het allemaal wat feestelijker te maken bedacht de toenmalige manager om het publiek met flessen bier te laten schudden. \"Het spuitende bier zorgde voor actie en een mooie sfeer\", zei voormalig bassist Willem Terhorst eerder tegen de NOS."
                            }
                        ]
                    }
