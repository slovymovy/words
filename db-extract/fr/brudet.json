                ],
                "senses": [
                    {
                        "sense_id": "5be031fd-62fe-38f3-ad89-f6ea7dcfc52b",
                        "entry_id": "8babe4d4-ae3c-3f43-a7d5-ed2d1343a7fd",
                        "glosses": [
                            "Soupe de poisson préparée, sous des noms proches, sur les côtes de Croatie et de divers pays de l’Adriatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568d28e4-8539-4837-bacd-6c733246dfed",
                                "sense_id": "5be031fd-62fe-38f3-ad89-f6ea7dcfc52b",
                                "text": "Les gens qui passent de temps à autre sous nos fenêtres, portant des bancs et de grandes marmites pour le brudet dans la Grand-Rue, pensent certainement à la fête, au jour férié."
                            },
                            {
                                "example_id": "7d51fba8-d9d8-4ee4-af2b-c82afd693ee5",
                                "sense_id": "5be031fd-62fe-38f3-ad89-f6ea7dcfc52b",
                                "text": "Populaire sur la côte dalmate, le brudet est un type de soupe de poisson croate similaire à la bouillabaisse."
                            },
                            {
                                "example_id": "a04c98f8-11af-492f-89dc-dba4a263d5c7",
                                "sense_id": "5be031fd-62fe-38f3-ad89-f6ea7dcfc52b",
                                "text": "Le brudet, le brujet, le brodet ou, si vous préférez, le brodetto, est le plat le plus répandu sur l’Adriatique croate, mais il est particulièrement apprécié dans toute la Dalmatie."
                            },
                            {
                                "example_id": "8ea44ab6-c690-43ac-bcc6-4cbc45c7e4c9",
                                "sense_id": "5be031fd-62fe-38f3-ad89-f6ea7dcfc52b",
                                "text": "Le secret d’un bon “brudet” consiste à mettre en valeur les qualités de certaines sortes de poissons moins connues, en créant un mélange de goûts harmonieux et inattendu."
                            }
                        ]
                    }
                ],
