                "senses": [
                    {
                        "sense_id": "b6058c97-c72f-3aa3-adca-570541cc34f4",
                        "entry_id": "e5b13ed6-337e-3104-adf1-75ff0cd90a81",
                        "glosses": [
                            "Zugang zur Gerichtsbarkeit"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "608e845c-4a1c-437e-85b2-95e558699aac",
                                "sense_id": "b6058c97-c72f-3aa3-adca-570541cc34f4",
                                "text": "Bei vielen Gewinnspielen kann man lesen: „Der Rechtsweg ist ausgeschlossen.“"
                            },
                            {
                                "example_id": "97502b41-94bd-47fd-ba1f-228f6bebdf11",
                                "sense_id": "b6058c97-c72f-3aa3-adca-570541cc34f4",
                                "text": "Nach Art. 19 des Grundgesetzes gilt: „Wird jemand durch die öffentliche Gewalt in seinen Rechten verletzt, so steht ihm der Rechtsweg offen.“"
                            },
                            {
                                "example_id": "40fcef59-85e2-42fc-93fa-3f851f2c9780",
                                "sense_id": "b6058c97-c72f-3aa3-adca-570541cc34f4",
                                "text": "Den Nachbarschaftsstreit mussten wir auf dem Rechtsweg klären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
