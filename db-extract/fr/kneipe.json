                        "examples": [
                            {
                                "example_id": "6c1f0272-046b-40d2-bf1e-e4e81e842570",
                                "sense_id": "480ddea7-6801-399f-8914-b18e227cafd1",
                                "text": "Pour ceux qui ne connaissent pas l'Allemagne ces mots ne seront peut-être pas clairs. Les Allemands ont inventé toutes sortes de règles, d'usages, de cérémonies qu'il faut observer dans les kneipes, et dont on trouvera le détail dans le livre de M. Sch."
                            }
