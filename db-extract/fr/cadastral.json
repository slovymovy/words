                "senses": [
                    {
                        "sense_id": "882ade8c-94e4-331f-bb82-760900123381",
                        "entry_id": "dcb73720-54a1-346c-b870-660d744027e6",
                        "glosses": [
                            "Relatif au cadastre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30068604-45e6-4460-b8aa-fa0ce1827b10",
                                "sense_id": "882ade8c-94e4-331f-bb82-760900123381",
                                "text": "Il se compose d'une maison de maître avec jardin , bâtimens d'habitation et d'exploitation , de 37 journaux 1/3 de terres labourables , de 9 hommées de pré et de 19 journaux de taillis ; contenances cadastrales et garanties."
                            },
                            {
                                "example_id": "7637431f-e15c-40c4-ae7b-c1bf4f1c41f1",
                                "sense_id": "882ade8c-94e4-331f-bb82-760900123381",
                                "text": "Les opérations cadastrales ont été commencées dans le département du Rhône en 1808, et ont été terminées en 1830."
                            },
                            {
                                "example_id": "0ae8561e-82fd-4e7d-8c3f-4ca1d4306536",
                                "sense_id": "882ade8c-94e4-331f-bb82-760900123381",
                                "text": "Elle a consisté en un relevé cadastral complet du terroir villageois : voie ferrée, piste principale, sentiers, maisons, plantations de cacaoyers, champs vivriers des deux saisons de cultures, limites entre Mom et les villages voisins."
                            }
                        ]
                    }
                ],
