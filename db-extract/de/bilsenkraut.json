                        "glosses": [
                            "ein Vertreter der Gattung Hyoscyamus aus der Familie der Nachtschattengewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d344de6-0bf9-4654-b822-97aa17896758",
                                "sense_id": "138ad7ee-0ee3-394c-9e98-72a4d2cde079",
                                "text": "Bilsenkräuter wachsen oft an alten Mauern und Ruinen."
                            },
                            {
                                "example_id": "b5a616f3-90c3-40c1-9ef1-fddb7a377113",
                                "sense_id": "138ad7ee-0ee3-394c-9e98-72a4d2cde079",
                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                            }
                        ],
