    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c003fe14-dd62-39e4-b8dd-0ccdc056271e",
                    "sense_definition": "państwo, którego głową i najwyższym władcą jest król lub królowa",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "monarchia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach to potężne <w>królestwo</w> obejmowało tereny wielu dzisiejszych krajów.",
                            "target_lang_translations": {
                                "en": "In ancient times, this powerful <w>kingdom</w> encompassed the territories of many modern-day countries."
                            }
                        },
                        {
                            "text": "Stolicą tego europejskiego państwa było starożytne miasto leżące w sercu <w>królestwa</w>.",
                            "target_lang_translations": {
                                "en": "The capital of this European state was an ancient city located in the heart of the <w>kingdom</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "korona"
                    ],
                    "antonyms": [
                        "republika"
                    ],
                    "common_phrases": [
                        "podział królestwa",
                        "granice królestwa"
                    ],
                    "target_lang_definitions": {
                        "en": "a country ruled by a king or queen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kingdom",
                                "target_lang_sense_clarification": "monarchical state"
                            },
                            {
                                "target_lang_word": "realm",
                                "target_lang_sense_clarification": "formal or literary term for a kingdom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a5a8c65-8143-3f63-ac31-bc32d81195df",
                    "sense_definition": "obszar, w którym dominuje określona cecha, zjawisko lub czyjś wyłączny wpływ",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta mała, przytulna kuchnia była prawdziwym <w>królestwem</w> mojej babci.",
                            "target_lang_translations": {
                                "en": "This small, cozy kitchen was truly my grandmother's <w>domain</w>."
                            }
                        },
                        {
                            "text": "Biblioteka uniwersytecka jest dla wielu studentów bezpiecznym <w>królestwem</w> ciszy i spokoju.",
                            "target_lang_translations": {
                                "en": "The university library is a safe <w>realm</w> of peace and quiet for many students."
                            }
                        }
                    ],
                    "synonyms": [
                        "świat"
                    ],
                    "common_phrases": [
                        "królestwo cieni",
                        "królestwo ciemności"
                    ],
                    "target_lang_definitions": {
                        "en": "an area or sphere dominated by a particular quality, phenomenon, or person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kingdom",
                                "target_lang_sense_clarification": "metaphorical domain or realm"
                            },
                            {
                                "target_lang_word": "realm",
                                "target_lang_sense_clarification": "sphere of activity or interest"
                            },
                            {
                                "target_lang_word": "domain",
                                "target_lang_sense_clarification": "area of control or dominance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee796b7-f92a-3a59-b6d6-d71198182ed4",
                    "sense_definition": "monarchistyczny ustrój polityczny, na którego czele stoi król",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "monarchia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej rewolucji zmieniono ustrój i obalono wieloletnie <w>królestwo</w>.",
                            "target_lang_translations": {
                                "en": "After a long revolution, the political system was changed and the longstanding <w>monarchy</w> was overthrown."
                            }
                        },
                        {
                            "text": "Norwegia została wówczas przekształcona z samodzielnego <w>królestwa</w> w duńską prowincję.",
                            "target_lang_translations": {
                                "en": "Norway was then transformed from an independent <w>kingdom</w> into a Danish province."
                            }
                        }
                    ],
                    "antonyms": [
                        "republika",
                        "demokracja"
                    ],
                    "target_lang_definitions": {
                        "en": "monarchical system of government headed by a king"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kingdom",
                                "target_lang_sense_clarification": "monarchy as a political system"
                            },
                            {
                                "target_lang_word": "monarchy",
                                "target_lang_sense_clarification": "system of royal governance"
                            },
                            {
                                "target_lang_word": "kingship",
                                "target_lang_sense_clarification": "state or institution of being a king"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8449b178-c687-364b-b9c3-e5114f82c2bd",
                    "sense_definition": "wysoka jednostka w systematyce organizmów żywych, obejmująca powiązane typy lub gromady",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rząd to określenie grupy taksonomicznej w <w>królestwie</w> roślin i zwierząt.",
                            "target_lang_translations": {
                                "en": "An order is a term for a taxonomic group in the plant and animal <w>kingdoms</w>."
                            }
                        },
                        {
                            "text": "Grzyby stanowią odrębne <w>królestwo</w> organizmów w nowoczesnej klasyfikacji biologicznej.",
                            "target_lang_translations": {
                                "en": "Fungi constitute a separate <w>kingdom</w> of organisms in modern biological classification."
                            }
                        }
                    ],
                    "common_phrases": [
                        "królestwo roślin",
                        "królestwo zwierząt"
                    ],
                    "target_lang_definitions": {
                        "en": "a major taxonomic category grouping related phyla or divisions in the classification of living organisms"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kingdom",
                                "target_lang_sense_clarification": "taxonomic rank"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb8e69ac-5a2e-30ed-a36e-c28aac2de708",
                    "sense_definition": "król i królowa traktowani wspólnie jako para małżeńska i panująca",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "monarchia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>królestwo</w> z zadowoleniem przyjęli zagraniczną delegację w pałacu.",
                            "target_lang_translations": {
                                "en": "<w>Their Majesties</w> gladly welcomed the foreign delegation at the palace."
                            }
                        },
                        {
                            "text": "Podczas uroczystej parady poddani serdecznie oklaskiwali ich <w>królestwo</w>.",
                            "target_lang_translations": {
                                "en": "During the ceremonial parade, the subjects warmly applauded <w>the royal couple</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ich królestwo"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane tradycyjnie na określenie pary królewskiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the king and queen considered together as a married and ruling couple"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Their Majesties",
                                "target_lang_sense_clarification": "the king and queen together"
                            },
                            {
                                "target_lang_word": "royal couple",
                                "target_lang_sense_clarification": "king and queen as spouses"
                            }
                        ]
                    }
                }
            ]
        }
    ]
