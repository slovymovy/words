                    }
                ],
                "senses": [
                    {
                        "sense_id": "23acfff5-a466-3abe-975f-60caed2e18f6",
                        "entry_id": "95574883-7695-3d61-a328-2f2dd421bc92",
                        "glosses": [
                            "zichzelf opofferend ten gunste van andere mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c5969e-4ec4-4ced-8429-b3d66a0ef9ee",
                                "sense_id": "23acfff5-a466-3abe-975f-60caed2e18f6",
                                "text": "We hoeven volgens Toxopeus niet altruïstisch te worden maar we moeten slimmer gaan worden in het samenwerken om de collectieve baten te verzorgen."
                            },
                            {
                                "example_id": "b384621d-434e-4e0d-a5aa-d62109f9a3a6",
                                "sense_id": "23acfff5-a466-3abe-975f-60caed2e18f6",
                                "text": "Het doel was te bekijken onder welke omstandigheden robots zich onzelfzuchtig zouden gaan gedragen. Dit is interessant omdat onduidelijk is hoe altruïstisch gedrag - zoals voedsel delen - evolutionair kan ontstaan terwijl het negatief uitwerkt op individuen die zich zo gedragen."
                            },
                            {
                                "example_id": "098b2be9-4d62-49c6-b98e-0f232ff71792",
                                "sense_id": "23acfff5-a466-3abe-975f-60caed2e18f6",
                                "text": "De 600 in het Theater Hotel aanwezige bezoekers mochten stemmen per SMS. Directeur Dennis Schipper van het genomineerde Demcon - uitgeroepen tot beste leverancier voor de hightechindustrie – had vooraf al heel altruïstisch laten weten zijn aanstaande huwelijk spannender te vinden dan de verkiezing en dat de aanwezigen daarom maar op het Solar Team moesten stemmen. Bestuursvoorzitter Victor van der Chijs van de eveneens genomineerde Universiteit Twente zei hetzelfde. Aldus geschiedde, het Solar Team won."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbddff5c-9b12-4862-9f24-e645acdd8341",
                        "source_entry_id": "95574883-7695-3d61-a328-2f2dd421bc92",
                        "source_sense_id": "23acfff5-a466-3abe-975f-60caed2e18f6",
                        "target_lang_word": "altruistic",
