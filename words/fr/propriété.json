                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est strictement interdit de pénétrer ici car c'est une <w>propriété</w> privée."
                        },
                        {
                            "text": "Le notaire a remis le titre de <w>propriété</w> aux acheteurs à la fin du rendez-vous."
                        }
                    ],
                    "synonyms": [
