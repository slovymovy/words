                "senses": [
                    {
                        "sense_id": "9aa4b002-17ec-31b2-9493-37190a91eee5",
                        "entry_id": "d8e91d92-fbec-31e9-aa72-ed2293cf56a7",
                        "glosses": [
                            "Catholiciser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee71192-e031-4bc6-b804-d93b018e08b0",
                                "sense_id": "9aa4b002-17ec-31b2-9493-37190a91eee5",
                                "text": "À certains égards, le catholicisme tend à se recatholiciser en dialoguant avec le protestantisme comme le protestantisme tend à se reprotestantiser en dialoguant avec le catholicisme dans la mesure où ce dialogue invite chaque confession à se penser au miroir de l’autre plutôt qu’au miroir des défis socioculturels du siècle."
                            },
                            {
                                "example_id": "90959e52-0634-48f4-a05e-596eee345f45",
                                "sense_id": "9aa4b002-17ec-31b2-9493-37190a91eee5",
                                "text": "Au conseiller spécial, le pays doit aussi être reconnaissant d’avoir tempéré l'influence de ceux qui voulaient recatholiciser la République."
                            }
                        ]
                    }
                ],
