                                    {
                                        "sense_id": "97c7dda6-171c-3e03-a459-b14f6941281e",
                                        "entry_id": "67ccabd4-1e83-3ef7-82d2-ff5b87f42090",
                                        "glosses": [
                                            "van vruchten: te rijp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d60b2756-0c53-4e08-88cd-d5b879403431",
                                                "sense_id": "97c7dda6-171c-3e03-a459-b14f6941281e",
                                                "text": "Bottura wil gaan koken met levensmiddelen die over datum zijn: „Ik heb altijd al gedacht dat broodkruim, overrijpe tomaten en bruine bananen mogelijkheden voor ons zijn om onze creativiteit te tonen. Het is zeker geen afval.”"
                                            },
                                            {
                                                "example_id": "08ad5491-bc4f-465b-9702-f88dd5b8fb2a",
                                                "sense_id": "97c7dda6-171c-3e03-a459-b14f6941281e",
                                                "text": "Met name overrijpe bessen hebben veel van hun gezonde stoffen verloren. Als je er echt voordeel van wil hebben, is het dus beter om het besje direct na aankoop puur uit de hand te eten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37428f6f-4f2f-4aae-8205-f4bf5c9b4342",
                        "source_entry_id": "27906e00-a2bf-3150-a38b-6ca414606a53",
                        "source_sense_id": "dbbd072e-7a83-31cd-8db0-34cf42dbad9f",
                        "source_sense_description": "excessively ripe; spoiled; gone bad",
                        "target_lang_word": "blet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                        "entry_id": "6a7eaf0c-3329-3b54-a243-c30d610a2fcd",
                                        "glosses": [
                                            "Dont la chair s’est ramollie et tachée, sans être encore gâtée, en parlant des fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c8626b5-62af-4f56-90f0-4806dd297108",
                                                "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                                "text": "Il semble même , par l'exemple des fruits des diospyros, du sorbier et du néflier, qu'on ne peut manger que blets, que plus l’acerbité a été grande, plus le fruit est susceptible de blessir régulièrement."
                                            },
                                            {
                                                "example_id": "5f7d62b7-9d05-4f01-8c05-39b902672f14",
                                                "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                                "text": "On mange à l’état blet les fruits de quelques espèces de […]"
                                            },
                                            {
                                                "example_id": "dea57cdc-acaf-4252-9c90-f9ddeca19001",
                                                "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                                "text": "Et une poire et des gaufrettes\n Seulement la poire était blette"
                                            },
                                            {
                                                "example_id": "cbb9b138-ae64-4cc4-a60c-e4dc9e04a389",
                                                "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                                "text": "Et dans la nuit qui tombe blette\nLes dix Indiens fument en rond"
                                            },
                                            {
                                                "example_id": "a0893222-73d6-4ed4-b659-0052a47b7750",
                                                "sense_id": "db877c95-154a-37ee-916e-8d429c623059",
                                                "text": "Je portais sans complexe ce physique usé. Ma tête dégoulinante de chair blette, de rides, de taches, comme un chapeau élimé qui a au moins le mérite de garantir du soleil et des ondées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "200a5380-9ebd-4617-aa83-06b8d0e67495",
                        "source_entry_id": "27906e00-a2bf-3150-a38b-6ca414606a53",
