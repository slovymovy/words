                                "target_senses": [
                                    {
                                        "sense_id": "7f516809-2137-34cb-9213-798ab96c6437",
                                        "entry_id": "49360253-5b7c-3cc4-a372-d00f7412b72e",
                                        "glosses": [
                                            "To move like the undulating surface of a body of water; to undulate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a5c88b-b19e-4b8f-8d17-8c9a45679ee7",
                                                "sense_id": "7f516809-2137-34cb-9213-798ab96c6437",
                                                "text": "Investments in research, deployment and scaling existing technologies are the initial ripples that will have to build to a groundswell of further action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e66a700d-d5c0-354b-b4e3-09948f568d29",
