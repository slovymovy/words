                "senses": [
                    {
                        "sense_id": "ba7da514-1519-301b-a65f-c75446600bac",
                        "entry_id": "42087d24-74a1-3a1a-a20e-498b86fbf246",
                        "glosses": [
                            "zehnter und letzter Tag – zugleich Ruhetag – der Dekade des französischen Revolutionskalenders"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c9555e77-b2ed-43ac-8707-b42ddc2a51c7",
                                "sense_id": "ba7da514-1519-301b-a65f-c75446600bac",
                                "text": "„Reiten Sie doch erst am Primidi oder Duodi, dann können Sie den Decadi noch mit uns feiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "720693ac-4f82-4e85-a9d4-3836a5e0e6f1",
                        "source_entry_id": "42087d24-74a1-3a1a-a20e-498b86fbf246",
                        "source_sense_id": "ba7da514-1519-301b-a65f-c75446600bac",
                        "source_sense_description": "letzter Tag der Dekade",
                        "target_lang_word": "décadi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décadi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd458c2-d96c-32f6-8bb6-85b58ee4cd10",
                                        "entry_id": "abfda883-b9a5-33c0-9a3e-575425748ad9",
                                        "glosses": [
                                            "Le dixième et dernier jour de la décade, dans le calendrier républicain. Ce jour était chômé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12199a00-2a40-4a66-a104-6f98be7e5db7",
                                                "sense_id": "3bd458c2-d96c-32f6-8bb6-85b58ee4cd10",
                                                "text": "Ils snobent le décadi en vaquant à leurs travaux comme à l’ordinaire, désertent les champs aux grandes fêtes liturgiques, s’entêtent à ne pas fixer les foires aux jours décrétés par l’administration révolutionnaire, […]"
                                            },
                                            {
                                                "example_id": "824f8b79-1c75-4337-9956-97490427c579",
                                                "sense_id": "3bd458c2-d96c-32f6-8bb6-85b58ee4cd10",
                                                "text": "… je les voyais en costume du temps, en petite robe simplette, avec des frisons à la grecque retombant sur un velours qui leur serrait le front, — s’amusant pendant leurs récréations du décadi, à la lumière d’un soleil plus jeune que le nôtre…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
