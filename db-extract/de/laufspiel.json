                "senses": [
                    {
                        "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                        "entry_id": "bde7e23b-d345-32e2-8137-979963bc209f",
                        "glosses": [
                            "Spiel, bei dem die schnelle Fortbewegung mit den Beinen im Zentrum steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a32657-e898-4c7d-8837-1847a8aeba10",
                                "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                                "text": "„Sie behandelten im Wortsinne den übergroßen Raum mit den überlegenen Mitteln des Laufspiels und des weitgreifenden Wurfspiels.“"
                            },
                            {
                                "example_id": "369e0dc1-50af-41d5-8867-993e5ee809b7",
                                "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                                "text": "„Als aktive Mitspieler könnten Spielpädagogen auch dafür sogen, dass traditionelle Bewertungsmuster wie beim Spiel Erde und Paradies oder das Ausscheiden aus dem Spiel wie bei den meisten Lauf- und Fangspielen abgeändert werden zugunsten einer relativ schnellen Beendigung von Spieldurchgängen und eines Wechsels der Rollen- und Spielgruppen.“"
                            },
                            {
                                "example_id": "dfd2f23d-0ef3-40de-86ea-9e94badf28ab",
                                "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                                "text": "„Der Bewegungstrieb verlangt nach Bewegungs- und Sportspielen: er beflügelt körperbezogene Aktivitäten und Interaktionsformen wie Fangspiele, Hüpfspiele, Laufspiele, Staffelspiele oder Ballspiele.“"
                            },
                            {
                                "example_id": "a1dbd872-a1de-4ea6-97a4-7ed390643f8d",
                                "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                                "text": "„Der Neuling zahlte dem kräftezehrenden Laufspiel der ersten 45 Minuten Tribut und konzentrierte sich fast vollständig auf die Defensivarbeit.“"
                            },
                            {
                                "example_id": "1525abdf-b60d-428d-a393-8372ca5e329e",
                                "sense_id": "b2138322-74f9-36e8-b52b-f37b9d52af89",
                                "text": "„Wilson fand immer wieder mit klugen Pässen seine Mitspieler, Runningback Marshawn Lynch war im Laufspiel von der Patriots-Defensive einfach nicht zu stoppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
