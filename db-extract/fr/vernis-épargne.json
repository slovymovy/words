                "senses": [
                    {
                        "sense_id": "a4a2345c-2de5-30f4-ae51-479364899d79",
                        "entry_id": "61a4ae61-7a63-3473-8163-597dc18d63df",
                        "glosses": [
                            "Couche de vernis déposée (souvent par sérigraphie) sur un circuit imprimé, pour délimiter les zones mouillées par la brasure tendre utilisée notamment pour le montage des composants, avec aussi un rôle de protection pour la surface du circuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06b900e-39e5-4dff-8909-17b818cd99e3",
                                "sense_id": "a4a2345c-2de5-30f4-ae51-479364899d79",
                                "text": "En cas de petits défauts dans le vernis-épargne, la retouche est acceptable pour autant qu’elle soit effectuée dans les règles de l’art et avec un matériau équivalent à celui d’origine."
                            },
                            {
                                "example_id": "25e1d933-c076-41cc-bd50-d09849ec5077",
                                "sense_id": "a4a2345c-2de5-30f4-ae51-479364899d79",
                                "text": "Les vernis-épargnes modernes sont photopolymérisables, ce qui permet d’atteindre des résolutions élevées par des techniques de photolithographie."
                            }
                        ]
                    }
                ],
