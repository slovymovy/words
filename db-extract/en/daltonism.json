                                        "entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                                        "glosses": [
                                            "Toutes dyschromatopsies."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed3bd8ce-14d2-43d1-a8c1-da1ebee65fa3",
                                                "sense_id": "bf78fea5-8775-3a41-ab4e-24ed30527fa7",
                                                "text": "Le daltonisme (ou dyschromatopsie) est une anomalie de la vision des couleurs qui est héréditaire et congénitale, ce qui signifie qu’elle se transmet aux générations suivantes, et qu’elle n’évolue pas au cours de la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
