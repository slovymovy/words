                                        "glosses": [
                                            "Músculos de los animales, considerados como alimento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a963db-3ef7-46e0-99e5-ce22c75a0860",
                                                "sense_id": "db968eea-cc9f-3d08-83b2-54dbc9bb4b77",
                                                "text": "No sé, la carne de cordero no es tan sabrosa como pensaba. ¡Qué decepción!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c6252cd-d913-3d83-9dde-81a43d7c97f1",
