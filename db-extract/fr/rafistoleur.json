                        "sense_id": "dec8c31a-4109-3bea-9880-24e8c17bb080",
                        "entry_id": "6a99ae78-081a-32f0-acc3-29b4e46f03cb",
                        "glosses": [
                            "Personne qui rafistole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af1f492-00e7-403f-9270-531307456ad8",
                                "sense_id": "dec8c31a-4109-3bea-9880-24e8c17bb080",
                                "text": "Pas question qu’un rafistoleur vienne triturer ma toiture"
                            },
                            {
                                "example_id": "2de2d1c2-e1d1-486f-bb0b-29b4685ba6f0",
                                "sense_id": "dec8c31a-4109-3bea-9880-24e8c17bb080",
                                "text": "Cette population instable qui vit en marge du grand Paris, les rafistoleurs de faïence et de parapluies, les rempailleuses et les matelassières, les chineurs et les mendigots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a19180a-d7a8-492d-afaf-b7f5bf8dad58",
                        "source_entry_id": "6a99ae78-081a-32f0-acc3-29b4e46f03cb",
                        "source_sense_id": "dec8c31a-4109-3bea-9880-24e8c17bb080",
                        "target_lang_word": "Pfuscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfuscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                        "entry_id": "2742a6ed-acd0-3468-b72f-4b798e5df7a8",
                                        "glosses": [
                                            "Person, die unprofessionell oder schlecht arbeitet"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1423a0-aa80-4a9a-b13c-014a46c133af",
                                                "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                                "text": "„Explodierende Mieten, Schuldenkrise und niedrige Zinsen-nie war es verlockender, sein Vermögen in ein Eigenheim zu investieren. Doch das Projekt kann schnell zum Alptraum werden, wenn man an Pfuscher oder Betrüger gerät.“"
                                            },
                                            {
                                                "example_id": "8582c656-7630-4797-9a0d-f4f23dbcae1d",
                                                "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                                "text": "„Jeder Pfuscher wäre gut genug dazu gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                        "entry_id": "2742a6ed-acd0-3468-b72f-4b798e5df7a8",
                                        "glosses": [
                                            "Person, die ohne Bezahlung von Steuern und Sozialabgaben arbeitet"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1010ac25-f53f-4e65-8570-f47264d0b262",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Pfuscher zahlen weder Steuern noch Sozialabgaben, die öffentliche Hand muss Mindereinnahmen durch Steuererhöhungen kompensieren.“"
                                            },
                                            {
                                                "example_id": "7896bc3e-9574-4f7e-a569-efe7f6fa9b3d",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Er sei noch Lehrling und keinesfalls Schwarzarbeiter oder Pfuscher.“"
                                            },
                                            {
                                                "example_id": "b97f9eb2-2a21-4bcd-940c-747fc420d502",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Der Zweck der Strafnorm […] liegt letztlich […] darin, das öffentliche Interesse an der Entrichtung von Steuern, Abgaben und Beiträgen zur Sozialversicherung bei der Beschäftigung von Ausländern durchzusetzen, einen geordneten Arbeitsmarkt sicherzustellen, die legalen Beschäftigungschancen inländischer und integrierter ausländischer Arbeitnehmer zu wahren (Arbeitsmarktprüfung, Ersatzkraftstellung) und ausländische Arbeitnehmer vor ausbeuterischen Lohn- und Arbeitsbedingungen sowie Arbeitgeber vor unlauterem Wettbewerb durch Pfuscher und Lohndumping durch in- und ausländische Unternehmen zu schützen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59e0f4d1-17cb-40fb-84dd-db1eedd5c5e7",
                        "source_entry_id": "6a99ae78-081a-32f0-acc3-29b4e46f03cb",
                        "source_sense_id": "dec8c31a-4109-3bea-9880-24e8c17bb080",
                        "target_lang_word": "Stümper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stümper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die auf einem Gebiet, auf dem sie tätig ist, nur wenige oder gar keine Kenntnisse hat"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2daff2-473c-498f-8815-be91cebe33fb",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Gute Musiker wollen sie dulden oder sogar fördern; Stümper an der Klampfe oder Fiedler mit Einliedrepertoire sollen aus U-Bahnen und Fußgängerzonen verschwinden.“"
                                            },
                                            {
                                                "example_id": "a1ca4af6-83ee-4cd0-8c34-d452e3265c67",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Allerdings wird aus den Prozessunterlagen jetzt deutlich, daß die Terrorkumpane des al-Sarkawi im Ruhrgebiet eher eine Bande von Stümpern als Profis waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die sich bei etwas keine Mühe gibt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18881293-ddaa-47e8-b34e-b42d6d4a196b",
                                                "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                                "text": "„Mein lieber Barbaro hielt die Karten wie ein Stümper; das gefiel mir von Anfang an nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
