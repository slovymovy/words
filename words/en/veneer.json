{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c765e12-2a53-3752-a5ed-73d447edf73a",
                    "sense_definition": "A thin layer of fine wood or other decorative material applied to the surface of a cheaper material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The table was made of cheap pine covered with a thin oak <w>veneer</w>."
                        },
                        {
                            "text": "Over the years, the <w>veneer</w> on the cabinet had begun to peel away."
                        }
                    ],
                    "synonyms": [
                        "facing",
                        "overlay"
                    ],
                    "common_phrases": [
                        "wood veneer",
                        "oak veneer"
                    ]
                },
                {
                    "sense_id": "99f4c3c2-9efe-330d-a8a0-c2d7e565e8ae",
                    "sense_definition": "An attractive or polite outward appearance that conceals someone's true feelings or underlying reality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deceptive_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Behind her calm <w>veneer</w> of politeness, she was boiling with anger."
                        },
                        {
                            "text": "The scandal quickly stripped away the company's <w>veneer</w> of respectability."
                        }
                    ],
                    "synonyms": [
                        "facade",
                        "mask",
                        "pretense",
                        "guise"
                    ],
                    "common_phrases": [
                        "thin veneer",
                        "veneer of politeness",
                        "veneer of respectability"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f96ebee-8443-3443-9604-8226d0c5567f",
                    "sense_definition": "To cover a surface with a thin layer of decorative material such as fine wood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Craftsmen chose to <w>veneer</w> the modern desk with dark walnut."
                        },
                        {
                            "text": "The interior walls were neatly <w>veneered</w> in polished mahogany."
                        }
                    ],
                    "synonyms": [
                        "overlay",
                        "face"
                    ],
                    "common_phrases": [
                        "veneer with"
                    ]
                },
                {
                    "sense_id": "ba0a91c6-6eab-3ff2-a8bd-86d7dab3bef7",
                    "sense_definition": "To cover or disguise unpleasant truths, faults, or bad intentions with a pleasant exterior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceptive_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>veneer</w> his hostility with forced smiles and compliments."
                        },
                        {
                            "text": "The legislation thinly <w>veneered</w> harsh restrictions with claims of public safety."
                        }
                    ],
                    "synonyms": [
                        "disguise",
                        "mask",
                        "camouflage",
                        "gloss over"
                    ],
                    "antonyms": [
                        "expose",
                        "reveal"
                    ]
                }
            ]
        }
    ]
}