                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c0538c9-1c8f-4438-9eff-67c1c5ca6520",
                        "source_entry_id": "a2a72163-cc0e-3519-a81b-d96967b429f1",
                        "source_sense_id": "a767ed21-71d6-3e9c-aca7-9e0ecfad85f2",
                        "source_sense_description": "bot van de wervelkolom",
                        "target_lang_word": "Wirbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine um eine gemeinsame Mittellinie kreisende Strömung (Gas oder Flüssigkeit)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b48128-3658-48fc-9d55-edfe991dcea4",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                                            },
                                            {
                                                "example_id": "f926c8ef-1cb8-4328-abea-68a4594a6c4b",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "Das aus einer Badewanne ablaufende Wasser bildet am Abfluss einen Wirbel."
                                            },
                                            {
                                                "example_id": "9c6c3be1-598b-4d14-b835-2e604f2c260e",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Das schwarze Wasser unterspülte das Ufer, und kleine Wirbel trieben in einem Bogen vorbei und griffen nach den Wurzeln, die ins Wasser hinunterhingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine Stelle der Haut (zum Beispiel Kopfhaut oder Fell), an der das Haar strahlenförmig auseinandergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b286b7-a3f2-4696-b3d5-b797e5d75005",
                                                "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                                "text": "Der Scheitel wird vom Wirbel aus gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "787678cc-b946-3bf6-84f9-47d352105cd3",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Knochen der Wirbelsäule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aefcddd8-4966-43e8-adf5-0f4d9db2e35a",
                                                "sense_id": "787678cc-b946-3bf6-84f9-47d352105cd3",
                                                "text": "Auch der Hals der Giraffe besitzt nur sieben Wirbel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7ad4b973-0668-33f6-83a0-fa72a2c91d8c",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Vorrichtung zum Spannen der Saiten bei Saiteninstrumenten"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "936a1cbd-1952-44d9-b0bd-ab3bec0eaa70",
                                                "sense_id": "7ad4b973-0668-33f6-83a0-fa72a2c91d8c",
                                                "text": "Ein Wirbel ist kaputt, da muss ich dauernd nachstimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4fea3eda-4ae3-389f-a0e7-d575e5c9519a",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Angelzubehör zum gegeneinander verdrehbaren Verbinden von Hauptschnur und Vorfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3090df9c-d936-424a-88e9-5071ad4398cd",
                                                "sense_id": "4fea3eda-4ae3-389f-a0e7-d575e5c9519a",
                                                "text": "Er knotete einen Wirbel an die Hauptschnur, um daran das Vorfach einzuschlaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0e06d008-af29-312b-bb9a-fe7eddc33338",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "großer Trubel, wildes Durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab4b2a1-9e6c-461f-809f-a16bbf0699b1",
                                                "sense_id": "0e06d008-af29-312b-bb9a-fe7eddc33338",
                                                "text": "„Val und Joe waren viel zu aufgebracht, um Bert mit dem ihm gebührenden Wirbel zu begrüßen, also nahmen Rosa und Bobby es auf sich, ihn im Slalom um die Bücherregale zu jagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "erhebliches Aufsehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13ffaf6-5dce-465c-860c-2036fbbb6ca9",
                                                "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                                "text": "Sie verursachte einen erheblichen Wirbel in der Versammlung."
                                            },
                                            {
                                                "example_id": "fba2a2af-489d-4588-921f-e3f47185f3c0",
                                                "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                                "text": "„Wieder einmal sorgt US-Präsident Trump mit rassistischen Äußerungen für Wirbel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86099280-0cdb-4ffc-8ba3-ac0116583450",
                        "source_entry_id": "a2a72163-cc0e-3519-a81b-d96967b429f1",
                        "source_sense_id": "a767ed21-71d6-3e9c-aca7-9e0ecfad85f2",
                        "source_sense_description": "bot van de wervelkolom",
                        "target_lang_word": "vertebra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertebra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1cba23-4814-3270-9c4b-54241187635d",
                                        "entry_id": "aad65465-c7ac-30eb-a4bf-5bbf43820a51",
                                        "glosses": [
                                            "Any of the bony or cartilaginous segments which make up the backbone, consisting in some lower vertebrates of several distinct elements which never become united, and in higher vertebrates having a short more or less cylindrical body whose ends articulate by pads of elastic or cartilaginous tissue with those of adjacent vertebrae and a bony arch that encloses the spinal cord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ffd619e-9d4f-4641-92dc-15d558c8cac3",
                                                "sense_id": "5d1cba23-4814-3270-9c4b-54241187635d",
                                                "text": "Already I seemed to hear the water rippling against the desiccated bones and rattling them together, rolling my skull against Mahomed's, and his against mine, till at last Mahomed's stood straight up upon its vertebræ, and glared at me through its empty eyeholes, and cursed me with its grinning jaws, because I, a dog of a Christian, disturbed the last sleep of a true believer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff3223c-752e-4e1a-b484-7fcbbfdefe39",
                        "source_entry_id": "a2a72163-cc0e-3519-a81b-d96967b429f1",
                        "source_sense_id": "a767ed21-71d6-3e9c-aca7-9e0ecfad85f2",
                        "source_sense_description": "bot van de wervelkolom",
                        "target_lang_word": "vertèbre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                        "entry_id": "26d96cfc-7f60-385f-901f-c090a6d8884a",
                                        "glosses": [
                                            "Chacun des os en forme de petits disques irréguliers qui, s’articulant les uns avec les autres, composent la colonne vertébrale chez les vertébrés dont l’humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36eb4b9-0f30-4689-9b2e-90d059f33354",
                                                "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                                "text": "Plus tard, les révolutionnaires ont détruit les reliques, à l’exception d’un avant-bras qui fut sauvé par une institutrice de la ville et d’une vertèbre sauvée par un porte-châsse."
                                            },
                                            {
                                                "example_id": "3b1712a0-d5a0-4f70-acd0-9ac435cef3f9",
                                                "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                                "text": "En 1845, New York s’ébaudissait devant le squelette dHydrargos, « le grand serpent des mers », long de 34 mètres. Albert Koch, qui exhibait sous ce nom le cétacé fossile Basilosaurus, avait pris soin de l’allonger en multipliant ses ''vertèbres, et l’imposteur fit fortune."
                                            },
                                            {
                                                "example_id": "7d0d8d36-6cc9-416c-afe5-3fbf3bea5dce",
                                                "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                                "text": "La colonne vertébrale de l’homme comporte 7 vertèbres cervicales, 12 vertèbres dorsales, 5 vertèbres lombaires, 5 vertèbres sacrées ou sacrales soudées (le sacrum) et 4 ou 5 vertèbres coccygiennes ou caudales soudées (le coccyx)."
                                            },
                                            {
                                                "example_id": "c5822842-eece-45c4-a065-43035fc0bd05",
                                                "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                                "text": "La colonne vertébrale du cheval comporte 7 vertèbres cervicales, 18 vertèbres dorsales, 6 ou 5 vertèbres lombaires, 5 vertèbres sacrées ou sacrales soudées (le sacrum) et 15 à 18 vertèbres coccygiennes."
                                            },
                                            {
                                                "example_id": "d45671fa-b478-4878-b9aa-aa7b21e219c3",
                                                "sense_id": "96db156b-7c4f-3dbb-b344-977b9c20a881",
                                                "text": "La colonne vertébrale du bœuf comporte 7 vertèbres cervicales, 13 vertèbres dorsales, 6 vertèbres lombaires, 5 vertèbres sacrées ou sacrales soudées (le sacrum) et 16 à 20 vertèbres coccygiennes."
                                            }
                                        ]
                                    }
                                ]
                            },
