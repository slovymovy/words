                "senses": [
                    {
                        "sense_id": "1d1a9c66-17b1-3fec-b112-63b2e2190485",
                        "entry_id": "d1e6c520-e346-36d3-9448-2fec9de5170a",
                        "glosses": [
                            "Teemischung, auf der Basis medizinisch wirksamer Kräuter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07987df4-2395-4a6b-8d23-69961d196ce4",
                                "sense_id": "1d1a9c66-17b1-3fec-b112-63b2e2190485",
                                "text": "„Arzneitee sollte möglichst frisch zubereitet werden.“"
                            },
                            {
                                "example_id": "9107eabf-5e95-4772-b182-83d3de254b53",
                                "sense_id": "1d1a9c66-17b1-3fec-b112-63b2e2190485",
                                "text": "„Ein Arzneitee ist v. a. bei Krankheitsbildern mit erhöhtem Flüssigkeitsbedarf angebracht.“"
                            },
                            {
                                "example_id": "7cac10cb-cfb8-4172-8a7d-28efa4cb49fc",
                                "sense_id": "1d1a9c66-17b1-3fec-b112-63b2e2190485",
                                "text": "„Die Grenze zwischen Kräutertee und Arzneitee ist relativ fließend. Viele Pflanzenteile, die gut schmecken, verfügen über eine nicht unerhebliche Heilwirkung, so dass aus einem Kräutertee recht schnell ein Arzneitee werden kann.“"
                            },
                            {
                                "example_id": "8370ccd6-65bf-4287-809b-060fc605f90c",
                                "sense_id": "1d1a9c66-17b1-3fec-b112-63b2e2190485",
                                "text": "„Man sollte immer eine kleine Auswahl im Hause haben, da jede Teesorte ihre ganz eigene Wirkung entfaltet. Wir entscheiden zunächst zwischen Haustee und Arzneitee. Arzneitee, wie etwa Salbeitee, darf nur für einen begrenzten Zeitraum getrunken werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
