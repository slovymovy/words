                        "examples": [
                            {
                                "example_id": "00872905-b296-4c81-a90f-1723ea45c777",
                                "sense_id": "9ab1f1da-7330-3114-b789-248a376165f7",
                                "text": "Par cette chaleur, qu'il est bon de siroter une chambéryzette !"
                            },
                            {
                                "example_id": "79e539a9-23cd-43bb-b849-070b5bc93b0d",
                                "sense_id": "9ab1f1da-7330-3114-b789-248a376165f7",
                                "text": "— Allez le conférencier, vous reprendrez bien de la Chambéryzette ! Elle fait, paraît-il, tomber les dents des Savoyards qui la boivent !"
                            },
                            {
                                "example_id": "beec74e5-7002-478e-b35a-aed1f6531668",
                                "sense_id": "9ab1f1da-7330-3114-b789-248a376165f7",
                                "text": "La Chambéryzette est un vermouth français parfumé aux fraises des bois. Délicieux pour certains, écœurant pour d’autres."
                            }
                        ]
