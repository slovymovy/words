                        "entry_id": "540f1e16-5b95-3d1a-aece-c6598c72235b",
                        "glosses": [
                            "Petit chatouillement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf2c21b-3e94-4a02-8e9c-db550d77c78f",
                                "sense_id": "f93c2825-e771-35bd-931a-b721e29939ed",
                                "text": "Pour la guérison de tous ceux qui sont de la terre, ceux qui ont de l’herbe dans le sang, de grandes poitrines en prairies et en vergers, des bras comme la branche des chênes, la peau comme de l’écorce d’arbre, et le chatouillis du vent dessus."
                            },
                            {
                                "example_id": "c4b3bfe0-da03-45cf-acad-8b02ace41402",
                                "sense_id": "f93c2825-e771-35bd-931a-b721e29939ed",
                                "text": "Un chatouillis insistant tire Géraldine du sommeil."
                            }
                        ]
                    }
                ],
