                "translations": [
                    {
                        "translation_id": "2c1501f7-278d-402c-b275-5ff916edeff3",
                        "source_entry_id": "36f1df33-1c4a-36a6-bafe-9a72bda1b7da",
                        "source_sense_id": "c43e0987-aa32-3125-8d0e-85fc59da2273",
                        "target_lang_word": "indifference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indifference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "The state of being indifferent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d345c28b-656b-4d8a-8a21-7e08bc97b6b4",
                                                "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                                "text": "\"I do not care for them; I would not have them now,\" cried Lady Penrhyn; \"it is only your affection I care for. Do not suppose, for a moment, that I wish for the tables when you do not: oh, no! my only concern was for your indifference. But I am content if you tell me I was mistaken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27db88c-7273-307a-8052-46118583ce1b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unbiased impartiality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unemotional apathy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe74535a-2673-4243-b1ba-a0c645804ac4",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "His daughter's indifference towards the sexist group made him wonder if she felt no empathy for the bullied."
                                            },
                                            {
                                                "example_id": "59bc99c5-eb46-4f3c-b268-f80e9563c626",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "I wish the consequences of this moment for young women punctured the apparent indifference of so many men and boys I saw that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f444eaa-e3f2-3a51-aa04-1b3a0d65594b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "A lack of enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unconcerned nonchalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b5fe27-4d36-434c-8cad-fdf51614a63c",
                                                "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Self-identity defined through the negation of difference, non-difference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41dda57-14d0-4802-9f64-925669bf2cc3",
                                                "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                                "text": "\"I call reason absolute reason, or reason insofar as it is conceived as the total indifference of the subjective and objective.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba56686e-5cf6-4e8f-8d89-bac81cec6345",
                        "source_entry_id": "36f1df33-1c4a-36a6-bafe-9a72bda1b7da",
                        "source_sense_id": "c43e0987-aa32-3125-8d0e-85fc59da2273",
                        "target_lang_word": "phlegm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phlegm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "One of the four humors making up the body in ancient and mediaeval medicine; said to be cold and moist, and often identified with mucus."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd5412b-453d-449c-b1b1-ffb713cea4be",
                                                "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                                "text": "Each person's unique mixture of these substances determines his temperament: a predominance of blood gives a sanguine temperament; a predominance of phlegm makes one phlegmatic; yellow bile, bilious (or choleric); and black bile, melancholic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Viscid mucus produced by the body, later especially mucus expelled from the bronchial passages by coughing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7272c6e6-3103-42bb-891c-0b08b07846df",
                                                "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                                "text": "Even some members of the new bourgeoisie indulge in conspicuously boorish behavior, like hawking phlegm onto the pavement or picking their noses at business meetings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "A watery distillation, especially one obtained from plant matter; an aqueous solution."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae850d3a-a7a3-408f-8ddd-9cfb4781595f",
                                                "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                                "text": "The attempts made to analyse vegetable substances previous to 1720, merely produced their resolution into the supposed elements of the chemists of those days, namely, salts, Earths, phlegm, and sulphur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Calmness of temperament, composure; also seen negatively, sluggishness, indifference."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89beed40-1f95-4c0f-b665-e032cdee90ec",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "Orloff's phlegm broke completely, and he snatched at the monocle as it dropped[.]"
                                            },
                                            {
                                                "example_id": "6b6ec911-918b-47ad-911d-9aa20f1dddad",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "But Swedish Nazis also talked of the necessity of saving Sweden from Bolshevism, and with the menacing Berlin radio gnawing in their ears many Swedes lost their Scandinavian phlegm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96fd7c23-cf5d-4f5f-8584-607bf0b205d3",
                        "source_entry_id": "36f1df33-1c4a-36a6-bafe-9a72bda1b7da",
                        "source_sense_id": "c43e0987-aa32-3125-8d0e-85fc59da2273",
                        "target_lang_word": "parsimonia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parsimonia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0c78da53-d65a-3c47-8d0c-8d983d451c66",
                                        "entry_id": "f7667083-2bc9-3015-9d40-b4944e121ef9",
                                        "glosses": [
                                            "Moderación en el gasto y en los placeres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b145f06-a3b8-4892-ab82-48493233c04e",
                                                "sense_id": "0c78da53-d65a-3c47-8d0c-8d983d451c66",
                                                "text": "Un anillo de hierro y sin alguna piedra enviaba el marido a la mujer, y le llamaban anillo casamentero, con el cual significaban la parsimonia que requería la vivienda matrimonial para sustentar su familia."
                                            },
                                            {
                                                "example_id": "0eb4b161-5782-49b1-9462-5fb997640aba",
                                                "sense_id": "0c78da53-d65a-3c47-8d0c-8d983d451c66",
                                                "text": "Y esta vino a ser toda la corte que entonces tantas veces se mudaba en Castilla y puédese notar su parsimonia y moderación, pues no avía villeta donde no cupiese y se aposentase."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "385b6e43-8868-34f9-b96d-2c0a2df62ad1",
                                        "entry_id": "f7667083-2bc9-3015-9d40-b4944e121ef9",
                                        "glosses": [
                                            "Calma y lentitud excesivas en el habla y en las acciones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c81a25-62be-4274-8373-8692772fce03",
                                                "sense_id": "385b6e43-8868-34f9-b96d-2c0a2df62ad1",
                                                "text": "Este proyecto fue el que siguió el duque de Brunswich, pero con tanta lentitud y parsimonia, que fueron inútiles sus ventajas."
                                            },
                                            {
                                                "example_id": "25baa608-5662-4e5e-b6b5-a7fa7d4a8311",
                                                "sense_id": "385b6e43-8868-34f9-b96d-2c0a2df62ad1",
                                                "text": "La salida deberá hacerse con pies, pues aunque el toro, como ya dijimos antes, no recargará, suele salir con mucha parsimonia, y á veces quedarse quieto en su terreno; y si el picador tambien lo hace, le falta una gran parte de lucimiento á la suerte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0371f9e-f235-3218-bb61-bcc40a199114",
                                        "entry_id": "f7667083-2bc9-3015-9d40-b4944e121ef9",
                                        "glosses": [
                                            "Por extensión, preferencia por la explicación más simple entre varias alternativas, usada como principio heurístico en la ciencia moderna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b727dd84-45a1-4376-ba0c-efb562648107",
                                                "sense_id": "c0371f9e-f235-3218-bb61-bcc40a199114",
                                                "text": "El canon de Lloyd Morgan, también denominado ley de la parsimonia, no hacía sino resucitar el viejo aforismo escolástico de no complicar los entes sin necesidad."
                                            },
                                            {
                                                "example_id": "e74de502-cd3a-49af-ba4d-b518dbc12906",
                                                "sense_id": "c0371f9e-f235-3218-bb61-bcc40a199114",
                                                "text": "en consecuencia se constituyen en defensores de la evolución gradual, estrictamente darwiniana. Para ellos, el gradualismo debe aceptarse ante todo por el principio de parsimonia."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f370eb96-6fb1-3319-bebb-e30f4492951f",
                                        "entry_id": "f7667083-2bc9-3015-9d40-b4944e121ef9",
                                        "glosses": [
                                            "Circunspección, templanza."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
