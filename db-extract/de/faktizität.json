                "senses": [
                    {
                        "sense_id": "63592d7b-ec1c-3f07-9434-285d9966f422",
                        "entry_id": "e395ed82-c22b-31f6-8dbf-cc8bd9bd3352",
                        "glosses": [
                            "Tatsächlichkeit, Nachweisbarkeit, Gegebenheit eines Dings oder Sachverhalts"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "49ada513-69d0-48a5-ba33-9a7398ee72dd",
                                "sense_id": "63592d7b-ec1c-3f07-9434-285d9966f422",
                                "text": "„Dabei werden im Text die narrativen Strategien zur Erzeugung einer scheinbaren Faktizität des Phantastischen aufgezeigt.“"
                            },
                            {
                                "example_id": "10dcd762-d47f-4389-af46-5d8c488303ed",
                                "sense_id": "63592d7b-ec1c-3f07-9434-285d9966f422",
                                "text": "„Die reine Faktizität ist nur ein Grenzwert, mit dem der Mensch nicht auf Dauer zu leben vermag.“"
                            },
                            {
                                "example_id": "bb762bdb-c7f3-4ba5-8890-b25aabe6a410",
                                "sense_id": "63592d7b-ec1c-3f07-9434-285d9966f422",
                                "text": "„Die Faktizität solcher Nachrichten lässt sich kaum überprüfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
