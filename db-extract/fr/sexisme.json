                "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                "word": "sexisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1591a21-f1a7-4df1-ba6b-6d7c9c42fbe9",
                        "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                        "tags": [
                            "plural"
                        ],
                        "form": "sexismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                        "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                        "glosses": [
                            "Attitude, acte ou parole discriminatoire, fondé sur des stéréotypes ou des préjugés liés au sexe ou au genre, visant à maintenir ou justifier une hiérarchie entre les individus."
                        ],
                        "tags": [
                            "Psychologie sociale",
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "066fca88-40f0-49c5-8c81-174d483241e1",
                                "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                                "text": "L’anecdote s’inscrit dans le contexte des nombreuses affaires de sexisme, de discrimination sexuelle et de harcèlement dans la Silicon Valley et le monde loin d’être rose des start-up et de la tech."
                            },
                            {
                                "example_id": "a93416f9-a741-456e-8869-9b5f1860aa8b",
                                "sense_id": "ba44fa06-0378-382d-b1f7-47b3a66c5c9d",
                                "text": "Les filles n’étaient pas, contrairement au lieu commun actuel, surveillées par sexisme, mais pour leur propre protection, parce que devenir, comme on disait, « fille mère » était la voie royale vers une existence difficile."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                        "entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                        "glosses": [
                            "Système idéologique et social reposant sur des croyances et des stéréotypes relatifs au sexe ou au genre, et produisant des rapports de pouvoir inégalitaires, des discriminations et des inégalités institutionnelles, économiques et culturelles."
                        ],
                        "tags": [
                            "Science politique",
                            "Études de genre",
                            "Études féministes",
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "68f1030b-f769-4f3f-8978-0683fb05cb87",
                                "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                                "text": "Nous ne pouvons tolérer ni le sexisme ni le racisme dans notre communauté."
                            },
                            {
                                "example_id": "d4051feb-e045-4a28-93f1-5ba59edd7f57",
                                "sense_id": "ea4cee27-4add-3bcf-beee-0e1302978755",
                                "text": "Le « sexisme » est tout un système dont le moteur est la discrimination des individus en fonction de leur sexe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55ff0cc7-539d-4a3a-b6cc-b38f2247bb22",
                        "source_entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                        "target_lang_word": "Sexismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sexismus",
