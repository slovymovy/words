                        "cross_references": [
                            {
                                "target_word": "высококачественный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc391697-4cb8-317d-bce9-44488bbf24b4",
                                        "entry_id": "bf9b7726-a4f6-3d65-b636-dfebc7299315",
                                        "glosses": [
                                            "имеющий высокое качество, сделанный с высоким качеством"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2c7e78-0767-4e9b-9ed0-279c8ac74ac2",
                                                "sense_id": "dc391697-4cb8-317d-bce9-44488bbf24b4",
                                                "text": "Поэтому понадобилось ещё почти два десятилетия напряжённой работы в различных областях науки и техники для того, чтобы найти, наконец, высококачественный способ записи и воспроизведения звука в кинематографе."
                                            },
                                            {
                                                "example_id": "02010b2f-f5c9-455b-a702-e83de452346b",
                                                "sense_id": "dc391697-4cb8-317d-bce9-44488bbf24b4",
                                                "text": "Чтобы получить высококачественный лук-порей с нежными отбе́ленными стеблями, каждое растение окучивают ― оно должно прорастать через холмик рыхлой почвы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
