                "senses": [
                    {
                        "sense_id": "c405020c-0b13-3bc7-b1ce-1abb55137f50",
                        "entry_id": "27236d41-d674-3b07-b030-8cc8c403a3eb",
                        "glosses": [
                            "Gesetz zur Regelung aller Abläufe innerhalb einer politischen Partei (insbesondere auch für die Parteienfinanzierung)"
                        ],
                        "tags": [
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "474ccfea-41c8-4f84-9421-38428b4fd7bb",
                                "sense_id": "c405020c-0b13-3bc7-b1ce-1abb55137f50",
                                "text": "„Die SPD-Fraktion zeigte sich bereit, die angesprochenen Regelungen im Parteiengesetz in den Blick zu nehmen.“"
                            },
                            {
                                "example_id": "681b1b9b-2d12-47de-b329-1e13d89ca194",
                                "sense_id": "c405020c-0b13-3bc7-b1ce-1abb55137f50",
                                "text": "„Eines der wesentlichen Probleme war jedoch, dass Zaher Schah das Parteiengesetz, das in der Verfassung enthalten war, nicht ratifizierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
