                    }
                ],
                "translations": [
                    {
                        "translation_id": "73052abd-0f87-4672-b5fb-b7225d2b46fe",
                        "source_entry_id": "575e3fb3-8189-344d-a8a4-993d242eadd9",
                        "target_lang_word": "catamaran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catamaran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac571ac9-4829-3d73-a119-06d6bcd2271d",
                                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                                        "glosses": [
                                            "A twin-hulled ship or boat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c27973-5edc-4af0-ac21-3a72911110f3",
                                                "sense_id": "ac571ac9-4829-3d73-a119-06d6bcd2271d",
                                                "text": "Swift over the seas the vessel drives; Madras appears in sight. The first object catching the eye, upon the anchor being cast, was an Indian upon his catamaran, who, making a sudden motion, sprung to the side of the ship, grappled there for a moment, and the next was on the deck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfdeaf7-b71d-3822-a574-36ac5f145145",
                                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                                        "glosses": [
                                            "A quarrelsome woman; a scold."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d129fbd7-c19d-434c-ab80-ca14b5b34471",
                                                "sense_id": "3cfdeaf7-b71d-3822-a574-36ac5f145145",
                                                "text": "She meddles with my prescriptions for your wife; she doctors the infant in private: you'll never have a quiet house or a quiet wife as long as that old Catamaran is here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "767bef62-9391-3895-aacf-ce0261b4508d",
                                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                                        "glosses": [
                                            "A raft of three pieces of wood lashed together, the middle piece being longer than the others, and serving as a keel on which the rower squats while paddling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20531f0-9f31-4c7a-8856-2e575bf8ed4d",
                                                "sense_id": "767bef62-9391-3895-aacf-ce0261b4508d",
                                                "text": "Three or four strange-looking things now came close to our boat, which I understood were called ‘catamarans’, consisting of nothing more than two or three large trees, the trunk part only strongly lashed together, upon which sat two men nearly in a state of nature […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741f271c-5be5-39a8-b039-f184356f2094",
                                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                                        "glosses": [
                                            "An old kind of fireship."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
