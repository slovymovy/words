                                                "sense_id": "ea5b0953-0200-31e5-bb15-721c711da81c",
                                                "text": "I blew out a tire on some hard cornering."
                                            },
                                            {
                                                "example_id": "03f55f98-b134-482e-b0ed-10e7d9af1004",
                                                "sense_id": "ea5b0953-0200-31e5-bb15-721c711da81c",
                                                "text": "I blew out an LED when I cranked up the power."
