                "word": "trebuchet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0c8de8a5-77b0-4b31-aff0-0da6f6ab0e99",
                        "entry_id": "8a912ec9-371d-3152-a965-c0b4196bdfc2",
                        "tags": [
                            "plural"
                        ],
