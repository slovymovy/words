{
    "word_family": [
        "theatrical",
        "theatricality"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8e85125-8f9d-3d2c-b7fe-2863b840b042",
                    "sense_definition": "A building or place with a stage and seats where plays, shows, and other performances are presented to an audience.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought tickets to see a famous play at the local <w>theater</w>.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты на известную пьесу в местный <w>театр</w>.",
                                "zh": "我们买了票去当地的<w>剧院</w>看一场著名的戏。"
                            }
                        },
                        {
                            "text": "The actors arrived at the <w>theater</w> early to prepare for the evening performance.",
                            "target_lang_translations": {
                                "ru": "Актёры прибыли в <w>театр</w> пораньше, чтобы подготовиться к вечернему спектаклю.",
                                "zh": "演员们早早来到<w>剧院</w>，为晚上的演出做准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "playhouse"
                    ],
                    "common_phrases": [
                        "go to the theater",
                        "local theater",
                        "open-air theater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или место со сценой и зрительным залом, где проходят пьесы, шоу и другие представления.",
                        "zh": "设有舞台和座位的建筑物或场所，用于向观众呈现戏剧、表演或其他演出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "театр",
                                "target_lang_sense_clarification": "здание или учреждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剧院",
                                "target_lang_sense_clarification": "用于表演戏剧的建筑物"
                            },
                            {
                                "target_lang_word": "戏院",
                                "target_lang_sense_clarification": "用于表演戏剧的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e5291eb-5e9d-38a4-9d08-3c2055726935",
                    "sense_definition": "A building where movies are shown to an audience.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the back row of the <w>theater</w> and ate popcorn while watching the film.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в заднем ряду <w>кинотеатра</w> и ели попкорн во время просмотра фильма.",
                                "zh": "我们坐在<w>电影院</w>的后排，边吃爆米花边看电影。"
                            }
                        },
                        {
                            "text": "The movie <w>theater</w> was packed on opening night.",
                            "target_lang_translations": {
                                "ru": "В день премьеры <w>кинотеатр</w> был переполнен.",
                                "zh": "首映当晚，<w>电影院</w>里挤满了人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "movie theater",
                        "at the theater"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, в котором показывают кинофильмы для зрителей.",
                        "zh": "放映电影供观众观看的建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинотеатр",
                                "target_lang_sense_clarification": "место для показа фильмов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电影院",
                                "target_lang_sense_clarification": "放映电影的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "414f3a49-108d-3e8e-a2e5-dfa5fe582e35",
                    "sense_definition": "The art, profession, or activity of writing, producing, and acting in plays.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has worked in <w>theater</w> for over twenty years as a director.",
                            "target_lang_translations": {
                                "ru": "Она проработала в <w>театре</w> более двадцати лет в качестве режиссёра.",
                                "zh": "她从事<w>戏剧</w>工作已经二十多年了，担任导演。"
                            }
                        },
                        {
                            "text": "He decided to study <w>theater</w> at college because he loved acting.",
                            "target_lang_translations": {
                                "ru": "Он решил изучать <w>театральное искусство</w> в колледже, потому что любил играть на сцене.",
                                "zh": "他决定在大学学习<w>戏剧</w>，因为他热爱表演。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "work in theater",
                        "theater arts",
                        "musical theater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство, профессия или деятельность по написанию, постановке и исполнению пьес.",
                        "zh": "编写、制作和表演戏剧的艺术、职业或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "театр",
                                "target_lang_sense_clarification": "вид искусства"
                            },
                            {
                                "target_lang_word": "театральное искусство",
                                "target_lang_sense_clarification": "сфера деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏剧",
                                "target_lang_sense_clarification": "作为艺术形式的戏剧"
                            },
                            {
                                "target_lang_word": "戏剧艺术",
                                "target_lang_sense_clarification": "戏剧相关的专业领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b39128e-0597-3c4b-b364-d50d4b576299",
                    "sense_definition": "A large room with rows of rising seats used for lectures, especially in a university.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor stood at the front of the lecture <w>theater</w> to address the students.",
                            "target_lang_translations": {
                                "ru": "Профессор стоял перед лекционной <w>аудиторией</w>, обращаясь к студентам.",
                                "zh": "教授站在<w>阶梯教室</w>的前方对学生们讲话。"
                            }
                        },
                        {
                            "text": "Our final exam will be held in the main science <w>theater</w>.",
                            "target_lang_translations": {
                                "ru": "Наш выпускной экзамен пройдет в главной научной <w>аудитории</w>.",
                                "zh": "我们的期末考试将在主科学<w>阶梯教室</w>举行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lecture theater"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая комната с рядами возвышающихся сидений, используемая для лекций, особенно в университете.",
                        "zh": "一种带有阶梯式座位的大房间，主要用于大学等机构的讲座。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аудитория",
                                "target_lang_sense_clarification": "учебное помещение"
                            },
                            {
                                "target_lang_word": "лекционный зал",
                                "target_lang_sense_clarification": "помещение для лекций"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阶梯教室",
                                "target_lang_sense_clarification": "大学里的讲座室"
                            },
                            {
                                "target_lang_word": "讲堂",
                                "target_lang_sense_clarification": "用于演讲或授课的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f485215b-0964-3fbb-9c41-9c7e2a706d73",
                    "sense_definition": "A specific area or region where important military operations or wars take place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His grandfather served in the Pacific <w>theater</w> during the Second World War.",
                            "target_lang_translations": {
                                "ru": "Его дед служил на Тихоокеанском <w>театре военных действий</w> во время Второй мировой войны.",
                                "zh": "他的祖父在第二次世界大战期间曾在太平洋<w>战区</w>服役。"
                            }
                        },
                        {
                            "text": "Troops were deployed to a new <w>theater</w> of operations to support the allies.",
                            "target_lang_translations": {
                                "ru": "Войска были переброшены на новый <w>театр</w> военных действий для поддержки союзников.",
                                "zh": "部队被部署到一个新的<w>战区</w>以支援盟军。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "theater of war",
                        "Pacific theater",
                        "European theater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная область или регион, где проходят важные военные операции или войны.",
                        "zh": "进行重要军事行动或战争的特定区域或地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "театр военных действий",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战区",
                                "target_lang_sense_clarification": "军事行动区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "761452da-e084-339b-a864-3ca58dace7e9",
                    "sense_definition": "A special room in a hospital where surgical operations are performed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "venue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was prepared and wheeled into the <w>theater</w> for surgery.",
                            "target_lang_translations": {
                                "ru": "Пациента подготовили и вкатили в <w>операционную</w> для операции.",
                                "zh": "病人准备好后被推进了<w>手术室</w>进行手术。"
                            }
                        },
                        {
                            "text": "Surgeons and nurses must scrub their hands thoroughly before entering the operating <w>theater</w>.",
                            "target_lang_translations": {
                                "ru": "Хирурги и медсестры должны тщательно мыть руки перед входом в <w>операционную</w>.",
                                "zh": "外科医生和护士在进入<w>手术室</w>前必须彻底洗手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "operating theater",
                        "in theater"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальное помещение в больнице, где проводятся хирургические операции.",
                        "zh": "医院内进行外科手术的专用房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "операционная",
                                "target_lang_sense_clarification": "медицинское помещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手术室",
                                "target_lang_sense_clarification": "医院的手术场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03fef510-55be-3074-ad61-437e79d492a0",
                    "sense_definition": "Actions that are done to impress people or appear important, but which have no real effect or value.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political debate was just <w>theater</w>, with no real solutions offered.",
                            "target_lang_translations": {
                                "ru": "Политические дебаты были просто <w>спектаклем</w>, без предложения реальных решений.",
                                "zh": "那场政治辩论不过是一场<w>作秀</w>，并没有提出任何真正的解决方案。"
                            }
                        },
                        {
                            "text": "Critics described the new safety checks as security <w>theater</w> rather than effective protection.",
                            "target_lang_translations": {
                                "ru": "Критики назвали новые проверки безопасности <w>театром</w> безопасности, а не эффективной защитой.",
                                "zh": "评论家们称新的安全检查只是安全<w>作秀</w>，而非有效的保护措施。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "political theater",
                        "security theater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действия, совершаемые с целью произвести впечатление или казаться важными, но не имеющие реального эффекта.",
                        "zh": "为了给人留下深刻印象或显得重要而采取的行动，但实际上并无实质效果或价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спектакль",
                                "target_lang_sense_clarification": "притворство, игра на публику"
                            },
                            {
                                "target_lang_word": "театр",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作秀",
                                "target_lang_sense_clarification": "为了博取关注的表演"
                            },
                            {
                                "target_lang_word": "演戏",
                                "target_lang_sense_clarification": "虚伪的表演"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}