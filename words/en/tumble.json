                    "sense_definition": "A village in Llannon community, Carmarthenshire, Wales.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Tumble</w> while traveling through Wales.",
                            "target_lang_translations": {
                                "zh": "他们在威尔士旅行时，造访了小村庄<w>坦布尔</w>。"
                            }
                        },
                        {
                            "text": "The road to <w>Tumble</w> is narrow and winds through the beautiful countryside.",
                            "target_lang_translations": {
                                "zh": "通往<w>坦布尔</w>的路很窄，蜿蜒穿过美丽的乡间。"
                            }
                        }
                    ],
                    "traits": [
