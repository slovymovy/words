                        "glosses": [
                            "Performance nettement moins bonne que ses performances habituelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423fc077-4417-47e3-aeb7-d2811645aa6d",
                                "sense_id": "bcb9db89-839e-3384-a4cf-ad1674c2c231",
                                "text": "Ce fut une contreperformance pour la jeune patineuse qui avait obtenu une note de 108,91 lors des championnats de la section Québec."
                            },
                            {
                                "example_id": "ef80871f-4ae5-40af-9208-e7d94334bae6",
                                "sense_id": "bcb9db89-839e-3384-a4cf-ad1674c2c231",
                                "text": "À côté de la contreperformance de la Bici Ci qui baisse de 14,29 %, c’est la chute des principales valeurs agricoles (Palm Ci −29,14 % et Saph Ci −11,12 %) qui explique les résultats négatifs de la Brvm en novembre dernier."
                            },
                            {
                                "example_id": "e9afbad5-416b-4b5e-ab56-658ef3ef83a7",
                                "sense_id": "bcb9db89-839e-3384-a4cf-ad1674c2c231",
                                "text": "« Laissez donc retomber la poussière », a ordonné sa [à Jean-Marie Le Pen] fille, après la contreperformance de son parti au second tour des élections législatives, le 7 juillet."
                            }
                        ]
                    }
