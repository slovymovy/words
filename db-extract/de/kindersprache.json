                    {
                        "form_id": "9c73194f-3b07-4ee6-ab34-2e527c0fcfc4",
                        "entry_id": "ea1f5428-8c9d-3f50-98cd-b51f9750d1f2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kindersprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c0f9291-bbc1-36b5-af95-85e50cb86b8d",
                        "entry_id": "ea1f5428-8c9d-3f50-98cd-b51f9750d1f2",
                        "glosses": [
                            "Sammelbegriff für die Sprachformen, die Kinder beim Erwerb ihrer Muttersprache nach und nach entwickeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddacba0d-f6e6-4b83-89fb-54e47e607241",
                                "sense_id": "7c0f9291-bbc1-36b5-af95-85e50cb86b8d",
                                "text": "„Die Kindersprache enthält usualisierte Wortschöpfungen: »Tick-Tack« (‚Uhr‘), »Puff-puff« (‚Eisenbahn‘).“"
                            },
                            {
                                "example_id": "c96e7ba6-ce31-4ae6-98d1-f17eb3003afd",
                                "sense_id": "7c0f9291-bbc1-36b5-af95-85e50cb86b8d",
                                "text": "„Als die erste ausführlichere Untersuchung der Kindersprache von einem Linguisten wird die Arbeit des Belgiers Grégoire (1937) …eingestuft.“"
                            },
                            {
                                "example_id": "90c2f493-104b-4958-8328-b5bf500d39d6",
                                "sense_id": "7c0f9291-bbc1-36b5-af95-85e50cb86b8d",
                                "text": "„Die Wörter haben hier, wie in den Anfängen begrifflicher Kindersprache, stellvertretende Funktion…“"
                            },
                            {
                                "example_id": "be4b3197-6771-4c03-a96e-fa3bbd00c705",
                                "sense_id": "7c0f9291-bbc1-36b5-af95-85e50cb86b8d",
                                "text": "„Da die Erkenntnisse von JAKOBSON über die lautliche Entwicklung der Kindersprache für unsere eigene Arbeit von wesentlicher Bedeutung sind, wollen wir sie nachfolgend kurz zusammenfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da553c06-763f-315b-8d0f-c5b5c8b77cb8",
                        "entry_id": "ea1f5428-8c9d-3f50-98cd-b51f9750d1f2",
                        "glosses": [
                            "eine der verschiedenen Sprachen von Kindern in einer Gruppe, zum Beispiel in einer Schulklasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad5192e-45e9-4b44-accd-ad1d50c8da8f",
                                "sense_id": "da553c06-763f-315b-8d0f-c5b5c8b77cb8",
                                "text": "„Mutter-, Eltern-, Kindersprachen. Die Rahmenbedingungen. Ich arbeite an einer Schule mit einem sehr hohen Anteil von Kindern, deren Muttersprache nicht Luxemburgisch ist. Die verschiedenen Muttersprachen der Kinder in meiner Klasse sind Portugiesisch (12), Luxemburgisch (3), Bosnisch (1), Französisch (1) und Italienisch (1). “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
