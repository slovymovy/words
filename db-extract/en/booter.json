                        "entry_id": "f01007b6-c271-39e0-a9ca-7ae98f8c2f52",
                        "glosses": [
                            "The experience of stepping in a deep puddle and having one's foot become completely engulfed in water."
                        ],
                        "tags": [
                            "Canada",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b6699cf0-85c4-44dc-b420-32ce85481367",
                                "sense_id": "bb0dec2b-8563-3629-a06f-f38f041c944b",
                                "text": "“Argghh, a booter,” Sally groaned when she sloshed across a puddle too wide to jump."
                            }
                        ]
