                    {
                        "translation_id": "330122a5-08a6-4145-a471-2be950ef3834",
                        "source_entry_id": "33ed3ff8-4016-30ce-af1e-e780ba22324d",
                        "source_sense_id": "e2c83031-a3f1-33cb-b58c-a72660fd40e4",
