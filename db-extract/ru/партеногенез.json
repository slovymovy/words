                                        "examples": [
                                            {
                                                "example_id": "7e5a3b09-68d0-49e4-9d4b-10af08af5af6",
                                                "sense_id": "400e2e35-4016-3a48-a994-0c480a9cf82e",
                                                "text": "Der Gott Hephaistos soll von seiner Mutter Hera in Parthenogenese gezeugt worden sein."
                                            }
