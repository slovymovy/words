                                        "entry_id": "1148edf2-732b-3962-84dc-5396e6ecdaa4",
                                        "glosses": [
                                            "Wrongly; erroneously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "525f9b6a-472d-47bc-8b4a-d15e31e2900d",
                                                "sense_id": "b8a43835-4cd7-3791-87c6-5e04fe6ca9a8",
                                                "text": "I mistakenly assumed that the shop was still there."
                                            },
                                            {
                                                "example_id": "0a6f9f30-e876-437c-b78d-456980e7083e",
                                                "sense_id": "b8a43835-4cd7-3791-87c6-5e04fe6ca9a8",
                                                "text": "Most Americans mistakenly believe that they must see specialists for almost every medical problem."
                                            },
                                            {
                                                "example_id": "90543325-104c-47ca-ab4f-2bd47970d1f7",
                                                "sense_id": "b8a43835-4cd7-3791-87c6-5e04fe6ca9a8",
                                                "text": "The Supreme Court on Monday temporarily paused a lower court-ordered deadline to return to the US a Maryland man mistakenly deported to El Salvador, granting the Trump administration additional time to review the case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e848a2b-11a8-3b98-a529-f3efb64c6b32",
                                        "entry_id": "1148edf2-732b-3962-84dc-5396e6ecdaa4",
                                        "glosses": [
                                            "By accident; by mistake; in error (without intention to do so)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9713a4d2-b283-4cde-bc1e-72ce8675e65b",
                                                "sense_id": "8e848a2b-11a8-3b98-a529-f3efb64c6b32",
                                                "text": "Today I mistakenly took your packed lunch to work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db274822-342f-4b3f-9866-a98b96ae600f",
