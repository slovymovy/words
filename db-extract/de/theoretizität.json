                ],
                "senses": [
                    {
                        "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                        "entry_id": "0f6acdff-1e03-3c07-86fa-3ce4dcea3f80",
                        "glosses": [
                            "Eigenschaft, die beschreibt, in welchem Maße Theorie (statt Praxis, Empirie) zum Tragen kommt, inwieweit man eine wissenschaftlich fundierte Theorie aufstellen kann, die Umstände erklärt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec43ffd-4cee-4d07-9497-2e24f5cc62af",
                                "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                                "text": "„Dabei sind die drei metatheoretischen Grundsätze „Empirizität, Theoretizität und Relevanz“ bestimmend, die empirisches Vorgehen, eine explizite Theorie und die Anwendbarkeit für literarische Werke fordern.“"
                            },
                            {
                                "example_id": "b2eef4e1-16c7-4726-a26a-328d780aaee2",
                                "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                                "text": "„Die methodologischen Besonderheiten, die die erklärenden Begriffe im Unterschied zu reinen Dispositionsbegriffen in der Psychologie aufweisen, bestehen im wesentlichen darin, daß sie eine bestimmte Theoretizität aufweisen.“"
                            },
                            {
                                "example_id": "ca3c0fdb-15b3-4b3b-b606-8b51bbc30ec4",
                                "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                                "text": "„Empirizität ist die Grundlage jeder Wissenschaft. Distinktionsfähigkeit ihre Zier. Theoretizität aber ihre Legitimität. Wenn nicht klar wird, was eine Wissenschaft überhaupt erklären soll und kann, dann wird diese Wissenschaft im Konzert konkurrierender Disziplinen langfristig marginalisiert oder untergehen.“"
                            },
                            {
                                "example_id": "6ebe5cce-5c64-4abf-ad6d-3446a875789a",
                                "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                                "text": "„Eines ist offenkundig: eine empirische Kulturtheorie ist eine Theorie, die die metatheoretischen Werte der Empirizität und Theoretizität besitzt.“"
                            },
                            {
                                "example_id": "fcc11a41-6512-45b3-8311-c968da721162",
                                "sense_id": "16dfdc49-c1be-3bff-a0df-bd27d1e8650f",
                                "text": "„In den beiden vorhergehenden Abschnitten dieses Kapitels wurde die Dimension der Theoretizität einer ersten allgemeinen Klärung zugeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
