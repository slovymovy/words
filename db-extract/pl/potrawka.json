                        ],
                        "examples": [
                            {
                                "example_id": "adbb484c-7e50-4f39-9ba4-ed7c9930bd20",
                                "sense_id": "8ee41386-0de2-3c65-9a31-9b99087b6d08",
                                "text": "Może weźmiemy tę potrawkę z kurczaka z surówkami?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e9a64d9f-44f5-37fe-93ae-a06ed82d93d0",
                        "entry_id": "ce56a615-2b8c-3f00-a8b5-c2fd608b6fb2",
                        "glosses": [
                            "pokrojone i ugotowane w sosie mięso"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95a0004e-87d4-48cc-bd7c-703d99d4ca0f",
                        "source_entry_id": "ce56a615-2b8c-3f00-a8b5-c2fd608b6fb2",
                        "source_sense_id": "e9a64d9f-44f5-37fe-93ae-a06ed82d93d0",
                        "target_lang_word": "fricassee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fricassee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43054732-bff6-3fdb-8f58-b9c2b34120a9",
                                        "entry_id": "15363a7d-900a-3279-8c21-7153d28eb5c3",
                                        "glosses": [
                                            "Meat or poultry cut into small pieces, stewed or fried and served in its own gravy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7683fc91-a012-4c99-a258-348f6b6384b4",
                                                "sense_id": "43054732-bff6-3fdb-8f58-b9c2b34120a9",
                                                "text": "I have been assured by a very knowing American of my acquaintance in London, that a young healthy child well nursed, is, at a year old, a most delicious nourishing and wholesome food, whether stewed, roasted, baked, or boiled; and I make no doubt that it will equally serve in a fricasee, or a ragoust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fricassee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9616794a-cd0b-3106-b152-210c0c5091f8",
                                        "entry_id": "a18c2ba9-6d8f-34ee-81e0-962be6688a7a",
                                        "glosses": [
                                            "To cook meat or poultry in this manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e5aac6-fcf8-498d-9065-c3969f5a46b5",
                                                "sense_id": "9616794a-cd0b-3106-b152-210c0c5091f8",
                                                "text": "Just now I'm waiting for Tony Goodwin [the publisher] to arrive, casseroling a rabbit, fricasseeing it actually, listening to Revolver on the record player and the gale stripping the olive trees outside, and answering my correspondence, when […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e71ad53e-74dd-474d-a494-f8a796db1dcc",
                        "source_entry_id": "ce56a615-2b8c-3f00-a8b5-c2fd608b6fb2",
                        "source_sense_id": "e9a64d9f-44f5-37fe-93ae-a06ed82d93d0",
                        "target_lang_word": "fricassée",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fricassée",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20c698ff-4509-3393-807f-73f770207d97",
                                        "entry_id": "1925dc2b-f298-3e9e-8ada-bf3564a220d9",
                                        "glosses": [
                                            "Alternative spelling of fricassee."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a807d1-391a-4d3c-92f3-2c264cfab485",
                                                "sense_id": "20c698ff-4509-3393-807f-73f770207d97",
                                                "text": "“We have nothing but some Barbacue soused in wine in the Spanish fashion, and a few fricassées, or so.”"
                                            },
                                            {
                                                "example_id": "86983035-5878-4220-a8d8-5652650db503",
                                                "sense_id": "20c698ff-4509-3393-807f-73f770207d97",
                                                "text": "With a quick sweep of my eye, I see fricassées, steamed bass and poached salmon, roast snipe, peacock, teal, mallard and quail, game pies and carbonados, tarts of marrowbone, neats' tongues, venison pasties, baked guinea fowl, compound salads, dishes of cream, quinces, comfits and marzipans, preserves, cheeses and fruits."
                                            },
                                            {
                                                "example_id": "32aeec21-a19a-4488-8879-87b662060b86",
                                                "sense_id": "20c698ff-4509-3393-807f-73f770207d97",
                                                "text": "He went to the royal quarters and found the King sitting on the floor with a dish of fricassées from which he was feeding his dogs, making them take their turns checked by a small stick he was holding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fricassée",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                        "entry_id": "23021726-11bb-39e5-a6ba-949b5137c513",
                                        "glosses": [
                                            "Alternative spelling of fricassee."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc709b6-b67d-4a75-be09-e8e04f2ef31a",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "The hind quarters may be fricaséed, ragoûted, or done in a timbale or casserole, with any of the fine herb seasoning, and served as a first-course dish; […]"
                                            },
                                            {
                                                "example_id": "5965a23c-256b-4b97-8e28-8b1da77c1b98",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "To Fricassée Cold Beef."
                                            },
                                            {
                                                "example_id": "345c79a3-3aae-4dc5-b9d2-dbf0e5258b2e",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "“Frogs were killed and as conscientiously fricasséed à la mode de Paris when we had learnt all other lessons from them.”"
                                            },
                                            {
                                                "example_id": "2724f85d-5b1c-4d70-a335-15cf22070ceb",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "That got me a wordless glare that would’ve fricasséed a squid."
                                            },
                                            {
                                                "example_id": "f43cadfe-f8f2-44e2-b676-37f7ea07a390",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "Then, against the wall, there were gridirons big enough for burning martyrs, saucepans in which a whole sheep could be fricasséed, a monumental plate-warmer, a marble basin filled with a continual trickle of water."
                                            },
                                            {
                                                "example_id": "c3ec2b4c-b823-4a94-ba40-ccc25ebf7aec",
                                                "sense_id": "83a82560-3e0f-3011-944a-82834a2f0e93",
                                                "text": "I didn’t know it at the time, but I was fricasséeing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "507baf33-3af8-499e-a32d-18f47efbb7fc",
                        "source_entry_id": "ce56a615-2b8c-3f00-a8b5-c2fd608b6fb2",
                        "source_sense_id": "e9a64d9f-44f5-37fe-93ae-a06ed82d93d0",
                        "target_lang_word": "fricassée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fricassée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d85d7319-ec7a-3bbd-a301-8ac1dc9beb93",
                                        "entry_id": "e9af7608-03c2-32ed-a239-3ef9b41a838b",
                                        "glosses": [
                                            "Viande fricassée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d32bbcbe-7981-491a-ba45-97132a522520",
                                                "sense_id": "d85d7319-ec7a-3bbd-a301-8ac1dc9beb93",
                                                "text": "Gouttez-moi ce carré de mouton au sarrasin, […]. C'est autre chose que les fricassées qu'on accommode chez vos grands seigneurs avec les laissés pour compte du marché."
                                            },
                                            {
                                                "example_id": "580e5c6d-89e0-447b-a9ff-41cd901139af",
                                                "sense_id": "d85d7319-ec7a-3bbd-a301-8ac1dc9beb93",
                                                "text": "– C’est pourtant vrai, répondait Honoré. Il faudra que je demande à Clotilde ce qu’elle pense du général Boulanger. Reprends donc de la fricassée... mais si ! deux cuillerées, avec un bon coup de vin pour la pousser dans le fin fond. Tripes sur tripes. Rien de pareil contre les aigreurs. »"
                                            },
                                            {
                                                "example_id": "f2216076-5a9c-4e86-b013-b8c2e87bd348",
                                                "sense_id": "d85d7319-ec7a-3bbd-a301-8ac1dc9beb93",
                                                "text": "La cacasse à cul nu, repas habituel était la fricassée du pauvre. On faisait brûler légèrement les pommes de terre au lard au fond d'une casserole en fonte pour donner à ce simple ragoût un petit goût de roussi agréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5639ba4-4d32-31e2-b680-378c57f49ad4",
                                        "entry_id": "e9af7608-03c2-32ed-a239-3ef9b41a838b",
                                        "glosses": [
                                            "Pot-pourri musical de pièces polyphoniques, aussi appelées quodlibet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fricassée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0feb821d-0e8d-3f92-9d01-0bd72b1c2651",
                                        "entry_id": "a155ee71-bc6b-3313-998f-a8f9345cb2bd",
                                        "glosses": [
                                            "Participe passé féminin singulier du verbe fricasser."
                                        ],
