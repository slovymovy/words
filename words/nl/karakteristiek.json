{
    "word_family": [
        "karakter",
        "karakteriseren",
        "karakterisering",
        "karakteristiek"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf36a532-b711-3c62-86e9-8a2b25cb46d1",
                    "sense_definition": "iets wat kenmerkend of typerend is voor een bepaalde persoon, zaak of groep",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kenmerkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gebruik van felle kleuren is <w>karakteristiek</w> voor het werk van deze schilder.",
                            "target_lang_translations": {
                                "en": "The use of bright colors is <w>characteristic</w> of this painter's work."
                            }
                        },
                        {
                            "text": "Deze vogel heeft een <w>karakteristiek</w> geluid waaraan je hem direct herkent.",
                            "target_lang_translations": {
                                "en": "This bird has a <w>distinctive</w> sound by which you recognize it immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "kenmerkend",
                        "tekenend",
                        "typisch",
                        "typerend"
                    ],
                    "antonyms": [
                        "atypisch"
                    ],
                    "common_phrases": [
                        "karakteristiek geluid",
                        "karakteristiek beeld",
                        "karakteristiek voorbeeld"
                    ],
                    "target_lang_definitions": {
                        "en": "something that is distinctive or typical for a particular person, thing, or group"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "characteristic",
                                "target_lang_sense_clarification": "typical or distinctive"
                            },
                            {
                                "target_lang_word": "typical",
                                "target_lang_sense_clarification": "representative of a type"
                            },
                            {
                                "target_lang_word": "distinctive",
                                "target_lang_sense_clarification": "serving to distinguish"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29baf978-598f-3383-b122-6ce4f6bc28e8",
                    "sense_definition": "een typerende eigenschap of een kenmerk waarmee iets of iemand zich onderscheidt",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "kenmerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De technische <w>karakteristiek</w> van de motor bepaalt hoe snel de auto kan optrekken.",
                            "target_lang_translations": {
                                "en": "The technical <w>characteristic</w> of the engine determines how fast the car can accelerate."
                            }
                        },
                        {
                            "text": "In zijn beschrijving noemde hij elke belangrijke <w>karakteristiek</w> van het landschap.",
                            "target_lang_translations": {
                                "en": "In his description, he mentioned every important <w>feature</w> of the landscape."
                            }
                        }
                    ],
                    "common_phrases": [
                        "technische karakteristiek"
                    ],
                    "target_lang_definitions": {
                        "en": "a typical quality or feature by which something or someone is distinguished"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "characteristic",
                                "target_lang_sense_clarification": "a distinguishing feature"
                            },
                            {
                                "target_lang_word": "feature",
                                "target_lang_sense_clarification": "a prominent attribute"
                            },
                            {
                                "target_lang_word": "trait",
                                "target_lang_sense_clarification": "a distinguishing quality"
                            }
                        ]
                    }
                }
            ]
