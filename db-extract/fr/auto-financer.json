                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cc3c745-2ba1-3ec8-b22e-907ea0413be2",
                        "entry_id": "05014592-8c20-3022-a86b-46ba76faef38",
                        "glosses": [
                            "Financer sans recours à l’endettement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f2b692-1016-411c-bc26-8d98e9445176",
                                "sense_id": "1cc3c745-2ba1-3ec8-b22e-907ea0413be2",
                                "text": "Le protectorat ne devait-il pas permettre d’auto-financer \"l’occupation\" ?"
                            },
                            {
                                "example_id": "5893c15f-742b-42b5-99e0-e0152cb08bd8",
                                "sense_id": "1cc3c745-2ba1-3ec8-b22e-907ea0413be2",
                                "text": "Les autres sont rarement capables d’auto-financer ce type de cursus, à moins de se faufiler entre les mailles de la formation initiale ou de parfois bénéficier d’un Cif."
                            }
                        ]
                    },
                    {
                        "sense_id": "88ffc36d-0553-382e-83b5-2e9d1b29d0e4",
                        "entry_id": "05014592-8c20-3022-a86b-46ba76faef38",
                        "glosses": [
                            "Financer ses propres projets sans recours à l’endettement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f8a7465-3746-4aa7-ad2c-d31599bdb40f",
                                "sense_id": "88ffc36d-0553-382e-83b5-2e9d1b29d0e4",
                                "text": "Il existe des activités de dimension d’utilité sociale qui ne pourront jamais s’auto-financer et qui doivent rester dans la mixité de l’économique et du social."
                            },
                            {
                                "example_id": "c2ebf8e9-7098-4a51-9b20-c1d81ea6f1bd",
                                "sense_id": "88ffc36d-0553-382e-83b5-2e9d1b29d0e4",
                                "text": "Il sait donc que ces structures sont très peu soutenues par les autorités locales et qu’elles doivent largement s’auto-financer."
                            }
                        ]
                    }
                ],
