                                        "glosses": [
                                            "jsoucí na pomezí dvou nebo více oborů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cc38dd-3d3f-44b4-9a9c-713e898b1a8d",
                                                "sense_id": "6ece2c75-bca7-36cb-a3b9-310f84c98772",
                                                "text": "Proto je současná antropologie věda interdisciplinární a opírá se mimo klasické antropologické nástroje také o medicínu, sociologii, psychologii, archeologii a další disciplíny, které mají co říct o člověku jako takovém."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
