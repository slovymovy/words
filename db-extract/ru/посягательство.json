                        "cross_references": []
                    },
                    {
                        "translation_id": "505d67ee-48a7-42ca-91c4-b16fa4082a47",
                        "source_entry_id": "ca9c305c-9192-391f-809d-6a9127a747fe",
                        "source_sense_id": "6d69daa3-4645-392c-bf18-f6894b9338b5",
                        "target_lang_word": "attentat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attentat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "Entreprise criminelle contre les personnes ou les choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308e1ca2-2d11-4533-84c4-009489e44c93",
                                                "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                                "text": "Dorénavant, conclut Gilles Malandain, «écrasé par le poids de l’horreur terroriste, l’attentat, après avoir longtemps servi de terme générique, équivalent savant de crime, et susceptible de modulations très diverses, en est venu à désigner spécifiquement une forme de violence très répulsive et injustifiable»."
                                            },
                                            {
                                                "example_id": "b62c894d-4eaf-47b1-bfd6-8df286366049",
                                                "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                                "text": "Il en est de même des victimes des attentats et des exactions qui ont marqué la période qui a suivi les accords d’Évian le 18 mars jusqu’à la déclaration d’indépendance de l’Algérie le 5 juillet, et parfois au-delà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cb8389-a2be-383f-9089-12ae45589210",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "Acte qui s’oppose à des droits inscrits dans la loi ou à des principes généralement admis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b10de68-9d06-4221-a46d-597a8b30371d",
                                                "sense_id": "43cb8389-a2be-383f-9089-12ae45589210",
                                                "text": "C’est un attentat contre nos droits, contre nos privilèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64360d91-7eba-3f61-995a-dafdb1e22edb",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "(Par analogie) Acte qui heurte les conventions artistiques, morales, le bon sens, les traditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433bd6c2-a9c4-41fe-9953-78ed01ba1fa9",
                                                "sense_id": "64360d91-7eba-3f61-995a-dafdb1e22edb",
                                                "text": "C’est un attentat contre le bon goût."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37757598-3a87-4335-8066-d3c9c83f7445",
                        "source_entry_id": "ca9c305c-9192-391f-809d-6a9127a747fe",
                        "source_sense_id": "6d69daa3-4645-392c-bf18-f6894b9338b5",
                        "target_lang_word": "atteinte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atteinte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                        "entry_id": "b0c14116-c9a3-3bf6-8a12-1a2fae95827c",
                                        "glosses": [
                                            "Action d’atteindre ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1ab17e-b644-4dfd-bd87-436a0b2a4dea",
                                                "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                                "text": "Ces objectifs sont déterminés par un plan à long terme, pour l’atteinte duquel on ménagera au maximum ses forces tout en cherchant les prises les plus variées qu'offre la situation du moment."
                                            },
                                            {
                                                "example_id": "84fa0016-1dd4-401b-be81-cedae63aabda",
                                                "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                                "text": "L’atteinte d’une maladie."
                                            },
                                            {
                                                "example_id": "920b276f-2f3d-4a18-b60b-e09cde4da1f7",
                                                "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                                "text": "L’aînée, Félicité, boite depuis qu’elle a eu une atteinte."
                                            },
                                            {
                                                "example_id": "ea25157c-1142-47fa-908c-33d83950adf9",
                                                "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                                "text": "Il s’alita aux premières atteintes du froid."
                                            },
                                            {
                                                "example_id": "c5e49e2b-e5f1-4eea-b7b3-00bb0ba8b0ce",
                                                "sense_id": "80786f34-d7c6-3b0b-a7e5-ea1545568154",
                                                "text": "Porter atteinte à l’autorité, à la réputation de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c024d310-363e-389e-849c-43564fc1c7de",
                                        "entry_id": "b0c14116-c9a3-3bf6-8a12-1a2fae95827c",
                                        "glosses": [
                                            "Frappe de son chalengeur dans un tournoi."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "411c3e42-c5eb-4c0f-8fe7-773278d0e9d9",
                                                "sense_id": "c024d310-363e-389e-849c-43564fc1c7de",
                                                "text": "…les tenants restaient toujours victorieux ; un de leurs adversaires fut renversé, et les deux autres manquèrent l’atteinte, c’est-à-dire de frapper leur antagoniste au casque ou au bouclier d’une main ferme et forte, avec la lance en arrêt, de manière que la lance se brisât ou que l’adversaire fût renversé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de8ba63-263f-3d5b-a1db-d59e0dbb0096",
                                        "entry_id": "b0c14116-c9a3-3bf6-8a12-1a2fae95827c",
                                        "glosses": [
                                            "Effet de ce qui cause un mal, un dommage, de ce qui porte quelque préjudice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "563c0067-3828-482b-b042-793312f42e78",
                                                "sense_id": "6de8ba63-263f-3d5b-a1db-d59e0dbb0096",
                                                "text": "Et, en effet, bien que cet adorable visage eût subi les atteintes du temps, bien que la splendide chevelure éparse sur ses épaules fût sur cette tête exquise une auréole d'argent, il semblait impossible d'appliquer une autre expression à cette merveilleuse créature."
                                            },
                                            {
                                                "example_id": "9b135046-7f41-41ff-a559-5e4dce97ecca",
                                                "sense_id": "6de8ba63-263f-3d5b-a1db-d59e0dbb0096",
                                                "text": "Mais le populisme est un récit idéologique qui se met à l’abri des atteintes de la réalité, et se fonde sur la désignation d’un ennemi affublé de tous les vices, les élites du savoir et de la compétence."
                                            },
                                            {
                                                "example_id": "3d4b10a0-debe-4732-952f-b59717c79b00",
                                                "sense_id": "6de8ba63-263f-3d5b-a1db-d59e0dbb0096",
                                                "text": "Cela porte à son crédit une fâcheuse atteinte."
                                            },
                                            {
                                                "example_id": "b69e1a4c-da69-4251-8385-f398184557b0",
                                                "sense_id": "6de8ba63-263f-3d5b-a1db-d59e0dbb0096",
                                                "text": "Être à l’abri de toute atteinte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aaddca5-5d77-32e7-8acf-8f3552ee20c9",
                                        "entry_id": "b0c14116-c9a3-3bf6-8a12-1a2fae95827c",
                                        "glosses": [
                                            "Affection morbide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830913fb-d26a-4e82-b0ca-e874d237ea17",
                                                "sense_id": "9aaddca5-5d77-32e7-8acf-8f3552ee20c9",
                                                "text": "L’atteinte des glandes salivaires est plus rare et concerne principalement la parotide qui est dure, saillante et douloureuse à la pression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46927914-df27-3096-8e42-cceed80e4f7b",
                                        "entry_id": "b0c14116-c9a3-3bf6-8a12-1a2fae95827c",
                                        "glosses": [
                                            "Blessure d'un cheval provoquée par un choc durant une course."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "atteinte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33ef8859-742b-3a4f-9329-7f2e5ca17e3b",
                                        "entry_id": "1b330b6e-4392-3001-9f60-bbd887ce1405",
                                        "glosses": [
                                            "Féminin singulier de atteint."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "atteinte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bead59f-371e-3f13-b25b-367ea2b19ad1",
                                        "entry_id": "ff34b393-e93f-3bb4-8d86-921bec81c85c",
                                        "glosses": [
                                            "Participe passé féminin singulier de atteindre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4aecd7-c4ed-430b-8d5f-0f3efa5134ae",
                                                "sense_id": "4bead59f-371e-3f13-b25b-367ea2b19ad1",
                                                "text": "Si une partie vitale n’est pas atteinte, il ne reste qu’une solution pour se désenferrer : pousser l’arme et la sortir de l’autre côté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b349274e-b120-44a8-b9a3-48d440ee9c3c",
                        "source_entry_id": "ca9c305c-9192-391f-809d-6a9127a747fe",
                        "source_sense_id": "6d69daa3-4645-392c-bf18-f6894b9338b5",
                        "target_lang_word": "agression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "606088f4-9d1b-36dc-9677-8b099a650874",
                                        "entry_id": "62ec340a-d1a2-3527-b4e7-55001d0ba6b5",
                                        "glosses": [
                                            "Action de celui qui agresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fca694-770d-408a-b720-1ce81f373256",
                                                "sense_id": "606088f4-9d1b-36dc-9677-8b099a650874",
                                                "text": "Les habitants des villas et des pavillons environnants passèrent rapidement de la curiosité malveillante à l’agression."
                                            },
                                            {
                                                "example_id": "9b76ab12-42d2-4a34-958a-3e39e5b7e09d",
                                                "sense_id": "606088f4-9d1b-36dc-9677-8b099a650874",
                                                "text": "Des fois, ils vont à la dure… quoique ça soye pas les mêmes équipes. La dure, c'est l’agression, l’attaque nocturne à main armée.\n— Et alors ?…\n— Haut les pognes ! Et ils vous braquent."
                                            },
                                            {
                                                "example_id": "0a289d51-d71b-4f33-bd18-d9dde32389ef",
                                                "sense_id": "606088f4-9d1b-36dc-9677-8b099a650874",
                                                "text": "Il y a preuve d’agression de sa part."
                                            },
                                            {
                                                "example_id": "a1783e20-4cef-4f63-be77-b94651247185",
                                                "sense_id": "606088f4-9d1b-36dc-9677-8b099a650874",
                                                "text": "Il a fait, il s’est permis un acte d’agression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
