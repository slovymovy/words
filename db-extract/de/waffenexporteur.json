                        "examples": [
                            {
                                "example_id": "16554a65-2505-478d-bfaa-4e44fe6a96a7",
                                "sense_id": "f962ef61-8fdb-33b9-bd2c-c46bb516bac2",
                                "text": "„Deutschland ist im Vorjahr hinter den USA und Russland der drittgrößte Waffenexporteur gewesen und hat damit Frankreich und Großbritannien überholt.“"
                            },
                            {
                                "example_id": "d03c517b-7a44-4b1b-b6dd-c3c03342794e",
                                "sense_id": "f962ef61-8fdb-33b9-bd2c-c46bb516bac2",
                                "text": "„Weltgrösster Waffenexporteur bleiben die USA mit einem Marktanteil von 34 Prozent.“"
                            },
                            {
                                "example_id": "8a88ca75-bb63-4fe4-82f1-eb93ec17f0d4",
                                "sense_id": "f962ef61-8fdb-33b9-bd2c-c46bb516bac2",
                                "text": "„Rund drei Viertel der Exporte zwischen 2013 und 2017 gehen dem Sipri-Bericht zufolge auf das Konto der genannten fünf Haupt-Waffenexporteure.“"
                            }
