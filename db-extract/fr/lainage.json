                        "sense_id": "0dea2b4d-ec22-3a2b-a235-c468ea2ed833",
                        "entry_id": "872ae318-87fc-3f53-bb75-d17555bbde17",
                        "glosses": [
                            "Ensemble de tous les objets, vêtements, couvertures, etc., fabriqués avec de la laine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841cce27-2e0f-4690-b548-1fa688faeb9c",
                                "sense_id": "0dea2b4d-ec22-3a2b-a235-c468ea2ed833",
                                "text": "[…] elle touchait les lainages, les flanelles, les cotonnades, pour s’assurer du grain et de la souplesse de l’étoffe."
                            },
                            {
                                "example_id": "ab5df5e0-ae2a-4b78-88e7-11ad37dabb5c",
                                "sense_id": "0dea2b4d-ec22-3a2b-a235-c468ea2ed833",
                                "text": "Les produits viennent surtout naturellement des grandes régions de l’industrie textile : Mulhouse pour les tissus de coton et la mercerie, le Nord pour les lainages, Troyes pour la bonneterie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f06e7fcd-0502-3fad-a6a4-f344640b1925",
                        "entry_id": "872ae318-87fc-3f53-bb75-d17555bbde17",
                        "glosses": [
                            "Toison des moutons."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "note": "Dans ce sens on dit plutôt laine",
                        "examples": []
                    },
                    {
                        "sense_id": "be088b7a-3892-345b-a640-c44b94f17494",
                        "entry_id": "872ae318-87fc-3f53-bb75-d17555bbde17",
                        "glosses": [
                            "Façon qu’on donnait aux draps de laine pour en faire ressortir le poil, cette opération se faisait avec une lainerie."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
