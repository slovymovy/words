                    },
                    {
                        "translation_id": "9a58a396-414f-4aa6-bc3c-be53c853045a",
                        "source_entry_id": "467528f9-05e8-3308-bd76-6e0be2c69934",
                        "source_sense_id": "d242a419-44ed-3598-8822-6d1bbe8a468a",
                        "target_lang_word": "berceuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berceuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Femme chargée de bercer un enfant."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27bafed-6e1e-482f-823b-ba03750986c1",
                                                "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                                "text": "[…] ; cette succession de grands noms de duchesses, de marquises et de belles dames, les gouvernantes et les sous-gouvernantes, et les dames pour accompagner, les femmes de chambre, les dames d'atours, les habilleuses, les berceuses, les feutières, les remueuses, tout un monde de femmes qu'on se représente si élégamment délicates, si pleines de respectueuses attentions pour l'enfant qui leur est confié."
                                            },
                                            {
                                                "example_id": "4eb7da94-9820-46ff-a6db-83cb0c0dabfb",
                                                "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                                "text": "– Slick ! Ouvre !\n– Quoi encore ? J’ai pas commandé une berceuse.\n– Rex te laisse dire que le job, c’est pour demain soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f793fe1-cbf9-3abc-91fc-6ac00c503993",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Forme musicale instrumentale ou vocale destinée à endormir les enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14c641c-32c0-41c8-9a90-d61b783eeecc",
                                                "sense_id": "2f793fe1-cbf9-3abc-91fc-6ac00c503993",
                                                "text": "J’entendais ma voix comme de l’extérieur, elle était sourde et monotone, et sa régularité me calmait comme la plus douce des berceuses, moi à qui on n’en avait jamais chantées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Rocking-chair sans mécanisme, monté sur des berceaux ; rarement utilisé en France."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e806d234-83e9-472a-9fc3-62821bee6d4d",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Dans ma famille, la berceuse s’offre de père en fils."
                                            },
                                            {
                                                "example_id": "32969927-e638-4bac-aac5-b867ceeb73a2",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Marie-Élodie jaillissait de sa somnolence tel un diable en boîte, se levait non sans peine de sa berceuse et traversait la cour intérieure en claudiquant."
                                            },
                                            {
                                                "example_id": "27752cf9-6d4d-40ff-b788-3d795923c6d8",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Anna s’était assise dans une berceuse qui avait un coussin tricoté et une mantille à dentelles sur le dossier."
                                            }
                                        ]
                                    }
                                ]
                            },
