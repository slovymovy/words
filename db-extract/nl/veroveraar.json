                ],
                "senses": [
                    {
                        "sense_id": "c2b4add8-3234-368b-b4a9-c55e8b88f3d5",
                        "entry_id": "2b79ef10-ef8c-3a8d-80c5-12fd9555cd26",
                        "glosses": [
                            "een vreemdeling die een gebied overmeestert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "badd3d16-7fab-4686-a39d-c28ef3573b07",
                                "sense_id": "c2b4add8-3234-368b-b4a9-c55e8b88f3d5",
                                "text": "De Duitse veroveraars hebben een groot deel van Europa overmeesterd."
                            },
                            {
                                "example_id": "c37a5ddc-ecc1-4ff9-bcc6-d83838c34852",
                                "sense_id": "c2b4add8-3234-368b-b4a9-c55e8b88f3d5",
                                "text": "Was hun koning, Willem de Veroveraar, niet tijdens een geweldige storm, dankzij de heilige Nicolaas, veilig van Normandië naar Engeland gevaren? Want Nicolaas was in staat de wind en de onstuimige kracht der golven te doen bedaren!"
                            }
                        ]
                    },
                    {
                        "sense_id": "857449d4-daeb-3f2e-8b87-9e6f8ed78984",
                        "entry_id": "2b79ef10-ef8c-3a8d-80c5-12fd9555cd26",
                        "glosses": [
                            "iemand die de liefde van een vrouw weet op te wekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f27300-c21e-4568-944b-325bf673f986",
                                "sense_id": "857449d4-daeb-3f2e-8b87-9e6f8ed78984",
                                "text": "De veroveraar had weinig interesse meer in de vrouw toen zijn versierpogingen gelukt waren."
                            }
                        ]
                    }
                ],
