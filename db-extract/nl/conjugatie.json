                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a64e4811-ad4a-3b51-9f22-d76bf046de2f",
                                        "entry_id": "848c822a-ce8b-3898-907a-fe9917d84aee",
                                        "glosses": [
                                            "Délocalisation d’électrons de type π, par exemple dans une séquence de liaisons simples et multiples alternées."
                                        ],
