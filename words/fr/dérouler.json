                    ]
                },
                {
                    "sense_id": "a52939e6-312b-354d-9f49-1d8166fe49d5",
                    "sense_definition": "Exposer ou présenter successivement une suite d'éléments, d'idées ou d'arguments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exposer",
                    "name_type": "no",
                    "examples": [
