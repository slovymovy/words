                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dresser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3223aca7-d505-32a3-9547-4af5b29f5789",
                                        "entry_id": "0c1df895-9b9d-3e0a-833a-47ff94977fc1",
                                        "glosses": [
                                            "An item of kitchen furniture, like a cabinet with shelves, for storing crockery or utensils."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5f93e5-24da-48fb-bed9-67fe882f5b50",
                                                "sense_id": "3223aca7-d505-32a3-9547-4af5b29f5789",
                                                "text": "The pewter plates on the dresser / Caught and reflected the flame, as shields of armies the sunshine."
                                            },
                                            {
                                                "example_id": "dbf779ec-0b1c-4f0e-b3cd-32f8c2362e93",
                                                "sense_id": "3223aca7-d505-32a3-9547-4af5b29f5789",
                                                "text": "But it went through her like a flash of hot fire when, in passing, he lurched against the dresser, setting the tins rattling, and clutched at the white pot knobs for support."
                                            },
                                            {
                                                "example_id": "54b54e05-7251-416e-81f1-af06d510a14a",
                                                "sense_id": "3223aca7-d505-32a3-9547-4af5b29f5789",
                                                "text": "The other room was a kitchen, with an open fireplace, a safe, a dresser and a tin sink, with a tap from the tank outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be2a6ecf-c963-32f3-81ab-6aad5df38493",
                                        "entry_id": "0c1df895-9b9d-3e0a-833a-47ff94977fc1",
                                        "glosses": [
                                            "An item of bedroom furniture, like a low chest of drawers (bureau), often with a mirror."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dresser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cfc413c-7e4a-37c7-9682-83da6aed9693",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "One who dresses in a particular way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fae125a-15e1-454e-a05c-07a3928689d9",
                                                "sense_id": "3cfc413c-7e4a-37c7-9682-83da6aed9693",
                                                "text": "He's a very snappy dresser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2558aaab-a793-37e7-888d-36453706238b",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A wardrobe assistant (who helps actors put on their costume)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcaf604d-901e-33de-9d11-bae74ef95be6",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A servant to royalty etc. who helps them with tasks such as dressing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da3a858-6cdc-4de9-ba77-d58e47fc5c57",
                                                "sense_id": "dcaf604d-901e-33de-9d11-bae74ef95be6",
                                                "text": "In the Queen's coach are the Queen's stateroom and bathroom, the Royal Family lounge, lady-in-waiting's compartment and bathroom, and dresser's room."
                                            },
                                            {
                                                "example_id": "5971d0f5-2e94-4f16-80ee-c265471daef8",
                                                "sense_id": "dcaf604d-901e-33de-9d11-bae74ef95be6",
                                                "text": "The former royal butler Guy Hunting recalls the uphill task faced by the Princess's dresser, Isobel Mathieson, each morning. 'During her many years with Princess Margaret, the biggest challenge Isobel faced each day was separating the royal body from its bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4da6b2-d20c-3b4e-91e2-a14d986082fd",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A surgeon's assistant who helps to dress wounds etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f90a18-9986-414e-889b-04cbda108471",
                                                "sense_id": "dd4da6b2-d20c-3b4e-91e2-a14d986082fd",
                                                "text": "On the very day that I had come to this conclusion, I was standing at the Criterion Bar, when someone tapped me on the shoulder, and turning round I recognized young Stamford, who had been a dresser under me at Bart's."
                                            },
                                            {
                                                "example_id": "2f879cfd-921d-49df-a805-3bd71beb865b",
                                                "sense_id": "dd4da6b2-d20c-3b4e-91e2-a14d986082fd",
                                                "text": "Boatmen and passengers — a Chinese assistant manager and a Tamil hospital dresser whom Crabbe had met before, two Malays of occupation undefined — helped Crabbe into the launch, but Vythilingam did not move, did not even seem to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ac185b-82fe-3b99-935b-3211b0c13386",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A football hooligan who wears designer clothing; a casual."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf042e60-c6a6-44c4-a9f5-6ed51b95d220",
                                                "sense_id": "08ac185b-82fe-3b99-935b-3211b0c13386",
                                                "text": "Because we were the first by a long way to turn trendy, we're still the only dressers in Scotland and our enemies were easily recognised: denims and DM's, skinheads and parkas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787ae73e-861d-3757-85b9-906a2961ea0b",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A mechanical device used in grain mills for bolting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4deab046-4fd3-36b8-952b-5a6a740ad103",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A mechanical device used in ore mills for dressing (e.g., comminution, sorting, sifting)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc12b675-812d-4f5b-a444-b30c7e4d15c4",
                                                "sense_id": "4deab046-4fd3-36b8-952b-5a6a740ad103",
                                                "text": "ore dresser"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "347c3e79-69c9-3d1e-99b1-c408ad6c756c",
                                        "entry_id": "11efe79f-def9-3fcb-a0d9-6b7213fc132e",
                                        "glosses": [
                                            "A table or bench on which meat and other things are dressed, or prepared for use."
