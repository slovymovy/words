        "nl-extract.jsonl": [
            {
                "entry_id": "ab4a2f12-b0e8-3182-9e22-19d0f9022c0e",
                "word": "rentenieren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                        "entry_id": "ab4a2f12-b0e8-3182-9e22-19d0f9022c0e",
                        "glosses": [
                            "leven van de rente van het kapitaal dat je bezit; niet meer hoeven te werken voor je dagelijks brood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ec6ab5-68d7-4ae9-8a40-24b0a80a55ed",
                                "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                                "text": "Hij was dan ook de bestbetaalde kunstenaar van zijn tijd met een jaarinkomen van 4000 gulden. Van 10.000 gulden kon je toen zeer royaal rentenieren."
                            },
                            {
                                "example_id": "fc7cd38e-79d9-43f6-bd5c-69dde248dc22",
                                "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                                "text": "Het bureau Intersolve Technologies B.V. dat de U-passen verstrekt, blijkt alleen te kijken naar het inkomen en niet naar het vermogen van de aanvragers. Daardoor kunnen bijvoorbeeld miljonairs die rentenieren ook in aanmerking komen voor een pas."
                            },
                            {
                                "example_id": "adf10c71-eb1a-4190-aa55-97c3c4f42c89",
                                "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                                "text": "Gróót is de kans dat als TATJANA SIMIC tegenwoordig vraagt: ’Maar buurman, wat doet u nu?’, diens antwoord zal zijn: RENTENIEREN"
                            },
                            {
                                "example_id": "f9539ce9-6ba6-4507-8fee-aef93e95e353",
                                "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                                "text": "Ondertussen moet Afida alle eindjes aan elkaar knopen om voor haar man te zorgen, terwijl Tina haar snor drukt en rustig met haar man Erwin Bach renteniert in Zwitserland. Alfida kan dat niet begrijpen, huilt ze tegen de bron. \"Ik ben zo verdrietig over deze gang van zaken. Ik hoop dat Tina snel inziet dat dit wel háár zoon is, en dat ze de middelen heeft om hem te helpen.\""
                            },
                            {
                                "example_id": "4f22a4a5-d140-4bf0-b9f2-f29a28b29fcd",
                                "sense_id": "1744ee27-08b9-3f48-af17-878fba68e4b2",
                                "text": "Drentenieren wordt het genoemd. Met name in de hoogtijdagen van de woningmarkt razend populair. Bewoners van de hectische Randstad verkochten hun stulpje en gingen rentenieren in rustiek Drenthe, provincie waar de tijd maar geen vat op lijkt te krijgen."
                            }
                        ]
                    }
                ],
