{
    "word_family": [
        "humiliate",
        "humiliation",
        "humiliating",
        "humiliatingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24ed6ca5-6a93-382a-b64d-41c825b385fa",
                    "sense_definition": "Feeling deeply ashamed, embarrassed, or deprived of dignity due to a public injury to self-respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt deeply <w>humiliated</w> after forgetting his speech in front of the entire audience.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя глубоко <w>униженным</w>, когда забыл свою речь перед всей аудиторией."
                            }
                        },
                        {
                            "text": "She felt completely <w>humiliated</w> when they criticized her work in public.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя совершенно <w>униженной</w>, когда её работу раскритиковали публично."
                            }
                        }
                    ],
                    "synonyms": [
                        "degraded"
                    ],
                    "antonyms": [
                        "proud",
                        "honored"
                    ],
                    "common_phrases": [
                        "feel humiliated",
                        "completely humiliated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого стыда, смущения или утраты достоинства из-за публичного оскорбления самоуважения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "униженный",
                                "target_lang_sense_clarification": "испытывающий чувство унижения и стыда"
                            },
                            {
                                "target_lang_word": "опозоренный",
                                "target_lang_sense_clarification": "лишённый чести, подвергшийся позору"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f77d033b-109d-3623-8093-806f9eb7b465",
                    "sense_definition": "simple past and past participle of <w>humiliate</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public defeat completely <w>humiliated</w> the arrogant politician.",
                            "target_lang_translations": {
                                "ru": "Публичное поражение полностью <w>унизило</w> высокомерного политика."
                            }
                        },
                        {
                            "text": "Her harsh criticism in front of the team <w>humiliated</w> him.",
                            "target_lang_translations": {
                                "ru": "Её резкая критика перед всей командой <w>унизила</w> его."
                            }
                        }
                    ],
                    "common_phrases": [
                        "humiliated publicly",
                        "humiliated by failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола humiliate (унизить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унизил",
                                "target_lang_sense_clarification": "в форме прошедшего времени глагола унизить"
                            },
                            {
                                "target_lang_word": "униженный",
                                "target_lang_sense_clarification": "причастие от глагола унизить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}