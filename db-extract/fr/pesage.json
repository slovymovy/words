                        "entry_id": "049d662d-5d9b-3472-ac05-2e22b67f7fa6",
                        "glosses": [
                            "Action de peser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea6e0813-908b-3e07-b919-8058bd2a4e65",
                        "entry_id": "049d662d-5d9b-3472-ac05-2e22b67f7fa6",
                        "glosses": [
                            "Action de peser les jockeys et leur selle avant la course, pour vérifier que le poids minimal réglementaire est atteint."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ec3a52e6-bc79-4e82-8c59-3de50b3d9e3a",
                                "sense_id": "ea6e0813-908b-3e07-b919-8058bd2a4e65",
                                "text": "L’enceinte du pesage : Enceinte ouverte au public (ou à une partie sélectionnée du public) où les turfistes peuvent voir les chevaux de près."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9bae863-5d42-3095-922a-b70a3e00e0d5",
                        "entry_id": "049d662d-5d9b-3472-ac05-2e22b67f7fa6",
                        "glosses": [
                            "Enceinte dans laquelle se déroule cette action."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "1f38837f-32bc-47ac-9a5b-a4e75494d885",
                                "sense_id": "b9bae863-5d42-3095-922a-b70a3e00e0d5",
                                "text": "Parfait, nous irions donc déjeuner au pesage et nous passerions l’après-midi à encourager la race chevaline."
                            }
                        ]
                    },
                    {
                        "sense_id": "63d089ac-f9f0-3408-aac6-ad322ff38f9f",
                        "entry_id": "049d662d-5d9b-3472-ac05-2e22b67f7fa6",
                        "glosses": [
                            "Lieu où on peut voir les concurrents de près, dans un vélodrome ou un autodrome."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
