                                "target_senses": [
                                    {
                                        "sense_id": "a8c018cc-4c43-37a5-af20-4c275f612c09",
                                        "entry_id": "66b551db-2209-3803-9ff0-87ba6572cb4d",
                                        "glosses": [
                                            "een met een halve toon verlaagde toon \\\"g\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3d3c6f-7946-4283-8136-d37587c91e80",
                                                "sense_id": "a8c018cc-4c43-37a5-af20-4c275f612c09",
                                                "text": "De toon “ges” klinkt in de getempereerde stemming, gelijk aan de toon “fis”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "845c5728-5e13-34d9-9b44-4d18eb6875da",
                                        "entry_id": "66b551db-2209-3803-9ff0-87ba6572cb4d",
                                        "glosses": [
                                            "de grondtoon (tonica) van de “ges-mineurtoonladder”, een toonladder met negen mollen als voortekens, tevens een korte aanduiding van die toonladder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90930160-6b22-4296-8062-a7c54ad1b70b",
                                                "sense_id": "845c5728-5e13-34d9-9b44-4d18eb6875da",
                                                "text": "Een muziekstuk in ges wordt daar genoteerd in het gelijkklinkende fis-mineur dat slechts drie kruisen als voortekens heeft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5e7805-e4b9-3bea-a6e1-03bd0e64a21e",
                                        "entry_id": "66b551db-2209-3803-9ff0-87ba6572cb4d",
                                        "glosses": [
                                            "de grondtoon van het “ges-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f6825ff-bc9a-4cc8-86c8-22952dd576b8",
                                                "sense_id": "1d5e7805-e4b9-3bea-a6e1-03bd0e64a21e",
                                                "text": "De drie tonen van het ges-mineurakkoord (symbool: G♭m) in grondligging, zijn: ges - beses - des."
                                            }
                                        ]
                                    }
                                ]
                            }
