                                "target_senses": [
                                    {
                                        "sense_id": "2e631397-477c-34f2-adc3-5dfa7d732824",
                                        "entry_id": "e68f8eda-9f83-34d4-ba73-e83f06dba852",
                                        "glosses": [
                                            "Métier à tisser destiné à tisser la soie."
                                        ],
                                        "tags": [
                                            "Soierie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddba2eff-0224-4830-8774-fb2c21873bb3",
                                                "sense_id": "2e631397-477c-34f2-adc3-5dfa7d732824",
                                                "text": "Le métier Jacquard ou simplement jacquard a été une des causes de la Révolte des Canuts. En effet, Joseph-Marie Jacquard a developpé cette technologie pour commander la levée de fils de chaîne sur le métier à tisser de manière mécanique afin d’éviter ce travail aux enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a9c4da-133a-397c-98c2-53904dff8ba4",
                                        "entry_id": "e68f8eda-9f83-34d4-ba73-e83f06dba852",
                                        "glosses": [
                                            "Tissu élaboré sur le jacquard."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe0c4216-d726-46b0-a1d5-0a1c6eeae873",
                                                "sense_id": "d6a9c4da-133a-397c-98c2-53904dff8ba4",
                                                "text": "Margery ! Mrs Blaine a besoin de combien de magenta pour le twin-set en jacquard ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757fea4c-d97d-3b8a-80e6-fb16bd1c4cc1",
                                        "entry_id": "e68f8eda-9f83-34d4-ba73-e83f06dba852",
                                        "glosses": [
                                            "Tricot fait à la main ou à la machine, à motifs géométriques et aux couleurs variées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f5522aa-0eeb-4cdb-933a-f7fef9107a51",
                                                "sense_id": "757fea4c-d97d-3b8a-80e6-fb16bd1c4cc1",
                                                "text": "Quel sociologue appréciera le ferme flou des dernières démocraties qui auront lutté contre l’angoisse ambiante par le ponceau d’un spencer ou le jacquard d’un pull-over ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062fca7e-13a6-413f-a847-c572659f86ca",
                        "source_entry_id": "22e7b2b3-2e20-3500-b070-d306891c82eb",
                        "source_sense_id": "34836036-5e76-30aa-b2ea-2a204c9fd606",
                        "target_lang_word": "жаккард",
