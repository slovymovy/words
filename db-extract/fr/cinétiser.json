                "senses": [
                    {
                        "sense_id": "b0b1a40a-d2a2-3be2-b298-4be405992b47",
                        "entry_id": "0152a5ad-17ae-30fd-a38e-177f998beb8c",
                        "glosses": [
                            "Donner un caractère cinétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2503410b-3f98-4bae-8db9-d1ba778db35f",
                                "sense_id": "b0b1a40a-d2a2-3be2-b298-4be405992b47",
                                "text": "Ces algorithmes randomisés ne semblent pas évidents à « cinétiser », c’est-à-dire à adapter au cas de segments bougeant continûment."
                            },
                            {
                                "example_id": "268ca1c0-f798-474f-bb1f-30cfe7c46e4f",
                                "sense_id": "b0b1a40a-d2a2-3be2-b298-4be405992b47",
                                "text": "Avec André Balthasar, il crée en 1957 le Daily-bul. Bientôt, il s'attaque à \"cinétiser\" les grandes œuvres."
                            },
                            {
                                "example_id": "eb195aad-2b83-443a-92e9-57f3d45ece45",
                                "sense_id": "b0b1a40a-d2a2-3be2-b298-4be405992b47",
                                "text": "Pol Bury a offert de «cinétiser» son auteur. On ne pouvait mieux rendre la pareille à une pensée aussi cinétique."
                            }
                        ]
                    }
