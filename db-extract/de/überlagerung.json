                                        "sense_id": "468643a7-6f32-3089-8583-1b71feb29146",
                                        "entry_id": "30939bfe-425b-37de-a930-7b547a5961a8",
                                        "glosses": [
                                            "The placing of one thing on top of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9142d863-e917-348b-ad49-c9c75587dbf2",
                                        "entry_id": "30939bfe-425b-37de-a930-7b547a5961a8",
                                        "glosses": [
                                            "The deposition of one stratum over another; the principle that in a series of sedimentary strata, the lower strata are the older."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57e987ee-fba2-34a4-b716-e09d75b7cd9b",
                                        "entry_id": "30939bfe-425b-37de-a930-7b547a5961a8",
                                        "glosses": [
                                            "The situation in quantum mechanics where two or more quantum states are added together (superposed) to yield another valid quantum state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ae4b8c2-2c55-43c4-b09f-89b806c26050",
                        "source_entry_id": "6895b4b4-00e5-3a95-8747-063b7eaec89a",
                        "source_sense_id": "68be526f-68b9-38d5-8f6a-961154d5969c",
                        "source_sense_description": "Physik, Technik: Interferenz von zwei oder mehr Wellen",
                        "target_lang_word": "superposition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superposition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76696c06-5a8e-3339-baa2-00c99d72016c",
                                        "entry_id": "bd048f18-3525-33c2-99e1-93dd83f831c6",
                                        "glosses": [
                                            "Action de superposer ; état des choses superposées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cffe8e63-ba7a-4348-86a1-3191840ea508",
                                                "sense_id": "76696c06-5a8e-3339-baa2-00c99d72016c",
                                                "text": "Nous terminâmes notre visite par une ascension au clocher, au sommet duquel on arrive par des superpositions d’échelles assez roides et d’un aspect peu rassurant."
                                            },
                                            {
                                                "example_id": "750da80e-6d5c-488f-b099-4f470c45c473",
                                                "sense_id": "76696c06-5a8e-3339-baa2-00c99d72016c",
                                                "text": "La flore se trouve ainsi formée d'une superposition de flores diverses, c'est la plus importante qui est choisie pour caractériser floristiquement le territoire considéré."
                                            },
                                            {
                                                "example_id": "a28cb246-1ed0-4686-a212-0ef9ad266d8e",
                                                "sense_id": "76696c06-5a8e-3339-baa2-00c99d72016c",
                                                "text": "Difficile donc de les expliquer, mais retenons que les bits quantiques, appelés qbits, sont eux des superpositions de 0 et de 1, multipliant ainsi les possibilités et donc la puissance lorsqu’il s’agit de calculs."
                                            },
                                            {
                                                "example_id": "37c22685-4651-427e-b1a1-ab19d2f55f43",
                                                "sense_id": "76696c06-5a8e-3339-baa2-00c99d72016c",
                                                "text": "La superposition des couches géologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a6baef9-7551-4bc6-857c-69e0a1f657b3",
                        "source_entry_id": "6895b4b4-00e5-3a95-8747-063b7eaec89a",
                        "source_sense_id": "68be526f-68b9-38d5-8f6a-961154d5969c",
                        "source_sense_description": "Physik, Technik: Interferenz von zwei oder mehr Wellen",
                        "target_lang_word": "наложение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наложение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1eb6ba46-8bad-38b7-baa3-8d455504c4b1",
                                        "entry_id": "aafcdfef-5f48-309a-bf5a-ba605dc03f4c",
                                        "glosses": [
                                            "действие по значению гл. налагать, наложить; помещение чего-либо сверху или поверх чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f480e38b-95c4-4432-adfb-898633b5b449",
                                                "sense_id": "1eb6ba46-8bad-38b7-baa3-8d455504c4b1",
                                                "text": "Доказательство этому сделать весьма легко наложением одного прямоугольника на другой."
                                            },
                                            {
                                                "example_id": "111db31a-54a4-4cb7-bb1c-45e85e277b6b",
                                                "sense_id": "1eb6ba46-8bad-38b7-baa3-8d455504c4b1",
                                                "text": "Если всё получалось, то эта запись переписывалась на втором СТМе с одновременным наложением ду́док и ещё одной гитары. Если опять всё получалось, то всё переписывалось обратно на первый магнитофон с наложением голосов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f8513c-9a9f-3840-87cf-7c26f28979f7",
                                        "entry_id": "aafcdfef-5f48-309a-bf5a-ba605dc03f4c",
                                        "glosses": [
                                            "результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b4e00e8-e7d9-43f2-b267-e9e44ff1cdf3",
                                                "sense_id": "a2f8513c-9a9f-3840-87cf-7c26f28979f7",
                                                "text": "Очевидно, мы имеем дело с наблюдаемым феноменом — наложением двух климатообразующих процессов — антропогенного глобального потепления климата и естественного — «потепления Арктики»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
