                "senses": [
                    {
                        "sense_id": "aa1d0ef5-fe52-3954-9783-9e425f5bad58",
                        "entry_id": "d00cded6-d8d2-30ae-91d4-fbda902066b2",
                        "glosses": [
                            "произрасти, вырасти (о злаках, плодах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120418a9-3f1b-4117-9694-5a2638506cc4",
                                "sense_id": "aa1d0ef5-fe52-3954-9783-9e425f5bad58",
                                "text": "Уродилось много хлеба. Яблоки уродились в этом году кислые."
                            }
                        ]
                    },
                    {
                        "sense_id": "de7dee3f-e28b-39e9-84fb-6fef95c144bb",
                        "entry_id": "d00cded6-d8d2-30ae-91d4-fbda902066b2",
                        "glosses": [
                            "разг. родиться похожим на кого-нибудь (о человеке) ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d3182c-4d6f-43b1-9a6b-0e001d44e292",
                                "sense_id": "de7dee3f-e28b-39e9-84fb-6fef95c144bb",
                                "text": "И в кого это ты такая уродилась?"
                            },
                            {
                                "example_id": "beeb39d0-11dc-4035-ba0e-866e8915726b",
                                "sense_id": "de7dee3f-e28b-39e9-84fb-6fef95c144bb",
                                "text": "И мать туда же: в кого, мол, ты вором уродился?"
                            }
                        ]
                    }
                ],
