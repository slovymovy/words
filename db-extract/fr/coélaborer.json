                "senses": [
                    {
                        "sense_id": "8d4b538e-d1c3-3fa9-a16c-b60626a45248",
                        "entry_id": "2633ee22-5f30-315a-a613-123cd19b18fa",
                        "glosses": [
                            "Élaborer ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10f94c7-678e-434b-b7a1-9c98e55382f6",
                                "sense_id": "8d4b538e-d1c3-3fa9-a16c-b60626a45248",
                                "text": "Cela correspond à notre point de vue mais encore faut—il savoir communiquer, écouter, partager, échanger et coélaborer."
                            },
                            {
                                "example_id": "35a9b91c-17d9-421e-a213-4fd51823400d",
                                "sense_id": "8d4b538e-d1c3-3fa9-a16c-b60626a45248",
                                "text": "La baisse des coûts est l’objectif prioritaire et l’évaluation est rabattue sur la standardisation des résultats, ce qui n’autorise plus guère les associations à innover ou à coélaborer l'intérêt général."
                            }
                        ]
