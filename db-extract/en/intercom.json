                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                        "entry_id": "ceb50abf-bc05-3d47-9f8f-e653769dfe6d",
                                        "glosses": [
                                            "Téléphone connecté à un réseau intérieur à un immeuble, hôtel, etc., souvent équipé d’un haut-parleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41228d28-cb85-4fb9-baef-5e33a191b6da",
                                                "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                                "text": "Tant pis! dit le Président avant d’appuyer sur l’interphone : Caroline, allez-y, faites entrer."
                                            },
                                            {
                                                "example_id": "ce996ab6-d253-4554-96e1-ce739b26fc8c",
                                                "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                                "text": "Ainsi, c’est après avoir appelé sa secrétaire sur l’interphone que Stahr apprend la tentative de suicide d’un de ses caméramen, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47da2244-fbcc-387d-856c-ced329bfbf3d",
                                        "entry_id": "ceb50abf-bc05-3d47-9f8f-e653769dfe6d",
                                        "glosses": [
                                            "Dispositif acoustique électronique interne à un immeuble, placé à l’entrée et dans un ou plusieurs pièces de celui-ci, afin d’en contrôler l’accès à l’aide d’un ouvre-porte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f819e5a1-3449-44d6-b70c-f42877850504",
                                                "sense_id": "47da2244-fbcc-387d-856c-ced329bfbf3d",
                                                "text": "Notre interphone permet non seulement d’accueillir les visiteurs, mais également de commander à distance l’ouverture de la porte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interphone",
