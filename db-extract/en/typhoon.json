                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb19be92-438a-42da-b7d0-34fd34c2062d",
                        "source_entry_id": "135ac1b0-6069-3290-81f6-fbd59b6f785e",
                        "source_sense_description": "hurricane in the Pacific",
                        "target_lang_word": "typhon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typhon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                        "entry_id": "4c2f2b9e-dace-3412-8ced-18fdecb498ce",
                                        "glosses": [
                                            "Cyclone tropical très violent en Extrême-Orient, issu du Pacifique nord-ouest ou de la mer de Chine méridionale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f2ef72-f415-4d45-8821-39e2167aa95d",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Voyez. C’est un typhon qui se prépare !\n− Va pour le typhon du sud, puisqu'il nous poussera du bon côté, répondit Mr Fogg."
                                            },
                                            {
                                                "example_id": "ef12a5b2-7766-4b4b-81a8-055795ceeb3e",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Depuis, j'ai vérifié que le vent est un grand personnage de la géographie, et que l'on s'expose à ne rien comprendre à l'histoire si l'on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu'ils créent la ville de Marseille."
                                            },
                                            {
                                                "example_id": "289db892-b78b-4acb-9153-ac481597b52f",
                                                "sense_id": "0a4ea7c0-e72c-3ef8-8a64-3f897223f69d",
                                                "text": "Les Philippines, classées parmi les pays les plus exposés au changement climatique, sont balayées par près de 20 tempêtes tropicales ou typhons chaque année qui détruisent généralement récoltes, habitations et infrastructures dans des régions déjà pauvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b2f56fa-d57d-4b02-9fca-726adebd09b4",
                        "source_entry_id": "135ac1b0-6069-3290-81f6-fbd59b6f785e",
                        "source_sense_description": "hurricane in the Pacific",
                        "target_lang_word": "Taifun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taifun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                        "entry_id": "10aea82e-d3bb-3d96-befe-f7ef43bb86ff",
                                        "glosses": [
                                            "tropischer Wirbelsturm im nordwestlichen Teil des Pazifischen Ozeans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb70f7b2-ef57-4011-b2a6-030fc2c4eef1",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "Der Taifun Nabi verwüstete am 6. September 2005 die japanische Insel Kyūshū."
                                            },
                                            {
                                                "example_id": "8ae67aa1-b395-4122-9ccd-a68fd1f9e9ac",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Einer der bislang mächtigsten Taifune ist mit verheerender Zerstörungskraft über die Philippinen hereingebrochen.“"
                                            },
                                            {
                                                "example_id": "847e010b-27a8-4e44-8f72-f99fc937fff1",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Am nächsten Tag schon hätten sie losfliegen können, doch hielt sie ein Taifun, der über Japan hinwegzog, davon ab.“"
                                            },
                                            {
                                                "example_id": "0537ed13-dcef-4b93-971c-9b5b1c8e706f",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Nach seinem Tod betrachteten es die Deckoffiziere als oberste Pflicht, die Anweisung, nach der der Alte das Flaggschiff durch Flauten und Taifune gesteuert hatte, als Vermächtnis zu beherzigen.“"
                                            },
                                            {
                                                "example_id": "a0f06244-3fa7-452f-98da-fe20544e8d5d",
                                                "sense_id": "b7874e23-bc5f-3ec3-9e27-4829c521c93f",
                                                "text": "„Und wie ein näherkreisender Taifun kehrte der Donner der Schlacht zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
