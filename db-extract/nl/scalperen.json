        "nl-extract.jsonl": [
            {
                "entry_id": "1012e2a8-a673-3dbb-8210-efb3b3ff3295",
                "word": "scalperen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da6614b9-622f-3b07-9a58-4b4b192d79e7",
                        "entry_id": "1012e2a8-a673-3dbb-8210-efb3b3ff3295",
                        "glosses": [
                            "verwijderen van hoofdhuid en daarmee ook van het hoofdhaar, gebruik van Noord-Amerikaanse indianen tegenover vijanden, maar het kan ook door een ongeluk gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5539c89-4c2f-48a4-88c2-a8f448654acd",
                                "sense_id": "da6614b9-622f-3b07-9a58-4b4b192d79e7",
                                "text": "Dat de botten sporen van kannibalisme dragen, is geen nieuwe bewering, zo geven Silvia Bello en collega’s toe. Bello identificeerde de jongste zes jaar de resten van ten minste zes mensen uit de grot (een kleuter, twee tieners, twee volwassenen en een oudere), allemaal met sporen van het verwijderen van ledematen, scalpering en/of ontvlezing. De schedels werden bijgewerkt tot kommen."
                            },
                            {
                                "example_id": "ded778ef-02d1-4c72-be82-976ba87fea0a",
                                "sense_id": "da6614b9-622f-3b07-9a58-4b4b192d79e7",
                                "text": "De 12-jarige Elizabeth Gilreath spreekt voor het eerst over het ene moment waarop haar leven in een hel veranderde. Een jaar geleden liep ze een schedelbreuk op en werd ze gescalpeerd, nadat ze met haar paardenstaart verstrikt raakte in een draaiende kermisattractie in Omaha (Nebraska). ‘Mijn littekens bepalen niet wie ik ben.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4913f50-ba09-4fcf-9153-4e2761141d8e",
                        "source_entry_id": "1012e2a8-a673-3dbb-8210-efb3b3ff3295",
                        "source_sense_id": "da6614b9-622f-3b07-9a58-4b4b192d79e7",
                        "source_sense_description": "verwijderen van hoofdhuid en daarmee ook van het hoofdhaar...",
                        "target_lang_word": "scalp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scalp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f7c356-c425-337c-a625-72223a6a0123",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "The top of the head; the skull."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d457167-7b8d-3b23-aba9-30dc79e7d3a7",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "The part of the head where the hair grows from, or used to grow from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae592b0-bd8b-44e5-9821-2726b53aba3f",
                                                "sense_id": "9d457167-7b8d-3b23-aba9-30dc79e7d3a7",
                                                "text": "By the bare scalpe of Robin Hoods fat Fryer, / This fellow were a King, for our wilde faction."
                                            },
                                            {
                                                "example_id": "51c9500a-aa2b-434d-82de-cca0956bee2e",
                                                "sense_id": "9d457167-7b8d-3b23-aba9-30dc79e7d3a7",
                                                "text": "The original titanium mesh plate that was inserted in the summer of 2010 was removed last June since it was causing his scalp to break down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69277916-5a6d-303a-b658-a6c6c5ea99e6",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "The part of the head where the hair grows from, or used to grow from.",
                                            "A part of the skin of the head, with the hair attached, formerly cut or torn off from an enemy by warriors in some cultures as a token of victory."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd3ebd8-a61e-4e11-9f20-c951306c7222",
                                                "sense_id": "69277916-5a6d-303a-b658-a6c6c5ea99e6",
                                                "text": "Some tribes used to collect scalps to prove how many of the enemy they had killed in battle."
                                            },
                                            {
                                                "example_id": "d3b43a6b-01df-4570-a9e8-1a3be7e9cadc",
                                                "sense_id": "69277916-5a6d-303a-b658-a6c6c5ea99e6",
                                                "text": "The most disturbing thing about Disneyland is seeing all those smiling people walking around wearing Mickey Mouse's severed scalp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e17c5d6-16ed-3121-a7bf-81a2172461ac",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "The part of the head where the hair grows from, or used to grow from.",
                                            "The skin of the head of a stag, to which the horns are attached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a294e6d9-7cb1-4305-92d6-9f8ab1691396",
                                                "sense_id": "2e17c5d6-16ed-3121-a7bf-81a2172461ac",
                                                "text": "He bears for Arms : Argent, on a chevron invected gules, between two bugle-horns sable, stringed of the second in chief, and the attires of a stag affixed to the scalp in base of the third, two fasces chevronways or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "A victory, especially at the expense of someone else."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bbe96cf-b014-4dfb-b7e4-7b3bcf28c3f1",
                                                "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                                "text": "[At the American State Convention in 1856 the Hon E. M. Yerger of Yazoo said that] he came up to the great council fire of his people, not like his friends Cobb, Hillyer and Brooke, with no scalps at his girdle that he had had a fight and a glorious victory."
                                            },
                                            {
                                                "example_id": "192b03ae-a0ac-4ec8-bb2e-f735c59281d5",
                                                "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                                "text": "His mind is quick to perceive a weak place in the enemy's armor, as he glances over the exchanges, and when he \"goes for\" a solitary foe he always returns with the scalp hanging at his girdle."
                                            },
                                            {
                                                "example_id": "305c98db-2f2a-464e-9b54-70374bdd9990",
                                                "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                                "text": "Pat Buchanan, in his ongoing presidential quest, claimed his first scalp, and Donald Wildmon's newsletter chortled that his efforts in opposing the NEA had paid off."
                                            },
                                            {
                                                "example_id": "2d5ce4fc-7522-4735-9c9c-15dea3c2de0b",
                                                "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                                "text": "Admiral Lee, aboard USS Washington, can content himself with the fact that his ship has claimed the scalp, or helped claim the scalp, of three out of the four Kongō class, and has landed meaningful hits on Nagato and Yamato as well, making it the single most successful U.S. battleship in history."
                                            },
                                            {
                                                "example_id": "871009ec-507c-4d13-90cf-429d54f6a92b",
                                                "sense_id": "0f026a78-501a-371d-8283-734b8b6217c4",
                                                "text": "Randy Waldrum’s Nigeria, ranked 40th in the world, 36 places below England, looked as if they would claim the latest big scalp and knock out the European champions after the eliminations of Brazil, Canada, Germany and the USA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d73d4aa-45c9-35ab-997a-b9c34a62c7df",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "A bed or stratum of shellfish."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9c9f4dd-1c2c-3868-b10e-d236ca290088",
                                        "entry_id": "d8f7efb9-6cfe-3ae9-a3ea-eefb802a64b7",
                                        "glosses": [
                                            "The top; the summit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebc97f8-1cf5-4e5f-b332-746aee8e9b2f",
                                                "sense_id": "b9c9f4dd-1c2c-3868-b10e-d236ca290088",
                                                "text": "the snowy scalp of Ben Cruachan"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scalp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "949c65ba-57ca-3779-9839-b20c32f4a32c",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To remove the scalp (part of the head from where the hair grows), by brutal act or accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69925d2-dbeb-4d79-80f7-c768a5baf37b",
                                                "sense_id": "949c65ba-57ca-3779-9839-b20c32f4a32c",
                                                "text": "Next morning, the Indians attacked us and one of our hunters, George Huffman, was killed and scalped. As soon as Baldwin heard the shooting, he came to our assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed4675a-1b1b-3e7e-8ecf-f8a4b6f7e595",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To resell, especially tickets, usually for an inflated price, often illegally."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81eb3dc7-9511-4a42-8146-12828c860e5e",
                                                "sense_id": "9ed4675a-1b1b-3e7e-8ecf-f8a4b6f7e595",
                                                "text": "Tickets were being scalped for $300."
                                            },
                                            {
                                                "example_id": "a09e303a-1ae7-41a2-aba1-657f1ad20030",
                                                "sense_id": "9ed4675a-1b1b-3e7e-8ecf-f8a4b6f7e595",
                                                "text": "Tickets sold online through Craigslist, eBay, and other forums, where the purchaser cannot physically see them, run a greater risk of being counterfeit—but counterfeiters have been known to scalp tickets in person outside the venue as well, […]"
                                            },
                                            {
                                                "example_id": "f212374f-30bf-4a3e-97da-e195dba060f6",
                                                "sense_id": "9ed4675a-1b1b-3e7e-8ecf-f8a4b6f7e595",
                                                "text": "Scalped tickets were going for $3,000 and up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060a7c5d-edda-3c29-b748-6cca690c4fac",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To bet on opposing competitors so as to make a profit from the bookmaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3cc78aa-8f3f-470c-b8fe-4a63dfd38c48",
                                                "sense_id": "060a7c5d-edda-3c29-b748-6cca690c4fac",
                                                "text": "The only sure thing about scalping the Series today is that the scalper is paying the bookie a greater profit because he is making a greater number of bets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe038022-2fa2-3e59-92be-7ad0c972913e",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "On an open outcry exchange trading floor, to buy and sell rapidly for one's own account, aiming to buy from a seller and a little later sell to a buyer, making a small profit from the difference (roughly the amount of the bid/offer spread, or less)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd846377-f624-3418-886f-660fa1ce6768",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To screen or sieve ore before further processing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f224a864-5c48-4d73-b40c-ff527c5c909a",
                                                "sense_id": "fd846377-f624-3418-886f-660fa1ce6768",
                                                "text": "scalped ore"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dec90ec-cab3-3594-a3ec-620b23b971af",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To remove the skin of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f45a1fa-769d-4998-923d-62d1a8d76a34",
                                                "sense_id": "7dec90ec-cab3-3594-a3ec-620b23b971af",
                                                "text": "We must […]\"scalp\" the whole lid [of the eye]."
                                            }
                                        ]
