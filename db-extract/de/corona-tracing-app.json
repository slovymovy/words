                ],
                "senses": [
                    {
                        "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                        "entry_id": "89f2689f-48b0-3067-82ab-51b894235afe",
                        "glosses": [
                            "Programm für Mobiltelefone, Abspielgeräte und Kleincomputer, das dem Zweck dient, die Verbreitung des Coronavirus zu minimieren, indem es zum Beispiel über Kontakte mit einer infizierten Person informiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f607026-a9a5-4cf1-8272-279da578b60c",
                                "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                                "text": "„Die deutschen Konzerne, die mit der Entwicklung der Corona-Tracing-App beauftragt sind, sind nach Angaben der Digitalministerin im Gespräch mit den US-Konzernen zur Nutzung der nötigen Schnittstelle.“"
                            },
                            {
                                "example_id": "1b8bc457-6f08-4925-999b-64d30c2512d4",
                                "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                                "text": "„Mithilfe von Corona-Tracing-Apps sollen Infektionsketten besser nachvollzogen werden.“"
                            },
                            {
                                "example_id": "e7c252cb-072b-4942-8bfd-0ddc468dfc3a",
                                "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                                "text": "„Mit der Corona-Tracing-App soll es möglich sein, Personen zu ermitteln, die mit einem Infizierten in jüngerer Zeit Kontakt hatten.“"
                            },
                            {
                                "example_id": "c85cef16-ad48-4f13-a966-9d612e7dca7c",
                                "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                                "text": "„Während in Deutschland noch gestritten wird, rollt Australien kurzerhand seine eigene Corona-Tracing-App aus: Ab sofort können Bürger des Landes die App „CovidSafe“ sowohl auf Apple- als auch auf Android-Smartphones installieren, innerhalb weniger Stunden wurde die Anwendung des australischen Gesundheitsministeriums allein aus Googles Play Store mehr als 500.000 Mal heruntergeladen.“"
                            },
                            {
                                "example_id": "a0fd45ca-2b83-4cf5-95e4-30bdce3c4a2a",
                                "sense_id": "909e20e8-c02a-33bb-9897-a44cdc83657c",
                                "text": "„Die Firmen, deren Betriebssysteme zusammen auf 99 Prozent aller Smartphones weltweit laufen, könnten mit ihrer ungewöhnlichen Allianz nicht zuletzt den in Europa entwickelten Corona-Tracing-Apps Konkurrenz machen (lesen Sie dazu auch, wie die Schweiz Handydaten auswertet).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
