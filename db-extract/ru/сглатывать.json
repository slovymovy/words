                    },
                    {
                        "sense_id": "3df1e0ee-f97a-346c-b5eb-719d01eedf8d",
                        "entry_id": "bd2c48aa-90b1-305d-a4d5-9deb161a4426",
                        "glosses": [
                            "разг., неперех. делать глотательные движения"
                        ],
                        "tags": [],
