{
    "word_family": [
        "highwayman",
        "superhighway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                    "sense_definition": "A main public road, especially a multi-lane, high-speed thoroughfare connecting major towns or cities.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "road_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We drove along the <w>highway</w> for three hours to reach the coast.",
                            "target_lang_translations": {
                                "ru": "Мы ехали по <w>шоссе</w> три часа, чтобы добраться до побережья.",
                                "zh": "我们在<w>高速公路</w>上开了三个小时才到达海岸。"
                            }
                        },
                        {
                            "text": "The new <w>highway</w> has significantly reduced travel time between the two cities.",
                            "target_lang_translations": {
                                "ru": "Новая <w>автомагистраль</w> значительно сократила время в пути между двумя городами.",
                                "zh": "新建的<w>高速公路</w>大大缩短了两座城市之间的通行时间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interstate highway",
                        "major highway",
                        "highway patrol",
                        "divided highway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главная общественная дорога, особенно многополосная скоростная трасса, соединяющая крупные города.",
                        "zh": "主要的公共道路，特别是连接大城市的多车道高速公路。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоссе",
                                "target_lang_sense_clarification": "дорога с твердым покрытием"
                            },
                            {
                                "target_lang_word": "автомагистраль",
                                "target_lang_sense_clarification": "скоростная дорога"
                            },
                            {
                                "target_lang_word": "трасса",
                                "target_lang_sense_clarification": "междугородняя дорога"
                            },
                            {
                                "target_lang_word": "автострада",
                                "target_lang_sense_clarification": "скоростная дорога (часто о зарубежных)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高速公路",
                                "target_lang_sense_clarification": "连接城市的主要高速道路"
                            },
                            {
                                "target_lang_word": "公路",
                                "target_lang_sense_clarification": "泛指公共道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                    "sense_definition": "A course of action or path that leads directly to a certain outcome or destiny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lack of preparation is a <w>highway</w> to failure.",
                            "target_lang_translations": {
                                "ru": "Его неподготовленность — это <w>прямой путь</w> к провалу.",
                                "zh": "他缺乏准备是通往失败的<w>捷径</w>。"
                            }
                        },
                        {
                            "text": "Many believe that education is the <w>highway</w> to a better future.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что образование — это <w>дорога</w> в лучшее будущее.",
                                "zh": "许多人认为教育是通往美好未来的<w>途径</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "highway to hell",
                        "highway to success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Курс действий или путь, ведущий непосредственно к определенному результату или судьбе.",
                        "zh": "导致特定结果或命运的行动过程或路径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямой путь",
                                "target_lang_sense_clarification": "метафорически"
                            },
                            {
                                "target_lang_word": "дорога",
                                "target_lang_sense_clarification": "в переносном смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捷径",
                                "target_lang_sense_clarification": "比喻通往某事的直接途径"
                            },
                            {
                                "target_lang_word": "途径",
                                "target_lang_sense_clarification": "通往目标的路径"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf40a018-b88d-3f26-a62a-625f5e80c0ed",
                    "sense_definition": "Any public road available for vehicular traffic, often used in legal or formal contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "road_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is an offense to obstruct the public <w>highway</w> without a permit.",
                            "target_lang_translations": {
                                "ru": "Блокирование <w>дороги общего пользования</w> без разрешения является правонарушением.",
                                "zh": "未经许可阻碍<w>公共道路</w>属于违法行为。"
                            }
                        },
                        {
                            "text": "The council is responsible for maintaining every <w>highway</w> in the district.",
                            "target_lang_translations": {
                                "ru": "Совет несет ответственность за содержание каждой <w>автомобильной дороги</w> в округе.",
                                "zh": "市政委员会负责维护区内的每一条<w>公路</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая общественная дорога, доступная для движения транспорта; термин часто используется в юридическом или официальном контексте.",
                        "zh": "任何供车辆通行的公共道路，常用于法律或正式语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорога общего пользования",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "автомобильная дорога",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公共道路",
                                "target_lang_sense_clarification": "法律术语"
                            },
                            {
                                "target_lang_word": "公路",
                                "target_lang_sense_clarification": "正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a9c39a5-a840-3202-9ae2-4f1b18a7a308",
                    "sense_definition": "A common connection for two or more circuits or components in electronics or computing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The data travels along the system <w>highway</w> to reach the memory unit.",
                            "target_lang_translations": {
                                "ru": "Данные передаются по системной <w>магистрали</w>, чтобы попасть в блок памяти.",
                                "zh": "数据沿着系统<w>总线</w>传输以到达内存单元。"
                            }
                        },
                        {
                            "text": "Engineers checked the <w>highway</w> for any signal interference.",
                            "target_lang_translations": {
                                "ru": "Инженеры проверили <w>магистраль</w> на наличие помех сигнала.",
                                "zh": "工程师检查了<w>总线</w>是否存在信号干扰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее соединение для двух или более схем или компонентов в электронике или вычислительной технике.",
                        "zh": "电子或计算中用于连接两个或多个电路或组件的公共连接。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магистраль",
                                "target_lang_sense_clarification": "канал передачи данных"
                            },
                            {
                                "target_lang_word": "шина",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总线",
                                "target_lang_sense_clarification": "计算机数据传输通道"
                            },
                            {
                                "target_lang_word": "数据通路",
                                "target_lang_sense_clarification": "电子电路连接"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0025a09b-c316-362b-92af-53d97fef9132",
                    "sense_definition": "To travel on a highway.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>highway</w> across the country during their summer vacation.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>проехать по шоссе</w> через всю страну во время летнего отпуска.",
                                "zh": "他们决定在暑假期间<w>走高速</w>横穿全国。"
                            }
                        },
                        {
                            "text": "He spent the entire week <w>highwaying</w> from state to state.",
                            "target_lang_translations": {
                                "ru": "Он провел всю неделю, <w>переезжая по трассам</w> из штата в штат.",
                                "zh": "他花了一整周的时间在各州之间<w>走高速</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или ехать по шоссе.",
                        "zh": "在高速公路上行驶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать по шоссе",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走高速",
                                "target_lang_sense_clarification": "驾车行驶在高速公路上"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6ba7002f-33fe-35ab-8ed8-d61cf81fd90b",
                    "sense_definition": "A place name used for various locations in England and the Philippines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited a small hamlet called <w>Highway</w> during our trip to Wiltshire.",
                            "target_lang_translations": {
                                "ru": "Во время поездки в Уилтшир мы посетили небольшую деревушку под названием <w>Хайвей</w>.",
                                "zh": "在去威尔特郡旅行时，我们参观了一个叫<w>海威</w>的小村庄。"
                            }
                        },
                        {
                            "text": "He lives in a neighborhood known as <w>Highway</w>.",
                            "target_lang_translations": {
                                "ru": "Он живет в районе, известном как <w>Хайвей</w>.",
                                "zh": "他住在一个被称为<w>海威</w>的社区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Топоним, используемый для обозначения различных мест в Англии и на Филиппинах.",
                        "zh": "用于英国和菲律宾多个地点的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хайвей",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海威",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}