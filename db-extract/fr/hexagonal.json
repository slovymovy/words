                ],
                "senses": [
                    {
                        "sense_id": "18f884cd-069c-3bd4-bfa4-dbab2c8087d5",
                        "entry_id": "f70faed8-ecaa-33b7-a579-6865083f9ae9",
                        "glosses": [
                            "Qui a la forme d’un hexagone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b62efd6-4c6b-48d6-8e41-bca35958609c",
                                "sense_id": "18f884cd-069c-3bd4-bfa4-dbab2c8087d5",
                                "text": "L’acide tellurique cristallise en gros prismes hexagonaux qui contiennent trois équivalents d’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "99787ecf-a953-3b9a-a545-90626bc7c95d",
                        "entry_id": "f70faed8-ecaa-33b7-a579-6865083f9ae9",
                        "glosses": [
                            "Relatif à l’Hexagone, à la France métropolitaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231540bc-e83a-4c75-a7e6-3c9404f503df",
                                "sense_id": "99787ecf-a953-3b9a-a545-90626bc7c95d",
                                "text": "Jusqu’à présent, les « enseignistes » hexagonaux, une centaine de mini-PME et quelques firmes plus importantes, ne faisaient pas preuve de beaucoup d’agressivité sur un marché français qui a réalisé en 1989 un chiffre d’affaires global de 1,3 milliard de francs."
                            },
                            {
                                "example_id": "d6b491bd-ef6f-4b40-a88f-7c6ff82a8d74",
                                "sense_id": "99787ecf-a953-3b9a-a545-90626bc7c95d",
                                "text": "Elles ne se sont toutefois emparées de cette question que récemment, le système éducatif hexagonal étant officiellement totalement mixte depuis 1969"
                            },
                            {
                                "example_id": "1b0fde6c-d5e5-4f95-9528-e20aee6fefa1",
                                "sense_id": "99787ecf-a953-3b9a-a545-90626bc7c95d",
                                "text": "Le résultat est sans appel : obtenir une visite avec un nom maghrébin est deux à trois fois plus difficile qu’avec un nom « hexagonal » – et le fait d’être fonctionnaire n’y change presque rien."
                            }
                        ]
                    },
                    {
                        "sense_id": "459e0334-79c5-347a-8b46-5a94ccec8b2c",
                        "entry_id": "f70faed8-ecaa-33b7-a579-6865083f9ae9",
                        "glosses": [
                            "Relatif à la France, sans référence à la France métropolitaine."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "9e5fc9eb-e2a5-41ce-94e7-06ddc0f34bde",
                                "sense_id": "459e0334-79c5-347a-8b46-5a94ccec8b2c",
                                "text": "Voici le portrait-robot du voyageur aérien hexagonal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85068cdd-ffd8-4271-8b54-72384e83bc00",
                        "source_entry_id": "f70faed8-ecaa-33b7-a579-6865083f9ae9",
                        "source_sense_description": "Qui a la forme d’un hexagone",
                        "target_lang_word": "hexagonal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexagonal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5ceb1e-179c-352e-8a02-a6bb36145022",
                                        "entry_id": "895660d8-3bfe-3db2-98cc-cb96c60fa064",
                                        "glosses": [
                                            "sechs Ecken besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70857a0f-979c-4347-b9b7-3dfaeb64c76e",
                                                "sense_id": "0c5ceb1e-179c-352e-8a02-a6bb36145022",
                                                "text": "Die dichteste Kugelpackung ist hexagonal."
                                            },
                                            {
                                                "example_id": "abd50e53-c2fd-4a50-97e7-341324b24093",
                                                "sense_id": "0c5ceb1e-179c-352e-8a02-a6bb36145022",
                                                "text": "„Ein weiterer Vertreter dieser Familie ist einschichtiges hexagonales Bornitrid, das aus den Elementen Bor und Stickstoff besteht und genau wie Graphen wabenförmig gebaut ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e598babc-95cb-43f8-960e-63b83a7ecb22",
                        "source_entry_id": "f70faed8-ecaa-33b7-a579-6865083f9ae9",
                        "source_sense_description": "Qui a la forme d’un hexagone",
                        "target_lang_word": "hexagonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexagonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                        "entry_id": "67d8a086-5134-3f27-89c1-1f15510f69f2",
                                        "glosses": [
                                            "Having six edges, or having a cross-section in the form of a hexagon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032e747b-16f8-4e12-ad79-e9c802607831",
                                                "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                                "text": "Nuts in engineering are generally hexagonal."
                                            },
                                            {
                                                "example_id": "e191dfc6-659e-4f6a-9d72-077f15237e3c",
                                                "sense_id": "c9d07f02-e81e-34b9-997c-466604876b6a",
                                                "text": "If we just plopped down a dot for every observation we’d end up with an undifferentiated black blob, so the weathergami technique visualizes frequency of temperature pairs: we divide the chart area into a fine hexagonal grid, and then color each hexagon according to how many daily observations fall within it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11b36ff-ea7a-3f34-bb68-dcef7524de45",
                                        "entry_id": "67d8a086-5134-3f27-89c1-1f15510f69f2",
                                        "glosses": [
                                            "Having three equal axes which cross at 60° angles, and an unequal axis which crosses the others at 90° angle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
