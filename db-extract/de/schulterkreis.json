                "senses": [
                    {
                        "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                        "entry_id": "98cc4d5f-3f41-3bbb-ab5c-51a491036183",
                        "glosses": [
                            "Bewegung einer Schulter (oder beider Schultern gleichzeitig) in einem vollständigen Kreis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b0f724-9fc9-4b96-b16f-029158826f23",
                                "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                                "text": "„Hör Dir gern zwischendurch den Song an, mach ein paar Nacken- und Kopfbewegungen, Schulterkreise und sing laut mit …“"
                            },
                            {
                                "example_id": "c7daa039-8175-44cf-b655-a004bece5e14",
                                "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                                "text": "„Schüttel im Anschluss Deine Arme und Beine aus und mach ein paar Schulterkreise.“"
                            },
                            {
                                "example_id": "7de4c23d-bb74-4581-b5ae-db80b1842548",
                                "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                                "text": "„Mache drei bis fünf große, kraftvolle Schulterkreise nach hinten.“"
                            },
                            {
                                "example_id": "8f838aba-c3d6-4e59-90d5-859c16977c3b",
                                "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                                "text": "„Regelmäßige Schulterkreise eignen sich hervorragend für die Dehnung des oberen Rückenbereichs: Führen Sie dazu mit den Schultern abwechselnd rotierende Bewegungen aus.“"
                            },
                            {
                                "example_id": "aaa4d8e8-aa7c-4cc2-8b19-43f5ed3e5a9d",
                                "sense_id": "ca4c0ef2-6ef4-3106-80c0-45e3a57fbcd8",
                                "text": "„Schüttle deine Arme aus und mache ganz simple Schulterkreise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
