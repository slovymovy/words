                ],
                "translations": [
                    {
                        "translation_id": "3ca3a187-b9c3-4697-beb2-a83d3f10ce49",
                        "source_entry_id": "f7acd72f-3b1e-37cd-b863-e7c0eb6b5e73",
                        "source_sense_id": "b51f1734-5620-32c5-8ec6-535b31d509f9",
                        "target_lang_word": "coulure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coulure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c72d58e-45db-37e3-b370-c418ecb04092",
                                        "entry_id": "d6534497-1707-3683-8cbf-29328b948546",
                                        "glosses": [
                                            "Ce qui s'écoule, en parlant d'un liquide, d'une substance, de peinture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd381fc-4198-4d8f-81d7-d15cefd642d5",
                                                "sense_id": "6c72d58e-45db-37e3-b370-c418ecb04092",
                                                "text": "Au dire des deux frères, il y avait trop peu de temps que je ne grattais plus pour les manger, au long des chandelles, les « coulures » en forme de longues larmes."
                                            },
                                            {
                                                "example_id": "84bdb38c-c845-4632-a6cb-e5eb2222d05e",
                                                "sense_id": "6c72d58e-45db-37e3-b370-c418ecb04092",
                                                "text": "Une atmosphère de délaissement presque accablante se glissait dans ces couloirs vides où le salpêtre mettait de longues coulures."
                                            },
                                            {
                                                "example_id": "d92ba53a-6e29-408f-9e54-8748aa40aea9",
                                                "sense_id": "6c72d58e-45db-37e3-b370-c418ecb04092",
                                                "text": "Il faut aimer plonger les mains dans la mécanique, se prendre la tête avec les plans d’un moteur, bichonner une peinture pour éviter les vilaines coulures…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f55526a-8fe8-302b-b047-58a5e5a3d7dd",
                                        "entry_id": "d6534497-1707-3683-8cbf-29328b948546",
                                        "glosses": [
                                            "Ce qui s’écoule, en parlant du métal qui s’échappe par les interstices du moule et des grains de la grappe qui tombent quand le raisin commence à se nouer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d191850-b34d-31a2-9825-278e8a9a5474",
                                        "entry_id": "d6534497-1707-3683-8cbf-29328b948546",
                                        "glosses": [
                                            "Ce qu’on fait couler, enfoncer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e05667-68d0-4fa2-9e88-fe242a03a1a8",
                                                "sense_id": "7d191850-b34d-31a2-9825-278e8a9a5474",
                                                "text": "Les coulures d’un filet, Les cordes d’un filet munies de liège à l’extrémité supérieure et d’un caillou à l’extrémité inférieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697899ca-7343-3ffc-89c5-5e2e2efcae3f",
                                        "entry_id": "d6534497-1707-3683-8cbf-29328b948546",
                                        "glosses": [
                                            "Chute des fleurs ou des jeunes fruits à la suite de conditions climatiques qui altèrent le pollen et empêchent la fécondation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbd9d1d6-766c-4a37-a317-188baa189510",
                                                "sense_id": "697899ca-7343-3ffc-89c5-5e2e2efcae3f",
                                                "text": "Petits rendements à Palmer, […]. Comme partout, ce résultat est dû en partie à la « coulure », la mauvaise floraison par temps froid, et aussi à l'orage de grêle du 28 mai (juste avant la floraison) qui a frappé plusieurs parcelles : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
