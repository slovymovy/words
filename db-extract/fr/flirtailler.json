                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d310d71-52f3-49d5-910d-1143e82de60e",
                                "sense_id": "cbb2c176-2b95-3fe1-a999-1a9a3e0a689d",
                                "text": "Je l’avais surprise en train de flirtailler avec un échalas de treize ans, Antoine, qui n’avait pour lui que la situation sociale de son père, conseiller municipal."
                            },
                            {
                                "example_id": "beca12c0-662d-4c5f-9648-97369dd2df57",
                                "sense_id": "cbb2c176-2b95-3fe1-a999-1a9a3e0a689d",
                                "text": "Autant avec mes sœurs il bombe le torse, frétille, batifole, flirtaille, autant avec moi il s’éteint."
                            }
                        ]
                    }
