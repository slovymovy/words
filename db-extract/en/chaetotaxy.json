                        "glosses": [
                            "The arrangement of, and study of arrangement of, chaetae (chitinous bristles) on a species or subspecies of animal, usually and especially an arthropod or annelid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
