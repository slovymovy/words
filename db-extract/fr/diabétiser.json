                "senses": [
                    {
                        "sense_id": "23155822-b7cb-37a3-984c-4958a3b8b57a",
                        "entry_id": "6521d976-67c7-3d8f-998e-6b57eb2757f6",
                        "glosses": [
                            "Donner un caractère diabétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8b19e0-75af-4551-b14e-a65f9cc56ca6",
                                "sense_id": "23155822-b7cb-37a3-984c-4958a3b8b57a",
                                "text": "Depuis longtemps on sait que l’inanition peut diabétiser, de par elle- même, une courbe de tolérance au glucose."
                            },
                            {
                                "example_id": "6e62948e-1526-4afb-81d6-a3767cadb5d1",
                                "sense_id": "23155822-b7cb-37a3-984c-4958a3b8b57a",
                                "text": "Ce régime réduit en rl,C (60 g/24 h), loin de « diabétiser » les courbes, normalise complètement la courbe glycémique et améliore la courbe des A.G.L."
                            }
                        ]
                    },
                    {
                        "sense_id": "171f8735-e9d9-30c4-8b22-739f405f592b",
                        "entry_id": "6521d976-67c7-3d8f-998e-6b57eb2757f6",
                        "glosses": [
                            "Rendre diabétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8269fcbf-febc-41f5-903a-2564c24d3f86",
                                "sense_id": "171f8735-e9d9-30c4-8b22-739f405f592b",
                                "text": "Maintenant comment diabétiser toute la population?"
                            },
                            {
                                "example_id": "25e56d44-9d11-4462-a1bd-63bab46c7068",
                                "sense_id": "171f8735-e9d9-30c4-8b22-739f405f592b",
                                "text": "Tu veux nous diabétiser en une bouchée ?"
                            },
                            {
                                "example_id": "99d47ecb-20cb-419d-a8ff-c105547480be",
                                "sense_id": "171f8735-e9d9-30c4-8b22-739f405f592b",
                                "text": "Ne vous laissez pas diabétiser."
                            }
                        ]
                    }
