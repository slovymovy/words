                                ]
                            },
                            {
                                "target_word": "staggering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de34e01-d7d7-3cac-baba-c17399fc60a0",
                                        "entry_id": "0f2c0ba1-77fe-33bd-b4a9-fa4422cbe6c7",
                                        "glosses": [
                                            "Incredible, overwhelming, amazing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94faf63-9f8b-4a7e-ab5f-9799bc18648b",
                                                "sense_id": "3de34e01-d7d7-3cac-baba-c17399fc60a0",
                                                "text": "The army suffered a staggering defeat."
                                            },
                                            {
                                                "example_id": "6d74f85a-c466-4f43-b33c-9a7562557502",
                                                "sense_id": "3de34e01-d7d7-3cac-baba-c17399fc60a0",
                                                "text": "It is this stretch which provides what is perhaps the most staggering scenic prospect of all; the impression made on the mind by the overwhelming height of the Eiger, towering over the train, is almost impossible to describe."
                                            },
                                            {
                                                "example_id": "a06ce88c-965e-4702-932e-89929acd30fb",
                                                "sense_id": "3de34e01-d7d7-3cac-baba-c17399fc60a0",
                                                "text": "Binance may be the biggest crypto house exposed, but it is simply the latest in a long line of financial institutions whose lack of money laundering oversight — and willingness to look the other way — has drawn in staggering amounts of illicit wealth and attracted the world’s leading criminal rings and kleptocratic regimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e2e2ad5-5175-3ea8-b82e-a693c23bacea",
                                        "entry_id": "0f2c0ba1-77fe-33bd-b4a9-fa4422cbe6c7",
                                        "glosses": [
                                            "Lurching, floundering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "staggering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb88d9d9-3e48-33c1-98d2-3f6f483ea9a7",
                                        "entry_id": "aca3652e-0494-3dc3-bb0a-8ad843443068",
                                        "glosses": [
                                            "The motion of one who staggers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56affda-c64d-439a-90cc-6eb684e7dab1",
                                                "sense_id": "eb88d9d9-3e48-33c1-98d2-3f6f483ea9a7",
                                                "text": "There are to whom the gods, in their bounty, give glory: but far oftener it is given in wrath, as a curse and a poison; disturbing the whole inner health and industry of the man; leading onward through dizzy staggerings and tarantula jiggings […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "950c0483-9d19-37bf-a641-1298baaef947",
                                        "entry_id": "aca3652e-0494-3dc3-bb0a-8ad843443068",
                                        "glosses": [
                                            "The condition of being staggered or amazed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f7ab70-2f95-427e-9abf-e1c121396ad9",
                                                "sense_id": "950c0483-9d19-37bf-a641-1298baaef947",
                                                "text": "But these doubts, and fears, and staggerings, although they may be in the believer, yet they are not in his faith; these things argue the infirmity of his faith, indeed; but under all this, faith is fighting for the victory[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b643270-ac04-3b9f-8150-da0a398c93af",
                                        "entry_id": "aca3652e-0494-3dc3-bb0a-8ad843443068",
                                        "glosses": [
                                            "The spacing out of various actions over time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54a4923-bc75-46ef-b058-674dc122c02d",
                                                "sense_id": "0b643270-ac04-3b9f-8150-da0a398c93af",
                                                "text": "As a result of the recommendation of the Committee of Inquiry into London Transport, a Government-sponsored scheme for the staggering of working hours in London has been announced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083915bb-87a7-3706-8c9e-da4c4de6d0c9",
                                        "entry_id": "aca3652e-0494-3dc3-bb0a-8ad843443068",
                                        "glosses": [
                                            "In animation, the repetition of a sequence of frames to show struggling effort"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
