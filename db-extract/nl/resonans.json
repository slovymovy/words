                        "examples": [
                            {
                                "example_id": "0eabc344-9232-4517-9c98-01c10d70c96a",
                                "sense_id": "bf661c06-e4d5-3541-ad2f-cdc2fe36eed9",
                                "text": "Bovendien onthult de muziek van Hume wat de gamba tot zo’n aantrekkelijk instrument maakt: dat je er ronkende akkoorden op kunt strijken, én de bijbehorende melodielijn. En dat je er op kunt tokkelen als op een gitaar, maar dan met de diepere resonans van een groter instrument."
                            }
                        ]
