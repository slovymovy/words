                                                "example_id": "4a229f3b-65f7-4e86-93eb-f50d85e7c6ba",
                                                "sense_id": "a7bfdfbc-2674-3d42-896c-7215a5e5ad7f",
                                                "text": "„Halleluja, endlich Ferien!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f8530b9-2138-47b3-b25b-8279c2cb814e",
                        "source_entry_id": "46cd313b-1515-3f0a-9310-3117d4e26fbc",
                        "source_sense_id": "f41bf9d9-e822-3c29-a9f1-e9f49ab6f405",
                        "target_lang_word": "alleluja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alleluja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4a9ed97d-f8cc-315f-8a59-5e8be329c50e",
                                        "entry_id": "4df67f81-b70a-3b24-98e7-2938f406dde9",
                                        "glosses": [
                                            "w liturgii judaistycznej i chrześcijańskiej: okrzyk radości i triumfu zaczynający lub kończący psalmy i pieśni, szczególnie wielkanocne; wezwanie do złożenia hołdu Bogu; ; zob. też aleluja w Encyklopedii staropolskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f6a9a8-071c-43d1-a9e8-ccb3ce0fe87f",
                                                "sense_id": "4a9ed97d-f8cc-315f-8a59-5e8be329c50e",
                                                "text": "Pan króluje na wieki, Bóg twój, Syjonie – przez pokolenia. Alleluja."
                                            },
                                            {
                                                "example_id": "d9b0eef4-6a07-40ac-b4d7-e57c412084f2",
                                                "sense_id": "4a9ed97d-f8cc-315f-8a59-5e8be329c50e",
                                                "text": "Pan zmartwychwstał i jest z nami. Alleluja, alleluja! Głośmy razem z aniołami. Alleluja, alleluja!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f86f017b-481c-4267-883f-03506ecafac6",
                        "source_entry_id": "46cd313b-1515-3f0a-9310-3117d4e26fbc",
                        "source_sense_id": "f41bf9d9-e822-3c29-a9f1-e9f49ab6f405",
                        "target_lang_word": "alléluia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alléluia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69c8a53f-d33f-3b7a-880c-df253dd41514",
                                        "entry_id": "08fe17f0-dded-326c-b107-972ea9f34693",
                                        "glosses": [
                                            "Cri de joie qui termine certaines hymnes, particulièrement au temps de Pâques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be85a292-6663-439a-b6ea-3b0fd8e4d934",
                                                "sense_id": "69c8a53f-d33f-3b7a-880c-df253dd41514",
                                                "text": "Chanter l’alléluia, des alléluias."
                                            },
                                            {
                                                "example_id": "ef089a43-5a40-40e1-abbe-3d7d901c8502",
                                                "sense_id": "69c8a53f-d33f-3b7a-880c-df253dd41514",
                                                "text": "Au centre, Assomption de la Vierge, avec le Père éternel et un chœur d’anges ; le tout a l’effet triomphant d’un alléluia, d’une gloire à Dieu chantée par mille cœurs heureux à la fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8902e8-6151-3c2b-bc13-b32cbabb0837",
                                        "entry_id": "08fe17f0-dded-326c-b107-972ea9f34693",
                                        "glosses": [
                                            "Chant de la messe, qui précède la lecture de l'évangile."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cafc83e7-b6dc-3ebd-9282-39bf9b751de6",
                                        "entry_id": "08fe17f0-dded-326c-b107-972ea9f34693",
                                        "glosses": [
                                            "Petite plante qui fleurit vers le temps de Pâques, dont les feuilles ont un goût aigrelet et qui fournit le sel d’oseille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c3699b-ceda-4ff0-a17e-e2744ef6c810",
                                                "sense_id": "cafc83e7-b6dc-3ebd-9282-39bf9b751de6",
                                                "text": "L’alléluia, Oxalis alleluia, L., contient absolument les mêmes principes que l’oseille, et a, comme elle, un goût acide agréable."
                                            },
                                            {
                                                "example_id": "93830491-e74a-4e37-870a-ff93ae88bce0",
                                                "sense_id": "cafc83e7-b6dc-3ebd-9282-39bf9b751de6",
                                                "text": "L’oxalide petite oseille, oxalis acetosella, Lin., porte vulgairement les noms de surette, alléluia, etc. Elle croit assez communément dans les bois et les lieux couverts de presque toute la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2fbcdc4-5850-3bb4-b34d-57786c701aae",
                                        "entry_id": "08fe17f0-dded-326c-b107-972ea9f34693",
                                        "glosses": [
                                            "Pâtisserie sucrée aux fruits confits et recouverte de sucre glace dont le nom lui a été donné en l'honneur du pape Pie VII de passage dans la ville de Castelnaudary."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ac5046-6df3-4782-9043-d0091918b24a",
                                                "sense_id": "f2fbcdc4-5850-3bb4-b34d-57786c701aae",
                                                "text": "Autre célébrité de Castelnaudary : l’alleluia. Ce n'est pas une façon spéciale de manifester son allégresse, mais un gâteau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alléluia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15db44d7-082c-3436-9044-a9d14cac5244",
                                        "entry_id": "6ad2cd02-02dd-3a24-aeab-70e451913c3f",
                                        "glosses": [
                                            "Expression de joie, de très bonne humeur, de chance incroyable, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bccc2a47-adf6-48e4-aed5-e6d43d42588d",
                                                "sense_id": "15db44d7-082c-3436-9044-a9d14cac5244",
                                                "text": "Alléluia, j’ai réussi !"
                                            },
                                            {
                                                "example_id": "83abc627-8b07-4f48-9bea-ac7372cd95a7",
                                                "sense_id": "15db44d7-082c-3436-9044-a9d14cac5244",
                                                "text": "Et ils dirent une seconde fois : Alléluia ! Et sa fumée monte aux siècles des siècles."
                                            },
                                            {
                                                "example_id": "4586a9b0-e2be-46a3-9cb3-5c4eaf9f93d9",
                                                "sense_id": "15db44d7-082c-3436-9044-a9d14cac5244",
                                                "text": "L’espoir d’un vaccin pour 2021 se pointe à l’horizon. Alléluia !"
                                            },
                                            {
                                                "example_id": "9f003dad-b4c6-438b-863e-cfa720c39c14",
                                                "sense_id": "15db44d7-082c-3436-9044-a9d14cac5244",
                                                "text": "– Ça lui revient, alléluia !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
