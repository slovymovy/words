                        "form": "dem Achselzucken"
                    },
                    {
                        "form_id": "78735b9a-99ab-46f5-acc7-9c6d473d919a",
                        "entry_id": "c31bb2a6-cac6-367a-ba28-faf75d503ad3",
                        "tags": [
                            "accusative",
