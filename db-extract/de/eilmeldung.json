                "senses": [
                    {
                        "sense_id": "4cfd2eb5-a51e-3dac-a452-8470c331f80e",
                        "entry_id": "f917000b-5872-308e-af67-bda2e6d5f135",
                        "glosses": [
                            "aktuelle, wichtige Nachricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa95fcdf-bbed-463b-876a-95a0fa17d9d1",
                                "sense_id": "4cfd2eb5-a51e-3dac-a452-8470c331f80e",
                                "text": "„Es war 18.21 Uhr, als die Deutsche Presse-Agentur per Eilmeldung die politische Szene Nordrhein-Westfalens in Aufruhr versetze.“"
                            },
                            {
                                "example_id": "5616bfe8-b9a9-49d2-9b2b-c26a9c9f3612",
                                "sense_id": "4cfd2eb5-a51e-3dac-a452-8470c331f80e",
                                "text": "„Am 30. September waren die fetten Eilmeldungen über alle Agenturen gelaufen.“"
                            },
                            {
                                "example_id": "a8f63042-aa4c-4a5c-87b5-a9e1802da3b2",
                                "sense_id": "4cfd2eb5-a51e-3dac-a452-8470c331f80e",
                                "text": "„Wieder einmal rasten Eilmeldungen durch ganz Deutschland, in die großen Städte ebenso wie in die Provinz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
