                    {
                        "translation_id": "87abcc52-4a58-4662-9e59-54985b696cc6",
                        "source_entry_id": "d2706c72-d9a1-3194-9fa0-af44ae9310e7",
                        "source_sense_id": "d0ce6bd5-8753-3cfa-bf77-47daea72a59f",
                        "source_sense_description": "Hauptstadt und Regierungssitz von Bosnien und Herzegowina",
                        "target_lang_word": "Сараево",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Сараево",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c72221b6-b88c-3c0d-8d99-8031ebbfc917",
                                        "entry_id": "837ce18a-33b8-3ada-9630-9fe169991600",
                                        "glosses": [
                                            "город, столица Боснии и Герцеговины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f9f9809-93e9-45cb-964a-5f51570295bd",
                                                "sense_id": "c72221b6-b88c-3c0d-8d99-8031ebbfc917",
                                                "text": "Однако в Сараеве собирают подписи под протестом против этой депутации, которую никто не уполномочивал отправляться в Вену."
                                            },
                                            {
                                                "example_id": "cbfd79c9-5566-46ed-ad16-cd4049595899",
                                                "sense_id": "c72221b6-b88c-3c0d-8d99-8031ebbfc917",
                                                "text": "Австрийские войска отходят от черногорской границы к Сараеву."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2876a8b9-25e0-3d60-be8b-77ab8d6014ed",
                                        "entry_id": "837ce18a-33b8-3ada-9630-9fe169991600",
                                        "glosses": [
                                            "истор., разг. убийство в Сараеве [1] 28 июня 1914 года эрцгерцога Франца Фердинанда, совершённое сербским террористом, ставшее формальным поводом к началу Первой мировой войны; перен. также любое подобное действие, служащее поводом к вооружённому конфликту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8553f94b-d811-496a-9da9-7a45e67e9fba",
                                                "sense_id": "2876a8b9-25e0-3d60-be8b-77ab8d6014ed",
                                                "text": "«Хотят спровоцировать конфликт с Польшей. Хотят повторить Сараево…» Он же предложил объявить заложниками всех монархистов, находящихся в местах лишения свободы в СССР, и в конечном итоге разгромить все белогвардейские ячейки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
