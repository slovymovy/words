                    {
                        "translation_id": "6bf53524-81a9-4fa9-9d2d-dd83bb7987b8",
                        "source_entry_id": "f295995d-a272-34bc-9006-55e57a87b43c",
                        "source_sense_id": "2755f964-740c-3832-9a48-2f516a401118",
                        "source_sense_description": "raspberry-blackberry hybrid berry",
                        "target_lang_word": "Loganbeere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Loganbeere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                        "entry_id": "d0b07089-6352-35ad-88b6-c8162a08b69e",
                                        "glosses": [
                                            "brombeerähnlicher Strauch mit länglichen, roten und säuerlichen Früchten als Kreuzung von Himbeere und Brombeere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c6613b-edc5-408f-8f99-0fc3aa0cf668",
                                                "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                                "text": "„Boysenbeere ist eine erstmals dem kalifornischen Züchter Robert Boysen gelungene Rückkreuzung der Loganbeere mit der Brombeere und Himbeere.“"
                                            },
                                            {
                                                "example_id": "00f7beea-2882-4228-b957-423c7346c76a",
                                                "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                                "text": "„Dieser attraktive Wohnsitz war umgeben von einem weitläufigen und wunderbaren Garten mit Akazien, Lampenputzergras, Agapanthus, Rosen, Immergrün, massenhaft einjährigen Pflanzen, Loganbeeren, heimischem Wacholder, Zedern und Pinien.“"
                                            },
                                            {
                                                "example_id": "48c50f85-c4df-4d3b-97c7-d7a8814846a2",
                                                "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                                "text": "„Brombeeren und Hybridbeeren wie Loganbeeren und Taybeeren sind kräftige Kletterpflanzen, die am besten an stabilen Rankhilfen aus Pfosten und Drähten wachsen.“"
                                            },
                                            {
                                                "example_id": "ff510562-198a-429f-aeb1-c87ffc7919da",
                                                "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                                "text": "„Er fällte Buchen- und Eichenwälder, um Plantagen mit schwarzen Johannis- und Loganbeeren anzulegen.“"
                                            },
                                            {
                                                "example_id": "90a5e5bd-6bb5-4c1e-b1d4-750c7f9e9798",
                                                "sense_id": "5016accd-817c-3029-af2a-6acdd45f88e5",
                                                "text": "„Sie können Brombeeren und deren Hybriden wie Loganbeeren an Zäunen und Wänden ranken lassen, wo sie wenig Platz brauchen und trotzdem eine gute Ernte mit Früchten liefern, die Sie nicht im Laden finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f9fc3bd-a12d-3607-8351-364a10e9e632",
                                        "entry_id": "d0b07089-6352-35ad-88b6-c8162a08b69e",
                                        "glosses": [
                                            "Frucht von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301b3fd0-a124-4c78-b412-f989201df43f",
                                                "sense_id": "3f9fc3bd-a12d-3607-8351-364a10e9e632",
                                                "text": "„Die bis zu 4 cm langen Loganbeeren“ reifen von Juli bis August."
                                            },
                                            {
                                                "example_id": "13fd39c9-c3d3-4fe5-a301-af49778b04a4",
                                                "sense_id": "3f9fc3bd-a12d-3607-8351-364a10e9e632",
                                                "text": "„Ich staunte über die Vorräte in der Speisekammer: unzählige Gläser mit Rotkohl, Roter Beete, sauren Gurken, Marmelade und Loganbeeren, Brühwürfeln, Polo und Worcestersoße, Körbe mit Zwiebeln, Rüben und Kartoffeln, riesige Steingutkrüge mit Essig, […]“"
                                            },
                                            {
                                                "example_id": "181362e2-409c-4738-891d-1a25ea5d3895",
                                                "sense_id": "3f9fc3bd-a12d-3607-8351-364a10e9e632",
                                                "text": "„In der Küche verarbeiten Cat und Mrs. Bell überquellende Körbe voller Himbeeren und Loganbeeren zu Marmelade.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
