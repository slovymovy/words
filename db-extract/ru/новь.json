                ],
                "senses": [
                    {
                        "sense_id": "5bd8c597-f48c-31a0-a3c2-84fe7892cfbd",
                        "entry_id": "7c1f1bb6-e88f-3083-b5e4-dac025bd6392",
                        "glosses": [
                            "разг. что-либо новое, только что появившееся или возникшее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4baa35cd-d50b-4455-813b-614d758b981f",
                                "sense_id": "5bd8c597-f48c-31a0-a3c2-84fe7892cfbd",
                                "text": "Что встарь бывало хорошо, то в нови зачастую никуда не годится."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1302290-981c-38cf-bd56-25c7cb75b82d",
                        "entry_id": "7c1f1bb6-e88f-3083-b5e4-dac025bd6392",
                        "glosses": [
                            "разг. не паханная ещё земля, целина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b077513-3e8e-4efb-bef1-18f9874506bb",
                                "sense_id": "d1302290-981c-38cf-bd56-25c7cb75b82d",
                                "text": "Поднимать следует новь не поверхностно скользящей сохой, но глубоко забирающим плугом."
                            },
                            {
                                "example_id": "580cdef6-9732-42a5-b584-3ed3dc712989",
                                "sense_id": "d1302290-981c-38cf-bd56-25c7cb75b82d",
                                "text": "Ширить пашни ― значит, распахивать девственную землю, новь."
                            },
                            {
                                "example_id": "11bf5ea7-a5a4-428d-b594-f36fba7c09d6",
                                "sense_id": "d1302290-981c-38cf-bd56-25c7cb75b82d",
                                "text": "Всякое пространство ковылистой нови, никогда не паханной земли, иногда на несколько сот вёрст в окружности, а иногда небольшое, зовут там степью."
                            }
                        ]
                    }
                ],
