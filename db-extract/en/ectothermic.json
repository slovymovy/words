                                    {
                                        "sense_id": "e4f56209-ec28-34b5-9701-49e290172965",
                                        "entry_id": "d3ea6de5-b8c5-34db-9515-543c9d1a031d",
                                        "glosses": [
                                            "niet de eigen lichaamstemperatuur regulerend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddddbff7-8ef0-4bc8-9c6f-108f56612ccc",
                                                "sense_id": "e4f56209-ec28-34b5-9701-49e290172965",
                                                "text": "Koudbloedige dieren kunnen hun lichaamstemperatuur alleen beïnvloeden met hun gedrag, door bijvoorbeeld de schaduw of de volle zon op te zoeken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470bb8f7-47b7-32ce-b808-1ace266654db",
                                        "entry_id": "d3ea6de5-b8c5-34db-9515-543c9d1a031d",
                                        "glosses": [
                                            "zonder emotie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f91ad57c-f4e0-4e10-ac2f-118a82bff47c",
                                                "sense_id": "470bb8f7-47b7-32ce-b808-1ace266654db",
                                                "text": "Die chirurg is echt koudbloedig, hij voert zonder enige moeite de moeilijkste operaties uit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f940281-99a5-33ef-99ac-82e0b292cda3",
                                        "entry_id": "d3ea6de5-b8c5-34db-9515-543c9d1a031d",
                                        "glosses": [
                                            "erg gevoelig voor kou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a70af2-d367-4541-86ee-e7ef98b81900",
                                                "sense_id": "4f940281-99a5-33ef-99ac-82e0b292cda3",
                                                "text": "Die chirurg is echt koudbloedig, als hij 's winters naar buiten moet trekt hij het liefst twee jassen over elkaar aan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8bc5969-443d-4177-b02e-12dfef1d71f7",
                        "source_entry_id": "f2baeb79-eea2-3bdf-9428-3f46098e4ff0",
                        "source_sense_id": "24c19d01-e358-3b04-9bff-d8e3d29fefb6",
                        "source_sense_description": "of or relating to ectotherm; having an unregulated body temperature — see also endothermic",
                        "target_lang_word": "poïkilotherme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poïkilotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c075087-d817-3912-b027-65d2736b55c6",
                                        "entry_id": "f4cda766-c0ff-33e4-a6a9-f33761f6aa31",
                                        "glosses": [
                                            "Dont la température interne est dépendante de celle de l’environnement, qui ne contrôle pas sa température corporelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "117c684a-3bad-456f-919b-edfa0292c4ab",
                                                "sense_id": "9c075087-d817-3912-b027-65d2736b55c6",
                                                "text": "C’est ainsi que les organismes poïkilothermes, comme les reptiles et les poissons, présentent une longévité accrue s’ils vivent dans un milieu froid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poïkilotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d28d4cd6-5924-3b42-866f-d5fd27c94d63",
                                        "entry_id": "b99a7fb8-a247-31fa-a73f-cbb083c9b2ab",
                                        "glosses": [
                                            "Animal poïkilotherme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778911aa-b51b-458b-9627-7a48fb6a9740",
                                                "sense_id": "d28d4cd6-5924-3b42-866f-d5fd27c94d63",
                                                "text": "Au cours du refroidissement progressif de l’organisme homéotherme certaines fonctions physiologiques disparaissent les uns à la suite des autres, de sorte qu’à la température corporelle de 15° le rat se comporte à certains égards comme un poïkilotherme, sa fonction de thermorégulation étant complètement abolie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205e0178-58f3-4f73-bb21-e26e9c196923",
                        "source_entry_id": "f2baeb79-eea2-3bdf-9428-3f46098e4ff0",
                        "source_sense_id": "24c19d01-e358-3b04-9bff-d8e3d29fefb6",
                        "source_sense_description": "of or relating to ectotherm; having an unregulated body temperature — see also endothermic",
