                        "glosses": [
                            "Leserin (in der Regel ein Mädchen von circa 5 bis 8/9 Jahren), die ihre ersten Leseversuche unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e06fca0-b225-4f80-9b80-834f623cb3a4",
                                "sense_id": "33832989-26df-39b3-9330-a27304e107f8",
                                "text": "„Diese Kategorien sollen Erstleserinnen und -leser dabei unterstützen, das für sie passende Buch auszuwählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
