                },
                {
                    "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                    "sense_definition": "Strange and unusual in shape or appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strange_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tree had <w>fantastic</w> roots that twisted in every direction.",
                            "target_lang_translations": {
                                "ru": "У старого дерева были <w>причудливые</w> корни, извивающиеся во всех направлениях."
                            }
                        },
                        {
                            "text": "The cave was filled with <w>fantastic</w> rock formations that looked like frozen waves.",
                            "target_lang_translations": {
                                "ru": "Пещера была заполнена <w>фантастическими</w> скальными образованиями, похожими на застывшие волны."
                            }
