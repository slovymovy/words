                                                "sense_id": "03fb7f15-3b31-3cff-bd91-5536be5abf5e",
                                                "text": "„Die Insekten sehen zwar dick und pummelig aus, haben aber durchaus das Zeug, den Mount Everest zu überfliegen.“"
                                            },
                                            {
                                                "example_id": "7dd22c57-f68a-4169-9b19-e09af98a1b42",
                                                "sense_id": "03fb7f15-3b31-3cff-bd91-5536be5abf5e",
                                                "text": "Igors Frau ist mit den Jahren ganz schön pummelig geworden."
                                            },
                                            {
                                                "example_id": "4b0e11b8-0688-4336-82b9-984c47453149",
                                                "sense_id": "03fb7f15-3b31-3cff-bd91-5536be5abf5e",
                                                "text": "In der Klasse meines Neffen gibt es einige sehr pummelige Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
