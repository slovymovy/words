                        "glosses": [
                            "Commune française, située dans le département des Ardennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8011e088-c588-4609-b3b1-8669866152a2",
                                "sense_id": "fcd26a22-d14d-3b74-aae7-175019f78789",
                                "text": "Les derniers renseignements reçus le 31 août avaient fait connaître que la colonne signalée à Château-Porcien s'était avancée dans la soirée jusqu'à Avançon et avait placé de l'artillerie lourde vers le Signal de l'Ermite."
                            },
                            {
                                "example_id": "ef78c886-58ea-4ced-b828-77d56a0d1931",
                                "sense_id": "fcd26a22-d14d-3b74-aae7-175019f78789",
                                "text": "Après s’être inclinés devant les sépultures des Camarades tombés à Avançon, Taizy et Nanteuil, les assistants se rendirent à Rethel où un déjeuner avait été prévu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74a6a34-47e7-39e4-90f7-a0e0810f3f18",
                        "entry_id": "e0ac376e-0a59-3eb6-becc-9f2ee4a5f892",
                        "glosses": [
                            "Rivière suisse, affluent de la rive droite du Rhône (ou Avençon)."
                        ],
                        "tags": [],
                        "examples": []
                    }
