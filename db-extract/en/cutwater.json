            {
                "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                "word": "cutwater",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f6c2dfa7-3281-46a0-9967-9d93675d32e1",
                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                        "tags": [
                            "plural"
                        ],
                        "form": "cutwaters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ab0b876-7991-35a1-8ce3-336162014532",
                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                        "glosses": [
                            "The forward curve of the stem of a ship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3eda48-9800-482d-92df-3c6cf1fce806",
                                "sense_id": "9ab0b876-7991-35a1-8ce3-336162014532",
                                "text": "For two hours we laboured, Mahomed, Job, and I, who was supposed to be strong enough to pull against the two of them, on the bank, while Leo sat in the bow of the boat, and brushed away the weeds which collected round the cutwater with Mahomed's sword."
                            }
                        ]
                    },
                    {
                        "sense_id": "35d6242a-d242-3e86-ac01-fe29190b2593",
                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                        "glosses": [
                            "The wedge of a bridge pier, that resists the flow of water and ice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd60e82-2a5d-48b6-a15d-49a975928b24",
                                "sense_id": "35d6242a-d242-3e86-ac01-fe29190b2593",
                                "text": "TARKA became one with the river, finding his course among the slimy stones so that his back was always covered. He rose beside the middle pier, whose cutwater was hidden by a faggot of flood sticks. Under the sticks was dimness, streaked and blurred with sunlight. Tarka hid and listened."
                            }
                        ]
                    },
                    {
                        "sense_id": "9307fa0f-891d-3b68-808c-00c47328b346",
                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                        "glosses": [
                            "A black skimmer; a sea bird of the species Rynchops niger, that flies low over the sea, \\\"cutting\\\" the water surface with its lower mandible to catch small fish."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "443edb50-8600-49f0-9bc5-a0719764053e",
                        "source_entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                        "source_sense_description": "edge of a ship's stem",
                        "target_lang_word": "taille-mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taille-mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "292bee2c-940a-3219-a1ec-488baf0faa02",
                                        "entry_id": "2f0d4b8e-4314-3db5-a69d-1e4c51064519",
                                        "glosses": [
                                            "Partie terminale de l’étrave d’un bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89e8d38-24a8-46cf-83f7-5c7adfc7600f",
                                                "sense_id": "292bee2c-940a-3219-a1ec-488baf0faa02",
                                                "text": "Plusieurs de ces barques, comme les anciennes galères grecques, ont à la proue, de chaque côté du taille-mer, deux grands yeux peints de couleurs naturelles, qui paraissent veiller à la marche et donnent à cette partie de l’embarcation une vague apparence de profil humain."
                                            },
                                            {
                                                "example_id": "c8f0ba80-1bea-41e4-98ea-3e00783c5fdd",
                                                "sense_id": "292bee2c-940a-3219-a1ec-488baf0faa02",
                                                "text": "Le taille-mer, long, courbe et aigu sous le beaupré, sortait de l’avant comme une corne de croissant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
