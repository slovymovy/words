                        "target_lang_word": "Philippe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philippe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                        "entry_id": "25426c5c-925e-3ab3-a876-2abb73d92261",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67edc27-b7b3-404b-a7b9-0770162da56e",
                                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                                "text": "Baptiste Coulmont se souvient ainsi d’un Johnny devenu Philippe. Il vomissait ce prénom, trop connoté \"Idole des jeunes\"."
                                            },
                                            {
                                                "example_id": "a21d48a1-5605-49c3-8ede-ba7efbcfc57b",
                                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                                "text": "Dans son ouvrage, Philippe Gasparini retrace le chemin tortueux de ce concept dont même l’initiateur du côté francophone, Serge Doubrovsky, a modifié la définition."
                                            },
                                            {
                                                "example_id": "a271501d-a631-48e6-8119-c79fb69cf73e",
                                                "sense_id": "cc066b88-1f72-3d15-8bec-90cb6b5da1d6",
                                                "text": "C’est une deuxième défaite d’affilée pour les hommes de Peter Bosz, qui stagnent à la 5ᵉ place du classement de Ligue I, et voient revenir ceux de Philippe Clément à seulement deux petits points, à la 7ᵉ place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Philippe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acb94f93-ed58-39a8-96db-4abd909ed24c",
                                        "entry_id": "45ee2105-3dcc-3bca-b653-50d9485c4394",
                                        "glosses": [
                                            "Prénom féminin jusqu’au début du XVIIᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Philippe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "389c1b88-5b0a-34dd-b5f2-bd86feb556e7",
                                        "entry_id": "d2919b60-5bec-3691-aedb-f2f6b0ddb6ce",
                                        "glosses": [
                                            "Patronyme français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "267b1c84-9c43-428d-94e3-5f09bb86171a",
                                                "sense_id": "389c1b88-5b0a-34dd-b5f2-bd86feb556e7",
                                                "text": "M. Philippe a expliqué être « en train de constituer un gouvernement, un gouvernement rassembleur de compétences », qu’il proposera à Emmanuel Macron."
                                            },
                                            {
                                                "example_id": "ef67763b-1f00-41a8-9807-bba928d70c21",
                                                "sense_id": "389c1b88-5b0a-34dd-b5f2-bd86feb556e7",
                                                "text": "Pour éviter un possible accident, le maire Georges Philippe, après avoir sécurisé les lieux, a appelé un agriculteur du bourg pour venir dégager le carrefour et déposer le round ball dans la cour de la mairie, où l’heureux propriétaire est invité à venir le récupérer, après s’être fait connaître à l'accueil."
                                            },
                                            {
                                                "example_id": "581b7bba-d409-4378-92af-09d641f1bade",
                                                "sense_id": "389c1b88-5b0a-34dd-b5f2-bd86feb556e7",
                                                "text": "Puis avec Thomas Philippe il coskippe 33 Export, plan Briand whitbread 81-82 qui sera ensuite skippé par Lionel Péan sous le nom d’Esprit d’Equipe en 1985-86."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
