                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879b6f85-9ed3-4f99-b5e1-55fc311fdd63",
                                "sense_id": "103631b3-6052-3b3c-be48-d1dfb7733611",
                                "text": "nos langues s’enfargent dans les pans du vent"
                            },
                            {
                                "example_id": "357cf922-ba0c-42ec-8dd3-443ef89ce134",
                                "sense_id": "103631b3-6052-3b3c-be48-d1dfb7733611",
                                "text": "Tout ça pour dire que le gouvernement Trudeau a les bras longs, si longs qu’il ne peut faire autrement que de s’enfarger dedans de temps en temps."
                            },
                            {
                                "example_id": "4be3873d-10d4-43a4-ab66-20dd3ada39b9",
                                "sense_id": "103631b3-6052-3b3c-be48-d1dfb7733611",
                                "text": "Pendant ce temps, les partis d’opposition se sont enfargés dans leurs lacets de bottines sur cette question devenue le point de mire de la semaine."
                            },
                            {
                                "example_id": "c3cb7825-2e4f-428c-ae7d-9883e3236124",
                                "sense_id": "103631b3-6052-3b3c-be48-d1dfb7733611",
                                "text": "Les deux personnages s’enfargent, hésitent, se cherchent."
                            }
                        ]
                    }
