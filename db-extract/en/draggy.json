                "senses": [
                    {
                        "sense_id": "21cc771a-955b-3ba4-a311-e52db2e7543c",
                        "entry_id": "3bf05fdb-06f0-393d-841a-60bb2fc2532d",
                        "glosses": [
                            "Moving or developing very slowly; tending to drag on; dull."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d6a0c52a-714d-4db8-8c30-910c3e8d8089",
                                "sense_id": "21cc771a-955b-3ba4-a311-e52db2e7543c",
                                "text": "About two years ago I had been feeling tired and draggy for about six months. I went to find out what was going on. They told me I had Epstein-Barr."
                            },
                            {
                                "example_id": "8d574f23-dd4c-4128-a3f9-ba647d18ee56",
                                "sense_id": "21cc771a-955b-3ba4-a311-e52db2e7543c",
                                "text": "It seemed to Chip that Julia was leaving him because \"The Academy Purple\" had too many breast references and a draggy opening, […]"
                            },
                            {
                                "example_id": "5a4e59af-f1b5-4e5f-8045-54b63cb5a453",
                                "sense_id": "21cc771a-955b-3ba4-a311-e52db2e7543c",
                                "text": "The Who start off ramshackle, draggy even. They pick up while on a run of Tommy songs; by Amazing Journey they sound much more like the fizzing fathers of freak-beat."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ad7afed-28fe-3df5-9c40-da38aaf818e7",
                        "entry_id": "3bf05fdb-06f0-393d-841a-60bb2fc2532d",
                        "glosses": [
                            "Typified by, or characteristic of, drag (women's clothing worn by men for the purpose of entertainment)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ab8f42-7752-4398-9c65-ce9e494054f0",
                                "sense_id": "3ad7afed-28fe-3df5-9c40-da38aaf818e7",
                                "text": "The performer strode onto the stage wearing a glittery, draggy outfit."
                            }
                        ]
                    }
                ],
