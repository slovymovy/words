                    {
                        "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                        "entry_id": "eed6b72a-11ed-32a9-a242-91b5a57dbfa0",
                        "glosses": [
                            "eternity"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "7184ffd7-9922-4eed-954e-9e9b3d3a8115",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "De sterrenhemel herinnert ons aan de oneindige schoonheid van de eeuwigheid.",
                                "translation": "The starry sky reminds us of the infinite beauty of eternity.",
                                "english": "The starry sky reminds us of the infinite beauty of eternity."
                            },
                            {
                                "example_id": "395da23b-7181-428d-b0bd-b79f0481683f",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "In sommige religieuze overtuigingen gaat de ziel na de dood over in de eeuwigheid.",
                                "translation": "In some religious beliefs, the soul transcends into eternity after death.",
                                "english": "In some religious beliefs, the soul transcends into eternity after death."
                            },
                            {
                                "example_id": "88d71791-25b8-461b-a350-99da0612a7fc",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "Liefde kan een gevoel van eeuwigheid creëren, alsof de tijd stilstaat.",
                                "translation": "Love can create a sense of eternity, as if time stands still.",
                                "english": "Love can create a sense of eternity, as if time stands still."
                            },
                            {
                                "example_id": "cff66ced-a5b9-460d-ad5f-5b9da397be5f",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "De dichter schreef over de ongrijpbare aard van de eeuwigheid.",
                                "translation": "The poet wrote about the elusive nature of eternity.",
                                "english": "The poet wrote about the elusive nature of eternity."
                            },
                            {
                                "example_id": "2a7b20b7-7d0e-48a7-8922-019ee8ed8873",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "Het schilderij vangt de emoties en gevoelens van de kunstenaar voor de eeuwigheid.",
                                "translation": "The painting captures the artist's emotions and feelings for eternity.",
                                "english": "The painting captures the artist's emotions and feelings for eternity."
                            },
                            {
                                "example_id": "58c3c66a-d9bf-4895-a276-aee5e94a2b62",
                                "sense_id": "02da93d3-cf69-35e0-8742-43962a14e45a",
                                "text": "Voor sommigen is het concept van de eeuwigheid moeilijk te bevatten.",
                                "translation": "For some, the concept of eternity is hard to grasp.",
                                "english": "For some, the concept of eternity is hard to grasp."
                            }
                        ]
                    }
                ],
