                        "glosses": [
                            "eine Rede oder Ansprache in der zu Feindseligkeit, Gewalt und Hass aufgerufen beziehungsweise aufgehetzt wird (häufig mit religiösem Bezug)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bcf4d29-7b79-489a-9906-e666e9588cce",
                                "sense_id": "e9c8ca66-0cfa-3e0c-86d5-1e27515512bb",
                                "text": "“Die Hasspredigt landete auf YouTube und löste einen landesweiten Skandal aus.”"
                            },
                            {
                                "example_id": "b5284931-8244-493b-8815-2ed3e3bfe6eb",
                                "sense_id": "e9c8ca66-0cfa-3e0c-86d5-1e27515512bb",
                                "text": "„Diese Kriegspropaganda ging unvermindert weiter, auch als der Krieg schon vorbei war und eigentlich keine Notwendigkeit mehr bestand, die Hasspredigten über den Feind fortzuführen.“"
                            },
                            {
                                "example_id": "4904b84a-fcab-433f-9063-40edd4f1d306",
                                "sense_id": "e9c8ca66-0cfa-3e0c-86d5-1e27515512bb",
                                "text": "„Zusätzlich wurden die Nachrichtendienste damit beauftragt, die Moscheen zu kontrollieren, um Hasspredigten gegen religiöse Minderheiten zu unterbinden.“"
                            }
                        ],
