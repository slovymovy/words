                "senses": [
                    {
                        "sense_id": "22cf80a0-cd48-379e-b38c-549dcd3ebae3",
                        "entry_id": "d06d69c7-0b6f-367a-9506-1640ebd36b18",
                        "glosses": [
                            "Untersuchung (Test), die feststellt, ob eine Ansteckung mit SARS-CoV-2 (Coronavirus) vorliegt/vorlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d4575fd-9695-4884-a7c6-8ac2dd1fbd8d",
                                "sense_id": "22cf80a0-cd48-379e-b38c-549dcd3ebae3",
                                "text": "„Viele Menschen werden in Deutschland täglich auf das Coronavirus getestet – aber wie funktioniert der Corona-Test eigentlich und wie verlässlich ist das Testergebnis wirklich?“"
                            },
                            {
                                "example_id": "b1580275-e1fc-4f7e-bff1-0f5c4337a1f3",
                                "sense_id": "22cf80a0-cd48-379e-b38c-549dcd3ebae3",
                                "text": "„Wie läuft so ein Corona-Test genau ab und wo kann ich ihn machen lassen?“"
                            },
                            {
                                "example_id": "afe4a442-3fe2-4120-ac0d-e53c9aac0a03",
                                "sense_id": "22cf80a0-cd48-379e-b38c-549dcd3ebae3",
                                "text": "„Brandenburg startet freiwillige Corona-Tests in Schulen und Kitas.“"
                            },
                            {
                                "example_id": "7d3cac4b-658c-4f61-afe5-6e1a7fc61b07",
                                "sense_id": "22cf80a0-cd48-379e-b38c-549dcd3ebae3",
                                "text": "„In einem Interview mit Rai Radio 1 kündigt Landeshauptmann Arno Kompatscher kostenlose Corona-Teste für Südtirol-Urlauber an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
