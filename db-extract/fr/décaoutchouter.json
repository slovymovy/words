                "senses": [
                    {
                        "sense_id": "e2641319-4bd7-3c52-8937-4a519876d999",
                        "entry_id": "5f1f0b70-8513-39f9-a0a4-bb5ad40cd6a0",
                        "glosses": [
                            "Débarrasser de son caoutchouc ou de son caractère caoutchouteux."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e8472273-24c1-4eeb-a18b-ade6cc47841f",
                                "sense_id": "e2641319-4bd7-3c52-8937-4a519876d999",
                                "text": "Manet des riches ou Duhamel des pauvres, je me simulais décaoutchouter tout mon être et m'attirer sur un cratère de moins en moins vinylique jusqu'à mon induction primordiale en robot initiatique primordial."
                            },
                            {
                                "example_id": "259a8620-35ac-47a2-b5c5-386dc874be61",
                                "sense_id": "e2641319-4bd7-3c52-8937-4a519876d999",
                                "text": "Je poussai un long soupir avant de me décaoutchouter de mon siège et chercher à tâtons l’interrupteur de ma petite veilleuse en forme d’œuf d’autruche posée sur ma tête de lit, et l’allumai dans un clic."
                            },
                            {
                                "example_id": "114f8f43-1cd0-4655-9395-a3ab82ab351c",
                                "sense_id": "e2641319-4bd7-3c52-8937-4a519876d999",
                                "text": "A peine décaoutchouté, Mouch prend la mouche et grommelle : « A mon avis ça sert à rien d’ la soigner, on f’rait mieux d’ l’ arrâcher ! »"
                            }
                        ]
                    }
                ],
