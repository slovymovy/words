                        "sense_id": "04215773-441d-3abb-8e34-16b015e11701",
                        "entry_id": "aeb626d1-11ee-3ec3-bcba-56d8f22ef310",
                        "glosses": [
                            "soort van aan de muur bevestigde kom of bak voor het met behulp van water reinigen van de geslachtsdelen, billen en anus na gebruik van het toilet, of om de voeten te wassen"
                        ],
                        "tags": [
                            "huishouden",
                            "sanitair"
                        ],
                        "examples": [
                            {
                                "example_id": "45c3b135-577d-4a78-bcc5-e41ae939e1eb",
                                "sense_id": "04215773-441d-3abb-8e34-16b015e11701",
                                "text": "De luxe badkamer heeft twee wastafels, een ligbad, toilet en een bidet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ca4aeaa-0a6d-4f57-9b9e-aedb1178c5e9",
                        "source_entry_id": "aeb626d1-11ee-3ec3-bcba-56d8f22ef310",
                        "source_sense_id": "04215773-441d-3abb-8e34-16b015e11701",
                        "source_sense_description": "soort van aan de muur bevestigde kom of bak voor het met behulp van water reinigen van de geslachtsdelen, billen en anus na gebruik van het toilet, of om de voeten te wassen",
                        "target_lang_word": "Bidet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bidet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                        "entry_id": "ee7eb678-04b2-3671-9685-f573178579ab",
                                        "glosses": [
                                            "Sitzwaschbecken zur Reinigung der Geschlechtsorgane und des Afters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd57e899-f3b7-4f65-9f62-c6e20bbed674",
                                                "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                                "text": "Das Bidet ist ein niedrig angebrachtes Waschbecken, auf das man sich zwecks Reinigung setzen kann."
                                            },
                                            {
                                                "example_id": "3fe28e83-4b57-43bc-adf5-34fe926d9b3d",
                                                "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                                "text": "In seinen Badezimmern nämlich gibt es Bidets, und das Frühstück kommt à la carte aus der Küche des Gourmet-Restaurants."
                                            },
                                            {
                                                "example_id": "2c9603e3-e66c-4737-9783-d091cebc01f9",
                                                "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                                "text": "Auf einem Betonplateau züchtet er in defekten Toilettenbecken und Bidets Kakteen."
                                            },
                                            {
                                                "example_id": "e480539b-0117-40f0-8f08-ae7afe0f2b3c",
                                                "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                                "text": "Araber und Südostasiaten benutzen die linke Hand und viel Wasser. Und in den meisten südeuropäischen Ländern steht neben der Toilette ein Bidet."
                                            },
                                            {
                                                "example_id": "69410fec-ce36-493f-b32b-7261bda6f249",
                                                "sense_id": "3d477d7a-0526-3eab-9a13-8c9da1dba76e",
                                                "text": "„›Diese unmäßig hohen Spiegel! Diese - Gerätschaften!‹ Ihr beleidigter Blick streifte ein Bidet. ›Und dieser Toilettentisch! Es ist eine Impertinenz, einer anständigen Frau ein derart ausgestattetes Zimmer anzuweisen!‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3211ccc-65c5-4537-9767-382da3bc3f07",
                        "source_entry_id": "aeb626d1-11ee-3ec3-bcba-56d8f22ef310",
