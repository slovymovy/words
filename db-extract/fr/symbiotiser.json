                ],
                "senses": [
                    {
                        "sense_id": "0779c71b-2fd5-35f5-a9b7-658729dda08b",
                        "entry_id": "a7b08341-7348-3f1e-b982-945e79a0130f",
                        "glosses": [
                            "Donner un caractère symbiotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904e662b-cf87-4ed4-90fc-58d5b91dea02",
                                "sense_id": "0779c71b-2fd5-35f5-a9b7-658729dda08b",
                                "text": "Le désir peut être de type symbiotique ; recherche d’intimité, de symbiotiser ou d’être symbiotisé."
                            },
                            {
                                "example_id": "cc9bed32-14b0-4153-8816-8b0888f5c067",
                                "sense_id": "0779c71b-2fd5-35f5-a9b7-658729dda08b",
                                "text": "Il tend à se « symbiotiser » avec un autre afin de pouvoir se servir des ressources du Moi de ce dernier, comme si elles lui appartenaient et il lui est indispensable que l’autre devine et reconnaisse ses besoins en tant que sujet pour qu’il puisse être correctement assisté, tout en évitant, si possible, les expériences traumatiques."
                            }
                        ]
                    }
                ],
