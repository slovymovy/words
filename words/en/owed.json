            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae96388b-92c9-3997-8fdb-0b3729ac55ca",
                    "sense_definition": "Simple past and past participle of <w>owe</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>owed</w> him a favor after he helped her move.",
                            "target_lang_translations": {
                                "ru": "Она <w>была должна</w> ему услугу после того, как он помог ей с переездом.",
                                "fr": "Elle lui <w>devait</w> une faveur après qu'il l'a aidée à déménager."
                            }
                        },
                        {
                            "text": "They <w>owed</w> money to the bank for several years.",
                            "target_lang_translations": {
                                "ru": "Они <w>были должны</w> деньги банку в течение нескольких лет.",
                                "fr": "Ils <w>devaient</w> de l'argent à la banque pendant plusieurs années."
                            }
                        }
                    ],
                    "common_phrases": [
                        "owed money",
                        "owed a favor",
                        "owed an apology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола owe (быть должным).",
                        "fr": "Forme passée et participe passé du verbe devoir (être redevable)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "был должен",
                                "target_lang_sense_clarification": "о состоянии долга или обязанности"
                            },
                            {
                                "target_lang_word": "задолжал",
                                "target_lang_sense_clarification": "о факте наличия долга"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "devait",
                                "target_lang_sense_clarification": "imparfait, exprimant une dette ou une obligation passée"
                            },
                            {
                                "target_lang_word": "a dû",
                                "target_lang_sense_clarification": "passé composé, exprimant une dette ponctuelle ou un fait accompli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5b50945-a949-38c4-b1eb-c5e8cf360f9c",
                    "sense_definition": "Required to be paid or given back.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pay the <w>owed</w> amount by the end of the month.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выплатите <w>причитающуюся</w> сумму до конца месяца.",
                                "fr": "Veuillez payer le montant <w>dû</w> avant la fin du mois."
                            }
                        },
                        {
                            "text": "The total debt <w>owed</w> was much higher than expected.",
                            "target_lang_translations": {
                                "ru": "Общая сумма <w>причитающегося</w> долга была намного выше, чем ожидалось.",
                                "fr": "La dette totale <w>due</w> était bien plus élevée que prévu."
                            }
                        }
