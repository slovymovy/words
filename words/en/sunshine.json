{
    "word_family": [
        "sun",
        "sunny",
        "sunbathe",
        "sunlight",
        "sunrise",
        "sunset",
        "sunflower",
        "sunbeam"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "145ded1b-31d7-3501-9ce7-92ab096c937f",
                    "sense_definition": "The direct rays, light, or warmth coming from the sun.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the garden and enjoyed the warm <w>sunshine</w>.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в саду и наслаждались теплым <w>солнцем</w>.",
                                "zh": "我们坐在花园里，享受着温暖的<w>阳光</w>。"
                            }
                        },
                        {
                            "text": "The bright <w>sunshine</w> woke me up early this morning.",
                            "target_lang_translations": {
                                "ru": "Яркий <w>солнечный свет</w> разбудил меня сегодня рано утром.",
                                "zh": "今天清晨，明亮的<w>日光</w>把我唤醒了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunlight",
                        "sun"
                    ],
                    "antonyms": [
                        "darkness",
                        "shade"
                    ],
                    "common_phrases": [
                        "bright sunshine",
                        "warm sunshine",
                        "in the sunshine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямые лучи, свет или тепло, исходящие от солнца.",
                        "zh": "来自太阳的直接光线、光亮或热量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнечный свет",
                                "target_lang_sense_clarification": "излучение"
                            },
                            {
                                "target_lang_word": "со́лнце",
                                "target_lang_sense_clarification": "свет и тепло"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳光",
                                "target_lang_sense_clarification": "太阳的光线"
                            },
                            {
                                "target_lang_word": "日光",
                                "target_lang_sense_clarification": "太阳的光亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c0ab1cc-1ffe-31e9-95d1-0fc4e823e2d9",
                    "sense_definition": "A specific area or place where the sun's light is falling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's move our chairs out of the shade and into the <w>sunshine</w>.",
                            "target_lang_translations": {
                                "ru": "Давай переставим стулья из тени на <w>солнце</w>.",
                                "zh": "我们把椅子从阴凉处搬到<w>向阳处</w>吧。"
                            }
                        },
                        {
                            "text": "The cat found a patch of <w>sunshine</w> on the floor and fell asleep.",
                            "target_lang_translations": {
                                "ru": "Кошка нашла пятно <w>солнечного света</w> на полу и уснула.",
                                "zh": "猫在地上找到了一块<w>阳光</w>照射的地方，然后睡着了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "shade",
                        "shadow"
                    ],
                    "common_phrases": [
                        "into the sunshine",
                        "out of the sunshine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещенное солнцем место или пространство.",
                        "zh": "阳光照射到的特定区域或空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнце",
                                "target_lang_sense_clarification": "освещенное место"
                            },
                            {
                                "target_lang_word": "со́лнечная сторона",
                                "target_lang_sense_clarification": "место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "向阳处",
                                "target_lang_sense_clarification": "有阳光的地方"
                            },
                            {
                                "target_lang_word": "阳光下",
                                "target_lang_sense_clarification": "处于阳光照射的空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3982fb17-9d92-3229-b18c-d072862336c5",
                    "sense_definition": "A feeling of cheerfulness, happiness, or a person who brings joy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_joy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brings a little bit of <w>sunshine</w> into the office every day.",
                            "target_lang_translations": {
                                "ru": "Она каждый день приносит немного <w>радости</w> в офис.",
                                "zh": "她每天都给办公室带来一丝<w>欢乐</w>。"
                            }
                        },
                        {
                            "text": "You are the <w>sunshine</w> of my life.",
                            "target_lang_translations": {
                                "ru": "Ты — <w>солнце</w> моей жизни.",
                                "zh": "你是我生命中的<w>小太阳</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "gloom",
                        "misery"
                    ],
                    "common_phrases": [
                        "ray of sunshine",
                        "bring sunshine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство жизнерадостности, счастья или человек, приносящий радость.",
                        "zh": "一种愉悦、快乐的感觉，或指代带来欢乐的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнышко",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "ра́дость",
                                "target_lang_sense_clarification": "чувство"
                            },
                            {
                                "target_lang_word": "свет",
                                "target_lang_sense_clarification": "метафорически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小太阳",
                                "target_lang_sense_clarification": "比喻给人带来温暖和快乐的人"
                            },
                            {
                                "target_lang_word": "欢乐",
                                "target_lang_sense_clarification": "指代快乐的源泉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ccafade-7f65-335d-8118-b32e045d9903",
                    "sense_definition": "A form of address used affectionately, ironically, or to someone who has just woken up.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good morning, <w>sunshine</w>! Did you sleep well?",
                            "target_lang_translations": {
                                "ru": "Доброе утро, <w>солнышко</w>! Ты хорошо спал?",
                                "zh": "早安，<w>小宝贝</w>！你睡得好吗？"
                            }
                        },
                        {
                            "text": "Listen to me, <w>sunshine</w>, you need to be more careful next time.",
                            "target_lang_translations": {
                                "ru": "Послушай меня, <w>солнышко</w>, в следующий раз тебе нужно быть осторожнее.",
                                "zh": "听着，<w>小宝贝</w>，下次你得更小心点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "good morning sunshine",
                        "hello sunshine"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used ironically or affectionately"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое или ироничное обращение к кому-либо.",
                        "zh": "一种亲昵、戏谑或用于称呼刚睡醒之人的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́лнышко",
                                "target_lang_sense_clarification": "обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小宝贝",
                                "target_lang_sense_clarification": "亲昵的称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fed8052e-e61c-3a1f-acc0-332330a454ec",
                    "sense_definition": "Relating to laws or policies that require public access to government proceedings and documents.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new <w>sunshine</w> law ensures that all committee meetings are open to the public.",
                            "target_lang_translations": {
                                "ru": "Новый закон о <w>гласности</w> гарантирует, что все заседания комитета открыты для общественности.",
                                "zh": "新的<w>公开</w>法确保了所有委员会会议都对公众开放。"
                            }
                        },
                        {
                            "text": "Journalists used the <w>sunshine</w> policy to get information about the decision.",
                            "target_lang_translations": {
                                "ru": "Журналисты использовали политику <w>открытости</w>, чтобы получить информацию о решении.",
                                "zh": "记者们利用这项<w>透明</w>政策获取了关于该决定的信息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sunshine law",
                        "sunshine policy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к законам или политике, требующим открытого доступа общественности к правительственным заседаниям и документам.",
                        "zh": "指要求政府会议和文件对公众公开的法律或政策。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гла́сность",
                                "target_lang_sense_clarification": "политическая"
                            },
                            {
                                "target_lang_word": "откры́тость",
                                "target_lang_sense_clarification": "прозрачность действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公开",
                                "target_lang_sense_clarification": "指政策的透明度"
                            },
                            {
                                "target_lang_word": "透明",
                                "target_lang_sense_clarification": "指行政程序的公开化"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1ba70d29-fd1f-34e9-8fbb-1b05239a2a19",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I have an appointment with Mr. <w>Sunshine</w> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У меня встреча с мистером <w>Саншайном</w> в три часа.",
                                "zh": "我三点钟和<w>桑沙恩</w>先生有个预约。"
                            }
                        },
                        {
                            "text": "The famous architect, Sarah <w>Sunshine</w>, designed this building.",
                            "target_lang_translations": {
                                "ru": "Знаменитый архитектор Сара <w>Саншайн</w> спроектировала это здание.",
                                "zh": "这座建筑是由著名建筑师萨拉·<w>桑沙恩</w>设计的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Са́ншайн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桑沙恩",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}