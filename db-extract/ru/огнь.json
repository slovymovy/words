                "senses": [
                    {
                        "sense_id": "5149af74-d79c-3446-9c0c-60fa21a0fd85",
                        "entry_id": "38f8a225-55e9-3334-bd08-09b6ff048d29",
                        "glosses": [
                            "устар., поэт. то же, что огонь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76ec3f9-dd48-44de-80e5-cc09383e858a",
                                "sense_id": "5149af74-d79c-3446-9c0c-60fa21a0fd85",
                                "text": "С бледными лицами взирали они на огнь и простирали к нему руки, не имея других орудий к погашению."
                            },
                            {
                                "example_id": "064fd31b-604f-41f6-8223-d999e2e6b37f",
                                "sense_id": "5149af74-d79c-3446-9c0c-60fa21a0fd85",
                                "text": "Ангел непогоды пролил огнь и гром, / Напоив народы яростным вином."
                            }
                        ]
                    }
                ],
