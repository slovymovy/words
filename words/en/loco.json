                                "target_lang_word": "au ton",
                                "target_lang_sense_clarification": "terme musical français"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按原音高",
                                "target_lang_sense_clarification": "音乐术语，结束八度移位"
                            },
                            {
                                "target_lang_word": "原位",
