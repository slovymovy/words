                "senses": [
                    {
                        "sense_id": "4099520d-fc8e-37c3-9114-b265c59a5f00",
                        "entry_id": "6bdfad4c-9073-38a2-818d-1b384d1738be",
                        "glosses": [
                            "Faire perdre leur caractère canalisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0702596b-5a53-4c26-b7ad-ea5eea4ddade",
                                "sense_id": "4099520d-fc8e-37c3-9114-b265c59a5f00",
                                "text": "Les défauts tendent à décanaliser les particules, soit par pur effet d’obstruction (défaut d’empilement) soit par effet de distorsion (dislocation)."
                            },
                            {
                                "example_id": "f6859e0b-bde3-4ebe-b7c6-213c99d1f2f9",
                                "sense_id": "4099520d-fc8e-37c3-9114-b265c59a5f00",
                                "text": "Le corps des ingénieurs de l’armée ne va pas uniquement réhabiliter la Kissimmee, mais obturer, combler et « décanaliser » les envahissants ouvrages publics du sud et du centre de la Floride afin de rendre autant que possible les Everglades à leur état naturel."
                            }
                        ]
                    }
                ],
