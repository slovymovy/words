                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lilith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9c6e83-aed5-3564-bd3f-8649df81c316",
                                        "entry_id": "8fe0a547-e9e5-3d68-ae1e-b737d0027ce1",
                                        "glosses": [
                                            "A type of female Mesopotamian demon, typically seen as coming to men in dreams and as endangering women during pregnancy or childbirth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb0915c-5b26-40d9-9642-1f642dc9a4c3",
                                                "sense_id": "1b9c6e83-aed5-3564-bd3f-8649df81c316",
                                                "text": "[A] Mandaic specimen from Kutha (BM 91715) which contains two independent incantations separated by a line: a historiola relating the expulsion of a particular lilith and the report of a dream purportedly dreamt by the client[.]"
                                            },
                                            {
                                                "example_id": "aba6c63c-244f-4ae2-9c7e-276ab958e07d",
                                                "sense_id": "1b9c6e83-aed5-3564-bd3f-8649df81c316",
                                                "text": "It describes the liliths who are divorced with these words: “naked are you sent forth, nor are you clad, with your hair disheveled and let fly behind your backs.” And indeed, the drawing of the lilith depicts her as naked[.]"
                                            },
                                            {
                                                "example_id": "384bfb3e-8f1b-4184-960d-f8479530ea0d",
                                                "sense_id": "1b9c6e83-aed5-3564-bd3f-8649df81c316",
                                                "text": "A drawing and a few inscriptions indicate the appearance of a lilith, as a young naked woman with long dishevelled hair and prominent breasts and genitals […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
