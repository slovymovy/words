                "senses": [
                    {
                        "sense_id": "f0e4f3e8-1ea8-3f7e-914b-0eff10451344",
                        "entry_id": "b4abd75f-2e93-3605-9deb-a16e8a9123fc",
                        "glosses": [
                            "deutlich über dem normalen Stand liegender Wasserstand der Donau, der mit einer Überschwemmung einhergehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637321e6-e15f-4c65-aafa-268080894d8c",
                                "sense_id": "f0e4f3e8-1ea8-3f7e-914b-0eff10451344",
                                "text": "„Der Rechnungshof (RH) hat sich mit dem Donauhochwasser 2013 beschäftigt und dabei unter anderem die Einhaltung der Wehrbetriebsordnungen überprüft, die laut dem am Mittwoch dem Parlament vorgelegten Bericht bei den meisten Kraftwerken auch eingehalten wurden.“"
                            },
                            {
                                "example_id": "cda7d96a-80a6-4d83-993b-cd19b56031e0",
                                "sense_id": "f0e4f3e8-1ea8-3f7e-914b-0eff10451344",
                                "text": "„Wie üblich bei Donauhochwasser seien auch diesmal wieder rote und gelbe Fahnen entlang der Neuen Donau gehisst worden, so die MA 45.“"
                            },
                            {
                                "example_id": "66edad6b-834e-4915-9594-6a0559440bff",
                                "sense_id": "f0e4f3e8-1ea8-3f7e-914b-0eff10451344",
                                "text": "„An Maria Himmelfahrt entspannte sich die Lage in Bayern allmählich. Insgesamt richtete das Elb- und Donauhochwasser in Deutschland einen Schäden in Höhe von 15 Milliarden Euro an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
