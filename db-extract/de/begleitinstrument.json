                ],
                "senses": [
                    {
                        "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                        "entry_id": "96fb5be4-d719-38b9-9cf9-e1fe3c0174c9",
                        "glosses": [
                            "Musikinstrument, das zur Begleitung einer Melodie gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33078d00-dd2a-4825-9409-e974ca5e6c30",
                                "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                                "text": "„Die Paukenschläge der großen vier Trommeln dominierten alle anderen Begleitinstrumente.“"
                            },
                            {
                                "example_id": "f07b00da-f4cb-4099-8ada-2e5f5de8eef5",
                                "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                                "text": "„Damit verschwanden auch die Trommeln als Begleitinstrumente aus dem musikalischen Leben dieser Regionen.“"
                            },
                            {
                                "example_id": "9460a827-cb86-4265-ad2c-de9d5e1dd599",
                                "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                                "text": "„Das Begleitinstrument hörte sich nicht mehr wie eine Sirene an, sondern wie eine von einem großartigen Könner gespielte Geige.“"
                            },
                            {
                                "example_id": "e29b50f7-1a48-465b-af66-9b79036cd319",
                                "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                                "text": "„Die Tänze des Flachlands unterscheiden sich durch die Art der Darbietung, durch die Tanzrhythmen sowie unterschiedliche Begleitinstrumente.“"
                            },
                            {
                                "example_id": "bd48853d-269c-4527-b11d-a4c8d0de8cb7",
                                "sense_id": "4cc11c18-dfc6-3194-8e03-93887b1a13fd",
                                "text": "„Neu eingeführt wurde die Balalaika als Begleitinstrument zusätzlich zur Gitarre, in manchen Gruppen entstanden sogar große Balalaika-Orchester.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
