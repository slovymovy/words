                "senses": [
                    {
                        "sense_id": "7ace9d80-f051-3028-933a-a5a3e8026c94",
                        "entry_id": "818ebc40-459c-3f7e-8101-500854a76184",
                        "glosses": [
                            "gesetzesähnliche Vorschrift (Verordnung), die die Herstellung, Kennzeichnung, das Inverkehrbringen und die Verwendung von Biozidprodukten (Mittel zur Bekämpfung von Schadorganismen; Substanzen und Produkte, die Schädlinge und Lästlinge wie Insekten, Mäuse oder Ratten, aber auch Algen, Pilze oder Bakterien bekämpfen) regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474b841a-b04a-4bfb-841b-c1e3328ad6e0",
                                "sense_id": "7ace9d80-f051-3028-933a-a5a3e8026c94",
                                "text": "„Die Verordnung (EU) 528/2012 des Europäischen Parlaments und des Rates über die Bereitstellung auf dem Markt und die Verwendung von Biozidprodukten, kurz „Biozid-Verordnung“ reguliert europaweit das Inverkehrbringen und die Verwendung von Biozidprodukten.“"
                            },
                            {
                                "example_id": "f11e0979-8736-4528-aec8-825a36d20595",
                                "sense_id": "7ace9d80-f051-3028-933a-a5a3e8026c94",
                                "text": "„Die Biozid-Verordnung [8] ist 2012 in Kraft getreten und hat die bis dahin geltende Biozidrichtlinie ersetzt.“"
                            },
                            {
                                "example_id": "31d1bdb6-7858-4b4c-8a81-872a8944abf9",
                                "sense_id": "7ace9d80-f051-3028-933a-a5a3e8026c94",
                                "text": "„Angesichts von Lösemittel- und Biozid-Verordnungen wird die Farbindustrie immer weiter eingeschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
