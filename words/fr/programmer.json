                    "sense_id": "cb6a0485-4f95-39c3-bfee-c987ac069003",
                    "sense_definition": "Planifier une activité à l'avance ou régler le déclenchement automatique d'un appareil.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>programmer</w> une réunion avec toute l'équipe pour discuter du projet.",
                            "target_lang_translations": {
                                "en": "We need to <w>schedule</w> a meeting with the whole team to discuss the project.",
                                "ru": "Нам нужно <w>назначить</w> встречу со всей командой, чтобы обсудить проект.",
                                "de": "Wir müssen mit dem ganzen Team eine Besprechung <w>ansetzen</w>, um über das Projekt zu sprechen.",
                                "es": "Debemos <w>programar</w> una reunión con todo el equipo para discutir el proyecto.",
                                "zh": "我们需要跟整个团队<w>安排</w>一次会议，讨论这个项目。"
                            }
                        },
                        {
                            "text": "Elle a pensé à <w>programmer</w> son réveil pour ne pas rater son train.",
                            "target_lang_translations": {
                                "en": "She remembered to <w>set</w> her alarm clock so she wouldn't miss her train.",
                                "ru": "Она не забыла <w>поставить</w> будильник, чтобы не опоздать на поезд.",
                                "de": "Sie hat daran gedacht, ihren Wecker zu <w>programmieren</w>, um ihren Zug nicht zu verpassen.",
                                "es": "Ella pensó en <w>programar</w> su despertador para no perder el tren.",
                                "zh": "她想到要<w>设定</w>闹钟，以免错过火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "planifier",
                        "prévoir",
                        "organiser"
                    ],
                    "antonyms": [
                        "improviser"
                    ],
                    "common_phrases": [
                        "programmer une réunion",
                        "programmer le réveil",
                        "programmer un voyage"
                    ],
                    "target_lang_definitions": {
