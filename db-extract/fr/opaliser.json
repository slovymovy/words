                ],
                "senses": [
                    {
                        "sense_id": "fa31f282-af36-372e-b3fd-a07014ee5b63",
                        "entry_id": "265b081f-9237-3d25-802d-7793b504c09a",
                        "glosses": [
                            "Donner à quelque chose un aspect d’opale, translucide et laiteux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab05903-2b59-425a-af9d-e3338bf13efd",
                                "sense_id": "fa31f282-af36-372e-b3fd-a07014ee5b63",
                                "text": "Ils pénétraient les papilles de la bouche, évoquaient des souvenances d’eau opalisée par des vinaigres rares, de baisers très profonds, tout imbibés d’odeurs."
                            },
                            {
                                "example_id": "6b8ef672-dea2-4f7a-9ffc-f0136f7314b3",
                                "sense_id": "fa31f282-af36-372e-b3fd-a07014ee5b63",
                                "text": "Sur cette eau dont la lune opalise le disque."
                            }
                        ]
                    },
                    {
                        "sense_id": "b48af92a-fee5-34e6-9c5b-9fc9baedbcb6",
                        "entry_id": "265b081f-9237-3d25-802d-7793b504c09a",
                        "glosses": [
                            "Prendre un aspect d’opale, translucide et laiteux."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "03a3cf2b-709c-4529-a297-1d789edc7e7d",
                                "sense_id": "b48af92a-fee5-34e6-9c5b-9fc9baedbcb6",
                                "text": "Les nuages s’émiettent, plus blancs ; le soleil tombe en pluie brillante sur la mer, dont le vert changeant s’adoucit, se dore par places, par places s’opalise, et, près du rivage, au-dessus de la ligne bouillonnante, se nuance de tous les tons du rose et du blanc."
                            },
                            {
                                "example_id": "237d517b-f8ab-4fb0-84c5-b78f22f841a7",
                                "sense_id": "b48af92a-fee5-34e6-9c5b-9fc9baedbcb6",
                                "text": "Des fleurs rappelant l’ivoire, dans un vase opalisé par l’eau qui s’en était évaporée, perdaient une pétale et leurs tiges donnaient un bruit minuscule, de cristal et d’os."
                            }
                        ]
                    }
                ],
