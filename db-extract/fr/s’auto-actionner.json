                "senses": [
                    {
                        "sense_id": "eb207161-0f26-33d3-85f6-3220ac949d06",
                        "entry_id": "0bf62dad-0874-3001-9ca2-833b7285d778",
                        "glosses": [
                            "S’actionner de façon automatique, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69da899d-3537-4ee0-ab47-59f50f7338ee",
                                "sense_id": "eb207161-0f26-33d3-85f6-3220ac949d06",
                                "text": "Les modèles d'organisation d'entreprise s'inspirent aussi des principes énoncés par le mathématicien Alan Turing : chercher à organiser l'entreprise comme si c'était une sorte de « banque de données » capable de s'auto-actionner grâce à une communication linguistique privée d'obstacle, la plus fluide possible, en « inter-faces »."
                            },
                            {
                                "example_id": "907eecdc-bac6-451f-b713-8c48172beaf7",
                                "sense_id": "eb207161-0f26-33d3-85f6-3220ac949d06",
                                "text": "Il était la chute, qui, avec l'énergie qu'elle produit, s'auto-actionne."
                            }
                        ]
                    }
