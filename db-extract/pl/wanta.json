                                        "examples": [
                                            {
                                                "example_id": "8acccff3-bf57-409f-b72e-22670cf816ba",
                                                "sense_id": "1c210938-6961-3cf2-bc90-bd7eaa496572",
                                                "text": "Все четыреста человек экипажа столпились на палубе, раздались командные слова, многие матросы поползли вверх по вантам, как мухи облепили реи, и судно окрылилось парусами."
                                            },
                                            {
                                                "example_id": "88bb6850-4f5e-4aa4-b6dc-68062ad5400b",
                                                "sense_id": "1c210938-6961-3cf2-bc90-bd7eaa496572",
                                                "text": "Простояли мы этак дён пять, вытянули ванты, выкрасились и, как справились, отпустили нашу вахту на берег."
                                            },
                                            {
                                                "example_id": "c977aad0-f97c-4572-b8ec-4c261685ce8b",
                                                "sense_id": "1c210938-6961-3cf2-bc90-bd7eaa496572",
                                                "text": "Тени штагов и вант перекрещивались на палубе чёрными полосами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
