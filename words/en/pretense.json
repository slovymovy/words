                        {
                            "text": "His sophisticated lifestyle was full of <w>pretense</w>."
                        }
                    ]
                },
                {
                    "sense_id": "08d57019-6d32-3b71-8ffe-33918b7406ce",
                    "sense_definition": "An unsupported or false claim made about one's abilities or character.",
