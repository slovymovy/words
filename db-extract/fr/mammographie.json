                "senses": [
                    {
                        "sense_id": "c6353332-e5e8-3657-b442-cf5a2384042b",
                        "entry_id": "ef3809e5-7ba5-3e66-9e28-91069b031ba8",
                        "glosses": [
                            "Technique de radiographie particulièrement adaptée à la détection des anomalies des seins de la femme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a350bea8-dfb6-4397-a089-a376d06fa868",
                                "sense_id": "c6353332-e5e8-3657-b442-cf5a2384042b",
                                "text": "L’échographie s’intègre dans la démarche diagnostique, comprenant l’examen clinique et, sauf cas particuliers, la mammographie à tous les stades de la prise en charge de la patiente en sénologie."
                            },
                            {
                                "example_id": "2a4d3bca-cad1-4db3-bdf5-a5509613a355",
                                "sense_id": "c6353332-e5e8-3657-b442-cf5a2384042b",
                                "text": "Tout comme un tube radiogène classique, les tubes de mammographie proposent deux tailles de foyers optiques en fonction de la charge thermique souhaitée."
                            }
                        ]
                    },
                    {
                        "sense_id": "01a5bdf4-f46a-3e92-89b0-885f5aa0f4e4",
                        "entry_id": "ef3809e5-7ba5-3e66-9e28-91069b031ba8",
                        "glosses": [
                            "L’image obtenue par cette technique (mammogramme)."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
