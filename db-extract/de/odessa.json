                        "source_entry_id": "510a169e-59cb-36f2-ae84-58cf70088e04",
                        "source_sense_id": "e0270f40-11d4-374f-a83c-72a27b9899c8",
                        "source_sense_description": "Stadt",
                        "target_lang_word": "Одесса",
