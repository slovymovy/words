{
    "word_family": [
        "choring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "135a96d3-10ee-340c-a71d-1878616dabd9",
                    "sense_definition": "A routine task, especially a household duty such as cleaning, washing, or preparing meals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "household_tasks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were made to do their daily <w>chores</w> before being allowed to play games.",
                            "target_lang_translations": {
                                "ru": "Детям велели сделать свои ежедневные <w>обязанности по дому</w>, прежде чем разрешить играть."
                            }
                        },
                        {
                            "text": "We usually divide the household <w>chores</w> so that everyone helps keep the kitchen clean.",
                            "target_lang_translations": {
                                "ru": "Мы обычно делим <w>бытовые дела</w>, чтобы каждый помогал поддерживать чистоту на кухне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "household chores",
                        "daily chores",
                        "do chores"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярная повседневная работа, особенно по дому (уборка, стирка, готовка)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работа по дому",
                                "target_lang_sense_clarification": "бытовые повседневные дела"
                            },
                            {
                                "target_lang_word": "домашние дела",
                                "target_lang_sense_clarification": "уборка, готовка, стирка"
                            },
                            {
                                "target_lang_word": "бытовая рутина",
                                "target_lang_sense_clarification": "ежедневные обязанности по хозяйству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f28410c-2150-31eb-9604-9f26bfafb29b",
                    "sense_definition": "A tedious, unpleasant, or difficult task that one dislikes doing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpleasant_tasks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Writing the weekly progress report has become a real <w>chore</w> for the team.",
                            "target_lang_translations": {
                                "ru": "Написание еженедельного отчета о прогрессе стало настоящей <w>рутиной</w> для команды."
                            }
                        },
                        {
                            "text": "I used to enjoy cooking, but preparing meals every single day feels like a <w>chore</w> now.",
                            "target_lang_translations": {
                                "ru": "Раньше мне нравилось готовить, но необходимость готовить каждый божий день теперь кажется <w>обузой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feel like a chore",
                        "real chore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучное, неприятное или тяжелое дело, которое не хочется делать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рутина",
                                "target_lang_sense_clarification": "нудное или неприятное занятие"
                            },
                            {
                                "target_lang_word": "обуза",
                                "target_lang_sense_clarification": "тягостная обязанность"
                            },
                            {
                                "target_lang_word": "тягость",
                                "target_lang_sense_clarification": "неприятный труд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255a56f3-c78b-3ee0-8c0d-466de324c316",
                    "sense_definition": "An archaic spelling and form of <w>choir</w> or chorus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text described a heavenly <w>chore</w> singing praises in the cathedral.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте описывался небесный <w>хор</w>, поющий хвалу в соборе."
                            }
                        },
                        {
                            "text": "He wrote of the sweet voices belonging to the sacred <w>chore</w>.",
                            "target_lang_translations": {
                                "ru": "Он писал о сладких голосах, принадлежащих священному <w>хору</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to mean choir"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма написания слова choir (хор)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хор",
                                "target_lang_sense_clarification": "устаревшая форма слова choir"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c464923-ee57-3cd1-83eb-a858a53ab291",
                    "sense_definition": "To perform routine household tasks or chores.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire Saturday morning <w>choring</w> around the house and garden.",
                            "target_lang_translations": {
                                "ru": "Он провел все утро субботы, <w>хлопоча по хозяйству</w> в доме и саду."
                            }
                        },
                        {
                            "text": "After <w>choring</w> all afternoon, she finally sat down to enjoy a cup of tea.",
                            "target_lang_translations": {
                                "ru": "Пропромышляв <w>домашней работой</w> весь день, она наконец присела выпить чашку чая."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять рутинную работу по дому или хозяйству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься домашними делами",
                                "target_lang_sense_clarification": "делать уборку или мелкую работу по дому"
                            },
                            {
                                "target_lang_word": "хлопотать по хозяйству",
                                "target_lang_sense_clarification": "выполнять повседневные бытовые обязанности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cad9e14e-3fca-3baf-b833-fbe26ffc5ccb",
                    "sense_definition": "To steal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boy was caught trying to <w>chore</w> some sweets from the local shop.",
                            "target_lang_translations": {
                                "ru": "Маленького мальчика поймали, когда он пытался <w>стянуть</w> сладости из местного магазина."
                            }
                        },
                        {
                            "text": "They warned him not to <w>chore</w> anything while visiting the market.",
                            "target_lang_translations": {
                                "ru": "Его предупредили ничего не <w>воровать</w>, пока он будет на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "thieve",
                        "twoc"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal/dialectal term for stealing"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Scottish or Romani-influenced English slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воровать, красть (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воровать",
                                "target_lang_sense_clarification": "сленговое обозначение кражи"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "своровать, умыкнуть"
                            }
                        ]
