        "fr-extract.jsonl": [
            {
                "entry_id": "1fbfa8d2-9b28-3099-85e5-53280b3c129a",
                "word": "plantal",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1221140b-a96d-3852-bece-92df24782af6",
                        "entry_id": "1fbfa8d2-9b28-3099-85e5-53280b3c129a",
                        "glosses": [
                            "Relatif au règne des plantes (dont certaines algues), à l’exclusion des champignons contrairement à l’adjectif végétal qui fait référence à l’ancien règne végétal."
                        ],
                        "tags": [
                            "Hapax"
                        ],
                        "examples": [
                            {
                                "example_id": "9a2cf352-5894-435b-b13e-c2ccc11263f3",
                                "sense_id": "1221140b-a96d-3852-bece-92df24782af6",
                                "text": "Dans les premiers temps les monères de Haeckel étaient mal circonscrites, excluant par exemple certains organismes anucléés comme Nostoc, un genre de cyanobactérie alors classé dans le règne plantal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f06b94-a20f-4f69-8e8b-e4c8a4483d38",
                        "source_entry_id": "1fbfa8d2-9b28-3099-85e5-53280b3c129a",
                        "source_sense_id": "1221140b-a96d-3852-bece-92df24782af6",
                        "target_lang_word": "plantal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plantal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f245a4-b674-30c5-adcd-ace6f30093ed",
                                        "entry_id": "0d493560-f409-3eb2-875e-ee337b8ec7d6",
                                        "glosses": [
                                            "Belonging to plants."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76d85560-8747-4555-a9f5-9b8ef29aa19f",
                                                "sense_id": "25f245a4-b674-30c5-adcd-ace6f30093ed",
                                                "text": "The most degenerate souls did at last sleep in the bodies of trees, and grew up merely into plantal life."
                                            },
                                            {
                                                "example_id": "cdfe815a-f1f7-4fc6-b038-879951066fbb",
                                                "sense_id": "25f245a4-b674-30c5-adcd-ace6f30093ed",
                                                "text": "To live indeed is common also to plants; but we now investigate the peculiar work of man, so that the consideration about the plantal life must be dismissed."
                                            },
                                            {
                                                "example_id": "d7997462-28b2-4418-86d3-f3827645cebe",
                                                "sense_id": "25f245a4-b674-30c5-adcd-ace6f30093ed",
                                                "text": "This sudden glimpse of the richness of southern vegetation is very delightful to a wanderer from Northern Europe who sees it for the first time, and it forms one of the most striking transitions in the aspect of plantal life […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd688e2d-652c-3f2c-9a85-ce65c9f4d6c2",
                                        "entry_id": "0d493560-f409-3eb2-875e-ee337b8ec7d6",
                                        "glosses": [
                                            "Of the nature of implanting or uniting."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4bbb067-9739-4a8a-9128-59f3097b5983",
                                                "sense_id": "bd688e2d-652c-3f2c-9a85-ce65c9f4d6c2",
                                                "text": "\"That the Plantal faculty of the Soul, whereby she is unitable to this terrestrial Body, is not arbitrarious, but fatal or natural; which union cannot be dissolved unless the bond of Life be loosened, and that vital congruity (which is in the Body, and does necessarily hold the Soul there) be either for a time hindred or utterly destroy'd.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75e70e72-6926-45f2-ab09-90d1f22a2684",
                        "source_entry_id": "1fbfa8d2-9b28-3099-85e5-53280b3c129a",
                        "source_sense_id": "1221140b-a96d-3852-bece-92df24782af6",
                        "target_lang_word": "plant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ea16cb-5469-3463-975b-a40c2ef120fe",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "An organism that is not an animal, especially an organism capable of photosynthesis. Typically a small or herbaceous organism of this kind, rather than a tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74d9548-1e8f-4789-89e4-c7f17ad33bec",
                                                "sense_id": "d5ea16cb-5469-3463-975b-a40c2ef120fe",
                                                "text": "The garden had a couple of trees, and a cluster of colourful plants around the border."
                                            },
                                            {
                                                "example_id": "b5ccfc1f-f283-46ca-be03-386cc579a9c2",
                                                "sense_id": "d5ea16cb-5469-3463-975b-a40c2ef120fe",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual. Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4752fe9b-8003-32d6-9ded-5cd75ca877e0",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "An organism of the kingdom Plantae. Now specifically, a living organism of the Embryophyta (land plants) or of the Chlorophyta (green algae), a eukaryote that includes double-membraned chloroplasts in its cells containing chlorophyll a and b, or any organism closely related to such an organism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a020920-cba1-38df-b978-54920d8c45e9",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "Now specifically, a multicellular eukaryote that includes chloroplasts in its cells, which have a cell wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b83a2266-b6ce-3f67-9a42-8393a20c9ccf",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "Any creature that grows on soil or similar surfaces, including plants and fungi."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75a5627-ff5a-4fd4-bc46-507fc6062821",
                                                "sense_id": "b83a2266-b6ce-3f67-9a42-8393a20c9ccf",
                                                "text": "Some plants, such as mushrooms found in the wild, are difficult to identify. Some plants are poisonous, and an inexperienced individual may make mistakes in identification of wild plants, with tragic results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dbfe047-0aff-33fe-84fe-70fbd564cb9e",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A factory or other industrial or institutional building or facility."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "572858e1-a199-4e27-a864-8615bf910956",
                                                "sense_id": "6dbfe047-0aff-33fe-84fe-70fbd564cb9e",
                                                "text": "The company has production plants in three countries."
                                            },
                                            {
                                                "example_id": "86c7b0e4-7ac8-482e-9999-0ddc709807c8",
                                                "sense_id": "6dbfe047-0aff-33fe-84fe-70fbd564cb9e",
                                                "text": "My dad worked at the plant for 27 years."
                                            },
                                            {
                                                "example_id": "5e48b180-0393-4784-966d-b53f3d807e9c",
                                                "sense_id": "6dbfe047-0aff-33fe-84fe-70fbd564cb9e",
                                                "text": "The US group does have another vaccine plant in Ireland – in Carlow – but it is understood the Dundalk site is the only live virus vaccine facility in MSD’s Irish network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e244509-cf46-37cc-bad2-d23caaecd72a",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "Machinery and other supplies and equipment, such as the kind used in heavy industry, light industry, earthmoving, or construction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10be788-824a-4a18-bd1f-5707a22ed1c3",
                                                "sense_id": "0e244509-cf46-37cc-bad2-d23caaecd72a",
                                                "text": "Near-synonym: capital equipment"
                                            },
                                            {
                                                "example_id": "c308af10-9f8b-42ac-91e3-a90f1bcd5d52",
                                                "sense_id": "0e244509-cf46-37cc-bad2-d23caaecd72a",
                                                "text": "industrial plant"
                                            },
                                            {
                                                "example_id": "d6533783-b38c-4939-ab8b-0df9685b8834",
                                                "sense_id": "0e244509-cf46-37cc-bad2-d23caaecd72a",
                                                "text": "refrigeration plant"
                                            },
                                            {
                                                "example_id": "b49f9732-b46c-49c7-8159-65f9d618ba55",
                                                "sense_id": "0e244509-cf46-37cc-bad2-d23caaecd72a",
                                                "text": "A massive amount of plant has been trucked in and installed over the past two years, and production is expected to begin soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63fd9f1-6b45-3ad7-9184-8d522ffe00f4",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "An object placed surreptitiously in order to cause suspicion to fall upon a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4149e4f4-8a65-4d3e-bbd9-5fd0abce43cc",
                                                "sense_id": "f63fd9f1-6b45-3ad7-9184-8d522ffe00f4",
                                                "text": "That gun’s not mine! It’s a plant! I’ve never seen it before!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53daa173-3639-3e6a-bc70-25a6080cf9f4",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A stash or cache of hidden goods."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9baec587-79d6-33c5-b9c7-28d243f79e64",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "Anyone assigned to behave as a member of the public during a covert operation (as in a police investigation)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73381f36-1191-365e-b2d7-12abf9d9483a",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A person, placed amongst an audience, whose role is to cause confusion, laughter etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95d6a44a-359b-372e-aef8-716ce6092dbf",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A play in which the cue ball knocks one (usually red) ball onto another, in order to pot the second; a set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69820c04-dad4-4027-9005-fb42cf244e48",
                                                "sense_id": "95d6a44a-359b-372e-aef8-716ce6092dbf",
                                                "text": "O’Sullivan risked a plant that went badly astray, splitting the reds."
                                            },
                                            {
                                                "example_id": "60dd93f6-fc24-4c79-92ee-d7f75e7a9fb6",
                                                "sense_id": "95d6a44a-359b-372e-aef8-716ce6092dbf",
                                                "text": "The company's product range includes tools, construction plant, diggers, dumpers and rollers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d78e63-9a86-3cbe-84ff-767cfe50ec6d",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A young tree; a sapling; hence, a stick or staff."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc03588-06e4-4f82-b9a8-1b43466a7cc7",
                                                "sense_id": "e8d78e63-9a86-3cbe-84ff-767cfe50ec6d",
                                                "text": "Take, Shepherd, take a Plant of ſtubborn Oak; / And labour him with many a ſturdy ſtroke: / Or with hard Stones, demoliſh from afar / His haughty Creſt, the feat of all the War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abd1ebb3-d600-33f1-8882-1ac6e0466eca",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "The sole of the foot."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1e4152-71c6-459c-9999-fad9d3839271",
                                                "sense_id": "abd1ebb3-d600-33f1-8882-1ac6e0466eca",
                                                "text": "Knotty legs, and plants of clay, / Seek for eaſe, or love delay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1ccdca-531d-3148-9bce-1e8e11a90b78",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A plan; a swindle; a trick."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8944755f-857b-4b02-b778-84a5973d0f54",
                                                "sense_id": "1c1ccdca-531d-3148-9bce-1e8e11a90b78",
                                                "text": "It wasn’t a bad plant that of mine, on Fikey, the man accused of forging the Sou’ Westeru Railway debentures—it was only t’ other day—because the reason why? I’ll tell you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b28809-8bd1-340a-9637-6a4975a1427c",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "An oyster which has been bedded, in distinction from one of natural growth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "342aafd4-c8bb-3bbe-a1cf-825368071ab7",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A young oyster suitable for transplanting."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb5204be-6bc4-32e8-b24a-ea2f6806aa83",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A system, such as a motor, whose behaviour is being regulated or controlled by a control system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d801b639-1753-34dd-8cbe-56a045f65ce7",
                                        "entry_id": "af6a6b58-79e1-3c47-a088-dff41fe6ff9a",
                                        "glosses": [
                                            "A position in the street to sell from; a pitch."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b70f0778-acc2-3a40-90ea-3b1f3fd41e94",
                                        "entry_id": "0b2850e3-7b1c-3b5b-b2e8-1e0f51b0c402",
                                        "glosses": [
                                            "To place (a seed or plant) in soil or other substrate in order that it may live and grow."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb14fdc7-3344-351f-9011-4a41a5595498",
                                        "entry_id": "0b2850e3-7b1c-3b5b-b2e8-1e0f51b0c402",
                                        "glosses": [
                                            "To furnish or supply with plants."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0fb29d-6a84-441a-97d5-b82e3302e7e4",
                                                "sense_id": "cb14fdc7-3344-351f-9011-4a41a5595498",
                                                "text": "to plant a garden, an orchard, or a forest"
                                            },
                                            {
                                                "example_id": "ad69cbe7-cce0-4b7d-9726-8d9df3fc377d",
                                                "sense_id": "cb14fdc7-3344-351f-9011-4a41a5595498",
                                                "text": "His father had given him a little square bed in a corner of the garden, which he had planted with corn two days before."
                                            },
                                            {
                                                "example_id": "ec7ecc7a-f824-4f1f-9913-2002a1f8e54a",
                                                "sense_id": "cb14fdc7-3344-351f-9011-4a41a5595498",
                                                "text": "With your mouse, you plant a garden by selecting plants from a database of 450 of the most common flowers, shrubs, and trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ed86db-1252-373a-829c-e5d6ea9c6031",
                                        "entry_id": "0b2850e3-7b1c-3b5b-b2e8-1e0f51b0c402",
                                        "glosses": [
                                            "To place (an object, or sometimes a person), often with the implication of intending deceit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e158936-12e2-41fd-a4e0-bdaf3bbcb819",
                                                "sense_id": "23ed86db-1252-373a-829c-e5d6ea9c6031",
                                                "text": "That gun’s not mine! It was planted there by the real murderer!"
                                            },
                                            {
                                                "example_id": "3279e33a-0473-4cae-82f5-0dc63f8ad1ef",
                                                "sense_id": "23ed86db-1252-373a-829c-e5d6ea9c6031",
                                                "text": "Not only that, I thought, but cynics would now theorise that the interview piece was a PR exercise, a planted story designed as damage-limitation in the event that some probing journalist revealed all about the love nest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaafd804-c799-32db-a6d8-4b7cd6ddb800",
                                        "entry_id": "0b2850e3-7b1c-3b5b-b2e8-1e0f51b0c402",
                                        "glosses": [
                                            "To place or set something firmly or with conviction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301b4f76-3b58-4252-ae0e-60ee69a14e83",
                                                "sense_id": "aaafd804-c799-32db-a6d8-4b7cd6ddb800",
                                                "text": "to plant cannon against a fort; to plant a flag; to plant one’s feet on solid ground"
                                            },
                                            {
                                                "example_id": "27414271-63af-44aa-83ca-c3fc5dae8c85",
                                                "sense_id": "aaafd804-c799-32db-a6d8-4b7cd6ddb800",
                                                "text": "Plant your feet firmly and give the rope a good tug."
                                            },
                                            {
                                                "example_id": "a99f75c0-d546-4e71-99ac-fb194bbdadc9",
                                                "sense_id": "aaafd804-c799-32db-a6d8-4b7cd6ddb800",
                                                "text": "First Anelka curled a shot wide from just outside the box, then Lampard planted a header over the bar from Bosingwa's cross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88728914-82fe-3706-a90a-55e6fb8f0380",
                                        "entry_id": "0b2850e3-7b1c-3b5b-b2e8-1e0f51b0c402",
                                        "glosses": [
                                            "To place in the ground."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cae763f7-cab9-43ee-bc1b-0367b5ffd560",
                                                "sense_id": "88728914-82fe-3706-a90a-55e6fb8f0380",
                                                "text": "God moves in a myſterious way, / His wonders to perform; / He plants his footſteps in the ſea, / And rides upon the ſtorm."
                                            },
                                            {
                                                "example_id": "f6a00d9f-84ed-4fbc-a4c2-c494d137f6e3",
