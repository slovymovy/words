                "senses": [
                    {
                        "sense_id": "c87a051a-0ae1-3961-8179-0c01df5015f4",
                        "entry_id": "4bf10213-24fa-3935-9933-ffc7b5f5346d",
                        "glosses": [
                            "ein (für Gelehrte) von Rabbinern verliehener Ehrentitel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d62e13c-c690-4e70-89b5-38bb89307ab9",
                                "sense_id": "c87a051a-0ae1-3961-8179-0c01df5015f4",
                                "text": "„Eine besondere Ehrung erwies ihm der Kreisrabbiner von Eschwege, Herr Dr. Baßfreund, der ihm persönlich den Chawer (Ehrentitel) überbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0de9f9d0-78bd-39fd-abf7-ea4581842ca4",
                        "entry_id": "4bf10213-24fa-3935-9933-ffc7b5f5346d",
                        "glosses": [
                            "Freund, Kamerad, Partner — besonders unter Mitgliedern der zionistischen Arbeiterpartei im Sinne von „Genosse“ verwendete Anrede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c97b26c-7a37-4ebd-8732-99e388b18edb",
                                "sense_id": "0de9f9d0-78bd-39fd-abf7-ea4581842ca4",
                                "text": "„Die Eröffnungsansprache hält der Chawer (Genosse) Rafael Steinert:[…]Ein Redner, der Chawer Schoschani, gebraucht eine wunderbare Metapher: Mit dem Sozialismus sei es wie mit dem Horizont, je mehr man sich ihm nähert, um so mehr erweitert er sich, bleibt aber immer unerreichbar … Er wettert gegen das Gerede vom „sozialistischen Endziel“: Der Sozialismus habe kein Endziel, er sei „ein permanenter Kampf um Fortschritt in unserer Zeit“.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
