{
    "word_family": [
        "lot",
        "latać",
        "przelot",
        "przelotny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "034a6e52-78c5-31a7-9cdb-f345a0cfb53d",
                    "sense_definition": "przemieszczać się w powietrzu z jednego miejsca do drugiego",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ptaki <w>przeleciały</w> nad naszymi głowami w stronę ciepłych krajów.",
                            "target_lang_translations": {
                                "ru": "Птицы <w>пролетели</w> над нашими головами в сторону теплых стран."
                            }
                        },
                        {
                            "text": "Samolot <w>przeleciał</w> nad oceanem w ciągu kilku godzin.",
                            "target_lang_translations": {
                                "ru": "Самолет <w>пролетел</w> над океаном за несколько часов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "перемещаться по воздуху из одного места в другое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролететь",
                                "target_lang_sense_clarification": "перемещаться в пространстве по воздуху"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e8ee4a4-9db3-3b7c-bc82-8b9225d25cae",
                    "sense_definition": "szybko minąć jakiś punkt lub przebyć pewną odległość",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czas bardzo szybko <w>przeleciał</w> podczas wakacji.",
                            "target_lang_translations": {
                                "ru": "Время во время каникул <w>пролетело</w> очень быстро."
                            }
                        },
                        {
                            "text": "Strzała <w>przeleciała</w> tuż obok celu.",
                            "target_lang_translations": {
                                "ru": "Стрела <w>пролетела</w> прямо рядом с целью."
                            }
                        }
                    ],
                    "synonyms": [
                        "minąć",
                        "przebyć",
                        "przemknąć"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро миновать точку или преодолеть расстояние; о времени — быстро пройти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролететь",
                                "target_lang_sense_clarification": "быстро миновать что-либо или о быстротекущем времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d78c3e22-9c2f-3eb3-bf24-9efa5459d84a",
                    "sense_definition": "przeczytać coś pobieżnie, bez wchodzenia w szczegóły",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę jeszcze <w>przelecieć</w> wzrokiem te notatki przed egzaminem.",
                            "target_lang_translations": {
                                "ru": "Мне нужно еще <w>пробежать глазами</w> эти заметки перед экзаменом."
                            }
                        },
                        {
                            "text": "Wystarczy, że <w>przelecisz</w> ten artykuł, żeby zrozumieć główny temat.",
                            "target_lang_translations": {
                                "ru": "Достаточно <w>пролистать</w> эту статью, чтобы понять главную тему."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прочитать что-либо бегло, не вникая в детали"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролистать",
                                "target_lang_sense_clarification": "бегло просмотреть страницы"
                            },
                            {
                                "target_lang_word": "пробежать глазами",
                                "target_lang_sense_clarification": "быстро прочитать текст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1afb8808-9600-38a2-9dfc-f2b24c47f7ee",
                    "sense_definition": "odbyć z kimś stosunek seksualny",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On myśli tylko o tym, żeby kogoś <w>przelecieć</w> na imprezie.",
                            "target_lang_translations": {
                                "ru": "Он думает только о том, чтобы кого-нибудь <w>трахнуть</w> на вечеринке."
                            }
                        },
                        {
                            "text": "Nie szanuje kobiet, traktuje je przedmiotowo i chce je tylko <w>przelecieć</w>.",
                            "target_lang_translations": {
                                "ru": "Он не уважает женщин, относится к ним как к вещам и хочет их только <w>трахнуть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaliczyć"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "wulgarny lub bardzo potoczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вступить с кем-либо в половую связь (вульгарно)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трахнуть",
                                "target_lang_sense_clarification": "грубо о половом акте"
                            },
                            {
                                "target_lang_word": "переспать",
                                "target_lang_sense_clarification": "более нейтральный, но разговорный вариант"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}