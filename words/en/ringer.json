{
    "word_family": [
        "ring"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b8032eb7-706d-35b5-864e-81456cd0fc26",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Ringer</w> family has lived in this town for over a century.",
                            "target_lang_translations": {
                                "cs": "Rodina <w>Ringerových</w> žije v tomto městě již přes století."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Ringer</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal muže jménem pan <w>Ringer</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Ringer",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec489654-d102-3023-b6d3-1e963b544cef",
                    "sense_definition": "A person who rings bells, especially in a church tower.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church <w>ringers</w> practiced their melody for the upcoming wedding.",
                            "target_lang_translations": {
                                "cs": "Kostelní <w>zvoníci</w> nacvičovali svou melodii na nadcházející svatbu."
                            }
                        },
                        {
                            "text": "As a dedicated <w>ringer</w>, he spent every Sunday morning in the bell tower.",
                            "target_lang_translations": {
                                "cs": "Jako oddaný <w>zvoník</w> trávil každé nedělní ráno ve zvonici."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která zvoní na zvony, zejména ve věži kostela."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvoník",
                                "target_lang_sense_clarification": "osoba obsluhující zvony"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31d30025-1685-300c-a0bd-1249456d00e3",
                    "sense_definition": "A successful throw in the game of horseshoes where the shoe lands encircling the stake.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cheered loudly after throwing a perfect <w>ringer</w> during the tournament.",
                            "target_lang_translations": {
                                "cs": "Po hodu, kdy podkova obepnula kolík, během turnaje hlasitě zajásal, protože hodil perfektní <w>zvon</w>."
                            }
                        },
                        {
                            "text": "It is very difficult to land a <w>ringer</w> against an experienced opponent.",
                            "target_lang_translations": {
                                "cs": "Je velmi těžké hodit <w>zvon</w> proti zkušenému soupeři."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Úspěšný hod ve hře podkovami, kdy podkova obepne kolík."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvon",
                                "target_lang_sense_clarification": "hod podkovou kolem kolíku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c322c1d8-6bfc-3f17-b8df-32450c70f6bd",
                    "sense_definition": "A person or thing that looks exactly like another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That actor is a dead <w>ringer</w> for the famous singer.",
                            "target_lang_translations": {
                                "cs": "Ten herec je naprostý <w>dvojník</w> toho slavného zpěváka."
                            }
                        },
                        {
                            "text": "The new employee is a total <w>ringer</w> for my old college roommate.",
                            "target_lang_translations": {
                                "cs": "Ten nový zaměstnanec je naprostý <w>dvojník</w> mého starého spolubydlícího z vysoké."
                            }
                        }
                    ],
                    "synonyms": [
                        "dead ringer"
                    ],
                    "common_phrases": [
                        "dead ringer"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba nebo věc, která vypadá přesně jako jiná."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dvojník",
                                "target_lang_sense_clarification": "osoba vypadající jako někdo jiný"
                            },
                            {
                                "target_lang_word": "věrná kopie",
                                "target_lang_sense_clarification": "věc vypadající jako jiná"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1bace6-0e2a-3843-9e21-193d6230be43",
                    "sense_definition": "A highly skilled person brought into a team to help them win, often secretly or unfairly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposing team brought in a <w>ringer</w> to ensure they won the final match.",
                            "target_lang_translations": {
                                "cs": "Soupeřící tým si přivedl <w>podvodného hráče</w>, aby si zajistil vítězství ve finálovém zápase."
                            }
                        },
                        {
                            "text": "It was obvious that the professional player was a <w>ringer</w> in our amateur league.",
                            "target_lang_translations": {
                                "cs": "Bylo zřejmé, že ten profesionální hráč je v naší amatérské lize <w>podvodný hráč</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vysoce kvalifikovaný hráč tajně nasazený do týmu, aby mu pomohl vyhrát."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podvodný hráč",
                                "target_lang_sense_clarification": "profesionál v amatérském týmu"
                            },
                            {
                                "target_lang_word": "černý pasažér",
                                "target_lang_sense_clarification": "přeneseně, někdo kdo neoprávněně posílí tým"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2ffdabb-2efe-397e-8601-4ecc88787889",
                    "sense_definition": "A fan of the Lord of the Rings books or films.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Ringers</w> gathered at the convention to discuss the fantasy world.",
                            "target_lang_translations": {
                                "cs": "Mnoho <w>fanoušků Pána prstenů</w> se sešlo na srazu, aby diskutovali o tomto fantasy světě."
                            }
                        },
                        {
                            "text": "As a devoted <w>Ringer</w>, she has read all the books multiple times.",
                            "target_lang_translations": {
                                "cs": "Jako oddaná <w>fanouška Pána prstenů</w> četla všechny knihy několikrát."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ringnut"
                    ],
                    "target_lang_definitions": {
                        "cs": "Fanoušek knih nebo filmů Pán prstenů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "fanoušek Pána prstenů",
                                "target_lang_sense_clarification": "obdivovatel díla J.R.R. Tolkiena"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}