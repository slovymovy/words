{
    "word_family": [
        "jailer",
        "jailbreak",
        "jailbird",
        "jailhouse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05b0ad5d-ab9a-3d0e-93d6-63dfde0e78df",
                    "sense_definition": "A building or institution where people are kept as punishment for a crime or while waiting for a trial.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confinement_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was sent to <w>jail</w> for two years.",
                            "target_lang_translations": {
                                "ru": "Вора отправили в <w>тюрьму</w> на два года.",
                                "zh": "小偷被关进<w>监狱</w>两年。"
                            }
                        },
                        {
                            "text": "She visited her brother in <w>jail</w> every weekend.",
                            "target_lang_translations": {
                                "ru": "Она навещала своего брата в <w>тюрьме</w> каждые выходные.",
                                "zh": "她每个周末都去<w>监狱</w>探望她的兄弟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prison",
                        "lockup",
                        "detention center",
                        "penitentiary",
                        "slammer",
                        "gaol"
                    ],
                    "common_phrases": [
                        "go to jail",
                        "in jail",
                        "jail cell",
                        "jail sentence",
                        "break out of jail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание или учреждение, где содержатся люди в качестве наказания за преступление или в ожидании суда.",
                        "zh": "关押罪犯或等待审判者的建筑物或机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюрьма",
                                "target_lang_sense_clarification": "место заключения"
                            },
                            {
                                "target_lang_word": "следственный изолятор",
                                "target_lang_sense_clarification": "место временного содержания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监狱",
                                "target_lang_sense_clarification": "关押罪犯的场所"
                            },
                            {
                                "target_lang_word": "看守所",
                                "target_lang_sense_clarification": "关押未决犯的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df96d964-f4b7-3257-8b53-25bf15a0e508",
                    "sense_definition": "The state or condition of being confined in a prison or similar institution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confinement_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is facing five years in <w>jail</w> for fraud.",
                            "target_lang_translations": {
                                "ru": "Ему грозит пять лет <w>тюрьмы</w> за мошенничество.",
                                "zh": "他因诈骗罪面临五年<w>监禁</w>。"
                            }
                        },
                        {
                            "text": "The judge decided that <w>jail</w> was the only appropriate punishment.",
                            "target_lang_translations": {
                                "ru": "Судья решил, что <w>тюремное заключение</w> было единственным подходящим наказанием.",
                                "zh": "法官认为<w>坐牢</w>是唯一合适的惩罚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imprisonment",
                        "incarceration",
                        "confinement",
                        "custody"
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "face jail",
                        "avoid jail",
                        "life in jail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения в заключении в тюрьме или аналогичном учреждении.",
                        "zh": "被关押在监狱或类似机构中的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюремное заключение",
                                "target_lang_sense_clarification": "наказание"
                            },
                            {
                                "target_lang_word": "тюрьма",
                                "target_lang_sense_clarification": "разг. срок заключения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监禁",
                                "target_lang_sense_clarification": "被剥夺自由的状态"
                            },
                            {
                                "target_lang_word": "坐牢",
                                "target_lang_sense_clarification": "口语，指服刑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e463b036-22b6-31b1-a9de-87da3175c49a",
                    "sense_definition": "A restricted environment on a computer system where a program or operating system can run safely without affecting the main system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_sandbox",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspicious software was run inside a <w>jail</w> to prevent viruses from spreading.",
                            "target_lang_translations": {
                                "ru": "Подозрительное программное обеспечение было запущено в <w>изолированной среде</w>, чтобы предотвратить распространение вирусов.",
                                "zh": "可疑软件在<w>沙盒</w>中运行，以防止病毒传播。"
                            }
                        },
                        {
                            "text": "System administrators often use a <w>jail</w> to test new applications securely.",
                            "target_lang_translations": {
                                "ru": "Системные администраторы часто используют <w>изолированную среду</w> для безопасного тестирования новых приложений.",
                                "zh": "系统管理员经常使用<w>隔离环境</w>来安全地测试新应用程序。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sandbox"
                    ],
                    "common_phrases": [
                        "chroot jail"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограниченная среда в компьютерной системе, где программа или операционная система может работать безопасно, не влияя на основную систему.",
                        "zh": "计算机系统中一种受限的运行环境，程序在此运行不会影响主系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолированная среда",
                                "target_lang_sense_clarification": "информатика"
                            },
                            {
                                "target_lang_word": "песочница",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沙盒",
                                "target_lang_sense_clarification": "计算机安全术语"
                            },
                            {
                                "target_lang_word": "隔离环境",
                                "target_lang_sense_clarification": "技术术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7a77f60-4e92-33f6-85db-d9d75fb0db02",
                    "sense_definition": "To put someone in a prison or detention center as a punishment or legal measure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_imprison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>jailed</w> the activists for protesting without a permit.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>посадило в тюрьму</w> активистов за протест без разрешения.",
                                "zh": "政府因活动人士未经许可抗议而将他们<w>监禁</w>。"
                            }
                        },
                        {
                            "text": "He was <w>jailed</w> for life after being found guilty of the crime.",
                            "target_lang_translations": {
                                "ru": "Он был <w>заключён в тюрьму</w> пожизненно после того, как его признали виновным в преступлении.",
                                "zh": "他在被判有罪后被终身<w>监禁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imprison",
                        "incarcerate",
                        "lock up",
                        "detain"
                    ],
                    "antonyms": [
                        "release",
                        "free",
                        "liberate"
                    ],
                    "common_phrases": [
                        "be jailed for",
                        "jailed for life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать кого-либо в тюрьму или следственный изолятор в качестве наказания или меры пресечения.",
                        "zh": "作为惩罚或法律措施将某人关进监狱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сажать в тюрьму",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "заключать в тюрьму",
                                "target_lang_sense_clarification": "официальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监禁",
                                "target_lang_sense_clarification": "法律或正式用语"
                            },
                            {
                                "target_lang_word": "关进监狱",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                }
            ]
        }
    ]
