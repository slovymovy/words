                                "target_lang_sense_clarification": "kelime grubu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说法",
                                "target_lang_sense_clarification": "表达方式或词语"
                            },
                            {
                                "target_lang_word": "用语",
                                "target_lang_sense_clarification": "使用的词汇或短语"
                            },
                            {
                                "target_lang_word": "成语",
                                "target_lang_sense_clarification": "固定短语或习语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab36234b-e6e3-31c9-9272-566585fd5603",
                    "sense_definition": "Действие по глаголу «выражать»; процесс передачи мыслей, чувств или воли вовне.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В знак <w>выражения</w> глубокой благодарности мы подарили им цветы.",
                            "target_lang_translations": {
                                "en": "As an <w>expression</w> of deep gratitude, we gave them flowers.",
                                "tr": "Derin şükranlarımızın bir <w>ifadesi</w> olarak onlara çiçek verdik.",
                                "zh": "为了<w>表示</w>深深的谢意，我们送了他们鲜花。"
                            }
                        },
                        {
                            "text": "Свободное <w>выражение</w> своего мнения является важным правом человека.",
                            "target_lang_translations": {
                                "en": "The free <w>expression</w> of one's opinion is an important human right.",
                                "tr": "Kendi fikrini özgürce <w>ifade etmesi</w> önemli bir insan hakkıdır.",
                                "zh": "自由地<w>表达</w>个人观点是重要的人权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "изъявление"
                    ],
                    "antonyms": [
                        "сокрытие",
                        "утаивание"
                    ],
                    "common_phrases": [
                        "выражение благодарности",
                        "выражение сочувствия",
                        "найти выражение",
                        "форма выражения"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of expressing; the process of conveying thoughts, feelings, or will outwardly.",
                        "tr": "Düşünceleri, duyguları veya iradeyi dışa vurma eylemi; dile getirme süreci.",
                        "zh": "指表达思想、情感或意愿的行为或过程。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expression",
                                "target_lang_sense_clarification": "act of conveying thoughts or feelings"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ifade",
                                "target_lang_sense_clarification": "duygu ve düşünceleri belirtme"
                            },
                            {
                                "target_lang_word": "dışavurum",
                                "target_lang_sense_clarification": "içtekini dışa yansıtma"
                            },
                            {
                                "target_lang_word": "beyan",
                                "target_lang_sense_clarification": "açıklama, bildirme"
                            }
                        ],
                        "zh": [
