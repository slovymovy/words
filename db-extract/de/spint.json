                    {
                        "sense_id": "bcfd108f-c30f-3f21-b20e-ce4a6cb61f9c",
                        "entry_id": "b40fb0e8-c20b-3e36-bcd8-927ab38a0376",
                        "glosses": [
                            "regionaler Name für den Bienenfresser , in Zusammensetzungen für seine Verwandten gebraucht"
                        ],
                        "tags": [
                            "Merops apiaster"
                        ],
                        "examples": [
                            {
                                "example_id": "f53a5af9-0464-4b40-8cfd-43456a6ff5d2",
                                "sense_id": "bcfd108f-c30f-3f21-b20e-ce4a6cb61f9c",
                                "text": "Der Blauwangenspint (Merops persicus) gehört zur Gattung der Bienenfresser."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f8e4b7e-4e68-3159-85de-6bf1698fb1fa",
                        "entry_id": "b40fb0e8-c20b-3e36-bcd8-927ab38a0376",
                        "glosses": [
                            "altes Hohlmaß für Getreide, 1/16 Scheffel (je nach Region 2,5 bis 7 l)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2358da-48ec-4a93-91fd-5b71278d092b",
                                "sense_id": "6f8e4b7e-4e68-3159-85de-6bf1698fb1fa",
                                "text": "Aus einer Abrechnung von 1690: 6 Spint Roggen zur Mühle gebracht, 1 Spint Weizen zur Mühle gebracht, 31 Stüber bezahlt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
