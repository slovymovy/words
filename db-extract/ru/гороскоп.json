                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6006a20-0ad7-4085-9c3a-812210f0e6c3",
                        "source_entry_id": "f5cd080b-d626-3110-9eae-db16a033a41d",
                        "source_sense_id": "e494faa6-f0c4-35c3-8a6d-478efe8b7f2e",
                        "target_lang_word": "horoscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horoscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64d9cdbd-7470-3cf8-a483-ba8770fc0a8e",
                                        "entry_id": "4820845d-ad02-3c52-9360-aa6619d99b60",
                                        "glosses": [
                                            "The position of the planets and stars at the moment of someone's birth; a diagram of such positions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                        "entry_id": "4820845d-ad02-3c52-9360-aa6619d99b60",
                                        "glosses": [
                                            "An astrological forecast of a person's future based on such information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c08229b-8258-4f3d-b548-b13e2692d49e",
                                                "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                                "text": "We must talk of the force of circumstances, of imperative necessity, and find fault with the cruel horoscope which ordained such a fate."
                                            },
                                            {
                                                "example_id": "d79ac86d-ddbc-4d16-84bf-ef85683d8512",
                                                "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                                "text": "\"Ah, min hart! And what day was it?\"\n\"How curious you are! Do you want to cast my horoscope?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd6d2825-b561-4f21-b3a0-5d4a01135274",
                        "source_entry_id": "f5cd080b-d626-3110-9eae-db16a033a41d",
                        "source_sense_id": "e494faa6-f0c4-35c3-8a6d-478efe8b7f2e",
