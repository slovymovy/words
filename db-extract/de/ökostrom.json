                "senses": [
                    {
                        "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                        "entry_id": "82159597-0826-3683-879f-eaf2453ba3c0",
                        "glosses": [
                            "elektrische Energie, die aus erneuerbaren Energiequellen gewonnen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ade3c570-19a0-436f-a4ce-788a1ec3ac05",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Bei der Produktion von Ökostrom wird weltweit am stärksten auf Windenergie gesetzt.“"
                            },
                            {
                                "example_id": "0cefce88-4d16-4e57-9e14-17fd6a5b29b6",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Wie kann ich meinen Betrieb auf Ökostrom umstellen?“"
                            },
                            {
                                "example_id": "e58af36d-167a-48cb-8367-0f2f3b069b74",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "Wenn Sie Ökostrom beziehen wollen, achten Sie auf Ökostromlabel wie dem 'ok-power-label' oder dem 'Grüner Strom Label'."
                            },
                            {
                                "example_id": "f7a2b4ea-5f67-45cc-ae0f-e549ab9aaaf0",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Erneuerbare Energien (gef. gem. EEG)“ bedeutet lediglich: Hier zahlen sie als Kunde für den von Ihnen bezogenen Strom die EEG-Abgabe, eine Abgabe nach dem 'Erneuerbaren Energie Gesetz (EEG)'. Dieses Kriterium sagt nichts über die Herkunft des Stromes aus. Dieser Strom wird also auch in Kohle- und Gaskraften oder Atommeilern produziert und ist garantiert kein Ökostrom."
                            },
                            {
                                "example_id": "7294729b-328b-4914-86b7-5d5c76221304",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Was kommt aus der Steckdose, wenn man bei seinem Stromanbieter extra zahlt für «Ökostrom»? Auf jeden Fall kein reiner Ökostrom.“"
                            },
                            {
                                "example_id": "bca9897b-25e5-4636-a7a4-c106abe4f747",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Am besten fürs Klima ist es, wenn die Wärmepumpe mit Ökostrom betrieben wird.“"
                            },
                            {
                                "example_id": "94cd0d93-1e4f-4e49-ac20-603bf2943427",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Privathaushalte erzeugen selbst Ökostrom und handeln diesen untereinander, etwa so, wie man Eier vom Bauern nebenan holt. Das soll den Umstieg auf erneuerbare Energien attraktiver machen. Ein Modellprojekt startet jetzt im Allgäu.“"
                            },
                            {
                                "example_id": "7829d67f-740d-43bb-a247-8b49f61de5e1",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Die Stadt Haßfurt produziert durch regenerative Energieerzeugung durch Wind, Sonne und Biogas mehr Strom, als Privathaushalte und Industrie dort verbrauchen. Damit ist Haßfurt ein echtes Vorbild bei der Erzeugung von Ökostrom.“"
                            },
                            {
                                "example_id": "4471070b-c385-467c-9ec0-c80bda803610",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Die gesamte deutsche Chemieindustrie brauche auf dem Weg zur Klimaneutralität bis 2050 \"gigantisch viel Ökostrom\".“"
                            },
                            {
                                "example_id": "789cfee6-0057-4688-8ff2-0018d6e107a5",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„[…] in Südspanien laufen drei Chemiewerke des Bayer-Konzerns ab 2022 mit 100 Prozent Ökostrom aus einem 590 Megawatt Solarkraftwerk.“"
                            },
                            {
                                "example_id": "33e5541b-f323-430a-b64e-a3ef0d22c865",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Um über den Bedarf hinaus verfügbaren Ökostrom zu \"bunkern\", setzen diverse Unternehmen auf Großbatterie-Anlagen - entweder aus ausgedienten oder neuen Batterien von Elektroautos. Gleich drei solcher Anlagen befinden sich in Nordrhein-Westfalen.“"
                            },
                            {
                                "example_id": "51806f41-1929-402f-a18c-92058fcd9563",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Österreichs Haushalte finanzieren einen Gutteil der Kosten für die Energiewende hin zu mehr Ökostrom. Zu viel, wenn es nach der Arbeiterkammer geht. Denn die Haushalte müssten 40 bis 50 Prozent der Ökostromkosten tragen, verbrauchten jedoch nur etwa ein Viertel des Stroms.“"
                            },
                            {
                                "example_id": "91f631ce-be36-4202-9faa-c8df5727514f",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "Sie verzichten auf Ökostrom, weil er zur Zeit zu teuer ist."
                            },
                            {
                                "example_id": "d5e34c4e-cce0-47d3-8466-870a6674425b",
                                "sense_id": "8ec87ef4-e495-38c9-adbb-2bc6e005f79b",
                                "text": "„Ökostrom ist teuer, nicht billig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
