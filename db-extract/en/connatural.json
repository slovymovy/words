                "senses": [
                    {
                        "sense_id": "84ffc063-b384-3be8-965f-6a46c5a944ad",
                        "entry_id": "ce2282e8-c7fa-3a31-bfeb-0c5e9e4d7fb9",
                        "glosses": [
                            "Similar in nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559d2c52-884d-414c-ac21-01ad2292ca27",
                                "sense_id": "84ffc063-b384-3be8-965f-6a46c5a944ad",
                                "text": "And mix with our connatural dust"
                            },
                            {
                                "example_id": "158f05f8-faf5-42da-a21e-e911b3f34275",
                                "sense_id": "84ffc063-b384-3be8-965f-6a46c5a944ad",
                                "text": "These inflowing potential essences are connatural with the astral conduits thus provided for their actualization, pursuant to a law of attrition and homogeneity."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0b94312-6374-3e1f-9906-946ffc8a05b9",
                        "entry_id": "ce2282e8-c7fa-3a31-bfeb-0c5e9e4d7fb9",
                        "glosses": [
                            "Inborn; inherent; natural."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ccc3fb-834a-4476-959f-10162b8ef375",
                                "sense_id": "e0b94312-6374-3e1f-9906-946ffc8a05b9",
                                "text": "It is true, that it is vvith the connatural Principles inſcribed in our Minds as it is vvith our Faculties, they lye more torpid, and inactive, and inevident, unleſs they are avvakened and exerciſed, like a ſpark involved in aſhes; […]"
                            },
                            {
                                "example_id": "513f57ea-78b5-4152-8300-36827470517a",
                                "sense_id": "e0b94312-6374-3e1f-9906-946ffc8a05b9",
                                "text": "These Affections are in truth Connatural to us."
                            }
                        ]
                    }
                ],
