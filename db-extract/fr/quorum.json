        "fr-extract.jsonl": [
            {
                "entry_id": "ed83ff71-0fe7-311b-a4f7-92d601a88323",
                "word": "quorum",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "762680bd-5d38-4aa3-8ae8-d9c2dbe21f8c",
                        "entry_id": "ed83ff71-0fe7-311b-a4f7-92d601a88323",
                        "tags": [
                            "plural"
                        ],
                        "form": "quorums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26b0287c-170f-3588-a32d-73f419871111",
                        "entry_id": "ed83ff71-0fe7-311b-a4f7-92d601a88323",
                        "glosses": [
                            "Nombre des membres d’une réunion qui est nécessaire pour que les décisions que cette réunion doit prendre soient valables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b096e9c-ed2b-49a3-bd41-8218b8657ac4",
                                "sense_id": "26b0287c-170f-3588-a32d-73f419871111",
                                "text": "Le quorum n’a pas été atteint."
                            },
                            {
                                "example_id": "508db431-5c85-40f4-9946-e384e05d846f",
                                "sense_id": "26b0287c-170f-3588-a32d-73f419871111",
                                "text": "Le conseil d'administration tient au moins une séance toutes les cinq semaines et son quorum est de trois membres."
                            },
                            {
                                "example_id": "93a12bb4-7064-492f-89e9-79b00b84e9a5",
                                "sense_id": "26b0287c-170f-3588-a32d-73f419871111",
                                "text": "Le quorum est atteint lorsque la moitié au moins des membres composant la commission est présente, y compris par téléconférence, ou a donné mandat à un autre membre."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f1ef3ef-3ff1-3cd4-8bc4-5863cfcc3c95",
                        "entry_id": "ed83ff71-0fe7-311b-a4f7-92d601a88323",
                        "glosses": [
                            "Quorum bactérien."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d87934e0-617f-45ed-92d0-707e735bf0b8",
                        "source_entry_id": "ed83ff71-0fe7-311b-a4f7-92d601a88323",
                        "target_lang_word": "quorum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quorum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79db77d6-caf1-3a4d-a4f3-f98ec4ac8dc0",
                                        "entry_id": "8269dff1-e38f-3586-ba6b-b6030b977f0f",
                                        "glosses": [
                                            "The minimum number of members required for a group to officially conduct business and to cast votes, often but not necessarily a majority or supermajority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b4be11-4706-4f2c-b4df-51fdbde19e83",
                                                "sense_id": "79db77d6-caf1-3a4d-a4f3-f98ec4ac8dc0",
                                                "text": "We can discuss the issue tonight but cannot vote until we have a quorum."
                                            },
                                            {
                                                "example_id": "c1f3de60-a7a8-47cf-adc8-8fbe8bd6cca4",
                                                "sense_id": "79db77d6-caf1-3a4d-a4f3-f98ec4ac8dc0",
                                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation.\nThe surprise turn of events quickly led to public accusations of betrayal among Democrats, as the House now has the required two-thirds of members necessary for a quorum."
                                            },
                                            {
                                                "example_id": "b1d2592d-83e8-4801-b57a-f26a981fb3a4",
                                                "sense_id": "79db77d6-caf1-3a4d-a4f3-f98ec4ac8dc0",
                                                "text": "They may not be using the same sort of hard-charging tactics we saw in the first Trump administration, when they would deny Republicans quorums for votes in committee or those kinds of things, but what we will see is they’re going to ask hard questions and make made-for-TV moments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47751360-f378-329d-a887-13deb76a062c",
                                        "entry_id": "8269dff1-e38f-3586-ba6b-b6030b977f0f",
                                        "glosses": [
                                            "A selected body of persons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9e8713b-a6f1-3ff9-b13c-5dcaca7607d0",
                                        "entry_id": "8269dff1-e38f-3586-ba6b-b6030b977f0f",
                                        "glosses": [
                                            "The minimum number of votes that a distributed transaction has to obtain in order to be allowed to perform an operation in a distributed system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
