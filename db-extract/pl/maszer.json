                        "translation_id": "5f3ae907-b1dd-4a12-af40-a8a1d961319e",
                        "source_entry_id": "2c5ba876-5016-35d7-bca6-51a856119a54",
                        "source_sense_id": "e311dd0d-d316-3bb5-849e-9d692f8ef706",
