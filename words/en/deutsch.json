                    "semantic_group_id": "german_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Arthur <w>Deutsch</w>.",
                            "target_lang_translations": {
                                "de": "Die örtliche Bibliothek wurde nach dem Philanthropen Arthur <w>Deutsch</w> benannt."
                            }
                        },
                        {
                            "text": "We invited Professor <w>Deutsch</w> to deliver the keynote lecture on physics.",
                            "target_lang_translations": {
                                "de": "Wir haben Professor <w>Deutsch</w> eingeladen, den Hauptvortrag über Physik zu halten."
                            }
