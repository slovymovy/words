                "senses": [
                    {
                        "sense_id": "c0632063-4975-34e2-9332-dad6340fd177",
                        "entry_id": "616957de-87c3-3d1d-b8a1-6cbcd813b6c1",
                        "glosses": [
                            "used clothes"
                        ],
                        "tags": [
