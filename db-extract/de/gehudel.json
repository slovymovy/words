                "senses": [
                    {
                        "sense_id": "d88948ea-0169-335a-9734-d2cbea2c47c0",
                        "entry_id": "9cc27c13-a329-36d5-b9c0-adea57e9b193",
                        "glosses": [
                            "ständiges Hudeln; unsaubere, nicht gewissenhafte Arbeit"
                        ],
                        "tags": [
                            "casual",
                            "derogatory",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "8660d7dd-5f83-4c42-863b-d74552ece189",
                                "sense_id": "d88948ea-0169-335a-9734-d2cbea2c47c0",
                                "text": "Ich denke, dass jetzt offenkundig wird, mit welchem Gehudel und mit welcher Chaotik hier vorgegangen wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "900f7262-c955-30e2-9ccb-a4d1683ee89d",
                        "entry_id": "9cc27c13-a329-36d5-b9c0-adea57e9b193",
                        "glosses": [
                            "gemeines Volk"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5b2f8ff4-eb81-4176-958c-cfc8412ec815",
                                "sense_id": "900f7262-c955-30e2-9ccb-a4d1683ee89d",
                                "text": "Frei will ich leben und also sterben,/ Niemand berauben und niemand beerben/ Und auf das Gehudel unter mir/ Leicht wegschauen von meinem Tier."
                            },
                            {
                                "example_id": "99e39419-1260-45d5-8447-b0ec709e995f",
                                "sense_id": "900f7262-c955-30e2-9ccb-a4d1683ee89d",
                                "text": "Die Erzählung \"Das Gesetz\" von Thomas Mann beschreibt, wie es Moses gelingt, aus dem Gehudel dem Herrn ein heiliges Volk aufzurichten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
