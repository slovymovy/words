                "senses": [
                    {
                        "sense_id": "e6aee4fb-3349-33a2-8715-fb929272671a",
                        "entry_id": "d4abff20-db96-3a60-99fa-b644816a77f6",
                        "glosses": [
                            "Redonner un état instinctif, spontané, non affecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a35140b-2a6b-4f1a-9705-3667a7e744c5",
                                "sense_id": "e6aee4fb-3349-33a2-8715-fb929272671a",
                                "text": "Le but du psychodrame est de réveiller, de « réchauffer » la spontanéité, de rendre à l’individu le sens de l’instinct ; il faut « déconserver » l’individu."
                            },
                            {
                                "example_id": "300b9e93-a623-4b9f-86a7-3bdb4cba2c26",
                                "sense_id": "e6aee4fb-3349-33a2-8715-fb929272671a",
                                "text": "Pour Moreno, le psychodrame par l’action groupale vise à déconserver ce qu’il appelle « les conserves sociales »."
                            }
                        ]
                    }
                ],
