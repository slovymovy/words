                                "target_lang_word": "小伙子",
                                "target_lang_sense_clarification": "年轻男子，口语"
                            },
                            {
                                "target_lang_word": "男生",
                                "target_lang_sense_clarification": "男性青年"
                            },
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "俚语中指年轻男子"
                            }
                        ]
