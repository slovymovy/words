        "fr-extract.jsonl": [
            {
                "entry_id": "1a69a320-b152-3f44-b297-a5069daf140a",
                "word": "Axone",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ac60ea0-2f38-3538-8400-a4632acb69bb",
                        "entry_id": "1a69a320-b152-3f44-b297-a5069daf140a",
                        "glosses": [
                            "Société de vente d’automobiles, filiale de Volkswagen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522ef048-c6b7-4526-ab0e-1254eb3e56e8",
                                "sense_id": "0ac60ea0-2f38-3538-8400-a4632acb69bb",
                                "text": "Un peu plus loin dans l’avenue, chez Axone Automobile, un concessionnaire Volkswagen, on n’est pas plus inquiets : « Quand ils arrivent ici, les clients ont déjà choisi, donc je ne crois pas que ce soit une mesure comme ça qui va les faire basculer d’un SUV vers une citadine »."
                            },
                            {
                                "example_id": "2c09c635-1970-4316-a83d-2770e556d5ff",
                                "sense_id": "0ac60ea0-2f38-3538-8400-a4632acb69bb",
                                "text": "La filiale de distribution de Volkswagen est en passe d’acquérir l’entité Axone Automobiles, détenue par le groupe Vulcain."
                            },
                            {
                                "example_id": "22e465b7-54a2-45f3-a715-3a8f4fcc8ee3",
                                "sense_id": "0ac60ea0-2f38-3538-8400-a4632acb69bb",
                                "text": "Selon l’Autorité de la concurrence, via sa filiale Axone Automobiles, Volkswagen Group Retail France (VGRF) s’est positionné mi-août pour reprendre trois sites Volkswagen au groupe Neubauer."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2ee48c3d-0ea7-3262-b9ee-fd0482189afc",
                "word": "axone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0342969b-649f-4890-b4c5-93f495c0413e",
                        "entry_id": "2ee48c3d-0ea7-3262-b9ee-fd0482189afc",
                        "tags": [
                            "plural"
                        ],
                        "form": "axones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                        "entry_id": "2ee48c3d-0ea7-3262-b9ee-fd0482189afc",
                        "glosses": [
                            "Partie allongée d’un neurone qui permet le passage de l’information sous forme d’impulsions électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1551ecdf-b9a9-48cb-a0b9-85068f49ce68",
                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                "text": "La gaine isolante que constitue la stratification myélinique est interrompue à intervalles réguliers par des étranglements (nœuds de Ranvier) au niveau desquels l’axone est dénudé."
                            },
                            {
                                "example_id": "7fc20d6d-e312-4a10-8ea5-c95fdb99e052",
                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l’axone."
                            }
                        ]
                    }
                ],
