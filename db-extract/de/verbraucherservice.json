                "senses": [
                    {
                        "sense_id": "8b2eab3a-b4be-3960-8742-8de38d7807f6",
                        "entry_id": "069726f8-4873-3e4a-87ec-21f579a34a14",
                        "glosses": [
                            "Service, der von Firmen für Verbraucher eingerichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4915e39b-5e5b-4ba3-9f83-9928f4cacf7b",
                                "sense_id": "8b2eab3a-b4be-3960-8742-8de38d7807f6",
                                "text": "„Heute trauen sich viele Verbraucher nicht mehr an einen Hefeteig ran, hat Josefa Stegherr, Ökotrophologin beim Verbraucherservice Bayern in Augsburg, beobachtet.“"
                            },
                            {
                                "example_id": "438e26ba-99ca-43f5-a0bd-e9f06795015d",
                                "sense_id": "8b2eab3a-b4be-3960-8742-8de38d7807f6",
                                "text": "„Verbraucher können sich an den Ombudsmann wenden, wenn sie mit dem Schufa-Verbraucherservice keine Einigung in einem Konflikt erzielen konnten.“"
                            },
                            {
                                "example_id": "a039ac51-97c2-4a21-996a-8aa5ccae6b81",
                                "sense_id": "8b2eab3a-b4be-3960-8742-8de38d7807f6",
                                "text": "„Den Packungsteil mit der Kennzeichnung L9191AM005, die sich im Feld des Mindesthaltbarkeitsdatums befindet, sollten sie ausschneiden und an den Iglo Verbraucherservice, Postfach 570 521, 22774 Hamburg schicken.“"
                            },
                            {
                                "example_id": "4759a85c-ffb3-4599-bf74-d70e1504fac9",
                                "sense_id": "8b2eab3a-b4be-3960-8742-8de38d7807f6",
                                "text": "„Seiner Behörde hat Kurth längst auch den Ruf einer agilen Verbraucherschutzorganisation verpasst. Nicht nur auf der Homepage im Internet steht \"Verbraucherservice\" ganz oben. Ob Mobilfunkstrahlung, Rufnummernmissbrauch oder digitale Signatur, \"die Leute rufen immer zuerst bei uns an\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
