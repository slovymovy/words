                "senses": [
                    {
                        "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                        "entry_id": "f0e66836-55e9-3509-b6e3-9fdf2eed8fe7",
                        "glosses": [
                            "Liebe, innige und gefühlsbetonte Beziehung zur Natur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "141afa56-d14b-4a67-ae73-f9454e588f4f",
                                "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                                "text": "„Kanadische Forscher haben gezeigt, dass Naturverbundenheit unsere Glücksfähigkeit verbessern kann.“"
                            },
                            {
                                "example_id": "10486e21-ca0e-4ed8-9938-1a289457e6da",
                                "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                                "text": "„Zudem neigen ja Menschen, die in enger Naturverbundenheit leben, nie zu Unmäßigkeiten.“"
                            },
                            {
                                "example_id": "02f53dc5-a5a4-4a4d-81fd-ee149cc27510",
                                "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                                "text": "„Lehm und Staub symbolisieren Naturverbundenheit, aber auch Vergänglichkeit und können für den Kreislauf des Lebens stehen.“"
                            },
                            {
                                "example_id": "b4242fe1-9d3c-4920-98e4-4099af5f5b40",
                                "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                                "text": "„In der Naturverbundenheit der stark geprägten Landschaftsstimmung finden wir das größere Leben wieder und das tiefere Sein: Die Heimat nimmt uns auf.“"
                            },
                            {
                                "example_id": "dd42084c-5bdf-47ec-874a-45609459efa1",
                                "sense_id": "5c1bcb8b-5063-3d0e-8c91-9440315e6db1",
                                "text": "„Umweltschutzverhalten kann gelernt und Naturverbundenheit durch Naturnähe gesteigert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
