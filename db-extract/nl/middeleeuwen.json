                        "entry_id": "f64a150d-711c-3b44-ba00-8a3fec3d59d7",
                        "glosses": [
                            "de periode tussen ongeveer 300 n.Chr. tot 1500 n.Chr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16210681-aed6-479f-b283-eaaefcbf99b0",
                                "sense_id": "424d44e6-681b-364c-9058-c72f60d38db2",
                                "text": "In de middeleeuwen zag het dagelijks leven van de mensen er totaal anders uit dan nu."
                            },
                            {
                                "example_id": "ddb7c8ac-413f-477f-ad15-7de52f703c72",
                                "sense_id": "424d44e6-681b-364c-9058-c72f60d38db2",
                                "text": "`Zwarte Piet' of 'Pietje Pik', zo noemde het volk in de middeleeuwen de duivel."
                            },
                            {
                                "example_id": "7698c53c-f975-43a9-9cc3-691610f6ae60",
                                "sense_id": "424d44e6-681b-364c-9058-c72f60d38db2",
                                "text": "In de Middeleeuwen werd jaloezie geassocieerd met het verdedigen van je eer, en stond daarmee als positief te boek."
                            },
                            {
                                "example_id": "39770de0-91fd-47ee-91d5-0687d46a42e1",
                                "sense_id": "424d44e6-681b-364c-9058-c72f60d38db2",
                                "text": "In de Middeleeuwen werd jaloezie geassocieerd met het verdedigen van je eer, en stond daarmee als positief te boek."
                            }
                        ]
                    }
                ],
