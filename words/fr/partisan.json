    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ad926f1-8cd6-3ad6-9557-c83b5c0c607f",
                    "sense_definition": "Personne qui soutient activement une cause, une doctrine, un projet ou une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le député s'est présenté comme un fervent <w>partisan</w> du développement durable. Tout le monde a applaudi son intervention."
                        },
                        {
                            "text": "Les <w>partisans</w> de cette réforme soulignent ses nombreux avantages économiques pour le pays."
                        }
                    ],
                    "synonyms": [
                        "défenseur",
                        "adepte",
                        "partisan"
                    ],
                    "antonyms": [
                        "opposant",
                        "adversaire",
                        "détracteur"
                    ],
                    "common_phrases": [
                        "fervent partisan",
                        "ardent partisan"
                    ]
                },
                {
                    "sense_id": "a1baa2c4-a88c-39b3-885e-c8339537a59b",
                    "sense_definition": "Combattant volontaire d'une troupe armée irrégulière, notamment dans la Résistance en temps de guerre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'occupation, les <w>partisans</w> menaient des actions de sabotage dans les montagnes."
                        },
                        {
                            "text": "Ce monument rend un hommage solennel aux <w>partisans</w> tombés lors de la libération."
                        }
                    ],
                    "synonyms": [
                        "résistant",
                        "guérillero",
                        "franc-tireur"
                    ],
                    "common_phrases": [
                        "guerre de partisans",
                        "groupe de partisans"
                    ]
                },
                {
                    "sense_id": "aa55d92b-42ee-3d5b-90c6-3c35b8f633a7",
                    "sense_definition": "Sous l'Ancien Régime, financier qui prenait à ferme les revenus de l'État ou la levée des impôts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, ce riche <w>partisan</w> collectait les taxes au nom du roi."
                        },
                        {
                            "text": "La fortune immense de ce <w>partisan</w> suscitait la jalousie des nobles de la cour."
                        }
                    ],
                    "synonyms": [
                        "traitant",
                        "fermier général"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "histoire"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6c92c5c-53af-3779-98fc-29b408c8b1d1",
                    "sense_definition": "Qui est favorable à une idée, à une décision ou à un projet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur n'est pas <w>partisan</w> de modifier les règles actuelles de l'entreprise."
                        },
                        {
                            "text": "Nous sommes tous <w>partisans</w> d'un dialogue ouvert entre les deux équipes."
                        }
                    ],
                    "synonyms": [
                        "favorable"
                    ],
                    "antonyms": [
                        "défavorable",
                        "hostile"
                    ],
                    "common_phrases": [
                        "être partisan de"
                    ]
                },
                {
                    "sense_id": "42e97748-9291-3f7e-92f7-c20da9958c29",
                    "sense_definition": "Qui fait preuve de parti pris, qui défend de façon partiale les intérêts d'une cause ou d'un parti.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a été vivement critiqué pour son analyse trop <w>partisane</w> de l'élection présidentielle."
                        },
                        {
                            "text": "Pour garantir un débat équitable, il faut éviter d'adopter une attitude <w>partisane</w>."
                        }
                    ],
                    "synonyms": [
                        "partial",
                        "biaisé",
                        "sectaire"
                    ],
                    "antonyms": [
                        "impartial",
                        "neutre",
                        "objectif"
                    ],
                    "common_phrases": [
                        "esprit partisan",
                        "vision partisane",
                        "querelle partisane"
                    ]
                }
            ]
        }
    ]
