                                "target_lang_word": "отрицательная величина",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательный результат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负数",
                                "target_lang_sense_clarification": "数学概念"
                            }
