            "senses": [
                {
                    "sense_id": "ddec1c87-6625-39c5-b3b9-fe6378ecba6d",
                    "sense_definition": "Féminin singulier de <w>quel</w>, servant à interroger sur l'identité ou la nature d'une personne ou d'une chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À <w>quelle</w> heure commence votre réunion de travail ce matin ?"
                        },
                        {
                            "text": "Dans <w>quelle</w> ville as-tu passé tes dernières vacances d'été ?"
                        }
                    ],
                    "common_phrases": [
                        "à quelle heure",
                        "de quelle manière",
                        "quelle direction"
                    ]
                },
                {
                    "sense_id": "0e09ffeb-0093-3908-9c6a-8da7d79e9484",
                    "sense_definition": "Féminin singulier de <w>quel</w>, servant à introduire une exclamation pour exprimer l'admiration, l'étonnement ou une vive émotion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quelle</w> chance nous avons d'être réunis tous ensemble aujourd'hui !"
                        },
                        {
                            "text": "<w>Quelle</w> bonne idée d'avoir apporté ce délicieux gâteau pour le dessert !"
                        }
                    ],
                    "common_phrases": [
