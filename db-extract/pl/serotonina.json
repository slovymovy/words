                    {
                        "sense_id": "175eeb12-9cb8-37ee-b79f-b6933ca4bff4",
                        "entry_id": "66badb80-f8e2-3a29-a1fb-2eabfb26faff",
                        "glosses": [
                            "neuroprzekaźnik regulujący ciśnienie krwi i działanie ośrodkowego układu nerwowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be857af1-8881-49e4-a5f1-1a84656e6132",
                                "sense_id": "175eeb12-9cb8-37ee-b79f-b6933ca4bff4",
                                "text": "Przeprowadzone badania wykazały, że ludzie, którzy cierpią na depresję, mają obniżony poziom serotoniny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efeeddbb-454b-417b-b0c4-8ee2e26977c9",
                        "source_entry_id": "66badb80-f8e2-3a29-a1fb-2eabfb26faff",
                        "source_sense_id": "175eeb12-9cb8-37ee-b79f-b6933ca4bff4",
                        "target_lang_word": "serotonin",
