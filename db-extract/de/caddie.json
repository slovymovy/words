                                    {
                                        "sense_id": "657440f7-165f-3343-998e-1a0b01f0b2b8",
                                        "entry_id": "ae880848-1796-3d49-a651-96993ddf04e2",
                                        "glosses": [
                                            "iemand die de clubs draagt en soms ook raad kan geven aan de speler"
                                        ],
                                        "tags": [
                                            "beroep",
                                            "golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dd3aee7-4d7a-42aa-bf89-1a171193567d",
                                                "sense_id": "657440f7-165f-3343-998e-1a0b01f0b2b8",
                                                "text": "Een caddie moet volgens hem over een goed karakter beschikken, fit zijn en uiteraard kennis van golf hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e7d7c3-82da-303f-b82f-bb3b72b490d0",
                                        "entry_id": "ae880848-1796-3d49-a651-96993ddf04e2",
                                        "glosses": [
                                            "(golf) koker of wagentje waarin de clubs worden meegedragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a6aefd-e432-4239-aa20-4c3fb9073558",
                                                "sense_id": "b2e7d7c3-82da-303f-b82f-bb3b72b490d0",
                                                "text": "In de uitzending van het programma gaan er allerlei dingen mis tijdens een golfsessie, waarbij Maradona flink in het ootje wordt genomen. De Argentijn kan er niet om lachen, met een vedette valt immers niet te sollen. Hij rijdt boos weg in een caddie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0113f51f-a40b-3f2d-b2ab-dc1fd01cb491",
                                        "entry_id": "ae880848-1796-3d49-a651-96993ddf04e2",
                                        "glosses": [
                                            "rolwagentje voor boodschappen"
                                        ],
