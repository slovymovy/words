                ],
                "senses": [
                    {
                        "sense_id": "c8a0e8ff-0773-3e79-90b1-9aa7900f4374",
                        "entry_id": "cd144db5-6f74-30a7-b973-95dc490b97a9",
                        "glosses": [
                            "Donner un caractère paroissial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fd135d-4799-4a98-9169-2775f75405b5",
                                "sense_id": "c8a0e8ff-0773-3e79-90b1-9aa7900f4374",
                                "text": "On peut tout aussi bien souligner qu’il s'est employé à paroissialiser la vie monastique afin que celle-ci puisse constituer l’armature — ou le noyau dur — d’une chrétienté villageoise réinventée."
                            },
                            {
                                "example_id": "18a4f54d-75b0-47d1-9512-2b38d364d12b",
                                "sense_id": "c8a0e8ff-0773-3e79-90b1-9aa7900f4374",
                                "text": "Un pasteur ne saurait « paroissialiser » les fidèles sans commettre une sorte d’hérésie."
                            },
                            {
                                "example_id": "145e2a02-c6e7-41a8-a6ae-86e3aa041bf3",
                                "sense_id": "c8a0e8ff-0773-3e79-90b1-9aa7900f4374",
                                "text": "On pervertit ainsi la notion de subsidiarité en cherchant à «paroissialiser» l'exploration minière."
                            }
                        ]
                    }
                ],
