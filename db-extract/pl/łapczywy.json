                "translations": [
                    {
                        "translation_id": "7728ab68-6323-46cd-8f45-f5f230fa48c9",
                        "source_entry_id": "baa0896e-5cb2-3502-be7d-eb0a3fd5200d",
                        "source_sense_id": "35ab52c8-61b3-39e2-b248-ed6b0c0665c9",
