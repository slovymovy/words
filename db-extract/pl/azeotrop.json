                        "sense_id": "4ed98178-d9ea-3809-9dd1-409d32c2446b",
                        "entry_id": "1e5fe1e4-7c02-3ab4-a3ac-6f96919fd9d3",
                        "glosses": [
                            "mieszanina cieczy, której temperatura wrzenia pod pewnym ciśnieniem jest wyższa lub niższa od temperatury wrzenia jej poszczególnych składników i której para ma taki sam skład, co postać ciekła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb44c154-ab8f-468e-bf5e-0c33c53fb816",
                                "sense_id": "4ed98178-d9ea-3809-9dd1-409d32c2446b",
                                "text": ", Wydawnictwo Naukowe PWN, Warszawa 2005.."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e53088f2-06ce-436e-8ef7-b32e53ebbee8",
                        "source_entry_id": "1e5fe1e4-7c02-3ab4-a3ac-6f96919fd9d3",
                        "source_sense_id": "4ed98178-d9ea-3809-9dd1-409d32c2446b",
                        "target_lang_word": "azeotrope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azeotrope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e69cb0f5-f73b-3e80-8259-1e988f69a98f",
                                        "entry_id": "ec1839a5-68c6-3f5c-8632-b392ac7b0887",
                                        "glosses": [
                                            "A mixture of two or more substances whose liquid and gaseous forms have the same composition (at a certain pressure); the substances cannot be separated by normal distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ecb87d7-da6f-40a7-9e5e-5c9440f41b8b",
                                                "sense_id": "e69cb0f5-f73b-3e80-8259-1e988f69a98f",
                                                "text": "The formation of azeotropes due to deviations from Raoult's law was discussed in Section 1.3. An azeotrope is a mixture that, at a given pressure (the azeotropic pressure), boils at a constant temperature (the azeotropic temperature), and has the same composition (the azeotropic composition) in the equilibrium vapor and liquid phases. Homogeneous azeotropes are those that form one liquid phase at equilibrium with the vapor; heterogeneous azeotropes are those that form two liquid phases at equilibrium with each other and the vapor."
                                            },
                                            {
                                                "example_id": "b35b5f0a-f462-42f7-b7db-34b46275cd36",
                                                "sense_id": "e69cb0f5-f73b-3e80-8259-1e988f69a98f",
                                                "text": "When a ternary azeotrope does exist, the curves intersect at the same point.\nThe presence of a unitary azeotrope curve is not a prerequisite for the generation of a ternary azeotrope."
                                            },
                                            {
                                                "example_id": "8667bc81-b702-4b10-91ca-81c631448bcb",
                                                "sense_id": "e69cb0f5-f73b-3e80-8259-1e988f69a98f",
                                                "text": "As the boiling point of HCl–H₂O azeotrope is lower than that of azeotrope (HNO₃–H₂O), hydrochloric acid can be eliminated efficiently by successive evaporations with nitric acid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "azeotrope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26776e07-e625-313d-8a9c-e7a6a63469c1",
                                        "entry_id": "abf57ba7-c513-3394-a1ec-3fc3ce80167d",
                                        "glosses": [
                                            "To create a mixture of this kind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
