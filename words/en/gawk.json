{
    "word_family": [
        "gawky",
        "gawkiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e269c532-496b-3428-bdd6-9f77baa1dee4",
                    "sense_definition": "To stare or gape in a stupid or awkward manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not just <w>gawk</w> at the screen while the teacher is explaining the lesson.",
                            "target_lang_translations": {
                                "zh": "老师讲课时，不要只对着屏幕<w>呆看</w>。"
                            }
                        },
                        {
                            "text": "It is considered rude to <w>gawk</w> at strangers in public places.",
                            "target_lang_translations": {
                                "zh": "在公共场合<w>盯着</w>陌生人看被认为是不礼貌的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stare"
                    ],
                    "common_phrases": [
                        "gawk at"
                    ],
                    "target_lang_definitions": {
                        "zh": "以愚蠢或笨拙的方式盯着看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呆看",
                                "target_lang_sense_clarification": "指因发呆或愚笨而盯着看。"
                            },
                            {
                                "target_lang_word": "傻看",
                                "target_lang_sense_clarification": "指毫无目的地盯着看，显得很傻。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "945c2a9f-8d54-3702-a0cd-4e6fe3ea2fec",
                    "sense_definition": "To stare openly and conspicuously at something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists stopped to <w>gawk</w> at the famous monument in the city center.",
                            "target_lang_translations": {
                                "zh": "游客们停下来<w>盯着</w>市中心的著名纪念碑看。"
                            }
                        },
                        {
                            "text": "Everyone began to <w>gawk</w> when the celebrity walked into the crowded room.",
                            "target_lang_translations": {
                                "zh": "当那位名人走进拥挤的房间时，每个人都开始<w>盯着</w>他看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stare"
                    ],
                    "common_phrases": [
                        "gawk at"
                    ],
                    "target_lang_definitions": {
                        "zh": "公开且引人注目地盯着某人或某物看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "盯着看",
                                "target_lang_sense_clarification": "指长时间、专注地注视。"
                            },
                            {
                                "target_lang_word": "目不转睛地看",
                                "target_lang_sense_clarification": "形容看得很专注，甚至不眨眼。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b21f06f4-9b3a-3da9-8391-706f001baa48",
                    "sense_definition": "A long, stupid, or conspicuous stare.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a long <w>gawk</w> at the strange machine before finally walking away.",
                            "target_lang_translations": {
                                "zh": "他对着那台奇怪的机器<w>呆视</w>了很久，才最终走开。"
                            }
                        },
                        {
                            "text": "The crowd's collective <w>gawk</w> made the performer feel quite uncomfortable.",
                            "target_lang_translations": {
                                "zh": "人群齐刷刷的<w>呆视</w>让表演者感到非常不自在。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种长时间、愚蠢或引人注目的凝视。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呆视",
                                "target_lang_sense_clarification": "指呆滞的凝视。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a24b029-d26e-31fb-818b-8afeee00b708",
                    "sense_definition": "A foolish, clumsy, or simple-minded person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>gawk</w> tripped over his own feet while trying to enter the room.",
                            "target_lang_translations": {
                                "zh": "那个老<w>笨蛋</w>在试图进屋时被自己的脚绊倒了。"
                            }
                        },
                        {
                            "text": "Do not act like such a <w>gawk</w> in front of the important guests.",
                            "target_lang_translations": {
                                "zh": "在重要客人面前不要表现得像个<w>傻瓜</w>一样。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "愚蠢、笨拙或头脑简单的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "指愚笨的人。"
                            },
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指头脑简单或行为愚蠢的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}