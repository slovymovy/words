                                                "sense_id": "4ccb35da-0362-3806-a55c-0347b5d878dc",
                                                "text": "Die Oboe wird im Orchester eingesetzt."
                                            },
                                            {
                                                "example_id": "ba4012bb-c753-4b56-b621-28cc207fe271",
                                                "sense_id": "4ccb35da-0362-3806-a55c-0347b5d878dc",
                                                "text": "„Wegen ihrer Herkunft von der Schalmei wird die Oboe auch jetzt noch für die Schilderung des pastoralen Lebens geeignet empfunden.“"
                                            }
