                                "sense_id": "1bdfe171-cbf2-3c54-b5cb-3dc94c21ee00",
                                "text": "„Augenzeugen und Journalisten berichteten, die Polizei habe scharfe Munition, Tränengas und Blendgranaten eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
