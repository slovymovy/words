                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b6eb5a-39c5-4ad9-902d-f89d6d0e183a",
                                "sense_id": "089dc8d8-8e49-3a78-b566-5976d7ff121d",
                                "text": "L'année a été des plus mauvaise dans l'Élection de Valognes ; entre autres, les pluies ont obligé de rensemencer jusqu'à trois fois certaines choses."
                            },
                            {
                                "example_id": "c1c228c4-e0c1-4b47-b8b1-376f3be67975",
                                "sense_id": "089dc8d8-8e49-3a78-b566-5976d7ff121d",
                                "text": "Ils répondent qu'ils leur est impossible, attendu qu'ils ont été obligés de rensemencer leurs terres, parce que le gibier a tout ruiné."
                            }
                        ]
                    }
