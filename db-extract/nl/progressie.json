                                "target_senses": [
                                    {
                                        "sense_id": "5b5bfab8-1041-37f7-bf7e-2c8f6a32c09f",
                                        "entry_id": "3a23bf93-90d6-363f-969a-1553bfb2f570",
                                        "glosses": [
                                            "Marche en avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b632c1ef-7df5-49bb-83b7-dee2bd3d60a2",
                                                "sense_id": "5b5bfab8-1041-37f7-bf7e-2c8f6a32c09f",
                                                "text": "La 2ᵉ Panzer ne manqua pas de profiter de cet avantage quand elle se fut emparé de Pont-à-Bar, le 14 mai à 12 h 30. Dans l'après-midi, elle entama une progression en rive gauche."
                                            },
                                            {
                                                "example_id": "42f0c094-2920-4cf5-9253-c6e18abd2ceb",
                                                "sense_id": "5b5bfab8-1041-37f7-bf7e-2c8f6a32c09f",
                                                "text": "Ses voiles délavées par le soleil et la pluie mais qui paraissaient blanches sur le gris du ciel, essayaient de récupérer les rares frissons de brise pour améliorer la lente progression du bateau."
                                            },
                                            {
                                                "example_id": "86c24cd8-d7bc-4d60-a87d-137c6778d1b1",
                                                "sense_id": "5b5bfab8-1041-37f7-bf7e-2c8f6a32c09f",
                                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                        "entry_id": "3a23bf93-90d6-363f-969a-1553bfb2f570",
                                        "glosses": [
                                            "Développement ; accroissement ininterrompu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577aa951-92f5-421e-8209-535646039a59",
                                                "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                                "text": "L’accroissement de la longueur des linéaires s'est accompagné d'une plus grande diversité des références: progression de 11% dans les hypers et de 9% dans les supers."
                                            },
                                            {
                                                "example_id": "6cd55d27-0872-4812-b248-dc578b66b2e3",
                                                "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                                "text": "La progression naturelle de l’esprit humain devait amener ce changement."
                                            },
                                            {
                                                "example_id": "e4929d08-cb76-46be-add2-3225b3370896",
                                                "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                                "text": "Il y a dans cet ouvrage une progression d’intérêt bien soutenue."
                                            },
                                            {
                                                "example_id": "c51faf9b-3cf6-4773-aaeb-6bebc048ee29",
                                                "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                                "text": "progression arithmétique, accroissement où la différence de chaque terme au terme précédent est constante : un, trois, cinq, sept, neuf, onze, etc., sont des grandeurs en progression arithmétique."
                                            },
                                            {
                                                "example_id": "286f438e-0039-4f39-a5f4-5e964916b34a",
                                                "sense_id": "1f97e625-fffb-3abd-bfee-774d02cf9eec",
                                                "text": "progression géométrique, accroissement où le rapport de chaque terme au terme précédent est constant : deux, quatre, huit, seize, trente-deux, etc. forment une progression géométrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d4c8e00-ed47-37d7-a769-511434e9d0f8",
                                        "entry_id": "3a23bf93-90d6-363f-969a-1553bfb2f570",
                                        "glosses": [
                                            "Avancement, développement par degrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ff9c77-f714-47f9-8137-11573a1fd857",
                                                "sense_id": "1d4c8e00-ed47-37d7-a769-511434e9d0f8",
                                                "text": "Il faut établir une progression dans ces études, dans ces exercices physiques."
                                            },
                                            {
                                                "example_id": "4fc318ee-8888-4088-8d85-a597204fe3c4",
                                                "sense_id": "1d4c8e00-ed47-37d7-a769-511434e9d0f8",
                                                "text": "La progression d’un impôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a9d636e-7bd5-3874-9b26-d727abad8cd8",
                                        "entry_id": "3a23bf93-90d6-363f-969a-1553bfb2f570",
                                        "glosses": [
                                            "Suite de nombres ou de quantités qui dérivent successivement les unes des autres, d’après une même loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc6e0140-dc41-413a-98da-d967f388f93f",
                                                "sense_id": "3a9d636e-7bd5-3874-9b26-d727abad8cd8",
                                                "text": "La progression est dite croissante ou décroissante selon que les termes vont en augmentant ou en diminuant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
