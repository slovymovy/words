                "senses": [
                    {
                        "sense_id": "64530d2b-abc3-36a9-87b3-ce7e5e201ff5",
                        "entry_id": "9d92326e-2c7b-3364-9958-b5626c71048a",
                        "glosses": [
                            "in de stijl van de klassieke Griekse dichteres Sapfo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8a045c-f09f-4a88-9d88-f0aed8d38005",
                                "sense_id": "64530d2b-abc3-36a9-87b3-ce7e5e201ff5",
                                "text": "In de bundel Ongeroepen staan drie oden in een alcaeisch metrum (naar de Griekse lyricus Alcaeus), in de bundel In de koude voorjaarsnacht staan drie oden in een sapfisch metrum (naar Sapfo)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f05c16e-6a9c-3efb-a4b9-81bc053a062c",
                        "entry_id": "9d92326e-2c7b-3364-9958-b5626c71048a",
                        "glosses": [
                            "betrekking hebbend op erotiek tussen vrouwen, van een vrouw: erotisch aangetrokken tot andere vrouwen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8e103195-3ca0-48cc-b72a-63d617d597a9",
                                "sense_id": "1f05c16e-6a9c-3efb-a4b9-81bc053a062c",
                                "text": "Omdat zij zich meestal jongensachtig kleedde werd aangenomen dat zij, zoals men dat destijds noemde, sapfische neigingen had. Of dat inderdaad zo was, weet ik niet, maar ik weet wel dat zij broeken droeg omdat ze vond dat ze lelijke benen had; en als ze echt sapfisch was vraag ik me af of ze wel zo verliefd op mijn vader had kunnen zijn."
                            }
                        ]
                    }
