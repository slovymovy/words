                    "sense_id": "30592ec8-e192-3bb1-a326-246a74691645",
                    "sense_definition": "Coming to an end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>terminating</w> phase of the project requires careful documentation.",
                            "target_lang_translations": {
                                "ru": "<w>Завершающая</w> фаза проекта требует тщательного документирования."
                            }
                        },
                        {
                            "text": "We observed the <w>terminating</w> signals sent by the system before it shut down.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали <w>завершающие</w> сигналы, отправленные системой перед её выключением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terminating phase",
                        "terminating signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершающийся, подходящий к концу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершающий",
                                "target_lang_sense_clarification": "относящийся к последней стадии чего-либо"
                            },
                            {
                                "target_lang_word": "заключительный",
                                "target_lang_sense_clarification": "последний, финальный этап"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77c0881b-6211-3e44-858e-2bc9c716127a",
                    "sense_definition": "Of a decimal: having a finite number of digits.",
