                "senses": [
                    {
                        "sense_id": "50ba3384-7f99-305f-888b-99f3a4da360f",
                        "entry_id": "aad254a2-c5a5-3cab-91c2-e939d333733c",
                        "glosses": [
                            "verniedlichend für Mami"
                        ],
                        "tags": [
                            "familiär"
                        ],
                        "examples": [
                            {
                                "example_id": "91c6446d-5d2e-4bfd-9e71-fb39ef3d3c2c",
                                "sense_id": "50ba3384-7f99-305f-888b-99f3a4da360f",
                                "text": "„Mit dem Walzer ‚Wenn du mal grau bist, Mamilein‘ und ‚Egerland Heimatland‘ zeigten die Musiker ihre Leidenschaft und ihr Engagement, mit dem sie ihre Instrumente beherrschen.“"
                            },
                            {
                                "example_id": "16d1afcd-4b78-43bb-9ed6-9507dab07523",
                                "sense_id": "50ba3384-7f99-305f-888b-99f3a4da360f",
                                "text": "„Wie der Österreicher verschwendet zudem auch der Rumäne seine Koseendungen gerne an Begriffe, die dies aufgrund ihres äußerlichen Erscheinungsbildes nicht unbedingt nahelegen: die ‚mămică‘ zum Beispiel, das ‚Mamilein‘, mit dem ‚tăticu‘, dem niedlichen Papilein an seiner Seite.“"
                            },
                            {
                                "example_id": "902aed07-1918-428d-b78e-bec677f59162",
                                "sense_id": "50ba3384-7f99-305f-888b-99f3a4da360f",
                                "text": "„Dazwischen Gedanken an den ersten Sex, an Nackttanzen, an ungelegene Erektionen, an erste Triumphe: ein jubelndes ‚Mamita, lo conseguí‘ - Mamilein, ich hab’s geschafft.“"
                            },
                            {
                                "example_id": "3d9f2f54-cd62-4a20-9e4f-bbf6f6c58d40",
                                "sense_id": "50ba3384-7f99-305f-888b-99f3a4da360f",
                                "text": "„Egal, was ich sagte oder bat, die Wombi antworte ‚Mach ich gleich, Mamilein‘, oder ‚Danke, dass du mich daran erinnerst.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
