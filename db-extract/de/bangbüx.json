                            {
                                "example_id": "557f1d7b-2e47-4197-91d1-9c44735e4844",
                                "sense_id": "b7ce9258-7be6-32ab-883d-868bd6076a8a",
                                "text": "Du bist mir vielleicht eine Bangbüx!"
                            },
                            {
                                "example_id": "f088e105-ff61-4954-914a-fe26be14a4dd",
                                "sense_id": "b7ce9258-7be6-32ab-883d-868bd6076a8a",
                                "text": "Wenn Mathilde eine Spinne sieht, mutiert sie zur Bangbüx."
                            },
                            {
                                "example_id": "14f4969b-5f4b-4885-b608-ef28f87b91f5",
                                "sense_id": "b7ce9258-7be6-32ab-883d-868bd6076a8a",
                                "text": "Meine Brüder sind echte Bangbüxen. Im Dunkeln zucken sie bei jedem Geräusch zusammen."
                            }
                        ],
