                                    {
                                        "sense_id": "0c676c9e-52b5-3436-b223-046de76b73ce",
                                        "entry_id": "f6e32ccb-660c-3bf4-8b34-eedb8179b63c",
                                        "glosses": [
                                            "weibliche Person, die sich (beruflich) mit Physik beschäftigt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aedf3c0c-050d-4ad5-a3da-66a2eed41362",
                                                "sense_id": "0c676c9e-52b5-3436-b223-046de76b73ce",
                                                "text": "Die Physikerin Marie Curie bekam als erste Person zwei Nobelpreise."
                                            },
                                            {
                                                "example_id": "fa0e3f24-f4b5-4627-8daa-91843a8c8985",
                                                "sense_id": "0c676c9e-52b5-3436-b223-046de76b73ce",
                                                "text": "„So wollte ich zum Beispiel mit der Nobelpreisträgerin Christiane Nüsslein-Volhard eigentlich über Freiheit in der Forschung sprechen, aber plötzlich redeten wir darüber, warum Fische schön sind und Angela Merkel besser Physikerin geblieben wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
