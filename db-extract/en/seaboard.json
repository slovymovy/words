                "senses": [
                    {
                        "sense_id": "40becd9b-ad8a-326a-92eb-de0529fd60f6",
                        "entry_id": "1e107a37-05d0-37e7-bbb7-4c31fcea1efd",
                        "glosses": [
                            "Küste, Meeresküste, Seeküste"
