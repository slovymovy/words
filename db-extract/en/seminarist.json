                                        "sense_id": "319cd72a-31b5-3d5a-8f57-959d755cab42",
                                        "entry_id": "1b113b54-bb7b-3d8b-a7c2-73d1bf8c02f2",
                                        "glosses": [
                                            "Teilnehmer eines Priesterseminars"
                                        ],
                                        "tags": [],
