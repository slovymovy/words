                                "example_id": "dc09e62b-9ebb-4952-85d0-ae406cfa270e",
                                "sense_id": "d57172d4-0230-3a52-9b9c-681fc74dd818",
                                "text": "Am Wochenende machen wir einen schönen Ausflug nach Meck-Pomm."
                            },
                            {
                                "example_id": "719f87a5-1d0f-453c-9929-1ac86b5ee250",
                                "sense_id": "d57172d4-0230-3a52-9b9c-681fc74dd818",
                                "text": "Meck-Pomm liegt doch an der Ostsee, nicht an der Nordsee!"
                            },
                            {
                                "example_id": "a54eda66-a13e-4c43-8afb-2f83c8ab6c33",
                                "sense_id": "d57172d4-0230-3a52-9b9c-681fc74dd818",
                                "text": "„Am Telefon hatte sie ihm gesagt, es sei in Meck-Pomm kalt und nass.“"
                            }
