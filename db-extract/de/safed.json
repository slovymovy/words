                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c3a049-e23f-4354-9def-7279278f446b",
                                "sense_id": "5f0aebe5-4260-3900-b740-9aa1a8aada09",
                                "text": "„Die Hisbollah erneuerte ihre Katjuscha-Angriffe auf Nordisrael. Mehrere Raketen landeten in den Städten Acre und Safed.“"
                            },
                            {
                                "example_id": "4eb16e41-d9c0-41c9-b740-fc815ca10e33",
                                "sense_id": "5f0aebe5-4260-3900-b740-9aa1a8aada09",
                                "text": "„Heute gibt es ein Feldlazarett, das die wachsende Zahl der Verwundeten in der Grenzregion aufnimmt, von denen einige ins israelische Krankenhaus von Safed gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
