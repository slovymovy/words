                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7dad1c8e-edfd-46d5-9a16-355aba514018",
                        "entry_id": "4550162c-121b-3525-bbfd-c712de2ffbce",
                        "tags": [
