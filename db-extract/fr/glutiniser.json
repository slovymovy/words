                "senses": [
                    {
                        "sense_id": "3a14f316-8ee8-3bfd-8ae9-260346a0b039",
                        "entry_id": "89c4ef25-b8cf-3f43-a07f-26a1eca8ceb9",
                        "glosses": [
                            "Donner un caractère glutineux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c356ee5-91a9-46b2-9c9e-8945c490c959",
                                "sense_id": "3a14f316-8ee8-3bfd-8ae9-260346a0b039",
                                "text": "Le premier nous demande un moyen pratique de glutiniser les pilules."
                            },
                            {
                                "example_id": "39498fd2-42dc-4e90-a3b5-5e96a7c22982",
                                "sense_id": "3a14f316-8ee8-3bfd-8ae9-260346a0b039",
                                "text": "Peut-être trouverait-on que l’azote, dont le siège est dans l’embryon, a la propriété de glutiniser, si je puis m’exprimer ainsi, la matière gommeuse contenue dans les cellules du périsperme, matière connue maintenant sous le nom de dextrine."
                            },
                            {
                                "example_id": "17d50bb7-b453-4d77-9715-cd7ff27f3c79",
                                "sense_id": "3a14f316-8ee8-3bfd-8ae9-260346a0b039",
                                "text": "Il est préférable de glutiniser les dragées afin d’en assurer le transit jusqu’à la région intestinale où s’effectue la réabsorption chlorurée."
                            }
                        ]
                    }
