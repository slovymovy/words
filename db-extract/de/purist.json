                ],
                "senses": [
                    {
                        "sense_id": "e25657fd-3875-3f42-a415-048094d050e0",
                        "entry_id": "9ea35f83-f029-319c-9a9b-3c1e2aaee138",
                        "glosses": [
                            "Vertreter der Kunstrichtung Purismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b510ac5-5d6c-430d-bbf6-abe846abf21d",
                                "sense_id": "e25657fd-3875-3f42-a415-048094d050e0",
                                "text": "Zu einem Gemälde von Barnett Newman führt Claus aus: „Beim Nennwert genommen, hat ein so wohlbekanntes Werk wie ›Vir Heroicus Sublimis‹ […] die eigentümliche Präzision der Puristen: es ist architektonisch, einfach, klar, gelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f1b9b21b-7799-31e9-b52a-55f4e4d597da",
                        "entry_id": "9ea35f83-f029-319c-9a9b-3c1e2aaee138",
                        "glosses": [
                            "Person, die sich darum bemüht, die Sprache von fremdsprachigen Einflüssen und/oder Sprachwandel zu befreien oder freizuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c2d5c1-ff92-4d68-ae93-8f4d974f5154",
                                "sense_id": "f1b9b21b-7799-31e9-b52a-55f4e4d597da",
                                "text": "„Sie beschränkt sich größtenteils auf den Zeitraum zwischen 1789 und 1871 (…), wobei das Hauptaugenmerk auf die theoretischen Ausführungen der Puristen gerichtet wird.“"
                            },
                            {
                                "example_id": "562468a3-a95e-44ee-a9ab-6f700e21518d",
                                "sense_id": "f1b9b21b-7799-31e9-b52a-55f4e4d597da",
                                "text": "„Hinter dem, was Puristen als Verfall, ja Verlotterung anprangern, steckt nur die Strategie, die Sprachstrukturen zu vereinfachen, um das Kommunizieren mit Nichtmuttersprachlern zu erleichtern.“"
                            },
                            {
                                "example_id": "f32ed220-a564-4fc2-b140-b553af5f731d",
                                "sense_id": "f1b9b21b-7799-31e9-b52a-55f4e4d597da",
                                "text": "„Hier unterscheiden sich die heutigen Puristen von denen vor hundert oder mehr Jahren, die häufig nicht nur gegen den französischen und teilweise auch schon englischen Einfluss waren, sondern auch gegen Franzosen und Engländer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9d9cfde-0e5b-4b89-aecc-0cdcd3920402",
                        "source_entry_id": "9ea35f83-f029-319c-9a9b-3c1e2aaee138",
                        "source_sense_id": "e25657fd-3875-3f42-a415-048094d050e0",
                        "source_sense_description": "Vertreter der Kunstrichtung Purismus",
                        "target_lang_word": "пурист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пурист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce1fa7e-76aa-3adb-ada1-5294eac9e55d",
                                        "entry_id": "ef13d0ce-a02e-350a-80d4-319a91991098",
                                        "glosses": [
                                            "книжн. приверженец пуризма, человек, выступающий за чистоту нравов, языка и т. п"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032ff0c2-2306-425f-81f3-14317a1941ed",
                                                "sense_id": "3ce1fa7e-76aa-3adb-ada1-5294eac9e55d",
                                                "text": "Нет, Лёлик слово сдержал, но, хитро оглядев всех и как бы демонстрируя, что он человек чести, он всего лишь оттопырил языком щеку. Со мной и партнерами случилась истерика. Неискушенный в наших профессиональных делах пурист скажет: «И это на святых подмостках?!»"
                                            },
                                            {
                                                "example_id": "8c0c668b-d8ad-43ad-930b-a7e5bcf242ac",
                                                "sense_id": "3ce1fa7e-76aa-3adb-ada1-5294eac9e55d",
                                                "text": "Почему же не склонять это слово, как склоняется, скажем, шило, коромысло, весло? […] Пуристы же хотят, чтобы оно оставалось в ряду таких несклоняемых слов, как домино, депо, трюмо, манто, метро, бюро и т. д."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
