                                    {
                                        "sense_id": "7b4e5dd1-65de-347c-91dc-530b54f39c51",
                                        "entry_id": "1bced4d5-fe78-3a3e-9882-a9bea54e28bb",
                                        "glosses": [
                                            "Qui représente par le dessin."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2545f883-3a89-43e9-a58d-d13593c3c826",
                                                "sense_id": "7b4e5dd1-65de-347c-91dc-530b54f39c51",
                                                "text": "Nicolas Oresme applique à la représentation du mouvement une représentation graphique, grâce à un système de coordonnées rectangulaires, ce qui fait de lui un précurseur de la géométrie analytique de Descartes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ab06da-d7d1-38da-aba0-630f703cda64",
                                        "entry_id": "1bced4d5-fe78-3a3e-9882-a9bea54e28bb",
                                        "glosses": [
                                            "Qualifie les arts qui exigent l’emploi du dessin."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652257a9-a3d9-4166-8776-f8a3a680fcd3",
                                                "sense_id": "20ab06da-d7d1-38da-aba0-630f703cda64",
                                                "text": "Ces photographies étaient cependant fort intéressantes : elles vérifiaient ce que la méthode graphique m’avait fait saisir relativement au mécanisme du vol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c1639f-2adf-3353-b60f-93514ab9ce69",
                                        "entry_id": "1bced4d5-fe78-3a3e-9882-a9bea54e28bb",
                                        "glosses": [
                                            "Qualifie les dessins par lesquels on représente des plans, des coupes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b7c448d-9df7-377c-b30b-b7c5756de598",
                                        "entry_id": "1bced4d5-fe78-3a3e-9882-a9bea54e28bb",
                                        "glosses": [
                                            "Qui a rapport à l’écriture, à la manière de représenter le langage par des signes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac7a598-d1d2-4382-a6b6-3c102cf6d74f",
                                                "sense_id": "3b7c448d-9df7-377c-b30b-b7c5756de598",
                                                "text": "Ces textes funéraires sont tous d’une écriture négligée, maigre et anguleuse ; et le papyrus trouvé sur la momie de Pétaménoph étant le plus récent, porte encore par cela même des traces plus marquées de la décadence de l’art graphique égyptien sous la domination gréco-romaine."
                                            }
                                        ]
                                    }
                                ]
                            },
