                    {
                        "translation_id": "a17f0fa9-a7bf-496e-8e1d-00e85e2d75a1",
                        "source_entry_id": "39944641-4270-37c0-a02c-37a9db46a7dc",
                        "source_sense_id": "c6ecf274-7d76-324b-b461-f2e15ea6ad5e",
                        "source_sense_description": "restrained and unpretentious",
                        "target_lang_word": "unauffällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unauffällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                        "entry_id": "e5c3cfa8-d2ac-3d58-84a7-589a50d3cd36",
                                        "glosses": [
                                            "keine Aufmerksamkeit auf sich ziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2436e98-2053-4510-a212-f6327a1e12b3",
                                                "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                                "text": "„Folgen Sie mir unauffällig.“"
                                            },
                                            {
                                                "example_id": "bd9c1b2e-adb3-4141-bb12-9d12b5a2e435",
                                                "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                                "text": "\"Viele Vögel brüten unauffällig\", sagte Hendrik Brunckhorst, Sprecher der Nationalparkverwaltung [Wattenmeer]."
                                            },
                                            {
                                                "example_id": "6de36637-3c14-44af-ae54-4a9bf761c3a7",
                                                "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                                "text": "Antennen von Funkbomben werden oft an Grashalmen oder in Büschen versteckt. Scheinbar unauffällig angehäufte Steine markieren Zielmarken für vorbeifahrende Fahrzeuge, die gesprengt werden sollen."
                                            },
                                            {
                                                "example_id": "63cf6623-04e0-49af-a379-6693057346d1",
                                                "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                                "text": "Die Niederlande sind das größte legale Steuerparadies der Welt. […] Manche dieser Holdings firmieren unter unauffälligen Namen wie BlueLeaf Coöperatie oder auch Holten Finance Company BV."
                                            },
                                            {
                                                "example_id": "10c2df7a-095c-4a0b-b2a7-98558ba89b3e",
                                                "sense_id": "95c18bcf-6b78-3b53-a115-33e72760f4c5",
                                                "text": "„Seine explosive Fracht transportierte er in einem unauffälligen Holzkoffer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "680a1678-0fc8-4c5c-96d4-7b48a435f597",
                        "source_entry_id": "39944641-4270-37c0-a02c-37a9db46a7dc",
                        "source_sense_id": "c6ecf274-7d76-324b-b461-f2e15ea6ad5e",
                        "source_sense_description": "restrained and unpretentious",
                        "target_lang_word": "subtil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subtil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1740314c-2dcb-3232-858b-835f6ece0fb2",
                                        "entry_id": "573809f5-3e1d-3751-a2a9-1fae9ab62566",
                                        "glosses": [
                                            "auf eine differenzierte und feine Art vorhanden, angelegt oder gegliedert; in die Feinheiten gehend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed1378a-0e1e-43d2-8a6f-96904c7e02ca",
                                                "sense_id": "1740314c-2dcb-3232-858b-835f6ece0fb2",
                                                "text": "Diese subtilen Zeichnungen erschließen sich erst bei genauerem Hinsehen."
                                            },
                                            {
                                                "example_id": "b0e369b5-1726-4df6-89cb-229ad45e32d5",
                                                "sense_id": "1740314c-2dcb-3232-858b-835f6ece0fb2",
                                                "text": "Covid-19-Erkrankungen: „Die britischen Neurologen befürchten, dass die COVID-19-Erkrankung bei einigen Patienten subtile Hirnschäden hinterlassen könnte, die sich erst in den kommenden Jahren bemerkbar machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                        "entry_id": "573809f5-3e1d-3751-a2a9-1fae9ab62566",
                                        "glosses": [
                                            "feinsinnig auf eine positive Art; mit Zartgefühl, Fingerspitzengefühl versehen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85aa0f50-0a84-4b1e-bbf3-2b6dc3a27a60",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "Er kommt nie über Redensarten hinaus, und ein etwas subtileres Denken wäre ihm zu wünschen."
                                            },
                                            {
                                                "example_id": "0a64be27-edd1-4dc5-8fb1-b64e7a45c3d1",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "Eine pampige Behauptung siegt oft über eine subtile Begründung."
                                            },
                                            {
                                                "example_id": "ac126007-8292-49c3-8e94-6441ce874fd8",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "„… Er bat mich, gnädigster König,",
                                                "translation": "Goethe, Reineke Fuchs, Sechster Gesang"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                        "entry_id": "573809f5-3e1d-3751-a2a9-1fae9ab62566",
                                        "glosses": [
                                            "scharfsinnig, auf eine eher negative Art hinten herum; mit verhüllten Zielen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb7209f-b763-4581-855d-db0d31fd80a1",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "„… Er bat mich, gnädigster König,",
                                                "translation": "Goethe, Reineke Fuchs, Sechster Gesang"
                                            },
                                            {
                                                "example_id": "02f5a00a-4230-40ec-b129-273997fdc3e6",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "Ich meine, wir sind besser in einigen Belangen… Wir sind subtiler… Benutzen mehr Worte und rechtliche Kniffe, um alles zu legitimieren."
                                            },
                                            {
                                                "example_id": "01f5b183-06a5-4325-8452-6e791e90b3f6",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "Das ist besser, als einfach mitten in der Nacht zu verschwinden. Aber nur, weil etwas subtiler ist, macht es das Ganze nicht richtig.\" (Bradley Manning)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "930116f2-a640-439a-9aca-4bd5ae71fbef",
