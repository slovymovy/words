                        "target_lang_word": "focus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "focus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ad0e62-89b8-3460-8f57-b35a4f13f7d4",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "A point at which reflected or refracted rays of light converge."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8283ff6-06e6-47cb-ab3a-3c0f4fde69e3",
                                                "sense_id": "b8ad0e62-89b8-3460-8f57-b35a4f13f7d4",
                                                "text": "The heat of sunlight at the focus of a magnifying glass can easily set dry leaves on fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688894fe-2b7f-3970-9a39-0e00475f6fd2",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "A point of a conic at which rays reflected from a curve or surface converge."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The fact of the convergence of light on the photographic medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b03cae97-9744-435e-918a-cf3856ba5436",
                                                "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                                "text": "Unfortunately, the license plate is out of focus in this image."
                                            },
                                            {
                                                "example_id": "b22ce163-c270-4dfa-b795-606e85d905ae",
                                                "sense_id": "4b3f67c6-8847-3e9b-93f7-c1d1cacc3ea4",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df78c567-dd89-38b1-92f3-a14f54d0c706",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The quality of the convergence of light on the photographic medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeebd194-1c71-4b9a-b3f6-5566a491babe",
                                                "sense_id": "df78c567-dd89-38b1-92f3-a14f54d0c706",
                                                "text": "During this scene, the boy’s face shifts subtly from soft focus into sharp focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc05359f-0eab-3d00-9eea-f16fae0b4a9a",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "Concentration of attention."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d836dd39-1aac-4199-b1e9-34c6ed4010d2",
                                                "sense_id": "fc05359f-0eab-3d00-9eea-f16fae0b4a9a",
                                                "text": "I believe I can bring the high degree of focus required for this important job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6c6054-6f07-36dd-8e30-3bc546668049",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "Something to which activity, attention or interest is primarily directed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3febecd-f6e6-4d2b-adbd-5c9e93eb986c",
                                                "sense_id": "dd6c6054-6f07-36dd-8e30-3bc546668049",
                                                "text": "My studies are my main focus right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91bd9a6-e80d-3579-95ac-81f06a14d097",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The exact point of where an earthquake occurs, in three dimensions (underneath the epicentre)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81129770-31b3-4197-8b03-327efb8aed62",
                                                "sense_id": "d91bd9a6-e80d-3579-95ac-81f06a14d097",
                                                "text": "The earthquake's focus was at exactly 37 degrees north, 18 degrees south, seventy five meters below the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32e5097-f510-3efa-98ac-5c392df3ed84",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The status of being the currently active element in a user interface, often indicated by a visual highlight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf5664ac-79ae-42a7-93ff-5ab2e6bbccef",
                                                "sense_id": "e32e5097-f510-3efa-98ac-5c392df3ed84",
                                                "text": "Text entered at the keyboard or pasted from a clipboard is sent to the component which currently has the focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08a674c-16be-3a45-a644-c219b02eba7d",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The most important word or phrase in a sentence or passage, or the one that imparts information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "347dad14-9e7f-3c03-a5b9-691c5faf8013",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "An object used in casting a magic spell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e428e6d-bb3f-463b-ae65-1dde02d2c0d3",
                                                "sense_id": "347dad14-9e7f-3c03-a5b9-691c5faf8013",
                                                "text": "Candles, in fact, are an essential ingredient in many spells. They can be used as either the focus of the spell or as a component that sets the spell's overall mood and tone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a7c4c3e-dec4-3168-8ddf-fffbf5603b9f",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The centre of an older fish's scale, which is the point where a younger fish's scale starts to grow from."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "focus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aefed87-5ef7-3e2a-84a2-4a356e4593d8",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To cause (rays of light, etc) to converge at a single point."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff07e6b-efe6-485e-90ed-86fc23627ee1",
                                                "sense_id": "6aefed87-5ef7-3e2a-84a2-4a356e4593d8",
                                                "text": "The difficulties of focussing colour-light signals on curved tracks to ensure maximum sighting distance were underlined in the recent official report [...] on a low-speed collision at Newcastle Central on July 25, 1960, between an unfitted freight and a diesel-hauled passenger train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d96a044-3d2f-33b3-af7c-711ab1416b96",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To adjust (a lens, an optical instrument) in order to position an image with respect to the focal plane."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80a284d-6439-4746-ac20-ac9e5a9426cf",
                                                "sense_id": "2d96a044-3d2f-33b3-af7c-711ab1416b96",
                                                "text": "You'll need to focus the microscope carefully in order to capture the full detail of this surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To adjust itself or be adjusted such that light from a scene converges appropriately to create a clear image."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "665a2bc4-ae14-4dee-8edd-379cc1944e84",
                                                "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                                "text": "I can't get the lens to focus."
                                            },
                                            {
                                                "example_id": "acae7729-50aa-4041-9e9e-29a83596734d",
                                                "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                                "text": "The camera focuses automatically on the subject's eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10589904-3649-3428-8016-8515e8ca2594",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To direct attention, effort, or energy to a particular audience or task."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d7eff9-5bb3-4c05-b740-5ac9f2bf9f7b",
                                                "sense_id": "10589904-3649-3428-8016-8515e8ca2594",
                                                "text": "The president focused her remarks on the newcomers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8f4c9a-7c28-3890-be40-c9d11d2b3011",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To concentrate one’s attention."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f65e68-e1f7-45d4-a6d4-b8aba75c63e4",
                                                "sense_id": "5f8f4c9a-7c28-3890-be40-c9d11d2b3011",
                                                "text": "If you're going to beat your competitors, you need to focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22dd6464-fa30-3657-abd9-e0a4b1da5590",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To concentrate one's attention on something; to have as one's central point of interest, concern, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab811bd-0a1d-4e63-b7fd-573a3a29529b",
                                                "sense_id": "22dd6464-fa30-3657-abd9-e0a4b1da5590",
                                                "text": "I have to focus on my work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da39fddf-1f7b-3ec6-9f4c-32cdc81860e5",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To transfer the input focus to (a visual element), so that it receives subsequent input."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a50ada-4170-43c3-83c2-f800b933d13b",
                                                "sense_id": "da39fddf-1f7b-3ec6-9f4c-32cdc81860e5",
                                                "text": "The text box won't receive the user's keystrokes unless you explicitly focus it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63abe1bd-8ef7-3bf9-b011-4c80fa77a0de",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To aggregate figures of accounts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b213aa1e-fdfc-42a4-add8-60e8c77367aa",
                                                "sense_id": "63abe1bd-8ef7-3bf9-b011-4c80fa77a0de",
                                                "text": "Whole pages of it are filled with masses of figures, generally single numbers added up in batches, and then the totals added in batches again, as though he were \"focusing\" some account, as the auditors put it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d18b5ff-81a8-4491-9685-11f3e17c4520",
                        "source_entry_id": "eb875da3-8e1c-33da-b43e-15dc1d76f606",
                        "source_sense_id": "8160b884-f815-3ed8-a750-b3568e5d22c3",
                        "source_sense_description": "besondere Konzentration der Aufmerksamkeit",
                        "target_lang_word": "priorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                        "entry_id": "2b7ac309-4228-394b-9a53-6af4eba05bfb",
                                        "glosses": [
                                            "Le fait de venir avant, dans l’ordre du temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7dc1c6-d316-4e18-9fef-01ac1683f6dd",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Priorité d’hypothèque."
                                            },
                                            {
                                                "example_id": "49ff50b9-70f9-4671-85d6-22ca70256153",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Ce savant revendique la priorité de sa découverte."
                                            },
                                            {
                                                "example_id": "d74caed6-6927-4e52-8c7e-1dce484cb7de",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Cet orateur réclame la priorité, Il réclame le droit de prendre la parole avant un autre."
                                            },
                                            {
                                                "example_id": "a065f5d0-5ee9-4ba0-b29e-38ebe09b80af",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Donner la priorité à un amendement, décider qu’il sera discuté avant un autre."
                                            },
                                            {
                                                "example_id": "e14ab4c8-1b63-491b-86d0-88c53281cc92",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Actions de priorité, celles qui sont investies du droit de participer avant les autres à la répartition des bénéfices ou de l’actif social."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                        "entry_id": "2b7ac309-4228-394b-9a53-6af4eba05bfb",
                                        "glosses": [
                                            "Droit, établi par des règlements, de passer avant un autre sur une route, de monter avant les autres dans une voiture de transports publics, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764dfe7a-9e6b-474c-ad33-68bbed0a8d72",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Cette voiture avait la priorité, elle avait le droit de s’engager la première sur telle route."
                                            },
                                            {
                                                "example_id": "9e439978-bcfc-42c6-8d97-ccc221e2b2c1",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Cette péniche a la priorité, elle a le droit d’accéder avant les autres à telle écluse, à telle gare, à tel quai."
                                            },
                                            {
                                                "example_id": "f225d5a2-c29a-498e-bc79-737d1b2081b8",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Carte de priorité, carte qui assure la priorité."
                                            },
                                            {
