                                    },
                                    {
                                        "sense_id": "af152281-d5dc-3b11-9c69-c88725d75c54",
                                        "entry_id": "27580923-777d-3035-b78f-1df45af67dd3",
                                        "glosses": [
                                            "A woman holding a baronial title in her own right; a female ruler of a barony."
                                        ],
