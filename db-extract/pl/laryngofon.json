                        "sense_id": "7676c44f-3b8e-3f72-b861-30c66580136b",
                        "entry_id": "b2ba8ed5-5252-3df3-a27c-b5e823a7f571",
                        "glosses": [
                            "mikrofon noszony przy krtani odbierający dźwięk głosu mówiącego przez jej drganie, dzięki czemu może być używany w bardzo głośnym otoczeniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eeb50e6-0d8a-4d11-978b-228c58978f8b",
                                "sense_id": "7676c44f-3b8e-3f72-b861-30c66580136b",
                                "text": "No i co tam, Wiechu, jedziemy na wojnę? – zapytał, przyciskając do krtani czujnik laryngofonu"
                            },
                            {
                                "example_id": "082fe924-5c1c-4994-bafa-efac6c907d82",
                                "sense_id": "7676c44f-3b8e-3f72-b861-30c66580136b",
                                "text": "Kiedyś wszyscy czołgiści używali hełmofonów ze słuchawkami i laryngofonami"
                            }
                        ],
