                                        "sense_id": "41863b71-8243-3336-a9cb-f316d9d9d21c",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "A high excitement of mind; an elation which rises to enthusiasm, frenzy, or madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c5e5d6-3837-426d-a1e6-1ef60b9509e9",
                                                "sense_id": "41863b71-8243-3336-a9cb-f316d9d9d21c",
                                                "text": "Excitement leads to enthusiasm, that moral intoxication, whose effects seem incredible to the sober, while the influence which produces the extravagance appears more extraordinary than the act itself."
                                            }
                                        ]
                                    }
                                ]
