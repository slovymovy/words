                "senses": [
                    {
                        "sense_id": "a871abcb-67cb-3d49-bc11-2b544a89e513",
                        "entry_id": "722b75cb-5935-3615-bdbc-9be62583eff0",
                        "glosses": [
                            "Organisation armée secrète"
