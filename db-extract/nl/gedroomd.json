                "senses": [
                    {
                        "sense_id": "86a2fa89-579e-32ce-8e73-d5e71260481b",
                        "entry_id": "6058d24e-a41f-373a-b500-443a9d6362e4",
                        "glosses": [
                            "van iets dat men er heel sterk naar verlangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1461941d-22ba-41a7-abda-aa5eb90ee5f5",
                                "sense_id": "86a2fa89-579e-32ce-8e73-d5e71260481b",
                                "text": "Toen zij acht jaar oud was, keerde haar vader, de Amerikaanse alpinist John Harlin II, niet terug van zijn gedroomde beklimming van de Eiger-noordwand in 1966."
                            },
                            {
                                "example_id": "772fcf85-7f7b-4b1f-89ed-30d1dd88342d",
                                "sense_id": "86a2fa89-579e-32ce-8e73-d5e71260481b",
                                "text": "De bouw van het gedroomde Paviljoen van de Stichting Natuurhus Almelo mag doorgaan. De gemeente Almelo liet de stichting onlangs weten garant te willen staan voor een lening die nodig is om het bouwproject mogelijk te maken."
                            }
                        ]
                    }
                ],
