                        "glosses": [
                            "An old English measure of corn (e.g., wheat), equal to half a quarter or 4 bushels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380370d0-af0b-44cc-9b96-7d654ef334c7",
                                "sense_id": "3e3b208a-0a89-39f8-8940-fa48d769876e",
                                "text": "It was equal to half a quarter, i.e. is identical with the coomb of the eastern counties."
                            },
                            {
                                "example_id": "537961df-41bb-4110-80ab-5ba538ded3b2",
                                "sense_id": "3e3b208a-0a89-39f8-8940-fa48d769876e",
                                "text": "Two kilderkins, or strikes, make a measure called a barrel, liquid, and a coomb, dry; this last term being ancient and little used."
                            }
                        ]
                    }
