                ],
                "senses": [
                    {
                        "sense_id": "c7ef6d74-5cc3-37bb-b9b5-c9ebbae3b16f",
                        "entry_id": "455d1002-e54f-3d29-aa5e-07ffd5a1ee12",
                        "glosses": [
                            "Rendre conforme aux droits de l’homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad8d332-4888-4ced-8af0-4467adb4a382",
                                "sense_id": "c7ef6d74-5cc3-37bb-b9b5-c9ebbae3b16f",
                                "text": "Prochaine étape de la Vigilance Concernée: la blogosphère, qu’il convient bien entendu de réguler, d’humaniser, de droit-de-l’hommiser, de solidariser et de rectifier, pour le bien de tous et la bonne marche de la société citoyenne respectueuse de la diversité."
                            },
                            {
                                "example_id": "eafe0f32-e559-487a-93bd-d32b259c414b",
                                "sense_id": "c7ef6d74-5cc3-37bb-b9b5-c9ebbae3b16f",
                                "text": "L’occident qui, depuis Saint Paul, voulait « évangéliser toutes les nations », veut « droit-de-l-hommiser » ^([sic]) le reste du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "72be82d1-e4a1-3644-b272-3003c69d0893",
                        "entry_id": "455d1002-e54f-3d29-aa5e-07ffd5a1ee12",
                        "glosses": [
                            "Défendre les droits de l’homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbcd3e44-4e27-484d-b976-e2eb2b09d5c5",
                                "sense_id": "72be82d1-e4a1-3644-b272-3003c69d0893",
                                "text": "Les islamistes du CCIF vont se faire mousser en criant à l’islamophobie, les droit-de-l’hommistes vont droit-de-l’hommiser."
                            },
                            {
                                "example_id": "02894b76-94d5-48f1-a81a-6b3f6e73a4e5",
                                "sense_id": "72be82d1-e4a1-3644-b272-3003c69d0893",
                                "text": "À force de moraliser, « droit-de-l’hommiser » ou encore gauchiser les débats on s’inflige un bandeau sur les yeux."
                            }
                        ]
                    }
                ],
