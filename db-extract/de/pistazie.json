                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c6f1e71-cd1a-3065-9f97-9b5f1f73faa6",
                        "entry_id": "5d89ec66-2c4a-3f08-9327-b509ed44bd4c",
                        "glosses": [
                            "nussähnliche Frucht der Pistazie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5330c0-e7db-4bd9-b147-6b9eca87a4a8",
                                "sense_id": "2c6f1e71-cd1a-3065-9f97-9b5f1f73faa6",
                                "text": "„Ohne ein Wort fängt meine Mutter an, ihre Kleidung, die Packungen mit Pistazien und Safran umzuräumen.“"
                            },
                            {
                                "example_id": "0c1c7e5e-44ea-4dbb-9758-54ae27fd0130",
                                "sense_id": "2c6f1e71-cd1a-3065-9f97-9b5f1f73faa6",
                                "text": "„Ein Junge verkaufte Pistazien zwischen den Tischen.“"
                            },
                            {
                                "example_id": "f2923fda-aaa7-49ea-9a5c-3d09e4c23390",
                                "sense_id": "2c6f1e71-cd1a-3065-9f97-9b5f1f73faa6",
                                "text": "„Als er die Pistazien und Kapern zerhackte, schlug er plötzlich mit dem Messer auf das Brett wie ein Wahnsinniger.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
