                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naast hen woonde een <w>alleenstaande</w> van in de zestig.",
                            "target_lang_translations": {
                                "en": "Next to them lived a <w>single person</w> in their sixties.",
                                "ru": "Рядом с ними жил <w>одинокий человек</w> лет шестидесяти.",
                                "pl": "Obok nich mieszkał <w>samotny człowiek</w> po sześćdziesiątce.",
                                "de": "Neben ihnen wohnte ein <w>Alleinstehender</w> in den Sechzigern.",
                                "fr": "À côté de chez eux vivait un <w>célibataire</w> d'une soixantaine d'années.",
                                "it": "Accanto a loro viveva un <w>single</w> sulla sessantina.",
                                "cs": "Vedle nich bydlel <w>single</w> šedesátník.",
                                "tr": "Yanlarında altmışlarında <w>yalnız yaşayan biri</w> oturuyordu.",
                                "es": "Al lado de ellos vivía una <w>persona soltera</w> de unos sesenta años."
                            }
                        },
                        {
                            "text": "Veel <w>alleenstaanden</w> kiezen ervoor om samen op vakantie te gaan.",
                            "target_lang_translations": {
                                "en": "Many <w>singles</w> choose to go on vacation together.",
                                "ru": "Многие <w>одинокие люди</w> предпочитают ездить в отпуск вместе.",
                                "pl": "Wielu <w>singli</w> decyduje się na wspólny wyjazd na wakacje.",
                                "de": "Viele <w>Alleinstehende</w> entscheiden sich dafür, gemeinsam in den Urlaub zu fahren.",
                                "fr": "Beaucoup de <w>célibataires</w> choisissent de partir en vacances ensemble.",
                                "it": "Molti <w>single</w> scelgono di andare in vacanza insieme.",
                                "cs": "Mnoho <w>singles</w> se rozhoduje jezdit na dovolenou společně.",
                                "tr": "Pek çok <w>bekar</w> birlikte tatile gitmeyi tercih ediyor.",
                                "es": "Muchos <w>solteros</w> eligen irse de vacaciones juntos."
                            }
                        }
