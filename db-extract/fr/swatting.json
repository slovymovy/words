                "forms": [],
                "senses": [
                    {
                        "sense_id": "87461146-453a-3492-8742-2eb8de98f397",
                        "entry_id": "80d0e983-d721-3730-a8fe-eeda55cfa93d",
                        "glosses": [
                            "Canular malveillant qui consiste à faire intervenir des unités spéciales de la police (comme le SWAT aux États-Unis ou le GIPN en France), chez quelqu’un sous prétexte d’une urgence imaginaire."
                        ],
                        "tags": [
                            "Anglicism",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "746d702c-809b-46d5-b6ad-b9f280d7aa24",
                                "sense_id": "87461146-453a-3492-8742-2eb8de98f397",
                                "text": "De plus en plus fréquent aux États-Unis, le swatting vient de faire sa première victime en France. Le principe consiste à faire un canular téléphonique aux forces de l’ordre dans le but de les faire intervenir chez un joueur, pendant qu’il diffuse sa vidéo en direct sur Internet. Le swatting tire justement son nom du Swat, l’équivalent des policiers d’élite du GIPN français."
                            }
                        ]
                    }
                ],
