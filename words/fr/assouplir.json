                    "frequency": "Middle",
                    "semantic_group_id": "matiere_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il applique régulièrement une crème spéciale pour <w>assouplir</w> le cuir de ses chaussures neuves."
                        },
                        {
                            "text": "Des étirements quotidiens aident à <w>assouplir</w> les muscles après une séance de sport intense."
                        }
                    ],
                    "synonyms": [
