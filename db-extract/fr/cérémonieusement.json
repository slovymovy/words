        "fr-extract.jsonl": [
            {
                "entry_id": "80e50863-cf12-338f-bdc0-a2fd8dacacf3",
                "word": "cérémonieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
                        "entry_id": "80e50863-cf12-338f-bdc0-a2fd8dacacf3",
                        "glosses": [
                            "D’une manière cérémonieuse ; avec cérémonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3560d55b-114f-4a00-ae86-4a6200ba7a59",
                                "sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
                                "text": "Quand tout fut réglé, Saccard alla cérémonieusement annoncer à son frère Eugène son union avec Mlle Renée Béraud Du Châtel."
                            },
                            {
                                "example_id": "c370825b-621b-4c99-a500-bef85e617096",
                                "sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
                                "text": "D’abord elle se répétait deux ou trois fois son nom entier, cérémonieusement, tel que les autres le prononçaient : François Paradis, de Saint-Michel-de-Mistassini… François Paradis… Et tout à coup, intimement : François."
                            },
                            {
                                "example_id": "d4e5a63f-998c-4497-a788-7d079ca79f3d",
                                "sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
                                "text": "— Tchin, tchin, fit Bernard cérémonieusement.\n— À la vôtre, mes enfants, répondit M. Tagada, qui leva son verre à la hauteur des yeux et but en connaisseur."
                            },
                            {
                                "example_id": "293ab47f-438d-4682-b00d-7ccb01499e3c",
                                "sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
                                "text": "Ce sont des creepypastas, ces nouvelles légendes urbaines, dont on sourit, bien malin, tant qu'il fait jour. On n'en parle guère, sinon le soir, cérémonieusement, de préférence en pixels, pour ajouter son grain de sel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3351b5f8-34f1-49aa-8cce-167400213a18",
                        "source_entry_id": "80e50863-cf12-338f-bdc0-a2fd8dacacf3",
                        "source_sense_id": "57b8df1d-b67e-3c41-ad0f-5a0b59ba7f6b",
