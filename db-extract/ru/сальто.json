                                "target_senses": [
                                    {
                                        "sense_id": "8f082beb-6312-30db-81e9-8333af4bcd5a",
                                        "entry_id": "18d3852c-5dfd-34c1-8e0c-1dd379f73780",
                                        "glosses": [
                                            "To perform a somersault."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00639df-a5f2-497e-9435-ae8b48b4ea1d",
                                                "sense_id": "8f082beb-6312-30db-81e9-8333af4bcd5a",
                                                "text": "The performer somersaulted all the way across the stage."
                                            },
                                            {
                                                "example_id": "d03a8da2-ec70-44a2-b1cc-ce0621cd83be",
                                                "sense_id": "8f082beb-6312-30db-81e9-8333af4bcd5a",
                                                "text": "He half-carries, half-drags it back to the stern, making sure the heat exchanger stays in the water, and somersaults it into the zodiac."
                                            }
                                        ]
                                    }
                                ]
                            }
