                        "target_lang_word": "шизоид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шизоид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8be7b2-ec93-3f58-9281-c5ec0839baeb",
                                        "entry_id": "dd799d54-7797-3ea9-ba48-2763dad6f701",
                                        "glosses": [
                                            "психиатр. человек с акцентуацией характера или расстройством личности, характеризующимся склонностью избегать эмоционально насыщенных взаимоотношений путём излишнего теоретизирования, замыкания в себе, ухода в фантазии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ce445d-5f8e-4d13-b0ab-339a72fe4fef",
                                                "sense_id": "0e8be7b2-ec93-3f58-9281-c5ec0839baeb",
                                                "text": "По-настоящему шизоиды любят всё-таки только себя: будучи эгоистами par excellence, они почти всегда держатся чрезвычайно высокого мнения о себе, о своих способностях и редко умеют ценить по-настоящему других людей, даже тех, к кому относятся хорошо."
                                            },
                                            {
                                                "example_id": "44c22439-7947-4dfd-9908-7893f2f80769",
                                                "sense_id": "0e8be7b2-ec93-3f58-9281-c5ec0839baeb",
                                                "text": "Шизоидов особенно часто можно встретить в семьях, где много больных, страдающих шизофренией как определённым психозом. Отсюда возникла мысль, что шизоид — это нечто промежуточное между здоровым человеком и шизофреником, как бы начальная или рудиментарная форма последней."
                                            }
                                        ]
                                    },
