                        "sense_id": "1f4d8e83-a6f1-3c89-801a-01a82b0b24f3",
                        "entry_id": "25c5c58d-68ea-3636-8234-c1feec908b6b",
                        "glosses": [
                            "Handlung, Hohlräume und Stollen unterhalb eines Bauwerks (Festung, Stadtmauer etc.) zu dessen Zerstörung, etwa durch eine anschließende Sprengung, anzulegen"
                        ],
                        "tags": [
                            "Pionierwesen"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d58c6915-3da5-38bd-be15-225ec30dba38",
                        "entry_id": "25c5c58d-68ea-3636-8234-c1feec908b6b",
                        "glosses": [
                            "Schaffen (durch Personen) oder Bewirken (durch Dinge, Umstände) von jederlei Hohlräumen unter Gebäudekomplexen oder sonstigen Anlagen, die diesen die Standfestigkeit nehmen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8d94e758-9fa7-3da9-8c0d-6385e4daeac5",
                        "entry_id": "25c5c58d-68ea-3636-8234-c1feec908b6b",
                        "glosses": [
                            "Handlung, etwas solide Bestehendes (Vertrauen, Ansehen, eine Position, …) oder ein Unterfangen langsam und unmerklich zu untergraben und zu zerstören"
                        ],
                        "tags": [
                            "abstract",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "39c055a1-8cdd-489f-ac62-438796fc6b5c",
                                "sense_id": "8d94e758-9fa7-3da9-8c0d-6385e4daeac5",
                                "text": "„Aus bisher ungeklärten Gründen treibt die Hemdindustrie jedoch ein niederträchtiges Doppelspiel, das offensichtlich auf die Unterminierung der männlichen Würde zielt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
