                "senses": [
                    {
                        "sense_id": "9747f819-7d5c-3f74-8607-58f68558ba81",
                        "entry_id": "554ea6f6-18e6-3f68-89f9-772b86d86ce1",
                        "glosses": [
                            "sealing wax"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4c36e0-0747-4597-afb6-b751fc72c5b7",
                                "sense_id": "9747f819-7d5c-3f74-8607-58f68558ba81",
                                "text": "В моё́ отсу́тствие ма́тушка получи́ла от но́вой свое́й сосе́дки письмо́ на се́рой бума́ге, запеча́танной бу́рым сургучо́м, како́й употребля́ется то́лько на почто́вых пове́стках да на про́бках дешё́вого вина́.",
                                "translation": "In my absence my mother had received from her new neighbour a letter on grey paper, sealed with brown wax, such as is only used in notices from the post-office or on the corks of bottles of cheap wine.",
                                "english": "In my absence my mother had received from her new neighbour a letter on grey paper, sealed with brown wax, such as is only used in notices from the post-office or on the corks of bottles of cheap wine."
                            }
                        ]
                    }
