                                "target_senses": [
                                    {
                                        "sense_id": "97474f9d-eeac-3b68-8445-9f308a7f53bc",
                                        "entry_id": "64808449-9a8f-37e7-a276-d63c00e4f68a",
                                        "glosses": [
                                            "The tendency of the mind toward, or its preoccupation with, physical phenomena; materialism in philosophy and religion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ec9a49-afb4-44ad-a156-68d67048bfed",
                                                "sense_id": "97474f9d-eeac-3b68-8445-9f308a7f53bc",
                                                "text": "Anthropomorphism grows into theology, while physicism (if I may so call it) develops into science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
