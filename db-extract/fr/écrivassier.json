                "entry_id": "beadb22a-c1e2-3343-9158-71f689a8dbe0",
                "word": "écrivassier",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43961645-2ef8-4fba-9cc5-5545e852fb99",
                        "entry_id": "beadb22a-c1e2-3343-9158-71f689a8dbe0",
