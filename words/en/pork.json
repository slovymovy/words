                {
                    "sense_id": "cb46ce91-d34a-3e53-bd38-f29b9e2912ff",
                    "sense_definition": "The meat of a pig used as food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to have roast <w>pork</w> with vegetables for dinner.",
