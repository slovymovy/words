                "senses": [
                    {
                        "sense_id": "0eb83b1c-b10b-3d75-899c-1f99dc73b4aa",
                        "entry_id": "207bf6be-a0d1-3117-8863-85aa91ad5a6d",
                        "glosses": [
                            "Communiquer sur la communication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4899b1df-d600-4442-ab97-54be3b1e4b09",
                                "sense_id": "0eb83b1c-b10b-3d75-899c-1f99dc73b4aa",
                                "text": "Il est donc essentiel pour le coach de savoir métacommuniquer puisque la communication interpersonnelle est au cœur du dispositif du coaching."
                            },
                            {
                                "example_id": "479b8066-f4ff-4a1b-a7e4-89337086c6a3",
                                "sense_id": "0eb83b1c-b10b-3d75-899c-1f99dc73b4aa",
                                "text": "Métacommuniquer, c'est échanger sur sa propre communication au niveau du contenu ou au niveau de la relation."
                            },
                            {
                                "example_id": "d215c28d-354f-4365-8f6d-31634d62a92d",
                                "sense_id": "0eb83b1c-b10b-3d75-899c-1f99dc73b4aa",
                                "text": "Métacommuniquer, c'est « communiquer sur la communication », sur la façon dont nous communiquons les uns avec les autres."
                            }
                        ]
                    }
