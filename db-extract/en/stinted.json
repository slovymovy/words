                "senses": [
                    {
                        "sense_id": "99db50a5-ac3d-3837-b463-cfcd3c3a7be8",
                        "entry_id": "6a5bc69c-ec99-33e3-879f-c990b240825c",
                        "glosses": [
                            "Constrained; restrained; confined."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eb26cf72-8b00-411a-bb94-c3d4e650a31f",
                                "sense_id": "99db50a5-ac3d-3837-b463-cfcd3c3a7be8",
                                "text": "Neither Mr. Toots nor Mr. Feeder could partake of this or any other snuff, even in the most stinted and moderate degree, without being seized with convulsions of sneezing."
                            },
                            {
                                "example_id": "3d872107-3c1e-43fd-9b57-0c94d44e7235",
                                "sense_id": "99db50a5-ac3d-3837-b463-cfcd3c3a7be8",
                                "text": "Mr. Home himself offered me a handsome sum—thrice my present salary—if I would accept the office of companion to his daughter. I declined. I think I should have declined had I been poorer than I was, and with scantier fund of resource, more stinted narrowness of future prospect."
                            },
                            {
                                "example_id": "dd80bd46-1d23-44c3-b6cf-ce980907d0c4",
                                "sense_id": "99db50a5-ac3d-3837-b463-cfcd3c3a7be8",
                                "text": "Nevertheless, he has always had to pay higher rents than even these for the poorest and most stinted rooms."
                            }
                        ]
                    }
                ],
