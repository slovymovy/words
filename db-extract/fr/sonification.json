                        "cross_references": [
                            {
                                "target_word": "sonification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaaa3fb0-77cf-3b02-8a1b-59682099d86e",
                                        "entry_id": "dbb1ffb6-9e9e-3fee-9c7f-48efcbedf155",
                                        "glosses": [
                                            "The process of sonifying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfcead78-b8ba-4a8f-8f5d-6cc366aaeb52",
                                                "sense_id": "aaaa3fb0-77cf-3b02-8a1b-59682099d86e",
                                                "text": "In another project, Weather sonification (Flowers and al., 2001), the correlation is made between different types of data, such as air pressure and temperature, with musical instruments."
                                            },
                                            {
                                                "example_id": "db5877d1-8274-4296-8a60-c38c1cf3c401",
                                                "sense_id": "aaaa3fb0-77cf-3b02-8a1b-59682099d86e",
                                                "text": "Sonification is a subset of a larger field called Auditory Display, which examines how sound can be used as the main conduit for conveying, understanding, and relaying information."
                                            },
                                            {
                                                "example_id": "f9090d7b-4377-4f83-817d-cafb06eaf3ca",
                                                "sense_id": "aaaa3fb0-77cf-3b02-8a1b-59682099d86e",
                                                "text": "Over the past 20 years, there have been many explorations and examples of sonifications."
                                            },
                                            {
                                                "example_id": "56c4682b-abcf-4ed4-b142-cbbc417023cf",
                                                "sense_id": "aaaa3fb0-77cf-3b02-8a1b-59682099d86e",
                                                "text": "As such, the mappings for direct data sonification should be straightforward in order to provide an intuitive correlation between brain activity and sound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
