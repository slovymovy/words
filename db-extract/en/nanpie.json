                    {
                        "sense_id": "cf2255f3-756a-3004-af0c-64785cf4cfe1",
                        "entry_id": "8d96f92a-2ae5-3570-8f22-a0ab23a1e8f1",
                        "glosses": [
                            "The magpie."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "577fc833-f284-4a32-b4c7-6e0439e7c632",
                                "sense_id": "cf2255f3-756a-3004-af0c-64785cf4cfe1",
                                "text": "An' twea 'r three Nanpies chatt'rin' owre her head."
                            },
                            {
                                "example_id": "d9c5b252-527e-4822-b8cb-f0c276d2c586",
                                "sense_id": "cf2255f3-756a-3004-af0c-64785cf4cfe1",
                                "text": "T'jerney wer lead'd forrard teah wi' an immense amount o' pleazure; in fakt, ivvery number i' t' nine gat theresense run up ta t' heeist pitch o' joyful expecktashun, fer all yan o' t' lot had a soart o' misgivin', becos he sed hede seen fer three da's hand runnin' nine Nanpies, whitch wer a bad sine, he sed—"
                            },
                            {
                                "example_id": "fdd8df62-31f9-46d1-b309-32b41d1e13ff",
                                "sense_id": "cf2255f3-756a-3004-af0c-64785cf4cfe1",
                                "text": "The unusual appearance of nanpies in a place is said to be ominous."
                            },
                            {
                                "example_id": "67c73664-dffe-4233-8578-d5f9cf1fc259",
                                "sense_id": "cf2255f3-756a-3004-af0c-64785cf4cfe1",
                                "text": "You see, he kept all nations o' wild birds an' wild animals down at his house; he'd linnets an' nanpies i' cages, and an ark full o' pricky-back urchins."
                            }
                        ]
                    }
                ],
