                {
                    "sense_id": "97a2dcfe-9eda-3710-a94d-1e70447a1f85",
                    "sense_definition": "A casual greeting used to say hello or ask how someone is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alright</w>? I haven't seen you in a long time.",
                            "target_lang_translations": {
                                "ru": "<w>Как дела</w>? Я тебя давно не видел.",
                                "zh": "<w>你好</w>吗？好久不见了。",
                                "nl": "<w>Hoe gaat het</w>? Ik heb je in lange tijd niet gezien.",
                                "pl": "<w>Co słychać</w>? Dawno cię nie widziałem.",
                                "de": "<w>Alles klar</w>? Ich habe dich schon lange nicht mehr gesehen.",
                                "fr": "<w>Ça va ?</w> Ça fait longtemps que je ne t'ai pas vu.",
                                "it": "<w>Come va</w>? È da tanto che non ci vediamo.",
                                "cs": "<w>Jak to jde</w>? Dlouho jsem tě neviděl.",
                                "tr": "<w>Naber</w>? Seni uzun zamandır görmemiştim.",
                                "es": "¿<w>Cómo va</w>? Hace mucho que no te veo."
                            }
                        },
                        {
                            "text": "<w>Alright</w>, Dave? How is it going?",
                            "target_lang_translations": {
                                "ru": "<w>Здорово</w>, Дэйв? Как оно?",
