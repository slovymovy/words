    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04a8c75a-76a7-39ff-b135-d9aae0998e85",
                    "sense_definition": "Arrêt ou pause que l'on fait au cours d'un trajet ou d'une marche pour se reposer.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "arret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après trois heures de marche en montagne, nous faisons une petite <w>halte</w> près de la rivière."
                        },
                        {
                            "text": "Les randonneurs décident de faire <w>halte</w> dans ce village avant de repartir."
                        }
                    ],
                    "synonyms": [
                        "pause"
                    ],
                    "common_phrases": [
                        "faire halte"
                    ]
                },
                {
                    "sense_id": "40d4471e-f411-3e47-ab64-f88023e4b297",
                    "sense_definition": "Lieu où l'on s'arrête temporairement lors d'un déplacement.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette auberge constitue une agréable <w>halte</w> pour les cyclistes fatigués."
                        },
                        {
                            "text": "Nous avons trouvé une charmante <w>halte</w> au bord du lac pour pique-niquer."
                        }
                    ]
                },
                {
                    "sense_id": "41b27df1-3628-3357-90d1-b348d57e9e90",
                    "sense_definition": "Petite station ferroviaire secondaire réservée à la montée et à la descente des voyageurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train régional dessert cette simple <w>halte</w> rurale deux fois par jour."
                        },
                        {
                            "text": "Il n'y a pas de guichet dans cette petite <w>halte</w> ferroviaire de campagne."
                        }
                    ],
                    "common_phrases": [
                        "halte ferroviaire"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "3e7b5200-5aec-31ff-9eac-ac43b482a427",
                    "sense_definition": "Cri ou commandement pour ordonner d'interrompre immédiatement un mouvement ou une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La sentinelle cria à haute voix : « <w>Halte</w> là, qui va là ? »"
                        },
                        {
                            "text": "Le garde a crié « <w>halte</w> » dès qu'un intrus s'est approché de la grille."
                        }
                    ],
                    "common_phrases": [
                        "halte là"
                    ]
                }
            ]
        }
    ]
