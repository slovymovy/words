{
    "word_family": [
        "chagrijnig",
        "chagrijnen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "977d136b-a5cd-3883-9b70-bab8d74143d9",
                    "sense_definition": "Een ontevreden, humeurige of geïrriteerde stemming.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>chagrijn</w> hier overal, zeg.",
                            "target_lang_translations": {
                                "en": "What a <w>bad mood</w> everywhere here, I must say."
                            }
                        },
                        {
                            "text": "Zijn voortdurende <w>chagrijn</w> bedierf de sfeer tijdens het hele diner.",
                            "target_lang_translations": {
                                "en": "His constant <w>moodiness</w> ruined the atmosphere during the entire dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "humeurigheid",
                        "slecht humeur",
                        "ontevredenheid"
                    ],
                    "antonyms": [
                        "vrolijkheid",
                        "blijdschap"
                    ],
                    "common_phrases": [
                        "vol chagrijn"
                    ],
                    "target_lang_definitions": {
                        "en": "A dissatisfied, moody, or irritated mood."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bad mood",
                                "target_lang_sense_clarification": "state of mind"
                            },
                            {
                                "target_lang_word": "moodiness",
                                "target_lang_sense_clarification": "state of being irritable"
                            },
                            {
                                "target_lang_word": "irritation",
                                "target_lang_sense_clarification": "annoyance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cee2c10-dfcf-35ab-8661-0095eb941c93",
                    "sense_definition": "Een persoon die chagrijnig, humeurig of ontevreden is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ben jij een stuk <w>chagrijn</w>!",
                            "target_lang_translations": {
                                "en": "What a <w>sourpuss</w> you are!"
                            }
                        },
                        {
                            "text": "Niemand wil praten met die oude <w>chagrijn</w> die altijd klaagt.",
                            "target_lang_translations": {
                                "en": "Nobody wants to talk to that old <w>grump</w> who is always complaining."
                            }
                        }
                    ],
                    "synonyms": [
                        "brompot",
                        "knorpot",
                        "zuurpruim"
                    ],
                    "antonyms": [
                        "gezelligheidsdier"
                    ],
                    "common_phrases": [
                        "een stuk chagrijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele uitdrukkingen zoals 'een stuk chagrijn'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is grumpy, moody, or dissatisfied."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grump",
                                "target_lang_sense_clarification": "person"
                            },
                            {
                                "target_lang_word": "sourpuss",
                                "target_lang_sense_clarification": "informal term for a grumpy person"
                            },
                            {
                                "target_lang_word": "grouch",
                                "target_lang_sense_clarification": "person who complains often"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e948bc2-670b-3fab-b97d-c3c2e7fde15d",
                    "sense_definition": "Hard, fijn gekorreld leer, ook wel bekend als segrijn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De antieke boekband was bekleed met groen <w>chagrijn</w>.",
                            "target_lang_translations": {
                                "en": "The antique bookbinding was covered in green <w>shagreen</w>."
                            }
                        },
                        {
                            "text": "Dit luxe doosje is afgewerkt met fijn <w>chagrijn</w>.",
                            "target_lang_translations": {
                                "en": "This luxury box is finished with fine <w>shagreen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "segrijnleer",
                        "segrijn"
                    ],
                    "target_lang_definitions": {
                        "en": "Hard, finely granulated leather, also known as shagreen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shagreen",
                                "target_lang_sense_clarification": "type of leather"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3da887fd-af45-3e8d-8f46-dfbee7fcd020",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>chagrijnen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>chagrijn</w> misschien een beetje omdat ik slecht geslapen heb.",
                            "target_lang_translations": {
                                "en": "I <w>am</w> maybe <w>being a bit grumpy</w> because I slept poorly."
                            }
                        },
                        {
                            "text": "Als ik honger heb, <w>chagrijn</w> ik altijd direct.",
                            "target_lang_translations": {
                                "en": "When I am hungry, I always <w>get grumpy</w> immediately."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'chagrijnen' (to be grumpy/fret)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "am grumpy",
                                "target_lang_sense_clarification": "first-person singular action"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "first-person singular action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "547364c4-5b6c-30bd-b335-357342723ea5",
                    "sense_definition": "De gebiedende wijs van <w>chagrijnen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Chagrijn</w> toch niet zo de hele dag!",
                            "target_lang_translations": {
                                "en": "Don't <w>be so grumpy</w> all day long!"
                            }
                        },
                        {
                            "text": "Kom op, wees vrolijk en <w>chagrijn</w> niet zo!",
                            "target_lang_translations": {
                                "en": "Come on, be cheerful and don't <w>fret</w> so much!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'chagrijnen' (to be grumpy/fret)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be grumpy",
                                "target_lang_sense_clarification": "imperative command"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "imperative command"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}