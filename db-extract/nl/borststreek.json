                        "examples": [
                            {
                                "example_id": "cc1612af-ea5e-46cf-9ff8-9ad605a0863b",
                                "sense_id": "3bf10dd8-4200-35f1-bc62-d2bc5027179c",
                                "text": "Naast de zware verwondingen in zijn borststreek liep de Amerikaan ook enkele sneeën in zijn hoofd op. Een hersenschudding bleef hem bespaard. De 42-jarige Horner was aan het trainen nabij het Italiaanse Comomeer en werd na het ongeluk overgebracht naar het ziekenhuis van Lecco."
                            },
                            {
                                "example_id": "4401e16c-5c18-4d10-8ea7-afb79d22d1f3",
                                "sense_id": "3bf10dd8-4200-35f1-bc62-d2bc5027179c",
                                "text": "De 37-jarige vrouw is volgens de politie helder. Ze heeft al gesproken met rechercheurs. De vrouw werd in het huis gevonden met steekwonden in de nek en in haar borststreek. Over het mogelijke motief van de vrouw is nog niets bekend."
                            }
                        ]
