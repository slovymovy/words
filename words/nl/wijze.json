        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "379bba7c-9841-3cea-bc86-a68471df04ed",
                    "sense_definition": "De aanvoegende <w>wijze</w> van het werkwoord <w>wijzen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men <w>wijze</w> er op dat dit slechts een tijdelijke oplossing is.",
                            "target_lang_translations": {
                                "en": "Let it be <w>pointed</w> out that this is only a temporary solution.",
                                "ru": "Пусть будет <w>указано</w> на то, что это лишь временное решение."
                            }
                        },
                        {
                            "text": "God <w>wijze</w> hem de weg in deze moeilijke tijden.",
                            "target_lang_translations": {
                                "en": "May God <w>show</w> him the way in these difficult times.",
                                "ru": "Да <w>укажет</w> ему Бог путь в эти трудные времена."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "gebruikt in formele of religieuze teksten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The subjunctive mood of the verb 'wijzen' (to point/show).",
                        "ru": "Форма сослагательного наклонения глагола «wijzen» (указывать/показывать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "may point",
