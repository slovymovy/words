                "senses": [
                    {
                        "sense_id": "d50a1a1d-ed89-3b4e-bf96-c32f397d1766",
                        "entry_id": "4af80c68-9b9f-39d6-afa2-dd2b3ef0d0c9",
                        "glosses": [
                            "neatly, cleanly, clearly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ae2382-28c3-495a-8f6c-7eb1a40a6159",
                                "sense_id": "d50a1a1d-ed89-3b4e-bf96-c32f397d1766",
                                "text": "1903 July–October, Henri Beaunis, “Contribution à la psychologie du rêve”, in The American Journal of Psychology, Volume XIV, Number 3–4, page 13,\nDans mes rêves, les images visuelles ont à peu près les mêmes caractères de vague et d’indécision; en général les objets sont vus plus nettement que les personnages, les mots plus que les objets, les dessins (dessins d’anatomie et d’histologie par exemple), les cartes plus nettement encore.",
                                "translation": "In my dreams, visual images have about the same characteristics of vagueness and indecision; in general objects are seen more clearly than characters, words more than objects, designs (designs of anatomy and of histology for example) and maps more clearly yet.",
                                "english": "In my dreams, visual images have about the same characteristics of vagueness and indecision; in general objects are seen more clearly than characters, words more than objects, designs (designs of anatomy and of histology for example) and maps more clearly yet."
                            }
                        ]
                    }
                ],
