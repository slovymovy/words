                "senses": [
                    {
                        "sense_id": "f70294f9-a12f-3a0a-98f2-ccb4563944d0",
                        "entry_id": "ebe3ebf6-0901-3810-8882-d6d2c8a1fef7",
                        "glosses": [
                            "weibliche Person, die etwas mietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978f907a-5205-482e-91eb-1cde2cd401b7",
                                "sense_id": "f70294f9-a12f-3a0a-98f2-ccb4563944d0",
                                "text": "Die Mieterin konnte die fällige Miete nicht bezahlen."
                            },
                            {
                                "example_id": "38d9ffaa-dd86-46c2-8634-6e7b720917f3",
                                "sense_id": "f70294f9-a12f-3a0a-98f2-ccb4563944d0",
                                "text": "„Vielleicht hatte sie einfach genug davon, dass die Mieterinnen alles zu Geld machten, was nicht niet- und nagelfest war, und sich dann auf Unwissenheit beriefen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1b9da6a-2b52-4472-be07-c388edd6cccd",
                        "source_entry_id": "ebe3ebf6-0901-3810-8882-d6d2c8a1fef7",
                        "source_sense_id": "f70294f9-a12f-3a0a-98f2-ccb4563944d0",
                        "source_sense_description": "weibliche Person, die etwas mietet",
                        "target_lang_word": "tenant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a92754f-30be-348e-9655-dfd6e98c616b",
                                        "entry_id": "e28ad53b-8cb8-3214-ae8f-f17b9c2a860b",
                                        "glosses": [
                                            "One who holds a lease (a tenancy)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42598ecb-c902-475c-8561-c142c89bef6f",
                                                "sense_id": "3a92754f-30be-348e-9655-dfd6e98c616b",
                                                "text": "Long even before the last tenant had occupied it, the room had been regarded with fear and aversion, and the end of that last tenant had in no way lightened the gloom that hung about the place."
                                            },
                                            {
                                                "example_id": "be559a99-1c37-4f90-a90f-d789ed360b7b",
                                                "sense_id": "3a92754f-30be-348e-9655-dfd6e98c616b",
                                                "text": "You are just a tenant here, you say / Living in and out of this life / As cheaply as you can"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d41267-9e51-3a4f-89ca-986660d43e24",
                                        "entry_id": "e28ad53b-8cb8-3214-ae8f-f17b9c2a860b",
                                        "glosses": [
                                            "One who has possession of any place."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b09cc5-c218-48c8-864a-5d560240db54",
                                                "sense_id": "b5d41267-9e51-3a4f-89ca-986660d43e24",
                                                "text": "What words are these have fall’n from me?\n⁠Can calm despair and wild unrest\n⁠Be tenants of a single breast,\nOr sorrow such a changeling be?"
                                            },
                                            {
                                                "example_id": "f630431c-8e11-4d8c-9e85-c18a58890641",
                                                "sense_id": "b5d41267-9e51-3a4f-89ca-986660d43e24",
                                                "text": "c. 1782-1783, William Cowper, Joy in Martyrdom\nsweet tenants of this grove"
                                            },
                                            {
                                                "example_id": "d9aad9d9-254f-48aa-affe-9a3032276241",
                                                "sense_id": "b5d41267-9e51-3a4f-89ca-986660d43e24",
                                                "text": "the happy tenant of your shade"
                                            },
                                            {
                                                "example_id": "f36d8a93-2a54-4853-a536-e3913fa33641",
                                                "sense_id": "b5d41267-9e51-3a4f-89ca-986660d43e24",
                                                "text": "But not in silence pass Calypso's isles, / The sister tenants of the middle deep; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d123625-fd3a-3a0f-805d-14e2a9d1e28e",
                                        "entry_id": "e28ad53b-8cb8-3214-ae8f-f17b9c2a860b",
                                        "glosses": [
                                            "Any of a number of customers serviced through the same instance of an application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47adc71d-1f30-4819-bb2f-cd8a206dd824",
                                                "sense_id": "2d123625-fd3a-3a0f-805d-14e2a9d1e28e",
                                                "text": "multi-tenant hosting"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9ccb62-9034-3a89-a3f4-ee46ba7f1283",
                                        "entry_id": "e28ad53b-8cb8-3214-ae8f-f17b9c2a860b",
                                        "glosses": [
                                            "One who holds a feudal tenure in real property."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b2292d9-f4c6-33ef-ad3b-fe4a7b518bc5",
                                        "entry_id": "e28ad53b-8cb8-3214-ae8f-f17b9c2a860b",
                                        "glosses": [
                                            "One who owns real estate other than via allodial title."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tenant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fee5304f-fa7d-3002-9d72-86136306a7fd",
                                        "entry_id": "dde5c97f-c467-38fd-9125-9efe1b522cf5",
                                        "glosses": [
                                            "To hold as, or be, a tenant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ea37f56-5679-32bf-b793-6570607f7c2f",
                                        "entry_id": "dde5c97f-c467-38fd-9125-9efe1b522cf5",
                                        "glosses": [
                                            "To inhabit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb516f52-d0c1-437e-ab02-1b0d9ecc221c",
                                                "sense_id": "8ea37f56-5679-32bf-b793-6570607f7c2f",
                                                "text": "His thin legs tenanted a pair of gambadoes fastened at the side with rusty clasps."
                                            },
                                            {
                                                "example_id": "c0452af0-a051-4644-b24f-43e480d5605e",
                                                "sense_id": "8ea37f56-5679-32bf-b793-6570607f7c2f",
                                                "text": "The felling of dense and lofty forests, which covered, even within the records of history, a considerable space on the globe, now tenanted by civilized man, must generally have lessened the amount of vegetable food throughout the space where these woods grew."
                                            },
                                            {
                                                "example_id": "7241d1b6-f5cb-477f-962b-76c0b465ae07",
                                                "sense_id": "8ea37f56-5679-32bf-b793-6570607f7c2f",
                                                "text": "They lived in palatial residences[…]their harems tenanted by numerous women[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tenant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6346a8b4-ed11-3a26-a836-0a8277362793",
                                        "entry_id": "c51d463e-c41e-3605-aee8-48e1aabce96a",
                                        "glosses": [
                                            "Misconstruction of tenet."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misconstruction"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bb181d8-5820-432b-a6ef-2b5ba47dcb80",
                        "source_entry_id": "ebe3ebf6-0901-3810-8882-d6d2c8a1fef7",
                        "source_sense_id": "f70294f9-a12f-3a0a-98f2-ccb4563944d0",
                        "source_sense_description": "weibliche Person, die etwas mietet",
                        "target_lang_word": "locataire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d6c9aa3-71c8-3641-a73a-6d0beab9e39b",
                                        "entry_id": "fec2b427-8a26-3f13-a8a9-bc2deb3a6a65",
                                        "glosses": [
                                            "Celui, celle qui occupe une maison ou une partie de maison à loyer."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc75eae9-46bf-484d-a785-782b16da0ce8",
                                                "sense_id": "3d6c9aa3-71c8-3641-a73a-6d0beab9e39b",
                                                "text": "Voilà bien ma maison, elle est bien à moi, j’en paie les impositions et j’ai un locataire qui ne paie pas son loyer, on a beau dire mais on est bien malheureux d’être propriétaire."
                                            },
                                            {
                                                "example_id": "5eef6ef7-0c2f-43f7-acab-a3d889978cd3",
                                                "sense_id": "3d6c9aa3-71c8-3641-a73a-6d0beab9e39b",
                                                "text": "Son propriétaire, Ferréol Tournier, l’avait, sans façons aucunes, prévenu qu’il en avait assez d’un locataire aussi mauvaise langue que lui et qu’il eût à songer à prendre ses cliques et ses claques pour le 25 mars prochain."
                                            },
                                            {
                                                "example_id": "2836b0c6-b94a-4761-9509-9fe2aa4ba48a",
                                                "sense_id": "3d6c9aa3-71c8-3641-a73a-6d0beab9e39b",
                                                "text": "Lorsque le locataire se marie en cours de bail, le conjoint qui n'a pas signé le contrat peut quand même se prévaloir du bail. Il faudra donc que le renon donné par les locataires soit signé par les deux époux et si l'un ne le fait pas, le bailleur pourra considérer que le congé est nul."
                                            },
                                            {
                                                "example_id": "cc026244-bfdc-4614-b6d8-fdbdfa434db1",
                                                "sense_id": "3d6c9aa3-71c8-3641-a73a-6d0beab9e39b",
                                                "text": "Il suffisait que des locataires de la maison déménageassent pour qu'elle ne dormît plus et souffrît autant que si on l'eût privée de tout. La pensée qu'on allait et venait près d'elle, qu'on était content de partir ou de s'installer, lui était intolérable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d23af1-4372-3459-9c0e-26b8119a682d",
                                        "entry_id": "fec2b427-8a26-3f13-a8a9-bc2deb3a6a65",
                                        "glosses": [
                                            "Celui ou celle qui prend à bail, à fermage, etc., une activité économique, agricole ou commerciale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7eef273d-b917-3447-9c39-419446801b8c",
                                        "entry_id": "fec2b427-8a26-3f13-a8a9-bc2deb3a6a65",
                                        "glosses": [
                                            "Nom donné à un insecte parfois envahissant le Lepinotus reticulatus anciennement Clothilla inquilina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8921a8a-299d-4a71-b940-594c19bff83f",
                                                "sense_id": "7eef273d-b917-3447-9c39-419446801b8c",
                                                "text": "Le locataire (Clothilla inquilina) possède deux ailes rudimentaires coriaces ; Virchow l'a vu envahir une maison au point d'y rendre le séjour intolérable et d'altérer gravement la santé des habitants."
                                            }
                                        ]
