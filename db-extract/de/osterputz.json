                                        "glosses": [
                                            "A systematic cleaning of a residence at the end of winter"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b572bef-2847-480e-83a1-03d9b31ae0ec",
                                                "sense_id": "9a2c0794-a4cc-3a8b-b5ea-ab127ade90e5",
                                                "text": "The Mole had been working very hard all the morning, spring-cleaning his little home. First with brooms, then with dusters; then on ladders and steps and chairs, with a brush and a pail of whitewash; till he had dust in his throat and eyes, and splashes of white-wash all over his black fur, and an aching back and weary arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a625e86-e0f5-3af7-9bc9-5b449c37823b",
                                        "entry_id": "fb115df6-cc32-3da8-9dfc-a5a7a4802bb5",
                                        "glosses": [
                                            "A systematic cleaning, reorganization, or weeding out of a system"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22f7b3b-48e3-45f4-a587-0a7956597104",
                                                "sense_id": "1a625e86-e0f5-3af7-9bc9-5b449c37823b",
                                                "text": "I spent the whole day in my head / Do a little spring cleanin' / I'm always too busy dreamin'"
                                            }
                                        ]
                                    }
                                ]
                            }
