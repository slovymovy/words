                                "target_senses": [
                                    {
                                        "sense_id": "69e2ebc9-3dfd-37d6-b05b-ee22edd0e81d",
                                        "entry_id": "4d3ac67a-c24d-35b1-a318-c49ffb245099",
                                        "glosses": [
                                            "Equisetum arvense, roślina wieloletnia należąca do rodziny skrzypowatych występująca głównie w Europie i mająca zastosowanie lecznicze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63dd285d-1410-4344-b34b-fdce23ead3b3",
                                                "sense_id": "69e2ebc9-3dfd-37d6-b05b-ee22edd0e81d",
                                                "text": "Skrzyp polny przywraca skórze elastyczność, jędrność i sprężystość; włosom nadaje blask, zapobiega ich przetłuszczaniu i wypadaniu"
                                            },
                                            {
                                                "example_id": "a55eadaa-5ad3-4a2d-9628-c1e62641a9ff",
                                                "sense_id": "69e2ebc9-3dfd-37d6-b05b-ee22edd0e81d",
                                                "text": "Skrzyp polny jest rośliną o działaniu moczopędnym, przeciwkrwotocznym, przeciwzapalnym, przeciwbakteryjnym i redukującym obrzęki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
