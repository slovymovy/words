                "senses": [
                    {
                        "sense_id": "31ecaa53-3d9d-3e6a-abfa-c9d22c7981a5",
                        "entry_id": "7ae4c271-58d1-3ba3-b8b5-82c1ff059ac5",
                        "glosses": [
                            "To unlock or unbolt a door that had been locked or bolted with a bar."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a43c323f-9060-446f-932b-66ee8820cc3f",
                                "sense_id": "31ecaa53-3d9d-3e6a-abfa-c9d22c7981a5",
                                "text": "“No need to unbar gates to thee and me,” said the martlet, as they passed beneath the darkness of that ancient portal, carved with strange devices, and clean through the massy timbers of the bolted gate thickly riveted with silver, into the inner court."
                            },
                            {
                                "example_id": "cb37e221-b6b5-4fa6-8cf6-4a1b228a9388",
                                "sense_id": "31ecaa53-3d9d-3e6a-abfa-c9d22c7981a5",
                                "text": "Only Enid could dare him at such a time, and even she felt occasionally that sinking of the heart which the bravest of tamers may experience as he unbars the gate of the cage."
                            }
                        ]
                    },
                    {
                        "sense_id": "641cb970-a901-388d-ba63-0b53409ed719",
                        "entry_id": "7ae4c271-58d1-3ba3-b8b5-82c1ff059ac5",
                        "glosses": [
                            "To remove an impediment that obstructs the passage of (someone or something)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce5de99a-fa3e-37cd-9016-ba1fac68bb70",
                        "entry_id": "7ae4c271-58d1-3ba3-b8b5-82c1ff059ac5",
