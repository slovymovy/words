                "senses": [
                    {
                        "sense_id": "bad90806-9b2e-3152-89ba-e8baad896121",
                        "entry_id": "c6e90002-987c-318d-9891-82a720248eff",
                        "glosses": [
                            "Begriff, der für das Verständnis eines Gegenstandsbereichs grundlegend ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "310e3e45-c472-421c-a4a2-ba7a8cf58678",
                                "sense_id": "bad90806-9b2e-3152-89ba-e8baad896121",
                                "text": "„Inzwischen hat sich die Struktur jedoch auch in der Geschichtswissenschaft als Schlüsselbegriff etabiert.“"
                            },
                            {
                                "example_id": "71052a99-a701-42d0-93ff-ee294ef4d622",
                                "sense_id": "bad90806-9b2e-3152-89ba-e8baad896121",
                                "text": "„Tagelang waren Sophie und ich fassungslos, wie tot das Leben sein konnte, und rätselten, wann es passiert war, dass die Menschen Stille und Ordnung zu den Schlüsselbegriffen ihres Glücks gemacht hatten.“"
                            },
                            {
                                "example_id": "7a4efa98-c98d-4251-9724-38dffa2b3460",
                                "sense_id": "bad90806-9b2e-3152-89ba-e8baad896121",
                                "text": "„Solidarität ist ein Schlüsselbegriff der Remarqueschen Epik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
