                "senses": [
                    {
                        "sense_id": "f8218490-0e0b-327e-b373-7bdead3b992f",
                        "entry_id": "ef61574e-f92e-3b5b-83fc-161dc8e3eee5",
                        "glosses": [
                            "A wet, squashy sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946585f2-bcdb-4bd5-8509-873493a24b96",
                                "sense_id": "f8218490-0e0b-327e-b373-7bdead3b992f",
                                "text": "Now there were two objects, ricocheting off a rocky headland, occasionally bumping each other with a squdge inaudible above the sloshing water."
                            },
                            {
                                "example_id": "f12a209c-2f6d-45a7-a641-bfe890253f31",
                                "sense_id": "f8218490-0e0b-327e-b373-7bdead3b992f",
                                "text": "Students plodded bravely on, unmindful of the cold rain water that made a \"squdge\" in the soaked shoes every time a step was taken."
                            },
                            {
                                "example_id": "cd2eee52-a516-4f1c-bd24-0fdb04454dc6",
                                "sense_id": "f8218490-0e0b-327e-b373-7bdead3b992f",
                                "text": "Rob's harpoon whistled through the air and sank, with a “squdge,” into the side of the bobbing, evasive target."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f9603e0-fa80-32ff-bec0-75daf43609c9",
                        "entry_id": "ef61574e-f92e-3b5b-83fc-161dc8e3eee5",
                        "glosses": [
                            "A wet, squashy mess."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43645fc-cc57-4ffa-be58-a923d3a68f98",
                                "sense_id": "5f9603e0-fa80-32ff-bec0-75daf43609c9",
                                "text": "What on earth did they do with themselves in those little transitory houses on their quarter-acre plots, without a decent tree on the estate, and the very road a squdge of clay and clinker?"
                            }
                        ]
                    }
                ],
