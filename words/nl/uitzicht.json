{
    "word_family": [
        "uitzien",
        "vooruitzicht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8844b127-62c7-3baa-84a8-dedcd24908ca",
                    "sense_definition": "wat men van de omgeving vanaf een bepaalde plek kan zien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visuele waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf deze hoge toren heeft men een prachtig <w>uitzicht</w> op het hele natuurgebied.",
                            "target_lang_translations": {
                                "en": "From this high tower, one has a beautiful <w>view</w> of the entire nature reserve.",
                                "ru": "С этой высокой башни открывается прекрасный <w>вид</w> на весь заповедник."
                            }
                        },
                        {
                            "text": "Deze hotelkamer heeft een mooi <w>uitzicht</w> op de bergen en het meer.",
                            "target_lang_translations": {
                                "en": "This hotel room has a nice <w>view</w> of the mountains and the lake.",
                                "ru": "Из этого гостиничного номера открывается красивый <w>вид</w> на горы и озеро."
                            }
                        }
                    ],
                    "synonyms": [
                        "panorama",
                        "vergezicht"
                    ],
                    "common_phrases": [
                        "mooi uitzicht",
                        "uitzicht op zee"
                    ],
                    "target_lang_definitions": {
                        "en": "what can be seen of the surroundings from a specific location",
                        "ru": "то, что можно увидеть вокруг с определенного места"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "the scenery visible from a place"
                            },
                            {
                                "target_lang_word": "outlook",
                                "target_lang_sense_clarification": "the view from a window or high point"
                            },
                            {
                                "target_lang_word": "panorama",
                                "target_lang_sense_clarification": "a wide, unbroken view of an area"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "пейзаж, открывающийся взору"
                            },
                            {
                                "target_lang_word": "панорама",
                                "target_lang_sense_clarification": "широкий, ничем не ограниченный вид"
                            },
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "вид вдаль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434026c1-1e31-376e-945f-e7176480bfec",
                    "sense_definition": "een verwachting of kans op iets in de toekomst",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toekomstverwachting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na maanden zoeken heeft hij eindelijk <w>uitzicht</w> op een betere baan bij een groot bedrijf.",
                            "target_lang_translations": {
                                "en": "After months of searching, he finally has the <w>prospect</w> of a better job at a large company.",
                                "ru": "После нескольких месяцев поисков у него наконец-то появилась <w>перспектива</w> получить работу получше в крупной компании."
                            }
                        },
                        {
                            "text": "Er is momenteel weinig <w>uitzicht</w> op een snelle oplossing voor dit ingewikkelde probleem.",
                            "target_lang_translations": {
                                "en": "There is currently little <w>prospect</w> of a quick solution to this complicated problem.",
                                "ru": "В настоящее время мало <w>шансов</w> на быстрое решение этой сложной проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooruitzicht",
                        "perspectief",
                        "kans"
                    ],
                    "common_phrases": [
                        "uitzicht op verbetering",
                        "geen uitzicht hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "an expectation or chance of something in the future",
                        "ru": "ожидание или шанс на что-то в будущем"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prospect",
                                "target_lang_sense_clarification": "the possibility or likelihood of a future event"
                            },
                            {
                                "target_lang_word": "outlook",
                                "target_lang_sense_clarification": "the likely future situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "возможность или вероятность будущего события"
                            },
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "возможность осуществления чего-либо"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "в выражении «иметь виды на что-то»"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}