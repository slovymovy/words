                "senses": [
                    {
                        "sense_id": "d7f33514-5644-3cad-9635-ae75edfc5d86",
                        "entry_id": "074649cb-28dc-3a2b-8e75-780f6dd69535",
                        "glosses": [
                            "podpora architektoniczna w postaci kobiecej spełniająca funkcję kolumny lub pilastra, dźwigająca na głowie belkowanie, balkon czy gzyms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9980f6ab-8662-4561-b9f4-2f45a43729dc",
                                "sense_id": "d7f33514-5644-3cad-9635-ae75edfc5d86",
                                "text": "W manieryzmie chętnie stosowano zamiast kolumn kariatydy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "64214892-716e-35c2-a7a6-87cce5fb4924",
                        "entry_id": "074649cb-28dc-3a2b-8e75-780f6dd69535",
                        "glosses": [
                            "piękna kobieta o silnej atletycznej budowie"
                        ],
                        "tags": [
                            "literary",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "8cdce806-d208-4c6d-9ea1-59bd0a78be94",
                                "sense_id": "64214892-716e-35c2-a7a6-87cce5fb4924",
                                "text": "Jak z jednej sztuki brązu ulana, zręczna, silna, z energią na czole, z oczyma pełnemi rozumu i ognia razem, przypominała piękną kariatydę grecką, która dźwignąć może gmach, ale nie ma skrzydeł, by się nad ziemię podniosła"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88df7561-8d03-4e1a-9de2-c15e6bc53d2d",
                        "source_entry_id": "074649cb-28dc-3a2b-8e75-780f6dd69535",
                        "source_sense_id": "d7f33514-5644-3cad-9635-ae75edfc5d86",
                        "target_lang_word": "caryatid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caryatid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96b4dc92-cf81-3fbb-824b-884468f1daec",
                                        "entry_id": "e2ddbd93-7840-39e6-9c98-9e180d98e801",
                                        "glosses": [
                                            "A sculpted female figure serving as an architectural support taking the place of a column or a pillar supporting an entablature on her head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d56817a-7bff-454a-bfb3-3bcc6369d6df",
                                                "sense_id": "96b4dc92-cf81-3fbb-824b-884468f1daec",
                                                "text": "She wore on the top of her head an upright circular cap that made her resemble a caryatid disburdened, and on other parts of her person strange combinations of colours, stuffs, shapes, of metal, mineral and plant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4332319-0dd3-4a0b-99a1-26baaaf694a8",
                        "source_entry_id": "074649cb-28dc-3a2b-8e75-780f6dd69535",
                        "source_sense_id": "d7f33514-5644-3cad-9635-ae75edfc5d86",
