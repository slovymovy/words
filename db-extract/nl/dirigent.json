                    {
                        "sense_id": "66c80def-93a2-369c-bec9-4d02cb07ffa0",
                        "entry_id": "7a9f01f3-9ba2-36e8-85f1-60d6775af732",
                        "glosses": [
                            "een leider van een orkest, koor of ander muziekgezelschap"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "80bde957-7e9f-4ece-a544-e9460e272c02",
                                "sense_id": "66c80def-93a2-369c-bec9-4d02cb07ffa0",
                                "text": "De dirigent wilde dat we onze stukken beter oefenden."
                            },
                            {
                                "example_id": "b45e6e8d-5eb5-4ede-b5d2-e45ceb3c6f2f",
                                "sense_id": "66c80def-93a2-369c-bec9-4d02cb07ffa0",
                                "text": "Kavakos is een rare dirigent, bleek na de pauze in een wisselvallige, maar enerverende Vierde symfonie van Brahms. Nu met baton en groot orkest lichtte hij schitterende details uit. Op cruciale momenten bracht hij zijn organische timing zeer nauwkeurig over op de musici. Maar in plaats van die precisie te bewaren ontaarde zijn slag even later in zwierige vaagheid en liep alles ongelijk."
                            },
                            {
                                "example_id": "142d06a3-5992-490a-a4e0-e519ea0a49f6",
                                "sense_id": "66c80def-93a2-369c-bec9-4d02cb07ffa0",
                                "text": "Hierna tikte hij tweemaal kort met zijn hand op Eveliens bovenbeen. Als een dirigent die om de eerste maten van zijn orkestleden vraagt."
                            }
                        ]
                    }
                ],
