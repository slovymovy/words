                        ],
                        "examples": [
                            {
                                "example_id": "d5d2ee74-8031-4d67-8632-3b12e013d2f6",
                                "sense_id": "f459fb9c-985c-373b-a045-69bbf69ff6a2",
                                "text": "I'm no used to your grandees, and I'm no gawn to begin to learn fashionable mainners noo — so dinna ask me — I'm no gawn to mak a fule o' mysel' at this time o' day."
                            },
                            {
                                "example_id": "04447730-4c7b-4ead-9667-209e8cd6cfad",
                                "sense_id": "f459fb9c-985c-373b-a045-69bbf69ff6a2",
                                "text": "Agnes came in dressed in nightgown and curlers. “Are we still gawn to the church bingo the night? I told Bessie I'd be gawn.”"
                            },
                            {
                                "example_id": "6c91579f-a13d-449b-ac80-9f5f450ad283",
                                "sense_id": "f459fb9c-985c-373b-a045-69bbf69ff6a2",
                                "text": "“Ah'm gawn to tear yore skin off with this here whip,” came the guttural voice from behind him. “Then ah'm gawn to rub salt in the cuts an' leave you hyar on the floor.”"
                            }
                        ]
                    }
