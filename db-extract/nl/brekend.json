                    {
                        "translation_id": "364cdc66-d869-4ce8-82bb-e94b83a5757a",
                        "source_entry_id": "1aac2735-8960-317d-9dad-2f61a18740af",
                        "source_sense_id": "32b12ee2-da30-3425-a1a9-dae63c7941e1",
                        "source_sense_description": "overslaand (van stem)",
                        "target_lang_word": "cassé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cassé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8856a832-fdd7-387f-bde7-f8227bccee9b",
                                        "entry_id": "b6bdb956-271d-33ed-bb20-2a7cbb179797",
                                        "glosses": [
                                            "Mis hors d’usage, détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b0b1c2-41b9-44d8-9685-682a4db363f9",
                                                "sense_id": "8856a832-fdd7-387f-bde7-f8227bccee9b",
                                                "text": "Les marches boueuses portaient l’enseigne de chaque métier en offrant aux regards des découpures de cuivre, des boutons cassés, des brimborions de gaze, de sparterie."
                                            },
                                            {
                                                "example_id": "29d89d85-7c8b-4771-ab57-067bee31a74b",
                                                "sense_id": "8856a832-fdd7-387f-bde7-f8227bccee9b",
                                                "text": "Le boîtier ouvert lui avait livré l’état désespérant d'un mécanisme hors d'usage : rouages encrassés, ressort cassé, cette montre était morte, non de maladie mais de vieillesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207c2af5-c212-3b2e-91e9-6a558396aa49",
                                        "entry_id": "b6bdb956-271d-33ed-bb20-2a7cbb179797",
                                        "glosses": [
                                            "Qui montre une cassure, un angle différent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06af7dc9-8195-4cf4-a1e4-9e6f86046028",
                                                "sense_id": "207c2af5-c212-3b2e-91e9-6a558396aa49",
                                                "text": "Elle avait déjà fait demi-tour et s’éloignait, toute petite, comme recroquevillée dans ses vêtements sombres et sous ce chapeau noir, dont le bord cassé couvrait entièrement sa nuque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c6289b9-f61d-3546-b622-585c43e1b5a8",
                                        "entry_id": "b6bdb956-271d-33ed-bb20-2a7cbb179797",
                                        "glosses": [
                                            "Ivre."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2e23a05-300e-385a-8acd-d6d780041712",
                                        "entry_id": "b6bdb956-271d-33ed-bb20-2a7cbb179797",
                                        "glosses": [
                                            "À court d’argent."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7df4a2cc-bfff-34ce-bd9d-3ddeab922839",
                                        "entry_id": "b6bdb956-271d-33ed-bb20-2a7cbb179797",
                                        "glosses": [
                                            "Se dit d'un dé à jouer (typiquement, un dé à six faces) qui, au terme d'un jet, ne s'est pas arrêté à plat sur l'une de ses faces (par exemple s'il repose en partie sur un objet d'un plateau de jeu), et dont la valeur (celle normalement lue sur la face supérieure) n'est donc pas complètement univoque."
                                        ],
                                        "tags": [
                                            "Jeu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e701a048-bdcc-4d04-865c-0bb199f1411b",
                                                "sense_id": "7df4a2cc-bfff-34ce-bd9d-3ddeab922839",
                                                "text": "je fais parti des dictateurs du lancé de dés, pour moi un dé est cassé à partir du moment où la face inférieure n'est pas à 100% horizontale !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cassé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e213fb4f-5e1d-30c8-a21f-70b8d10ccb45",
                                        "entry_id": "c45a9908-9b6b-3443-a689-e152b6514c56",
                                        "glosses": [
                                            "Cirque naturel. référence nécessaire (résoudre le problème)"
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b642ab1-8839-42f9-aa73-631416258967",
                                                "sense_id": "e213fb4f-5e1d-30c8-a21f-70b8d10ccb45",
                                                "text": "Cet après-midi vers 14h30, on pouvait apercevoir un petit cône très actif, en lisière du cassé dominant la Plaine des Osmondes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cassé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62aa5fed-ff47-357d-a11c-d6b97010c815",
                                        "entry_id": "3fcbf31f-1bf9-3cda-8419-19a2db0342f9",
                                        "glosses": [
                                            "Sucre cuit de manière qu’une goutte projetée dans l’eau froide s’y fige et en sort cassante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cassé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58a14525-7e4c-3933-a182-86cab7515fcc",
                                        "entry_id": "f8837bbb-29d7-3198-b722-dd2921d4c10d",
                                        "glosses": [
                                            "Participe passé masculin singulier de casser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1553a6-69b3-4855-bd91-4e130d134e41",
                                                "sense_id": "58a14525-7e4c-3933-a182-86cab7515fcc",
                                                "text": "Je n’ai pas repris ma vie avec Rosemond pour deux raisons : la première, parce que le mariage a été cassé pour non-consommation, coups et blessures devant témoins et que je ne pouvais même pas la réépouser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
