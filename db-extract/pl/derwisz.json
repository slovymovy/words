                        "entry_id": "dd31036b-1a57-3744-9ad5-48ab58a90af2",
                        "glosses": [
                            "członek muzułmańskiego bractwa religijnego o charakterze mistycznym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "039ca68a-fa0d-3c6d-98a8-f1c69fd3c977",
                        "entry_id": "dd31036b-1a57-3744-9ad5-48ab58a90af2",
                        "glosses": [
                            "pobożny i ascetyczny muzułmański mnich wędrowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5037a359-6317-4ccc-9561-8b806e9510c2",
                                "sense_id": "039ca68a-fa0d-3c6d-98a8-f1c69fd3c977",
                                "text": "Cisza panująca po zagarnięciu ludzi przez derwiszów i widok bananów przynęciły tu spore stado szympansów, które na wyższych drzewach pourządzały sobie nawet rodzaj parasoli lub daszków dla ochrony od deszczu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
