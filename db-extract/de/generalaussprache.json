                "senses": [
                    {
                        "sense_id": "e6ca1ce3-b745-37d6-b69b-64a6b7a77813",
                        "entry_id": "f77d2720-1a7e-357c-89a8-859df26b211f",
                        "glosses": [
                            "das Besprechen, die Erörterung alles dessen, das momentan für wichtig gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f1e8d8-9de7-4e8c-a0ef-fbe911921203",
                                "sense_id": "e6ca1ce3-b745-37d6-b69b-64a6b7a77813",
                                "text": "„Die Generalaussprache zum Thema Agenda 2010 lief im Prinzip am 1. Juni 2003.“"
                            },
                            {
                                "example_id": "34777a2e-7395-4686-be81-a682aeb00f86",
                                "sense_id": "e6ca1ce3-b745-37d6-b69b-64a6b7a77813",
                                "text": "„Rasner schlägt zur Abwicklung der Wehrdebatte vor, die Generalaussprache so gut als möglich zu kürzen, dann in die Einzelberatung einzutreten.“"
                            },
                            {
                                "example_id": "7f83b050-02e7-4e19-a05d-e2d678f3d1ca",
                                "sense_id": "e6ca1ce3-b745-37d6-b69b-64a6b7a77813",
                                "text": "„Die Beratung des Haushaltsplanes in zweiter und dritter Lesung gibt dem Bundestag jedes Jahr Anlaß zu einer Generalaussprache über die Politik der Bundesregierung insgesamt und über den von den einzelnen Ministern dazu beigetragenen Teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
