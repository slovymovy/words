                "senses": [
                    {
                        "sense_id": "ca911e56-7e64-3fbb-ab41-abf1e307afe4",
                        "entry_id": "12cc1836-49a8-3366-94bf-489148e881a6",
                        "glosses": [
                            "meist durch ein Unglück zerstörtes Flugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3feab063-c585-45f7-88b2-e7460a6adabb",
                                "sense_id": "ca911e56-7e64-3fbb-ab41-abf1e307afe4",
                                "text": "„Die Fischer brachten das Flugzeugwrack zu einer Bucht der Great Barrier Insel, etwa 90 Kilometer nordöstlich von Auckland.“"
                            },
                            {
                                "example_id": "ffb21d87-7e42-4da8-a927-aacaf281bceb",
                                "sense_id": "ca911e56-7e64-3fbb-ab41-abf1e307afe4",
                                "text": "„Sein Plan, wie er zum Flugzeugwrack gelangen sollte, war fertig.“"
                            },
                            {
                                "example_id": "313951d5-df75-4b2a-aae7-41ebd06ed7a9",
                                "sense_id": "ca911e56-7e64-3fbb-ab41-abf1e307afe4",
                                "text": "„\"Dies stützt unsere Annahme, dass Tiere die Leiche Fossetts vom Flugzeugwrack weggeschleift haben\", sagte der Sheriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
