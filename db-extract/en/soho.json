                "senses": [
                    {
                        "sense_id": "1abcef8c-b6e3-3bb9-b7af-3c16f92be085",
                        "entry_id": "af484618-7725-3eee-8194-66ea35be0b1a",
                        "glosses": [
                            "ho; halloo; a word used in calling from a distant place."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7e93df68-61ea-4185-b0a9-aecebd8bed93",
                                "sense_id": "1abcef8c-b6e3-3bb9-b7af-3c16f92be085",
                                "text": "Proteus: Run, boy, run, run, and seek him out.\nLaunce: Soho, soho!\nProteus: What seest thou?\nLaunce: Him we go to find […]"
                            },
                            {
                                "example_id": "b2365140-2a23-4946-928d-c4bdbc266bc2",
                                "sense_id": "1abcef8c-b6e3-3bb9-b7af-3c16f92be085",
                                "text": "He then began to beat about, in the same language and in the same manner as if he had been beating for a hare; and at last cried out, \"Soho! Puss is not far off. Here's her form, upon my soul; I believe I may cry stole away.\""
                            }
                        ]
                    }
                ],
