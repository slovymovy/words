                ],
                "senses": [
                    {
                        "sense_id": "81a7b114-1b02-344a-9397-376c200053be",
                        "entry_id": "68355d59-abee-39d2-9c29-e5b018c9cee0",
                        "glosses": [
                            "allgemein: zusätzliche Bedeutung einer Aussage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017c36b7-65b8-4bee-a1d0-affa73c902e4",
                                "sense_id": "81a7b114-1b02-344a-9397-376c200053be",
                                "text": "In der Debatte waren außer weitgehender Zustimmung auch kritische Nebentöne zu hören."
                            },
                            {
                                "example_id": "e5dbadf9-3c5c-4abd-9717-442bcb4df7a3",
                                "sense_id": "81a7b114-1b02-344a-9397-376c200053be",
                                "text": "„Immerhin fiel inmitten des weltweit verbreiteten Schwachsinns ein kritischer Nebenton auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "597d2a89-e9e3-38ae-b6a0-cf000bf833da",
                        "entry_id": "68355d59-abee-39d2-9c29-e5b018c9cee0",
                        "glosses": [
                            "im Vergleich zum Hauptton schwächere Betonung einer Silbe in einem komplexen Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0541025e-5fdf-4474-acfa-7c9e2dc36270",
                                "sense_id": "597d2a89-e9e3-38ae-b6a0-cf000bf833da",
                                "text": "„Vor allem bei mehrsilbigen Wörtern und Wortformen entwickelt sich ein Nebenton, der in vielen Fällen nach dem Zusammenhang der Rede wechselt, in manchen Fällen aber durch die ganze deutsche Sprachgeschichte hindurch eindeutig festliegt…“"
                            },
                            {
                                "example_id": "f8a8e627-e33a-49d8-9f9e-767f3163efe6",
                                "sense_id": "597d2a89-e9e3-38ae-b6a0-cf000bf833da",
                                "text": "In einem Wort wie „Behinderungen“ trägt das „i“ den Hauptton, das „u“ den Nebenton."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
