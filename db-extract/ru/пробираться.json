                                    },
                                    {
                                        "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Fréquenter, avoir des relations suivies ; se convenir mutuellement."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aadde6d-4b87-4f70-bdb4-9b541e3fa032",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "On le croit fier parce qu’il ne fraie avec personne, en fait, il est timide."
                                            },
                                            {
                                                "example_id": "5377b47c-37da-49fb-b3e7-e5a171fc10a3",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Généralement une fois l’explication donnée, Cottard disait : « Ah ! bon, bon, ça va bien » et ne montrait plus trace d’émotion.\nMais cette fois-ci, les derniers mots de Swann, au lieu de lui procurer l’apaisement habituel, portèrent au comble son étonnement qu’un homme avec qui il dînait, qui n’avait ni fonctions officielles, ni illustration d’aucune sorte, frayât avec le Chef de l’État."
                                            },
                                            {
                                                "example_id": "245df9cf-33dd-4567-82af-bc2a57219cdb",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Yves reconnut un de ses camarades, un campagnard, pensionnaire et fort en gymnastique, avec lequel il ne frayait pas."
                                            },
                                            {
                                                "example_id": "444c9bbb-87a9-417b-9068-7f8cd0d0be73",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "— Ils sont en train de tondre les poules qui ont frayé avec les Fritz."
                                            },
                                            {
                                                "example_id": "6f780761-12eb-403b-b03a-db92b5734cb9",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "– C’est toi qui frayes une gonzesse, une brune qui s’appelle Odette ?"
                                            },
                                            {
                                                "example_id": "056a0ab6-6c21-4a8e-839f-fa3fac1196b4",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Non contente d'être une laissée-pour-compte et une cossarde frayant avec des personnages douteux, la fille illégitime du candidat au Sénat Laurence Jeffries était aussi une traînée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b896ebc-f72d-3bc2-b2b4-210288203b1e",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Se reproduire, en parlant des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
