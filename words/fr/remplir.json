{
    "word_family": [
        "remplissage",
        "remplisseuse",
        "rempliable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7788f82-5c7b-3efd-b94e-f27db89fc8f6",
                    "sense_definition": "Mettre une matière, un liquide ou des objets dans un contenant jusqu'à ce qu'il soit plein.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>remplir</w> cette carafe avec de l'eau fraîche pour le dîner."
                        },
                        {
                            "text": "Elle <w>remplit</w> son sac avec toutes ses affaires avant de partir."
                        }
                    ],
                    "synonyms": [
                        "emplir",
                        "combler"
                    ],
                    "antonyms": [
                        "vider"
                    ],
                    "common_phrases": [
                        "remplir une bouteille",
                        "remplir un verre",
                        "remplir la baignoire"
                    ]
                },
                {
                    "sense_id": "303a2120-29dd-30a0-88d5-8b42ba2cad28",
                    "sense_definition": "Inscrire les renseignements demandés dans les espaces prévus d'un document ou d'un questionnaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>remplir</w> ce formulaire avec vos coordonnées pour valider votre inscription."
                        },
                        {
                            "text": "Le candidat <w>remplit</w> soigneusement les cases blanches de son dossier administratif."
                        }
                    ],
                    "synonyms": [
                        "compléter"
                    ],
                    "common_phrases": [
                        "remplir un formulaire",
                        "remplir un questionnaire"
                    ]
                },
                {
                    "sense_id": "a35fb253-0508-31b1-8497-e78b2f8602f6",
                    "sense_definition": "Accomplir une tâche, exercer une fonction ou satisfaire à des conditions requises.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce candidat doit <w>remplir</w> toutes les conditions requises pour obtenir la bourse."
                        },
                        {
                            "text": "Le médecin <w>remplit</w> sa mission avec un dévouement exceptionnel auprès des patients."
                        }
                    ],
                    "synonyms": [
                        "accomplir",
                        "exécuter",
                        "satisfaire"
                    ],
                    "antonyms": [
                        "négliger"
                    ],
                    "common_phrases": [
                        "remplir son devoir",
                        "remplir les conditions",
                        "remplir une mission"
                    ]
                },
                {
                    "sense_id": "58d5a551-dd51-325f-aba8-715833905207",
                    "sense_definition": "Mettre de nouveau du contenu dans ce qui a été vidé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le niveau baisse rapidement, nous devons <w>remplir</w> le réservoir avant notre départ."
                        },
                        {
                            "text": "Le serveur <w>remplit</w> à nouveau nos verres dès qu'ils sont vides."
                        }
                    ],
                    "synonyms": [
                        "recharger",
                        "réapprovisionner"
                    ],
                    "common_phrases": [
                        "remplir le réservoir"
                    ]
                },
                {
                    "sense_id": "dd092109-a0b5-3b98-9e0c-2863f414e001",
                    "sense_definition": "Occuper entièrement ou en grande partie un espace ou un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une foule enthousiaste <w>remplit</w> la salle de concert dès le début de la soirée."
                        },
                        {
                            "text": "Une odeur agréable de café chaud <w>remplissait</w> toute la maison au réveil."
                        }
                    ],
                    "synonyms": [
                        "encombrer",
                        "envahir"
                    ],
                    "common_phrases": [
                        "remplir la salle",
                        "remplir la pièce"
                    ]
                },
                {
                    "sense_id": "a9bcdae1-c1ff-3b7b-b0b4-77fbe612c59d",
                    "sense_definition": "Faire éprouver pleinement une émotion ou un sentiment intense à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette merveilleuse nouvelle nous <w>remplit</w> de joie et d'espoir pour l'avenir."
                        },
                        {
                            "text": "Le succès de ses élèves a <w>rempli</w> le professeur d'une immense fierté."
                        }
                    ],
                    "synonyms": [
                        "combler"
                    ],
                    "common_phrases": [
                        "remplir de joie",
                        "remplir de fierté"
                    ]
                },
                {
                    "sense_id": "c5eb4a34-8e21-3485-9efc-9caecad9683c",
                    "sense_definition": "Occuper ou employer une durée, une période de temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La préparation du festival va <w>remplir</w> nos journées pendant plusieurs semaines consécutives."
                        },
                        {
                            "text": "Elle cherche de nouvelles activités pour <w>remplir</w> ses soirées d'hiver solitaires."
                        }
                    ],
                    "synonyms": [
                        "occuper"
                    ],
                    "common_phrases": [
                        "remplir ses journées",
                        "remplir son temps"
                    ]
                },
                {
                    "sense_id": "fe7643e0-98a7-3be0-8ab4-6721df095b7a",
                    "sense_definition": "Manger ou boire abondamment jusqu'à satiété excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>rempli</w> la panse avec les restes du copieux repas dominical."
                        },
                        {
                            "text": "Les enfants se <w>remplissent</w> le ventre de friandises avant l'heure du dîner."
                        }
                    ],
                    "synonyms": [
                        "gaver"
                    ],
                    "common_phrases": [
                        "se remplir la panse",
                        "se remplir le ventre"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier"
                        }
                    ]
                }
            ]
        }
    ]
