                    },
                    {
                        "form_id": "18473396-4882-49a0-9748-d3b950943aeb",
                        "entry_id": "b44dc1d8-d9d2-3ee1-8da3-e4cc948a43c2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "усме́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c3d3872-2ab8-3cd0-9b0f-955bb485488f",
                        "entry_id": "b44dc1d8-d9d2-3ee1-8da3-e4cc948a43c2",
                        "glosses": [
                            "улыбка, выражающая насмешку, иронию или недоверие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ffc865-c7e6-48b5-8e9d-79fb4298b65b",
                                "sense_id": "6c3d3872-2ab8-3cd0-9b0f-955bb485488f",
                                "text": "— Скажите, Иван Николаевич, а вы-то сами как далеко были от турникета, когда Берлиоз свалился под трамвай? — спросил следователь. Чуть заметная равнодушная усмешка почему-то тронула губы Ивана, и он ответил: — Я был далеко."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb6cc455-0dbb-42d9-9eb3-d7ed4722686e",
                        "source_entry_id": "b44dc1d8-d9d2-3ee1-8da3-e4cc948a43c2",
                        "source_sense_id": "6c3d3872-2ab8-3cd0-9b0f-955bb485488f",
                        "target_lang_word": "sourire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sourire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                        "entry_id": "238aea34-79b8-3b6e-8bd3-df5cb22f3a6c",
                                        "glosses": [
                                            "Rire sans éclat, par un léger mouvement de la bouche et du visage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24524891-4bfd-4396-8500-660404adeff3",
                                                "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                                "text": "Il m’a salué à sa manière, en portant deux doigts à sa tête et en souriant d'un air bonasse."
                                            },
                                            {
                                                "example_id": "ab521757-7fbf-4629-bb48-e575f806061e",
                                                "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                                "text": "Mais Jacques souriait, et il n’avait pas l’air de lui vouloir du mal."
                                            },
                                            {
                                                "example_id": "3faa2ce2-efef-4c3c-a830-056caa83f82e",
                                                "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                                "text": "Les indigènes se montraient très sympathiques, aimables et complaisants ; leurs figures du type mongol caractérisé, souriaient, intelligentes et franches."
                                            },
                                            {
                                                "example_id": "7924308e-6ea6-40a3-9cc3-d0e50cdf157e",
                                                "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                                "text": "Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d’un fennec, souriait."
                                            },
                                            {
                                                "example_id": "4eaf6545-53bb-419c-bc62-67ca98de2f71",
                                                "sense_id": "99204d93-7492-3a6d-988c-ee5493aad937",
                                                "text": "De sa bouche lisse, Amédée souriait, repris par l’hébétude de l’enfance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d27bbc19-045f-395a-ae89-04c91b45b0b0",
                                        "entry_id": "238aea34-79b8-3b6e-8bd3-df5cb22f3a6c",
                                        "glosses": [
                                            "Considérer avec un peu de moquerie ou de dédain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ed8274-49d2-40b5-ac19-43013c017946",
                                                "sense_id": "d27bbc19-045f-395a-ae89-04c91b45b0b0",
                                                "text": "[…] ; ces arbres nains qui nous font sourire nous paraîtraient de grandes merveilles si nous revenions de l’Islande, où nous ne verrons plus la moindre végétation arborescente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fffb4b56-70dc-3947-aaae-8d4269862091",
                                        "entry_id": "238aea34-79b8-3b6e-8bd3-df5cb22f3a6c",
                                        "glosses": [
                                            "Présenter un aspect séduisant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a8bb308-594a-49bc-ace5-b1c177cf72f2",
                                                "sense_id": "fffb4b56-70dc-3947-aaae-8d4269862091",
                                                "text": "Il s'amusait de cette grimace faite au destin et se prenait à rêver que les mouches avaient changé d'âne, que la bourrique avait enfin tourné le cul au foin, et que la veine, désormais, lui sourirait toujours."
                                            },
                                            {
                                                "example_id": "51817c47-82b7-4ebc-8aa6-3da0cb9848c4",
                                                "sense_id": "fffb4b56-70dc-3947-aaae-8d4269862091",
                                                "text": "Qu'est-ce que tu croyais ? Que la chance allait enfin te sourire et t'assurer une sortie sous forme d'un golden parachute ? Mais la scoumoune qui s'est penchée sur ton berceau, avec une schlague en guise de baguette magique, elle ne te lâche plus."
                                            },
                                            {
                                                "example_id": "02409fa7-cbb2-4547-abf5-3b147f20c0f7",
                                                "sense_id": "fffb4b56-70dc-3947-aaae-8d4269862091",
                                                "text": "Cette affaire lui sourit beaucoup."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sourire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                        "entry_id": "69c83db5-27a5-332c-9f91-553343ac904e",
                                        "glosses": [
                                            "Action de sourire ou son résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84f2a33-bd21-445b-8498-25f8e07c2a7c",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "T'as retrouvé le sourire?"
                                            },
                                            {
                                                "example_id": "f0daca50-9930-4153-b4ce-d264b552c1f3",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "On dit que tu aimes le vin et les sourires des dames plus qu’il ne sied à ton ordre, sire prêtre ; mais cela ne me regarde pas."
                                            },
                                            {
                                                "example_id": "f35f4054-8669-4db2-aac3-ae43743bc9fe",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "Ce jour-là, au moment de la séparation, spontanément, avec un sourire heureux, Yasmina lui donna un baiser, le premier..."
                                            },
                                            {
                                                "example_id": "3f4d852f-025b-4f55-84a0-985653d8e29b",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "Ce qui me frappait le plus en lui, c'était le sourire — le plus franc, le plus engageant que j’aie jamais vu sur aucune face humaine."
                                            },
                                            {
                                                "example_id": "cb857c34-149c-4c25-9184-5d7f4c0947b8",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "Il n'a pas pris soin de son sourire qui ne sert à personne. Ses dents sont noires et sa barbe, longue."
                                            },
                                            {
                                                "example_id": "0058b52b-df1a-4ac2-8f48-9bc8bd6c04e8",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "Il existe aussi de nombreux exemples de langage corporel ludique chez les animaux, comme des expressions faciales de \"sourire\" chez les primates ou les canidés."
                                            },
                                            {
                                                "example_id": "55a29dad-49c6-47b5-9e99-bdfb47c0a2f5",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "— Un soir, à l'insu du brigadier, sa fille est entrée chez l'instituteur, le sourire aux yeux, les lèvres plus rouges que ces tablettes de sucre écarlate — des coquelicots — qu'on suce contre les enrouements; […]."
                                            },
                                            {
                                                "example_id": "e5e2155e-701f-4f7e-81b9-bba9a9f460a1",
                                                "sense_id": "715ccc40-b8be-3b38-8195-0a4f6208bcb5",
                                                "text": "— Privé de tout accommodement, de ses fards, de ses sourires et de ses ruses, le vice a peu de chance de séduire la vertu la plus chancelante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
