                {
                    "sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                    "sense_definition": "iets wat men laat zien of merken door middel van woorden, gebaren of gedrag",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een plotselinge <w>uiting</w> van woede was het onverwachte gevolg van de discussie.",
                            "target_lang_translations": {
                                "en": "A sudden <w>expression</w> of anger was the unexpected result of the discussion.",
                                "de": "Ein plötzlicher <w>Ausbruch</w> von Wut war die unerwartete Folge der Diskussion."
                            }
                        },
                        {
                            "text": "Ik geloof dat elkaar vrijheid gunnen een mooie <w>uiting</w> van liefde is binnen een gezonde relatie.",
                            "target_lang_translations": {
                                "en": "I believe that granting each other freedom is a beautiful <w>expression</w> of love within a healthy relationship.",
                                "de": "Ich glaube, dass es ein schöner <w>Ausdruck</w> von Liebe in einer gesunden Beziehung ist, einander Freiraum zu geben."
                            }
                        }
                    ],
                    "synonyms": [
                        "expressie",
                        "betuiging",
                        "manifestatie"
                    ],
                    "antonyms": [
                        "onderdrukking",
                        "verhulling"
                    ],
                    "common_phrases": [
                        "uiting van woede",
                        "uiting van liefde",
                        "tot uiting komen"
                    ],
                    "target_lang_definitions": {
                        "en": "something shown or noticed through words, gestures, or behavior",
                        "de": "etwas, das man durch Worte, Gesten oder Verhalten zeigt oder bemerkbar macht"
                    },
