                "senses": [
                    {
                        "sense_id": "3ffe82b2-b5e9-3c76-ad38-35dabc213011",
                        "entry_id": "06005421-521c-393a-ad26-aa33335c7688",
                        "glosses": [
                            "Seitenwand einer Tasse"
