                ],
                "senses": [
                    {
                        "sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                        "entry_id": "1c3b32a9-e598-3d7c-a431-5d6319c6f5bf",
                        "glosses": [
                            "Qui n’est pas articulé, ou qui ne l’est qu’imparfaitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0ec77a-8923-46bb-8ad4-63c331ddeb80",
                                "sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                                "text": "Elle voulut parler, mais sa voix ne put proférer que des sons inarticulés, comme ceux qu’on laisse échapper pendant un rêve."
                            },
                            {
                                "example_id": "46130137-7f70-432a-8bb5-60f642442704",
                                "sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                                "text": "Une rage et un désespoir inarticulés, seuls, le soutenaient faiblement."
                            },
                            {
                                "example_id": "d00f12f7-8dd7-43db-bf31-697dd48828e4",
                                "sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                                "text": "Brusquement, il tomba à genoux, enfouit sa tête dans les coussins de soie d'un canapé et, longtemps, il cria sa douleur en plaintes inarticulées."
                            },
                            {
                                "example_id": "e0f257ec-1256-47fb-afe2-1f4f0fc44b7d",
                                "sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                                "text": "Ses lectures à haute voix sont inarticulées, ce qui étonne quand on pense qu’elles charmeront plus tard son mari, juge difficile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b888e9c6-2545-4269-bafc-63bc1037dad5",
                        "source_entry_id": "1c3b32a9-e598-3d7c-a431-5d6319c6f5bf",
                        "source_sense_id": "7206931f-0046-328e-b041-e88c2b75c66e",
                        "target_lang_word": "inarticulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
