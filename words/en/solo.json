                {
                    "sense_id": "4a996eea-b93e-3009-8105-e0e16b18774b",
                    "sense_definition": "To drop a ball and kick it back into one's own hands while running.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player managed to <w>solo</w> the ball down the field past the defenders.",
                            "target_lang_translations": {
                                "ru": "Игроку удалось <w>провести</w> мяч по полю мимо защитников.",
                                "zh": "球员成功<w>带球</w>越过防守队员冲向场地。"
                            }
                        },
                        {
                            "text": "In Gaelic football, you must <w>solo</w> or bounce the ball every four steps.",
                            "target_lang_translations": {
                                "ru": "В гэльском футболе нужно <w>делать соло</w> или ударять мячом о землю каждые четыре шага.",
                                "zh": "在盖尔式足球中，你必须每走四步就<w>带球</w>或运球一次。"
                            }
                        }
                    ],
