                {
                    "sense_id": "2f9f5fa5-a42d-3c20-a499-e71fc9de8d9f",
                    "sense_definition": "Ensemble d'objets disparates, affaires encombrantes ou matériel hétéroclite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends toutes tes affaires et range tout ton <w>bazar</w> avant ce soir.",
                            "target_lang_translations": {
                                "en": "Gather all your things and tidy your <w>stuff</w> away before tonight.",
                                "ru": "Возьми все свои вещи и убери всё своё <w>барахло</w> до сегодняшнего вечера.",
                                "de": "Nimm alle deine Sachen und räum bis heute Abend deinen ganzen <w>Krempel</w> weg.",
                                "es": "Toma todas tus cosas y guarda todos tus <w>trastos</w> antes de esta noche.",
                                "zh": "把你所有的东西都收拾起来，今晚之前把你的<w>杂物</w>整理好。"
                            }
                        },
                        {
                            "text": "Nous avons entassé tout le <w>bazar</w> dans le coffre de la voiture.",
                            "target_lang_translations": {
                                "en": "We crammed all the <w>stuff</w> into the boot of the car.",
                                "ru": "Мы затолкали всё <w>барахло</w> в багажник машины.",
                                "de": "Wir haben den ganzen <w>Krempel</w> in den Kofferraum des Autos gestopft.",
                                "es": "Amontonamos todos los <w>trastos</w> en el maletero del coche.",
                                "zh": "我们把所有的<w>杂物</w>都塞进了汽车后备箱。"
                            }
                        }
                    ],
                    "common_phrases": [
