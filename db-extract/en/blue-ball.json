                "senses": [
                    {
                        "sense_id": "16ae4c68-bfe7-3aaa-8089-ebbc570b449c",
                        "entry_id": "06b9a31b-250b-3e8f-918a-cea891389b7c",
                        "glosses": [
                            "To leave (a person, usually a man) sexually frustrated by denying them an orgasm or abruptly ending sexual contact."
                        ],
                        "tags": [
                            "slang",
                            "transitive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "99563c19-019e-454b-ae21-ac2ab1daca0b",
                                "sense_id": "16ae4c68-bfe7-3aaa-8089-ebbc570b449c",
                                "text": "“Stop blue-balling the guy and give in already.”"
                            },
                            {
                                "example_id": "83ca7441-4950-4906-9fa7-ebe7f8ae86c6",
                                "sense_id": "16ae4c68-bfe7-3aaa-8089-ebbc570b449c",
                                "text": "I'm not even upset; I'm just tired of being blue-balled and tired of being rejected. It's just sad to see that I have to argue about having sex with my wife."
                            },
                            {
                                "example_id": "ac6ae40f-edd2-4b5a-a200-f4e47ca0ad60",
                                "sense_id": "16ae4c68-bfe7-3aaa-8089-ebbc570b449c",
                                "text": "I thought it would be a good way to go out—to blue-ball him into submission and then leave, the way all of the cool girls did in the movies."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa54616b-3113-3c83-9f9e-97aa1e2f39d1",
                        "entry_id": "06b9a31b-250b-3e8f-918a-cea891389b7c",
                        "glosses": [
                            "To lead someone on or tease them with the promise of something desirable without actually delivering it, causing them to feel frustrated and unsatisfied."
                        ],
                        "tags": [
                            "broadly",
                            "idiomatic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d5763549-fd2d-4d85-b57c-5012eb4e1e0d",
                                "sense_id": "aa54616b-3113-3c83-9f9e-97aa1e2f39d1",
                                "text": "Stop blue-balling me and tell me what happened!"
                            }
                        ]
                    }
