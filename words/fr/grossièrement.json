    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0dcf9207-6509-35df-842c-ae424b5870c9",
                    "sense_definition": "D'une manière impolie, sans égards ni respect envers autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impolitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le client mécontent a parlé très <w>grossièrement</w> à la jeune vendeuse."
                        },
                        {
                            "text": "Il est inacceptable de répondre <w>grossièrement</w> à une question polie de son professeur."
                        }
                    ],
                    "antonyms": [
                        "poliment",
                        "courtoisement"
                    ],
                    "common_phrases": [
                        "parler grossièrement",
                        "répondre grossièrement"
                    ]
                },
                {
                    "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                    "sense_definition": "De façon approximative, générale et sans entrer dans les détails.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On peut estimer <w>grossièrement</w> la durée du trajet à trois heures de route."
                        },
                        {
                            "text": "Le professeur a <w>grossièrement</w> esquissé les grandes étapes du projet sur le tableau."
                        }
                    ],
                    "synonyms": [
                        "en gros",
                        "grosso modo",
                        "sommairement"
                    ],
                    "antonyms": [
                        "précisément",
                        "exactement"
                    ],
                    "common_phrases": [
                        "estimer grossièrement",
                        "grossièrement esquissé"
                    ]
                },
                {
                    "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                    "sense_definition": "De manière rudimentaire, sans soin ou sans finesse d'exécution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fabrication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite chaise en bois a été <w>grossièrement</w> fabriquée avec des outils anciens."
                        },
                        {
                            "text": "Les silhouettes des arbres étaient <w>grossièrement</w> peintes sur la toile de fond."
                        }
                    ],
                    "synonyms": [
                        "imparfaitement"
                    ],
                    "antonyms": [
                        "finement",
                        "soigneusement"
                    ],
                    "common_phrases": [
                        "grossièrement fait",
                        "grossièrement taillé"
                    ]
                },
                {
                    "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                    "sense_definition": "De manière lourde et flagrante, en parlant d'une erreur ou d'une tromperie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes ont été <w>grossièrement</w> trompés par ces faux bilans comptables."
                        },
                        {
                            "text": "Ce document officiel contenait des chiffres <w>grossièrement</w> falsifiés par les fraudeurs."
                        }
                    ],
                    "synonyms": [
                        "à gros sabots"
                    ],
                    "antonyms": [
                        "subtilement"
                    ],
                    "common_phrases": [
                        "grossièrement trompé",
                        "grossièrement abusé"
                    ]
                }
            ]
        }
    ]
}