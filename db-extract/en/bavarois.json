                        "target_lang_word": "bavarois",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavarois",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37dfc239-3a18-3324-93ef-3f53b5f2084b",
                                        "entry_id": "f2e4c38b-0b9e-33bd-adbb-c15303d9df17",
                                        "glosses": [
                                            "een koud dessert dat bereid wordt met gelatine, vruchtenmoes en slagroom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91200f3-614b-4825-8cb2-0a08a2f8da6d",
                                                "sense_id": "37dfc239-3a18-3324-93ef-3f53b5f2084b",
                                                "text": "Een bavarois stijft, in tegenstelling tot de meeste puddingen, niet op met behulp van zetmeel maar door middel van eieren en gelatine. Omdat de werking van gelatine afhankelijk is van temperatuur, is een baravois geen toetje dat je even snel in elkaar flanst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f115f29-0355-4ae1-abfe-8a653083d403",
                        "source_entry_id": "cae61910-9191-3df0-a485-97d829a2d264",
                        "source_sense_id": "3d695369-8aa7-3ff7-9670-396bf9c444bf",
                        "source_sense_description": "pudding",
                        "target_lang_word": "bavarois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavarois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3298b4d-64ae-37e6-b3c5-c3f5b18a382c",
                                        "entry_id": "97dbe450-c3f9-3ed3-a8b2-872aed823b0a",
                                        "glosses": [
                                            "Relatif à la Bavière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3f04fb-66ab-4950-b779-63cf5e45be58",
                                                "sense_id": "d3298b4d-64ae-37e6-b3c5-c3f5b18a382c",
                                                "text": "Depuis le matin, il giboulait. Le ciel et la terre avaient une même couleur de boue et les pins de la forêt bavaroise étaient plus noirs que jamais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bavarois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98d4f11a-2aa9-3898-803c-8a5e517830bd",
                                        "entry_id": "7bd5c7eb-8a34-392a-bf66-d87473aa4d39",
                                        "glosses": [
                                            "Entremets, généralement à base de mousse de fruits."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40716c0-5887-4d9f-aed1-948d62f60c4f",
                                                "sense_id": "98d4f11a-2aa9-3898-803c-8a5e517830bd",
                                                "text": "Je passai à la boulangerie près de chez nous et pris un magnifique bavarois au chocolat que la boulangère qui nous connaissait bien m'agrémenta rapidement d'un magnifique « Bon anniversaire Papa » à l'aide d'une poche à douille de chantilly. Je m'en léchai les doigts d'avance ."
                                            },
                                            {
                                                "example_id": "50269347-6b61-4b88-95cd-d9f44bfcb3ac",
                                                "sense_id": "98d4f11a-2aa9-3898-803c-8a5e517830bd",
                                                "text": "[…], notre vibrant Broadcast Blender Custom se la coule douce, délaissant les émulsions radiophoniques pour retrouver ses fonctions culinaires premières, broyant, remuant, mélangeant, liquéfiant selon mes lubies du moment: cocktails pétillants, glaces ou sorbets déliquescents, ou bavarois aux fraises à en faire baver d’envie Ricardo et Josée di Stasio en même temps!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9474fd7-1bbe-3dad-ae4a-e2630ed8af1b",
                                        "entry_id": "7bd5c7eb-8a34-392a-bf66-d87473aa4d39",
                                        "glosses": [
                                            "Groupe de dialectes du sud de l’Allemagne qui forment, avec l’alémanique, l’allemand supérieur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "315a9117-7439-468f-b413-cbee93d9d2bf",
                        "source_entry_id": "cae61910-9191-3df0-a485-97d829a2d264",
                        "source_sense_id": "3d695369-8aa7-3ff7-9670-396bf9c444bf",
                        "source_sense_description": "pudding",
                        "target_lang_word": "Creme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Creme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                        "entry_id": "6e6b3aa7-0dce-3cb4-abd1-cb85f484abeb",
                                        "glosses": [
                                            "meist fetthaltige Substanz zur äußerlichen Pflege der Haut"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e77a34-6f7b-4f02-854f-ac4d1b581236",
                                                "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                                "text": "Meine Hände sind voller Creme."
                                            },
                                            {
                                                "example_id": "3ba6bdd4-287d-4ef9-b32e-5726e60027b7",
                                                "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                                "text": "„Die Suche nach der perfekten Creme entspricht der Suche nach dem Heiligen Gral, beide verheißen ewige Jugend.“"
                                            },
                                            {
                                                "example_id": "8895fe72-48b2-479a-9b01-de11cdc4c8bd",
                                                "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                                "text": "„Streichen Sie auf Verbrennungen keine Cremen oder Hausmittel wie etwa Mehl oder Melkfett.“"
                                            },
                                            {
                                                "example_id": "64bf4a57-50db-4522-8660-10ed258f2027",
                                                "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                                "text": "„In flachen Tiegeln schimmerten bleiche Cremes, und herbe riechendes Wasser stand in breiten Schalen.“"
                                            },
                                            {
                                                "example_id": "124dd98b-524a-4ba8-b831-155a7a18ca39",
                                                "sense_id": "8576839e-4883-368c-b432-f6f040d7b54a",
                                                "text": "„Andeutungen gab es genug, die vielen Salben und Cremes, Hornhautfeilen und Binden, sie waren verteilt auf Regalfächer und Ablageflächen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7644ca6d-d2a7-3f35-93ad-96c41c909faf",
                                        "entry_id": "6e6b3aa7-0dce-3cb4-abd1-cb85f484abeb",
                                        "glosses": [
                                            "häufig süße Speise, die ihre charakteristische Konsistenz zum Beispiel durch aufgeschlagene Sahne, Butter oder Eier erhält"
                                        ],
                                        "tags": [
                                            "Kochkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a988fea7-ed67-418c-873f-d86f99a9c1c9",
                                                "sense_id": "7644ca6d-d2a7-3f35-93ad-96c41c909faf",
                                                "text": "Sie liebt Süßspeisen über alles und isst öfters Cremes zum Dessert."
                                            },
                                            {
                                                "example_id": "a15c9fd6-4343-4eb4-ab2b-1ba43e8926ff",
                                                "sense_id": "7644ca6d-d2a7-3f35-93ad-96c41c909faf",
                                                "text": "„Diese leichte Konversation unterhielt uns bis zum Nachtisch, einer katalanischen Creme mit Zimt; dann tranken wir einen Anisschnaps.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c948593-95dd-358a-b548-934de6295d87",
                                        "entry_id": "6e6b3aa7-0dce-3cb4-abd1-cb85f484abeb",
                                        "glosses": [
                                            "milchige, fetthaltige Flüssigkeit zum Weißen von Kaffee"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5915ad-fa37-4162-8951-ec93ff2be844",
                                                "sense_id": "0c948593-95dd-358a-b548-934de6295d87",
                                                "text": "Er trinkt den Kaffee ohne Creme, weil er auf seine Gesundheit achtet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "69460dd3-7a22-34ff-a888-0a16c70118f7",
                                        "entry_id": "6e6b3aa7-0dce-3cb4-abd1-cb85f484abeb",
                                        "glosses": [
                                            "Gruppe von Leuten, die als die ranghöchsten Vertreter auf einem bestimmten Gebiet gelten"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb549ba-4376-4ebb-90c6-4e521f560803",
                                                "sense_id": "69460dd3-7a22-34ff-a888-0a16c70118f7",
                                                "text": "Die Creme der Gesellschaft lässt Gesetze so entstehen, wie es ihr passt."
                                            },
                                            {
                                                "example_id": "c3de3c44-640b-47bb-9129-10cead9268fc",
                                                "sense_id": "69460dd3-7a22-34ff-a888-0a16c70118f7",
                                                "text": "„Denn das German Investment Seminar der Dresdner Kleinwort Wasserstein, auf dem sich von A wie Adidas bis V wie Volkswagen die Creme der bundesrepublikanischen Wirtschaft präsentiert, verzeichnet in diesem Jahr einen Rekordansturm von Investoren.“"
                                            },
                                            {
                                                "example_id": "8cab4c64-6601-4392-8bf3-eb482ea7deab",
                                                "sense_id": "69460dd3-7a22-34ff-a888-0a16c70118f7",
                                                "text": "„Als in den Sechzigern die Creme der Hippies und des Rock'n'Roll Marokko entdeckte, war er ihr Gastgeber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
