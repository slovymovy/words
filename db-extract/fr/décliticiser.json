                "senses": [
                    {
                        "sense_id": "d5cba13e-4d78-38bb-8f88-4508681be88b",
                        "entry_id": "6b52e925-5c8d-30d3-b018-0be94d9582fe",
                        "glosses": [
                            "Faire perdre son caractère clitique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9843351b-095f-4890-b161-5104ed7cf880",
                                "sense_id": "d5cba13e-4d78-38bb-8f88-4508681be88b",
                                "text": "Exemple en adangme (Ghana), où l’indice personnel sujet est décliticisé du verbe et porte, en énoncé négatif (comme aussi dans quelques autres types marqués d’énoncés positifs), son ton intrinsèque, alors qu’il porte un ton bas au positif : (…)"
                            },
                            {
                                "example_id": "08cbbdd3-0c61-49c6-a676-edd29e4a0fd3",
                                "sense_id": "d5cba13e-4d78-38bb-8f88-4508681be88b",
                                "text": "Cela pourrait s'expliquer par le fait que dans le parler de certains locuteurs les CLS tendent à se \"décliticiser\"."
                            }
                        ]
                    }
