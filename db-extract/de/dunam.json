                "senses": [
                    {
                        "sense_id": "550e3a68-5eb5-3f75-9420-e1c4f5f918b4",
                        "entry_id": "924acd3c-97ef-32ac-b3a5-cea96aa263b4",
                        "glosses": [
                            "aus dem Osmanischen Reich stammendes Flächenmaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3860a6-faa8-412a-b6a5-49d24ceebc5e",
                                "sense_id": "550e3a68-5eb5-3f75-9420-e1c4f5f918b4",
                                "text": "„Besonders empört zeigte er sich über Samuels Entscheidung, einem Beduinenstamm Hunderttausende Dunam (1 Dunam entspricht knapp 1000 Quadratmeter) Regierungsland im Beit-Sche’an-Tal zu überlassen.“"
                            },
                            {
                                "example_id": "d4eb3b47-a881-437f-b4c5-469bbe52cf8c",
                                "sense_id": "550e3a68-5eb5-3f75-9420-e1c4f5f918b4",
                                "text": "„So konnte Sharett bei einem Vortrag, den er am 13. Dezember 1938 vor Angestellten zionistischer Organisationen in Jerusalem hielt, von einer besonders zufriedenstellenden Leistung berichten: dem Ankauf von 2500 Dunam (etwa 1000 m² oder 0,1 ha) Land im Baysan-Tal in Ostpalästina.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00ff93ec-0d4f-4ba1-92dd-5b04599e4527",
                        "source_entry_id": "924acd3c-97ef-32ac-b3a5-cea96aa263b4",
                        "source_sense_id": "550e3a68-5eb5-3f75-9420-e1c4f5f918b4",
                        "source_sense_description": "aus dem Osmanischen Reich stammendes Flächenmaß",
                        "target_lang_word": "dunam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dunam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baf37547-9269-30bc-a48b-e07d282fe3ce",
                                        "entry_id": "e23cfe5b-a054-3500-a53c-2c7ebb884a6a",
                                        "glosses": [
                                            "An Ottoman Turkish unit of surface area nominally equal to 1,600 square (Turkish) paces but actually varied at a provincial and local level according to land quality to accommodate its colloquial sense of the amount of land able to be plowed in a day, roughly equivalent to the Byzantine stremma or English acre."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4262a5-4ccb-4ea3-b55f-285921b355c0",
                                                "sense_id": "baf37547-9269-30bc-a48b-e07d282fe3ce",
                                                "text": "You pay eight marks and they plant a dunam of land for you with olives, oranges, almonds or citrons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbbff218-6363-3c77-a5f8-0e914c0ce296",
                                        "entry_id": "e23cfe5b-a054-3500-a53c-2c7ebb884a6a",
                                        "glosses": [
                                            "A modern Turkish unit of surface area equal to a decare (1000 m²), equivalent to the modern Greek stremma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa99492b-269a-36d1-a412-4738e327b183",
                                        "entry_id": "e23cfe5b-a054-3500-a53c-2c7ebb884a6a",
                                        "glosses": [
                                            "Various other units in other areas of the former Ottoman Empire, usually equated to the decare but sometimes varying (as in Iraq, where it is 2500 m²)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
