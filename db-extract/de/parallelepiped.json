                                        "entry_id": "f66118ab-ab61-3eb7-81c2-b6fb6e90df32",
                                        "glosses": [
                                            "forma geometrica tridimensionale composta da sei lati tra loro paralleli"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ee85cc-8610-499c-8dc1-9b552b20d0c1",
                                                "sense_id": "433b9c3b-869a-3ee2-8be8-0890ff71aade",
                                                "text": "il volume di un parallelepipedo è pari al prodotto dell'area di una sua faccia qualsiasi per la sua distanza minima dalla faccia opposta"
                                            }
                                        ]
