                        "entry_id": "28878865-3686-39a7-bfd3-c574881f7cfc",
                        "glosses": [
                            "A wooden block, the size of a brick, built into a wall, as a hold for the nails of woodwork."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8212e8-f2b3-4fa7-ae96-f0f787a9976a",
                                "sense_id": "261da2c6-2db6-35d8-b51e-29202ca65e2c",
                                "text": "Within a wall,[…], we find vertical studs, nogs or blocking, top and bottom plates, perhaps some form of diagonal braces, and many nailed and screwed connections."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b43a97f-1904-33c7-9783-c39d4856fb93",
                        "entry_id": "28878865-3686-39a7-bfd3-c574881f7cfc",
                        "glosses": [
                            "One of the square logs of wood used in a pile to support the roof of a mine."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4164fb08-f9a3-41f4-9b41-6b7a5e30dc16",
                                "sense_id": "5b43a97f-1904-33c7-9783-c39d4856fb93",
                                "text": "nogs and chocks are used to support the roof where waste material can not conveniently be obtained"
                            }
                        ]
                    },
