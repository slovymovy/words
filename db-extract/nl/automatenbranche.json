                        ],
                        "examples": [
                            {
                                "example_id": "bc98060d-0ac0-4d4c-a53c-440cc519a363",
                                "sense_id": "bf257772-81e6-331b-97b6-f05074dfff50",
                                "text": "BRUSSEL - Het Thaise muntstuk van 10 baht (ongeveer 11 frank), zorgt voor een probleem in de automatenbranche. De Thaise munt lijkt zo sterk op de nieuwe munt van 2 euro (ongeveer 80 frank) dat automaten moeite hebben om hem te onderscheiden. Dat heeft men in Nederland ontdekt. Ook de munt van 2 Britse pence kan voor een andere munt aangezien worden."
                            },
                            {
                                "example_id": "690081af-de37-42ca-94a6-00f0ae908eec",
                                "sense_id": "bf257772-81e6-331b-97b6-f05074dfff50",
                                "text": "ECB-woordvoerder Körber waarschuwde dat bankbiljetten duurder zijn omdat ze veel sneller slijten dan munten en eerder vervangen moeten worden. Voorts kunnen de ministeries van financiën van de eurostaten dwarsliggen omdat zij aan de productie van munten verdienen. Ook de automatenbranche, die vorig jaar veel geld en moeite heeft gestoken in het aanpassen van apparaten aan de nieuwe munten, zal niet blij zijn als die munten door bankbiljetten worden vervangen."
                            }
                        ]
                    }
