                    {
                        "sense_id": "0a9aae75-064a-3ad1-a590-6e45d4d3c5ef",
                        "entry_id": "4341f531-63d4-3da6-b63a-aaa73b48a7ea",
                        "glosses": [
                            "der Teil des Sprechakts, der aus der sprachlichen Äußerung besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101e8c2e-1a98-4eec-b9e6-1670bd4e58fd",
                                "sense_id": "0a9aae75-064a-3ad1-a590-6e45d4d3c5ef",
                                "text": "Die Lokution des kleinen Satzes \"Es zieht\" besteht in der Äußerung von zwei Wörtern, die phonetisch, grammatisch und semantisch richtig gebildet sind und einen korrekten Satz ergeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc4e4798-1988-4965-aa63-1cb16ad3c0c3",
                        "source_entry_id": "4341f531-63d4-3da6-b63a-aaa73b48a7ea",
                        "source_sense_id": "0a9aae75-064a-3ad1-a590-6e45d4d3c5ef",
                        "source_sense_description": "Linguistik: der Teil des Sprechakts, der aus der sprachlichen Äußerung besteht",
                        "target_lang_word": "locution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a9749f-118b-3acd-9724-c2cfb3be61b0",
                                        "entry_id": "def65dce-bccf-300c-b390-4b2b3960380c",
                                        "glosses": [
                                            "A phrase or expression peculiar to or characteristic of a given person or group of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "657beefc-f71c-46b3-b261-080b7ddcbe32",
                                                "sense_id": "b8a9749f-118b-3acd-9724-c2cfb3be61b0",
                                                "text": "The television show host is widely recognized for his all-too-common locutions."
                                            },
                                            {
                                                "example_id": "50197498-4d16-4c90-91ee-50916f2a1c20",
                                                "sense_id": "b8a9749f-118b-3acd-9724-c2cfb3be61b0",
                                                "text": "Another way fathers impact sons is that sons, once their voices have changed in puberty, invariably answer the telephone with the same locutions and intonations of their fathers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "150efc79-2ee8-3610-b185-b366c4784f31",
                                        "entry_id": "def65dce-bccf-300c-b390-4b2b3960380c",
                                        "glosses": [
                                            "The use of a word or phrase in an unusual or specialized way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34afe024-efec-4b7f-babb-eadc7b38937e",
                                                "sense_id": "150efc79-2ee8-3610-b185-b366c4784f31",
                                                "text": "So it cannot be supposed that promisings differ from other word-givings in that a word-giver makes a promise only if he or she uses the locution \"I promise\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176e6efe-6028-3f1e-8e29-1a062b636274",
                                        "entry_id": "def65dce-bccf-300c-b390-4b2b3960380c",
                                        "glosses": [
                                            "Style of discourse or usage, or any particular utterance in such style."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a921b7a2-8af7-44da-8405-25de50171462",
                                                "sense_id": "176e6efe-6028-3f1e-8e29-1a062b636274",
                                                "text": "informal locutions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "356f9cf7-01f7-3e09-be4b-fe6446338392",
                                        "entry_id": "def65dce-bccf-300c-b390-4b2b3960380c",
                                        "glosses": [
                                            "A supernatural revelation where a religious figure, statue or icon speaks, usually to a saint."
                                        ],
