                "senses": [
                    {
                        "sense_id": "74838a4c-ff75-3293-abab-16b94d0097d3",
                        "entry_id": "d42f91a9-aa28-362e-81d0-7c79c844fa2d",
                        "glosses": [
                            "eine Anagoge (einen erhöhten Sinn) betreffend"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f5e95c66-bddf-4675-a333-bf0c47275ff9",
                                "sense_id": "74838a4c-ff75-3293-abab-16b94d0097d3",
                                "text": "„[…] er wünscht eine Führung \", die auf die individuellen, werthaften Ich-Erlebnisse eingeht, eine \"anagogische\", wertorientierte Analyse, während Freud eine ausdrücklich pädagogische Bemühung des Analytikers ablehnt und sich als Arzt wie als Forscher auf die rein naturwissenschaftliche Erkenntnis beschränkt: in der sokratischen Meinung, daß Klären, Wissen, Einsehen auch ohne besondere Führung und Verweisung auf irgendwelche Ideale eine therapeutische Wirkung habe.“"
                            }
                        ],
