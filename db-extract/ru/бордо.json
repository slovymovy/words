                                    {
                                        "sense_id": "29372bde-3820-3d78-9a09-9530d246d899",
                                        "entry_id": "14e2f5f4-8e66-39aa-afa1-fad8c85a869c",
                                        "glosses": [
                                            "The capital city of Gironde department, France; the capital city of the region of Nouvelle-Aquitaine."
                                        ],
                                        "tags": [],
