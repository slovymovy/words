                        "examples": [
                            {
                                "example_id": "9d1e0173-7b4c-485f-8065-3aa2dfc09f2d",
                                "sense_id": "62804827-f201-3447-ab5b-43486f8c3c51",
                                "text": "Philip war irgendwann zum Islam konvertiert, also lange Zeit kein Muslim, und war Herkunftsdeutscher."
                            },
                            {
                                "example_id": "0ff1bbef-1af2-4dd9-9a39-f9648282b2c8",
                                "sense_id": "62804827-f201-3447-ab5b-43486f8c3c51",
                                "text": "Natürlich gibt es Putin-nahe Russlanddeutsche, genauso wie es Erdoğan-Anhänger in der deutschtürkischen Community gibt. Es gibt aber auch genügend Herkunftsdeutsche, manche von ihnen hochrangige Politiker, die mit Autokraten Geschäfte machen. Warum bekommen die eigentlich noch ihr Schnitzel serviert?"
                            }
                        ]
                    }
