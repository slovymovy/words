{
    "word_family": [
        "sob"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b8c6240-3e17-3d35-a484-381ed80560a7",
                    "sense_definition": "Characterized by or expressing sorrow through the act of sobbing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sobbing</w> child held onto her mother tightly after the scary movie.",
                            "target_lang_translations": {
                                "cs": "<w>Vzlykající</w> dítě se po tom strašidelném filmu pevně drželo své matky."
                            }
                        },
                        {
                            "text": "She tried to speak through her <w>sobbing</w> breath while explaining what happened.",
                            "target_lang_translations": {
                                "cs": "Snažila se mluvit přes své <w>vzlykání</w>, zatímco vysvětlovala, co se stalo."
                            }
                        }
                    ],
                    "synonyms": [
                        "crying"
                    ],
                    "common_phrases": [
                        "sobbing child",
                        "sobbing breath"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyjádření smutku nebo bolesti prostřednictvím vzlykání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzlykající",
                                "target_lang_sense_clarification": "označuje osobu, která právě vzlyká"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1977a870-07cf-3c87-9e66-3a0db52bdb1d",
                    "sense_definition": "The act of crying or weeping with short, convulsive breaths.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet <w>sobbing</w> in the corner of the room made everyone feel sad.",
                            "target_lang_translations": {
                                "cs": "Tiché <w>vzlykání</w> v rohu místnosti vyvolalo v každém smutek."
                            }
                        },
                        {
                            "text": "Her <w>sobbing</w> eventually turned into calm, steady breathing as she began to recover.",
                            "target_lang_translations": {
                                "cs": "Její <w>vzlykání</w> se nakonec změnilo v klidný, pravidelný dech, jak se začala uklidňovat."
                            }
                        }
                    ],
                    "synonyms": [
                        "crying",
                        "sobs"
                    ],
                    "common_phrases": [
                        "quiet sobbing",
                        "uncontrollable sobbing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projev pláče doprovázený krátkými, křečovitými nádechy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzlykání",
                                "target_lang_sense_clarification": "podstatné jméno označující děj"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab7bb30e-b23c-3ccc-95fc-b0dcb8059a9c",
                    "sense_definition": "The present participle and gerund of <w>sob</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>sobbing</w> uncontrollably after hearing the terrible news.",
                            "target_lang_translations": {
                                "cs": "Poté, co uslyšel tu hroznou zprávu, nekontrolovaně <w>vzlykal</w>."
                            }
                        },
                        {
                            "text": "The sound of <w>sobbing</w> could be heard from behind the closed door.",
                            "target_lang_translations": {
                                "cs": "Za zavřenými dveřmi bylo slyšet <w>vzlykání</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start sobbing",
                        "keep sobbing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb sob."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí nebo gerundium slovesa vzlykat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzlykající",
                                "target_lang_sense_clarification": "příčestí přítomné"
                            },
                            {
                                "target_lang_word": "vzlykání",
                                "target_lang_sense_clarification": "gerundium (děj)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}