{
    "word_family": [
        "aalmoezenier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4820b0f-d82f-3c0b-a324-05363edc0561",
                    "sense_definition": "Een gift in de vorm van geld of goederen aan een behoeftige of bedelaar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liefdadigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man vroeg op straat om een <w>aalmoes</w> om wat eten te kunnen kopen.",
                            "target_lang_translations": {
                                "en": "The old man asked for <w>alms</w> on the street to be able to buy some food."
                            }
                        },
                        {
                            "text": "Zij weigerde een <w>aalmoes</w> te vragen en zocht liever naar een eerlijke baan.",
                            "target_lang_translations": {
                                "en": "She refused to ask for a <w>handout</w> and preferred to look for an honest job."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefdegift",
                        "alm"
                    ],
                    "common_phrases": [
                        "een aalmoes geven",
                        "om een aalmoes vragen"
                    ],
                    "target_lang_definitions": {
                        "en": "A gift of money or goods given to a needy person or beggar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alms",
                                "target_lang_sense_clarification": "charitable donation of money or food to the poor"
                            },
                            {
                                "target_lang_word": "charity",
                                "target_lang_sense_clarification": "help or money given to those in need"
                            },
                            {
                                "target_lang_word": "handout",
                                "target_lang_sense_clarification": "something given free to a needy person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "597bbbee-4bae-3fcc-900f-75de57ca92b9",
                    "sense_definition": "Een zeer kleine, ontoereikende vergoeding of gift die als beledigend wordt ervaren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geringe-vergoeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor zo'n <w>aalmoes</w> ga ik niet het hele weekend werken.",
                            "target_lang_translations": {
                                "en": "I am not going to work the entire weekend for such a <w>pittance</w>."
                            }
                        },
                        {
                            "text": "De werknemers vonden de loonsverhoging van één procent een schandelijke <w>aalmoes</w>.",
                            "target_lang_translations": {
                                "en": "The employees considered the one percent wage increase to be a shameful <w>pittance</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fooi",
                        "hongerloon",
                        "pittance"
                    ],
                    "common_phrases": [
                        "werken voor een aalmoes",
                        "een schandelijke aalmoes"
                    ],
                    "target_lang_definitions": {
                        "en": "A very small, inadequate payment or gift that is perceived as insulting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pittance",
                                "target_lang_sense_clarification": "a very small or inadequate amount of money"
                            },
                            {
                                "target_lang_word": "peanuts",
                                "target_lang_sense_clarification": "a trivial or insignificantly small sum of money"
                            },
                            {
                                "target_lang_word": "pittance of a wage",
                                "target_lang_sense_clarification": "an insultingly low salary"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}