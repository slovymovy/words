        "fr-extract.jsonl": [
            {
                "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                "word": "fricot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "44787368-ce6c-4d6b-8dc7-9d1aa0cb2294",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "tags": [
                            "plural"
                        ],
                        "form": "fricots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bb021d9-6afc-3995-bb1f-09afbddeb7de",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "glosses": [
                            "Ragoût, viande fricassée."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "45365818-5f57-472b-9a28-7a62ab427342",
                                "sense_id": "7bb021d9-6afc-3995-bb1f-09afbddeb7de",
                                "text": "Tout à coup elle s’arrêta dans l’escalier : une suave odeur de fricot venait de saisir son odorat."
                            },
                            {
                                "example_id": "727bc1ca-d080-436d-9612-07ee5f9ee06b",
                                "sense_id": "7bb021d9-6afc-3995-bb1f-09afbddeb7de",
                                "text": "Ils apportaient leur pain pour recevoir le fricot dessus"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6167922-ec5f-3eb0-a2c6-00fb79462047",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "glosses": [
                            "Toute sorte de cuisine préparée rapidement et avec peu de moyens, frichti."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3d59d5e4-8766-4781-ac4a-9658a2804e4e",
                                "sense_id": "e6167922-ec5f-3eb0-a2c6-00fb79462047",
                                "text": "Dans une immense marmite, placée sur un feu très ardent, vous voyez bouillir constamment le fricot (c’est le mot technique), composé de je ne sais quelle viande, qui nage dans je ne sais quelle sauce."
                            },
                            {
                                "example_id": "b5779998-5683-487b-8da4-6ef956b8cbf9",
                                "sense_id": "e6167922-ec5f-3eb0-a2c6-00fb79462047",
                                "text": "Qu’est-ce que ce fricot-là ? toujours du gargolier ! Du rata en bouillie ! ça te rendrait malade de me faire de temps en temps un peu de rôti, un peu de soupe grasse."
                            },
                            {
                                "example_id": "2514f3e8-6dc8-40a6-a3e1-4c3061173bc9",
                                "sense_id": "e6167922-ec5f-3eb0-a2c6-00fb79462047",
                                "text": "Mais dans notre langage à nous, ça s’appelle un petit creux, une petite faim. Ça vient doucement ou subitement quand le fricot de midi et la gamelle du soir sont encore loin. Alors, on va taper dans les réserves de la cambuse ou l’on fait un arrêt boulange, charcutaille, voire épicier."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dfc9253-9cba-324c-9219-f46a5c1b8751",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "glosses": [
                            "Festin."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b7dbd39f-b11b-435d-a9b1-7510a4907b79",
                                "sense_id": "5dfc9253-9cba-324c-9219-f46a5c1b8751",
                                "text": "Car ils sont, paraît-il, les fervents amateurs des « fricots » les plus savoureux : une noce, chez ces farauds, dure huit jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e94f39-720e-3d3e-8c48-887fd0c44d2f",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "glosses": [
                            "Bon repas, bonne chère, régal."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d3b7a6f0-5a96-331b-bf76-9ca7b1c97eae",
                        "entry_id": "5aad8327-7d67-34b2-b28c-0179ac0b600e",
                        "glosses": [
                            "Repas convivial, typiquement acadien."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f962d136-f464-4998-993f-f78a3b590547",
                                "sense_id": "d3b7a6f0-5a96-331b-bf76-9ca7b1c97eae",
                                "text": "Les Bertin ont donné un grand fricot hier soir."
                            }
                        ]
                    }
                ],
