            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecf40bd7-c2bf-3299-85d3-7f1f2ce7092c",
                    "sense_definition": "zabijać zwierzęta hodowlane przy użyciu ostrego narzędzia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zabijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz musiał <w>zarzynać</w> świnię przed świętami.",
                            "target_lang_translations": {
                                "ru": "Хозяину пришлось <w>забивать</w> свинью перед праздниками."
                            }
                        },
                        {
                            "text": "W dawnych czasach ludzie często sami musieli <w>zarzynać</w> drób na obiad.",
                            "target_lang_translations": {
                                "ru": "В старые времена людям часто приходилось самим <w>резать</w> птицу на обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "szlachtować",
                        "ubijać"
                    ],
                    "common_phrases": [
                        "zarzynać zwierzę"
                    ],
                    "target_lang_definitions": {
