                        "tags": [],
                        "examples": [
                            {
                                "example_id": "035b62b4-69c8-44d5-83e8-7e66ffa2a220",
                                "sense_id": "ec013cda-401b-3d8e-8653-2c4a48e493a3",
                                "text": "„Im letzten Moment tat sich zwanzig Sekunden lang eine Wolkenlücke auf.“"
                            },
                            {
                                "example_id": "846c4ce7-cd22-4243-ba6e-2ee9ce8ee744",
                                "sense_id": "ec013cda-401b-3d8e-8653-2c4a48e493a3",
                                "text": "„Als sie vor das Landgericht tritt, hat die Sonne sich in eine Wolkenlücke geschoben und lässt den nassen Asphalt silbrig glänzen.“"
                            },
                            {
                                "example_id": "9c8aae99-4484-4e64-a0b9-90f73f7508df",
                                "sense_id": "ec013cda-401b-3d8e-8653-2c4a48e493a3",
                                "text": "„Bei Sichtweiten von nur wenigen Metern begann […] ein aufwendiger Einsatz von Bodenkräften, zudem kreiste ein Hubschrauber konstant über dem Berg, um die beiden bei einer Wolkenlücke sofort mit einer Winde an Bord holen zu können.“"
                            }
                        ],
