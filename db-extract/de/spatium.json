                "senses": [
                    {
                        "sense_id": "a0ad4d00-b52e-3684-82d6-6b1a00667d32",
                        "entry_id": "0123965c-fade-3150-987c-50147f330e85",
                        "glosses": [
                            "Leerstelle, Leerraum zwischen zwei Schriftzeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9837194-299b-4b48-ab27-a25d610d6277",
                                "sense_id": "a0ad4d00-b52e-3684-82d6-6b1a00667d32",
                                "text": "Man kann ein Wort definieren als eine Kette von Buchstaben zwischen zwei Spatien."
                            },
                            {
                                "example_id": "a49c244a-4f69-4667-a9b8-b8a55c1b3fd8",
                                "sense_id": "a0ad4d00-b52e-3684-82d6-6b1a00667d32",
                                "text": "Wortdefinition nach dem orthographischen Kriterium: „Als Wort gilt eine Buchstabensequenz, die zwischen zwei Leerzeichen (Spatien) auftritt und selbst kein Leerzeichen enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d1f5ea96-effe-3e78-8094-0254d5b07ee9",
                        "entry_id": "0123965c-fade-3150-987c-50147f330e85",
                        "glosses": [
                            "Metallteil, das niedriger war als die Lettern eines Zeichensatzes und gesetzt werden konnte, um eine unbedruckte leere Stelle im Text zu gewinnen"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "6a755743-66b7-4a34-83c6-b596a93f3f29",
                                "sense_id": "d1f5ea96-effe-3e78-8094-0254d5b07ee9",
                                "text": "Hier wurde ein Spatium von einem halben Buchstaben gewählt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
