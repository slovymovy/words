                                        "entry_id": "12e35199-4f09-3b0a-8062-66a996ffe16f",
                                        "glosses": [
                                            "A place where public transport buses stop to allow passengers to board or leave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66fbd5c1-9066-478d-be89-55dfb86d9a1c",
                                                "sense_id": "dcf9cad0-07ba-304b-91fb-570880067fae",
                                                "text": "He was waiting at the bus stop with her."
                                            },
                                            {
                                                "example_id": "bd0daed7-af37-40d8-beb2-bdcd6112a592",
                                                "sense_id": "dcf9cad0-07ba-304b-91fb-570880067fae",
                                                "text": "\"The streets are packed now,\" said a man named Pinky, as we sat talking on a busstop bench."
                                            },
                                            {
                                                "example_id": "ff623ead-dd8a-4915-9ab5-8161044d2b1f",
                                                "sense_id": "dcf9cad0-07ba-304b-91fb-570880067fae",
                                                "text": "2011, Rebecca Black featuring Patrice Wilson, Friday\nGotta get down to the bus stop\nGotta catch my bus, I see my friends"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4612281-3048-3f01-aa49-f5428a4a1d00",
                                        "entry_id": "12e35199-4f09-3b0a-8062-66a996ffe16f",
                                        "glosses": [
