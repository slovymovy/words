                "senses": [
                    {
                        "sense_id": "57855c03-7a44-3679-8975-4eeefb61a560",
                        "entry_id": "3524508d-4b53-3800-934d-415b71084ce5",
                        "glosses": [
                            "Metabolit, der den Fettsäureabbau im Innern der Mitochondrien einleitet und so eine Schlüsselstellung im Energiestoffwechsel bei Tier und Mensch einnimmt"
                        ],
                        "tags": [
                            "Tierphysiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d0690358-112a-4d3b-b566-05df09d74431",
                                "sense_id": "57855c03-7a44-3679-8975-4eeefb61a560",
                                "text": "„Außerdem enthält Fleisch - vor allem vom Schaf - den Biostoff Carnitin, den der Muskel braucht, wenn seine zuckerhaltigen Energiespeicher nach zirka einer Stunde Laufen leergepumpt sind und der Organismus auf die etwas trägere Verbrennung von Fett aus seinen Fettdepots umsteigen muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
