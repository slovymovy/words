                "senses": [
                    {
                        "sense_id": "967d8861-5a3a-34b2-a1a7-8c4d44411f87",
                        "entry_id": "f95adb2b-5fd8-3de3-9d35-043c7f16306e",
                        "glosses": [
                            "kleine Wolke, die durch das Atmen in kalter Umgebung von einer Person ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d60c47c-33e2-4252-a9ea-49afdda71b07",
                                "sense_id": "967d8861-5a3a-34b2-a1a7-8c4d44411f87",
                                "text": "„Um ein Uhr nachts, mitten im Ghetto, ein halbes Dutzend Streifenpolizisten, deren Atemwölkchen mal wieder über eine Leiche ziehen – gibt es einen besseren Ort, eine bessere Zeit für einen echten Landsman, so trocken vorgebracht, dass selbst der Schichtleiter vom Western District im grellen Flackern seines Blaulichts hart auflacht?“"
                            },
                            {
                                "example_id": "8c6b10e9-ab53-4935-ac0e-b3084b509303",
                                "sense_id": "967d8861-5a3a-34b2-a1a7-8c4d44411f87",
                                "text": "„Im Stall roch es nach Lehm, Stroh und Mist; im trübgelben Lampenlicht waberten die Atemwölkchen durch die Kälte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
