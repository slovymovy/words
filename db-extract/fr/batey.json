                        "glosses": [
                            "Campement de coupeurs de canne à sucre."
                        ],
                        "tags": [
                            "Haïti"
                        ],
                        "examples": [
                            {
                                "example_id": "946434f0-1de4-4134-b528-de07458b61a0",
                                "sense_id": "35f3d8d1-35d8-340c-a929-fab4dc60c0e1",
                                "text": "Pour se donner de la contenance, il alluma une cigarette et aspira profondément l’âcre fumée qui lui rappelait Cuba, l’immensité, étendue d’un horizon à l’autre, des champs de canne, le batey de la Centrale sucrière, la baraque empuantie où le soir venu il couchait pêle-mêle, après une journée épuisante, avec ses camarades d’infortune."
                            },
                            {
                                "example_id": "b59ff357-2ff3-4457-951b-fce5829b3cdf",
                                "sense_id": "35f3d8d1-35d8-340c-a929-fab4dc60c0e1",
                                "text": "Francia Simon, qui vit en République dominicaine dans un batey, un village construit sur une plantation autour d’une raffinerie de sucre, où vivent des Haïtiens venus travailler dans des champs de canne à sucre."
                            }
                        ]
                    }
