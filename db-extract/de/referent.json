                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                        "glosses": [
                            "Person, die etwas referiert, ein Referat hält"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf782f8-34be-4a24-aefb-2f144b8891d5",
                                "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                                "text": "Der Referent hielt einen sehr langweiligen Vortrag."
                            },
                            {
                                "example_id": "a756e2e2-d19b-42ac-8dd6-ba821bcf05f4",
                                "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                                "text": "„Dass dies jedoch nicht immer der Fall ist, illustrierte der Referent anhand einiger Beispiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a806e676-39a3-3ec3-9cfd-16dcf2e266d1",
                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                        "glosses": [
                            "Person, die in einer Organisation für einen Sachbereich zuständig ist"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce72c3d-9d0e-4ab9-a85e-9cf6fcf4d560",
                                "sense_id": "a806e676-39a3-3ec3-9cfd-16dcf2e266d1",
                                "text": "Der neue Referent muss sich erst noch richtig einarbeiten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                        "glosses": [
                            "der Gegenstand, auf den ein sprachlicher Ausdruck sich bezieht, auf den eine Referenz (Bezugnahme) gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e6d642-e07b-4492-a815-57af5c13ba6c",
                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                "text": "Der Referent eines Ausdrucks wie \"Hans\" ist eine Person."
                            },
                            {
                                "example_id": "6a93ecef-1234-425d-96af-7e05b696bd72",
                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                "text": "„Zwischen Symbol und Referent besteht kein unmittelbarer Zusammenhang.“"
                            },
                            {
                                "example_id": "343ca2fa-6137-4fcd-a07b-06a890639044",
                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                "text": "„Dann redet man auch, mehr oder weniger gleichbedeutend mit Referent, vom Designat oder Designatum (…).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd3c1325-002a-45a3-9c9d-c17a41cd6cac",
                        "source_entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                        "source_sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                        "source_sense_description": "allgemein: Person, die etwas referiert, ein Referat hält",
                        "target_lang_word": "speaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who speaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2d9f0e-d9ec-47fc-aea7-5db654326f8d",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "There were three different speakers, but I couldn't make out their accents."
                                            },
                                            {
                                                "example_id": "f5692ef3-a75f-4548-9ded-49575cfb9fb0",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "This title is derived from the first verse of the book (1.1), which is a heading or colophon informing the reader who this Qoheleth was: he was the author of the book, or at least the speaker of the words which are contained in it ..."
                                            },
                                            {
                                                "example_id": "9fe402ea-2cfa-4ddc-8ff7-32b4cd38a3f3",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "As [David] Bellos points out, those born as English speakers are now a minority of English speakers: most speak it as a second language. English is the world’s biggest interlanguage."
                                            },
                                            {
                                                "example_id": "4534b1aa-9fcf-4665-8369-11d481d0d803",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Loudspeaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc469b6-5c94-4693-a1fe-dda3a6fb6c99",
                                                "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                                "text": "She lost her hearing after standing too close to the speaker at the festival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Speakerphone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2d89a3-200f-4523-9ee5-c3c6a625c00f",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "you're on speaker"
                                            },
                                            {
                                                "example_id": "b806f216-ade0-4d79-9cd9-eda68c7ba621",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "I'm gonna put you on speaker now"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43531dd1-0ac0-3955-a88f-628d5913f00b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The chair or presiding officer of certain legislative bodies, such as the U.K. House of Commons or the U.S. House of Representatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who makes a speech to an audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c06ae97-eb80-4cf9-ad73-b681533dd53c",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "Near-synonyms: orator, presenter, announcer"
                                            },
                                            {
                                                "example_id": "4ba59a91-8120-433d-b72d-1b5dc2acaeef",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "hired speaker;   motivational speaker"
                                            },
                                            {
                                                "example_id": "75c53a82-6ced-44d6-9456-43404ce338be",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "The company hired a motivational speaker to boost morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adab38ed-fa7e-3de2-a246-6a7e80b73dae",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A book containing passages of text for use in speeches."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec4966f-37ed-41bc-b1c7-0a7aa513382e",
                                                "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                                "text": "The speaker spelled out the words to be communicated, letter by letter, while the reader's hand read the speaker's message. In its original form the hand alphabet assumed that both speaker and reader could already speak and spell the words ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text.",
                                            "The literary character uttering the lyrics of a poem or song, as opposed to the author writing the words of that character."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935a2544-b1bb-4b2a-bfef-6619022a514b",
                                                "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                                "text": "Popular culture often incorrectly attributes quotes from the speakers of poems or songs to the authors thereof, as when \"I took the one less traveled by\" is attributed to Robert Frost rather than to the speaker in Frost's \"The Road Not Taken\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fffa2e-c0c8-39ef-a9c6-8d9d9e61080e",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A key on a woodwind instrument of the clarinet family (compare octave key on other instruments) which induces the instrument to overblow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A wooden pole or spike used by hedgers to carry loads on their shoulders. Possibly Dorset dialect."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b220d34-8813-4c24-85d3-abe1e5afc029",
                                                "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                                "text": "With a speäker, or stake, he tossed the outlying scraps of fuel on the into the conflagration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8668526-d4b9-4403-8b8a-6c77af6cee39",
                        "source_entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                        "source_sense_id": "a806e676-39a3-3ec3-9cfd-16dcf2e266d1",
                        "source_sense_description": "allgemein: Person, die in einer Organisation für einen Sachbereich zuständig ist",
                        "target_lang_word": "referent",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "referent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "811c5cac-313a-3b1b-8f83-47ec17f92481",
                                        "entry_id": "5b7ba7dc-19da-34cf-a313-bf59ff28d216",
                                        "glosses": [
                                            "iemand die een referaat houdt, iemand die een inleiding houdt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc7c9304-022c-3ef4-ba3c-eaa00740072a",
                                        "entry_id": "5b7ba7dc-19da-34cf-a313-bf59ff28d216",
                                        "glosses": [
                                            "deskundige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca258e1-1623-4f6e-9ac1-081037875aee",
                                                "sense_id": "bc7c9304-022c-3ef4-ba3c-eaa00740072a",
                                                "text": "De basiskennis van het katholicisme versterken, en leerlingen gevoelig maken voor de christelijke beeldtaal in de Westerse cultuur. Met die ambitie schreef Johan Bonny, de bisschop van Antwerpen en referent voor het onderwijs, een brochure met vernieuwde lesinstructies voor het vak rooms-katholieke godsdienst. Elke betrokken leerkracht krijgt een exemplaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f27cf9d-39d1-3279-84aa-4673d97678f4",
                                        "entry_id": "5b7ba7dc-19da-34cf-a313-bf59ff28d216",
                                        "glosses": [
                                            "iemand waarnaar je kunt verwijzen voor meer informatie (met name als het gaat om informatie over jezelf)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ad3163-6fe6-4c42-88a9-e4536cdac611",
                                                "sense_id": "4f27cf9d-39d1-3279-84aa-4673d97678f4",
                                                "text": "Het Trimbosinstituut heeft voor het onderzoek naar de psychische gesteldheid van de aanvragers een speciale test ontwikkeld. Volgens het wetsvoorstel moet de aanvrager ook drie referenten opgeven, zijn of haar verzoek altijd persoonlijk indienen en zelf aanwezig zijn bij de controle van opslagmogelijkheden voor vuurwapens; thuis of in zijn of haar bedrijf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ed7c8d-aeae-32e1-aa4b-1674c2097ed2",
                                        "entry_id": "5b7ba7dc-19da-34cf-a313-bf59ff28d216",
                                        "glosses": [
                                            "mentaal concept of materieel voorwerp waarnaar je met taal kunt verwijzen (refereren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a66911-4623-413d-9be4-37c6b6cd70b0",
                                                "sense_id": "57ed7c8d-aeae-32e1-aa4b-1674c2097ed2",
                                                "text": "Het motorvoertuig met vier wielen voor het vervoer van een klein aantal personen is de referent voor personenauto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28251d2c-f926-3010-842e-0afdc528bff7",
                                        "entry_id": "5b7ba7dc-19da-34cf-a313-bf59ff28d216",
                                        "glosses": [
                                            "dat waarnaar een verwijswoord verwijst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f6b66f-658d-467f-9fd3-8fde6fef52f9",
                                                "sense_id": "28251d2c-f926-3010-842e-0afdc528bff7",
                                                "text": "„Het verloren gaan van het juiste verband tussen het verwijswoord en de referent.”: Ik ontmoette gisteren een meisje en dat vertelde mij... (bij de referent ‘het meisje’ hoort het verwijswoord dat)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
