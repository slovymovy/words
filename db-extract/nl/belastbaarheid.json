                        "examples": [
                            {
                                "example_id": "0eb968d6-366b-475d-bdbd-817f7485c5dc",
                                "sense_id": "cba90ff2-e4d1-3414-9a93-adecd11d1b94",
                                "text": "De toetsingsgrens is gesteld op 60% als maximale belastbaarheid. De kabels mogen veelal niet hoger worden belast, omdat omschakeling in storingssituaties voor de meeste kabels mogelijk moet blijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "186f2084-9d37-35ab-b670-b71ac6fe3b56",
                        "entry_id": "b89e3f99-f927-398e-8ec0-134f995462f1",
                        "glosses": [
                            "hoeveel inspanning die iemand kan opbrengen"
                        ],
