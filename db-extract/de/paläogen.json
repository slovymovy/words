                        "entry_id": "deae49a8-b7c1-3cbb-a053-7505b7e84ee7",
                        "glosses": [
                            "nach heutiger Definition ältester Zeitabschnitt des Känozoikums (Erdneuzeit), der etwa vor 66 Millionen Jahren begann und vor 23 Millionen Jahren endete (zwischen der Kreide und dem Neogen); umfasst das Oligozän, das Eozän und das Paläozän;\\n der ältere Zeitabschnitt des Tertiärs"
                        ],
                        "tags": [
                            "früher",
                            "nicht mehr offiziell (aber in der Praxis durchaus noch gebräuchlich)"
                        ],
                        "examples": [
                            {
                                "example_id": "4d05e7ac-fadf-4732-8b7f-4a0c6e622c9f",
                                "sense_id": "6f650210-c6d1-325b-81fc-e2de66d91db1",
                                "text": "„Gegen Ende des Paläogens waren die Rüsseltiere die größten Landsäugetiere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
