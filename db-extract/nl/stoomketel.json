                    },
                    {
                        "translation_id": "2699f376-ed16-40b5-ad6c-1c4a01beb39c",
                        "source_entry_id": "0089849b-39c2-3850-8d6a-03dd2616a184",
                        "source_sense_id": "de73d963-3177-320f-b453-5f96fb1f7356",
                        "target_lang_word": "chaudière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaudière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9332874d-7cc3-3dda-b79a-c55355833e88",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Chaudron."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba846bad-3861-4f60-867a-0035d15122c2",
                                                "sense_id": "9332874d-7cc3-3dda-b79a-c55355833e88",
                                                "text": "Une quarantaine de trappeurs et de guerriers comanches étaient disséminés çà et là, […], quelques-uns accroupis devant deux ou trois feux sur lesquels étaient suspendues des chaudières, où rôtissaient d’énormes quartiers de venaison, préparaient le repas de leurs compagnons."
                                            },
                                            {
                                                "example_id": "bfc1969b-ab38-4930-aee2-9cb10ecc6b95",
                                                "sense_id": "9332874d-7cc3-3dda-b79a-c55355833e88",
                                                "text": "[…] : au sortir des presses, le jus est immédiatement amené dans des chaudières à double fond, où l’on fait circuler un courant de vapeur qui le porte à la température de 75 à 80° ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40b7f6c-0343-3e89-92b7-11b0c0b9f918",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Récipient clos, de cuivre, de tôle ou de fonte dans lequel l’eau se transforme en vapeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545e6f19-c78c-4303-9515-deec7edb67d9",
                                                "sense_id": "c40b7f6c-0343-3e89-92b7-11b0c0b9f918",
                                                "text": "La vapeur, tant pour le service de la machine et d’une pompe spéciale que pour le chauffage des bassines, est produite par deux chaudières dont une de rechange."
                                            },
                                            {
                                                "example_id": "3b6195e0-0b2e-401c-b1b2-1352f1d25a42",
                                                "sense_id": "c40b7f6c-0343-3e89-92b7-11b0c0b9f918",
                                                "text": "Quatre heures après nous stoppions dans une clairière, décidés à renouveler la provision d’eau de la chaudière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0ae5cb-2231-3226-92da-1d93f5917af6",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Appareil qui produit de l'eau chaude ou de la vapeur dont la circulation permet notamment de faire fonctionner le chauffage central."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902dcd8a-e3fe-4635-8375-fd2107571a10",
                                                "sense_id": "fc0ae5cb-2231-3226-92da-1d93f5917af6",
                                                "text": "Par régulation thermostatique, la chaudière se déclenche seulement si la chaleur solaire est insuffisante; néanmoins l’eau caloporteuse est préchauffée et réduit l’augmentation de température nécessaire."
                                            },
                                            {
                                                "example_id": "7774ceca-4201-4036-954d-c26bb0e0cb59",
                                                "sense_id": "fc0ae5cb-2231-3226-92da-1d93f5917af6",
                                                "text": "Les propriétaires de poêles, inserts ou chaudières à bois, particulièrement, multiplient les achats précoces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8194a080-3f49-3124-b439-482363fdac8d",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Caudrette."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8eade793-911d-3cd1-a423-c348d29cd0f9",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Meuble représentant un chaudron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5231af8-59a3-34f5-a437-a446aaf3bbc8",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Coureur dopé."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02f629b7-27af-45c0-b908-7e0b4b5a917d",
                                                "sense_id": "a5231af8-59a3-34f5-a437-a446aaf3bbc8",
                                                "text": "Pierrick Guillereau, excellent amateur autour de 1995, s’insurge contre sa réputation de « chaudière ». … « Je courais cent courses par an, c’est impossible sous pot belge qui vous cloue plutôt dans le canapé. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abc3a7d-b45a-3258-bdf9-c21b12e55eab",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Seau."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e7c1289-ab48-429e-bd42-047faa885d55",
                                                "sense_id": "0abc3a7d-b45a-3258-bdf9-c21b12e55eab",
                                                "text": "Est-ce que ta chaudière est pleine ?"
                                            },
                                            {
                                                "example_id": "ce379406-fbd2-47be-a0b9-0d8b7da1a7df",
                                                "sense_id": "0abc3a7d-b45a-3258-bdf9-c21b12e55eab",
                                                "text": "La distribution de viande en chaudière par une entreprise de la Mauricie sur le territoire de Baie-Comeau dérange au point où la Ville entend modifier sa réglementation pour mettre fin à ce commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc20e94-0571-3634-bf05-708b8d380477",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Chaudasse, femme qui paraît très portée sur le sexe."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a181bef-5dca-4ad9-9b61-da5e3063fdc0",
                                                "sense_id": "8dc20e94-0571-3634-bf05-708b8d380477",
                                                "text": "C’est une chaudière celle-là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c05f5a2-3e52-37d7-9292-8561da1dbe56",
                                        "entry_id": "c232e5cb-2960-35c2-ba2c-1126bf979d63",
                                        "glosses": [
                                            "Marmite."
                                        ],
                                        "tags": [
                                            "Haïti"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
