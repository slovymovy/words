                "senses": [
                    {
                        "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                        "entry_id": "3584055b-f618-33dc-83d8-11ff7ca6038c",
                        "glosses": [
                            "am Vorstag aufrollbares Segel auf einem Segelboot mit einem Mechanismus, der dies leicht ermöglicht"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "64c4771c-32da-45fc-8f5c-133db87ef8c8",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "Wenn die Rollfock klemmt, hat man ein Problem, das man zügig lösen sollte."
                            },
                            {
                                "example_id": "36922459-9f9a-4c10-bd9d-8a5d7fd26d35",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "„Der Wirbel ist mit einem Axial-Nadellager ausgestattet und soll selbst unter Spitzenlast eine leichtgängige Rollfock garantieren.“"
                            },
                            {
                                "example_id": "a45e3012-b936-4eb7-8650-c19f2a449ad6",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "[Die einfachste Variante des Katamarans] „hat ein Dacron-Großsegel von 13,5 Quadratmeter und eine 4,2 Quadratmeter messende Rollfock.“"
                            },
                            {
                                "example_id": "c78d28c8-e44d-45cf-ba98-d737d519ebbb",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "„Kommen noch Rollfock und Rollgroß sowie eine umfangreiche elektronische Navigationsausrüstung hinzu, kann man bis zu 250 000 Mark für diese 28-Fuß-Yacht ausgeben.“"
                            },
                            {
                                "example_id": "5d724554-3476-4790-aeba-df467edc1bef",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "„Mit einer Rollfock kann das Vorsegel über eine Rolleinrichtung meist vom Steuerstand aus ganz oder teilweise durch Zug an einer Leine eingerollt werden.“"
                            },
                            {
                                "example_id": "ea6baa2b-7df3-4d8e-af89-7cfc06f9dcf2",
                                "sense_id": "69acbdf2-1008-334b-9ce7-24081d30acb6",
                                "text": "„Das 7/8-Rigg bietet gute Trimmöglichkeiten und kommt doch dank der Rollfock mit erheblich weniger Segeln aus als eine Regattayacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
