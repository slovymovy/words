        "pl-extract.jsonl": [
            {
                "entry_id": "ffbd871a-ba8c-38ce-b027-87c3441b6f39",
                "word": "opieszały",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c07fe18-dd02-36eb-9b67-c44c85703a5b",
                        "entry_id": "ffbd871a-ba8c-38ce-b027-87c3441b6f39",
                        "glosses": [
                            "powolny w wykonywaniu pewnych czynności"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4d56acc-3137-4546-9480-2d9c4117c0c1",
                        "source_entry_id": "ffbd871a-ba8c-38ce-b027-87c3441b6f39",
                        "source_sense_id": "6c07fe18-dd02-36eb-9b67-c44c85703a5b",
                        "target_lang_word": "tardy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tardy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                        "entry_id": "476cfe10-bec3-3f6b-a83d-883df5e47c38",
                                        "glosses": [
                                            "Late; overdue or delayed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de9a059-9200-4c75-99c9-edf9538e485f",
                                                "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                                "text": "He yawned, then raised a tardy hand over his mouth."
                                            },
                                            {
                                                "example_id": "d7fc1da7-4403-41a2-b7f7-363a3e8798c6",
                                                "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                                "text": "When everything is ended, then you come. / These tardy tricks of yours will, on my life, / One time or other break some gallows’ back."
                                            },
                                            {
                                                "example_id": "3b98a0e9-2ddb-48d5-ae98-d18295a5dde9",
                                                "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                                "text": "Men of genius anticipate their contemporaries, and know they are such, long before the tardy consent of the public."
                                            },
                                            {
                                                "example_id": "7afa4e24-7068-4eae-8717-6d7c7f07faab",
                                                "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                                "text": "As a matter of fact, the luncheon fare, when it made its tardy appearance, was distinctly unworthy of the reputation which the justly-treasured cook had built up for herself."
                                            },
                                            {
                                                "example_id": "1096ed00-c7ce-4c59-8ca7-9592295cfac7",
                                                "sense_id": "acf6d87d-665d-384d-836b-e1e22ddb739b",
                                                "text": "And the Black Muslims, along with many people who are not Muslims, no longer wish for a recognition so grudging and (should it ever be achieved) so tardy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                        "entry_id": "476cfe10-bec3-3f6b-a83d-883df5e47c38",
                                        "glosses": [
                                            "Moving with a slow pace or motion; not swift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42db9991-7020-4478-9621-188dd903e271",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "[…] fashions in proud Italy, / Whose manners still our tardy apish nation / Limps after in base imitation."
                                            },
                                            {
                                                "example_id": "9e2138d8-8285-49a0-87c5-7d47702d82dd",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "Nor should their Age by Yeares be told: / Whose Souls, more swift then Motion, clime; / And check the tardy Flight of Time."
                                            },
                                            {
                                                "example_id": "f3fadc19-bef0-4e6c-ac63-44d3b1e88971",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "In various Views she tries her constant Theme; / Finds him, in Councils, and in Arms, the same: / When certain to o’ercome, inclin’d to save; / Tardy to Vengeance; and with Mercy brave."
                                            },
                                            {
                                                "example_id": "e5daca70-2da3-4ee9-b1c2-2579abc35f47",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "[…] a disease which medicine never cured, wealth never warded off, or poverty could boast exemption from; which sometimes moves in giant strides, and sometimes at a tardy sluggish pace, but, slow or quick, is ever sure and certain."
                                            },
                                            {
                                                "example_id": "8ac2c0e6-c0d1-481a-84aa-8cfa7a750224",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "These berries […] are a deadly and insidious poison, though very tardy in their action, often lying dormant in the blood for many days."
                                            },
                                            {
                                                "example_id": "60692a28-b25b-4df1-aab5-451a80980446",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "After the introduction of the Highland Railway class, the progress of the 4-6-0 was tardy for some years.Then, when designers were increasingly turning to it as the answer to their growing motive power problems, production of 4-6-0s swelled into a flood tide."
                                            },
                                            {
                                                "example_id": "ed6b6760-a313-4cbd-a4b9-1da88b166077",
                                                "sense_id": "b091cf4d-d63e-322c-8011-2bcc3cfe4ea5",
                                                "text": "And the youngest of the family\nIs moving with authority\nBuilding castles by the sea\nHe dares the tardy tide\nTo wash them all aside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55f94288-ec8f-3118-9990-3bf8b35b1be6",
                                        "entry_id": "476cfe10-bec3-3f6b-a83d-883df5e47c38",
                                        "glosses": [
                                            "Ineffectual; slow-witted, slow to act, or dull."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55cf465-2012-44e2-aba5-92131fc1de33",
                                                "sense_id": "55f94288-ec8f-3118-9990-3bf8b35b1be6",
                                                "text": "His tardy performance bordered on incompetence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0edc24-bac3-3d1d-aa6c-d218836aa94f",
                                        "entry_id": "476cfe10-bec3-3f6b-a83d-883df5e47c38",
                                        "glosses": [
                                            "Unwary; unready (especially in the phrase take (someone) tardy)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c1dc32-29fe-4591-88c6-a873724117cf",
                                                "sense_id": "4a0edc24-bac3-3d1d-aa6c-d218836aa94f",
                                                "text": "Be not ta’en tardy by unwise delay."
                                            },
                                            {
                                                "example_id": "ac692109-a61c-4206-ba10-ac75bbaf3638",
                                                "sense_id": "4a0edc24-bac3-3d1d-aa6c-d218836aa94f",
                                                "text": "Yield, Scoundrel base (quoth she) or die; / Thy life is mine, and liberty. / But if thou think’st I took thee tardy, / And dar’st presume to be so hardy, / To try thy fortune o’re afresh, / I’le wave my title to thy flesh,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5554f8-86c6-3a5a-9acd-749056324e42",
                                        "entry_id": "476cfe10-bec3-3f6b-a83d-883df5e47c38",
                                        "glosses": [
                                            "Criminal; guilty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53f9b69-69ef-467d-9885-22fa477dc45d",
                                                "sense_id": "6f5554f8-86c6-3a5a-9acd-749056324e42",
                                                "text": "And the Franks served the Men much the same ſauce when they found them tardy, and made them run their Heats through the Streets"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tardy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "304ec6ce-cb24-3d0a-9753-62b13b38d5bd",
                                        "entry_id": "d4bb76e4-6515-3290-8d04-7b7600e01fbe",
                                        "glosses": [
                                            "A piece of paper given to students who are late to class."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9db5e0-9836-44dc-9959-41b3b950df2a",
                                                "sense_id": "304ec6ce-cb24-3d0a-9753-62b13b38d5bd",
                                                "text": "The teacher gave her a tardy because she did not come into the classroom until after the bell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a44e23a-bf5c-3591-99ef-71b40f7132bb",
                                        "entry_id": "d4bb76e4-6515-3290-8d04-7b7600e01fbe",
                                        "glosses": [
                                            "An instance of a student's being marked as tardy by a teacher on the teacher's attendance sheet."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tardy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e57e6f35-c4a6-3e42-a7c1-95b925fd745f",
                                        "entry_id": "acf309de-dbaf-3fbc-8604-b3dc688408ff",
                                        "glosses": [
                                            "To make tardy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5d6dd5-34c8-4275-9112-edf58f1d2052",
                                                "sense_id": "e57e6f35-c4a6-3e42-a7c1-95b925fd745f",
                                                "text": "the good mind of Camillo tardied\nMy swift command"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5fa044-f87a-3714-9e44-40b3b3d9ba5c",
                                        "entry_id": "acf309de-dbaf-3fbc-8604-b3dc688408ff",
                                        "glosses": [
                                            "To dawdle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7613cb39-ae9f-466c-8e41-f217fdd6a1a7",
                                                "sense_id": "6b5fa044-f87a-3714-9e44-40b3b3d9ba5c",
                                                "text": "Sitting there on the rock behind the school, I heard nothing but the occasional raised voice of some youngster tardying on his way home, and the joints in the schoolhouse squeaking from the frost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
