                ],
                "senses": [
                    {
                        "sense_id": "63926b47-9a7e-3d8e-8ffe-760e64f1b226",
                        "entry_id": "6132d875-abe4-3104-9df2-a10fc32bfe78",
                        "glosses": [
                            "Celui qui sollicite, qui fait des démarches pour obtenir quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b1e5e1-bfad-4955-9ee6-c64191ef7b05",
                                "sense_id": "63926b47-9a7e-3d8e-8ffe-760e64f1b226",
                                "text": "Sans parler des postulants plus « politiques », comme l’auteur des Versets sataniques, menacé de mort, Salman Rushdie, ou la dissidente russe exilée à Berlin, Ludmila Oulitskaïa."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b6b850-08dc-37de-9bf2-5c98420b6795",
                        "entry_id": "6132d875-abe4-3104-9df2-a10fc32bfe78",
                        "glosses": [
                            "Celui qui demande à faire son noviciat dans une maison religieuse."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5a87ff-2196-4028-9bc9-0cae0bef6bf7",
                                "sense_id": "89b6b850-08dc-37de-9bf2-5c98420b6795",
                                "text": "Cela étant précisé, il reste que, pendant ces vingt années, les organismes tentent de freiner l'entrée des ménages les plus démunis en instituant, d'une part un plancher de revenus en dessous duquel le postulant ne voit pas sa candidature pour un logement retenue, et d'autre part des obligations de créances, de garanties ou de cautions."
                            },
                            {
                                "example_id": "99f18878-f0b5-4e29-8f68-441e38abd757",
                                "sense_id": "89b6b850-08dc-37de-9bf2-5c98420b6795",
                                "text": "Il est postulant, elle est postulante depuis six mois pour entrer au noviciat de tel couvent."
                            }
                        ]
                    }
                ],
