                    {
                        "sense_id": "1f36416c-3abc-357b-9d21-581a7b757482",
                        "entry_id": "07fd04e2-5d85-36d4-8619-04bd3b11bc64",
                        "glosses": [
                            "Dont tous les mots sont des dissyllabes, ou qui n’ont que deux syllabes, en parlant de certains vers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "03e761a2-241a-3201-bbc7-15cdf13b0bcc",
                        "entry_id": "07fd04e2-5d85-36d4-8619-04bd3b11bc64",
                        "glosses": [
                            "Formé de deux syllabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac4a417-3e44-42fe-a5bb-87368f2e15af",
                                "sense_id": "03e761a2-241a-3201-bbc7-15cdf13b0bcc",
                                "text": "Vous n’entendez plus qu’un chœur de grillons qui chantent, dans leurs petites cages enjolivées de verroteries, leur complainte dissyllabique."
                            },
                            {
                                "example_id": "af18ccee-61e4-49f3-b75c-a68938afd65d",
                                "sense_id": "03e761a2-241a-3201-bbc7-15cdf13b0bcc",
                                "text": "En effet, en ancien français, le oui était dissyllabique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ec65de-6dac-49a1-b973-8a3d51b52a4f",
                        "source_entry_id": "07fd04e2-5d85-36d4-8619-04bd3b11bc64",
                        "target_lang_word": "zweisilbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweisilbig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42df2622-312d-39bb-bc09-bbea6cf97224",
                                        "entry_id": "bbd5a4ac-cff3-3318-a763-64b0a8f2109e",
                                        "glosses": [
                                            "aus genau zwei Silben bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d279365-ab00-4030-9010-58fc2ff599ab",
                                                "sense_id": "42df2622-312d-39bb-bc09-bbea6cf97224",
                                                "text": "„Außer dem Merkmal der (alten⁵) Zweisilbigkeit gibt es keine erkennbare phonologische Regel, derzufolge ein zweisilbiges Wort einen musikalischen Akzent zu bekommen hat oder nicht.“"
                                            },
                                            {
                                                "example_id": "25e194ad-ce51-4eac-affb-55cfcf5baa47",
                                                "sense_id": "42df2622-312d-39bb-bc09-bbea6cf97224",
                                                "text": "„Zu entscheiden ist also jeweils, ob die zweisilbige Grundform eine derivationell aktive Einheit enthält, die zu einer internen morphologischen Grenze führt.“"
                                            },
                                            {
                                                "example_id": "5f80bb69-d810-4161-be75-81c7f3f32f86",
                                                "sense_id": "42df2622-312d-39bb-bc09-bbea6cf97224",
                                                "text": "„Ins Deutsche übersetzt würde dasselbe Fragepronomen aus einem zweisilbigen Wort bestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
