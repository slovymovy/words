                "senses": [
                    {
                        "sense_id": "d4d6c532-c858-39bd-adfb-94ddbe04a28f",
                        "entry_id": "75f75edf-7af1-303d-be5f-51cc7a902a53",
                        "glosses": [
                            "Dessert le plus souvent à base de farine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d25c3c-cbfe-44ab-b78e-c86f528fe8a5",
                                "sense_id": "d4d6c532-c858-39bd-adfb-94ddbe04a28f",
                                "text": "W kuchni polskiej do legumin zalicza się następujące, przyrządzone na słodko potrawy: budynie, suflety, omlety, naleśniki, racuchy, pierogi (z twarogiem i owocami), makaron pszenny lub kluski (np. makaron z twarogiem, knedle z owocami, pierogi leniwe, pampuchy), ryż (ze śmietaną i owocami, np. jabłkami, gotowany na mleku), musy, galaretki, kisiele mleczne (tzw. budynie), legumina z zupy „nic”, a nawet zupy owocowe (podane z makaronem, grzankami lub groszkiem ptysiowym)."
                            }
                        ]
                    }
                ],
