                "senses": [
                    {
                        "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                        "entry_id": "fb6acf50-feb5-3f6f-ac8c-65ed81eb58ea",
                        "glosses": [
                            "alternative Schreibweise von Maharadscha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c4a933-9e2b-4e06-8c24-1a153d49f69f",
                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                "text": "„Überhaupt, erzählt der Maharaja, sein Reich habe früher mehr Kontakt zu Europa und Afrika gehabt als zum Rest Indiens. Das lag an den schlechten Straßen.“"
                            },
                            {
                                "example_id": "1122a5e5-de86-4178-85b1-1b946a4a6d2d",
                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                "text": "„Um die wirtschaftliche Entwicklung ihrer Gebiete zu fördern, ließen die Maharajas des 19. Jhs. selbst in der Wüste Thar Eisenbahnen bauen - in Kooperation mit den Briten oder ganz auf eigene Rechnung.“"
                            },
                            {
                                "example_id": "da0b37fb-ce1d-4b01-b5a8-3d98d5fab45a",
                                "sense_id": "be575d60-f141-3118-bce9-5845e8d9c51e",
                                "text": "„Er zog sich freilich gleich darauf wieder zurück, etablierte aber seine Macht im Gebiet südlich von Delhi, wo seine Heerführer Scindia, Gaekwad und Holkar später zu Maharajas von Gwalior, Baroda und Indore wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
