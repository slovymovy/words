                {
                    "sense_id": "211e4d1e-1c17-3a78-84ae-f12e9166ff73",
                    "sense_definition": "Ensemble des traits psychologiques, moraux et affectifs qui constituent l'individualité d'une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque être humain possède une <w>personnalité</w> unique qui se développe avec le temps."
                        },
                        {
                            "text": "Son test de <w>personnalité</w> a révélé un grand sens de l'organisation et du leadership."
                        }
                    ],
                    "synonyms": [
                        "caractère",
                        "tempérament"
                    ],
                    "common_phrases": [
                        "trait de personnalité",
                        "test de personnalité",
                        "trouble de la personnalité"
                    ]
                },
                {
                    "sense_id": "773dc2c0-49a2-360d-9470-89d0ffab60a2",
                    "sense_definition": "Personne célèbre, influente ou en vue dans la vie publique ou dans un domaine précis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs <w>personnalités</w> du monde du spectacle ont participé à cet événement caritatif."
                        },
                        {
                            "text": "Cette <w>personnalité</w> politique très influente donnera une conférence de presse demain."
                        }
                    ],
                    "synonyms": [
                        "célébrité",
                        "notabilité"
                    ],
                    "common_phrases": [
                        "personnalité politique",
                        "personnalités publiques"
                    ]
                },
                {
                    "sense_id": "0869f36d-4d17-3c01-bf0a-4a482da51bb4",
                    "sense_definition": "Caractère affirmé, originalité ou force morale qui distingue nettement quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette artiste possède une forte <w>personnalité</w> qui se reflète dans chacune de ses toiles."
                        },
                        {
                            "text": "Sa voix manque un peu de <w>personnalité</w> malgré une excellente technique vocale."
