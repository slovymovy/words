        "fr-extract.jsonl": [
            {
                "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                "word": "roulage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b05bb98a-fc12-490f-a1cb-84d714cc8fa4",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "tags": [
                            "plural"
                        ],
                        "form": "roulages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff4e516-f977-3dd3-b419-d799b3a6bd6a",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Transport des marchandises par voiture."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "adda1b92-9f26-4092-a23b-759b097844fd",
                                "sense_id": "2ff4e516-f977-3dd3-b419-d799b3a6bd6a",
                                "text": "Il ne lui restait plus rien, pas une pièce d’un franc, pas une pièce de deux sous. Il avait vidé sa monnaie dans les mains des gens à pourboire, porteurs du roulage ou facteurs des messageries, et il n’avait pas même de quoi prendre un verre de groseille."
                            },
                            {
                                "example_id": "6f0302a6-7a78-46b2-b0f5-4a3e5a1820b1",
                                "sense_id": "2ff4e516-f977-3dd3-b419-d799b3a6bd6a",
                                "text": "Par voie de terre, on évaluait à 70.000 voyageurs et 60.000 tonnes de marchandises la circulation qui profitait du roulage ordinaire, du roulage accéléré ou des diligences."
                            }
                        ]
                    },
                    {
                        "sense_id": "37ac796c-e699-3d29-850b-996a5182fedd",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Établissement où l’on se charge de ce transport."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2527aebc-ee7e-4a8b-be21-8e45787d39ce",
                                "sense_id": "37ac796c-e699-3d29-850b-996a5182fedd",
                                "text": "Tenez : faites donc faire un ballot de tout ce qui est envoyable, et me le jetez au roulage."
                            }
                        ]
                    },
                    {
                        "sense_id": "15f1ca3b-ae1f-3805-9679-61ef17487e23",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Technique de chargement ou de déchargement des navires par rampes d'accès qu'empruntent tous engins sur roues, automoteurs, tractés ou poussés."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "95dd092a-25df-3e68-bb8b-08a2d7061a59",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Fait de déplacer un avion au sol en utilisant le même mode de propulsion que dans l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bf82fd-e663-415f-9968-cfe1596e2b22",
                                "sense_id": "95dd092a-25df-3e68-bb8b-08a2d7061a59",
                                "text": "Cet aéroport a été agencé afin de minimiser les délais dus au roulage."
                            }
                        ]
                    },
                    {
                        "sense_id": "1556063a-4813-3b53-80cd-ee23909e728c",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Façon culturale destinée à tasser légèrement le sol avant ou après le semi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a4cc6dd-bb88-400b-ad38-31b59c514046",
                                "sense_id": "1556063a-4813-3b53-80cd-ee23909e728c",
                                "text": "Le plombage du sol porte en agriculture le nom de roulage; on l'opère en effet, à l'aide de rouleaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "c314dba2-6cc1-3389-be2c-19bb14ed1577",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Action de courber une tôle par déformation plastique avec une rouleuse."
                        ],
                        "tags": [
                            "Chaudronnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "e8d8dc7f-7103-4a07-8a54-7ff686c56635",
                                "sense_id": "c314dba2-6cc1-3389-be2c-19bb14ed1577",
                                "text": "Une virole se fabrique par roulage."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dceeb59-6c7c-3432-940e-61e6607209b4",
                        "entry_id": "4bf56128-b4c4-3b0f-ba0d-e3905d041b31",
                        "glosses": [
                            "Conduite de véhicule."
                        ],
                        "tags": [
                            "Belgique",
                            "Congo-Kinshasa",
                            "Burundi"
                        ],
                        "examples": [
                            {
                                "example_id": "139d6c25-469e-4d9e-b3e9-9d1c18229339",
                                "sense_id": "4dceeb59-6c7c-3432-940e-61e6607209b4",
                                "text": "Accident de roulage, taxe de roulage, police de roulage."
                            },
                            {
                                "example_id": "cdef3222-56ee-4f2d-baa4-cf453a8c44d6",
                                "sense_id": "4dceeb59-6c7c-3432-940e-61e6607209b4",
                                "text": "Cela dit, afin que personne ne soit lésé face aux conditions de roulage changeantes, l’ordre de départ sera tiré au sort pour chaque étape..."
                            }
                        ]
                    }
