                ],
                "senses": [
                    {
                        "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                        "entry_id": "cf857f0c-286d-3d4d-bf46-b4fb3c7ac85e",
                        "glosses": [
                            "Schicht von Staub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a1b9fd-4788-4567-a77e-bbde9ebff9f6",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "Eine zentimeterdicke Staubschicht hatte sich über das Mobiliar des verlassenen Hauses gelegt."
                            },
                            {
                                "example_id": "2dd1b24a-274b-455a-ba71-962313d477d2",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "„Joe strich mit dem Finger über den Esstisch und blies sich eine dicke Staubschicht von der Fingerspitze.“"
                            },
                            {
                                "example_id": "ad227c34-aaa2-4c06-96df-9513b329bf36",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "„Weil ihre in einem großen Wohnhaus eröffnete Herberge keinen Parkplatz hat, besteht sie darauf, dass unser Auto, dessen grüne Farbe unter einer dicken Staubschicht kaum noch zu erkennen ist, in der blank gewienerten Lobby parkt.“"
                            },
                            {
                                "example_id": "aeeabb03-bced-4980-b1a1-c1e14dd32441",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "„Ich widerstehe dem Impuls, einen Smiley in die Staubschicht auf dem Glastisch zu malen.“"
                            },
                            {
                                "example_id": "734608f5-df09-4957-9530-fc0fb8fce343",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "„Ihre Hände streichelten die Aschenbecher, ihre Finger zeichneten Muster in die Staubschicht auf dem Tisch.“"
                            },
                            {
                                "example_id": "967eabc0-e8da-4b9d-a23f-e829f16ef905",
                                "sense_id": "97522b46-88c3-32ca-9c31-db1aed775285",
                                "text": "„Das Hakenkreuz auf der Schulter wirkte unter einer Staubschicht wie ausgebleicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
