                                "target_senses": [
                                    {
                                        "sense_id": "5623e381-81b5-39cb-ae05-f51225492138",
                                        "entry_id": "298ef71e-7f36-39db-8cd8-17960e7bb317",
                                        "glosses": [
                                            "A place where trains stop for passengers to embark and disembark."
                                        ],
