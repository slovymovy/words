                "senses": [
                    {
                        "sense_id": "42f0593e-90c3-3abc-8965-7625e2061e67",
                        "entry_id": "d6db273e-d1ef-339e-b59d-16d8743a637d",
                        "glosses": [
                            "Rédiger un article."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3d0808ce-d667-4347-abb3-9ef4286bcc59",
                                "sense_id": "42f0593e-90c3-3abc-8965-7625e2061e67",
                                "text": "Je voudrais articler sur notre ami."
                            },
                            {
                                "example_id": "8433ab84-2cdc-4c54-a4f5-92b7abb96ca6",
                                "sense_id": "42f0593e-90c3-3abc-8965-7625e2061e67",
                                "text": "Il apparaît alors que le discours sur le monde, un monde inscrit dans l'histoire et traversé de souffrances et de conflits, ne peut chez Desbordes-Valmore advenir qu'à être pris en charge en première personne, dans l'apparente incapacité — ou le refus — d'articler un récit impersonnel ou des énoncés doxiques."
                            },
                            {
                                "example_id": "da6b1b71-69ec-49e8-b6cb-4fe0a9ae25cc",
                                "sense_id": "42f0593e-90c3-3abc-8965-7625e2061e67",
                                "text": "S'il y a quelque livre nouveau sur lequel je puisse articler, envoyez-le-moi."
                            }
                        ]
                    }
