                                "target_senses": [
                                    {
                                        "sense_id": "5b062418-f21a-30d4-addc-5c98ed93f39f",
                                        "entry_id": "83672204-ca3b-304d-91f6-5c7c737972fd",
                                        "glosses": [
                                            "immer gleich und ohne Abwechslung verlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f485a1e-c6f3-4ffd-bd4c-952707542c86",
                                                "sense_id": "5b062418-f21a-30d4-addc-5c98ed93f39f",
                                                "text": "Am meisten hasste sie das einförmige Leben in dieser spießigen Kleinstadt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c523dc7e-0da7-4e01-8268-e969395f4fee",
                        "source_entry_id": "585580c6-3ec2-394b-8acc-03105254ff49",
                        "source_sense_id": "2aad2707-02a6-310d-8764-43addc0aa307",
                        "source_sense_description": "not varied",
                        "target_lang_word": "eintönig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eintönig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47c3f12a-f347-3a53-bad4-d8133e79f5ad",
                                        "entry_id": "4db84fc5-1e88-3f11-8322-fdcc56b66cbf",
                                        "glosses": [
                                            "ohne oder arm an Abwechslung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300b1e15-f7de-4ef1-94fc-7cd33b13fbff",
                                                "sense_id": "47c3f12a-f347-3a53-bad4-d8133e79f5ad",
                                                "text": "Er führt ein sehr eintöniges Leben."
                                            },
                                            {
                                                "example_id": "4ac4e4ac-ad24-4435-9e26-5e6fa936498b",
                                                "sense_id": "47c3f12a-f347-3a53-bad4-d8133e79f5ad",
                                                "text": "Die Vortragsweise des Dozenten war extrem eintönig."
                                            },
                                            {
                                                "example_id": "164d974b-6701-4c51-b0ef-bce1c423395d",
                                                "sense_id": "47c3f12a-f347-3a53-bad4-d8133e79f5ad",
                                                "text": "„Ihre eintönige Arbeit bestand darin, stundenlang Äpfel von den Bäumen zu pflücken und in Säcke zu füllen, die auf bereitstehende Lorries gehievt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fa6a86c-9e93-4a61-bee7-4de516d59b2b",
                        "source_entry_id": "585580c6-3ec2-394b-8acc-03105254ff49",
                        "source_sense_id": "2aad2707-02a6-310d-8764-43addc0aa307",
                        "source_sense_description": "not varied",
                        "target_lang_word": "gleichförmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                        "entry_id": "1e0604e5-721c-3527-8974-752794080f73",
                                        "glosses": [
                                            "immer gleich und ohne Abwechslung verlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5f8dc6-cf1f-4666-93f0-b81c28c5b4be",
                                                "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                                "text": "„Und weiter berichtet sie in ihrem Tagebuch davon, dass alle Tage so gleichförmig abliefen, dass sie oft nicht mehr gewusst habe, welcher Wochentag gerade sei.“"
                                            },
                                            {
                                                "example_id": "701ac07a-cfc1-4110-8dfb-e04b95f36617",
                                                "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                                "text": "„Auch den Bankenanalysten wirft man vor, eine Neigung zum ‚Herding‘ zu haben, nämlich dass ihre Kauf- und Verkaufsempfehlungen viel zu gleichförmig seien.“"
                                            },
                                            {
                                                "example_id": "fbc332e1-c104-4f9b-b229-eb24f0f7ea84",
                                                "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                                "text": "„Alle Beobachtungen und empirisch überprüfbaren Theorien weisen darauf hin, daß der Kosmos seine Existenz vor etwa 14 Milliarden Jahren als ein extrem gleichförmiges Gebilde aus Energie und Raumzeit begann.“"
                                            },
                                            {
                                                "example_id": "dcfb8d7f-d3ca-455c-a04d-39815e6a3379",
                                                "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                                "text": "„Die Kurve steigt gleichförmig an, um nach etwa 100 h einen Höchstwert zu erreichen, der bei höherer Anlaßtemperatur wieder entsprechend früher auftritt. Bei noch längerem Anlaffen auf 500° fiel die Härte allmählich wieder ab.“"
                                            },
                                            {
                                                "example_id": "e14c4159-3da5-49dd-8693-b3fb36941d63",
                                                "sense_id": "35d47737-0bb4-3235-a6d9-879b4ca9176d",
                                                "text": "„Das erleichtert die Züchtung von Hybriden – einem Pflanzentyp, der oft mehr und gleichförmigere Früchte liefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ad71b75-f8b6-43bc-92f8-22128ff2c867",
                        "source_entry_id": "585580c6-3ec2-394b-8acc-03105254ff49",
                        "source_sense_id": "2aad2707-02a6-310d-8764-43addc0aa307",
                        "source_sense_description": "not varied",
                        "target_lang_word": "abwechslungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abwechslungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faf3036c-db15-3677-bab7-1424f8e4464d",
                                        "entry_id": "68da56d7-e96b-35fe-aa0d-7db776b977a2",
                                        "glosses": [
                                            "durch Eintönigkeit gekennzeichnet; von einem sich ständig wiederholenden Rhythmus bestimmt sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03035ef-4eb4-4e1b-82c4-8e0e6a168edb",
                                                "sense_id": "faf3036c-db15-3677-bab7-1424f8e4464d",
                                                "text": "Er führte ein aus seiner Sicht abwechslungsloses, langweiliges Leben."
                                            },
                                            {
                                                "example_id": "e8d86192-acc8-4984-8e4e-921b35fbf741",
                                                "sense_id": "faf3036c-db15-3677-bab7-1424f8e4464d",
                                                "text": "„Der Lauf ist eine mühselige und abwechslungslose Choreographie aus Schritten und Atmung.“"
                                            },
                                            {
                                                "example_id": "52761c2b-1b9d-4852-8fab-d4cff71ee068",
                                                "sense_id": "faf3036c-db15-3677-bab7-1424f8e4464d",
                                                "text": "„Nur der kräftige Wind und die herrliche Aussicht auf die weite Ebene Kastilien-La Manchas holen den Besucher nach einer abwechslungslosen Tour aus dem Delirium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
