{
    "word_family": [
        "constriction",
        "constrictor",
        "constrictive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dfe64af-1d2e-345c-8e63-e19eaf7a1e85",
                    "sense_definition": "To narrow or tighten something, usually by applying pressure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "narrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tight collar began to <w>constrict</w> his breathing."
                        },
                        {
                            "text": "Cold temperatures often <w>constrict</w> the blood vessels in your skin."
                        }
                    ],
                    "synonyms": [
                        "inhibit"
                    ],
                    "common_phrases": [
                        "constrict blood flow",
                        "constrict the airway"
                    ]
                },
                {
                    "sense_id": "1396d441-b181-37c1-8230-626641eb1139",
                    "sense_definition": "To limit or restrict the freedom or development of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restricting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excessive regulations can <w>constrict</w> the growth of small businesses."
                        },
                        {
                            "text": "The lack of funding served to <w>constrict</w> the scope of the research project."
                        }
                    ]
                },
                {
                    "sense_id": "483a25af-10ff-36ba-b8ac-85358a76f6c7",
                    "sense_definition": "To coil around prey tightly to cause suffocation, as a snake does.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large python began to <w>constrict</w> its prey slowly."
                        },
                        {
                            "text": "Some species of snakes <w>constrict</w> their food before swallowing it whole."
                        }
                    ]
                }
            ]
        }
    ]
}