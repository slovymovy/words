                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208da641-ca06-40ab-9f34-734fe86ddf98",
                                "sense_id": "fc4e3d78-00f9-39f3-99db-47d7163bc145",
                                "text": "„Der Verbleib der originalen Umrahmung aus Messingblech, die auf Innenaufnahmen von 1908 dokumentiert ist, war vorerst unbekannt.“"
                            },
                            {
                                "example_id": "7c999287-f79a-4e87-9f9a-72ef3145a31c",
                                "sense_id": "fc4e3d78-00f9-39f3-99db-47d7163bc145",
                                "text": "„Die Außenseite der Instrumente sollten gelegentlich auch geputzt werden. Die in der Regel aus Messingblech bestehenden Oberflächen lassen sich mit einer Metallpolitur pflegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
