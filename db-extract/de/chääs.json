                "senses": [
                    {
                        "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                        "entry_id": "fce9600e-41c2-3775-bb38-90ad833c0f6c",
                        "glosses": [
                            "Käse"
                        ],
                        "tags": [
                            "Berndeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "4b5b22c4-cc54-4bd2-bd09-92f9b7aab8bb",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "De Chääschueche isch in de Chuchi."
                            },
                            {
                                "example_id": "c22b0300-1e29-4746-9ee1-333e0093ce1c",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "„Am nächste Morge het de Hund em Raab abpasset, und tatsächlich isch de Raab wider aazflüüge choo mit eme groosse Stück Chääs im Schnabel.“"
                            },
                            {
                                "example_id": "4389dbef-758e-497c-8b65-af1b7cf02222",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "„… und das Mannli het me va schim Chääs ggä.“"
                            },
                            {
                                "example_id": "0cd5470a-9df1-4f0f-b005-3e53672ae46a",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "„Daß en gärächte Gott im Himmel ischt, weis î; und das Chääs und Brod für Hunger ischt, weis i au.“"
                            },
                            {
                                "example_id": "d143c13d-6ea4-4b2d-b218-cda112f0fe62",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "„E gueten alte Chääs im Schwytzerpuur is Gfrääs; …“"
                            },
                            {
                                "example_id": "14212a94-8398-4452-8471-caeb2f7aea7a",
                                "sense_id": "576b05b8-2bf6-3776-b3e5-c29a8c92ac68",
                                "text": "„…, und Chääs und Broot derzue hät au nüd gfäält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "73d46596-5a8f-3cca-b62f-1eaee4cd515e",
                        "entry_id": "fce9600e-41c2-3775-bb38-90ad833c0f6c",
                        "glosses": [
                            "Unsinn, Unrealistisches, Unwahres"
                        ],
                        "tags": [
                            "Swiss German"
                        ],
                        "examples": [
                            {
