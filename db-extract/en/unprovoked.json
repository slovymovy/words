                            {
                                "example_id": "49f8002e-b30a-4b11-8dd1-7283fc8019ff",
                                "sense_id": "4329614b-0a50-3bfd-932c-a5a08b1c4f9f",
                                "text": "A 22-year-old man has been jailed for life with a minimum term of 25 years for fatally stabbing 22-year-old Tashan Daniel in an unprovoked attack at Hillingdon Underground station on September 24 2019."
                            },
                            {
                                "example_id": "22261540-36a3-4fae-855b-a53f9d01ff35",
                                "sense_id": "4329614b-0a50-3bfd-932c-a5a08b1c4f9f",
                                "text": "Three unprovoked stabbings across Manhattan Monday morning that left two men and one woman dead show how the criminal justice and mental health systems fail New Yorkers, the city’s mayor said."
                            }
                        ]
                    }
