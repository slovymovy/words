                        ],
                        "examples": [
                            {
                                "example_id": "78486c19-ed91-4daf-a951-1ac22619cd50",
                                "sense_id": "53a3dba8-be91-33f0-90d2-e34ca367c8d3",
                                "text": "Elle avait vécu entre sa ponette et les chevaux, ceux qu’elle montait et celui qu’elle avait sauvé, Everest, sur lequel elle était déjà perchée à trois ans."
                            },
                            {
                                "example_id": "a37e464f-1360-4381-a3db-b9eaf70e5ecb",
                                "sense_id": "53a3dba8-be91-33f0-90d2-e34ca367c8d3",
                                "text": "Je voudrais l’arrêter, mais j’arrêterais plus facilement une ponette emballée !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f98079ec-bc33-3c04-90d1-2c6698c0f7ce",
                        "entry_id": "c7a0e330-a7bd-37bf-876c-9ba141fb7b06",
