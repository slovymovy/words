                ],
                "senses": [
                    {
                        "sense_id": "98cd6da3-4fea-300e-ab5b-900739570227",
                        "entry_id": "c60ace76-4659-3bd3-864a-86e1896f2d11",
                        "glosses": [
                            "Assembler deux pièces de bois, de métal ou d’étoffe bout à bout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d99e96-74a9-4e6c-8330-b70867157f4a",
                                "sense_id": "98cd6da3-4fea-300e-ab5b-900739570227",
                                "text": "Rabouter deux morceaux de drap."
                            },
                            {
                                "example_id": "8297c7af-7cf8-466f-8c0c-78e961722722",
                                "sense_id": "98cd6da3-4fea-300e-ab5b-900739570227",
                                "text": "Au pavillon des Legrand, construit en meulière, avait été rabouté un appendice crépi à la chaux qui donnait à l'ensemble une curieuse impression d'improvisation."
                            },
                            {
                                "example_id": "60736230-c40e-4270-9fc7-743a3f2ce001",
                                "sense_id": "98cd6da3-4fea-300e-ab5b-900739570227",
                                "text": "Le découpage traditionnel des débuts de la formation des nations anglaise et française raboute en une ligne du temps soi-disant continue trois périodes distinctes au cours desquelles se sont mis en place les éléments fondateurs de l'identité des Anglais et des Français."
                            },
                            {
                                "example_id": "6d5b5409-80a2-42c3-b0c2-0dd9cbc8df00",
                                "sense_id": "98cd6da3-4fea-300e-ab5b-900739570227",
                                "text": "On raboutait plusieurs morceaux de laine ensemble et on foulait le tout dans l'eau : un travail ardu qui nous donnait un tissu fait pour résister au froid et à l'eau."
                            }
                        ]
                    }
