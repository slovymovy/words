                    {
                        "translation_id": "95feda55-aef0-4a61-a3c0-c78d49b033e7",
                        "source_entry_id": "44d9bb30-e04c-32b0-b84d-b18130792a73",
                        "source_sense_id": "9dd52515-ede1-3748-916b-d3335238b794",
                        "target_lang_word": "schrijven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schrijven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "71ee93a2-d599-3068-80c3-b4d532799b09",
                                        "entry_id": "72c7cc30-0038-3f11-9632-1c9126e8861e",
                                        "glosses": [
                                            "tekst in tekens vastleggen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e0b7ec-8907-45a9-965e-4abeaff3ebdf",
                                                "sense_id": "71ee93a2-d599-3068-80c3-b4d532799b09",
                                                "text": "Na veel gepeins besloot ik een lange brief vol ervaringen, waarden en suggesties te schrijven aan mijn kinderen."
                                            },
                                            {
                                                "example_id": "12c3d4dd-1b1a-4a4a-80c7-4a329b3c83ab",
                                                "sense_id": "71ee93a2-d599-3068-80c3-b4d532799b09",
                                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118fa179-6098-38ed-ab3e-4d5e61f83ad9",
                                        "entry_id": "72c7cc30-0038-3f11-9632-1c9126e8861e",
                                        "glosses": [
                                            "iemand een brief sturen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49791e2d-6474-477e-b8bd-5629d24cc5b7",
                                                "sense_id": "118fa179-6098-38ed-ab3e-4d5e61f83ad9",
                                                "text": "Dit was het moeilijke moment, dat was altijd zo. Nu moest hij zeggen dat de dienst hem helaas riep en dat hij rond lunchtijd al opgehaald zou worden met een geheim transport. Maar dat ze elkaar altijd konden schrijven, dat de oorlog niet eeuwig duurde en dat hij haar onmogelijk zou kunnen vergeten. Ze was natuurlijk wanhopig en vond dat hij haar erin had geluisd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "schrijven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "456f1677-f50d-3555-be97-01ee91936a01",
                                        "entry_id": "86e78662-d082-3f0d-ae31-e52ceb9e4e15",
                                        "glosses": [
                                            "een stuk in tekens vastgelegde tekst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45aceccc-6a50-459f-a212-c78f842c854e",
                                                "sense_id": "456f1677-f50d-3555-be97-01ee91936a01",
                                                "text": "In mijn schrijven van donderdag jongstleden heb ik het u reeds meegedeeld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98144a22-c9ae-3309-a714-4f0c6195ae72",
                                        "entry_id": "86e78662-d082-3f0d-ae31-e52ceb9e4e15",
                                        "glosses": [
                                            "de handeling van het in tekens vastleggen van tekst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a204dcc3-0c10-4558-8ec8-6501526d07fb",
                                                "sense_id": "98144a22-c9ae-3309-a714-4f0c6195ae72",
                                                "text": "De boekdrukkunst gaf het schrijven en het lezen een enorme duw in de rug."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
