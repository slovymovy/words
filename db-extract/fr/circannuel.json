                                        "entry_id": "8519b669-3cbf-3bf3-b073-24bc292971f0",
                                        "glosses": [
                                            "Of biological processes: having or occurring in annual cycles or periods"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b38f0d-89c0-4de3-aa28-1dbd8d1160fb",
                                                "sense_id": "e026924a-3e85-3472-b955-1310d9fb4798",
                                                "text": "Light pollution can interfere with the circannual migration of birds."
                                            },
                                            {
                                                "example_id": "01575365-9b15-422b-a398-98ffdb854a3f",
                                                "sense_id": "e026924a-3e85-3472-b955-1310d9fb4798",
                                                "text": "[…] because morbidity and mortality from cardiovascular disease also reveal statistically significant circadian and circannual rhythms."
                                            },
                                            {
                                                "example_id": "6a94bbba-b636-4e7d-b48c-6d2ad01d0a36",
                                                "sense_id": "e026924a-3e85-3472-b955-1310d9fb4798",
                                                "text": "Circannual rhythms control reproductive function in seasonal breeders."
                                            },
                                            {
                                                "example_id": "b718735a-5a6a-41d8-9d36-ede53bee26e6",
                                                "sense_id": "e026924a-3e85-3472-b955-1310d9fb4798",
                                                "text": "Seasonal variations in locomotor activity are generated by a circannual clock […]."
                                            }
                                        ]
