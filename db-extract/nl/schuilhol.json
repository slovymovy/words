                "senses": [
                    {
                        "sense_id": "264c6e38-e11a-3459-aec3-b7fb6ea851fe",
                        "entry_id": "3129b459-c0b9-3b15-aef0-d4cc860b4bb3",
                        "glosses": [
                            "weinig comfortabele plaats waar iemand zich verborgen of schuilt houdt voor gevaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e79316-7c2d-44bb-9182-e0c8dda83c7d",
                                "sense_id": "264c6e38-e11a-3459-aec3-b7fb6ea851fe",
                                "text": "In hun schuilhol vond de politie een enorm organigram met namen van geplande slachtoffers, tijdschema's, pijltjes naar opsporingsorganen en massamedia. \"Heel bizar, maar ze waren echt gevaarlijk. Ze wisten hoe ze met springstof om moesten gaan.\""
                            },
                            {
                                "example_id": "23db60ea-3f6b-40cc-97eb-82092cd18e28",
                                "sense_id": "264c6e38-e11a-3459-aec3-b7fb6ea851fe",
                                "text": "Verder meldden de Amerikaanse strijdkrachten zondag dat er bij het schuilhol geen communicatieapparatuur was aangetroffen. Een militaire zegsman zei dat dit feit zijn opvatting onderstreepte dat de ex-president niet persoonlijk aanvallen op coalitietroepen coördineerde."
                            },
                            {
                                "example_id": "b7eb6667-553b-45a4-b029-35d5189da685",
                                "sense_id": "264c6e38-e11a-3459-aec3-b7fb6ea851fe",
                                "text": "De vogels in Blijdorp zijn door de eerder zo zachte winter een beetje van slag. Een stel lepelaars is daardoor gaan broeden. De verzorgers hebben de jongen die nu net zijn geboren, in de couveuse gelegd, aldus de woordvoerster. Hoewel de gorillafamilie verwarmde schuilholen buiten heeft, kiest ze volgens haar ook voor een verwarmd plekje in het verblijf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cff4bda2-e1b5-4826-b1a8-a874dbbdc6ef",
                        "source_entry_id": "3129b459-c0b9-3b15-aef0-d4cc860b4bb3",
                        "source_sense_id": "264c6e38-e11a-3459-aec3-b7fb6ea851fe",
                        "target_lang_word": "refuge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refuge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359fd24c-5326-3480-8642-44b952c81f43",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A state of safety, protection or shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c1ff42-102b-4551-b254-68046d404cf0",
                                                "sense_id": "359fd24c-5326-3480-8642-44b952c81f43",
                                                "text": "Rocks, dens, and caves! But I in none of these / Find place or refuge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea62e87c-d44b-34fa-887d-b0092205d938",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A place providing safety, protection or shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda9952a-a16a-4ced-b507-dfbb19a33a96",
                                                "sense_id": "ea62e87c-d44b-34fa-887d-b0092205d938",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba10bfed-5b81-312b-a3ab-ceb19a0e276f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "Something or someone turned to for safety or assistance; a recourse or resort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c9b909-b91e-4270-a411-8569f06e5b78",
                                                "sense_id": "ba10bfed-5b81-312b-a3ab-ceb19a0e276f",
                                                "text": "Since its conception, the European Union has been a haven for those seeking refuge from war, persecution and poverty in other parts of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "An expedient to secure protection or defence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016fdf74-1153-4796-a544-1a8337335412",
                                                "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                                "text": "Their latest refuge / Was to send him."
                                            },
                                            {
                                                "example_id": "7b87a980-70d3-4eb6-947b-f8852b46855b",
                                                "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                                "text": "This is occaſioned by this, that too too often the Teaching of a Grammar School is the ordinary Refuge that deſperate Perſons as to any other Employment in good Learning betake themſelves to; whilﬅ but a few know themſelves ſuited with intellectual and moral Abilities, and fewer have that Encouragement, when they undertake it, their Pains deſerve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de491a1-3147-3a39-91c8-d123483def1f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A refuge island."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "refuge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014d961d-3a11-3ee4-ae41-5772afdc5696",
                                        "entry_id": "9670f8cc-6cc4-3f1f-8f10-cb2cd0d323c3",
                                        "glosses": [
                                            "To return to a place of shelter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7420b1ea-2965-4d92-a2be-c3f06883c03c",
                                                "sense_id": "014d961d-3a11-3ee4-ae41-5772afdc5696",
                                                "text": "Among these macaques, although activity cycles are quite variable from location to location, refuging is a common characteristic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994786da-adab-30a7-bd22-ebbf231feb05",
                                        "entry_id": "9670f8cc-6cc4-3f1f-8f10-cb2cd0d323c3",
                                        "glosses": [
                                            "To shelter; to protect."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
