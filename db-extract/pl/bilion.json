                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "A million (times a) million: 1 followed by twelve zeros, 10¹²."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "US",
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0912a570-0ef1-44fd-b10a-65c5356c0e35",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "Javik: Stand in the ashes of a trillion dead souls and ask the ghosts if honor matters. Their silence is your answer."
                                            },
                                            {
                                                "example_id": "7e1155e1-f686-4582-8323-9b9ff367a622",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "Data published by the Treasury Department showed that “total public debt outstanding” rose to $34.001 trillion on December 29."
                                            },
                                            {
                                                "example_id": "d3607037-11a3-4523-b9cc-5f5ad9d0f89d",
                                                "sense_id": "4e5403d9-034a-3718-bd8e-2d91d8f7266c",
                                                "text": "As President Donald Trump prepares to order the dismantling of the Department of Education, the financial arm of the agency – which makes loans directly to borrowers and manages trillions of dollars in student debt – faces an uncertain future, with steep staff cuts and lack of communication exacerbating the uncertainty, according to interviews with more than a dozen current and former department employees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5744187d-930b-31b3-9a29-6019ed5aa31e",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "A million (times a) million (times a) million: 1 followed by eighteen zeros, 10¹⁸."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                        "entry_id": "661393bf-2742-3c31-8518-d4b33b3ade2f",
                                        "glosses": [
                                            "An unspecified very large number."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8235f9b-0927-4516-af62-6b30cf8bb48c",
                                                "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                                "text": "Near-synonyms: gazillion; see also Thesaurus:zillion"
                                            },
                                            {
                                                "example_id": "6073d4e8-4fbc-4bec-aa6d-79d0cd99e6b4",
                                                "sense_id": "faf9f2ff-7ccc-3789-9c66-4eaab85ff7e4",
                                                "text": "There were trillions of people at the concert."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b498aa80-e562-3758-a1eb-bdcd3a4c7035",
