    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3797137-9f78-3b5c-ad39-916d168e5c70",
                    "sense_definition": "urządzenie gospodarstwa domowego służące do prasowania ubrań i tkanin za pomocą wysokiej temperatury",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sprzet_domowy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę kupić nowe <w>żelazko</w>, ponieważ stare słabo się nagrzewa.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новый <w>утюг</w>, так как старый плохо нагревается."
                            }
                        },
                        {
                            "text": "Zanim wyjdziesz z domu, upewnij się, że wyłączyłeś gorące <w>żelazko</w> z prądu.",
                            "target_lang_translations": {
                                "ru": "Прежде чем выйти из дома, убедись, что ты выключил горячий <w>утюг</w> из розетки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gorące żelazko",
                        "żelazko parowe"
                    ],
                    "target_lang_definitions": {
                        "ru": "бытовой прибор для разглаживания складок и заминов на одежде и тканях с помощью высокой температуры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утюг",
                                "target_lang_sense_clarification": "бытовой прибор для глажения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c89fe84f-eb37-352d-ac3e-1507309397d4",
                    "sense_definition": "mechaniczne urządzenie służące do ręcznego kopiowania danych z wypukłych kart płatniczych",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "urzadzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy terminal przestał działać, sprzedawca wyciągnął stare <w>żelazko</w> do kart.",
                            "target_lang_translations": {
                                "ru": "Когда терминал перестал работать, продавец достал старый <w>импринтер</w> для карт."
                            }
                        },
                        {
                            "text": "W dawnych czasach transakcje bezgotówkowe rejestrowano za pomocą mechanicznego <w>żelazka</w>.",
                            "target_lang_translations": {
                                "ru": "В прежние времена безналичные операции регистрировали с помощью механического <w>импринтера</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprinter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie imprintera"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "механическое устройство для снятия оттиска с эмбоссированной банковской карты; импринтер"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импринтер",
                                "target_lang_sense_clarification": "механическое устройство для прокатки банковских карт"
                            },
                            {
                                "target_lang_word": "прокаточница",
                                "target_lang_sense_clarification": "разг., устройство для снятия слипов с карт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5feb2663-7f23-31cf-825a-1712fd1fba59",
                    "sense_definition": "dawne narzędzie górnicze w kształcie klina",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narzedzia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muzeum górnictwa prezentuje dawne <w>żelazko</w> używane do rozłupywania skał.",
                            "target_lang_translations": {
                                "ru": "Музей горного дела экспонирует старинный <w>горный клин</w>, применявшийся для раскалывания породы."
                            }
                        },
                        {
                            "text": "Górnik uderzał młotem w stalowe <w>żelazko</w>, aby kruszyć twardy kamień.",
                            "target_lang_translations": {
                                "ru": "Шахтёр бил молотом по стальному <w>клину</w>, чтобы дробить твёрдый камень."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawne narzędzie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старинный горняцкий инструмент в форме клина для раскалывания породы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горный клин",
                                "target_lang_sense_clarification": "старинное орудие труда рудокопов"
                            },
                            {
                                "target_lang_word": "зубило",
                                "target_lang_sense_clarification": "старинный горный инструмент"
                            }
                        ]
                    }
                }
            ]
        },
        {
