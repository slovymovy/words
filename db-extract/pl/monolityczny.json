                "translations": [
                    {
                        "translation_id": "2ba22c27-0106-4b23-aa6b-3d069b89ac20",
                        "source_entry_id": "d72e550c-1fa0-3fd5-88c7-771f910b00f0",
                        "source_sense_id": "34081a63-720f-3f02-9d1a-9475a05b7083",
                        "target_lang_word": "monolithic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86bada19-e03f-3f4b-9c17-8dfbd4647ad4",
                                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                                        "glosses": [
                                            "Of or resembling a monolith."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79d07b1d-6026-36c7-895a-f4809bbdc311",
                                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                                        "glosses": [
                                            "Consisting of a single piece of homogeneous material as opposed to a composite material or an assembly of multiple parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc2d3aae-e705-42ff-a2a7-f4aa5d514225",
                                                "sense_id": "79d07b1d-6026-36c7-895a-f4809bbdc311",
                                                "text": "A monolithic chunk of titanium with facets for cutting, wrenching, and prying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                                        "glosses": [
                                            "Having a massive, unchanging structure that does not permit individual variation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f8954d-c286-4368-96cf-a3a1b2c0e203",
                                                "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                                                "text": "Mainstream culture is hardly the monolithic block that its caricaturization often implies."
                                            },
                                            {
                                                "example_id": "c44c951e-8fc8-4a6f-b903-ed7f6217e59b",
                                                "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                                                "text": "Farming today is industrial, and dominated by monolithic corporations who control almost all the food we eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f278fca-90f9-3b02-8bad-87029a4cbcb7",
                                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                                        "glosses": [
                                            "Of a single structure, a singular component; instead of an assembly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183e1682-b010-4f5d-b1ff-1e6b7601248c",
                                                "sense_id": "6f278fca-90f9-3b02-8bad-87029a4cbcb7",
                                                "text": "Monolithic space stations only have a single station module."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                                        "glosses": [
                                            "Consisting of a single program or codebase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a61103-45c6-4c90-90eb-a42dd552e73d",
                                                "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                                                "text": "Monolithic kernels perform all operating system duties in kernel space."
                                            },
                                            {
                                                "example_id": "797c5327-06af-4d0a-a542-40eee93a1367",
                                                "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                                                "text": "In the monolithic architecture software system is deployed as a single solution, in which functionally distinguishable aspects are all interwoven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
