                        "glosses": [
                            "Accession au statut d'auteur par l'autoédition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f8493b-dd76-4259-bd49-b2e7dd0dcd7e",
                                "sense_id": "7b8913f5-6013-3fdb-8087-4d6fd7ac2805",
                                "text": "L’autoritativité peut donc être définie comme une attitude consistant à produire et à rendre public des textes, à s’auto-éditer ou à publier sur le WWW, sans passer par l’assentiment d’institutions de référence référées à l’ordre imprimé."
                            },
                            {
                                "example_id": "df906760-9607-4a37-9330-8e9415d82be0",
                                "sense_id": "7b8913f5-6013-3fdb-8087-4d6fd7ac2805",
                                "text": "L’autorité charismatique des blogueurs catholiques s’est construite en amont par leur travail individuel d’autoédition et leurs pratiques d’autoritativité, mais aussi en aval par leur reconnaissance collective par les médias confessionnels comme le magazine Pèlerin cité en introduction."
                            }
                        ]
                    }
