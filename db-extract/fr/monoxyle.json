                        "glosses": [
                            "Se dit d’un ouvrage fait d’une seule pièce de bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb748b1-1398-4a8b-a6f0-84f1fc2f67ba",
