                        "glosses": [
                            "Assurer une péréquation, répartir."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "11fa7718-4f7d-47bc-9f4e-e06b6a472359",
                                "sense_id": "292c7b27-df41-3e40-a480-1320229a95da",
                                "text": "La défenderesse répond, tout d'abord, par des explications sur le concept de péréquation. Péréquater, ou péréquer, signifie répartir équitablement des charges, adapter des valeurs l'une à l'autre. — ()"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ac9fa6a-8244-3547-bcf7-51b7d53c35f3",
                        "entry_id": "30b96f89-86be-3f35-8a08-a765b71534b3",
                        "glosses": [
                            "Indexer, en particulier pour tenir compte de l’inflation."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "786abbe2-b72c-41ec-85fc-bcc3293932f7",
                                "sense_id": "2ac9fa6a-8244-3547-bcf7-51b7d53c35f3",
                                "text": "Le jeton de présence de 30 francs, alloué aux membres des commissions d'appel en matière de pension de vieillesse ne peut-il être péréquaté ?"
                            }
                        ]
                    }
