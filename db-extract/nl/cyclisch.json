                "senses": [
                    {
                        "sense_id": "3b69f898-d354-3cf2-a1f4-c31231cb5bc1",
                        "entry_id": "f9138b24-60f7-3304-855e-c404f9ec0740",
                        "glosses": [
                            "regelmatig terugkerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572eb91e-28cf-4964-aec5-0feb0b45c995",
                                "sense_id": "3b69f898-d354-3cf2-a1f4-c31231cb5bc1",
                                "text": "Vooruitgang In premoderne samenlevingen had men een cyclische kijk op de geschiedenis: van vooruitgangsdenken was hoegenaamd geen sprake. Men ging ervan uit dat alles even slecht of goed zou blijven als het altijd was geweest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c52fd442-70c0-4975-bfac-f76a20d32585",
                        "source_entry_id": "f9138b24-60f7-3304-855e-c404f9ec0740",
                        "source_sense_id": "3b69f898-d354-3cf2-a1f4-c31231cb5bc1",
                        "source_sense_description": "regelmatig terugkerend",
                        "target_lang_word": "zyklisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zyklisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be378d0d-7a80-34d6-9cc0-6a68c31a5e89",
                                        "entry_id": "3820fe9a-79c1-3599-b57d-031fdc6a1aef",
                                        "glosses": [
                                            "regelmäßig wiederkehrend, wiederholend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0606fcc-536a-4a6a-a343-5088bc7b1d46",
                                                "sense_id": "be378d0d-7a80-34d6-9cc0-6a68c31a5e89",
                                                "text": "Sofort fällt einem der zyklische Verlauf auf."
                                            },
                                            {
                                                "example_id": "2133857e-d87d-427f-87f6-14772f382ece",
                                                "sense_id": "be378d0d-7a80-34d6-9cc0-6a68c31a5e89",
                                                "text": "Ob ein zyklisches Anlageverhalten auf dem Aktienmarkt besser ist, als ein antizyklisches, dass muss jeder Anleger für sich entscheiden."
                                            },
                                            {
                                                "example_id": "44443cca-f07a-4ec8-b0da-7b730c47906f",
                                                "sense_id": "be378d0d-7a80-34d6-9cc0-6a68c31a5e89",
                                                "text": "In den USA und in Asien gab es 2004 und 2005 so viele tropische Wirbelstürme wie nie zuvor, und auch der europäische Hitzesommer 2003 könnte sich zyklisch wiederholen, so eine von dem IPCC in Auftrag gegebene Studie."
                                            },
                                            {
                                                "example_id": "7137e917-c0fc-4013-9e22-f99a1a896cf4",
                                                "sense_id": "be378d0d-7a80-34d6-9cc0-6a68c31a5e89",
                                                "text": "Die Beschreibung von Violas Arbeiten ist auf den ersten Blick denkbar einfach: Auf den Leinwänden wird in unterschiedlichen, zyklisch ablaufenden Bildsequenzen gezeigt, wie ein Mann in weißem Hemd und mit ausgebreiteten Armen ins Wasser springt und durch ein Becken gezogen wird. Durch die künstlerische Nachbearbeitung und die in den Videos umgekehrte Bildfolge wird dieser schlichte Sprung auf den zweiten Blick jedoch zum Auftauchen; gleichsam zur Geburt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc20caaa-c18e-3673-8190-2b7617c29933",
                                        "entry_id": "3820fe9a-79c1-3599-b57d-031fdc6a1aef",
                                        "glosses": [
                                            "kreisläufig, kreisförmig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3debf3de-1948-4fb9-b979-f06c9ce731ce",
                                                "sense_id": "bc20caaa-c18e-3673-8190-2b7617c29933",
                                                "text": "Jene Denker, in denen alle Sterne sich in zyklischen Bahnen bewegen, sind nicht die tiefsten; (Nietzsche)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ad84af8-2a2b-3380-a316-fbb5c5d982bc",
                                        "entry_id": "3820fe9a-79c1-3599-b57d-031fdc6a1aef",
                                        "glosses": [
                                            "eine Reihe thematisch zusammenhängender (Kunst-)Werke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e17896f-2060-4cb1-9cca-f9465b79e652",
                                                "sense_id": "8ad84af8-2a2b-3380-a316-fbb5c5d982bc",
                                                "text": "Johann Sebastian Bach hat zahlreiche zyklische Werke komponiert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "adbec6f3-737d-3854-a1dc-c139ca97da75",
                                        "entry_id": "3820fe9a-79c1-3599-b57d-031fdc6a1aef",
                                        "glosses": [
                                            "fachsprachlich zyklische Verbindungen: organische Moleküle mit kreisförmig angeordneten Atomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82e74d4f-d18a-43e4-810c-f70b86d8cc3d",
                                                "sense_id": "adbec6f3-737d-3854-a1dc-c139ca97da75",
                                                "text": "Die Aromaten sind ein Spezialfall zyklischer Verbindungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
