                "senses": [
                    {
                        "sense_id": "e5caaa60-3964-37f9-9fe8-8ebb4063574d",
                        "entry_id": "9b2fe8a7-f5dd-310f-a47d-3574c3c150a5",
                        "glosses": [
                            "The act of breaking."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f345d17-25e6-4512-a7c9-41963a1cf553",
                                "sense_id": "e5caaa60-3964-37f9-9fe8-8ebb4063574d",
                                "text": "A loader performs the important work of storing goods in the wagons and of unloading the wagons. In each case considerable skill is required to avoid breakage, and, in the case of loading, skill goes far to conserve wagon space."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdb33a6d-180b-30f7-92e4-aaab0112898e",
                        "entry_id": "9b2fe8a7-f5dd-310f-a47d-3574c3c150a5",
                        "glosses": [
                            "Something that has been broken."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fdb852a-13fa-4827-81e6-98de52c465fb",
                                "sense_id": "cdb33a6d-180b-30f7-92e4-aaab0112898e",
                                "text": "At the end of the party, there were two reported breakages."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a2b5ec5-2a72-376d-8a9f-18d5dab6bed4",
                        "entry_id": "9b2fe8a7-f5dd-310f-a47d-3574c3c150a5",
                        "glosses": [
                            "A service which is unused by a customer, such as an unredeemed gift card, which therefore represents a pure profit to the seller."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9bb9f67c-9fe0-32b8-a081-2f3b2c3fd692",
                        "entry_id": "9b2fe8a7-f5dd-310f-a47d-3574c3c150a5",
                        "glosses": [
                            "The left-over money in a pari-mutuel betting pool resulting from rounding off the payoffs, added to the pool for the next race or event or kept as profit."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1650f8c4-8347-44b1-999d-3d1670531b3f",
                        "source_entry_id": "9b2fe8a7-f5dd-310f-a47d-3574c3c150a5",
                        "source_sense_description": "something that has been broken",
                        "target_lang_word": "Anbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a8fcb6e-23ba-3a93-a1dc-0f8793b25c04",
                                        "entry_id": "cb5743fa-81a7-31c5-97f9-22f1518376e1",
                                        "glosses": [
                                            "zeitliche Definition im Sinne von Beginn, zum Beispiel einer Tageszeit oder eines Zeitalters"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23f240e-8236-4ac3-a150-0c77f99750f0",
                                                "sense_id": "6a8fcb6e-23ba-3a93-a1dc-0f8793b25c04",
                                                "text": "Der Sonnenaufgang kennzeichnet den Anbruch eines neuen Tages."
                                            },
                                            {
                                                "example_id": "6fdc0f41-9506-41ca-a9b8-c071ebed50e0",
                                                "sense_id": "6a8fcb6e-23ba-3a93-a1dc-0f8793b25c04",
                                                "text": "„Zwei Jahrhunderte lang, seit Anbruch des Industriezeitalters, wurde das Revier durchbuddelt und durchfurcht.“"
                                            },
                                            {
                                                "example_id": "1bb35af4-cf8f-46de-bce6-9c56294004bf",
                                                "sense_id": "6a8fcb6e-23ba-3a93-a1dc-0f8793b25c04",
                                                "text": "„Mit Anbruch des folgenden Tages holte Han Dau-go die Ladenschlüssel aus Simen Tjing's Wohnanwesen, öffnete das Geschäft und schenkte der alten Feng zum Dank eine Unze Silber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a8f0c38-fafa-3b91-9a78-2c2d93e186d3",
                                        "entry_id": "cb5743fa-81a7-31c5-97f9-22f1518376e1",
                                        "glosses": [
                                            "erstmaliges Öffnen eines befüllten und verschlossenen Behältnisses"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063ef7fc-2c35-4fe0-9c79-220f01bcbd07",
                                                "sense_id": "7a8f0c38-fafa-3b91-9a78-2c2d93e186d3",
                                                "text": "Nach Anbruch sollte das Produkt innerhalb weniger Tage verzehrt werden."
                                            },
                                            {
                                                "example_id": "52366609-1cba-4e7a-bf2c-d9f28b2f40bb",
                                                "sense_id": "7a8f0c38-fafa-3b91-9a78-2c2d93e186d3",
                                                "text": "„[Augentropfen] sollten handwarm sein und nach Anbruch der Packung innerhalb von 6 Wochen verbraucht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4138ac32-a801-30cc-a79c-566affb69eb4",
                                        "entry_id": "cb5743fa-81a7-31c5-97f9-22f1518376e1",
                                        "glosses": [
                                            "im Bergbau übliche Bezeichnung der Stelle, an der eine Lagerstätte angetroffen wird, speziell auch einen bloßgelegten Erzgang"
                                        ],
                                        "tags": [
                                            "Bergmannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df11724-e09e-49b0-9a12-fef039a08fb1",
                                                "sense_id": "4138ac32-a801-30cc-a79c-566affb69eb4",
                                                "text": "Der Anbruch wurde vom Vorarbeiter farblich markiert."
                                            },
                                            {
                                                "example_id": "2745065e-c270-455d-89a1-44a0a153f5a4",
                                                "sense_id": "4138ac32-a801-30cc-a79c-566affb69eb4",
                                                "text": "„Nach der physikalisch-ökunomischen Wochenschrift lautete die Denkschrift: ‚Auf dem St. Christophs-Erbstollen, Fundgrubner- und St. Wolfgangsstollen sind Pucherze am Anbruch gehauen werden, werden aber dermalen nicht betrieben. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "48ea700d-4769-3698-89e2-a2ea3f58c299",
                                        "entry_id": "cb5743fa-81a7-31c5-97f9-22f1518376e1",
                                        "glosses": [
                                            "morsch gewordenes und nicht mehr beilfestes Holz, angefaultes Holz"
                                        ],
                                        "tags": [
                                            "Forstwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b4ff1dd-9e95-4398-a0c0-0e50e682dfd7",
                                                "sense_id": "48ea700d-4769-3698-89e2-a2ea3f58c299",
                                                "text": "Am Wegesrand liegen mehrere Haufen mit Anbrüchen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ddb38a9b-0939-3d42-bed3-cbe3e7cdde99",
                                        "entry_id": "cb5743fa-81a7-31c5-97f9-22f1518376e1",
                                        "glosses": [
                                            "beschädigte Stelle, die zur Zerstörung führen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af1cd41a-ceba-4676-9f59-3ec56c4f2b09",
                                                "sense_id": "ddb38a9b-0939-3d42-bed3-cbe3e7cdde99",
                                                "text": "Ich kann noch keine Anbrüche erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
