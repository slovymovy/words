                "senses": [
                    {
                        "sense_id": "bf699cfc-8696-3d3a-8fbd-7cae543581bd",
                        "entry_id": "422db111-7179-3798-835c-3c7a8abafc48",
                        "glosses": [
                            "Sanctionner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f72858-11f1-48ef-ad23-2c9dc2e35e84",
                                "sense_id": "bf699cfc-8696-3d3a-8fbd-7cae543581bd",
                                "text": "Demander que le roi sanctionne et resanctionne la constitution, c'est demander que l'effet produise la cause, ce qui est absurde."
                            },
                            {
                                "example_id": "2ca2be0f-46d8-421d-84b2-409c338f7c6e",
                                "sense_id": "bf699cfc-8696-3d3a-8fbd-7cae543581bd",
                                "text": "Même si la sanction normale est prescrite, l'acte critiqué n'en constitue pas moins un acte de contrefaçon qui devrait être sanctionné par la loi sur les brevets et il n'est pas question de le resanctionner par ce biais."
                            }
                        ]
                    }
                ],
