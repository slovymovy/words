                ],
                "senses": [
                    {
                        "sense_id": "b6114df6-ee32-362a-8fdd-ce453cb7c182",
                        "entry_id": "ea8b42f9-ad14-3a82-9fe3-f4bc30469924",
                        "glosses": [
                            "benaming voor voor verschillende soorten slakken uit de familie Cypraeidae met glanzend gekleurde schelpen, gebruikt voor versiering en als ruilmiddel"
                        ],
                        "tags": [
                            "buikpotigen"
                        ],
                        "examples": [
                            {
                                "example_id": "15448fc9-37df-4aa7-a31e-a3e10eac5698",
                                "sense_id": "b6114df6-ee32-362a-8fdd-ce453cb7c182",
                                "text": "‘Jij hebt het over honderd armbanden,’ zei Wosu. ‘Ik heb alleen mijzelf kunnen voorzien. Ik heb er nog geen kauri aan overgehouden.’"
                            },
                            {
                                "example_id": "cffc6fa6-dce3-4622-84cf-fff4dca7a45b",
                                "sense_id": "b6114df6-ee32-362a-8fdd-ce453cb7c182",
                                "text": "Ook vond men hier de kauri, kleine schelpen die op verschillende plaatsen in Indië als pasmunt golden."
                            }
                        ]
                    },
                    {
                        "sense_id": "f81d8c4d-65b2-3b08-a8d7-a461f340df98",
                        "entry_id": "ea8b42f9-ad14-3a82-9fe3-f4bc30469924",
                        "glosses": [
                            "conifeer Agathis australis die voorkomt in Nieuw-Zeeland, waarvan het hout en de hars nuttige toepassingen kennen"
                        ],
                        "tags": [
                            "coniferen"
                        ],
                        "examples": [
                            {
                                "example_id": "f4741a3d-2088-4183-ac1d-b6ae30e0d306",
                                "sense_id": "f81d8c4d-65b2-3b08-a8d7-a461f340df98",
                                "text": "Het is maar goed, dat het reservaat er is, want anders zou de kauri zijn - uitgestorven als de zeehond in het zuiden en de walvis in het noorden."
                            }
                        ]
                    }
                ],
