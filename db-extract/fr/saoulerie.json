                "senses": [
                    {
                        "sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
                        "entry_id": "1a9fa78a-24c6-3943-902e-ded80540a62c",
                        "glosses": [
                            "Action de se saouler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a3ad8d-db39-416b-8f38-7d802f8cc2e7",
                                "sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
                                "text": "Il me revient vaguement qu’étant plus jeune, au matin d’une saoulerie prolongée, je me réveillai comme aujourd’hui dans une cellule mais moins propre…"
                            },
                            {
                                "example_id": "aa165acd-db6e-47a5-83df-d5d0be70ebae",
                                "sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
                                "text": "— Écoute, tu te trompes sur mon cas, ne te fie pas aux apparences. Tu crois voir ici un petit bourgeois résigné. Mais je vis beaucoup plus intensément que du temps des saouleries et des coucheries."
                            },
                            {
                                "example_id": "c163145b-b9c8-4f9f-abfd-8c5c6a725f42",
                                "sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
                                "text": "Une saoulerie à un souper de cadets n’a rien d’extraordinaire ; le lendemain, il l’a oubliée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae3dcc78-d7c1-4194-89f1-8d46955a4110",
                        "source_entry_id": "1a9fa78a-24c6-3943-902e-ded80540a62c",
                        "source_sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
                        "target_lang_word": "Gelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                        "entry_id": "d658d844-9c3e-39bc-bcd2-cadc7affff79",
                                        "glosses": [
                                            "gemeinsames Mahl mit übermäßigem Essen und Trinken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f964d8e6-5551-4f76-8566-255dda994495",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Glaubt man den antiken Autoren, spielten Gastmähler und Gelage eine wichtige Rolle in der keltischen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "e24f65ff-17e3-4c93-868f-d8e6604754d4",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Zwei Wächter hielten den zum Gelage angereisten Fürsten an den Armen fest.“"
                                            },
                                            {
                                                "example_id": "35ab2aca-de17-441f-88d2-49be3fc3725b",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Hier merkte Messire Thibaud recht gut, daß es sich um ein Gelage handelte, das er am Tage vorher mit seinen beiden Freunden gehalten hatte.“"
                                            },
                                            {
                                                "example_id": "62c75c6a-91d5-46d5-b565-e28e61d64246",
                                                "sense_id": "06c1a4ec-fb5a-370b-b7a4-8e18a386860a",
                                                "text": "„Danach begannen sie ein Gelage mit schweren Weinen und allgemeinem Tanz, als ob es der letzte Tag ihres Lebens wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0932f317-cd1e-4acc-97d8-dab97c7cf219",
                        "source_entry_id": "1a9fa78a-24c6-3943-902e-ded80540a62c",
                        "source_sense_id": "81d8ba5d-c006-3891-9e7e-3e6d8c570945",
