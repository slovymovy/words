                "senses": [
                    {
                        "sense_id": "de63536e-76ed-37d8-8daa-2ee890f69017",
                        "entry_id": "73195366-886f-32f8-9966-9ea89fba5816",
                        "glosses": [
                            "zwolennik lewicy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08174b2a-b35f-4aa5-93be-5009945e03a4",
                                "sense_id": "de63536e-76ed-37d8-8daa-2ee890f69017",
                                "text": "Zwolennikami równouprawnienia poligamii są natomiast zarówno postępowi lewicowcy, którzy w jej zabranianiu widzą „rasistowskie prześladowanie mniejszości”, jak i prawicowi liberałowie, którzy podobny zakaz uważają za „niebezpieczną ingerencję państwa w życie prywatne jednostki”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a247d6a-9ba8-4f01-a788-fab13835957f",
                        "source_entry_id": "73195366-886f-32f8-9966-9ea89fba5816",
                        "source_sense_id": "de63536e-76ed-37d8-8daa-2ee890f69017",
                        "target_lang_word": "leftist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leftist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7cc90d-0a60-3bd7-9114-4a3cf9f15b4b",
                                        "entry_id": "9f88bf77-b1f6-30f2-b3cb-cb789ba0c09b",
                                        "glosses": [
                                            "A person who holds views associated with the political left."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61146a7-d3a9-4f1e-83d5-0ff666664ab6",
                                                "sense_id": "4e7cc90d-0a60-3bd7-9114-4a3cf9f15b4b",
                                                "text": "The first major clash between the two groups occurred in Shih-ho-tzu on January 26, 1967, with the leftists admitting they had suffered a bloody defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b89b1164-2c5c-3485-acac-9f3557c70850",
                                        "entry_id": "9f88bf77-b1f6-30f2-b3cb-cb789ba0c09b",
                                        "glosses": [
                                            "Someone who holds socialist or communist-leaning economic views, usually alongside progressive social views; an anticapitalist."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "leftist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "626cb5e4-f3b8-396d-a1d5-cd0a4de217a8",
                                        "entry_id": "29293ffc-41bd-3623-950d-81e88d457118",
                                        "glosses": [
                                            "Of or pertaining to the political left."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d19df1-02aa-443c-bed0-5b7554196dfa",
                                                "sense_id": "626cb5e4-f3b8-396d-a1d5-cd0a4de217a8",
                                                "text": "In law school, when we students thought the outcome of a case was determined by a rule we had studied, leftist professors admonished us, “Tools not rules!” In other words, rules control nothing; they’re merely tools you manipulate for the results you want. The fancy word for this kind of amorality is “instrumentalism,” and it subverts the rule of law."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "339c5694-92c0-4556-b3c7-ca9b2d373e7e",
                        "source_entry_id": "73195366-886f-32f8-9966-9ea89fba5816",
                        "source_sense_id": "de63536e-76ed-37d8-8daa-2ee890f69017",
                        "target_lang_word": "leftwinger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leftwinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "327230cf-04b2-33e2-8d51-f46cb7742818",
                                        "entry_id": "c776bdd4-24a1-3bb1-9729-eab7051ed3ba",
                                        "glosses": [
                                            "Alternative form of left-winger."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20dc0330-92b5-4012-a485-7c988dd15803",
                        "source_entry_id": "73195366-886f-32f8-9966-9ea89fba5816",
                        "source_sense_id": "de63536e-76ed-37d8-8daa-2ee890f69017",
                        "target_lang_word": "lefty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lefty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "915f833c-82d6-337b-8d23-547372695bc1",
                                        "entry_id": "1dc2417d-c8e2-3e67-974b-8152b47cd59b",
                                        "glosses": [
                                            "One who is left-handed."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0212d18-5e68-3dbe-9c3d-d9dba76bb185",
                                        "entry_id": "1dc2417d-c8e2-3e67-974b-8152b47cd59b",
                                        "glosses": [
                                            "One who has left-wing political views."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51eb31b-d9a4-41fc-8b77-a9b9141b83e1",
                                                "sense_id": "f0212d18-5e68-3dbe-9c3d-d9dba76bb185",
                                                "text": "The new brocialism cares deeply about women’s issues of course – just not enough to elect an actual woman. They don’t need to, because good lefties speak for all us. They don’t even notice gender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cac0ad5-249c-358a-baf6-afa612b01610",
                                        "entry_id": "1dc2417d-c8e2-3e67-974b-8152b47cd59b",
                                        "glosses": [
                                            "One's left testicle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0d4936-db8a-45e0-a422-e7dcc9a89478",
                                                "sense_id": "1cac0ad5-249c-358a-baf6-afa612b01610",
                                                "text": "I'll bet my lefty he won't show up for work today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c9e191e-5a90-3a30-8392-c1291316983b",
                                        "entry_id": "1dc2417d-c8e2-3e67-974b-8152b47cd59b",
                                        "glosses": [
                                            "One's left hand."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2ae398-758c-49b3-ad66-bccd531f02f4",
                                                "sense_id": "8c9e191e-5a90-3a30-8392-c1291316983b",
                                                "text": "This pole gets whipped, I miss dishing it, putting red on the can like Pepsi\nGovs said I defy, I never been right but my yank does love my lefty"
                                            },
                                            {
                                                "example_id": "7d92d221-2d5b-4b47-9d3c-436fade55be7",
                                                "sense_id": "8c9e191e-5a90-3a30-8392-c1291316983b",
                                                "text": "Spin that whip, let me see that dog, Imma blam that goal like Messi, shit gets messy – and I still get him down with my lefty"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lefty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99cd7e2c-1f37-3aa0-bbd9-83c2ae2b4bc4",
                                        "entry_id": "a3ec8f68-ff89-31da-9c3a-9c0049e33cf4",
                                        "glosses": [
