                    {
                        "form_id": "6c9eb385-2cc2-42da-8a1a-e24ae812484f",
                        "entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "па́льчиках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b589fba6-67da-33ad-9244-59b20aebecf1",
                        "entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
                        "glosses": [
                            "разг. уменьш.-ласк. к палец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7f20aeb-8c43-4da0-a00f-bd184461929d",
                                "sense_id": "b589fba6-67da-33ad-9244-59b20aebecf1",
                                "text": "Она другой рукой берёт меня за шею, и пальчики её быстро шевелятся и щекотят меня."
                            },
                            {
                                "example_id": "01591337-885b-4359-9aab-b12bc322813a",
                                "sense_id": "b589fba6-67da-33ad-9244-59b20aebecf1",
                                "text": "Оля улыбнулась и погрозила мне пальчиком."
                            },
                            {
                                "example_id": "ad13c8b6-f73e-424e-a9e0-9df75eccac4f",
                                "sense_id": "b589fba6-67da-33ad-9244-59b20aebecf1",
                                "text": "Девочка, впрочем, и не вырывалась из угла; она стояла смирно, надув губенки, и колупала ногтем своего пальчика штукатурку белой стены."
                            },
                            {
                                "example_id": "cd7e2753-9226-4d65-899f-d764e1057fe6",
                                "sense_id": "b589fba6-67da-33ad-9244-59b20aebecf1",
                                "text": "Сверху доносились слабые звуки гамы, разыгрываемых неверными пальчиками Леночки."
                            }
                        ]
                    },
                    {
                        "sense_id": "75242dbd-9b2d-3d75-b31e-c54a6c4750e9",
                        "entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
                        "glosses": [
                            "мн. ч., проф. отпечатки пальцев"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f73f0aa-a3b2-49b9-8eb9-dd9f5b81aa8c",
                        "source_entry_id": "647f6321-69b9-36a8-b487-8f0a0efef768",
