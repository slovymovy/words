            "senses": [
                {
                    "sense_id": "861e5b08-1d79-36b0-8e1f-6458e8d78cd3",
                    "sense_definition": "ongehuwd samenwonen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "samenwonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloten om te gaan <w>hokken</w> in een klein appartement in de stad.",
                            "target_lang_translations": {
                                "en": "They decided to <w>shack up</w> in a small apartment in the city."
                            }
                        },
                        {
                            "text": "In plaats van te trouwen, kozen ze ervoor om gezellig te <w>hokken</w>.",
                            "target_lang_translations": {
                                "en": "Instead of getting married, they chose to <w>live together</w> cozily."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenwonen"
                    ],
                    "common_phrases": [
                        "gezellig hokken",
                        "samen hokken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for living together unmarried"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To live together without being married, typically in an informal or cozy arrangement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shack up",
                                "target_lang_sense_clarification": "informal, living together unmarried"
                            },
                            {
                                "target_lang_word": "live together",
                                "target_lang_sense_clarification": "cohabiting without marriage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82123bfe-81b1-3af2-9b8a-e78116015ea3",
                    "sense_definition": "in een hok stoppen, bij elkaar blijven, samenscholen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "groeperen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schapen stonden dicht op elkaar te <w>hokken</w> in de hoek van de weide.",
                            "target_lang_translations": {
                                "en": "The sheep were <w>huddling</w> close together in the corner of the meadow."
                            }
                        },
                        {
                            "text": "Tijdens de storm zagen we de vogels onder het afdak <w>hokken</w>.",
                            "target_lang_translations": {
                                "en": "During the storm, we saw the birds <w>huddling</w> under the shelter."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenscholen",
                        "bijeenkruipen"
                    ],
                    "common_phrases": [
                        "bij elkaar hokken"
                    ],
                    "target_lang_definitions": {
                        "en": "To crowd or huddle together closely, or to keep close to one another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "huddle",
                                "target_lang_sense_clarification": "crowding together closely"
                            },
                            {
                                "target_lang_word": "crowd together",
                                "target_lang_sense_clarification": "gathering tightly in a group"
                            }
                        ]
                    }
                }
            ]
        },
        {
