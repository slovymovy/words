                                        "entry_id": "daec7159-5d7b-3d19-9333-11cf7e4a6f8b",
                                        "glosses": [
                                            "Bezeichnung für verschiedene starrkrampfartige Arten der Bewegungsarmut mit und ohne Steigerung des Muskeltonus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca623bb5-95eb-4f45-90a2-bdb879dd2f57",
                                                "sense_id": "e395d899-8514-3e3b-8834-84ded1912856",
                                                "text": "„Die Legendenerzählung berichtet, wie der stolze und leichtlebige Ritter plötzlich in Katalepsie fällt und drei Tage lang wie tot da liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
