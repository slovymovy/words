{
    "word_family": [
        "vijand",
        "vijandigheid",
        "vijandschap"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7501bea9-9e1b-3a29-b61f-61a70c25eba9",
                    "sense_definition": "zich gedragend als een <w>vijand</w> of blijk gevend van onvriendelijkheid en tegenwerking",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>vijandige</w> houding tegenover de nieuwe collega is voor iedereen onbegrijpelijk.",
                            "target_lang_translations": {
                                "en": "His <w>hostile</w> attitude toward the new colleague is incomprehensible to everyone."
                            }
                        },
                        {
                            "text": "De sfeer in de vergadering werd plotseling erg <w>vijandig</w> toen het budget werd besproken.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the meeting suddenly became very <w>hostile</w> when the budget was discussed."
                            }
                        }
                    ],
                    "synonyms": [
                        "onvriendelijk",
                        "vijandiggezind",
                        "agressief"
                    ],
                    "antonyms": [
                        "vriendelijk",
                        "gastvrij",
                        "welwillend"
                    ],
                    "common_phrases": [
                        "vijandige houding",
                        "vijandige sfeer",
                        "vijandig gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "behaving like an enemy or showing unfriendliness and opposition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hostile",
                                "target_lang_sense_clarification": "showing ill will or unfriendliness"
                            },
                            {
                                "target_lang_word": "antagonistic",
                                "target_lang_sense_clarification": "showing active opposition or hostility"
                            },
                            {
                                "target_lang_word": "unfriendly",
                                "target_lang_sense_clarification": "not kind or pleasant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7e2eb9c-5b17-35cc-938c-dc70b01e3f4a",
                    "sense_definition": "behorend tot of kenmerkend voor een tegenstander in een oorlog of conflict",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten moesten voorzichtig zijn toen ze het <w>vijandige</w> gebied betraden.",
                            "target_lang_translations": {
                                "en": "The soldiers had to be careful when they entered <w>hostile</w> territory."
                            }
                        },
                        {
                            "text": "De radar pikte een <w>vijandig</w> vliegtuig op dat de grens naderde.",
                            "target_lang_translations": {
                                "en": "The radar picked up an <w>enemy</w> aircraft approaching the border."
                            }
                        }
                    ],
                    "synonyms": [
                        "vijandelijk"
                    ],
                    "antonyms": [
                        "bondgenootschappelijk",
                        "bevriend"
                    ],
                    "common_phrases": [
                        "vijandig gebied",
                        "vijandige troepen",
                        "vijandig vuur"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to or characteristic of an opponent in a war or conflict"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hostile",
                                "target_lang_sense_clarification": "belonging to an enemy force"
                            },
                            {
                                "target_lang_word": "enemy",
                                "target_lang_sense_clarification": "related to an opposing military force"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}