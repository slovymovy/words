        "nl-extract.jsonl": [
            {
                "entry_id": "880407ce-98e4-31a5-9768-d000ee677134",
                "word": "gelukzoeker",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ebd5fbbd-ee90-47d4-8462-032078aed619",
                        "entry_id": "880407ce-98e4-31a5-9768-d000ee677134",
                        "tags": [
                            "plural"
                        ],
                        "form": "gelukzoekers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                        "entry_id": "880407ce-98e4-31a5-9768-d000ee677134",
                        "glosses": [
                            "iemand die naar een ander land of streek trekt om daar een nieuw (beter en gelukkiger) leven op te bouwen, maar geen vluchteling is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0507da5-4538-4d87-b318-aca67645dd9c",
                                "sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                                "text": "Zelfs hun linkse collega’s ondersteunen het idee dat er een onderscheid tussen ‘politieke vluchtelingen’ en ‘gelukzoekers’ gemaakt moet worden, en dat de laatste hier niets te zoeken hebben."
                            },
                            {
                                "example_id": "3664917e-38d7-4dc7-9781-293b3569554f",
                                "sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                                "text": "Lieve Nederlandse lezers, ik ben geen gelukzoeker. Soms wil ik niet eens gelukkig worden. Survivor's guilt, noemen ze dat. De schaamte en het schuldgevoel waardoor je overvallen wordt omdat jij nog leeft en de anderen niet. Omdat jij een huisje in Haarlem hebt, en je familie vreest voor bombardementen. Dat gevoel onderscheidt ons van economische migranten. Oorlogsvluchtelingen hebben last van diepe heimwee, soms willen ze zelfs dood."
                            },
                            {
                                "example_id": "6362d883-f573-417f-9001-f51c296aba2a",
                                "sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                                "text": "China is een magneet voor starters. Ook Nederlandse gelukzoekers wagen zich hieraan. Het grootste probleem? „Traag internet.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417a8db4-da1f-4f0a-9e91-e35afc5471ad",
                        "source_entry_id": "880407ce-98e4-31a5-9768-d000ee677134",
                        "source_sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                        "source_sense_description": "iemand op zoek naar een beter leven elders",
                        "target_lang_word": "adventurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adventurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "One who enjoys adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb94115f-988e-4eee-9483-709d5adce082",
                                                "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43aaed4b-b0cc-3c0d-bdfc-f36b3cb09704",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who seeks a fortune in new and possibly dangerous enterprises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d462da-e20f-3bb9-b757-07cdd0fffd44",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A soldier of fortune, a speculator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3967e50b-1d81-34f4-a883-a479f6163ae0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who tries to advance their social position by somewhat devious means."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A player of adventure games or text adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e2d7a7-7001-400c-806d-dfec1639d647",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "Meanwhile, the ranks of adventurers grow, be they manic puzzle-solvers or people like me, who like to look under the Robners' beds just for the hell of it."
                                            },
                                            {
                                                "example_id": "207b0c72-6830-4f0c-9d9a-70bcaef66c9a",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "It's a challenging game for the inexperienced adventurer, and should even give the hardened pros a bit of a run for their money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c26a67bd-cdde-4d41-a8ef-2caeb36c0a1f",
                        "source_entry_id": "880407ce-98e4-31a5-9768-d000ee677134",
                        "source_sense_id": "9c31e8ce-3333-35cd-ba4d-f5b020c1f481",
                        "source_sense_description": "iemand op zoek naar een beter leven elders",
                        "target_lang_word": "fortune-hunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortune-hunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                        "entry_id": "599edfac-9249-3efe-983e-b2ee66a19f9a",
                                        "glosses": [
                                            "Alternative form of fortune hunter."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3626f8-69ca-47b0-b64c-86f3c5e1c184",
                                                "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                                "text": "\"There is no character more contemptible than a man that is a fortune-hunter, and I can see no reason why fortune-hunting women should not be contemptible too.\""
                                            },
                                            {
                                                "example_id": "c5b403d3-69c6-43a3-ad94-141efa1e23eb",
                                                "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                                "text": "[H]e did not know of what use money could be to a woman, except to make her a prey to a fortune-hunter."
                                            },
                                            {
                                                "example_id": "cb36010c-c0f9-4c8d-9a57-ae9b95ffd750",
                                                "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                                "text": "\"The stock-exchange, the pulpit, the counting-house, the royal drawing-room, the senate,—what but fortune-hunters are they filled with?\""
                                            },
                                            {
                                                "example_id": "75add6ad-a295-4ac3-a9de-5816c050cc6f",
                                                "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                                "text": "She pictured him as a crafty adventurer, a wretched fortune-hunter."
                                            },
                                            {
                                                "example_id": "8e57b0d6-b180-4013-8bb1-569aca4aca01",
                                                "sense_id": "328b06d8-c7c6-365f-8445-51873dad55d4",
                                                "text": "She had to do something to convince him that he could marry her even if she was a wealthy woman, Cherie decided. Why couldn’t the guy be a fortune-hunter? What was so wrong with that? Ha! She probably wouldn’t love him if he were. Life gets mighty complicated sometimes, she reflected wryly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
