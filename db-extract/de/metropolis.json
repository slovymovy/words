                "translations": [
                    {
                        "translation_id": "f603e0b5-7798-436a-838d-33946b77a769",
                        "source_entry_id": "ce3478b1-1205-36fc-9981-e45fcc66a565",
                        "source_sense_id": "bfa10070-5eb5-3986-95ec-cd2de95e0733",
                        "source_sense_description": "die Weltstadt, die Hauptstadt mit weltstädtischem Charakter, die Provinzhauptstadt",
                        "target_lang_word": "metropolis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metropolis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac1c673c-2394-3e60-ba9b-0b3bf0d15d1a",
                                        "entry_id": "98df0986-81e8-3c7d-843e-131b2183023b",
                                        "glosses": [
                                            "The mother (founding) polis (city state) of a colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab42a78d-6079-4b33-aa67-b5b87c930fa0",
                                                "sense_id": "ac1c673c-2394-3e60-ba9b-0b3bf0d15d1a",
                                                "text": "Colonies certainly did not become \"clones\" of their metropolises, but it is equally false that their colonial heritages were not influenced by the organization of the metropolises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                        "entry_id": "98df0986-81e8-3c7d-843e-131b2183023b",
                                        "glosses": [
                                            "A large, busy city, especially as the main city in an area or country or as distinguished from surrounding rural areas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d93011-2b10-44e7-987d-856a2699fce6",
                                                "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                                "text": "Holonym: metropolitan area"
                                            },
                                            {
                                                "example_id": "5a02a9bc-bf73-40c4-92a8-8f018e28a741",
                                                "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                                "text": "An immense metropolis, like London, is calculated to make men selfish and uninteresting."
                                            },
                                            {
                                                "example_id": "1f8dd44d-9c64-4926-b80a-4c8adccc1935",
                                                "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                                "text": "[I]t would not be very much less absurd for someone to write about New York City after having spent only a few years or a few decades in this metropolis of inexhaustible adventure, of terrifying emotional fecundity, of uncapturable character."
                                            },
                                            {
                                                "example_id": "46764d3f-8be6-4905-8f95-a711a779b946",
                                                "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                                "text": "Love is dead in metropolis / All contact through glove or partition"
                                            },
                                            {
                                                "example_id": "9de47c29-aaba-42dc-b317-875128d17be4",
                                                "sense_id": "4f784d93-4255-3c27-9deb-8f87695c8f9e",
                                                "text": "They call me the Hiphopopotamus / Flows that glow like phosphorous / Popping off the top of this esophagus / Rocking this metropolis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0d87a4-4185-3977-b373-718eb1772d72",
                                        "entry_id": "98df0986-81e8-3c7d-843e-131b2183023b",
                                        "glosses": [
                                            "The see of a metropolitan bishop, ranking above its suffragan diocesan bishops."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f140379-6fd2-3cd5-9aed-a4f34ea19e7b",
                                        "entry_id": "98df0986-81e8-3c7d-843e-131b2183023b",
                                        "glosses": [
                                            "A generic focus in the distribution of plants or animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da9d3fe7-0b41-42ef-b657-0909a93ee057",
                        "source_entry_id": "ce3478b1-1205-36fc-9981-e45fcc66a565",
