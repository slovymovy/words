{
    "word_family": [
        "gleaming",
        "gleamy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56ed3098-4c33-3777-a641-9395c0578ecc",
                    "sense_definition": "To shine, especially in an indistinct or intermittent manner; to glisten or glitter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moonlight began to <w>gleam</w> on the surface of the lake as the clouds moved away.",
                            "target_lang_translations": {
                                "ru": "Лунный свет начал <w>мерцать</w> на поверхности озера, когда облака разошлись."
                            }
                        },
                        {
                            "text": "The knight's armor would <w>gleam</w> brightly whenever the sun hit the polished metal.",
                            "target_lang_translations": {
                                "ru": "Рыцарские доспехи ярко <w>блестели</w> всякий раз, когда солнце попадало на начищенный металл."
                            }
                        }
                    ],
                    "synonyms": [
                        "glint",
                        "glow",
                        "sparkle",
                        "shine",
                        "glimmer"
                    ],
                    "common_phrases": [
                        "gleam brightly",
                        "gleam in the sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светиться, особенно неясно или прерывисто; мерцать или блестеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "о неясном или прерывистом свете"
                            },
                            {
                                "target_lang_word": "блестеть",
                                "target_lang_sense_clarification": "о полированной поверхности или отражении"
                            },
                            {
                                "target_lang_word": "отсвечивать",
                                "target_lang_sense_clarification": "отражать свет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "142cb8c2-2e7d-38a5-b7c6-359d75ea8df5",
                    "sense_definition": "To be strongly but briefly apparent, often referring to an emotion or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden look of anger started to <w>gleam</w> in his eyes during the heated argument.",
                            "target_lang_translations": {
                                "ru": "В его глазах во время жаркого спора <w>мелькнул</w> внезапный гнев."
                            }
                        },
                        {
                            "text": "For a moment, a sense of pride would <w>gleam</w> through her modest exterior.",
                            "target_lang_translations": {
                                "ru": "На мгновение сквозь её скромный вид <w>промелькнуло</w> чувство гордости."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "flare"
                    ],
                    "common_phrases": [
                        "gleam in one's eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляться сильно, но кратковременно (часто об эмоции или качестве)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелькнуть",
                                "target_lang_sense_clarification": "о быстром проявлении чувства"
                            },
                            {
                                "target_lang_word": "промелькнуть",
                                "target_lang_sense_clarification": "о мимолетном выражении лица"
                            },
                            {
                                "target_lang_word": "вспыхнуть",
                                "target_lang_sense_clarification": "о внезапном проявлении эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62dcd1b3-f83c-32dc-940e-6e9c0b8b626e",
                    "sense_definition": "To cause light to shine, usually used with an adverb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying embers <w>gleamed</w> forth a final, weak light before turning to ash.",
                            "target_lang_translations": {
                                "ru": "Угасающие угли <w>испустили</w> последний слабый свет, прежде чем превратиться в пепел."
                            }
                        },
                        {
                            "text": "The lighthouse <w>gleamed</w> out its warning to the ships lost in the heavy fog.",
                            "target_lang_translations": {
                                "ru": "Маяк <w>посылал</w> свой предупреждающий свет кораблям, заблудившимся в густом тумане."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gleam forth",
                        "gleam out"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with adverbs like 'forth' or 'out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучать свет, обычно используется с наречием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светить",
                                "target_lang_sense_clarification": "излучать свет вовне"
                            },
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "ярко светить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c50ac770-ff3f-32f9-95c4-275e00346487",
                    "sense_definition": "Of a hawk or bird of prey: to disgorge filth from its crop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer watched as the hawk began to <w>gleam</w> after its morning meal.",
                            "target_lang_translations": {
                                "ru": "Сокольник наблюдал, как ястреб начал <w>очищать зоб</w> после утренней трапезы."
                            }
                        },
                        {
                            "text": "It is natural for a bird of prey to <w>gleam</w> to clear its gorge of impurities.",
                            "target_lang_translations": {
                                "ru": "Для хищной птицы естественно <w>отрыгивать</w> остатки пищи, чтобы очистить зоб от нечистот."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical falconry term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О хищных птицах: отрыгивать непереваренные остатки пищи из зоба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать зоб",
                                "target_lang_sense_clarification": "технический термин в соколиной охоте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "237aa995-256a-3e23-82e8-49bb89f82fdc",
                    "sense_definition": "A small, indistinct, or short-lived appearance of light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see a faint <w>gleam</w> of light coming from under the locked door.",
                            "target_lang_translations": {
                                "ru": "Мы видели слабый <w>отблеск</w> света, пробивающийся из-под запертой двери."
                            }
                        },
                        {
                            "text": "The first <w>gleam</w> of dawn appeared on the horizon, signaling the start of the day.",
                            "target_lang_translations": {
                                "ru": "На горизонте появился первый <w>проблеск</w> рассвета, знаменующий начало дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "flicker",
                        "glint",
                        "beam"
                    ],
                    "common_phrases": [
                        "gleam of light",
                        "faint gleam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабое, неясное или кратковременное появление света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отблеск",
                                "target_lang_sense_clarification": "отраженный свет"
                            },
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "внезапно показавшийся свет"
                            },
                            {
                                "target_lang_word": "слабый свет",
                                "target_lang_sense_clarification": "неяркое свечение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca1be814-2c96-3ab6-83a9-5349259850d6",
                    "sense_definition": "A small or indistinct sign of something; a glimpse or hint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news gave the family a <w>gleam</w> of hope that their cat might be found.",
                            "target_lang_translations": {
                                "ru": "Эта новость дала семье <w>проблеск</w> надежды на то, что их кот найдется."
                            }
                        },
                        {
                            "text": "There was not even a <w>gleam</w> of interest in his voice when I told the story.",
                            "target_lang_translations": {
                                "ru": "В его голосе не было ни <w>тени</w> интереса, когда я рассказывал эту историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace",
                        "glimmer"
                    ],
                    "common_phrases": [
                        "gleam of hope",
                        "gleam of optimism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный или неясный признак чего-либо; намек или проблеск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "слабое проявление надежды или чувства"
                            },
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "малейший признак чего-либо"
                            },
                            {
                                "target_lang_word": "зачатки",
                                "target_lang_sense_clarification": "первые признаки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ecb3e0-7310-37f8-8457-64c09d97f043",
                    "sense_definition": "A look of joy, mischief, or liveliness on a person's face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I noticed a mischievous <w>gleam</w> in her eyes just before she played the prank.",
                            "target_lang_translations": {
                                "ru": "Я заметил озорной <w>огонек</w> в её глазах прямо перед тем, как она разыграла нас."
                            }
                        },
                        {
                            "text": "A <w>gleam</w> of satisfaction crossed his face when he finally finished the puzzle.",
                            "target_lang_translations": {
                                "ru": "На его лице промелькнул <w>блеск</w> удовлетворения, когда он наконец собрал пазл."
                            }
                        }
                    ],
                    "synonyms": [
                        "glint"
                    ],
                    "common_phrases": [
                        "mischievous gleam",
                        "gleam in the eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение радости, лукавства или оживления на лице человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огонек",
                                "target_lang_sense_clarification": "в глазах, о задоре или лукавстве"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "в глазах, о выражении лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c1ce068-1e38-360e-8d41-5afa857ed33d",
                    "sense_definition": "General brightness, radiance, or splendor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The golden <w>gleam</w> of the sunset covered the entire valley in a warm glow.",
                            "target_lang_translations": {
                                "ru": "Золотистое <w>сияние</w> заката накрыло всю долину теплым светом."
                            }
                        },
                        {
                            "text": "The museum was filled with the silver <w>gleam</w> of ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "Музей был наполнен серебристым <w>блеском</w> древних артефактов."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzle",
                        "lambency"
                    ],
                    "common_phrases": [
                        "golden gleam",
                        "silver gleam"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая яркость, сияние или великолепие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "яркий, ровный свет"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "великолепие или сильное сияние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab340495-56a1-30cd-8796-2f779a41f3b6",
                    "sense_definition": "A warm ray of sunlight or a brief period of warm weather between showers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a brief <w>gleam</w> of sunshine before the next rain cloud arrived.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались коротким <w>просветом</w> солнца перед тем, как пришла следующая дождевая туча."
                            }
                        },
                        {
                            "text": "The hot <w>gleam</w> of the afternoon sun was quite intense for that time of year.",
                            "target_lang_translations": {
                                "ru": "Жаркий <w>луч</w> полуденного солнца был довольно сильным для этого времени года."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot gleam"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal or dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплый солнечный луч или короткий период теплой погоды между дождями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "луч",
                                "target_lang_sense_clarification": "солнечный свет"
                            },
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "солнце между тучами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}