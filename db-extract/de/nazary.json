                ],
                "senses": [
                    {
                        "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                        "entry_id": "3ed79b0f-0e48-37dc-9f7a-05e904a27c0e",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bee001-8708-406e-9bd7-95a87cb4aa18",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Frau Nazary ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ce7a6edf-ed5f-4121-b586-2c63569a413a",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Herr Nazary wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d0d1cedf-51ae-455e-96a8-62935a1ca9e7",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Die Nazarys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ef4722cb-ae70-461b-b8bc-149b28da3635",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Der Nazary trägt nie die Schals, die die Nazary ihm strickt."
                            },
                            {
                                "example_id": "10ae4722-a804-472b-8731-28fed452d681",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nazary kommt, geht der Herr Nazary.“"
                            },
                            {
                                "example_id": "1d8b581d-60e5-458e-af5d-deabded8e733",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Nazary kommt und geht."
                            },
                            {
                                "example_id": "4c8c45e4-bc14-486a-abc0-7ec821ad2b4e",
                                "sense_id": "83a31789-f9ff-3d46-92e0-ac48e200595d",
                                "text": "Nazarys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
