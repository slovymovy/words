                "senses": [
                    {
                        "sense_id": "1d4375e9-7499-3f27-b5a2-d115b4ef5556",
                        "entry_id": "86f9397d-4e6a-3af4-8db8-51e43125dcf5",
                        "glosses": [
                            "разг. хоть какой-нибудь, любой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778f437f-5ba2-41a2-9fc9-2391ef373da1",
                                "sense_id": "1d4375e9-7499-3f27-b5a2-d115b4ef5556",
                                "text": "Он глядел на земные дела цепко, горько и без маломальской фантазии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56e387d2-5045-4465-b453-d908bda79198",
                        "source_entry_id": "86f9397d-4e6a-3af4-8db8-51e43125dcf5",
                        "source_sense_id": "1d4375e9-7499-3f27-b5a2-d115b4ef5556",
                        "target_lang_word": "least",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "least",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                        "entry_id": "67037739-9b01-3064-a0a9-981431d6eb2b",
                                        "glosses": [
                                            "The most little; the smallest amount or quantity of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66f6f91-6867-4fff-91d3-0d5a0f596102",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "Comparison of the four bogie designs shows that the Rugby-built A.E.I. bogie has the least number of components and a minimum of metallic wearing surfaces."
                                            },
                                            {
                                                "example_id": "a61822e1-a0ff-4ce5-b124-9325c9937f63",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "He earns the least money in his family. Of all the sisters, she has the least patience. I can only afford to pay the least of the bills. I'm giving (the) least of all towards her present."
                                            },
                                            {
                                                "example_id": "61ac6854-ddc3-440d-9d72-481a7e53f55d",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "The least water we could find there was 4 fathoms, which bears from the point S.E., and is distant 1½ mile."
                                            },
                                            {
                                                "example_id": "28a04c4e-4372-4d24-aab8-05472eccdc7e",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "To have demolished and rebuilt the walls, would have been a very costly expedient, and as the least of two evils, the painter's brush was resorted to; here and there however, above some of the windows, the black wreathings of the smoke are still discernible through the white covering."
                                            },
                                            {
                                                "example_id": "32c0bce5-8950-41af-949f-2371a4ab6dad",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "“Well,” I says, “I cal'late a body could get used to Tophet if he stayed there long enough.” ¶ She flared up; the least mite of a slam at Doctor Wool was enough to set her going."
                                            },
                                            {
                                                "example_id": "5e53427f-6db5-4b5b-bdf2-03665d1a82e4",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            },
                                            {
                                                "example_id": "c7a6c156-a499-44b1-9ba2-cb3509c44e83",
                                                "sense_id": "b1b3a1c9-1b41-3e47-ad5d-b16460783ad9",
                                                "text": "Light does not need to know in advance which is the path of least time because it takes all paths from its source to its destination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "least",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71a3e401-2307-3e21-a852-8195e260db7d",
                                        "entry_id": "2e0c1962-0339-3837-8088-b15653cf45e5",
                                        "glosses": [
                                            "Used for forming superlatives of adjectives, especially those that do not form the superlative by adding -est."
                                        ],
                                        "tags": [
                                            "negative",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86ec9f6c-6785-4118-b19c-1a96f7c13c20",
                                                "sense_id": "71a3e401-2307-3e21-a852-8195e260db7d",
                                                "text": "It was the least surprising thing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d9940a-d274-3adc-8954-1ae3daafba70",
                                        "entry_id": "2e0c1962-0339-3837-8088-b15653cf45e5",
                                        "glosses": [
                                            "In the smallest or lowest degree; in a degree below all others."
                                        ],
                                        "tags": [
                                            "negative",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef3a50b-f729-43e3-a69e-ecd469526ad0",
                                                "sense_id": "a4d9940a-d274-3adc-8954-1ae3daafba70",
                                                "text": "to reward those who least deserve it"
                                            },
                                            {
                                                "example_id": "0cd66b4c-7811-49be-82be-189556648bdc",
                                                "sense_id": "a4d9940a-d274-3adc-8954-1ae3daafba70",
                                                "text": "my best routine was the one I had practised the least."
                                            },
                                            {
                                                "example_id": "6b122c92-3e96-445c-bc7e-e80330dcbd0a",
                                                "sense_id": "a4d9940a-d274-3adc-8954-1ae3daafba70",
                                                "text": "I don't much like housework, and doing the dishes least of all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "least",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a24a5fc3-67bf-3dd4-925e-dfde709f2829",
                                        "entry_id": "151319bf-d557-34a9-bc77-3ca6aa07e1b2",
                                        "glosses": [
                                            "Something of the smallest possible extent; an indivisible unit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "least",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6697e9a-ea9e-3ce9-bdbc-17f37d3ab0b5",
                                        "entry_id": "c34c92a4-7994-344e-9b78-6f8988c9649a",
                                        "glosses": [
                                            "superlative form of little: most little; littlest."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "040724fb-8797-47cd-855e-ea79e38314ef",
                                                "sense_id": "b6697e9a-ea9e-3ce9-bdbc-17f37d3ab0b5",
                                                "text": "least weasel"
                                            },
                                            {
                                                "example_id": "dd33d0c5-7960-49ae-af90-f18c9d8158fc",
                                                "sense_id": "b6697e9a-ea9e-3ce9-bdbc-17f37d3ab0b5",
                                                "text": "least common multiple"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "least",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e59b011-b2e0-3de0-9c51-37000f852af1",
                                        "entry_id": "0372042e-2303-3685-9f32-726d57ef218c",
                                        "glosses": [
                                            "At least."
                                        ],
                                        "tags": [
                                            "informal",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da26477-cdfe-4d0d-933c-74d89e6fd2f7",
                                                "sense_id": "6e59b011-b2e0-3de0-9c51-37000f852af1",
                                                "text": "“Why he took and dipped his hand in a rotten stump where the rain water was.” “In the day time?” “Certainly.” “With his face to the stump?” “Yes. Least I reckon so.”"
                                            },
                                            {
                                                "example_id": "16d6540b-9405-4397-b193-cad91a2ddd0c",
                                                "sense_id": "6e59b011-b2e0-3de0-9c51-37000f852af1",
                                                "text": "What a stupid white privileged POS I am! Least I call myself out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7ed0c1-9647-42d9-a8e9-7362aa38377a",
                        "source_entry_id": "86f9397d-4e6a-3af4-8db8-51e43125dcf5",
                        "source_sense_id": "1d4375e9-7499-3f27-b5a2-d115b4ef5556",
                        "target_lang_word": "slightest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slightest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64db56e6-7c7d-303a-8ca4-81d8af366881",
                                        "entry_id": "06fc1707-00f5-3229-8376-61b9b3233269",
                                        "glosses": [
                                            "superlative form of slight: most slight."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35334c9c-a005-40ae-be9d-3ff2604e5bf7",
                                                "sense_id": "64db56e6-7c7d-303a-8ca4-81d8af366881",
                                                "text": "The slightest effort made the patient cough. He would stand leaning on a stick and holding a hand to his side, and when the paroxysm had passed it left him shaking."
                                            },
                                            {
                                                "example_id": "1e0fa54d-2767-4bab-9ac0-cf2a500dc1c1",
                                                "sense_id": "64db56e6-7c7d-303a-8ca4-81d8af366881",
                                                "text": "Over the past few months, RAIL has frequently condemned the Department for Transport for its growing contempt for rail customers - by obsessing on cost, caring nothing for service, and not having the slightest interest in growth."
                                            }
                                        ]
                                    }
                                ]
                            },
