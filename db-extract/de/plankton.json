                                "target_senses": [
                                    {
                                        "sense_id": "cc07a023-729f-3543-af7d-ee901ab6e0d8",
                                        "entry_id": "75d64d90-e963-3f2f-aa1c-b1f0d1e8b4e1",
                                        "glosses": [
                                            "Organisms, especially small and microscopic ones, that drift in water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fea63b4-28b2-407c-893d-cc9bd82dd4d4",
                                                "sense_id": "cc07a023-729f-3543-af7d-ee901ab6e0d8",
                                                "text": "Whales feed on tiny plankton drifting in the ocean."
                                            },
                                            {
                                                "example_id": "45e6bcbc-3b47-43b7-a47c-7d67d7df14ef",
                                                "sense_id": "cc07a023-729f-3543-af7d-ee901ab6e0d8",
                                                "text": "The lake water was full of microscopic plankton."
                                            },
                                            {
                                                "example_id": "a9d5922d-6d1c-4fd5-9a12-3617cb987e85",
                                                "sense_id": "cc07a023-729f-3543-af7d-ee901ab6e0d8",
                                                "text": "The study focused on the role of plankton in the food chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf57b31-dbd8-3070-b011-1a9c0c0717f4",
                                        "entry_id": "75d64d90-e963-3f2f-aa1c-b1f0d1e8b4e1",
                                        "glosses": [
                                            "A plankter, any single organism that drifts in water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7359c92e-cafe-4153-852e-2bb05e552366",
                        "source_entry_id": "b901affd-0bfe-3e1c-bdd6-f1a1e4b49ede",
                        "source_sense_id": "f10d6166-9d9b-3c52-b874-1d16d054a9ab",
                        "source_sense_description": "Biologie: Gesamtheit der frei im Wasser treibenden und schwebenden Organismen",
                        "target_lang_word": "plancton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plancton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b5578ef-c2c3-3a9e-b714-b4be480ab102",
                                        "entry_id": "f0427853-3d5e-30a7-8f33-0173d8ae0939",
                                        "glosses": [
                                            "Ensemble d’organismes aquatiques microscopiques ou macroscopiques, généralement incapables de résister aux courants et dérivant dans les mers ou les eaux douces ; il comprend le phytoplancton, le zooplancton, ainsi que des bactéries et des virus."
                                        ],
                                        "tags": [
                                            "Biologie marine",
                                            "Écologie aquatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "720a2fc6-c4ca-45f5-9ea5-830e0bef0a93",
                                                "sense_id": "4b5578ef-c2c3-3a9e-b714-b4be480ab102",
                                                "text": "L’ensemble des êtres océaniques, animaux et végétaux, se classe en trois grandes catégories : le Benthos, le Nekton et le Plankton."
                                            },
                                            {
                                                "example_id": "ab0dc894-5129-4dc5-ad79-74f7b15efcae",
                                                "sense_id": "4b5578ef-c2c3-3a9e-b714-b4be480ab102",
                                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                                            },
                                            {
                                                "example_id": "f07db9be-7c0b-47a8-aca8-00c9d302225d",
                                                "sense_id": "4b5578ef-c2c3-3a9e-b714-b4be480ab102",
                                                "text": "Le plancton rassemble les espèces aquatiques entraînées par le courant, animales comme des méduses pour le zooplancton, et végétales comme les algues pour le phytoplancton, ainsi que des bactéries et des virus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
