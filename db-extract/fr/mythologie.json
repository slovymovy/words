        "fr-extract.jsonl": [
            {
                "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                "word": "mythologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d98c2107-14f1-4169-ab90-6e775785caa1",
                        "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "mythologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3218abee-c358-3f47-bd7c-ce825b405bfb",
                        "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "glosses": [
                            "Ensemble des histoires fabuleuses des dieux, des demi-dieux et des héros de tel ou tel peuple, civilisation, ou région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d6f39e-7892-4824-bb98-5cb0c6322624",
                                "sense_id": "3218abee-c358-3f47-bd7c-ce825b405bfb",
                                "text": "Les Féroésiens l’ont consacrée à Thor : de tous les dieux de l’ancienne mythologie scandinave, Thor est celui qui a la vie la plus dure."
                            },
                            {
                                "example_id": "b5a36fe1-af75-473b-824f-75e4d43796d9",
                                "sense_id": "3218abee-c358-3f47-bd7c-ce825b405bfb",
                                "text": "Ils manient avec une élégante aisance les mètres latins les plus compliqués et les vocables les plus choisis de la mythologie."
                            },
                            {
                                "example_id": "f1a9dc07-b68b-41f3-8fce-0d80cb7bcd2e",
                                "sense_id": "3218abee-c358-3f47-bd7c-ce825b405bfb",
                                "text": "En sixième, quand on a fait la mythologie grecque, je me suis dit que c’était normal que les gouers, ils croyaient que Jésus était le fils de Dieu parce que leurs ancêtres, ils croyaient bien qu’Héraclès était le fils de Zeus."
                            },
                            {
                                "example_id": "6d75959b-059b-41c8-ba3e-2abadd4616e7",
                                "sense_id": "3218abee-c358-3f47-bd7c-ce825b405bfb",
                                "text": "Le portail de cette dernière est surmonté de deux sirènes, ces êtres mythiques qui, selon la mythologie inca, servaient de messagers entre le monde d’en bas (urin) et le monde d’en haut (hanan)."
                            }
                        ]
                    },
                    {
                        "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                        "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "glosses": [
                            "Ensemble des idées qu'un groupe humain se fait de certaines choses."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ffdef5-2dd9-4e89-8442-f2057ab1f04e",
                                "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                                "text": "En outre, la communauté fait preuve d’une forte propension à mythifier les fondateurs de ces monnaies et à les placer sur un piédestal. Pour Bitcoin, le culte se concentre autour de la figure énigmatique de Satoshi Nakamoto, devenu prophète malgré lui. Dans la mythologie Bitcoin, ce dernier restitue au peuple un instrument constitutif de son émancipation, la monnaie, en la volant au monopole des États et des Banques centrales."
                            },
                            {
                                "example_id": "1642e74f-5e5e-4bd2-b1c3-6b853bf507f1",
                                "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                                "text": "Il y a présentement le risque d'une mythologie du nègre en soi qui n'est qu'une évasion du blanc devant ses propres problèmes. Il existe le danger d'une négrophilie philistine, d'une négrophilie sans obligation ni sanction ; […]."
                            },
                            {
                                "example_id": "90677fd3-1d9c-4b58-a01f-719e66db94b2",
                                "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                                "text": "Ainsi la télévision publique est-elle un thème de débat, une posture obligée, une rhétorique de salon qui mériterait de figurer dans les mythologies des couches cultivées."
                            },
                            {
                                "example_id": "a1494282-94cc-4fb4-bb7a-ce780c0fda2b",
                                "sense_id": "36b49501-dea2-3b20-b71d-eba3d664931b",
                                "text": "Mythologie du village français ? Oui, complètement ! C’est même drôle à quel point nous recouvrons la réalité par des métaphores et des mythes. Actuellement, ce sont l’image de la guerre et de l’abri qui dominent."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7b320f1-d043-3e40-a7f5-5f4a7d1a916f",
                        "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "glosses": [
                            "Ouvrage qui traite de cette matière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "578f98a8-b601-46c3-af9e-7c6a8e49e803",
                                "sense_id": "e7b320f1-d043-3e40-a7f5-5f4a7d1a916f",
                                "text": "Il a acheté une mythologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cb57b60-81fa-3bf3-9f7c-0bf5c3b4a65d",
                        "entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "glosses": [
                            "Science qui étudie les mythes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a79ef9eb-a089-40a7-b5d3-53198f99437c",
                        "source_entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "target_lang_word": "Mythologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mythologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2169c063-bfb5-3ea7-9ce8-c73eb4a29e60",
                                        "entry_id": "85ca33d5-99e7-3603-8a42-d36793d96f6f",
                                        "glosses": [
                                            "systematisch-wissenschaftliche Darstellung der und die Beschäftigung mit den Mythen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a416142-2293-4eb5-ad8b-ca68b03a77e9",
                                                "sense_id": "2169c063-bfb5-3ea7-9ce8-c73eb4a29e60",
                                                "text": "Die Mythologie kann sich z.B. damit befassen, welche Schöpfungsmythen es bei den Völkern der Erde gibt oder gegeben hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                        "entry_id": "85ca33d5-99e7-3603-8a42-d36793d96f6f",
                                        "glosses": [
                                            "Gesamtheit oder System der Mythen einer Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b3a176-4d30-4b25-a15e-357e6e70f9a2",
                                                "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                                "text": "Die griechische Mythologie weist viele Götter auf."
                                            },
                                            {
                                                "example_id": "7634ee33-42f2-4fee-bf3a-5ca1869d25a4",
                                                "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                                "text": "„Indische, griechische und nordische Mythologie zeigen klare Ansätze zu einer philosophischen oder »spekulativen« Betrachtungsweise.“"
                                            },
                                            {
                                                "example_id": "dc4e41bf-ab4c-4ca6-8a62-730aff2bd4d9",
                                                "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                                "text": "„Es handelte sich um Darstellungen höchst unanständiger Szenen von Leda mit dem Schwan, von Pan und den Nymphen, von Susanna im Bade und ähnlichen Sachen, die schon längst zur Konfiskation der Bibel, der Mythologie und der gesamten Kunstgeschichte hätte führen müssen, wenn sich alles nach der Berliner Polizei richten würde.“"
                                            },
                                            {
                                                "example_id": "81d29a59-ced5-4972-bf3c-2d7e73b58897",
                                                "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                                "text": "„Nikolai sass etwas eingesunken in seinem Sessel, beugte sich unentwegt lächelnd zu der schönen Blondine neben ihm und sagte ihr Komplimente, in denen er sie mit Gestalten der Mythologie verglich.“"
                                            },
                                            {
                                                "example_id": "402be9da-9198-497a-a290-efa7dc9e283c",
                                                "sense_id": "39b4fb44-e8bd-3c27-a202-a33666993f6b",
                                                "text": "„Weil der Löwe der ägyptischen Mythologie zufolge die Augen immer offen hat, ist er die Verkörperung der Wachsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6b2510-bf77-4bd1-a25d-91cd32e32c78",
                        "source_entry_id": "4f824cd2-b102-3974-9097-159c1e97f9b7",
                        "target_lang_word": "mythology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47fa8b51-bd87-36d9-8cc9-1f6a1a6edff4",
                                        "entry_id": "3fc989b7-38a4-3470-8ed6-814e5d6cf7d0",
                                        "glosses": [
                                            "The collection of myths of a people, concerning the origin of the people, history, deities, ancestors and heroes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ba27c7-436f-4e8e-898f-cdd9cd89076c",
                                                "sense_id": "47fa8b51-bd87-36d9-8cc9-1f6a1a6edff4",
                                                "text": "Now the great obstacle in tracing the identity of any of the basic forms of worship lies in the vast number of names which appear in the ancient idolatries and mythologies, creating the illusion of a miscellany of gods, whereas many of these different names refer to the same deity. Thus the sun has been personified and worshipped under as many different names as there are nations on the surface of the earth."
                                            },
                                            {
                                                "example_id": "1b24f2cd-714a-4863-9bb8-10691d844599",
                                                "sense_id": "47fa8b51-bd87-36d9-8cc9-1f6a1a6edff4",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85380312-508c-3d87-b52a-7e11fb1417ef",
                                        "entry_id": "3fc989b7-38a4-3470-8ed6-814e5d6cf7d0",
                                        "glosses": [
                                            "A similar body of myths concerning an event, person or institution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23529f88-b00b-4148-b99d-9ef468f38bb4",
                                                "sense_id": "85380312-508c-3d87-b52a-7e11fb1417ef",
                                                "text": "This program to distinguish Austria from Germany was important to building a new Austria, but it also indirectly contributed to victim mythology by implying that participation in the Nazi war of conquest was antithetical to Austrian identity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa2d46c-11ff-3899-8e5f-5f1a1a1ce86f",
                                        "entry_id": "3fc989b7-38a4-3470-8ed6-814e5d6cf7d0",
                                        "glosses": [
                                            "Pervasive elements of a fictional universe that resemble a mythological universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ebf9d16-d89e-4809-91fb-e1f94d3e9d4e",
                                                "sense_id": "0fa2d46c-11ff-3899-8e5f-5f1a1a1ce86f",
                                                "text": "This tongue-in-cheek episode is especially fun for people who don’t take their “X-Files” mythology seriously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e13afb-ed38-39dc-848f-c37fab1fad94",
                                        "entry_id": "3fc989b7-38a4-3470-8ed6-814e5d6cf7d0",
                                        "glosses": [
                                            "The set of misconceptions and false attitudes that are held about something and contribute to its perception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee916dd5-85a4-442e-bd8a-b99d6bcd2da7",
                                                "sense_id": "09e13afb-ed38-39dc-848f-c37fab1fad94",
                                                "text": "Straight people who do not know, or do not know that they know, any gays, can accept all the mythology about us that is paramount in the propaganda of our enemies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030b6ad7-7f56-34f6-963c-b536515b6c43",
                                        "entry_id": "3fc989b7-38a4-3470-8ed6-814e5d6cf7d0",
                                        "glosses": [
                                            "The systematic collection and study of myths."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
