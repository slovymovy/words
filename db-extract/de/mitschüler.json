                        "form": "den Mitschüler"
                    },
                    {
                        "form_id": "8bae8584-7154-459d-b5b9-2918fcf09370",
                        "entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mitschüler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                        "entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                        "glosses": [
                            "eine Person, die dieselbe Schule besucht(e) wie man selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750220bf-b6dc-4621-bec7-f109d7ae3caa",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "Erwin erpresst seine Mitschüler auf dem Pausenhof."
                            },
                            {
                                "example_id": "3ed1bf87-a427-4e61-8553-fa946152b08e",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "Die Mitschüler halfen einander bei den Hausaufgaben."
                            },
                            {
                                "example_id": "cff28660-3791-455e-8fa1-417590e4bce8",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler.“"
                            },
                            {
                                "example_id": "5ed8d28a-4a82-45af-bce7-4161261b989d",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“"
                            },
                            {
                                "example_id": "70726feb-bd95-405e-a3d1-600580c214ce",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "„Noch etwas war ihm bei seinen Mitschülern aufgefallen.“"
                            },
                            {
                                "example_id": "de26772e-10ce-4923-bab5-c61a0044cc45",
                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b178e37-11e4-4a15-8067-eba13854f158",
                        "source_entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                        "source_sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                        "source_sense_description": "eine Person, die dieselbe Schule besucht(e) wie man selbst",
                        "target_lang_word": "schoolmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                        "entry_id": "9235123b-7a7e-3a62-a5a9-a0d738700730",
                                        "glosses": [
                                            "A person who was a fellow attendee at one's school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9f6a56a-df39-46ed-877c-c82ad32c0202",
                                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                                "text": "I've lost touch with all my old schoolmates: I only see them at class reunions."
                                            },
                                            {
                                                "example_id": "52a4bf9f-a273-4769-ac39-cca554fad459",
                                                "sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
                                                "text": "The truth seems to be, however, that when he casts his leaves forth upon the wind, the author addresses, not the many who will fling aside his volume, or never take it up, but the few who will understand him better than most of his schoolmates or lifemates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "294ecbcb-8a19-4049-9ef3-f5dd4c5ce36a",
                        "source_entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                        "source_sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                        "source_sense_description": "eine Person, die dieselbe Schule besucht(e) wie man selbst",
                        "target_lang_word": "classmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A student who is in the same class at school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50df9526-b9ac-4dfd-9bea-b905bcc02d9d",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "She was your classmate at the village school from first grade."
                                            },
                                            {
                                                "example_id": "31e0c9a0-b5c7-4f1a-812c-5109b100b6f6",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "Danny and I have been classmates for five years, but I've never spoken to him outside of lessons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A member of a different sort of class, such as locomotives etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87374be0-ccde-42a0-90b1-e8ea3b317ca5",
                                                "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                                "text": "The Class 87 is the only main line-certified member of the fleet left in the UK, although there are 21 classmates in use overseas [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc8e3658-bf0d-4ae0-a1ff-d93a914f04c8",
