                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7d995c2-e364-3287-9fa2-15637350c7e7",
                        "entry_id": "9177cffa-52c9-36a1-a582-f0aa1f6e7426",
                        "glosses": [
                            "w sposób instynktowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee2c366-a987-45ec-816c-ee115ae6fd51",
                                "sense_id": "b7d995c2-e364-3287-9fa2-15637350c7e7",
                                "text": "W ramach rozgrzewki miałam zrobić pięćdziesiąt przysiadów, ale przy trzydziestym piątym straciłam równowagę i złamałam nadgarstek, gdy instynktownie starałam się podeprzeć."
                            },
                            {
                                "example_id": "2d215893-c8d9-4719-b937-cd67742f8d8c",
                                "sense_id": "b7d995c2-e364-3287-9fa2-15637350c7e7",
                                "text": "Człowiek instynktownie chroni to, co jest święte, przed przejawami profanum."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d59c01d3-9f87-43de-ad4c-f41a2e7859ca",
                        "source_entry_id": "9177cffa-52c9-36a1-a582-f0aa1f6e7426",
                        "source_sense_id": "b7d995c2-e364-3287-9fa2-15637350c7e7",
                        "target_lang_word": "instinctively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                        "entry_id": "6c9c7bfa-e058-32fc-ac27-b858feb8ffef",
                                        "glosses": [
                                            "Innately; by instinct; without being taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1a41bd-7287-46be-b68a-78833a68cc7c",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "Fish instinctively know how to swim; most humans don't."
                                            },
                                            {
                                                "example_id": "bb1c246e-5588-4e3b-b287-2c7ee252ebff",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "She loved him so passionately, and he was so godlike in her eyes; and being, though untrained, instinctively refined, her nature cried for his tutelary guidance."
                                            },
                                            {
                                                "example_id": "6e88c3bd-70a3-42ad-a92e-69393d3081c4",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "'I am, perhaps, overgreedy, but I sense a good cook instinctively.'"
                                            },
                                            {
                                                "example_id": "0fc6fc8b-ddd6-46a4-9ee8-d6e18263dfdb",
                                                "sense_id": "21119385-082f-36ab-8ef7-fdc894ae70f8",
                                                "text": "While Conservative and Labour MPs instinctively had deep political differences, they were united in the cold view that at the end of the 1950s, Britain's railways were friendless and almost finished."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b736c3b2-9107-44c6-a16d-63a070363d08",
                        "source_entry_id": "9177cffa-52c9-36a1-a582-f0aa1f6e7426",
                        "source_sense_id": "b7d995c2-e364-3287-9fa2-15637350c7e7",
                        "target_lang_word": "instinctivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinctivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                        "entry_id": "7c7652e1-0ebe-38c4-b158-cc6fbd103bf8",
                                        "glosses": [
                                            "Par instinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce16c27-981f-425f-9608-4f1e6de255aa",
                                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                                "text": "Tous deux demeurèrent quelques instants en silence, et leurs regards se portèrent instinctivement vers l’endroit où était apparu le chevalier, le jour de son combat avec Gérard."
                                            },
                                            {
                                                "example_id": "d0f83a8d-7044-44ff-8602-16d263e86e5b",
                                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                                "text": "Mais il était modeste au logis, il y sentait instinctivement la supériorité de sa femme, quelque jeune qu'elle fût ; […]."
                                            },
                                            {
                                                "example_id": "81c238b2-7572-449a-ad46-850a37202a92",
                                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                                "text": "C'est notre première bataille, mais nous ébauchons instinctivement tous les gestes et les pensées que nous aurons une fois guerriers."
                                            },
                                            {
                                                "example_id": "8da0c314-8656-45c6-8109-3d34a1707019",
                                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                                "text": "Ce n'est pas par raison qu'un pilote agit avec mesure: il le fait instinctivement, avec d'autant plus de naturel qu'il a de l'expérience et de ce fait, une tendance à ne rien risquer."
                                            },
                                            {
                                                "example_id": "d33debf3-29c5-4462-bbf0-3fd2c81df5db",
                                                "sense_id": "dff6417b-2990-3e40-b401-94dce1677507",
                                                "text": "Instinctivement Éric esquive le coup, bascule en arrière en entraînant l’homme dans sa chute et l’envoie bouler à quelques mètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
