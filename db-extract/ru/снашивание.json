                                "target_senses": [
                                    {
                                        "sense_id": "c0696204-2645-3d57-9e66-1cb90a9ded7a",
                                        "entry_id": "2ddf15a9-f1a4-38dd-96d3-239ded69ce05",
                                        "glosses": [
                                            "Damage or depreciation resulting from ordinary use (normally as something excluded from a guarantee or warranty of quality, or as justifying a write-down in a set of accounts)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e760bde9-f2c2-488e-94b7-607b0a7e6fc7",
                                                "sense_id": "c0696204-2645-3d57-9e66-1cb90a9ded7a",
                                                "text": "The washing machine flooded the basement due to wear and tear, so Margaret was not eligible for insurance."
                                            },
                                            {
                                                "example_id": "bd2201b0-f3bf-4852-9478-6b2da08ff07e",
                                                "sense_id": "c0696204-2645-3d57-9e66-1cb90a9ded7a",
                                                "text": "The main obstacles to increasing traffic, in fact, are the heavy gradients and sharp curves on the approaches to the Gotthard Tunnel. Wear-and-tear of the track necessitates frequent attention by the civil engineers and possessions are hard to obtain without reducing the throughput of trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
