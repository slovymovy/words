                {
                    "sense_id": "9d25cab6-031a-3f73-bf8f-728443f6b815",
                    "sense_definition": "zich afmelden of verwijderen uit een officieel register of lijst",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "registratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je op tijd <w>uitschrijven</w> bij de gemeente als je naar het buitenland verhuist.",
                            "target_lang_translations": {
                                "en": "You must <w>deregister</w> with the municipality on time if you move abroad."
                            }
                        },
                        {
                            "text": "Na het behalen van het diploma kon de student zich eindelijk <w>uitschrijven</w> bij de universiteit.",
                            "target_lang_translations": {
                                "en": "After obtaining the diploma, the student could finally <w>unenroll</w> from the university."
                            }
                        }
                    ],
                    "synonyms": [
                        "afmelden",
                        "deregistreren"
                    ],
                    "antonyms": [
                        "inschrijven"
                    ],
                    "common_phrases": [
                        "zich uitschrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially remove oneself from a register or list"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to deregister",
                                "target_lang_sense_clarification": "formal removal from an official record"
                            },
                            {
                                "target_lang_word": "to unenroll",
                                "target_lang_sense_clarification": "specifically for courses or institutions"
                            },
                            {
                                "target_lang_word": "to sign out",
                                "target_lang_sense_clarification": "general sense of leaving a system or list"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ef49423-2df8-33e1-8e06-85d4ae020a0f",
                    "sense_definition": "officieel aankondigen of organiseren van een wedstrijd of prijsvraag",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente heeft een prijsvraag <w>uitgeschreven</w> voor het beste ontwerp van het nieuwe park.",
                            "target_lang_translations": {
                                "en": "The municipality has <w>announced</w> a competition for the best design of the new park."
                            }
                        },
                        {
                            "text": "De sportbond heeft een toernooi <w>uitgeschreven</w> voor alle amateurclubs in de regio.",
                            "target_lang_translations": {
                                "en": "The sports federation has <w>called for</w> a tournament for all amateur clubs in the region."
                            }
                        }
                    ],
                    "synonyms": [
                        "organiseren",
                        "aankondigen"
                    ],
                    "common_phrases": [
                        "wedstrijd uitschrijven",
                        "prijsvraag uitschrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially announce or organize a competition or contest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to announce",
                                "target_lang_sense_clarification": "making a competition public"
                            },
                            {
                                "target_lang_word": "to call for",
                                "target_lang_sense_clarification": "inviting entries for a competition or tender"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa6b216d-dab1-306f-8d14-20880d2df346",
                    "sense_definition": "het officieel opstellen of invullen van een document zoals een cheque of recept",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "documentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts moet een nieuw recept <w>uitschrijven</w> voor de medicijnen.",
                            "target_lang_translations": {
                                "en": "The doctor must <w>write out</w> a new prescription for the medication."
                            }
                        },
                        {
                            "text": "De bankmedewerker heeft de cheque voor het juiste bedrag <w>uitgeschreven</w>.",
                            "target_lang_translations": {
                                "en": "The bank employee <w>wrote out</w> the check for the correct amount."
                            }
                        }
                    ],
                    "synonyms": [
                        "opstellen",
                        "invullen"
                    ],
                    "common_phrases": [
                        "recept uitschrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially draw up or fill out a document like a prescription or check"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to write out",
                                "target_lang_sense_clarification": "filling in the details of a document"
                            },
                            {
                                "target_lang_word": "to issue",
                                "target_lang_sense_clarification": "formally providing a document like a prescription"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e54a2a74-03e7-318b-adb7-4c1cf255cea1",
                    "sense_definition": "het schrijven van een tekst afronden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "schrijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was net <w>uitgeschreven</w> toen de telefoon ging en hij moest opnemen.",
                            "target_lang_translations": {
                                "en": "He had just <w>finished writing</w> when the phone rang and he had to answer it."
                            }
                        },
                        {
                            "text": "Nadat ze haar brief had <w>uitgeschreven</w>, deed ze de envelop in de brievenbus.",
                            "target_lang_translations": {
                                "en": "After she had <w>finished writing</w> her letter, she put the envelope in the mailbox."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To finish writing a text"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to finish writing",
                                "target_lang_sense_clarification": "completing the act of writing"
                            },
                            {
                                "target_lang_word": "to write out",
                                "target_lang_sense_clarification": "writing something in full or to completion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
