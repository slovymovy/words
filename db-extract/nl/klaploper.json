                "senses": [
                    {
                        "sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                        "entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "glosses": [
                            "iemand die profiteert van andermans goedheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0525f25-9f1f-4142-bec6-783a0ac337d1",
                                "sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                                "text": "Het was absoluut mijn beurt om Lena ergens voor uit te nodigen, het liefst de bioscoop, anders zou ik een soort klaploper bij haar thuis worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c974b1be-a4fe-4c4a-b255-e3f0b340888c",
                        "source_entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "source_sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                        "target_lang_word": "Schmarotzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmarotzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                        "entry_id": "995414c5-20d9-3ddc-bdbc-629498e5fd3c",
                                        "glosses": [
                                            "faule Person, die vom Geld, von der Arbeit anderer lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa0c94a-801a-4590-854d-8274056235dd",
                                                "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                                "text": "Er muss nicht arbeiten, denn er hat einen reichen Onkel und lebt wunderbar als Schmarotzer."
                                            },
                                            {
                                                "example_id": "30ad9618-4331-46f1-a7f6-c061dfad82e2",
                                                "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                                "text": "„‚Hoho, man will Sex und bekommt nichts als einen Schmarotzer, das kennen wir doch‘, so rufen die anderen, und schauen abfällig auf den Lebensabschnittsgefährten, der schlaff und arbeitslos auf der Couch herumschimmelt.“"
                                            },
                                            {
                                                "example_id": "fb398028-e4d5-4eab-a5da-6d178b34fef5",
                                                "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                                "text": "„In den Augen dieser Wilden war er nicht mehr länger ein Schmarotzer.“"
                                            },
                                            {
                                                "example_id": "660954e7-2770-43ee-8b99-4374c33498f8",
                                                "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                                "text": "„In dieser ausnehmend langweiligen Stadt, in der sich die Schmarotzer viel lieber auf die Fremden stürzen als auf die Einheimischen, unterhielt ich mich bei einer Pharaobank, die man im Café aufgelegt hatte, und drängte auch Rosalie zu spielen.“"
                                            },
                                            {
                                                "example_id": "a40687ae-3ec7-46f3-82d7-6bbae83a35a4",
                                                "sense_id": "4395de91-04a6-3a2f-a121-ce69658b5c99",
                                                "text": "„Dabei hat sie jahrelang allerlei hergelaufene Schmarotzer am Fressen gehalten, aber das waren ›Künstler und Dichter‹; Schnitzler, dieser Kitschbruder, und Gruber, der gar nicht so übel war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1468de8a-b345-38c9-b626-1f9857c4b134",
                                        "entry_id": "995414c5-20d9-3ddc-bdbc-629498e5fd3c",
                                        "glosses": [
                                            "Organismus, der seine Nahrung (zum einseitigen Nutzen) auf Kosten anderer Pflanzen oder Tiere gewinnt, indem er auf oder in ihnen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "838d4f06-ba32-4787-96d9-915f6a9ce8c0",
                                                "sense_id": "1468de8a-b345-38c9-b626-1f9857c4b134",
                                                "text": "Misteln leben als Schmarotzer auf Bäumen."
                                            },
                                            {
                                                "example_id": "62cb2a10-55d9-4acb-a808-64db93137514",
                                                "sense_id": "1468de8a-b345-38c9-b626-1f9857c4b134",
                                                "text": "„Auch die Vanille-Orchideen wachsen als schlingende Schmarotzer in der Luft, während Zimt sich als dünne Rindenschicht von den Stämmen des Zimtbaums abschälen lässt, prompt in seine bekannte Form zusammenrollt und schon leicht typisch riecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c294e945-10a3-4321-9b2b-51ff9cc2913a",
                        "source_entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "source_sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                        "target_lang_word": "scrounger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrounger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcbb55e-9fe7-336e-b3a6-c2addbb48d22",
                                        "entry_id": "5d00a376-9305-3aab-b3fe-a521ca17f462",
                                        "glosses": [
                                            "One who scrounges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692fa9a0-fe06-4f12-80a7-53277920170a",
                                                "sense_id": "9dcbb55e-9fe7-336e-b3a6-c2addbb48d22",
                                                "text": "You get out of me kitchen, you low-down scrounger! I ain't going to have you in here, giving me cheek to me face and drinkin' beer I got to pay for."
                                            },
                                            {
                                                "example_id": "87237919-1cdd-417f-8aa2-ecd4b120e465",
                                                "sense_id": "9dcbb55e-9fe7-336e-b3a6-c2addbb48d22",
                                                "text": "For a mad two hours, artists, critics, hangers-on, insiders, befuddled outsiders and outright scroungers mingle, collide, preen, dish, fawn, toady, snub and, as a last resort, take a fleeting glance at the art on the wall."
                                            },
                                            {
                                                "example_id": "4f5bcf80-5e30-4a2b-8e40-c6a59e51d1c9",
                                                "sense_id": "9dcbb55e-9fe7-336e-b3a6-c2addbb48d22",
                                                "text": "Elwood seems at first a typical army scrounger and lurkman with his latest model Mercedes and every creature comfort but he is a ruthless and greedy drug pedlar."
                                            },
                                            {
                                                "example_id": "6841d3c2-86c2-4b45-b075-e4e0061e4b6f",
                                                "sense_id": "9dcbb55e-9fe7-336e-b3a6-c2addbb48d22",
                                                "text": "Harbert was our dog robber (scrounger), had been since he joined the outfit in Guadalcanal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45c4e51b-8d09-4182-ae2a-49f4627ace13",
                        "source_entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                        "source_sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
