                "senses": [
                    {
                        "sense_id": "88e4e45a-0419-31f8-ac15-b42bdc26ac49",
                        "entry_id": "17e165e3-9b6d-3965-b917-7652a14e5335",
                        "glosses": [
                            "künstlicher Wasserweg vom Mittelmeer zum Roten Meer über die nur 113 km breite Landenge von Suez"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140cbd9f-377c-49e4-932d-025b7c631e6c",
                                "sense_id": "88e4e45a-0419-31f8-ac15-b42bdc26ac49",
                                "text": "Um vom Mittelmeer in das Rote Meer zu gelangen, müssen die Schiffe durch den Suezkanal fahren."
                            },
                            {
                                "example_id": "1257c444-28e0-4fc2-84f2-d667515a4f48",
                                "sense_id": "88e4e45a-0419-31f8-ac15-b42bdc26ac49",
                                "text": "„Ich könnte meinen Leuten befehlen, den Suezkanal zu überqueren und in Richtung Kairo weiterzufahren.“"
                            },
                            {
                                "example_id": "47c57907-b5da-4c30-9ef5-19823b3bac52",
                                "sense_id": "88e4e45a-0419-31f8-ac15-b42bdc26ac49",
                                "text": "„Die Hitze lag wie flüssiges Blei über dem Suezkanal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
