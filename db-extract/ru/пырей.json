                    {
                        "translation_id": "dd08b2cf-89b0-4ebe-90b3-b544870e85cb",
                        "source_entry_id": "f1e8d2dc-4216-3ef9-ac9b-a56024353a95",
                        "source_sense_id": "804bfb8f-6581-32d7-aa50-94c3b0b79f17",
