                "senses": [
                    {
                        "sense_id": "e2d2c48f-0979-379f-8f5c-f1e2e5680319",
                        "entry_id": "8357771d-4c49-3a4c-bb5f-4ccda24a0b2e",
                        "glosses": [
                            "Fleischgericht aus dem Rücken eines jungen Schweines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33559b59-5164-4908-b075-09b1d7cf1399",
                                "sense_id": "e2d2c48f-0979-379f-8f5c-f1e2e5680319",
                                "text": "„Das Restaurant hat einen lieblichen Hofgarten, die Küche ist wunderbar, mittags gibt es ein Menü (Gurken-Joghurt-Suppe, Jungschweinrücken mit Pak Choi und Süßkartoffelpüree) für 7,50 Euro; ein Wasser kostet zwei Euro.“"
                            },
                            {
                                "example_id": "3454d8a2-1696-4511-bb48-682ce4bac1bc",
                                "sense_id": "e2d2c48f-0979-379f-8f5c-f1e2e5680319",
                                "text": "„In einer Ecke servieren weiß geschürzte Köche gefüllten Jungschweinrücken und Basilikum-Risotto.“"
                            },
                            {
                                "example_id": "fcb9de11-7cb4-455b-ba62-bb88eca4b256",
                                "sense_id": "e2d2c48f-0979-379f-8f5c-f1e2e5680319",
                                "text": "„Mit dem ersten Biss durch die rösche Hülle und das saftige Fleisch vom Jungschweinrücken breitet sich wohliges Behagen aus – und mit ihm die Erkenntnis, dass nur ein absolut frisch zubereitetes Schnitzel hohen Genuss gewährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
