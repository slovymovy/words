                "senses": [
                    {
                        "sense_id": "6c0b918c-baef-3b98-8d96-fc7dd1b860a1",
                        "entry_id": "732b8289-a8ec-36cd-a829-0604fc9f54a5",
                        "glosses": [
                            "Convertir à l’iPhone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e2682c-d2bb-4706-ae07-ad22970f8b0d",
                                "sense_id": "6c0b918c-baef-3b98-8d96-fc7dd1b860a1",
                                "text": "Le méga-citadin se laisse transporter, embarquer, distraire, divertir, alcooliser, i-phoniser... exploiter..."
                            },
                            {
                                "example_id": "26beb53b-4aa1-4097-9599-f66a15348a75",
                                "sense_id": "6c0b918c-baef-3b98-8d96-fc7dd1b860a1",
                                "text": "I-phonisée. Et oui, je me suis trouvée une nouvelle passion et non des moindres."
                            },
                            {
                                "example_id": "586080d1-789a-414b-ab7e-2466eec7c55f",
                                "sense_id": "6c0b918c-baef-3b98-8d96-fc7dd1b860a1",
                                "text": "D'ailleurs, si la civilisation actuelle, informatisée, numérisée, i-phonisée, bloggisée, facebookée, twitterisée, internetisée... disparaissait par \"accident général\"... Il faudrait bien alors revenir autant que possible à la diffusion de l'écrit selon les modes, techniques et procédures qui furent celles des siècles passés..."
                            }
                        ]
                    }
