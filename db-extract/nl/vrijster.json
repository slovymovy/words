                ],
                "senses": [
                    {
                        "sense_id": "af116fe6-9cd7-3258-91c3-e41bb1e001a4",
                        "entry_id": "36d021a5-c05b-3306-85e1-f0e92090471c",
                        "glosses": [
                            "ongetrouwde vrouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c9cee1-db27-4355-9bb1-25e95c3563c6",
                                "sense_id": "af116fe6-9cd7-3258-91c3-e41bb1e001a4",
                                "text": "De oude vrijster was altijd chagrijnig."
                            },
                            {
                                "example_id": "7a1ece6a-7abd-49bb-afb6-e76e9f1c8ad5",
                                "sense_id": "af116fe6-9cd7-3258-91c3-e41bb1e001a4",
                                "text": "De ziel is Weldra, het adoptiekind van juffrouw van Aerden. Zij was oorspronkelijk een weesmeisje uit een Londense achterbuurt en droeg een andere naam, maar werd door haar pleegmoeder herdoopt tot ‘Weldra de Winnenbergh’, een onwaarschijnlijke naam die de vrijster als bij ingeving voor haar bedacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "804bc038-3f94-3e08-9acd-531932daadb0",
                        "entry_id": "36d021a5-c05b-3306-85e1-f0e92090471c",
                        "glosses": [
                            "beminde of minnende vrouw die nog niet getrouwd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d8864c-1e3e-475c-bace-e2b57eb8181c",
                                "sense_id": "804bc038-3f94-3e08-9acd-531932daadb0",
                                "text": "Acanthus toont een felgekleurde populaire gravure uit circa 1680, met als thema `de vrijstersboom'. Op deze amusante volksprent staat een groep smachtende vrouwen onder een pereboom die beladen is met aantrekkelijke mannen. `Dit zijn de peeren die vrijsters begeeren,' meldt het onderschrift."
                            }
                        ]
                    },
                    {
                        "sense_id": "fabbcb77-d62b-3b10-bd61-dabd63d8d336",
                        "entry_id": "36d021a5-c05b-3306-85e1-f0e92090471c",
                        "glosses": [
                            "speculaaspop die een ongetrouwde vrouw voorstelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92001b9-7614-47bf-a66b-ce4ba2510eee",
                                "sense_id": "fabbcb77-d62b-3b10-bd61-dabd63d8d336",
                                "text": "Dit verschijnsel komt nog steeds voor en verwijst naar een zeventiende-eeuws gebruik bij verliefde jongeren om een (soms heimelijk) aanbeden meisje of jongeman met Sinterklaas een vrijer/vrijster van speculaas te geven als gebaar van grote genegenheid."
                            }
                        ]
                    }
