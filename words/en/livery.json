{
    "word_family": [
        "liver",
        "liverish",
        "liveryman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ac08687-374b-3646-bbad-ea1803648384",
                    "sense_definition": "The specific paint scheme or design on a vehicle or a fleet of vehicles, often used for branding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "branding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline's new <w>livery</w> received a mixed reaction from the press.",
                            "target_lang_translations": {
                                "ru": "Новая <w>ливрея</w> авиакомпании вызвала неоднозначную реакцию в прессе."
                            }
                        },
                        {
                            "text": "The company decided to update its <w>corporate</w> <w>livery</w> to look more modern.",
                            "target_lang_translations": {
                                "ru": "Компания решила обновить свой <w>фирменный стиль</w>, чтобы выглядеть более современно."
                            }
                        }
                    ],
                    "synonyms": [
                        "branding",
                        "colors"
                    ],
                    "common_phrases": [
                        "corporate livery",
                        "airline livery",
                        "standard livery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая схема окраски или дизайн транспортного средства или парка машин, часто используемые для брендинга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливрея",
                                "target_lang_sense_clarification": "авиационный или транспортный жаргон"
                            },
                            {
                                "target_lang_word": "раскраска",
                                "target_lang_sense_clarification": "фирменный стиль оформления"
                            },
                            {
                                "target_lang_word": "цветовая схема",
                                "target_lang_sense_clarification": "дизайн бренда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                    "sense_definition": "A distinctive uniform worn by male servants, chauffeurs, or members of a specific group or guild.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The footmen were dressed in <w>full</w> <w>livery</w> for the royal banquet.",
                            "target_lang_translations": {
                                "ru": "Лакеи были одеты в парадные <w>ливреи</w> для королевского банкета."
                            }
                        },
                        {
                            "text": "By wearing <w>livery</w>, the brewers publicly expressed guild association and solidarity.",
                            "target_lang_translations": {
                                "ru": "Нося <w>форменную одежду</w>, пивовары публично выражали свою принадлежность к гильдии и солидарность."
                            }
                        }
                    ],
                    "synonyms": [
                        "uniform",
                        "regalia"
                    ],
                    "common_phrases": [
                        "full livery",
                        "servant livery"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often refers to historical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличительная форменная одежда, которую носят слуги мужского пола, шоферы или члены определенных гильдий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливрея",
                                "target_lang_sense_clarification": "форменная одежда слуг"
                            },
                            {
                                "target_lang_word": "обмундирование",
                                "target_lang_sense_clarification": "официальная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1927e9ed-f8f6-39b0-9313-36de4dc4b4cf",
                    "sense_definition": "A stable where horses are kept for a fee or where they can be hired.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "equestrian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept his horse at a local <w>livery</w> <w>stable</w> because he had no land of his own.",
                            "target_lang_translations": {
                                "ru": "Он держал лошадь в местной <w>платной конюшне</w>, так как у него не было собственной земли."
                            }
                        },
                        {
                            "text": "The town had a large <w>livery</w> where travelers could rent carriages.",
                            "target_lang_translations": {
                                "ru": "В городе был большой <w>прокат экипажей</w>, где путешественники могли арендовать повозки."
                            }
                        }
                    ],
                    "synonyms": [
                        "stable"
                    ],
                    "common_phrases": [
                        "livery stable",
                        "stand at livery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конюшня, где лошади содержатся за плату или где их можно взять напрокат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платная конюшня",
                                "target_lang_sense_clarification": "содержание лошадей"
                            },
                            {
                                "target_lang_word": "постой",
                                "target_lang_sense_clarification": "содержание лошади на чужой конюшне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfbd96f2-5ddd-39eb-b9cc-ed38d8b53e2a",
                    "sense_definition": "A vehicle for hire, such as a taxicab or limousine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city regulations for <w>livery</w> vehicles are different from those for private cars.",
                            "target_lang_translations": {
                                "ru": "Городские правила для <w>наемных автомобилей</w> отличаются от правил для частных машин."
                            }
                        },
                        {
                            "text": "He called a <w>livery</w> service to take him to the airport.",
                            "target_lang_translations": {
                                "ru": "Он вызвал <w>службу такси</w>, чтобы доехать до аэропорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "cab",
                        "taxi"
                    ],
                    "common_phrases": [
                        "livery vehicle",
                        "livery service"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство для найма, такое как такси или лимузин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наемный экипаж",
                                "target_lang_sense_clarification": "транспорт для найма"
                            },
                            {
                                "target_lang_word": "такси",
                                "target_lang_sense_clarification": "автомобиль с водителем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fae4eeca-a836-3374-9504-a3c98acd3153",
                    "sense_definition": "The legal delivery of property into the possession of a new owner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained the process of <w>livery</w> of seisin to the heirs.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил наследникам процесс <w>ввода во владение</w> недвижимостью."
                            }
                        },
                        {
                            "text": "The transfer was finalized upon the formal <w>livery</w> of the keys.",
                            "target_lang_translations": {
                                "ru": "Передача была завершена после формального <w>вручения</w> ключей."
                            }
                        }
                    ],
                    "synonyms": [
                        "delivery",
                        "transfer"
                    ],
                    "common_phrases": [
                        "livery of seisin"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "legal historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая передача собственности во владение новому владельцу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввод во владение",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "имущества"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5e5d208-a3ee-3292-9f69-62deb202101f",
                    "sense_definition": "Resembling or having the taste or color of <w>liver</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meat had a strong <w>livery</w> flavor that some guests found unappealing.",
                            "target_lang_translations": {
                                "ru": "У мяса был сильный <w>печеночный</w> привкус, который некоторым гостям показался неприятным."
                            }
                        },
                        {
                            "text": "The sauce was a dark, <w>livery</w> brown color.",
                            "target_lang_translations": {
                                "ru": "Соус был темно-коричневого, <w>печеночного</w> цвета."
                            }
                        }
                    ],
                    "synonyms": [
                        "liverish"
                    ],
                    "common_phrases": [
                        "livery flavor",
                        "livery taste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий печень или имеющий вкус или цвет печени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печеночный",
                                "target_lang_sense_clarification": "вкус или цвет"
                            },
                            {
                                "target_lang_word": "темно-коричневый",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                    "sense_definition": "Feeling ill or irritable, as if suffering from a liver disorder; queasy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He woke up feeling <w>livery</w> after the heavy meal the night before.",
                            "target_lang_translations": {
                                "ru": "Он проснулся с <w>тошнотой</w> после тяжелого ужина накануне вечером."
                            }
                        },
                        {
                            "text": "The patient complained of a <w>livery</w> feeling and general fatigue.",
                            "target_lang_translations": {
                                "ru": "Пациент жаловался на <w>недомогание</w> и общую усталость."
                            }
                        }
                    ],
                    "synonyms": [
                        "bilious",
                        "liverish",
                        "queasy"
                    ],
                    "antonyms": [
                        "healthy"
                    ],
                    "common_phrases": [
                        "feeling livery"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохое самочувствие или раздражительность, как при заболевании печени; тошнота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желчный",
                                "target_lang_sense_clarification": "раздражительный"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "из-за проблем с печенью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "261f1822-3b4a-3df2-aafc-cd7dee43a09e",
                    "sense_definition": "To dress or clothe someone in a <w>livery</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>liveried</w> his servants in the most modest of clothing.",
                            "target_lang_translations": {
                                "ru": "Он <w>одел</w> своих слуг в самую скромную одежду."
                            }
                        },
                        {
                            "text": "The staff were <w>liveried</w> in gold and blue for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Персонал был <w>облачен в ливреи</w> золотого и синего цветов для церемонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothe",
                        "attire",
                        "dress"
                    ],
                    "antonyms": [
                        "undress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать кого-либо в ливрею."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачать в ливрею",
                                "target_lang_sense_clarification": "одевать слуг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}