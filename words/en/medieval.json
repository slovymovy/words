        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65060ff9-b58e-37ee-b59c-c0d81c6740d9",
                    "sense_definition": "Someone living in the Middle Ages.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>medievals</w> had a very different understanding of the universe than we do.",
                            "target_lang_translations": {
                                "ru": "<w>Люди Средневековья</w> имели совсем иное представление о вселенной, чем мы.",
                                "zh": "<w>中世纪人</w>对宇宙的理解与我们大不相同。",
                                "es": "Los <w>habitantes de la Edad Media</w> tenían una comprensión del universo muy diferente a la nuestra.",
                                "tr": "<w>Orta çağ insanları</w> evrene dair bizden çok farklı bir anlayışa sahipti.",
                                "de": "Die <w>Menschen des Mittelalters</w> hatten ein ganz anderes Verständnis vom Universum als wir."
                            }
                        },
                        {
                            "text": "Life for the <w>medievals</w> was often short and full of hardship.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>людей Средневековья</w> часто была короткой и полной лишений.",
                                "zh": "<w>中世纪人</w>的生活往往短暂且充满苦难。",
                                "es": "La vida para los <w>habitantes de la Edad Media</w> era a menudo corta y llena de dificultades.",
                                "tr": "<w>Orta çağ insanları</w> için hayat genellikle kısa ve zorluklarla doluydu.",
                                "de": "Das Leben für die <w>Menschen des Mittelalters</w> war oft kurz und voller Entbehrungen."
                            }
                        }
                    ],
                    "antonyms": [
                        "moderns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живший в эпоху Средневековья.",
                        "zh": "生活在中世纪的人。",
                        "es": "Persona que vivió durante la Edad Media.",
                        "tr": "Orta Çağ'da yaşamış olan kimse.",
                        "de": "Jemand, der im Mittelalter lebte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек Средневековья",
                                "target_lang_sense_clarification": "житель той эпохи"
