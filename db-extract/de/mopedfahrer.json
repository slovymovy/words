                ],
                "senses": [
                    {
                        "sense_id": "7cced98e-67bf-3bef-996a-0e9816d6c7cd",
                        "entry_id": "d6886e53-1af0-3fcc-b7b7-94507477caf8",
                        "glosses": [
                            "jemand, der auf einem Moped fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b2bdb3-6edb-40c2-9608-caad5efbaa9c",
                                "sense_id": "7cced98e-67bf-3bef-996a-0e9816d6c7cd",
                                "text": "Der Mopedfahrer flüchtete vom Unfallort."
                            },
                            {
                                "example_id": "2e1daa77-85ec-4cc1-ad97-a15a98436665",
                                "sense_id": "7cced98e-67bf-3bef-996a-0e9816d6c7cd",
                                "text": "„Sie beide nähmen Ohrstöpsel, wegen eines wahnsinnigen Mopedfahrers, der bereits seit Langem, meist an den Wochenenden, kurz vor oder nach Mitternacht mit einem offenbar frisierten Kleinmotorrad mit Höllenlärm handabstand dicht an ihrem Haus vorbeirase und sie, die Einwohner terrorisiere.“"
                            },
                            {
                                "example_id": "7eb59e32-eb95-4d60-80e5-147c5f7ab86d",
                                "sense_id": "7cced98e-67bf-3bef-996a-0e9816d6c7cd",
                                "text": "„Ein Porschefahrer sieht im Rückspiegel einen Mopedfahrer, der gerade überholen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
