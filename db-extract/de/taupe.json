                            {
                                "example_id": "c762e2fd-b60d-49ed-a64f-d881e8cc0888",
                                "sense_id": "e097cf4b-b2cf-370f-82a5-8b71e2b67e50",
                                "text": "Eine beliebte Farbe, die oft als Basisfarbe verwendet wird, ist Taupe."
                            },
                            {
                                "example_id": "07b1832d-bc65-4bc2-af6e-de8e57ad9ce3",
                                "sense_id": "e097cf4b-b2cf-370f-82a5-8b71e2b67e50",
                                "text": "Taupe ist eine sehr schöne Farbe, die sowohl zu hellen als auch zu dunklen Farben passt."
                            },
                            {
                                "example_id": "3153a770-6ee8-4cc8-81aa-0a54081d89e1",
                                "sense_id": "e097cf4b-b2cf-370f-82a5-8b71e2b67e50",
                                "text": "Taupe wird gerne als neutrale Farbe bezeichnet, welche unzählige Möglichkeiten bietet, andere Farben ins Spiel zu bringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
