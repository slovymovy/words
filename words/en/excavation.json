{
    "word_family": [
        "excavate",
        "excavator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a74a6569-4a18-368f-831f-a692a206ce79",
                    "sense_definition": "The systematic process of digging to uncover historical buildings, tombs, or artifacts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "archaeology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team began an <w>excavation</w> of the ancient temple site last summer.",
                            "target_lang_translations": {
                                "zh": "团队去年夏天开始对古庙遗址进行<w>发掘</w>。"
                            }
                        },
                        {
                            "text": "Many important artifacts were found during the <w>archaeological</w> <w>excavation</w>.",
                            "target_lang_translations": {
                                "zh": "在这次考古<w>发掘</w>中发现了许多重要文物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dig"
                    ],
                    "common_phrases": [
                        "archaeological excavation"
                    ],
                    "target_lang_definitions": {
                        "zh": "对历史建筑、墓葬或文物进行系统性挖掘的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发掘",
                                "target_lang_sense_clarification": "指考古学中科学的挖掘过程。"
                            },
                            {
                                "target_lang_word": "考古挖掘",
                                "target_lang_sense_clarification": "特指考古领域的挖掘活动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1f818d5-c760-3c6b-bfa3-6acf2b8309f8",
                    "sense_definition": "A specific location where archaeological research or digging is currently taking place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "archaeology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students visited the <w>excavation</w> to learn about local history.",
                            "target_lang_translations": {
                                "zh": "学生们参观了<w>发掘现场</w>以了解当地历史。"
                            }
                        },
                        {
                            "text": "Security is tight at the <w>excavation</w> to protect the fragile findings.",
                            "target_lang_translations": {
                                "zh": "<w>发掘现场</w>安保严密，以保护脆弱的发现物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dig site"
                    ],
                    "common_phrases": [
                        "visit the excavation"
                    ],
                    "target_lang_definitions": {
                        "zh": "正在进行考古研究或挖掘的具体地点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发掘现场",
                                "target_lang_sense_clarification": "指正在进行考古工作的具体地点。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b86009a6-3acb-37eb-bcb7-b926d2a809a3",
                    "sense_definition": "The process of digging holes in the ground for construction purposes like foundations or roads.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>excavation</w> for the new skyscraper foundation will take several weeks.",
                            "target_lang_translations": {
                                "zh": "新摩天大楼地基的<w>开挖</w>工作将持续数周。"
                            }
                        },
                        {
                            "text": "Heavy machinery is required for the deep <w>excavation</w> of the site.",
                            "target_lang_translations": {
                                "zh": "该场地的深层<w>开挖</w>需要重型机械。"
                            }
                        }
                    ],
                    "synonyms": [
                        "digging"
                    ],
                    "common_phrases": [
                        "site excavation"
                    ],
                    "target_lang_definitions": {
                        "zh": "为建筑基础或道路等工程目的而在地面挖坑的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "开挖",
                                "target_lang_sense_clarification": "指工程建设中的挖掘作业。"
                            },
                            {
                                "target_lang_word": "土方工程",
                                "target_lang_sense_clarification": "指建筑施工中涉及挖掘的工程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33d01032-c6f4-3e10-bd2b-ec530e3ebc47",
                    "sense_definition": "A large hole or cavity in the ground created by digging or natural forces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive <w>excavation</w> filled with water after the heavy rainstorm.",
                            "target_lang_translations": {
                                "zh": "暴雨过后，巨大的<w>坑洞</w>里积满了水。"
                            }
                        },
                        {
                            "text": "Workers fenced off the deep <w>excavation</w> to prevent accidents.",
                            "target_lang_translations": {
                                "zh": "工人们用围栏围住了深<w>坑洞</w>以防事故发生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pit",
                        "cavity"
                    ],
                    "common_phrases": [
                        "deep excavation"
                    ],
                    "target_lang_definitions": {
                        "zh": "因挖掘或自然力量在地面上形成的巨大坑洞或空腔。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坑洞",
                                "target_lang_sense_clarification": "指挖掘后留下的深坑。"
                            },
                            {
                                "target_lang_word": "基坑",
                                "target_lang_sense_clarification": "特指建筑施工中挖出的深坑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d656ca0f-e4d3-3df3-9737-91c3e9404134",
                    "sense_definition": "The act of uncovering or revealing something hidden, such as talent or information.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book is an <w>excavation</w> of the author's long-forgotten childhood memories.",
                            "target_lang_translations": {
                                "zh": "这本书是对作者早已遗忘的童年记忆的<w>发掘</w>。"
                            }
                        },
                        {
                            "text": "The research required an <w>excavation</w> of complex social theories.",
                            "target_lang_translations": {
                                "zh": "这项研究需要对复杂的社会理论进行深入<w>发掘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unearthing",
                        "revelation"
                    ],
                    "target_lang_definitions": {
                        "zh": "揭示或发现隐藏事物（如才能或信息）的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发掘",
                                "target_lang_sense_clarification": "比喻性用法，指深入探究并揭示隐藏的内容。"
                            },
                            {
                                "target_lang_word": "挖掘",
                                "target_lang_sense_clarification": "比喻性用法，指深入探索。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}