                    {
                        "sense_id": "72d7ecd0-4773-3844-811d-5efe2128726b",
                        "entry_id": "d9611643-57fc-3489-8019-a9e176a8544e",
                        "glosses": [
                            "onvoltooid deelwoord van gapen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3cd082f2-da29-4677-8438-f08ccb8db5a3",
                                "sense_id": "72d7ecd0-4773-3844-811d-5efe2128726b",
                                "text": "Dommel herken je meteen. Hij verveelt zich, staart uit het raam en verstopt zich gapend in het midden van de groep. Dommel is rationeel, logisch en leert het beste door te doen. Dommel beschikt ook over een rijke fantasie."
                            }
                        ]
                    }
