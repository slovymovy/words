                                        "sense_id": "a703a0d0-30e7-3f26-a840-eee3f1a9ebc7",
                                        "entry_id": "40e86b30-b837-3199-86e7-fea7483abfce",
                                        "glosses": [
                                            "zegar określający czas na podstawie pozycji słońca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c15d495-8cae-409e-b90d-b0afa295b749",
                                                "sense_id": "a703a0d0-30e7-3f26-a840-eee3f1a9ebc7",
                                                "text": "Zegar słoneczny rozpowszechnił się w latach 604-606 po wydaniu przez papieża Sabinianusa nakazu umieszczania zegarów słonecznych na dachu każdego kościoła."
                                            },
                                            {
                                                "example_id": "547529c6-877f-4fbe-b451-3ffd9523aa4e",
                                                "sense_id": "a703a0d0-30e7-3f26-a840-eee3f1a9ebc7",
                                                "text": "Czy wiesz kto jest inicjatorem powstania, współautorem projektu i wykonawcą nowego zegara słonecznego w Tychach?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
