                "senses": [
                    {
                        "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                        "entry_id": "2f2f77c4-a832-3c61-9ad5-3ef436cc67d0",
                        "glosses": [
                            "Linguistik: ein Wort, Satz oder Ausdruck, der rückwärts gelesen eine andere (sinnvolle) Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f218b6-d377-45bf-bc38-92e5d3a07769",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "Mordnilaps im Deutschen sind zum Beispiel „Nebel“ – „Leben“."
                            },
                            {
                                "example_id": "039b7e8b-ab2c-4462-899f-0fb834b6b6b9",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "Sowohl „Mordnilap“ selbst als auch „Palindrom“ sind Mordnilaps (voneinander)."
                            },
                            {
                                "example_id": "01a7bb66-1fb7-46e2-9349-8295de6d5ca0",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "Das längste Wort im Englischen, das ein Mordnilap ist, ist „stressed“ – „desserts“ (neben „Mordnilap“ selbst)."
                            },
                            {
                                "example_id": "f0f84c53-f3e0-4ea8-ab73-32ee19a86702",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "Ein Satz als Mordnilap ist zum Beispiel „Die Liebe ist Sieger“ – „rege ist sie bei Leid“."
                            },
                            {
                                "example_id": "a3da3b09-477f-49f6-8020-5195ebacbbbb",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "„Mordnilap » Wissen Sie, was ein Mordnilap ist? Wenn nicht, brauchen Sie nicht im Lexikon oder Fremdwörterbuch nachzusehen. Es ist dort nicht zu finden. Natürlich ist das kein Beweis gegen die Existenz des Wortes Mordnilap.“"
                            },
                            {
                                "example_id": "b3d5cbd4-5442-4d7d-ac0f-0aeee2e3559e",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "„Dog ist ein gängiges Mordnilap von God (Mordnilap ist Palindrom rückwärts gelesen und bezeichnet ein Wort, das rückwärts gelesen ein anderes ergibt, wie live – evil : also ist Mordnilap selbst ein Mordnilap, aber Palindrom auch, oder?“"
                            },
                            {
                                "example_id": "0f72a677-7d70-4302-8bcb-b17dd4622806",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "„„Mordnilap“ („Palindrom“ rückwärts geschrieben) ist ein Wort, das bei der Umkehr einen anderen Sinn bekommt: Ton – Not“"
                            },
                            {
                                "example_id": "504a7133-29f6-4c30-8544-ebce286da67e",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "„Palindrom (um auch das zu verraten) ist griechischer Herkunft – pálin: zurück + drómos: der Lauf. Palindromiert würde es Mordnilap lauten.“"
                            },
                            {
                                "example_id": "49b57b50-5400-46a7-98e2-e99a4f9d7200",
                                "sense_id": "12b8f3ca-f204-35a1-8cca-c35d901945f1",
                                "text": "„Mordnilap (Gardner) findet man vor allem die Bezeichnungen reversible oder recurrent palindrome für Gebilde wie trap und emit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
