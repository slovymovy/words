                        "examples": [
                            {
                                "example_id": "733f0079-2165-4d93-b799-f197716a60f3",
                                "sense_id": "66c8edb9-ba2d-34d7-bec2-cfdaa90dd11d",
                                "text": "De entree van Balk in het betaald voetbal, eind september, had veel weg van een jongensboek. Zo werd dat in ieder geval beleefd in Zuidhorn, het dorp waar zijn roots liggen."
                            },
                            {
                                "example_id": "052ca0ed-b591-4c15-a9d3-08b8c766afa2",
                                "sense_id": "66c8edb9-ba2d-34d7-bec2-cfdaa90dd11d",
                                "text": "Ajax-trainer Erik ten Hag betreurt het vertrek van Frenkie de Jong naar Barcelona, maar vindt het tegelijkertijd 'geweldig' voor de middenvelder. \"Dit is een jongensboek.\""
                            }
                        ]
