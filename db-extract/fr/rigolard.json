                        "tags": [
                            "feminine"
                        ],
                        "form": "rigolarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19d8c7d0-d5be-31d4-81bc-549da9b5fdbd",
                        "entry_id": "076b783a-7305-39b7-ab78-dd56534c55b3",
                        "glosses": [
                            "Celui qui rigole ou aime rigoler."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e6a52a2e-aeae-4790-89eb-2acfc1a80515",
                                "sense_id": "19d8c7d0-d5be-31d4-81bc-549da9b5fdbd",
                                "text": "Vous, vous êtes un petit rigolard, me dit le juteux, trois jours de mitard, ça vous fera passer l’envie de rigoler !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2241957b-2f32-4d91-8a05-b1ca19f336ad",
                        "source_entry_id": "076b783a-7305-39b7-ab78-dd56534c55b3",
                        "source_sense_id": "19d8c7d0-d5be-31d4-81bc-549da9b5fdbd",
                        "target_lang_word": "Spaßvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaßvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                        "entry_id": "a68bf340-89b9-395a-9c7d-d61d0742797e",
                                        "glosses": [
                                            "jemand, der mit seinen lustigen Einfällen und Späßen andere gerne erheitert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b30a63-fc8e-4687-8b1e-0d0e5f1da6a5",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "Das närrische Treiben nimmt bekannterweise am Faschingsdienstag sein Ende. Für manch einen Spaßvogel ist dies Anlass Genug, um noch einmal so richtig auf den Putz zu hauen und die Zeit vor dem großen Fasten mit einem lustigen „Scherzchen“ abzuschließen."
                                            },
                                            {
                                                "example_id": "58e68a42-e326-4c83-a7dd-39937fceaf2f",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "Denn als sich die Medienwelt schon darauf eingestellt hatte, Hape Kerkeling, 47, werde Gottschalk beerben, sagte der Spaßvogel Anfang November \"nein\"."
                                            },
                                            {
                                                "example_id": "b30c6651-5ebc-4dcb-bfdc-dffcd88b60a3",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "Jetzt hat sie 1,8 Prozent in Berlin bekommen. Spaßvögel könnten jetzt auf die Idee kommen, die alten 18-Plakate auszugraben und nur um das Komma zu ergänzen."
                                            },
                                            {
                                                "example_id": "f0e65ed4-8341-4dd2-ae36-9f1fd73ff17b",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "Zum Vollsprechen eines Anrufbeantworters mit Wutanrufen haben Spaßvögel inzwischen sogar ein Verb erfunden: wulffen lautet es."
                                            },
                                            {
                                                "example_id": "d64f675e-3b70-4e6f-969e-a95fb23f8575",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "Endgültig zur Überzeugung von der Unsterblichkeit des Grafen verdichtet sich solche Rede, als in Paris ein Spaßvogel auftritt, der sich selbst für Saint-Germain ausgibt und mit gehörigem Ernst erklärt, ein Freund von Jesus Christus gewesen zu sein, die Heilige Jungfrau Maria gekannt und am Konzil zu Nicäa teilgenommen zu haben."
                                            },
                                            {
                                                "example_id": "b3a7b1e6-c2ac-4ec2-935f-c900f64a37fa",
                                                "sense_id": "83f7d718-863a-30cc-9823-664d3d39c96f",
                                                "text": "„Er [Sepp Maier] gibt den Spaßvogel und bleibt gleichzeitig ein Freund der klaren Worte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
