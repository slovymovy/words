                    "sense_id": "03265a94-1fff-31ec-ace5-81b4baa1b339",
                    "sense_definition": "sprawność ruchowa, zwinność i precyzja w wykonywaniu czynności fizycznych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sprawność fizyczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iluzjonista popisał się niezwykłą <w>zręcznością</w> palców podczas pokazu z kartami.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист продемонстрировал необычайную <w>ловкость</w> пальцев во время карточного фокуса."
                            }
                        },
                        {
                            "text": "Praca chirurga wymaga ogromnej precyzji oraz wyjątkowej <w>zręczności</w> manualnej.",
                            "target_lang_translations": {
                                "ru": "Работа хирурга требует огромной точности и исключительной ручной <w>ловкости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprawność"
                    ],
                    "antonyms": [
                        "niezręczność"
                    ],
                    "common_phrases": [
                        "zręczność manualna",
                        "zręczność palców",
                        "wykazać się zręcznością"
                    ],
                    "target_lang_definitions": {
                        "ru": "двигательная сноровка, ловкость и точность в выполнении физических действий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкость",
                                "target_lang_sense_clarification": "физическая сноровка, быстрота и точность движений"
                            },
                            {
                                "target_lang_word": "сноровка",
                                "target_lang_sense_clarification": "умение, навык в физической работе"
                            },
                            {
                                "target_lang_word": "проворство",
                                "target_lang_sense_clarification": "быстрота и гибкость в движениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1b187a5-73d4-362c-9049-dcffc450b0d3",
                    "sense_definition": "umiejętność radzenia sobie w trudnych sytuacjach życiowych lub towarzyskich, spryt i takt",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "umiejętność społeczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyplomata z wielką <w>zręcznością</w> wybrnął z niezręcznego pytania zadanego przez dziennikarza.",
                            "target_lang_translations": {
                                "ru": "Дипломат с большой <w>ловкостью</w> уклонился от неловкого вопроса, заданного журналистом."
                            }
                        },
                        {
                            "text": "Do rozwiązania tego wieloletniego konfliktu potrzebna była dyplomatyczna <w>zręczność</w>.",
                            "target_lang_translations": {
                                "ru": "Для разрешения этого многолетнего конфликта потребовалась дипломатическая <w>ловкость</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "niezręczność"
                    ],
                    "common_phrases": [
                        "zręczność dyplomatyczna"
                    ],
                    "target_lang_definitions": {
                        "ru": "умение находить выход из трудных жизненных или общественных ситуаций, сообразительность и такт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкость",
                                "target_lang_sense_clarification": "умение искусно выпутываться из ситуаций"
                            },
                            {
                                "target_lang_word": "изворотливость",
                                "target_lang_sense_clarification": "умение находить выход из сложного положения"
                            },
                            {
                                "target_lang_word": "искусность",
                                "target_lang_sense_clarification": "мастерство, дипломатичность в общении"
                            },
                            {
                                "target_lang_word": "тактичность",
                                "target_lang_sense_clarification": "умение вести себя деликатно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088a2596-654d-3276-b24a-62afd00ee484",
                    "sense_definition": "sprzyjająca okoliczność, dobra okazja",
