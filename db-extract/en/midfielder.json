                                            {
                                                "example_id": "ff27a1a7-e12d-4a9a-bfd2-3abc1ea349ff",
                                                "sense_id": "d98e6a79-527a-3be3-8dd5-78a7e003ed3b",
                                                "text": "Johan Cruijff speelde vaak als middenvelder."
                                            },
                                            {
                                                "example_id": "920f700e-a0db-459f-afdd-dc639c493e74",
                                                "sense_id": "d98e6a79-527a-3be3-8dd5-78a7e003ed3b",
                                                "text": "De middenvelder had al een lichte dijbeenblessure en hij zou eerst niet van start gaan in de bekerstrijd tegen Roma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70db7860-e626-476b-bf0d-9eb0ed9767ed",
                        "source_entry_id": "69d5c2e4-a910-36b9-b79b-125e405236ac",
                        "source_sense_id": "bc383fab-e932-342b-a0dd-05aaaf73fbe7",
