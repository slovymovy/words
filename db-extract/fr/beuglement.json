                        "entry_id": "f48fe9ce-86c8-3dbb-b1be-126b99dd91cb",
                        "glosses": [
                            "Cri des animaux de l’espèce bovine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3179443a-34d2-4fe3-a778-b30ddf7e34f1",
                                "sense_id": "1d2f2c91-7d36-30c9-81d3-477e6f835c75",
                                "text": "[…] et on n’entend jamais, en traversant un village, le beuglement d’une vache, le bêlement d’une brebis."
