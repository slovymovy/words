                "senses": [
                    {
                        "sense_id": "0b9fabc6-5eb1-3f24-8c93-de5bf115623c",
                        "entry_id": "ceb566c4-cd22-32f4-8b53-2fc9b28750d9",
                        "glosses": [
                            "морск. левый борт корабля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152751b5-5fc8-4c41-8f15-74fce64f3770",
                                "sense_id": "0b9fabc6-5eb1-3f24-8c93-de5bf115623c",
                                "text": "Паруса, туманно видимые из-за бакборта и выше бугшприта, полные неистовой силы шторма, валились всей громадой назад, чтобы, перейдя вал, выпрямиться, а затем, склоняясь над бездной, мчать судно к новым лавинам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49ada31c-8c96-49b2-bc98-8533d563e7db",
                        "source_entry_id": "ceb566c4-cd22-32f4-8b53-2fc9b28750d9",
                        "source_sense_id": "0b9fabc6-5eb1-3f24-8c93-de5bf115623c",
                        "target_lang_word": "port",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "port",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae48b27-5308-34ab-9bd5-913ad10a5ab7",
                                        "entry_id": "f6e9f268-ec2d-3a00-a0c9-cdef2eb3d797",
                                        "glosses": [
                                            "A place on the coast at which ships can shelter, or dock to load and unload cargo or passengers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d8cdd7-6de5-44b5-889e-f51dd3359e84",
                                                "sense_id": "3ae48b27-5308-34ab-9bd5-913ad10a5ab7",
                                                "text": "peering in maps for ports and piers and roads"
                                            },
                                            {
                                                "example_id": "85450566-2104-4845-9dbd-897901d07d00",
                                                "sense_id": "3ae48b27-5308-34ab-9bd5-913ad10a5ab7",
                                                "text": "From the ground, Colombo's port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e3295f7-493b-3b81-afdf-6de338de6726",
                                        "entry_id": "f6e9f268-ec2d-3a00-a0c9-cdef2eb3d797",
                                        "glosses": [
                                            "A town or city containing such a place, a port city."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a64476-f8b1-43bf-ae11-c38e9d9c05af",
                                                "sense_id": "5e3295f7-493b-3b81-afdf-6de338de6726",
                                                "text": "More broadly, the port is seen as a litmus test for France; if its most multicultural city can foster vast Muslim enclaves viewed with broad suspicion or hostility by the police, then what hope is there elsewhere?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e297e7-7af6-35ba-b42b-d37e9d033e40",
                                        "entry_id": "f6e9f268-ec2d-3a00-a0c9-cdef2eb3d797",
                                        "glosses": [
                                            "The left-hand side of a vessel, including aircraft, when one is facing the front. Used to unambiguously refer to directions relative to the vessel structure, rather than to a person or object on board."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d01080-d8bc-33aa-ae1f-d0cd3b0ed55c",
                                        "entry_id": "f6e9f268-ec2d-3a00-a0c9-cdef2eb3d797",
                                        "glosses": [
                                            "A sweep rower that primarily rows with an oar on the port side."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2123af2-25d2-4fe3-a37b-e9193168c04f",
                                                "sense_id": "b8d01080-d8bc-33aa-ae1f-d0cd3b0ed55c",
                                                "text": "Each eight has four ports and four starboards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
