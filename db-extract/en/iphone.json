                    {
                        "translation_id": "bde92188-bbce-47f3-9335-ab5c7bf28d32",
                        "source_entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                        "source_sense_description": "device",
                        "target_lang_word": "iPhone",
                        "target_lang_code": "fr",
