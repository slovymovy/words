                        "translation_id": "2858c541-f410-491f-a38e-19d5ea078d33",
                        "source_entry_id": "2a44b94d-9aa8-3874-9e9e-13e0f6721ab0",
                        "source_sense_id": "d84f0420-7edb-3147-b508-aa02c2d26138",
                        "target_lang_word": "выпердыш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "выпердыш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a75b49-be6b-3b08-80f8-34fe092987ba",
                                        "entry_id": "1fc1deb3-e470-3241-ad2f-4c5fb1f3107f",
                                        "glosses": [
                                            "пренебр., дисфм. ребёнок ( мужского пола), детёныш"
                                        ],
                                        "tags": [
                                            "преим."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37500770-313b-48b2-b591-f7235313ad36",
                                                "sense_id": "b5a75b49-be6b-3b08-80f8-34fe092987ba",
                                                "text": "— Ах, какие ревности! — приговаривала она, стряхивая его с колен, словно досадные крошки, или отталкивая от себя. — Сопли подотри, ишь ты, выпердыш."
                                            },
                                            {
                                                "example_id": "ebb58bf8-4379-47b6-b1e9-bb5aac2d840e",
                                                "sense_id": "b5a75b49-be6b-3b08-80f8-34fe092987ba",
                                                "text": "Оно превращает женщину в животное. Это когда самка, не раздумывая, перегрызёт горло десяти чужим детёнышам, чтобы жил её худосочный выпердыш. Вот вам ваше материнство!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
