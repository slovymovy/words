                        "examples": [
                            {
                                "example_id": "00c4bdd1-349d-486a-9e6d-014c68f3d008",
                                "sense_id": "a81a3334-998c-3709-883a-0ea3591392cf",
                                "text": "Het smerige is alleen dat ik niet kan volstaan met een verslag van zijn geboorte en de navolgende jeugdjaren."
                            },
                            {
                                "example_id": "b5251675-187d-4db9-811d-8d2e14bdc18a",
                                "sense_id": "a81a3334-998c-3709-883a-0ea3591392cf",
                                "text": "Zorgeloos voetballen, dat doet Ihattaren in zijn jeugdjaren op zijn pleintje aan de Adenauerlaan. Daar leert hij zijn trucjes. En net zo lief neemt hij later de tijd voor de jeugd, want rijzende ster van PSV of niet, hij verloochent zijn afkomst nooit."
                            }
                        ]
                    }
