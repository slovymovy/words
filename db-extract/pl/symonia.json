                                        "glosses": [
                                            "The act of persistently instigating lawsuits, often groundless ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b236c11-9fe7-480e-a633-99bec1195efe",
                                                "sense_id": "98fbaaf4-875d-366c-8751-794893eeb7c7",
                                                "text": "[Deacon Mushrat to Pogo:] The Machiavellian barratry of a pettifogging public has maundered into do-nothingism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dfdf5e1-eb45-3af1-8df5-ce97cce352c1",
                                        "entry_id": "d13f6dcf-7e42-3fca-8f3b-5254f29b4e50",
                                        "glosses": [
                                            "The sale or purchase of religious or political positions of power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bde8de7-4493-31a2-9384-f2bc68bf7848",
                                        "entry_id": "d13f6dcf-7e42-3fca-8f3b-5254f29b4e50",
                                        "glosses": [
