                                    {
                                        "sense_id": "5554360f-7158-374b-b197-71ba4232d712",
                                        "entry_id": "837f2907-b9e7-36f2-86d5-2384db48ae89",
                                        "glosses": [
                                            "Something mounted; an attachment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4943d990-0737-46ee-9fb7-e60d626ea9b1",
                                                "sense_id": "5554360f-7158-374b-b197-71ba4232d712",
                                                "text": "That particular plane must have hit an obstruction that ripped its undercarriage right off its mountings, to leave it suspended beneath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cde1afa-fa94-3cca-9aef-1b892377df84",
                                        "entry_id": "837f2907-b9e7-36f2-86d5-2384db48ae89",
                                        "glosses": [
                                            "The act of one who mounts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55632577-b078-4366-becc-4ded6d8a5939",
                                                "sense_id": "1cde1afa-fa94-3cca-9aef-1b892377df84",
                                                "text": "The stage we had now commenced was eighteen miles in length; but the frequent mountings and dismountings, to climb or to descend the rocky sides of the mountains, made it appear much longer."
                                            }
                                        ]
                                    }
                                ]
                            }
