                "senses": [
                    {
                        "sense_id": "50ffa63c-eafd-3b7d-9cc5-07fb0eca576b",
                        "entry_id": "6588111e-de85-3f89-bf5a-8ee8669c5f03",
                        "glosses": [
                            "Officier de justice subalterne qui, dans le midi de la France, avait les mêmes fonctions que les prévôts royaux dans les autres provinces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0073449-7656-49c5-9ddc-a4373bfb446e",
                                "sense_id": "50ffa63c-eafd-3b7d-9cc5-07fb0eca576b",
                                "text": "Le viguier veille sur la justice du roi, mais laisse le soin à un juge de conduire les procès."
                            },
                            {
                                "example_id": "99a3b295-68d2-4aa5-b606-1d87a9586683",
                                "sense_id": "50ffa63c-eafd-3b7d-9cc5-07fb0eca576b",
                                "text": "Une insulte faite au baylon (syndic) est punie d'une amende de dix écus, et même de la prison, à la diligence du viguier ; le délinquant ne sortait de prison que sur l'intervention du syndic. […]. Il y avait des baylons de première main, de seconde main et de troisième main ; ce sont les riches, ceux de la classe moyenne et les pauvres."
                            }
                        ]
                    }
                ],
