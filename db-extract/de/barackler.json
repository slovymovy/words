                "senses": [
                    {
                        "sense_id": "3d449470-acc2-3f05-9c07-9d77182f510d",
                        "entry_id": "783a20c9-a3a2-3090-ba5b-87850e0f1280",
                        "glosses": [
                            "jemand, der eine Baracke bewohnt; jemand, der in einem Barackenlager, einer Barackensiedlung wohnt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "bb269b62-4d09-40c4-8e2f-56a2060820b0",
                                "sense_id": "3d449470-acc2-3f05-9c07-9d77182f510d",
                                "text": "„‚Die Familien vom Riedweg sollen sich der Gesellschaft eingliedern. Sie müssen sich resozialisieren‘, heißt es. Die Gesellschaft, die das fordert, begeht jedoch fortwährenden Rufmord an den Baracklern.“"
                            },
                            {
                                "example_id": "92e5fbf1-4df3-4d04-9847-b581139d6ade",
                                "sense_id": "3d449470-acc2-3f05-9c07-9d77182f510d",
                                "text": "„Den üblichen Ton, in dem viele Deutsche über Obdachlose reden, vernahm auch der evangelische Vikar und Soziologe Manfred Dehnen, der in Mannheim Nachbarn von ‚Baracklern‘ befragte. […] Mit Ekel und Haß werden die sozial Verachteten behandelt -- ‚wie Scheiße‘, fand der Schriftsteller Alexander Spoerl, der 1967 Barackler in Köln observierte und ein wohlwollendes Buch über die ‚Menschen dritter Klasse‘ (Titel) schrieb.“"
                            },
                            {
                                "example_id": "ad431627-7aea-400b-a86e-8ec3d081178e",
                                "sense_id": "3d449470-acc2-3f05-9c07-9d77182f510d",
                                "text": "„Ein Siedlungsjunge, ein typischer Barackler, nicht mal eine Hose hat er über dem Hintern!“"
                            },
                            {
                                "example_id": "f04846fb-e083-4b1f-b8c3-2abc9fd08cd7",
                                "sense_id": "3d449470-acc2-3f05-9c07-9d77182f510d",
                                "text": "„Der mit der Kugel im Rücken war ein ‚Barackler‘, ein kroatischer Steinbrucharbeiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
