                            {
                                "target_lang_word": "üzmek",
                                "target_lang_sense_clarification": "kederlendirmek, keder vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73016c01-a640-32d2-b28f-0a340e15fc4a",
                    "sense_definition": "To trouble aggressively or harass someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered not to <w>vex</w> the local population during their stay.",
