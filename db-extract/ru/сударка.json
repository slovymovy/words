                "senses": [
                    {
                        "sense_id": "884fd92a-df4d-3a02-ae4b-20835f582595",
                        "entry_id": "0fc15b36-51c0-3935-bb8a-e3f5e35c2e93",
                        "glosses": [
                            "ласковое обращение к женщине, девочке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9315bbcc-d820-4504-a72e-61d5185e9ae2",
                                "sense_id": "884fd92a-df4d-3a02-ae4b-20835f582595",
                                "text": "— Мне ничего, покуда бог милует; а я за тобой, сударка, для твоего же добра."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3024ef5-6d7b-33c1-bbad-69416841c579",
                        "entry_id": "0fc15b36-51c0-3935-bb8a-e3f5e35c2e93",
                        "glosses": [
                            "возлюбленная, любовница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5323901b-ffd2-4696-bf33-9607df973f24",
                                "sense_id": "e3024ef5-6d7b-33c1-bbad-69416841c579",
                                "text": "— Любопытно мне стало поглядеть на неё. Сам знаешь, баринова сударка; стало быть, сила."
                            }
                        ]
                    }
