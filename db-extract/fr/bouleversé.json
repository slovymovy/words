                                                "sense_id": "d8d21665-3dfa-3ed0-b5b6-3ea9f5aef4cf",
                                                "text": "The Board determines that the probable cause of this accident was the unfavorable interaction of severe vertical air drafts and large longitudinal control displacements resulting in a longitudinal upset from which a successful recovery was not made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df9a4d3-e8ad-35c9-9789-d13e5aeb193b",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "A woven row supporting the foundation rods for the uprights of a basket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08fa13e-eb29-439c-b148-ee911bd68f2f",
                                                "sense_id": "9df9a4d3-e8ad-35c9-9789-d13e5aeb193b",
                                                "text": "Willow basket making, an artisan inserting bye-stakes in the upsets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                        "entry_id": "04663a68-a9bb-322d-8c22-3e12f4c390fd",
                                        "glosses": [
                                            "Angry, distressed, or unhappy."
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4d62b0-0f85-40a6-8856-5f54f740408e",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "He was upset when she refused his friendship."
                                            },
                                            {
                                                "example_id": "80db85e1-23b5-4558-b84c-639ddc3d6fde",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "My children often get upset with their classmates."
                                            },
                                            {
                                                "example_id": "db0e7000-715c-4e8c-b63e-e727be0f13f3",
                                                "sense_id": "65045610-4e53-36b0-9465-5b63fb9b7cb4",
                                                "text": "We were shocked when we asked a disruptive man in the front row to move to the back, and when he subsequently left, the producer's helpers were so upset for him they gave him two free tickets to the next 'women's music' production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                        "entry_id": "04663a68-a9bb-322d-8c22-3e12f4c390fd",
                                        "glosses": [
                                            "Feeling unwell, nauseated, or ready to vomit."
                                        ],
                                        "tags": [
                                            "of a stomach or gastrointestinal tract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5dece0-5cda-4af5-80fb-66baea5b884a",
                                                "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                                "text": "His stomach was upset, so he didn't want to move."
                                            },
                                            {
                                                "example_id": "fdcf4340-d928-46c4-92c2-09d61ab33336",
                                                "sense_id": "439900e5-3d04-364b-a516-027c90b7e43c",
                                                "text": "Bryan came home from school with an upset tummy."
                                            }
                                        ]
                                    }
                                ]
                            },
