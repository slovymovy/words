                        "glosses": [
                            "Intoxiquer par soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6024d2-a913-47d9-b538-d6ce5d5535c1",
                                "sense_id": "c67af910-d621-3cb4-bc23-692093bf0a2e",
                                "text": "Cet aspect essentiel du phénomène conduit à instaurer le mensonge en règle de conduite et à auto-intoxiquer les sociétés qui y ont recours."
                            },
                            {
                                "example_id": "883f19f4-16c6-471a-8a3d-0abcf56d9d11",
                                "sense_id": "c67af910-d621-3cb4-bc23-692093bf0a2e",
                                "text": "Mais est-ce que le fait même de s'auto-intoxiquer est une pathologie ?"
                            }
