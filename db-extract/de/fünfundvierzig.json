                                        "glosses": [
                                            "dat wat in een (rang)ordening met 45 is aangeduid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7735618d-802b-4bb0-b6a5-8fde458d646c",
                                                "sense_id": "48c500b9-1168-3e6d-820a-fae111ccbf4e",
                                                "text": "Het is weer de vijfenveertig die het niet doet, kunnen we die niet simpel vervangen?"
                                            },
                                            {
                                                "example_id": "75d8e202-cd5a-49f1-8cbd-024bdc552f9a",
                                                "sense_id": "48c500b9-1168-3e6d-820a-fae111ccbf4e",
                                                "text": "Haar zesenveertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vijfenveertig eenmaal voorbij was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ed1464d-5fa5-376f-97dc-4bee4c973e68",
                                        "entry_id": "1c0f980c-f4d0-3719-98ea-4f46a395e247",
                                        "glosses": [
                                            "groep van 45 eenheden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fffb714-bd3d-45ef-aa06-b18ef558c29a",
                                                "sense_id": "5ed1464d-5fa5-376f-97dc-4bee4c973e68",
                                                "text": "De vijfenveertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
