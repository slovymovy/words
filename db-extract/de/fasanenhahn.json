                "senses": [
                    {
                        "sense_id": "a4ca5f57-4fcd-38b3-a482-28f7fc793e26",
                        "entry_id": "e96687fd-c02e-31ec-9325-f1b99422e573",
                        "glosses": [
                            "Fasan männlichen Geschlechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb961a9b-d9a0-4e5b-bee6-6d61d0e45664",
                                "sense_id": "a4ca5f57-4fcd-38b3-a482-28f7fc793e26",
                                "text": "„Ein Fasanenhahn sammelt, wenn andere es ihm gestatten, fünf bis zehn Hennen um sich.“"
                            },
                            {
                                "example_id": "d76e7b89-98c4-4c9a-bc08-5f3d9a43a543",
                                "sense_id": "a4ca5f57-4fcd-38b3-a482-28f7fc793e26",
                                "text": "„[…] Nun hat er ihn vor sich; ganz deutlich sieht er ihn. Unterwärts ist er schwarzblau, wie ein Birkhahn, auch die Kopfbildung schlägt dahin, aber das Obergefieder ähnelt dem der Fasanenhenne, und der Stoß ist so lang wie beim Fasanenhahne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
