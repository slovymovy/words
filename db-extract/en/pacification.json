                                        "glosses": [
                                            "– Ici, on ne dit pas « la guerre », on dit « la pacification », nuance! — (Pierre Lemaître, Le Grand Monde, Calmann-Lévy, 2022, page 102)"
                                        ],
                                        "tags": [],
                                        "examples": []
