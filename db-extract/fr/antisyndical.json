                "senses": [
                    {
                        "sense_id": "fe7935c1-e78c-300d-ba08-6f6d05ec1fca",
                        "entry_id": "899ac785-c089-3247-8fec-6f3bcefd2d12",
                        "glosses": [
                            "Opposé au syndicalisme, aux syndicats."
                        ],
                        "tags": [
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "04da541d-4fde-4a19-a713-aadeaafb5295",
                                "sense_id": "fe7935c1-e78c-300d-ba08-6f6d05ec1fca",
                                "text": "On peut se voiler la face en se livrant à un déferlement d’attaques antisyndicales ciblées sur la seule CGT, qui, avec le temps, vire à l’hommage du vice à la vertu."
                            },
                            {
                                "example_id": "ef8110ac-330c-4151-a7b7-8e994f024c2c",
                                "sense_id": "fe7935c1-e78c-300d-ba08-6f6d05ec1fca",
                                "text": "Pour le syndicat américain de l’automobile (UAW), cette campagne devait s’étendre, par la suite, à d’autres usines européennes et asiatiques attirées dans le sud des États-Unis par la main-d’œuvre bon marché, les généreuses subventions, mais aussi des règles antisyndicales en train de faire tache d’huile vers le nord."
                            }
                        ]
                    }
                ],
