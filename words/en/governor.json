{
    "word_family": [
        "govern",
        "government",
        "governance",
        "gubernatorial",
        "governess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                    "sense_definition": "The official leader of a state or province who is in charge of its government.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>governor</w> announced a new plan to improve local schools.",
                            "target_lang_translations": {
                                "ru": "<w>Губернатор</w> объявил о новом плане по улучшению местных школ.",
                                "zh": "<w>州长</w>宣布了一项改善当地学校的新计划。"
                            }
                        },
                        {
                            "text": "Voters elected a new state <w>governor</w> during the last election.",
                            "target_lang_translations": {
                                "ru": "Избиратели выбрали нового <w>губернатора</w> штата на последних выборах.",
                                "zh": "选民在上次选举中选出了一位新<w>州长</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "state governor",
                        "lieutenant governor",
                        "governor general"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный руководитель штата или провинции, возглавляющий правительство",
                        "zh": "州或省的行政长官，负责管理当地政府。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губернатор",
                                "target_lang_sense_clarification": "глава региона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "州长",
                                "target_lang_sense_clarification": "州政府的最高行政长官"
                            },
                            {
                                "target_lang_word": "省长",
                                "target_lang_sense_clarification": "省政府的最高行政长官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5efd9fd5-bb35-3578-8cf5-7bea99ee35c0",
                    "sense_definition": "A title used before the name of a person who holds the position of governor.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_leader",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "We welcomed <w>Governor</w> Smith to the opening ceremony of the hospital.",
                            "target_lang_translations": {
                                "ru": "Мы приветствовали <w>губернатора</w> Смита на церемонии открытия больницы.",
                                "zh": "我们欢迎<w>州长</w>史密斯参加医院的开幕仪式。"
                            }
                        },
                        {
                            "text": "The press asked <w>Governor</w> Johnson about the budget cuts.",
                            "target_lang_translations": {
                                "ru": "Пресса спросила <w>губернатора</w> Джонсона о сокращении бюджета.",
                                "zh": "媒体向<w>州长</w>约翰逊询问了关于预算削减的问题。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый перед именем человека, занимающего пост губернатора",
                        "zh": "用于州长或省长姓名之前的尊称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губернатор",
                                "target_lang_sense_clarification": "титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "州长",
                                "target_lang_sense_clarification": "作为头衔使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                    "sense_definition": "A member of a committee that manages an organization, such as a bank, school, or hospital.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has served on the board of <w>governors</w> for five years.",
                            "target_lang_translations": {
                                "ru": "Она прослужила в совете <w>управляющих</w> пять лет.",
                                "zh": "她已经在董事会担任<w>理事</w>五年了。"
                            }
                        },
                        {
                            "text": "The bank <w>governor</w> decided to raise interest rates today.",
                            "target_lang_translations": {
                                "ru": "<w>Управляющий</w> банком решил сегодня повысить процентные ставки.",
                                "zh": "<w>行长</w>今天决定提高利率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "board of governors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член комитета, управляющего организацией, такой как банк, школа или больница",
                        "zh": "管理机构（如银行、学校或医院）的委员会成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управляющий",
                                "target_lang_sense_clarification": "руководитель организации"
                            },
                            {
                                "target_lang_word": "член правления",
                                "target_lang_sense_clarification": "член совета директоров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理事",
                                "target_lang_sense_clarification": "机构管理委员会成员"
                            },
                            {
                                "target_lang_word": "行长",
                                "target_lang_sense_clarification": "银行的最高管理人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                    "sense_definition": "A device that automatically limits the speed or controls the operation of a machine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck has a <w>governor</w> to limit its top speed on the highway.",
                            "target_lang_translations": {
                                "ru": "На грузовике установлен <w>ограничитель</w> для лимитирования максимальной скорости на шоссе.",
                                "zh": "这辆卡车装有<w>限速器</w>，以限制其在高速公路上的最高时速。"
                            }
                        },
                        {
                            "text": "A broken <w>governor</w> caused the engine to run too fast and overheat.",
                            "target_lang_translations": {
                                "ru": "Сломанный <w>регулятор</w> заставил двигатель работать слишком быстро и перегреться.",
                                "zh": "一个损坏的<w>调速器</w>导致发动机运转过快并过热。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speed governor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, которое автоматически ограничивает скорость или контролирует работу механизма",
                        "zh": "自动限制速度或控制机器运行的装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулятор",
                                "target_lang_sense_clarification": "механизм контроля"
                            },
                            {
                                "target_lang_word": "ограничитель",
                                "target_lang_sense_clarification": "устройство лимитирования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调速器",
                                "target_lang_sense_clarification": "控制机器转速的装置"
                            },
                            {
                                "target_lang_word": "限速器",
                                "target_lang_sense_clarification": "限制最高速度的装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c118cc21-83f1-38ce-a28c-434a0cddf7ab",
                    "sense_definition": "A word used to address a boss, a father, or a man in a superior position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sorry I am late, <w>governor</w>, the traffic was terrible this morning.",
                            "target_lang_translations": {
                                "ru": "Извините за опоздание, <w>шеф</w>, пробки сегодня утром были ужасные.",
                                "zh": "抱歉我迟到了，<w>老板</w>，今天早上的交通太糟糕了。"
                            }
                        },
                        {
                            "text": "His <w>governor</w> gave him a raise last week for his hard work.",
                            "target_lang_translations": {
                                "ru": "Его <w>начальник</w> повысил ему зарплату на прошлой неделе за усердную работу.",
                                "zh": "他的<w>老板</w>上周因为他工作努力给他涨了工资。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для обращения к начальнику, отцу или мужчине, занимающему более высокое положение",
                        "zh": "英国俚语，用于称呼老板、父亲或地位较高的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шеф",
                                "target_lang_sense_clarification": "разговорное обращение"
                            },
                            {
                                "target_lang_word": "начальник",
                                "target_lang_sense_clarification": "руководитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老板",
                                "target_lang_sense_clarification": "对上司的口语称呼"
                            },
                            {
                                "target_lang_word": "头儿",
                                "target_lang_sense_clarification": "非正式的称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}