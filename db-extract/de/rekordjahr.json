                "senses": [
                    {
                        "sense_id": "731d1823-5110-368f-8578-27c359b168ef",
                        "entry_id": "594b301d-745b-38fb-ad88-976d10facb43",
                        "glosses": [
                            "Jahr, in dem ein Rekordwert erreicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b112149-cc9b-4977-ae83-90135713ecdb",
                                "sense_id": "731d1823-5110-368f-8578-27c359b168ef",
                                "text": "Nach Einschätzung des statistischen Bundesamtes werden noch mehr Deutsche emigrieren als im bisherigen Auswander-Rekordjahr 2007."
                            },
                            {
                                "example_id": "a78c4ea0-8cdc-4dc8-aae7-59a5b6d3c233",
                                "sense_id": "731d1823-5110-368f-8578-27c359b168ef",
                                "text": "„Der Stromverbrauch in der Schweiz ist vergangenes Jahr um 0,6 Prozent gestiegen. Nach dem Rekordjahr 2012 ist das der zweithöchste Jahresverbrauch.“"
                            },
                            {
                                "example_id": "ef384794-3fef-4a49-977c-546a9e9bd667",
                                "sense_id": "731d1823-5110-368f-8578-27c359b168ef",
                                "text": "Und sollte das nicht genügen, weichen die Hurrikanforscher noch auf das griechische Alphabet aus, wie es im Rekordjahr 2005 nötig war, als sich zum Abschluss „Epsilon“ bildete."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
