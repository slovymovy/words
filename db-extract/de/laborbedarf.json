                        "tags": [],
                        "examples": [
                            {
                                "example_id": "567e7e05-2a09-42dd-89e8-a0fa5df558ca",
                                "sense_id": "486e9bab-98c4-3066-985e-52e54bbfdd0c",
                                "text": "„Der Name einer Firma für Laborbedarf war in das Gleis eingeprägt.“"
                            },
                            {
                                "example_id": "49df5533-6bb9-4793-a904-2770db96d378",
                                "sense_id": "486e9bab-98c4-3066-985e-52e54bbfdd0c",
                                "text": "„Er wollte wissen, ob ausländische Wissenschaftler das Labor an der Teheraner Universität besucht hatten, in dem Azadi arbeitete. Oder ob es neue Materiallieferungen aus dem Westen oder neue Bestellungen von Laborbedarf gegeben habe.“"
                            }
