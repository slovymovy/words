                                    },
                                    {
                                        "sense_id": "c5559dac-3615-3433-84fe-2028bfe43cb7",
                                        "entry_id": "17feb24c-543f-31c5-833c-1ef1a4891edb",
                                        "glosses": [
                                            "To soil, stain, corrupt, or infect by contact or association."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5dbfcf-bc89-4822-8309-97686bc41b32",
                                                "sense_id": "c5559dac-3615-3433-84fe-2028bfe43cb7",
                                                "text": "Shall we now\n Contaminate our figures with base bribes?"
                                            },
                                            {
                                                "example_id": "1a46c448-abd1-455d-8fca-63e830db2181",
                                                "sense_id": "c5559dac-3615-3433-84fe-2028bfe43cb7",
                                                "text": "I would neither have simplicity imposed upon, nor virtue contaminated."
                                            },
                                            {
                                                "example_id": "233926d7-3517-4d64-9186-b64630c6da67",
                                                "sense_id": "c5559dac-3615-3433-84fe-2028bfe43cb7",
                                                "text": "[Martin] Heidegger's repellent political beliefs do not contaminate his philosophical work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bc9de7-a900-301f-acf6-fea4a42dc2ca",
                                        "entry_id": "17feb24c-543f-31c5-833c-1ef1a4891edb",
                                        "glosses": [
                                            "To make unfit for use by the introduction of unwholesome or undesirable elements."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c59032a-2c79-4e22-b1d2-086d48eb00f4",
                                                "sense_id": "c1bc9de7-a900-301f-acf6-fea4a42dc2ca",
                                                "text": "Do not contaminate the peanut butter with the jelly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ce7bfc-ecb8-3e9e-b308-9c9c3ce66145",
                                        "entry_id": "17feb24c-543f-31c5-833c-1ef1a4891edb",
                                        "glosses": [
                                            "To infect, usually of a deadly virus."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
