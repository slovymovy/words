                        "cross_references": [
                            {
                                "target_word": "jupette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8df8e51f-d50a-308a-a10a-074d0b2f053b",
                                        "entry_id": "8c2c56ef-7284-39fc-8761-98ac48584f4e",
                                        "glosses": [
                                            "Jupe courte qui descend au-dessus du genou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d563f7ab-9588-49ba-b44f-918c028e420d",
                                                "sense_id": "8df8e51f-d50a-308a-a10a-074d0b2f053b",
                                                "text": "Et dans ce décor, la douce écrivain, qui est jolie, curieuse, l’air viril et des muscles apparents partout, car sauf une jupette pareille à un pagne, elle est nue."
                                            },
                                            {
                                                "example_id": "4ed0c09a-d092-4a08-b1c8-bf0465b2fa55",
                                                "sense_id": "8df8e51f-d50a-308a-a10a-074d0b2f053b",
                                                "text": "Quand les couturiers Carven et Balenciaga leur dessinaient de mignonnettes jupettes au-dessus du genou et de seyantes toques sur leurs cheveux, les « prunes » glissées par leurs doigts de fée sur les pare-brise avaient un autre goût."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jupette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca6afd02-9434-3481-b515-468756aa03dc",
                                        "entry_id": "849be189-4211-3539-a55c-eb8708e74c6f",
                                        "glosses": [
                                            "Variante de juppette."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be33090-9d53-4a0a-b46d-4dc5f03cf344",
                                                "sense_id": "ca6afd02-9434-3481-b515-468756aa03dc",
                                                "text": "La décision du gouvernement Fillon a été saluée par tous car elle pourrait permettre, en lissant l'activité, d'éviter l'effet « jupette » à la sortie. « Les immatriculations avaient chuté de plus de 20 % en 1997 après l'arrêt de la prime Juppé », rappelle Yann Lacroix, spécialiste automobile chez Euler-SFAC."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
