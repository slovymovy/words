                                    {
                                        "sense_id": "7866e799-e226-34e4-85b4-526a730dfe11",
                                        "entry_id": "cba43457-b41d-3ff3-bb32-6ba59d540862",
                                        "glosses": [
                                            "The cry of a cat."
                                        ],
                                        "tags": [
