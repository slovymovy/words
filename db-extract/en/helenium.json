                        "glosses": [
                            "Any of various flowering plants, of the genus Helenium, the dried leaves of which were once used to make a form of snuff."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63848b6-cc9f-41f1-afc1-6d7fcb2699be",
                                "sense_id": "5baaddbd-e32f-38d1-84a8-136a34679f59",
                                "text": "Amongst the herbs to be administered when the charm was sung over him were a yew-berry, lupin, helenium, marsh mallow, dock elder, wormwood and strawberry leaves."
                            },
                            {
                                "example_id": "eb51d9b4-f131-4dbb-b64d-2bd9cb465656",
                                "sense_id": "5baaddbd-e32f-38d1-84a8-136a34679f59",
                                "text": "Heleniums mostly have an upright habit, though the taller ones may need staking in spring or cutting back by half in early summer to stay that way."
                            }
                        ]
                    }
