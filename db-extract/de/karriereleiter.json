                ],
                "senses": [
                    {
                        "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                        "entry_id": "1b909b03-1f1e-3789-a1ed-1a1f3abfe28e",
                        "glosses": [
                            "Weg aufwärts / Aufstieg in der beruflichen Laufbahn"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5ba43b4e-3f8e-4922-be30-fe74b4b43489",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Weiter oben auf der Karriereleiter sinkt der Anteil der Frauen in deutschen Konzernen und Behörden immer mehr."
                            },
                            {
                                "example_id": "8ee9d27c-a6bb-4f8c-bc3d-6a642257c00f",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "2003 stieg [Mohsen Sohi] bei der US-Tochter von Freudenberg ein und kletterte in den darauffolgenden Jahren die Karriereleiter empor."
                            },
                            {
                                "example_id": "83e20f13-0ee2-4c90-a042-8ceb1178eb0a",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Völlig unabhängig von Talent und Fähigkeiten haben nur die wenigsten haben überhaupt die Möglichkeit, die Karriereleiter ganz nach oben zu erklimmen: es gibt nur 30 Dax-Vorstandsvorsitzende."
                            },
                            {
                                "example_id": "2c97f5a7-0324-4be2-8a9d-19c6c74b8195",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "[…] die junge Generation fordert: Jobs sollen gefälligst Spaß machen […]. Die klassische Karriereleiter hat ausgedient."
                            },
                            {
                                "example_id": "aa65e01c-45da-4927-a9e1-76b671e3dd5e",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Meist wurde [der Journalist Friedrich Nowottny] gefragt, wenn er die Karriereleiter wieder eine Sprosse höher steigen sollte."
                            },
                            {
                                "example_id": "d99b8d50-842c-4666-b4a4-36ae337e4012",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Mit spätestens sechzehn hört das Wunderkindalter auf. Was danach kommt, ist jene mitunter quälend lange Phase, in der die Karriereleiter Sprosse für Sprosse erklommen werden muss."
                            },
                            {
                                "example_id": "013a39b3-d17c-44c1-a8fa-f297d0377ba3",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Obwohl Anna Ternheim erst 25 Jahre alt war, als sie \"Somebody Outside\" aufzunehmen begann, hatte sie auf ihrer musikalischen Karriereleiter schon einen weiten Weg zurückgelegt."
                            },
                            {
                                "example_id": "8b0eae98-9c05-4f53-80d1-e3e438f993c1",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "Wer den internationalen „Concours Reine Elisabeth“ in Brüssel für sich entscheiden kann, ist ein gutes Stück nach oben auf der Karriereleiter gekommen."
                            },
                            {
                                "example_id": "bfe026ac-11b2-45b9-b61e-7de10eceb07c",
                                "sense_id": "0db5e8b5-75f8-387e-b13f-26ea7ed8eb3f",
                                "text": "[Das Peter-Prinzip besagt,] dass jedes Mitglied einer ausreichend komplexen Hierarchie so lange befördert wird, bis es das Maß seiner absoluten Unfähigkeit erreicht hat, was in der Regel das persönliche Maximum der Karriereleiter markiert und weitere Beförderungen ausbleiben lässt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
