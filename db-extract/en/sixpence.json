                "senses": [
                    {
                        "sense_id": "8a06023b-06c8-3b1b-9a99-5bf4e4d6a523",
                        "entry_id": "92d40da1-7532-3a34-9d35-069106f9f55d",
                        "glosses": [
                            "The value of six old pence; half of a shilling; or one-fortieth of a pound sterling."
                        ],
                        "tags": [
                            "British",
                            "Irish",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9220aa6e-be3b-4772-aecb-2fa76cd67b2f",
                                "sense_id": "8a06023b-06c8-3b1b-9a99-5bf4e4d6a523",
                                "text": "Finest apples, sixpence each."
                            },
                            {
                                "example_id": "133dd6ae-d1b6-4da2-898d-c1f975b3265a",
                                "sense_id": "8a06023b-06c8-3b1b-9a99-5bf4e4d6a523",
                                "text": "When the ferry-boat with her wild freight pushed into the stream, nobody cared sixpence for the wasted time but the captain of the craft."
                            }
                        ]
                    },
                    {
                        "sense_id": "c516d501-dc21-371f-961b-c7e80dfcb64f",
                        "entry_id": "92d40da1-7532-3a34-9d35-069106f9f55d",
                        "glosses": [
                            "A former British or Irish coin worth six pennies, first minted in 1551."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "241ba79b-628d-4cf9-a348-41431cfa265e",
                                "sense_id": "c516d501-dc21-371f-961b-c7e80dfcb64f",
                                "text": "Have you got two sixpences for a shilling?"
                            },
                            {
                                "example_id": "f8f58247-e685-46f2-8ad3-7e6bc0e1bef3",
                                "sense_id": "c516d501-dc21-371f-961b-c7e80dfcb64f",
                                "text": "\"One penny, sir!\" He was roused at once from his abstraction; for it was a question to himself whether he had even that in his pocket. Sixpence was, however, discovered; he paid the toll, and passed on."
                            },
                            {
                                "example_id": "87412913-02a7-4463-a0c5-69675b89219f",
                                "sense_id": "c516d501-dc21-371f-961b-c7e80dfcb64f",
                                "text": "I remember playing card games with my grandfather. Games of memory, not of skill. If I won, he gave me sixpence; if he won, he didn't. We would play until I was bored, or until he ran out of sixpences."
                            }
                        ]
                    }
                ],
