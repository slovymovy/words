                "senses": [
                    {
                        "sense_id": "a8e31742-8217-3aa8-a6f3-ddd4fea84f6b",
                        "entry_id": "4ca972c5-8ff9-3539-b391-4d2f901a581a",
                        "glosses": [
                            "Tout ce qui manque d’harmonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5979244-ac20-4a35-a1d5-aea9e96d40f9",
                                "sense_id": "a8e31742-8217-3aa8-a6f3-ddd4fea84f6b",
                                "text": "L’atmosphère, chez mes parents, était prohibitivement harmonieuse. Je veux dire par là que, chez nous, il fallait que tout fût parfaitement harmonieux, que tout ne pouvait être, en aucune façon, autre qu’harmonieux, que la notion même ou la possibilité de l’inharmonieux n’existait pas (...) quelque chose qui posât un problème, cela ne devait pas exister car c’eût été la fin du monde (...). Toute ma vie j’ai été brave et gentil et c’est pour cela que j’ai attrapé le cancer."
                            }
                        ]
                    }
