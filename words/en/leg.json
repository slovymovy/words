{
    "word_family": [
        "leggy",
        "legging",
        "legless",
        "bootleg",
        "blackleg",
        "dogleg"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3c8a841-5e77-3106-897c-84d34e9f6451",
                    "sense_definition": "In humans, the lower limb extending from the groin to the ankle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dan won't be able to come to the party, since he broke his <w>leg</w> last week and is now on crutches.",
                            "target_lang_translations": {
                                "ru": "Дэн не сможет прийти на вечеринку, так как на прошлой неделе он сломал <w>ногу</w> и теперь ходит на костылях."
                            }
                        },
                        {
                            "text": "She stretched her <w>leg</w> out to reach the ball before it went out of bounds.",
                            "target_lang_translations": {
                                "ru": "Она вытянула <w>ногу</w>, чтобы достать мяч, прежде чем он вылетит за пределы поля."
                            }
                        }
                    ],
                    "synonyms": [
                        "gam"
                    ],
                    "common_phrases": [
                        "broken leg",
                        "left leg",
                        "right leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя конечность человека от паха до щиколотки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нога",
                                "target_lang_sense_clarification": "конечность человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b06eaac9-f152-3d6f-80b3-187b6caa4028",
                    "sense_definition": "A limb or appendage that an animal uses for support or locomotion on land.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Insects have six <w>legs</w>.",
                            "target_lang_translations": {
                                "ru": "У насекомых шесть <w>ног</w>."
                            }
                        },
                        {
                            "text": "The spider crawled quickly across the floor using all eight of its <w>legs</w>.",
                            "target_lang_translations": {
                                "ru": "Паук быстро полз по полу, используя все восемь <w>лапок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drumstick"
                    ],
                    "common_phrases": [
                        "hind leg",
                        "front leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечность животного, используемая для опоры или передвижения по земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нога",
                                "target_lang_sense_clarification": "конечность животного"
                            },
                            {
                                "target_lang_word": "лапа",
                                "target_lang_sense_clarification": "конечность некоторых животных или насекомых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab3b3114-85b8-3351-8023-d6b638d644f0",
                    "sense_definition": "A rod-like protrusion from an inanimate object, such as a piece of furniture, supporting it from underneath.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One <w>leg</w> of the table is shorter than the others, making it wobble.",
                            "target_lang_translations": {
                                "ru": "Одна <w>ножка</w> стола короче остальных, из-за чего он качается."
                            }
                        },
                        {
                            "text": "He carefully painted each <w>leg</w> of the chair to match the new desk.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно покрасил каждую <w>ножку</w> стула под цвет нового стола."
                            }
                        }
                    ],
                    "common_phrases": [
                        "table leg",
                        "chair leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стержнеобразная опора неодушевленного предмета, например мебели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ножка",
                                "target_lang_sense_clarification": "опора мебели или утвари"
                            },
                            {
                                "target_lang_word": "нога",
                                "target_lang_sense_clarification": "опора крупного сооружения или механизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd12f4b1-1da6-3271-ae94-2eb2fa2dc3fd",
                    "sense_definition": "A part of garment, such as a pair of trousers or pants, that covers a leg.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The left <w>leg</w> of these jeans has a tear.",
                            "target_lang_translations": {
                                "ru": "На левой <w>штанине</w> этих джинсов дырка."
                            }
                        },
                        {
                            "text": "He spilled coffee down his <w>pant</w> <w>leg</w> while driving to work.",
                            "target_lang_translations": {
                                "ru": "Он пролил кофе на <w>штанину</w>, пока ехал на работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "pant leg",
                        "pantleg"
                    ],
                    "common_phrases": [
                        "pant leg",
                        "trouser leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть одежды (брюк, штанов), закрывающая ногу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штанина",
                                "target_lang_sense_clarification": "часть брюк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f962db1-3ce6-3e52-abe9-49677900d17b",
                    "sense_definition": "A stage of a journey, race, or competition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After six days, we're finally in the last <w>leg</w> of our cross-country trip.",
                            "target_lang_translations": {
                                "ru": "Спустя шесть дней мы, наконец, на последнем <w>этапе</w> нашего путешествия через всю страну."
                            }
                        },
                        {
                            "text": "The first <w>leg</w> of the flight was much smoother than the second one.",
                            "target_lang_translations": {
                                "ru": "Первый <w>отрезок</w> полета прошел гораздо спокойнее, чем второй."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last leg",
                        "first leg",
                        "final leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Этап или отрезок пути, гонки или соревнования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этап",
                                "target_lang_sense_clarification": "часть пути или процесса"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "отрезок пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc840b35-bcb5-36e8-af83-74c423d9880f",
                    "sense_definition": "A single game or match played in a tournament or other sporting contest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They crushed nine-man Estonia 4-0 in the first <w>leg</w> of the qualifying play-off tie.",
                            "target_lang_translations": {
                                "ru": "Они разгромили Эстонию, игравшую вдевятером, со счетом 4:0 в первом <w>матче</w> стыкового отборочного турнира."
                            }
                        },
                        {
                            "text": "The team needs to win the second <w>leg</w> to advance to the finals.",
                            "target_lang_translations": {
                                "ru": "Команде нужно выиграть ответный <w>матч</w>, чтобы выйти в финал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "first leg",
                        "second leg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночная игра или матч в рамках турнира, состоящего из нескольких встреч."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матч",
                                "target_lang_sense_clarification": "одна из встреч в серии"
                            },
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "стадия турнира"
                            },
                            {
                                "target_lang_word": "тур",
                                "target_lang_sense_clarification": "этап соревнования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4346498-7bcf-3dc8-aa4e-815144cb1864",
                    "sense_definition": "The ability of something to persist or succeed over a long period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This proposal has no <w>legs</w> because almost everyone opposes it.",
                            "target_lang_translations": {
                                "ru": "У этого предложения нет <w>перспектив</w>, потому что почти все выступают против него."
                            }
                        },
                        {
                            "text": "The marketing team believes this campaign has <w>legs</w> and will last all year.",
                            "target_lang_translations": {
                                "ru": "Команда по маркетингу верит, что у этой кампании есть <w>потенциал</w> и она продлится весь год."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have legs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business or creative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность чего-либо сохранять актуальность или успех в течение длительного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциал",
                                "target_lang_sense_clarification": "шансы на долгосрочный успех"
                            },
                            {
                                "target_lang_word": "жизнеспособность",
                                "target_lang_sense_clarification": "способность долго существовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650657ae-b13a-3640-a6cc-3e2e2cd36ea2",
                    "sense_definition": "One of the two sides of a right triangle that is not the hypotenuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To find the hypotenuse, you must square each <w>leg</w> of the right triangle.",
                            "target_lang_translations": {
                                "ru": "Чтобы найти гипотенузу, нужно возвести в квадрат каждый <w>катет</w> прямоугольного треугольника."
                            }
                        },
                        {
                            "text": "The length of the shorter <w>leg</w> is exactly five centimeters.",
                            "target_lang_translations": {
                                "ru": "Длина меньшего <w>катета</w> составляет ровно пять сантиметров."
                            }
                        }
                    ],
                    "synonyms": [
                        "cathetus"
                    ],
                    "common_phrases": [
                        "triangle leg"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух сторон прямоугольного треугольника, образующих прямой угол."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катет",
                                "target_lang_sense_clarification": "сторона прямоугольного треугольника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d9bf696-e2f3-322a-b367-a9f79c2c458e",
                    "sense_definition": "An act of forming a step for a person's feet with one's hands to help them climb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Josiah gave me a <w>leg</w> so I could reach the top of the wall.",
                            "target_lang_translations": {
                                "ru": "Джозайя <w>подсадил</w> меня, чтобы я мог дотянуться до верха стены."
                            }
                        },
                        {
                            "text": "He needed a <w>leg</w> up to climb over the tall wooden fence.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было, чтобы его <w>подсадили</w>, чтобы перелезть через высокий деревянный забор."
                            }
                        }
                    ],
                    "synonyms": [
                        "leg up"
                    ],
                    "common_phrases": [
                        "give a leg"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually in the phrase 'give a leg up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подсаживание человека (с помощью рук), чтобы помочь ему залезть куда-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсадка",
                                "target_lang_sense_clarification": "помощь при подъеме"
                            },
                            {
                                "target_lang_word": "подсобить",
                                "target_lang_sense_clarification": "помочь залезть (в контексте действия)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5afc77a-c35b-37e2-911f-fea507085fec",
                    "sense_definition": "To apply force using the leg, especially when riding a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider had to <w>leg</w> the horse to keep it moving through the deep mud.",
                            "target_lang_translations": {
                                "ru": "Всаднику пришлось активно <w>посылать</w> лошадь шенкелем, чтобы она продолжала идти через глубокую грязь."
                            }
                        },
                        {
                            "text": "You must <w>leg</w> the animal firmly to signal a change in direction.",
                            "target_lang_translations": {
                                "ru": "Нужно крепко <w>сжать</w> бока животного ногами, чтобы подать сигнал к смене направления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leg a horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладывать усилие ногами, особенно при езде на лошади (шенкелем)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посылать",
                                "target_lang_sense_clarification": "управлять лошадью с помощью ног"
                            },
                            {
                                "target_lang_word": "пришпоривать",
                                "target_lang_sense_clarification": "ускорять движение ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a088f40-0e6b-3695-a0a5-816f0c24c210",
                    "sense_definition": "To remove the legs from an animal carcass.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butchery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher began to <w>leg</w> the deer after the hunt was over.",
                            "target_lang_translations": {
                                "ru": "Мясник начал <w>отделять ноги</w> у оленя после завершения охоты."
                            }
                        },
                        {
                            "text": "It takes skill to <w>leg</w> a carcass without damaging the surrounding meat.",
                            "target_lang_translations": {
                                "ru": "Требуется навык, чтобы <w>разделать</w> тушу, не повредив окружающее мясо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical butchery term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделять ноги от туши животного при разделке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отнимать",
                                "target_lang_sense_clarification": "отделять конечности туши"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}