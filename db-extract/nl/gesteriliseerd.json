                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8d4114db-9f57-4635-bdb2-f0c016fb749f",
                                "sense_id": "fb1b77a2-71e5-3fcd-a6f7-43ae782a5d33",
                                "text": "Het negerboek, dat in Canada als The Book of Negroes werd gepubliceerd maar in de VS de gesteriliseerde titel Someone Knows My Name meekreeg, wordt gedragen door Aminata Diallo."
                            }
                        ]
                    }
