                        "form": "das Gesamtkunstwerk"
                    },
                    {
                        "form_id": "d1ca67a6-0540-43ee-b0a1-a00fa7642efc",
                        "entry_id": "9c97b40d-bcd2-3d40-b454-5bbbe67a0b19",
