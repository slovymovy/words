                "senses": [
                    {
                        "sense_id": "50482b80-252b-3776-bb57-9d196681e0d9",
                        "entry_id": "ef376c9e-4a77-3dc7-9809-b42dfbfc5090",
                        "glosses": [
                            "Maladie contagieuse épidémique des vers à soie due à un protozoaire Nosema bombycis et qui a été étudiée et combattue par Louis Pasteur."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "9139d9d4-3f77-419a-a357-70ebb0f87148",
                                "sense_id": "50482b80-252b-3776-bb57-9d196681e0d9",
                                "text": "[…] ; et les vers à soie en proie à la pébrine ou à la gâtine ne fournissent plus aux campagnes leur appoint précieux."
                            },
                            {
                                "example_id": "8e604db8-764e-40e7-b7e4-999720894132",
                                "sense_id": "50482b80-252b-3776-bb57-9d196681e0d9",
                                "text": "Pasteur diagnostiqua le mal : c'était la maladie dite des morts flats ou flacherie, indépendante de la pébrine. Contrairement à l'opinion générale, deux maladies différentes, mais concomitantes, décimaient les magnaneries."
                            },
                            {
                                "example_id": "b6752767-304b-4cee-a723-efe7a0d12898",
                                "sense_id": "50482b80-252b-3776-bb57-9d196681e0d9",
                                "text": "Il y a eu la pébrine, une maladie très contagieuse qui doit son nom aux taches en forme de grains de poivre qu'elle occasionne sur l'épiderme des chenilles."
                            }
                        ]
                    }
                ],
