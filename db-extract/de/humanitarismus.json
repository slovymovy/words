                                        "sense_id": "5eba3e5f-cd9f-35b7-8d91-13a191ea6f38",
                                        "entry_id": "40d87bc4-5181-3bc1-a3aa-2b54207848a7",
                                        "glosses": [
                                            "Amour de l’humanité excessif et prétentieux."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0907000-4a3b-4edb-af94-2f724b9deee8",
                                                "sense_id": "5eba3e5f-cd9f-35b7-8d91-13a191ea6f38",
                                                "text": "Non seulement la violence prolétarienne peut assurer la révolution future, mais encore elle semble être le seul moyen dont disposent les nations européennes, abruties par l’humanitarisme, pour retrouver leur ancienne énergie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7089e22-fd64-3904-98f0-c3b670c24b3a",
                                        "entry_id": "40d87bc4-5181-3bc1-a3aa-2b54207848a7",
                                        "glosses": [
                                            "Activisme pour la défense des droits de l’Homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c083c5-c997-4470-b191-0543383b9534",
                                                "sense_id": "c7089e22-fd64-3904-98f0-c3b670c24b3a",
                                                "text": "Incapables de proposer un autre idéal qu’un nationalisme revanchard, ils exhibent aux européens le miroir déformant de leur humanitarisme."
                                            }
                                        ]
                                    }
