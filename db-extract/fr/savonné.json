                        "sense_id": "29a4f89b-9d14-33b2-a467-f4cbb8d9009e",
                        "entry_id": "67f13532-48f2-318f-86ec-5fd0ce99e9b9",
                        "glosses": [
                            "Qui a été couvert de savon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf12af3-f19c-47d1-a929-1d26666f588c",
                                "sense_id": "29a4f89b-9d14-33b2-a467-f4cbb8d9009e",
                                "text": "Je me rappelle maman se lavant dans la cuisine, chaque soir, de la tête aux pieds, par petits bouts, avec un gant savonné, ne découvrant que le strict carré de peau nécessaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "900459b4-e17b-377d-8f9d-8f327d34cf73",
                        "entry_id": "67f13532-48f2-318f-86ec-5fd0ce99e9b9",
                        "glosses": [
                            "Qui est glissant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cf4c087c-9ebc-4dfc-8314-f6a33bd9dff5",
                                "sense_id": "900459b4-e17b-377d-8f9d-8f327d34cf73",
                                "text": "La Ligue de la Paix, petit groupe isolé, un peu ridicule, qui s’efforce de retenir cette Europe de 1869 sur la pente savonnée de la guerre."
                            }
                        ]
                    }
