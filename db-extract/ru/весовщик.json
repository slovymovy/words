                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9da615bc-3d7f-3fce-897e-28445c430033",
                                        "entry_id": "ee2133fc-df94-3fb2-bfe3-7fa8fcbc7bff",
                                        "glosses": [
                                            "Celui qui pèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c16d0c-74d2-4eaf-8ebb-6975a7d231e4",
                                                "sense_id": "9da615bc-3d7f-3fce-897e-28445c430033",
                                                "text": "L'intellectuel […] peseur d’idées, voit toujours sa balance à peu près au point mort."
                                            },
                                            {
                                                "example_id": "1eb431f8-263f-4457-99b6-6669a119ca82",
                                                "sense_id": "9da615bc-3d7f-3fce-897e-28445c430033",
                                                "text": "Madame Vincent est une rieuse. Je les trouve tous gais, les gens que je vois et que ma mère méprise parce qu’ils sont paysans, savetiers ou peseurs de sucre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0726cae1-c696-4327-bcc7-740b069a310c",
                        "source_entry_id": "1d02d95b-7db9-3dfa-bbc2-583b30f3145b",
                        "source_sense_id": "b4e9d41a-0cf4-3589-a546-ea40def7ff37",
                        "target_lang_word": "basculeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basculeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "295fdbf4-0584-3f53-aefb-6231a19646fb",
                                        "entry_id": "4b36fe7d-0c8b-3a35-9c42-3022ca5889e5",
                                        "glosses": [
                                            "Qui bascule ou se bascule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4866bb-6825-439c-b270-f554795a7c12",
                                                "sense_id": "295fdbf4-0584-3f53-aefb-6231a19646fb",
                                                "text": "Tracteurs et remorques basculeuses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basculeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "539d96e1-bc23-3c3b-9414-f41f043ca976",
                                        "entry_id": "ba8e34ef-e8fa-3aa4-9938-c42e1acb0861",
                                        "glosses": [
                                            "Dispositif ou mécanisme qui bascule un contenu, qui se bascule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7046324-fa50-4ca1-a858-94bb0c212be0",
                                                "sense_id": "539d96e1-bc23-3c3b-9414-f41f043ca976",
                                                "text": "Basculeur rotatif, latéral."
                                            },
                                            {
                                                "example_id": "77518467-5d06-495a-b167-ac131679c8b4",
                                                "sense_id": "539d96e1-bc23-3c3b-9414-f41f043ca976",
                                                "text": "Les quatre soupapes d'un même cylindre, soumises chacune à l'action d'un ressort de rappel qui tend à les maintenir en position de fermeture, sont commandées par des basculeurs individuels actionnés par un même arbre à cames disposé transversalement."
                                            },
                                            {
                                                "example_id": "dd6031ad-8cfe-4abe-93df-178f71353133",
                                                "sense_id": "539d96e1-bc23-3c3b-9414-f41f043ca976",
                                                "text": "La déchetterie, située rue de la Favée, vient d’être équipée d’un nouveau système de basculeurs qui ont un double avantage : plus de facilité pour vider les déchets et pour contrôler leur conformité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51473a6c-5a1e-3238-a7bf-bda055fd6101",
                                        "entry_id": "ba8e34ef-e8fa-3aa4-9938-c42e1acb0861",
                                        "glosses": [
                                            "Personne qui s’occupe de ce dispositif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8437cd24-c997-4a6a-80a1-913e2dfc609e",
                                                "sense_id": "51473a6c-5a1e-3238-a7bf-bda055fd6101",
                                                "text": "Derrière sa vitre, la basculeuse vérifiait que la charrette était bien placée, les bœufs hors du tablier, puis elle poussait ses curseurs de cuivre, enfin elle remplissait le carnet que lui tendait le charretier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f156fbdc-180a-39eb-a901-fc37328608a9",
                                        "entry_id": "ba8e34ef-e8fa-3aa4-9938-c42e1acb0861",
                                        "glosses": [
                                            "Ouvrier chargé d'ajuster entre elles les pièces métalliques d'une arme à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7725aa-84e8-4d29-84b5-fc318a1fafc9",
                                                "sense_id": "f156fbdc-180a-39eb-a901-fc37328608a9",
                                                "text": "ils envoient le tout, successivement, à tel ou tel ouvrier platineur, basculeur, garnisseur, monteur, ajusteur, régleur, graveur, vernisseur, metteur en couleur, qui travaille chacun chez soi, et voilà des armes plus ou moins bâclées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
