        "nl-extract.jsonl": [
            {
                "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                "word": "waterwolf",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cd559ead-6ad3-4331-beed-ac3eaede1d8d",
                        "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                        "tags": [
                            "plural"
                        ],
                        "form": "waterwolven"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3148817c-df9a-3201-959c-29285ada67a6",
                        "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                        "glosses": [
                            "overstroming die tot verlies van land leidt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6d86f577-021c-4a63-b1fb-06abb5fdc79e",
                                "sense_id": "3148817c-df9a-3201-959c-29285ada67a6",
                                "text": "Door de waterwolf, de voortdurende afkalving van land, werden de Noord-Hollandse meren steeds groter en dreigde Holland eenvoudigweg te verdwijnen."
                            },
                            {
                                "example_id": "d1aacd8c-b960-49b7-88af-54eca4322e8d",
                                "sense_id": "3148817c-df9a-3201-959c-29285ada67a6",
                                "text": "De Beemster is een onwaarschijnlijk geometrische enclave. (…) Het is een zuiver toonbeeld van de triomf van de mens over het geweld van water, de waterwolf, dat het land eeuwenlang bedreigde."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffd45491-56a5-3ed4-9a87-7f05c89de3b6",
                        "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                        "glosses": [
                            "benaming voor de snoek, Esox lucius"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2e537d6e-303e-49ba-9699-7414e5cd0598",
                                "sense_id": "ffd45491-56a5-3ed4-9a87-7f05c89de3b6",
                                "text": "⧖ Gij ziet de visschen dartelen over de gladde steentjes; de omzichtige ouvel verkiest de diepte, en wantrouwt het struikgewas; omdat hij de listen en de verslindende tanden van den waterwolf - den snoek - vreest."
                            },
                            {
                                "example_id": "61a5b815-b866-4065-83a2-ddaaa96088d7",
                                "sense_id": "ffd45491-56a5-3ed4-9a87-7f05c89de3b6",
                                "text": "⧖ Den Snoeck is oock een gemeene, en bekende Visch. () Dese Visch is een rovende Waterwolf, op alle andere Visschen daer hy van leeft, nochtans is het den Wolfvisch niet, want die onthoudt sich in de Zee, en zoute Wateren, dese wordt daer noyt gesien, maer in soete, en loopende Wateren, en Meeren alleen gevangen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3da9e34-9f09-39c8-95b9-4b8ca163b944",
                        "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                        "glosses": [
                            "bepaald soort monster dat in het water zou leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3060f34-2921-4f18-b14a-ce59924e2624",
                                "sense_id": "d3da9e34-9f09-39c8-95b9-4b8ca163b944",
                                "text": "⧖ Kinderen maakt men bang met den waterwolf, om het spelen aan het water tegen te gaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "2aea1f60-2267-3385-ab3e-4f9019bedf6f",
                        "entry_id": "39089a09-5c61-3c7f-aa10-60b9abfbe591",
                        "glosses": [
                            "iemand die anderen op zee aanvalt en berooft"
                        ],
                        "tags": [
                            "figuratively",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "5d8704b7-6e54-4c48-9674-2c9c635bfc8e",
                                "sense_id": "2aea1f60-2267-3385-ab3e-4f9019bedf6f",
                                "text": "⧖ Hy, Kolgorm, waterwolf, die d'oceaan bereed,\nMaar op Ithornoos kust zijn broeder sneuvlen deed!"
                            }
                        ]
                    }
                ],
