                "senses": [
                    {
                        "sense_id": "a36906fb-1c84-3354-ad75-24e35586dc5c",
                        "entry_id": "7caa3771-71c8-3a44-923b-3e9879a99525",
                        "glosses": [
                            "Geruchswahrnehmung, die von Karamell stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba9c892-99c2-4fbe-95a7-4b26038e5d7d",
                                "sense_id": "a36906fb-1c84-3354-ad75-24e35586dc5c",
                                "text": "„Typisches Zeichen für einen überhitzten Honig ist der Karamellgeruch!“"
                            },
                            {
                                "example_id": "cebbc009-275a-421b-8674-f4d217ec6595",
                                "sense_id": "a36906fb-1c84-3354-ad75-24e35586dc5c",
                                "text": "„Der Zucker beginnt gelblich bis braun zu werden und einen angenehmen Karamellgeruch zu verbreiten.“"
                            },
                            {
                                "example_id": "04c3ba4d-9a54-4474-b120-ee21d235ed80",
                                "sense_id": "a36906fb-1c84-3354-ad75-24e35586dc5c",
                                "text": "„Allerdings wird schon ein ganz leichter, appetitlicher Karamellgeruch verströmt.“"
                            },
                            {
                                "example_id": "48be444b-a34c-4f37-9cde-0dc4942bd8fc",
                                "sense_id": "a36906fb-1c84-3354-ad75-24e35586dc5c",
                                "text": "„Wenn dann ein leichter Karamellgeruch von der Pfanne ausgeht, ist der große Moment gekommen – bemerkt Ihr einen starken Karamellgeruch mit leichtem Brandaroma, könnt Ihr ´ne neue Pfanne kaufen und die Entebrüste ohne Beilage servieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
