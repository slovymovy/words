                                "target_senses": [
                                    {
                                        "sense_id": "9029c40a-d845-34e5-9c37-c39fe2e6cfd7",
                                        "entry_id": "e7eb7418-3fa2-32c4-a92d-d1ce862c2532",
                                        "glosses": [
                                            "Rendre salin, ajouter du sel à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2de7d96-a435-453d-8258-f97336871e9d",
                                                "sense_id": "9029c40a-d845-34e5-9c37-c39fe2e6cfd7",
                                                "text": "Sur le plan agricole, il peut se déverser dans de vastes périmètres irrigués comme ceux qui ont été aménagés sur sa rive sud-ouest, et son eau peut être conduite sur les polders pour arroser sans saliniser."
                                            },
                                            {
                                                "example_id": "dfab4d95-d01b-4928-a432-04541f60bfd8",
                                                "sense_id": "9029c40a-d845-34e5-9c37-c39fe2e6cfd7",
                                                "text": "Ce système a un avantage secondaire pour les sols de ces zones semi-arides qui ont souvent tendance à se saliniser : la submersion par les eaux de crue permet de maîtriser ce phénomène, grâce à un lessivage régulier."
                                            }
                                        ]
                                    }
                                ]
