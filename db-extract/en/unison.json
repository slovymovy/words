                    {
                        "translation_id": "5e3b80eb-10da-49d2-b9f6-bf86c1439291",
                        "source_entry_id": "94745002-6f07-3835-b519-60e01698d613",
                        "source_sense_description": "the state of being together, in harmony, at the same time",
                        "target_lang_word": "Eintracht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eintracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43426c85-2449-3a1c-9515-584368aacb84",
                                        "entry_id": "207955cf-bc40-3374-9f5a-56abb51a7240",
                                        "glosses": [
                                            "gleiche Ansicht/Gesinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017c3d53-81c0-427c-8c48-e4807f7141af",
                                                "sense_id": "43426c85-2449-3a1c-9515-584368aacb84",
                                                "text": "“… Mit der Themis aber vermählte sich Jupiter und erzeugte mit ihr die Eunomia, Dice und Irene, welche auch Horen genannt wurden, Göttinnen der Eintracht befördernden Gerechtigkeit und Gefährtinnen der Grazien, welche, ebenfalls Töchter des Jupiter, Hand in Hand geschlungen, ein schönes Sinnbild wohlwollender Freundschaft sind. …“ (Die alten Götter, Götterehre, z. n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "1bbfb876-bdcd-4ce0-bf4c-5f7bc22a9606",
                                                "sense_id": "43426c85-2449-3a1c-9515-584368aacb84",
                                                "text": "Der Jakobsweg als Symbol der Eintracht und des Friedens in Europa."
                                            },
                                            {
                                                "example_id": "e07b29f7-59ff-4853-9a12-5506da924d86",
                                                "sense_id": "43426c85-2449-3a1c-9515-584368aacb84",
                                                "text": "„Um die fragile Eintracht in ihrer Heimat zu wahren, haben die Siedler die Thinge geschaffen.“"
                                            },
                                            {
                                                "example_id": "86165c30-ebee-4110-b7a0-8327bddbf567",
                                                "sense_id": "43426c85-2449-3a1c-9515-584368aacb84",
                                                "text": "„Die alte Eintracht war wieder da, fast ohne Anlaß, ein einfacher Wunsch, die Cannebière möge endlos sein, die Nachmittagssonne stillstehen, der Kopf des Jungen an meinen Arm gelehnt bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f638d48a-3c1b-31fe-a2a8-3cc0199e6a2b",
                                        "entry_id": "207955cf-bc40-3374-9f5a-56abb51a7240",
                                        "glosses": [
                                            "Name: häufige Bezeichnung von Vereinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da35d367-bd4d-4930-b02c-33ff95d752b7",
                                                "sense_id": "f638d48a-3c1b-31fe-a2a8-3cc0199e6a2b",
                                                "text": "In den Vereinsnamen mancher Sportvereine taucht die Bezeichnung Eintracht auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f5c30b2-62e6-34f6-ac37-19982c5baa3c",
                                        "entry_id": "207955cf-bc40-3374-9f5a-56abb51a7240",
                                        "glosses": [
                                            "Stadtname weltweit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe93313a-c501-4d93-8b66-cbd9ddc4b5f5",
                                                "sense_id": "8f5c30b2-62e6-34f6-ac37-19982c5baa3c",
                                                "text": "Weltweit werden Städte Concordia (Eintracht) genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "7d358e9f-c1b3-3e59-88ec-9d2ca74261e7",
                                        "entry_id": "207955cf-bc40-3374-9f5a-56abb51a7240",
                                        "glosses": [
                                            "ein Asteroid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3966989f-0dc4-4194-ae42-7415f89e5bd9",
                                                "sense_id": "7d358e9f-c1b3-3e59-88ec-9d2ca74261e7",
                                                "text": "Ein Asteroid trägt den Namen Concordia (Eintracht)."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
