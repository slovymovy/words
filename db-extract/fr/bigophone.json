                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c4c611af-5ef7-42cb-b906-297bc892d3d0",
                        "entry_id": "baf96847-23b8-3019-9b60-ec568fc5e997",
                        "tags": [
                            "plural"
                        ],
