        "fr-extract.jsonl": [
            {
                "entry_id": "bd06d66d-7420-3091-88fa-b1493453cfdd",
                "word": "patronat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07e168c0-6050-40a5-bfad-30b817ff9187",
                        "entry_id": "bd06d66d-7420-3091-88fa-b1493453cfdd",
                        "tags": [
                            "plural"
                        ],
                        "form": "patronats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7b8a76f-b249-385c-87b1-4670ad5a72ba",
                        "entry_id": "bd06d66d-7420-3091-88fa-b1493453cfdd",
                        "glosses": [
                            "Ensemble des patrons, des chefs d’entreprise, éventuellement représenté par des organisations."
                        ],
                        "tags": [
                            "Économie",
                            "Socio-économie"
                        ],
                        "examples": [
                            {
                                "example_id": "24f6d81d-12d6-4b1c-9b04-3ce99390d79f",
                                "sense_id": "f7b8a76f-b249-385c-87b1-4670ad5a72ba",
                                "text": "Autant dire que le départ des cinq sociétés industrielles nationalisables de leurs syndicats respectifs laisserait un trou de plusieurs millions de francs par an dans les caisses du patronat."
                            },
                            {
                                "example_id": "3990644d-a0cc-41e8-bdb3-9d1af6c12e95",
                                "sense_id": "f7b8a76f-b249-385c-87b1-4670ad5a72ba",
                                "text": "L’éloge vibrant du libéralisme traditionnel, c’est l’attitude de tous les patronats de la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "726ae306-e2b0-37ba-a4dc-8c97bd0b14c4",
                        "entry_id": "bd06d66d-7420-3091-88fa-b1493453cfdd",
                        "glosses": [
                            "Condition du patron à l’égard du client, dans l’antiquité romaine et le haut moyen-âge."
                        ],
                        "tags": [
                            "Ancient",
                            "Middle-Ages",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "71a85e16-4ab5-4812-b7cf-9e1b5fd4f17f",
                                "sense_id": "726ae306-e2b0-37ba-a4dc-8c97bd0b14c4",
                                "text": "Sous les Mérovingiens et les Carolingiens, l’habitude du patronat n’a fait que se développer, non seulement sous l’influence de coutumes germaniques, mais surtout sous l’effet de l’anarchie régnante."
                            }
                        ]
                    }
                ],
