                "senses": [
                    {
                        "sense_id": "14f8c57d-4a84-3a0e-bbe9-b51a482fb385",
                        "entry_id": "a0112015-95df-367c-b700-271a89e54bb8",
                        "glosses": [
                            "избавить от боли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04f2981-6c94-4880-ac75-4606b1d82e8b",
                                "sense_id": "14f8c57d-4a84-3a0e-bbe9-b51a482fb385",
                                "text": "Сжалься над грешником, обезболь мою душу, очисти и возвысь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd1b4b79-4270-3cce-be37-3e901e03a00d",
                        "entry_id": "a0112015-95df-367c-b700-271a89e54bb8",
                        "glosses": [
                            "мед. искусственно вызвать потерю болевой чувствительности (при хирургической операции, болезненном физиологическом процессе)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a67b707-e4c1-41ab-8be4-e4c360625a25",
                                "sense_id": "bd1b4b79-4270-3cce-be37-3e901e03a00d",
                                "text": "Сделал все, что полагается, ― обезболил, взял щипцы и удалил… соседний с больным совершенно здоровый зуб."
                            }
                        ]
                    }
                ],
