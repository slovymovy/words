                    },
                    {
                        "form_id": "6944b549-9220-41d2-a914-1891b69a67a8",
                        "entry_id": "e3ffd21c-0821-3947-9b81-740eb34195a8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pandeisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aaffd8ff-734e-3fa3-ad17-6c33f5c58a8b",
                        "entry_id": "e3ffd21c-0821-3947-9b81-740eb34195a8",
                        "glosses": [
                            "Anhänger des Pandeismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7e77ed-c141-4b8e-82c5-9b94681ed888",
                                "sense_id": "aaffd8ff-734e-3fa3-ad17-6c33f5c58a8b",
                                "text": "„Nehmen wir einmal an, wir würden das allumfassende Gesetz der Natur finden, nach dem wir suchen, so dass wir schließlich voller Stolz versichern könnten, so und nicht anders ist die Welt aufgebaut – sofort entstünde eine neue Frage: Was steht hinter diesem Gesetz, warum ist die Welt gerade so aufgebaut? Dieses Warum führt uns über die Grenzen der Naturwissenschaft in den Bereich der Religion. Als Fachmann sollte ein Physiker antworten: Wir wissen es nicht, wir werden es niemals wissen. Andere würden sagen, dass Gott dieses Gesetz aufstellte, also das Universum schuf. Ein Pandeist würde vielleicht sagen, dass das allumfassende Gesetz eben Gott sei.\" […]"
                            },
                            {
                                "example_id": "2c888932-a144-48d3-85b2-05345b8eaae0",
                                "sense_id": "aaffd8ff-734e-3fa3-ad17-6c33f5c58a8b",
                                "text": "Pandeisten glauben an Gott aus Gründen der Vernunft, dass Gott das Universum herstellte, und zur gleichen Zeit als das Universum jetzt das Ganze des Gottes ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3289d71e-54dc-45a3-9fe9-69d5d9cbf045",
                        "source_entry_id": "e3ffd21c-0821-3947-9b81-740eb34195a8",
                        "source_sense_id": "aaffd8ff-734e-3fa3-ad17-6c33f5c58a8b",
                        "source_sense_description": "Anhänger des Pandeismus",
                        "target_lang_word": "pandeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pandeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                        "entry_id": "fce166e8-a812-3fc0-b54a-c790760444bf",
                                        "glosses": [
                                            "of or relating to pandeism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f448e5-4b89-496c-a314-cce70caba9a6",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "[Y]ou're drifting somewhere in the Pandeist or Deist dogma, where god is either the Universe itself or is a part of each person."
                                            },
                                            {
                                                "example_id": "6a7aa538-b569-43fc-b628-e4497eee3aa8",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "Indeed, most of the staff is either Hindu or Moslem, but they are full of these pan-deist ideas, and even Zahir deliberately used the Christian word \"God\" rather than \"Allah\" when talking with me."
                                            },
                                            {
                                                "example_id": "3deb4b78-39c4-45c9-bcb1-e73ada01c7b2",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "[S]ome pragmatists (such as William James) took a more pantheist or pandeist approach by rejecting views of God as separate from the World."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pandeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                        "entry_id": "2c224ad3-3fad-3e71-bcfb-c653c4d38332",
                                        "glosses": [
                                            "One who believes in pandeism, a blend of pantheism and deism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849697c1-bf22-48b1-ac8b-9df4e56a746e",
                                                "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                                "text": "Is Gordon a pan-deist, or a monotheist?"
                                            },
                                            {
                                                "example_id": "9fdafb36-b05d-4259-9c69-4ea30fc4e2dd",
                                                "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                                "text": "Does that mean that it holds a majority of Christians as its subjects? That it was founded by Christians? That it must hold only to what Christians say, ignoring Jews, Muslims, non-deists, pandeists, and all other non-Christians?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4416f7fd-5fde-3308-9068-d485748093a5",
                                        "entry_id": "2c224ad3-3fad-3e71-bcfb-c653c4d38332",
                                        "glosses": [
                                            "one who believes in the truth of all religions"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
