                                        "glosses": [
                                            "Egg-shaped; shaped like an oval, but more tapered at one end; ovate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62edb7c9-c073-4078-bcde-d689349b2b12",
                                                "sense_id": "2ba4aa8d-9375-32df-a64e-cf972c9153de",
                                                "text": "And then they were looking at him, Mrs. Ansen's ovoid black eyes behind bifocals attached to a chain, Baffi's beautiful hazel eyes bright with the promise of fun and friendly competition, and what else could Patrick say, other than no, he didn't have anything else going on this afternoon, and yeah, come to think of it, Cokes and leftover pizza would be nice."
                                            }
                                        ]
                                    }
