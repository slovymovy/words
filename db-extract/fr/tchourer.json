                "senses": [
                    {
                        "sense_id": "57db0e5a-442f-37bf-9325-546d3c19a06c",
                        "entry_id": "0a8eae75-5539-30af-9f44-a473fe6e04d4",
                        "glosses": [
                            "Voler, dérober."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3dc5577a-dd87-4c20-b0ce-286258ca4822",
                                "sense_id": "57db0e5a-442f-37bf-9325-546d3c19a06c",
                                "text": "Les voleurs ont des cartes vierges pour tirer les voitures, je vois pas trop ce qui pourrait les empêcher de tchourer les jantes... — (forum Megane RS, site meganers.fr.)"
                            },
                            {
                                "example_id": "8363a163-528c-4fee-92ca-d18d69e65cf4",
                                "sense_id": "57db0e5a-442f-37bf-9325-546d3c19a06c",
                                "text": "La piche tchoure un carbu pour sa bleue, part en bande pour la marave (bagarre), et tant mieux si les gonzes n’y entravent tchi, que dalle (si les gens n’y comprennent rien)."
                            },
                            {
                                "example_id": "ee2de499-4867-4aeb-99bb-a9be982cb8fa",
                                "sense_id": "57db0e5a-442f-37bf-9325-546d3c19a06c",
                                "text": "Ses morts !!! On m'a tchouré ma meule !!!( mobylette )."
                            }
                        ]
                    }
