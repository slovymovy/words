                        "sense_id": "92a9fa24-62fe-3b4e-bf1f-7ac8c619f947",
                        "entry_id": "2d952896-1c1f-326f-b5f7-eb76bc674e84",
                        "glosses": [
                            "Old objects, artifacts, and/or sculptural elements reused in a later work of architecture."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "62621f52-06f8-498f-8180-c9a5d605b8dc",
                                "sense_id": "92a9fa24-62fe-3b4e-bf1f-7ac8c619f947",
                                "text": "In the field of architecture the use of spolia began with Constantine."
                            },
                            {
                                "example_id": "27f22459-93b7-4a59-839f-9d2fe94ff4ec",
                                "sense_id": "92a9fa24-62fe-3b4e-bf1f-7ac8c619f947",
                                "text": "The sultan did not so much destroy and rebuild as adapt and embroider, reusing the gorgeous spolia of the Crusaders with their foliate patterns, capitals and wetleaf acanthus; his architecture is thus constructed with the very symbols of his enemies, which makes it hard to distinguish between the buildings of the Crusaders and Saladin."
                            },
                            {
                                "example_id": "6997eacd-77cf-46b6-bc33-5537826b2d63",
                                "sense_id": "92a9fa24-62fe-3b4e-bf1f-7ac8c619f947",
                                "text": "The conspicuous use of spolia in the Mihaloğlu buildings of the shrine of Syyid Gazi is a remarkable departure from the dominant architectural culture of the time."
                            }
                        ]
                    }
                ],
