                "translations": [
                    {
                        "translation_id": "df68d6bc-3ac5-4105-b0c9-f1f98db61dc9",
                        "source_entry_id": "d9664ee1-f79c-30aa-8564-ba28dff7e405",
                        "target_lang_word": "Unbequemlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbequemlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e88b07c4-5bb5-3301-a82d-38c512365c4a",
                                        "entry_id": "e6371816-becd-35c3-8fe5-c3c471123e42",
                                        "glosses": [
                                            "(Sachverhalt mit der) Eigenschaft, nachteilig/unbequem zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f67fba-fc7c-4e09-98b3-140543ace3f4",
                                                "sense_id": "e88b07c4-5bb5-3301-a82d-38c512365c4a",
                                                "text": "„Keine der Frauen sagt ein Wort, und doch wissen sie, wie sehr es sie alle drei empört, dass Madam nur ihr Geschäft im Kopf hat und Sisis Tod nur eine vorübergehende Unbequemlichkeit für sie zu sein scheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2e174c9-1020-4307-8f8b-ca07003e4d30",
                        "source_entry_id": "d9664ee1-f79c-30aa-8564-ba28dff7e405",
                        "target_lang_word": "désagrément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désagrément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                        "entry_id": "6c5a6f79-73ee-3759-8067-c26aacf58028",
                                        "glosses": [
                                            "Chose désagréable, sujet de chagrin, d’ennui, de dégoût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f942e82e-81ce-48c1-a45c-d716feeb8841",
                                                "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                                "text": "C’est un grand désagrément que d’avoir des procès."
                                            },
                                            {
                                                "example_id": "75e4285f-9fa0-4c67-85e7-32d07797958a",
                                                "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                                "text": "Il a eu, il a essuyé de grands désagréments dans l’exercice de son emploi."
                                            },
                                            {
                                                "example_id": "90ba54c7-2204-45cc-86f3-af320ec53b52",
                                                "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                                "text": "Il s’est attiré des désagréments."
                                            },
                                            {
                                                "example_id": "ff412e01-19f3-454b-b0a9-26b82c1a64e3",
                                                "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                                "text": "On n’en a que du désagrément."
                                            },
                                            {
                                                "example_id": "3a04dbd0-ec0a-4c6c-9738-1591be8a630e",
                                                "sense_id": "10edbadd-98d5-312e-b54e-081f22d6521e",
                                                "text": "Faillible, humain donc, ses faiblesses qui l’amènent à son funeste destin permettent l’identification, la projection des sentiments du spectateur, pouvant susciter un pathos si la cohérence de l’œuvre est suffisante, les péripéties et infortunes diverses produisant un désagrément au fond tellement bienvenu !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
