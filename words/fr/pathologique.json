                    "sense_id": "424ca5d7-4849-3cff-a47d-add7f0b3ccc5",
                    "sense_definition": "Relatif à la pathologie ou provoqué par une maladie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a prescrit un examen <w>pathologique</w> pour analyser ce tissu."
                        },
                        {
                            "text": "Cette fatigue inhabituelle révèle un état <w>pathologique</w> nécessitant des examens approfondis."
                        }
                    ],
                    "synonyms": [
                        "morbide"
                    ],
                    "common_phrases": [
                        "état pathologique",
                        "examen pathologique",
                        "anatomie pathologique"
                    ]
                },
                {
                    "sense_id": "2f7ab203-76e5-3e88-b4f8-e1c1dd680a1d",
                    "sense_definition": "Qui relève d'une anomalie psychologique ou comportementale, maladif et excessif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa jalousie <w>pathologique</w> a fini par détruire leur vie de couple."
                        },
                        {
                            "text": "Ce menteur <w>pathologique</w> invente sans cesse des histoires pour se valoriser."
                        }
                    ],
                    "synonyms": [
                        "maladif",
                        "anormal",
                        "obsessionnel"
                    ],
                    "common_phrases": [
                        "menteur pathologique",
                        "jalousie pathologique"
                    ]
                },
                {
                    "sense_id": "e80a0541-e486-39d8-a004-4d47abbfd799",
                    "sense_definition": "Qualifie un cas particulier, atypique ou contre-intuitif ne vérifiant pas les propriétés générales usuelles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fonction continue mais non dérivable constitue un cas <w>pathologique</w> bien connu des mathématiciens."
                        },
                        {
                            "text": "Les chercheurs évitent d'appliquer cet algorithme à des structures géométriques <w>pathologiques</w>."
                        }
                    ],
                    "synonyms": [
                        "atypique",
                        "anormal"
                    ],
                    "common_phrases": [
                        "cas pathologique",
                        "fonction pathologique"
                    ]
                },
                {
                    "sense_id": "47ac3a0f-92ed-3353-803b-c1b1ef5e4f8b",
                    "sense_definition": "Qui dépend des inclinations naturelles et de la sensibilité passive plutôt que de la raison pure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kant distingue l'amour <w>pathologique</w> de l'amour pratique guidé par le devoir moral."
                        },
                        {
                            "text": "Une motivation purement <w>pathologique</w> ne peut pas fonder une action universelle."
                        }
                    ],
                    "antonyms": [
                        "pratique"
                    ],
                    "common_phrases": [
                        "amour pathologique"
                    ]
                }
            ]
        }
