                        "entry_id": "8995e8b1-0f72-3fc2-8abc-39aeaeefbe8b",
                        "glosses": [
                            "Any of several South American and Central American birds of prey in the subfamily Caracarinae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676edd59-e115-46a6-974c-9b46831f9cc3",
                                "sense_id": "df3fcfa5-b208-3efe-88dc-15c3990fa0f3",
                                "text": "The caracara's flight is direct and rapid, not at all like that of the vulture, which sails and soars in spirals."
                            },
                            {
                                "example_id": "50e71deb-7150-4113-9998-5d1a87b87b10",
                                "sense_id": "df3fcfa5-b208-3efe-88dc-15c3990fa0f3",
                                "text": "A few still live on the remote coasts of Tierra del Fuego, and though warrahs and gauchos vanished from the Falklands soon after Darwin's visit, striated caracaras still cling to life on the archipelago's outer islands, where they hunt and scavenge in colonies of penguins, seals, and albatrosses."
                            }
                        ]
                    }
