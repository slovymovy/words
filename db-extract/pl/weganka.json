                        "entry_id": "d13d7dbc-9b66-3dd0-8c4e-3f72dadbbc9b",
                        "glosses": [
                            "kobieta przestrzegająca zasad weganizmu, będąca na diecie wegańskiej, nie jedząca pokarmów pochodzenia zwierzęcego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d24867d-2d17-42fc-bd67-63ce6c65e0df",
                                "sense_id": "d21423c6-c2d3-312b-b94f-e911b75a84d0",
                                "text": "Jest weganką i tego nie zmieni. Gdy dosiada konia nie używa bata i zakłada najmniejsze i najłagodniej zakończone ostrogi"
                            }
                        ],
