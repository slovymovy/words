                "senses": [
                    {
                        "sense_id": "0abff40a-f54c-3c89-a9c6-0e91b3e815ec",
                        "entry_id": "daf5ecd9-6f9b-3332-98f0-b251cfc57a42",
                        "glosses": [
                            "Infection à arbovirus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d7a858-61a1-4186-a073-56552ba737e9",
                                "sense_id": "0abff40a-f54c-3c89-a9c6-0e91b3e815ec",
                                "text": "L’arbovirose la plus connue est la fièvre jaune. Elle est à l’origine d’épidémie^([sic]) redoutables et étendues en Afrique et en Amérique."
                            },
                            {
                                "example_id": "abf2f041-88e7-4337-bcdb-ea310fbb31b7",
                                "sense_id": "0abff40a-f54c-3c89-a9c6-0e91b3e815ec",
                                "text": "La fièvre jaune est une arbovirose, c’est-à-dire une maladie virale transmise par des arthropodes hématophages (moustiques). Elle n’est présente que dans les régions tropicales d’Afrique et d’Amérique du Sud."
                            },
                            {
                                "example_id": "d8cb4b47-4074-4113-80b0-21db77661f05",
                                "sense_id": "0abff40a-f54c-3c89-a9c6-0e91b3e815ec",
                                "text": "La dengue (en anglais, dengue fever), une arbovirose endémique transmise par un moustique et qui se traduit par une forte fièvre accompagnée de douleurs diffuses, vient de l’expression swahilie ki denga pepo, littéralement « crampes causées par un esprit malin »."
                            }
                        ]
                    }
                ],
