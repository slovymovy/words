                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c04f1ce-a1d5-4550-afa7-43df8719c4f5",
                                "sense_id": "0072a2b8-baa3-3b26-9bb2-77c62a386849",
                                "text": "„90% der Westberliner S-Bahn-Fahrgäste leisten dem Boykottaufruf des Deutschen Gewerkschaftsbundes Folge und meiden die unter Ostberliner Betriebshoheit fahrende S-Bahn in den Westsektoren.“"
                            },
                            {
                                "example_id": "eca23559-e188-47c3-ae57-603af29166e3",
                                "sense_id": "0072a2b8-baa3-3b26-9bb2-77c62a386849",
                                "text": "„Sable erklärte, der Brief mit dem Boykottaufruf sei von ihm und seinem Bruder verfasst worden.“"
                            },
                            {
                                "example_id": "20e0bac5-30b3-4bc6-bb30-49f6aa2b3cab",
                                "sense_id": "0072a2b8-baa3-3b26-9bb2-77c62a386849",
                                "text": "„Boykottaufrufe sind in der Türkei keine Seltenheit.“"
                            },
                            {
                                "example_id": "684b1f0e-3e11-4e96-8eed-1e261306c2e2",
                                "sense_id": "0072a2b8-baa3-3b26-9bb2-77c62a386849",
                                "text": "[Boykottaktionen gegen jüdische Gewerbetreibende und jüdische Geschäfte in den 20er und 30er Jahren:] „Die Boykottaufrufe trugen als Allererstes dazu bei, die Unterscheidung von ,deutsch' und ,jüdisch' im Alltag zu etablieren und ihr formuliertes Ziel war der dauerhafte Ausschluss von Menschen aus der deutschen Wirtschaft und Gesellschaft, aufgrund ihres angeblichen Andersseins, ihres Judentums.“"
                            }
                        ],
