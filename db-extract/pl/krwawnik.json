                                            "generell ein Vertreter der Gattung der Scharfgarben (Achillea), neben der Gemeinen Schafgarbe [1] etwa 200 weitere Arten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb2ec3d-52c2-44e6-ae05-ea3573400b52",
                                                "sense_id": "0e85c7eb-876c-317e-afcc-0ccfd6abba53",
                                                "text": "Schafgarben sind weltweit verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schafgarbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                        "entry_id": "36f04f51-268a-32f6-8b6d-b0f6a62cc57a",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname mit seltenem Vorkommen in Norddeutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3f5f74-b247-4913-bab6-04fa54e517a8",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Der Schafgarbe trägt nie die Pullover, die die Schafgarbe ihm strickt."
                                            },
                                            {
                                                "example_id": "d451c793-7457-4bb5-82f3-cac852eb2e79",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Frau Schafgarbe ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "292addd8-781d-42cf-8399-fc98c46d3cce",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Herr Schafgarbe wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "837e3805-becb-4f5d-bb69-9c78b527afaf",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Die Schafgarbes fliegen heute nach Helsinki."
                                            },
                                            {
                                                "example_id": "63aa3efa-462d-44ae-923f-74ed12c496d6",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schafgarbe kommt, geht der Herr Schafgarbe.“"
                                            },
                                            {
                                                "example_id": "66451142-ba51-4192-881e-71fb59e03967",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Schafgarbe kommt und geht."
                                            },
                                            {
                                                "example_id": "c057346f-1bdf-430e-ad43-03bed9f5882d",
                                                "sense_id": "5b6e4a58-50d6-34e8-9342-5801a0afa3fa",
                                                "text": "Schafgarbes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
