{
    "word_family": [
        "art",
        "artist",
        "artistically",
        "artistry",
        "artwork",
        "inartistic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "833de762-6964-3448-9459-cb80448fa28d",
                    "sense_definition": "Relating to or characteristic of art or artists.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum is famous for its valuable <w>artistic</w> treasures.",
                            "target_lang_translations": {
                                "ru": "Музей славится своими ценными <w>художественными</w> сокровищами.",
                                "zh": "这家博物馆以其珍贵的<w>艺术</w>珍藏而闻名。"
                            }
                        },
                        {
                            "text": "She was appointed as the <w>artistic</w> director of the theater company.",
                            "target_lang_translations": {
                                "ru": "Она была назначена <w>художественным</w> руководителем театральной труппы.",
                                "zh": "她被任命为这家剧团的<w>艺术</w>总监。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "artistic director",
                        "artistic expression",
                        "artistic freedom",
                        "artistic community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искусству или свойственный художникам и артистам.",
                        "zh": "与艺术有关的，或具有艺术家、艺术作品特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "художественный",
                                "target_lang_sense_clarification": "относящийся к произведениям искусства"
                            },
                            {
                                "target_lang_word": "артистический",
                                "target_lang_sense_clarification": "свойственный артистам или профессиональной среде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艺术的",
                                "target_lang_sense_clarification": "与艺术或艺术作品有关"
                            },
                            {
                                "target_lang_word": "艺术性的",
                                "target_lang_sense_clarification": "强调具有艺术特征或艺术属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de59e5f2-4d9b-3cff-b8de-2fd00e69ed30",
                    "sense_definition": "Having or revealing creative skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother is very <w>artistic</w> and loves to paint landscapes.",
                            "target_lang_translations": {
                                "ru": "Мой брат очень <w>творческий</w> и любит писать пейзажи.",
                                "zh": "我哥哥很<w>有艺术天赋</w>，而且喜欢画风景画。"
                            }
                        },
                        {
                            "text": "The child showed great <w>artistic</w> talent at a very young age.",
                            "target_lang_translations": {
                                "ru": "Ребёнок проявил огромный <w>художественный</w> талант в очень раннем возрасте.",
                                "zh": "这个孩子很小就显得非常<w>有艺术天赋</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "artistic talent",
                        "artistic ability",
                        "artistic skill",
                        "artistic nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий творческими способностями или талантом.",
                        "zh": "具有或表现出创造性才能的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "творческий",
                                "target_lang_sense_clarification": "креативный, созидательный"
                            },
                            {
                                "target_lang_word": "артистичный",
                                "target_lang_sense_clarification": "обладающий художественным вкусом или талантом"
                            },
                            {
                                "target_lang_word": "одарённый",
                                "target_lang_sense_clarification": "талантливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有艺术天赋的",
                                "target_lang_sense_clarification": "有进行绘画、设计等艺术创作的天赋"
                            },
                            {
                                "target_lang_word": "有创造力的",
                                "target_lang_sense_clarification": "强调有创作能力、富于创意"
                            },
                            {
                                "target_lang_word": "有艺术才华的",
                                "target_lang_sense_clarification": "强调具备艺术方面的才能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2274d33-b42f-33a0-bfdb-c244b342b3da",
                    "sense_definition": "Aesthetically pleasing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef arranged the food on the plate in a very <w>artistic</w> way.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар разложил еду на тарелке весьма <w>художественным</w> образом.",
                                "zh": "主厨把盘中的食物摆得非常<w>雅致</w>。"
                            }
                        },
                        {
                            "text": "Her apartment is full of <w>artistic</w> decorations and unique furniture.",
                            "target_lang_translations": {
                                "ru": "Её квартира полна <w>художественных</w> украшений и уникальной мебели.",
                                "zh": "她的公寓里满是<w>富有艺术感的</w>装饰和独特的家具。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inartistic"
                    ],
                    "common_phrases": [
                        "artistic design",
                        "artistic arrangement",
                        "artistic merit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эстетически приятный; сделанный со вкусом и мастерством.",
                        "zh": "在审美上令人愉悦的；看起来有美感的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "художественный",
                                "target_lang_sense_clarification": "эстетичный, красивый"
                            },
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "мастерский, умелый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有美感的",
                                "target_lang_sense_clarification": "看起来美观、令人赏心悦目"
                            },
                            {
                                "target_lang_word": "雅致的",
                                "target_lang_sense_clarification": "风格精致而好看"
                            },
                            {
                                "target_lang_word": "富有艺术感的",
                                "target_lang_sense_clarification": "带有审美设计感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6970c02c-4e09-34f7-9892-5a93e7b0e839",
                    "sense_definition": "Euphemistic form of <w>autistic</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some users on that forum use the word <w>artistic</w> as a code word.",
                            "target_lang_translations": {
                                "ru": "Некоторые пользователи на этом форуме используют слово <w>«артистичный»</w> как кодовое.",
                                "zh": "那个论坛里有些用户把“<w>艺术的</w>”这个词当作“autistic”的代称。"
                            }
                        },
                        {
                            "text": "He made a joke about being <w>artistic</w> that no one understood.",
                            "target_lang_translations": {
                                "ru": "Он пошутил о том, что он <w>«артистичный»</w>, но никто не понял.",
                                "zh": "他开玩笑说自己很“<w>艺术的</w>”，但谁也没听懂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acoustic"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang, often offensive or ironic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эвфемизм для слова «аутичный» (сленг, основанный на созвучии).",
                        "zh": "“autistic”的一种委婉或戏谑说法，常见于网络俚语，通常带冒犯性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«артистичный»",
                                "target_lang_sense_clarification": "эвфемизм для «аутичный» (по созвучию)"
                            }
                        ],
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a0e3fd75-581d-34c6-a46a-37a4023cc81d",
                    "sense_definition": "Artistically; in an artistic style.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to paint the wall <w>artistic</w>, but it just looked messy.",
                            "target_lang_translations": {
                                "ru": "Он пытался покрасить стену <w>художественно</w>, но получилось просто неряшливо.",
                                "zh": "他试着<w>艺术化地</w>粉刷那面墙，但结果看起来还是乱糟糟的。"
                            }
                        },
                        {
                            "text": "You have to do it <w>artistic</w> if you want it to sell.",
                            "target_lang_translations": {
                                "ru": "Ты должен сделать это <w>художественно</w>, если хочешь, чтобы это продавалось.",
                                "zh": "如果你想让它卖得出去，就得<w>艺术化地</w>处理它。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "non-standard usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Художественно; в художественном стиле (разговорное употребление).",
                        "zh": "以艺术化的方式；用有艺术风格的方式（口语中的非标准用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "художественно",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艺术化地",
                                "target_lang_sense_clarification": "以带有艺术效果的方式"
                            },
                            {
                                "target_lang_word": "富有艺术性地",
                                "target_lang_sense_clarification": "以有艺术风格的方式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}