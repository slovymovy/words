                ],
                "senses": [
                    {
                        "sense_id": "517dcb2a-7e38-3cc9-b569-7e44977edbbd",
                        "entry_id": "ac9f093c-a245-345c-9da8-e284f64b101e",
                        "glosses": [
                            "Sauvegarder une partie de la mémoire centrale sur un périphérique de stockage pour la libérer pour utilisation par un programme qui en a besoin."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "9ee235cd-0f20-446a-bd87-269642ffd28f",
                                "sense_id": "517dcb2a-7e38-3cc9-b569-7e44977edbbd",
                                "text": "Cela permet de swapper la totalité de la mémoire physique attribuée."
                            },
                            {
                                "example_id": "e8dae042-2b9d-478c-b2bd-0cfc473e017b",
                                "sense_id": "517dcb2a-7e38-3cc9-b569-7e44977edbbd",
                                "text": "Après une enquête dans les entrailles du système, l'un des coupables s'est dénoncé : la swappiness, ou tendance du système à swapper...."
                            }
                        ]
                    },
                    {
                        "sense_id": "58b520a0-1e88-307c-a422-da8ba820f2f3",
                        "entry_id": "ac9f093c-a245-345c-9da8-e284f64b101e",
                        "glosses": [
                            "Intervertir."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b6eadbad-fffc-4c39-b60a-33b32d4097e8",
                                "sense_id": "58b520a0-1e88-307c-a422-da8ba820f2f3",
                                "text": "Votre travail est de swapper les personnages, c'est votre job."
                            }
                        ]
                    },
                    {
                        "sense_id": "af906428-c856-33db-a8b7-a3589be10d56",
                        "entry_id": "ac9f093c-a245-345c-9da8-e284f64b101e",
                        "glosses": [
                            "Échanger des titres financiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379ff8d2-47ab-4b68-9929-c0ae09e10939",
                                "sense_id": "af906428-c856-33db-a8b7-a3589be10d56",
                                "text": "Elles ont alors tout intérêt à emprunter chacune sur le marché où le taux d’emprunt leur est le plus favorable et échanger (« swapper ») ensuite leurs emprunts respectifs."
                            },
                            {
                                "example_id": "99187598-b285-4537-a9f2-3b0abd1c1fb6",
                                "sense_id": "af906428-c856-33db-a8b7-a3589be10d56",
                                "text": "Les perturbations sur le marché primaire entre mai et décembre 1992, ont conduit de nombreux opérateurs à swapper leurs titres, gelant ainsi une partie des titres disponibles."
                            }
                        ]
                    }
                ],
