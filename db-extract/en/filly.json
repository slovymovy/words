                                        "glosses": [
                                            "спец. крючок, скрепляющий между собой театральные декорации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97432b59-2138-4a7d-9b56-9b3457cdf6be",
                                                "sense_id": "e2124da2-fd3b-370d-99cf-ae4144b07f52",
