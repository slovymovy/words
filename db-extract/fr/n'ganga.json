                        "examples": [
                            {
                                "example_id": "948aa9de-aa52-402a-a39a-a02c69f285ff",
                                "sense_id": "15b22bb8-e28c-31db-9716-a2aec3c76802",
                                "text": "J’ai dit et je maintiens que Moyombé avait tué mon fils. Mais il y a n’ganga et n’ganga. Moyombé n’était qu’un vulgaire féticheur, borné et sale. En ce domaine, il convient de ne pas condamner en bloc. Là aussi je tenais à faire cette fameuse « part des choses ». Dans certains cas, la médecine gabonaise peut avoir du bon."
                            },
                            {
                                "example_id": "39cbc672-b7f1-4e37-b405-f073b4d2c709",
                                "sense_id": "15b22bb8-e28c-31db-9716-a2aec3c76802",
                                "text": "Le n’ganga n’est pas un sorcier ; il est même le contraire du sorcier, qui, lui, ne fait pas profession de soigner, mais au contraire de nuire."
                            }
                        ]
                    }
