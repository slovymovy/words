                    },
                    {
                        "translation_id": "4d9c6099-13fb-490f-aca5-e630233699ab",
                        "source_entry_id": "99eaa03b-8cf7-3739-8d56-82c48ea4c79a",
                        "source_sense_id": "35f998ef-d7b2-37cf-b43c-2b45437a7043",
                        "target_lang_word": "hyperaccumulator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperaccumulator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7017489f-8512-3b4d-a87c-e5f8b3421e97",
                                        "entry_id": "567378b1-0744-3c8f-9fab-2a6ebb418401",
                                        "glosses": [
                                            "Any plant that can accumulate large quantities of trace elements from its environment, and thus may be used in phytoremediation or phytomining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263752f9-0d4c-4624-acd1-1c322f2dd861",
                                                "sense_id": "7017489f-8512-3b4d-a87c-e5f8b3421e97",
                                                "text": "Also, the progress of constructing ideal hyperaccumulators by using biological technologies is slow."
                                            },
                                            {
                                                "example_id": "88ffd2db-2791-44e2-a200-b76a455b6981",
                                                "sense_id": "7017489f-8512-3b4d-a87c-e5f8b3421e97",
                                                "text": "Hyperaccumulator species are able to accumulate higher metal concentrations in their shoots than surrounding nonaccumulator plants, even from soils containing nonphytotoxic background levels of metals [35-37]."
                                            },
                                            {
                                                "example_id": "2fa85d02-244a-4a46-921a-e10329042e56",
                                                "sense_id": "7017489f-8512-3b4d-a87c-e5f8b3421e97",
                                                "text": "To date, over 400 species have been identified as hyperaccumulators, with this number increasing continuously as new species are identified (Baker et al., 2000)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
