                            {
                                "target_lang_word": "наклонился",
                                "target_lang_sense_clarification": "о движении тела вниз"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "schylił się",
                                "target_lang_sense_clarification": "o ruchu ciała w dół"
                            },
                            {
                                "target_lang_word": "wygiął się",
