                                    {
                                        "sense_id": "0e2e739b-f83b-376e-afc9-be874e009303",
                                        "entry_id": "3b1f3115-f8d6-3ec3-9a33-12e0f4bf2f79",
                                        "glosses": [
                                            "spadek ciśnienia w zamkniętej przestrzeni, wywołany umyślnie lub spowodowane uszkodzeniem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ac401a-4935-41e2-80cd-7db5f06e32a1",
                                                "sense_id": "0e2e739b-f83b-376e-afc9-be874e009303",
                                                "text": "Przy dużych uszkodzeniach kadłuba gwałtowna dekompresja może wyssać z kabiny nie tylko bagaż podręczny, ale i osoby znajdujące się w pobliżu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "4d899cfa-e58d-33ff-84c0-1868a2624549",
                                        "entry_id": "3b1f3115-f8d6-3ec3-9a33-12e0f4bf2f79",
                                        "glosses": [
                                            "stopniowe zmniejszanie ciśnienia działającego na osobę wynurzającą się z dużej głębokości w celu zapobiegnięcia chorobie dekompresyjnej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b10c1a-2723-47fa-84e0-90f024e4be4c",
                                                "sense_id": "4d899cfa-e58d-33ff-84c0-1868a2624549",
                                                "text": "W XVII wieku zawód nurka był bardzo niebezpieczny. Nie znano wówczas jeszcze techniki dokonywania dekompresji i po dłuższym nurkowaniu, zwłaszcza na większych głębokościach, czuli się oni źle i często nawet poważnie chorowali."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "1d5cca4e-9b33-31b3-a9cf-c624d9071437",
                                        "entry_id": "3b1f3115-f8d6-3ec3-9a33-12e0f4bf2f79",
                                        "glosses": [
                                            "przywrócenie pierwotnego rozmiaru informacji, której rozmiar został uprzednio zmniejszony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6474c77d-8d09-4f6f-bc50-57590c883483",
                                                "sense_id": "1d5cca4e-9b33-31b3-a9cf-c624d9071437",
                                                "text": "Problemy mogą wystąpić podczas dekompresji poprzedzającej skanowanie plików RAR np. w załącznikach pocztowych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
