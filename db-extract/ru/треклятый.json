                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "Their damned lawyers can go to hell."
                                            },
                                            {
                                                "example_id": "e3f40b3c-c157-4595-a7cb-d94babc632ae",
                                                "sense_id": "d9e12883-4696-33ce-81cf-b502615c7f1d",
                                                "text": "I can't get this damned thing to work."
                                            }
                                        ]
                                    },
