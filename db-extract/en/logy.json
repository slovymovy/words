                        "examples": [
                            {
                                "example_id": "948c6e28-2643-4add-88ab-8cae6b02d488",
                                "sense_id": "ada88480-50db-37e5-be35-f9f0976555a0",
                                "text": "The steering seems logy; you have to turn the wheel well before you want to turn."
                            },
                            {
                                "example_id": "3279bfc8-0225-44b8-867f-5945c7aad476",
                                "sense_id": "ada88480-50db-37e5-be35-f9f0976555a0",
                                "text": "Perkins discovered his prize duck in a logy condition."
                            },
                            {
                                "example_id": "040bc2de-8817-490b-8f24-da0a4af4c962",
                                "sense_id": "ada88480-50db-37e5-be35-f9f0976555a0",
                                "text": "I was still logy with sleep; I shook my head to try to clear it."
                            },
                            {
                                "example_id": "9c73b718-f40a-4420-b75b-8fe1567fdac9",
                                "sense_id": "ada88480-50db-37e5-be35-f9f0976555a0",
                                "text": "“So then you stumble into another bunch of cocaine in the jungle, and then continue stumbling into a bean bagging arms dealer so that now almost inexplicably we have enough weapons to invade Quebec.” “Wait, literally?” “No, Krieger. Not literally.” “Aw.” “Lame.” “Well, if we ever do, the best time to invade is right after brunch when they're all logy.” “Archer?” “I don't know. I mean, it couldn't hurt, but--” “Still talking about this, not invading Quebec.”"
                            }
                        ]
