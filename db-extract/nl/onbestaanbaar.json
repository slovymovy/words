                        "examples": [
                            {
                                "example_id": "6237221e-849d-4b06-b592-3abe6afd92d1",
                                "sense_id": "e0abfe2f-9493-3374-bd58-4af020ebf4eb",
                                "text": "Precies daarin verschilt de VVD van de PVV, die steeds meer is gaan uitsluiten dat ‘moslims’ en ‘Nederlanderschap’ ooit nog samen kunnen gaan: de islam moet volgens de PVV simpelweg uit Nederland verdwijnen, een ‘islamitische Nederlander’ is onbestaanbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "1524f369-4374-3d4d-90ce-1528ef6e6afc",
                        "entry_id": "6e897f7e-44c2-32a6-a575-23c41f9908ba",
                        "glosses": [
                            "onacceptabel, dat iets niet zou mogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91eb8ad-0abb-4092-9703-fc4c067d9c43",
                                "sense_id": "1524f369-4374-3d4d-90ce-1528ef6e6afc",
                                "text": "Dat de regering de opgevraagde documenten niet aan het parlement heeft overhandigd vind ik onbestaanbaar."
                            }
                        ]
                    }
