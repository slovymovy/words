                                "example_id": "051f6fdc-eef4-46a8-bec0-bfe6c4191170",
                                "sense_id": "b93472fa-6daa-3bc7-9053-91148ebaffad",
                                "text": "„Abfertigungsgebäude erleichtern die Verteilung der Passagiere und der Fracht.“"
