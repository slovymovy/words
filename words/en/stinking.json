{
    "word_family": [
        "stink",
        "stinker",
        "stinky"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49950266-b333-3def-8666-45c8267e4da2",
                    "sense_definition": "Foul-smelling; having an offensive or pungent odor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "odor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen was filled with a <w>stinking</w> pile of rotten vegetables.",
                            "target_lang_translations": {
                                "ru": "Кухня была завалена <w>вонючей</w> кучей гнилых овощей."
                            }
                        },
                        {
                            "text": "He took off his shoes and left behind a pair of <w>stinking</w> socks.",
                            "target_lang_translations": {
                                "ru": "Он снял ботинки и оставил после себя пару <w>вонючих</w> носков."
                            }
                        }
                    ],
                    "synonyms": [
                        "foul-smelling",
                        "malodorous",
                        "smelly",
                        "stinky"
                    ],
                    "antonyms": [
                        "fragrant",
                        "sweet-smelling"
                    ],
                    "common_phrases": [
                        "stinking garbage",
                        "stinking mess"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сильный, отвратительный или резкий запах; источающий зловоние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонючий",
                                "target_lang_sense_clarification": "очень неприятно пахнущий"
                            },
                            {
                                "target_lang_word": "зловонный",
                                "target_lang_sense_clarification": "испускающий дурной запах (более книжное)"
                            },
                            {
                                "target_lang_word": "смрадный",
                                "target_lang_sense_clarification": "тяжело и неприятно пахнущий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9190ed8-c46e-30d4-8ff2-b202bf756802",
                    "sense_definition": "Very bad, severe, or unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to stay in bed all weekend because of a <w>stinking</w> cold.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось пролежать в постели все выходные из-за <w>паршивой</w> простуды."
                            }
                        },
                        {
                            "text": "She was in a <w>stinking</w> mood after missing the morning train.",
                            "target_lang_translations": {
                                "ru": "Она была в <w>скверном</w> настроении после того, как опоздала на утренний поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "dreadful",
                        "terrible",
                        "wretched"
                    ],
                    "common_phrases": [
                        "stinking cold",
                        "stinking mood"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used conversationally to describe an unpleasant condition or mood"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой, тяжелый, отвратительный или крайне неприятный (о состоянии, настроении, болезни)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "очень плохой, гадкий"
                            },
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "дурной, скверный"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "крайне тяжелый, неприятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01660e27-8ff9-3f26-9636-33b7a3f822fc",
                    "sense_definition": "Used as an intensifier expressing contempt, disgust, or intense annoyance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keep your money, because I don't want your <w>stinking</w> charity.",
                            "target_lang_translations": {
                                "ru": "Оставь свои деньги себе, потому что мне не нужна твоя <w>подачка</w>."
                            }
                        },
                        {
                            "text": "We worked hard all day and received not one <w>stinking</w> cent.",
                            "target_lang_translations": {
                                "ru": "Мы тяжело трудились весь день и не получили ни одного <w>чёртова</w> цента."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasted",
                        "confounded",
                        "cursed",
                        "lousy"
                    ],
                    "common_phrases": [
                        "stinking rich",
                        "stinking badges"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an emphatic expression of contempt"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употребляется как экспрессивное слово для выражения презрения, раздражения или отвращения к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "презрительно о чем-то ненавистном"
                            },
                            {
                                "target_lang_word": "чёртов",
                                "target_lang_sense_clarification": "эмоциональное ругательство"
                            },
                            {
                                "target_lang_word": "дурацкий",
                                "target_lang_sense_clarification": "раздражающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a435e18-60dd-3969-b248-b61bfd358cce",
                    "sense_definition": "Extremely intoxicated from alcohol.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drunk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got completely <w>stinking</w> at the party and barely remembered anything.",
                            "target_lang_translations": {
                                "ru": "На вечеринке он напился <w>в стельку</w> и почти ничего не помнил."
                            }
                        },
                        {
                            "text": "They were already <w>stinking</w> drunk before the concert had even started.",
                            "target_lang_translations": {
                                "ru": "Они были уже <w>мертвецки</w> пьяны еще до начала концерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "hammered",
                        "plastered",
                        "wasted"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "stinking drunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for severe intoxication"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно, сильно пьяный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный в стельку",
                                "target_lang_sense_clarification": "в состоянии сильнейшего алкогольного опьянения"
                            },
                            {
                                "target_lang_word": "мертвецки пьяный",
                                "target_lang_sense_clarification": "до потери сознания или контроля"
                            },
                            {
                                "target_lang_word": "в хлам",
                                "target_lang_sense_clarification": "разг. сильно пьяный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21ff3220-dabf-38a9-90b9-cea71c353e8b",
                    "sense_definition": "Present participle and gerund of <w>stink</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trash can was <w>stinking</w> up the entire hallway.",
                            "target_lang_translations": {
                                "ru": "Мусорное ведро <w>завоняло</w> всю прихожую."
                            }
                        },
                        {
                            "text": "He walked inside after practice, <w>stinking</w> of heavy sweat.",
                            "target_lang_translations": {
                                "ru": "Он зашел внутрь после тренировки, <w>расточая</w> сильный запах пота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stinking out",
                        "stinking up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени или герундия от глагола stink (вонять, смердеть)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воняющий",
                                "target_lang_sense_clarification": "причастие, издающий дурной запах"
                            },
                            {
                                "target_lang_word": "смердящий",
                                "target_lang_sense_clarification": "причастие, сильно воняющий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cc7a026-a178-30b8-a83a-0aa3f92121c8",
                    "sense_definition": "The act or instance of emitting a foul smell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "odor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marshland was known for the sudden <w>stinkings</w> that drifted across the village.",
                            "target_lang_translations": {
                                "ru": "Болотистая местность была известна внезапными <w>волнами зловония</w>, доносившимися до деревни."
                            }
                        },
                        {
                            "text": "Continuous <w>stinking</w> from the chemical factory alarmed the local residents.",
                            "target_lang_translations": {
                                "ru": "Непрерывная <w>вонь</w> от химического завода тревожила местных жителей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или случай испускания неприятного запаха; вонь, зловоние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловоние",
                                "target_lang_sense_clarification": "дурной запах, смрад"
                            },
                            {
                                "target_lang_word": "вонь",
                                "target_lang_sense_clarification": "резкий неприятный запах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}