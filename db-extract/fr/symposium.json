                                        "entry_id": "c9cf0cce-a574-35c4-9f92-a632e2695e27",
                                        "glosses": [
                                            "gemeinsames, geselliges (Wein-)Trinken im alten Griechenland, bei dem auch improvisierte Reden zu bestimmten Themen gehalten wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04d219c-edd8-451f-acbf-cdf90bccae38",
                                                "sense_id": "5c3baaad-8e24-3808-b147-b118ad4d2eb4",
                                                "text": "Bei einem Symposion wurde der erste Schluck Wein zu Ehren des guten Geistes Daimon aus einem edlen Kantharos getrunken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cdec1e6f-8f35-34a2-94a7-b8198d8d2cf9",
                                        "entry_id": "c9cf0cce-a574-35c4-9f92-a632e2695e27",
                                        "glosses": [
                                            "Zusammenkunft von Wissenschaftlern zum Zwecke des Austausches von Erkenntnissen und Gedanken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9cc2fe-0ee7-4e8e-8ce8-b14e26d08e68",
                                                "sense_id": "cdec1e6f-8f35-34a2-94a7-b8198d8d2cf9",
                                                "text": "Es wurden mehrere Symposien zu speziellen Themen der Neurologie angeboten."
                                            },
                                            {
                                                "example_id": "6dc1f4ae-7448-4e19-9158-c712239b1e1b",
                                                "sense_id": "cdec1e6f-8f35-34a2-94a7-b8198d8d2cf9",
                                                "text": "„Eines der angestammten Rituale aller Kongresse, Konferenzen, Symposien und Seminare ist der Begrüßungscocktail am Vorabend des offiziellen Tagungsbeginns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66f12195-363d-3549-b6e5-d711fc64ea78",
                                        "entry_id": "c9cf0cce-a574-35c4-9f92-a632e2695e27",
                                        "glosses": [
                                            "wissenschaftlicher Sammelband"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
