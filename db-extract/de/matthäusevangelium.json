                "senses": [
                    {
                        "sense_id": "ee21ec3d-6579-34c7-babf-d0994cd27dc8",
                        "entry_id": "1c8811b7-9e2d-3992-8ed0-a33b36a1949f",
                        "glosses": [
                            "erstes Buch der Bibel im Neuen Testament"
                        ],
                        "tags": [
                            "Bibel"
                        ],
                        "examples": [
                            {
                                "example_id": "86a54f10-2b68-4a55-ab5c-47323afe0ab0",
                                "sense_id": "ee21ec3d-6579-34c7-babf-d0994cd27dc8",
                                "text": "Das Matthäusevangelium gehört zu den drei synoptischen Evangelien."
                            },
                            {
                                "example_id": "beb96bce-6730-4b27-beb9-5bb2f5a75573",
                                "sense_id": "ee21ec3d-6579-34c7-babf-d0994cd27dc8",
                                "text": "Die genaue Entstehungszeit des Matthäusevangeliums ist umstritten; sie liegt zwischen 70 und 100."
                            },
                            {
                                "example_id": "87408fff-0936-4c32-ad82-86903558fe41",
                                "sense_id": "ee21ec3d-6579-34c7-babf-d0994cd27dc8",
                                "text": "Das Matthäusevangelium besteht aus 28 Kapiteln von Kindheitsgeschichten bis zur Passion und Auferstehung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
