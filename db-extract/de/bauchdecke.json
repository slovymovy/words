                "senses": [
                    {
                        "sense_id": "2f7c95fe-8412-3221-a5eb-6eb7174014cb",
                        "entry_id": "59016505-edac-3b22-9678-f50819d35bae",
                        "glosses": [
                            "äußere Schicht aus Haut und Muskeln, die den Bauch bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81052bf6-3529-4be9-a7d3-47e5f66b513c",
                                "sense_id": "2f7c95fe-8412-3221-a5eb-6eb7174014cb",
                                "text": "„Ein Granatsplitter hatte ihm wie ein riesiges Skalpell die Bauchdecke aufgeschlitzt.“"
                            },
                            {
                                "example_id": "3e67d44a-b949-4e0e-a5f4-c767510e1075",
                                "sense_id": "2f7c95fe-8412-3221-a5eb-6eb7174014cb",
                                "text": "„Die Organe, die durch die Bauchdecke geplatzt waren, aber immer noch an blutigen Gewebefetzen am Körper hingen, zuckten, nachdem sie auf den Boden geklatscht waren.“"
                            }
                        ],
