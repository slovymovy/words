                                        "sense_id": "3c07539b-5b82-38e5-873b-61049d67022b",
                                        "entry_id": "893ca727-2ec1-3c28-aa46-31b7ae351dc2",
                                        "glosses": [
                                            "A beating with a belt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60029f5f-d99a-320e-8921-9c228d686b18",
                                        "entry_id": "893ca727-2ec1-3c28-aa46-31b7ae351dc2",
                                        "glosses": [
                                            "A thorough defeat; a thrashing."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96ec60b5-e8d9-43f1-84dc-8414e4e91df0",
                                                "sense_id": "60029f5f-d99a-320e-8921-9c228d686b18",
                                                "text": "He said recent nail-biting finals had renewed interest in the end-of-season contests, after a series of one-sided beltings earlier this decade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d4d4a63-a943-35a1-965e-234f0c7357e9",
                                        "entry_id": "893ca727-2ec1-3c28-aa46-31b7ae351dc2",
                                        "glosses": [
                                            "A system of beltwork, as in a conveyor or other mechanical device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ec631e8-0897-3031-bf47-c7fef07b3c43",
                                        "entry_id": "893ca727-2ec1-3c28-aa46-31b7ae351dc2",
                                        "glosses": [
                                            "The material from which belts for machinery are made."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e2227dc-3125-3b54-a509-2290d240ce05",
                                        "entry_id": "893ca727-2ec1-3c28-aa46-31b7ae351dc2",
                                        "glosses": [
                                            "The act of singing in chest voice above one's vocal break in a higher range typically sung in head voice."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f88c2257-9423-4de7-8b99-bf69e5c03c51",
                                                "sense_id": "5e2227dc-3125-3b54-a509-2290d240ce05",
                                                "text": "I could hear you perfectly all the way in the back of the audience! I wish my belting were as good as yours."
                                            },
                                            {
                                                "example_id": "e7873d22-0ba0-446c-88b2-a9d86a983c4c",
                                                "sense_id": "5e2227dc-3125-3b54-a509-2290d240ce05",
                                                "text": "Traditionally belting was used by certain character roles in musicals, usually the funny, quirky or feisty female roles."
                                            },
                                            {
                                                "example_id": "b12b1ca3-0c41-4594-a305-fa8840d1403d",
                                                "sense_id": "5e2227dc-3125-3b54-a509-2290d240ce05",
                                                "text": "Kristin Vigard was originally chosen to play Annie, but after only a few performances, she was replaced by Andrea McArdle, who gave the role a tougher veneer (reminiscent of the Our Gang kids) while conveying vulnerability without sentimentality. And McArdle's belting exceeded everyone's wildest imagination. She transformed the writers' initial conception of Annie as a spirited but vocally average little girl into a Broadway diva."
                                            }
                                        ]
                                    }
                                ]
