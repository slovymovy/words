                "senses": [
                    {
                        "sense_id": "a41d25b0-7fc5-3d52-88b5-d441f2025871",
                        "entry_id": "21dc80a5-ac84-3eec-a681-28b0559741c5",
                        "glosses": [
                            "to smarten oneself up, to preen (to make oneself look pretty or handsome)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "98e7c320-2566-43b9-9932-d0fa57ae1874",
                                "sense_id": "a41d25b0-7fc5-3d52-88b5-d441f2025871",
                                "text": "А он всё прихора́шивался: то сни́мет шля́пу и начнёт пригла́живать седы́е во́лосы, то попра́вит на руба́хе га́лстук, то одёрнет по́лы но́вого пиджака́.",
                                "translation": "And he kept preening: either taking off his hat and smoothing his grey hair, or adjusting the tie over his shirt, or pulling at the flaps of his new suit jacket.",
                                "english": "And he kept preening: either taking off his hat and smoothing his grey hair, or adjusting the tie over his shirt, or pulling at the flaps of his new suit jacket."
                            }
                        ]
                    },
