{
    "word_family": [
        "simple",
        "simplicity",
        "simplistic",
        "simplify",
        "simplification"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2f15cfeb-c928-3690-ade4-9d017376b5fa",
                    "sense_definition": "Used to introduce or excuse an explanation that has been made much simpler than it really is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oversimplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To put it <w>simplistically</w>, the company failed because it spent more money than it earned.",
                            "target_lang_translations": {
                                "ru": "Если говорить <w>упрощенно</w>, компания обанкротилась, потому что тратила больше денег, чем зарабатывала."
                            }
                        },
                        {
                            "text": "<w>Simplistically</w>, he was fired with pay, though the legal details were actually quite complex.",
                            "target_lang_translations": {
                                "ru": "<w>Проще говоря</w>, его уволили с выплатой пособия, хотя юридические детали на самом деле были довольно сложными."
                            }
                        }
                    ],
                    "synonyms": [
                        "in layman's terms"
                    ],
                    "common_phrases": [
                        "put it simplistically",
                        "stated simplistically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения или оправдания объяснения, которое было значительно упрощено по сравнению с реальностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрощенно",
                                "target_lang_sense_clarification": "если говорить простыми словами"
                            },
                            {
                                "target_lang_word": "проще говоря",
                                "target_lang_sense_clarification": "вводная фраза для упрощения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c04bb558-24fa-3de5-8984-bfbc522f7d40",
                    "sense_definition": "In a way that is too simple and fails to consider the complex aspects of a situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "oversimplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the theory of relativity, but he did so very <w>simplistically</w> for the beginners.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил теорию относительности, но сделал это очень <w>упрощенно</w> для новичков."
                            }
                        },
                        {
                            "text": "We often assume <w>simplistically</w> that everyone follows the rules, ignoring the many exceptions that exist.",
                            "target_lang_translations": {
                                "ru": "Мы часто <w>примитивно</w> полагаем, что все следуют правилам, игнорируя множество существующих исключений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "viewed simplistically",
                        "interpreted simplistically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слишком просто, без учета сложных аспектов или нюансов ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примитивно",
                                "target_lang_sense_clarification": "излишне просто"
                            },
                            {
                                "target_lang_word": "поверхностно",
                                "target_lang_sense_clarification": "не вдаваясь в детали"
                            },
                            {
                                "target_lang_word": "упрощенно",
                                "target_lang_sense_clarification": "игнорируя сложность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}