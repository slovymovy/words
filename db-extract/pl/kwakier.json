                                        "examples": [
                                            {
                                                "example_id": "73b04ad0-f81e-4db2-83e7-0596c4a7cab8",
                                                "sense_id": "506b5cee-9ba1-37eb-a9bb-53728824423e",
                                                "text": "The demon of fanaticism was the shape which it took with us; and verily, what with religious republicans, harmonists, quakers, fifth-monarchy men, Presbyterians, and the reign of the saints upon earth, it needs the strong hand of a Cromwell to reduce the spiritual chaos to any sort of order."
                                            }
