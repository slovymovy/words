                        "examples": [
                            {
                                "example_id": "c2335cd2-d9b0-466c-bc40-5249a24e3624",
                                "sense_id": "c037c540-7c62-39f9-88ec-348c2494de5e",
                                "text": "[Baudelaire] a montré la femme sphinx malgré elle, déshabillable, sujet aux cuisantes expériences du chercheur d’idéal, chat de sérail, meurtrissable, « ignorante et toujours ravie »."
                            },
                            {
                                "example_id": "fee8bce3-ff79-4548-83ce-8ed6352c32c6",
                                "sense_id": "c037c540-7c62-39f9-88ec-348c2494de5e",
                                "text": "L’air s’écoule sans grands remous et la discrétion du moteur est particulièrement appréciable. Nous sommes dans le seul vrai 4X4 découvrable, voire totalement déshabillable du monde."
                            },
                            {
                                "example_id": "d407a292-4df9-4911-8871-f3ec6c055884",
                                "sense_id": "c037c540-7c62-39f9-88ec-348c2494de5e",
                                "text": "Déshabillables comme des poupées géantes, démontables en trois heures, les géants sont surtout plus maniables."
                            }
                        ]
                    }
