                "senses": [
                    {
                        "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                        "entry_id": "5cc26cb1-2d65-3d2e-b260-f48a7cb7237a",
                        "glosses": [
                            "sexuelle Orientierung, sich von Gegenständen erotisch angezogen zu fühlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1faca2-7f67-4f23-92c3-7ba4290dce97",
                                "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                                "text": "„Objektophilie sei eine sexuelle Orientierung und Neigung, so ihr Ergebnis.“"
                            },
                            {
                                "example_id": "8328f175-7d7b-43a5-b7a3-18e9864c292b",
                                "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                                "text": "„Wer forscht über \"Objektophilie\"?“"
                            },
                            {
                                "example_id": "f7066705-9425-41b8-8c47-9ddc3ed042db",
                                "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                                "text": "„Die Schwedin leidet unter Objektophilie – und daher seit nun fast 20 Jahren darunter, dass die ihre Angetraute fast ganz verschwunden ist.“"
                            },
                            {
                                "example_id": "79bd5cc6-6e5b-4138-9e89-4026d70416c3",
                                "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                                "text": "„Menschen, die sich zu Objekten hingezogen fühlen und diese auch ehelichen, sind der letzte Schrei (Stichwort: Objektophilie).“"
                            },
                            {
                                "example_id": "456c5656-aa5e-43ad-b26e-503aed716004",
                                "sense_id": "3ce47542-c238-3d02-b3f3-98e79b9ce15c",
                                "text": "„Experten rätseln über die bizarre sexuelle Spielart der Objektophilie.“"
                            }
                        ],
