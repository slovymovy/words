                "senses": [
                    {
                        "sense_id": "1126ecdc-a830-3abf-aac6-91b98f87045b",
                        "entry_id": "c3399398-33aa-362a-bca4-54d7ffda260e",
                        "glosses": [
                            "bezorgd dat iemand iets zal overkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7dd8ac-07cb-4dae-bc4f-2fad21411600",
                                "sense_id": "1126ecdc-a830-3abf-aac6-91b98f87045b",
                                "text": "Ze waren vreselijk ongerust over ons geweest."
                            },
                            {
                                "example_id": "51bb91e3-2be5-47da-8b07-adff8d42a3a4",
                                "sense_id": "1126ecdc-a830-3abf-aac6-91b98f87045b",
                                "text": "Zij was ongerust en ik ook, toen ik enan hoorde, want zijn brief stond vol met extreemrechts gedachtegoed De lieve Milan uit mijn jeugd was opgeslokt door de meute."
                            },
                            {
                                "example_id": "0488cfea-cefe-447c-87f9-b4743a222e09",
                                "sense_id": "1126ecdc-a830-3abf-aac6-91b98f87045b",
                                "text": "De ongeruste echtgenoot zat al uren in spanning te wachten."
                            }
                        ]
                    }
                ],
