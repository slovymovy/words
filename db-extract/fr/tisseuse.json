                                            {
                                                "example_id": "bb8bf3a8-731e-4cc4-a50a-d1cdf2b7bdb3",
                                                "sense_id": "66cf098a-98cb-3074-b05e-bea2d4490ac7",
                                                "text": "Nach ihrer Ausbildung arbeitete sie 21 Jahre als Weberin."
                                            },
                                            {
                                                "example_id": "8e524091-f58f-4bab-82be-5987b37c8d02",
                                                "sense_id": "66cf098a-98cb-3074-b05e-bea2d4490ac7",
                                                "text": "„Von Beruf ist sie Weberin, das sei »psychologisch gut«, da würde man »jeden Fehler gleich erkennen«.“"
                                            }
