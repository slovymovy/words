                "senses": [
                    {
                        "sense_id": "09686953-9823-378b-89f1-9f8772d14bda",
                        "entry_id": "0bc63976-3525-362a-a967-e6a5748e66c1",
                        "glosses": [
                            "von 0 verschiedene Nichteinheit, die a oder b teilt, wenn sie das Produkt ab teilt"
                        ],
                        "tags": [
                            "in einem kommutativen Ring"
                        ],
                        "examples": [
                            {
                                "example_id": "95c02bb0-a06c-462c-8c00-e8c4b943c3ca",
                                "sense_id": "09686953-9823-378b-89f1-9f8772d14bda",
                                "text": "Die Primelemente im Ring der ganzen Zahlen sind die Primzahlen (2, 3, 5, 7, 11, …) und ihre Gegenzahlen (−2, −3, −5, −7, −11, …)."
                            },
                            {
                                "example_id": "d9e48d07-69b8-432c-876b-461f3e5a862e",
                                "sense_id": "09686953-9823-378b-89f1-9f8772d14bda",
                                "text": "Jedes Primelement eines Integritätsrings ist irreduzibel und jedes irreduzible Element eines faktoriellen Rings ist prim."
                            },
                            {
                                "example_id": "2b3e4800-84f3-44d0-9257-eb3511576413",
                                "sense_id": "09686953-9823-378b-89f1-9f8772d14bda",
                                "text": "In einem Körper gibt es keine Primelemente, weil dort jedes Element 0 oder eine Einheit ist."
                            },
                            {
                                "example_id": "608c6443-68d5-45bc-8d41-b5172fc42136",
                                "sense_id": "09686953-9823-378b-89f1-9f8772d14bda",
                                "text": "In Z [i√] ist 2 irreduzibel, aber kein Primelement, da 2 keines der Elemente 1-i√5 und 1+i√5 teilt, wohl aber deren Produkt (1-i√5)(1+i√5)=6."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
