                    {
                        "translation_id": "9abf55f1-0be9-431c-9092-4963e57d701f",
                        "source_entry_id": "3f7a721b-6ce2-31ab-833f-74c4b2a8f15c",
                        "source_sense_id": "0aaab720-7cba-3689-b376-bcc51f936ba0",
                        "target_lang_word": "Palisade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palisade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                        "entry_id": "35ea42e4-f5ba-39db-bc3f-cf3931508f68",
                                        "glosses": [
                                            "ein aus hölzernen, meist angespitzten Pfählen bestehendes Hindernis zum Schutz und zur Verteidigung, Element bei der Gartengestaltung und im Landschaftsbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcd35cc-8019-4c5b-9582-c49f85cca705",
                                                "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                                "text": "Die Palisade schien unüberwindlich."
                                            },
                                            {
                                                "example_id": "bbd3eedb-6233-4e0d-ba85-c53d5e6eb10c",
                                                "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                                "text": "„Wie kam er darauf, dass der Hafen Haithabus von einer Palisade geschützt wurde?“"
                                            },
                                            {
                                                "example_id": "3bb5c32f-9bc1-40c4-98d3-7dd8afe3eb4e",
                                                "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                                "text": "„Zehn Minuten später standen wir am Rand der Lichtung, auf der sich die Palisade befand.“"
                                            },
                                            {
                                                "example_id": "34491624-a139-407b-8ab9-70a636569b93",
                                                "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                                "text": "„Die Maschinengewehrtürme und die Palisaden waren nicht zu erkennen.“"
                                            },
                                            {
                                                "example_id": "178e9338-487e-4249-a181-e5b5c8cfee0a",
                                                "sense_id": "4debc8ba-59e6-368d-abc8-9fcd2bb4383f",
                                                "text": "„Die Tiere hatten natürlich versucht, gegen die Umzäunung anzurennen, aber die Palisaden hatten standgehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb9d264d-91ec-31a6-9a5a-2e33dbcb2821",
                                        "entry_id": "35ea42e4-f5ba-39db-bc3f-cf3931508f68",
                                        "glosses": [
                                            "ein Typ palisadenförmiger Pflanzenzellen in Blättern höherer Pflanzen. Sie bilden ein meist einschichtiges Gewebe meist direkt unter der oberen Epidermis (das Palisadenparenchym)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16a86be4-5bff-4eb5-ad6a-9c976f722aae",
                        "source_entry_id": "3f7a721b-6ce2-31ab-833f-74c4b2a8f15c",
                        "source_sense_id": "0aaab720-7cba-3689-b376-bcc51f936ba0",
                        "target_lang_word": "палисад",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "палисад",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ab73e40-1e4c-3bd3-bfc0-b0cbb05074ec",
                                        "entry_id": "21c10c70-fcba-3fc6-9d56-051eb50c5aac",
                                        "glosses": [
                                            "то же, что палисадник; легкий сквозной забор из жердей, брусков, реек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9179063-115f-4b7e-ba97-8775adb9a68d",
                                                "sense_id": "8ab73e40-1e4c-3bd3-bfc0-b0cbb05074ec",
                                                "text": "Вода крутилась и кипела, ветер с воем мчал её в виде пыли, сёк волны, которые, как стадо преследуемых животных, метались на прибрежные каменья, потом на берег, затопляя на мгновение хижины, батареи, плетни и палисады."
                                            },
                                            {
                                                "example_id": "962c373b-df77-4be1-a764-e326ae18b1bc",
                                                "sense_id": "8ab73e40-1e4c-3bd3-bfc0-b0cbb05074ec",
                                                "text": "Так как видимо было, что майора нет еще дома, то я приостановился, облокотившись на решётку палисада, и стал вслушиваться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9040a718-4063-3584-8172-5aad2652bb61",
                                        "entry_id": "21c10c70-fcba-3fc6-9d56-051eb50c5aac",
                                        "glosses": [
                                            "воен. истор. оборонительное полевое укрепление в виде сплошного частокола из толстых бревен, досок, заостренных кверху и сплоченных поперечными брусьями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae10680-75f8-4808-92ee-fde1c3073c5d",
                                                "sense_id": "9040a718-4063-3584-8172-5aad2652bb61",
                                                "text": "Прыгай через палисады, бросай фашины, спускайся в ров, ставь лестницы!"
                                            },
                                            {
                                                "example_id": "b5b46fee-49e6-4ed3-a566-8720f5474d71",
                                                "sense_id": "9040a718-4063-3584-8172-5aad2652bb61",
                                                "text": "Палисад из заострённых, толстых кольев составлял внешнее укрепление городка, простираясь извилинами далее стен, из-за которых видны были вышки княжеских теремов, переходы и сени, покрытые гонтом, или дранью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb478b2-f67f-317a-9ae6-cb84f337af34",
                                        "entry_id": "21c10c70-fcba-3fc6-9d56-051eb50c5aac",
                                        "glosses": [
                                            "техн. ряд забитых в землю брёвен, свай, укрепляющий земляной склон и защищающий его от оползней и осыпания"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
