                    },
                    {
                        "form_id": "284aaa6f-d325-4f9e-9535-c3476078178a",
                        "entry_id": "379007c5-3475-321b-825a-da2cec1a6506",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "шпио́нках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f45b19fa-98b0-3ccf-abca-3888d189b520",
                        "entry_id": "379007c5-3475-321b-825a-da2cec1a6506",
                        "glosses": [
                            "женск. к шпион"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9beb014-a3c9-4672-8169-99d97ac1f66d",
                                "sense_id": "f45b19fa-98b0-3ccf-abca-3888d189b520",
                                "text": "Потому что, видимо, подумал, что я шпионка, а враги Родины ― они наши друзья и с ними завсегда надо на «ты»."
                            },
                            {
                                "example_id": "abae2cb9-be7a-4963-9b13-6fe21593a51f",
                                "sense_id": "f45b19fa-98b0-3ccf-abca-3888d189b520",
                                "text": "В окошечке сидел комсомольский работник, который со мной недружелюбно и подозрительно разговаривал, выяснял, не шпионка ли я."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0c80f79-f35a-4373-b16e-e2e5973720fc",
                        "source_entry_id": "379007c5-3475-321b-825a-da2cec1a6506",
                        "source_sense_id": "f45b19fa-98b0-3ccf-abca-3888d189b520",
                        "target_lang_word": "Spionin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spionin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                        "entry_id": "cd4dc758-7154-3683-99b9-d64e79a693f3",
                                        "glosses": [
                                            "weibliche Person, die als heimliche, unerkannte Beobachterin die gegnerische Seite auskundschaftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f1512f-f182-47e4-ae82-d49baa36134a",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Selbst Zinat Mahal, die Lieblingsfrau des Großmoguls, betätigte sich als Spionin.“"
                                            },
                                            {
                                                "example_id": "6546f5b8-7d8f-4d23-9194-b33603003690",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Sie galt den finnischen Sicherheitsbehörden zwischenzeitlich als Spionin.“"
                                            },
                                            {
                                                "example_id": "97036bfa-d659-4052-9dff-98cddbcb1262",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Ihre Augen waren die Augen einer Spionin.“"
                                            },
                                            {
                                                "example_id": "27f0f759-d5b9-44fb-8e52-106b64bc8403",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Es gäbe Gerüchte, sie sei eine Spionin, und möglicherweise wolle der Sicherheitsdienst – die Auslandsabteilung der Gestapo – sie demnächst befragen.“"
                                            },
                                            {
                                                "example_id": "026a7cfb-546c-4a7f-9cc8-69cf887295a6",
                                                "sense_id": "19b4d58b-149e-37a7-ac6d-a40a7009dc84",
                                                "text": "„Für ihn war sie nur noch eine Spionin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac594b46-bd92-46b4-975e-15b5f30784af",
                        "source_entry_id": "379007c5-3475-321b-825a-da2cec1a6506",
                        "source_sense_id": "f45b19fa-98b0-3ccf-abca-3888d189b520",
                        "target_lang_word": "spionne",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spionne",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e0b6ad7-305b-304c-b49b-8098ed864e3f",
                                        "entry_id": "ca2eb262-5290-31db-9fe9-8c197c01a8d9",
                                        "glosses": [
                                            "een vrouwelijke spion"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccfcee5-bf4d-4f6e-b520-46bfa0523e3a",
                                                "sense_id": "8e0b6ad7-305b-304c-b49b-8098ed864e3f",
                                                "text": "En het is precies 100 jaar geleden dat het leven van roemruchte spionne Mata Hari eindigde voor een vuurpeloton."
                                            },
                                            {
                                                "example_id": "c82eb0fd-5c51-463b-9b13-9bda85b01f6e",
                                                "sense_id": "8e0b6ad7-305b-304c-b49b-8098ed864e3f",
                                                "text": "Velen kennen de mythe van Mata Hari, de vermeende Friese spionne die tijdens de Eerste Wereldoorlog in 1917 door de Fransen werd gefusilleerd op verdenking van hoogverraad. Maar weinigen weten wie Margaretha Geertruida Zelle, zoals Mata Hari in werkelijkheid heette, was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
