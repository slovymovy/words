                                        "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                        "entry_id": "e20e5878-998d-37cc-af22-2b7031d244bf",
                                        "glosses": [
                                            "auffällig hergerichtet/präpariert, übertrieben zurechtgemacht/aufgerüstet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc57007-b5a7-4cae-9e42-1a3296906b53",
                                                "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                                "text": "Ronny fährt den aufgemotzteren Schlitten der beiden."
                                            },
                                            {
                                                "example_id": "364ed1de-38fd-4f72-8c3e-4b1ec7e414c5",
                                                "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                                "text": "Den aufgemotztesten Schlitten des nordwestlichen Landkreises hat doch wohl Tommy."
                                            },
                                            {
                                                "example_id": "f9f748e6-dd07-438d-aa0a-0b875596e6bb",
                                                "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                                "text": "Oh, du hast dich für heute Abend aber ganz schön aufgemotzt!"
                                            },
                                            {
                                                "example_id": "81b5c0c7-d48c-46a2-8680-120e7a3e6fb9",
                                                "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                                "text": "„Ich finde es sinnlos, dass ein Block weg muss, wie vorne in der Thomas-Müntzer-Straße, der vorher erneuert wurde, Fenster, Türen, alles aufgemotzt und das ist nicht das einzige Bespiel hier in Hoyerswerda.“"
                                            },
                                            {
                                                "example_id": "a6208931-c134-4441-90a4-07684595d800",
                                                "sense_id": "d02b73b7-df37-3281-8169-108350d55c8f",
                                                "text": "„Und so kommt es, dass sich bis auf ein wenig verlängerte Synagogen-Aufenthalte und ein bisschen aufgemotztere Feiertagsmenüs eigentlich keine allzu spektakulären Höhepunkte des Festes ausmachen lassen.“"
                                            }
                                        ],
