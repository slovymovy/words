                "senses": [
                    {
                        "sense_id": "a1b0c1ee-44ee-371a-b144-2fc91d23beda",
                        "entry_id": "3e968e8b-ea52-3ced-a3fe-2c82b26609a8",
                        "glosses": [
                            "Gebäudeteil/Etage direkt unter dem Dach"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "232e19e5-a1aa-4469-9608-83ca6a7cf08f",
                                "sense_id": "a1b0c1ee-44ee-371a-b144-2fc91d23beda",
                                "text": "Wir wohnen im Dachgeschoß."
                            },
                            {
                                "example_id": "79f71a6b-547e-404f-bea8-fd1b67f1dbba",
                                "sense_id": "a1b0c1ee-44ee-371a-b144-2fc91d23beda",
                                "text": "„Das Steigungsverhältnis für die Stiege ins Dachgeschoß ist mit 29,2/25 cm (H/B) angegeben und gem. § 22 NÖ BTV auch für eine Nebenstiege ungeeignet.“"
                            },
                            {
                                "example_id": "3684b952-a103-4aed-a3b5-6461fb35c540",
                                "sense_id": "a1b0c1ee-44ee-371a-b144-2fc91d23beda",
                                "text": "„Ich saß im Dachgeschoß des Hauses und hatte alles, was Black in seinem Leben jemals gekauft und verkauft hatte, zu katalogisieren, die Photographien mit den Aufschriften über die Herkunft der Bilder zu versehen und die Quellen dazu zu erforschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
