                                "target_senses": [
                                    {
                                        "sense_id": "ffa97194-f70a-3a78-852a-4d5da5094c40",
                                        "entry_id": "f1be7bae-a9f9-3150-9109-f6d62018a501",
                                        "glosses": [
                                            "without ceasing (stopping); continuously"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92ad6b1-b1d5-463f-995f-651137a3f1b7",
                                                "sense_id": "ffa97194-f70a-3a78-852a-4d5da5094c40",
                                                "text": "All concerned, more particularly those in charge of the depots, worked unceasingly for long hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba80eca1-28f7-4bd5-a27c-c75e4953b141",
                        "source_entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
                        "source_sense_id": "2720ecfa-2f16-3d51-bb33-0fe91d0c3221",
                        "target_lang_word": "continuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                        "entry_id": "67d61252-9945-34ea-a8f4-233d95259065",
                                        "glosses": [
                                            "Without pause."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3f9061-309d-45bb-812d-f6df62058290",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "The river continuously flows to the sea, it will never pause to let us cross on dry land."
                                            },
                                            {
                                                "example_id": "5bf09a40-14e7-44b1-b69f-518f212f4abe",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "In the year 1633, the Bridget Nuns, near Xanthus, behaved like sheep, jumping about and bleating continuously."
                                            },
                                            {
                                                "example_id": "05a70050-46b3-4ba7-889e-f8bdfbe2c66c",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "\"We continuously strive to improve our processes and indeed have updated our systems accordingly. Ultimately, however, it is for the student to make a proper declaration to SLC [Student Loans Company]^([sic]) to draw down funding,\" LSST said in a statement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47105f66-ea2e-4044-b79a-8d3238eb1044",
                        "source_entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
                        "source_sense_id": "2720ecfa-2f16-3d51-bb33-0fe91d0c3221",
                        "target_lang_word": "unaufhörlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaufhörlich",
