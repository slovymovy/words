                            {
                                "example_id": "dc00b0ae-4fbe-4b2f-a10f-5f33280f5c25",
                                "sense_id": "8c6b020a-e8b3-329d-9780-b668d3d0d50a",
                                "text": "Tijdens de frisse winternacht maakten we een wandeling over het strand."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d56f826-0c1f-3d31-8ae1-ac6375473981",
                        "entry_id": "b463419b-8f35-3b6c-9633-115cdcc372df",
