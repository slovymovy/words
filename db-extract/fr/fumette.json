                                        "examples": [
                                            {
                                                "example_id": "1730bd59-3038-451c-90ba-cfb1f23087ac",
                                                "sense_id": "4e0602ba-e20e-3d13-931e-2d17ef6f6e2e",
                                                "text": "The artist took a thoughtful toke off the joint, then passed it along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb16dda-084b-3534-8da6-974c9a11e763",
                                        "entry_id": "bc9f578f-dcfb-3bff-9c8a-6fc929d5b274",
                                        "glosses": [
                                            "An inhalation or lungful of anything."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db82043-b255-4aca-a7ce-2664caf0c6ec",
                                                "sense_id": "ffb16dda-084b-3534-8da6-974c9a11e763",
                                                "text": "Back on the wards a big toke of O₂ might have done the job; it was God's own pick-me-up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a76034d-1671-3d4c-8296-d7640cb1ac86",
                                        "entry_id": "6b71c8cc-616f-3ee2-a454-26a4f67e3cc1",
                                        "glosses": [
                                            "To smoke marijuana."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00076df6-48f5-4ed2-a2eb-30e6b12cb4da",
                                                "sense_id": "4a76034d-1671-3d4c-8296-d7640cb1ac86",
                                                "text": "Let's roll up a doobie and toke."
                                            },
                                            {
                                                "example_id": "feafc640-0927-4af4-8776-d692b6792b8d",
                                                "sense_id": "4a76034d-1671-3d4c-8296-d7640cb1ac86",
                                                "text": "This keeps Doc’s workload relatively light, freeing him to stay stoned around the clock and live in the now, which isn’t hard for him, because he’s toked away his short-term memory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "110f8a1d-5020-31ea-9de3-35287f97efa6",
