                "senses": [
                    {
                        "sense_id": "f263e9ba-f445-31e9-ab19-8a707b98bda8",
                        "entry_id": "85562721-65e0-3ab5-b66d-6052f0a9dfeb",
                        "glosses": [
                            "Action de bredouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa62cbdb-76bd-4711-8b9b-79b78773a60f",
                                "sense_id": "f263e9ba-f445-31e9-ab19-8a707b98bda8",
                                "text": "Le même bredouillement de syllabes se fit entendre, couvert par les huées de la classe."
                            },
                            {
                                "example_id": "1e831409-17cc-4846-bae2-b6756e0e88d1",
                                "sense_id": "f263e9ba-f445-31e9-ab19-8a707b98bda8",
                                "text": "Elle n’en put rien tirer d’abord, que ces bredouillements apeurés."
                            },
                            {
                                "example_id": "3922fae2-070e-4a4c-92ca-76064c0a72c6",
                                "sense_id": "f263e9ba-f445-31e9-ab19-8a707b98bda8",
                                "text": "Cette voix perçait maintenant le bredouillement officiel et s’élevait seule, comme si, plus qu’au flot des paroles décevantes, il eût été de toute importance de disposer maintenant mon oreille aux suggestions profondes, presque hypnotiques, d’un certain timbre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f99669f-902b-328e-9a72-bfb048caec68",
                        "entry_id": "85562721-65e0-3ab5-b66d-6052f0a9dfeb",
                        "glosses": [
                            "Trouble particulier de la phonation qui se caractérise par des paroles rapides et, ou, un mélange d’idées, produisant un télescopage de syllabes."
                        ],
                        "tags": [],
                        "examples": []
                    }
