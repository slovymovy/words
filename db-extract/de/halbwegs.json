                                "target_senses": [
                                    {
                                        "sense_id": "124c4658-5098-38c4-986a-d071204daecc",
                                        "entry_id": "683dbb65-a218-3bd2-be29-9411a76d4b59",
                                        "glosses": [
                                            "in beperkte mate, een beetje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9626ea22-9538-4830-a782-f5ef28bd8c86",
                                                "sense_id": "124c4658-5098-38c4-986a-d071204daecc",
                                                "text": "Na die plotseling van rechts opdoemende auto was de rijexamenkandidaat enigszins uit zijn doen."
                                            },
                                            {
                                                "example_id": "8bf2eb85-0df5-44a4-b037-ba0b162be59b",
                                                "sense_id": "124c4658-5098-38c4-986a-d071204daecc",
                                                "text": "Albert Maillard. Hij was een slanke jongen met een enigszins traag, bescheiden karakter."
                                            },
                                            {
                                                "example_id": "3bc74829-fcfc-4390-b778-1cb4644d76a4",
                                                "sense_id": "124c4658-5098-38c4-986a-d071204daecc",
                                                "text": "Deze informatie was nog betrouwbaarder dan de soms wat verouderde opmerkingen in Guthook en gezamenlijk gaven ze voldoende informatie om met enigszins gerust hart de uitgedroogde woestijn in te trekken."
                                            },
                                            {
                                                "example_id": "a63bf7ac-9fff-47f4-8f33-dbb05e34d94f",
                                                "sense_id": "124c4658-5098-38c4-986a-d071204daecc",
                                                "text": "Wanneer ik ze voortduw in de dubbele wandelwagen, mijn schouders opgetrokken en mijn rug enigszins krom: een lastdier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
