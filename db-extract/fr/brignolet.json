                "senses": [
                    {
                        "sense_id": "b1b4c6b4-95cf-3f1e-a2a9-e8aec470261b",
                        "entry_id": "6951ed06-6e15-3f45-aed9-4ac767c0c2fe",
                        "glosses": [
                            "Pain."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2e476b41-9d6b-4c22-857f-2cfd30ad02eb",
                                "sense_id": "b1b4c6b4-95cf-3f1e-a2a9-e8aec470261b",
                                "text": "Un coup de jus, mon vieux birbe, et une croûte de brignolet !"
                            },
                            {
                                "example_id": "dd938c8a-7dba-4b5f-9ced-297f77f4271e",
                                "sense_id": "b1b4c6b4-95cf-3f1e-a2a9-e8aec470261b",
                                "text": "J’achète des œufs et un brignolet et rentre."
                            },
                            {
                                "example_id": "45c3564f-99fd-4365-8efe-005bbb95acad",
                                "sense_id": "b1b4c6b4-95cf-3f1e-a2a9-e8aec470261b",
                                "text": "Le train ne démarrant qu'à treize heures, j'eus le temps de me restaurer, avec, comme disait Dédé, du brignolet (du pain), du sifflard (saucisson), le tout arrosé d'un coup de Beaujolais."
                            },
                            {
                                "example_id": "f7149900-8aec-4eeb-a637-4108908a73b7",
                                "sense_id": "b1b4c6b4-95cf-3f1e-a2a9-e8aec470261b",
                                "text": "Autre détail, une station assez longue près du frigo pour rectifier un excellent livarot affiné à point, ne laissant que les miettes du brignolet, indice de sans-gêne et de bon goût… ça peut cohabiter parfois."
                            }
                        ]
                    }
