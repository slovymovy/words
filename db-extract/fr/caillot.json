            {
                "entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
                "word": "caillot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85d207ac-ce20-4801-b56f-db23ff67d5d1",
                        "entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
                        "tags": [
                            "plural"
                        ],
                        "form": "caillots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                        "entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
                        "glosses": [
                            "Petite masse de liquide coagulé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a74cbed2-a43f-4741-87d0-40667a96473e",
                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                "text": "Aussitôt l’abatage des animaux, le sang est fortement agité, pour en séparer la fibrine, et empêcher la formation du caillot sanguin."
                            },
                            {
                                "example_id": "62e671a4-d967-4b6b-823f-f88539b1591a",
                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                "text": "Il y a de grandes vagues dans la cuve, et le sucre ruisselle par terre, pend en caillots noirs qui roulent sur la terre couverte de feuilles et de paille."
                            },
                            {
                                "example_id": "c2d1c88e-e38e-4625-a823-83b5236f2e91",
                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                "text": "Il existe aussi des médicaments (warfarine) dont l'usage est destiné à ralentir la formation du caillot sanguin, à « éclaircir le sang », comme disent certains patients."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb2dcc0d-ce9f-4770-b10f-f1c8feeba942",
                        "source_entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
                        "source_sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                        "target_lang_word": "Gerinnsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerinnsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c446c0ea-4fec-3f2c-a8d1-8848ce531064",
                                        "entry_id": "55e52d18-e939-34c5-a8ac-132d058adfad",
                                        "glosses": [
                                            "Gewässer mit nur sehr wenig Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4529224-b109-4339-a15c-8b3c06f76aa7",
                                                "sense_id": "c446c0ea-4fec-3f2c-a8d1-8848ce531064",
                                                "text": "Infolge der Trockenheit ist von dem Bach nur noch ein kleines Gerinnsel übrig geblieben."
                                            },
                                            {
                                                "example_id": "ba8c92ee-4b3e-4c0d-821b-994646933156",
                                                "sense_id": "c446c0ea-4fec-3f2c-a8d1-8848ce531064",
                                                "text": "„Was aber gewisse Wilberger und die Meinberger trennte und häufig Verwirrung stiftete, war ebenfalls ein Gewässer, obwohl bestenfalls nur ein Gerinnsel, weshalb es wohl keinen rechten Namen dafür gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "22b5ee54-82ab-3d5e-a587-58b69febac6b",
                                        "entry_id": "55e52d18-e939-34c5-a8ac-132d058adfad",
                                        "glosses": [
                                            "kleine Ansammlung klumpig gewordenen Blutes im Blutkreislauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f01e2c-8603-47cd-9773-1636982d3a3e",
                                                "sense_id": "22b5ee54-82ab-3d5e-a587-58b69febac6b",
                                                "text": "Die blutverdünnenden Medikamente sollen die Bildung von Gerinnseln während der Zeit im Krankenhaus verhindern."
                                            },
                                            {
                                                "example_id": "3912ac7f-b5c2-4542-8703-0292539a7519",
                                                "sense_id": "22b5ee54-82ab-3d5e-a587-58b69febac6b",
                                                "text": "„Ich sah die Gerinnsel und wie sie durch das verengte Labyrinth trieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00e84c0-5eb6-4e01-9f27-a5e1bf958e4d",
                        "source_entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
