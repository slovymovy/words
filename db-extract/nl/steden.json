                        "examples": [
                            {
                                "example_id": "c614184e-1e94-49f6-b264-5cc6d076465e",
                                "sense_id": "18c2af16-1597-3b6e-9603-de8a7207cddb",
                                "text": "Tienduizenden in Amerikaanse steden de straat op tegen regering-Trump: ‘Stuur Musk naar Mars!’"
                            },
                            {
                                "example_id": "cf1b510e-4ae7-477e-a045-f270d9a7eabb",
                                "sense_id": "18c2af16-1597-3b6e-9603-de8a7207cddb",
                                "text": "Na de Negev loop je door oude steden als Jeruzalem, Haifa en Nazareth en kun je bij Trail Angels overnachten die hun huis openstellen voor INT-hikers."
                            },
                            {
                                "example_id": "cbbf4eda-7a3e-4ad2-832c-e06eb59859b4",
                                "sense_id": "18c2af16-1597-3b6e-9603-de8a7207cddb",
                                "text": "Ze waren begonnen met het vermoorden van burgers door niet alleen Berlijn maar ook andere Duitse steden te bombarderen."
                            }
                        ]
