                ],
                "senses": [
                    {
                        "sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                        "entry_id": "5cb33b42-8ee4-304a-9c3a-3b4d11b85c60",
                        "glosses": [
                            "устар. игривый, легкомысленный, нескромный, не вполне пристойный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50374bac-cc4f-4484-85d7-4679562bda4b",
                                "sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                                "text": "Он мастерски пел гривуазные песни и при этом как-то лихо вертел направо и налево головою и шевелил плечами."
                            },
                            {
                                "example_id": "fe387ec7-be55-4cac-836d-dc1a0ccd1a68",
                                "sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                                "text": "Гривуазные анекдоты."
                            },
                            {
                                "example_id": "a92cbc70-15e0-4859-9817-07acb4838f3c",
                                "sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                                "text": "Сатир, трактуемый как «похотливое лесное божество» — это уже не сатир, не персонаж древнегреческого мифа, а скорее герой гривуазного французского романа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2575755d-744c-4377-ae2d-f1bcd4ee6b73",
                        "source_entry_id": "5cb33b42-8ee4-304a-9c3a-3b4d11b85c60",
                        "source_sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                        "target_lang_word": "frivolous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frivolous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1388c2bd-59e6-389f-97bd-8bb588b40568",
                                        "entry_id": "f3fe2fb7-882a-3d2d-9175-acd238859fe5",
                                        "glosses": [
                                            "Silly, especially at an inappropriate time or in an inappropriate manner; lacking a good reason for being, or for doing what one does; due to or moved by a whim or caprice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "060aa8b1-f6ec-39af-aa15-e7fdd672068b",
                                        "entry_id": "f3fe2fb7-882a-3d2d-9175-acd238859fe5",
                                        "glosses": [
                                            "Of little weight or importance; not worth notice; slight; trivial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "267f972f-3add-39a1-937f-bd0554845e68",
                                        "entry_id": "f3fe2fb7-882a-3d2d-9175-acd238859fe5",
                                        "glosses": [
                                            "Having no reasonable prospect of success because its claim is without merit, lacking a supporting legal or factual basis, while the filing party is, or should be, aware of this."
                                        ],
                                        "tags": [
                                            "said of a lawsuit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d38f148-ee70-4dde-829d-441339261617",
                                                "sense_id": "267f972f-3add-39a1-937f-bd0554845e68",
                                                "text": "There is no easy definition for the phrase 'frivolous lawsuit,' but I imagine any claim for damages where the injuries are minimal or where the basis for the defendant's liability is hard to believe, might qualify as frivolous."
                                            },
                                            {
                                                "example_id": "02cc0b14-0344-4bc2-ae2d-42c8a5ddb1ad",
                                                "sense_id": "267f972f-3add-39a1-937f-bd0554845e68",
                                                "text": "One of the major cost drivers in the delivery of health care are these junk and frivolous lawsuits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9834d600-c68e-436f-a11f-7d1fd59ed4e7",
                        "source_entry_id": "5cb33b42-8ee4-304a-9c3a-3b4d11b85c60",
                        "source_sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                        "target_lang_word": "suggestive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suggestive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Tending to suggest or imply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f6a0ba-254a-403b-b226-f9ef339bf065",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "The painting is abstract, but the colors are suggestive of fruit or the Mediterranean."
                                            },
                                            {
                                                "example_id": "5edcc428-b40e-4d73-adf7-8a726d17bf71",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "But Sophia's mother was not the woman to brook defiance. After a few moments' vain remonstrance her husband complied. His manner and appearance were suggestive of a satiated sea-lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Suggesting romance, sex, etc.; risqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4025fe7d-3b79-4fa8-ad51-7541ac181f1f",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "She crossed her legs and shot him a suggestive smile."
                                            },
                                            {
                                                "example_id": "81b1b8f0-5715-4087-bd2e-aa26d0ff37c7",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "Girls read fashion and celebrity magazines at younger and younger ages and look for the same kinds of sexy, suggestive clothing worn by the models."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ae212c-48e1-3818-bd20-2e3e1ad3d668",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Relating to hypnotic suggestion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c45bc6-701e-4507-b859-a424b09da743",
                        "source_entry_id": "5cb33b42-8ee4-304a-9c3a-3b4d11b85c60",
                        "source_sense_id": "e6c5ad7c-94b7-3c3c-8dd7-e5f8c9dfbd7c",
                        "target_lang_word": "grivois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grivois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44a5248a-abf3-3633-a34f-c9e98fada723",
                                        "entry_id": "6a71750c-9560-33b7-a0df-0449ea078e95",
                                        "glosses": [
                                            "Qui est égrillard et tient du libertinage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fde409-0f81-48e4-a35d-6396d6ca8b7e",
                                                "sense_id": "44a5248a-abf3-3633-a34f-c9e98fada723",
                                                "text": "Il est souvent grivois dans ses propos. Propos grivois. Contes grivois. Chanson grivoise."
                                            },
                                            {
                                                "example_id": "da721935-18ae-4f13-80ea-fdedf94de4b4",
                                                "sense_id": "44a5248a-abf3-3633-a34f-c9e98fada723",
                                                "text": "Cependant le propriétaire commençait à jouer de la prunelle d’une façon extraordinaire. Il se balançait sur sa chaise, tenait des propos grivois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bebdfd48-047f-3ccc-97db-b2bb47063d13",
                                        "entry_id": "6a71750c-9560-33b7-a0df-0449ea078e95",
                                        "glosses": [
                                            "D’une humeur libre et hardie. Leste en propos et en actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a93e84-5a9b-4e12-9610-0c50b0e663fe",
                                                "sense_id": "bebdfd48-047f-3ccc-97db-b2bb47063d13",
                                                "text": "Le pouce est ce gras cabaretier flamand, d’humeur goguenarde et grivoise, qui fume sur sa porte, à l’enseigne de la double bière de mars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grivois",
