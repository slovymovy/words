                        "glosses": [
                            "in der Musiknotation ein Strich als Teil der Darstellung von Noten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc61512-13f5-4299-bca7-008ee2c6d174",
                                "sense_id": "8487db6d-b378-3162-b029-1bcfbc5f4b55",
                                "text": "Die Notenhalsrichtung in einem Notationsprogramm ändern."
                            },
                            {
                                "example_id": "c191bba4-264e-4c06-8e92-1c664b4fb1c6",
                                "sense_id": "8487db6d-b378-3162-b029-1bcfbc5f4b55",
                                "text": "Eine Achtelnote hat einen ausgefüllten Kopf und einen Notenhals mit einem Fähnchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bfea572-a017-4740-874f-11bd845f399a",
                        "source_entry_id": "5dd2fdc5-ef08-3636-af8b-26e354ce6e03",
                        "source_sense_id": "8487db6d-b378-3162-b029-1bcfbc5f4b55",
