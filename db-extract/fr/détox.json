                                            {
                                                "example_id": "35b7cfb6-1c41-47e1-bdef-9109d3a4593a",
                                                "sense_id": "7a257c8c-be94-31e1-b915-ed13456e91e4",
                                                "text": "Die Entgiftung dioxinverseuchter Böden ist sehr aufwendig."
                                            },
                                            {
                                                "example_id": "9f827c61-9032-40c7-987a-a13bc2b27c52",
                                                "sense_id": "7a257c8c-be94-31e1-b915-ed13456e91e4",
                                                "text": "„Nachdem wir eine Nacht lang bei Dunning gesessen und auf den Tod gewartet hatten, wurde die Angelegenheit schließlich einem Arzt übergeben, und Dunning wurde zur Entgiftung in eine Privatklinik gebracht.“"
                                            }
                                        ],
