                "senses": [
                    {
                        "sense_id": "dad9af19-a707-3ecd-9ea7-b879e448847d",
                        "entry_id": "2ab467bf-8c16-3a04-96e9-4656c98b3f95",
                        "glosses": [
                            "weibliche Person, die ein Studium der Psychologie, der Wissenschaft vom Erleben und Verhalten des Menschen, erfolgreich abgeschlossen hat"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "76f4c3b9-9ead-47ef-9435-ce0a04c22296",
                                "sense_id": "dad9af19-a707-3ecd-9ea7-b879e448847d",
                                "text": "Die Psychologin hat sich auf Jugendliche spezialisiert und ist sehr beliebt."
                            },
                            {
                                "example_id": "64091ebd-294d-41be-af23-c433b369f025",
                                "sense_id": "dad9af19-a707-3ecd-9ea7-b879e448847d",
                                "text": "„Die Psychologin lächelte und sah so aus, als würde sie sich darüber amüsieren, dass ich es spannend machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e210c219-8c31-4395-a7d4-c3fdbbfe1c93",
                        "source_entry_id": "2ab467bf-8c16-3a04-96e9-4656c98b3f95",
                        "source_sense_id": "dad9af19-a707-3ecd-9ea7-b879e448847d",
                        "source_sense_description": "weibliche Person, die ein Studium der Psychologie erfolgreich abgeschlossen hat",
                        "target_lang_word": "psychologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
