                        ],
                        "examples": [
                            {
                                "example_id": "29f90f26-161b-433f-aff3-79dcea41a003",
                                "sense_id": "3629bbba-8115-355a-baf3-0b40832b2354",
                                "text": "But pale Malts will be fit for Use at a Week's End, because the Leisureness of their Drying endows them with a Softness from the Time they are taken off the Kiln to the Time they are brewed […]"
                            },
                            {
                                "example_id": "1a9c0b07-953c-4b01-96e0-8adb34bdd104",
                                "sense_id": "3629bbba-8115-355a-baf3-0b40832b2354",
                                "text": "How else explain the seeming slowness with which we were falling — the seeming leisureness with which the wall drifted up past us?"
                            }
                        ]
                    }
                ],
