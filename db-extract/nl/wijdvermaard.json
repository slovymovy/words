                    },
                    {
                        "translation_id": "7046db9f-76bf-4ab5-9cac-cdeb061b9ea8",
                        "source_entry_id": "47a622fe-d2e0-3b1e-b963-78c81e61de6b",
                        "source_sense_id": "f630f069-3ad9-363f-9ea5-6ce034e6a004",
