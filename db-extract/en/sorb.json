                        "target_lang_word": "Sorbin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorbin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce24983-18c0-3b5a-8a50-b30150561edb",
                                        "entry_id": "13cab83f-6883-3acf-8a92-14d20f89184d",
                                        "glosses": [
                                            "Angehörige eines westslawischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c288106-89e4-4c30-abc0-928a91f749dd",
                                                "sense_id": "0ce24983-18c0-3b5a-8a50-b30150561edb",
                                                "text": "„Da sich das Bewußtsein, Sorbin oder Sorbe zu sein, vor allem im Bereich der gemeinsamen Sprache erhält, ist auch die kulturelle Identität der Sorben eng mit ihrer Sprache verknüpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
