    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05c5dc08-61c9-3778-a1aa-907d8bbe3a7c",
                    "sense_definition": "Promesse ou obligation morale, contractuelle ou financière que l'on prend envers quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a pris l'<w>engagement</w> d'aider cette association chaque fin de semaine."
                        },
                        {
                            "text": "Il est essentiel de respecter ses <w>engagements</w> professionnels pour préserver la confiance de ses partenaires."
                        }
                    ],
                    "synonyms": [
                        "obligation",
                        "promesse"
                    ],
                    "common_phrases": [
                        "tenir ses engagements",
                        "prendre un engagement",
                        "respecter ses engagements"
                    ]
                },
                {
                    "sense_id": "756d2d4a-05bf-3076-a1cd-140bf04e9141",
                    "sense_definition": "Fait de mettre son action, son temps ou son art au service d'une cause politique, sociale ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militantisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>engagement</w> politique se manifeste par sa participation active aux réunions citoyennes."
                        },
                        {
                            "text": "Cet écrivain est très admiré pour son <w>engagement</w> constant en faveur des droits de l'homme."
                        }
                    ],
                    "synonyms": [
                        "militantisme",
                        "implication"
                    ],
                    "antonyms": [
                        "désengagement"
                    ],
                    "common_phrases": [
                        "engagement politique",
                        "engagement citoyen"
                    ]
                },
                {
                    "sense_id": "a6011f31-7d24-32f9-927c-56e859201ef3",
                    "sense_definition": "Fait d'entrer au service d'un employeur, ou action d'embaucher un salarié pour une durée déterminée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recrutement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction lui a remis une lettre d'<w>engagement</w> avant de finaliser son contrat."
                        },
                        {
                            "text": "Dès son <w>engagement</w> au sein de l'entreprise, le jeune ingénieur a reçu une solide formation."
                        }
                    ],
                    "synonyms": [
                        "embauche",
                        "recrutement"
                    ],
                    "common_phrases": [
                        "lettre d'engagement",
                        "contrat d'engagement"
                    ]
                },
                {
                    "sense_id": "b9ea885e-bd91-336b-bd91-75dde23406f4",
                    "sense_definition": "Mise en jeu réglementaire du ballon ou du palet au début d'un match ou après un but.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre siffle l'<w>engagement</w> au rond central sous les encouragements des supporters."
                        },
                        {
                            "text": "Dès l'<w>engagement</w>, les attaquants se sont rués vers la cage adverse pour ouvrir le score."
                        }
                    ],
                    "synonyms": [
                        "coup d'envoi"
                    ],
                    "common_phrases": [
                        "zone d'engagement",
                        "ligne d'engagement"
                    ]
                },
                {
                    "sense_id": "72debb52-825d-33f2-998d-1f6db2879de2",
                    "sense_definition": "Affrontement armé ou combat entre des troupes militaires opposées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un bref <w>engagement</w> armé a éclaté entre les patrouilles à la frontière nord."
                        },
                        {
                            "text": "Les soldats ont réussi à se replier en bon ordre après un <w>engagement</w> violent contre l'ennemi."
                        }
                    ],
                    "synonyms": [
                        "combat",
                        "affrontement",
                        "escarmouche"
                    ],
                    "common_phrases": [
                        "engagement armé",
                        "règles d'engagement"
                    ]
                },
                {
                    "sense_id": "20f5c736-ab1f-35d7-b75d-d4ea34d89d3a",
                    "sense_definition": "Enrôlement volontaire d'une personne dans les forces armées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>engagement</w> volontaire dans l'armée de terre a surpris tous ses proches."
                        },
                        {
                            "text": "Le jeune homme a officiellement signé son contrat d'<w>engagement</w> le jour de sa majorité."
