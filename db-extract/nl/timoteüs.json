                    {
                        "translation_id": "5de0b08d-62a9-4237-b86d-1fecf62832e2",
                        "source_entry_id": "278a39c4-12b0-3ebe-b646-e291077ffcdd",
                        "target_lang_word": "Timothy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Timothy",
