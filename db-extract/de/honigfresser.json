                "translations": [
                    {
                        "translation_id": "adcfd90d-7e96-455e-bedb-5e2882ece169",
                        "source_entry_id": "47061303-b324-34d3-9d31-156f5150408e",
                        "source_sense_id": "f630a3a7-be50-30da-9ac4-1d5f4e2cbe4a",
                        "source_sense_description": "Vogel aus der Familie Meliphagidae",
                        "target_lang_word": "honeyeater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honeyeater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                        "entry_id": "48fa6f49-db06-3780-aba6-44fd28fe4ea4",
                                        "glosses": [
                                            "Any of the many Australasian birds of the family Meliphagidae, which have a tongue adapted for obtaining nectar from flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af2be44-b0f5-4715-8987-6c13eb7d0ed3",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "1985, Hugh A. Ford, David C. Paton, Chapter 12: Habitat Selection in Australian Honeyeaters, with Special Reference to Nectar Productivity, Martin L. Cody (editor), Habitat Selection in Birds, 376,\nFor all honeyeaters combined and White-naped Honeyeaters, the only other common species, there is actually a negative correlation between abundance and nectar productivity […] ."
                                            },
                                            {
                                                "example_id": "f0144322-f17b-4969-9c23-70fba3c5a6ec",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "The spiny-cheeked honeyeater has a more generalized diet and the gastrointestinal tract is similar structurally and proportionally to other honeyeaters."
                                            },
                                            {
                                                "example_id": "2b038aea-6eb8-4bd6-b2be-23c19dcbe864",
                                                "sense_id": "67fff212-2abb-3739-a791-7cf467d9e4a5",
                                                "text": "The adopted sequence of genera of Australian honeyeaters follows that implied by the phylogeny of Driskell and Christidis (2004)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d20911e0-bbc1-4d96-a695-11df7c34f4f8",
                        "source_entry_id": "47061303-b324-34d3-9d31-156f5150408e",
                        "source_sense_id": "f630a3a7-be50-30da-9ac4-1d5f4e2cbe4a",
                        "source_sense_description": "Vogel aus der Familie Meliphagidae",
                        "target_lang_word": "méliphage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méliphage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf942019-9a8a-39fa-8720-c16d12ab516f",
                                        "entry_id": "c5812aab-744b-3f9c-9c82-c584d9d68012",
                                        "glosses": [
                                            "Mellivore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba8c42e-6641-4000-a744-f0d8c18454fd",
                                                "sense_id": "cf942019-9a8a-39fa-8720-c16d12ab516f",
                                                "text": "La plus spectaculaire d’entre elles : un oiseau méliphage (mangeur de miel) à tête orange."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méliphage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19de86ba-9e17-3a37-84af-b0af0ec28d78",
                                        "entry_id": "e3480ce5-cc37-3a39-8aaf-04c6d89fe37d",
                                        "glosses": [
                                            "Nom donné à de nombreuses espèces de passereaux de la famille des méliphagidés, qui ont la particularité commune de se nourrir du nectar des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a550eb02-5be6-4d6c-be63-3aebb6aa9da3",
                                                "sense_id": "19de86ba-9e17-3a37-84af-b0af0ec28d78",
                                                "text": "J’ai rencontré fréquemment le Méliphage séricéeux dans les lieux marécageux, sur une plante dont j’ai rapporté plusieurs échantillons, mais souvent isolé et presque toujours au milieu des touffes les plus épaisses."
                                            },
                                            {
                                                "example_id": "de69ed48-bb8b-4d0d-a58e-18686460b060",
                                                "sense_id": "19de86ba-9e17-3a37-84af-b0af0ec28d78",
                                                "text": "Un méliphage carillonneur venait nous rendre visite dans le jardin."
                                            },
                                            {
                                                "example_id": "b824fafb-cdab-4237-9b7f-080c1bcd9039",
                                                "sense_id": "19de86ba-9e17-3a37-84af-b0af0ec28d78",
                                                "text": "Les Méliphages à bavette se nourrissent principalement de fruits, de nectar et d'arthropodes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
