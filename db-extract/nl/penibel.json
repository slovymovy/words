                                "target_senses": [
                                    {
                                        "sense_id": "7abde5c0-d684-3191-b530-740eaad17a3f",
                                        "entry_id": "1ee67e43-f499-3011-9f6b-9f3dd2303672",
                                        "glosses": [
                                            "A critical value, factor, etc."
