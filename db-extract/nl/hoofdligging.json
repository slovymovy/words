                            {
                                "example_id": "cb50fd56-09dc-48f3-b3a4-4b7eb53738cd",
                                "sense_id": "b2e34e80-b1c6-3cf5-af75-983bb9aef2e5",
                                "text": "In het onderzoek van de KNOV werd bij alle vrouwen geprobeerd het kind te draaien naar een hoofdligging. Bij de helft van hen lukte dat, en vervolgens kwam het in verreweg de meeste gevallen tot een vaginale bevalling."
                            },
                            {
                                "example_id": "03e6ba61-108f-4032-9b93-793cd12a4671",
                                "sense_id": "b2e34e80-b1c6-3cf5-af75-983bb9aef2e5",
                                "text": "Gynaecologen zijn erin geslaagd om het aantal keizersnedes terug te dringen. In het Jeroen Bosch Ziekenhuis is het bij 70 procent van de kinderen in stuitligging gelukt om ze te draaien naar hoofdligging. En daardoor is het in 30 procent van die gevallen niet meer nodig om een keizersnede uit te voeren."
                            }
                        ]
