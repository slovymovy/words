                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jaffa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62e69052-05c0-362d-b10c-6d74971736d2",
                                        "entry_id": "e014b123-ec58-3b82-8494-ea560b2d428b",
                                        "glosses": [
                                            "die ursprüngliche Hafenstadt Jaffa, die heute mit der Stadt Tel Aviv vereinigt ist"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30637eb4-3679-4021-b384-a14cc9117b49",
                                                "sense_id": "62e69052-05c0-362d-b10c-6d74971736d2",
                                                "text": "„Die Offiziere legten dar, wo Jordaniens größte Befürchtungen lagen: Ihnen war aufgefallen, dass die jüdischen Truppen Gebiete besetzten und säuberten, die wie Jaffa im UN-designierten arabischen Staatsgebiet lagen.“"
                                            },
                                            {
                                                "example_id": "9423f7eb-c5f8-4e10-ad40-f9d49e3008d3",
                                                "sense_id": "62e69052-05c0-362d-b10c-6d74971736d2",
                                                "text": "„Das 1909 gegründete Tel Aviv war ursprünglich ein Vorort der bereits seit der Antike bestehenden Hafenstadt Jaffa. 1950 wurden beide Städte zum heutigen Tel Aviv-Jaffa vereinigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
