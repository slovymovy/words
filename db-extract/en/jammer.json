                                        "sense_id": "a7e8d8b0-1f1a-3633-b0a6-5fac155eb125",
                                        "entry_id": "6a3c6b04-42f8-388f-8b77-c70b3f84cc51",
                                        "glosses": [
                                            "Émetteur radioélectrique destiné à produire un brouillage."
                                        ],
