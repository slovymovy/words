{
    "word_family": [
        "stallholder",
        "forestall",
        "install"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6aabc9ac-56c7-3117-b054-5f250aa9a4d0",
                    "sense_definition": "A small open-fronted shop or table, for example in a market, where goods are sold.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some fresh fruit at the market <w>stall</w>.",
                            "target_lang_translations": {
                                "ru": "Мы купили свежие фрукты в рыночной <w>палатке</w>.",
                                "zh": "我们在市场上的<w>摊位</w>买了一些新鲜水果。"
                            }
                        },
                        {
                            "text": "She runs a small <w>stall</w> selling handmade jewelry at the fair.",
                            "target_lang_translations": {
                                "ru": "Она держит небольшую <w>палатку</w> по продаже украшений ручной работы на ярмарке.",
                                "zh": "她在集市上经营着一个小<w>摊位</w>，专门售卖手工首饰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "market stall",
                        "food stall",
                        "fruit stall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой открытый магазинчик или прилавок, например на рынке, где продаются товары.",
                        "zh": "一种小型露天商店或摊位，例如在市场上，用于出售商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палатка",
                                "target_lang_sense_clarification": "торговая"
                            },
                            {
                                "target_lang_word": "ларёк",
                                "target_lang_sense_clarification": "киоск"
                            },
                            {
                                "target_lang_word": "прилавок",
                                "target_lang_sense_clarification": "торговое место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摊位",
                                "target_lang_sense_clarification": "市场上的售货点"
                            },
                            {
                                "target_lang_word": "货摊",
                                "target_lang_sense_clarification": "摆放商品的台子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d038abdc-db19-3c55-b138-aa4321957aa2",
                    "sense_definition": "A small enclosed area or room used for a shower or a toilet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went into the shower <w>stall</w> to wash off the mud.",
                            "target_lang_translations": {
                                "ru": "Он зашел в душевую <w>кабинку</w>, чтобы смыть грязь.",
                                "zh": "他走进淋浴<w>隔间</w>去洗掉身上的泥土。"
                            }
                        },
                        {
                            "text": "The door to the toilet <w>stall</w> was locked.",
                            "target_lang_translations": {
                                "ru": "Дверь в туалетную <w>кабинку</w> была заперта.",
                                "zh": "厕所<w>隔间</w>的门锁上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cubicle"
                    ],
                    "common_phrases": [
                        "shower stall",
                        "bathroom stall",
                        "toilet stall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое огороженное пространство или комната, используемая для душа или туалета.",
                        "zh": "用于淋浴或如厕的小型封闭空间或隔间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "душевая или туалетная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔间",
                                "target_lang_sense_clarification": "卫生间或淋浴间的独立空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a90fa958-fbce-3149-b3aa-713a0e135a22",
                    "sense_definition": "A compartment for a single animal in a stable or cattle shed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse was resting quietly in its <w>stall</w>.",
                            "target_lang_translations": {
                                "ru": "Лошадь спокойно отдыхала в своем <w>стойле</w>.",
                                "zh": "马儿正安静地在它的<w>畜栏</w>里休息。"
                            }
                        },
                        {
                            "text": "The farmer cleaned out the cattle <w>stall</w> every morning.",
                            "target_lang_translations": {
                                "ru": "Фермер чистил <w>стойло</w> для скота каждое утро.",
                                "zh": "农夫每天早上都会清理牛<w>畜栏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boose"
                    ],
                    "common_phrases": [
                        "horse stall",
                        "cattle stall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделение для одного животного в конюшне или хлеву.",
                        "zh": "马厩或牛棚中供单只动物居住的隔栏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойло",
                                "target_lang_sense_clarification": "для животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "畜栏",
                                "target_lang_sense_clarification": "牲畜的隔间"
                            },
                            {
                                "target_lang_word": "马厩",
                                "target_lang_sense_clarification": "马匹的隔间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04ec3ab5-088e-35f3-bc34-b9b2fad08c9d",
                    "sense_definition": "A seat in a theatre on the ground floor, close to the stage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had excellent seats in the <w>stalls</w> for the new play.",
                            "target_lang_translations": {
                                "ru": "У нас были отличные места в <w>партере</w> на новой пьесе.",
                                "zh": "我们看那场新剧时，坐在<w>正厅前座</w>，位置非常好。"
                            }
                        },
                        {
                            "text": "Tickets for the <w>stalls</w> are usually more expensive than those in the circle.",
                            "target_lang_translations": {
                                "ru": "Билеты в <w>партер</w> обычно дороже, чем на балкон.",
                                "zh": "<w>正厅前座</w>的票通常比楼座的票贵。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the stalls",
                        "front stalls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место в театре на первом этаже, близко к сцене.",
                        "zh": "剧院底层靠近舞台的座位区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партер",
                                "target_lang_sense_clarification": "в театре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正厅前座",
                                "target_lang_sense_clarification": "剧院底层座位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6405d174-eb3a-39d4-91e3-7daec132b953",
                    "sense_definition": "An action intended to delay something or someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delay_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden questions were just a <w>stall</w> to give him time to think.",
                            "target_lang_translations": {
                                "ru": "Его внезапные вопросы были лишь <w>уловкой</w>, чтобы дать ему время подумать.",
                                "zh": "他突然提出的问题只是为了<w>拖延</w>时间，好让自己思考。"
                            }
                        },
                        {
                            "text": "The manager's long speech was clearly a <w>stall</w> until the lawyers arrived.",
                            "target_lang_translations": {
                                "ru": "Длинная речь менеджера была явно <w>попыткой потянуть время</w> до приезда юристов.",
                                "zh": "经理的长篇大论显然是为了在律师到达前<w>拖延</w>时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, направленное на то, чтобы задержать что-то или кого-то.",
                        "zh": "旨在拖延某事或某人的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрость"
                            },
                            {
                                "target_lang_word": "оттягивание времени",
                                "target_lang_sense_clarification": "задержка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖延",
                                "target_lang_sense_clarification": "故意延误的行为"
                            },
                            {
                                "target_lang_word": "缓兵之计",
                                "target_lang_sense_clarification": "为了争取时间而采取的策略"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80e7137d-9694-3dcf-a484-d4601f62cae4",
                    "sense_definition": "To delay taking action or to distract someone in order to gain time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "delay_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>stalling</w> and tell me the truth immediately.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>тянуть время</w> и немедленно скажи мне правду.",
                                "zh": "别再<w>拖延</w>了，立刻告诉我真相。"
                            }
                        },
                        {
                            "text": "He tried to <w>stall</w> the police until his lawyer arrived.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>задержать</w> полицию до приезда адвоката.",
                                "zh": "他试图<w>拖延</w>警察，直到他的律师赶到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "procrastinate"
                    ],
                    "common_phrases": [
                        "quit stalling",
                        "stall for time",
                        "stop stalling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откладывать действия или отвлекать кого-то, чтобы выиграть время.",
                        "zh": "推迟行动或转移他人注意力以争取时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тянуть время",
                                "target_lang_sense_clarification": "медлить"
                            },
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "отвлекать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖延",
                                "target_lang_sense_clarification": "故意延误"
                            },
                            {
                                "target_lang_word": "磨蹭",
                                "target_lang_sense_clarification": "行动迟缓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "786069d1-8f96-380b-a9a3-70b807aeb728",
                    "sense_definition": "To stop working suddenly (of an engine or vehicle), or to cause this to happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "stop_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My car <w>stalled</w> at the traffic lights and wouldn't start again.",
                            "target_lang_translations": {
                                "ru": "Моя машина <w>заглохла</w> на светофоре и больше не заводилась.",
                                "zh": "我的车在红绿灯处<w>熄火</w>了，之后就再也发动不起来。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>stall</w> the engine when you release the clutch.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>заглушить</w> двигатель, когда отпускаешь сцепление.",
                                "zh": "松离合器时要小心，别让发动机<w>熄火</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "engine stalled",
                        "car stalled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно прекратить работу (о двигателе или транспортном средстве) или вызвать это.",
                        "zh": "（发动机或车辆）突然停止运转，或导致这种情况发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глохнуть",
                                "target_lang_sense_clarification": "о двигателе"
                            },
                            {
                                "target_lang_word": "заглушить",
                                "target_lang_sense_clarification": "остановить двигатель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熄火",
                                "target_lang_sense_clarification": "发动机停止工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a186556-2bf9-31da-9d50-cde5ce4e9e7e",
                    "sense_definition": "To stop making progress or to bring to a standstill.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peace talks have <w>stalled</w> due to a lack of agreement between the parties.",
                            "target_lang_translations": {
                                "ru": "Мирные переговоры <w>зашли в тупик</w> из-за отсутствия согласия между сторонами.",
                                "zh": "由于双方未能达成一致，和平谈判已经<w>陷入僵局</w>。"
                            }
                        },
                        {
                            "text": "The construction project <w>stalled</w> because of funding issues.",
                            "target_lang_translations": {
                                "ru": "Строительный проект <w>застопорился</w> из-за проблем с финансированием.",
                                "zh": "由于资金问题，建筑项目已经<w>停滞</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "negotiations stalled",
                        "talks stalled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановиться в развитии или зайти в тупик.",
                        "zh": "停止进展或陷入停滞状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застопориться",
                                "target_lang_sense_clarification": "остановиться"
                            },
                            {
                                "target_lang_word": "зайти в тупик",
                                "target_lang_sense_clarification": "о переговорах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停滞",
                                "target_lang_sense_clarification": "进展停止"
                            },
                            {
                                "target_lang_word": "陷入僵局",
                                "target_lang_sense_clarification": "谈判或项目无法推进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2e17520-f5eb-3321-bbab-602e45b923d9",
                    "sense_definition": "To lose lift and drop because the aerodynamic angle is too steep (of an aircraft).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot accidentally <w>stalled</w> the plane during the steep climb.",
                            "target_lang_translations": {
                                "ru": "Пилот случайно <w>свалил</w> самолет в штопор во время крутого набора высоты.",
                                "zh": "飞行员在陡峭爬升过程中不慎导致飞机<w>失速</w>。"
                            }
                        },
                        {
                            "text": "If the aircraft slows down too much, it might <w>stall</w> and lose altitude.",
                            "target_lang_translations": {
                                "ru": "Если самолет слишком сильно замедлится, он может <w>свалиться</w> и потерять высоту.",
                                "zh": "如果飞机减速过多，可能会<w>失速</w>并失去高度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stall warning"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context often used in general aviation discussions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерять подъемную силу и начать падать из-за слишком крутого угла атаки (о самолете).",
                        "zh": "（飞机）因迎角过大而失去升力并下坠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливаться",
                                "target_lang_sense_clarification": "авиация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失速",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}