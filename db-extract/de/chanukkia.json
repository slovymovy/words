                ],
                "senses": [
                    {
                        "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                        "entry_id": "2663c796-52e7-3b79-99ae-0e223fed4dd6",
                        "glosses": [
                            "acht- oder neunarmiger Leuchter, der zu Chanukka angezündet wird"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "47bae141-feae-4c97-8a50-fc49d87e976c",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„Die Chanukkia, die ich mit Georg bei unserem Flohmarktrundgang gleich am dritten oder vierten Stand entdeckt hatte, war die schönste Chanukkia, die ich jemals in meinem Leben gesehen habe.“"
                            },
                            {
                                "example_id": "e62580e2-312f-4300-8d8d-24b6f66d301e",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„Chanukkia und Menora, die jüdischen Leuchter, werden von Nicht-Juden oft verwechselt. Heinrich Heine beschrieb 1840 die vom Licht der Chanukkias erleuchteten Fenster in der Frankfurter Judengasse, wo er abends entlangspazierte.“"
                            },
                            {
                                "example_id": "26b9f32f-2953-42a7-9a33-725e5cbe19f4",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„In der Tat gibt es Chanukkiot in ganz verschiedenen Formen und Größen.“"
                            },
                            {
                                "example_id": "077af1bb-4385-4033-b9dc-698f383f767d",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„Er hatte die Chanukkia den ganzen Tag bis nachmittags, zu der Besprechung, auf den Straßen der Ostseite von Manhattan mit sich herumgeschleppt.“"
                            },
                            {
                                "example_id": "4f823c78-ee7f-4a2b-a986-6e288283c04f",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„So vielfältig wie die Menschen sind auch ihre Chanukkiot.“"
                            },
                            {
                                "example_id": "645c1703-ad3c-4f37-9711-6852ab9f7b19",
                                "sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                                "text": "„Während die Lichter auf der Chanukkia, dem Chanukkaleuchter, die Fackeln und die Lampen in allen jüdischen Häusern im Galata-Viertel leuchteten, wartete Blancas Entbindungsbett schon in dem Raum, der für die Niederkunft vorbereitet war, da dieses freudige Ereignis kurz bevorstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d7b68f-c0a6-4d32-9e86-3a356a5a7d3e",
                        "source_entry_id": "2663c796-52e7-3b79-99ae-0e223fed4dd6",
                        "source_sense_id": "7ce5c2bc-f890-3653-b17b-ce2e21e114f3",
                        "source_sense_description": "jüdische Religion: acht- oder neunarmiger Leuchter, der zu Chanukka angezündet wird",
                        "target_lang_word": "hanukkiah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hanukkiah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                        "entry_id": "f4069dcf-5f96-3705-b5dd-ae397d977191",
                                        "glosses": [
                                            "A nine-branched menorah used during Hanukkah."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f9a490-f1ff-4fa7-9720-1d7d2e04fe32",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "Some might say that the hanukkiah is decorations, but it isn't; the hanukkiah is a ceremonial object, with specific, non-decorative purposes. Perhaps the Stars of David that many string about are appropriate Jewish decoration?"
                                            },
                                            {
                                                "example_id": "86bab17c-ca8b-476b-b865-f654ec9d103a",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "As a child of Holocaust survivors, there was nothing, no family relics. The celebration was very modest, with a very small hanukkiah, and my mother was a great maker of latkes. I now luckily have many different kinds of hanukkiahs."
                                            },
                                            {
                                                "example_id": "b2bfc09d-1328-49d2-a6a8-7d9bf9b2cc67",
                                                "sense_id": "a20f2a3e-ab9a-3810-9215-3c0c6c2db05f",
                                                "text": "The candelabras lit on Hanukkah are technically called hanukkiahs. They have eight candles plus one more, a shamash, that is used for lighting the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
