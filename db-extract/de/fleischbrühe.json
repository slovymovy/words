                ],
                "senses": [
                    {
                        "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                        "entry_id": "1fab7234-4451-3e23-9e98-8f11e3b0dad7",
                        "glosses": [
                            "herzhafte Flüssigkeit, die aus Wasser, Fleisch, Knochen / Markknochen, Gewürzen und zusätzlich meist mit verschiedenen Gemüsen gekocht wurde"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "c9000a46-d661-40c4-acb7-949467bf795e",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Rinderknochen sind die Grundlage für [eine] kräftige Fleischbrühe."
                            },
                            {
                                "example_id": "747dc218-1158-4386-abcb-804455be0fac",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Die Basis für eine kräftige Fleischbrühe sind Knochen, Suppenfleisch und Gemüse."
                            },
                            {
                                "example_id": "85f52dbd-90b1-4814-a5ad-c011aa0a6fa6",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Maultaschen lässt man in reichlich Fleischbrühe ca. 10 - 15 Min Minuten ziehen."
                            },
                            {
                                "example_id": "a1f2566b-6495-4a48-94d9-001bc05fa869",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "[…] Durch die offen stehende Glastür duftet es herzhaft nach Fleischbrühe, nach Sternanis, Ingwer und Knoblauch."
                            },
                            {
                                "example_id": "36d31af3-9857-4320-a83f-e30396af53e9",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Bisher ist bei Fertiggerichten wie Suppen und Saucen [für Vegetarier] oft nicht zu erkennen ob zum Beispiel Fleischbrühe als Zutat drinsteckt […]"
                            },
                            {
                                "example_id": "6262122b-0517-45be-879e-f29bb9534b77",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Vor Weihnachten gibt es in vielen Supermärkten und Discountern ein besonders großes Angebot an Fleischbrühe im Glas."
                            },
                            {
                                "example_id": "999306b2-e733-4a9f-91c8-0edcc8e6c215",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Wem die Fleischbrühe wichtiger ist als das Fleisch, setzt das Fleisch (Fleischabschnitte oder auch Knochen) für die Brühe kalt auf und erhöht dann die Temperatur."
                            },
                            {
                                "example_id": "11cfaa89-e479-4f4d-a45a-d3b62996108a",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "[Es] wäre historisch arg verengt, wollte man [den Chemiker Justus] Liebig nur auf seine Fleischbrühe reduzieren. […] Unter dem Namen \"Eine neue Fleischbrühe für Kranke\" veröffentlichte Liebig später das Rezept."
                            },
                            {
                                "example_id": "b0412553-d24d-4254-b162-910bd35a7bb5",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "[…] meine Mutter [war] als Hebamme gut dran. Wir waren sechs Kinder, und wenn sie beim Bauern entbunden hat, dann kriegte sie einen Topf Fleischbrühe mit oder auch ein bisschen mehr."
                            },
                            {
                                "example_id": "390b6080-13ec-4b00-8ca2-9b0dd99cf223",
                                "sense_id": "7d7d5fe7-032a-3eb5-8ed3-bc80c07ec687",
                                "text": "Hat die Maſſe einige Zeit geſtanden, so werden kleine Klößchen davon in ſiedende Fleiſchbrühe gelegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
