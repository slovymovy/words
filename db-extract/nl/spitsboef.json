                        "sense_id": "9244d097-1063-3012-b842-65e523c1ce34",
                        "entry_id": "b033e549-1c78-3361-b93f-94f8669149e8",
                        "glosses": [
                            "een sluwe boef"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f8fe9d-137e-46c8-addb-e11696167376",
                                "sense_id": "9244d097-1063-3012-b842-65e523c1ce34",
                                "text": "Maar wanneer een spitsboef als Sam Klepper een ereronde door de stad krijgt, mag iedereen die Danny Tomson lief had voor mijn part De Kuip een uurtje claimen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea17292d-a3ef-3386-aec3-52b8fe59b6e0",
                        "entry_id": "b033e549-1c78-3361-b93f-94f8669149e8",
                        "glosses": [
                            "kwajongen, een grote schelm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc83c91-4e2d-4d79-89f3-f95c4b2f5fb5",
                                "sense_id": "ea17292d-a3ef-3386-aec3-52b8fe59b6e0",
                                "text": "‘Ooit zal uw reportage tegen mij worden gebruikt, Martin. De beelden van mijn landhuisje zullen de fiscus irriteren. In Terzake en aanverwante programma's zullen ze worden opgevist om te insinueren wat voor een poenpakker, oplichter en spitsboef ik eigenlijk wel ben. Maar het kan mij niet schelen. Weet je waarom? Omdat ik niet wil wijken voor kleingeestige sentimenten als afgunst en leedvermaak.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aec3b5b4-956e-4415-98aa-fc5df90db341",
                        "source_entry_id": "b033e549-1c78-3361-b93f-94f8669149e8",
                        "source_sense_id": "ea17292d-a3ef-3386-aec3-52b8fe59b6e0",
