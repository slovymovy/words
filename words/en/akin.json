                    "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                    "sense_definition": "Allied by nature; similar; partaking of the same properties; of the same kind.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden feeling of dread was <w>akin</w> to panic.",
