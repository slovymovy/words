                                    {
                                        "sense_id": "ca71e2cf-ed99-3420-8f99-c8130de4bdfd",
                                        "entry_id": "2bbac17e-8ff1-3eb8-a636-815df2f9d042",
                                        "glosses": [
                                            "Forme de dialecte propre à un groupe ethnique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980cfa5b-031a-4fd5-8292-563f4c3ca034",
                                                "sense_id": "ca71e2cf-ed99-3420-8f99-c8130de4bdfd",
                                                "text": "Par exemple, Ebonics ou l’anglais parlé par certaines personnes de race noire peut être caractérisé comme étant un ethnolecte."
                                            }
