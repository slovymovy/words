                            {
                                "example_id": "98b6ee8d-c604-44b2-92f8-c840f3a1621d",
                                "sense_id": "dcd78000-9ed7-3951-88b9-381f17c44a78",
                                "text": "Die Kirche wurde aus Muschelkalk und Buntsandstein gebaut."
                            },
                            {
                                "example_id": "dc247994-61a7-42a8-86f5-5709b2aa4c7b",
                                "sense_id": "dcd78000-9ed7-3951-88b9-381f17c44a78",
                                "text": "Der Muschelkalk überlagert den Buntsandstein und wird seinerseits vom Keuper überlagert."
                            }
