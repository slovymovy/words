                "translations": [
                    {
                        "translation_id": "29053079-5d84-4229-a96f-86939f23bcdc",
                        "source_entry_id": "be5d9742-b604-366f-ae61-834ae16554e8",
                        "target_lang_word": "difficulty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "difficulty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "286266fc-e894-3f22-9851-9da1bca781d7",
                                        "entry_id": "befa7da5-169b-307f-bdd4-22b072e383a7",
                                        "glosses": [
                                            "The state of being difficult, or hard to do."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181b51ba-3e45-4070-ba9c-de4d1f04f7aa",
                                                "sense_id": "286266fc-e894-3f22-9851-9da1bca781d7",
                                                "text": "My mom is old and has a lot of difficulty (in) remembering all her grandchildren's names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cce43b-aedc-3ff8-877b-1ceb522cd5cf",
                                        "entry_id": "befa7da5-169b-307f-bdd4-22b072e383a7",
                                        "glosses": [
                                            "An obstacle that hinders achievement of a goal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027b3fe3-06e5-473e-808c-30f4564da08b",
                                                "sense_id": "79cce43b-aedc-3ff8-877b-1ceb522cd5cf",
                                                "text": "We faced a difficulty in trying to book a flight so late."
                                            },
                                            {
                                                "example_id": "8ee75271-eee6-4117-bafb-e6f007c503ed",
                                                "sense_id": "79cce43b-aedc-3ff8-877b-1ceb522cd5cf",
                                                "text": "The difficulties of photoheliography consist principally in the rapidity with which the sun's image acts upon the sensitive film."
                                            },
                                            {
                                                "example_id": "de4b7e56-e89e-4bae-bbea-1dd5a144ff66",
                                                "sense_id": "79cce43b-aedc-3ff8-877b-1ceb522cd5cf",
                                                "text": "The two-hour debate was briefly stalled by a technical difficulty with the moderators’ microphones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                                        "entry_id": "befa7da5-169b-307f-bdd4-22b072e383a7",
                                        "glosses": [
                                            "Physical danger from the environment, especially with risk of drowning"
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aab2909-4bfa-4a45-8193-125edd5647ff",
                                                "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                                                "text": "2012 August 2, \"Children rescued after getting into difficulties in Donegal\" BBC Online"
                                            },
                                            {
                                                "example_id": "6a58bd8a-f8d1-4541-9cf6-470950c19289",
                                                "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                                                "text": "The three teenagers, a girl and two boys, were playing by the river when it is believed they got into difficulty."
                                            },
                                            {
                                                "example_id": "b2e50ca4-3e85-439c-a5bf-c52ccc86064b",
                                                "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                                                "text": "Members of the public had called 999 as they were concerned the kayaker was in difficulty around the headland race due to very strong spring tides and choppy seas with the kayaker making no headway."
                                            },
                                            {
                                                "example_id": "2296669b-787d-4215-af40-9fb2459f24ee",
                                                "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                                                "text": "A group of young people had to be rescued from Dartmoor on Friday night after getting into difficulty during a Duke of Edinburgh exercise. […] A 16-year-old girl required medical attention and a medic was winched down to the site by helicopter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafecf60-e89f-39a7-9f4c-d1cec990b507",
                                        "entry_id": "befa7da5-169b-307f-bdd4-22b072e383a7",
                                        "glosses": [
                                            "An objection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc8a3425-2116-3253-97b7-2498ec66f1d4",
                                        "entry_id": "befa7da5-169b-307f-bdd4-22b072e383a7",
