                                    {
                                        "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                        "entry_id": "ca2919a2-d393-3610-aae7-b4a2da90bd8a",
                                        "glosses": [
                                            "Dieu roi de la mythologie égyptienne."
                                        ],
                                        "tags": [
                                            "Mythologie égyptienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51e576e-3211-4379-8932-caae381d7985",
                                                "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                                "text": "Dix prêtres, du Nil clair suivant la haute berge,\nD’un pas égal, le front incliné vers le sol,\nPortent la barque peinte où, sous un parasol,\nSiège le fils d’Amon, Khons, le Dieu calme et vierge."
                                            },
                                            {
                                                "example_id": "422d35d2-47a3-4ab3-95ca-1fd82bb43ffb",
                                                "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                                "text": "Il a été commandé par Ahmosis, le roi de Thèbes, pour le temple du dieu Amon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
