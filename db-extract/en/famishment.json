                        "entry_id": "516de19b-3795-3a36-b6f2-5f39c879c2b4",
                        "glosses": [
                            "The state or process of being famished."
                        ],
                        "tags": [
                            "countable",
                            "literary",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7131aed2-60f7-4575-b351-36e73b88e346",
                                "sense_id": "4fe07457-b4ad-3c41-aa3f-0af4811e5398",
                                "text": "He churned the emptiness of my stomach, and stirred the fury of my famishment."
                            },
                            {
                                "example_id": "2bbe38bc-0872-44a8-b45b-9a501f71f5ab",
                                "sense_id": "4fe07457-b4ad-3c41-aa3f-0af4811e5398",
                                "text": "Sith you will not attend true Wisedoms Words,\nLaugh and bee fatt, sith al you touch is Gold,\nThough that foode your Soules famishment affordes."
                            },
                            {
                                "example_id": "f54a90da-05b8-4ce2-90a0-4edf2f1cf455",
                                "sense_id": "4fe07457-b4ad-3c41-aa3f-0af4811e5398",
                                "text": "[…] among the French planters, the slaves are in a condition of almost utter famishment during the great portion of the year."
                            },
                            {
                                "example_id": "b71332e2-db12-46b6-aa2e-897fab8c954a",
                                "sense_id": "4fe07457-b4ad-3c41-aa3f-0af4811e5398",
                                "text": "As the young Cuban tasted his flesh, his tropical appetite long depressed by the North American dryness suddenly revived, and brought to his mind the thought of his long famishment."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7118047-f0eb-3311-845d-eaa665186389",
                        "entry_id": "516de19b-3795-3a36-b6f2-5f39c879c2b4",
                        "glosses": [
                            "Famine."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "53fc6d91-80c4-42de-a1d5-8bf857abd8fe",
                                "sense_id": "d7118047-f0eb-3311-845d-eaa665186389",
                                "text": "And there ſhalbe erthquakes / in all quarters / and famyſſhment / and troubles."
                            }
                        ]
