                "senses": [
                    {
                        "sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                        "entry_id": "509f5b28-9a96-3b8b-a72c-3eea87ffb234",
                        "glosses": [
                            "zonder ordening of regelmaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a11b5427-9eae-42c2-bc9d-57a6633b9300",
                                "sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                                "text": "Hierheen, Stiva, hierheeniep Levin en hij voelde hoe zijn hart steeds heftiger begon te bonzen en hoe er als het ware een grendel weggeschoven werd in zijn gespannen luisteren; hij verloor elk begrip van afstand en alle geluiden troffen ongeordend, maar uiterst scherp zijn oor."
                            },
                            {
                                "example_id": "661d243e-8e66-4301-ad9a-608dcffd74f3",
                                "sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                                "text": "In een open brief schrijft de bisschop dat hij de dialoog met de homogemeenschap blijft zoeken, hoe moeizaam dat volgens hem ook gaat. Maar hij verwijst ook naar het officiële standpunt van de Rooms-Katholieke Kerk: \"Naar rooms-katholiek inzicht vormt het huwelijk, als levensverbond tussen man en vrouw, het kader van een geordende seksualiteitsbeleving. Andere vormen van seksualiteitsbeleving gelden als ongeordend. Als rooms-katholiek bisschop ben ik geroepen deze leer voor te houden.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aaef70f-d854-4e81-ad02-8c5c6b49f787",
                        "source_entry_id": "509f5b28-9a96-3b8b-a72c-3eea87ffb234",
                        "source_sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                        "target_lang_word": "unsorted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsorted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "492d3e79-6d86-324d-936c-944175bf5da7",
                                        "entry_id": "a84cd890-c5de-368a-b343-4d1f4be71480",
                                        "glosses": [
                                            "Not in any particular order or sequence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b9daf7-9b1d-499a-8fac-87389c74e714",
                                                "sense_id": "492d3e79-6d86-324d-936c-944175bf5da7",
                                                "text": "Had the council warrants been in order, no question but considerable discoveries might have been made of the iniquity of this time; but those being unsorted, and in no small confusion, I was obliged to keep myself by what the managers have thought fit to put into the registers; and it is surprising to find some things there, which we shall afterwards meet with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb104575-9017-3be4-8f6e-adf16d00981f",
                                        "entry_id": "a84cd890-c5de-368a-b343-4d1f4be71480",
                                        "glosses": [
                                            "Mixed, jumbled, not separated by property into categories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3306f9-3e71-48b0-a172-7cb4fca57cbb",
                                                "sense_id": "cb104575-9017-3be4-8f6e-adf16d00981f",
                                                "text": "When he knocked the tray of type sorts onto the floor, he simply scooped everything back into the compartments, all unsorted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ba3b20d-be11-3742-a411-b5071d69275d",
                                        "entry_id": "a84cd890-c5de-368a-b343-4d1f4be71480",
                                        "glosses": [
                                            "Ill-chosen, inconvenient, unsuitable"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1728a877-79b4-4046-b3a3-4f20d9f8d349",
                                                "sense_id": "1ba3b20d-be11-3742-a411-b5071d69275d",
                                                "text": "The purpose you undertake is dangerous; the friends you have named uncertain; the time itself unsorted; and your whole plot too light for the counterpoise of so great an opposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbbb07ec-f05c-4ea1-9dc9-c7ef570d517b",
                        "source_entry_id": "509f5b28-9a96-3b8b-a72c-3eea87ffb234",
                        "source_sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                        "target_lang_word": "untidy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untidy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12bbc9e7-44f5-3dc7-90c1-1e9f904d725a",
                                        "entry_id": "aac73de8-cb80-3584-b89e-94b0441822b1",
                                        "glosses": [
                                            "Sloppy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c264ec3a-02e6-473d-9827-5c8734a07bba",
                                                "sense_id": "12bbc9e7-44f5-3dc7-90c1-1e9f904d725a",
                                                "text": "I have never seen such an untidy bedroom!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                        "entry_id": "aac73de8-cb80-3584-b89e-94b0441822b1",
                                        "glosses": [
                                            "Disorganized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2a2af2-541c-4150-8509-dc5b3a7b10cd",
                                                "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                                "text": "His finances were in an untidy state when he died."
                                            },
                                            {
                                                "example_id": "1e31cc01-4ae2-4888-aba7-74d8dad92d4f",
                                                "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "untidy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca56dbe-e93b-3629-993e-31c8c998b664",
                                        "entry_id": "ca208ad2-69c0-3840-b6a2-e2a6d672f8b6",
                                        "glosses": [
                                            "To make untidy, to make a mess"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100e2e1d-263b-41ae-8b68-3831120e16d0",
                                                "sense_id": "6ca56dbe-e93b-3629-993e-31c8c998b664",
                                                "text": "Before she closed each drawer she rummaged her hands through the clothes, untidying them just enough to feel comfortable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "589561ea-aeaa-4c8c-b83f-3bc84e22f5bd",
                        "source_entry_id": "509f5b28-9a96-3b8b-a72c-3eea87ffb234",
                        "source_sense_id": "531a615c-7d9a-3288-a9c8-b93e8f9ce072",
                        "target_lang_word": "disorganized",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disorganized",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25c88d65-dda5-3f64-a6f7-24ac47de440c",
                                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                                        "glosses": [
                                            "Lacking order or organization; confused; chaotic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f6984e-9bf4-411c-b15b-29b0b2b3f522",
                                                "sense_id": "25c88d65-dda5-3f64-a6f7-24ac47de440c",
                                                "text": "If we fail to repulse the enemy within the gates--unemployment, poverty, disorganized agriculture and the like--from whence may we expect the united strength and clear purpose to repulse any outside force?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e3e48c-3bb9-32f3-8cc9-d18dd123c976",
                                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                                        "glosses": [
                                            "Lacking skills for organizing one's affairs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaeff37-1389-40a1-8913-d5e8adde91fe",
                                                "sense_id": "46e3e48c-3bb9-32f3-8cc9-d18dd123c976",
                                                "text": "He is quite disorganized and has difficulty planning his day or remembering when his homework is due."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b483b0d-3acb-37c5-a67f-0dae6d9f37eb",
                                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                                        "glosses": [
                                            "In a state of disruption of orderly psychological functioning; engaging in behavior that is chaotic, self-contradictory, or out of keeping with reality; (of a mental illness) poorly controlled and leading to a disorganized state."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
