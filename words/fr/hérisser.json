            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba9639a9-3991-31d8-9873-64663f750b0b",
                    "sense_definition": "Dresser des poils, des cheveux ou des plumes de manière droite et raide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dresser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat apeuré <w>hérisse</w> ses poils face au grand chien du voisin."
                        },
                        {
                            "text": "Le vent glacial du matin fait <w>hérisser</w> les plumes des petits oiseaux sur la branche."
                        }
                    ],
                    "synonyms": [
                        "dresser",
                        "ériger"
                    ],
                    "antonyms": [
                        "aplatir",
                        "lisser"
                    ],
                    "common_phrases": [
                        "hérisser ses poils",
                        "hérisser les plumes"
                    ]
                },
                {
                    "sense_id": "315421bc-d702-31d8-89b1-c2bfd5fec44b",
                    "sense_definition": "Provoquer une vive irritation, agacer ou énerver fortement une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irriter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette attitude particulièrement arrogante a fini par <w>hérisser</w> tous ses collègues de travail."
                        },
                        {
                            "text": "Les remarques injustifiées de ce client finissent toujours par me <w>hérisser</w>."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "exaspérer",
                        "irriter",
                        "énerver"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "hérisser les nerfs"
                    ]
                },
                {
                    "sense_id": "34246812-fd1f-38ec-a1d3-c575ed34dd14",
                    "sense_definition": "Garnir ou recouvrir un lieu ou un objet d'éléments pointus ou saillants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "garnir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gardes ont décidé de <w>hérisser</w> le sommet de la clôture de pointes métalliques."
                        },
                        {
                            "text": "De gros rochers tranchants <w>hérissent</w> la crête sauvage de cette montagne isolée."
                        }
                    ],
                    "synonyms": [
                        "armer",
                        "garnir"
                    ],
                    "common_phrases": [
