                    {
                        "translation_id": "2742f6bf-923d-4e45-ba57-b3ea8a315fb6",
                        "source_entry_id": "7712c1cf-b636-3c33-b7ec-ebe24f00d7e1",
                        "source_sense_id": "78bf9b51-37bb-3849-8e6e-ce86e88557ac",
                        "source_sense_description": "ruimte bestemd voor de huisvesting van varkens; 2. (figuurlijk) vuile boel",
                        "target_lang_word": "Schweinestall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "Stall, in dem Hausschweine gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdad035-2258-491d-a042-a1a14e5437e1",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "Morgen wird der Schweinestall ausgemistet."
                                            },
                                            {
                                                "example_id": "d007560b-ebe8-42fb-941b-805e7be335a0",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Die Dondorfer Zinkwanne im ausgedienten Schweinestall vor Augen, prustete ich los.“"
                                            },
                                            {
                                                "example_id": "5abb44c0-231c-4ce3-97f5-5a468848098d",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Ein paar Kuh- und Schweineställe bildeten das Ganze dieser Hinterwäldler-Siedlung.“"
                                            },
                                            {
                                                "example_id": "8b8e6511-8ae8-4260-b382-9929bde2a5f7",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Er war ein Mannsbild und in der Faktorei ein Mädchen für alles und durfte im Schweinestall schlafen.“"
                                            },
                                            {
                                                "example_id": "3fb20b0b-18e5-4111-8b03-230c72a060f4",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Bald wurde der Schweinestall zu eng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "unordentlicher, schmutziger Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe1252-dd75-4b32-a6ea-4776e2da22e3",
                                                "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                                "text": "Wie kannst du in aller Ruhe in diesem Schweinestall sitzen und fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
