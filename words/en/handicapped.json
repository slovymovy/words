{
    "word_family": [
        "handicap",
        "handicapper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "256318a3-2139-3825-b166-21fb376dd409",
                    "sense_definition": "Having a physical or mental disability.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel provides specially adapted rooms for <w>handicapped</w> guests.",
                            "target_lang_translations": {
                                "tr": "Otel, <w>engelli</w> misafirler için özel olarak uyarlanmış odalar sunmaktadır."
                            }
                        },
                        {
                            "text": "Parking in a <w>handicapped</w> parking space without a permit is illegal.",
                            "target_lang_translations": {
                                "tr": "İzin belgesi olmadan <w>engelli</w> park yerine park etmek yasa dışıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "disabled",
                        "impaired"
                    ],
                    "antonyms": [
                        "able-bodied"
                    ],
                    "common_phrases": [
                        "handicapped parking",
                        "handicapped accessible"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often considered dated or offensive; 'disabled' is generally preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Fiziksel veya zihinsel bir engeli olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "engelli",
                                "target_lang_sense_clarification": "fiziksel veya zihinsel yetersizliği olan"
                            },
                            {
                                "target_lang_word": "özürlü",
                                "target_lang_sense_clarification": "eski ve bazen kaba kabul edilen kullanım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d626befd-4d02-3167-8fc8-e20c124df64f",
                    "sense_definition": "Disadvantaged or hindered by a particular limitation or circumstance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hindrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was severely <w>handicapped</w> by a sudden shortage of materials.",
                            "target_lang_translations": {
                                "tr": "Şirket, ani malzeme kıtlığı sebebiyle ciddi biçimde <w>sekteye uğradı</w>."
                            }
                        },
                        {
                            "text": "Candidates without digital skills will find themselves severely <w>handicapped</w> in the job market.",
                            "target_lang_translations": {
                                "tr": "Dijital becerileri olmayan adaylar, iş piyasasında kendilerini son derece <w>dezavantajlı</w> bulacaktır."
                            }
                        }
                    ],
                    "synonyms": [
                        "disadvantaged",
                        "hindered",
                        "impeded"
                    ],
                    "antonyms": [
                        "advantaged"
                    ],
                    "common_phrases": [
                        "severely handicapped"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir kısıtlama veya olumsuz durum nedeniyle dezavantajlı duruma düşmüş, engellenmiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dezavantajlı",
                                "target_lang_sense_clarification": "olumsuz şartlar nedeniyle geri kalmış"
                            },
                            {
                                "target_lang_word": "eli kolu bağlı",
                                "target_lang_sense_clarification": "hareket veya ilerleme alanı kısıtlanmış"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33f814fe-01a3-3447-8065-ea2a6b21d6f3",
                    "sense_definition": "Simple past and past participle of <w>handicap</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hindrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden leg injury <w>handicapped</w> the runner during the final lap.",
                            "target_lang_translations": {
                                "tr": "Ani bir bacak sakatlığı, son turda koşucuyu <w>engelledi</w>."
                            }
                        },
                        {
                            "text": "Poor communication had <w>handicapped</w> the team throughout the entire project.",
                            "target_lang_translations": {
                                "tr": "Yetersiz iletişim, tüm proje boyunca ekibe <w>köstek olmuştu</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'handicap' fiilinin geçmiş zaman ve geçmiş zaman ortacı hali; engellemek, dezavantajlı duruma düşürmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "engellemek",
                                "target_lang_sense_clarification": "köstek olmak, zorlaştırmak"
                            },
                            {
                                "target_lang_word": "aksatmak",
                                "target_lang_sense_clarification": "işleyişi güçleştirmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5078f0d-7a18-36d4-9f50-cf976b404717",
                    "sense_definition": "A person with a physical or mental disability.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization works to protect the rights of the <w>handicapped</w> in the workplace.",
                            "target_lang_translations": {
                                "tr": "Kuruluş, iş yerinde <w>engellilerin</w> haklarını korumak için çalışmaktadır."
                            }
                        },
                        {
                            "text": "New public buildings must ensure accessible entrances for the <w>handicapped</w>.",
                            "target_lang_translations": {
                                "tr": "Yeni kamu binaları, <w>engelliler</w> için erişilebilir girişler sağlamalıdır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the handicapped"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Now widely avoided and considered offensive; 'disabled person' is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Fiziksel veya zihinsel engeli bulunan kimse (genellikle çoğul 'the handicapped' olarak topluluğu ifade eder)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "engelli",
                                "target_lang_sense_clarification": "engeli bulunan kimse"
                            },
                            {
                                "target_lang_word": "özürlü",
                                "target_lang_sense_clarification": "eski kullanım, engelli kimse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}