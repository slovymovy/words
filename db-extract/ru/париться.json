                    },
                    {
                        "form_id": "7cb0c120-7783-41df-9d2d-be8085056a78",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "па́рившись"
                    },
                    {
                        "form_id": "c3e8f10d-50b0-4000-a786-49b4fffd2f8a",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… па́риться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17565173-9769-3c84-b385-def24aa5aa63",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "glosses": [
                            "подвергать своё тело действию пара в горячей бане"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f584d9-dc75-4ea7-b4c4-ab25d0988f48",
                                "sense_id": "17565173-9769-3c84-b385-def24aa5aa63",
                                "text": "Париться веником."
                            },
                            {
                                "example_id": "61c08fc0-4c1f-4544-aa4c-7c2e9b12beac",
                                "sense_id": "17565173-9769-3c84-b385-def24aa5aa63",
                                "text": "Прежде всего я отправляюсь в воронинские бани, где парюсь до тех пор, покамест не сознаю себя вполне трезвым."
                            }
                        ]
                    },
                    {
                        "sense_id": "0147f0f0-0052-398a-8077-3f537c9719f6",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "glosses": [
                            "перен. подвергаться действию жары, зноя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388c75c2-e185-4226-874e-9a74928ff8ac",
                                "sense_id": "0147f0f0-0052-398a-8077-3f537c9719f6",
                                "text": "Париться на солнце."
                            },
                            {
                                "example_id": "6bd66be4-e2fb-4d15-94f5-52f99ecb20bc",
                                "sense_id": "0147f0f0-0052-398a-8077-3f537c9719f6",
                                "text": "Второй раз за день париться в душном вагоне метро я уже не захотел."
                            }
                        ]
                    },
                    {
                        "sense_id": "3be4825f-a847-30e3-9bb0-4d285abc8134",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "glosses": [
                            "жарг. потеть, томиться, суетиться, нервничать, мучиться, заниматься чем-либо тяжёлым, неприятным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7fb53b-d926-4fef-8465-f577e7f1bc0f",
                                "sense_id": "3be4825f-a847-30e3-9bb0-4d285abc8134",
                                "text": "Кровати были пустыми, ― то ли соседей перевели, то ли они парились на допросе."
                            },
                            {
                                "example_id": "3a7096e4-296f-40f5-94ec-a901613ddb08",
                                "sense_id": "3be4825f-a847-30e3-9bb0-4d285abc8134",
                                "text": "― А должна бы, как мы, от понедельника до пятницы тут париться за копейки, ― недовольно протянула баба, перелистывавшая бумаги."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfe0e3af-d12a-380e-bda9-6416970797bc",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "glosses": [
                            "жарг. беспокоиться о чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f995d7e2-df41-4836-8840-c6aa2a2d9f0f",
                                "sense_id": "dfe0e3af-d12a-380e-bda9-6416970797bc",
                                "text": "В богатых странах люди среднего класса не парятся о моде и носят то, что удобно."
                            }
                        ]
                    },
                    {
                        "sense_id": "458b463b-ec2b-37a8-a53a-1e28a3886c25",
                        "entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "glosses": [
                            "жарг. делать что-либо с усердием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7831c7ed-2a6c-42a8-93dd-16ea956a43e4",
                                "sense_id": "458b463b-ec2b-37a8-a53a-1e28a3886c25",
                                "text": "Если бы мне надо было напечатать подробное резюме на несколько листов да ещё и с цветной фотографией только для того, чтобы показать его преподавателю на курсах переподготовки, то я бы просто не стал париться."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "75968d8a-7e4f-4b18-b66b-ee62b2619eb6",
                        "source_entry_id": "a1508857-c4ba-32e0-9cda-bf1a733f067a",
                        "source_sense_ids": [
