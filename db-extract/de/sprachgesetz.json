                ],
                "senses": [
                    {
                        "sense_id": "f3f8f256-99db-35ea-9c75-d1b59b156524",
                        "entry_id": "ead99444-cebc-3eef-9b97-18d3dbccce3c",
                        "glosses": [
                            "allgemeingültige Aussage über einen Zustand oder einen Prozess, die sich in Sprachen zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e821fe-f3b2-4e72-b045-7f9c139bba65",
                                "sense_id": "f3f8f256-99db-35ea-9c75-d1b59b156524",
                                "text": "Die Lautgesetze der Junggrammatiker sind Sprachgesetze; sie machen allgemeine Aussagen über die Lautbeziehungen zwischen Sprachen."
                            },
                            {
                                "example_id": "f9eba3a6-9a92-4e04-8acb-a034cdc84486",
                                "sense_id": "f3f8f256-99db-35ea-9c75-d1b59b156524",
                                "text": "„Aus der Annahme von Sprachgesetzen und aus der seinerzeit aktuellen psychologischen Lehre von Assoziationen, die bei der Begriffsbildung eine Rolle spielen, leitete Paul ab, dass jedes Einzelwort im Zentrum mehrerer psychisch bedingter Netze stehe, ohne deren Kenntnis das Einzelwort vor allem in semantischer Hinsicht nicht erklärt werden könne.“"
                            },
                            {
                                "example_id": "a63bfbbf-9fdb-4432-87bf-179056ca2392",
                                "sense_id": "f3f8f256-99db-35ea-9c75-d1b59b156524",
                                "text": "„An eine Vermittlung der Sprachgesetze hapere es in der Lehrerausbildung, sagt auch Renate Valtin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32042ded-a80f-322a-a4c9-d5192692383b",
                        "entry_id": "ead99444-cebc-3eef-9b97-18d3dbccce3c",
                        "glosses": [
                            "allgemeingültige Aussage über einen Mechanismus, der in der Sprache beobachtbare Zustände oder Prozesse hervorbringt"
                        ],
                        "tags": [
                            "speziell Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b456b560-3731-47d7-aeb0-c7abe8e88a76",
                                "sense_id": "32042ded-a80f-322a-a4c9-d5192692383b",
                                "text": "Das Menzerathsche Gesetz \"Je größer ein sprachliches Konstrukt, desto kleiner seine (direkten) Konstituenten\" ist ein Beispiel für ein Sprachgesetz."
                            },
                            {
                                "example_id": "a698c2e8-7272-4db8-9744-a8c386be2492",
                                "sense_id": "32042ded-a80f-322a-a4c9-d5192692383b",
                                "text": "Sprachgesetze sind Bestandteile der Sprachtheorie."
                            },
                            {
                                "example_id": "ec1acd42-91b2-47ac-a39a-6695fd71799b",
                                "sense_id": "32042ded-a80f-322a-a4c9-d5192692383b",
                                "text": "„Eine Sprachtheorie im Sinne der allgemeinen wissenschaftstheoretischen Terminologie existiert, wie gesagt, noch nicht; eine Reihe von Sprachgesetzen dagegen ist in neuerer Zeit - im Rahmen der quantitativen Linguistik - gefunden, formuliert und überprüft worden…“"
                            },
                            {
                                "example_id": "3788d49f-aef9-45c3-90b5-68ceed69293b",
                                "sense_id": "32042ded-a80f-322a-a4c9-d5192692383b",
                                "text": "„Ohne von den genannten Sprachgesetzen zu wissen, bestätigen allerdings KALAŠNIKOVA/ AL'NIKOVA mit ihren Befunden indirekt Hypothese 12.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                        "entry_id": "ead99444-cebc-3eef-9b97-18d3dbccce3c",
                        "glosses": [
                            "Gesetz (in manchen Ländern), das der Erhaltung und Pflege der eigenen Sprache dient"
                        ],
                        "tags": [
                            "Recht/Politik"
                        ],
                        "examples": [
                            {
                                "example_id": "efb11a26-ef34-4f52-aa4e-f0d07c4c0afd",
                                "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                                "text": "In Frankreich soll ein Sprachgesetz dafür sorgen, dass das Französische erhalten bleibt und gepflegt wird."
                            },
                            {
                                "example_id": "5eadcd44-85ad-4669-905e-6b006697ebc3",
                                "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                                "text": "„Es sei ‚eine Verletzung multinationaler Abkommen‘, dieses slowakische Sprachgesetz, sagt Ungarns Präsident László Sólyom, Ungarisch werde zur Küchensprache herabgewürdigt.“"
                            },
                            {
                                "example_id": "5cbbc40b-d3ac-4afd-8315-3b90187c866c",
                                "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                                "text": "„Der belgische Sprachenstreit zwischen Flamen und Wallonen nutzte den deutschsprachigen Belgiern, die sich keiner der beiden Volksgruppen zugehörig fühlten, insofern, als in den Sprachgesetzen von 1963 Deutsch ‚dritte Sprache Belgiens‘ wurde…“"
                            },
                            {
                                "example_id": "dc529829-2fa8-4df9-a1c8-599f818d9d6f",
                                "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                                "text": "„Seit dem Wahlsieg des flämischen Nationalisten Bart de Wever im Juni 2010 ist aus dem Streit um Sprachgesetze und Wahlkreise ein Sprengstoff für den Staat geworden.“"
                            },
                            {
                                "example_id": "953218fb-a94b-4257-b3e0-cd1cacc7a983",
                                "sense_id": "a3bfbcdf-6726-3c3b-ab7c-0c5f0121793b",
                                "text": "„Betrachtet man jedoch die Untersuchungsergebnisse, die gezeigt haben, daß im Französischen bedeutend weniger unterschiedliche Anglizismen vorkamen als im Deutschen, so liegt die Vermutung nahe, daß das französische Sprachgesetz durchaus eine gewisse Wirkung haben muß.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
