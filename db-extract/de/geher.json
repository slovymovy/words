                    }
                ],
                "translations": [
                    {
                        "translation_id": "308a61fc-42e8-4937-96e7-36eca6a86c00",
                        "source_entry_id": "1d606f7f-0917-32f7-8a07-68727cdfc37d",
                        "source_sense_id": "f63b9951-db8b-3804-9863-95110e771fc6",
                        "source_sense_description": "Person, die Gehen als sportliche Tätigkeit betreibt",
                        "target_lang_word": "marcheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marcheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f35ea439-140e-3e7e-8d32-5fcb13ac30b9",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Celui qui sait marcher, qui est doté de la capacité de marcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7143b258-86e2-4071-9ec7-40e6a8688e34",
                                                "sense_id": "f35ea439-140e-3e7e-8d32-5fcb13ac30b9",
                                                "text": "Les batraciens offrent, dans l’histoire évolutive, l’importance extrême d’avoir été les premiers vertébrés terrestres, les premiers marcheurs. Ils inaugurèrent la patte […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Personne qui peut marcher beaucoup sans se fatiguer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f504026-0155-4b0a-9704-8deca13bd7ea",
                                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                                "text": "Enfin, le poumon vert de Bruxelles, la forêt de Soignes et ses majestueux hêtres vieux de deux siècles, régale les marcheurs les meilleurs, tandis que le Rouge-Cloître, juste à coté, s'impose aux bulleurs comme l'espace de détente rêvé."
                                            },
                                            {
                                                "example_id": "2d32d06c-68d4-4e61-a95d-5f6e6777985e",
                                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                                "text": "On l’emploie le plus souvent avec une épithète."
                                            },
                                            {
                                                "example_id": "ea259d82-bd0a-4c7c-8cd3-e74a592b2b68",
                                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                                "text": "Un grand, un bon, un mauvais marcheur."
                                            },
                                            {
                                                "example_id": "c76bfb51-3f01-4070-ac9b-56bece601e20",
                                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                                "text": "Je ne rapporte cette circonstance insignifiante que parce qu’elle est caractéristique de la légèreté des Espagnols, les premiers marcheurs du monde et les coureurs les plus agiles que l’on puisse voir."
                                            },
                                            {
                                                "example_id": "a2edb302-ee38-473e-b572-16b5b7b513df",
                                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                                "text": "Dès avril hélas, les estivants recommencèrent leur transhumance. Des badauds erraient devant toutes les grilles, des marcheurs dans tous les sentiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1230ff1a-a3fc-3c65-af4e-278bc2d3ccc5",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Athlète spécialiste de la marche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e85277-1193-4eef-8201-c17d4162a003",
                                                "sense_id": "1230ff1a-a3fc-3c65-af4e-278bc2d3ccc5",
                                                "text": "Le camp français a fait appel de la décision, mais le marcheur tricolore a encore passé une journée assez incroyable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fa2993-e1ac-3a11-88be-fdd4a52bc2a3",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Créature ressemblant a une araignée géante."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Univers d’Ewilan de Pierre Bottero"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55a7a30c-b002-3090-8a3b-d0941b696d82",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Dispositif d’entraînement des chevaux, où ils marchent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8e69ae-2e7c-40db-b13f-2e365d82793b",
                                                "sense_id": "55a7a30c-b002-3090-8a3b-d0941b696d82",
                                                "text": "Tous les chevaux sont sortis sur le marcheur (un outil pour l’échauffement et le retour au calme) et au paddock (l’enclos) chaque jour, mais tous ne sont pas entraînés de la même façon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e46f79-caba-35d7-9385-b5b4a0b19a0c",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Partisan du mouvement politique En marche."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d8e822-0f2f-4eba-8724-dc52832e7bcc",
                                                "sense_id": "40e46f79-caba-35d7-9385-b5b4a0b19a0c",
                                                "text": "Pour arriver au pouvoir, Emmanuel Macron a pu s'appuyer sur la détermination de ses 400 000 marcheurs, durant la campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae84a1e6-6242-3ca2-b9e7-90b119e04363",
                                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                                        "glosses": [
                                            "Viveur, qui fait la noce."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
