                "senses": [
                    {
                        "sense_id": "7900f0e2-5758-37c3-a9b2-c3079c4c1ea8",
                        "entry_id": "1d8b2045-640c-3eba-9770-3de75e616366",
                        "glosses": [
                            "Summe/Zusammenspiel der Zulieferer, derjenigen Unternehmen, die Rohstoffe oder Halbfertigprodukte an einen Hersteller verkaufen (liefern), der Hersteller selbst plus die Transporteure, die das Fertigprodukt zum Kunden/Endverbraucher befördern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16de61e4-b41f-4454-91ce-894e01f19986",
                                "sense_id": "7900f0e2-5758-37c3-a9b2-c3079c4c1ea8",
                                "text": "„Die coronabedingte Krise der Luftfahrt hat inzwischen voll auf die Zulieferkette durchgeschlagen und wird dort aus Expertensicht noch große Opfer fordern.“"
                            },
                            {
                                "example_id": "cc413616-141b-43f4-b545-034107575c3e",
                                "sense_id": "7900f0e2-5758-37c3-a9b2-c3079c4c1ea8",
                                "text": "„Japans Wirtschaft leidet vor allem unter der unsicheren Auslandsnachfrage. Die noch im Februar befürchteten abgeschnittenen Zulieferketten aus China führten zu keinen größeren Verwerfungen.“"
                            },
                            {
                                "example_id": "6927a5df-cf2c-4bd6-8194-b0dd0ef84155",
                                "sense_id": "7900f0e2-5758-37c3-a9b2-c3079c4c1ea8",
                                "text": "„Die größte Herausforderung sei es gewesen, die Zulieferkette wieder aufzubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd7401d4-bd36-4f17-9e00-ee78887ed0cd",
                        "source_entry_id": "1d8b2045-640c-3eba-9770-3de75e616366",
                        "source_sense_id": "7900f0e2-5758-37c3-a9b2-c3079c4c1ea8",
                        "source_sense_description": "aufeinander folgende Zulieferung von Rohstoffen und Halbfertigprodukten bis zum Endprodukt",
                        "target_lang_word": "supply chain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supply chain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9dd00d-a25a-3c6e-a2a5-9dd715e2ae3d",
                                        "entry_id": "5e146900-4f0f-3a72-9ac1-4de9831d296b",
                                        "glosses": [
                                            "A system of organizations, people, technology, activities, information and resources involved in moving a product or service from the supplier to the customer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8536db9-3f9f-4dcf-b561-18285cc5c570",
                                                "sense_id": "5a9dd00d-a25a-3c6e-a2a5-9dd715e2ae3d",
                                                "text": "It adds that the majority of TfL's costs are spent on its supply chain and internal labour costs. \"Without a stable source of income or funding during the COVID-19 pandemic, our supply chain will not be able to gain adequate assurance that TfL will be able to fund their future commitments,\" the report concludes."
                                            },
                                            {
                                                "example_id": "6033446c-619e-4433-b9c7-a834de6ac47b",
                                                "sense_id": "5a9dd00d-a25a-3c6e-a2a5-9dd715e2ae3d",
                                                "text": "[during the British expedition to Tibet] ... the expedition under General Macdonald became dominant. The difficulties of penetrating a hostile and barren country in the dead of winter, of keeping a supply chain with India unbroken, and of fighting for the capture of fortified passes ..."
                                            },
                                            {
                                                "example_id": "f9f36efc-da13-4e09-975b-191017bacec4",
                                                "sense_id": "5a9dd00d-a25a-3c6e-a2a5-9dd715e2ae3d",
                                                "text": "In Bullough’s estimation, Moneyland is the dark twin of globalization, an unregulated system made possible by the same tissues of connectivity that have enabled global supply chains, cross-border trade and electronic cash flows."
                                            },
                                            {
                                                "example_id": "bbedcf4e-e872-43d5-bdff-76d84238b036",
                                                "sense_id": "5a9dd00d-a25a-3c6e-a2a5-9dd715e2ae3d",
                                                "text": "Two months after gas and food shortages caused shudders of anxiety across the country, Britain continues to face challenges in its supply chain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
