                    {
                        "sense_id": "1de893e8-1e3f-3b48-8fba-cd73d45c17c2",
                        "entry_id": "e41db523-e96d-332e-8829-41a8e4232019",
                        "glosses": [
                            "past passive perfective participle of окра́сить (okrásitʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "participle",
