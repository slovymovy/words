    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d00cc89e-a7a2-38a4-b964-7215b7ee816f",
                "word": "plainclothes",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a1318030-296c-3776-bb56-eca176436bd9",
                        "entry_id": "d00cc89e-a7a2-38a4-b964-7215b7ee816f",
                        "glosses": [
                            "Wearing ordinary civilian clothes instead of a uniform, in order to avoid detection."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05f2e951-e61f-4c67-ba5b-0202a76d0de1",
                        "source_entry_id": "d00cc89e-a7a2-38a4-b964-7215b7ee816f",
                        "source_sense_id": "a1318030-296c-3776-bb56-eca176436bd9",
                        "source_sense_description": "wearing civilian clothes",
                        "target_lang_word": "en civil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en civil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db1f059a-6ae4-31f9-9781-897d73dc11f0",
                                        "entry_id": "b81aa846-377f-3870-8ddb-a2711d3c712c",
                                        "glosses": [
                                            "Revêtu de vêtements civils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1146534b-a83e-4da4-81f5-a655ec1474ab",
                                                "sense_id": "db1f059a-6ae4-31f9-9781-897d73dc11f0",
                                                "text": "Comme je parvenais à me relever, un agent en civil – on dit « en bourgeois », nous imprimions « hambourgeois », naturellement – se mit gentiment à m’étrangler, à l’aide de mon propre cache-nez, manœuvré et tordu comme une vis de pression."
                                            },
                                            {
                                                "example_id": "75cb2a3e-6f59-497e-a8a2-2459f1c70094",
                                                "sense_id": "db1f059a-6ae4-31f9-9781-897d73dc11f0",
                                                "text": "— As-tu l’autorisation de ton commandant pour t’habiller en civil, hein ? De mon époque, il n’y avait que les sous-officiers rengagés qui bénéficiaient de cette faveur."
                                            },
                                            {
                                                "example_id": "18159679-18f9-4fc4-a28d-c2dd61238c8f",
                                                "sense_id": "db1f059a-6ae4-31f9-9781-897d73dc11f0",
                                                "text": "Les flics de l’hôtel sont là, et aussi des hommes en civil du Precinct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e2cac9c-0ed4-4084-a125-3b0b00f130fd",
                        "source_entry_id": "d00cc89e-a7a2-38a4-b964-7215b7ee816f",
                        "source_sense_id": "a1318030-296c-3776-bb56-eca176436bd9",
                        "source_sense_description": "wearing civilian clothes",
                        "target_lang_word": "en bourgeois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en bourgeois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                        "entry_id": "a9e0091b-51fd-38fb-a677-6f8c6aba54f3",
                                        "glosses": [
                                            "Revêtu de vêtements civils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203c9c1c-b1af-4924-8ce8-33c530b07c9c",
                                                "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                                "text": "— C’est un sergent de la ville en bourgeois qui a tiré ! Toute la brigade du quartier, qui se cachait depuis le 4, a repris l’offensive !… Nous allons être attaqués !"
                                            },
                                            {
                                                "example_id": "23473c3b-9b4e-44d8-b169-87b255010c79",
                                                "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                                "text": "À ce moment, on entend un brouhaha de voix sur le balcon d’où débusquent deux agents en bourgeois ; au même moment Moricet, attiré par le bruit, sort vivement de la chambre de droite."
                                            },
                                            {
                                                "example_id": "86791108-0ffc-4b22-8177-40aca082dc2c",
                                                "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                                "text": "On racontait que de grossières lettres de menaces étaient adressées journellement au baron Duvillard, pour lui annoncer qu’on allait tuer sa femme, sa fille, son fils, l’égorger lui-même, faire sauter son hôtel, à ce point que, jour et nuit, cet hôtel était gardé par une nuée d’agents en bourgeois."
                                            },
                                            {
                                                "example_id": "9ae0fa9b-1549-4fda-ae16-8232f322df19",
                                                "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                                "text": "Comme je parvenais à me relever, un agent en civil – on dit « en bourgeois », nous imprimions « hambourgeois », naturellement – se mit gentiment à m’étrangler, à l’aide de mon propre cache-nez, manœuvré et tordu comme une vis de pression."
                                            },
                                            {
                                                "example_id": "32e2f069-f3bf-4fed-876d-0a2b78dc64d5",
                                                "sense_id": "664b7ef5-0145-37f1-833c-eb3db3b27d14",
                                                "text": "La tête durement dessinée d’un agent en bourgeois qui questionnait le procureur des yeux en attendant un ordre et qui, sur un signe, faisait passer le jeune homme…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "en bourgeois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbab608-26e0-33f5-bf39-64dac29feecc",
                                        "entry_id": "10ab0100-9800-32b7-a000-03ab097d1b0c",
                                        "glosses": [
                                            "Policier en civil."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ababcdba-ca1e-444d-8405-2ff93a3f325d",
                                                "sense_id": "4dbab608-26e0-33f5-bf39-64dac29feecc",
                                                "text": "Enfin, deux « en bourgeois » arrivent."
                                            },
                                            {
                                                "example_id": "238d4de4-f695-4b53-b817-9c6dc873b78a",
                                                "sense_id": "4dbab608-26e0-33f5-bf39-64dac29feecc",
                                                "text": "Un « en bourgeois » sautait à terre et galopait à sa rencontre."
                                            },
                                            {
                                                "example_id": "c34465e3-2a01-4536-aa4c-6c6e14372d43",
                                                "sense_id": "4dbab608-26e0-33f5-bf39-64dac29feecc",
                                                "text": "J’ai effectué ce voyage (et les voyages suivants) en voiture particulière, seul avec deux en bourgeois très gentils, et sans menottes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76f1ae0c-346a-430b-8bd8-619458b1a739",
                        "source_entry_id": "d00cc89e-a7a2-38a4-b964-7215b7ee816f",
                        "source_sense_id": "a1318030-296c-3776-bb56-eca176436bd9",
