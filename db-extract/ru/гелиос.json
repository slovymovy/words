                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6209c0-6d54-475c-b7aa-59a9348a7f37",
                                                "sense_id": "a32ccbf1-3dd0-38c8-b4f4-cb6d6780f0b7",
                                                "text": "Srebrny rydwan Selene ciągnęły dwa rumaki, a nie cztery, jak złoty rydwan Heliosa"
                                            },
                                            {
                                                "example_id": "59d92972-4d07-483d-88f0-1ca7a0f1fc0d",
                                                "sense_id": "a32ccbf1-3dd0-38c8-b4f4-cb6d6780f0b7",
                                                "text": "Atrybutami Heliosa były: korona z promieni słonecznych, złoty rydwan, słonecznik, heliotrop (tomiłek), jaszczurka, konik polny, kruk i kogut."
                                            },
                                            {
                                                "example_id": "be066200-34bf-466f-87c9-d779b9bf3fed",
                                                "sense_id": "a32ccbf1-3dd0-38c8-b4f4-cb6d6780f0b7",
                                                "text": "Kult bóstw uosabiających ciała niebieskie był w Grecji rzadkością, jednak Heliosa czczono na Rodos, a Selene – na Peloponezie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
