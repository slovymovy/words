                    {
                        "translation_id": "ef1cec8d-9054-426e-9d6c-a1af454f2497",
                        "source_entry_id": "9a72aa4a-f367-3c5b-b20e-b222bf24c682",
                        "source_sense_id": "226aa3d1-1af9-3d6a-8e99-24293274b4e8",
                        "source_sense_description": "kleine Eierkuchen/Pfannkuchen mit einem Teig aus Hefe/Buchweizenmehl/Weizenmehl",
                        "target_lang_word": "bliny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bliny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34fb9252-cfc8-31a3-b12a-3427fd0774f1",
                                        "entry_id": "60ef3637-1579-395c-b1b9-37f3e47b5992",
                                        "glosses": [
                                            "Alternative form of blini."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faed3575-47b9-4b0d-b0b3-e51b9a576a8c",
                                                "sense_id": "34fb9252-cfc8-31a3-b12a-3427fd0774f1",
                                                "text": "In fact, buckwheat is most popular in pancakes, on its own or mixed with wheat, as in blinys."
                                            },
                                            {
                                                "example_id": "caf73107-d10d-4ddc-8e5c-cfca15310ae9",
                                                "sense_id": "34fb9252-cfc8-31a3-b12a-3427fd0774f1",
                                                "text": "The Chainaya, or tea-room, used to be the place for a late supper of blinys and champagne after a ballet at the Bolshoy across the street, one of the few places in town where one could hope to eat that late."
                                            },
                                            {
                                                "example_id": "70c9d7aa-9f63-4d57-84a2-e1e858c779c3",
                                                "sense_id": "34fb9252-cfc8-31a3-b12a-3427fd0774f1",
                                                "text": "When finished with the first helping, a refill or two was automatically provided, no questions asked. It was murderous, but there was no escape. We developed a new vocabulary, all evolving around the concept of “murder by blinys,” but it didn’t take away the obligation to eat until one’s pants couldn’t fit anymore and there was difficulty walking without constant belly pains."
                                            },
                                            {
                                                "example_id": "7e03e465-b13f-4bb5-931e-ae954ed6e2f1",
                                                "sense_id": "34fb9252-cfc8-31a3-b12a-3427fd0774f1",
                                                "text": "Many of the villagers provided Mama with milk and cheese, and she made dozens and dozens of bliny for everyone."
                                            }
                                        ]
                                    }
                                ]
                            },
