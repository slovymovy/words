                "senses": [
                    {
                        "sense_id": "d3828f92-9952-308e-a071-b8eb73d6ecbc",
                        "entry_id": "28e4a40b-511b-32a4-9a6f-b770b26a13cc",
                        "glosses": [
                            "Organisation, die sich für die Interessen von Flüchtlingen engagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5958796d-f24b-4d82-ad5e-cae74c110814",
                                "sense_id": "d3828f92-9952-308e-a071-b8eb73d6ecbc",
                                "text": "„Ob durch die Aktion Schleuserorganisationen aufgedeckt wurden, kann die Bundesregierung nicht sagen – sie verweist auf die jeweilige Ratspräsidentschaft. Für Jelpke und die Flüchtlingsverbände sind nicht die illegal Eingereisten das Problem, sondern fehlende legale Wege nach Europa. Die Linke hat deshalb einen Antrag in den Bundestag eingebracht, der sichere Einreisewege für Migranten ermöglichen soll.“"
                            },
                            {
                                "example_id": "c8e0c34a-7d25-44c6-8559-8d3cdcda7d74",
                                "sense_id": "d3828f92-9952-308e-a071-b8eb73d6ecbc",
                                "text": "„Dank seiner Vernetzung mit anderen Flüchtlingsverbänden und mit der SRK Kinderhilfe (ab 1942) und dank seiner proklamierten Neutralität übertrug der Bundesrat dem SHEK am 1. Dezember 1942 die Verantwortung für die alleinstehenden Flüchtlingskinder bis zu 16 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
