                "senses": [
                    {
                        "sense_id": "6898c83c-1399-3551-8acc-90811bc09479",
                        "entry_id": "3743d3a6-551b-37a1-b6a1-e4c67591486e",
                        "glosses": [
                            "Käfer, der zu den Holzzerstörern gehört und dessen Männchen während der Paarungszeit mit seinem Kopf auf das Holz schlägt, um Weibchen anzulocken"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "58f4bf81-8e72-4c78-8228-0e329b008622",
                                "sense_id": "6898c83c-1399-3551-8acc-90811bc09479",
                                "text": "Als Totenuhr bezeichnet man verschiedene Insekten, die unheimliche Klopfgeräusche verursachen und damit im Volksglauben die Angst vor dem nahen Tode weckten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07f4a641-a655-3be8-86f6-53ef4b29035c",
                        "entry_id": "3743d3a6-551b-37a1-b6a1-e4c67591486e",
                        "glosses": [
                            "Vertreter der Staubläuse, der mit dem Hinterleib auf den Boden schlägt und dabei uhrähnliche Geräusche erzeugt"
                        ],
