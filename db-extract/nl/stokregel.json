                        "glosses": [
                            "een zin of zinsnede die men steeds herhaalt in een tekst of toespraak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239ddd25-c5bf-4278-a6e7-07a14c8be9fb",
                                "sense_id": "33c987a4-c630-3264-a5be-891562410a61",
                                "text": "Op de stokregel (het thema, telkens herhaald aan het slot van elke strofe) „Zyn zy niet zot, die hem daerup betrauen” (zijn ze niet gek die daarop vertrouwen) laat hij zich in een droom wegvoeren door een kabouter naar Buusbaurea, het land van grote drinkers (”buzen” is zuipen)."
                            },
                            {
                                "example_id": "51ca692b-9cff-4ccd-b564-edf46ec044c8",
                                "sense_id": "33c987a4-c630-3264-a5be-891562410a61",
                                "text": "Het kwam steeds terug, zag ze. Waarschijnlijk had de schrijver zoiets als Ik had een droom voor ogen gehad, dat je wel eens tegenkwam als stokregel in een rederijkersrefrein, of in de toespraak van een heel beroemde redenaar. Het had iets literairs, en de mensen hoorden het graag."
                            }
                        ]
