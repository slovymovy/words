                        "examples": [
                            {
                                "example_id": "af9c36b6-c2db-4d14-92de-9584b77b5a92",
                                "sense_id": "46703f38-c57a-33da-84c8-458f6186f5c5",
                                "text": "The merchant proceeded on his way marvelling in his heart at the uncharitableness and innate wickedness of unregenerated human nature."
                            },
                            {
                                "example_id": "185176cc-51e1-4f89-a18b-7cb925b77bab",
                                "sense_id": "46703f38-c57a-33da-84c8-458f6186f5c5",
                                "text": "The houses themselves are so horrible in their condition, and have been so remodeled from time to time, to meet Celestial ideas and fall in with notions which are but a relic of barbarism, that not even a colored man of the most degraded type can be persuaded to live permanently in a house which has ever been occupied by an unregenerated denizen of Chinatown."
                            }
                        ]
                    }
