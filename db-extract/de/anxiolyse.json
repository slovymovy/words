                "senses": [
                    {
                        "sense_id": "f60b1c1a-c1df-3b1d-93e6-0426775f0d71",
                        "entry_id": "10175b9d-92e2-364b-88b7-5b7e46a48304",
                        "glosses": [
                            "Verminderung übermäßiger oder krankhafter Ängste mithilfe von Medikamenten oder Therapien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793756b7-7cf3-4910-9b6e-793c13a92bcc",
                                "sense_id": "f60b1c1a-c1df-3b1d-93e6-0426775f0d71",
                                "text": "„Dies erklärt ihr breitgefächertes Wirkspektrum von Anxiolyse (Unterdrückung von Angst, affektiver Spannung und Erregung) über Sedierung, Schlafanstoßung, Muskelrelaxierung, effektiver dosisabhängiger Hypnose bis hin zur Narkose.“"
                            },
                            {
                                "example_id": "94be48f3-a6f4-4271-9326-65a4509a0d27",
                                "sense_id": "f60b1c1a-c1df-3b1d-93e6-0426775f0d71",
                                "text": "„Es hat sich jedoch ein Paradigmenwechsel vollzogen, so dass aktuell im zahnmedizinischen Bereich nicht die Sedierung, sondern die Anxiolyse und Stressreduktion im Vordergrund stehen.“"
                            },
                            {
                                "example_id": "5a26f4fa-9e33-4d44-a4d5-954fff669897",
                                "sense_id": "f60b1c1a-c1df-3b1d-93e6-0426775f0d71",
                                "text": "„Diese Stoffklasse ist aufgrund des dosisabhängigen kontinuierlichen Wirkungsspektrums von Anxiolyse über Sedierung und Schlaf bis Narkose nicht klar voneinander abgrenzbar.“"
                            },
                            {
                                "example_id": "96f167bc-f7e3-402b-8f36-2efbeba19204",
                                "sense_id": "f60b1c1a-c1df-3b1d-93e6-0426775f0d71",
                                "text": "„Die Anxiolyse erreicht man nicht durch Emotionsänderung, sondern medikamentös wird die Vigilanz gedämpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
