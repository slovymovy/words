                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lastkahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                        "entry_id": "539c2f2a-a520-350e-a585-8ce20344823e",
                                        "glosses": [
                                            "Wasserfahrzeug ohne Motor zum Transport von Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29dadba5-9f61-47c9-8d35-5cfb1f701220",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Es ging auf schmalen Brücken über Kanäle mit langsam fließendem Wasser, auf dem Lastkähne lagen.“"
                                            },
                                            {
                                                "example_id": "a361614a-928c-4fff-b6a2-96f7226f743d",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Keine 10 Minuten von der Stelle entfernt, an der unsere Reise begann, am heutigen Niederländer Ufer in Köln, wurden die Waren, die auf flachkieligen Segelschiffen transportiert wurden, auf Lastkähne umgeladen.“"
                                            },
                                            {
                                                "example_id": "e17ac6b9-9564-468b-81fe-90949d8ec92b",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Auf den Krananlagen, den Lastkähnen und den Schornsteinen des Kraftwerks gingen die Lichter an.“"
                                            },
                                            {
                                                "example_id": "33a3a8d5-57d8-4f02-b07d-82c081771b9a",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Wo früher Holzflöße flussabwärts getrieben waren, kamen nun Lastkähne, von Treidlern gezogen, den Fluss herauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
