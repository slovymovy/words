                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e32b893-e724-4a17-967f-c47205b91d93",
                                                "sense_id": "a3509260-7556-36e9-b9b9-1419e43b86d8",
                                                "text": "There in full Opulence a Banker dwelt,\nWho all the Joys and Pangs of Riches felt;\nHis Side-board glitter’d with imagin’d Plate;\nAnd his proud Fancy held a vaſt Eſtate."
                                            },
                                            {
                                                "example_id": "35205504-3033-4d84-8e40-cbd10428dba5",
                                                "sense_id": "a3509260-7556-36e9-b9b9-1419e43b86d8",
                                                "text": "The most meritorious persons have always … been removed from opulence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
