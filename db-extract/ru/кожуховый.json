                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92681d28-50f4-4af3-9889-62e7e864b765",
                                                "sense_id": "c1aa554f-b4d6-36b8-a93b-481ef36a2777",
                                                "text": "Some people like to split the casing of a sausage before cooking so it doesn’t burst."
