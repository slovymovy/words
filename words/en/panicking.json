                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "panic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try to stay calm and avoid <w>panicking</w> when unexpected problems happen.",
                            "target_lang_translations": {
                                "ru": "Постарайтесь сохранять спокойствие и не <w>паниковать</w>, когда возникают неожиданные проблемы."
                            }
                        },
                        {
                            "text": "He started <w>panicking</w> when he realized he had lost his wallet.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>паниковать</w>, когда понял, что потерял кошелёк."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start panicking",
                        "stop panicking",
                        "avoid panicking"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма настоящего времени или герундий от глагола panic (паниковать, поддаваться панике)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паниковать",
                                "target_lang_sense_clarification": "испытывать панику"
                            },
                            {
                                "target_lang_word": "поддаваться панике",
                                "target_lang_sense_clarification": "терять самообладание из-за страха"
                            },
                            {
                                "target_lang_word": "паникующий",
                                "target_lang_sense_clarification": "охваченный паникой (причастие)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f2b1cbd-3cfe-3cec-8d8e-6028eed5a0e1",
                    "sense_definition": "An instance or state of panic; frantic behavior or alarm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "panic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>panicking</w> among the staff only made the crisis harder to manage.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>паника</w> среди сотрудников только затрудняла преодоление кризиса."
                            }
                        },
                        {
                            "text": "His sudden <w>panicking</w> disrupted the entire meeting.",
                            "target_lang_translations": {
                                "ru": "Его внезапная <w>паника</w> сорвала всю встречу."
                            }
                        }
                    ],
                    "synonyms": [
                        "panic",
                        "hysteria"
                    ],
                    "antonyms": [
                        "calm",
                        "calmness"
                    ],
                    "target_lang_definitions": {
