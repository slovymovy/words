                                        "examples": [
                                            {
                                                "example_id": "565f79a7-b275-457a-8450-05b23373e431",
                                                "sense_id": "715b651e-3473-3922-99df-b66592b535ea",
                                                "text": "In November 2024, Kiley won reelection in the district where Folsom is located by about 11 points, though Trumps' victory was closer to 3 points, according to data compiled by analyst Drew Savicki and cited by the Center for Politics at the University of Virginia."
                                            }
                                        ]
