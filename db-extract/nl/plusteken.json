                                "target_senses": [
                                    {
                                        "sense_id": "1479605e-3d27-3c77-8af6-acdd80fbaa35",
                                        "entry_id": "dee5f731-8254-3415-88f4-297849e5134a",
                                        "glosses": [
                                            "Signe de l’addition ou d’un nombre positif, +."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4491135-ff29-47f5-9ebf-be0306681c30",
                                                "sense_id": "1479605e-3d27-3c77-8af6-acdd80fbaa35",
                                                "text": "Toutes ces croix, à perte de vue. On dirait des signes plus, remarque Vissarion. Et, au dessous, les pierres tombales forment des signes moins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03483bb-caef-4312-9228-d51978bb9aa1",
                        "source_entry_id": "e869cb8e-9f03-3a70-85e5-065147e38951",
                        "source_sense_id": "cc6a8b2a-cc91-3c0e-9f94-e188b6792349",
                        "target_lang_word": "plus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc8dbbd-036e-35fc-bbb6-f111c0a6b7d6",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "Comparatif de beaucoup. On peut l’utiliser avec que. (\\\\plys\\\\)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e1dc05-3310-47fd-8045-65bdd8624df2",
                                                "sense_id": "6bc8dbbd-036e-35fc-bbb6-f111c0a6b7d6",
                                                "text": "Ne m’en dites pas plus. — Vous n’offrez pas assez, donnez quelque chose de plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "289b9890-b2bc-3bc7-83ed-dabb89f21d17",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "Comparatif de beaucoup de. Davantage de. On peut l’utiliser avec que. (\\\\plys\\\\)"
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65907fa3-7e32-419b-9622-967b07513eee",
                                                "sense_id": "289b9890-b2bc-3bc7-83ed-dabb89f21d17",
                                                "text": "Il y a plus de gens qu’hier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70955834-269b-36b6-a081-12eacf575e20",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "Indique le comparatif d’un adjectif ou d’un adverbe. Davantage. On peut l’utiliser avec que. (\\\\ply\\\\)"
                                        ],
                                        "tags": [
                                            "Avec un adjectif ou un adverbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47a75e1-2948-42f1-b9b2-9b24a711b580",
                                                "sense_id": "70955834-269b-36b6-a081-12eacf575e20",
                                                "text": "— Je n’ai à recueillir que l’héritage de mon père, qui, je le crains, sera plus que léger."
                                            },
                                            {
                                                "example_id": "900ece10-c87c-412a-ae5b-8b8cac7e39f4",
                                                "sense_id": "70955834-269b-36b6-a081-12eacf575e20",
                                                "text": "Si vous préparez la crème anglaise la veille, elle n'en sera que plus parfumée et plus savoureuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d16e5db-b9b3-3d9a-9c6c-9fde5259d2dd",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "Superlatif de beaucoup, comme un adverbe pour le verbe. Le premier en quantité ou en intensité. (\\\\plys\\\\)"
                                        ],
                                        "tags": [
                                            "Avec le"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43ee3c02-0e3e-4987-8ab0-4efefeab4f78",
                                                "sense_id": "9d16e5db-b9b3-3d9a-9c6c-9fde5259d2dd",
                                                "text": "Les livres que j’ai le plus aimés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "Indique le superlatif d’un adjectif ou d’un adverbe. Le premier en cette qualité, ou au pluriel, du premier à un certain rang. (\\\\ply\\\\) Note d’usage : L’adverbe prend toujours la forme au masculin singulier le plus."
                                        ],
                                        "tags": [
                                            "Avec un déterminant défini comme le",
                                            "mon",
                                            "etc.",
                                            "et avec un adjectif ou un adverbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b01c49-140a-4c47-9beb-da419d364354",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "La porcelaine, cette matière céramique la plus parfaite, résulte de la liaison à une température très élevée, de l’infusible kaolin et du fusible feldspath, en une masse homogène."
                                            },
                                            {
                                                "example_id": "243d4a57-627a-4424-9e44-2a3ed4c19ab7",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "L’ortie de Chine ou Bœhmérie, nommée mai et tchou-ma par les Chinois et cay-gai par les Annamites, est, après le coton, la plante textile la plus cultivée dans toute l’Indo-Chine."
                                            },
                                            {
                                                "example_id": "397b74a2-f4ce-48a9-a047-60c585fb8c66",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "Il est l’homme le plus grand du monde."
                                            },
                                            {
                                                "example_id": "5f9d64b6-e3b4-4196-b1a2-5e2fbdfd6721",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "Ma plus belle histoire d’amour."
                                            },
                                            {
                                                "example_id": "f7137b3b-e458-4859-b96a-367933a4badc",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "Les trois pays les plus peuplés du monde sont la Chine, l’Inde et les États-Unis."
                                            },
                                            {
                                                "example_id": "e2137071-4998-4a70-b054-0cc9ba19f7df",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "Paris est l’une des plus belles villes du monde."
                                            },
                                            {
                                                "example_id": "f77cbd36-60fa-45e4-b782-c8a455646c31",
                                                "sense_id": "0ef65fb5-2d6d-3ccc-9224-6bef8c94da6d",
                                                "text": "Elle court le plus vite de ma classe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                        "entry_id": "a964d868-42a1-349e-bc51-669b42274519",
                                        "glosses": [
                                            "(plus…, plus, plus…, moins) Employé avec répétition, ou en corrélation avec moins pour indiquer une relation proportionnelle. (\\\\ply\\\\)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a60720-27ca-46b4-8599-0c162a511990",
                                                "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                                "text": "L’usage classique permet de rejeter plus ou moins après le groupe verbal du second membre : Enfin plus vous m’aimez, je vous aimerais moins."
                                            },
                                            {
                                                "example_id": "7ebfc517-9c0d-4fef-a9ff-c59144fb8180",
                                                "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                                "text": "Dans cet emploi, une tournure littéraire est d’inverser le sujet dans le second membre : Plus votre rang vous distingue des autres, plus devez-vous vous en approcher ; plus devez-vous, pour user de cette expression, vous humaniser ; plus devez-vous avoir de douceur, de modération, de charité."
                                            },
                                            {
                                                "example_id": "f66ca744-5c4a-4fb7-90ec-33ce9288eeaa",
                                                "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                                "text": "Bon, bon ! répondit le roi avec son sourire fauve, plus il y en aura, plus nous serons contents ; amenez, amenez, Henri."
                                            },
                                            {
                                                "example_id": "d9bcd5c4-305c-4262-b371-8426ab9c04c9",
                                                "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                                "text": "Puis, en grosses lettres, cette phrase : « Plus il y aura d'acheteurs de blé, meuniers ou négociants, plus les agriculteurs vendront le leur facilement et cher. »\nIl est hors de contestation que, si des éléments de concurrence nouveaux devaient surgir, le cultivateur y trouverait son compte."
                                            },
                                            {
                                                "example_id": "8daa6988-18f1-42ac-aae4-d872a1a4f750",
                                                "sense_id": "5af9bd75-c9c9-379b-ab3f-5bfabefb0315",
                                                "text": "J’étais écœurée de son attitude, elle jouait les étonnées et essayait de me persuader que c'était Jojo qui avait tapé ce courrier. Elle devait se payer ma tête, mais plus elle essayait de me persuader, plus elle s'enfonçait, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b5aca5-90b7-3418-ad08-0c83e9dcd07a",
                                        "entry_id": "3ee434bb-a766-37b1-9ba5-42834b922ca4",
                                        "glosses": [
                                            "(En corrélation avec ne : ne… plus) Avec la négation, il sert à marquer la cessation d’une action ou d’un état, la privation d’un bien. Cela provient de l’expression euphémique ancienne « pas plus » (l’équivalent du « nicht mehr » allemand)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252eee3b-d347-40ca-920e-007e3215ef3b",
                                                "sense_id": "d1b5aca5-90b7-3418-ad08-0c83e9dcd07a",
                                                "text": "La baguette magique agitée opportunément pour chercher à se faire élire ne suffit plus, ne convainc plus."
                                            },
                                            {
                                                "example_id": "646c54a9-63a1-44bc-a595-6e8b9b0ae379",
                                                "sense_id": "d1b5aca5-90b7-3418-ad08-0c83e9dcd07a",
                                                "text": "Je n’y pense plus. — Il n’a plus envie d’y retourner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c76e5d4a-3a01-35ba-87a1-2ba1992ba39a",
                                        "entry_id": "3ee434bb-a766-37b1-9ba5-42834b922ca4",
                                        "glosses": [
                                            "Il n’y a plus, il ne faut plus."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "688a09bf-0dac-43e5-92e4-6b9d0c10c077",
                                                "sense_id": "c76e5d4a-3a01-35ba-87a1-2ba1992ba39a",
                                                "text": "Plus de crainte, tout est fini !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de077988-7c8b-3c9c-856c-b82f844aa29d",
                                        "entry_id": "3ee434bb-a766-37b1-9ba5-42834b922ca4",
                                        "glosses": [
                                            "Sans négation, dans le corps de la phrase, il s’emploie dans le sens d’encore, davantage, désormais."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee36be15-5e2d-4088-a5cc-09843546bc5a",
                                                "sense_id": "de077988-7c8b-3c9c-856c-b82f844aa29d",
                                                "text": "Il leur défendit d’y plus songer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2eca4af7-577c-34cd-8e9f-07b3c7f43131",
                                        "entry_id": "9769a285-8dac-3325-b77a-33cba5e6a155",
                                        "glosses": [
                                            "Somme des nombres précédent et suivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19e13f0-3415-4a7f-b13e-ec956d252dc1",
                                                "sense_id": "2eca4af7-577c-34cd-8e9f-07b3c7f43131",
                                                "text": "Un plus un égale deux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9846b297-06b7-3220-81f6-4c0bcd1bb811",
                                        "entry_id": "9769a285-8dac-3325-b77a-33cba5e6a155",
                                        "glosses": [
                                            "Outre cela, et ; c’est alors une sorte de formule dont on se sert dans les inventaires, dans les états de compte, de recette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3beac58e-68ed-409d-b4eb-2187dca2b2c8",
                                                "sense_id": "9846b297-06b7-3220-81f6-4c0bcd1bb811",
                                                "text": "Plus un lit en bois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7348a9ac-3f1f-353d-87dd-fd040bd42755",
                                        "entry_id": "5fead88d-6aef-3f88-a8dc-5323bf3618f1",
                                        "glosses": [
                                            "+. Signe en forme de croix. Symbole de l’addition et signe positif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c554ea7-ec29-4865-af2c-f7435c856c46",
                                                "sense_id": "7348a9ac-3f1f-353d-87dd-fd040bd42755",
                                                "text": "Un plus et un moins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f46c47d-5347-3566-bbde-cfad06805fce",
                                        "entry_id": "5fead88d-6aef-3f88-a8dc-5323bf3618f1",
                                        "glosses": [
                                            "Avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b889120-4483-4fd2-9bb4-cff61bd9a0e7",
                                                "sense_id": "3f46c47d-5347-3566-bbde-cfad06805fce",
                                                "text": "Ce stage est un plus pour votre CV."
                                            },
                                            {
                                                "example_id": "7a2da7b7-d7be-4261-941f-dc934bfd0344",
                                                "sense_id": "3f46c47d-5347-3566-bbde-cfad06805fce",
                                                "text": "C'est un plus. On va se servir de cet appareil-là surtout dans les transferts interhospitaliers où les cas de COVID sont confirmés."
                                            },
                                            {
                                                "example_id": "c1d68360-e864-4748-9eb1-af5ab3998487",
                                                "sense_id": "3f46c47d-5347-3566-bbde-cfad06805fce",
                                                "text": "Il faut bien avouer que l' ergonomie des commandes est en retrait depuis la généralisation des touches numériques. Les boutons à poussoir présentent l'avantage d'être actionnables en un geste auquel le conducteur se familiarise d'ailleurs rapidement. Un vrai plus en termes de sécurité routière apprécié par beaucoup d'automobilistes. Leurs homologues tactiles, eux, obligent souvent à quitter la route des yeux, surtout lorsque la fonctionnalité choisie est accessible via des menus, pas toujours intuitifs au demeurant. Or c'est précisément ce que dénonce le dirigeant d'Euro NCAP. Qui explique : « La surutilisation des écrans tactiles est un problème à l'échelle de l'industrie. Presque tous les constructeurs automobiles déplacent les commandes clés sur des écrans tactiles centraux, obligeant les conducteurs à quitter la route des yeux et augmentant le risque d'accidents liés à la distraction. »"
                                            },
                                            {
                                                "example_id": "82147a9e-304b-4306-9fcf-c18835ee9e82",
                                                "sense_id": "3f46c47d-5347-3566-bbde-cfad06805fce",
                                                "text": "Il est écossais. - Tu mettras ses jupes, que du plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00f5514-e57f-367d-a1d9-2c632d2f36a4",
                                        "entry_id": "5fead88d-6aef-3f88-a8dc-5323bf3618f1",
                                        "glosses": [
                                            "La plus grande quantité, le maximum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9289c80e-67f0-406f-99f7-7284afe466b7",
                                                "sense_id": "e00f5514-e57f-367d-a1d9-2c632d2f36a4",
                                                "text": "C'est le plus que je puisse faire."
                                            },
                                            {
                                                "example_id": "a1a9a7aa-5a2e-4bdd-8ebd-782b5cc46c2a",
                                                "sense_id": "e00f5514-e57f-367d-a1d9-2c632d2f36a4",
                                                "text": "Le plus que vous en pourrez espérer, c'est une réponse évasive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0edc607-f0de-3c01-8854-ec9d52d7810c",
                                        "entry_id": "5fead88d-6aef-3f88-a8dc-5323bf3618f1",
                                        "glosses": [
                                            "Borne positive d'un circuit électrique ou d'une pile."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f78a081-549a-42a7-aab1-e89747957267",
                                                "sense_id": "e0edc607-f0de-3c01-8854-ec9d52d7810c",
                                                "text": "Le vendeur m'a dit de connecter le fil rouge au plus de la batterie."
                                            }
                                        ]
                                    }
                                ]
