                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04f3c4a-011f-4073-8468-efef1e50c432",
                                "sense_id": "2cc6db5b-bdfe-373d-807d-69701c45303b",
                                "text": "Die Blaskapelle spielte einen wunderschönen Marsch."
                            },
                            {
                                "example_id": "113e22f4-e437-4579-8732-41b96b6e20d1",
                                "sense_id": "2cc6db5b-bdfe-373d-807d-69701c45303b",
                                "text": "„Vielleicht würde eine Blaskapelle irgendetwas Dummes aufspielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d161b6a5-de25-4bef-9684-85cc1ca61abc",
                        "source_entry_id": "d5675a6f-cf81-3719-9dce-46ddb28dd1a4",
                        "source_sense_id": "2cc6db5b-bdfe-373d-807d-69701c45303b",
                        "source_sense_description": "Musikgruppe, die Musikinstrumente bläst und Blasmusik spielt",
                        "target_lang_word": "brass band",
