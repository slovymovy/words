                    {
                        "sense_id": "dfe8ba53-4ac9-323e-9d60-69a6a48913e5",
                        "entry_id": "7cbd38a8-f49c-3916-8cac-42beae824d50",
                        "glosses": [
                            "display case for snacks in bars (typically filled with meatballs, sausages, gherkins, etc.)"
                        ],
                        "tags": [
                            "Berlin",
                            "dated",
                            "humorous",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c6f6836a-34a8-4084-b7cc-cd741278ffdd",
                                "sense_id": "dfe8ba53-4ac9-323e-9d60-69a6a48913e5",
                                "text": "Dazu gibt es ab 19.30 Uhr Klöße, Klopse, saure Gurken als kulinarische Spezialitäten aus dem „Hungerturm“ zu essen."
                            },
                            {
                                "example_id": "f950c0fc-5eeb-4acf-b96d-043fa60291ed",
                                "sense_id": "dfe8ba53-4ac9-323e-9d60-69a6a48913e5",
                                "text": "Hier sieht es noch so aus wie vor 23 Jahren”, sagt Gabi, nur der “Hungerturm” fehle. Bevor das Nichtrauchergesetz vor zehn Jahren verbot, in Raucherkneipen Essen zu verkaufen, stand der “Hungerturm” auf dem Tresen, eine Glasvitrine mit Buletten, Schmalzstullen und Wiener Würstchen."
                            }
                        ]
                    }
