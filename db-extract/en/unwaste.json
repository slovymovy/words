                        "examples": [
                            {
                                "example_id": "f4c890cb-e359-4bae-804c-40740cf28388",
                                "sense_id": "20d7d23a-071e-319a-b49a-5dd00a6a97ba",
                                "text": "\"Well, dear. It's wicked the stuff people waste, you know, and other people without. Reg unwastes it . . . yes, that's what he does. There's fine things in fine houses, and people dusting 'em every day, that Reg has unwasted.[…]\""
                            },
                            {
                                "example_id": "c003ea96-5ba4-4911-b9fd-de605d1eae17",
                                "sense_id": "20d7d23a-071e-319a-b49a-5dd00a6a97ba",
                                "text": "“Trust me, I've been out with my fair share of not specials, and I don't have a time machine to unwaste my time.”"
                            }
                        ]
                    }
