                    {
                        "translation_id": "de03dd96-f38a-444d-8ef1-6dad0c143a59",
                        "source_entry_id": "4c7b7eb3-f863-3da4-bf9b-9170a5c7d2a5",
                        "source_sense_description": "действие",
                        "target_lang_word": "reflux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Mouvement réglé de la mer qui se retire du rivage après le flux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e8e218-7c13-41ea-ae0f-74d576391f8b",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Le dimanche après-midi, avec un vieux vélo de dame, je parcourais les kilomètres qui séparaient mon lieu de résidence de la mer et j'allais contempler le flux et le reflux de l'océan."
                                            },
                                            {
                                                "example_id": "8b1304b0-9153-4cb1-b8f4-6753d196f1b0",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Mais bientôt le reflux se fait sentir; la mer, après quelques oscillations, commence à baisser."
                                            },
                                            {
                                                "example_id": "5a8f1fa6-9375-4b81-bbfd-4c4e8e2dcc73",
                                                "sense_id": "9fac9393-2f04-3dfe-a08f-3bf91ab24be6",
                                                "text": "Au fond, vers le Louvre, tout bouillonnait ; des flux énormes de foule, puis des reflux soudains ; des regards furieux ; des multitudes qui se disloquaient, se formaient en bandes d'où jaillissaient des vociférations qui crépitaient sur le murmure immense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Vicissitude, changement alternatif des choses humaines."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b338b41c-b7f2-4b65-8929-f1ffbd6b5944",
                                                "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                                "text": "Dans quel flux et reflux de pensées, de résolutions, de plans de conduite, Ernest ne fut-il pas bercé avant de sommeiller !"
                                            },
                                            {
                                                "example_id": "b80539ea-5c2e-481a-be3a-408e8d647357",
                                                "sense_id": "c70bc662-219c-3900-9026-bec3070befbd",
                                                "text": "De l’assuétude, qui signifie la longue accoutumance, on peut dire qu’elle est d’emblée aussi consuétude, et par un mouvement qui n’est pas de reflux ou de résorption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46f129f-f643-3230-a9a1-da05cae7d598",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Réjection du bol alimentaire, chez le nourrisson, chez l’adulte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c28fb0e8-7d01-337e-a795-ab9c7141b337",
                                        "entry_id": "8209ba8c-f3a7-31dd-94d1-b2cc414c4e2b",
                                        "glosses": [
                                            "Mode de solubilisation avec une faible quantité de liquide qui, par condensation, dissout des substances à son contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690bd0c7-4a33-45b5-82b0-a55d6d77d146",
                                                "sense_id": "c28fb0e8-7d01-337e-a795-ab9c7141b337",
                                                "text": "Après refroidissement, ajouter 5 ml d'acide nitrique concentré, couvrir d'un verre de montre et remettre le bécher sur la plaque chauffante en maintenant un doux reflux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
