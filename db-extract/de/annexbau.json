                            {
                                "example_id": "aaa07e5c-6d5b-4d63-b6ab-621e22402e56",
                                "sense_id": "13fa2aca-762a-3118-8a21-24cbb6bf6d9e",
                                "text": "„An ihrer Stelle hätte dann, als Pendant zur Bibliothek in einem äußeren Annexbau, die Akademie der Bildenden Künste in den anderen Annexbau einziehen sollen.“"
                            },
                            {
                                "example_id": "274f73ca-21d3-4782-95aa-05a62a0e531a",
                                "sense_id": "13fa2aca-762a-3118-8a21-24cbb6bf6d9e",
                                "text": "„In dem anstossenden rechten Annexbaue befindet sich ein mit dem Corridore in Verbindung stehendes kleines Kiefernadelbad, sowie ein vom rechten Lichthofe aus zugängiger Raum zur Desinfection und Reinigung von Kleidern und Wäsche.“ (1873)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
