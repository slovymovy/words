                "senses": [
                    {
                        "sense_id": "23f1589c-5a6d-329a-88c7-170935178563",
                        "entry_id": "35e822e4-24ac-3fc9-ae74-bf63e71f6cfd",
                        "glosses": [
                            "Conduire à l'anarchisme, en parlant de la société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39485c8-783f-4d52-ac2e-08edfd834629",
                                "sense_id": "23f1589c-5a6d-329a-88c7-170935178563",
                                "text": "On n’anarchisera pas l'univers de sitôt, peut-être jamais ; mais si l'anarchie universelle est irréalisable, l'anarchie relative peut toujours s'affirmer. Il suffit que les militants se constituent en colonies anarchistes, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5a053cd-0d52-3ecf-8001-dee51b626008",
                        "entry_id": "35e822e4-24ac-3fc9-ae74-bf63e71f6cfd",
                        "glosses": [
                            "Livrer à l’anarchie."
                        ],
                        "tags": [
                            "obsolete",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d3db879c-2226-4d54-add3-841ee81d59f5",
                                "sense_id": "d5a053cd-0d52-3ecf-8001-dee51b626008",
                                "text": "Vingt-cinq années d’humanisation intensive, il y en avait des ordres à anarchiser ou plutôt un désordre toujours là à faire parler."
                            }
                        ]
                    },
                    {
                        "sense_id": "91f339cb-9a33-3429-ae97-ad6762511911",
                        "entry_id": "35e822e4-24ac-3fc9-ae74-bf63e71f6cfd",
                        "glosses": [
                            "Défendre des thèses anarchistes."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f458d872-2474-4144-8b86-5aa440318402",
                                "sense_id": "91f339cb-9a33-3429-ae97-ad6762511911",
                                "text": "Il râle. Il anarchise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "790363ba-e9da-4e02-9e26-6b4d85368d94",
