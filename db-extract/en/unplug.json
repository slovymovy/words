                "senses": [
                    {
                        "sense_id": "8c25f22a-42d4-3e80-a28c-6b2ee48c6759",
                        "entry_id": "ce4b62b8-3a54-3b10-9570-5a253924ac84",
                        "glosses": [
                            "To disconnect from a supply, especially an electrical socket."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "db2abc30-cd92-4ca8-adf5-9b7d02cd5e29",
                                "sense_id": "8c25f22a-42d4-3e80-a28c-6b2ee48c6759",
                                "text": "To save electricity, I unplug my computer when I am not at home."
                            },
                            {
                                "example_id": "32010ece-be0b-447b-9845-0180b163246b",
                                "sense_id": "8c25f22a-42d4-3e80-a28c-6b2ee48c6759",
                                "text": "We had unplugged from each other, the kind of unplugging where the charger gets torn out of the computer and the computer automatically dies."
                            }
                        ]
                    },
                    {
                        "sense_id": "87d6e4e2-910b-3594-8e94-d3fcae6a8937",
                        "entry_id": "ce4b62b8-3a54-3b10-9570-5a253924ac84",
                        "glosses": [
                            "To stop using electronic devices, especially for relaxation or to reduce stress."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a4d05574-d619-33e7-b2e1-477364dd7c29",
                        "entry_id": "ce4b62b8-3a54-3b10-9570-5a253924ac84",
                        "glosses": [
                            "To remove a blockage from (especially a water pipe or drain)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e72d497d-efe1-48e3-91f1-61ab8af90b81",
                                "sense_id": "a4d05574-d619-33e7-b2e1-477364dd7c29",
                                "text": "I had to unplug the sink the other day: there was far too much hair and gunk down there."
                            }
                        ]
                    },
                    {
                        "sense_id": "746db247-a6e6-35f6-a65b-9208637b1c0a",
                        "entry_id": "ce4b62b8-3a54-3b10-9570-5a253924ac84",
                        "glosses": [
                            "To temporarily disconnect from worldly experiences."
                        ],
                        "tags": [
                            "idiomatic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95ec6cb3-b85e-4848-8bad-26ae3863ebf4",
                                "sense_id": "746db247-a6e6-35f6-a65b-9208637b1c0a",
                                "text": "I need to unplug and spend some time with my family."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffe990fd-7125-4532-8506-cddcd1178280",
                        "source_entry_id": "ce4b62b8-3a54-3b10-9570-5a253924ac84",
                        "source_sense_description": "disconnect from a supply",
                        "target_lang_word": "débrancher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débrancher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "783e9d60-75ba-3701-b93d-601bdeaa5f25",
                                        "entry_id": "5463a750-cad7-3465-b052-71a7a1ed5dac",
                                        "glosses": [
                                            "Ôter la fiche d’un appareil électrique de la prise de courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6984bdf8-9902-4e88-8bbe-e7d3cc714ee5",
                                                "sense_id": "783e9d60-75ba-3701-b93d-601bdeaa5f25",
                                                "text": "Débrancher un radiateur, le frigo…"
                                            },
                                            {
                                                "example_id": "229d660d-d3bc-463b-9e94-efe3f4a07492",
                                                "sense_id": "783e9d60-75ba-3701-b93d-601bdeaa5f25",
                                                "text": "Le téléphone reprit ses stridulations, il trouait mon cerveau par endroits d’une aiguille trempée de poison. Je trouvai alors la force de me lever pour aller le débrancher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74efcd6f-80f2-3d58-b4e1-d85d45c9a5e1",
                                        "entry_id": "5463a750-cad7-3465-b052-71a7a1ed5dac",
                                        "glosses": [
                                            "Déconnecter une partie d’un circuit électrique ou d’un ensemble d’appareils."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9066ca28-dd43-4ccd-9e4b-eb7ca41db936",
                                                "sense_id": "74efcd6f-80f2-3d58-b4e1-d85d45c9a5e1",
                                                "text": "Par sécurité, il vaut mieux débrancher les enceintes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f792cd4-c224-3342-beba-d5fd73c97625",
                                        "entry_id": "5463a750-cad7-3465-b052-71a7a1ed5dac",
                                        "glosses": [
                                            "Arrêter un appareil."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e84893e9-2d38-48de-a6c1-1e58750f41cf",
                                                "sense_id": "3f792cd4-c224-3342-beba-d5fd73c97625",
                                                "text": "Débranche ta sono qu’on ait un peu de calme !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3aeb0d-490d-3789-8dcd-f3986a47a049",
                                        "entry_id": "5463a750-cad7-3465-b052-71a7a1ed5dac",
                                        "glosses": [
                                            "Quitter une voie, une ligne pour une autre au passage d’un aiguillage."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd4db76-4275-42f4-80c3-fd0dfe4531e4",
                                                "sense_id": "8f3aeb0d-490d-3789-8dcd-f3986a47a049",
                                                "text": "Après avoir quitté la gare du Havre-Graville, la voie unique se débranche sur la gauche des voies de la ligne de Paris-Saint-Lazare au Havre peu avant d'arriver à Harfleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
