                ],
                "senses": [
                    {
                        "sense_id": "a2a4ee1d-07da-3f1d-9bd4-6fe45664e5bd",
                        "entry_id": "2dd9d7d6-9ae7-3516-b6f9-b34713efba25",
                        "glosses": [
                            "Remettre dans quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637d1208-dd5a-42db-ac27-5a5d9df7e55f",
                                "sense_id": "a2a4ee1d-07da-3f1d-9bd4-6fe45664e5bd",
                                "text": "On le vit réenfouir rapidement la lettre dans sa chemise."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dc8004b-62ae-3019-adbb-595649f9b14b",
                        "entry_id": "2dd9d7d6-9ae7-3516-b6f9-b34713efba25",
                        "glosses": [
                            "Recouvrir (le plus souvent de terre ou de sable)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f90ad9-d070-48c9-bde2-cfa364304b82",
                                "sense_id": "3dc8004b-62ae-3019-adbb-595649f9b14b",
                                "text": "Une nouvelle tempête de sable souffla et réenfouit toutes les ruines."
                            }
                        ]
                    },
                    {
                        "sense_id": "43401e81-34c8-3e7d-98fc-d8820e7527c7",
                        "entry_id": "2dd9d7d6-9ae7-3516-b6f9-b34713efba25",
                        "glosses": [
                            "S’enfouir de nouveau."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7707e3a1-dec5-4b00-8775-79e81df95538",
                                "sense_id": "43401e81-34c8-3e7d-98fc-d8820e7527c7",
                                "text": "Le plus souvent l'insecte se trouve dérangé par les façons culturales, il doit alors se réenfouir et se réaménage une petite cavité d'hibernation."
                            },
                            {
                                "example_id": "7da5503e-448c-4386-b8d8-079394f660d9",
                                "sense_id": "43401e81-34c8-3e7d-98fc-d8820e7527c7",
                                "text": "Des canards et des petites grenouilles vertes venaient y chercher les vers qui n'avaient pas encore eu le temps de se réenfouir dans la terre meuble."
                            }
                        ]
                    }
                ],
