    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "284f3070-a3ad-380c-9bc6-eedb8b786b77",
                    "sense_definition": "Служебное слово, используемое для образования повелительного наклонения 3-го лица; выражает побуждение, пожелание, призыв или согласие (аналогично слову «пусть»).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imperative_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пускай</w> он придёт завтра утром, мы всё обсудим.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> him come tomorrow morning, we'll discuss everything.",
                                "de": "<w>Lass</w> ihn morgen früh kommen, wir werden alles besprechen."
                            }
                        },
                        {
                            "text": "Не трогай кота, <w>пускай</w> спит спокойно.",
                            "target_lang_translations": {
                                "en": "Don't touch the cat, <w>let</w> him sleep peacefully.",
                                "de": "Fass die Katze nicht an, <w>lass</w> sie ruhig schlafen."
                            }
                        },
                        {
                            "text": "<w>Пускай</w> всегда будет солнце и голубое небо!",
                            "target_lang_translations": {
                                "en": "<w>May</w> there always be sunshine and a blue sky!",
                                "de": "<w>Möge</w> es immer Sonne und einen blauen Himmel geben!"
                            }
                        }
                    ],
                    "synonyms": [
                        "пусть"
                    ],
                    "common_phrases": [
                        "пускай будет",
                        "пускай говорят"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "more informal than 'пусть'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A particle used to form the third-person imperative; expresses an urge, wish, call to action, or consent (similar to \"let\").",
                        "de": "Eine Partikel, die verwendet wird, um den Imperativ der dritten Person zu bilden; drückt einen Wunsch, eine Aufforderung oder eine Erlaubnis aus."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "particle for 3rd person imperative"
                            },
                            {
                                "target_lang_word": "may",
                                "target_lang_sense_clarification": "expressing a wish or hope"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lass",
                                "target_lang_sense_clarification": "Imperativ für die 3. Person (z.B. lass ihn kommen)"
                            },
                            {
                                "target_lang_word": "möge",
                                "target_lang_sense_clarification": "Ausdruck eines Wunsches oder einer Hoffnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5be0edb8-1cec-3aaa-aa88-89caa943481d",
                    "sense_definition": "Употребляется при выражении уступки, означая «даже если», «несмотря на то, что» или «хотя».",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пускай</w> на улице дождь, мы всё равно пойдём гулять.",
                            "target_lang_translations": {
                                "en": "<w>Even if</w> it's raining outside, we'll go for a walk anyway.",
                                "de": "<w>Auch wenn</w> es draußen regnet, gehen wir trotzdem spazieren."
                            }
                        },
                        {
                            "text": "Это решение, <w>пускай</w> и трудное, было единственно верным.",
                            "target_lang_translations": {
                                "en": "This decision, <w>though</w> difficult, was the only right one.",
                                "de": "Diese Entscheidung, <w>wenn auch</w> schwierig, war die einzig richtige."
                            }
                        }
                    ],
                    "synonyms": [
                        "пусть"
                    ],
                    "common_phrases": [
                        "пускай даже",
                        "пускай и"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express concession, meaning \"even if\", \"despite the fact that\", or \"although\".",
                        "de": "Wird verwendet, um eine Konzession auszudrücken, im Sinne von 'auch wenn', 'obwohl' oder 'trotz'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "even if",
                                "target_lang_sense_clarification": "concessive condition"
                            },
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "concessive conjunction"
                            },
                            {
                                "target_lang_word": "although",
                                "target_lang_sense_clarification": "concessive"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auch wenn",
                                "target_lang_sense_clarification": "konzessive Bedingung"
                            },
                            {
                                "target_lang_word": "obwohl",
                                "target_lang_sense_clarification": "konzessive Konjunktion"
                            },
                            {
                                "target_lang_word": "wenn auch",
                                "target_lang_sense_clarification": "einräumende Formulierung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae24f139-15cc-315c-a2d0-18e287627fc2",
                    "sense_definition": "Употребляется для выражения допущения или вынужденного согласия; соответствует словам «допустим», «положим», «ладно».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пускай</w> я ошибся в расчётах, но идея была правильной.",
                            "target_lang_translations": {
                                "en": "<w>Suppose</w> I made a mistake in the calculations, but the idea was correct.",
                                "de": "<w>Angenommen</w>, ich habe mich verrechnet, aber die Idee war richtig."
                            }
                        },
                        {
                            "text": "Ты хочешь сделать по-своему? Ну <w>пускай</w>, я не возражаю.",
                            "target_lang_translations": {
                                "en": "You want to do it your way? Well <w>fine</w>, I don't mind.",
                                "de": "Du willst es auf deine Art machen? Na <w>meinetwegen</w>, ich habe nichts dagegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "допустим",
                        "положим",
                        "пусть"
                    ],
                    "common_phrases": [
                        "ну пускай"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express an assumption or forced agreement; corresponds to \"suppose\", \"let's assume\", or \"okay\".",
                        "de": "Wird verwendet, um eine Annahme oder ein erzwungenes Einverständnis auszudrücken; entspricht 'angenommen', 'meinetwegen' oder 'in Ordnung'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suppose",
                                "target_lang_sense_clarification": "assumption"
                            },
                            {
                                "target_lang_word": "let's say",
                                "target_lang_sense_clarification": "assumption"
                            },
                            {
                                "target_lang_word": "fine",
                                "target_lang_sense_clarification": "reluctant agreement"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "angenommen",
                                "target_lang_sense_clarification": "Ausdruck einer Vermutung"
                            },
                            {
                                "target_lang_word": "meinetwegen",
                                "target_lang_sense_clarification": "widerwilliges Einverständnis"
                            },
                            {
                                "target_lang_word": "in Ordnung",
                                "target_lang_sense_clarification": "Zustimmung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04e2dcb1-f6eb-3fc8-b068-db48e20ce5ef",
                    "sense_definition": "Форма повелительного наклонения глагола <w>пускать</w> (единственное число, 2-е лицо); требование отпустить кого-то, разрешить вход или привести что-то в движение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не <w>пускай</w> собаку в дом, у неё грязные лапы.",
                            "target_lang_translations": {
                                "en": "Don't <w>let</w> the dog in the house, she has dirty paws.",
                                "de": "<w>Lass</w> den Hund nicht ins Haus, er hat schmutzige Pfoten."
                            }
                        },
                        {
                            "text": "<w>Пускай</w> воду, нам нужно наполнить ванну.",
                            "target_lang_translations": {
                                "en": "<w>Turn on</w> the water, we need to fill the bathtub.",
                                "de": "<w>Dreh</w> das Wasser auf, wir müssen die Wanne füllen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "не пускай",
                        "пускай воду"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative of пускать"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb \"пускать\" (singular, 2nd person); a command to release someone, allow entry, or set something in motion.",
                        "de": "Imperativform des Verbs 'пускать' (2. Person Singular); eine Aufforderung, jemanden loszulassen, den Zutritt zu gewähren oder etwas in Gang zu setzen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "allow or permit"
                            },
                            {
                                "target_lang_word": "let in",
                                "target_lang_sense_clarification": "allow entry"
                            },
                            {
                                "target_lang_word": "turn on",
                                "target_lang_sense_clarification": "start the flow of liquid"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lass",
                                "target_lang_sense_clarification": "erlauben oder zulassen"
                            },
                            {
                                "target_lang_word": "lass herein",
                                "target_lang_sense_clarification": "Zutritt gewähren"
                            },
                            {
                                "target_lang_word": "dreh auf",
                                "target_lang_sense_clarification": "Fluss von Flüssigkeit starten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
