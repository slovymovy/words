                "senses": [
                    {
                        "sense_id": "935bff13-a83b-3d53-83a6-cf15e0717588",
                        "entry_id": "91b7ab5a-1483-3892-9074-f925504fc01c",
                        "glosses": [
                            "Schweizer Fluss, der im Kanton Bern entspringt, das Emmental durchfließt und im Kanton Solothurn in die Aare mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b833b00-4029-422c-b1b9-a9ee2d3348cd",
                                "sense_id": "935bff13-a83b-3d53-83a6-cf15e0717588",
                                "text": "„Das langgezogene Strassendorf [Hindelbank] erstreckt sich in einer leicht gewellten Landschaft am südlichen Rand der Schwemmebene der Emme, am Fuss der Molassehügel des höheren Schweizer Mittellandes.“"
                            },
                            {
                                "example_id": "4dbda541-17eb-47bb-9c9f-9117b9e6c621",
                                "sense_id": "935bff13-a83b-3d53-83a6-cf15e0717588",
                                "text": "„Weil es im Einzugsgebiet der Emme stark regnet, warnen die Behörden vor einer Flutwelle im unteren Emmelauf und im Emmenkanal. Die Wassermassen haben die untere Emme im Grenzgebiet der Kantone Bern und Solothurn am Donnerstagnachmittag massiv anschwellen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
