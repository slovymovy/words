    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e6d14ec-4a77-3682-be42-06f499386bf9",
                    "sense_definition": "To give something to someone and receive something else in return.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exchange_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>swap</w> seats so she could see the stage better.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>поменяться</w> местами, чтобы она могла лучше видеть сцену.",
                                "tr": "Sahneyi daha iyi görebilmesi için koltukları <w>değiştirmeye</w> karar verdik."
                            }
                        },
                        {
                            "text": "I will <w>swap</w> my apple for your orange if you want.",
                            "target_lang_translations": {
                                "ru": "Я <w>обменяю</w> свое яблоко на твой апельсин, если хочешь.",
                                "tr": "İstersen elmamı senin portakalınla <w>takas ederim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exchange",
                        "trade",
                        "switch",
                        "interchange"
                    ],
                    "common_phrases": [
                        "swap places",
                        "swap stories",
                        "swap numbers",
                        "swap over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать что-то кому-то и получать что-то другое взамен.",
                        "tr": "Birine bir şey verip karşılığında başka bir şey almak, takas etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "производить обмен чем-либо"
                            },
                            {
                                "target_lang_word": "поменяться",
                                "target_lang_sense_clarification": "совершить обмен (совершенный вид)"
                            },
                            {
                                "target_lang_word": "обмениваться",
                                "target_lang_sense_clarification": "взаимно передавать друг другу"
                            },
                            {
                                "target_lang_word": "махнуться",
                                "target_lang_sense_clarification": "разг. совершить быстрый обмен"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takas etmek",
                                "target_lang_sense_clarification": "bir şeyi başka bir şeyle değiştirmek"
                            },
                            {
                                "target_lang_word": "değiş tokuş etmek",
                                "target_lang_sense_clarification": "karşılıklı nesne veya eşya vermek"
