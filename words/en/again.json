{
    "word_family": [
        "againward"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fabb4b91-a516-3324-9880-444a7c2951e8",
                    "sense_definition": "Another time; indicating a repeat of an action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoyed the movie so much that I want to see it <w>again</w> tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мне так понравился фильм, что я хочу посмотреть его <w>снова</w> завтра."
                            }
                        },
                        {
                            "text": "If you do not succeed at first, you should try <w>again</w> and <w>again</w>.",
                            "target_lang_translations": {
                                "ru": "Если сначала не получится, нужно пробовать <w>снова</w> и <w>снова</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "once more"
                    ],
                    "common_phrases": [
                        "again and again",
                        "try again",
                        "never again",
                        "once again"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ещё раз; указывает на повторение действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опять",
                                "target_lang_sense_clarification": "повторно"
                            },
                            {
                                "target_lang_word": "снова",
                                "target_lang_sense_clarification": "ещё раз"
                            },
                            {
                                "target_lang_word": "ещё раз",
                                "target_lang_sense_clarification": "однократное повторение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bd39354-3a2d-3424-876b-e75eb622f1a2",
                    "sense_definition": "Back to a former place, condition, or state.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long vacation, it feels good to be home <w>again</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого отпуска приятно <w>снова</w> оказаться дома."
                            }
                        },
                        {
                            "text": "The patient is feeling like her old self <w>again</w> after the surgery.",
                            "target_lang_translations": {
                                "ru": "После операции пациентка <w>снова</w> чувствует себя как прежде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "home again",
                        "together again",
                        "well again"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение в прежнее место, состояние или положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снова",
                                "target_lang_sense_clarification": "в прежнее состояние"
                            },
                            {
                                "target_lang_word": "опять",
                                "target_lang_sense_clarification": "в прежнее положение"
                            },
                            {
                                "target_lang_word": "обратно",
                                "target_lang_sense_clarification": "назад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b86c1ae-4e61-3896-b3dc-39738d0da043",
                    "sense_definition": "Used when asking a question to which one may have already received an answer but cannot remember.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conversational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry, what is your name <w>again</w>?",
                            "target_lang_translations": {
                                "ru": "Простите, как ваше имя <w>ещё раз</w>?"
                            }
                        },
                        {
                            "text": "Where are we meeting for dinner <w>again</w> tonight?",
                            "target_lang_translations": {
                                "ru": "Где мы, <w>говорите</w>, встречаемся за ужином сегодня вечером?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "what again",
                        "who again",
                        "where again"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in spoken English to request repetition of information."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется при переспрашивании информации, которую человек забыл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё раз",
                                "target_lang_sense_clarification": "при переспрашивании"
                            },
                            {
                                "target_lang_word": "говорите",
                                "target_lang_sense_clarification": "в вопросах о забытом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f161c97e-670a-3505-8c6b-610ccc18b487",
                    "sense_definition": "Used to introduce a repeated statement or to emphasize a point previously made.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conversational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Again</w>, I am not complaining, I just want to clarify the rules.",
                            "target_lang_translations": {
                                "ru": "<w>Опять же</w>, я не жалуюсь, я просто хочу уточнить правила."
                            }
                        },
                        {
                            "text": "Then <w>again</w>, we could just stay home and watch a movie.",
                            "target_lang_translations": {
                                "ru": "С <w>другой</w> стороны, мы могли бы просто остаться дома и посмотреть кино."
                            }
                        }
                    ],
                    "common_phrases": [
                        "then again",
                        "but again",
                        "there again"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения повторного утверждения или акцентирования внимания на сказанном ранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опять же",
                                "target_lang_sense_clarification": "для подчеркивания мысли"
                            },
                            {
                                "target_lang_word": "с другой стороны",
                                "target_lang_sense_clarification": "в значении 'then again'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8165f695-8a3d-3481-a352-24d30f8c0d87",
                    "sense_definition": "In addition to what has already been mentioned; furthermore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Again</w>, it is important to remember that safety comes first.",
                            "target_lang_translations": {
                                "ru": "<w>И снова</w> важно помнить, что безопасность превыше всего."
                            }
                        },
                        {
                            "text": "The costs are high and, <w>again</w>, the risks are significant.",
                            "target_lang_translations": {
                                "ru": "Затраты высоки и, <w>опять же</w>, риски значительны."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В дополнение к уже сказанному; кроме того."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опять же",
                                "target_lang_sense_clarification": "кроме того"
                            },
                            {
                                "target_lang_word": "и снова",
                                "target_lang_sense_clarification": "в дополнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb1008c-5137-34f3-b5e8-be42e6a4b9ab",
                    "sense_definition": "Used to indicate a factor of increase or comparison, often meaning 'more' or 'extra'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new rope is half as long <w>again</w> as the old one.",
                            "target_lang_translations": {
                                "ru": "Эта новая веревка в полтора раза <w>длиннее</w> старой."
                            }
                        },
                        {
                            "text": "The project took twice as long <w>again</w> as we originally planned.",
                            "target_lang_translations": {
                                "ru": "Проект занял в два раза <w>больше</w> времени, чем мы планировали изначально."
                            }
                        }
                    ],
                    "common_phrases": [
                        "half as much again",
                        "half as long again"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на увеличение или сравнение, часто в значении «ещё на столько же»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "больше",
                                "target_lang_sense_clarification": "при сравнении величин"
                            },
                            {
                                "target_lang_word": "столько же",
                                "target_lang_sense_clarification": "в конструкциях типа 'half as much again'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "43b1937b-ac97-3a18-a814-ddb8287e0a22",
                    "sense_definition": "A dialectal or archaic variation of the word 'against'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were all <w>again</w> the new government policy.",
                            "target_lang_translations": {
                                "ru": "Все жители деревни были <w>против</w> новой политики правительства."
                            }
                        },
                        {
                            "text": "He fought <w>again</w> the wind as he walked up the hill.",
                            "target_lang_translations": {
                                "ru": "Он боролся <w>против</w> ветра, поднимаясь на холм."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Found in some regional British and older English dialects."
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern standard English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диалектный или архаичный вариант слова 'against' (против)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "против",
                                "target_lang_sense_clarification": "архаичное/диалектное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}