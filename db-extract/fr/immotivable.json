                "senses": [
                    {
                        "sense_id": "4e1cb371-ac89-38fc-8563-d022ee2e4cc1",
                        "entry_id": "016cf47c-d16e-3575-a74e-c194e7db62f5",
                        "glosses": [
                            "À quoi on ne peut trouver de motif, de cause ou de raison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0107b30a-d1a5-43a0-b288-b12c4dce0817",
                                "sense_id": "4e1cb371-ac89-38fc-8563-d022ee2e4cc1",
                                "text": "Cette famille obscure s’avère totalement immotivable à l’intérieur du latin, et le manque de données comparatives directes conduit à de prudentes réserves ou bien à une accumulation d’hypothèses ingénieuses mais engagées sans fondement et sans perspective."
                            },
                            {
                                "example_id": "dccd5d80-15ee-4da5-8a98-0478a0bbcf2a",
                                "sense_id": "4e1cb371-ac89-38fc-8563-d022ee2e4cc1",
                                "text": "Chercher une phrase\nqui serait juste\njustifier une absence\nimmotivable\nun paragraphe illisible\ntrouver des points de suspension\nau fond de sa canette de four loko\net se dire\nque ça finira\npar où ça a starté"
                            },
                            {
                                "example_id": "06589090-11be-4410-a94d-a6169ba10d0a",
                                "sense_id": "4e1cb371-ac89-38fc-8563-d022ee2e4cc1",
                                "text": "Autrement dit, le récit factuel est souvent incroyable, c’est-à-dire immotivable, parce que le réel est souvent surprenant, c’est-à-dire arbitraire."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb1e4594-d259-3e5c-8c02-f1752c7ee58b",
                        "entry_id": "016cf47c-d16e-3575-a74e-c194e7db62f5",
                        "glosses": [
                            "À qui on ne peut donner de motivation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c173bf-d275-4bf6-a140-6f43582a933d",
                                "sense_id": "fb1e4594-d259-3e5c-8c02-f1752c7ee58b",
                                "text": "Le déprimé est quelqu’un qui ne s’intéresse à rien, qui n’a pas de « motivation ». Le déprimé est immotivable, ne peut recevoir de « récompense » : il n'a jamais droit à la prime !"
                            },
                            {
                                "example_id": "13fb1348-ce97-4bfe-8c44-ede342d062cf",
                                "sense_id": "fb1e4594-d259-3e5c-8c02-f1752c7ee58b",
                                "text": "Les professeurs se sentent dépassés par des classes impossibles, manipulées par des perturbateurs immotivables."
                            }
                        ]
                    }
