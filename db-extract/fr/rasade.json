        "fr-extract.jsonl": [
            {
                "entry_id": "8c27228e-6ba9-3b95-8dc8-b99485053186",
                "word": "rasade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f6c1feb8-9a4d-47f9-a032-3fdc91a464cb",
                        "entry_id": "8c27228e-6ba9-3b95-8dc8-b99485053186",
                        "tags": [
                            "plural"
                        ],
                        "form": "rasades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                        "entry_id": "8c27228e-6ba9-3b95-8dc8-b99485053186",
                        "glosses": [
                            "Quantité d'un verre de vin ou d’autre liquide, plein jusqu’aux bords."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28746ea-6eb7-40a4-982c-af329def5523",
                                "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                                "text": "À ces mots, l’hôte chancelant, se mit à chanter en espagnol, entrecoupant ses chants de rasades qu’il jetait dans son gosier en se renversant."
                            },
                            {
                                "example_id": "357b2d89-0c9c-4893-b41d-c90ac00d94d4",
                                "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                                "text": "Et les amis recommencèrent à boire à plus amples rasades, pendant qu’en dehors la neige tombait toujours."
                            },
                            {
                                "example_id": "297df3f6-f3da-483d-8472-3fff71e78781",
                                "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                                "text": "Aujourd'hui, je médite; je me rappelle avoir été frappé, partout où je suis allé, d'apercevoir dans les débits, dès la première heure du matin, des masses de gens, hommes ou femmes, corsant leur café par des rasades d'eau-de-vie."
                            },
                            {
                                "example_id": "da98b79e-66b8-4085-ad29-7b6befab531b",
                                "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                                "text": "L'homme à la sucette renverse un peu de vin dans la fourgonnette, puis s'en envoie une rasade. Il a beau boire un bon château, l'américain ne retiendra que son odeur de vinasse."
                            },
                            {
                                "example_id": "0623a9b4-10a8-4d8a-8f6d-5017c3fe41f3",
                                "sense_id": "37374fab-43eb-3e98-be2c-733ac383de6f",
                                "text": "Un seul remède : cheuler. Il prend dans la portière une petite bouteille en plastique, moitié gin moitié Schweppes, […], et s'envoie une bonne rasade."
                            }
                        ]
                    }
                ],
