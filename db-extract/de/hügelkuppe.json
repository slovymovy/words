                "senses": [
                    {
                        "sense_id": "aa070bcd-c72e-380f-9955-0d2044f167e0",
                        "entry_id": "8552552b-5f59-3717-935d-3ebb34614725",
                        "glosses": [
                            "höchste, rundliche Erhebung eines Hügels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444dbedb-72b5-4e1b-b4ff-5df797f7b5b8",
                                "sense_id": "aa070bcd-c72e-380f-9955-0d2044f167e0",
                                "text": "„Zwei oder drei Minuten später stürmte die berittene Truppe mit Don Pedro an der Spitze über die Hügelkuppe.“"
                            },
                            {
                                "example_id": "23a635b6-6a00-4ca8-9cc8-22495388910e",
                                "sense_id": "aa070bcd-c72e-380f-9955-0d2044f167e0",
                                "text": "„Der Volvo rollt über die schmale Schotterstraße voller Schlaglöcher, die hundert Meter über dem Ufer verläuft, ziemlich gerade, aber mit einigen nicht einsehbaren Hügelkuppen.“"
                            }
                        ],
