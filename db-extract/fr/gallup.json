                        "sense_id": "68446395-6b72-3687-8be2-c08ccf2435f0",
                        "entry_id": "9b28c2d3-d456-3036-8de0-153ffa152303",
                        "glosses": [
                            "Première dénomination, devenue désuète, du sondage d’opinion."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7ce5b988-4bd2-48bd-b806-8b443c4d38e8",
                                "sense_id": "68446395-6b72-3687-8be2-c08ccf2435f0",
                                "text": "J’avais envie de faire, pour mon édification, une de ces enquêtes ou Gallups, par lesquelles la statistique tente d’ordonner le hasard."
                            },
                            {
                                "example_id": "39f6cd47-dcf2-4932-98b3-92b929775414",
                                "sense_id": "68446395-6b72-3687-8be2-c08ccf2435f0",
                                "text": "Malgré une tentative lors de la signature des accords de Munich par Daladier, le premier sondage d’opinion en France, alors appelé un gallup, ne connait aucun succès et ne sera publié que confidentiellement."
                            }
                        ]
                    }
