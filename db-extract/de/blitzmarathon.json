                "senses": [
                    {
                        "sense_id": "066d75e1-171a-3305-b3c5-4be82ee2ce1e",
                        "entry_id": "1c24d9a0-7a09-3a9e-8665-2ddc4f0c2b74",
                        "glosses": [
                            "Tag, an dem an überdurchschnittlich vielen Radarkontrollen durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e83c7b3-b653-41e1-b759-44cee238df78",
                                "sense_id": "066d75e1-171a-3305-b3c5-4be82ee2ce1e",
                                "text": "„Beim zweiten bundesweiten Blitzmarathon sind über 13.000 Polizisten an etwa 7500 Messstellen im Einsatz.“"
                            },
                            {
                                "example_id": "3c8c6baf-3793-4859-9136-79e0be0e4461",
                                "sense_id": "066d75e1-171a-3305-b3c5-4be82ee2ce1e",
                                "text": "„Der Blitzmarathon soll auch ein wenig die Frage beantworten: Wie tickt der deutsche Autofahrer?“"
                            },
                            {
                                "example_id": "c49f9fac-479a-46c9-8196-effaa1d1507e",
                                "sense_id": "066d75e1-171a-3305-b3c5-4be82ee2ce1e",
                                "text": "„Die Kölner Polizei hat beim Blitzmarathon bis zum frühen Donnerstagnachmittag bereits mehr als 43.000 Autofahrer auf Autobahnen und in der Stadt kontrolliert.“"
                            },
                            {
                                "example_id": "3842d540-ca8f-4d20-af5e-6bffd2d46a87",
                                "sense_id": "066d75e1-171a-3305-b3c5-4be82ee2ce1e",
                                "text": "„Auf Beschluss der Innenministerkonferenz findet vom 18. September, 6 Uhr bis 19. September, 6 Uhr der zweite bundesweite Blitzmarathon unter Beteiligung aller Bundesländer statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
