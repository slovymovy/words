                "senses": [
                    {
                        "sense_id": "c5eed342-64cc-3e8a-80fc-8e087489ac70",
                        "entry_id": "851e8325-5857-3420-8377-34ad7dfd47a7",
                        "glosses": [
                            "The quality or degree of being useful."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "25cb3254-d794-4580-8b10-d203475f2a9c",
                                "sense_id": "c5eed342-64cc-3e8a-80fc-8e087489ac70",
                                "text": "The usefulness of his latest reorganisation has been disputed."
                            },
                            {
                                "example_id": "921a0b02-4b49-4994-a3f5-20f0b0e55e64",
                                "sense_id": "c5eed342-64cc-3e8a-80fc-8e087489ac70",
                                "text": "Always kept in the background, and undervalued by Lady Anne, who disliked the spirit of active usefulness which characterized her youngest daughter, this was the first time that Isabella had been loved for herself;..."
                            },
                            {
                                "example_id": "5ba93bf7-07a8-4ca9-83e5-3a0fb9cc9df8",
                                "sense_id": "c5eed342-64cc-3e8a-80fc-8e087489ac70",
                                "text": "Redding’s study asked four psychologists with expertise in anxiety and depressive disorders to rate each self-help book on five criteria: […] and the general usefulness of the book as a self-administered method for changing behavior or psychological change."
                            }
                        ]
                    }
                ],
