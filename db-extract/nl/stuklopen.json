                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df67022-2e2d-43a3-b46c-6dc1e8af26a7",
                                                "sense_id": "8f855ae4-0f11-3ba0-978a-6f7a39372b93",
                                                "text": "As we breasted the first summit, the precipitous mass of the Raven's Rock, towering some 250 ft. above the railway, looked grim and forbidding in the failing light, and distant Ben Wyves was shrouded in mist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "failing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2530ed4-584d-3a21-afad-69bdba00e14b",
                                        "entry_id": "4d168894-ea84-36cc-8115-480e904524c5",
                                        "glosses": [
                                            "weakness; defect"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60577cf-1e73-4e58-9a58-064c9754874f",
                                                "sense_id": "d2530ed4-584d-3a21-afad-69bdba00e14b",
                                                "text": "His worst failing is his temper."
                                            },
                                            {
                                                "example_id": "bbc32ebf-ae2f-4339-8259-3c20bbc56205",
                                                "sense_id": "d2530ed4-584d-3a21-afad-69bdba00e14b",
                                                "text": "At the High Court in Aberdeen in September, NR pleaded guilty to a series of failings, including failing to tell the driver that it was unsafe to drive the train at the 75mph line speed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "failing",
                                "target_lang_code": "en",
                                "target_senses": [
