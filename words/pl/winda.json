{
    "word_family": [
        "windowy",
        "windziarz"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a23e4b6-ab8f-3a80-93d0-2de254e41395",
                    "sense_definition": "Urządzenie mechaniczne w postaci kabiny lub platformy poruszającej się w pionie, służące do transportu ludzi i towarów między piętrami budynku.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transport_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieszkam na dziesiątym piętrze, więc codziennie jeżdżę <w>windą</w>.",
                            "target_lang_translations": {
                                "ru": "Я живу на десятом этаже, поэтому каждый день езжу на <w>лифте</w>."
                            }
                        },
                        {
                            "text": "W przypadku pożaru nie wolno korzystać z <w>windy</w>, należy użyć schodów.",
                            "target_lang_translations": {
                                "ru": "В случае пожара нельзя пользоваться <w>лифтом</w>, следует воспользоваться лестницей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dźwig"
                    ],
                    "common_phrases": [
                        "jechać windą",
                        "winda towarowa",
                        "szyb windy",
                        "zepsuta winda"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое подъемное устройство в виде кабины или платформы для перевозки людей и грузов между этажами здания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лифт",
                                "target_lang_sense_clarification": "подъемник в здании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47ed88d-e312-324c-b174-d65b8ecd3e99",
                    "sense_definition": "Potoczne określenie systemu operacyjnego Microsoft Windows.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "software_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę przeinstalować <w>windę</w>, bo komputer zaczął bardzo wolno działać.",
                            "target_lang_translations": {
                                "ru": "Мне нужно переустановить <w>винду</w>, потому что компьютер стал очень медленно работать."
                            }
                        },
                        {
                            "text": "Większość gier komputerowych jest tworzona głównie pod <w>windę</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство компьютерных игр разрабатывается в основном под <w>винду</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Windows",
                        "windoza"
                    ],
                    "common_phrases": [
                        "przeinstalować windę",
                        "siedzieć na windzie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informatyka"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обозначение операционной системы Microsoft Windows."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винда",
                                "target_lang_sense_clarification": "жаргонное название ОС Windows"
                            },
                            {
                                "target_lang_word": "виндовс",
                                "target_lang_sense_clarification": "операционная система"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c49897e7-9b4f-3410-ab89-606e51e36e26",
                    "sense_definition": "Urządzenie mechaniczne, zazwyczaj na statku, służące do nawijania liny lub łańcucha w celu podnoszenia ciężkich obiektów, takich jak kotwica.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Załoga statku użyła <w>windy</w> kotwicznej, aby przygotować się do wypłynięcia z portu.",
                            "target_lang_translations": {
                                "ru": "Экипаж судна задействовал якорную <w>лебёдку</w>, чтобы подготовиться к выходу из порта."
                            }
                        },
                        {
                            "text": "Mechanik sprawdził stan techniczny <w>windy</w> przed rozpoczęciem załadunku.",
                            "target_lang_translations": {
                                "ru": "Механик проверил техническое состояние <w>лебёдки</w> перед началом погрузки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winda kotwiczna",
                        "winda parowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механизм, обычно на судне, для наматывания каната или цепи с целью подъема тяжестей (например, якоря)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лебёдка",
                                "target_lang_sense_clarification": "механизм для подъема и перемещения грузов"
                            },
                            {
                                "target_lang_word": "брашпиль",
                                "target_lang_sense_clarification": "якорная лебедка с горизонтальным валом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}