                        "examples": [
                            {
                                "example_id": "c56e8b79-a070-4d0b-b1cc-0f0ed7c7a5c2",
                                "sense_id": "9d7235f7-4435-3ef3-b2c7-40c458b30dc6",
                                "text": "Les Pastoureaux, annonciateurs des Jacques, occupent une place unique dans l’histoire des soulèvements populaires : les leurs tiennent de la pastorale, de la moutonnade même, mais aussi de la tragédie."
                            },
                            {
                                "example_id": "23755101-53c3-4392-989e-0b3a34d10c4c",
                                "sense_id": "9d7235f7-4435-3ef3-b2c7-40c458b30dc6",
                                "text": "Je venais de chanter de fort jolies moutonnades, dont mes amis étaient dans le ravissement."
                            }
                        ]
                    }
