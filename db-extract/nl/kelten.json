                        "entry_id": "64d9065c-050d-3883-ad88-faabfe74ccb2",
                        "glosses": [
                            "Indo-Europees volk waarvan de meeste leden op de Britse eilanden en in Bretagne leven"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "543c3446-eb91-41a3-a1d6-8574c204a8fb",
                                "sense_id": "ae413350-d13e-3b73-abca-d7ccc2ee874d",
                                "text": "De Kelten leefden vroeger in grote delen van Europa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b227a0cd-a8cd-413c-84c7-ee9ece37c1b8",
                        "source_entry_id": "64d9065c-050d-3883-ad88-faabfe74ccb2",
                        "source_sense_id": "ae413350-d13e-3b73-abca-d7ccc2ee874d",
                        "source_sense_description": "Indo-Europees volk waarvan de meeste leden op de Britse eilanden en in Bretagne leven",
                        "target_lang_word": "Kelten",
