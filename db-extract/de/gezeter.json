                        ],
                        "form": "dem Gezeter"
                    },
                    {
                        "form_id": "0130f22c-4215-4ed9-af13-78afb51ba863",
                        "entry_id": "013c0a62-dd33-32c0-ba1a-bb7e140e98ac",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gezeter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                        "entry_id": "013c0a62-dd33-32c0-ba1a-bb7e140e98ac",
                        "glosses": [
                            "anhaltendes, lautes Geschimpfe als Ausdruck von Zorn, Wut oder Unzufriedenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6448c2-c487-40bd-86ea-0f9f8c4dcf95",
                                "sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                                "text": "„Der Andi und ich führen die Essensausgabe wie ein selbstständiges Unternehmen, und das ist den Beamten super wichtig. Kein Stress, kein Gezeter, keine Arbeit für sie.“"
                            },
                            {
                                "example_id": "63e5e7d2-4dea-4635-a812-2cedfa30826b",
                                "sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                                "text": "„Heute wäre diese Aussage kaum mehr kontrovers, aber danach gab es großes Gezeter.“"
                            },
                            {
                                "example_id": "850df26f-d555-4b8f-b957-d5da2cf60368",
                                "sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                                "text": "„Für einen Moment schwiegen alle und versuchten aus dem Gezeter irgendeinen Sinn herauslesen zu können, was aber nicht gelang.“"
                            },
                            {
                                "example_id": "978631f1-a067-40b3-abdb-e67f3a3204c1",
                                "sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                                "text": "„Sie sprach mit mir über die Dame Pacienza und stimmte ein solches Gezeter an, daß ich schallend lachen mußte, als ich ihr erzählte, ich würde die Corticelli aushalten, und welchen harten Bedingungen ich mich dabei unterworfen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d1def03-10df-46c2-a8ef-5c677ded3eb8",
                        "source_entry_id": "013c0a62-dd33-32c0-ba1a-bb7e140e98ac",
                        "source_sense_id": "d890ec47-c416-3598-9a8f-cdd06367fe97",
                        "source_sense_description": "anhaltendes, lautes Geschimpfe als Ausdruck von Zorn, Wut oder Unzufriedenheit",
                        "target_lang_word": "clamor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clamor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec1656d-0e0f-3f06-9010-12ad60f3e2e9",
                                        "entry_id": "56704d66-9ba9-3a02-8840-cabea6347176",
                                        "glosses": [
                                            "A great outcry or vociferation; loud and continued shouting or exclamation."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f845fa-fbc5-4b8d-95ad-1d0ec59386be",
                                                "sense_id": "6ec1656d-0e0f-3f06-9010-12ad60f3e2e9",
                                                "text": "For when he knew his Rival freed and gone, / He ſwells with Wrath; he makes outrageous Moan: / He frets, he fumes, he ſtares, he ſtamps the Ground; / The hollow Tow'r with Clamours rings around: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f81cf2aa-15be-3319-93c6-b7f962a21101",
                                        "entry_id": "56704d66-9ba9-3a02-8840-cabea6347176",
                                        "glosses": [
                                            "Any loud and continued noise."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21729de0-315a-3a4c-a9ea-af248828430a",
                                        "entry_id": "56704d66-9ba9-3a02-8840-cabea6347176",
                                        "glosses": [
                                            "A continued public expression, often of dissatisfaction or discontent; a popular outcry."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clamor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23230e32-5697-3c9b-b19a-3a72e815aa8e",
                                        "entry_id": "d3081876-be62-344d-8bb1-40cf4743a99c",
                                        "glosses": [
                                            "To cry out or demand."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc63133-665d-4e8e-97e9-09fa2be83e76",
                                                "sense_id": "23230e32-5697-3c9b-b19a-3a72e815aa8e",
                                                "text": "Anyone who tastes our food seems to clamor for more."
                                            },
                                            {
                                                "example_id": "2db0b2e8-deca-4041-a90b-706c3fef6c8a",
                                                "sense_id": "23230e32-5697-3c9b-b19a-3a72e815aa8e",
                                                "text": "All the universities are sending in long petitions to restrict their production. Otherwise, they say, mankind will become extinct through lack of fertility. But the R. U. R. shareholders, of course, won't hear of it. All the governments, on the other hand, are clamoring for an increase in production, to raise the standards of their armies. And all the manufacturers in the world are ordering Robots like mad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8ffb3d-28d8-3fd7-991b-b9f75be00eee",
                                        "entry_id": "d3081876-be62-344d-8bb1-40cf4743a99c",
                                        "glosses": [
                                            "To demand by outcry."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973e0030-ba6f-46a7-8c7d-d2b02b8b0564",
                                                "sense_id": "6d8ffb3d-28d8-3fd7-991b-b9f75be00eee",
                                                "text": "Thousands of demonstrators clamoring the government's resignation were literally deafening, yet their cries fell in deaf ears"
                                            },
                                            {
                                                "example_id": "b820d727-4208-49fc-aafe-4c368699b2d5",
                                                "sense_id": "6d8ffb3d-28d8-3fd7-991b-b9f75be00eee",
                                                "text": "The distinctness of London has led many to clamor for the capital to pursue its own policies, especially on immigration. The British prime minister, David Cameron, is a Conservative. So is the mayor of London, Boris Johnson. But they have diametrically opposed views on immigration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb95268c-63fc-30c0-aa8b-8bd6a9b39914",
                                        "entry_id": "d3081876-be62-344d-8bb1-40cf4743a99c",
                                        "glosses": [
                                            "To become noisy insistently."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7f4979-f45d-480f-a859-aca229092bd8",
                                                "sense_id": "fb95268c-63fc-30c0-aa8b-8bd6a9b39914",
                                                "text": "After a confused murmur the audience soon clamored"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a32a02-1e63-3fd9-8267-ec54f6e95367",
                                        "entry_id": "d3081876-be62-344d-8bb1-40cf4743a99c",
                                        "glosses": [
                                            "To influence by outcry."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74834a5-2b8a-41f9-a72e-610b85a811a1",
                                                "sense_id": "e1a32a02-1e63-3fd9-8267-ec54f6e95367",
                                                "text": "His many supporters successfully clamor his election without a formal vote"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f337f2c-b02c-35d8-9d09-05554915e153",
                                        "entry_id": "d3081876-be62-344d-8bb1-40cf4743a99c",
                                        "glosses": [
                                            "To silence."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
