                                "target_lang_sense_clarification": "the common red wildflower"
                            },
                            {
                                "target_lang_word": "corn poppy",
                                "target_lang_sense_clarification": "specifically Papaver rhoeas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3373fce3-45ab-3d3f-8f56-c6a80945d7ef",
                    "sense_definition": "Een algemene benaming voor planten uit het geslacht Papaver.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>klaproos</w> is een symbool geworden van het slagveld van de Eerste Wereldoorlog.",
                            "target_lang_translations": {
                                "en": "The <w>poppy</w> has become a symbol of the battlefield of the First World War."
                            }
                        },
                        {
                            "text": "Er zijn verschillende soorten van de <w>klaproos</w> die in de tuin kunnen groeien.",
                            "target_lang_translations": {
                                "en": "There are different types of <w>poppy</w> that can grow in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "papaver"
                    ],
                    "common_phrases": [
                        "wilde klaproos"
                    ],
                    "target_lang_definitions": {
