                        "glosses": [
                            "Isotope formé par l’interaction des rayonnements cosmiques avec des noyaux terrestres."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a2a0c730-32cb-4657-8dac-bd970ba8acc8",
                                "sense_id": "fe007ad4-045d-3685-adb9-111a6eeb0174",
                                "text": "Le carbone 14 est un cosmonucléide : sa formation est liée aux bombardements dans la haute atmosphère de noyaux d’azote par des neutrons issus des rayons cosmiques."
                            },
                            {
                                "example_id": "ddb24eb9-1d34-4ff0-8f9e-7e75534c91f4",
                                "sense_id": "fe007ad4-045d-3685-adb9-111a6eeb0174",
                                "text": "Le béryllium 10 est un cosmonucléide qui se forme à partir de la silice et de l’oxygène dans le quartz des roches constitutives de morphologie glaciaire, c'est-à-dire résultant de l'action des glaciers."
                            }
                        ]
                    }
