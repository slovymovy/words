                    {
                        "sense_id": "4a049123-e70c-3ee6-94c8-82b576900260",
                        "entry_id": "6e2e3952-8fbf-373f-bda9-9772c77474a4",
                        "glosses": [
                            "verschillen in de eigenaardigheden van verschillende groepen mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eede6c83-6e7c-4c56-9efb-7f03142d3a68",
                                "sense_id": "4a049123-e70c-3ee6-94c8-82b576900260",
                                "text": "In Nederland zijn veel mensen overgevoelig voor autoriteit, dat is een cultuurverschil met de meeste andere culturen waarin autoriteit meer wordt geaccepteerd."
                            },
                            {
                                "example_id": "deb8cf53-1ce3-4766-9543-d06b5b48312a",
                                "sense_id": "4a049123-e70c-3ee6-94c8-82b576900260",
                                "text": "In het eten kunnen we grote cultuurverschillen zien tussen verschillende samenlevingen of bevolkingsgroepen."
                            },
                            {
                                "example_id": "47cdb93e-aed6-42a6-8116-82a7e25ec10b",
                                "sense_id": "4a049123-e70c-3ee6-94c8-82b576900260",
                                "text": "Van Oslo tot Athene, van Versailles tot Moskou - bij temperaturen boven de 25 graden zijn fonteinen kindermagneten. Wie af wil van een te groot geloof in cultuurverschillen en breuklijnen, moet tijdens een hittegolf fonteinen bezichtigen."
                            }
                        ]
                    }
