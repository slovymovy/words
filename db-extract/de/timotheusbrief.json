                "senses": [
                    {
                        "sense_id": "9b6b496e-2999-35f4-8219-c52ca28371d6",
                        "entry_id": "ff954df1-a533-36f5-9444-3411fdfdec98",
                        "glosses": [
                            "einer von zwei, Paulus zugeschriebenen Briefen an seinen Schüler, den Gemeindevorsteher Timotheus in Ephesus"
                        ],
                        "tags": [
                            "Neutestamentliche Bibelwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "249fec4f-e3e1-4365-aa70-f84309640c94",
                                "sense_id": "9b6b496e-2999-35f4-8219-c52ca28371d6",
                                "text": "„Die Trauerfeier leitete der Chor der Kaiser-Wilhelm-Gedächtniskirche mit dem ‚Integer vitae‘ ein, dann hielt Pfarrer Nithack-Stahn die Trauerrede über die Stelle des Timotheusbriefes: ‚So jemand auch kämpfet, wird er doch nicht gekrönt, er kämpfe denn recht‘.“"
                            },
                            {
                                "example_id": "a4026a9d-e8de-42e2-8eff-bf322bca59ba",
                                "sense_id": "9b6b496e-2999-35f4-8219-c52ca28371d6",
                                "text": "Die Frage nach dem Verfasser der beiden Timotheusbriefe ist bis heute lebhaft umstritten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
