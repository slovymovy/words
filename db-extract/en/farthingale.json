                "entry_id": "b07061a0-0310-3fec-bfbd-275cb9a14e20",
                "word": "farthingale",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "59d7a736-5d9b-4c55-9d09-f13a50088dfd",
                        "entry_id": "b07061a0-0310-3fec-bfbd-275cb9a14e20",
                        "tags": [
                            "plural"
                        ],
                        "form": "farthingales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dea94080-3fe1-3575-bb5d-1ef4ee542fc2",
                        "entry_id": "b07061a0-0310-3fec-bfbd-275cb9a14e20",
                        "glosses": [
                            "A hooped structure in cloth worn to extend the skirt of women's dresses; a hooped petticoat."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a9c73340-8647-487f-8b0d-49deafddb227",
                                "sense_id": "dea94080-3fe1-3575-bb5d-1ef4ee542fc2",
                                "text": "women […] make trunk-sleeves of wyre and whale-bone bodies, backes of lathes, and stiffe bumbasted verdugals, and to the open-view of all men paint and embellish themselves with counterfeit and borrowed beauties[…]."
                            },
                            {
                                "example_id": "8bd7fd3a-f811-41e9-9119-559fc9e74728",
                                "sense_id": "dea94080-3fe1-3575-bb5d-1ef4ee542fc2",
                                "text": "As I entered the room, the fire from the large square stove, where the logs were burning lustily, threw a red, flickering light through the wide-open door over the room, which was very deep, and furnished in the old style with high-backed Russia leather chairs, and one of those settees which were intended for farthingales and straight up-and-down positions."
                            },
                            {
                                "example_id": "9968fb0a-276b-4f40-82eb-e598c4ca4ac4",
                                "sense_id": "dea94080-3fe1-3575-bb5d-1ef4ee542fc2",
                                "text": "In Henry VIII's Great Hall, there were men in doublets and codpieces prancing up and down with women in farthingales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "badaa3ec-e19a-438f-8036-f0ce3b57449a",
                        "source_entry_id": "b07061a0-0310-3fec-bfbd-275cb9a14e20",
                        "source_sense_id": "dea94080-3fe1-3575-bb5d-1ef4ee542fc2",
                        "source_sense_description": "hooped structure",
                        "target_lang_word": "crinoline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crinoline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b70a0958-0eb8-37c4-be37-377bbe940ec4",
                                        "entry_id": "7ce87a62-98be-3beb-b195-7748c7fb2312",
                                        "glosses": [
                                            "Étoffe de crin dont on faisait des cols, des sacs, des jupons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f194e2aa-47e9-45c6-817d-03f4c57ac685",
                                                "sense_id": "b70a0958-0eb8-37c4-be37-377bbe940ec4",
                                                "text": "Une jupe de crinoline."
                                            },
                                            {
                                                "example_id": "42a6c4cd-8615-41ad-b76d-3c846548f946",
                                                "sense_id": "b70a0958-0eb8-37c4-be37-377bbe940ec4",
                                                "text": "Cinq ou six femmes, vêtues de robes de soie, très coquettes avec leurs chignons frisés et leurs crinolines rejetées en arrière, s’y agitaient en causant."
                                            },
                                            {
                                                "example_id": "0a06eb09-f0a1-4da5-8e8a-e0187e4cf671",
                                                "sense_id": "b70a0958-0eb8-37c4-be37-377bbe940ec4",
                                                "text": "Une jupe évasée, une crinoline si large que j'entrerai difficilement dans l'autobus et un petit cardigan tout mignon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                        "entry_id": "7ce87a62-98be-3beb-b195-7748c7fb2312",
                                        "glosses": [
                                            "Jupe de dessous garnie de baleines ou de lames d’acier flexibles."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef59391-8745-49a2-ae17-d04d9e4c9ea4",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "Le règne de l'absurde crinoline venait de finir et une robe bien coupée mettait en relief tous les avantages naturels de la dame […]."
                                            },
                                            {
                                                "example_id": "202999a9-1299-42a2-9ea5-6782f1c8c536",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "Que ne trouve-t-on pas dans les greniers ? […] ; des crinolines fripées, mais encore solides sur forme […]"
                                            },
                                            {
                                                "example_id": "82058764-7723-4ccd-9c99-0eea4a6afd8d",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "Il avait un logement au Prytanée, il l’a quitté à cause de la gêne et de l’obligation de s’habiller. « On ne rencontrait que crinolines et habits neufs dans le parc. » — Il paraît que la crinoline et l’ajustement tournent la tête de toutes les femmes ; les maris ont des appointements de dix-huit cents, deux mille, trois mille cinq cents francs ; un seul a quatre mille francs ; on doit rogner sur le bœuf et le potage pour fournir aux rubans."
                                            },
                                            {
                                                "example_id": "26cdfb1f-bfdb-44c7-86f3-e437312f39f0",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "On rit d’une mode différente de celles que nous voyons courir les rues ; les daguerréotypes de nos mères-grands en crinoline sont irrésistibles ; […]"
                                            },
                                            {
                                                "example_id": "45363713-ce20-433d-843c-66805a844ec7",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "Ma grand’mère, qui avait une coupe remarquable et beaucoup de goût, faisait à elle seule, pour chaque soirée, le tiers des toilettes, et ce n’était pas une mince affaire. La crinoline pouvait arriver à dix volants ; […]."
                                            },
                                            {
                                                "example_id": "99877fb2-86ae-4b9e-a91b-62a9dd6ffbd4",
                                                "sense_id": "12f75272-bbcd-3f5a-a130-a822443639f4",
                                                "text": "Sur les pavés de la place Sainte-Catherine\nDansaient les hommes les femmes en crinoline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc1f902-e9e8-300e-aeea-5cc5a66ed8c7",
                                        "entry_id": "7ce87a62-98be-3beb-b195-7748c7fb2312",
                                        "glosses": [
                                            "Arceau d’acier qui entoure une échelle verticale, pour éviter la chute de ses utilisateurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5447f6f8-3d9c-4b45-a00e-ee53654360f9",
                                                "sense_id": "9fc1f902-e9e8-300e-aeea-5cc5a66ed8c7",
                                                "text": "Lorsque l'extrémité supérieure d'une échelle aboutit au bord d'une plate-forme ses montants seront prolongés d'une hauteur de 1 m et la crinoline sera prolongée jusqu'à la hauteur du garde-corps de cette plate-forme."
                                            },
                                            {
                                                "example_id": "5290f56e-95a7-47d2-b53c-699bd4a9204e",
                                                "sense_id": "9fc1f902-e9e8-300e-aeea-5cc5a66ed8c7",
                                                "text": "La hauteur d'une échelle à crinoline à une seule volée est limitée à 8 m.\nLa hauteur des volées d'une échelle à crinoline à plusieurs volées est limitée à 6 m."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
