                        "examples": [
                            {
                                "example_id": "b51ca9bf-54f4-4198-9ca5-4d94f725fc3d",
                                "sense_id": "d51383ea-60c1-332f-b45b-56fcbb092a07",
                                "text": "In meinem Auslandssemester habe ich viele Spaziergänge durch Caen unternommen."
                            },
                            {
                                "example_id": "357c9048-2aa7-4458-8af3-a53651cfad97",
                                "sense_id": "d51383ea-60c1-332f-b45b-56fcbb092a07",
                                "text": "„Die Firma NXP Semiconductors unterhält in Caen ein Halbleiterwerk mit einer Forschungs- und Entwicklungsabteilung.“"
                            },
                            {
                                "example_id": "a94b11f3-e023-4dde-ade2-67f098dcc826",
                                "sense_id": "d51383ea-60c1-332f-b45b-56fcbb092a07",
                                "text": "„Als er am Freitag in Caen ausstieg, waren seine Gepäckstücke noch nicht da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
