                "senses": [
                    {
                        "sense_id": "bb62b72b-8a75-3eb2-b8e6-ad513e6901c3",
                        "entry_id": "138e3f41-3e2a-3e23-b7ca-cb555f7d5d7f",
                        "glosses": [
                            "niet meer te verdedigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29a7201-2598-420a-99b2-fe4d7303f8d3",
                                "sense_id": "bb62b72b-8a75-3eb2-b8e6-ad513e6901c3",
                                "text": "Deze dwaze man verkondigde weer eens een van zijn onhoudbare stellingen."
                            },
                            {
                                "example_id": "d5a3bd04-645b-499e-bd06-7c09792a9da3",
                                "sense_id": "bb62b72b-8a75-3eb2-b8e6-ad513e6901c3",
                                "text": "Aan een nieuwe veiligheidswet voegden rechtse politici een amendement toe dat hennep de facto gelijkstelt aan cannabis. De plant mag nog wel geteeld worden voor de vezels en de bladeren, maar de bloemen mogen niet meer verkocht worden. \"Economisch onhoudbaar\", noemt de Calabrese ondernemer Mattia Cusani dat."
                            }
                        ]
                    }
                ],
