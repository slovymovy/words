                                        "glosses": [
                                            "A trans lesbian."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9f4a40-e71d-4e4f-9937-d2013c871b04",
                                                "sense_id": "df3fff45-322f-3f3b-99d5-cae54ea318c2",
                                                "text": "Our trans meeting at the clinic breaks up, after a discussion about transbians."
                                            },
                                            {
                                                "example_id": "242ae998-8763-443c-a28a-2a35b28479e6",
                                                "sense_id": "df3fff45-322f-3f3b-99d5-cae54ea318c2",
                                                "text": "To give an opinionated answer, I'd say no, I do not think that there is a trend toward all transsexuals becoming transbians."
                                            },
                                            {
                                                "example_id": "4d01d558-41b6-4cf4-b623-b24b38498970",
                                                "sense_id": "df3fff45-322f-3f3b-99d5-cae54ea318c2",
                                                "text": "“So, I'm a butch transbian, so by most standards I'm literally just a cis-het dude-”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
