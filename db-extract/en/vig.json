                        "entry_id": "ea634123-1369-3564-a516-3c173b7aed97",
                        "glosses": [
                            "Initialism of voter information guide."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "1378256b-834a-4d2d-9178-e9370cad36d4",
                                "sense_id": "042a8372-cb5e-37ee-8c41-16edef4ef404",
                                "text": "Elections officials aim to send out the VIGs before voters get their ballots. By law, all elections officials must mail the VIG no sooner than 40 days or later than 21 days before an election, or no later than 10 days if the voter was registered later on in the process. Elec. Code §§ 9094, 13303."
                            }
                        ]
