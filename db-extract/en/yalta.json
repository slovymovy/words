                                    {
                                        "sense_id": "7986be72-e55f-30aa-b3a9-2ba935d8130f",
                                        "entry_id": "fa0fdd93-f427-3dfb-9db7-64f78eb83eb1",
                                        "glosses": [
                                            "Hafenstadt und Kurort auf der Krim, in der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "220e1d7b-35f1-4225-8716-7800572feb50",
                                                "sense_id": "7986be72-e55f-30aa-b3a9-2ba935d8130f",
                                                "text": "Jalta liegt im Süden der Krim, ungefähr 50 Kilometer südöstlich von Sewastopol."
                                            },
                                            {
                                                "example_id": "a018d6c4-fe28-430e-89af-e019035f6507",
                                                "sense_id": "7986be72-e55f-30aa-b3a9-2ba935d8130f",
                                                "text": "„In Jalta findet die zweite Gipfelkonferenz zwischen dem US-amerikanischen Präsidenten Franklin D. Roosevelt, dem britischen Premierminister Winston Churchill und dem sowjetischen Staatschef Josef W. Stalin statt, auf der die Richtlinien der alliierten Nachkriegspolitik fest gelegt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
