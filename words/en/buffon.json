    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58d59afd-f9b9-3245-a40d-f00166e1c809",
                    "sense_definition": "An obsolete spelling of <w>buffoon</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "buffoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king laughed heartily at the antics of his favorite <w>buffon</w>.",
                            "target_lang_translations": {
                                "ru": "Король от души смеялся над выделками своего любимого <w>шута</w>."
                            }
                        },
                        {
                            "text": "He was dismissed from the court for acting like a mere <w>buffon</w>.",
                            "target_lang_translations": {
                                "ru": "Его выгнали со двора за то, что он вел себя как обычный <w>паяц</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова buffoon (шут, паяц)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "комический персонаж, паяц"
                            },
                            {
                                "target_lang_word": "паяц",
                                "target_lang_sense_clarification": "клоун, кривляка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8788d94-58be-30ef-a411-ce19e194f578",
                    "sense_definition": "A projecting, puffed-out neckerchief or gauze covering for the breast, worn by women in the late 18th century.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The front of her historical gown was always covered with a <w>buffon</w> or neckerchief.",
                            "target_lang_translations": {
                                "ru": "Передняя часть ее исторического платья всегда была прикрыта <w>буффоном</w> или шейным платком."
                            }
                        },
                        {
                            "text": "She adjusted the lace <w>buffon</w> around her neck before entering the ballroom.",
                            "target_lang_translations": {
                                "ru": "Она поправила кружевной <w>буффон</w> на шее перед тем, как войти в бальный зал."
                            }
                        }
                    ],
                    "synonyms": [
                        "buffont"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical fashion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий, пышный шейный платок или марлевая косынка, закрывающая грудь, которую носили женщины в конце XVIII века."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буффон",
                                "target_lang_sense_clarification": "пышный женский шейный платок XVIII века"
                            },
                            {
                                "target_lang_word": "фишю-буффон",
                                "target_lang_sense_clarification": "историческая деталь женского гардероба"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "934e86de-9cd8-3430-941c-afd9005df218",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous naturalist Georges-Louis Leclerc, Comte de <w>Buffon</w>, made major contributions to science.",
                            "target_lang_translations": {
                                "ru": "Знаменитый натуралист Жорж-Луи Леклерк, граф де <w>Бюффон</w>, внес огромный вклад в науку."
                            }
                        },
                        {
                            "text": "We studied the evolutionary theories of <w>Buffon</w> in our history of science class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали эволюционные теории <w>Бюффона</w> на уроке истории науки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бюффон",
                                "target_lang_sense_clarification": "французский натуралист Жорж-Луи Леклерк де Бюффон"
                            }
                        ]
                    }
                }
            ]
        }
    ]
