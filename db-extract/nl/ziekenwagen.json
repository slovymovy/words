                    {
                        "translation_id": "383fda5e-d1ce-4510-8dae-bce339673f61",
                        "source_entry_id": "3bc02799-d293-3d74-8121-a14d7e0f1683",
                        "source_sense_id": "6ae69813-7c13-3471-8076-12ec17850db2",
                        "source_sense_description": "een voertuig ingericht voor het vervoer van patiënten, gewoonlijk naar een ziekenhuis toe",
                        "target_lang_word": "ambulance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambulance",
