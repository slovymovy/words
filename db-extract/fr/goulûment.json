                ],
                "senses": [
                    {
                        "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                        "entry_id": "2ec82062-254b-375c-8768-21e84cdc2e9d",
                        "glosses": [
                            "D’une manière goulue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77f123bb-9662-441d-a774-cebd6b74d11c",
                                "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                                "text": "En même temps, il ferma la porte et, saisissant la jolie Mariette par la taille, il l’embrassa goulûment sur la bouche."
                            },
                            {
                                "example_id": "a8bc0930-f2e1-4ae0-8015-7aabcacd8c95",
                                "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                                "text": "Elle but goulûment sa citronnade et s’écria : « Appelez votre chauffeur. On part. »"
                            },
                            {
                                "example_id": "d4b3e17b-6621-43d2-8a1f-4919ed6a8769",
                                "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                                "text": "Des cavaliers – les plus riches – employaient ce loisir à changer de monture. D’autres, pour étancher leur soif, mordaient goulûment dans la tranche de pastèque ou la grappe de raisin que leur tendaient leurs saïs."
                            },
                            {
                                "example_id": "b9f67b9e-4d1e-4b16-a779-224b56e906ad",
                                "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                                "text": "D'abord timidement, puis de plus en plus goulûment, tu nous savoures des yeux."
                            },
                            {
                                "example_id": "c8fb205d-6985-4040-a836-4a56f35cbf5d",
                                "sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                                "text": "Je savoure goulûment ce que cette année m’a apporté de bon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37b75763-f33d-49b9-b3ae-c22a61fb239e",
                        "source_entry_id": "2ec82062-254b-375c-8768-21e84cdc2e9d",
                        "source_sense_id": "f573006c-b6ec-3c96-a0a5-6b035aa781da",
                        "target_lang_word": "hungrily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hungrily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                        "entry_id": "08f84c34-0b5c-3ce8-8053-2211ac3b34f7",
                                        "glosses": [
                                            "In a hungry way or manner; with hunger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6277ae-5575-45e0-918d-750673c70680",
                                                "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                                "text": "For at the last shall the thunder, fleeing to escape from the doom of the gods, roar horribly among the Worlds; and Time, the hound of the gods, shall bay hungrily at his masters because he is lean with age."
                                            },
                                            {
                                                "example_id": "afc1fa17-b15a-4a8d-8ac7-e48b1ac4dccf",
                                                "sense_id": "ea3bfef5-cc29-30c6-bf10-db13587bc6aa",
                                                "text": "Nungi was too hungrily cross to be respectful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
