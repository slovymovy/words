                                "target_senses": [
                                    {
                                        "sense_id": "6b7c5a03-25ff-3bb8-8476-d2ec4803e828",
                                        "entry_id": "5ddf709a-391b-35a5-bb1e-66eebc74e6ba",
                                        "glosses": [
                                            "Hell; the bottomless pit; primeval chaos; a confined subterranean ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5546256d-2f40-4d24-8db8-132d90c7ad20",
                                                "sense_id": "6b7c5a03-25ff-3bb8-8476-d2ec4803e828",
                                                "text": "'You cannot enter here,' said Gandalf, and the huge shadow halted. 'Go back to the abyss prepared for you! Go back! Fall into the nothingness that awaits you and your Master. Go!'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340e25e4-231f-3fac-8a5e-401c543fed3f",
                                        "entry_id": "5ddf709a-391b-35a5-bb1e-66eebc74e6ba",
                                        "glosses": [
                                            "A bottomless or unfathomed depth, gulf, or chasm; hence, any deep, immeasurable; any void space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5751bcb-ec5e-4b86-a225-c28c8afab8a2",
                                                "sense_id": "340e25e4-231f-3fac-8a5e-401c543fed3f",
                                                "text": "Below is the deep abyss of the Lauterbrunnen valley, and at its head a stately semi-circle of mountains, with the pyramidal Lauterbrunnen Breithorn as the centre-piece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2c12d6-84bf-331f-8273-67a4afa15ae7",
                                        "entry_id": "5ddf709a-391b-35a5-bb1e-66eebc74e6ba",
                                        "glosses": [
                                            "Anything infinite, immeasurable, or profound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fb1d9d2-ab66-302d-86aa-828e9901de47",
                                        "entry_id": "5ddf709a-391b-35a5-bb1e-66eebc74e6ba",
                                        "glosses": [
                                            "Moral depravity; vast intellectual or moral depth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7790ea-c72b-47ea-b314-1f9ea8b2cf33",
                                                "sense_id": "1fb1d9d2-ab66-302d-86aa-828e9901de47",
