                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a9f79a-598f-3b8b-a7d1-17826a154ef1",
                                        "entry_id": "ad869985-7e0c-3bff-a76d-96efbdb29121",
                                        "glosses": [
                                            "immer in der Erinnerung bleibend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5713ae-417d-4096-a9b7-e3f78c8b28ac",
                                                "sense_id": "a6a9f79a-598f-3b8b-a7d1-17826a154ef1",
                                                "text": "Die Geburtstagsfeier bleibt mir unvergesslich gut in Erinnerung."
                                            },
                                            {
                                                "example_id": "4d8638a2-5344-4ac9-a6af-514c641cc428",
                                                "sense_id": "a6a9f79a-598f-3b8b-a7d1-17826a154ef1",
                                                "text": "Das Wetter im August war unvergesslich heiß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
