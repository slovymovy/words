                                            },
                                            {
                                                "example_id": "5f7e3e69-4539-4716-ab6b-a727b0164c72",
                                                "sense_id": "5b510653-7732-3e45-aefc-01debdcb210f",
                                                "text": "meticulous knowledge"
                                            },
                                            {
                                                "example_id": "5ec16b8e-6c62-40b6-bb27-be074d28c85b",
                                                "sense_id": "5b510653-7732-3e45-aefc-01debdcb210f",
                                                "text": "meticulous report"
                                            },
                                            {
                                                "example_id": "1a725d45-52c1-4e58-aaa4-0373fa9d1298",
                                                "sense_id": "5b510653-7732-3e45-aefc-01debdcb210f",
                                                "text": "The meticulous care with which the operation in Sicily was planned has paid dividends. Our casualties in men, in ships and materiel have been low—in fact, far below our estimate."
                                            },
                                            {
                                                "example_id": "3adc5425-0a8d-4a91-8f7b-5bc48f973881",
                                                "sense_id": "5b510653-7732-3e45-aefc-01debdcb210f",
                                                "text": "Currently, bodyshells for units 810024/025 are on the weld line. […] In the paint shop are bodyshells for 810022/023, which are undergoing a meticulous process to ensure a high-quality finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bab80bd-b445-3558-976b-c4927d044c40",
                                        "entry_id": "ff5de8a5-7d31-3237-bd8b-7c6ff624cf1d",
                                        "glosses": [
                                            "Timid, fearful, overly cautious."
                                        ],
