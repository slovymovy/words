                ],
                "senses": [
                    {
                        "sense_id": "2e9e5758-d69a-367d-927f-656930954fe8",
                        "entry_id": "bbf7c556-ea0e-377a-a8c4-5b1020b3ad29",
                        "glosses": [
                            "autíčko (na hraní), angličák"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868db297-98ac-44ab-9dc4-d35c19fa5a6f",
                                "sense_id": "2e9e5758-d69a-367d-927f-656930954fe8",
                                "text": "“Hij blijft erbij dat hij niet stond. Hij geeft toe dat hij hoog zat, maar behield steeds de controle over zijn voertuig. Het is een erg kleine auto. Het is een beetje als een reus in een speelgoedauto”, verdedigt zijn advocaat Nick Cartmell bij Chronicle Live."
                            },
                            {
                                "example_id": "36e75533-b800-4afc-9d6b-f1afd57bbff8",
                                "sense_id": "2e9e5758-d69a-367d-927f-656930954fe8",
                                "text": "Meer dan 100 mensen kwamen op de been om te zoeken en zelfs een helikopter werd ingezet. Na drie dagen werd het ventje teruggevonden, toen hij reageerde op de stem van zijn oom. De eerste vraag die hij stelde was of zijn speelgoedautootje het goed stelde.",
                                "translation": "Do jeho hledání se pustiĺo více než sto lidí a dokonce byl nasazen i vrtulník. Po třech dnech byl chlapec znovunalezen, když zareagoval na strýcův hlas. První otázka, kterou položil, byla, zda se jeho autíčko dobře chovalo/má dobře."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
