                ],
                "senses": [
                    {
                        "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                        "entry_id": "b4c9d9e5-5889-381b-921c-df6062a29c3a",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Erziehung an Vorschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026bfe9a-9281-4af2-a34f-134cd64b988b",
                                "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                                "text": "„Denn eigentlich beneidet die halbe Welt die Franzosen um ihr flächendeckendes dreijähriges Vorschulsystem, das von weit denkenden Politikern des französischen Widerstands gegen die Nazis schon am Ende des Zweiten Weltkriegs eingeführt wurde.“"
                            },
                            {
                                "example_id": "f665ffd9-877d-4c6f-baca-75ab209afd60",
                                "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                                "text": "„Das Vorschulsystem Italiens findet er vorbildlich, die weiterführenden Schulen dagegen verbesserungsbedürftig.“"
                            },
                            {
                                "example_id": "5bbae158-2b93-474f-a401-57c2973a691d",
                                "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                                "text": "„Die Konferenz der europäischen Bildungsminister hat bereits 1977 empfohlen, das Vorschulsystem in das Bildungssystem zu integrieren,\" bemängelt Carle.“"
                            },
                            {
                                "example_id": "87acc9d6-a63f-46e7-b642-4bd107b2cd88",
                                "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                                "text": "„Um einen internationalen Vergleich der einzelnen Vorschulsysteme zu ermöglichen, muss ein entsprechendes methodisches Instrumentarium erstellt werden.“"
                            },
                            {
                                "example_id": "238ba01d-5a64-4d98-bfa1-ba88dc1c18a2",
                                "sense_id": "24867098-3808-3d3d-b20c-03b2fccdf0fc",
                                "text": "„Seit 1971 wurde beispielsweise vom Rat für Kulturelle Zusammenarbeit des Europarats der Informationsaustausch über die Entwicklungen und Hauptprobleme der jeweiligen nationalen Vorschulsysteme der Mitgliedsländer vorangetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
