                ],
                "senses": [
                    {
                        "sense_id": "f6e87793-728d-3e10-8d58-5601cfe04c46",
                        "entry_id": "67126036-cdc0-3cf7-b7ee-bf37964b48d9",
                        "glosses": [
                            "eine von Raoul Auger Feuillet um 1700 entwickelte Schrift zur Aufzeichnung von Tanzfolgen"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "ec1ee8e1-b81a-4ddf-8501-cf46aa7bec83",
                                "sense_id": "f6e87793-728d-3e10-8d58-5601cfe04c46",
                                "text": "„1767 veröffentlichte der Tanzlehrer Carl Joseph von Feldtenstein sein Buch „Die Kunst, nach der Choreographie zu tanzen und Tänze zu schreiben“. Hier ist also Choreographie noch identisch mit Tanzschrift. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "66526a83-64eb-3800-9fe8-5960189a34f1",
                        "entry_id": "67126036-cdc0-3cf7-b7ee-bf37964b48d9",
                        "glosses": [
                            "die dichterische Erfindung und die technisch-künstlerische Umsetzung eines Tanzvortrages (Ballett, Pantomime, Eiskunstlaufen usw.)"
                        ],
                        "tags": [
                            "heute"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                        "entry_id": "67126036-cdc0-3cf7-b7ee-bf37964b48d9",
                        "glosses": [
                            "von Fans auf einer Tribüne im Stadion organisierte Show mit dem Schwenken vieler Fahnen, dem Entrollen riesiger Stoffbahnen oder dem Halten farbige Schilder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45af6c5a-3201-4c87-822a-75ca90a1a1c7",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "„Sie sind mit mit hohen Kosten und vielen ehrenamtlichen Arbeitsstunden verbunden, sorgen aber jedesmal für Gänsehautmomente: Choreografien in Fußballstadien!“"
                            },
                            {
                                "example_id": "1590c454-770f-47dd-a0d8-7255d5fd8f22",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "Eine Choreografie der Kölner Fans sorgt für riesigen Ärger in Köln."
                            },
                            {
                                "example_id": "b462907b-4038-474d-97df-75214a8a40f7",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "[Eintracht Frankfurt:] „Am Mittwoch sagten die Ultras die in der Europa-League-Zwischenrunde gegen Salzburg geplante Choreografie ab, nachdem der Verband das Abbrennen von Wunderkerzen verboten hatte.“"
                            },
                            {
                                "example_id": "1c1a6d85-dcc7-4c50-bcfc-a6384e114098",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "„Eine Choreografie muss sich im Rahmen der Stadionordnung, der Gesetze und behördlichen Vorgaben sowie der Werte des 1. FC Köln bewegen.“"
                            },
                            {
                                "example_id": "95da9e3f-8604-49ca-ab60-55afb70196c2",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "„Mit einer gemeinsam initiierten, 22.240,96 Euro teuren Choreografie haben die Fans des FC Schalke und des 1. FC Nürnberg dem Spiel am Samstagabend einen außergewöhnlichen Rahmen beschert.“"
                            },
                            {
                                "example_id": "7b8d984b-6627-4267-98ff-1afa0b0dd9af",
                                "sense_id": "9a4d1b61-60fe-3531-b81b-29166a4d38c2",
                                "text": "„[…] so gab es auch beim Heimspiel gegen Standard Lüttlich eine hinreißende Choreografie in der Nordwestkurve zu bewundern.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
