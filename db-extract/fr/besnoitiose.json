                "senses": [
                    {
                        "sense_id": "b58e7b95-5346-3482-8c2f-b0d974a65fb1",
                        "entry_id": "55041174-af79-35c6-b0ee-2dce2d1ef672",
                        "glosses": [
                            "Une protozoose de la peau, des muqueuses et d'autres tissus, des animaux, surtout jeunes et en régions tropicales et sub-tropicales, avec formation de kystes."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "806710d7-6e73-4518-a59f-90cc5bf3a54a",
                                "sense_id": "b58e7b95-5346-3482-8c2f-b0d974a65fb1",
                                "text": "Ce sont probablement des mouches piqueuses qui inoculent l’infection mais la transmission peut également s’effectuer par l’intermédiaire des chats. La besnoitiose est due à un protozoaire (Besnoitia)."
                            },
                            {
                                "example_id": "dcf0b9cf-bd8c-447d-9ae0-3dc133660f7d",
                                "sense_id": "b58e7b95-5346-3482-8c2f-b0d974a65fb1",
                                "text": "Depuis plusieurs mois maintenant, la Besnoitiose (maladie transmise par les insectes piqueurs) inquiète de plus en plus le territoire français. Cette maladie jusqu'ici présente dans les Pyrénées, les Alpes du Sud et le sud du Massif central, semble avoir gagné du terrain."
                            }
                        ]
                    }
