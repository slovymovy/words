                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2202f4b0-23ef-4376-8c28-9790cc976122",
                        "source_entry_id": "27b0f246-a4e8-3b34-bbb8-6d18f8103f1a",
                        "source_sense_id": "dc1910c0-8d40-3631-9527-3dee87fde5b0",
                        "source_sense_description": "communiant",
                        "target_lang_word": "communicant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communicant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                        "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                                        "glosses": [
                                            "A person who receives (or is allowed to receive) the elements (i.e., bread and wine) of the sacrament of Holy Communion. (Compare also these terms: communion, Communion, Lord's Supper, Mass, Eucharist, Divine Liturgy.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2289333a-5bb4-40f8-aacc-16febc116726",
                                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                                "text": "1706 August 30, Francis Atterbury, a sermon preached at the funeral of Mr. Bennett\na never-failing monthly communicant"
                                            },
                                            {
                                                "example_id": "a3c1152c-e8f4-4bbc-b11c-bac85e15893a",
                                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                                "text": "Meanwhile, the lass grew up in the nurture and admonition of the Lord. I have heard Dr. Chrystal say that he never had a communicant more full of the things of the Spirit."
                                            },
                                            {
                                                "example_id": "67509cce-e54d-4972-931d-1b0de86a540a",
                                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                                "text": "The folded hands and submissive posture of the orderly line of communicants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                        "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                                        "glosses": [
                                            "One who communicates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff916ce-2107-4ef2-ae1a-b22939d3c7ef",
                                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                                "text": "Each was a messenger and communicant with a special branch of knowledge."
                                            },
                                            {
                                                "example_id": "36a89d33-593d-41b1-98be-b375949bea72",
                                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                                "text": "partakers communicant with the bodie of Christ"
                                            },
                                            {
                                                "example_id": "b9a3a236-d0e1-4db9-9008-6331f94991c8",
                                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                                "text": "These cyberforums are asynchronous; that is, contributors post (i.e., publish a text message) without the need for fellow communicants to be online at the same time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "communicant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994c10a3-dacc-3d33-b62c-d60cc8bb28d4",
                                        "entry_id": "4942484f-166a-3e91-8731-051d0d673641",
                                        "glosses": [
                                            "Communicating."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93b276c-26d9-46ff-97ee-4d38bd7b473b",
                                                "sense_id": "994c10a3-dacc-3d33-b62c-d60cc8bb28d4",
                                                "text": "The co-eternal Son of the living God, incarnate, tempted, crucified, resurgent, communicant of his spirit, ascendant, and obtaining for his church the descent of the Holy Ghost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
