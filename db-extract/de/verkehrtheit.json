                ],
                "senses": [
                    {
                        "sense_id": "fab5f5d4-d558-30fd-9326-b0083559a518",
                        "entry_id": "d20d065b-9dd8-37ea-8187-528ff80148ed",
                        "glosses": [
                            "Eigenschaft, Zustand, falsch (verkehrt) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5244d3-1621-49b8-9b96-8716b7e87ff8",
                                "sense_id": "fab5f5d4-d558-30fd-9326-b0083559a518",
                                "text": "„Vielmehr erscheint nur die menschliche Beschränktheit, Verkehrtheit und Schlechtigkeit in jedem Lande in einer andern Form, und diese nennt man den Nationalcharakter.“"
                            },
                            {
                                "example_id": "3be6c95f-8294-4ae7-9596-4c1d06fa6bb6",
                                "sense_id": "fab5f5d4-d558-30fd-9326-b0083559a518",
                                "text": "„Mitunter will einem die Verkehrtheit des Denkens noch absurder vorkommen als das Fallen aus aller Moral.“"
                            },
                            {
                                "example_id": "8e241561-93e7-4317-bb77-d06c5e4be0e7",
                                "sense_id": "fab5f5d4-d558-30fd-9326-b0083559a518",
                                "text": "„Deren Ziel war es, die ‚Verkehrtheiten der Zeit, insbesondere aus dem Gebiet der vaterländischen Politik‘ anzuprangern.“"
                            },
                            {
                                "example_id": "4409aa53-9533-4cb4-9c14-b91b551b0766",
                                "sense_id": "fab5f5d4-d558-30fd-9326-b0083559a518",
                                "text": "„Was Lüge und was Krieg ist, das kann man ihnen kaum erklären, denn diese Verkehrtheiten sind ihnen vollständig fremd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
