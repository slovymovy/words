                    {
                        "sense_id": "0496d3dd-b7ea-393e-bae2-44e5defdafe7",
                        "entry_id": "6844f88b-70e3-3aa6-827c-370d76842f3b",
                        "glosses": [
                            "Sprache, die in Malawi (Amtssprache dort), Mosambik, Sambia und Simbabwe gesprochen wird"
