                "senses": [
                    {
                        "sense_id": "7597ba54-b35b-36d5-9b9d-e97eda28d829",
                        "entry_id": "0a83ba5c-23ad-3064-ae66-60f8c53767eb",
                        "glosses": [
                            "Remettre en état un objet qui s’est une nouvelle fois tordu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78538fa3-3fe9-448d-a24e-d7ccf266c1f7",
                                "sense_id": "7597ba54-b35b-36d5-9b9d-e97eda28d829",
                                "text": "Inutile de redétordre cette fourchette en permanence ! De toutes façons, elle n’est pas solide."
                            },
                            {
                                "example_id": "2682dc91-ebb4-4738-b42b-44f968550dda",
                                "sense_id": "7597ba54-b35b-36d5-9b9d-e97eda28d829",
                                "text": "À force de tordre, détordre, retordre et redétordre la carrosserie, elle a fini par rouiller."
                            }
                        ]
                    }
