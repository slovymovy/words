                                    {
                                        "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                        "entry_id": "b08705ee-be19-393d-a652-d3626a212d01",
                                        "glosses": [
                                            "eine Menge, die nur Elemente einer anderen Menge enthält"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169eefb2-9f30-4290-bada-4012bbc65a26",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "Jede Menge hat die leere Menge zur Teilmenge."
                                            },
                                            {
                                                "example_id": "d2a8e135-c3c5-479c-bca4-90733fd46654",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "Die Teilmenge der Schüler dieser Klasse, die ihre Mathematikaufgaben richtig gelöst haben, die kann ich an den Fingern einer Hand abzählen."
                                            },
                                            {
                                                "example_id": "c0c488cd-2792-41ac-b2dd-21e64b343118",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "„Teilmengen achronaler Mengen sind achronal.“"
                                            },
                                            {
                                                "example_id": "3ae997df-e6b1-428c-b49f-be70379db93e",
                                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                                "text": "„Bei unendlichen Mengen ist es aber möglich, dass eine echte Teilmenge dieselbe Mächtigkeit hat wie ihre Grundmenge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
