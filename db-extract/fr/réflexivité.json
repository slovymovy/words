                                        "sense_id": "c69e8d87-cc42-3127-baa4-c7f3f2fd117e",
                                        "entry_id": "13bb2da3-979c-3fc9-b67e-5c8277b6eb39",
                                        "glosses": [
                                            "The quality of being reflectable; able to be reflected."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a72a47f-d8b4-4d36-b850-88cf26ae2b0f",
                                                "sense_id": "c69e8d87-cc42-3127-baa4-c7f3f2fd117e",
                                                "text": "Night time results, for example, in an increase in reflectability, which is why a distant AM commercial broadcast station can often be heard at night but not by day."
                                            },
                                            {
                                                "example_id": "2b50d736-56e3-4fee-bc87-ec6f273175bc",
                                                "sense_id": "c69e8d87-cc42-3127-baa4-c7f3f2fd117e",
                                                "text": "Such questions as his attitude to garlic and crosses, and his reflectability in mirrors, simply never arise — but he does eventually acquire the power to manifest himself by day."
                                            },
                                            {
                                                "example_id": "d20a7518-2db5-4b2f-9aaa-af91b0829434",
                                                "sense_id": "c69e8d87-cc42-3127-baa4-c7f3f2fd117e",
                                                "text": "Second, ultrasonic data obtained with the high frequency SAM can be used for assessing reflectability or texture in clinical echographic imaging."
                                            }
                                        ]
                                    }
                                ]
