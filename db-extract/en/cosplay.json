                                                "text": "Coloration du Dessin de \"Lily se Cosplaye\"."
                                            },
                                            {
                                                "example_id": "cf40c629-cc5f-42dc-84cc-00221dc9e4ff",
                                                "sense_id": "f60ae8da-5932-3fef-87ac-0b879b36596d",
