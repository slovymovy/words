                "senses": [
                    {
                        "sense_id": "4b88cea9-7fd7-3e40-afe4-f6c24be7e48b",
                        "entry_id": "386d1989-5185-3745-ab19-cbd874005fc1",
                        "glosses": [
                            "przywiezienie, dostarczenie czegoś albo kogoś do celu; ogół czynności z tym związanych"
                        ],
                        "tags": [
                            "also"
                        ],
                        "examples": [
                            {
                                "example_id": "1407e188-bfdf-4efb-8d12-5a3affe6ac40",
                                "sense_id": "4b88cea9-7fd7-3e40-afe4-f6c24be7e48b",
                                "text": "Przemysł krajowy zaspokajał potrzeby armii tylko częściowo. Dowóz sprzętu bojowego z zachodu mógł odbywać się jedynie przez Murmańsk i Archangielsk i to z wyłączeniem zimy, gdy zamarzały wody okalające oba porty."
                            },
                            {
                                "example_id": "f238f6f4-51dc-4858-8668-88ea6d109413",
                                "sense_id": "4b88cea9-7fd7-3e40-afe4-f6c24be7e48b",
                                "text": "Po locie z Gdańska czekał nas będzie bezpieczny dowóz autobusem do miejsca zakwaterowania."
                            }
                        ],
