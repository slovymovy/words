{
    "word_family": [
        "grinder",
        "grindstone"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cba6e858-da9a-37ae-b5dd-486bfa370268",
                    "sense_definition": "Present participle and gerund of <w>grind</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>grinding</w> the coffee beans for breakfast.",
                            "target_lang_translations": {
                                "ru": "Он <w>мелет</w> кофейные зерна на завтрак.",
                                "pl": "On <w>mieli</w> ziarna kawy na śniadanie."
                            }
                        },
                        {
                            "text": "The gears were <w>grinding</w> loudly because of the lack of oil.",
                            "target_lang_translations": {
                                "ru": "Шестерни громко <w>скрежетали</w> из-за нехватки масла.",
                                "pl": "Przekładnie głośno <w>zgrzytały</w> z powodu braku oleju."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола grind.",
                        "pl": "Imiesłów czynny lub rzeczownik odczasownikowy od czasownika 'grind' (mielić, trzeć)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоть",
                                "target_lang_sense_clarification": "измельчать что-либо твердое"
                            },
                            {
                                "target_lang_word": "скрежетать",
                                "target_lang_sense_clarification": "издавать резкий звук трения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mielenie",
                                "target_lang_sense_clarification": "proces rozdrabniania czegoś na drobne cząstki"
                            },
                            {
                                "target_lang_word": "zgrzytanie",
                                "target_lang_sense_clarification": "wydawanie ostrego dźwięku tarcia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f24f450a-b23c-3064-8203-653cf3485bee",
                    "sense_definition": "Relentlessly taxing, oppressive, or exhausting, often describing poverty or difficult work.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "oppressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families in the region struggle to survive amidst <w>grinding</w> poverty.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в регионе борются за выживание в условиях <w>беспросветной</w> нищеты.",
                                "pl": "Wiele rodzin w regionie walczy o przetrwanie w obliczu <w>wyniszczającej</w> biedy."
                            }
                        },
                        {
                            "text": "After years of <w>grinding</w> toil, he finally saved enough money to retire.",
                            "target_lang_translations": {
                                "ru": "После многих лет <w>изнурительного</w> труда он наконец скопил достаточно денег, чтобы уйти на пенсию.",
                                "pl": "Po latach <w>morderczej</w> pracy w końcu zaoszczędził wystarczająco dużo pieniędzy, by przejść na emeryturę."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppressive",
                        "burdensome",
                        "crushing",
                        "exhausting"
                    ],
                    "antonyms": [
                        "effortless",
                        "easy"
                    ],
                    "common_phrases": [
                        "grinding poverty",
                        "grinding toil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывно изматывающий, угнетающий или изнурительный; часто описывает бедность или тяжелую работу.",
                        "pl": "Nieustannie wyczerpujący, przytłaczający lub męczący; często opisuje biedę lub ciężką pracę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнурительный",
                                "target_lang_sense_clarification": "о тяжелом труде или работе"
                            },
                            {
                                "target_lang_word": "беспросветный",
                                "target_lang_sense_clarification": "о крайней бедности или нужде"
                            },
                            {
                                "target_lang_word": "угнетающий",
                                "target_lang_sense_clarification": "давящий морально или физически"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyniszczający",
                                "target_lang_sense_clarification": "o bardzo ciężkiej pracy lub warunkach"
                            },
                            {
                                "target_lang_word": "beznadziejny",
                                "target_lang_sense_clarification": "o skrajnej biedzie"
                            },
                            {
                                "target_lang_word": "przytłaczający",
                                "target_lang_sense_clarification": "o ciężarze psychicznym lub fizycznym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd319183-f0f5-398c-9d76-51d38be54cd3",
                    "sense_definition": "Producing a harsh, grating sound caused by friction, or describing a motion characterized by heavy friction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project came to a <w>grinding</w> halt when the funding was cut.",
                            "target_lang_translations": {
                                "ru": "Проект <w>со скрежетом</w> остановился, когда финансирование было урезано.",
                                "pl": "Projekt <w>zatrzymał się z wielkim zgrzytem</w>, gdy obcięto finansowanie."
                            }
                        },
                        {
                            "text": "We heard a loud <w>grinding</w> noise coming from the engine.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>скрежещущий</w> звук, доносящийся из двигателя.",
                                "pl": "Usłyszeliśmy głośny <w>zgrzytliwy</w> dźwięk dobiegający z silnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "grating",
                        "rasping",
                        "scraping"
                    ],
                    "antonyms": [
                        "smooth",
                        "silent"
                    ],
                    "common_phrases": [
                        "grinding halt",
                        "grinding noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий резкий, скрежещущий звук из-за трения или описывающий движение с сильным сопротивлением.",
                        "pl": "Wydający ostry, zgrzytliwy dźwięk spowodowany tarciem lub opisujący ruch z dużym oporem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежещущий",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о звуке или остановке"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zgrzytliwy",
                                "target_lang_sense_clarification": "o dźwięku"
                            },
                            {
                                "target_lang_word": "trący",
                                "target_lang_sense_clarification": "o ruchu z oporem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8aca0e76-6b00-38ff-bdab-189bf51a629c",
                    "sense_definition": "The action of crushing something into small particles or the harsh sound produced by friction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grinding</w> of the millstones could be heard from far away.",
                            "target_lang_translations": {
                                "ru": "<w>Скрежет</w> жерновов был слышен издалека.",
                                "pl": "<w>Zgrzyt</w> kamieni młyńskich był słyszalny z daleka."
                            }
                        },
                        {
                            "text": "Constant <w>grinding</w> of teeth during sleep can lead to dental problems.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>скрежет</w> зубами во сне может привести к проблемам с зубами.",
                                "pl": "Ciągłe <w>zgrzytanie</w> zębami podczas snu może prowadzić do problemów stomatologicznych."
                            }
                        }
                    ],
                    "synonyms": [
                        "crushing",
                        "pulverization",
                        "grating"
                    ],
                    "common_phrases": [
                        "teeth grinding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по раздавливанию чего-либо на мелкие частицы или резкий звук, производимый трением.",
                        "pl": "Czynność rozdrabniania czegoś na małe cząstki lub ostry dźwięk wytwarzany przez tarcie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежет",
                                "target_lang_sense_clarification": "резкий звук"
                            },
                            {
                                "target_lang_word": "перемалывание",
                                "target_lang_sense_clarification": "процесс измельчения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zgrzyt",
                                "target_lang_sense_clarification": "ostry dźwięk"
                            },
                            {
                                "target_lang_word": "mielenie",
                                "target_lang_sense_clarification": "proces rozdrabniania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7335f8e9-e38e-3d7b-b473-58fb86c6c918",
                    "sense_definition": "The repetitive performance of tasks in a video game to gain experience points, currency, or items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "repetitive_task",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole weekend doing <w>grinding</w> to level up his character.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные за <w>гриндингом</w>, чтобы повысить уровень своего персонажа.",
                                "pl": "Spędził cały weekend na <w>grindowaniu</w>, aby podnieść poziom swojej postaci."
                            }
                        },
                        {
                            "text": "Most players find the <w>grinding</w> boring, but it is necessary to unlock the best gear.",
                            "target_lang_translations": {
                                "ru": "Большинство игроков находят <w>фарм</w> скучным, но он необходим для получения лучшего снаряжения.",
                                "pl": "Większość graczy uważa <w>farmienie</w> za nudne, ale jest ono konieczne, aby odblokować najlepszy ekwipunek."
                            }
                        }
                    ],
                    "synonyms": [
                        "farming"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монотонное выполнение однотипных задач в видеоигре для получения очков опыта, валюты или предметов.",
                        "pl": "Powtarzalne wykonywanie zadań w grze wideo w celu zdobycia punktów doświadczenia, waluty lub przedmiotów."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гриндинг",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "фарм",
                                "target_lang_sense_clarification": "сбор ресурсов в играх"
                            },
                            {
                                "target_lang_word": "прокачка",
                                "target_lang_sense_clarification": "развитие персонажа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "grindowanie",
                                "target_lang_sense_clarification": "slang graczy"
                            },
                            {
                                "target_lang_word": "farmienie",
                                "target_lang_sense_clarification": "zbieranie zasobów w grach"
                            },
                            {
                                "target_lang_word": "prokacja",
                                "target_lang_sense_clarification": "rozwój postaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8674069-3489-3353-bda2-d59a51940843",
                    "sense_definition": "The industrial process of smoothing, sharpening, or shaping a material by friction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "friction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Precision <w>grinding</w> is required to manufacture these delicate lenses.",
                            "target_lang_translations": {
                                "ru": "Для изготовления этих хрупких линз требуется точная <w>шлифовка</w>.",
                                "pl": "Do produkcji tych delikatnych soczewek wymagane jest precyzyjne <w>szlifowanie</w>."
                            }
                        },
                        {
                            "text": "The factory specializes in the <w>grinding</w> of steel parts for automotive engines.",
                            "target_lang_translations": {
                                "ru": "Завод специализируется на <w>шлифовке</w> стальных деталей для автомобильных двигателей.",
                                "pl": "Fabryka specjalizuje się w <w>szlifowaniu</w> stalowych części do silników samochodowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "polishing",
                        "abrasion",
                        "sanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Промышленный процесс сглаживания, заточки или придания формы материалу с помощью трения.",
                        "pl": "Proces przemysłowy wygładzania, ostrzenia lub nadawania kształtu materiałowi poprzez tarcie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлифовка",
                                "target_lang_sense_clarification": "обработка поверхности"
                            },
                            {
                                "target_lang_word": "заточка",
                                "target_lang_sense_clarification": "заострение инструмента"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szlifowanie",
                                "target_lang_sense_clarification": "obróbka powierzchni"
                            },
                            {
                                "target_lang_word": "ostrzenie",
                                "target_lang_sense_clarification": "nadawanie ostrości narzędziom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24a89421-5268-382e-b4f2-718b30717511",
                    "sense_definition": "A style of dancing in which two people rub their bodies closely together.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school administration banned <w>grinding</w> at the prom due to its suggestive nature.",
                            "target_lang_translations": {
                                "ru": "Администрация школы запретила <w>грязные танцы</w> на выпускном из-за их непристойного характера.",
                                "pl": "Administracja szkoły zakazała <w>ocierania się w tańcu</w> na balu maturalnym ze względu na jego sugestywny charakter."
                            }
                        },
                        {
                            "text": "They were kicked out of the club for inappropriate <w>grinding</w> on the dance floor.",
                            "target_lang_translations": {
                                "ru": "Их выгнали из клуба за неподобающие <w>зажимания</w> на танцполе.",
                                "pl": "Zostali wyrzuceni z klubu za niestosowne <w>ocieranie się</w> na parkiecie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль танца, при котором партнеры тесно прижимаются и трутся телами друг о друга.",
                        "pl": "Styl tańca, w którym dwie osoby ocierają się o siebie ciałami w bliskim kontakcie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязные танцы",
                                "target_lang_sense_clarification": "идиоматическое выражение"
                            },
                            {
                                "target_lang_word": "зажимания",
                                "target_lang_sense_clarification": "разговорное, о тесном контакте"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "taniec erotyczny",
                                "target_lang_sense_clarification": "opisowy"
                            },
                            {
                                "target_lang_word": "ocieranie się",
                                "target_lang_sense_clarification": "potoczne określenie ruchu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}