                        "source_sense_id": "ce53d4e3-b24c-3b5b-a935-85bb260fd993",
                        "source_sense_description": "Bergwerk, in dem Kohle abgebaut wird",
                        "target_lang_word": "mine de charbon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mine de charbon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb135a3-c31e-3eda-ab7b-7016d75bebe4",
                                        "entry_id": "5280c26a-3738-35d4-b6a6-114e0e99e5da",
                                        "glosses": [
                                            "Lieu d’extraction du charbon."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dbf169f-5c7c-4f8d-b4b2-d3424a69d25a",
                                                "sense_id": "9fb135a3-c31e-3eda-ab7b-7016d75bebe4",
                                                "text": "Après la fermeture de la dernière mine de charbon du pays, à Kellingley, dans le Yorkshire, vendredi, […]"
                                            },
                                            {
                                                "example_id": "6d3fd5de-83d9-4977-8708-5fbfb5eaf937",
                                                "sense_id": "9fb135a3-c31e-3eda-ab7b-7016d75bebe4",
                                                "text": "Ce type d'épidémie est comme «un canari dans la mine de charbon de la crise climatique», a-t-il dit en évoquant la métaphore du petit oiseau qui alerte d'un grand danger."
                                            },
                                            {
                                                "example_id": "23bf7e9a-b4d4-4bca-8270-7419fe1321a5",
                                                "sense_id": "9fb135a3-c31e-3eda-ab7b-7016d75bebe4",
                                                "text": "Il y avait aussi là-bas des mines de charbon, du charbon à fleur de roche, qui vaudrait de l’or, lorsque le pays se couvrirait d’usines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf5c3462-75ec-32f4-ab4e-4a3c0ec3acea",
                                        "entry_id": "5280c26a-3738-35d4-b6a6-114e0e99e5da",
                                        "glosses": [
                                            "Outil de dessin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655bc975-2fb3-4b5b-8762-189bcf54ac73",
                                                "sense_id": "cf5c3462-75ec-32f4-ab4e-4a3c0ec3acea",
                                                "text": "Il dessine au crayon mine de charbon, ses camarades mécaniciens et pilotes, endormis ou en corvées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
