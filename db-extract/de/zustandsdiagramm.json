                        "form": "das Zustandsdiagramm"
                    },
                    {
                        "form_id": "bdd9f164-3d12-4a49-ade5-bcbbf4cbdf06",
                        "entry_id": "95412bda-95f6-3268-95da-a0fd1e4afcf6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zustandsdiagramme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0f6d63a-89b5-3ab7-927a-268ad8001fb8",
                        "entry_id": "95412bda-95f6-3268-95da-a0fd1e4afcf6",
                        "glosses": [
                            "Darstellung der „Zustände und deren zugehörigen Phasen in Abhängigkeit von Zustandsgrößen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3a4725-026a-4df2-bdeb-69441b40f8ec",
                                "sense_id": "f0f6d63a-89b5-3ab7-927a-268ad8001fb8",
                                "text": "„Das Zustandsdiagramm des Systems Fe–Al ist trotz zahlreicher Unterss. noch nicht in allen Konzentrationsbereichen mit hinreichender Sicherheit ermittelt worden.“"
                            },
                            {
                                "example_id": "a483f5ac-6bee-47bd-8aa4-b2ff2083d6dd",
                                "sense_id": "f0f6d63a-89b5-3ab7-927a-268ad8001fb8",
                                "text": "„Festkörperplasmen sind unterschiedlichen Bereichen im Zustandsdiagramm zuzuordnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3887174-9775-308d-a968-203fd1f53353",
                        "entry_id": "95412bda-95f6-3268-95da-a0fd1e4afcf6",
                        "glosses": [
                            "graphische Gegenüberstellung des Spektraltyps gegenüber der absoluten Helligkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b893fb29-e926-4937-99ac-c791606936ef",
                                "sense_id": "f3887174-9775-308d-a968-203fd1f53353",
                                "text": "„Auf solche Weise entsteht im Zustandsdiagramm ein Entwicklungsweg.“"
                            },
                            {
                                "example_id": "e53dd4c9-23da-4d06-9278-602634afa993",
                                "sense_id": "f3887174-9775-308d-a968-203fd1f53353",
                                "text": "„Sehr dichte Sternsysteme wie Kugelhaufen und Zentralgebiete von Spiralnebeln zeigen ein wesentlich anderes Zustandsdiagramm; […]“"
                            },
                            {
                                "example_id": "f7bd3311-277e-456c-a149-adfb4a05403c",
                                "sense_id": "f3887174-9775-308d-a968-203fd1f53353",
                                "text": "„Das HRD ist ein zweidimensionales Zustandsdiagramm der Astrophysik, das zu Beginn des 20. Jahrhunderts unabhängig voneinander von Ejnar Hertzsprung und Henry Norris Russell entwickelt wurde.“"
                            },
                            {
                                "example_id": "8904cb53-35f9-4cfe-834e-90d2ff047b7e",
                                "sense_id": "f3887174-9775-308d-a968-203fd1f53353",
                                "text": "„Man kann beobachten, daß der Stern sich auf einem komplizierten und verschlungenem Weg durch das Zustandsdiagramm bewegt, während er dauernd seine Größe und seine Oberflächentemperatur verändert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dd108cd9-f1f4-3248-a5b9-75846a9aa822",
                        "entry_id": "95412bda-95f6-3268-95da-a0fd1e4afcf6",
                        "glosses": [
                            "Beschreibung der Zustände einer Maschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183dd8a7-0efd-4b08-8fa6-dff60cba1842",
                                "sense_id": "dd108cd9-f1f4-3248-a5b9-75846a9aa822",
                                "text": "„Eine Möglichkeit, ein Zustandsdiagramm zu charakterisieren, ist zu sagen, dass seine Objekte ihren Zustand als Reaktion auf Ereignisse und Zeitablauf ändern.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
