                                "target_senses": [
                                    {
                                        "sense_id": "6cfb4519-a3fa-31fd-8832-d37b8c97e01e",
                                        "entry_id": "174a9b0f-27e8-349e-89f4-f021a58fd27f",
                                        "glosses": [
                                            "zdroj energie, síly pro pohyb"
                                        ],
                                        "tags": [
                                            "stroje",
                                            "mechanismu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8b6572-b766-46a5-8c84-ecff2e52f7c9",
                                                "sense_id": "6cfb4519-a3fa-31fd-8832-d37b8c97e01e",
                                                "text": "Již za několik dní bude v Howaldtově loděnici spuštěna na vodu dokonce loď s dieselelektrickým pohonem, a jak lze již nyní hádat, ponese jméno Roberta Leye."
                                            },
                                            {
                                                "example_id": "f872358d-db4b-4408-b3b3-6e87c6ad50df",
                                                "sense_id": "6cfb4519-a3fa-31fd-8832-d37b8c97e01e",
                                                "text": "Po desetiletí sloužila Laboratoř pro výzkum tryskového pohonu za velitelské středisko pro americké družice, které fotografovaly Jupiter a prstence Saturnu a vysílaly snímky na zem jako videozáznam."
                                            },
                                            {
                                                "example_id": "1dfc96d2-de6c-455b-9fc7-4663d19fecea",
                                                "sense_id": "6cfb4519-a3fa-31fd-8832-d37b8c97e01e",
                                                "text": "Popisuje se v něm náš pařížský pobyt a klade otázka hnací síly pro zdlouhavou práci na románu, která je zodpovězena takto: „Nejspolehlivějším pohonem byl asi můj maloměšťácký původ, ono zapšklé, přerušeným gymnaziálním vzděláním — skončil jsem v kvintě — umocněné velikášství, které chce předvést něco nepřehlédnutelného.“"
                                            }
                                        ]
                                    }
                                ]
