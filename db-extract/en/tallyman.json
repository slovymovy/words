                        "entry_id": "b2d3b4d9-a659-3c43-ab85-5c04f8f1160a",
                        "glosses": [
                            "A man who cohabits (with someone) outside of marriage."
                        ],
                        "tags": [
                            "archaic",
                            "informal",
                            "regional"
                        ],
                        "examples": [
                            {
