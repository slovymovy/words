{
    "word_family": [
        "préparation",
        "préparateur",
        "préparatrice",
        "préparatoire",
        "préparatif",
        "impréparation",
        "impréparé"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "878f1c98-96e9-3332-bde2-597e837eded0",
                    "sense_definition": "Apprêter quelque chose, le mettre en état d'être utilisé ou consommé, surtout en cuisinant un plat ou en fabriquant un produit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "préparation matérielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soir, je <w>prépare</w> un gâteau au chocolat pour l'anniversaire de ma fille."
                        },
                        {
                            "text": "Si vous <w>préparez</w> la crème anglaise la veille, elle sera plus savoureuse."
                        }
                    ],
                    "synonyms": [
                        "apprêter",
                        "confectionner"
                    ],
                    "common_phrases": [
                        "préparer le dîner",
                        "préparer un repas",
                        "préparer un gâteau"
                    ]
                },
                {
                    "sense_id": "cc1e53de-d0d3-39ef-b405-79327e1065ec",
                    "sense_definition": "Faire à l'avance ce qu'il faut pour que quelque chose soit prêt ou puisse avoir lieu, par exemple un voyage, une fête ou ses affaires.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "préparation matérielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>préparons</w> notre voyage en Italie depuis plusieurs semaines."
                        },
                        {
                            "text": "Elle a <w>préparé</w> ses valises avant de partir pour la gare."
                        }
                    ],
                    "synonyms": [
                        "organiser"
                    ],
                    "common_phrases": [
                        "préparer un voyage",
                        "préparer ses valises",
                        "préparer une fête"
                    ]
                },
                {
                    "sense_id": "dafcc561-1a9b-3e5e-a560-35ccc0d556b3",
                    "sense_definition": "Travailler pour se mettre en état de réussir une épreuve, un examen, un concours ou une compétition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "préparation intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>prépare</w> mon examen de français depuis le mois de janvier."
                        },
                        {
                            "text": "Mon frère <w>prépare</w> le concours d'entrée à une école d'ingénieurs."
                        },
                        {
                            "text": "Les joueurs se <w>préparent</w> pour le match de demain soir."
                        }
                    ],
                    "common_phrases": [
                        "préparer un examen",
                        "préparer un concours",
                        "se préparer pour un match"
                    ]
                },
                {
                    "sense_id": "9d14edd1-4fcb-3e86-8b3b-3a7df9c0e64f",
                    "sense_definition": "Réfléchir à l'avance à ce que l'on va dire ou faire et l'organiser dans son esprit ou par écrit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "préparation intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur <w>prépare</w> son discours pour la réunion de demain matin."
                        },
                        {
                            "text": "L'étudiante a bien <w>préparé</w> son exposé sur la Révolution française."
                        }
                    ],
                    "synonyms": [
                        "élaborer"
                    ],
                    "antonyms": [
                        "improviser"
                    ],
                    "common_phrases": [
                        "préparer un discours",
                        "préparer un exposé",
                        "préparer une réunion"
                    ]
                },
                {
                    "sense_id": "c13a4ff4-0d52-30ea-b449-60a27537aa10",
                    "sense_definition": "Mettre une personne dans les dispositions nécessaires pour atteindre un but ou faire face à quelque chose ; au pronominal, s'apprêter à quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "préparation des personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>prépare</w> ses élèves à l'examen final avec beaucoup de patience."
                        },
                        {
                            "text": "Nous nous <w>préparons</w> à une longue journée de travail."
                        },
                        {
                            "text": "Le ministre a <w>préparé</w> les esprits à cette réforme importante."
                        }
                    ],
                    "synonyms": [
                        "disposer"
                    ],
                    "common_phrases": [
                        "préparer les esprits",
                        "se préparer à"
                    ]
                },
                {
                    "sense_id": "9257572c-1238-3170-8e9f-f1581c6129be",
                    "sense_definition": "Mettre en place les causes ou les conditions qui produiront plus tard certains effets, souvent des événements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "préparation des effets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses amis lui <w>préparent</w> une grande surprise pour son anniversaire."
                        },
                        {
                            "text": "Une révolution se <w>prépare</w> alors dans le pays."
                        }
                    ],
                    "common_phrases": [
                        "préparer une surprise",
                        "préparer l'avenir"
                    ]
                },
                {
                    "sense_id": "a8d5eb45-c9c0-381c-b9fa-78426d9330f3",
                    "sense_definition": "Parler à quelqu'un avec ménagement pour le disposer à apprendre une nouvelle pénible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "préparation des personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû <w>préparer</w> sa mère avec douceur avant de lui annoncer la mauvaise nouvelle."
                        },
                        {
                            "text": "Le médecin <w>prépare</w> la famille avant de donner les résultats de l'analyse."
                        }
                    ]
                },
                {
                    "sense_id": "dcb3fb3a-4c36-390f-b983-46f38dfe2530",
                    "sense_definition": "Soumettre un malade à un certain régime ou à certains soins en vue d'une opération chirurgicale ou d'un traitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "préparation des personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière <w>prépare</w> le patient avant l'opération chirurgicale prévue ce matin."
                        },
                        {
                            "text": "On <w>prépare</w> le malade à l'intervention par un régime strict de plusieurs jours."
                        }
                    ],
                    "common_phrases": [
                        "préparer un malade",
                        "préparer un patient"
                    ]
                },
                {
                    "sense_id": "8a4cc897-dca8-37cc-a796-4faeec5a333d",
                    "sense_definition": "Faire précéder une chose de précautions ou d'éléments introductifs pour en assurer l'effet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "préparation des effets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musicien <w>prépare</w> avec soin ses dissonances avant de les résoudre."
                        },
                        {
                            "text": "Il faut <w>préparer</w> cette annonce pour qu'elle produise tout son effet sur le public."
                        }
                    ]
                }
            ]
        }
    ]
}