                        ],
                        "form": "sympatyki"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d7567e1-8014-390d-99bf-0c36570e3a08",
                        "entry_id": "691c5ce4-e7ba-3705-a62e-33875e151f11",
                        "glosses": [
                            "osoba, która z czymś lub z kimś sympatyzuje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e884db2-fae5-47cb-8882-e138c30b46bb",
                                "sense_id": "3d7567e1-8014-390d-99bf-0c36570e3a08",
                                "text": "W ciągu ostatniego tygodnia nastąpił gigantyczny atak ze strony zarówno mediów prawicowych, sympatyków prawicy, trolli z farmy, posłów prawicy, jak i europosłów z prawicy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0f0ee56-5006-4ad1-8a0b-b8a166f407b0",
                        "source_entry_id": "691c5ce4-e7ba-3705-a62e-33875e151f11",
                        "source_sense_id": "3d7567e1-8014-390d-99bf-0c36570e3a08",
                        "target_lang_word": "sympathizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sympathizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c13fa7a-9832-3be8-baac-6e1986d864ec",
                                        "entry_id": "b2935e9c-71f9-3756-867a-3e07175aafaa",
                                        "glosses": [
                                            "A person who sympathizes (with a political cause, a side in a conflict, etc.); a supporter."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf94baf-e74e-4a1d-94fc-cdf95edc1064",
                                                "sense_id": "5c13fa7a-9832-3be8-baac-6e1986d864ec",
                                                "text": "His reputation was ruined when it was revealed that he had been a Nazi sympathizer before the war."
                                            },
                                            {
                                                "example_id": "58cba0d6-33dc-4dd9-a66c-07e8ed511cbc",
                                                "sense_id": "5c13fa7a-9832-3be8-baac-6e1986d864ec",
                                                "text": "[…] she exposed herself to the fury of the sympathizers with slavery, without fear, and suffered their blows without flinching."
                                            },
                                            {
                                                "example_id": "abe3fc9d-9281-4ea6-a444-d55b0dc44693",
                                                "sense_id": "5c13fa7a-9832-3be8-baac-6e1986d864ec",
                                                "text": "‘[…] And I tell you that the slightest suspicion of my loyalty could be ruin for me, ruin! If it were ever breathed that I were even a sympathiser with this rebellion, there iss an end of me.’"
                                            },
                                            {
                                                "example_id": "b8c39fe7-e532-4266-94c6-bd29a25d2ce2",
                                                "sense_id": "5c13fa7a-9832-3be8-baac-6e1986d864ec",
                                                "text": "The Ardent Spirit pupils now belong to him alone and through them he’ll set his plans in motion, moulding them to be warrior saints, brilliant in deceit against the West and its sympathisers here at home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b5d2aff-1732-362d-b431-915d6ba4c9ae",
                                        "entry_id": "b2935e9c-71f9-3756-867a-3e07175aafaa",
                                        "glosses": [
                                            "A person who has, shows or expresses sympathy (with another person or people); a person who enters into the feelings of another."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64962634-56cf-47bc-b83e-06ef70eaa1d3",
                                                "sense_id": "8b5d2aff-1732-362d-b431-915d6ba4c9ae",
                                                "text": "[…] it is a sad case when the truly godly, who are cordial sympathizers, and earnest intercessours in the straits of a Nation, are stricken dumb in a day of calamity […]"
                                            },
                                            {
                                                "example_id": "5d24941a-3931-4324-9e57-55c8abe818d5",
                                                "sense_id": "8b5d2aff-1732-362d-b431-915d6ba4c9ae",
                                                "text": "[…] I am a sympathizer in every part of thy distress, except (and yet it is cruel to say it) in That which arises from thy guilt."
                                            },
                                            {
                                                "example_id": "e8de41c2-6cb8-48f8-a765-8526633adaef",
                                                "sense_id": "8b5d2aff-1732-362d-b431-915d6ba4c9ae",
                                                "text": "Not a mood of his but what found a ready sympathiser in Margaret; not a wish of his that she did not strive to forecast, and to fulfil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c87e9b9c-2fc6-47ca-854e-b87e47e111b1",
                        "source_entry_id": "691c5ce4-e7ba-3705-a62e-33875e151f11",
