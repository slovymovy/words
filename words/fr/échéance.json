    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbc587b5-702b-3449-8e9a-3cfd29be4aaf",
                    "sense_definition": "Date ou moment auquel expire un délai fixé, où un projet ou un engagement prend fin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "delai",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat de location arrive à <w>échéance</w> à la fin de ce mois."
                        },
                        {
                            "text": "Nous devons impérativement respecter cette <w>échéance</w> pour livrer le projet dans les temps."
                        }
                    ],
                    "synonyms": [
                        "date limite",
                        "terme"
                    ],
                    "common_phrases": [
                        "arriver à échéance",
                        "respecter une échéance"
                    ]
                },
                {
                    "sense_id": "d9caf6ba-b1d3-34e5-a507-c448d6a80fde",
                    "sense_definition": "Date précise à laquelle une dette financière ou une somme due doit être remboursée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>échéance</w> du prêt immobilier est fixée au cinq de chaque mois."
                        },
                        {
                            "text": "Le commerçant a demandé à repousser une <w>échéance</w> auprès de son banquier."
                        }
                    ],
                    "synonyms": [
                        "terme"
                    ],
                    "common_phrases": [
                        "repousser une échéance"
                    ]
                },
                {
                    "sense_id": "1e11d35c-7712-312b-8083-ba9514be9580",
                    "sense_definition": "Somme d'argent ou mensualité devant être réglée à une date convenue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a réussi à payer une <w>échéance</w> malgré ses difficultés financières actuelles."
                        },
                        {
                            "text": "Après avoir réglé cette lourde <w>échéance</w>, ils n'avaient presque plus rien sur leur compte."
                        }
                    ],
                    "synonyms": [
                        "mensualité",
                        "traite"
                    ],
                    "common_phrases": [
                        "lourde échéance",
                        "payer une échéance"
                    ]
                },
                {
                    "sense_id": "faec0251-d783-3542-b632-349cba03d2f5",
                    "sense_definition": "Horizon ou perspective temporelle dans laquelle s'inscrit un projet ou une prévision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delai",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À courte <w>échéance</w>, cette nouvelle politique pourrait provoquer quelques perturbations."
                        },
                        {
                            "text": "À longue <w>échéance</w>, la transition écologique reste indispensable pour le pays."
                        }
                    ],
                    "synonyms": [
                        "horizon",
                        "terme"
                    ],
                    "common_phrases": [
                        "à courte échéance",
                        "à longue échéance"
                    ]
                }
            ]
        }
    ]
}