                        "entry_id": "97b8d81b-0a22-3a35-a485-f6b0b659f875",
                        "glosses": [
                            "Any process that causes the color of a compound to change."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a01fd6b0-18ec-47ad-b896-817fb8033fff",
                                "sense_id": "00d0d975-fcaa-32ba-a640-11498778c0f9",
                                "text": "By adding mechanical stresses to the crystalline sample, regular structures disappeared, followed by luminescent chromism from orange to yellow."
                            },
                            {
                                "example_id": "df16190c-11d5-4471-bbdd-38f517992cf5",
                                "sense_id": "00d0d975-fcaa-32ba-a640-11498778c0f9",
                                "text": "There are different types of chromism such as photochromism (induced by sunlight or UV rays), thermochromism (induced by changes in temperature), solvato chromism (induced by polarity of the solvent), hygrochromism (induced by moisture), ionochromism (induced by ions), halochromism (induced by pH value), acido chromism (induced by acids), chemochromism (induced by specifice chemical agents like dangerous gases, warfare agents, etc.) electrochromism (induced by electricity), piezochromism (induced by pressure), mechanochromism (induced by deformation of substances)."
                            }
                        ]
                    }
