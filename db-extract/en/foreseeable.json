                                "target_senses": [
                                    {
                                        "sense_id": "a4681f75-fa38-3758-8dee-8ead0b329d79",
                                        "entry_id": "37f11693-fc83-3f53-97a0-1a74f772f7c8",
                                        "glosses": [
                                            "Qui peut être prévu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bdfc12c-178e-4374-b508-ca49e85ea15a",
                                                "sense_id": "a4681f75-fa38-3758-8dee-8ead0b329d79",
                                                "text": "Qu'il s'agisse de sensualité ou d'expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                                            },
                                            {
                                                "example_id": "8ba699a3-d08d-40da-bc60-903e9c8dafd5",
                                                "sense_id": "a4681f75-fa38-3758-8dee-8ead0b329d79",
                                                "text": "Au moment où l’image revenait sur le visage souriant et prévisible de Michel Drucker, il coupa le son, se tourna vers son fils."
                                            },
                                            {
                                                "example_id": "2ce9670a-cabd-4de1-bac5-72466fac312c",
                                                "sense_id": "a4681f75-fa38-3758-8dee-8ead0b329d79",
                                                "text": "Les Syldaves et les Bordures n'ont qu'à bien se tenir. Ici, on ramasse les vieilles pétoires, on met un coup de peinture sur les zincs maculés d'huile et de rouille, histoire de faire bonne figure lors du prévisible défilé de la victoire, puis on s’apprête gaiement au massacre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ce0806d-b3ad-4c13-8cd8-90b1157fff67",
                        "source_entry_id": "7a96ad17-5b69-36bd-950d-8d2e2c9f97fe",
                        "source_sense_id": "b1165ea4-c0ae-38b6-b178-8305de5db753",
                        "source_sense_description": "able to be foreseen or anticipated",
                        "target_lang_word": "vorhersehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorhersehbar",
