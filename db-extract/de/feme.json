                "senses": [
                    {
                        "sense_id": "6ad8718f-e0ce-321c-bf2c-83ae629f6550",
                        "entry_id": "2cb3141e-aa52-3558-aac0-91b89c21dea9",
                        "glosses": [
                            "Vehmic court (medieval, chiefly Westphalian, special court for capital crimes presided by a local noble or freeman appointed by the king)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f15218e3-652a-4e38-9ea3-2e77580270f4",
                                "sense_id": "6ad8718f-e0ce-321c-bf2c-83ae629f6550",
                                "text": "Gegenüber dem Dortmunder Hauptbahnhof befindet sich der Freistuhl, wo im Mittelalter die Feme tagte.",
                                "translation": "Across the street from Dortmund central station is the Freistuhl (thingstead), where the Vehmic court used to sit during the Middle Ages.",
                                "english": "Across the street from Dortmund central station is the Freistuhl (thingstead), where the Vehmic court used to sit during the Middle Ages."
                            }
                        ]
                    },
                    {
                        "sense_id": "2112ad3f-1d18-3e6b-8e56-0ac796549349",
                        "entry_id": "2cb3141e-aa52-3558-aac0-91b89c21dea9",
                        "glosses": [
                            "a secret tribunal that orders the assassination of (political) enemies or traitors"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "cb7c1141-898c-4946-8335-44c24dc09e6e",
                                "sense_id": "2112ad3f-1d18-3e6b-8e56-0ac796549349",
                                "text": "Das Opfer könnte ein der Feme verfallener Angehöriger des organisierten Verbrechens sein.",
                                "translation": "The victim might be a member of organized crime who was ordered killed by a secret tribunal.",
                                "english": "The victim might be a member of organized crime who was ordered killed by a secret tribunal."
                            }
                        ]
                    },
                    {
                        "sense_id": "d808b687-3426-3160-a9a0-28699fcdecb9",
                        "entry_id": "2cb3141e-aa52-3558-aac0-91b89c21dea9",
                        "glosses": [
                            "such tribunals among right-wing organisations of the Weimar era"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ddb7ae00-3902-4863-89cc-6f6020dec083",
                                "sense_id": "d808b687-3426-3160-a9a0-28699fcdecb9",
                                "text": "Wegen seiner Beteiligung an einer Feme in Parchim saß Rudolf Höß vier Jahre im Zuchthaus.",
                                "translation": "Rudolf Höss spent four years in jail for his involvement in a right-wing murder plot at Parchim.",
                                "english": "Rudolf Höss spent four years in jail for his involvement in a right-wing murder plot at Parchim."
                            }
                        ]
                    }
                ],
