                    {
                        "translation_id": "0735542e-e151-49d2-98d1-891ce37fce59",
                        "source_entry_id": "58ebc4f0-df5e-3ae1-abbc-e1d48030143f",
                        "source_sense_id": "edd90c23-0b91-32e4-96b7-b2db1a0bc793",
                        "source_sense_description": "benaming voor verschillende in hout levende insectenlarven",
                        "target_lang_word": "woodworm",
                        "target_lang_code": "en",
