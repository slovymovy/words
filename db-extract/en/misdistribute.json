                "senses": [
                    {
                        "sense_id": "51d50b9b-8d10-3ab5-bfdb-925e7979cd0e",
                        "entry_id": "c6cabf4c-7b6a-3eb9-8229-f357a8ec4202",
                        "glosses": [
                            "To distribute incorrectly or unfairly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f3662d26-7f7a-4cab-9a67-e00c6f13e5d1",
                                "sense_id": "51d50b9b-8d10-3ab5-bfdb-925e7979cd0e",
                                "text": "Like Tanner he is an orator, an outsider, a rebel against the existing political and social order, who believes that society misdistributes wealth horribly."
                            },
                            {
                                "example_id": "adfe12f3-1cc0-4bfa-ad25-7832ac26e2fb",
                                "sense_id": "51d50b9b-8d10-3ab5-bfdb-925e7979cd0e",
                                "text": "It misdesigned goods, adversely selected technologies, misallocated and misremunerated factors of production, encouraged work to rule, underproduced, misdistributed outputs and was subject to a myriad of moral hazards."
                            },
                            {
                                "example_id": "4bcf3733-1449-43c3-be60-256faa6aea67",
                                "sense_id": "51d50b9b-8d10-3ab5-bfdb-925e7979cd0e",
                                "text": "Despite Japan's well deserved reputation for high quality export products, its economic system misallocates factors, under-produces, overworks, misdistributes and mistransfers goods and services."
                            }
                        ]
                    }
