                    {
                        "sense_id": "5ce5c2b8-93da-3bad-a862-b193ddd7e279",
                        "entry_id": "0b6ee791-6068-3954-98ef-fa14057b32d6",
                        "glosses": [
                            "een beoefenaar van de theologie"
