                "senses": [
                    {
                        "sense_id": "501ee3f2-36e2-3fe8-a2bd-b20ecdbfb066",
                        "entry_id": "4cc80cb3-455d-373a-b2fa-0432d2c0ae1a",
                        "glosses": [
                            "Terme employé, surtout dans le commerce, pour désigner un degré supérieur de finesse dans des choses de même nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e3db7d-6e9e-4a1f-bc73-23c82a1600d5",
                                "sense_id": "501ee3f2-36e2-3fe8-a2bd-b20ecdbfb066",
                                "text": "Une femme d’un certain âge, qui veut s’attacher à jamais un homme, commence par en diviniser les défauts, afin de rendre impossible toute rivalité ; car une rivale n’est pas de prime abord dans le secret de cette superfine flatterie à laquelle un homme s’habitue assez facilement."
                            },
                            {
                                "example_id": "20ae2b85-3ff1-483a-aef2-6bdc18077b46",
                                "sense_id": "501ee3f2-36e2-3fe8-a2bd-b20ecdbfb066",
                                "text": "Lisbeth était allée à la Halle, et le dîner devait être un de ces dîners superfins que Mathurine cuisinait pour son évêque quand il traitait le prélat du diocèse voisin."
                            },
                            {
                                "example_id": "5b830a97-eb4d-452e-b65f-97ee08bde2e9",
                                "sense_id": "501ee3f2-36e2-3fe8-a2bd-b20ecdbfb066",
                                "text": "En ce moment, on entendit le frôlement d’une robe dans l’escalier, accompagné par le bruit des pas d’une femme à brodequins superfins."
                            }
                        ]
                    }
                ],
