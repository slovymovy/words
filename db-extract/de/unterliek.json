                                    {
                                        "sense_id": "fd593969-ea8e-3bf3-a556-940b1e5ee7b5",
                                        "entry_id": "2ad33939-e149-383e-a115-fdae65256c7d",
                                        "glosses": [
                                            "To set on foot; to establish; to land."
