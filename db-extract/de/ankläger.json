                "senses": [
                    {
                        "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                        "entry_id": "039dfc9f-5764-31b8-98b1-0c4e0d1f8c09",
                        "glosses": [
                            "Person, die im Gericht die Anklage vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795d8c6f-86ef-4ff4-a3d7-6cd40dd16a3f",
                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                "text": "„Barry Roux geht von Anfang an auf Angriff: In seinem Schlussplädoyer beschuldigt Pistorius' Verteidiger Staatsanwalt Gerrie Nel schwer. […] Dann nimmt der Anwalt die Beweisführung des Anklägers auseinander.“"
                            },
                            {
                                "example_id": "c07bb0ef-6ac3-4267-847b-b0ad69b76b90",
                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                "text": "„Punkt für Punkt geht Roux die Anschuldigungen, die Ankläger Nel gestern erhob, durch.“"
                            },
                            {
                                "example_id": "beb3b889-8e48-467c-89fd-1ee283b85b1d",
                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                "text": "„Das Radiogerät lieferte die Stimmen des Anklägers und der Zeugen, Stimmen, die sich in der Luft auflösten, und Sarale lieferte die dazugehörigen Bilder.“"
                            },
                            {
                                "example_id": "8dc68049-0fbc-4ed5-883a-4b553adcb03a",
                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                "text": "„Der Ankläger wird zum Beschuldigten, der Fehltritt zur logischen Notwendigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b211817-8014-4fea-bf52-1873ee57d06e",
