                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ed21cf-f1e2-4550-bba6-ca9a2877f3c2",
                                "sense_id": "61fabdc3-1589-3f6a-91cd-1f91ce12377c",
                                "text": "Timothy Castagne n’en pensait pas moins : « Si ce n’est pas Romelu, peut-être qu’on ne les crée pas, ces occasions. »"
                            }
                        ]
                    }
                ],
