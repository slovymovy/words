                "senses": [
                    {
                        "sense_id": "020ea5b5-a089-35a7-8cd9-d7bd8cd9595f",
                        "entry_id": "29644916-99c4-3516-be3c-1f21ec7d49f3",
                        "glosses": [
                            "Action de caqueter, cri de la poule qui caquète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466bc4ef-e9e4-46b6-bec7-cf0c90213491",
                                "sense_id": "020ea5b5-a089-35a7-8cd9-d7bd8cd9595f",
                                "text": "Les bruits de la brousse —craquements, caquètements, craquètements, cliquètements, coassements, croassements, criaillements, couinements, chuchotements— forment un langage secret."
                            },
                            {
                                "example_id": "3b83dc95-802f-4084-98db-8c08afc9b5f9",
                                "sense_id": "020ea5b5-a089-35a7-8cd9-d7bd8cd9595f",
                                "text": "Je restais sec, contemplais le paysage avec indifférence, écoutais avec calme un caquètement de poule qui triomphait du bruit de la machine s'éloignant, et introduisait une note d'aigreur dans le silence."
                            }
                        ]
                    }
