                ],
                "senses": [
                    {
                        "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                        "entry_id": "dbabce9a-5022-3c6f-b08a-cde0969ca17c",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd819eed-6155-4b8a-a059-31d8c4324f3a",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Herrn Schmidhuber traue ich alles zu."
                            },
                            {
                                "example_id": "68b2e2b4-b3f9-42a4-a493-3e0cab7ceeca",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "An diesem Baum fand Fräulein Schmidhuber letztes Jahr den Tod."
                            },
                            {
                                "example_id": "a7805838-9e6a-48d3-837f-ac799ab961bf",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Der alte Schmidhuber wurde ins Spital eingeliefert."
                            },
                            {
                                "example_id": "d04d4fdf-9b4e-403c-89bd-26ea45ac31ef",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Bei den Schmidhubern gibt es heute Tafelspitz."
                            },
                            {
                                "example_id": "106a248e-c129-4da4-9c7e-065517f9e951",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Schmidhubers haben sich zwei Ochsen angeschafft."
                            },
                            {
                                "example_id": "d429d3ff-8fe4-4c5d-8322-6665c242d55d",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Schmidhubers neuer Verehrer ist ein Zugereister."
                            },
                            {
                                "example_id": "3254b8ef-a9b9-45b5-b3ae-3391facdd17a",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "Kümmere dich gut um Herrn Schmidhubers Königspudel, solange er im Urlaub ist."
                            },
                            {
                                "example_id": "15d91bf7-ed87-4155-af9e-21c44284d680",
                                "sense_id": "274ec8d1-ed79-3be5-a346-9b94bc4632e1",
                                "text": "In Düsseldorf traf Theo seinen alten Bekannten Schmidhuber, den er vor Jahren in Colombo beim Strip-Poker besiegt hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
