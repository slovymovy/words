                ],
                "senses": [
                    {
                        "sense_id": "a5bb0298-c68b-37ba-9e8e-30b6eae175b0",
                        "entry_id": "38347427-02b9-3460-ac51-ede0de78196e",
                        "glosses": [
                            "dem Adel angehörende Familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2624e186-b28f-4a5e-b889-c888ffba2c5e",
                                "sense_id": "a5bb0298-c68b-37ba-9e8e-30b6eae175b0",
                                "text": "„Bei der Regierungsbildung 2017 gehörte der Berufsdiplomat – er entstammt einer alten oberösterreichischen Adelsfamilie – dem Verhandlungsteam für die Koalitionsverhandlungen an.“"
                            },
                            {
                                "example_id": "6d6ad850-c1be-41d9-ad0d-99de187e81b7",
                                "sense_id": "a5bb0298-c68b-37ba-9e8e-30b6eae175b0",
                                "text": "„Jene Netze, welche die wohlhabenden Adelsfamilien durch Verheiratungen über Jahrhunderte zwischen sich gesponnen haben, sicherten Roms Größe.“"
                            },
                            {
                                "example_id": "c2a14b45-3719-4b53-bb9a-2543126e60dd",
                                "sense_id": "a5bb0298-c68b-37ba-9e8e-30b6eae175b0",
                                "text": "„Einzelne Adelsgeschlechter befehdeten die Städte, und die Städte ihrerseits bekriegten die Adelsfamilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
