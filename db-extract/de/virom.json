                                "target_senses": [
                                    {
                                        "sense_id": "a0cc7f62-7c1d-3c40-bd13-ec0d1fb62815",
                                        "entry_id": "60669096-6a05-3416-899f-ba77f16b3b44",
                                        "glosses": [
                                            "Composition génétique des virus d’un virobiote, l’ensemble des virus qui habitent un écosystème ou un organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42fdc4e-b281-428c-b93f-8644e50c91f1",
                                                "sense_id": "a0cc7f62-7c1d-3c40-bd13-ec0d1fb62815",
                                                "text": "Le virome cutané est actuellement moins bien caractérisé. Il est composé aussi de virus résidents et transitaires. Des analyes de séquençages à la surface cutanée ont montré trois familles prédominantes : Papillomaviridae, Polyomaviridae et Circoviridae, ce qui confirme le portage asymptomatique de nombreuses souches de papillomavirus (HPV) (jusqu’à 17 différentes souches)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
