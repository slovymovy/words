                    },
                    {
                        "translation_id": "2faef0ed-1d37-4c7b-b395-2221ce1cb0f6",
                        "source_entry_id": "4c305192-2344-3392-9ed2-77deddb7888f",
                        "source_sense_id": "189500e9-c82f-3455-9430-9d71e9bafb9a",
                        "source_sense_description": "diejenige Sprache, die ein Kind als erste/wichtigste Sprache erlernt und verwendet",
                        "target_lang_word": "moedertaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moedertaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                                        "entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                                        "glosses": [
                                            "taal die tijdens de jeugd, zonder formeel taalonderwijs, wordt verworven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a38832e-1353-4870-a1ef-cd6dfdbd0ad6",
                                                "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                                                "text": "Het Nederlands is niet mijn moedertaal."
                                            },
                                            {
                                                "example_id": "3ab5a01c-2588-41ee-b8a6-c75fb64d6444",
                                                "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                                                "text": "'Op uw gedichten studeer ik nog. Ik heb echter moeite met de klanken van uw moedertaal, dus ik vrees dat ik, wanneer de gelegenheid zich voordoet om iets van uw hand te citeren, mijn toevlucht zal moeten nemen tot de Engelse, Duitse of Italiaanse vertaling. Ik hoop dat u bij voorbaat de grootmoedigheid kunt opbrengen om mij dat te vergeven.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf14f75-1680-3b87-b110-311c84d4f107",
                                        "entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                                        "glosses": [
                                            "iets waar iemand zich helemaal in thuis voelt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12cc2ee-3bbb-4798-942b-c0505ad35cb6",
                                                "sense_id": "bcf14f75-1680-3b87-b110-311c84d4f107",
                                                "text": "Natuurkunde is mijn moedertaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f7705dd-79cf-4812-8e59-50abdcd52aff",
                        "source_entry_id": "4c305192-2344-3392-9ed2-77deddb7888f",
                        "source_sense_id": "189500e9-c82f-3455-9430-9d71e9bafb9a",
                        "source_sense_description": "diejenige Sprache, die ein Kind als erste/wichtigste Sprache erlernt und verwendet",
                        "target_lang_word": "родной язык",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "родной язык",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "121b92ed-79cd-357e-9b63-77eea1afe786",
                                        "entry_id": "44cf9546-c69e-33d0-96a2-16545d2228ab",
                                        "glosses": [
                                            "язык, которым человек владеет с раннего детства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4317f9-13f6-4179-9d69-e14c1df47a7b",
                                                "sense_id": "121b92ed-79cd-357e-9b63-77eea1afe786",
                                                "text": "Обтерев с лиц пот и пыль, три товарища усаживаются за деревянный стол и долго шепчутся на родном языке."
                                            },
                                            {
                                                "example_id": "e5881c3b-b429-4330-8ec8-834a7038370b",
                                                "sense_id": "121b92ed-79cd-357e-9b63-77eea1afe786",
                                                "text": "Учась по книгам на родном языке, татары могли знакомиться со своими народными писателями и поэтами, что позволило более осмысленно представлять и отстаивать свои интересы и считать себя самостоятельной нацией, имеющей собственную историю, свой язык, литературу, искусство, культуру."
                                            },
                                            {
                                                "example_id": "0ab968ea-bc57-44b9-8234-47d3e0d369d8",
                                                "sense_id": "121b92ed-79cd-357e-9b63-77eea1afe786",
                                                "text": "Понимай меня или не понимай, фон Верден, а я буду говорить на своем родном языке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
