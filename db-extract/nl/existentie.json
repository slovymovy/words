                "translations": [
                    {
                        "translation_id": "4d02a05c-b584-4aed-8894-46784d8fa228",
                        "source_entry_id": "030642e2-1271-3d9c-8a5c-28c1261a0d10",
                        "source_sense_id": "1284b4a7-5854-3407-a719-0cd76326d9f2",
                        "target_lang_word": "Existenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Existenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                        "entry_id": "80414a7e-e790-3de6-8437-a3775aacb58f",
                                        "glosses": [
                                            "das Vorhandensein eines Gegenstandes oder eines Zustandes in der Realität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e948d6a-a2a7-467a-9aa0-95545dcc4f24",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Zwangsläufig: Die bloße Existenz eines Grundgesetzes ist keine Garantie für dessen Erfüllung, wenn die politisch bedeutenden Kräfte nicht einig sind“. (Quelle: Neues Deutschland 2003)"
                                            },
                                            {
                                                "example_id": "aff93514-c553-4788-88db-6be447cc0896",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Oft billigen wir Dingen nur eine Existenz zu, wenn sie denn sichtbar sind und einen Namen tragen“. (Quelle: Der Spiegel ONLINE)"
                                            },
                                            {
                                                "example_id": "93c9f5a4-7d75-48d3-9246-b0ea07913909",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Die Existenz von Pflanzen erfordert ein Mindestmaß an Kohlendioxid in der Planetenatmosphäre“. (Quelle: Der Spiegel ONLINE)"
                                            },
                                            {
                                                "example_id": "94d04857-168e-4f4f-9a84-947fae82c94f",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Nur dann wäre in dieser Sicht ein wissenschaftlicher Gottesbeweis gelungen, wenn der Unterschied empirisch feststellbar wäre, den seine Existenz bzw. Nichtexistenz für eine naturwissenschaftliche Beschreibung der Wirklichkeit machen würde.“"
                                            },
                                            {
                                                "example_id": "614d4ad1-29c5-4b8a-8920-2b960fdd1829",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Der ontologische Gottesbeweis schlussfolgert aus dem bloßen Gedanken oder Begriff ‚Gott’, d. h. a priori, auf die Existenz Gottes.“"
                                            },
                                            {
                                                "example_id": "6611e495-f1d6-4c70-ad74-de1261f7ab11",
                                                "sense_id": "f283b411-467b-3660-97b2-ac88601c5366",
                                                "text": "„Die gesellschaftlichen Rahmenbedingungen, die ethische Substanz einer Gemeinschaft und die Existenz oder Nichtexistenz einer Wagniserziehung tragen einen wesentlichen Verantwortungsanteil daran, in welche Wertrichtung sich die Wagnistendenzen bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5d03b9a-68e7-364c-9b63-4986fe73555e",
                                        "entry_id": "80414a7e-e790-3de6-8437-a3775aacb58f",
                                        "glosses": [
                                            "die Notwendigkeiten für eine Lebensgrundlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a729310-bf81-4614-811c-d1cdec0db3a7",
                                                "sense_id": "f5d03b9a-68e7-364c-9b63-4986fe73555e",
                                                "text": "Seine Existenz stand auf dem Spiel."
                                            },
                                            {
                                                "example_id": "e68feb50-52b7-4600-98e2-5a40dd226dab",
                                                "sense_id": "f5d03b9a-68e7-364c-9b63-4986fe73555e",
                                                "text": "„Durch den Brexit sind zahlreiche Fabriken in ihrer Existenz bedroht, Tausende Arbeitsplätze in Gefahr.“"
                                            },
                                            {
                                                "example_id": "92637fc0-57eb-42ac-96ac-398fca19cbf2",
                                                "sense_id": "f5d03b9a-68e7-364c-9b63-4986fe73555e",
                                                "text": "„Ich dachte an Bosse, der versuchte, sich eine neue Existenz aufzubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7124669-0d5a-482f-a864-e857f29e7fc6",
                        "source_entry_id": "030642e2-1271-3d9c-8a5c-28c1261a0d10",
                        "source_sense_id": "1284b4a7-5854-3407-a719-0cd76326d9f2",
                        "target_lang_word": "existence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "existence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "The state of being, existing, or occurring; beinghood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9466a8-7db2-4455-a509-bcf07092b654",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "In order to destroy evil, we must first acknowledge its existence."
                                            },
                                            {
                                                "example_id": "e2f64c68-d4f1-454f-9a89-61252bef7dec",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "Fortunate it is for the tranquillity of the new-born infant, if he have any turn for philosophy, that he understands none of the nonsense consecrated by old usage to the commencement of existence."
                                            },
                                            {
                                                "example_id": "b2b100d0-e7e5-4517-b3af-76d7c34870c7",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "725bd82d-e992-4c66-b680-9a4c50418d06",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            },
                                            {
                                                "example_id": "933a459d-402a-49d2-9209-efba7455dd07",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The ancients said, “A ruler should exist for the existence of the people.” The famous thinker, Mencius noted, “The people are the most valuable, then the country, and the ruler comes last.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47581ac-1901-34db-9aab-f235e5ade685",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "Empirical reality; the substance of the physical universe. (Dictionary of Philosophy; 1968)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f8a4cd-7cdd-49ab-8d86-1c61424f59b8",
                        "source_entry_id": "030642e2-1271-3d9c-8a5c-28c1261a0d10",
                        "source_sense_id": "1284b4a7-5854-3407-a719-0cd76326d9f2",
                        "target_lang_word": "existence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "existence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                        "entry_id": "391e32fb-8eec-34f4-a18f-fe446557f358",
                                        "glosses": [
                                            "Fait d’être, état de ce qui existe ; par exemple le fait d’être d’une manière absolue, ou pour la perception, ou encore pour la conscience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f159762-b42c-483d-9a5c-16d0acf003f4",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "Je crois confusément à beaucoup de choses ; par dessus tout, à l’existence de Dieu, sinon aux dogmes de la religion ; […]."
                                            },
                                            {
                                                "example_id": "f72777a5-bcf4-4f79-ae8d-d8c087baecbe",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "Il semble donc qu'on est en droit de conclure à l’existence d'un large mouvement humain se dirigeant, vers l'époque quaternaire, de l'Est du vieux monde à l'Ouest du nouveau."
                                            },
                                            {
                                                "example_id": "10ff19b3-3813-4f61-9227-24792ff8e3a7",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "La plus récente causerie de Wambery portait sur l’existence d'un tyran walachien, le Voïvode Drakula (ou Vlad Drakul), réputé buveur de sang humain. Le tout-Londres ne parle bientôt plus que de vampires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                        "entry_id": "391e32fb-8eec-34f4-a18f-fe446557f358",
                                        "glosses": [
                                            "Vie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c699296-34cd-458b-a2ae-e87c10c17f3a",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Les Lettres à l'Étrangère, […], ces lettres contiennent des aveux, voilés, il est vrai, des histoires obscures, sans doute, mais reconnaissables pour qui connaît un peu l’existence secrète de Balzac."
                                            },
                                            {
                                                "example_id": "de0ea9da-7fb1-41d1-889c-376e1969cca4",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Lentement, irrésistiblement, avec ampleur, Bert se rendit compte de l’immense tragédie qui ébranlait l’humanité, et au milieu de laquelle s’écoulait sa petite existence ; […]"
                                            },
                                            {
                                                "example_id": "230dbefc-f75a-45c9-bbfd-ada2f075b535",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "[…] Henri Fagerolle, jeté brusquement dans une sorte de tourbillon irrésistible, avait entièrement perdu pied. Il se laissait glisser, ballotter, secouer dans les remous d'une existence qui ne lui accordait aucun répit."
                                            },
                                            {
                                                "example_id": "11596653-f29d-4c34-b244-7d971285fc40",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "La jeune femme était inquiète de ce bouleversement qu'elle sentait envahir son existence. Elle était heureuse cependant, car elle avait une raison de vivre et d'espérer."
                                            },
                                            {
                                                "example_id": "7f4d9a42-b716-4c96-b8bc-a6bc83f6bdb9",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Tout métier qui ne fait pas oublier le travail est un esclavage. La vie alors n'est plus une existence."
                                            },
                                            {
                                                "example_id": "17d11125-157e-4316-8308-b15b68e77746",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Voilà une existence qui n'a rien à voir avec celle que j'ai connue dans un bourg morvandiau, au milieu des toucheurs de bœufs et des mineurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
