                    "sense_definition": "Personne versée dans la connaissance approfondie et l'étude du droit et des lois.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juriste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>légiste</w> réputé a consacré toute sa carrière à l'analyse critique des textes juridiques."
                        },
