                "senses": [
                    {
                        "sense_id": "d75761ec-41c0-3b45-848c-1f6ba322da2b",
                        "entry_id": "acb093d7-62b3-3ab0-91b7-f7a4b5445a6b",
                        "glosses": [
                            "S’affranchir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1021de82-ea1a-46ce-a7f8-48f7a3f9dc03",
                                "sense_id": "d75761ec-41c0-3b45-848c-1f6ba322da2b",
                                "text": "Pourtant, ce dernier ne pourrait y suffire, nul ne pouvant s’autoaffranchir."
                            },
                            {
                                "example_id": "55bbb66d-0abe-4100-b9c6-075430ca239f",
                                "sense_id": "d75761ec-41c0-3b45-848c-1f6ba322da2b",
                                "text": "Les sénateurs usant arbitrairement de leur pouvoir législatif s’autoaffranchissent de tout contrôle de la régularité, liberté, légalité, des élections, par le citoyen, la justice, l'électeur, désormais proscrits de tout capacité de contrôle sur le déroulement des élections sénatoriales."
                            }
                        ]
                    }
