                    "sense_definition": "bijnaam voor een sporter die zeer veel doelpunten maakt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spits staat bekend als een echte <w>bomber</w> in het strafschopgebied.",
                            "target_lang_translations": {
                                "fr": "L'attaquant est connu comme un vrai <w>buteur</w> dans la surface de réparation."
                            }
                        },
                        {
                            "text": "Dankzij de doelpunten van de <w>bomber</w> won het team de wedstrijd.",
                            "target_lang_translations": {
