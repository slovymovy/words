                                                "sense_id": "ff873305-03c3-35f9-a2e2-d81171ce9a3c",
                                                "text": "The roof gave in under the weight of the snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b3ed7f-98ae-30df-a537-fbe0555465c0",
                                        "entry_id": "518a2a28-dda1-3ea3-993e-6d46fe6a064c",
                                        "glosses": [
                                            "To relent, yield, surrender or admit defeat."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1762142d-970c-4de5-b951-c9eee4f673d6",
                                                "sense_id": "30b3ed7f-98ae-30df-a537-fbe0555465c0",
                                                "text": "Try not to give in to temptation."
                                            },
                                            {
                                                "example_id": "d11613db-c251-4af7-b180-17babd1cfb32",
                                                "sense_id": "30b3ed7f-98ae-30df-a537-fbe0555465c0",
                                                "text": "OK, I don't know the answer. I give in."
                                            },
                                            {
                                                "example_id": "d6a8d980-3cec-4d5f-9766-9a48bceb2fd0",
                                                "sense_id": "30b3ed7f-98ae-30df-a537-fbe0555465c0",
                                                "text": "I finally gave in and let him stay up to watch TV."
                                            }
                                        ]
                                    },
