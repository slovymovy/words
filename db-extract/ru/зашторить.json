                        "translation_id": "a518cc71-65b8-46dc-b16a-8908cb80eb2f",
                        "source_entry_id": "3836820f-10d5-3a0d-a534-855137a34a3c",
                        "source_sense_id": "2246ed1b-433a-30f9-b8ea-1c06b48acd0f",
                        "target_lang_word": "curtain off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curtain off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3385c896-97a3-35d9-96bd-0981095a7796",
                                        "entry_id": "62383618-dfef-339a-a271-e5f0df1dbf77",
                                        "glosses": [
                                            "To separate, isolate or block by means of a curtain or other barrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd22340b-283c-461f-babf-3cb31a41b090",
                                                "sense_id": "3385c896-97a3-35d9-96bd-0981095a7796",
                                                "text": "The encircling, mile-high mountains of the Coeur d'Alene mining area, rich in lead, zinc and silver, curtain off the sunlight except for a few midday hours."
                                            },
                                            {
                                                "example_id": "0896529e-63d2-4994-9002-dd7f02dc4a2e",
                                                "sense_id": "3385c896-97a3-35d9-96bd-0981095a7796",
                                                "text": "For furniture there was a table and chair, and a bed, slovenly made; one corner of the room was curtained off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2665fcfe-9136-3e3e-bbc7-9be852e1d9ed",
                                        "entry_id": "62383618-dfef-339a-a271-e5f0df1dbf77",
                                        "glosses": [
                                            "To isolate."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d78fd0-3396-4d4c-94ab-b0aed9b58fb3",
                                                "sense_id": "2665fcfe-9136-3e3e-bbc7-9be852e1d9ed",
                                                "text": "I am talking about a way of regarding our world as amenable to investigation and interrogation without magic keys, special jargons and instruments, curtained-off practices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
