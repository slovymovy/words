                "senses": [
                    {
                        "sense_id": "f61c7e43-5de6-3388-960e-00e4af76ee82",
                        "entry_id": "06d419b2-4522-33f1-80f6-bb03a4f00b13",
                        "glosses": [
                            "indischer Herrschertitel"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9904a99f-492c-4e9b-bdf1-f456174f1aef",
                                "sense_id": "f61c7e43-5de6-3388-960e-00e4af76ee82",
                                "text": "Der Mogul Sofi hatte nur durchschnittliche Führungsqualitäten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96ea3ae8-7556-350d-a877-09293aae8bf2",
                        "entry_id": "06d419b2-4522-33f1-80f6-bb03a4f00b13",
                        "glosses": [
                            "Träger des unter [1] erwähnten Titels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b397ead-f6dd-41da-83f7-9bd5614470af",
                                "sense_id": "96ea3ae8-7556-350d-a877-09293aae8bf2",
                                "text": "Das 16. Jahrhundert war eine große Zeit für Indiens Mogule."
                            },
                            {
                                "example_id": "6ae43e90-0a79-4ee4-9f0b-e7e7f0128267",
                                "sense_id": "96ea3ae8-7556-350d-a877-09293aae8bf2",
                                "text": "„Die großen Reiche Asiens – die Osmanen, Perser, Moguln und Chinesen – bekamen sehr bald mit, dass die Europäer einen neuen Kontinent entdeckt hatten.“"
                            },
                            {
                                "example_id": "c4d940f8-6aae-493c-99c9-2c31c086644a",
                                "sense_id": "96ea3ae8-7556-350d-a877-09293aae8bf2",
                                "text": "„Nachdem die muslimischen Moguln sich zurückgezogen hatten, war Bhopal fast hundert Jahre lang ein unabhängiges Fürstentum.“"
                            },
                            {
                                "example_id": "af4456cd-dcae-4116-afc4-60ccfa138f54",
                                "sense_id": "96ea3ae8-7556-350d-a877-09293aae8bf2",
                                "text": "„Hier liegt auch die ehemalige Residenzstadt der Moguln, Lahore (ca. 10 Mio. Einwohner).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
