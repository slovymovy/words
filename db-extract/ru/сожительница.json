                "senses": [
                    {
                        "sense_id": "a2a3f85c-8d82-3796-8b24-e28b1f1ffe5b",
                        "entry_id": "f853b59f-7f7a-3fad-b398-1a69822caf14",
                        "glosses": [
                            "женск. к сожитель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c0ea04-55fd-4f38-a2e9-b88f374f2390",
                                "sense_id": "a2a3f85c-8d82-3796-8b24-e28b1f1ffe5b",
                                "text": "Я понял, что она вместо больницы подалась на почту ― сдавать бандероли и письма, там ей сообщили о том, что ночью Рубцова убила его сожительница."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1fb817-0510-4df7-808a-c0b6a99fa5f7",
                        "source_entry_id": "f853b59f-7f7a-3fad-b398-1a69822caf14",
                        "source_sense_id": "a2a3f85c-8d82-3796-8b24-e28b1f1ffe5b",
                        "target_lang_word": "konkubina",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konkubina",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d4bd90cb-1adc-3cbb-8c50-01102689287c",
                                        "entry_id": "51a41578-749d-3a1f-adda-c48cd03a78a8",
                                        "glosses": [
                                            "kobieta żyjąca z mężczyzną bez zawarcia związku małżeńskiego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0854d97c-4db3-4f86-8f7a-f51bc2e2260d",
                                                "sense_id": "d4bd90cb-1adc-3cbb-8c50-01102689287c",
                                                "text": "Kiedy Krzysztof D. powiedział, że nie ma pieniędzy, dostał dwa ciosy w twarz. Wtedy jego konkubina, która też była w mieszkaniu, zadzwoniła na policję"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "8e2c10fe-31d6-3f2c-a8fb-d552ce9ae0bc",
                                        "entry_id": "51a41578-749d-3a1f-adda-c48cd03a78a8",
                                        "glosses": [
                                            "nałożnica"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae32a06f-24dc-4fd1-b9c4-be64dbc9d4d0",
                                                "sense_id": "8e2c10fe-31d6-3f2c-a8fb-d552ce9ae0bc",
                                                "text": "Dawid, król Izraela, miał kilka żon i wiele konkubin."
                                            },
                                            {
                                                "example_id": "66bac52a-e2c6-47da-a96e-17491a29857d",
                                                "sense_id": "8e2c10fe-31d6-3f2c-a8fb-d552ce9ae0bc",
                                                "text": "Często więc mężczyźni w Chinach brali konkubiny dla własnej przyjemności"
                                            },
                                            {
                                                "example_id": "5a0ef590-ebbf-433a-ba1f-aae396ec571a",
                                                "sense_id": "8e2c10fe-31d6-3f2c-a8fb-d552ce9ae0bc",
                                                "text": "Syn i następca cesarza polecił podobno pochować razem z ojcem wszystkie jego konkubiny"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
