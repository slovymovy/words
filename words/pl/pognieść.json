    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e3ffb1c-a62c-3681-bdc6-c3a7eaa53fbc",
                    "sense_definition": "spowodować powstanie zagnieceń, fałd lub zmarszczek na powierzchni tkaniny, papieru itp.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zmiacanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez nieuwagę <w>pogniotłem</w> ważny dokument, który leżał na biurku.",
                            "target_lang_translations": {
                                "ru": "По невнимательности я <w>помял</w> важный документ, лежавший на столе."
                            }
                        },
                        {
                            "text": "Jeśli włożysz tę sukienkę do ciasnej walizki, na pewno ją <w>pognieciesz</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты положишь это платье в тесный чемодан, ты точно его <w>погнёшь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pomiąć",
                        "pofałdować"
                    ],
                    "antonyms": [
                        "wyprasować",
                        "rozprostować"
                    ],
                    "common_phrases": [
                        "pognieść koszulę",
                        "pognieść kartkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать мятым, покрыть складками или морщинами ткань, бумагу и т. п."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помять",
                                "target_lang_sense_clarification": "сделать мятым (одежду, бумагу)"
                            },
                            {
                                "target_lang_word": "измять",
                                "target_lang_sense_clarification": "сильно или полностью помять"
                            },
                            {
                                "target_lang_word": "скомкать",
                                "target_lang_sense_clarification": "сжать в комок (о бумаге, ткани)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f10def4f-e227-362f-8cba-85284e10109b",
                    "sense_definition": "rozgnieść lub zmiażdżyć pewną ilość czegoś miękkiego, zamieniając w miazgę",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "miazdzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy dokładnie <w>pognieść</w> ugotowane ziemniaki, zanim dodamy do nich masło.",
                            "target_lang_translations": {
                                "ru": "Нам нужно тщательно <w>растолочь</w> варёный картофель, прежде чем добавлять масло."
                            }
                        },
                        {
                            "text": "Dziecko niechcący <w>pogniotło</w> miękkie truskawki w papierowej torbie.",
                            "target_lang_translations": {
                                "ru": "Ребёнок случайно <w>подавил</w> мягкую клубнику в бумажном пакете."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozgnieść",
                        "zmiażdżyć"
                    ],
                    "common_phrases": [
                        "pognieść ziemniaki",
                        "pognieść owoce"
                    ],
                    "target_lang_definitions": {
                        "ru": "раздавить или размять что-либо мягкое, превращая в кашицу или пюре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растолочь",
                                "target_lang_sense_clarification": "измельчить давлением (картофель)"
                            },
                            {
                                "target_lang_word": "размять",
                                "target_lang_sense_clarification": "сделать мягким, превратить в пюре"
                            },
                            {
                                "target_lang_word": "подавить",
                                "target_lang_sense_clarification": "раздавить в некотором количестве (ягоды, фрукты)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}