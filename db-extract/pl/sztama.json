                        "entry_id": "86b179af-55d1-3009-927d-9504d6acdaf9",
                        "glosses": [
                            "koleżeński lub przyjacielski układ z kimś, zobowiązujący do wzajemnej pomocy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "251b5de1-6892-4476-82c1-963f88b4dac0",
                                "sense_id": "eea0c9a6-51fb-31e0-bb9e-b7db44919563",
                                "text": "Chcę, żeby między nami była sztama, rozumiesz? Bracia powinni iść z sobą ręka w rękę."
                            },
                            {
                                "example_id": "7fef1206-87c1-4cb1-af85-a764cb57469a",
                                "sense_id": "eea0c9a6-51fb-31e0-bb9e-b7db44919563",
                                "text": "Sztama! To znaczy, musimy trzymać jeden z drugim. I ani pary z gęby o tym, o czym ze sobą gadamy…"
                            }
                        ],
