                "senses": [
                    {
                        "sense_id": "c30fec42-a244-33d6-8f8d-570d71b0e02c",
                        "entry_id": "5ba63542-20bd-30e9-92c2-e388b3f60caf",
                        "glosses": [
                            "Concevoir un produit de façon à garantir un impact écologique réduit sur l’environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05aa235f-863b-4f4b-a663-6a5060879d8f",
                                "sense_id": "c30fec42-a244-33d6-8f8d-570d71b0e02c",
                                "text": "Éco-concevoir un produit implique de réfléchir à l'optimisation de ses fonctionnalités, faire plus avec moins, éliminer le superflu afin d'apporter plus de l'essentiel."
                            },
                            {
                                "example_id": "248c234b-edc7-4da9-8e36-51153633c4b6",
                                "sense_id": "c30fec42-a244-33d6-8f8d-570d71b0e02c",
                                "text": "Incitant fort à éco-concevoir les produits et à optimiser l'efficience du système."
                            },
                            {
                                "example_id": "d494d93e-2e0a-409b-bbee-f136eef5f25e",
                                "sense_id": "c30fec42-a244-33d6-8f8d-570d71b0e02c",
                                "text": "Par exemple, consulter l’horaire d’un train sur un site éco-conçu consommerait 700 fois moins de ressources que sur une page web inondée de publicités et de gadgets."
                            }
                        ]
                    }
