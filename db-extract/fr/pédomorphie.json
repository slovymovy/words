                                        "glosses": [
                                            "The retention or emergence of juvenile characteristics in an adult organism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e365f597-8755-4027-be4e-88b830110b08",
                                                "sense_id": "12ffe7d9-e963-33ab-a288-aa0d6108a693",
                                                "text": "The clade 4-1 salamanders recently lived in environments that would make paedomorphy unlikely, but now even when they are living in large, permanent ponds that induce paedomorphy in clade 4-2 salamanders, they are incapable of becoming paedomorphs."
                                            },
                                            {
                                                "example_id": "18df4f6c-465e-46b2-8ddd-e230feed1037",
                                                "sense_id": "12ffe7d9-e963-33ab-a288-aa0d6108a693",
                                                "text": "Richard Wrangham has noted that the domestication of animals usually tames them by slowing down components of the developmental timetable to retain juvenile traits into adulthood, a process called pedomorphy or neoteny."
                                            }
                                        ]
                                    }
                                ]
