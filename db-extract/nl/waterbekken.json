                "senses": [
                    {
                        "sense_id": "588be720-df16-33d9-9827-382b2f09a74a",
                        "entry_id": "27b8b8df-2f38-3721-8c89-abd503d5a395",
                        "glosses": [
                            "met water gevuld bekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737739b8-5c0a-4c3a-8bda-6969b30e0dce",
                                "sense_id": "588be720-df16-33d9-9827-382b2f09a74a",
                                "text": "In Indonesië zijn gisteren zeker zeven mensen omgekomen toen een boot met toeristen op een waterbekken op Java kapseisde."
                            },
                            {
                                "example_id": "96b953cd-18ff-4138-8a89-66f1890a3640",
                                "sense_id": "588be720-df16-33d9-9827-382b2f09a74a",
                                "text": "Het monument bestaat uit een 12 meter breed waterbekken met in het midden een steen. De Israëlische Kunstenaar en bouwer Dani Karavan wil dat er altijd een bloeiende roos op de steen ligt. Is de roos verwelkt, dan zakt de steen in het water. Vervolgens komt hij weer boven en moet er een nieuwe roos opgelegd worden. Als symbool voor de cyclus van leven, rouw en herinnering."
                            },
                            {
                                "example_id": "5ea44e49-c4de-41c1-9574-6d1d7c9c0c21",
                                "sense_id": "588be720-df16-33d9-9827-382b2f09a74a",
                                "text": "Als er geen behoefte is aan opwekking gaan de schuiven dicht en blijft de energie 'bewaard' in het waterbekken."
                            }
                        ]
                    }
                ],
