                ],
                "senses": [
                    {
                        "sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                        "entry_id": "473e1936-0fa9-3944-b2cb-d30618bc07c1",
                        "glosses": [
                            "gastronomischer Betrieb, der vor allem des Nachts geöffnet hat und in vielen Fällen ein Unterhaltungsangebot bereithält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f281060d-437e-45fa-b85b-8e03e1616843",
                                "sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                                "text": "Politiker lassen sich nicht gern beim Besuch eines Nachtklubs sehen."
                            },
                            {
                                "example_id": "b2c4c78d-9100-4efd-9172-f76ed75673b3",
                                "sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                                "text": "„Erst gegen zwei Uhr morgens konnten sie die versammelte Meute von der Unentbehrlichkeit von Literatur in einem Nachtklub überzeugen.“"
                            },
                            {
                                "example_id": "0423c9a4-81c1-4a25-930e-f245f47a07b9",
                                "sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                                "text": "„Er hatte in Simon Balcairns Spalte gelesen, seine Tochter sei in einem Nachtklub gesehen worden, was aber Kenner von Miss Strappers Lebensgewohnheiten durchaus nicht wunderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58bdf17a-b394-4bcd-a672-928e11061bb7",
                        "source_entry_id": "473e1936-0fa9-3944-b2cb-d30618bc07c1",
                        "source_sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                        "target_lang_word": "nightclub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nightclub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                        "entry_id": "012498d6-f343-3fa7-9eb0-952d53653db4",
                                        "glosses": [
                                            "A public or private establishment that is open late at night to provide entertainment, food, drink, music or dancing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f1813d-9323-4202-9b02-e3ea64de17b0",
                                                "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                                "text": "They respond instantly to the faintest rustling in the covert of a sheaf of Ulysses S. Grants, or the homely, rustic tinkle of a wheelbarrow full of rubies being jounced along over a nightclub floor."
                                            },
                                            {
                                                "example_id": "2cee2c5e-dbfa-4544-89e9-295f5fe4667e",
                                                "sense_id": "5a60eb88-ecf5-38bc-9594-50b5b795adc6",
                                                "text": "EARLY this summer, Joshua J. Pelton decided that he was meant to live in Orlando, Fla. So he quit his sales job in Detroit, packed his car with all the belongings that fit, put the rest in storage, and drove southeast daydreaming about sundrenched winters and packed nightclubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d1364a-ab77-3e23-85b7-7512e40b5e2c",
                                        "entry_id": "012498d6-f343-3fa7-9eb0-952d53653db4",
                                        "glosses": [
                                            "A strip club."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nightclub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5dc0ca-8b80-31c7-837c-698a62b76e07",
                                        "entry_id": "c19aa120-9587-30f5-8793-f5b56429b656",
                                        "glosses": [
                                            "To visit a nightclub (or nightclubs) for entertainment."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad5fc043-5f75-4397-8c05-7641c44888ca",
                                                "sense_id": "fc5dc0ca-8b80-31c7-837c-698a62b76e07",
                                                "text": "Our first night in the big city we went out nightclubbing. The next morning we stayed in hung over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc400440-bb44-4211-9596-b0a47eb40ffe",
                        "source_entry_id": "473e1936-0fa9-3944-b2cb-d30618bc07c1",
                        "source_sense_id": "5f8f9d3b-2b7c-3cbb-a2ba-44d0b3b4da3c",
                        "target_lang_word": "boîte de nuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boîte de nuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                        "entry_id": "0cbf9d55-2d5b-310c-ab3a-47ea88b01d91",
                                        "glosses": [
                                            "Établissement de loisir où l’on va habituellement de nuit pour écouter de la musique et danser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf3d486-365d-48f9-a875-742e79b6d9dc",
                                                "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                                "text": "Si j'étais pas faignante je me mettrais à faire les boîtes de nuit, sérieusement, la noce sans m'amuser, j'y parviendrais : tendre ma joue à embrasser, comme un paillasse à la parade tend sa joue à claquer."
                                            },
                                            {
                                                "example_id": "87bd400b-2403-4b28-9126-41e002c7581e",
                                                "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                                "text": "J’avais pour invité, dans un bar de Montmartre, le chasseur d’une boîte de nuit qui, sous son beau costume, abritait une nature inquiète."
                                            },
                                            {
                                                "example_id": "7da5776f-255f-4b96-8a44-01d17fb98d3e",
                                                "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                                "text": "L’année dernière, le Point de vue, à Laz, a fermé, victime de l’épidémie de covid sur l’économie des boîtes de nuit."
                                            },
                                            {
                                                "example_id": "dc760f0e-b83b-4c4a-a8e9-71f16bc3bca4",
                                                "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                                "text": "Elle a tenu les emplois les plus divers, pour finir dans les vestiaires d’une boîte de nuit."
                                            },
                                            {
                                                "example_id": "b72983bb-c67a-43ac-b09e-50a3dea6a73f",
                                                "sense_id": "6b3c5bc6-2a48-3999-b608-e02bff8f810f",
                                                "text": "Ainsi « boîte de nuit » nous a été signalé à plusieurs reprises comme un « togolisme ». Par contre, de véritables écarts ont été omis car ils apparaissaient à tous les locuteurs comme la forme française « correcte », en raison de leur grande fréquence d'emploi : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
