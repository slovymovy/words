            "senses": [
                {
                    "sense_id": "6e0e9e04-172e-3e75-983a-a45f6c53df10",
                    "sense_definition": "Какой угодно, безразлично какой, всякий.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <любом> случае мы должны закончить эту работу сегодня.",
                            "target_lang_translations": {
                                "en": "In <w>any</w> case, we must finish this work today.",
                                "zh": "在<w>任何</w>情况下，我们今天都必须完成这项工作。",
                                "es": "En <w>cualquier</w> caso, debemos terminar este trabajo hoy.",
                                "fr": "Dans <w>n'importe quel</w> cas, nous devons finir ce travail aujourd'hui."
                            }
                        },
                        {
                            "text": "Вы можете прийти к нам в гости в <любое> время.",
                            "target_lang_translations": {
                                "en": "You can come visit us at <w>any</w> time.",
                                "zh": "你们可以<w>任何</w>时间来我们家做客。",
                                "es": "Pueden venir a visitarnos a <w>cualquier</w> hora.",
                                "fr": "Vous pouvez venir nous rendre visite à <w>n'importe quelle</w> heure."
                            }
                        }
                    ],
                    "synonyms": [
                        "всякий",
                        "каждый"
                    ],
                    "antonyms": [
                        "никакой",
                        "ни один"
                    ],
                    "common_phrases": [
                        "в любом случае",
                        "любой ценой",
                        "в любое время"
                    ],
                    "target_lang_definitions": {
                        "en": "Whichever one; no matter which; any kind of.",
                        "zh": "指代任何一个，无论哪一个；不加选择的。",
                        "es": "Cualquiera, sin importar cuál; que no se distingue de otros.",
                        "fr": "Indique une personne ou une chose indifféremment, sans distinction ; n'importe lequel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "any",
                                "target_lang_sense_clarification": "no matter which"
                            },
                            {
                                "target_lang_word": "every",
                                "target_lang_sense_clarification": "all members of a group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何",
                                "target_lang_sense_clarification": "指代任何一个，不加限制"
                            },
                            {
                                "target_lang_word": "无论什么",
                                "target_lang_sense_clarification": "强调不加选择"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cualquier",
                                "target_lang_sense_clarification": "usado antes de un sustantivo singular"
                            },
                            {
                                "target_lang_word": "cualquiera",
                                "target_lang_sense_clarification": "usado como determinante o pronombre"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "n'importe quel",
