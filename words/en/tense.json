                    "sense_id": "5f773c34-ad76-347e-994b-eefec218ef9c",
                    "sense_definition": "Showing signs of stress or strain; not relaxed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stress_strain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to relax because all this work is making you <w>tense</w>.",
