                                        "glosses": [
                                            "Land in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "092b52fb-e5a3-4883-8461-c018cb668ed4",
                                                "sense_id": "b62e84cc-6f09-3339-9209-924efb0810ff",
                                                "text": "„In allen Teilen Perus ist die Vogelfauna sehr vielfältig.“"
                                            },
                                            {
                                                "example_id": "2954cf62-65c0-4a75-9b05-bde7a9d2a990",
                                                "sense_id": "b62e84cc-6f09-3339-9209-924efb0810ff",
                                                "text": "Lima ist die Hauptstadt von Peru."
                                            },
                                            {
                                                "example_id": "5163bd64-1c8f-4ba3-90b7-f8f9a9f071b8",
                                                "sense_id": "b62e84cc-6f09-3339-9209-924efb0810ff",
                                                "text": "„In der zeitgenössischen Kunst wird das Peru des 20. Jahrhunderts demonstrativ mit Mitteln der indianischen Kunst interpretiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
