                        "examples": [
                            {
                                "example_id": "e1edbd75-ca85-4695-a023-ff265d49fe85",
                                "sense_id": "3595b8a8-6426-32a4-a83a-9a0e9d23b1fe",
                                "text": "De naam Bij Flip komt van de uitbater, Ronald Philippa, die bij velen bekend staat als Flip, zo legt Tom Kuijpers, de andere uitbater, uit. „We hebben voor de naamsverandering gekozen omdat we niet langer als CP door het leven wilden gaan."
                            },
                            {
                                "example_id": "7e6fb0a8-c9e2-4fce-a93f-0c754c442ca8",
                                "sense_id": "3595b8a8-6426-32a4-a83a-9a0e9d23b1fe",
                                "text": "Nu het ijzer al vele jaren steenkoud is, lijkt de enig mogelijke naamsverandering Johan Cruijff Arena/Stadion te zijn. De naam van Cruijff roept nu allerwege sympathie op en zal dus indirect voor extra inkomsten zorgen. Zowel het sentiment als de kassa willen Johan Cruijff."
                            }
                        ]
                    }
