                "senses": [
                    {
                        "sense_id": "79a1b955-a2a8-3a9f-a754-9b9ca04f19b4",
                        "entry_id": "119c8ab2-9261-3d34-8e0a-3dc72307466a",
                        "glosses": [
                            "Allemand."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "899bfd3e-2d99-47a0-be5a-5e05b0883195",
                                "sense_id": "79a1b955-a2a8-3a9f-a754-9b9ca04f19b4",
                                "text": "Quand même, c'est les partisans schleus qui ont fait sauter l’half-track du peloton avec un bazouka."
                            },
                            {
                                "example_id": "72553ec9-1890-457f-ae17-6a39ff5d0df5",
                                "sense_id": "79a1b955-a2a8-3a9f-a754-9b9ca04f19b4",
                                "text": "Un jour, un officier schleu le remarque et passe plusieurs fois près de notre gars. Il s'arrête, le regarde travailler et lui fait des sourires. Notre brave gars était tout ébahi et à la pause nous raconta les faits et gestes de l'officier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50180b96-b916-4c3f-8c03-b972d97e5e34",
                        "source_entry_id": "119c8ab2-9261-3d34-8e0a-3dc72307466a",
                        "source_sense_id": "79a1b955-a2a8-3a9f-a754-9b9ca04f19b4",
                        "target_lang_word": "Kraut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
