                "senses": [
                    {
                        "sense_id": "608e98b6-6f4b-391f-8c13-c3eba23e8483",
                        "entry_id": "3dbcbca6-d5d8-38de-835e-1d6b1e6388de",
                        "glosses": [
                            "Fixer (l’éclairage, les réflexions, etc.) dans la texture d’un objet afin d’améliorer les performances de rendu."
                        ],
                        "tags": [
                            "Graphisme"
                        ],
                        "examples": [
                            {
                                "example_id": "83149c1b-c1ae-45c4-82c8-d8a866c89a02",
                                "sense_id": "608e98b6-6f4b-391f-8c13-c3eba23e8483",
                                "text": "Voilà je modélise en ce moment un bâtiment pour un jeu et j'aimerais savoir comment baker les ombres avec blender, je savais le faire avec la version antérieure mais quand je refais les mêmes manips, il me dit \"no objects or images found to bake to\""
                            },
                            {
                                "example_id": "82f44583-bd49-40b3-b5f9-303ac28fb24a",
                                "sense_id": "608e98b6-6f4b-391f-8c13-c3eba23e8483",
                                "text": "J'aurais voulu savoir comment baker un PTC en mode color bleeding mais avec la possibilité de pouvoir faire du multi-bounce ?"
                            },
                            {
                                "example_id": "b6a7245f-c1f6-4ef8-a988-ed39b5113077",
                                "sense_id": "608e98b6-6f4b-391f-8c13-c3eba23e8483",
                                "text": "Je m'explique, après avoir passé plusieurs heures de recherche pour savoir comment faire pour baker sa texture, je bloque sur son texturing !"
                            }
                        ]
                    }
                ],
