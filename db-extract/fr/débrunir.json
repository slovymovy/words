                "senses": [
                    {
                        "sense_id": "d3f872e9-7887-3a39-8ad4-032ec8a2bac3",
                        "entry_id": "c82f7728-a860-3ae6-af94-49f4cf36597d",
                        "glosses": [
                            "Faire perdre sa couleur brune à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "695d2e7f-57e1-4a64-88a0-f8e1fead1adc",
                                "sense_id": "d3f872e9-7887-3a39-8ad4-032ec8a2bac3",
                                "text": "La vapeur a été sans influence pour changer le ton de la couleur des étoffes, mais alors elle peut brunir la couleur ou la débrunir, changer la couleur de la gamme."
                            },
                            {
                                "example_id": "b6e2b842-0956-46ef-aecc-309971821985",
                                "sense_id": "d3f872e9-7887-3a39-8ad4-032ec8a2bac3",
                                "text": "Toutefois après la teinture et la dessiccation des étoffes, on les passe en acide pour les débrunir."
                            },
                            {
                                "example_id": "56ff925b-69d2-4ecf-937a-0e85c5d9d4b9",
                                "sense_id": "d3f872e9-7887-3a39-8ad4-032ec8a2bac3",
                                "text": "25 novembre 1940 – J’ai débruni et pris mon teint d’hiver, brouillé, parfois boutonneux."
                            }
                        ]
                    }
