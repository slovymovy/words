                {
                    "sense_id": "3261f272-b3e7-3192-bedd-c94e2ff1755a",
                    "sense_definition": "To hug or embrace someone affectionately around the neck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother reached down to <w>coll</w> her weeping child in her arms.",
                            "target_lang_translations": {
                                "ru": "Мать наклонилась, чтобы <w>обнять за шею</w> своего плачущего ребенка."
                            }
                        },
                        {
                            "text": "In old romantic verses, lovers would often kiss and <w>coll</w> under the moonlight.",
                            "target_lang_translations": {
                                "ru": "В старинных романтических стихах влюбленные часто целовались и <w>обнимались</w> при лунном свете."
                            }
