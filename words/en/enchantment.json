{
    "word_family": [
        "enchant",
        "enchanter",
        "enchanting",
        "enchanted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6478298-e588-3e33-99b7-9238a9d6ed5a",
                    "sense_definition": "A feeling of great pleasure, delight, or fascination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched the fireworks with a sense of pure <w>enchantment</w>.",
                            "target_lang_translations": {
                                "ru": "Дети смотрели на фейерверк с чувством чистого <w>очарова́ния</w>."
                            }
                        },
                        {
                            "text": "She fell under the <w>enchantment</w> of the beautiful mountain scenery.",
                            "target_lang_translations": {
                                "ru": "Она попала под <w>очарова́ние</w> прекрасного горного пейзажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "delight",
                        "fascination",
                        "charm"
                    ],
                    "common_phrases": [
                        "sense of enchantment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство огромного удовольствия, восторга или очарования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очарова́ние",
                                "target_lang_sense_clarification": "состояние восхищения или притягательная сила чего-либо"
                            },
                            {
                                "target_lang_word": "восто́рг",
                                "target_lang_sense_clarification": "сильное чувство радости и восхищения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e08b8e-296d-3c36-8037-e01c15dafbef",
                    "sense_definition": "A magical spell or charm used to influence or control someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch cast an <w>enchantment</w> over the sleeping prince.",
                            "target_lang_translations": {
                                "ru": "Ведьма наложила <w>заклина́ние</w> на спящего принца."
                            }
                        },
                        {
                            "text": "He tried to break the <w>enchantment</w> with a powerful counter-spell.",
                            "target_lang_translations": {
                                "ru": "Он попытался снять <w>волшебство́</w> с помощью мощного контрзаклинания."
                            }
                        }
                    ],
                    "synonyms": [
                        "spell",
                        "charm",
                        "hex"
                    ],
                    "common_phrases": [
                        "cast an enchantment",
                        "break the enchantment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магическое заклинание или чары, используемые для влияния на кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волшебство́",
                                "target_lang_sense_clarification": "магическое действие или чары"
                            },
                            {
                                "target_lang_word": "заклина́ние",
                                "target_lang_sense_clarification": "магические слова или формула, имеющие силу"
                            },
                            {
                                "target_lang_word": "колдовство́",
                                "target_lang_sense_clarification": "магические приемы или чары"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}