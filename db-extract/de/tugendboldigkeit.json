                "senses": [
                    {
                        "sense_id": "0fea8e56-1f4f-3c9a-96bd-e7b6aee671cf",
                        "entry_id": "1b7bcb66-2e39-3971-80b4-ea00716b4f4b",
                        "glosses": [
                            "Verhalten, mit dem man sich überzogen als Eiferer für Sittsamkeit präsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af36e408-9087-496d-9ed5-50b2caf3885d",
                                "sense_id": "0fea8e56-1f4f-3c9a-96bd-e7b6aee671cf",
                                "text": "„Man schweigt sie tot, wenn man überhaupt der Mühe sich unterzogen hat, sie kennenzulernen, weil man mit ihr nichts anzufangen weiß, oder aus possierlicher Tugendboldigkeit.“"
                            },
                            {
                                "example_id": "c90288f4-1155-47eb-9856-f3bc8ee307fe",
                                "sense_id": "0fea8e56-1f4f-3c9a-96bd-e7b6aee671cf",
                                "text": "„Vor fünf Jahren vom Autor wegen eines Theaterskandals in Paris fürs Ausland gesperrt, kam diese Abrechnung mit französischer Tugendboldigkeit jetzt doch nach Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
