                ],
                "senses": [
                    {
                        "sense_id": "f0b81156-418c-350f-a1d1-727b28ce82ab",
                        "entry_id": "4a831a44-a418-30a0-ad9d-be9b52dd8777",
                        "glosses": [
                            "Donner un caractère périurbain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51639695-8986-4f97-88b9-688364546696",
                                "sense_id": "f0b81156-418c-350f-a1d1-727b28ce82ab",
                                "text": "C'est l'explosion de l'immigration en Angleterre qui rend la crise du logement aiguë et impose de périurbaniser les campagnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "beef3d16-a3c8-3a3d-beaa-4ad1d2b4fd6b",
                        "entry_id": "4a831a44-a418-30a0-ad9d-be9b52dd8777",
                        "glosses": [
                            "Prendre un caractère périurbain."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1b6cf52b-46ba-4544-9b85-eb3bcb8a1fff",
                                "sense_id": "beef3d16-a3c8-3a3d-beaa-4ad1d2b4fd6b",
                                "text": "Le cas de Chavannes est celui d'un village en train de se périurbaniser, peuplé d'habitants au mode de vie plus banlieusard que rural."
                            },
                            {
                                "example_id": "871dac8a-03fd-48f9-9235-0a0d39a958b3",
                                "sense_id": "beef3d16-a3c8-3a3d-beaa-4ad1d2b4fd6b",
                                "text": "Dans ce scénario, les villes continuent à s'étendre et les campagnes à se périurbaniser."
                            },
                            {
                                "example_id": "d9f94339-41ce-428a-84b6-c054918a5eae",
                                "sense_id": "beef3d16-a3c8-3a3d-beaa-4ad1d2b4fd6b",
                                "text": "Dans les années 90, la France a continué à s'urbaniser et se « périurbaniser »."
                            }
                        ]
                    }
