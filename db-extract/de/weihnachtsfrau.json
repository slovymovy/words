                "senses": [
                    {
                        "sense_id": "ba7e2053-2ebb-3b9c-846c-371ecc8a7a0b",
                        "entry_id": "f544ec02-f486-38ae-a88b-2a5b41839aa3",
                        "glosses": [
                            "Frau, die die traditionell dem Weihnachtsmann zugeschriebene Rolle einnimmt oder so verkleidet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8cec942-0718-4301-8fed-5814a8a13112",
                                "sense_id": "ba7e2053-2ebb-3b9c-846c-371ecc8a7a0b",
                                "text": "„Aber eine Weihnachtsfrau ist der richtige Ansatz, wir haben nur das Problem, dass nicht genug Väter mit Kindern kommen!“"
                            },
                            {
                                "example_id": "c01dde6e-11df-4c28-be43-2b30642ee908",
                                "sense_id": "ba7e2053-2ebb-3b9c-846c-371ecc8a7a0b",
                                "text": "„Seid ihr Weihnachtsfrauen? Kennt ihr den Weihnachtsmann? Könnt ihr ihm einen Brief mitgeben?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
