                                        "sense_id": "b2aed151-0dee-358a-a2d1-49073af1b109",
                                        "entry_id": "5af918d9-bc19-3455-82a3-5ffc3242b228",
                                        "glosses": [
                                            "Dated spelling of jail."
                                        ],
                                        "tags": [
                                            "UK",
