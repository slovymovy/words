                    {
                        "sense_id": "84458d3d-8aeb-308a-8bba-bd3fb92dd465",
                        "entry_id": "89b19111-dd8b-3509-8a69-43979a17b1e5",
                        "glosses": [
                            "Agrémenter de rhum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f7ea19-9b3b-4657-acbc-089711ee9aa0",
                                "sense_id": "84458d3d-8aeb-308a-8bba-bd3fb92dd465",
                                "text": "mais ma \"mamie de Bretagne\" (aucun lien de parenté, juste affectif) avait la main assez lourde (et de + en + avec les années) quand il s'agissait de rhumiser son far)"
                            },
                            {
                                "example_id": "2c6a3c9d-a9df-4de9-a0a6-19597d9cb8b8",
                                "sense_id": "84458d3d-8aeb-308a-8bba-bd3fb92dd465",
                                "text": "Je connais le chemin des apothicaires et je citronnise, miellise, rhumise à tout va!"
                            },
                            {
                                "example_id": "c7067db7-b005-4c69-86ce-9d488b4f1433",
                                "sense_id": "84458d3d-8aeb-308a-8bba-bd3fb92dd465",
                                "text": "Sur fond de musique cubaine, l'audience hispano-bobo se désaltère en se faisant brumiser la face et rhumiser le petit palais sous l’immense verrière du Grand."
                            }
                        ]
                    }
