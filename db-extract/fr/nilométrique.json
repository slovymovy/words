                        "glosses": [
                            "Qui a rapport au nilomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a611b5-d5f0-4e26-94aa-0a3b252ee389",
                                "sense_id": "07b64fe8-fba5-31d7-a549-2e7b8de30da6",
                                "text": "La coudée nilométrique."
                            },
                            {
                                "example_id": "e734ae30-02c8-4e10-a9c9-00ba804ac292",
                                "sense_id": "07b64fe8-fba5-31d7-a549-2e7b8de30da6",
                                "text": "Le zéro nilométrique fut, je pense, fixé localement sur une hauteur moyenne de la nappe phréatique dans des temps très anciens de l’époque pharaonique."
                            },
                            {
                                "example_id": "f5fbf247-3bf6-4225-8597-f022f1830bd8",
                                "sense_id": "07b64fe8-fba5-31d7-a549-2e7b8de30da6",
                                "text": "Cependant, le nilomètre a été un instrument de pouvoir parce que l’épaisseur du temps écoulé entre la lecture des chiffres sur l’échelle nilométrique et les conséquences qu’on pouvait en déduire pour l’abondance des récoltes, laissait place à la réflexion, à l’organisation c’est-à-dire à l’exercice du pouvoir à moyen terme."
                            }
                        ]
                    }
