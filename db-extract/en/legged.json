    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c8a7ccd7-9ea6-3b81-a6d1-ce736937e1a3",
                "word": "legged",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b3dea3c-cfb0-3398-b28d-95568f9907ef",
                        "entry_id": "c8a7ccd7-9ea6-3b81-a6d1-ce736937e1a3",
                        "glosses": [
                            "Having legs of a certain specified type or number."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a59827e-0678-47e8-af6c-225fdb9c9a50",
                                "sense_id": "8b3dea3c-cfb0-3398-b28d-95568f9907ef",
                                "text": "Many of the big African spiders are hairy-legged."
                            },
                            {
                                "example_id": "5b62167b-d6fe-4cfa-b359-490c30667272",
                                "sense_id": "8b3dea3c-cfb0-3398-b28d-95568f9907ef",
                                "text": "Giraffes are the longest-legged animals."
                            },
                            {
                                "example_id": "6e7150ea-3ae2-4707-9b0c-4985db0b7735",
                                "sense_id": "8b3dea3c-cfb0-3398-b28d-95568f9907ef",
                                "text": "The maltster, after having lain down in his clothes for a few hours, was now sitting beside a three-legged table, breakfasting off bread and bacon."
                            }
                        ]
                    },
                    {
                        "sense_id": "493bd8ea-1614-3414-be08-9ef448f62ab8",
                        "entry_id": "c8a7ccd7-9ea6-3b81-a6d1-ce736937e1a3",
                        "glosses": [
                            "Having legs; provided with legs."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "546df097-01e5-4190-aab6-11ed1cb55890",
                                "sense_id": "493bd8ea-1614-3414-be08-9ef448f62ab8",
                                "text": "A robot which runs at a speed of over 29mph has set a new land-speed record for legged robots"
                            },
                            {
                                "example_id": "2faec5e4-d1a8-4c6d-81a6-56c7d85d24e1",
                                "sense_id": "493bd8ea-1614-3414-be08-9ef448f62ab8",
                                "text": "Farther west in the Carabobo-Aragua region Kidder has been able to establish some culture succession and he reports several legged vessels."
                            },
                            {
                                "example_id": "df402ddf-1b84-4c03-a03b-d33c5f534958",
                                "sense_id": "493bd8ea-1614-3414-be08-9ef448f62ab8",
                                "text": "DARPA is supporting several legged vehicle programs at Carnegie-Mellon and Ohio State Universities"
                            },
                            {
                                "example_id": "3f165acf-47a0-4ab7-bae2-88bb41becbf4",
                                "sense_id": "493bd8ea-1614-3414-be08-9ef448f62ab8",
                                "text": "Beginning with his hopping robots at the MIT Leg Lab (Raibert, 1986), Marc Raibert has advanced the state of the art in legged robot control for practical application."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea2d296b-ce34-3e91-9054-4bf09d4b8186",
                        "entry_id": "c8a7ccd7-9ea6-3b81-a6d1-ce736937e1a3",
                        "glosses": [
                            "Wounded in the leg, especially as part of a hunt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0f046555-6fce-4097-b4dd-d28f3ccdb597",
                                "sense_id": "ea2d296b-ce34-3e91-9054-4bf09d4b8186",
                                "text": "Spring guns and man traps have been set for me, and I am legged!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
