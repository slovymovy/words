                                        "sense_id": "b64bcbe7-c3f5-3a32-a809-883dc4303fb4",
                                        "entry_id": "2911389e-29d3-3104-b1f8-799fb8f5b6bc",
                                        "glosses": [
                                            "Petit coussin où l’on met des parfums, des senteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734216e2-aed6-4a72-a902-f6067a6dee8e",
                                                "sense_id": "b64bcbe7-c3f5-3a32-a809-883dc4303fb4",
                                                "text": "Des sachets parfumés."
                                            }
