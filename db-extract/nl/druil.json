                                                "sense_id": "421d90b0-c679-3444-92da-0591d2f88201",
                                                "text": "Après trois kilomètres de tapecul nous arrivions enfin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885b5098-a79a-3923-9477-f6fe7d32a0bd",
                                        "entry_id": "19983d30-91d8-393b-be50-38fc476b238c",
                                        "glosses": [
                                            "Petite voile située à l’extrémité arrière d’une embarcation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
