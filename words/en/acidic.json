{
    "word_family": [
        "acid",
        "acidity",
        "acidify",
        "acidification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a05702bf-004a-3e9b-a654-8caa79535ccd",
                    "sense_definition": "Having a pH of less than 7, tasting sour, or having the chemical properties of an acid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Citrus fruits taste sour because they are naturally <w>acidic</w>.",
                            "target_lang_translations": {
                                "ru": "Цитрусовые кислые на вкус, потому что от природы обладают <w>кислой</w> средой."
                            }
                        },
                        {
                            "text": "Certain plants grow much better in <w>acidic</w> soil than in neutral ground.",
                            "target_lang_translations": {
                                "ru": "Некоторые растения растут в <w>кислой</w> почве гораздо лучше, чем в нейтральном грунте."
                            }
                        }
                    ],
                    "synonyms": [
                        "acid"
                    ],
                    "antonyms": [
                        "basic"
                    ],
                    "common_phrases": [
                        "acidic soil",
                        "acidic foods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий pH менее 7, кислый на вкус или обладающий свойствами кислоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислый",
                                "target_lang_sense_clarification": "о вкусе или среде (почва, среда)"
                            },
                            {
                                "target_lang_word": "кислотный",
                                "target_lang_sense_clarification": "с низким уровнем pH, содержащий кислоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64121b0-ebfa-3664-9680-d0f7ab1ba80a",
                    "sense_definition": "Of, relating to, or having the characteristics of an acid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist poured an <w>acidic</w> solution into the beaker to start the reaction.",
                            "target_lang_translations": {
                                "ru": "Учёный налил <w>кислотный</w> раствор в химический стакан, чтобы запустить реакцию."
                            }
                        },
                        {
                            "text": "Frequent exposure to <w>acidic</w> substances can wear away tooth enamel over time.",
                            "target_lang_translations": {
                                "ru": "Частое воздействие <w>кислых</w> веществ со временем может разрушать зубную эмаль."
                            }
                        }
                    ],
                    "synonyms": [
                        "acid"
                    ],
                    "common_phrases": [
                        "acidic solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к кислоте или имеющий характерные для неё свойства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислотный",
                                "target_lang_sense_clarification": "относящийся к кислоте (раствор, вещество)"
                            },
                            {
                                "target_lang_word": "кислый",
                                "target_lang_sense_clarification": "обладающий свойствами кислоты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a901b905-3dd2-389f-8959-d6a182648baa",
                    "sense_definition": "Describing igneous rocks containing a high percentage of silica.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Granite is a well-known example of an <w>acidic</w> igneous rock.",
                            "target_lang_translations": {
                                "ru": "Гранит — широко известный пример <w>кислой</w> магматической породы."
                            }
                        },
                        {
                            "text": "The volcanic eruption produced a thick flow of highly <w>acidic</w> lava.",
                            "target_lang_translations": {
                                "ru": "Извержение вулкана привело к образованию густого потока крайне <w>кислой</w> лавы."
                            }
                        }
                    ],
                    "antonyms": [
                        "basic"
                    ],
                    "common_phrases": [
                        "acidic rock",
                        "acidic lava"
                    ],
                    "target_lang_definitions": {
                        "ru": "В геологии: магматическая порода с высоким содержанием кремнезёма (более 65%)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислый",
                                "target_lang_sense_clarification": "о горных породах и магме с высоким содержанием диоксида кремния"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}