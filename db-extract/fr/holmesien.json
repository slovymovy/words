                ],
                "senses": [
                    {
                        "sense_id": "134f9129-7d97-3cb4-92b5-6ce562d73d20",
                        "entry_id": "ff6e0885-0e34-32a8-a2d0-d43d95ce41e8",
                        "glosses": [
                            "Qui caractérise ou évoque Sherlock Holmes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "abddcb39-e957-4e62-b0d3-5a825d7030b0",
                                "sense_id": "134f9129-7d97-3cb4-92b5-6ce562d73d20",
                                "text": "— Vous parlez comme un grand, dit la fille avec admiration.\n— Mon point de départ a été une remarque tout à fait sherlockienne, ou plutôt holmesienne : Maloney ne recevait jamais de lettre au château et postait toujours ses propres lettres au bureau de Corwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56351e1f-6db1-4ace-bcc8-26b9d16e4bbd",
                        "source_entry_id": "ff6e0885-0e34-32a8-a2d0-d43d95ce41e8",
                        "source_sense_id": "134f9129-7d97-3cb4-92b5-6ce562d73d20",
                        "target_lang_word": "Holmesian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holmesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "573757ef-372d-38e0-9534-9bb454e12c88",
                                        "entry_id": "95b7bb7a-be1f-3f20-bb33-619a9638198c",
                                        "glosses": [
                                            "Of or pertaining to the fictional detective Sherlock Holmes or his investigations, methods, or sayings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17dcc678-bd94-4a58-83c3-3933214ddc7c",
                                                "sense_id": "573757ef-372d-38e0-9534-9bb454e12c88",
                                                "text": "Holmesian powers of observation"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Holmesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a838733b-475e-3816-a6b7-b0c974d86d7f",
                                        "entry_id": "96515e7d-b36c-3996-b9c0-3942e3184d72",
                                        "glosses": [
                                            "A fan of the character Sherlock Holmes; one who studies or enjoys the Sherlock Holmes stories by Sir Arthur Conan Doyle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624a2064-9d4d-4ffd-91e9-21b2958e00c6",
                                                "sense_id": "a838733b-475e-3816-a6b7-b0c974d86d7f",
                                                "text": "So great a protest arose from 20,000 Holmesians, including Queen Victoria and her family, that Doyle revived the character in The Hound of the Baskervilles (1902), “The Adventure of the Empty House” (1903), and “The Adventure of the Second Stain” (1904)."
                                            },
                                            {
                                                "example_id": "52a05861-9752-42e4-9e0b-c8253eab4c49",
                                                "sense_id": "a838733b-475e-3816-a6b7-b0c974d86d7f",
                                                "text": "After the decision was made, a group of local Holmesians in charge of planning the exhibition decided to re-create the sitting room at 221b Baker Street."
                                            },
                                            {
                                                "example_id": "e8d3ea2e-562f-413c-843e-dcb66c7be8c9",
                                                "sense_id": "a838733b-475e-3816-a6b7-b0c974d86d7f",
                                                "text": "Sunday's episode, the first of three installments, is \"A Study in Pink,\" a nod to the 1887 Doyle novel \"A Study in Scarlet\" that introduced the Holmes character and a title that could be the equivalent of waving a red flag in front of traditional Holmesians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
