                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "artery",
                                "target_lang_sense_clarification": "major transport route"
                            },
                            {
                                "target_lang_word": "thoroughfare",
                                "target_lang_sense_clarification": "main road"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df63a1c-bf5a-3f6b-b073-dfd572b8ba70",
                    "sense_definition": "Een afzonderlijke, geïsoleerde stroomdraad binnen een elektrische kabel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke <w>ader</w> in de elektriciteitskabel heeft een andere kleur isolatie.",
                            "target_lang_translations": {
                                "en": "Each <w>core</w> in the electrical cable has a different color of insulation."
                            }
                        },
                        {
                            "text": "Je moet de koperen <w>ader</w> voorzichtig strippen voor de aansluiting.",
                            "target_lang_translations": {
                                "en": "You must carefully strip the copper <w>strand</w> for the connection."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geïsoleerde ader"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A separate, insulated wire within an electrical cable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "core",
                                "target_lang_sense_clarification": "individual wire in a cable"
                            },
                            {
                                "target_lang_word": "strand",
                                "target_lang_sense_clarification": "single wire"
                            },
                            {
                                "target_lang_word": "conductor",
                                "target_lang_sense_clarification": "electrical wire"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e084dbd3-66f9-3091-bf3a-911ed58bc851",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>aderen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ader</w> het oppervlak om het op marmer te laten lijken.",
                            "target_lang_translations": {
                                "en": "I <w>vein</w> the surface to make it look like marble."
                            }
                        },
                        {
                            "text": "Wanneer ik schilder, <w>ader</w> ik de achtergrond met een fijn penseel.",
                            "target_lang_translations": {
                                "en": "When I paint, I <w>grain</w> the background with a fine brush."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to grain' or 'to vein' (applying a pattern)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vein",
                                "target_lang_sense_clarification": "to apply a vein-like pattern"
                            },
                            {
                                "target_lang_word": "grain",
                                "target_lang_sense_clarification": "to paint a wood or marble pattern"
                            }
                        ]
                    }
                }
            ]
        }
