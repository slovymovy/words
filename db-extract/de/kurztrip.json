                "senses": [
                    {
                        "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                        "entry_id": "be8065b9-c124-3197-8334-2bbc0ea17145",
                        "glosses": [
                            "eintägige oder maximal wenige Tage dauernde Reise"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8775aaf8-1f53-4daf-8c03-0ec8538a632e",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Michaels Reise nach Franken wurde zu einem Kurztrip, denn schon am ersten Tag übermannte ihn das Heimweh."
                            },
                            {
                                "example_id": "b19c0cb6-61ac-45a6-9d22-f0596c7fe4c3",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Cassandra hat Holly zu einem Kurztrip nach Ankara eingeladen."
                            },
                            {
                                "example_id": "b94fa5f5-06c6-4888-8e8c-6cdd179506ec",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Als du anriefst, befand ich mich gerade auf einem Kurztrip in Bukarest."
                            },
                            {
                                "example_id": "c8074f7e-e986-42eb-87b9-dd55c6f15587",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Wir unternehmen nun endlich den lang geplanten Kurztrip nach Vlotho."
                            },
                            {
                                "example_id": "2cbc0f12-31e5-43cf-b257-85ce02adbee9",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Wer hat deinen Kurztrip nach Schneverdingen finanziert?"
                            },
                            {
                                "example_id": "e014d1db-e8a2-40e6-81d8-c0eded388504",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "Diesen schettrigen Anzug kann er unmöglich auf seinen Kurztrip nach Wladiwostok mitnehmen."
                            },
                            {
                                "example_id": "09b31033-9278-4549-96a4-49f3d501d1f5",
                                "sense_id": "1908fb76-0679-328f-b8ea-6dbff6e9bda4",
                                "text": "„Bei einem Kurztrip nach Südfrankreich musste ich mit einer Fischvergiftung ins Krankenhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
