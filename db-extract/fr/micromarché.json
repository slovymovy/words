                "senses": [
                    {
                        "sense_id": "eceba930-fb4c-3c4d-a323-01f281474a6e",
                        "entry_id": "1676e8a0-6cc5-3197-9aa4-b8425c4c623a",
                        "glosses": [
                            "Marché de très petite taille, petit environnement économique dans lequel il existe une offre et une demande transparentes de vendeurs et acheteurs."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "3eede4c5-6820-49de-8640-4c709f1c23ef",
                                "sense_id": "eceba930-fb4c-3c4d-a323-01f281474a6e",
                                "text": "En effet, chaque type de location représente à lui seul un micromarché spécifique avec ses propres prix en fonction des surfaces offertes."
                            },
                            {
                                "example_id": "668d0c12-0084-4469-b531-29984b1ba4c3",
                                "sense_id": "eceba930-fb4c-3c4d-a323-01f281474a6e",
                                "text": "La rédaction a choisi de vous proposer un dossier, intitulé « Où va le marché ? », avec des analyses sur les bilans et perspectives par classe d’actifs ; les micromarchés et les indicateurs à suivre."
                            },
                            {
                                "example_id": "991e4928-33e8-460d-afb7-d03c334e957d",
                                "sense_id": "eceba930-fb4c-3c4d-a323-01f281474a6e",
                                "text": "Mais cela fait dix ans qu’ils travaillent sur place. Ils connaissent tous les micromarchés, quartier par quartier."
                            }
                        ]
                    }
                ],
