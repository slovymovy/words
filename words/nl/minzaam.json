            "senses": [
                {
                    "sense_id": "697ab830-ab2f-38b5-b30d-3be221508aa3",
                    "sense_definition": "beleefd en vriendelijk tegen iemand die je als sociaal lager beschouwt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vriendelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koningin sprak op een <w>minzame</w> manier met de bedienden in de keuken.",
                            "target_lang_translations": {
                                "en": "The queen spoke in a <w>gracious</w> manner with the servants in the kitchen."
                            }
                        },
                        {
                            "text": "Hij gaf een <w>minzaam</w> knikje aan de voorbijgangers terwijl hij in zijn koets zat.",
                            "target_lang_translations": {
                                "en": "He gave an <w>affable</w> nod to the passers-by while sitting in his carriage."
                            }
                        }
                    ],
                    "synonyms": [
                        "vriendelijk",
                        "welwillend",
                        "minnelijk"
                    ],
                    "antonyms": [
                        "hooghartig",
                        "onvriendelijk"
                    ],
                    "common_phrases": [
                        "minzaam knikje",
                        "minzame glimlach",
                        "minzame manier"
                    ],
                    "target_lang_definitions": {
                        "en": "polite and friendly towards someone considered to be of lower social status"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affable",
                                "target_lang_sense_clarification": "friendly and easy to talk to, often from a position of authority"
                            },
                            {
                                "target_lang_word": "condescendingly kind",
                                "target_lang_sense_clarification": "showing kindness while implying superiority"
                            },
                            {
                                "target_lang_word": "gracious",
                                "target_lang_sense_clarification": "courteous and kind, especially towards subordinates"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8739194-bdbc-36f5-984d-ad9da74271c4",
                    "sense_definition": "vriendelijk en beminnelijk in de omgang",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vriendelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks zijn hoge positie bleef hij altijd een <w>minzaam</w> mens voor iedereen.",
                            "target_lang_translations": {
                                "en": "Despite his high position, he always remained an <w>amiable</w> person to everyone."
                            }
                        },
                        {
                            "text": "Zij begroette haar gasten met een <w>minzame</w> glimlach bij de deur.",
                            "target_lang_translations": {
                                "en": "She greeted her guests with a <w>genial</w> smile at the door."
                            }
                        }
                    ],
                    "synonyms": [
                        "hartelijk",
                        "innemend",
                        "vriendelijk"
                    ],
                    "antonyms": [
