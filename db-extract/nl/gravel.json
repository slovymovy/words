                                        "sense_id": "06f822cd-1f98-3455-bc60-46877103bbea",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A tennis court surface made of crushed stone, brick, shale, or other unbound mineral aggregate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5411fa5f-7de0-4213-8e4c-4cf6ce9c6439",
                                                "sense_id": "06f822cd-1f98-3455-bc60-46877103bbea",
                                                "text": "The French Open is played on clay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "The material of the human body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e0fc67-a79d-4d83-988b-78e7324bcb79",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "From clay we are made."
                                            },
                                            {
                                                "example_id": "299f1bfa-e493-46d4-84b1-9ef1d5607c27",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "Thine hands have made me and fashioned me together round about...thou hast made me as the clay."
                                            },
                                            {
                                                "example_id": "c289d8e1-9e60-4547-a918-d0987607bd6c",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "But now, O Lord, thou art our Father; we are the clay, and thou art our potter; and we are the work of thy hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c025d4-5b05-3843-ab23-6ed9609628fe",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A particle less than 3.9 microns in diameter, following the Wentworth scale."
                                        ],
