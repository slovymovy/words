                    "frequency": "Low",
                    "semantic_group_id": "grid_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuin is afgezet met een houten <w>raster</w> om de honden binnen te houden.",
                            "target_lang_translations": {
