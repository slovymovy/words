                "forms": [
                    {
                        "form_id": "7f9b8d31-3445-4621-86a9-22a51dac8cd2",
                        "entry_id": "cecbc71a-66c1-3790-91c0-896651962bbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "romarins"
                    },
                    {
                        "form_id": "9f5ca695-534b-4449-a66f-5bd988f02316",
                        "entry_id": "cecbc71a-66c1-3790-91c0-896651962bbd",
                        "tags": [],
                        "form": "roumarin"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                        "entry_id": "cecbc71a-66c1-3790-91c0-896651962bbd",
                        "glosses": [
                            "Arbuste aromatique méditerranéen, à feuilles persistantes sans pétiole, d’odeur très camphrée, aux fleurs bleu pâle à violet ou blanches, herbe condimentaire, plante mellifère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131a5647-0f38-42a0-82a5-e7adb2a506c4",
                                "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                                "text": "Une touffe de romarin."
                            },
                            {
                                "example_id": "6e9043aa-1f14-445f-92a0-a7ae95dcd5ad",
                                "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                                "text": "Le romarin est une plante qui croît dans nos régions méridionales et dans le Sud Tunisien qui fournissent l’essence la plus fine, et en Dalmatie, sur les côtes de l’Adriatique et en Espagne."
                            },
                            {
                                "example_id": "444ad9c4-ee7b-4733-b475-73473f4ec801",
                                "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                                "text": "J’avais fait ces réflexions, adossé à un pin où les petites cigales noires des collines, dans le parfum de la résine chaude, sciaient des roseaux bien secs, et je mâchais nerveusement une brindille de romarin."
                            },
                            {
                                "example_id": "d742a8bb-0a82-4735-b5db-aaa7c7327b53",
                                "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                                "text": "Pendant que nous mangions l’omelette aux tomates – délicieuse quand elle est froide – les côtelettes grésillaient sur une braise de romarin."
                            },
                            {
                                "example_id": "911ce1ec-07d3-4ef1-9a74-45da5ab8b63c",
                                "sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                                "text": "Mᵐᵉ Rezeau, qui n’a pas entendu, saisit le bout de romarin marinant dans une soucoupe sur la table de nuit et, avec une gravité appliquée, fouette l’air de trois petits coups qui font tomber quelques gouttes d’eau sur le drap à rabat de dentelle. Elle se tourne vers moi, puis se ravise, songeant sans doute à l’état de mes relations avec ma grand-mère, à moins que ce ne soit à l’état de mes relations avec le ciel. Elle repose le romarin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e991f28-12ea-42ef-9e92-f60c14fbd6f5",
                        "source_entry_id": "cecbc71a-66c1-3790-91c0-896651962bbd",
                        "source_sense_id": "dcc13f6f-def7-3bef-bfd6-08f490e5959c",
                        "target_lang_word": "Rosmarin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosmarin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                        "entry_id": "076d5307-8583-300c-909c-5104ff22261a",
                                        "glosses": [
                                            "immergrüner Strauch aus der Familie der Lippenblütengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d105fb1-6685-4176-9f94-05eca501a300",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "Rosmarin wird häufig zum Kochen verwendet."
                                            },
                                            {
                                                "example_id": "c54eeb63-4a66-4a53-8b2c-182f6bc843a6",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "Rosmarin ist ein häufiger Strauch der Macchia und der Garrigue."
                                            },
                                            {
                                                "example_id": "f937028c-f4a0-40f1-ac46-f708bd1c4dc2",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "„An diesem Tag im neuen Jahr hatte er Knoblauchzehen in das Fleisch gesteckt und den Braten mit einer Mischung aus geriebener Zitronenschale, Thymian, Rosmarin und Oregano bestrichen.“"
                                            },
                                            {
                                                "example_id": "b738fa46-9a88-4092-9567-7b67b9129c35",
                                                "sense_id": "a96b676b-e06a-38b1-9595-7651e65c7a09",
                                                "text": "„Unser Ziel sind die großen roten Tüten mit abgesaugtem Fett, das wir in die Paper Street schaffen, auslassen und mit Lauge und Rosmarin mischen werden, um es dann wieder genau den Leuten zu verkaufen, die dafür bezahlt haben, es sich absaugen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
