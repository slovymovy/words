                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3280791d-6dc9-4cb7-b363-293840e4d3bd",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "tags": [
