                        "sense_id": "dd137798-51b3-3b79-a575-f1f9ba116d3d",
                        "entry_id": "7695164c-45d4-3935-9c6a-89e9676550c8",
                        "glosses": [
                            "Spaßgesellschaft, oberflächliches Auftreten"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "baefebe4-5385-4bc8-8f9b-5a9070963b04",
                                "sense_id": "dd137798-51b3-3b79-a575-f1f9ba116d3d",
                                "text": "„Homepages: Kein Sauglattismus, bitte! Wer etwas auf sich hält, gestaltet eine eigene Homepage. Doch vieles, was Freizeitgestalter im Internet basteln, ist banal und langweilig.“"
                            },
                            {
                                "example_id": "bd5fde50-b371-4b8c-9634-f631a286f350",
                                "sense_id": "dd137798-51b3-3b79-a575-f1f9ba116d3d",
                                "text": "Dennoch: Ohne die Kraft einer utopischen Idee vermag ich nicht zu sehen, wie sich die Stadtplanung aus dem postmodernen \"Sauglattismus\" retten und irgend etwas zur Rettung des \"Projektes Stadt\" beitragen könnte."
                            },
                            {
                                "example_id": "e624b944-0dc9-42da-9e38-d7d2d022953a",
                                "sense_id": "dd137798-51b3-3b79-a575-f1f9ba116d3d",
                                "text": "Doch es kann und soll nicht Aufgabe einer ehrenamtlich betriebenen Anlage sein, den heute so verbreiteten «Sauglattismen» gewissermassen noch ein stellares Sahnehäubchen aufzusetzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
