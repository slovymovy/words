                    {
                        "sense_id": "99062a4a-3f2d-303a-9ab9-acc9ab26b9bf",
                        "entry_id": "fd9c74d8-d832-3042-bc3e-cb039d969121",
                        "glosses": [
                            "op een manier tekenen waarbij maat en vorm niet overeenkomen met de werkelijkheid, verkeerd weergeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca6f63c-846e-42d0-bf9b-7663f753c502",
                                "sense_id": "99062a4a-3f2d-303a-9ab9-acc9ab26b9bf",
                                "text": "De ontdekking werd gedaan met behulp van een nieuwe supercomputer en algoritmes om seismische gegevens te interpreteren. Die stellen energiebedrijven in staat op een sterk verbeterde manier geologische formaties in kaart te brengen. Wetenschappers kunnen nu voorbij zoutkoepels kijken die de seismische golven vertekenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb050967-d757-308d-8736-ec1afdaaf246",
                        "entry_id": "fd9c74d8-d832-3042-bc3e-cb039d969121",
                        "glosses": [
                            "iets (expres) verkeerd voorstellen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ec8435-8381-44cd-bb77-5c8c31bb0649",
                                "sense_id": "cb050967-d757-308d-8736-ec1afdaaf246",
                                "text": "Groningen kende in het laatst onderzochte jaar 2015 een kleine 240 inbraken in studentenhuizen, Utrecht telde er 115, Amsterdam 72, Leiden 37 en Zwolle 10. Dat lijkt niet echt schrikbarend, maar volgens de LSVB en het CCV is dit slechts het topje van de ijsberg: „De cijfers vertekenen, omdat bij één inbraak vaak meerdere kamers worden leeggehaald. In de praktijk zijn er dus veel meer slachtoffers.”"
                            }
                        ]
                    }
