                ],
                "senses": [
                    {
                        "sense_id": "d4f646cb-3f40-3e91-b5c8-4c9372a72c19",
                        "entry_id": "c90d3a89-e91a-3e08-8cb2-543f32597e97",
                        "glosses": [
                            "niet puur, verontreinigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05415a98-2723-4167-bd23-e73ce341feda",
                                "sense_id": "d4f646cb-3f40-3e91-b5c8-4c9372a72c19",
                                "text": "Hij had glycerine, waarvan hij wist dat ze onzuiver was, verkocht aan een geneesmiddelenproducent op Haïti."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0dfc168-7382-3627-8ebe-200ee62e433f",
                        "entry_id": "c90d3a89-e91a-3e08-8cb2-543f32597e97",
                        "glosses": [
                            "waar nog bedragen van afgetrokken moeten worden, bruto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99cdeb9e-1091-4987-83ed-d328e3bea51c",
                                "sense_id": "a0dfc168-7382-3627-8ebe-200ee62e433f",
                                "text": "Deze is aftrekbaar van de inkomstenbelasting voorzover het totaal aan giften dat u doet de 1% van uw onzuiver inkomen overtreft."
                            }
                        ]
                    },
                    {
                        "sense_id": "d55b2918-d2a2-3d87-83b2-e2380c82b757",
                        "entry_id": "c90d3a89-e91a-3e08-8cb2-543f32597e97",
                        "glosses": [
                            "afwijkend van de juiste waarde, hoogte, klank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7623e9-1544-473a-80e8-d36782eb0a77",
                                "sense_id": "d55b2918-d2a2-3d87-83b2-e2380c82b757",
                                "text": "Wanneer de violist evenwel onzuiver - zonder uitzondering te laag - intoneert en bovendien slechts schijnt te beschikken over een mager, zenuwachtig toontje, dan is het resultaat minder dan niets."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ea645b7-938d-3320-ab43-392bdc6c3926",
                        "entry_id": "c90d3a89-e91a-3e08-8cb2-543f32597e97",
                        "glosses": [
                            "moreel niet behoorlijk"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "edc2570a-3435-4be5-ada3-7c1865360b7f",
                                "sense_id": "3ea645b7-938d-3320-ab43-392bdc6c3926",
                                "text": "Voor de christenen betekende de haas zwakheid, snelheid en angst. Hij gold als een onzuiver dier, symbool van promiscuïteit en ongeremde voortplanting."
                            }
                        ]
                    }
                ],
