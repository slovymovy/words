                "forms": [],
                "senses": [
                    {
                        "sense_id": "5544ae21-80d8-3353-8c58-79c56d2eae7e",
                        "entry_id": "6cb584b8-add3-3384-a419-f59c115cdfa7",
                        "glosses": [
                            "dat wat in een (rang)ordening met 38 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90397b1a-93cc-4dfb-8399-408a7ffff482",
                                "sense_id": "5544ae21-80d8-3353-8c58-79c56d2eae7e",
                                "text": "Het is weer de achtendertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "2e05fafa-8f05-4184-9dc7-f7f2e2352c22",
                                "sense_id": "5544ae21-80d8-3353-8c58-79c56d2eae7e",
                                "text": "Haar negenendertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtendertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9b830d4-88b9-3d64-96eb-f6010ea5eb8e",
                        "entry_id": "6cb584b8-add3-3384-a419-f59c115cdfa7",
                        "glosses": [
                            "groep van 38 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac909eb-1d09-4cda-bef6-722b989bc694",
                                "sense_id": "c9b830d4-88b9-3d64-96eb-f6010ea5eb8e",
                                "text": "De achtendertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
