                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2b80f7-d19c-4df1-9458-9adcd8b15cab",
                                "sense_id": "d18bd98e-5865-3994-9491-c0ff3b20acc7",
                                "text": "De politie is op zoek naar het slachtoffer en wil spreken met getuigen. Ook is de politie op zoek naar de betrokken voertuigen: een donkerkleurig busje en vermoedelijk een witte Audi, een witte Mercedes en een witte Volkswagen Golf."
                            },
                            {
                                "example_id": "67c338e6-eacf-4b1d-87a5-00d30e41f0bc",
                                "sense_id": "d18bd98e-5865-3994-9491-c0ff3b20acc7",
                                "text": "De politie is in het onderzoek op zoek naar een kleine, donkerkleurige auto en vraagt getuigen die deze rond het tijdstip van de explosie gezien hebben om contact op te nemen."
                            }
                        ]
                    }
