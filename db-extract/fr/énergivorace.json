                "senses": [
                    {
                        "sense_id": "07bcfd41-2a03-3894-bc35-f71d8bc6c9f8",
                        "entry_id": "257253ff-4928-38b6-9c0e-851dd9ed45aa",
                        "glosses": [
                            "Celle ou celui qui consomme énormément d’énergie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7d45bd21-599e-48d7-8833-c6ba118c208b",
                                "sense_id": "07bcfd41-2a03-3894-bc35-f71d8bc6c9f8",
                                "text": "Chacun de nous gaspille beaucoup plus d’énergie qu'il ne le pense. Nous sommes donc tous des énergivoraces, sans le savoir."
                            },
                            {
                                "example_id": "3ab02f1f-e2fa-4a59-84b1-37a9cfd021eb",
                                "sense_id": "07bcfd41-2a03-3894-bc35-f71d8bc6c9f8",
                                "text": "Conduisons plus calmement. Évitons les débauches de lumière. En un mot, ne soyons plus des énergivoraces. Nous vivions aussi bien. Et nous préserverons notre avenir."
                            },
                            {
                                "example_id": "c85cd7d5-d40e-48c9-92b1-8f3f6a741e09",
                                "sense_id": "07bcfd41-2a03-3894-bc35-f71d8bc6c9f8",
                                "text": "Le syntagme figé « énergivoraces » apparaît dans une phrase de type coercitif : « Nous sommes tous des « énergivoraces ». Or ce type de contrainte est neutralisé par l'effet humoristique du néologisme."
                            }
                        ]
                    }
                ],
