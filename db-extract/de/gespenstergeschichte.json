                        "entry_id": "e18d14e0-1127-36ed-ab46-e6a5dea9bdac",
                        "glosses": [
                            "Erzählung über unheimliche Ereignisse, Gespenster oder ähnliche Figuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a8bdf5-0d9b-4fb6-8d05-ab85bff8ffba",
                                "sense_id": "d5526660-0943-3f0b-b9b6-4af9fcd83998",
                                "text": "„Ich glaube, meine Mutter konnte nicht einmal über Gespenstergeschichten lachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
