                "senses": [
                    {
                        "sense_id": "66c93372-3ba3-3db0-b558-0a8ba7e6200e",
                        "entry_id": "e4d9a6b3-71dd-3956-9968-18d77f1b9681",
                        "glosses": [
                            "Cesser d’envahir, libérer ce qu’on a envahi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e8e53c-be55-4756-bce3-8c42dbaa394d",
                                "sense_id": "66c93372-3ba3-3db0-b558-0a8ba7e6200e",
                                "text": "Ainsi quand Roscoff annonce à grand-peine l’intention de désenvahir la pièce de son fils, aussitôt Maryse redouble d’invectives sur l’incapacité de cet homme à tenir ses engagements."
                            },
                            {
                                "example_id": "3b5136ea-65d6-46c7-8be2-074a477e13b4",
                                "sense_id": "66c93372-3ba3-3db0-b558-0a8ba7e6200e",
                                "text": "Chaque millimètre qu’il désenvahit s’affole dans des pulsations extrêmes."
                            },
                            {
                                "example_id": "dbcea858-e651-4d76-a0e3-d283cc510f66",
                                "sense_id": "66c93372-3ba3-3db0-b558-0a8ba7e6200e",
                                "text": "Il lui faut vider sa pensée des intrusions de la journée, se désenvahir par ses propres moyens : créer le rien."
                            }
                        ]
                    }
                ],
