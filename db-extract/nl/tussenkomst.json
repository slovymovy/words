                    }
                ],
                "senses": [
                    {
                        "sense_id": "732da5f2-6489-32ee-80f7-32d0f64b830f",
                        "entry_id": "e5bb4796-0a97-3284-817b-8b3f37edd1ea",
                        "glosses": [
                            "het je ergens mee bemoeien, de interventie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ddabea-753e-47e1-97e6-a3bf8fd96781",
                                "sense_id": "732da5f2-6489-32ee-80f7-32d0f64b830f",
                                "text": "Door de tussenkomst van de politie bleef het toch rustig na de voetbalwedstrijd."
                            },
                            {
                                "example_id": "54cc0c40-abfb-4932-995d-e8d895b555fd",
                                "sense_id": "732da5f2-6489-32ee-80f7-32d0f64b830f",
                                "text": "Heiligen zijn gewone mensen die een vroom en voorbeeldig leven hebben geleid. Als ze door de Kerk heilig zijn verklaard, bevinden ze zich dicht bij God en kunnen een goed woordje bij Hem doen. Gelovige katholieken bidden op hun voorspraak en hopen dat door die tussenkomst hun gebed wordt verhoord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f74dcb4a-4565-4c0d-b77a-c8b5e48ac5f3",
                        "source_entry_id": "e5bb4796-0a97-3284-817b-8b3f37edd1ea",
                        "source_sense_id": "732da5f2-6489-32ee-80f7-32d0f64b830f",
                        "target_lang_word": "Eingriff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eingriff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deff1542-2cbb-357f-8b02-27262d1bd0a9",
                                        "entry_id": "4b9db3c3-05e0-3bf8-9271-22a39fe985f6",
                                        "glosses": [
                                            "medizinische Arbeit am Körper eines Menschen oder Tieres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60498fd6-cbf8-414f-bf7c-4dcd1f2b44f7",
                                                "sense_id": "deff1542-2cbb-357f-8b02-27262d1bd0a9",
                                                "text": "Medizinische Eingriffe enthalten immer ein gewisses Risiko."
                                            },
                                            {
                                                "example_id": "253bfa50-c9ea-4ba9-baa8-7351faf88d4e",
                                                "sense_id": "deff1542-2cbb-357f-8b02-27262d1bd0a9",
                                                "text": "[Schwangerschaftsabbrüche:] 2003 verzeichnete das Statistische Bundesamt noch etwa 2.050 […] Praxen und Kliniken, die den Eingriff durchführen. Ende 2020 waren es nur noch 1109."
                                            },
                                            {
                                                "example_id": "96bd798f-a007-4e5f-a2e0-d6faaaab8474",
                                                "sense_id": "deff1542-2cbb-357f-8b02-27262d1bd0a9",
                                                "text": "Vor dem notwendigen Eingriff am Herzen hat das Kind Angst."
                                            },
                                            {
                                                "example_id": "4ee7ae94-1aa5-416c-bd3e-55f6255c41a6",
                                                "sense_id": "deff1542-2cbb-357f-8b02-27262d1bd0a9",
                                                "text": "„Sie hat ihn beruhigt und getröstet und zum Arzt gebracht, der in seiner Praxis einen kleinen, unkomplizierten Eingriff vorgenommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c2e0257-f95e-3c85-969f-3de1ec782d53",
                                        "entry_id": "4b9db3c3-05e0-3bf8-9271-22a39fe985f6",
                                        "glosses": [
                                            "eine beliebige Aktion, das Eingreifen zur Unterbrechung oder zur Lenkung eines Ablaufs oder Geschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f089debb-0fd7-46ff-a262-ea81c0c73cda",
                                                "sense_id": "7c2e0257-f95e-3c85-969f-3de1ec782d53",
                                                "text": "Um die Bankräuber zu fassen, ist ein Eingriff der Polizei notwendig."
                                            },
                                            {
                                                "example_id": "87b68c7b-2984-41c8-98ad-081b96f0d2f9",
                                                "sense_id": "7c2e0257-f95e-3c85-969f-3de1ec782d53",
                                                "text": "„In Kontinentaleuropa und besonders in Frankreich betrachtet man die ersten Nachkriegsjahrzehnte, die von starken staatlichen Eingriffen geprägt waren, als eine segensreiche Zeit des Wachstums […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43e8c27e-6c18-386c-a73a-13019e10d70a",
                                        "entry_id": "4b9db3c3-05e0-3bf8-9271-22a39fe985f6",
                                        "glosses": [
                                            "das zielgerichtete und gewollte Handeln der öffentlichen Gewalt im Schutzbereich eines Grundrechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35de1c83-0e6c-4b9f-a1cb-0379e0afc511",
                                                "sense_id": "43e8c27e-6c18-386c-a73a-13019e10d70a",
                                                "text": "„Der in der Sicherungsverwahrung liegende, schwerwiegende Eingriff in das Freiheitsgrundrecht (Art. 2 Abs. 2 Satz 2 GG) ist nur nach Maßgabe strikter Verhältnismäßigkeitsprüfung und unter Wahrung strenger Anforderungen an die zugrundeliegenden Entscheidungen und die Ausgestaltung des Vollzugs zu rechtfertigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "948e304c-67a3-3338-8cfa-5e2d6227d18c",
                                        "entry_id": "4b9db3c3-05e0-3bf8-9271-22a39fe985f6",
                                        "glosses": [
                                            "Hosenschlitz der Herrenunterhose"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f66773-80f3-4a62-91d2-a42cdcc75b61",
                                                "sense_id": "948e304c-67a3-3338-8cfa-5e2d6227d18c",
                                                "text": "\"Viele Linkshänder fühlen sich diskriminiert: Immerhin befindet sich sogar bei Männerunterhosen der Eingriff grundsätzlich rechts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "debe359c-096b-4caa-8cab-f5375a108d40",
                        "source_entry_id": "e5bb4796-0a97-3284-817b-8b3f37edd1ea",
                        "source_sense_id": "732da5f2-6489-32ee-80f7-32d0f64b830f",
                        "target_lang_word": "intervention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intervention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "755cf7f6-f573-3556-b7e6-1bc3be5f5ea5",
                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "The action of intervening; interfering in some course of events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a492ee-c3ad-46eb-8241-149c117ae576",
                                                "sense_id": "755cf7f6-f573-3556-b7e6-1bc3be5f5ea5",
                                                "text": "Fernando Torres was recalled in place of the suspended Didier Drogba and he was only denied a goal in the opening seconds by Laurent Koscielny's intervention - a moment that set the tone for game filled with attacking quality and littered with errors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd45d83-887e-3368-af8b-0fb04b5db8e7",
                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "A legal motion through which a person or entity who has not been named as a party to a case seeks to have the court order that they be made a party."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1425daf2-15b1-35ff-9a4b-38fc75278865",
                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "An orchestrated attempt to convince somebody with an addiction or other psychological problem to seek professional help and/or change their behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "660d4b41-3ec5-3177-92fa-b1373d31d3ee",
                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "An action taken or procedure performed; an operation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74a41fd-153f-45bc-9d8a-7631e3861158",
                                                "sense_id": "660d4b41-3ec5-3177-92fa-b1373d31d3ee",
                                                "text": "As I showed, although some rhetoricians, such as Mesmer and Erb, claimed that their interventions were medical treatments, others, such as Freud and Jung, claimed that their interventions were both medical curings and spiritual carings."
                                            },
                                            {
                                                "example_id": "e21fc69e-0216-4d32-b078-28f9fbbd97fc",
                                                "sense_id": "660d4b41-3ec5-3177-92fa-b1373d31d3ee",
                                                "text": "“It goes with my mantra of there is ‘no magic pill’ to prevent cognitive decline,” said Isaacson, who was not involved in the new study. “At my clinic, we check nutritional blood measures and personally tailor interventions, and in doing so we don’t tend to recommend multivitamins since we address the individual deficiencies.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
