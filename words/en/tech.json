                            {
                                "target_lang_word": "技术合成",
                                "target_lang_sense_clarification": "舞台合成排练"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebc3ef3f-1e58-3987-a883-956d32d0ffcc",
                    "sense_definition": "A technical inspection of a vehicle, particularly in motorsports, to ensure it meets regulations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The race car failed <w>tech</w> because the tires were too worn.",
                            "target_lang_translations": {
                                "ru": "Гоночный автомобиль не прошел <w>техосмотр</w>, потому что шины были слишком изношены.",
                                "zh": "这辆赛车因为轮胎磨损严重而没能通过<w>技术检查</w>。"
                            }
                        },
                        {
                            "text": "Every driver must take their vehicle through <w>tech</w> before qualifying begins.",
                            "target_lang_translations": {
                                "ru": "Каждый водитель должен пройти <w>техническую комиссию</w> перед началом квалификации.",
                                "zh": "每位车手在排位赛开始前都必须让车辆通过<w>车检</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "technical inspection",
                        "scrutineering"
                    ],
                    "common_phrases": [
                        "pass tech",
                        "fail tech"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "motorsports jargon"
                        }
