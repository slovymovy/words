        "fr-extract.jsonl": [
            {
                "entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                "word": "pilaf",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db2dba3e-5f35-4c4d-8f80-90b2a72f662a",
                        "entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                        "tags": [
                            "plural"
                        ],
                        "form": "pilafs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                        "entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                        "glosses": [
                            "Riz cuit avec des morceaux de viande, de volaille ou de poisson et très épicé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de7eb55-982a-4210-af66-5607b530fb9e",
                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                "text": "Le pilaf est un mode de cuisson du riz originaire du Moyen-Orient et d’Asie Centrale."
                            },
                            {
                                "example_id": "7d9f6fa5-f32b-4a4f-9ba8-27f00622b32e",
                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                "text": "Le séjour en Turquie avait gravement attaqué ma santé ; la nourriture y était désirable et nocive. […] Les plus chanceux, les plus vigoureux d’entre les convives, guérissaient grâce à quelques journées de jeûne ; d’autres se voyaient terrassés par la qualité et l’abondance des pilafs aux pois chiches, des moules géantes, des dolmas : boulettes de riz farcies de chair de mouton et présentées dans des feuilles de vigne ; des aubergines gorgées d’huile, des pastèques glaciales."
                            },
                            {
                                "example_id": "25160b59-b9b2-4df6-941e-d65a1f4a450f",
                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                "text": "Riz pilaf."
                            },
                            {
                                "example_id": "816967a5-d905-4d7d-ab25-06332512dd23",
                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                "text": "Pilaf de poulet."
                            },
                            {
                                "example_id": "7943e067-118a-4b29-ba3c-329697c19ad2",
                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                "text": "Pilaf de homard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff2f77c8-8170-4a5c-b7e7-2ba93f3f5331",
                        "source_entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                        "source_sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                        "target_lang_word": "Pilaw",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pilaw",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0289af27-c10e-3d57-ac81-e4c1ae85dcd9",
                                        "entry_id": "44a20e8c-7f1a-33ca-a9c8-e0318daca833",
                                        "glosses": [
                                            "orientalisches Gericht in vielen Varianten mit körnigem Reis, der mit Fleisch (zum Beispiel Huhn, Lamm/Hammel) oder Fisch, Gemüse, Nüssen, Trockenfrüchten etc. gemischt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b234f9c-3cd0-4f9c-bf33-5bbd89c3e057",
                                                "sense_id": "0289af27-c10e-3d57-ac81-e4c1ae85dcd9",
                                                "text": "„Wenn Istanbuler ihre hamsi nicht pur vom Grill essen, dann oft auf Pilaw, dem türkischen Risotto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64ca8552-819e-48b8-a81b-011b5729fe61",
                        "source_entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                        "source_sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                        "target_lang_word": "pilaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c925aae-73b9-3da8-9c46-3c003c80023e",
                                        "entry_id": "a4eec175-a6bf-3eba-9702-15816b58996a",
                                        "glosses": [
                                            "A dish made by browning grain, typically rice, in oil and then cooking it with a seasoned broth, to which meat and/or vegetables may be added."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60ef8ae-cd03-40da-bea7-e8fb30cdd4d3",
                                                "sense_id": "6c925aae-73b9-3da8-9c46-3c003c80023e",
                                                "text": "My spirits rose as I passed among the tents and savored the aroma of steaming pots of pilaf and the long skewers of shashlyk roasting over the open fires."
                                            },
                                            {
                                                "example_id": "102324c5-1c8d-48b5-a230-a8b8eee1dbf1",
                                                "sense_id": "6c925aae-73b9-3da8-9c46-3c003c80023e",
                                                "text": "Charlie Vaughn, the tribal chairman, dismissed his critics at the opening as people who are \"eating tofu and pilaf and sitting in Phoenix with their plasma-screen TVs\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "345273b4-f9e6-4a4b-b0f1-3175f430c088",
                        "source_entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
