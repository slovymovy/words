                        "examples": [
                            {
                                "example_id": "de02a0e1-3b45-43f7-82dd-ae740584d6a4",
                                "sense_id": "d9c35942-eb91-3e0b-aada-4b7c0d696fe8",
                                "text": "W jego domu pełno jest oznak nowobogactwa: złote klamki, sztukateria na sufitach i łuki Karwowskiego."
                            },
                            {
                                "example_id": "36fca9f1-3178-457e-b26f-29bb369dc4d5",
                                "sense_id": "d9c35942-eb91-3e0b-aada-4b7c0d696fe8",
                                "text": "Nie lubię Krzyśka za jego nowobogactwo. Popisuje się nowymi samochodami, złotym zegarkiem, a słoma mu z butów wystaje."
                            }
                        ],
