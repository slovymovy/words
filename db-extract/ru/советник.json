                                "target_senses": [
                                    {
                                        "sense_id": "858c6d0f-6785-3f7e-ba54-abdb16b19bb5",
                                        "entry_id": "8f61b57e-f66f-3a92-a0dc-4ee6c7be2049",
                                        "glosses": [
                                            "One who advises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e8559b-399e-48be-b63c-8b770c55f9bf",
                                                "sense_id": "858c6d0f-6785-3f7e-ba54-abdb16b19bb5",
                                                "text": "“An adviser can provide you with clarity on where you are today, where you want to be in the future and how to bridge the space between,” said Andy Mardock, a certified financial planner, and founder and president of VivFi Planning."
                                            },
                                            {
                                                "example_id": "8f9884c1-e4f7-4c4c-80ac-946790debc60",
                                                "sense_id": "858c6d0f-6785-3f7e-ba54-abdb16b19bb5",
                                                "text": "The call, which is the first known conversation between the presidents since Trump assumed office last month, came as as^([sic]) Trump makes clear to his advisers he wants to bring the Ukraine conflict to a swift end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda319e1-35b0-3d44-a29d-fc819af1ac53",
                                        "entry_id": "8f61b57e-f66f-3a92-a0dc-4ee6c7be2049",
                                        "glosses": [
                                            "Ellipsis of class adviser."
                                        ],
