{
    "word_family": [
        "ethic",
        "ethical",
        "ethically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7aeb5c0e-db79-31fe-8798-da69f877fca0",
                    "sense_definition": "The system of moral principles or values that guide a person's behavior.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her decision was guided by her strong personal <w>ethics</w>.",
                            "target_lang_translations": {
                                "zh": "她的决定受到她坚定个人<w>道德</w>的指引。"
                            }
                        },
                        {
                            "text": "He has high <w>ethics</w> and always tells the truth.",
                            "target_lang_translations": {
                                "zh": "他有很高的<w>道德</w>修养，总是说实话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal ethics"
                    ],
                    "target_lang_definitions": {
                        "zh": "指导个人行为的道德原则或价值观体系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "道德",
                                "target_lang_sense_clarification": "指个人或社会遵循的道德准则。"
                            },
                            {
                                "target_lang_word": "伦理",
                                "target_lang_sense_clarification": "指行为的准则或道德规范。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29301f14-0431-337a-8101-01137d360650",
                    "sense_definition": "The set of rules or standards governing the conduct of members of a specific profession.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor teaches a course on business <w>ethics</w>.",
                            "target_lang_translations": {
                                "zh": "这位教授开设了一门关于商业<w>伦理</w>的课程。"
                            }
                        },
                        {
                            "text": "Medical <w>ethics</w> require doctors to prioritize patient welfare.",
                            "target_lang_translations": {
                                "zh": "医学<w>伦理</w>要求医生将患者的福祉放在首位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "business ethics",
                        "medical ethics",
                        "professional ethics"
                    ],
                    "target_lang_definitions": {
                        "zh": "规范特定职业成员行为的一套规则或标准。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "职业道德",
                                "target_lang_sense_clarification": "指特定行业内应遵守的道德规范。"
                            },
                            {
                                "target_lang_word": "伦理",
                                "target_lang_sense_clarification": "指专业领域内的行为准则。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "910ea00e-b0a4-3ef1-967a-6b3deaaea46d",
                    "sense_definition": "The branch of philosophy that studies principles of right and wrong conduct.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students in the philosophy department are required to take a class on <w>ethics</w>.",
                            "target_lang_translations": {
                                "zh": "哲学系的学生必须修读一门<w>伦理学</w>课程。"
                            }
                        },
                        {
                            "text": "The study of <w>ethics</w> helps us understand complex moral dilemmas.",
                            "target_lang_translations": {
                                "zh": "研究<w>伦理学</w>有助于我们理解复杂的道德困境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deontology",
                        "moral philosophy"
                    ],
                    "target_lang_definitions": {
                        "zh": "研究是非行为准则的哲学分支。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伦理学",
                                "target_lang_sense_clarification": "哲学的一个分支，专门研究道德问题。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8974790-078e-3168-bb40-df8782c84a39",
                    "sense_definition": "The plural form of <w>ethic</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has strong work <w>ethics</w> that help him succeed in his career.",
                            "target_lang_translations": {
                                "zh": "他有很强的<w>职业操守</w>，这帮助他在事业上取得了成功。"
                            }
                        },
                        {
                            "text": "Different cultures may have different <w>ethics</w> regarding social behavior.",
                            "target_lang_translations": {
                                "zh": "不同的文化在社会行为方面可能有不同的<w>道德准则</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "work ethics"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of ethic"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "ethic 的复数形式，常指工作态度或行为准则。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "道德准则",
                                "target_lang_sense_clarification": "指一系列的行为规范。"
                            },
                            {
                                "target_lang_word": "职业操守",
                                "target_lang_sense_clarification": "特指工作中的道德表现。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}