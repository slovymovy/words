                        "translation_id": "ac9d1edb-1e6d-48b3-afb2-d55de453360e",
                        "source_entry_id": "32ed04e3-ffc2-3aec-8573-137272a7a586",
                        "source_sense_id": "a103e6fe-d92c-3819-8f31-91a8076d140c",
