    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc26673c-a631-31c2-a71c-9452f584bb13",
                    "sense_definition": "To live or reside in a specific place, such as a house, apartment, or room.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family has <w>occupied</w> this farmhouse for over fifty years.",
                            "target_lang_translations": {
                                "ru": "Семья <w>занимает</w> этот фермерский дом уже более пятидесяти лет.",
                                "zh": "这家人在这座农舍里已经<w>住</w>了五十多年。"
                            }
                        },
                        {
                            "text": "Most of the apartments in the building are <w>occupied</w> by students.",
                            "target_lang_translations": {
                                "ru": "Большинство квартир в этом здании <w>заняты</w> студентами.",
                                "zh": "这栋楼里的大多数公寓都<w>住</w>着学生。"
                            }
                        }
                    ],
                    "antonyms": [
                        "vacate"
                    ],
                    "common_phrases": [
                        "occupy a house",
                        "occupy a room",
                        "owner-occupied"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить или проживать в определенном месте, например, в доме, квартире или комнате.",
                        "zh": "居住在某个特定的地方，如房屋、公寓或房间里。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "помещение, жилплощадь"
                            },
                            {
                                "target_lang_word": "заня́ть",
                                "target_lang_sense_clarification": "помещение, жилплощадь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居住",
                                "target_lang_sense_clarification": "居住在房屋、公寓、房间等处"
                            },
                            {
                                "target_lang_word": "住",
                                "target_lang_sense_clarification": "较口语，表示住在某处"
                            },
                            {
                                "target_lang_word": "入住",
                                "target_lang_sense_clarification": "强调长期占用并居住某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72a70104-b9c5-336d-ba69-66471c2ad0c5",
                    "sense_definition": "To fill or take up a specific amount of physical space or time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fill_extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large dining table <w>occupies</w> most of the living room.",
                            "target_lang_translations": {
                                "ru": "Большой обеденный стол <w>занимает</w> большую часть гостиной.",
                                "zh": "这张大餐桌<w>占</w>了客厅的大部分空间。"
                            }
                        },
                        {
                            "text": "Preparing for the final exam <w>occupied</w> her entire weekend.",
                            "target_lang_translations": {
                                "ru": "Подготовка к выпускному экзамену <w>заняла</w> у нее все выходные.",
                                "zh": "准备期末考试<w>占</w>了她整个周末的时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fill",
                        "take up"
                    ],
                    "common_phrases": [
                        "occupy space",
                        "occupy time",
                        "occupy a position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнять или занимать определенное физическое пространство или время.",
                        "zh": "占去或填满一定的物理空间或时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "место, время"
                            },
                            {
                                "target_lang_word": "заня́ть",
                                "target_lang_sense_clarification": "место, время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占",
                                "target_lang_sense_clarification": "占据空间、时间、位置等"
                            },
                            {
                                "target_lang_word": "占据",
                                "target_lang_sense_clarification": "较正式，指占去一定空间或时间"
                            },
                            {
                                "target_lang_word": "占用",
                                "target_lang_sense_clarification": "常用于空间、篇幅、时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2b5f68-d488-3b9a-8a14-2d38eb679643",
                    "sense_definition": "To keep someone busy or hold their attention; to engage oneself in an activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "engage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>occupied</w> herself with gardening while waiting for the guests.",
                            "target_lang_translations": {
                                "ru": "Она <w>занималась</w> садоводством в ожидании гостей.",
                                "zh": "她在等客人时以园艺来<w>消磨</w>时间。"
                            }
                        },
                        {
                            "text": "The puzzle <w>occupied</w> the children for several hours.",
                            "target_lang_translations": {
                                "ru": "Пазл <w>занял</w> детей на несколько часов.",
                                "zh": "这个拼图让孩子们<w>忙</w>了好几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "busy",
                        "employ"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "occupy oneself",
                        "keep occupied",
                        "occupy one's mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать кого-либо делом или удерживать чье-либо внимание.",
                        "zh": "让某人忙于某事或吸引其注意力；使自己投入某项活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "внимание, делом"
                            },
                            {
                                "target_lang_word": "заня́ть",
                                "target_lang_sense_clarification": "внимание, делом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使忙于",
                                "target_lang_sense_clarification": "使人忙于某事、占住注意力"
                            },
                            {
                                "target_lang_word": "让……有事做",
                                "target_lang_sense_clarification": "让人一直有事做"
                            },
                            {
                                "target_lang_word": "消磨",
                                "target_lang_sense_clarification": "用于时间、等待等语境，指打发时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15af892-bb2f-3cfc-a704-6ed11f1deb10",
                    "sense_definition": "To take possession or control of a territory or place, usually by military force.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Enemy forces <w>occupied</w> the capital city for three years.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска <w>оккупировали</w> столицу в течение трех лет.",
                                "zh": "敌军<w>占领</w>了首都三年。"
                            }
                        },
                        {
                            "text": "The army was sent to <w>occupy</w> the border region to maintain order.",
                            "target_lang_translations": {
                                "ru": "Армия была направлена, чтобы <w>занять</w> приграничный регион для поддержания порядка.",
                                "zh": "军队被派去<w>占领</w>边境地区以维持秩序。"
                            }
                        }
                    ],
                    "antonyms": [
                        "liberate",
                        "withdraw"
                    ],
                    "common_phrases": [
                        "occupy territory",
                        "occupy a country",
                        "illegally occupied"
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватывать территорию или место, обычно с помощью военной силы.",
                        "zh": "通常通过军事力量占有并控制某块领土或某个地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оккупи́ровать",
                                "target_lang_sense_clarification": "территорию"
                            },
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "захватывать силой"
                            },
                            {
                                "target_lang_word": "завладева́ть",
                                "target_lang_sense_clarification": "брать под контроль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占领",
                                "target_lang_sense_clarification": "通常指军队占有并控制一地"
                            },
                            {
                                "target_lang_word": "占据",
                                "target_lang_sense_clarification": "较正式，指夺取并控制地区"
                            },
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "强调取得控制权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "146162c4-feb2-31aa-8280-a24550d34106",
                    "sense_definition": "To hold or fill an official position, role, or office.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He currently <w>occupies</w> the post of managing director.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>занимает</w> пост управляющего директора.",
                                "zh": "他目前<w>担任</w>总经理一职。"
                            }
                        },
                        {
                            "text": "Several women now <w>occupy</w> senior positions in the government.",
                            "target_lang_translations": {
                                "ru": "Несколько женщин сейчас <w>занимают</w> руководящие должности в правительстве.",
                                "zh": "目前有几位女性在政府中<w>担任</w>高级职务。"
                            }
                        }
                    ],
                    "antonyms": [
                        "vacate",
                        "resign"
                    ],
                    "common_phrases": [
                        "occupy a post",
                        "occupy a seat",
                        "occupy a role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать официальную должность, пост или роль.",
                        "zh": "担任某个正式职位、职务或角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занима́ть",
                                "target_lang_sense_clarification": "должность, пост"
                            },
                            {
                                "target_lang_word": "заня́ть",
                                "target_lang_sense_clarification": "должность, пост"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "担任",
                                "target_lang_sense_clarification": "担任某个职务、职位或角色"
                            },
                            {
                                "target_lang_word": "任",
                                "target_lang_sense_clarification": "较正式，指身居某职位"
                            },
                            {
                                "target_lang_word": "占据",
                                "target_lang_sense_clarification": "用于职位、席位、职务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5971f021-f722-38dd-86f4-ade5f38392f5",
                    "sense_definition": "To place a surveying instrument, such as a theodolite, over a specific point to make measurements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor needed to <w>occupy</w> the station on the hill to complete the map.",
                            "target_lang_translations": {
                                "ru": "Геодезисту нужно было <w>занять</w> станцию на холме, чтобы завершить карту.",
                                "zh": "测量员需要在山上的测站<w>架设仪器</w>，才能完成这张地图。"
                            }
                        },
                        {
                            "text": "We must <w>occupy</w> a known point to calibrate the total station.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>занять</w> известную точку для калибровки тахеометра.",
                                "zh": "我们必须在已知点上<w>架设仪器</w>，才能校准全站仪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (surveying)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать геодезический прибор над определенной точкой для проведения измерений.",
                        "zh": "把经纬仪等测量仪器安置在某个指定点上方以进行测量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устанавливать прибор над точкой",
                                "target_lang_sense_clarification": "геодез.: ставить теодолит над точкой для измерений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "架设仪器",
                                "target_lang_sense_clarification": "测量学，指把仪器安置在测点上方"
                            },
                            {
                                "target_lang_word": "在测点上设站",
                                "target_lang_sense_clarification": "测量学，指在已知点或测站上安置测量仪器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ea3feb-edab-3421-a88c-3c8bf254a11c",
                    "sense_definition": "To have sexual intercourse with someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_vulgar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older literature, the word was sometimes used to mean he <w>occupied</w> his mistress.",
                            "target_lang_translations": {
                                "ru": "В старой литературе это слово иногда использовалось в значении, что он <w>совокуплялся</w> со своей любовницей.",
                                "zh": "在较早的文学作品中，这个词有时用来表示他与情妇<w>发生性关系</w>。"
                            }
                        },
                        {
                            "text": "The playwright made a pun on the word <w>occupy</w> which was considered vulgar at the time.",
                            "target_lang_translations": {
                                "ru": "Драматург сделал каламбур на слове <w>occupy</w>, которое в то время считалось вульгарным.",
                                "zh": "这位剧作家拿<w>occupy</w>一词做了双关，而这在当时被认为很粗俗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep with",
                        "go to bed with",
                        "copulate with"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "formerly common, now archaic or historical"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "vulgar usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь половую связь с кем-либо.",
                        "zh": "与某人发生性关系。此义现已古旧，且带粗俗色彩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совокупляться",
                                "target_lang_sense_clarification": "устар./эвф.: вступать в половую связь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发生性关系",
                                "target_lang_sense_clarification": "古旧、粗俗用法，指与某人发生性关系"
                            },
                            {
                                "target_lang_word": "性交",
                                "target_lang_sense_clarification": "较书面或旧式说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b96344ac-fafd-3d22-8065-cb3c417bb892",
                    "sense_definition": "A protest movement against economic inequality, specifically 'Occupy Wall Street'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "ideology_or_movement_name",
                    "examples": [
                        {
                            "text": "The <w>Occupy</w> movement drew attention to the wealth gap in the country.",
                            "target_lang_translations": {
                                "ru": "Движение <w>Occupy</w> (Захвати) привлекло внимание к разрыву в благосостоянии в стране.",
                                "zh": "<w>占领运动</w>让人们关注到该国的贫富差距。"
                            }
                        },
                        {
                            "text": "Many students participated in <w>Occupy</w> protests during that year.",
                            "target_lang_translations": {
                                "ru": "Многие студенты участвовали в протестах <w>Occupy</w> в том году.",
                                "zh": "那一年，许多学生参加了<w>占领运动</w>的抗议活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "OWS"
                    ],
                    "common_phrases": [
                        "Occupy Wall Street",
                        "Occupy movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протестное движение против экономического неравенства, в частности «Захвати Уолл-стрит».",
                        "zh": "反对经济不平等的抗议运动，尤其指“占领华尔街”运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Occupy",
                                "target_lang_sense_clarification": "движение против неравенства (Occupy Wall Street)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占领运动",
                                "target_lang_sense_clarification": "指“占领华尔街”及相关反经济不平等抗议运动"
                            },
                            {
                                "target_lang_word": "占领华尔街运动",
                                "target_lang_sense_clarification": "更具体地指 Occupy Wall Street"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}