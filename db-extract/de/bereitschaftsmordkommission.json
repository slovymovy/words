                ],
                "senses": [
                    {
                        "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                        "entry_id": "d44623c0-27fd-3972-bd9c-e3024a4f9ac1",
                        "glosses": [
                            "ständige Einheit der Kriminalpolizei, die sich mit der Aufklärung von Mordfällen befasst und aktiv wird, wenn nötig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098e16bc-ea95-4364-a266-56cb3c856501",
                                "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                                "text": "„Nach Informationen dieser Zeitung hatte die Bereitschaftsmordkommission die Ermittlungen zu dem Fall unmittelbar nach der Tat zunächst abgelehnt.“"
                            },
                            {
                                "example_id": "126dd7b8-f66c-4ff8-bc8c-b258ee432c5e",
                                "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                                "text": "„‚Vielleicht stelle ich mich erst einmal vor. Ich bin Hauptkommissar Justus Weber, Leiter der Bereitschaftsmordkommission beim LKA Berlin.‘“"
                            },
                            {
                                "example_id": "21229a6c-0dd7-4b77-9dc0-d4af953c9de1",
                                "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                                "text": "„Golombek wirkte, als wolle er sich dafür entschuldigen, bei dem Fall, an dem die Bereitschaftsmordkommission aktuell arbeitete, nicht voranzukommen.“"
                            },
                            {
                                "example_id": "a44c26ce-ba37-42a8-893a-eb7754fdc99f",
                                "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                                "text": "„‚Sprengstoffanschlag mit mehreren Toten‘ meldete wenig später der Lagedienst der Polizei und benachrichtigte zugleich die Dienststellen des Polizeilichen Staatsschutzes und natürlich die Bereitschaftsmordkommission.“"
                            },
                            {
                                "example_id": "4ae8daba-7f8b-4bc9-a60f-5b5551fa532e",
                                "sense_id": "2b763659-423a-39bb-8826-f793ad539f35",
                                "text": "„Sie wird für einen konkreten Fall, bei dem der Verdacht eines Tötungsdeliktes besteht, gegründet, oder es wird eine Bereitschaftsmordkommission angerufen, deren Leiter über die Übernahme des Falles entscheidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
