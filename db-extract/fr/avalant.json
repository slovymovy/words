                "senses": [
                    {
                        "sense_id": "874f7de2-e104-3dae-a95c-be306370d0f6",
                        "entry_id": "40ed7df2-1899-3da0-97e4-bc9959a119c9",
                        "glosses": [
                            "Qui va vers l'aval du cours d’eau."
                        ],
                        "tags": [
                            "Batellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "33d0025d-52bd-4b76-9be7-0267aae34ae6",
                                "sense_id": "874f7de2-e104-3dae-a95c-be306370d0f6",
                                "text": "– D’où venaient les victimes ?\n– Des canaux du Centre, en passant par Nemours. Elles se dirigeaient vers la Seine. Elles étaient donc avalantes, comme on dit.\n– Et les montantes ?\n– Pas d’accident !"
                            },
                            {
                                "example_id": "a01ea5e1-1409-4d40-9880-e3a20f526912",
                                "sense_id": "874f7de2-e104-3dae-a95c-be306370d0f6",
                                "text": "Lorsque le chargement du bateau ou du convoi au moment de l'essai est inférieur à 70 %, le déplacement autorisé en navigation avalante doit être fixé en fonction du chargement effectif, pour autant que les valeurs limites visées au point 2 ."
                            },
                            {
                                "example_id": "c70d0396-68a0-4f4e-a006-5cb1976e1ea1",
                                "sense_id": "874f7de2-e104-3dae-a95c-be306370d0f6",
                                "text": "Cette Marne avalante est une autre rivière, un cours d’eau inconnu, absolument nouveau."
                            }
                        ]
                    }
