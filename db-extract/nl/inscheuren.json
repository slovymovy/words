                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To move or act with great speed, energy, or violence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a08ca5-80dd-4800-97c2-d7030094ee91",
                                                "sense_id": "75246216-531d-3104-b3fe-3dcb2dc9c5d4",
                                                "text": "He went tearing down the hill at 90 miles per hour."
                                            },
