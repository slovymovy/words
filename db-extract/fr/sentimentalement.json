        "fr-extract.jsonl": [
            {
                "entry_id": "0f40095d-d723-390d-8c0a-8a7e9229e2b5",
                "word": "sentimentalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98008fd5-1edf-36fd-b624-034bfc38b215",
                        "entry_id": "0f40095d-d723-390d-8c0a-8a7e9229e2b5",
                        "glosses": [
                            "D’une manière sentimentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fd04b3-0c85-447d-9cad-844cabe57ed7",
                                "sense_id": "98008fd5-1edf-36fd-b624-034bfc38b215",
                                "text": "Albert avait attaché sentimentalement son bouquet de violettes fanées à sa boutonnière."
                            }
                        ]
                    },
                    {
                        "sense_id": "32f64729-8a7f-32c6-b43d-6255ee55ee5a",
                        "entry_id": "0f40095d-d723-390d-8c0a-8a7e9229e2b5",
                        "glosses": [
                            "Du point de vue sentimental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b82759e-9f01-4ef1-aaef-236af28a4ddc",
                                "sense_id": "32f64729-8a7f-32c6-b43d-6255ee55ee5a",
                                "text": "Quand elle comprend l'importance de rester fidèle à ses aspirations, elle mesure, avec le recul, toutes les conséquences de son attitude de dévalorisation tant sentimentalement que professionnellement."
                            },
                            {
                                "example_id": "ca6452db-c3ee-497d-b862-7000688dfd32",
                                "sense_id": "32f64729-8a7f-32c6-b43d-6255ee55ee5a",
                                "text": "Le mode opératoire de Simon Leviev, serial lover multimilliardaire, est d’autant plus violent qu’il brise sentimentalement ses conquêtes, en plus de les appauvrir."
                            }
                        ]
                    }
                ],
