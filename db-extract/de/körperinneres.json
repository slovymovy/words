                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52aeb330-13f2-4baf-a5a7-a08a49cfb146",
                                "sense_id": "dd313d71-dedf-33a3-9d77-12078911dc69",
                                "text": "„Damit wird verhindert, dass sich die Erreger in den Schleimhautzellen in Richtung Körperinneres ausbreiten.“"
                            },
                            {
                                "example_id": "7ae42ff6-8048-483e-85c0-f0b4be5a34da",
                                "sense_id": "dd313d71-dedf-33a3-9d77-12078911dc69",
                                "text": "„Sein Körperinneres (Cytoplasma) ist ein funktionales Äquivalent unseres Körperinneren mit seinen Organen.“"
                            },
                            {
                                "example_id": "29644b07-f307-47a4-aa77-c0beb66799c8",
                                "sense_id": "dd313d71-dedf-33a3-9d77-12078911dc69",
                                "text": "„Macht nichts, er würde sein gesamtes Frühstück gleich mit zwei Tassen Kaffee in sein Körperinneres spülen.“"
                            },
                            {
                                "example_id": "c5ebca09-6fb0-4cf2-babf-778e46ce30ae",
                                "sense_id": "dd313d71-dedf-33a3-9d77-12078911dc69",
                                "text": "„Die Beobachtung der äußeren Zeichen der Krankheiten am Krankenbett umfaßte damit auch Körperinneres und Seziertisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
