                "senses": [
                    {
                        "sense_id": "60151db1-9001-357f-9beb-834c742e1519",
                        "entry_id": "8413b519-a2dd-306b-adb8-fda975775a16",
                        "glosses": [
                            "потерять доверие к кому-либо, чему-либо; перестать верить кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758c6652-5e3c-433d-8793-bd0f99e1128a",
                                "sense_id": "60151db1-9001-357f-9beb-834c742e1519",
                                "text": "Дмитриева увидела, что она обманута Карицким и изверилась в нём."
                            },
                            {
                                "example_id": "25ab25e7-76f8-4a84-b2c3-7ef0c708bf8c",
                                "sense_id": "60151db1-9001-357f-9beb-834c742e1519",
                                "text": "На совесть я на людскую надеюсь, всё ещё в совести людской не изверилась…"
                            },
                            {
                                "example_id": "7cac0404-9337-41c1-b9fb-6d2a990b9854",
                                "sense_id": "60151db1-9001-357f-9beb-834c742e1519",
                                "text": "Ну, а оставшийся народ вовсе изверился в Демидове и во всех заводчиках."
                            }
                        ]
                    }
                ],
