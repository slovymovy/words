                        "examples": [
                            {
                                "example_id": "8e741a19-a3d8-4611-805f-a69c8bcc7ab2",
                                "sense_id": "58dc1159-7aa8-3999-89a5-db02528df505",
                                "text": "Qu’ils soient transformationnels ou progressistes dans leurs objectifs, ils ont besoin, pour être efficaces, du pouvoir de convaincre et du pouvoir de contraindre."
                            },
                            {
                                "example_id": "ec861a1a-e3ad-4c1e-a8b5-958c57144ea2",
                                "sense_id": "58dc1159-7aa8-3999-89a5-db02528df505",
                                "text": "Il se présente lui-même comme un leader transformationnel qui a fait basculer l'État de manière décisive vers la droite."
                            }
                        ]
