                "senses": [
                    {
                        "sense_id": "f387c4f2-89d4-3104-aa07-dc68d883efec",
                        "entry_id": "2198034b-d3dd-30d2-bc25-91f3253074f6",
                        "glosses": [
                            "разг., : поза, положение человека или животного, присевшего на согнутых ногах, обычно с опорой на носки"
                        ],
                        "tags": [
                            "в сочет. на корточки, на корточках, с корточек и др."
                        ],
                        "examples": [
                            {
                                "example_id": "7e636bcb-0562-49fa-92df-58725aaf7380",
                                "sense_id": "f387c4f2-89d4-3104-aa07-dc68d883efec",
                                "text": "Вот Мишенька, не говоря ни слова, // Увесистый булыжник в лапы сгрёб, // Присел на корточки, не переводит духу, // Сам думает: «Молчи ж, уж я тебя, воструху!»"
                            },
                            {
                                "example_id": "df8d6d62-86c1-45b6-a0d7-ea9b15a97714",
                                "sense_id": "f387c4f2-89d4-3104-aa07-dc68d883efec",
                                "text": "Увидав Нехлюдова, он, не встав с корточек, глядя снизу вверх из-под своих нависших бровей, подал руку."
                            }
                        ]
                    }
