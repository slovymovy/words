                ],
                "senses": [
                    {
                        "sense_id": "33a7c0f5-6c2a-3ef5-98a7-921f9717db6a",
                        "entry_id": "a7a84954-20f3-36e6-b1b4-8966a1aff736",
                        "glosses": [
                            "проявляющий самообладание; очень спокойный"
                        ],
                        "tags": [],
