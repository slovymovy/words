                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "311cbc78-ec05-3bf8-ba17-9f79f1dc4883",
                        "entry_id": "c0513ae9-2c34-3575-ac44-ca0783b09d18",
                        "glosses": [
                            "op een plek die lager is, onder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dedbe276-693a-45e6-9644-c0b86c7a1682",
                                "sense_id": "311cbc78-ec05-3bf8-ba17-9f79f1dc4883",
                                "text": "Zij wonen beneden."
                            },
                            {
                                "example_id": "faeaedb5-e180-4a4b-aca3-59e33a86113b",
                                "sense_id": "311cbc78-ec05-3bf8-ba17-9f79f1dc4883",
                                "text": "Heel langzaam volgden we de contouren van de haarspelden naar beneden."
                            },
                            {
                                "example_id": "d4bd2513-c79b-475e-a51b-0b55a350a023",
                                "sense_id": "311cbc78-ec05-3bf8-ba17-9f79f1dc4883",
                                "text": "'Als je zo midden in de nacht naar beneden springt met een parachute, ja ik weet er niets van, maar ik neem aan dat het midden in de nacht moet zijn, dan ben je toch enorm bang?'Hij verzekerde haar dat hij niet bang zou zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "18bad634-de48-378f-a6c1-c2ba7f9316ba",
                        "entry_id": "c0513ae9-2c34-3575-ac44-ca0783b09d18",
                        "glosses": [
                            "prepositioneel deel van een voornaamwoordelijk bijwoord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a59779-a9fe-42d0-a25f-32133b2866db",
                                "sense_id": "18bad634-de48-378f-a6c1-c2ba7f9316ba",
                                "text": "Hij woont al jaren in een flat waar een muziekwinkel beneden is."
                            }
                        ]
                    },
                    {
                        "sense_id": "950fe175-aca8-33f4-b4d9-4a36b2a8bb9e",
                        "entry_id": "c0513ae9-2c34-3575-ac44-ca0783b09d18",
                        "glosses": [
                            "een kleiner aantal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0d5602-bae0-4bd7-bff4-76f0b2f5ab94",
                                "sense_id": "950fe175-aca8-33f4-b4d9-4a36b2a8bb9e",
                                "text": "Als we met drieduizend of meer waren, zoals op deze voorzomerse dag, deelde de politie de burgerlijke pers mee dat we met tweeduizend waren, wat de journalisten naar beneden toe afrondden zodat drieduizend mensen op straat er een paar honderd in de kolommen werden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d3972ae-a1a7-37d8-bccd-0693148445b7",
                        "entry_id": "c0513ae9-2c34-3575-ac44-ca0783b09d18",
                        "glosses": [
                            "ten zuiden van"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec67ea3b-a9c7-45e4-829c-d92ae261d5ad",
                                "sense_id": "6d3972ae-a1a7-37d8-bccd-0693148445b7",
                                "text": "Zij wonen beneden de grote rivieren."
                            }
                        ]
                    }
                ],
