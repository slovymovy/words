                        "examples": [
                            {
                                "example_id": "4f469b8e-01a9-4823-b5d1-0bd12a05886f",
                                "sense_id": "0bc4bbc4-60da-391e-915b-43ce98bd19cc",
                                "text": "She saw the young Corinthian Lycius / Charioting foremost in the envious race, / Like a young Jove with calm uneager face, / And fell into a swooning love of him."
                            },
                            {
                                "example_id": "f9cdfe55-edad-4c74-85bb-be5366638210",
                                "sense_id": "0bc4bbc4-60da-391e-915b-43ce98bd19cc",
                                "text": "His voice was unexcited, uneager."
                            },
                            {
                                "example_id": "d13c7522-16b8-446b-9fec-87c70d5bafe0",
                                "sense_id": "0bc4bbc4-60da-391e-915b-43ce98bd19cc",
                                "text": "The sound of running water came from the bathroom. I listened with my hand on the doorknob, uneager to catch Simone Delage in the act of clipping her toenails."
                            }
                        ]
                    }
