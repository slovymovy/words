                                    {
                                        "sense_id": "e33905a1-ab0f-3693-8861-f01f601cf66a",
                                        "entry_id": "9b849349-491f-3965-9a8f-ce07e93eca55",
                                        "glosses": [
                                            "mit kleinen (eher runden) Flecken (Tupfen, Tüpfelchen) versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46201dc6-2aad-4a14-b0fe-c3ce44df716d",
                                                "sense_id": "e33905a1-ab0f-3693-8861-f01f601cf66a",
                                                "text": "„Leuchtend grüne Augen tauchten zwischen den wilden roten Locken auf,und auf ihrer Alabasterhaut tüpfelte eine Vielzahl blasser Sommersprossen ihre Wangenknochen und den Nasenrücken.“"
                                            },
                                            {
                                                "example_id": "753cc855-2a2c-43bb-9023-233d5cdcb789",
                                                "sense_id": "e33905a1-ab0f-3693-8861-f01f601cf66a",
                                                "text": "Die Flügel des Schmetterlinges sind in verschiedenen Grüntönen getüpfelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b7e2cca-befd-4683-97c4-e2722440efcf",
