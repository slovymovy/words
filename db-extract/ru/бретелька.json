                    {
                        "sense_id": "7cac205e-f1a7-3f36-94c1-18cdccdb2555",
                        "entry_id": "a7b58e08-8bf4-30fd-a6c8-fac84ced02b2",
                        "glosses": [
                            "узкая лямка, поддерживающая одежду на плече"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fd17d8-8277-48f5-abbe-779b0167d6fa",
                                "sense_id": "7cac205e-f1a7-3f36-94c1-18cdccdb2555",
                                "text": "Она была одета в лёгкий сарафанчик с тонкими бретельками, подчеркивающий её фигуру."
                            }
                        ]
                    }
                ],
