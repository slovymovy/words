            "senses": [
                {
                    "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                    "sense_definition": "To call someone \"darling\".",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>darlinging</w> his wife at every opportunity.",
