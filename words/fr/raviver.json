    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11b68201-83af-3b2f-9842-df46858ffdfa",
                    "sense_definition": "Rendre plus ardent un feu ou une flamme qui commençait à faiblir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a ajouté quelques brindilles sèches pour <w>raviver</w> le feu dans la cheminée."
                        },
                        {
                            "text": "Un souffle de vent suffit à <w>raviver</w> la flamme de la bougie qui vacillait."
                        }
                    ],
                    "synonyms": [
                        "attiser",
                        "rallumer"
                    ],
                    "antonyms": [
                        "éteindre",
                        "étouffer"
                    ],
                    "common_phrases": [
                        "raviver le feu",
                        "raviver la flamme"
                    ]
                },
                {
                    "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                    "sense_definition": "Faire renaître ou rendre plus vif un sentiment, un souvenir ou une tension.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille photo retrouvée dans le grenier est venue <w>raviver</w> des souvenirs oubliés."
                        },
                        {
                            "text": "Ses propos maladroits risquent de <w>raviver</w> les tensions entre les deux équipes."
                        }
                    ],
                    "synonyms": [
                        "réveiller",
                        "ranimer",
                        "réactiver"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "raviver la douleur",
                        "raviver les souvenirs",
                        "raviver les tensions"
                    ]
                },
                {
                    "sense_id": "7fb1e1a1-9c62-31db-82c6-30e00af5c62a",
                    "sense_definition": "Redonner de l'éclat, du lustre ou de la fraîcheur à des couleurs ou à un objet terni.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce produit nettoyant permet de <w>raviver</w> les couleurs ternies de ce vieux tapis."
                        },
                        {
                            "text": "L'artisan a appliqué un vernis protecteur pour <w>raviver</w> le bois ciré du meuble."
                        }
                    ],
                    "synonyms": [
                        "aviver",
                        "rafraîchir"
                    ],
                    "antonyms": [
                        "ternir",
                        "affadir"
                    ],
                    "common_phrases": [
                        "raviver les couleurs",
                        "raviver un tableau"
                    ]
                },
                {
                    "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                    "sense_definition": "Exciser les tissus morts ou insensibles d'une plaie pour remettre la chair vive à nu et favoriser la guérison.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a dû <w>raviver</w> les bords de la blessure avant de poser les points de suture."
                        },
                        {
                            "text": "Cette intervention médicale consiste à <w>raviver</w> une plaie pour stimuler une cicatrisation propre."
                        }
                    ],
                    "common_phrases": [
                        "raviver une plaie"
                    ]
                }
            ]
        }
    ]
