                                        "sense_id": "362fdb9c-b730-3c69-b115-26783657648c",
                                        "entry_id": "df0eaf0c-16ab-394a-957e-d31618966726",
                                        "glosses": [
                                            "elemento estrutural de uma edificação responsável por transmitir as ações que nela chegam para as vigas que a sustentam, e destas para os pilares"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a521e3d-bbbc-4474-ad9d-e066168fbc6b",
                                                "sense_id": "362fdb9c-b730-3c69-b115-26783657648c",
                                                "text": "O estudante Vítor de Souza Euzébio, de 21 anos, foi atingido por uma bala perdida na laje de casa, enquanto consertava uma caixa-d'água."
                                            }
                                        ]
                                    }
