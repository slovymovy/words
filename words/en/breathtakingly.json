{
    "word_family": [
        "breathtaking",
        "breath"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d6343094-60f7-3282-99bb-fbbb32c675ab",
                    "sense_definition": "In an astonishingly impressive, exciting, or beautiful manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astonishing_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain view from our hotel balcony was <w>breathtakingly</w> beautiful.",
                            "target_lang_translations": {
                                "es": "La vista de la montaña desde el balcón de nuestro hotel era <w>impresionantemente</w> hermosa."
                            }
                        },
                        {
                            "text": "The dancer gave a <w>breathtakingly</w> fast and energetic performance that stunned the crowd.",
                            "target_lang_translations": {
                                "es": "El bailarín ofreció una actuación <w>asombrosamente</w> rápida y enérgica que dejó atónito al público."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunningly",
                        "spectacularly",
                        "astonishingly"
                    ],
                    "common_phrases": [
                        "breathtakingly beautiful"
                    ],
                    "target_lang_definitions": {
                        "es": "De una manera asombrosamente impresionante, emocionante o hermosa que deja sin aliento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "de manera impresionante",
                                "target_lang_sense_clarification": "que asombra por su belleza o magnitud"
                            },
                            {
                                "target_lang_word": "espectacularmente",
                                "target_lang_sense_clarification": "de forma grandiosa o llamativa"
                            },
                            {
                                "target_lang_word": "asombrosamente",
                                "target_lang_sense_clarification": "que causa gran admiración o sorpresa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeabc4ec-f54b-31c6-9123-b0d80672615b",
                    "sense_definition": "To an astonishing degree that causes shock or awe; shockingly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astonishing_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>breathtakingly</w> foolish thing to say during such an important interview.",
                            "target_lang_translations": {
                                "es": "Fue algo <w>increíblemente</w> tonto de decir durante una entrevista tan importante."
                            }
                        },
                        {
                            "text": "His decision showed a <w>breathtakingly</w> arrogant disregard for the safety of others.",
                            "target_lang_translations": {
                                "es": "Su decisión demostró un desprecio <w>inauditamente</w> arrogante por la seguridad de los demás."
                            }
                        }
                    ],
                    "synonyms": [
                        "shockingly",
                        "staggeringly",
                        "astoundingly"
                    ],
                    "common_phrases": [
                        "breathtakingly foolish",
                        "breathtakingly arrogant"
                    ],
                    "target_lang_definitions": {
                        "es": "En un grado asombroso o desmesurado que causa consternación, sorpresa o indignación."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "increíblemente",
                                "target_lang_sense_clarification": "en grado extremo y difícil de creer"
                            },
                            {
                                "target_lang_word": "inauditamente",
                                "target_lang_sense_clarification": "de un modo escandaloso o nunca visto"
                            },
                            {
                                "target_lang_word": "asombrosamente",
                                "target_lang_sense_clarification": "hasta un punto que causa perplejidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}