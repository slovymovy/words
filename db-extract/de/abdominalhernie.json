                ],
                "senses": [
                    {
                        "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                        "entry_id": "54e59b46-c430-38fa-a4ce-81c0c8b30927",
                        "glosses": [
                            "Bruch im Bereich des Abdomens, der durch eine schwache Stelle der Bauchwand hervortritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75546f38-58b5-459b-b22f-15b768837ae2",
                                "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                                "text": "„Abdominalhernien beruhen auf einer Erschlaffung und sackartigen Erweiterung der Bauchmuskulatur, der Haut und des Bauchfells.“"
                            },
                            {
                                "example_id": "c8c6785f-4620-4429-8c79-47af4c0b3819",
                                "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                                "text": "„Die Missbildung des Thorax ist ohne Zweifel auf dieselbe Ursache zurückzuführen wie die Abdominalhernie, sie steht mit derselben in unmittelbarem Causalnexus.“"
                            },
                            {
                                "example_id": "700ddd9b-ef64-42ed-995a-4a111ea60b2d",
                                "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                                "text": "„Die erste Indication bei allen beweglichen Brüchen, bei allen gewöhnlichen Abdominalhernien, ist die Zurückbringung des Bruchs (Taxis, Repositio herniae); die zweite besteht darin, dass der reponirte Bruch fortdauernd durch ein gutes Bruchband zurückgehalten werde.“"
                            },
                            {
                                "example_id": "52bf74b2-5a50-4eab-85c6-16fc0680aba5",
                                "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                                "text": "„Resultierende Hernien, seien es kleine Narbenhernien oder große Abdominalhernien nach offen gelassenem Abdomen, sind eine absolute Indikation zur operativen Reparation.“"
                            },
                            {
                                "example_id": "02cbe672-301f-47dd-b3d4-7cb4d0cf0089",
                                "sense_id": "9d988168-aa27-35e7-9c6b-105b8fc1f584",
                                "text": "„Innere Abdominalhernien sind vergleichsweise selten und werden bei einem operationspflichtigen Ileus nur bei 0,2 bis 0,9 % aller Patienten gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
