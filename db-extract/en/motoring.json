                        "glosses": [
                            "The act of operating a motorized vehicle; especially, driving a car (motorcar)."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1ed92e00-aa21-47e7-b6e9-5199332ba4d4",
                                "sense_id": "555b0aef-9aa4-3827-8cee-7d56f86c72c1",
                                "text": "c. 1910, George Bernard Shaw, letter to Beatrice\nThe afternoon was horrible; but when we struck the sea at Exmouth, and the coast, familiar to me through my Torquay motorings, became lovely in the evening. I revived & was quite jolly when I arrived."
                            }
                        ]
                    }
                ],
