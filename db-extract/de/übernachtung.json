                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9dc3a92-862c-4bd8-8eac-1c1a5bab823e",
                                                "sense_id": "f9331b0a-757e-3e52-939e-31623e75055a",
                                                "text": "Je vais à l’hôtel pour une nuitée."
                                            },
                                            {
                                                "example_id": "bc93cf0a-e9b4-4c0f-9038-ba40ef1b8f36",
                                                "sense_id": "f9331b0a-757e-3e52-939e-31623e75055a",
                                                "text": "Une nuitée qui sort de l'ordinaire, c'est ce que l'Hôtel de glace offre au public chaque année. Cette année, c'est une excursion dans un monde fantastique et surréaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad71c1a1-f5bc-3cb9-b5a8-4a553581e37b",
                                        "entry_id": "0f16db2b-7951-318a-8dc6-ef4b131b7413",
                                        "glosses": [
                                            "Travail effectué pendant la nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f7a766-4500-4f85-ba5f-a592fe8d7015",
                                                "sense_id": "ad71c1a1-f5bc-3cb9-b5a8-4a553581e37b",
                                                "text": "Les nuitées sont mieux payées que les journées."
                                            }
