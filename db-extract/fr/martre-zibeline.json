                        "examples": [
                            {
                                "example_id": "aeda753b-82fe-4112-8f9b-8d7a7a4b46ea",
                                "sense_id": "6274a4cc-3774-3e18-8adf-008186c67752",
                                "text": "C'était par l'entremise des Samoyèdes que se faisait alors ce trafic de martres-zibelines, d'hermines, de castors, etc."
                            },
                            {
                                "example_id": "58050941-0542-4196-a539-9618ec89f9d4",
                                "sense_id": "6274a4cc-3774-3e18-8adf-008186c67752",
                                "text": "La martre-zibeline allez c’est plus joli\nSur Madame en Packard\nQue quand le paradichlorobenzène emplit\nLe nez et les placards"
                            },
                            {
                                "example_id": "68b0799e-001a-40cb-be38-16e6c7d2c0e1",
                                "sense_id": "6274a4cc-3774-3e18-8adf-008186c67752",
                                "text": "… ; elle était coiffée d'un petit bonnet de martre-zibeline, surmonté d'une aigrette, témoignage de son origine princière."
                            }
                        ]
                    }
