                        "glosses": [
                            "To clear (something) of obstructions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35be965a-8f68-42e4-8217-2c25dc16d369",
                                "sense_id": "471eb557-ae18-3576-a5ed-dc1a15f2b00c",
                                "text": "[…] we humbly desire of God […] [that] he will be pleas’d to convey to them [the people of Ireland] the notices of their danger, and their sin, and to deobstruct the passages of necessary truth to them,"
                            },
                            {
                                "example_id": "27688f5f-e84b-45a2-85ae-83731fde88c3",
                                "sense_id": "471eb557-ae18-3576-a5ed-dc1a15f2b00c",
                                "text": "[…] such as carry off the Foeces and Mucus, deobstruct the Mouths of the Lacteals, so as the Chyle may have a free Passage into the Blood."
                            },
                            {
                                "example_id": "c00fd39a-2ef1-487d-9049-45b4c3e2983b",
                                "sense_id": "471eb557-ae18-3576-a5ed-dc1a15f2b00c",
                                "text": "[…] he exhibited an instrument which he had invented for deobstructing the Fallopian tubes in such cases."
                            }
                        ]
