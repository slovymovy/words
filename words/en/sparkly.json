{
    "word_family": [
        "spark",
        "sparkle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "82c067df-c323-359d-afd6-b2a19b84d587",
                    "sense_definition": "Giving off small flashes of light or appearing to glitter.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl wore a <w>sparkly</w> dress to the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринку маленькая девочка надела <w>сверкающее</w> платье."
                            }
                        },
                        {
                            "text": "The snow looked very <w>sparkly</w> under the bright morning sun.",
                            "target_lang_translations": {
                                "ru": "Снег выглядел очень <w>искрящимся</w> под ярким утренним солнцем."
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkling"
                    ],
                    "common_phrases": [
                        "sparkly dress",
                        "sparkly lights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испускающий небольшие вспышки света или мерцающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверкающий",
                                "target_lang_sense_clarification": "излучающий яркий, переливающийся свет"
                            },
                            {
                                "target_lang_word": "искрящийся",
                                "target_lang_sense_clarification": "излучающий мелкие, частые вспышки света"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "отражающий свет, имеющий блеск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04303b5b-be23-3def-b0bd-eadcc5fd7010",
                    "sense_definition": "Full of energy and high spirits.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>sparkly</w> performance that delighted the entire audience.",
                            "target_lang_translations": {
                                "ru": "Она выступила с <w>оживлённым</w> номером, который привел в восторг всю аудиторию."
                            }
                        },
                        {
                            "text": "His <w>sparkly</w> personality makes him very popular with everyone at work.",
                            "target_lang_translations": {
                                "ru": "Его <w>оживлённый</w> характер делает его очень популярным среди всех на работе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный энергии, жизнерадостный и воодушевленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлённый",
                                "target_lang_sense_clarification": "полный энергии, веселья и активности"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "обладающий большой внутренней силой и активностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf74dde-4a59-38dc-8e19-db5ce58bf380",
                    "sense_definition": "Containing many small bubbles or having a lively, effervescent quality.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bubbly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drink was <w>sparkly</w> and refreshing on a hot summer day.",
                            "target_lang_translations": {
                                "ru": "Напиток был <w>шипучим</w> и освежающим в жаркий летний день."
                            }
                        },
                        {
                            "text": "They enjoyed a glass of <w>sparkly</w> wine to celebrate the occasion.",
                            "target_lang_translations": {
                                "ru": "Они наслаждались бокалом <w>игристого</w> вина, чтобы отпраздновать это событие."
                            }
                        }
                    ],
                    "synonyms": [
                        "fizzy",
                        "effervescent",
                        "bubblesome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий множество мелких пузырьков или обладающий игристым, шипучим качеством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шипучий",
                                "target_lang_sense_clarification": "о напитках, содержащих углекислый газ"
                            },
                            {
                                "target_lang_word": "игристый",
                                "target_lang_sense_clarification": "о вине, содержащем пузырьки газа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}