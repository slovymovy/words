                "senses": [
                    {
                        "sense_id": "2a25abce-814d-3a2c-9ab2-5522b58f2901",
                        "entry_id": "f4f5bb5b-fa36-3125-ad66-bdd44f18e440",
                        "glosses": [
                            "Gefolgsmann des Königs oder eines Fürsten bei den Angelsachsen; seit dem 10. Jahrhundert erblicher Großgrundbesitzer"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "266308c6-6803-4e1b-851d-f64e09dd400b",
                                "sense_id": "2a25abce-814d-3a2c-9ab2-5522b58f2901",
                                "text": "Zum Pfande nur der größern Ehren, die er dir bestimmt, befahl uns der Monarch, dich Than von Cawdor zu grüßen, und in diesem neuen Titel heil dir, ruhmwürd’ger Cawdor, denn du bist’s!"
                            },
                            {
                                "example_id": "36449f31-3bf1-47df-8369-1a0e80e4f1c8",
                                "sense_id": "2a25abce-814d-3a2c-9ab2-5522b58f2901",
                                "text": "Macbeth! Macbeth! Macbeth! Hüte dich vor Macduff ! Hüte dich vor dem Than von Fife! - - Entlaßt mich - - Genug!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
