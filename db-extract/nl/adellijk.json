                "senses": [
                    {
                        "sense_id": "8f797bb0-61fb-37d4-8e35-77342edb8e7b",
                        "entry_id": "920acf69-a8c7-3015-a0eb-d81e75f57b0e",
                        "glosses": [
                            "noble"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "870f831a-02b5-49a9-88d8-572d71dec2c0",
                                "sense_id": "8f797bb0-61fb-37d4-8e35-77342edb8e7b",
                                "text": "Hij komt uit een adellijk geslacht.",
                                "translation": "He comes from a noble lineage.",
                                "english": "He comes from a noble lineage."
                            },
                            {
                                "example_id": "381410ee-1583-4345-8a5b-a794a438fb60",
                                "sense_id": "8f797bb0-61fb-37d4-8e35-77342edb8e7b",
                                "text": "Het adellijke huis was bekend om zijn rijkdom.",
                                "translation": "The noble house was known for its wealth.",
                                "english": "The noble house was known for its wealth."
                            },
                            {
                                "example_id": "59fcdad0-8384-43ae-a8b3-d669b9d46ed0",
                                "sense_id": "8f797bb0-61fb-37d4-8e35-77342edb8e7b",
                                "text": "Zij heeft de adellijkste manieren die ik ooit heb gezien.",
                                "translation": "She has the noblest manners I have ever seen.",
                                "english": "She has the noblest manners I have ever seen."
                            }
                        ]
                    }
                ],
