{
    "word_family": [
        "itinerant",
        "itinerancy",
        "itinerate",
        "itineration"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc3934d0-2f2f-3e31-9e5b-53ed68f871c8",
                    "sense_definition": "A planned route or path for a journey.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel_planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travel agent suggested a scenic <w>itinerary</w> through the mountains of Switzerland.",
                            "target_lang_translations": {
                                "ru": "Турагент предложил живописный <w>маршрут</w> через горы Швейцарии."
                            }
                        },
                        {
                            "text": "We need to finalize our <w>travel</w> <w>itinerary</w> before we book the train tickets.",
                            "target_lang_translations": {
                                "ru": "Нам нужно окончательно утвердить наш <w>план</w> <w>поездки</w>, прежде чем мы забронируем билеты на поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "route",
                        "path",
                        "course"
                    ],
                    "common_phrases": [
                        "travel itinerary",
                        "planned itinerary",
                        "scenic itinerary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированный путь или маршрут поездки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маршрут",
                                "target_lang_sense_clarification": "путь следования"
                            },
                            {
                                "target_lang_word": "план передвижения",
                                "target_lang_sense_clarification": "намеченный путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "961d1ab8-7279-3f7c-89fa-c111461d78d3",
                    "sense_definition": "A detailed schedule or list of activities and times for a trip.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel_planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "According to the <w>itinerary</w>, we are supposed to visit the museum at ten o'clock.",
                            "target_lang_translations": {
                                "ru": "Согласно <w>программе</w>, мы должны посетить музей в десять часов."
                            }
                        },
                        {
                            "text": "Please <w>follow</w> the <w>itinerary</w> closely so we do not miss our flight back home.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, строго придерживайтесь <w>графика</w>, чтобы мы не опоздали на наш рейс домой."
                            }
                        }
                    ],
                    "synonyms": [
                        "schedule",
                        "timetable",
                        "program"
                    ],
                    "common_phrases": [
                        "follow the itinerary",
                        "detailed itinerary",
                        "daily itinerary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробный график или список мероприятий и времени для поездки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа",
                                "target_lang_sense_clarification": "план мероприятий"
                            },
                            {
                                "target_lang_word": "график поездки",
                                "target_lang_sense_clarification": "расписание по времени"
                            },
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "общий порядок действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a26b3cf8-9159-3453-85a2-9182e3d38c87",
                    "sense_definition": "A guidebook or document providing information for travelers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travel_planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>itinerary</w> provided useful tips about the local customs and landmarks.",
                            "target_lang_translations": {
                                "ru": "Старый <w>путеводитель</w> содержал полезные советы о местных обычаях и достопримечательностях."
                            }
                        },
                        {
                            "text": "He consulted a <w>tourist</w> <w>itinerary</w> to find the best restaurants in the city.",
                            "target_lang_translations": {
                                "ru": "Он сверился с туристическим <w>гидом</w>, чтобы найти лучшие рестораны в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "guidebook",
                        "guide"
                    ],
                    "common_phrases": [
                        "tourist itinerary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путеводитель или документ, предоставляющий информацию для путешественников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путеводитель",
                                "target_lang_sense_clarification": "справочное издание"
                            },
                            {
                                "target_lang_word": "гид",
                                "target_lang_sense_clarification": "книжка или сервис с описанием мест"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fdc99a-c183-3bf1-a7a0-040bf9c15b6b",
                    "sense_definition": "A written account or record of a journey that has been taken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer published a fascinating <w>itinerary</w> of his travels across the desert.",
                            "target_lang_translations": {
                                "ru": "Исследователь опубликовал захватывающие <w>путевые</w> <w>заметки</w> о своих странствиях по пустыне."
                            }
                        },
                        {
                            "text": "Her personal <w>itinerary</w> included sketches and notes about every village she visited.",
                            "target_lang_translations": {
                                "ru": "Ее личный <w>дорожный</w> <w>дневник</w> включал наброски и заметки о каждой деревне, которую она посетила."
                            }
                        }
                    ],
                    "synonyms": [
                        "journal",
                        "log",
                        "record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменный отчет или запись о совершенном путешествии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путевые заметки",
                                "target_lang_sense_clarification": "записи о путешествии"
                            },
                            {
                                "target_lang_word": "дорожный дневник",
                                "target_lang_sense_clarification": "личный журнал поездки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1ae6bfd-daa5-3124-ad19-4f6969be3bf6",
                    "sense_definition": "Relating to a journey or traveling from place to place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge performed an <w>itinerary</w> circuit to hear cases in different towns.",
                            "target_lang_translations": {
                                "ru": "Судья совершал <w>разъездной</w> окружной суд для слушания дел в разных городах."
                            }
                        },
                        {
                            "text": "His <w>itinerary</w> habits made it difficult for him to settle in one home.",
                            "target_lang_translations": {
                                "ru": "Его привычка к <w>переездам</w> мешала ему обосноваться в одном доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "itinerant",
                        "traveling",
                        "wandering"
                    ],
                    "antonyms": [
                        "stationary",
                        "fixed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к путешествию или переезду с места на место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъездной",
                                "target_lang_sense_clarification": "связанный с поездками по делам"
                            },
                            {
                                "target_lang_word": "путевой",
                                "target_lang_sense_clarification": "относящийся к пути"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}