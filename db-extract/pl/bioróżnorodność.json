                        ]
                    },
                    {
                        "translation_id": "94d7c931-d838-491e-a17d-a1a5d422db94",
                        "source_entry_id": "237714a4-878a-323b-8579-99a3c3c88165",
                        "source_sense_id": "3dbf344b-514a-3a1c-b424-c439987d5861",
                        "target_lang_word": "biodiversité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biodiversité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d9ff00-4b69-38b0-9e6d-5d26d5b90fbd",
                                        "entry_id": "742a8a51-1520-351d-bb5b-0a1f46587bf8",
                                        "glosses": [
                                            "Diversité des organismes, qui s’apprécie en considérant la diversité des espèces, celle des gènes au sein de chaque espèce, ainsi que l’organisation et la répartition des écosystèmes."
                                        ],
                                        "tags": [
                                            "Sciences de la vie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5f0be7-fe0e-4a83-90ec-7e76335ada67",
                                                "sense_id": "e4d9ff00-4b69-38b0-9e6d-5d26d5b90fbd",
                                                "text": "Sa biodiversité est exceptionnelle : hérons, aigrettes, poules d’eau, mais aussi orchidées sauvages, iris jaunes, roseaux…"
                                            },
                                            {
                                                "example_id": "52870203-8965-4f0c-a123-bd9dd94f6423",
                                                "sense_id": "e4d9ff00-4b69-38b0-9e6d-5d26d5b90fbd",
                                                "text": "L’organisation des Nations unies prend également plusieurs exemples pour illustrer l’importance de cette biodiversité des espèces et des cultures. L’humanité cultive environ 6 000 plantes pour se nourrir, mais, en réalité, seules 200 d’entre elles contribuent à remplir son assiette et neuf seulement représentent 66 % de toutes les récoltes dans le monde."
                                            },
                                            {
                                                "example_id": "97ad4d96-0c2d-49f4-bcad-37774dea1213",
                                                "sense_id": "e4d9ff00-4b69-38b0-9e6d-5d26d5b90fbd",
                                                "text": "Plus on déforeste, plus on perd de la biodiversité, plus on a de pandémies…"
                                            },
                                            {
                                                "example_id": "1af00d53-207f-4ce4-9133-b1f75dc98ed6",
                                                "sense_id": "e4d9ff00-4b69-38b0-9e6d-5d26d5b90fbd",
                                                "text": "La particularité de la dalle aux ammonites de Digne est qu'elle présente une très faible biodiversité, largement dominée par l'espèce Coroniceras multicostatum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "060db54f-5398-435e-a259-2e00e687d587",
                        "source_entry_id": "237714a4-878a-323b-8579-99a3c3c88165",
                        "source_sense_id": "3dbf344b-514a-3a1c-b424-c439987d5861",
                        "target_lang_word": "biodiversidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
