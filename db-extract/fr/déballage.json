                    },
                    {
                        "translation_id": "7d77c2d8-f0ad-46fc-85c5-75dbed3079c2",
                        "source_entry_id": "533c34ae-a8e4-33e9-9900-bd8e674a4649",
                        "source_sense_id": "f8e59db5-21ca-3379-b81d-0a73a6443e4f",
                        "source_sense_description": "Action de déballer",
                        "target_lang_word": "uitpakken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitpakken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "904b791c-b4a0-3c38-a82f-92605dc94ec2",
                                        "entry_id": "4983aa29-42a7-3269-bff2-1f1439ad1b09",
                                        "glosses": [
                                            "uit een verpakking halen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52647451-4496-4ca9-a695-0676916390ff",
                                                "sense_id": "904b791c-b4a0-3c38-a82f-92605dc94ec2",
                                                "text": "Op deze foto zie je Kim op haar eerste verjaardag haar eerste cadeautje uitpakken, met een beetje hulp natuurlijk."
                                            },
                                            {
                                                "example_id": "fcccca76-249b-4bad-9f6d-3b03ce0bd2e3",
                                                "sense_id": "904b791c-b4a0-3c38-a82f-92605dc94ec2",
                                                "text": "Het was een hele bevrijding om met minder spullen de bergen in te gaan en het in- en uitpakken van mijn rugzak werd hierdoor een stuk overzichtelijker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c074c09b-fd2f-368e-accb-0e450385b1a2",
                                        "entry_id": "4983aa29-42a7-3269-bff2-1f1439ad1b09",
                                        "glosses": [
                                            "leeg maken van een verpakking"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33778070-c4ff-458e-8066-a4cb23ff27cc",
                                                "sense_id": "c074c09b-fd2f-368e-accb-0e450385b1a2",
                                                "text": "De magazijnmedewerker pakte een doos met tomatensoep uit."
                                            },
                                            {
                                                "example_id": "a7d8dc7f-1c86-467a-80b4-b2e058e38662",
                                                "sense_id": "c074c09b-fd2f-368e-accb-0e450385b1a2",
                                                "text": "Maar door de telefoon had ze gezegd dat de verhuizing goed was gegaan. Ze was al begonnen met het uitpakken van de dozen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d64fe0-3797-38d0-be52-5de76bf1f05c",
                                        "entry_id": "4983aa29-42a7-3269-bff2-1f1439ad1b09",
                                        "glosses": [
                                            "een bepaalde uitkomst krijgen"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51607450-a787-45a5-a34a-dd3a76810bca",
                                                "sense_id": "49d64fe0-3797-38d0-be52-5de76bf1f05c",
                                                "text": "Dat is beter uitgepakt dan hij verwacht had."
                                            },
                                            {
                                                "example_id": "2aa11608-0ea4-479a-8552-b32e33d17aca",
                                                "sense_id": "49d64fe0-3797-38d0-be52-5de76bf1f05c",
                                                "text": "In theorie neemt zo de armoede af. Maar in zijn wijk zou het averechts kunnen uitpakken, vreest Krijgsman: \"Soms wordt er bij het opknappen te rigoureus door wijkverbanden heen gebroken. Dat moet niet in Oud-Crooswijk gebeuren.\""
                                            },
                                            {
                                                "example_id": "99e378fe-eae6-407b-a295-8c9591c9126f",
                                                "sense_id": "49d64fe0-3797-38d0-be52-5de76bf1f05c",
                                                "text": "In 1947 trouwde ze met Philip Mountbatten. De Grieks-Deense prins was verre familie van haar: beiden waren achterachterkleinkind van koningin Victoria. Het was een huwelijk uit liefde, iets wat onder gekroonde hoofden en hun families niet per se voor de hand lag. Ondanks spanningen in de eerste jaren van Elizabeths koningschap pakte het goed uit. Philip bleef altijd een belangrijke adviseur van zijn vrouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f76103-11ce-4179-b86b-a0e84a65006e",
                        "source_entry_id": "533c34ae-a8e4-33e9-9900-bd8e674a4649",
                        "source_sense_id": "9ed0a453-f438-3f72-8a70-4d1d531e354d",
                        "source_sense_description": "Action de déballer",
                        "target_lang_word": "uitstalling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitstalling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "62628c9a-f212-34bf-8970-46c090e371b7",
                                        "entry_id": "a882203d-63f6-3049-af71-90dee9e134eb",
                                        "glosses": [
                                            "plaats waar dingen goed zichtbaar worden neergelegd zodat iedereen het duidelijk kan zien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8624b60e-294b-41fa-8849-b506de86e420",
                                                "sense_id": "62628c9a-f212-34bf-8970-46c090e371b7",
                                                "text": "Maar Johnny had gelijk: het was echt 'mijn'krokodil. Ik vergaapte me aan de uitstalling."
                                            },
                                            {
                                                "example_id": "5c4a687b-eb26-4833-8426-de09a84ed0e0",
                                                "sense_id": "62628c9a-f212-34bf-8970-46c090e371b7",
                                                "text": "Kinderschoenen, tassen, grotemensenslippers, kleren en onherkenbare resten van spulletjes werden uit de zee gevist en uitgestald op de kade in de haven van Jakarta. Het was bijna alles wat over was van de 189 inzittenden. President Joko Widodo zelf bezocht de uitstalling. Hij knielde ernaast, pakte iets uit de stapel en hield het omhoog. Dat gebaar was even onbeholpen als oneerbiedig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
