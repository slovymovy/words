                "translations": [
                    {
                        "translation_id": "9821eec4-c05a-471d-a39e-d05f50b01c19",
                        "source_entry_id": "536b7321-22ce-398e-aa38-edca11582fc7",
                        "source_sense_id": "c3c88286-c15d-3801-a021-2b6873f31063",
                        "source_sense_description": "met rood gekleurde haren",
                        "target_lang_word": "fuchsig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuchsig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2edce4-14ac-3504-a614-bd79cc4154d1",
                                        "entry_id": "9506a9e6-53ac-3ed5-bfd4-26c8a1b823f4",
                                        "glosses": [
                                            "in der Farbe eines Fuchsfelles bestehend"
                                        ],
                                        "tags": [
                                            "Farbton"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33dc8e71-d8f1-4833-b418-0dcf8c2cc96e",
                                                "sense_id": "ab2edce4-14ac-3504-a614-bd79cc4154d1",
                                                "text": "Zwölf Stunden später, und sie [die weißen Atlasse] waren ärger als grau: schmutzig, fuchsig, unverkäuflich."
                                            },
                                            {
                                                "example_id": "2eab16ca-67a7-49c8-a3da-075ccb4d1a76",
                                                "sense_id": "ab2edce4-14ac-3504-a614-bd79cc4154d1",
                                                "text": "Schön war es [ein schwarzes Kleid] nicht, fuchsig und fadenscheinig, sogar an mehreren Stellen zerrissen."
                                            },
                                            {
                                                "example_id": "5e974877-f597-41e9-bc31-b1671e2fe957",
                                                "sense_id": "ab2edce4-14ac-3504-a614-bd79cc4154d1",
                                                "text": "Auch der Bart ist stellenweise etwas fuchsig."
                                            },
                                            {
                                                "example_id": "7dd274bf-ae2a-4a58-92bb-8cf18e0ffd1b",
                                                "sense_id": "ab2edce4-14ac-3504-a614-bd79cc4154d1",
                                                "text": "Sein glatt anliegendes, braunes Haar, das auf dem Scheitel gegen das Licht etwas fuchsig schimmerte, ging hinten in die Höhe, und unten durch kamen die Spitzen einiger spärlichen grauen Löckchen zum Vorschein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "707107c1-f377-3ef6-bd1e-65fb205b93e4",
                                        "entry_id": "9506a9e6-53ac-3ed5-bfd4-26c8a1b823f4",
                                        "glosses": [
                                            "ärgerlich, erbost, wütend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e881b32-3290-462a-89b6-3a4f408f1df7",
                                                "sense_id": "707107c1-f377-3ef6-bd1e-65fb205b93e4",
                                                "text": "Nein, was einige wirklich fuchsig macht, ist die Entscheidung, keine 3,5-Millimeter-Klinkenbuchse für Kopfhörer in das neue iPhone zu bauen."
                                            },
                                            {
                                                "example_id": "a8f93a3b-ba52-4240-b337-ca2e3e1d7ae2",
                                                "sense_id": "707107c1-f377-3ef6-bd1e-65fb205b93e4",
                                                "text": "Es habe ihn fuchsig gemacht, sagt er, dass von den wissenschaftlichen Vereinigungen in Deutschland nie ein klares Wort zu vernehmen sei."
                                            },
                                            {
                                                "example_id": "bdf60dfc-08b2-416f-895e-d249a0c5c567",
                                                "sense_id": "707107c1-f377-3ef6-bd1e-65fb205b93e4",
                                                "text": "Wenn ich sehe, dass jemand über Airbnb 9000 Euro im Monat schwarz verdient und gleichzeitig Unternehmer mit 30.000 Euro Jahresumsatz mit der Registrierkassenpflicht genervt werden, werde ich aber fuchsig."
                                            },
                                            {
                                                "example_id": "c90c5c21-e493-44ff-865e-62ba9afc76ae",
                                                "sense_id": "707107c1-f377-3ef6-bd1e-65fb205b93e4",
                                                "text": "«Was mich manchmal fuchsig gemacht hat, war seine Art, verständlich gegenüber jedermann zu sein. Aber wenn wir selber etwas verbockt hatten, reagierte er völlig anders», sagte Merkel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d73fc3ef-c32f-482e-8469-0e4c806fdfcf",
                        "source_entry_id": "536b7321-22ce-398e-aa38-edca11582fc7",
                        "source_sense_id": "c3c88286-c15d-3801-a021-2b6873f31063",
