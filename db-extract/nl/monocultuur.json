                    {
                        "sense_id": "2afdad68-4d0d-3674-a001-911ad67671eb",
                        "entry_id": "cd0a3098-477f-326c-ac5c-d30da37e2f59",
                        "glosses": [
                            "monoculture (single-crop cultivation)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "023318e0-187f-4f08-96be-1617d8d15600",
                                "sense_id": "2afdad68-4d0d-3674-a001-911ad67671eb",
                                "text": "De boerderij gebruikt monocultuur, wat een risico kan zijn voor ziekten.",
                                "translation": "The farm uses monoculture, which can be a risk for diseases.",
                                "english": "The farm uses monoculture, which can be a risk for diseases."
                            },
                            {
                                "example_id": "94c22ef6-1bab-4049-a347-b473c184fe63",
                                "sense_id": "2afdad68-4d0d-3674-a001-911ad67671eb",
                                "text": "Monocultuur van maïs is gebruikelijk in dit gebied.",
                                "translation": "Monoculture of corn is common in this area.",
                                "english": "Monoculture of corn is common in this area."
                            }
                        ]
                    },
                    {
                        "sense_id": "fea0d0a5-1478-3236-9b1a-798e932a4978",
                        "entry_id": "cd0a3098-477f-326c-ac5c-d30da37e2f59",
                        "glosses": [
                            "monoculture (rather homogeneous, undiverse culture)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "320530ed-9900-4839-aedd-a83782f381a2",
                                "sense_id": "fea0d0a5-1478-3236-9b1a-798e932a4978",
                                "text": "De stad probeert monocultuur te vermijden door diversiteit te bevorderen.",
                                "translation": "The city tries to avoid monoculture by promoting diversity.",
                                "english": "The city tries to avoid monoculture by promoting diversity."
                            },
                            {
                                "example_id": "1aedc2c9-8285-41cc-ae4b-ee3771fd5ae7",
                                "sense_id": "fea0d0a5-1478-3236-9b1a-798e932a4978",
                                "text": "Critici beweren dat monocultuur de samenleving minder veerkrachtig maakt.",
                                "translation": "Critics argue that monoculture makes society less resilient.",
                                "english": "Critics argue that monoculture makes society less resilient."
                            }
                        ]
                    }
                ],
