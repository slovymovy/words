                    {
                        "translation_id": "a858082c-ff37-4821-b4c4-aaa62f7153c0",
                        "source_entry_id": "0533a077-57fa-38b4-b685-8281cb3001a9",
                        "source_sense_id": "cadd473d-fade-3355-af2f-75cc9ee2733e",
