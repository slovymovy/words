                    {
                        "sense_id": "80c092eb-de74-3087-b038-ba27efdba5ec",
                        "entry_id": "344319b1-e52e-3a40-a11c-b609f03787b7",
                        "glosses": [
                            "die Ausscheidung von Kalzium über den Urin"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3f5ab8-53d5-4983-8d87-0937426454ec",
                                "sense_id": "80c092eb-de74-3087-b038-ba27efdba5ec",
                                "text": "„Keine Calciumbeschränkung: Weil sie eine Kalziurie noch verstärkt. Ausreichende orale Calciumzufuhr bindet das Oxalat im Darmtrakt.“"
                            },
                            {
                                "example_id": "33df0192-fe9c-4ae1-b78d-e37506a718ee",
                                "sense_id": "80c092eb-de74-3087-b038-ba27efdba5ec",
                                "text": "„Die wichtigste Maßnahme ist die Steigerung der Diurese und Kalziurie durch Flüssigkeitsgabe in Form von 0,9 %iger NaCl-Lösung und Gabe von Schleifendiuretia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
