                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611360f2-c316-43c5-a3b3-2a9474f60a08",
                                "sense_id": "7b125309-51f3-3d4c-8889-52b91ffcb71b",
                                "text": "W Japonii dominują dwie religie: buddyzm i shinto"
                            },
                            {
                                "example_id": "fd88260d-fab9-4f30-b7c5-896f5d4ea65c",
                                "sense_id": "7b125309-51f3-3d4c-8889-52b91ffcb71b",
                                "text": "W Japonii miejscowa religia shinto tradycyjnie opierała się na czczeniu Natury i dusz zmarłych przodków. Kami (miejscowe dusze) były strażnikami gór, rzek, wodospadów, drzew, kamieni itd."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58c88b90-7967-4758-9b25-9d4323959a56",
                        "source_entry_id": "c2c0c2ba-4f4d-3d08-bb2a-d113793f6f66",
                        "source_sense_id": "7b125309-51f3-3d4c-8889-52b91ffcb71b",
