                                        ]
                                    },
                                    {
                                        "sense_id": "456a2266-ff01-3dd0-a544-6bf7d1201df1",
                                        "entry_id": "e09306cf-3e57-326b-8472-3faef433a719",
                                        "glosses": [
                                            "Par autorité de justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216d1d9f-2c1e-4670-b440-0066598b75ef",
                                                "sense_id": "456a2266-ff01-3dd0-a544-6bf7d1201df1",
