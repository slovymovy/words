                                            {
                                                "example_id": "3c964e9a-25a7-4b6b-9969-c44b4c6befb8",
                                                "sense_id": "b6a2a552-e676-325d-9f13-d26a4c2cc5be",
                                                "text": "my little sausage"
                                            },
                                            {
                                                "example_id": "119f0a8d-0489-4ae4-b568-6a78f75107b3",
                                                "sense_id": "b6a2a552-e676-325d-9f13-d26a4c2cc5be",
                                                "text": "“Algernon, you silly sausage. Now you want to marry me? Don't you remember we were already engaged to be married, and then I broke it off with you?”"
                                            },
                                            {
                                                "example_id": "dbb1f3bb-95b2-493f-829a-27cc6c2936c6",
                                                "sense_id": "b6a2a552-e676-325d-9f13-d26a4c2cc5be",
                                                "text": "There are loads of mazes, it's all really good fun and utterly addictive — so you should certainly consider adding this little sausage to your collection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f77455af-4988-37cc-8c35-851c72c3b3ba",
