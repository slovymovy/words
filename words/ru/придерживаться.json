{
    "word_family": [
        "держать",
        "держаться",
        "задержать",
        "поддержать",
        "удержать",
        "содержать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c017a16e-6e86-3815-b836-06b200448d93",
                    "sense_definition": "Держаться за что-либо рукой для равновесия или опоры.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чтобы не упасть в автобусе, нужно <w>придерживаться</w> за поручень.",
                            "target_lang_translations": {
                                "de": "Um im Bus nicht zu fallen, muss man sich am Haltegriff <w>festhalten</w>."
                            }
                        },
                        {
                            "text": "Ребенок начал ходить и постоянно <w>придерживается</w> за перила.",
                            "target_lang_translations": {
                                "de": "Das Kind hat angefangen zu laufen und <w>hält</w> sich ständig am Geländer <w>fest</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "держаться"
                    ],
                    "common_phrases": [
                        "придерживаться за перила",
                        "придерживаться за поручень"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich mit der Hand an etwas festhalten, um das Gleichgewicht zu halten oder Unterstützung zu finden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich festhalten",
                                "target_lang_sense_clarification": "sich mit der Hand an einem Gegenstand stützen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bfb305a-5bdc-311b-bdbc-fc7a6927a013",
                    "sense_definition": "Перемещаясь, оставаться вблизи чего-либо или следовать определенному маршруту.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В горах туристам советуют <w>придерживаться</w> тропы.",
                            "target_lang_translations": {
                                "de": "In den Bergen wird Touristen geraten, sich an den Pfad zu <w>halten</w>."
                            }
                        },
                        {
                            "text": "Водитель должен <w>придерживаться</w> правой стороны дороги.",
                            "target_lang_translations": {
                                "de": "Der Fahrer muss die rechte Straßenseite <w>einhalten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "следовать"
                    ],
                    "common_phrases": [
                        "придерживаться дороги",
                        "придерживаться правой стороны"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich in der Nähe von etwas bewegen oder einem bestimmten Weg folgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich halten an",
                                "target_lang_sense_clarification": "einer bestimmten Richtung oder einem Pfad folgen"
                            },
                            {
                                "target_lang_word": "einhalten",
                                "target_lang_sense_clarification": "eine Spur oder Seite auf der Straße beibehalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d441e84-ba4b-3739-9f8d-9ca83a7fd48a",
                    "sense_definition": "Соблюдать правила, инструкции или установленный порядок.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При заполнении документов просим строго <w>придерживаться</w> инструкции.",
                            "target_lang_translations": {
                                "de": "Beim Ausfüllen der Dokumente bitten wir Sie, sich strikt an die Anleitung zu <w>halten</w>."
                            }
                        },
                        {
                            "text": "Сотрудники компании должны <w>придерживаться</w> правил внутреннего распорядка.",
                            "target_lang_translations": {
                                "de": "Die Mitarbeiter des Unternehmens müssen die internen Arbeitsregeln <w>befolgen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "соблюдать",
                        "следовать"
                    ],
                    "antonyms": [
                        "нарушать"
                    ],
                    "common_phrases": [
                        "придерживаться правил",
                        "придерживаться графика",
                        "придерживаться инструкции"
                    ],
                    "target_lang_definitions": {
                        "de": "Regeln, Anweisungen oder eine festgelegte Ordnung befolgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich halten an",
                                "target_lang_sense_clarification": "Regeln oder Anweisungen befolgen"
                            },
                            {
                                "target_lang_word": "befolgen",
                                "target_lang_sense_clarification": "Anweisungen oder Vorschriften strikt einhalten"
                            },
                            {
                                "target_lang_word": "einhalten",
                                "target_lang_sense_clarification": "einen Zeitplan oder eine Frist einhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841fbc62-72fa-3be4-af9a-94dd7d35cbe8",
                    "sense_definition": "Иметь определенные взгляды, убеждения или придерживаться какого-либо мнения.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие эксперты <w>придерживаются</w> мнения, что ситуация скоро улучшится.",
                            "target_lang_translations": {
                                "de": "Viele Experten <w>vertreten</w> die Meinung, dass sich die Situation bald verbessern wird."
                            }
                        },
                        {
                            "text": "Он всегда <w>придерживается</w> консервативных взглядов на воспитание детей.",
                            "target_lang_translations": {
                                "de": "Er <w>vertritt</w> immer konservative Ansichten zur Kindererziehung."
                            }
                        }
                    ],
                    "synonyms": [
                        "разделять"
                    ],
                    "common_phrases": [
                        "придерживаться мнения",
                        "придерживаться взглядов"
                    ],
                    "target_lang_definitions": {
                        "de": "Bestimmte Ansichten, Überzeugungen oder Meinungen vertreten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vertreten",
                                "target_lang_sense_clarification": "eine bestimmte Meinung oder Ansicht haben"
                            },
                            {
                                "target_lang_word": "haben",
                                "target_lang_sense_clarification": "eine bestimmte Einstellung oder Ansicht besitzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}