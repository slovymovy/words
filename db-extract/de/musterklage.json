                ],
                "senses": [
                    {
                        "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                        "entry_id": "269b092b-2052-3c61-9dae-7a644828529f",
                        "glosses": [
                            "Gerichtsverfahren zur Klärung der Rechtslage, das als Beispiel für ähnliche, künftige Fälle durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcce08e0-1040-462e-bce7-f657da49e2eb",
                                "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                                "text": "„Die Musterklagen stützen sich sowohl auf Fehler des Bundes, als auch auf Fehler des Landes und der Gemeinden.“"
                            },
                            {
                                "example_id": "9febb119-16dc-463e-8406-9a5a84332ae3",
                                "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                                "text": "„In Deutschland hat die Kompetenzinitiative eine Musterklage angestrengt wegen Körperverletzung.“"
                            },
                            {
                                "example_id": "737688a8-d122-445d-b25c-869392e3455d",
                                "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                                "text": "„Fehlt es am Verzug, sind – wie in vorstehendem Auszug der Musterklage formuliert – Zinsen ab Rechtshängigkeit zu beantragen.“"
                            },
                            {
                                "example_id": "abe3b527-3c56-4cbf-a05a-f17659a81e2a",
                                "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                                "text": "„Paryla erklärte ihr auf ihre erste Frage hin, dass es normalerweise üblich sei, die Geschädigten für eine Musterklage öffentlich aufzufordern.“"
                            },
                            {
                                "example_id": "eb2c934e-c63b-48a8-ba84-a3fbc8ddbffe",
                                "sense_id": "d80c9a3b-6c6a-3d91-8ee3-21a698d2d19c",
                                "text": "„VW legt eine ausführliche Klageerwiderung im Rahmen der Musterklage vor, die vor dem Oberlandesgericht Braunschweig anhängig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
