            "senses": [
                {
                    "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                    "sense_definition": "In a reluctant, unwilling, or resentful manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long argument, he <w>grudgingly</w> agreed to help us clean up the mess.",
                            "target_lang_translations": {
                                "zh": "经过长时间的争吵后，他才<w>勉强地</w>同意帮我们收拾这个烂摊子。"
                            }
                        },
                        {
                            "text": "She <w>grudgingly</w> accepted his apology, although she was still quite upset.",
                            "target_lang_translations": {
                                "zh": "尽管她心里仍很不痛快，但还是<w>不情愿地</w>接受了他的道歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unwillingly"
                    ],
                    "antonyms": [
                        "willingly",
                        "gladly"
                    ],
                    "common_phrases": [
                        "grudgingly admit",
                        "grudgingly accept",
                        "grudgingly agree"
                    ],
                    "target_lang_definitions": {
                        "zh": "勉强地，不情愿地，心怀怨恨地"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勉强地",
                                "target_lang_sense_clarification": "表示很不情愿或非出于本意地做某事"
                            },
                            {
                                "target_lang_word": "不情愿地",
                                "target_lang_sense_clarification": "表示心里不愿意、勉强接受或去做"
                            }
                        ]
                    }
                }
            ]
        }
    ]
