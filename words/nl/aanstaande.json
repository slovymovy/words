                {
                    "sense_id": "ea992567-685f-3477-b65e-ea80b8d29c9b",
                    "sense_definition": "Verbogen vorm van <w>aanstaand</w>: toekomstig (iemand die een bepaalde status of functie gaat krijgen).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "role_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zoon was eindelijk thuis, een <w>aanstaande</w> marineofficier die niet op zee zou opereren.",
                            "target_lang_translations": {
                                "en": "The son was finally home, a <w>future</w> naval officer who would not operate at sea.",
                                "ru": "Сын наконец был дома, <w>будущий</w> морской офицер, который не будет служить в море.",
                                "it": "Il figlio era finalmente a casa, un <w>futuro</w> ufficiale di marina che non avrebbe operato in mare.",
                                "zh": "儿子终于回家了，他是一名<w>未来的</w>海军军官，但不会在海上执行任务。"
                            }
                        },
                        {
                            "text": "De <w>aanstaande</w> ouders zijn druk bezig met het inrichten van de kinderkamer.",
                            "target_lang_translations": {
                                "en": "The <w>expectant</w> parents are busy furnishing the nursery.",
                                "ru": "<w>Будущие</w> родители заняты обустройством детской комнаты.",
                                "it": "I <w>futuri</w> genitori sono impegnati ad arredare la cameretta.",
                                "zh": "这对<w>准</w>父母正忙着布置婴儿房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toekomstig",
                        "aankomend"
                    ],
                    "antonyms": [
                        "voormalig",
                        "oud-",
                        "gewezen"
                    ],
                    "common_phrases": [
                        "aanstaande moeder",
                        "aanstaande bruid",
                        "aanstaande vader"
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of 'aanstaand': future (referring to someone who is about to acquire a certain status or role).",
