                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59135f6f-c8a8-336c-94bf-2cc3a831a089",
                                        "entry_id": "f4710278-a21d-3868-8f22-f56bec824720",
                                        "glosses": [
                                            "Describing a train, system, etc, that operates by magnetic levitation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c40374-17e2-44b7-9565-4b2f4e2ce3c2",
                                                "sense_id": "59135f6f-c8a8-336c-94bf-2cc3a831a089",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays. This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "83a08153-80bb-4e32-ad88-032aed3dcf12",
                                                "sense_id": "59135f6f-c8a8-336c-94bf-2cc3a831a089",
                                                "text": "After nearly three years of technical research, Ding said the team had developed a lightweight and high-strength train body that lays the technical foundation for the development of five sets of maglev engineering prototypes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maglev",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "879adf7e-580c-35c1-a4d6-fa01a83bcca0",
                                        "entry_id": "8517775f-a007-3b01-9f55-8326b9f07a56",
                                        "glosses": [
                                            "A train supported by magnetic levitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d171496-bcba-4bd1-9d3b-24493a9b8c23",
                                                "sense_id": "879adf7e-580c-35c1-a4d6-fa01a83bcca0",
                                                "text": "When finished, the trains will be the fastest commercial maglevs developed and built completely by Chinese firms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
