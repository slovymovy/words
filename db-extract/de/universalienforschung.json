                "senses": [
                    {
                        "sense_id": "b07d3905-c1f4-3a90-bce0-423c07a726a1",
                        "entry_id": "58841a0b-53d5-3910-a7dc-1d04d4267cc0",
                        "glosses": [
                            "Disziplin der Linguistik, die sich der Erforschung sprachlicher Universalien, also der allen Sprachen gemeinsamen Eigenschaften, widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4d184c-ad64-4978-a179-aa2235932c9e",
                                "sense_id": "b07d3905-c1f4-3a90-bce0-423c07a726a1",
                                "text": "Die Universalienforschung sucht nach Universalien auf allen Ebenen der Sprache."
                            },
                            {
                                "example_id": "399f61d9-3bc1-41e0-a30d-d541c2ebb061",
                                "sense_id": "b07d3905-c1f4-3a90-bce0-423c07a726a1",
                                "text": "Die Universalienforschung beruht wie die Sprachtypologie auf dem strukturellen Vergleich der Sprachen."
                            },
                            {
                                "example_id": "87bc7331-6754-4733-9e54-585303c5d231",
                                "sense_id": "b07d3905-c1f4-3a90-bce0-423c07a726a1",
                                "text": "„Methodisch ist gegen diese und zahlreiche ähnliche Behauptungen in der gegenwärtigen Forschungslage einzuwenden, daß die Resultate der Universalienforschung noch keineswegs eine Überprüfung ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
