                    "sense_id": "30ff2533-092c-38b1-b411-1a94bef6e098",
                    "sense_definition": "de manier waarop een samengesteld geheel is opgebouwd om orde en houvast te bieden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was altijd een efficiënte planner geweest en hield van <w>structuur</w>, orde en controle.",
                            "target_lang_translations": {
                                "en": "I had always been an efficient planner and loved <w>structure</w>, order, and control."
                            }
                        },
                        {
                            "text": "Zonder een duidelijke <w>structuur</w> is het lastig om dit grote project op tijd af te ronden.",
                            "target_lang_translations": {
                                "en": "Without a clear <w>structure</w>, it is difficult to complete this large project on time."
                            }
                        }
                    ],
                    "synonyms": [
