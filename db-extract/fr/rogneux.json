                        "entry_id": "d6752f1a-af36-35a4-aaaa-6f3efa8edc2d",
                        "glosses": [
                            "Qui a la rogne, la gale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50180968-f596-4e55-9a7f-623b530b0c3a",
                                "sense_id": "5520b12e-7ab1-32c2-98ad-2afe540d09d9",
                                "text": "Un enfant rogneux."
                            },
                            {
                                "example_id": "1d449fbd-9059-474d-ac21-2f91f73d7152",
                                "sense_id": "5520b12e-7ab1-32c2-98ad-2afe540d09d9",
                                "text": "Un chien rogneux."
                            },
                            {
                                "example_id": "16dc2b07-67fb-4ba1-859f-010a574f7492",
                                "sense_id": "5520b12e-7ab1-32c2-98ad-2afe540d09d9",
                                "text": "Sur le second palier un chat rogneux avait traîné un peu de merluche qu’il s’apprêtait à déglutir."
                            }
                        ]
                    },
                    {
                        "sense_id": "39d0b622-c1c8-3004-8ea4-b072c5bf4301",
                        "entry_id": "d6752f1a-af36-35a4-aaaa-6f3efa8edc2d",
                        "glosses": [
                            "Méchant (cf. « méchant comme la gale »)."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7aa4978b-60d2-486b-af44-f34980352167",
                                "sense_id": "39d0b622-c1c8-3004-8ea4-b072c5bf4301",
                                "text": "Il essaya d’imaginer la solitude de son ami, entre des parents rogneux, aux frontières de la ville et de la plaine, sur une queue de faubourg où la vie était rare et la campagne ingrate."
                            }
                        ]
                    },
                    {
                        "sense_id": "0981d2be-8285-3bbb-9ee9-a49eab7f235e",
                        "entry_id": "d6752f1a-af36-35a4-aaaa-6f3efa8edc2d",
                        "glosses": [
                            "Qui est facilement en rogne, colérique."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "cc6637c9-2987-45b7-808d-f422b8e1c957",
                                "sense_id": "0981d2be-8285-3bbb-9ee9-a49eab7f235e",
                                "text": "Il faut faire attention à ce qu’on dit avec François, il est vraiment rogneux."
                            }
                        ]
                    }
