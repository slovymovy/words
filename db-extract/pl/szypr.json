                ],
                "senses": [
                    {
                        "sense_id": "0301f318-e7f6-35e4-b340-88f24458db8b",
                        "entry_id": "fe5204cf-7b76-3fb5-a1c2-d4a6e657a5d6",
                        "glosses": [
                            "perfumy o zapachu szyprowym"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "1d9a76bf-ddff-4679-bcf5-12735996468f",
                                "sense_id": "0301f318-e7f6-35e4-b340-88f24458db8b",
                                "text": "Elegancki, aldehydowy szypr, ale w żadnym wypadku nie staromodny, przeciwnie – powiedziałbym, że bardzo nowoczesny, wręcz futurystyczny w swoim brzmieniu"
                            },
                            {
                                "example_id": "7fc01568-8735-4e46-bb6f-b4388b74e814",
                                "sense_id": "0301f318-e7f6-35e4-b340-88f24458db8b",
                                "text": "Rush to taki niby-szypr, szypr instant, szypr z wygładzonymi krawędziami. Szypr dla żółtodziobów"
                            },
                            {
                                "example_id": "cb37fe00-42ca-4ec0-965b-69a056e8b04f",
                                "sense_id": "0301f318-e7f6-35e4-b340-88f24458db8b",
                                "text": "To szypr w pełnej krasie, a jednak jest on jednym z najbardziej przystępnych i noszalnych, bo jest to szypr lekki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
