                    {
                        "sense_id": "97ab561c-1820-3fa3-8a62-b6ca6cdf23d5",
                        "entry_id": "892375d2-47f3-3456-afb0-eebd1154b7e9",
                        "glosses": [
                            "een slurfvormige draaiing, met name in een watermassa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0afffa9f-5f1d-4f00-8f6a-7c60085e6c15",
                                "sense_id": "97ab561c-1820-3fa3-8a62-b6ca6cdf23d5",
                                "text": "De vloedgolf ging gepaard met een aantal draaikolken."
                            },
                            {
                                "example_id": "846851fc-347e-440d-9e19-d96782c8fa0c",
                                "sense_id": "97ab561c-1820-3fa3-8a62-b6ca6cdf23d5",
                                "text": "Eerst verscheen er een klein kuiltje in het oppervlak van de Blauwe Wierenzee dat echter groter en groter werd en uiteindelijk een grote draaikolk vormde waarvan de punt tot op de bodem van de Blauwe Wierenzee reikte."
                            },
                            {
                                "example_id": "8db4f098-4264-48eb-bcce-05a52c4422e8",
                                "sense_id": "97ab561c-1820-3fa3-8a62-b6ca6cdf23d5",
                                "text": "Kennedy Meadows is een soort oase die je als een draaikolk kan opslokken en waar je veel te lang in kunt blijven hangen."
                            }
                        ]
                    }
                ],
