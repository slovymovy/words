                    }
                ],
                "senses": [
                    {
                        "sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
                        "entry_id": "4f26471e-5cdc-3a48-83c2-2bfff2d12994",
                        "glosses": [
                            "eine Art Baumstruktur von Objekten, durch den innerhalb dieses Raumes jeder Name eindeutig ist"
                        ],
                        "tags": [
                            "Programmierung"
                        ],
                        "examples": [
                            {
                                "example_id": "1c866a9c-2363-45fa-9a24-d36107c64a10",
                                "sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
                                "text": "Da er den richtigen Namensraum nicht hinzufügte, griff er auf ein gleichnamiges Objekt mit anderer Funktionalität zu – mit unangenehmen Folgen."
                            },
                            {
                                "example_id": "e571f564-43dd-468c-bb70-19728bb5425e",
                                "sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
                                "text": "„Wo die Ressourcen im Netz liegen, ist dank des dateisystembasierten Namensraums unsichtbar.“"
                            },
                            {
                                "example_id": "1c58028f-40e7-4549-a1ef-b3edc47f6aed",
                                "sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
                                "text": "„Ungleich komplexer werden solche diskursanalytischen Betrachtungen dann, wenn man in die kontrastive Analyse einbezieht, dass den verschiedenen Namensräumen (Artikelseiten, Diskussionsseiten, Versionsgeschichte) je spezifische Sprachstile eigen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c646f49-4042-41d9-a79b-1e70ca9e8cf6",
                        "source_entry_id": "4f26471e-5cdc-3a48-83c2-2bfff2d12994",
                        "source_sense_id": "85d3f176-bd9d-3562-a9b7-b38e950403ee",
                        "target_lang_word": "namespace",
