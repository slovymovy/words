                                "example_id": "334928e2-14b9-4f95-b48f-bbf3b5f89d96",
                                "sense_id": "c005fb52-f19b-30c0-9337-9487476b20d0",
                                "text": "Pour smocker, il faut commencer par froncer le tissu."
                            }
                        ]
