                                        "sense_id": "727d80de-f75d-3b8d-96a2-310ca88a33aa",
                                        "entry_id": "0c25da0c-7051-3d0e-84bd-f1db41073ab8",
                                        "glosses": [
                                            "sich ungewollt vom richtigen Weg entfernen und sich nicht mehr auskennen; durch Zufall, ohne Absicht an eine bestimmte Stelle kommen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81328f79-4c43-4a91-bb2d-3bf6640a6d93",
                                                "sense_id": "727d80de-f75d-3b8d-96a2-310ca88a33aa",
                                                "text": "Wir haben uns auf einer Wanderung im Wald verirrt."
                                            },
                                            {
                                                "example_id": "a07a4428-21bd-4581-99b9-d2884660e140",
                                                "sense_id": "727d80de-f75d-3b8d-96a2-310ca88a33aa",
                                                "text": "In diesen wunderschönen Ort verirren sich nur selten Touristen."
                                            },
                                            {
                                                "example_id": "0042e303-ec5f-4b0d-b76f-e0cf213361d6",
                                                "sense_id": "727d80de-f75d-3b8d-96a2-310ca88a33aa",
                                                "text": "Die sich tiefer und tiefer im Moor verirrende junge Frau bekam es langsam mit der Angst zu tun."
                                            },
                                            {
                                                "example_id": "b227aef2-76d0-4764-ad8c-0649134ffcf5",
                                                "sense_id": "727d80de-f75d-3b8d-96a2-310ca88a33aa",
                                                "text": "„Es ist eine Gegend, in die sich allenfalls Extremkletterer verirren und auch Hilfsorganisationen und Reporter nur unter Mühen vordringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
