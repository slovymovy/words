                    {
                        "translation_id": "37970ca3-f038-4007-b922-8bf450c7edc3",
                        "source_entry_id": "be42b24d-bf39-3525-8286-59c931683334",
                        "source_sense_id": "78a7841f-e673-3e6c-b73a-ca0541982167",
                        "target_lang_word": "hunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cdfb325-0466-3c24-a7ed-4e30874727e2",
                                        "entry_id": "4f44ee6a-0faf-3c18-b5ae-0024551fc605",
                                        "glosses": [
                                            "A large or dense piece of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4003d3b8-455e-4d9a-bf2f-f5013d495fc5",
                                                "sense_id": "1cdfb325-0466-3c24-a7ed-4e30874727e2",
                                                "text": "a hunk of metal"
                                            },
                                            {
                                                "example_id": "5460be1f-8fb2-4756-afe1-1de9ffa549ee",
                                                "sense_id": "1cdfb325-0466-3c24-a7ed-4e30874727e2",
                                                "text": "\"Jim, this is nice,\" I says. \"I wouldn't want to be nowhere else but here. Pass me along another hunk of fish and some hot corn-bread.\""
                                            },
                                            {
                                                "example_id": "f967d0ae-96ec-4a80-82eb-d642ce9a90e3",
                                                "sense_id": "1cdfb325-0466-3c24-a7ed-4e30874727e2",
                                                "text": "A cowherd was sitting by the roadside eating this food, and as he was one of those pudding-faced, basin-clipped, decent fellows, he cut off two medium great hunks of bread and cheese for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d23f02-b6a1-312a-89ff-f6d256c1d4aa",
                                        "entry_id": "4f44ee6a-0faf-3c18-b5ae-0024551fc605",
                                        "glosses": [
                                            "An attractive man, especially one who is muscular."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b43e817-3474-4f88-b72f-014b91c41b94",
                                                "sense_id": "f9d23f02-b6a1-312a-89ff-f6d256c1d4aa",
                                                "text": "The unfortunate thing about calling the season seven finale “The Dragon And The Wolf” is you can’t even reference it by name without picturing Daenerys Targaryen’s long-awaited hook-up with Jon Snow, her strapping hunk of an ally and also her nephew."
                                            },
                                            {
                                                "example_id": "a5c2175a-65f5-4886-a9c3-5539e8f5b831",
                                                "sense_id": "f9d23f02-b6a1-312a-89ff-f6d256c1d4aa",
                                                "text": "Diana’s most recent romantic adventure at that time was with the sturdy hunk Will Carling, captain of the England rugby team, whom she had met in 1995 working out at the Chelsea Harbor Club gym."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0ddd87-8338-3abd-8aa9-f6264435e717",
                                        "entry_id": "4f44ee6a-0faf-3c18-b5ae-0024551fc605",
                                        "glosses": [
                                            "A record of differences between almost contiguous portions of two files (or other sources of information). Differences that are widely separated by areas which are identical in both files would not be part of a single hunk. Differences that are separated by small regions which are identical in both files may comprise a single hunk. Patches are made up of hunks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f493533-c0f4-3896-be98-ade70155c8bd",
                                        "entry_id": "4f44ee6a-0faf-3c18-b5ae-0024551fc605",
                                        "glosses": [
                                            "A honyock."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b42f586-2bb7-4802-bcb8-1743920d35ec",
                                                "sense_id": "5f493533-c0f4-3896-be98-ade70155c8bd",
                                                "text": "\"You ain't callin' me a country hunk, are you?\" \"Hell, naw!\" Louie backed away and grinned."
                                            }
                                        ]
                                    }
                                ]
                            },
