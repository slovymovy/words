                                    {
                                        "sense_id": "7b10e259-d261-3e68-ab9e-767591f4de87",
                                        "entry_id": "a086be4b-e8b2-3040-8763-d09c144b552b",
                                        "glosses": [
                                            "ein Einwohner Schottlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9daf606-ca44-4acc-9b84-9c5ee3d2f69a",
                                                "sense_id": "7b10e259-d261-3e68-ab9e-767591f4de87",
                                                "text": "Unser Rinderzuchtverein hatte gerade letztes Jahr 17 Schotten zu Gast, die zu einem Erfahrungsaustausch nach Niedersachsen gekommen waren."
                                            },
                                            {
                                                "example_id": "cf3bd715-05bd-46e2-bd30-b1bd6366108e",
                                                "sense_id": "7b10e259-d261-3e68-ab9e-767591f4de87",
                                                "text": "„Dank der besseren Tordifferenz übernahm Deutschland wieder die Tabellenführung vor den Schotten, die am 7. Juni in Glasgow Gastgeber des Vize-Weltmeisters sind, und Litauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf83882e-d3f9-3033-836d-b2586561eb62",
                                        "entry_id": "a086be4b-e8b2-3040-8763-d09c144b552b",
                                        "glosses": [
                                            "Bruder in einem Schottenkloster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d91cbe-f8e5-47e0-95ed-ef7be2b71c9f",
                                                "sense_id": "bf83882e-d3f9-3033-836d-b2586561eb62",
                                                "text": "Der Abt der Schotten ist ein sehr weiser und barmherziger Mann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b78d2cc9-2e46-3f31-b72d-0f812cb37937",
                                        "entry_id": "a086be4b-e8b2-3040-8763-d09c144b552b",
                                        "glosses": [
                                            "umherziehender Krämer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896311fc-1094-44f9-89ba-112621aeb36b",
                                                "sense_id": "b78d2cc9-2e46-3f31-b72d-0f812cb37937",
                                                "text": "Es ist strengstens untersagt, einem Schotten oder einer Schottin Unterschlupf zu gewähren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9c0597f4-b865-37f5-bd18-4c371e18744e",
                                        "entry_id": "a086be4b-e8b2-3040-8763-d09c144b552b",
                                        "glosses": [
                                            "junger Hering"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5081f813-59e4-4eeb-abad-28efbb987474",
                                                "sense_id": "9c0597f4-b865-37f5-bd18-4c371e18744e",
                                                "text": "Nach drei Stunden hatten die beiden Angler immer noch bloß einen Schotten gefangen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eae24bb6-0050-3948-82cb-5500aa732287",
                                        "entry_id": "c1bc3005-02e1-30c4-bafd-54fb3802d571",
                                        "glosses": [
                                            "Molke oder Quark"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e61560f-19c8-4908-b54f-4cbaa2f170b4",
                                                "sense_id": "eae24bb6-0050-3948-82cb-5500aa732287",
                                                "text": "„Was die Bergspeisen anbelangt, so sind sie dem Magen des Städters nicht immer behaglich, zuträglich sind Milch, Rahm, Zieger und, besonders die Schotte oder Molke; gesalzene Käse und Schweinefleisch erfordern aber schon einen kräftigen Magen und Gewohnheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f581ed6-3093-3d5c-8651-bb6813499c38",
                                        "entry_id": "cbfc1dd3-4899-3575-b3e9-5963a9ca2d1d",
                                        "glosses": [
                                            "Trennwand im Innern eines Schiffs"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb08bea-2cf4-4c03-acec-f1b2c4ca0648",
                                                "sense_id": "6f581ed6-3093-3d5c-8651-bb6813499c38",
                                                "text": "Dieses Schiff braucht eine neue Schotte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                        "entry_id": "4cfdcce4-d374-36ba-b0c5-3643dce787b9",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9239633-f5c5-4191-83af-e798d93f2044",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Frau Schotte ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a2298c48-e423-4f16-a651-90be7ea180e2",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Herr Schotte wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4378ccae-0a5b-4bff-86db-bf0e56308cc0",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Die Schottes fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "775a8fbc-2882-4646-b48e-93fa83649b54",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Der Schotte trägt nie die Schals, die die Schotte ihm strickt."
                                            },
                                            {
                                                "example_id": "3a8f4ffc-10a2-44ca-816f-83abe1d47d66",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schotte kommt, geht der Herr Schotte.“"
                                            },
                                            {
                                                "example_id": "8070a7df-81ff-47e2-9e6f-4ac0f45d08b0",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Schotte kommt und geht."
                                            },
                                            {
                                                "example_id": "eea75371-0e04-4f37-a97f-2bc392ce7439",
                                                "sense_id": "1f4ff80e-49dc-3e49-8716-989ff5300615",
                                                "text": "Schottes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
