                                "target_senses": [
                                    {
                                        "sense_id": "b6607f68-95df-3e99-8327-503adb156aca",
                                        "entry_id": "cfcb5780-3ab5-39a1-8555-3410280a0ca5",
                                        "glosses": [
                                            "To predestine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10552ff9-c380-4907-9a4e-dfa619f0319a",
                                                "sense_id": "b6607f68-95df-3e99-8327-503adb156aca",
                                                "text": "Whom he did foreknow, he also did predestinate to be conformed to the image of his Son."
                                            },
                                            {
                                                "example_id": "128fef63-47fc-4928-acf9-f5b82f5983e4",
                                                "sense_id": "b6607f68-95df-3e99-8327-503adb156aca",
                                                "text": "Boys possessing any mental or moral force to give them a tendency, then predestinate their careers; or, if under supervision, take the impress that is given them: not often to cast it off, and seldom to cast it off altogether."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "predestinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76ca8240-c8bb-3f51-b34a-0f11df936593",
                                        "entry_id": "98784442-0779-3017-970b-8747bda1ee08",
                                        "glosses": [
                                            "Predestined, preordained."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c86935a0-6f49-4de0-b444-3290f6d68a84",
                                                "sense_id": "76ca8240-c8bb-3f51-b34a-0f11df936593",
                                                "text": "God keep your ladyship still in that mind; so some gentleman or other shall 'scape a predestinate scratched face."
                                            },
                                            {
                                                "example_id": "802f03a5-5f9b-4ce9-adfb-6e096f96a4fe",
                                                "sense_id": "76ca8240-c8bb-3f51-b34a-0f11df936593",
                                                "text": "There once was a man who said, “Damn!\nIt is borne in upon me I am\n An engine that moves\n In predestinate grooves,\nI’m not even a bus, I’m a tram.”"
                                            }
                                        ]
                                    }
                                ]
                            }
