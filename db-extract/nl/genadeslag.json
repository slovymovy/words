                "senses": [
                    {
                        "sense_id": "ce4915fb-6545-34d3-acb3-86540d3a352c",
                        "entry_id": "4e87c96b-cf11-31b5-bf7b-2703e64cedd9",
                        "glosses": [
                            "de laatste slag toegebracht aan een zwaargewonde vijand om hem uit zijn lijden te helpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c83679-6be4-4e85-811b-675e7047083f",
                                "sense_id": "ce4915fb-6545-34d3-acb3-86540d3a352c",
                                "text": "In de middeleeuwen werd de genadeslag als ridderlijk en eervol beschouwd, ook al had de kerk er bezwaren tegen."
                            },
                            {
                                "example_id": "52e625db-132d-480b-ab96-dabcd5a22b4d",
                                "sense_id": "ce4915fb-6545-34d3-acb3-86540d3a352c",
                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5ec05fe-be67-4a91-a1f8-dd2f03869169",
                        "source_entry_id": "4e87c96b-cf11-31b5-bf7b-2703e64cedd9",
                        "source_sense_id": "ce4915fb-6545-34d3-acb3-86540d3a352c",
                        "source_sense_description": "de laatste slag toegebracht aan een zwaargewonde vijand om hem uit zijn lijden te helpen",
                        "target_lang_word": "Fangschuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fangschuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b66b257-d56c-3369-a6eb-cb052918da32",
                                        "entry_id": "53988abb-7362-39b8-b14f-031d1738436b",
                                        "glosses": [
                                            "Schuss, der ein bereits angeschossenes Wild tötet"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3867ed-95bf-46d6-b98b-d4463cc618f5",
                                                "sense_id": "0b66b257-d56c-3369-a6eb-cb052918da32",
                                                "text": "Der erste Fangschuss war nicht tödlich und somit musste ein weiterer erfolgen."
                                            },
                                            {
                                                "example_id": "47d95147-4ddd-4664-ba4b-d54335e0924e",
                                                "sense_id": "0b66b257-d56c-3369-a6eb-cb052918da32",
                                                "text": "Darf der Schütze nach der gesetzlichen Wildfolgeregelung mit seiner geladenen Langwaffe über die [Revier-]Grenze an den Graben [, in dem ein vom Schützen in seinem Revier angeschossenes Schmalreh liegt,] herantreten, um den Fangschuss anzubringen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d824134-6fea-42d6-a059-0c0b3e9ccbb5",
                        "source_entry_id": "4e87c96b-cf11-31b5-bf7b-2703e64cedd9",
                        "source_sense_id": "ce4915fb-6545-34d3-acb3-86540d3a352c",
                        "source_sense_description": "de laatste slag toegebracht aan een zwaargewonde vijand om hem uit zijn lijden te helpen",
                        "target_lang_word": "coup de grâce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coup de grâce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cab9b12-a63e-3f7b-93f2-36095af1c908",
                                        "entry_id": "ea2d1e7e-c2c6-3a6c-ad00-204541befef2",
                                        "glosses": [
                                            "A final blow or shot given to kill a wounded person or animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2757800f-9d0e-4e67-ac81-958c70f88cb4",
                                                "sense_id": "1cab9b12-a63e-3f7b-93f2-36095af1c908",
                                                "text": "After we had row'd, or rather driven about a League and a Half, as we reckon'd it, a raging Wave, Mountain-like, came rolling a-ſtern of us, and plainly bad us expect the Coup-de-Grace."
                                            },
                                            {
                                                "example_id": "ed0902c9-c606-46e5-a5aa-83b0f587927b",
                                                "sense_id": "1cab9b12-a63e-3f7b-93f2-36095af1c908",
                                                "text": "The expression of his face was an appeal; his eyes were full of prayer. […] For what, indeed? For that which we accord to even the meanest creature without sense to demand it, denying it only to the wretched of our own race: for the blessed release, the rite of uttermost compassion, the coup de grâce."
                                            },
                                            {
                                                "example_id": "16a0dee2-a3e3-4282-ae8e-a7c442f4e57b",
                                                "sense_id": "1cab9b12-a63e-3f7b-93f2-36095af1c908",
                                                "text": "[…] they just went \"Right, activate radar, hello everybody, we can see you, you can't see us\", and plastered everything in 14-and-16-inch gunfire until everything was broken, burning, and not able to fire back, and then they popped out for the coup de grâce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac03348-9dd6-3274-a063-7dde50bbcea7",
                                        "entry_id": "ea2d1e7e-c2c6-3a6c-ad00-204541befef2",
                                        "glosses": [
                                            "A remarkable finishing action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
