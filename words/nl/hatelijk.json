    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52bf2765-9261-3e43-adb4-525f5f871299",
                    "sense_definition": "Gekenmerkt door of voortkomend uit onvriendelijke, boosaardige of hatende gevoelens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malicious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij maakte soms de <w>hatelijkste</w> opmerkingen over haar collega's.",
                            "target_lang_translations": {
                                "en": "She sometimes made the <w>most spiteful</w> remarks about her colleagues."
                            }
                        },
                        {
                            "text": "Ik probeer die <w>hatelijke</w> reacties op sociale media gewoon te negeren.",
                            "target_lang_translations": {
                                "en": "I just try to ignore those <w>nasty</w> comments on social media."
                            }
                        }
                    ],
                    "synonyms": [
                        "boosaardig",
                        "kwaadaardig",
                        "gemeen",
                        "vinnig"
                    ],
                    "antonyms": [
                        "vriendelijk",
                        "liefhebbend"
                    ],
                    "common_phrases": [
                        "hatelijke opmerkingen",
                        "hatelijke reacties",
                        "hatelijke blik"
                    ],
                    "target_lang_definitions": {
                        "en": "Characterized by or stemming from unfriendly, malicious, or hateful feelings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spiteful",
                                "target_lang_sense_clarification": "motivated by a desire to annoy or harm"
                            },
                            {
                                "target_lang_word": "malicious",
                                "target_lang_sense_clarification": "intending to do harm or cause pain"
                            },
                            {
                                "target_lang_word": "nasty",
                                "target_lang_sense_clarification": "highly unpleasant, unkind, or spiteful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "054ead4a-63f8-3a29-9dac-d601b35079cb",
                    "sense_definition": "Afschuwelijk, verwerpelijk of weerzinwekkend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dictator beging enkele uiterst <w>hatelijke</w> daden tegen de bevolking.",
                            "target_lang_translations": {
                                "en": "The dictator committed some extremely <w>odious</w> acts against the population."
                            }
                        },
                        {
                            "text": "Zij vonden die discriminerende maatregel een <w>hatelijke</w> beslissing.",
                            "target_lang_translations": {
                                "en": "They considered that discriminatory measure a <w>hateful</w> decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuwelijk",
                        "weerzinwekkend",
                        "verwerpelijk",
                        "odieus"
                    ],
                    "antonyms": [
                        "loofwaardig",
                        "aangenaam"
                    ],
                    "common_phrases": [
                        "hatelijke misdaad"
                    ],
                    "target_lang_definitions": {
                        "en": "Abhorrent, reprehensible, or repulsive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "odious",
                                "target_lang_sense_clarification": "extremely unpleasant or repulsive"
                            },
                            {
                                "target_lang_word": "hateful",
                                "target_lang_sense_clarification": "arousing or deserving of hatred"
                            },
                            {
                                "target_lang_word": "detestable",
                                "target_lang_sense_clarification": "deserving intense dislike"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bfdee5a0-a9e5-35b1-ad6b-fba4ac64283a",
                    "sense_definition": "Op een hatelijke, boosaardige of vijandige manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malicious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij lachte <w>hatelijk</w> toen zijn rivaal de wedstrijd verloor.",
                            "target_lang_translations": {
                                "en": "He laughed <w>spitefully</w> when his rival lost the match."
                            }
                        },
                        {
                            "text": "Ze sprak <w>hatelijk</w> over de nieuwe plannen van de directie.",
                            "target_lang_translations": {
                                "en": "She spoke <w>maliciously</w> about the management's new plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "boosaardig",
                        "gemeen",
                        "vinnig"
                    ],
                    "antonyms": [
                        "vriendelijk"
                    ],
                    "common_phrases": [
                        "hatelijk lachen",
                        "hatelijk spreken"
                    ],
                    "target_lang_definitions": {
                        "en": "In a hateful, malicious, or hostile manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spitefully",
                                "target_lang_sense_clarification": "in a manner showing a desire to harm or annoy"
                            },
                            {
                                "target_lang_word": "maliciously",
                                "target_lang_sense_clarification": "with intent to do harm or cause distress"
                            },
                            {
                                "target_lang_word": "nastily",
                                "target_lang_sense_clarification": "in an unpleasant or unkind way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bd82f01-0d00-33ea-b83d-b279f1adcd80",
                    "sense_definition": "In zeer sterke mate; buitengewoon (gebruikt ter versterking van een ander bijwoord of bijvoeglijk naamwoord).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was die middag <w>hatelijk</w> koud op de kale vlakte.",
                            "target_lang_translations": {
                                "en": "It was <w>terribly</w> cold on the barren plain that afternoon."
                            }
                        },
                        {
                            "text": "Zij vond de toets <w>hatelijk</w> moeilijk en vreesde voor een onvoldoende.",
                            "target_lang_translations": {
                                "en": "She found the test <w>awfully</w> difficult and feared a failing grade."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitengewoon",
                        "enorm",
                        "verschrikkelijk"
                    ],
                    "common_phrases": [
                        "hatelijk koud",
                        "hatelijk moeilijk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an intensifier in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To a very high degree; extremely (used as an intensifier for another adverb or adjective)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "terribly",
                                "target_lang_sense_clarification": "extremely or very"
                            },
                            {
                                "target_lang_word": "awfully",
                                "target_lang_sense_clarification": "very or extremely, in an informal way"
                            },
                            {
                                "target_lang_word": "dreadfully",
                                "target_lang_sense_clarification": "extremely, to an unpleasant degree"
                            }
                        ]
                    }
                }
            ]
        }
    ]
