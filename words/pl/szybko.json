                                "target_lang_sense_clarification": "very soon"
                            },
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "within a short time"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "быстро",
