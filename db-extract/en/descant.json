                        "entry_id": "345e8b12-8c71-3bb2-bfd3-8449845475fd",
                        "glosses": [
                            "To discuss at length."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a264c376-8676-4f8e-af7d-1803308e8435",
                                "sense_id": "33b14f34-25f9-3761-a723-e19e9e26b297",
                                "text": "but shun the establishment of a bachelor who has hung a pendulum between temptation and prudence till the age of———but of all subjects, age is the one on which it is most invidious to descant."
                            },
                            {
                                "example_id": "7a3724e9-9e24-4a92-908e-8e4689b20311",
                                "sense_id": "33b14f34-25f9-3761-a723-e19e9e26b297",
                                "text": "“… This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, …”"
                            },
                            {
                                "example_id": "66826bfc-c9c9-4cc6-b566-cd39c2858e78",
                                "sense_id": "33b14f34-25f9-3761-a723-e19e9e26b297",
                                "text": "Involving some interesting, intellectual trips, she was descanting lightly to right and left."
                            }
                        ]
