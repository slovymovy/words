                "senses": [
                    {
                        "sense_id": "3219f98d-2770-3c71-8dfa-90877621c331",
                        "entry_id": "50d879f4-3a49-3d83-a8f8-662827428edb",
                        "glosses": [
                            "женск. к паникёр; женщина, которая легко поддаётся панике, сеет панику"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd8fdec-ffdb-4942-8749-f0cb4dea7456",
                                "sense_id": "3219f98d-2770-3c71-8dfa-90877621c331",
                                "text": "Если Серафима Павловна не получит о тебе сообщения, ей Чёрное море покажется красным, фиолетовым или ещё не знаю каким и она может ударить во все колокола… — Это да! — улыбнулся Антон. — Дикая паникёрша."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a524b0-570b-4071-a90c-d7e08b023868",
                        "source_entry_id": "50d879f4-3a49-3d83-a8f8-662827428edb",
                        "source_sense_id": "3219f98d-2770-3c71-8dfa-90877621c331",
                        "target_lang_word": "panicker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panicker",
