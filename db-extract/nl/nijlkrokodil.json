                        "examples": [
                            {
                                "example_id": "6b536a31-57d1-404d-a939-8df438625485",
                                "sense_id": "f319ec68-2a83-3591-b75f-5f960951cabe",
                                "text": "Het meer en omgeving beslaat ruim 7 miljoen hectare (70.000 vierkante kilometer), de oppervlakte van Nederland en België samen, en herbergt veel bijzondere flora en fauna zoals de nijlkrokodil."
                            },
                            {
                                "example_id": "8e77dec6-8a36-4672-805d-ce83092650cf",
                                "sense_id": "f319ec68-2a83-3591-b75f-5f960951cabe",
                                "text": "Het reptiel is inmiddels meegenomen naar een tijdelijk onderkomen en moet uiteindelijk onderdak krijgen in een dierentuin. Welke park dat wordt, is nog niet duidelijk: veel Zweedse plekken zijn te klein voor de grote Nijlkrokodil, en als hij bij vreemde soortgenoten wordt gezet, riskeert hij te worden doodgebeten, schrijft de lokale krant Sydsvenskan."
                            }
                        ]
