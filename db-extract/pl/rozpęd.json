                "translations": [
                    {
                        "translation_id": "1e22ebfb-8f7a-495e-92da-62551c5454ce",
                        "source_entry_id": "a3adf8d3-262a-3823-a5c6-f1e3fccf6562",
                        "source_sense_id": "50f97a7b-8439-39a9-bd6c-b67e86fa81e3",
                        "target_lang_word": "momentum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momentum",
