                                "target_word": "Dysphemismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1faef9a1-e331-3bf3-8cc7-75717ff6b983",
                                        "entry_id": "8271ab60-f0e9-3192-831c-2a483fb19d24",
                                        "glosses": [
                                            "abfällige und/oder abwertende und/oder entwürdigende Bezeichnung für eine Person, eine Sache oder einen Sachverhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9dbfe41-9b66-4ccc-83a6-6f8eff238c77",
                                                "sense_id": "1faef9a1-e331-3bf3-8cc7-75717ff6b983",
                                                "text": "„Darunter befand sich eine Fülle von ‚Euphemismen‘ (Bezeichnungen, die die tabuisierten Körperteile durch einen angenehmeren oder »unanstößigen« Begriff ersetzen), aber auch Dysphemismen, die das bezeichnete Vokabular negativ färben und dabei durchaus kränkend wirken können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05ba493-4c6a-4d7d-a16a-c6e4ea9cc260",
                        "source_entry_id": "331e0f5e-3a94-3826-983b-39b5a492ba8e",
