        "fr-extract.jsonl": [
            {
                "entry_id": "7593fc10-426e-3613-85e4-8d5450788510",
                "word": "chyle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff56503a-4ddb-48ef-8c4e-2807bd4c9b17",
                        "entry_id": "7593fc10-426e-3613-85e4-8d5450788510",
                        "tags": [
                            "plural"
                        ],
                        "form": "chyles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                        "entry_id": "7593fc10-426e-3613-85e4-8d5450788510",
                        "glosses": [
                            "Fluide qui, dans l’intestin grêle, est séparé des aliments pendant l’acte de la digestion, et que les vaisseaux dits chylifères pompent à la surface de l’intestin, et portent dans le sang pour servir à sa formation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfca0a07-99d6-4aa1-b15d-b5c7fb1b5d85",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Les aliments se confondent tous en une liqueur douce, qui devient une espèce de lait, nommé chyle."
                            },
                            {
                                "example_id": "c54103f3-befd-43ec-83bb-905246a28f29",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Il en résulte que les parties du chyle sont plus propres à être appliquées sur les fibres et à les nourrir."
                            },
                            {
                                "example_id": "0b11fe1d-3170-4059-9ef5-4a8b859ee28a",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Le potage et le bouillon de viande leur font un meilleur chyle."
                            },
                            {
                                "example_id": "d4abb880-215c-4d56-829a-0fc057c9214c",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Rien ne trahissait en moi cette épouvantable existence qui fait d’un homme un entonnoir, un appareil à chyle, un cheval de luxe."
                            },
                            {
                                "example_id": "8923a2a3-7773-4186-b910-a75b2fa3e03e",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Le corps de l’homme ne renferme aucun liquide inconnu ; on y trouve du sang, du chyle, de la lymphe, et ces trois fluides contiennent de l’albumine."
                            },
                            {
                                "example_id": "1ccdc799-4eb0-4408-beb8-b75f46a6c88f",
                                "sense_id": "2fe4b1e9-633c-3189-ad25-b06928a08504",
                                "text": "Les graisses animales sont contenues dans tous les tissus et organes des animaux. […]. Le chyle et le lait en renferment aussi une quantité importante. Les chairs musculaires, par contre, en sont complètement dépourvues."
                            }
                        ]
                    },
                    {
                        "sense_id": "e58c2e30-9742-39a7-bcd8-7226e07048b3",
                        "entry_id": "7593fc10-426e-3613-85e4-8d5450788510",
                        "glosses": [
                            "ressassement, rumination."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1fffe4b1-f97b-4a98-aa34-2a9f9fd446fc",
                                "sense_id": "e58c2e30-9742-39a7-bcd8-7226e07048b3",
                                "text": "De nouveau chez elle, Jeanne commençait un monologue qui durait des heures dont elle se régalait, qui bientôt la faisait sourire parce qu’elle en était l’auteur et qui ressemblait à certains romans modernes faits d’une interminable émission rocailleuse, morose et ressassante. Ce chyle toutefois finissait par lui donner la nausée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6658096a-9ed0-4912-a010-2b4757b51a1d",
                        "source_entry_id": "7593fc10-426e-3613-85e4-8d5450788510",
                        "target_lang_word": "Chylus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
