                    },
                    {
                        "form_id": "31419ca1-9e78-41cd-9d5e-9d0de8b72e51",
                        "entry_id": "4a0e3e9e-e052-3aad-a2a5-150955113af5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sterbebetten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                        "entry_id": "4a0e3e9e-e052-3aad-a2a5-150955113af5",
                        "glosses": [
                            "Bett eines Versterbenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af8b96e-8905-4034-8488-99cbbda75701",
                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                "text": "„Sein Schwager hielt bereits in der Kirche eine schöne Rede, in der er einen Wunsch des Verstorbenen erwähnte, den dieser noch auf dem Sterbebett zu Papier gebracht hatte.“"
                            },
                            {
                                "example_id": "f0cc0c90-4cb5-4cfc-a442-75990ef18253",
                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                "text": "„Sein Ziel war es, sich auf dem Sterbebett taufen zu lassen und als reines Christenkind gen Himmel zu fahren.“"
                            },
                            {
                                "example_id": "c9e51594-fea8-41f0-a579-829ab0b4746a",
                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                "text": "„Und es ist nicht zu verwundern, daß ein eindrucksfähiger Kollege sogar noch auf dem Sterbebett um mehr solche Werke bittet.“"
                            },
                            {
                                "example_id": "40b8f6ca-a91a-4d29-9bbb-00efceb0d8c8",
                                "sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                                "text": "„Klaus, mein Vater, war keine sechs Jahre alt, als er im Juni 1942 zusammen mit seiner zwei Jahre älteren Schwester am Sterbebett Abschied von ihm nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61c0f250-35ae-4828-a259-1c9a943cf2b2",
                        "source_entry_id": "4a0e3e9e-e052-3aad-a2a5-150955113af5",
                        "source_sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                        "source_sense_description": "Bett eines Versterbenden",
                        "target_lang_word": "deathbed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deathbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6af5f18-c886-3025-995b-02395dd56e30",
                                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                                        "glosses": [
                                            "The bed on which someone dies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10e9a52-aad7-44c3-99c8-456381959225",
                                                "sense_id": "b6af5f18-c886-3025-995b-02395dd56e30",
                                                "text": "He was once on his way to an old woman, who was on her death-bed and who had led a wicked life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab84120-852d-30ab-b9a0-305fd8555564",
                                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                                        "glosses": [
                                            "The last hours before death."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a7f1e99-94cf-30ac-a574-bca876fb7985",
                                        "entry_id": "0a6f6b7b-8de3-3ee3-97ef-a5f542f47523",
                                        "glosses": [
                                            "A grave; the site of a burial or entombment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deccc329-d850-4f6b-a423-3ff62422cde9",
                                                "sense_id": "5a7f1e99-94cf-30ac-a574-bca876fb7985",
                                                "text": "“Will you ask our oldest warriors to build me a barrow? Ask them to climb this headland and build me a death pile high on its top. Let my deathbed rise high above Hronesnesse.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1deffacf-82b3-4f71-ba6c-11c3da2d62de",
                        "source_entry_id": "4a0e3e9e-e052-3aad-a2a5-150955113af5",
                        "source_sense_id": "8660d082-6cac-30cb-846f-56f3df217a20",
                        "source_sense_description": "Bett eines Versterbenden",
                        "target_lang_word": "lit de mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lit de mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                        "entry_id": "aa70445f-93b3-30e6-b178-0af5b5a8482e",
                                        "glosses": [
                                            "Lit sur lequel une personne meurt."
                                        ],
                                        "tags": [],
                                        "note": "Signifie le temps immédiatement avant la mort d’une personne, très souvent avec un adjectif possessif, non pas le lit lui-même",
                                        "examples": [
                                            {
                                                "example_id": "cb8ddc2a-d67c-4b5f-8b65-effcd9c4d837",
                                                "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                                "text": "Tu ne mourras pas en paix, répéta la voix ; même à ton lit de mort, tu te représenteras tes meurtres, les gémissements qui ont retenti dans ce château et le sang qui en rougit encore les murs."
                                            },
                                            {
                                                "example_id": "de1aab48-a815-42f8-8f3e-82f226f5ac60",
                                                "sense_id": "30707aa3-e584-3bed-a803-ae4817afbb98",
                                                "text": "Il y songeait dans ses victoires, dans ses harangues, dans ses discours, dans tous ses actes. À son lit de mort il y songeait encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
