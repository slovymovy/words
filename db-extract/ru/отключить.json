                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03f12ec8-a314-3db1-9291-d8a29e68a0f0",
                                        "entry_id": "3baaba30-4a69-3b38-aa81-6761ed06ed31",
                                        "glosses": [
                                            "To render unable; to take away an ability of, as by crippling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ac8a925-3c62-34ff-bcc4-541e596ae4f6",
                                        "entry_id": "3baaba30-4a69-3b38-aa81-6761ed06ed31",
                                        "glosses": [
                                            "To impair the physical or mental abilities of; to cause a serious, permanent injury."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820e6937-5f41-4159-88c8-123029e0209e",
                                                "sense_id": "3ac8a925-3c62-34ff-bcc4-541e596ae4f6",
                                                "text": "Falling off the horse disabled him."
                                            },
                                            {
                                                "example_id": "a078b4b6-821a-4bfd-9fd6-bbba434681ef",
                                                "sense_id": "3ac8a925-3c62-34ff-bcc4-541e596ae4f6",
                                                "text": "Krav is a martial art of last resort that assumes no quarter and focuses purely on disarming, disabling and, if necessary, destroying your opponent."
                                            },
                                            {
                                                "example_id": "90957aef-8632-46e8-bee2-1792db1dbd4e",
                                                "sense_id": "3ac8a925-3c62-34ff-bcc4-541e596ae4f6",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88b1ea2-4b21-3b57-bd3e-993790361e5e",
                                        "entry_id": "3baaba30-4a69-3b38-aa81-6761ed06ed31",
                                        "glosses": [
                                            "To deactivate, to make inoperational (especially of a function of an electronic or mechanical device)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46861833-f4fc-4101-ac70-a5b78772e19b",
                                                "sense_id": "a88b1ea2-4b21-3b57-bd3e-993790361e5e",
                                                "text": "The pilot had to disable the autopilot of his airplane."
                                            },
                                            {
                                                "example_id": "0c8e6d52-e141-4e29-a9b3-b8d351ac19b4",
                                                "sense_id": "a88b1ea2-4b21-3b57-bd3e-993790361e5e",
                                                "text": "At the end of March 2015 the onboard software configuration of the AGILE satellite was modified in order to disable the veto signal of the anticoincidence shield for the minicalorimeter instrument."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
