                        "examples": [
                            {
                                "example_id": "a4d84236-b6ad-4b69-8eec-512284573dce",
                                "sense_id": "7e016704-99f9-34ad-9c2d-23f924b98c20",
                                "text": "Er is een financieel conflict ontstaan over de deuren van de nieuwe zeesluis in IJmuiden. Het Zuid-Koreaanse bedrijf dat ze heeft gebouwd, ligt in de clinch met het Nederlandse bouwconsortium OpenIJ, dat bestaat uit VolkerWessels en BAM."
                            },
                            {
                                "example_id": "6a3cf1b7-8b48-4f9a-bdca-536e6f22ecd4",
                                "sense_id": "7e016704-99f9-34ad-9c2d-23f924b98c20",
                                "text": "Het kabinet is voorlopig niet van plan de verhuizing van het korps mariniers van Doorn naar Vlissingen stop te zetten. In een debat met de Tweede Kamer zei staatssecretaris Visser dat het afblazen van de verhuizing schadeclaims van het bouwconsortium kan opleveren."
                            }
                        ]
