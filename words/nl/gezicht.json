    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d0de66e-c4b4-3602-a290-22c3ae517429",
                    "sense_definition": "de voorkant van een menselijk hoofd met de ogen, neus en mond",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "hoofd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De neus, de mond en de ogen zijn delen van het <w>gezicht</w>.",
                            "target_lang_translations": {
                                "en": "The nose, the mouth, and the eyes are parts of the <w>face</w>.",
                                "ru": "Нос, рот и глаза — это части <w>лица</w>."
                            }
                        },
                        {
                            "text": "Hij liep met een grote grijns op zijn <w>gezicht</w> door het bos.",
                            "target_lang_translations": {
                                "en": "He walked through the forest with a big grin on his <w>face</w>.",
                                "ru": "Он шел по лесу с широкой ухмылкой на <w>лице</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gelaat",
                        "aangezicht"
                    ],
                    "common_phrases": [
                        "grijns op zijn gezicht",
                        "vriendelijk gezicht",
                        "bekend gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "the front part of a human head containing the eyes, nose, and mouth",
                        "ru": "передняя часть головы человека, на которой расположены глаза, нос и рот"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "the front part of the head"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "передняя часть головы"
                            },
                            {
                                "target_lang_word": "физиономия",
                                "target_lang_sense_clarification": "разговорное обозначение лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36a760c8-2c9f-3f97-a503-b28c54bb4cfb",
                    "sense_definition": "het vermogen om te kunnen zien",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gezicht</w> ging achteruit en daarom moest hij een bril gaan dragen.",
                            "target_lang_translations": {
                                "en": "His <w>eyesight</w> was deteriorating, so he had to start wearing glasses.",
                                "ru": "Его <w>зрение</w> ухудшилось, и поэтому ему пришлось начать носить очки."
                            }
                        },
                        {
                            "text": "Na het ongeluk was hij zijn <w>gezicht</w> volledig kwijt.",
                            "target_lang_translations": {
                                "en": "After the accident, he had completely lost his <w>sight</w>.",
                                "ru": "После аварии он полностью потерял <w>зрение</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zicht",
                        "gezichtsvermogen"
                    ],
                    "common_phrases": [
                        "slecht gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "the ability to see; the sense of sight",
                        "ru": "способность видеть; зрительное восприятие"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyesight",
                                "target_lang_sense_clarification": "the ability to see"
                            },
                            {
                                "target_lang_word": "vision",
                                "target_lang_sense_clarification": "the faculty of seeing"
                            },
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "the power of seeing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "зрение",
                                "target_lang_sense_clarification": "способность видеть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7994c186-0a20-334f-bf3e-8900f17cc126",
                    "sense_definition": "iets dat men ziet, zoals een landschap of een tafereel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Van op die bergtop zie je een mooi <w>gezicht</w> over de vallei.",
                            "target_lang_translations": {
                                "en": "From that mountaintop, you see a beautiful <w>view</w> over the valley.",
                                "ru": "С той вершины горы открывается красивый <w>вид</w> на долину."
                            }
                        },
                        {
                            "text": "Het was een vreemd <w>gezicht</w> om de straat zo leeg te zien.",
                            "target_lang_translations": {
                                "en": "It was a strange <w>sight</w> to see the street so empty.",
                                "ru": "Это было странное <w>зрелище</w> — видеть улицу такой пустой."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitzicht",
                        "zicht",
                        "tafereel"
                    ],
                    "common_phrases": [
                        "mooi gezicht",
                        "vreemd gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "something that one sees, such as a landscape, scene, or spectacle",
                        "ru": "то, что предстает перед глазами; вид, пейзаж или зрелище"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "something worth seeing or a specific scene"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "a landscape or scene"
                            },
                            {
                                "target_lang_word": "spectacle",
                                "target_lang_sense_clarification": "a visually striking performance or display"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "панорама или пейзаж"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "необычная или впечатляющая картина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91fb74c7-e141-3bb0-8d2c-8f264cd870da",
                    "sense_definition": "de uiterlijke verschijningsvorm of het karakter van een organisatie of groep",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe paus gaf de kerk een menselijk <w>gezicht</w>.",
                            "target_lang_translations": {
                                "en": "This new pope gave the church a human <w>face</w>.",
                                "ru": "Этот новый папа придал церкви человеческое <w>лицо</w>."
                            }
                        },
                        {
                            "text": "De nieuwe leider gaf de politieke partij een nieuw <w>gezicht</w>.",
                            "target_lang_translations": {
                                "en": "The new leader gave the political party a new <w>face</w>.",
                                "ru": "Новый лидер придал политической партии новый <w>облик</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "boegbeeld"
                    ],
                    "common_phrases": [
                        "menselijk gezicht",
                        "nieuw gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "the outward appearance, public image, or character of an organization or group",
                        "ru": "внешний облик, общественный имидж или характер организации или группы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "public image or outward appearance"
                            },
                            {
                                "target_lang_word": "figurehead",
                                "target_lang_sense_clarification": "a person who represents an organization"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "образ или характер организации"
                            },
                            {
                                "target_lang_word": "облик",
                                "target_lang_sense_clarification": "внешний вид или имидж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8f779c-44d3-3a62-ba3c-7f62be7563d3",
                    "sense_definition": "een bovennatuurlijke verschijning of droombeeld",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De profeet kreeg een heilig <w>gezicht</w> over de toekomst van het land.",
                            "target_lang_translations": {
                                "en": "The prophet received a holy <w>vision</w> about the future of the country.",
                                "ru": "Пророку явилось святое <w>видение</w> о будущем страны."
                            }
                        },
                        {
                            "text": "In zijn koorts dacht hij een angstaanjagend <w>gezicht</w> te zien.",
                            "target_lang_translations": {
                                "en": "In his fever, he thought he saw a terrifying <w>apparition</w>.",
                                "ru": "В лихорадке ему показалось, что он видит пугающее <w>видение</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "visioen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a supernatural appearance or dreamlike image",
                        "ru": "сверхъестественное явление или образ, возникший в воображении или во сне"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vision",
                                "target_lang_sense_clarification": "a supernatural or prophetic apparition"
                            },
                            {
                                "target_lang_word": "apparition",
                                "target_lang_sense_clarification": "a ghost or ghostlike image of a person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "видение",
                                "target_lang_sense_clarification": "призрачный или пророческий образ"
                            },
                            {
                                "target_lang_word": "явление",
                                "target_lang_sense_clarification": "сверхъестественное появление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00381add-a5ee-3bf2-be49-0d9d7351f9ea",
                    "sense_definition": "voltooid deelwoord van <w>zichten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het graan was reeds <w>gezicht</w> voordat de regen begon.",
                            "target_lang_translations": {
                                "en": "The grain had already been <w>reaped</w> before the rain started.",
                                "ru": "Зерно было уже <w>сжато</w> до того, как начался дождь."
                            }
                        },
                        {
                            "text": "Nadat het veld was <w>gezicht</w>, konden de boeren rusten.",
                            "target_lang_translations": {
                                "en": "After the field had been <w>harvested</w>, the farmers could rest.",
                                "ru": "После того как поле было <w>сжато</w>, фермеры смогли отдохнуть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'zichten' (to reap or sift)",
                        "ru": "причастие прошедшего времени от глагола 'zichten' (жать серпом или просеивать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reaped",
                                "target_lang_sense_clarification": "harvested with a scythe or sickle"
                            },
                            {
                                "target_lang_word": "sifted",
                                "target_lang_sense_clarification": "passed through a sieve"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "о зерне, убранном серпом"
                            },
                            {
                                "target_lang_word": "просеянный",
                                "target_lang_sense_clarification": "пропущенный через сито"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}