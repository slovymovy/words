                    "sense_definition": "To cover or decorate something with ornaments or natural beauty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spring has <w>appareled</w> the fields with bright wildflowers.",
                            "target_lang_translations": {
                                "ru": "Весна <w>украсила</w> поля яркими полевыми цветами.",
                                "de": "Der Frühling hat die Felder mit leuchtenden Wildblumen <w>geschmückt</w>."
                            }
