                "senses": [
                    {
                        "sense_id": "6e1ff930-9488-3498-a298-d7393b1b8d2f",
                        "entry_id": "a401e661-1406-32a3-b2eb-8fd1b25e1e97",
                        "glosses": [
                            "Stärke des von einem Stern ausgestrahlten Lichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd155209-137a-4384-9914-62ec400fbd34",
                                "sense_id": "6e1ff930-9488-3498-a298-d7393b1b8d2f",
                                "text": "„CoRoT konnte Variationen in der Sternenhelligkeit von bis zu 0,01 Prozent wahrnehmen.“"
                            },
                            {
                                "example_id": "1055a12a-fac4-47a0-9e78-67b9414668c0",
                                "sense_id": "6e1ff930-9488-3498-a298-d7393b1b8d2f",
                                "text": "„Hier hatte der legendäre Friedrich Wilhelm Argelander für die Bonner Durchmusterung die Stufenschätzmethode eingeführt, um rasch Sternenhelligkeiten generell abzuschätzen.“"
                            },
                            {
                                "example_id": "57a0a878-68f7-4eed-a467-de358cb00ba5",
                                "sense_id": "6e1ff930-9488-3498-a298-d7393b1b8d2f",
                                "text": "„Um die Sterne in der Umgebung der Sonne genauer zu klassifizieren, trug der dänische Astronom Ejnar Hertzsprung zu Beginn des 20. Jahrhunderts die absolute Sternenhelligkeit gegenüber der Sternenfarbe auf.“"
                            },
                            {
                                "example_id": "a483f55a-29ce-4c47-a046-012b5dce0ad4",
                                "sense_id": "6e1ff930-9488-3498-a298-d7393b1b8d2f",
                                "text": "„Eine Suche in historischen Daten zeigte jedoch keine weitere Abschwächung der Sternenhelligkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
