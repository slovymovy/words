                            {
                                "example_id": "cbad5ec6-2caf-4882-b99e-2caa00fbf278",
                                "sense_id": "c70a954b-79d7-3efe-af3d-af276516968c",
                                "text": "Après tout, j'ai plutôt l'habitude des mecs qui me fourrent leur zboub sous le nez, ou qui essaient à toute force de me l'enfoncer dans le cul : […]."
                            },
                            {
                                "example_id": "376fe369-15ea-45fa-bb0d-ca81c5e6079c",
                                "sense_id": "c70a954b-79d7-3efe-af3d-af276516968c",
                                "text": "— C'est portenawaque, votre histoire de bi! arrête de m’faire golri ! Pour ouam, y'a pas d’timinik : ou t’aimes zober les teuches ou tu kiffes le zboub."
                            }
                        ]
                    }
