                                        "entry_id": "79b92ada-518c-3104-bc46-c219f31d542f",
                                        "glosses": [
                                            "ein Überzug auf Keramiken, zum Beispiel auf Porzellan, der oft durchsichtig und spröde ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac50478-b29d-41c4-83c5-10e54919cb12",
                                                "sense_id": "af17e20a-25d5-3ab2-894f-766569023525",
                                                "text": "Beim ersten Brennvorgang wird der Tonbecher ohne Glasur gebrannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bd7b68f-836b-3ae5-b3af-bbe38afafd87",
                                        "entry_id": "79b92ada-518c-3104-bc46-c219f31d542f",
                                        "glosses": [
                                            "ein Überzug auf Gebäck, der aus Schokolade oder Zucker ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b21bda7-02cd-4ad9-ae91-47c8ba60e5aa",
                                                "sense_id": "1bd7b68f-836b-3ae5-b3af-bbe38afafd87",
                                                "text": "Die Mutter kauft verschiedene Krapfen mit Glasur beim Bäcker."
                                            },
                                            {
                                                "example_id": "e00103ab-7c6b-4b09-9cb5-e8ddb6281319",
                                                "sense_id": "1bd7b68f-836b-3ae5-b3af-bbe38afafd87",
                                                "text": "Beim Nappieren überzieht man eine Speise mit Soße oder Glasur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
