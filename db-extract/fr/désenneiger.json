                "senses": [
                    {
                        "sense_id": "70451209-458d-3111-ac6c-9fe677d4be65",
                        "entry_id": "b0a6ffa0-0dcf-3d78-b9e7-faf67646b57f",
                        "glosses": [
                            "Débarrasser de la neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698c0c14-067d-4486-82fc-49386548d58b",
                                "sense_id": "70451209-458d-3111-ac6c-9fe677d4be65",
                                "text": "Le lendemain, il partit avec le Kommando chargé de désenneiger la route qui descendait vers Neumarktl."
                            },
                            {
                                "example_id": "9e8613f3-89c0-4c5f-8dde-54348efd02cf",
                                "sense_id": "70451209-458d-3111-ac6c-9fe677d4be65",
                                "text": "La colonne avait fini par se désenneiger, et, dès le jour paru, les avions de secours, pilotés par les guides basques, s’étaient mis en quête des rescapés, pour leur parachuter des vivres."
                            }
                        ]
                    }
