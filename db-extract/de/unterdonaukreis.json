                ],
                "senses": [
                    {
                        "sense_id": "05c955af-3260-3da2-980d-497670708929",
                        "entry_id": "c031c6f8-e937-3ba0-935a-87bdb9f566f7",
                        "glosses": [
                            "einer der Kreise im Königreich Bayern von 1806 bis 1837"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8dfda2-6d06-42e2-b7b8-00ad18b2cf6d",
                                "sense_id": "05c955af-3260-3da2-980d-497670708929",
                                "text": "„Mit der Kreisreform von 1810 wurde der Unterdonaukreis beträchtlich um Gebiete des Regenkreises, des Salzachkreises und um Teile des Hausruckviertels erweitert“"
                            },
                            {
                                "example_id": "011e8d87-228d-40a5-9659-5b4eb14deb2f",
                                "sense_id": "05c955af-3260-3da2-980d-497670708929",
                                "text": "„Die königl. Regierung des Unterdonaukreises äußerte: …“"
                            },
                            {
                                "example_id": "79d55d6d-9d58-4dc7-9ca8-5cf28c34c927",
                                "sense_id": "05c955af-3260-3da2-980d-497670708929",
                                "text": "„Altötting und Neuötting gehörten verwaltungsmäßig zum Unterdonaukreis mit Passau als Regierungssitz.“"
                            },
                            {
                                "example_id": "d4f9f90d-3943-4f86-895f-c6b0bc12c8d2",
                                "sense_id": "05c955af-3260-3da2-980d-497670708929",
                                "text": "„Der Unterdonaukreis weist die größte Zahl der landwirtschaftlichen Bevölkerung auf, fast 2/3 der Kreisbevölkerung leben von der reinen Landwirtschaft.“"
                            },
                            {
                                "example_id": "8f7aa728-b391-4b2e-9d4b-e8ecd566f4bc",
                                "sense_id": "05c955af-3260-3da2-980d-497670708929",
                                "text": "„Der Organisationsplan der Regierung des Unterdonaukreises vom 8. Februar 1809 sah eine wesentliche Verkleinerung des Landgerichts vor, durch Bildung eines Landgerichts Fürsteneck und eines Landgerichts Hauzenberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
