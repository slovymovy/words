        "fr-extract.jsonl": [
            {
                "entry_id": "87b59864-c22f-30b5-b3f7-6031cab7b13f",
                "word": "invective",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1029b6d3-03b1-4974-b623-a0c1ec86e500",
                        "entry_id": "87b59864-c22f-30b5-b3f7-6031cab7b13f",
                        "tags": [
                            "plural"
                        ],
                        "form": "invectives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                        "entry_id": "87b59864-c22f-30b5-b3f7-6031cab7b13f",
                        "glosses": [
                            "Parole ou suite de paroles violentes et injurieuses contre quelqu’un ou contre quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f38006e-6e41-489b-9dc5-1d655cc9cd20",
                                "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                                "text": "L'orgueil espagnol cependant ne perd pas ses droits; il se trahit tantôt par des invectives, tantôt par des fictions également intéressées."
                            },
                            {
                                "example_id": "f0c3a6c8-020c-4dd5-a716-e3412c3ee1bd",
                                "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                                "text": "On n’a recours aux invectives que quand on manque de preuves. Entre deux controversistes, il y a cent à parier contre un, que celui qui aura tort se fâchera."
                            },
                            {
                                "example_id": "1b128058-a641-43e4-88b2-81d0bb1ea441",
                                "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                                "text": "Novicio se repentit aussitôt de son invective, qui aurait été plus appropriée dans une réunion du Katipunan que dans le bahay familial, dont les parois étaient couvertes d’images pieuses, de crucifix et de scapulaires."
                            },
                            {
                                "example_id": "3b3d4f61-c55e-4986-94d3-b0223cc0676b",
                                "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                                "text": "La grâce de ses propos mercredi après-midi annonce un retour à une image plus unificatrice, plus rassembleuse et, par le fait même, à une image de décence et de respect, après quatre années d’invectives et de provocations de la part d’un président qui n’avait pas de filtre."
                            },
                            {
                                "example_id": "580ae36c-3445-4d23-aeca-0d301a77984b",
                                "sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                                "text": "Mais cette affirmation d’un problème de racisme particulier au Québec est une invective couplée d’un préjugé méprisant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d841322-4aa3-47cf-97ce-0ac5226ba3fe",
                        "source_entry_id": "87b59864-c22f-30b5-b3f7-6031cab7b13f",
                        "source_sense_id": "047d7b63-3ead-351b-900c-f88700d05b46",
                        "target_lang_word": "invective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9d7e8c-c9ac-3ead-88ec-a9c5b64e195a",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "An expression which inveighs or rails against a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fe653a1-6d46-31ad-bdce-57e2dccf2b1b",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "A severe or violent censure or reproach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "Something spoken or written, intended to cast shame, disgrace, censure, or reproach on another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9106561b-f835-47e6-baa2-d2374ccaae62",
                                                "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                                "text": "And wordy attacks against slavery drew sneers from observers which were not altogether undeserved. The authors were compared to doctors who offered to a patient nothing more than invectives against the disease which consumed him."
                                            },
                                            {
                                                "example_id": "4f3ea123-d376-4fb2-80c2-5debb80b0879",
                                                "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                                                "text": "[A] savage passage of 14th-century invective about the text-obsessed nerdiness of the Florentine bibliophile and friend of Petrarch, Niccolò Niccoli ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f72c0a-9573-3c6a-b5ff-211e8417a020",
                                        "entry_id": "7f92d3c7-89a1-3624-9e3b-46ee0ae8f411",
                                        "glosses": [
                                            "A harsh or reproachful accusation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363045a6-8b0a-48b2-af68-5e4ec6563684",
                                                "sense_id": "f3f72c0a-9573-3c6a-b5ff-211e8417a020",
                                                "text": "Politics can raise invective to a low art."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "invective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06229ae7-4a93-3d3f-afa9-572874bc2c91",
                                        "entry_id": "55cff290-45c9-32e9-b306-6d2796d50ad3",
                                        "glosses": [
                                            "Characterized by invection or railing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71183c46-c5ac-4aad-b75c-835b235faa8f",
                                                "sense_id": "06229ae7-4a93-3d3f-afa9-572874bc2c91",
                                                "text": "Tom's speeches became diatribes — each more invective than the last."
                                            }
                                        ]
