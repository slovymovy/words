                                                "example_id": "2a89d02a-1af5-405b-b369-6de9695c4493",
                                                "sense_id": "f3ed5fe4-e7db-3685-8918-327ce324d977",
                                                "text": "...in Italy, customers can buy an espresso; in India, the restaurants use lamb instead of beef; and in Athens, McDonald's sells spanakopita as a snack food."
                                            },
