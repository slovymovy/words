                                "fr": "Je <w>vais</w> t'appeler demain.",
                                "it": "Ti <w>chiamerò</w> domani.",
                                "cs": "Zítra ti <w>zavolám</w>.",
                                "tr": "Seni yarın <w>arayacağım</w>.",
                                "es": "Te <w>llamaré</w> mañana."
                            }
                        },
                        {
                            "text": "Het <w>zal</w> waarschijnlijk de hele dag regenen.",
                            "target_lang_translations": {
                                "en": "It <w>will</w> probably rain all day.",
                                "ru": "Вероятно, весь день <w>будет</w> идти дождь.",
                                "pl": "Prawdopodobnie <w>będzie</w> padać przez cały dzień.",
                                "de": "Es <w>wird</w> wahrscheinlich den ganzen Tag regnen.",
                                "fr": "Il <w>va</w> probablement pleuvoir toute la journée.",
                                "it": "Probabilmente <w>pioverà</w> tutto il giorno.",
                                "cs": "Pravděpodobně <w>bude</w> pršet celý den.",
                                "tr": "Muhtemelen bütün gün yağmur <w>yağacak</w>.",
                                "es": "Probablemente <w>va a</w> llover todo el día."
                            }
                        },
                        {
                            "text": "Dat <w>zal</w> niet gebeuren.",
                            "target_lang_translations": {
                                "en": "That <w>will</w> not happen.",
                                "ru": "Этого не <w>произойдет</w>.",
                                "pl": "To się nie <w>stanie</w>.",
                                "de": "Das <w>wird</w> nicht passieren.",
                                "fr": "Cela ne <w>va</w> pas se produire.",
                                "it": "Questo non <w>accadrà</w>.",
                                "cs": "To se <w>nestane</w>.",
                                "tr": "Bu <w>olmayacak</w>.",
