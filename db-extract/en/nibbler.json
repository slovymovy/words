                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grignoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98723931-6318-37f5-9246-73fb3adc7436",
                                        "entry_id": "f219d79e-04b0-3cad-a5ba-2971c240af15",
                                        "glosses": [
                                            "Personne qui grignote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a2cffc-25d9-4868-ae67-ad0e8dc41eac",
                                                "sense_id": "98723931-6318-37f5-9246-73fb3adc7436",
                                                "text": "Et pour peu que notre mondain se double d’un gastronome, on comprend qu’il soit vexé d’être comparé à un grignoteur de croûtons de pain quand on est habitué aux homards grillés et au salmis de bécasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66aad01-62c9-34c9-bcbe-7b85340191ac",
                                        "entry_id": "f219d79e-04b0-3cad-a5ba-2971c240af15",
                                        "glosses": [
                                            "Objet permettant aux bébés de grignoter des aliments sans s'étouffer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dbe6319-3030-4d08-9822-a1384f5ca90f",
                        "source_entry_id": "77d29868-bb46-356c-a70a-b4122540db86",
                        "source_sense_description": "someone who nibbles",
                        "target_lang_word": "grignoteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grignoteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ebb8d3-17ad-3ee3-b9b4-27984ae0c405",
                                        "entry_id": "4e5ec3ac-8cd9-3550-bb61-6da90b6513ce",
                                        "glosses": [
                                            "Celle qui grignote"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b561097-85e0-4f47-b2bc-b6917865a939",
                                                "sense_id": "e0ebb8d3-17ad-3ee3-b9b4-27984ae0c405",
                                                "text": "Si vous êtes un grignoteur ou une grignoteuse réguliers, déterminez la nature de vos grignotages."
                                            },
                                            {
                                                "example_id": "92b8db84-ff1d-4ae4-b1dd-60c45335902a",
                                                "sense_id": "e0ebb8d3-17ad-3ee3-b9b4-27984ae0c405",
                                                "text": "La grignoteuse solitaire à l'abri des regards et des commentaires, vous ouvrez la porte du réfrigérateur avec la délicatesse d'un cambrioleur professionnel. Ni vu ni connu, vous espacez un peu les parts de gâteau, on n'y verra que du feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a1d3b6-884f-38bf-a628-d1920601ed2a",
                                        "entry_id": "4e5ec3ac-8cd9-3550-bb61-6da90b6513ce",
                                        "glosses": [
                                            "Outil qui permet de tailler la tôle, ou autre plaque de métal fin, par cisaillement de petits morceaux du bord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d18f5dd-3600-455d-b408-05959c426089",
                                                "sense_id": "02a1d3b6-884f-38bf-a628-d1920601ed2a",
                                                "text": "Pour le parachèvement des métaux en feuille l'IMTS permettra de trouver toute une gamme de machine, de la grignoteuse, à la cisaille, en passant par la rectifieuse de bande et bien sûr par la poinçonneuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56bdb787-c54b-365d-bb70-bcedef8ffeed",
                                        "entry_id": "4e5ec3ac-8cd9-3550-bb61-6da90b6513ce",
                                        "glosses": [
                                            "Outil à main pour cette fin, une cisaille-grignoteuse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0893c68b-eec5-45eb-98cc-08feb1e3cded",
                                                "sense_id": "56bdb787-c54b-365d-bb70-bcedef8ffeed",
                                                "text": "Dévissez les fixations des montants ou coupez-les au ras des rails de sol et plafond à la grignoteuse s’ils sont sertis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
