        "ru-extract.jsonl": [
            {
                "entry_id": "6af4954d-87e2-34ab-b991-573db6969748",
                "word": "ль",
                "pos": "particle",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1bf66d22-6910-3e90-afa7-9fb4180055ac",
                        "entry_id": "6af4954d-87e2-34ab-b991-573db6969748",
                        "glosses": [
                            "разг. то же, что ли (во всех значениях)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfabaa34-1ab2-4990-81c1-6ed1eb093143",
                                "sense_id": "1bf66d22-6910-3e90-afa7-9fb4180055ac",
                                "text": "Занятий мало ль есть у ней: // Грибы солить, кормить гусей, // Заказывать обед и ужин, // В анбар и в погреб заглянуть, — // Хозяйки глаз повсюду нужен: // Он вмиг заметит что-нибудь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d57b71e-98ce-43b6-80a5-abed9cfd1e9f",
                        "source_entry_id": "6af4954d-87e2-34ab-b991-573db6969748",
                        "source_sense_id": "1bf66d22-6910-3e90-afa7-9fb4180055ac",
                        "target_lang_word": "whether",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7353ae6e-abba-3aec-bdb1-78cb0b17cb8d",
                                        "entry_id": "8487a6aa-ee47-3c57-bf6c-e6de99f2f1f6",
                                        "glosses": [
                                            "Introduces a simple indirect question (without a correlative)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb996a-80f2-4c68-ac03-662918c77656",
                                                "sense_id": "7353ae6e-abba-3aec-bdb1-78cb0b17cb8d",
                                                "text": "Whether we'll be on time I'm unsure."
                                            },
                                            {
                                                "example_id": "2fc2abdf-693f-4395-8d2e-08de53fe9b04",
                                                "sense_id": "7353ae6e-abba-3aec-bdb1-78cb0b17cb8d",
                                                "text": "Do you know whether he's coming?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                        "entry_id": "8487a6aa-ee47-3c57-bf6c-e6de99f2f1f6",
                                        "glosses": [
                                            "Indicates doubt between possibilities (usually with correlative or)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f625bf58-417f-4659-ae12-788bca418346",
                                                "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                                "text": "He chose the correct answer, but whether by luck or by skill I don't know."
                                            },
                                            {
                                                "example_id": "ca4d4bdb-6712-4e55-b882-0298b1f83117",
                                                "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                                "text": "I can't decide whether to get divorced now or wait."
                                            },
                                            {
                                                "example_id": "f22c42f1-5ee4-465c-b1c9-d43057778933",
                                                "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                                "text": "As a political system democracy seems to me extraordinarily foolish,[…]. My servant is, so far as I am concerned, welcome to as many votes as he can get.[…]I do not suppose that it matters much in reality whether laws are made by dukes or cornerboys, but I like, as far as possible, to associate with gentlemen in private life."
                                            },
                                            {
                                                "example_id": "9e1d5e67-db14-49cf-a866-ac5cc70ae23a",
                                                "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                                "text": "The incident immediately revived the debate about goal-line technology, with a final decision on whether it is introduced expected to be taken in Zurich on 5 July."
                                            },
                                            {
                                                "example_id": "329ee1c4-c05f-4870-96d3-8d79ef751813",
                                                "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless. One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                                        "entry_id": "8487a6aa-ee47-3c57-bf6c-e6de99f2f1f6",
                                        "glosses": [
                                            "Introduces a disjunctive adverbial clause qualifying the main clause (with correlative or)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac647e94-70f8-410c-9ca6-978f1bbe9068",
                                                "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                                                "text": "He's coming, whether you like it or not."
                                            },
                                            {
                                                "example_id": "8a377669-54ef-466b-b872-767a1e972475",
                                                "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                                                "text": "I'll enjoy playing with my friends again, whether we win or lose."
                                            },
                                            {
                                                "example_id": "e854a00c-17e7-44d8-b440-2c23b90ba1e7",
                                                "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                                                "text": "Whether or not you're successful, you can be sure you did your best."
                                            },
                                            {
                                                "example_id": "39b2b24f-e799-4ff1-89df-610ae49233d0",
                                                "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                                                "text": "The years have gone by and still we know not whether or no Mallory and Irvine reached the summit. But the will to climb Mount Everest is still alive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7137acd6-9bec-3f2b-bca0-b575cc770a0a",
                                        "entry_id": "8487a6aa-ee47-3c57-bf6c-e6de99f2f1f6",
                                        "glosses": [
                                            "Introduces a direct question between alternatives (often with correlative or)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ce826c-4e79-477e-b216-1ff2de223dce",
                                                "sense_id": "7137acd6-9bec-3f2b-bca0-b575cc770a0a",
                                                "text": "whether ys it easyer to saye to the sicke of the palsey, thy synnes ar forgeven the: or to saye, aryse, take uppe thy beed and walke?"
                                            },
                                            {
                                                "example_id": "466c0463-091c-4041-b201-4254510acac4",
                                                "sense_id": "7137acd6-9bec-3f2b-bca0-b575cc770a0a",
                                                "text": "Whether hadst thou rather be a Faulconbridge, [...] Or the reputed sonne of Cordelion?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                                        "entry_id": "46c36422-300c-30b0-b30e-1c2dfd471049",
                                        "glosses": [
                                            "Which of two."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f8aac9-cbae-4c00-8891-99df1bdb50e7",
                                                "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                                                "text": "But to whether side fortune would have been partial could not be determined.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "cf9dcda0-bcfd-48cf-983b-6be53c64a789",
                                                "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                                                "text": "Whilst thus the case in doubtfull ballance hong,\nVnsure to whether side it would incline,"
                                            },
                                            {
                                                "example_id": "46e4a286-cf44-4cc7-9fa4-f806d4a832a7",
                                                "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                                                "text": "In the morning sowe thy seede, and in the euening withhold not thine hand: for thou knowest not whether shall prosper, either this or that, or whether they both shall be alike good."
                                            },
                                            {
                                                "example_id": "0242fbc3-42ea-4d50-9f29-aa313bd6fc1e",
                                                "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                                                "text": "In vies of favours whether party gains..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                        "entry_id": "0f1a259e-9cbd-39ab-9f4e-058c517c06b4",
                                        "glosses": [
                                            "Which of two."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c15ffa-a65b-49e5-ad2a-7e48a5d7dc83",
                                                "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                                "text": "The debite answered and sayde unto them: whether of the twayne will ye that I lett loosse unto you?"
                                            },
                                            {
                                                "example_id": "28ffc031-f241-4a05-8eb6-65364f2115b0",
                                                "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                                "text": "Whether of them twain did the will of his father?"
                                            },
                                            {
                                                "example_id": "9730fb9b-d7b8-4bd2-a3e1-99a3b430c594",
                                                "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                                "text": "I told them we were in a country where we all knew there was a great deal of gold, and that all the world sent ships thither to get it; that we did not indeed know where it was, and so we might get a great deal, or a little, we did not know whether; […]"
                                            },
                                            {
                                                "example_id": "dfbb3813-1a22-460a-8493-94a046f7fada",
                                                "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                                "text": "On the 17th, we came in full view of a great island, or continent (for we knew not whether;) on the south side whereof was a small neck of land jutting out into the sea, and a creek too shallow to hold a ship of above one hundred tons."
                                            },
                                            {
                                                "example_id": "8676f161-d5d1-48ed-a98d-bd8db5d51803",
                                                "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                                                "text": "\"Whether is better, the gift or the donor? / Come to me,\" / Quoth the pine tree, \"I am the giver of honor.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c65f699f-aa9e-4f21-b69f-a97acd0eaded",
                        "source_entry_id": "6af4954d-87e2-34ab-b991-573db6969748",
                        "source_sense_id": "1bf66d22-6910-3e90-afa7-9fb4180055ac",
                        "target_lang_word": "if",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "if",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Supposing that, assuming that, in the circumstances that; used to introduce a condition that may be (or prove to be) either true or false."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9b8c4a-b5e2-486a-8abe-bdc2584fdd19",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "I'll come only if you will do the driving."
                                            },
                                            {
                                                "example_id": "4fe9d2c4-9d69-47cd-83fc-96451f47914d",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "Fetch me a cold beer if there's one in the fridge."
                                            },
                                            {
                                                "example_id": "d9cbc87f-61e1-4ec4-8ebf-4580a682f24c",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "If crossing the road, make sure you look both ways."
                                            },
                                            {
                                                "example_id": "d006ffd1-ed68-42f3-a8f2-9afec068463c",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "If I give you the money would/will you buy it for me?"
                                            },
                                            {
                                                "example_id": "b32c2820-ca88-4872-9881-3b67ba758ca7",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "If you prefer, I can come tomorrow instead."
                                            },
                                            {
                                                "example_id": "1e8980bf-d32c-4d30-9146-0783b2801b7a",
                                                "sense_id": "8f4fb9fc-3a3c-33ec-ac58-ebf828d9c2e1",
                                                "text": "I'll, if I have time, do it next week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fafa616-b79e-381e-89e6-fb41e09075ab",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Supposing that, assuming that, in the circumstances that; used to introduce a condition that may be (or prove to be) either true or false.",
                                            "A keyword that invokes conditional processing: in the event that a given condition is true, execute the given statement(s) (otherwise execute other statements)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3349b3d-c79f-4dfb-bd9a-f5e3f5a059cb",
                                                "sense_id": "4fafa616-b79e-381e-89e6-fb41e09075ab",
                                                "text": "if A then B else C"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2883ae7a-5c7c-37f1-bac8-77c3c700abdc",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Supposing that; used with past or past perfect subjunctive to indicate a counterfactual or hypothetical condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17340049-b7af-45fd-b76d-4ba2def15fa0",
                                                "sense_id": "2883ae7a-5c7c-37f1-bac8-77c3c700abdc",
                                                "text": "If she hadn't told me, I wouldn't know."
                                            },
                                            {
                                                "example_id": "e3515211-65bf-42fc-a247-ef49f4c6472a",
                                                "sense_id": "2883ae7a-5c7c-37f1-bac8-77c3c700abdc",
                                                "text": "\"You would be healthier if you would give up smoking\" \"Well, if I were rich, I'd go to one of those hypnosis therapies to quit\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd83ea4c-3206-3b26-b6a2-0a391046c14f",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Supposing that; used with past or past perfect subjunctive to indicate a counterfactual or hypothetical condition.",
                                            "Even if; even in the circumstances that."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65c65b4a-dc52-401d-ae0e-5146fc8488a1",
                                                "sense_id": "bd83ea4c-3206-3b26-b6a2-0a391046c14f",
                                                "text": "I wouldn't marry you if you were the last man on earth."
                                            },
                                            {
                                                "example_id": "4b518668-2651-4b30-b2f9-7afed72d3179",
                                                "sense_id": "bd83ea4c-3206-3b26-b6a2-0a391046c14f",
                                                "text": "You're finishing your chowder if you sit there all afernoon!"
                                            },
                                            {
                                                "example_id": "307db88c-7157-4b83-a164-f7fd5555817a",
                                                "sense_id": "bd83ea4c-3206-3b26-b6a2-0a391046c14f",
                                                "text": "“Wait a minute!” said the girl: “I wouldn’t hurry by, if it was you that was coming out to be hung, the next time eight o’clock struck, Bill. I’d walk round and round the place till I dropped, if the snow was on the ground, and I hadn’t a shawl to cover me.”"
                                            },
                                            {
                                                "example_id": "345e120f-e88a-4bd6-be5f-ced45e8bc284",
                                                "sense_id": "bd83ea4c-3206-3b26-b6a2-0a391046c14f",
                                                "text": "If it’s the last thing I do / If it takes me from Tubilo to Timbuktu / If it’s the last thing I do / I’m gonna dodge every road block, speed trap, county cop / To get my hands on you / If it’s the last thing I do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57744589-0869-30f0-b130-7736acf6c3ad",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Considering the fact that; given that; introducing a condition that is known to be true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62dd2a41-65c2-4bdd-b566-be7805c9c313",
                                                "sense_id": "57744589-0869-30f0-b130-7736acf6c3ad",
                                                "text": "The drain's blocked — and if the drain's blocked, the water won't flow."
                                            },
                                            {
                                                "example_id": "358aa27f-230f-4a0d-ae13-d8b32977645f",
                                                "sense_id": "57744589-0869-30f0-b130-7736acf6c3ad",
                                                "text": "O what of Gods then boots it to be borne, / If old Aveugles ſonnes ſo euill heare?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a18574b5-4e43-3ba3-ba1b-1618579bb558",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "When; whenever; every time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe03625-bb76-43d3-9473-2c06706b741e",
                                                "sense_id": "a18574b5-4e43-3ba3-ba1b-1618579bb558",
                                                "text": "If you heat water to 100° C, it boils."
                                            },
                                            {
                                                "example_id": "26b4f29d-a070-4854-8a89-9250e1d4f590",
                                                "sense_id": "a18574b5-4e43-3ba3-ba1b-1618579bb558",
                                                "text": "If it rains, it pours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "948f01fb-eeaa-35cd-89ec-c168fc5b2ab3",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Although; used to introduce a concession; may..but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d451dce-d3f8-4388-a72f-1f9d505fa619",
                                                "sense_id": "948f01fb-eeaa-35cd-89ec-c168fc5b2ab3",
                                                "text": "He was a great friend, if a little stingy at the bar."
                                            },
                                            {
                                                "example_id": "f4d90c0d-2816-499b-94db-9e34b44c4f8d",
                                                "sense_id": "948f01fb-eeaa-35cd-89ec-c168fc5b2ab3",
                                                "text": "She won her team's admiration, if not the award, for her performance."
                                            },
                                            {
                                                "example_id": "eccb65a9-c27d-406b-afdb-b2f80fbfea4f",
                                                "sense_id": "948f01fb-eeaa-35cd-89ec-c168fc5b2ab3",
                                                "text": "Both Spear & Davis were indicted in the witchhunt surrounding the sensational (if nonexistent) \"Revere sex ring.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d2644f5-f6f4-32bf-add2-3ae25bf6e118",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Whether; used to introduce a noun clause, an indirect question, that functions as the direct object of certain verbs."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99aeb5d5-902b-41be-b86e-6baaa9014d8c",
                                                "sense_id": "5d2644f5-f6f4-32bf-add2-3ae25bf6e118",
                                                "text": "I don't know if I want to go or not."
                                            },
                                            {
                                                "example_id": "f20e31f2-4eda-497e-9786-3ce7975b66b3",
                                                "sense_id": "5d2644f5-f6f4-32bf-add2-3ae25bf6e118",
                                                "text": "Quoth Matthew, “ […] / She doubts if two and two make four, / […] ”"
                                            },
                                            {
                                                "example_id": "c3d77dba-e64a-4ac5-8167-feaab3c7c9dc",
                                                "sense_id": "5d2644f5-f6f4-32bf-add2-3ae25bf6e118",
                                                "text": "It is doubtful if the Victorian Londoner needed any warning, for the artful mobsmen, toolers, whizzers and dippers, together with their stickman accomplices, were everywhere in the crowds, in the underground, on railway trains […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1c70a6-73ef-3964-8233-7e578e93375d",
                                        "entry_id": "a8ef1879-67ce-394e-9675-c317b93982d6",
                                        "glosses": [
                                            "Introducing a relevance conditional; in case."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11264ce-e8c2-4a01-b5fe-31633f895c19",
                                                "sense_id": "8f1c70a6-73ef-3964-8233-7e578e93375d",
                                                "text": "I have leftover cake if you want some."
                                            },
                                            {
                                                "example_id": "13d0fa1b-cefb-487b-8888-8c2be339026a",
                                                "sense_id": "8f1c70a6-73ef-3964-8233-7e578e93375d",
                                                "text": "If you want to go home, I have the car keys."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "if",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2af9164-d298-38a8-b65b-3b9aed824159",
                                        "entry_id": "6f8fb310-53c7-310e-b9e3-733d064bfdbd",
                                        "glosses": [
                                            "An uncertainty, possibility, condition, doubt etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc4ef401-ead8-41d3-be21-4af98518fe76",
                                                "sense_id": "d2af9164-d298-38a8-b65b-3b9aed824159",
                                                "text": "The board can't approve this project; there are too many ifs."
                                            },
                                            {
                                                "example_id": "5387af48-d8a4-4469-87f3-4d480ffaaaaa",
                                                "sense_id": "d2af9164-d298-38a8-b65b-3b9aed824159",
                                                "text": "1709, Susannah Centlivre, The Busy Body, Act III, in John Bell (ed.), British Theater, J. Bell (1791), page 59,\nSir Fran. Nay, but Chargy, if——— ¶ Miran. Nay, Gardy, no Ifs.——Have I refus'd three northern lords, two British peers, and half a score knights, to have put in your Ifs?"
                                            },
                                            {
                                                "example_id": "63a54c2b-e007-4b4c-b78b-a5a0b1a0b699",
                                                "sense_id": "d2af9164-d298-38a8-b65b-3b9aed824159",
                                                "text": "Well might Bergman add, (in his Sciographia,), “if the compariſon that has been made, &c. be juſt.” The preſent writer makes no ifs about the matter, and has ſuperadded a little inaccuracy of his own, […]"
                                            },
                                            {
                                                "example_id": "d6147620-5ae0-4876-a3f3-4ad61d6a55bb",
                                                "sense_id": "d2af9164-d298-38a8-b65b-3b9aed824159",
                                                "text": "Even if they managed to strike Japan, the United States or South Korea with nuclear weapons — a big if, given that they do not have a reliable delivery system — they could not save themselves from ultimate defeat."
                                            }
                                        ]
                                    }
                                ]
                            }
