                    {
                        "translation_id": "a04f1697-bce2-4450-9ac1-76d8fd02acb5",
                        "source_entry_id": "8ee86fbe-70bf-3b83-96b9-1e9d13efe9d2",
                        "source_sense_id": "c3bf5a5b-4800-3964-862d-8f9af80189d2",
