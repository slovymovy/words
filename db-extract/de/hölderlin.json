                ],
                "senses": [
                    {
                        "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                        "entry_id": "072fb66e-352b-355b-830d-2845c4b65705",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182f8dc1-fccf-4260-b5e4-1893b3206632",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Frau Hölderlin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "af9c0676-a925-41ab-8fd0-ac87e5151b15",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Herr Hölderlin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "39373c48-0d2e-4e29-8252-1f78c7d2286c",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Die Hölderlins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f61e400a-a218-41e1-9cac-0a085c32090e",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Der Hölderlin trägt nie die Schals, die die Hölderlin ihm strickt."
                            },
                            {
                                "example_id": "f2ab62d2-dddc-4e24-99ef-3526207c8a5c",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hölderlin kommt, geht der Herr Hölderlin.“"
                            },
                            {
                                "example_id": "13cc9ab8-589c-4dd7-a56a-9db895baa4a0",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Hölderlin kommt und geht."
                            },
                            {
                                "example_id": "e2f9e6bf-0a64-49d1-897c-22bb59f920b5",
                                "sense_id": "5ab9ad23-979f-3a02-9599-b790abef4918",
                                "text": "Hölderlins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
