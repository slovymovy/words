                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторонник UKIP",
                                "target_lang_sense_clarification": "член или избиратель британской партии UKIP"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e571e0ce-81f3-31ac-91b4-0bfa085b41ec",
                    "sense_definition": "A foolish, silly, or awkward person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a silly <w>kipper</w> and put your coat back on.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>разиней</w> и надень пальто обратно."
                            }
                        },
                        {
                            "text": "The poor <w>kipper</w> lost his car keys down the drain.",
                            "target_lang_translations": {
                                "ru": "Бедный <w>недотёпа</w> уронил ключи от машины прямо в водосток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly kipper"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often affectionate or humorous"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, нелепый или неуклюжий человек (часто шутливо или ласково)."
