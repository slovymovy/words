                "senses": [
                    {
                        "sense_id": "aa27bb0b-c187-3655-b6f5-5f18279ad19c",
                        "entry_id": "17b2a746-d370-3f3d-b008-69d305bbb11b",
                        "glosses": [
                            "większy od osy owad drapieżny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e09e96-12f9-47af-823b-04047415bc7a",
                                "sense_id": "aa27bb0b-c187-3655-b6f5-5f18279ad19c",
                                "text": "W trawie gniły stosy jabłek i gruszek, między nimi bzykały osy, a także mnóstwo szerszeni"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d804d693-b81e-4adb-addd-a81105589655",
                        "source_entry_id": "17b2a746-d370-3f3d-b008-69d305bbb11b",
                        "source_sense_id": "aa27bb0b-c187-3655-b6f5-5f18279ad19c",
                        "target_lang_word": "hornet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hornet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3080badc-94e8-3ffd-8716-4931e626c141",
                                        "entry_id": "e1650e8b-4e90-3975-8398-16286770f087",
                                        "glosses": [
                                            "A large wasp, of the genus Vespa, having a brown-and-yellow-striped body and the ability to inflict a serious sting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a313655e-2a58-32e2-a5a8-7962502d3e0b",
                                        "entry_id": "e1650e8b-4e90-3975-8398-16286770f087",
                                        "glosses": [
                                            "A person who pesters with petty but ceaseless attacks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eab43a4b-8920-4114-a7f2-62ce18e7f98d",
                        "source_entry_id": "17b2a746-d370-3f3d-b008-69d305bbb11b",
                        "source_sense_id": "aa27bb0b-c187-3655-b6f5-5f18279ad19c",
                        "target_lang_word": "Hornisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hornisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Art der Faltenwespen, die der Gattung der Großwespen (siehe [2]) angehört"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f963c8c-5cb3-4440-bbf2-7111958ffa1c",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "Der Stich einer Hornisse ist nicht gefährlicher als derjenige einer Biene."
                                            },
                                            {
                                                "example_id": "6650826b-a9a5-4fe0-9685-8320d6bbd210",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Zwei Hornissen stachen ihn fast zu gleicher Zeit, er brüllte vor Entsetzen und warf sein Gewehr weg.“"
                                            },
                                            {
                                                "example_id": "f4f17b4a-d17b-40e9-8c95-b1002ed5b9cb",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Dann flog eine Hummel in den Hochstand, die so groß war, daß sie auch eine Hornisse sein konnte.“"
                                            },
                                            {
                                                "example_id": "29ca2752-b58a-4424-a94f-6a6dbcd94895",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Bald schwärmten Fliegen, Wespen und Hornissen um das tote Tier; sie mussten es in den Graben werfen und dem Ungeziefer überlassen.“"
                                            },
                                            {
                                                "example_id": "77f124ae-924e-4daa-93eb-259b8e5568be",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Drohnen, Hornissen, Schmetterlinge fliegen unsachlich herum und stossten gegen die Stockwände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Sammelbezeichnung für die Gattung Vespa oder Großwespen"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508af155-d770-4495-b6d5-2451dba44341",
                                                "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                                "text": "Die Gattung der Hornissen zählt zu der Familie der Faltenwespen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
