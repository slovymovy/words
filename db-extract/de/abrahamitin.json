                "senses": [
                    {
                        "sense_id": "d44014c4-abd4-3f21-9efe-aa35d12be71c",
                        "entry_id": "b307071e-d685-3d96-a9e8-8a8ec6e78719",
                        "glosses": [
                            "Anhängerin der abrahamitischen Religionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b157e99-5fb0-42e4-95fd-3c74c70bbc7d",
                                "sense_id": "d44014c4-abd4-3f21-9efe-aa35d12be71c",
                                "text": "Die Abrahamitinnen glauben nur an einen Gott."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85e3b9b3-7c08-31e9-8b88-e69df870a75c",
                        "entry_id": "b307071e-d685-3d96-a9e8-8a8ec6e78719",
                        "glosses": [
                            "Anhängerin der syrischen Sekte Abrahams von Antiochien im 9. Jahrhundert, die die Gottheit Christi leugnete"
                        ],
                        "tags": [
                            "historisch,"
                        ],
                        "examples": [
                            {
                                "example_id": "c8598a86-cb2c-49b3-8cdc-ad30e4f18db3",
                                "sense_id": "85e3b9b3-7c08-31e9-8b88-e69df870a75c",
                                "text": "Die syrische Sekte der Abrahamiten leugnete die Gottheit Christi."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0ba1e890-496c-3572-90a7-a7200ef45725",
                        "entry_id": "b307071e-d685-3d96-a9e8-8a8ec6e78719",
                        "glosses": [
                            "Anhängerin der Bauernsekte Böhmens im 18. Jahrhundert, die den kirchlichen Gottesdienst und fast alle christlichen Dogmen verwarf und nur an den Glauben Abrahams vor seiner Beschneidung glaubt"
                        ],
                        "tags": [
                            "historisch,"
                        ],
                        "examples": [
                            {
                                "example_id": "1fc50a6a-dda6-43d8-9398-78e300bbebea",
                                "sense_id": "0ba1e890-496c-3572-90a7-a7200ef45725",
                                "text": "„Wie wenig noch allenthalben die Begriffe von der wahren Toleranz und von den unwidersprechlichen Rechten der Menschheit, in Absicht auf Glaubenssachen aufgeklärt sind, davon giebt die Geschichte von den Abrahamiten, Israeliten oder Deisten in Böhmen, ein trauriges Beyspiel.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
