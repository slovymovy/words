                "senses": [
                    {
                        "sense_id": "7ec8a991-2e47-3bd2-95d1-f78cb356a3e1",
                        "entry_id": "b14f23a1-3780-3f8f-8de3-5d68f8c4522d",
                        "glosses": [
                            "To educe, to extract."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d05168-4d94-4547-a9fd-270cb1fc79d6",
                                "sense_id": "7ec8a991-2e47-3bd2-95d1-f78cb356a3e1",
                                "text": "1878, W. J. Macquorn Rankine, Morton's Jet Condenser, John Bourne (author & editor), Examples of Steam, Air, & Gas Engines of the Most Recent Approved Types, Longmans, Green and Co., Appendix, page xlix,\nIn my 'Hand Book of the Steam Engine,' published in 1865, I pointed out that a feat more difficult than that of forcing the waste water out of the condenser might be performed by the educted steam, whether proceeding to the atmosphere or the condenser."
                            },
                            {
                                "example_id": "f9002c41-c830-45e7-9a44-d60cad892b34",
                                "sense_id": "7ec8a991-2e47-3bd2-95d1-f78cb356a3e1",
                                "text": "1960, Engineering Extension Series, Issue 145, Purdue University, Department of Engineering Extension, page 260,\nFrom this tank the carbon is educted with high pressure water to the dewatering screw above the regeneration furnace."
                            },
                            {
                                "example_id": "b70c7adf-f460-4ea9-bbae-99398cba343c",
                                "sense_id": "7ec8a991-2e47-3bd2-95d1-f78cb356a3e1",
                                "text": "1980, Marshall Sittig, Metal and Inorganic Waste Reclaiming Encyclopedia, Noyes Data Corporation, page 271,\nTo accomplish this, a preferred means is to provide an eductor 27 which has the line 28 communicating therewith and the educting fluid preferably is the vaporized hydrocarbon discharged […] ."
                            }
                        ]
                    }
