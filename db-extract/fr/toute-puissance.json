        "fr-extract.jsonl": [
            {
                "entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                "word": "toute-puissance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                        "entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                        "glosses": [
                            "Puissance absolue et illimitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13933a98-8f65-4598-988f-a809b648c12c",
                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                "text": "Il sait, fit-elle d’une voix ferme, qu’il ne peut atteindre au bonheur de l’amour que lorsque je lui aurai donné la toute-puissance de la royauté ; à ce moment-là seulement, Concino me tuera."
                            },
                            {
                                "example_id": "a8025ad0-b8b2-47c4-a6cd-b0e119554943",
                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                "text": "M. de Chemillé, vieux libertin, vous dirait que, dans le cas qui nous a retenus, il n'y a aucune intervention surhumaine, mais la manifestation de la toute-puissance de l'Amour, qui règne sur l'univers immense."
                            },
                            {
                                "example_id": "e3b25162-8403-4cc1-86d2-35bbf10885a4",
                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                "text": "Ce moment particulier de toute-puissance des médias s’est refermé. Aujourd’hui, le prétendu premier pouvoir est mal en point."
                            },
                            {
                                "example_id": "5af9daf6-c9e6-4e77-a861-a02e845a4d36",
                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                "text": "Le mythe de la toute-puissance paternelle joue un rôle fondamental dans la constitution de l'identité masculine."
                            },
                            {
                                "example_id": "078a4497-0661-42f8-9261-7f9835b4cfc3",
                                "sense_id": "10a2f8a4-6068-3744-bd53-c1559a58d5b3",
                                "text": "Ikarus l’admet : provoquer la mort lui donne un sentiment de toute-puissance."
                            }
                        ]
                    },
                    {
                        "sense_id": "df9c8ed0-5ec4-3ce4-a605-6828f5cee191",
                        "entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                        "glosses": [
                            "Celui qui a une puissance absolue et illimitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcede403-9a54-4da3-8a43-176c1945c5ad",
                                "sense_id": "df9c8ed0-5ec4-3ce4-a605-6828f5cee191",
                                "text": "Saccard avait remarqué que la jolie madame Michelin, qui se glissait si humblement par les portes entrebâillées, était une toute-puissance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02b2a92a-3029-4139-bfcd-2688acc28bf1",
                        "source_entry_id": "6b09eed9-a529-3fa9-b922-670c7f1ac608",
                        "target_lang_word": "παντοδυναμία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "παντοδυναμία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "86309074-2c3c-3184-8123-42e1311fea8c",
                                        "entry_id": "22b941db-6c00-350b-b19a-d55092d11c3b",
                                        "glosses": [
                                            "η ιδιότητα του παντοδύναμου, ιδιότητα του Θεού"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8578a781-2fcd-401d-8a5f-2a31bc8f99ef",
                                                "sense_id": "86309074-2c3c-3184-8123-42e1311fea8c",
                                                "text": "※ Στις αρχαίες κοινωνίες η κτιστή Φύση λατρευόταν ως θεός, γιατί ο άνθρωπος δεν είχε κατορθώσει να τη δαμάσει. Σήμερα κυριαρχεί η πίστη στην παντοδυναμία της τεχνολογίας. Ο τεχνολογισμός προκαλεί νέους ηθικούς προβληματισμούς που δεν αφορούν μόνο το φυσικό περιβάλλον, αλλά και τον ίδιο τον άνθρωπο. (Κωνσταντίνος Λιάκουρας, Αθανάσιος Γλάρος, Εκκλησιαστική Ιστορία και Πατέρες και Θεολόγοι της Εκκλησίας, τεύχος B΄, Γ´ Εκκλησιαστικού Γυμνασίου, Ινστιτούτο Εκπαιδευτικής Πολιτικής, αναθεωρημένη έκδοση 51-00009, ISBN 978-960-06-6218-4, ανακτήθηκε στις 18/1/2026 http://ebooks.edu.gr/ebooks/d/8547/5443/51-0004-01_Pateres-kai-Theologoi-tis-Ekklisias_G-Ekklisiastikou-Gymnasiou_Vivlio-Mathiti.pdf)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aae300e-bb35-37b8-9f8b-afbd800b28e7",
                                        "entry_id": "22b941db-6c00-350b-b19a-d55092d11c3b",
                                        "glosses": [
                                            "η πολύ μεγάλη ισχύς, πολιτική, κοινωνική, στρατιωτική κλπ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea5c195-ee77-49e0-a8f3-05754e425aa4",
                                                "sense_id": "5aae300e-bb35-37b8-9f8b-afbd800b28e7",
                                                "text": "η παντοδυναμία των ΗΠΑ είχε σαν αποτέλεσμα να μην αντιδράσουν άλλα κράτη της περιοχής"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
