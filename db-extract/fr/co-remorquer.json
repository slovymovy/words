                "senses": [
                    {
                        "sense_id": "39715a56-6e0f-3f95-9acf-8e575f55b0dc",
                        "entry_id": "7802df85-f1d1-3b6c-bbec-0f96d34369af",
                        "glosses": [
                            "Partager une remorque pour un déplacement (par exemple pour transporter deux motos sur la même remorque)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91de3874-782b-4ac2-9ed5-3538244c51bd",
                                "sense_id": "39715a56-6e0f-3f95-9acf-8e575f55b0dc",
                                "text": "Les participants déja pré-inscrits pour les DR Days peuvent s'inscrire ici afin de se mettre en relation pour co-motorer ou co-remorquer : certains d'entre eux se proposent de partager leur remorque ou cherche une place dans une remorque pour venir ou bien encore veulent tailler la route avec d'autres pour leur pélérinage en terre sainte vosgienne !!"
                            },
                            {
                                "example_id": "536b2cba-f47d-4ef3-9d70-440bcd941915",
                                "sense_id": "39715a56-6e0f-3f95-9acf-8e575f55b0dc",
                                "text": "Un des buts de ce forum, c'est de permettre de co-remorquer pour aller sur piste."
                            },
                            {
                                "example_id": "ad39a7fe-f9a0-4acc-a415-d8a75800e19f",
                                "sense_id": "39715a56-6e0f-3f95-9acf-8e575f55b0dc",
                                "text": "Co-remorquer ou co-voiturer pour y aller..."
                            }
                        ]
                    }
