    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3edc6d32-9f0d-3e0d-80ed-95b5de9e3740",
                    "sense_definition": "vanuit een verticale positie naar de grond vallen en horizontaal komen te liggen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de harde wind kan er vannacht een oude boom <w>omvallen</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "Due to the strong wind, an old tree might <w>fall over</w> in the garden tonight."
                            }
                        },
                        {
                            "text": "Hij stootte tegen de tafel waardoor zijn glas water bijna <w>omviel</w>.",
                            "target_lang_translations": {
                                "en": "He bumped into the table, causing his glass of water to almost <w>tip over</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkieperen",
                        "kantelen"
                    ],
                    "antonyms": [
                        "rechtop staan"
                    ],
                    "common_phrases": [
                        "bijna omvallen",
                        "laten omvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fall from a vertical position to the ground and end up lying horizontally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fall over",
                                "target_lang_sense_clarification": "general use for objects or people"
                            },
                            {
                                "target_lang_word": "to topple over",
                                "target_lang_sense_clarification": "often used for tall or heavy objects"
                            },
                            {
                                "target_lang_word": "to tip over",
                                "target_lang_sense_clarification": "often used for containers or smaller objects"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee8fd95-076b-33cf-8bc6-5221dfc94ee8",
                    "sense_definition": "het ophouden te bestaan van een bedrijf of organisatie door financiële problemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakelijk falen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kranten schrijven dat deze grote bank op <w>omvallen</w> staat door de crisis.",
                            "target_lang_translations": {
                                "en": "The newspapers are writing that this large bank is on the verge of <w>collapsing</w> due to the crisis."
                            }
                        },
                        {
                            "text": "Als de overheid niet helpt, zullen veel kleine winkels dit jaar <w>omvallen</w>.",
                            "target_lang_translations": {
                                "en": "If the government doesn't help, many small shops will <w>go under</w> this year."
                            }
                        }
                    ],
                    "synonyms": [
                        "failliet gaan",
                        "bankroet gaan"
                    ],
                    "antonyms": [
                        "overeind blijven",
                        "floreren"
                    ],
                    "common_phrases": [
                        "op omvallen staan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in journalistieke en zakelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The ceasing to exist of a company or organization due to financial problems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to collapse",
                                "target_lang_sense_clarification": "sudden failure of an organization"
                            },
                            {
                                "target_lang_word": "to go under",
                                "target_lang_sense_clarification": "informal term for going bankrupt"
                            },
                            {
                                "target_lang_word": "to fail",
                                "target_lang_sense_clarification": "general business failure"
                            }
                        ]
                    }
                }
            ]
        }
    ]
