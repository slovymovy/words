                ],
                "senses": [
                    {
                        "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                        "entry_id": "88ac5736-39e1-3b16-8a56-cd498a7c2668",
                        "glosses": [
                            "Qui rend un petit bruit indistinct ; qui bruisse, qui bruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921b5321-8876-4411-9718-c4ba5a49e0a6",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "Les dimanches, ils allaient se promener le long du canal, hantés par la mélancolie que les eaux semblaient charrier, alourdies par le reflet des ormes touffus, entre les rangées de roseaux bruissants."
                            },
                            {
                                "example_id": "a36cab5a-f137-4dbd-82a8-b82c5543fa84",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "Il s’enorgueillissait de l’avoir à son bras, vêtue d’une robe de soie bruissante, et des camarades qui l’avaient rencontré, l’avaient complimenté sur sa conquête."
                            },
                            {
                                "example_id": "d10632d6-20b9-43ad-adf4-0fc444bd0c2c",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "La directrice tapa dans ses mains, sans grande conviction, vers les bancs grouillants et bruissants.\n— Voyons, là-bas, un peu moins de vacarme !\nUne centaine de jeunes têtes présentèrent pendant cinq secondes l’attention de leurs yeux vifs, puis redevinrent exactement aussi mouvantes et babillantes."
                            },
                            {
                                "example_id": "e86bf3f7-37c6-44aa-bf63-43bde9890f4f",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "L’air était lourd, immobile et tout bruissant du vol de mille insectes."
                            },
                            {
                                "example_id": "ead9e4c1-6196-4c98-810a-ea75382ac39e",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "Il jette la chaux vive dans un grand seau d'eau et déclenche ainsi un bouillonnement bruissant et fumant."
                            },
                            {
                                "example_id": "87486de8-1fe2-45df-bec8-1924b40f9e45",
                                "sense_id": "39898080-9d8a-3707-a375-43a3d9d7d448",
                                "text": "Les derniers rayons cuivrés du soleil se réfléchissaient sur de longues feuilles vert sombre bruissantes."
                            }
                        ]
                    }
                ],
