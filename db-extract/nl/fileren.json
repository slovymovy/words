                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d7e3fe4-2639-47d3-b228-35d81dfea692",
                                                "sense_id": "7c70e7af-7b8b-3c52-b999-61f4ee1a2f75",
                                                "text": "Il s’est fait dézinguer en sortant d'un bar."
                                            },
                                            {
                                                "example_id": "e00eb0a6-ab56-460c-bb33-98a150ce10a3",
                                                "sense_id": "7c70e7af-7b8b-3c52-b999-61f4ee1a2f75",
                                                "text": "Il est vrai que cette union a tout pour plaire à Trump : le géant allemand des pesticides, dont le fameux Gaucho est soupçonné de dézinguer les abeilles, convolant avec l’américain Monsanto, leader mondial tout à la fois des OGM, des semences et des produits phytosanitaires…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade37f99-9bd7-3989-a4da-f4f0fab4e8dd",
                                        "entry_id": "703c3e2a-9bf3-3b41-a6aa-63916a55c0a6",
                                        "glosses": [
                                            "Démolir ; mettre à mal ; critiquer violemment."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9c5246-f7c4-459a-be7e-545d44b07c96",
                                                "sense_id": "ade37f99-9bd7-3989-a4da-f4f0fab4e8dd",
                                                "text": "Dominique de Villepin dézingue le chef de l’État."
                                            },
                                            {
                                                "example_id": "dfa65adc-b729-4a29-a8af-258664e3bc2b",
                                                "sense_id": "ade37f99-9bd7-3989-a4da-f4f0fab4e8dd",
                                                "text": "On est toujours partants pour se dézinguer le crâne, mais v’là la dèche d’alcool. Il faudrait trouver de la pillave."
                                            },
                                            {
                                                "example_id": "b97e4f64-9198-4362-9e10-28db559ca3c8",
                                                "sense_id": "ade37f99-9bd7-3989-a4da-f4f0fab4e8dd",
                                                "text": "Les scientifiques sont formels : le triclosan est un perturbateur endocrinien qui dézingue le système hormonal et favorise les malformations congénitales."
