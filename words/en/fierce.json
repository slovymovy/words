                            },
                            {
                                "target_lang_word": "强烈",
                                "target_lang_sense_clarification": "形容情感或愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cc18225-b53e-3638-ae3b-f8c07dc20864",
                    "sense_definition": "Of exceptional quality, exhibiting boldness, style, or confidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The model was told to strike a pose and make it <w>fierce</w>.",
                            "target_lang_translations": {
                                "ru": "Модели сказали принять позу и сделать её <w>дерзкой</w>.",
                                "zh": "模特被要求摆出一个姿势，并且要显得<w>大胆</w>。"
                            }
                        },
                        {
                            "text": "Her outfit at the gala was absolutely <w>fierce</w> and caught everyone's attention.",
                            "target_lang_translations": {
                                "ru": "Её наряд на гала-вечере был абсолютно <w>эффектным</w> и привлек всеобщее внимание.",
                                "zh": "她在晚宴上的装扮简直太<w>酷</w>了，吸引了所有人的目光。"
                            }
                        }
                    ],
                    "antonyms": [
                        "boring",
                        "plain"
                    ],
                    "common_phrases": [
                        "look fierce",
                        "fierce outfit"
                    ],
                    "traits": [
