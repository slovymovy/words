                                    {
                                        "sense_id": "7405372a-e879-3d6d-b8c8-dcc135ae6b54",
                                        "entry_id": "eefe9374-5f41-382c-8880-1a50b3df5b14",
                                        "glosses": [
                                            "Relativo a la costa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae75dc9-8f52-49d9-b059-deebce6f8150",
                                                "sense_id": "7405372a-e879-3d6d-b8c8-dcc135ae6b54",
                                                "text": "En el Reinado anterior se prohibió la saca del esparto en rama, por ser un fruto casi especial de la España y que fuera sólo se coge en Cerdeña y en algunos parajes de la África litoral."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "litoral",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "44e75f85-9323-3ac7-9cd8-23d151b99ad9",
                                        "entry_id": "b4e3c65d-00e6-3fed-9f9d-e0a7a87d2300",
                                        "glosses": [
                                            "Franja en torno a la línea de costa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603cb696-7a78-4221-a33b-1abc9ffb3d81",
                                                "sense_id": "44e75f85-9323-3ac7-9cd8-23d151b99ad9",
                                                "text": "La Emilia López, a bordo de la cual venía yo de Panamá, fondeó en la bahía de Buenaventura después de haber jugueteado sobre la alfombra marina acariciada por las brisas del litoral."
