    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a93577f6-18d6-381a-ab3c-95b5b847b9f5",
                    "sense_definition": "Present participle and gerund of <w>stick</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glue is not <w>sticking</w> to the paper very well.",
                            "target_lang_translations": {
                                "ru": "Клей не очень хорошо <w>приклеивается</w> к бумаге.",
                                "pl": "Klej nie <w>przykleja się</w> zbyt dobrze do papieru."
                            }
                        },
                        {
                            "text": "He is <w>sticking</w> with his original plan despite the difficulties.",
                            "target_lang_translations": {
                                "ru": "Он <w>придерживается</w> своего первоначального плана, несмотря на трудности.",
                                "pl": "On <w>trzyma się</w> swojego pierwotnego planu pomimo trudności."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sticking out",
                        "sticking together",
                        "sticking with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола stick (клеить, липнуть, придерживаться).",
                        "pl": "Imiesłów czynny lub rzeczownik odczasownikowy od czasownika 'stick' (kleić, przywierać, trzymać się czegoś)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипание",
                                "target_lang_sense_clarification": "свойство клея или материала"
                            },
                            {
                                "target_lang_word": "приклеивание",
                                "target_lang_sense_clarification": "процесс соединения"
                            },
                            {
                                "target_lang_word": "придерживание",
                                "target_lang_sense_clarification": "следование плану или идее"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przyklejanie",
                                "target_lang_sense_clarification": "proces łączenia powierzchni"
                            },
                            {
                                "target_lang_word": "trzymanie się",
                                "target_lang_sense_clarification": "pozostawanie przy planie lub decyzji"
                            },
                            {
                                "target_lang_word": "przyleganie",
                                "target_lang_sense_clarification": "stan bycia przyklejonym do czegoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "359ef47c-686f-35d4-b2cd-878ffa3416f4",
                    "sense_definition": "A sequence or arrangement of drum notes to be played with drumsticks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer practiced the complex <w>sticking</w> for several hours.",
                            "target_lang_translations": {
                                "ru": "Барабанщик несколько часов отрабатывал сложную <w>аппликатуру</w>.",
                                "pl": "Perkusista ćwiczył złożony <w>układ uderzeń</w> przez kilka godzin."
                            }
                        },
                        {
                            "text": "Good <w>sticking</w> technique allows for faster and more fluid rhythms.",
                            "target_lang_translations": {
                                "ru": "Хорошая техника <w>игры палочками</w> позволяет играть более быстрые и плавные ритмы.",
                                "pl": "Dobra <w>technika uderzeń</w> pozwala na szybsze i bardziej płynne rytmy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность или схема ударов палочками при игре на барабанах.",
                        "pl": "Sekwencja lub układ uderzeń pałeczkami perkusyjnymi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аппликатура",
                                "target_lang_sense_clarification": "схема чередования рук при игре"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "technika uderzeń",
                                "target_lang_sense_clarification": "sposób operowania pałeczkami"
                            },
                            {
                                "target_lang_word": "układ uderzeń",
                                "target_lang_sense_clarification": "sekwencja ruchów rąk perkusisty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ade14233-ee12-39a2-8f2c-4457760568df",
                    "sense_definition": "Coarse, bruised, or damaged meat sold to the makers of sausages, pies, etc.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher set aside the <w>sticking</w> to be ground into sausage meat.",
                            "target_lang_translations": {
                                "ru": "Мясник отложил <w>зарез</w>, чтобы перекрутить его на колбасный фарш.",
                                "pl": "Rzeźnik odłożył <w>obрезь</w>, aby zmielić ją na farsz kiełbasiany."
                            }
                        },
                        {
                            "text": "They bought cheap <w>sticking</w> to make pies for the market.",
                            "target_lang_translations": {
                                "ru": "Они купили дешевый <w>зарез</w>, чтобы наделать пирогов для рынка.",
                                "pl": "Kupili tanią <w>obрезь</w>, żeby zrobić paszteciki na sprzedaż."
                            }
                        }
                    ],
                    "synonyms": [
                        "trimmings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое, поврежденное мясо (обычно с шеи), идущее на переработку.",
                        "pl": "Gorszej jakości, uszkodzone mięso (zazwyczaj z okolic szyi), przeznaczone do przetworzenia na farsz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарез",
                                "target_lang_sense_clarification": "мясо с места убоя"
                            },
                            {
                                "target_lang_word": "обрезь",
                                "target_lang_sense_clarification": "остатки мяса для фарша"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obрезь",
                                "target_lang_sense_clarification": "odpady mięsne przeznaczone na mielenie"
                            },
                            {
                                "target_lang_word": "mięso gorszej jakości",
                                "target_lang_sense_clarification": "mięso przeznaczone do przetworzenia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
