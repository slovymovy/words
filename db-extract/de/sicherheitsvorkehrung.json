                ],
                "senses": [
                    {
                        "sense_id": "85f51fa5-04e0-3e2e-aa85-508cbe51260a",
                        "entry_id": "7d71edc5-5d8c-3324-ae3d-763ef15dadbb",
                        "glosses": [
                            "Maßnahme, die getroffen wird, um die Sicherheit von jemandem oder etwas zu gewährleisten"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "eb9ee37c-0417-4614-a10f-e02363c27939",
                                "sense_id": "85f51fa5-04e0-3e2e-aa85-508cbe51260a",
                                "text": "Nach dem bekannt wurde, dass die Regierungsmitglieder in Gefahr sind, wurden Sicherheitsvorkehrungen getroffen."
                            },
                            {
                                "example_id": "590140ac-dd0a-40b4-a043-288d90ef33fd",
                                "sense_id": "85f51fa5-04e0-3e2e-aa85-508cbe51260a",
                                "text": "Nach dem 11. September wurden mehr Sicherheitsvorkehrungen an den Flughäfen getroffen."
                            },
                            {
                                "example_id": "ed7e502a-447b-4462-abec-101c9441e9f2",
                                "sense_id": "85f51fa5-04e0-3e2e-aa85-508cbe51260a",
                                "text": "„An die meisten Träume können wir uns morgens aber nicht erinnern. Sie bleiben unbewusst. Das ist wahrscheinlich eine Sicherheitsvorkehrung der Natur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
