                "senses": [
                    {
                        "sense_id": "68c6f92c-c857-3927-9773-05c5e35ec0be",
                        "entry_id": "70186f88-5fa5-36a7-b7dc-588929b32fa9",
                        "glosses": [
                            "Brief, der gegen eine Zusatzgebühr dem Empfänger besonders schnell zugestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b1335f-a428-4069-8ea3-fb9894dbb927",
                                "sense_id": "68c6f92c-c857-3927-9773-05c5e35ec0be",
                                "text": "„Sehr langsam und nachdenklich ging Heinz mit seinen Eilbriefen zur Post.“"
                            },
                            {
                                "example_id": "f436f8d5-00e9-4ca3-af86-6ae4dbda8f31",
                                "sense_id": "68c6f92c-c857-3927-9773-05c5e35ec0be",
                                "text": "„Auf einem anderen, unfreien, mit Nachporto belegten Eilbrief von Stuttgart nach Straßburg finden wir auf der Rückseite nicht nur den Ankunftstempel von Straßburg, sondern auch den daneben abgeschlagenen, individuellen Stempel des Zustellers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
