    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9d976e7-cad7-3530-ab55-bfe48d8157eb",
                    "sense_definition": "Arriver précipitamment, à toute vitesse ou de manière tout à fait inattendue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a vu une voiture <w>débouler</w> à toute vitesse au croisement des deux rues."
                        },
                        {
                            "text": "Mon voisin aime <w>débouler</w> chez nous à l'improviste pendant le repas du soir."
                        }
                    ],
                    "synonyms": [
                        "se pointer"
                    ],
                    "common_phrases": [
                        "débouler à toute vitesse",
                        "débouler sans prévenir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "a7fec4d5-399e-352b-9555-dc61a4b2991c",
                    "sense_definition": "Descendre une pente à grande vitesse ou faire une chute brutale de haut en bas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a couru un peu trop vite et a failli <w>débouler</w> dans l'escalier."
                        },
                        {
                            "text": "Des pierres ont commencé à <w>débouler</w> sur la route après les fortes pluies."
                        }
                    ],
                    "synonyms": [
                        "dévaler"
                    ],
                    "common_phrases": [
                        "débouler les escaliers",
                        "débouler la pente"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé familièrement"
                        }
                    ]
                },
                {
                    "sense_id": "e2f34a22-c964-335a-9d19-e03530db60c3",
                    "sense_definition": "Raconter ou débiter des propos de manière rapide, continue et spontanée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est mis à <w>débouler</w> toute son histoire sans reprendre son souffle un seul instant."
                        },
                        {
                            "text": "Elle lui a <w>déboulé</w> tous ses reproches dès qu'il a franchi la porte d'entrée."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "usage argotique ou très familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed220cb8-4130-3a68-ac7b-38f1ce286193",
                    "sense_definition": "Moment précis où un lièvre ou un lapin surgit précipitamment de son gîte ou de son terrier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur attend patiemment le <w>débouler</w> du gibier à l'orée du bois dense."
                        },
                        {
                            "text": "Au <w>débouler</w> du lièvre, les chiens se sont immédiatement lancés à sa poursuite."
                        }
                    ],
                    "common_phrases": [
                        "au débouler du lièvre"
                    ]
                }
            ]
        }
    ]
