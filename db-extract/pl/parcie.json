                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe790ac3-0cd7-4005-835b-b70e5cf4918d",
                        "source_entry_id": "daabbc90-9dbc-322f-8e1d-df31d662648e",
                        "source_sense_id": "534c2564-5db9-33fb-b619-3ce5811d228f",
                        "target_lang_word": "pressure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d353a7-471b-3c46-8f38-2aa476ef24bc",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "A pressing; a force applied to a surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8fab10f-3879-44ff-96be-27dfe263d27f",
                                                "sense_id": "c7d353a7-471b-3c46-8f38-2aa476ef24bc",
                                                "text": "Apply pressure to the wound to stop the bleeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "A contrasting force or impulse of any kind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6056f016-16e7-4fce-815f-b14723a90a9f",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "Hostile forces are putting pressure on our people. Take out their supply line to give our troops room to breathe."
                                            },
                                            {
                                                "example_id": "a9ef64e5-8f69-4a36-83f8-37da2bf63db2",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "the pressure of poverty; the pressure of taxes; the pressure of motives on the mind; the pressure of civilization."
                                            },
                                            {
                                                "example_id": "622d11f3-90e0-487a-a632-78063e044960",
                                                "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                                                "text": "When the pressure of danger was not felt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f466299-0a90-4ed7-879e-dabf607d7ad5",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "She has felt pressure lately because her boss expects her to get the job done by the first."
                                            },
                                            {
                                                "example_id": "50c56549-8b5b-4b0c-90e4-4ed561d0dbec",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "My people's pressures are grievous."
                                            },
                                            {
                                                "example_id": "4de15eac-e29e-44fb-b5e9-fbff3c0cfb62",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "October 31, 1708, Francis Atterbury, a sermon preach'd before the Queen at St. James's\nIn the midst of his great troubles and pressures."
                                            },
                                            {
                                                "example_id": "12e39a6a-66f4-4202-955e-fbaeae84d2a5",
                                                "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                                                "text": "Thirty-five years ago, many journeys around London meant having to pass through the centre of the capital. That's no longer the case, which takes real pressure off the city's termini as well as underground routes such as the Circle Line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64ce59c-0efd-3c25-b163-86b5a6fbac6f",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Urgency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d1a38a-9321-4149-8d71-2a97069b1177",
                                                "sense_id": "d64ce59c-0efd-3c25-b163-86b5a6fbac6f",
                                                "text": "the pressure of business"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55977157-a531-3ff2-b8e8-3e0505a758b3",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "Impression; stamp; character impressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72f0581a-af1f-430f-8b4f-aad01ba431d0",
                                                "sense_id": "55977157-a531-3ff2-b8e8-3e0505a758b3",
                                                "text": "All saws of books, all forms, all pressures past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf541a43-0206-346b-9144-d08adf2c2868",
                                        "entry_id": "ce9f0050-fd88-3c80-b1b7-8cc5324cf08a",
                                        "glosses": [
                                            "The amount of force that is applied over a given area divided by the size of this area; force per unit area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3cf2ad5-ea7c-3f5b-9351-6060c4337eb8",
                                        "entry_id": "3108e46e-1ebf-31af-8216-d5047f0745cb",
                                        "glosses": [
                                            "To encourage or heavily exert force or influence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043d0052-1613-4bbb-989f-25c721ec1d9e",
                                                "sense_id": "c3cf2ad5-ea7c-3f5b-9351-6060c4337eb8",
                                                "text": "Do not let anyone pressure you into buying something you do not want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f86d7ed1-7474-4203-972e-f7abe82ee15c",
                        "source_entry_id": "daabbc90-9dbc-322f-8e1d-df31d662648e",
                        "source_sense_id": "a292a1bb-4020-39f5-b96e-493b00bde23d",
                        "target_lang_word": "Druck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6788421-f482-3fab-8672-98818626acff",
                                        "entry_id": "8afd30af-7858-3383-960f-e4225c2e09d0",
                                        "glosses": [
                                            "Kraft pro Fläche"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bda52b-a00e-4ad0-a03e-a5f1706dd6ca",
                                                "sense_id": "d6788421-f482-3fab-8672-98818626acff",
                                                "text": "Die Gleichheit des hydrostatischen Drucks auf gleicher Höhe wird bei dem Prinzip der kommunizierenden Röhren genutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                        "entry_id": "8afd30af-7858-3383-960f-e4225c2e09d0",
                                        "glosses": [
                                            "psychische (Stress) oder physische Belastung in beziehungsweise vor Leistungssituationen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "309a40a2-cc4a-4f15-ba99-dcaf42eaacca",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "Vor dem Abitur stehen viele Schüler unter Druck."
                                            },
                                            {
                                                "example_id": "1d162f41-ec68-476e-9964-030ce30c02af",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Auf Druck der Öffentlichkeit hatte der Polizeipräsident zunächst den Verein verboten, um das Verbot vier Wochen später wieder aufzuheben.“"
                                            },
                                            {
                                                "example_id": "2e96c4bc-6b4c-4cbe-8381-75aa3a98b3d2",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Statt Linderung verspürte Irmgard Ried nach dem Besuch noch mehr Druck, weil es für ihr Leid offensichtlich keinen legitimen Grund gab.“"
                                            },
                                            {
                                                "example_id": "0c7f4e00-a847-417a-9c5e-c67425f3b3fe",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Aber der Durchschnittsdeutsche aller sozialen Klassen sieht viel sauberer und ordentlicher aus, als man angesichts seiner wirklichen Lebensbedingungen, des Drucks und der Plackerei seines Lebens erwarten könnte.“"
                                            },
                                            {
                                                "example_id": "2ed35bec-ff1b-4f5e-b16c-70f57df39fcb",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Mafiöse Gruppen versuchten an allen möglichen Stellen, korrumpierbare Helfer zu rekrutieren, mit Druck oder mit Geld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ea54895-c0f1-3c86-bebd-8c0915ecbf30",
                                        "entry_id": "8afd30af-7858-3383-960f-e4225c2e09d0",
                                        "glosses": [
                                            "Vorgang des Drückens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e0117a-e2e2-4764-bf4e-ea3c4b958a18",
                                                "sense_id": "0ea54895-c0f1-3c86-bebd-8c0915ecbf30",
                                                "text": "Ein gelegentlicher Druck auf die Umschalttaste würde dem Schriftbild guttun."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Druck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                        "entry_id": "0bf06019-0fa2-3f48-8567-51cc2c98f4a1",
                                        "glosses": [
                                            "Reproduktionsverfahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366b197d-8076-48d6-b422-ca34ff9e3717",
                                                "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                                "text": "Der Druck erlaubt die günstige Vervielfältigung von Text und Bildern; er wurde in Asien um 770 n. Chr. entwickelt und seitdem weltweit verbessert."
                                            },
                                            {
                                                "example_id": "ae5b0b1e-a5ae-423e-be9d-8dda2dcfa20f",
                                                "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                                "text": "„Nach dem Druck kann diese Schicht vom Zylinder entfernt werden und ermöglicht nach erneuter Galvanisierung dessen Wiederverwendung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                        "entry_id": "0bf06019-0fa2-3f48-8567-51cc2c98f4a1",
                                        "glosses": [
                                            "Ergebnis des Reproduktionsverfahrens ^([2])"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d59f47e-48fd-4d87-afdd-b21bf2e5cdd8",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "Ein guter Druck ist meist kaum vom Original zu unterscheiden."
                                            },
                                            {
                                                "example_id": "a5c0b0a8-2586-4e25-a97e-f67ffda96d86",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Er stellte mehr als 200 Drucke her.“"
                                            },
                                            {
                                                "example_id": "3b2dc7c0-7a9b-4e46-86c4-5189f9333775",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Sämtliche Glossen stammen aus der Entstehungszeit dieser Werke und werden seit jeher in den meisten Abschriften und Drucken mit aufgeführt.“"
                                            },
                                            {
                                                "example_id": "118ffa82-1c99-4e98-bf83-a69ca80edfc3",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Bereits zu Luthers Zeiten gelangten Hunderttausende von Exemplaren unter die Leute: Drucke aus Wittenberg, Nachdrucke aus Augsburg, Leipzig oder Basel, Teildrucke im Kleinformat, einspaltige und zweispaltige, einbändige und mehrbändige Drucke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
