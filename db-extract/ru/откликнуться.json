                            "past"
                        ],
                        "form": "откли́кнувшийся"
                    },
                    {
                        "form_id": "5994ec8b-305e-41f0-b76a-482f19539cdc",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "откли́кнувшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd2df48e-464a-3c10-9271-cfbc3c21b906",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "ответить на чей-либо зов, на обращённые слова; отозваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f9329a-ccc6-4d2f-895e-0a566ea643fe",
                                "sense_id": "cd2df48e-464a-3c10-9271-cfbc3c21b906",
                                "text": "— Зина, а Зина! — проговорила старуха. Зинаида не откликнулась."
                            },
                            {
                                "example_id": "7b4415f5-8215-4657-99a6-2119858bfe2d",
                                "sense_id": "cd2df48e-464a-3c10-9271-cfbc3c21b906",
                                "text": "Стоит ему только назвать жену по имени, как она откликнется."
                            }
                        ]
                    },
                    {
                        "sense_id": "a200517c-ad40-39a3-8237-4aa182e82e8b",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "подать о себе весть ответным письмом; написать ответное письмо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae566d63-5215-4ea3-ab01-a23c96e0c280",
                                "sense_id": "a200517c-ad40-39a3-8237-4aa182e82e8b",
                                "text": "Выйдя из театра, я сейчас же послала А. П. телеграмму. Он откликнулся письмом: «Милая кума, поздравляю вас с новым годом, желаю провести оный в добром здравии и благополучии, и дождаться многих предбудущих.»"
                            }
                        ]
                    },
                    {
                        "sense_id": "6f069f59-f2b0-30cf-873d-64a7ae5cd788",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "прозвучать в ответ на что-либо; дать отзвук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4329b1e5-1b00-4dc6-8f7d-63bd55f983d4",
                                "sense_id": "6f069f59-f2b0-30cf-873d-64a7ae5cd788",
                                "text": "― Виновен! ― откликнулось эхо."
                            }
                        ]
                    },
                    {
                        "sense_id": "32a29aba-4265-38a6-80af-e8e55f2517b6",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "перен., ответить каким-либо образом на какое-либо событие, явление, выразить, проявить своё отношение к чему-либо"
                        ],
                        "tags": [
                            "на что?"
                        ],
                        "examples": [
                            {
                                "example_id": "e31c3ffa-07b1-4a0e-994a-6c28c5105ae8",
                                "sense_id": "32a29aba-4265-38a6-80af-e8e55f2517b6",
                                "text": "Пушкин откликнулся на всё, в чём проявлялась русская жизнь; он обозрел все её стороны."
                            }
                        ]
                    },
                    {
                        "sense_id": "81d73676-6871-3061-a1a9-f02b69dee4b4",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "перен., проявить сочувствие, одобрение, готовность содействовать, помочь кому-либо, чему-либо, поддержать кого-либо, что-либо"
                        ],
                        "tags": [
                            "на что?"
                        ],
                        "examples": [
                            {
                                "example_id": "8b6783c5-0fc2-4bc5-9916-652b0685a803",
                                "sense_id": "81d73676-6871-3061-a1a9-f02b69dee4b4",
                                "text": "На эту просьбу откликнулись все ребята, и каждый принёс кто книгу, кто две, а многие принесли и больше."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5fd960-642a-3f55-8a22-33749a1d412f",
                        "entry_id": "d039feb6-d52d-384c-aabf-ebd848ffd358",
                        "glosses": [
                            "перен. вновь проявиться, обнаружиться; подать весть, дать знать о себе каким-либо образом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b501c9e-19d9-41ae-805c-20544d4931cd",
                                "sense_id": "0d5fd960-642a-3f55-8a22-33749a1d412f",
                                "text": "[Н е з н а м о в]: А знают ли они, как иногда этот несчастный, напрасно обруганный и оскорблённый, обливает слезами маменькин подарок? Где, мол, ты ликуешь теперь, откликнись!"
                            },
                            {
                                "example_id": "5deefb4b-5e5c-4f4a-9067-a9b6c566f6d2",
                                "sense_id": "0d5fd960-642a-3f55-8a22-33749a1d412f",
                                "text": "Что с Вами, голубчик мой, откликнитесь, напишите мне строчку."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
