                                    {
                                        "sense_id": "d5845491-ecc7-31ae-9075-8ba9c739b661",
                                        "entry_id": "7940ea5b-c7c4-382d-9e65-3066a9a30b1e",
                                        "glosses": [
                                            "A city in West Flanders, Belgium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3332a0-4d0e-4b63-8808-04a51e980c66",
                                                "sense_id": "d5845491-ecc7-31ae-9075-8ba9c739b661",
                                                "text": "Ypres was not the actual start of the front; that distinction belongs to Nieuport, a city on the North Sea twentyodd miles down the river Yser from Ypres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b63b12-1947-3e1d-9fa9-3a816635b1f2",
