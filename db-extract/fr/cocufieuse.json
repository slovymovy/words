                        ],
                        "examples": [
                            {
                                "example_id": "751402cf-c401-4e77-85b5-5c911c4ed648",
                                "sense_id": "e20e4aab-0564-3707-a3ff-e8608d627cf9",
                                "text": "Pensant qu’un cocu éventuel ne pouvait choisir pour femme qu’une cocufieuse en puissance, il se gardait bien cependant de jeter la pierre aux femmes. Elles représentaient la majorité de sa clientèle."
                            },
                            {
                                "example_id": "469fa718-d99f-4e50-adb4-1ee5e4b65e05",
                                "sense_id": "e20e4aab-0564-3707-a3ff-e8608d627cf9",
                                "text": "Ainsi dans les Thesmophories, Mica se plaint du mal qu’Euripide fait aux femmes en les traitant de « cocufieuses, de coureuses, de pochardes, de traîtresses, de commères […], de grandes plaies des hommes »."
                            }
                        ]
                    }
