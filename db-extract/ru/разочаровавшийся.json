                "translations": [
                    {
                        "translation_id": "e290b464-262f-4b6e-a65c-5b5976bc4250",
                        "source_entry_id": "7b3de58f-1c6f-3fa5-b1fa-8f46c3c01e8d",
                        "source_sense_id": "72edb7cd-caa7-3cf0-8b98-748a333a4600",
                        "target_lang_word": "disappointed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappointed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                        "entry_id": "1f16eefd-c37a-3a74-93b2-f40ca709c2c7",
                                        "glosses": [
                                            "Defeated of expectations or hope; experiencing disappointment; let down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ba9c33-9595-46c6-ae6a-7a8baeb03ca9",
                                                "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                                "text": "After all his anticipation, the trip left him deeply disappointed."
                                            },
                                            {
                                                "example_id": "26c65602-e597-425d-9f8e-366e91e96f95",
                                                "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                                                "text": "If they came to hear me beg, they will be disappointed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21db216a-e9fb-38fb-8311-a82c90af32a1",
                                        "entry_id": "1f16eefd-c37a-3a74-93b2-f40ca709c2c7",
                                        "glosses": [
                                            "Defeated of expectations or hope; experiencing disappointment; let down.",
                                            "Having had a marriage proposal rejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1e8c05-15f9-479c-a5e5-cd1942250c44",
                                                "sense_id": "21db216a-e9fb-38fb-8311-a82c90af32a1",
                                                "text": "Scattered here and there amongst the steerage passengers were men of a different class: men whose previous lives had not fitted them for the hard and uncertain lot that certainly lay before them - pale-faced boys from Melbourne shops; middle-aged and disappointed men; one and all hoping for a turn of luck in the lottery of the newly-discovered goldfield."
                                            }
                                        ]
                                    },
