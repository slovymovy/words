{
    "word_family": [
        "subjugate",
        "subjugator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7955cc86-8c97-3163-83b9-0b1a646eba20",
                    "sense_definition": "The act of conquering or bringing under complete control.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid military campaign led to the total <w>subjugation</w> of the neighboring territories.",
                            "target_lang_translations": {
                                "ru": "Стремительная военная кампания привела к полному <w>покорению</w> соседних территорий."
                            }
                        },
                        {
                            "text": "The emperor sought the <w>subjugation</w> of all rebellious factions within the empire.",
                            "target_lang_translations": {
                                "ru": "Император стремился к <w>подчинению</w> всех мятежных группировок внутри империи."
                            }
                        }
                    ],
                    "synonyms": [
                        "conquest"
                    ],
                    "antonyms": [
                        "liberation"
                    ],
                    "common_phrases": [
                        "total subjugation",
                        "military subjugation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по завоеванию или установлению полного контроля над кем-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчинение",
                                "target_lang_sense_clarification": "процесс установления власти и контроля"
                            },
                            {
                                "target_lang_word": "покорение",
                                "target_lang_sense_clarification": "завоевание, силовое подчинение"
                            },
                            {
                                "target_lang_word": "порабощение",
                                "target_lang_sense_clarification": "лишение свободы и независимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0660d143-b241-3a0d-aa7f-0a6ffe5cb4c3",
                    "sense_definition": "The state of being dominated or forced into submission by others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The people lived in fear and complete <w>subjugation</w> under the oppressive regime.",
                            "target_lang_translations": {
                                "ru": "Народ жил в страхе и полном <w>повиновении</w> при деспотическом режиме."
                            }
                        },
                        {
                            "text": "Generations struggled against economic <w>subjugation</w> before finally achieving true independence.",
                            "target_lang_translations": {
                                "ru": "Поколения боролись против экономического <w>порабощения</w>, прежде чем наконец обрести подлинную независимость."
                            }
                        }
                    ],
                    "antonyms": [
                        "freedom",
                        "independence"
                    ],
                    "common_phrases": [
                        "political subjugation",
                        "economic subjugation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние зависимости, подавленности или полного подчинения чужой воле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчинение",
                                "target_lang_sense_clarification": "нахождение под чужим контролем"
                            },
                            {
                                "target_lang_word": "порабощение",
                                "target_lang_sense_clarification": "состояние угнетения и несвободы"
                            },
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "подневольное положение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}