                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsfuncties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>spuwde</w> op de grond uit pure minachting voor de situatie.",
                            "target_lang_translations": {
                                "en": "He <w>spat</w> on the ground out of pure contempt for the situation."
                            }
                        },
                        {
                            "text": "Het is erg onbeleefd om op straat te <w>spuwen</w>.",
                            "target_lang_translations": {
                                "en": "It is very rude to <w>spit</w> in the street."
                            }
                        }
                    ],
                    "synonyms": [
