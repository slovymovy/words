                                        "entry_id": "2c570109-351d-398a-83f7-793cbac253a5",
                                        "glosses": [
                                            "(meist geschlossene) Rennbahn für Fahrräder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d2ba3a-1c40-4c4f-9704-3a2a65fe572b",
                                                "sense_id": "a05652b2-5d45-3e67-8bd7-b788e6b48a5d",
                                                "text": "Drei Tage vor der offiziellen Eröffnung der Olympischen Spiele wird die Technik einer Anzeigetafel im Athener Velodrom gecheckt. (www.spiegel.de)"
                                            },
                                            {
                                                "example_id": "1b3b6552-b738-4ea5-b96d-a52a752c8ae8",
                                                "sense_id": "a05652b2-5d45-3e67-8bd7-b788e6b48a5d",
                                                "text": "„Das Dröhnen der Räder und die anfeuernden Rufe der Zuschauer im Velodrom waren laut und belebend gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
