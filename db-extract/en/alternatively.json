        "zh-extract.jsonl": [
            {
                "entry_id": "14da7d6d-35ce-3504-9563-f19b79b1f06d",
                "word": "alternatively",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fe15f7c-ac8d-39c9-a347-7d18c63bae83",
                        "entry_id": "14da7d6d-35ce-3504-9563-f19b79b1f06d",
                        "glosses": [
                            "以另一種方式"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134847aa-04c2-4d39-add2-9b1bd3f6a423",
                                "sense_id": "5fe15f7c-ac8d-39c9-a347-7d18c63bae83",
                                "text": "Observers should keep in mind that these efforts at living alternatively are not easily undertaken; indeed, if they were, more people would be doing what they do.",
                                "translation": "观察者应该牢记，这些另类生活方式的努力并不容易；事实上，如果这些努力容易的话，那应该会有更多的人去做他们正在做的事情。"
                            },
                            {
                                "example_id": "fecdb36a-1441-42c5-abf1-0aeb2350df74",
                                "sense_id": "5fe15f7c-ac8d-39c9-a347-7d18c63bae83",
                                "text": "Thus, we are creating a new class struggle between those who live within the social system and those who are marginalized or wish to live alternatively.",
                                "translation": "因此，我们正在生活于现行社会体制内的人们和被边缘化或希望采取别样生活方式的人们之间制造一场新的阶级斗争。"
                            },
                            {
                                "example_id": "66d1b929-4e2d-4222-b258-ef70799ad5e8",
                                "sense_id": "5fe15f7c-ac8d-39c9-a347-7d18c63bae83",
                                "text": "Devising obviously asks for what we understand as general creativity, like the ability to take an initiative, to invent, to think alternatively, to associate interestingly, to create metaphors and images.",
                                "translation": "设计显然需要我们所理解的一般创造力，例如采取主动行动的能力、发明的能力、另类思考的能力、有趣的联想的能力、创造隐喻和图像的能力。"
                            },
                            {
                                "example_id": "c25da90e-6e00-45a5-b363-ced59fbf8bf6",
                                "sense_id": "5fe15f7c-ac8d-39c9-a347-7d18c63bae83",
                                "text": "Most people living alternatively have strong pro-environmental values and, unlike many 'greens' in mainstream society, are generally able to apply their values in day-to-day life.",
                                "translation": "大多数选择另类生活方式的人都具有强烈的环保价值观，与主流社会中的许多“绿党”不同，他们通常能够在日常生活中践行自己的价值观。"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c85628-0bdd-3a20-9412-c512685ad688",
                        "entry_id": "14da7d6d-35ce-3504-9563-f19b79b1f06d",
