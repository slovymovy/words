                        "examples": [
                            {
                                "example_id": "8f39008f-38e3-46d0-ba1d-debd46361bee",
                                "sense_id": "7aac039e-0a81-305a-8020-01791bb62898",
                                "text": "Wir stellen Dörrobst selbst her."
                            },
                            {
                                "example_id": "1d095ce4-bd52-4873-b7ab-dbf8e803eb50",
                                "sense_id": "7aac039e-0a81-305a-8020-01791bb62898",
                                "text": "Seinen Söhnen gibt der Vater jeden Tag Dörrobst mit in die Schule."
                            },
                            {
                                "example_id": "8fd49921-69c4-43ef-9733-069f54f56b02",
                                "sense_id": "7aac039e-0a81-305a-8020-01791bb62898",
                                "text": "Sie isst gern gedörrte Äpfel und anderes Dörrobst."
                            },
                            {
                                "example_id": "ea7dbdfa-2d8d-4fe6-8ed9-7a30af5fa5c3",
                                "sense_id": "7aac039e-0a81-305a-8020-01791bb62898",
                                "text": "Er schätzt den einzigartigen Geschmack des Dörrobstes."
                            },
                            {
                                "example_id": "2a6f1045-bdfc-46c8-9ab5-9e3d3b07498c",
                                "sense_id": "7aac039e-0a81-305a-8020-01791bb62898",
                                "text": "Margot ist sich sicher, dass diese Süßspeise Rosinen oder anderes Dörrobst beinhaltet."
                            }
                        ],
