                        "glosses": [
                            "Full of hours; time-consuming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e410973-3358-47e6-ac26-ee99e32904a9",
                                "sense_id": "7c20b017-9389-356a-8661-0cb7b4971074",
                                "text": "And all I did was Moan and rise and moan And fall And pain away and break And slip In many hourful whiles."
                            },
                            {
                                "example_id": "95540bc7-8530-4329-a922-8363f936a2a1",
                                "sense_id": "7c20b017-9389-356a-8661-0cb7b4971074",
                                "text": "Angley then drifts into his hourful, mouthful extempore, accentuated with refrains of \"cast the demon away with the power of the Lord.\""
                            },
                            {
                                "example_id": "254a5afc-7abc-40df-aaa4-73471c5556c4",
                                "sense_id": "7c20b017-9389-356a-8661-0cb7b4971074",
                                "text": "Timed perfectly for nearly nothing, the hourful day proceeds."
                            }
                        ]
                    }
                ],
