                    {
                        "sense_id": "9cbbb2e4-c3c4-31b5-baf9-d51eac2de023",
                        "entry_id": "abb70638-b4f5-3a5d-8812-654557923779",
                        "glosses": [
                            "ruimte die iemand de gelegenheid geeft om te kunnen ademhalen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b42b5ada-5582-3dab-ba28-02f03ac1edd4",
                        "entry_id": "abb70638-b4f5-3a5d-8812-654557923779",
                        "glosses": [
                            "een zodanige verlichting van een probleem dat iemand verder kan gaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "76dcadee-2f5a-418b-a4de-a1480c7f436a",
                                "sense_id": "b42b5ada-5582-3dab-ba28-02f03ac1edd4",
                                "text": "Ziekenhuizen hebben volgens Kuipers nu wat ademruimte gekregen. \"Dat biedt de mogelijkheid om patiënten zo goed mogelijk te blijven spreiden.\""
                            },
                            {
                                "example_id": "166990ca-7bc0-48ad-8e3c-8c4c5da3e935",
                                "sense_id": "b42b5ada-5582-3dab-ba28-02f03ac1edd4",
                                "text": "\"Als dat lukt, zal het voor meer financiële ademruimte zorgen en haalt het de druk van de regering\", zegt Jurna. En dat is hard nodig, want de financiële situatie in Suriname wordt steeds penibeler."
                            },
                            {
                                "example_id": "e435bd83-0235-4661-923d-09f830978869",
                                "sense_id": "b42b5ada-5582-3dab-ba28-02f03ac1edd4",
                                "text": "„Dit geeft ons wat ademruimte, waardoor we ons kunnen concentreren op de zoektocht naar een nieuwe ambulance”, aldus Melissa Nomden van de dierenambulance."
                            }
                        ]
                    }
                ],
