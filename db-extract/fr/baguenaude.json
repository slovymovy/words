            {
                "entry_id": "74e043fc-5f0c-3157-af0e-e4028565dd40",
                "word": "baguenaude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "886748e8-90ad-4661-977e-bc841b72609a",
                        "entry_id": "74e043fc-5f0c-3157-af0e-e4028565dd40",
                        "tags": [
                            "plural"
                        ],
                        "form": "baguenaudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1847cce-02f2-3429-b527-8ab6c02432d2",
                        "entry_id": "74e043fc-5f0c-3157-af0e-e4028565dd40",
                        "glosses": [
                            "Ancien type de poésie fait sans se soucier des règles de la versification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a1cce9-c12b-49ed-be3c-3d0f2116c0bf",
                                "sense_id": "c1847cce-02f2-3429-b527-8ab6c02432d2",
                                "text": "Entre les especes de nostre poesie, il y en eut une que l’on appeloit baguenaude, qui sembloit avoir esté de propos delibéré introduite en despit de la vraye poesie."
                            }
                        ]
                    },
                    {
                        "sense_id": "86618ae0-a680-34a4-b673-4616d1301922",
                        "entry_id": "74e043fc-5f0c-3157-af0e-e4028565dd40",
                        "glosses": [
                            "Loisir sans intérêt, niaiserie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3a7793c0-65d2-376b-921b-4701f07ed9a5",
                        "entry_id": "74e043fc-5f0c-3157-af0e-e4028565dd40",
                        "glosses": [
                            "Promenade, flânerie."
                        ],
                        "tags": [
                            "France",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "3069520f-0898-4db5-80d0-874c96aacaae",
                                "sense_id": "3a7793c0-65d2-376b-921b-4701f07ed9a5",
                                "text": "Avec la nuit qui se défait, s’abat la fatigue de la baguenaude."
                            },
                            {
                                "example_id": "02ef2f91-70d7-46b9-9dab-09d534f0a7ac",
                                "sense_id": "3a7793c0-65d2-376b-921b-4701f07ed9a5",
                                "text": "Ma surprise se dissipa vite lors de première baguenaude matutinale dans les rues de New Bedford."
                            },
                            {
                                "example_id": "d5464ee2-cc10-4fcd-8003-9d4bcb97d4b9",
                                "sense_id": "3a7793c0-65d2-376b-921b-4701f07ed9a5",
                                "text": "Les passants plus rares s’offrent une allure de baguenaude."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
