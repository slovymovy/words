                ],
                "senses": [
                    {
                        "sense_id": "933272b3-8fe9-3bb3-9cd8-9d48b6f5b045",
                        "entry_id": "14ebb25e-2995-3c82-ab3e-e21c0befa7f0",
                        "glosses": [
                            "zonder orde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad75236-3879-4d29-9595-05770acb726c",
                                "sense_id": "933272b3-8fe9-3bb3-9cd8-9d48b6f5b045",
                                "text": "Hij deed zeer onregelmatig zijn huiswerk voor school."
                            },
                            {
                                "example_id": "3c45426b-e439-44bf-85df-1a20d3a80da6",
                                "sense_id": "933272b3-8fe9-3bb3-9cd8-9d48b6f5b045",
                                "text": "‘Het is zaak dat je niet vol gas geeft. Dat moet je voor het allerlaatste bewaren. Het moeilijke is dat het zo onregelmatig is. Het loopt nergens.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "11b34614-e26c-3ed1-b192-c21d33d13465",
                        "entry_id": "14ebb25e-2995-3c82-ab3e-e21c0befa7f0",
                        "glosses": [
                            "slordig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833d5069-57e1-4e1f-a367-05e051a9825b",
                                "sense_id": "11b34614-e26c-3ed1-b192-c21d33d13465",
                                "text": "De arts had een zeer onregelmatig handschrift."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc9c5690-8ece-3d64-83d0-448bfcb6f0cd",
                        "entry_id": "14ebb25e-2995-3c82-ab3e-e21c0befa7f0",
                        "glosses": [
                            "zich niet aan de orde houdend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb287777-5fad-4135-afaa-43ea709861e7",
                                "sense_id": "fc9c5690-8ece-3d64-83d0-448bfcb6f0cd",
                                "text": "Onregelmatige werkwoorden zijn moeilijk om te leren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cefe12b4-6d72-4baa-b8e5-d1035438d7f1",
                        "source_entry_id": "14ebb25e-2995-3c82-ab3e-e21c0befa7f0",
                        "target_lang_word": "abnormal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                        "entry_id": "3fa13c1e-01ef-3985-bb8c-e6549de23a23",
                                        "glosses": [
                                            "Not conforming to rule or system; deviating from the usual or normal type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c85f404-53f3-495d-a494-aa98dfa39b5e",
                                                "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                                "text": "And then after an abnormal meal, which was either a very late breakfast or a very early lunch, they drove on to Victoria Station."
                                            },
                                            {
                                                "example_id": "97601c56-99a0-4073-a353-b42a05c4d75d",
                                                "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                        "entry_id": "3fa13c1e-01ef-3985-bb8c-e6549de23a23",
                                        "glosses": [
                                            "Of or pertaining to that which is irregular, in particular, behaviour that deviates from norms of social propriety or accepted standards of mental health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e47f0c-f5b0-4e15-950a-551bfc936563",
                                                "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                                "text": "Furuseth was right; I was abnormal, an \"emotionless monster,\" a strange bookish creature, capable of pleasuring in sensations only of the mind."
                                            },
                                            {
                                                "example_id": "6a49a86c-7a4e-4781-be57-f6bb7a6930b3",
                                                "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                                "text": "Many of the so-called rites of these secret societies were so patently ridiculous, that it is quite obvious that they were merely an excuse for men and women to indulge in sex-play and lustful gratification, frequently of an abnormal kind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abnormal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0580d170-fda7-3d80-a185-28d5a104ac70",
                                        "entry_id": "a968b3f1-3d20-317f-b482-2717b0413464",
                                        "glosses": [
                                            "A person or object that is not normal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
