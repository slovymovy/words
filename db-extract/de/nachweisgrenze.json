                "senses": [
                    {
                        "sense_id": "030c2f5a-524a-32ff-a8be-43db31ceb4d9",
                        "entry_id": "52f776d4-ec09-31c0-b8cf-cc0ed4db0236",
                        "glosses": [
                            "diejenige Menge Material, die mindestens messbar sein muss, um dieses Material als in der Probe vorhanden nachzuweisen; Parameter zur Form und Größe eines Gebildes, der eine zuverlässige Identifikation erlaubt"
                        ],
                        "tags": [
                            "bei bildgebenden Verfahren"
                        ],
                        "examples": [
                            {
                                "example_id": "71094a55-69ae-49e0-b9bd-e8f4ad479527",
                                "sense_id": "030c2f5a-524a-32ff-a8be-43db31ceb4d9",
                                "text": "„Eine quantitative Bestimmung der Nikotin- und Cotinin-Serumspiegel erfolgt in zahlreichen Labors mit der Hochleistungsflüssigkeits-Chromatografie (HPLC), die Nachweisgrenzen betragen etwa 1 ng/ml.“"
                            },
                            {
                                "example_id": "e61203c5-02ac-47ea-a4f1-b6489042c70e",
                                "sense_id": "030c2f5a-524a-32ff-a8be-43db31ceb4d9",
                                "text": "„Die radiologische Nachweisgrenze eines frei auslaufenden Pleuraergusses auf Standardröntgenaufnahmen im Stehen liegt im Mittel bei mindestens 150 ml.“"
                            }
                        ],
