                        "entry_id": "af6240d1-99bc-351c-96ec-ad5d39251366",
                        "glosses": [
                            "Nom donné à des espèces d’acariens à deux paires de pattes s’attaquant à diverses espèces d’arbres, sur les feuilles desquels ils provoquent des galles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8a73a0-9805-45ca-97d7-6177156797c3",
                                "sense_id": "4198a439-e0a0-3eb9-b820-a3bed2e0b262",
                                "text": "Le phytopte est un nom commun donné à plusieurs espèces selon la plante qu'il attaque (phytopte du poirier, du noisetier, du cassissier, du mûrier, phytopte de l'érable, du tilleul…)."
                            },
                            {
                                "example_id": "c88f22f3-2141-4453-a741-6cfd3a077074",
                                "sense_id": "4198a439-e0a0-3eb9-b820-a3bed2e0b262",
                                "text": "Le phytopte attaque les nouvelles feuilles au fur et à mesure de la croissance des rameaux. Les dégâts sont en général limités et ne provoquent pas de diminution de récolte."
                            },
                            {
                                "example_id": "e6b89ff8-2a92-4cd7-9f79-b1e05ee28eac",
                                "sense_id": "4198a439-e0a0-3eb9-b820-a3bed2e0b262",
                                "text": "Le phytopte du poirier, Eriophyes pyri, est un acarien ravageur du poirier. Il ressemble à un petit bâtonnet de couleur jaune clair de 0,1 mm de long."
                            }
                        ]
                    }
