                        "glosses": [
                            "Aufnahme von (professionellen) Fotos; Fotoshooting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b577a5-da0c-4277-9637-1af4a3007842",
                                "sense_id": "a71dacae-1394-391f-9500-103cf556cdf1",
                                "text": "„Für Shootings und Werbedrehs wurden Nationalspielerinnen damals in der Business Class um die Welt geschickt.“"
                            },
                            {
                                "example_id": "50653795-f326-42c2-bcc0-850cad53b752",
                                "sense_id": "a71dacae-1394-391f-9500-103cf556cdf1",
                                "text": "„Darauf stehen aber keine Galaabende oder Shootings für Hochglanz-Magazine, sondern eher Dinge wie: die Wohnung aufräumen, einkaufen gehen, Papierkram erledigen, Freunde besuchen und ein Fitness-Workout absolvieren.“"
                            }
                        ],
