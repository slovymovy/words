                "senses": [
                    {
                        "sense_id": "3b9bdd9c-c8ba-3053-8c96-43dfbf8972f0",
                        "entry_id": "6c7ad770-e012-308d-a3cf-420e9bb7c61a",
                        "glosses": [
                            "iets moeten hebben voor vaak praktische of medische redenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24f0ce3-d75a-4425-99d1-cfd4a4a4371f",
                                "sense_id": "3b9bdd9c-c8ba-3053-8c96-43dfbf8972f0",
                                "text": "Insuline krijgen is een noodzaak voor diabetespatiënten."
                            },
                            {
                                "example_id": "6f109ab2-ea4c-4517-b2f2-4f5372393db3",
                                "sense_id": "3b9bdd9c-c8ba-3053-8c96-43dfbf8972f0",
                                "text": "Ik moest alles opschrijven, hoewel ik besefte dat de noodzaak van het vertellen, in de woorden van Aeneas tot Dido, het verdriet zou verversen. Maar ik moest boekstaven om de rekening te kunnen opmaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e395cd45-90c0-439f-b22d-5dbaa611cb9d",
                        "source_entry_id": "6c7ad770-e012-308d-a3cf-420e9bb7c61a",
                        "source_sense_id": "3b9bdd9c-c8ba-3053-8c96-43dfbf8972f0",
                        "source_sense_description": "iets moeten hebben voor vaak praktische of medische redenen",
                        "target_lang_word": "necessity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d548133-f02d-3ba7-a608-ae9ee75a2d31",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "The quality or state of being necessary, unavoidable, or absolutely requisite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad629624-67bc-4031-b3fa-cbdfe58c2a35",
                                                "sense_id": "0d548133-f02d-3ba7-a608-ae9ee75a2d31",
                                                "text": "I bought a new table out of necessity. My old one was ruined."
                                            },
                                            {
                                                "example_id": "21f02f65-ad01-46fa-a85d-033a24f071d8",
                                                "sense_id": "0d548133-f02d-3ba7-a608-ae9ee75a2d31",
                                                "text": "Educating the public about some of the myths that underlie their fears that non-traditional families will of necessity be detrimental to the well-being of foster children."
                                            },
                                            {
                                                "example_id": "0849feaa-6c04-4744-a685-b587e5f2d4e4",
                                                "sense_id": "0d548133-f02d-3ba7-a608-ae9ee75a2d31",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, […]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc9c1c4e-cfaa-32a1-96c4-67a36e3d2de8",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "The condition of being needy; desperate need; lack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588da6ad-985d-48ab-9273-2ae6f7c55344",
                                                "sense_id": "bc9c1c4e-cfaa-32a1-96c4-67a36e3d2de8",
                                                "text": "1863, Richard Sibbes, The Successful Seeker, in The Complete Works of Richard Sibbes, D.D., Volume VI, James Nichol, page 125,\nFor it is in vain for a man to think to seek God in his necessity and exigence, if he seek not God in his ordinances, and do not joy in them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f9e451-88a9-3ab9-9650-b79ea1eeb1bb",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "Something necessary; a requisite; something indispensable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89bdbc22-474a-441d-8ae6-b3ce08062fc2",
                                                "sense_id": "07f9e451-88a9-3ab9-9650-b79ea1eeb1bb",
                                                "text": "A tent is a necessity if you plan on camping."
                                            },
                                            {
                                                "example_id": "c93b6c72-4214-42ae-8fa6-7baa0cc7bf98",
                                                "sense_id": "07f9e451-88a9-3ab9-9650-b79ea1eeb1bb",
                                                "text": "Look for the bare necessities / The simple bare necessities / Forget about your worries and your strife"
                                            },
                                            {
                                                "example_id": "6d0541e1-370b-40a8-b4df-c70c41c36cb2",
                                                "sense_id": "07f9e451-88a9-3ab9-9650-b79ea1eeb1bb",
                                                "text": "Love and compassion are necessities, not luxuries. Without them humanity cannot survive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21c0f77-4cb4-350f-befb-d76001318553",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "Something which makes an act or an event unavoidable; an irresistible force; overruling power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9740e6a6-391e-4212-853e-534859c2a405",
                                                "sense_id": "e21c0f77-4cb4-350f-befb-d76001318553",
                                                "text": "After eating a full meal, the human body's necessity for food will compel the person to eat again in the future."
                                            },
                                            {
                                                "example_id": "6199acdb-7d4d-479a-a350-3e9761e69a5b",
                                                "sense_id": "e21c0f77-4cb4-350f-befb-d76001318553",
                                                "text": "I stopped, and said with inly muttered voice,\n'It doth not love the shower, nor seek the cold:\nThis neither is its courage nor its choice,\nBut its necessity in being old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bada49ba-4ce1-3ad8-8fe1-38fa5b0becf3",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "The negation of freedom in voluntary action; the subjection of all phenomena, whether material or spiritual, to inevitable causation; necessitarianism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "551da0fa-8bfe-3928-8317-00e292fda19b",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "Greater utilitarian good; used in justification of a criminal act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca77de50-c037-4ba0-8da2-ce299c29de0f",
                                                "sense_id": "551da0fa-8bfe-3928-8317-00e292fda19b",
                                                "text": "doctrine of necessity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83f19c27-1147-3728-b37b-25bbe8624545",
                                        "entry_id": "4874c82c-6c29-3241-96f6-20221dd54c53",
                                        "glosses": [
                                            "Indispensable requirements (of life)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1ba9217-bad0-4942-a224-e19e1e1d03c6",
                        "source_entry_id": "6c7ad770-e012-308d-a3cf-420e9bb7c61a",
                        "source_sense_id": "3b9bdd9c-c8ba-3053-8c96-43dfbf8972f0",
                        "source_sense_description": "iets moeten hebben voor vaak praktische of medische redenen",
                        "target_lang_word": "Notwendigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notwendigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                        "entry_id": "bcd9562b-03b8-3bb3-8b02-8c5fb0ac3dbc",
                                        "glosses": [
                                            "eine unvermeidliche Handlung oder Unterlassung, Entscheidung beziehungsweise Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61633a62-2641-4ba6-b42f-2dacf072c989",
                                                "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                                "text": "Geiz und Wucher und Misstrauen müssen noch für eine Weile unsere Götter bleiben. Denn nur sie können uns aus dem Tunnel der ökonomischen Notwendigkeit ans Tageslicht leiten."
                                            },
                                            {
                                                "example_id": "a1bf3a4b-9a94-4b26-b664-421ff08ddb40",
                                                "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                                "text": "In einem kleinen Vorrat an Redewendungen und Gemeinplätzen, die wir in der Jugend erlernten, besitzen wir alles Nötige, um ohne die ermüdende Notwendigkeit, denken zu müssen, durchs Leben zu gehen."
                                            },
                                            {
                                                "example_id": "2c89273e-543d-418d-9767-12893f6213a3",
                                                "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                                "text": "Notwendigkeit nimmt uns die Qual der Wahl ab."
                                            },
                                            {
                                                "example_id": "a33c43ae-7727-434b-8fcb-937f3aa01b08",
                                                "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                                "text": "Wo wir unfähig sind, die Gesetze der Notwendigkeit zu erkennen, da glauben wir frei zu sein."
                                            },
                                            {
                                                "example_id": "fb8cae71-0c71-432f-9e77-a706368620d5",
                                                "sense_id": "bcd52dfc-67f8-384c-b69c-6a77be1b3e41",
                                                "text": "„Gesellschaften haben das Geldsystem im Laufe der Zeit weiterentwickelt und neuen Notwendigkeiten angepasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
