                        "glosses": [
                            "Fenouil (légume) de taille nettement plus petite que les fenouils ordinaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "befe111a-a680-4d83-a6a8-1819ed314345",
                                "sense_id": "333de0e9-68b0-326e-b567-e5145a47a535",
                                "text": "Taillez finement en copeaux à la mandoline les asperges, les mini-pâtissons, les mini-navets, les mini-fenouils, les mini-carottes, les fleurs de courgettes, les radis, les mini-betteraves et l’oignon rouge, puis réservez-les dans un saladier d’eau glacée."
                            },
                            {
                                "example_id": "37ae4970-6306-46dc-8471-64ec12c6da69",
                                "sense_id": "333de0e9-68b0-326e-b567-e5145a47a535",
                                "text": "L’attraction du stand Clause à Berlin aura été le Babyfino, un mini-fenouil déjà en production chez le hollandais Litjens Venkel."
                            },
                            {
                                "example_id": "3242fbe9-ccee-4ce1-b5a5-fd7c7e87997c",
                                "sense_id": "333de0e9-68b0-326e-b567-e5145a47a535",
                                "text": "Préparer le mini-fenouil : Parer le bulbe. Faire sauter à l’huile d’olive dans une poêle à feu vif. Le cuire croquant. L’égoutter sur papier absorbant."
                            }
                        ]
                    }
