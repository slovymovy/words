                    }
                ],
                "senses": [
                    {
                        "sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
                        "entry_id": "81e3db78-f5be-397d-a81c-7c723ec67011",
                        "glosses": [
                            "ongunstige eigenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d53f8f-a0b2-4ca4-bdec-f185a5ec089f",
                                "sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
                                "text": "Het nadeel van een grote auto is vaak het grote benzineverbruik."
                            },
                            {
                                "example_id": "3e7dac13-c016-4827-a622-33657e074538",
                                "sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
                                "text": "Ik dook vol in de nieuwe wereld van ultra lichtgewicht kampeerspullen en verslond online zo veel mogelijk lijsten (gear lists) van anderen om de voor- en nadelen te begrijpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad5effc-7eea-396a-88f9-45f8f696d2fc",
                        "entry_id": "81e3db78-f5be-397d-a81c-7c723ec67011",
                        "glosses": [
                            "verlies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebef6593-244b-465d-af24-51a2272645bc",
                                "sense_id": "7ad5effc-7eea-396a-88f9-45f8f696d2fc",
                                "text": "De aandeelhouders ondervonden nadeel van de sterk gedaalde beurskoers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77704b87-2838-47a9-a301-3d8c80feec02",
                        "source_entry_id": "81e3db78-f5be-397d-a81c-7c723ec67011",
                        "source_sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
                        "source_sense_description": "ongunstige eigenschap",
                        "target_lang_word": "Nachteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                        "entry_id": "b13eaf36-33c4-3680-9945-94f289e58cbf",
                                        "glosses": [
                                            "negative oder unerwünschte Folge oder negativer Nebeneffekt, zum Beispiel einer Lösung, eines Vorgehens, einer Überlegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b31c7a85-58fe-40c7-bd40-294f18e30cd4",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Wenn du uns hilfst, soll das nicht zu deinem Nachteil sein."
                                            },
                                            {
                                                "example_id": "7ebede67-6a43-4af9-b461-20d876d6aa36",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Wir müssen nach einer Lösung suchen, die ohne Nachteil für die Arbeitnehmer ist."
                                            },
                                            {
                                                "example_id": "4ab34b97-f279-4d36-bffd-84f34125dd3f",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Diese Regelung hier ist eindeutig zu meinem Nachteil."
                                            },
                                            {
                                                "example_id": "05f8370a-a8d2-4d20-9ce4-29e3ffdf82c9",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Es ist für die gesamte Diskussion von Nachteil, wenn Sie jetzt polemisch werden."
                                            },
                                            {
                                                "example_id": "03e6f300-7e1f-4396-9c6f-816073f99976",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Die Nachteile liegen darin, dass es zu teuer ist und nie rechtzeitig fertig wird."
                                            },
                                            {
                                                "example_id": "e7573168-0b7c-4886-be5a-887dd074c5a1",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Der Nachteil an der Sache ist, dass ich einen Kredit aufnehmen muss."
                                            },
                                            {
                                                "example_id": "cbc9658a-d5b7-4c86-8c00-3d82714afe20",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Man neigt dazu, in einem Vorschlag immer gleich die Nachteile zu suchen und zu sehen."
                                            },
                                            {
                                                "example_id": "c952c6d0-7920-4ed4-bfd7-e091a6361222",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "Martin hat sich seit der Scheidung zu seinem Nachteil verändert, finde ich."
                                            },
                                            {
                                                "example_id": "5733c08b-be8c-479a-925a-0cf1d6816fbf",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "„Und manche verklärten sogar die Nachteile der Deutschen in Vorteile.“"
                                            },
                                            {
                                                "example_id": "87a951f6-043e-42c6-905b-5bdbf2f56731",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "„Auch Zigarettenqualm muss nicht immer nur Nachteile haben.“"
                                            },
                                            {
                                                "example_id": "4031a949-04f0-44cf-9e6c-056d2660287e",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "„Sie hatten anscheinend einfach mehr Vorteile als Nachteile voneinander.“"
                                            },
                                            {
                                                "example_id": "8bf2bada-c9cf-48d3-9153-2fc4d79b67ac",
                                                "sense_id": "865ac3eb-2a07-346d-844a-c85016ab8a63",
                                                "text": "„Doch das Ballungsgebiet hat auch Nachteile: Bezahlbarer Wohnraum wird knapp.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0b66556-e10f-4093-99a1-9e5f015b84d0",
                        "source_entry_id": "81e3db78-f5be-397d-a81c-7c723ec67011",
                        "source_sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
                        "source_sense_description": "ongunstige eigenschap",
                        "target_lang_word": "disadvantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A weakness or undesirable characteristic; con; drawback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171e49af-66f9-4007-aeb8-db815217f4d8",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "The disadvantage to owning a food processor is that you have to store it somewhere."
                                            },
                                            {
                                                "example_id": "eebef41c-d113-4c2d-b2e5-09afb7799834",
                                                "sense_id": "22ce2ccd-17d6-3bc1-ac08-3bdac9378636",
                                                "text": "One of the disadvantages of increasing intermediate stops is that, as we have pointed out already, certain prestige trains have to suffer, notably the \"Cornish Riviera Express\", slowed 15min to Plymouth by stops at Taunton and Exeter; the \"Torbay Express\", decelerated 18min by stops at Reading, Westbury, Taunton and Newton Abbot; and the \"Bristolian\", which adds 14min in order to allow for a Bath stop and an increased load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "A setback or handicap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80eaba6-79c3-48bd-af4f-0628699f5abd",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "My height is a disadvantage for reaching high shelves."
                                            },
                                            {
                                                "example_id": "255f5862-20f3-48ab-b649-4c60190babe6",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "I was brought hither under the disadvantage of being unknown, even by sight, to any of you."
                                            },
                                            {
                                                "example_id": "4791ad39-9313-4b2a-9134-5ec9f7196d70",
                                                "sense_id": "24ba1aa0-9208-3e05-b9fc-66150a0ed4bb",
                                                "text": "1859-1890, John G. Palfrey, History of New England to the Revolutionary War\nAbandoned by their great patron, the faction henceforward acted at disadvantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                        "entry_id": "09359086-c194-37df-9ccb-22987abfe534",
                                        "glosses": [
                                            "Loss; detriment; hindrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fabbf53-3c78-404a-abcd-399d5e41e0cd",
                                                "sense_id": "474ab26a-4db3-3573-8b7b-7ece30c9e7e1",
                                                "text": "They would throw a construction on his conduct, to his disadvantage before the public."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disadvantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                        "entry_id": "c2d49292-1d65-3a95-ab29-e8252a746359",
                                        "glosses": [
                                            "To place at a disadvantage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338fa432-fad7-438e-aafa-40f7007c4420",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "They fear it might disadvantage honest participants to allow automated entries."
                                            },
                                            {
                                                "example_id": "d5053aeb-1a50-4186-8e81-e831caa3049b",
                                                "sense_id": "2b813a67-579e-35a2-822c-a87d2a4a5fa9",
                                                "text": "For London to have its own exclusive immigration policy would exacerbate the sense that immigration benefits only certain groups and disadvantages the rest. It would entrench the gap between London and the rest of the nation. And it would widen the breach between the public and the elite that has helped fuel anti-immigrant hostility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d7fa85-7118-42df-845e-16404a8edda3",
                        "source_entry_id": "81e3db78-f5be-397d-a81c-7c723ec67011",
                        "source_sense_id": "17b38018-f5bd-395e-b865-b033ae477076",
