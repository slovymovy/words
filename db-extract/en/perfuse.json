                                "target_senses": [
                                    {
                                        "sense_id": "0b349637-d90b-36e5-b559-f9d0dca73040",
                                        "entry_id": "f18f4fc6-214f-3ed7-b871-d94877a01f6d",
                                        "glosses": [
                                            "mit Blut (oder auch einer Nährlösung) versorgen; durch Perfusion zuführen, von außen einbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0309daa9-58f3-4d27-8361-df0a34b5e7ce",
                                                "sense_id": "0b349637-d90b-36e5-b559-f9d0dca73040",
                                                "text": "„COSSMAN (1972) gelang es, Hundenieren mit einer Dextranlösung für 24 Std in dem von BELZER entwickelten Gerät zu perfundieren […].“"
                                            },
                                            {
                                                "example_id": "cdf64714-31c2-4e06-bccc-e2b45678c400",
                                                "sense_id": "0b349637-d90b-36e5-b559-f9d0dca73040",
                                                "text": "„Die Darstellung eines Gefäßes über Kollateralen sagt noch nichts darüber aus, ob das Blut mit genügendem Druck und Fluß strömt, um Myokard zu perfundieren.“"
                                            },
                                            {
                                                "example_id": "a40a0e93-4f7e-4c33-ac34-1a664e28f9a1",
                                                "sense_id": "0b349637-d90b-36e5-b559-f9d0dca73040",
                                                "text": "„Die rechte A. brachialis wird in der Axilla kanüliert, um die rechte Vertebralarterie und die rechten Karotiden zu perfundieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
