                        ],
                        "examples": [
                            {
                                "example_id": "dfc8e7cf-ffe7-4d48-9d2d-7eb729c47606",
                                "sense_id": "c8674eae-fbfb-3cd9-b5a7-8a023576d739",
                                "text": "Tel est le cri que je voudrais faire continuellement entendre, au-dessus de la politiquaillerie actuelle. Votre tapage tombera, nos œuvres resteront."
                            },
                            {
                                "example_id": "25189868-f54d-4300-903f-00d576ab7f87",
                                "sense_id": "c8674eae-fbfb-3cd9-b5a7-8a023576d739",
                                "text": "On le sent faux et emprunté jusque dans ses gestes, jusque dans le son de sa voix. Sa politiquaillerie vaut sa science, qui ne vaut rien."
                            }
                        ]
                    }
