                ],
                "senses": [
                    {
                        "sense_id": "f22eb823-4f77-3318-a2f6-496029fed966",
                        "entry_id": "ad31c35b-173e-36a7-9039-5b2844070558",
                        "glosses": [
                            "jemand, der professionell Nutztiere kauft und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae3782b-f12d-4a5f-82a6-5628228af630",
                                "sense_id": "f22eb823-4f77-3318-a2f6-496029fed966",
                                "text": "„Auf der Straße geriet Meck mit den beiden Viehhändlern in eine heftige Debatte.“"
                            },
                            {
                                "example_id": "cf29092a-a8c5-45c9-a407-89b784679737",
                                "sense_id": "f22eb823-4f77-3318-a2f6-496029fed966",
                                "text": "„Der Schmuck war ein Pfand, ein Pfand von einem Viehhändler für den Großvater, aus der Inflationszeit nach dem Ersten Weltkrieg, und der Händler hat das Pfand nicht eingelöst, und so hat es der Großvater mir vererbt.“"
                            },
                            {
                                "example_id": "47f3a70c-d12e-4cfa-9d41-10e1a390c162",
                                "sense_id": "f22eb823-4f77-3318-a2f6-496029fed966",
                                "text": "„Leider sind unter den Gefallenen auch zwei Juden, die Söhne des Viehhändlers Levi.“"
                            },
                            {
                                "example_id": "527df8b7-3244-4251-9052-c2a1e872dafe",
                                "sense_id": "f22eb823-4f77-3318-a2f6-496029fed966",
                                "text": "„Ein junger, kräftig gebauter Viehhändler läßt seinen trägen und erschlafften Körper durch die sächsische Landschaft befördern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
