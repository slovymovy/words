        "fr-extract.jsonl": [
            {
                "entry_id": "c009cecf-1160-3afd-a1fc-ef81250d9f62",
                "word": "funestement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b78a6c9-d551-3558-9e3e-543767c39df6",
                        "entry_id": "c009cecf-1160-3afd-a1fc-ef81250d9f62",
                        "glosses": [
                            "D’une manière funeste."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e8c8553a-900f-4b65-83e9-0158511363e1",
                                "sense_id": "2b78a6c9-d551-3558-9e3e-543767c39df6",
                                "text": "Le péché […] contraire à Dieu comme à la règle qu’il combat, et outre cela, mais funestement, contraire à l’homme comme au sujet qu’il corrompt."
                            },
                            {
                                "example_id": "4966fddb-b26b-4aff-8761-932bb2a188d7",
                                "sense_id": "2b78a6c9-d551-3558-9e3e-543767c39df6",
                                "text": "Il ne faut pas interrompre un récit si intéressant et si funestement curieux."
                            },
                            {
                                "example_id": "4a185e75-ab16-4aab-aae0-e301f59a4ad1",
                                "sense_id": "2b78a6c9-d551-3558-9e3e-543767c39df6",
                                "text": "Je remarque que, dans ces temps malheureux, les princes et les principaux chefs catholiques et protestants sont tous morts funestement ou d’une façon singulière."
                            }
                        ]
                    }
                ],
