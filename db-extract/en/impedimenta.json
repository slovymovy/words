    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f1161202-d6b0-3f67-a39e-4b88f5cc9ad1",
                "word": "impedimenta",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "61225533-d823-3422-80e8-33adbb4b93fa",
                        "entry_id": "f1161202-d6b0-3f67-a39e-4b88f5cc9ad1",
                        "glosses": [
                            "Equipment intended for an activity that serves as more of a hindrance than a help, especially military baggage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fc59c2-e178-4d88-ad47-7218fd8e23e0",
                                "sense_id": "61225533-d823-3422-80e8-33adbb4b93fa",
                                "text": "On the plains they will have horses dragging travoises, dogs with travoises, women and children loaded with impedimenta."
                            },
                            {
                                "example_id": "f3d15458-4a02-4412-87aa-43207e24ae61",
                                "sense_id": "61225533-d823-3422-80e8-33adbb4b93fa",
                                "text": "Dashing back to my compartment, I grabbed my impedimenta - what my companion thought of the maniac who alighted at a station only half-way to the first booked stop I don't know ! - got out, hurried under the subway, and was into my 10.45 comfortably before its departure."
                            },
                            {
                                "example_id": "fda4b426-0c0a-43d8-aad0-f84dd21985ee",
                                "sense_id": "61225533-d823-3422-80e8-33adbb4b93fa",
                                "text": "Games impedimenta — hockey-sticks, boxing-gloves, a burst football, a pair of sweaty shorts turned inside out — lay all over the floor, and on the table there was a litter of dirty dishes and dog-eared exercise-books."
                            }
                        ]
                    },
