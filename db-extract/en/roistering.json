                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ce2629-93df-4cc7-ba72-4917037b8409",
                                "sense_id": "8020b3dc-0fa6-30ba-877c-d2dea0cec766",
                                "text": "[H]e could look on with an eye of kindness at the lookers-on too; at the roystering youth bent upon enjoyment, and here taking it […]"
                            },
                            {
                                "example_id": "4501f086-3e23-480b-bdd1-cd13d82c22c8",
                                "sense_id": "8020b3dc-0fa6-30ba-877c-d2dea0cec766",
                                "text": "Merry Mansions Sunday night, with loud parties in the distance. Matilda said she was going to have a good time at some heaven. And George Smith sat alone staring across the room. And out the window for a bit, at a roistering gathering of folk across the street. A city full of fathers with gathered arms of presents to give and get, this complicated time of year."
                            }
                        ]
                    }
