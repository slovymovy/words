                                "example_id": "67285ff0-1312-4636-a610-c870de04f925",
                                "sense_id": "3334e3ac-b8db-3e15-939e-1922ca37918f",
                                "text": "Veel christenen hebben een crucifix in hun huis.",
                                "translation": "Many Christians have a crucifix in their home.",
                                "english": "Many Christians have a crucifix in their home."
                            },
                            {
                                "example_id": "744f4d4f-572a-4dde-951b-91022e548321",
                                "sense_id": "3334e3ac-b8db-3e15-939e-1922ca37918f",
                                "text": "Het crucifix is gemaakt van eikenhout.",
                                "translation": "The crucifix is made of oak wood.",
                                "english": "The crucifix is made of oak wood."
                            },
                            {
                                "example_id": "ec8af8be-1583-4335-ad8d-99d040d3215c",
                                "sense_id": "3334e3ac-b8db-3e15-939e-1922ca37918f",
                                "text": "Ze kuste het crucifix voordat ze ging slapen.",
                                "translation": "She kissed the crucifix before going to sleep.",
                                "english": "She kissed the crucifix before going to sleep."
                            }
                        ]
