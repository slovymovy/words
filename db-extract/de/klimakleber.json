                "senses": [
                    {
                        "sense_id": "b9dbb8c7-bfe1-3ead-a01d-2a355369bf80",
                        "entry_id": "ac0a7f4f-0b5f-3e09-9d68-ed6610569047",
                        "glosses": [
                            "climate activist, especially one using glue"
                        ],
                        "tags": [
                            "informal",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "3d12c0cb-2c0c-47dd-bcac-e4dfb612304d",
                                "sense_id": "b9dbb8c7-bfe1-3ead-a01d-2a355369bf80",
                                "text": "Die Bild-Zeitung, die sich als Stimme der blockierten Au­to­fah­re­r:in­nen versteht, ist schon ganz empört: „Es breitet sich das Gefühl aus, als würden die Klimakleber mit Samthandschuhen angefasst.“"
                            },
                            {
                                "example_id": "274a0460-b7ac-42f6-bff6-26e9b33eb6f7",
                                "sense_id": "b9dbb8c7-bfe1-3ead-a01d-2a355369bf80",
                                "text": "Polizei und Staatsanwaltschaft seien im Moment dabei, zu ermitteln und Strafverfahren einzuleiten, so Jarasch. „Ich sehe keinen Grund, irgendeinen Sonderstraftatbestand für Klimakleber einzuführen.“"
                            }
                        ]
                    }
