                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a70167-7944-402e-9cf7-12c05396b514",
                                "sense_id": "44228af0-07e4-35f3-83b1-d7a7abc5ee97",
                                "text": "„Einen großen Markt für Holzfasern stellen die Faserplatten dar.“"
                            },
                            {
                                "example_id": "3a2439f6-6398-4e8e-acfd-f35225a053b5",
                                "sense_id": "44228af0-07e4-35f3-83b1-d7a7abc5ee97",
                                "text": "„Die reine Holzfaſer, bei + 100° ausgetrocknet, beſteht zur Hälfte ihres Gewichtes aus Kohlenſtoff, während die zweite Gewichtshälfte aus Sauerſtoff und Waſſerſtoff beſteht, und zwar die letztere in demſelben Verhältniſſe, in welchem beide Stoffe das Waſſer bilden.“ [1845]"
                            }
                        ],
                        "sense_index_json": "\"1\""
