                "senses": [
                    {
                        "sense_id": "40031ebf-1d1e-3159-950e-d3754c527658",
                        "entry_id": "0facf9a5-3443-346d-9179-4b39668dd790",
                        "glosses": [
                            "разг. небольшой магазин, торгующий колбасными изделиями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9ab534-04b7-4a11-8dc2-1b80cf49915a",
                                "sense_id": "40031ebf-1d1e-3159-950e-d3754c527658",
                                "text": "Да возьми в колбасной хоть колбасы немного подешевле."
                            },
                            {
                                "example_id": "c6c761c9-e9ee-45b6-adcd-664278da9d98",
                                "sense_id": "40031ebf-1d1e-3159-950e-d3754c527658",
                                "text": "— Всё в лавочке есть; а чего нет в лавочке, так тут где-нибудь в колбасной есть; а там нет, так в кондитерской; а уж чего в кондитерской нет, так иди в аглицкий магазин: у французов все есть!"
                            }
                        ]
                    }
                ],
