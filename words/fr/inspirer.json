            "senses": [
                {
                    "sense_id": "89345624-c03c-31d2-95a2-9fbff5df30b5",
                    "sense_definition": "Faire entrer de l'air dans ses poumons au cours de la respiration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin me demande d'<w>inspirer</w> profondément avant d'écouter mes poumons."
                        },
                        {
                            "text": "Quand on se sent stressé, il faut <w>inspirer</w> lentement par le nez."
                        }
                    ],
                    "antonyms": [
                        "expirer"
                    ],
                    "common_phrases": [
                        "inspirer profondément",
                        "inspirer et expirer",
                        "inspirer à pleins poumons"
                    ]
                },
                {
                    "sense_id": "bc609f3b-dd22-32e7-8b35-27d07b8b4129",
                    "sense_definition": "Faire naître un sentiment ou une idée chez quelqu'un, ou stimuler la créativité intellectuelle et artistique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magnifique paysage de montagne a su <w>inspirer</w> les peintres de la région."
                        },
                        {
                            "text": "Ce nouveau directeur adopte une attitude calme qui <w>inspire</w> confiance à ses employés."
                        }
                    ],
                    "synonyms": [
                        "insuffler"
                    ],
                    "common_phrases": [
                        "inspirer confiance",
                        "inspirer le respect",
                        "inspirer la crainte"
                    ]
                },
                {
                    "sense_id": "97f5449c-f07d-38d8-bab3-733f63dd4851",
                    "sense_definition": "Avoir une idée heureuse ou malavisée dans une circonstance donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous seriez bien <w>inspiré</w> de relire ce contrat avant de le signer."
                        },
                        {
                            "text": "Le jeune joueur a été mal <w>inspiré</w> en tentant ce tir très difficile."
