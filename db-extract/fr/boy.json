                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "464554a4-fdb3-40ec-a4e2-0d1e5f2ef1bf",
                                "sense_id": "cc886289-34bf-3901-93a8-017ec419e805",
                                "text": "Le mercredi 25 août, je me suis rendu au bureau de M Boy, le nouveau Proviseur Adjoint du lycée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                "word": "boy",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e69ad974-6437-445d-b322-0a3cd91f9fa6",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "tags": [
                            "plural"
                        ],
                        "form": "boys"
                    },
                    {
                        "form_id": "7b574436-a9af-4f43-9208-1a5b53257c19",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "tags": [
                            "feminine"
                        ],
                        "form": "boyesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "glosses": [
                            "Dans les colonies, valet, domestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "707c517d-4ce7-4fa4-a085-fff6c5bdc371",
                                "sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                                "text": "Le boy, un bécon d'une douzaine d'années, attend patiemment, accroupi, la volonté du Céleste ; seuls ses yeux de singe ont salué l'arrivée de Wong-Truch d'un indéfinissable sourire."
                            },
                            {
                                "example_id": "cacfe197-52c8-4eb2-8a3b-c09a696e1813",
                                "sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                                "text": "Aucun luxe, au contraire, une bonhomie spécifiquement belge, un certain laisser-aller même et, à l'encontre du Soudan anglais, des boys familiers, vêtus de blanc, qui vous souriaient de toutes leurs dents."
                            },
                            {
                                "example_id": "3dba1b88-fc67-4ba4-9d85-cb3374f9d09e",
                                "sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                                "text": "Un boy l’attendait à côté du chauffeur, un merle dans une grande cage dorée sur ses genoux."
                            },
                            {
                                "example_id": "6cfe22f9-4faa-489f-bdd9-f64ffc34d786",
                                "sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                                "text": "— J’ai compris, m’écriai-je. Marie-Jeanne torture ses poursuivants, comme le boy le colon.\nCordélia protesta violemment.\nJusqu’à nouvel ordre, c’est le colon qui bat le boy.\n— C’est pourquoi, quand les circonstances permettent au boy de frapper à son tour le colon, il perd tout contrôle. Il a trop d’humiliations à venger. Il danse autour de l’agonisant, comme moi autour du serpent."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3715114-7094-32ed-ae38-9d54e80da3c4",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "glosses": [
                            "Jeune danseur de revue."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "55cacad1-f91a-41bf-8154-0b7cc999d93e",
                                "sense_id": "d3715114-7094-32ed-ae38-9d54e80da3c4",
                                "text": "Déjà les boys et les danseuses faisaient la haie en chantant un chœur tonitruant et en tortillant des gambettes…"
                            }
                        ]
                    },
                    {
                        "sense_id": "777b90ca-18be-3cd1-9142-e97b22815f07",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "glosses": [
                            "Jeune garçon anglais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48032718-5aad-47b0-8d4f-971c28304398",
                                "sense_id": "777b90ca-18be-3cd1-9142-e97b22815f07",
                                "text": "Toutes les dix minutes un boy, crieur de journaux, s’introduit furtivement dans la salle et offre les dernières éditions des feuilles du soir."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cd219c2-62f1-3255-aaf6-4478da45af4d",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "glosses": [
                            "Ami, gars."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d49b444c-93e8-3b00-99c4-f20fefbe821f",
                        "entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "glosses": [
                            "Support élévateur, sorte de cric utilisé en laboratoire pour ajuster la hauteur de ce qui est posé dessus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b85ceea-f990-4e1e-87cc-84ac36daee8c",
                        "source_entry_id": "617d2595-6a9a-308d-94da-aa66326bfe91",
                        "source_sense_id": "6e8b6130-529a-339e-a066-a124fd69a876",
                        "source_sense_description": "Nom donné dans les colonies aux valets, aux domestiques",
                        "target_lang_word": "Diener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "abhängig Arbeitender, der für seinen Herren bestimmte häusliche Pflichten erfüllt, Hausangestellter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50e2859-faf4-4db0-a8ef-7d9d31f754b2",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "Ein Diener lernt auf einer speziellen Schule, wie er sich gegenüber dem Herren verhalten muss."
                                            },
                                            {
                                                "example_id": "7170e4bf-1d7d-44cd-815e-e67536cf21b6",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Es nützte nichts, weder der Priester noch sonst jemand vermochte ihn davon abzubringen, daß ich nicht sein Diener, sondern sein Sklave sei…“"
                                            },
                                            {
                                                "example_id": "23226876-6de2-4650-a8d3-e81ee59ea5c7",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                                            },
                                            {
                                                "example_id": "cbf1718a-5aa3-4572-a9e9-0fc6958b3852",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Mit dem »ganz ollen Vietzke« ist unser alter Diener gemeint; sein Sohn ist der Brennermeister.“"
                                            },
                                            {
                                                "example_id": "5b171a48-7db5-44ff-9377-04ffdca2ad20",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Ich befürchtete, dass der Diener mich nicht hereinlassen würde, wenn ich im Gewand eines einfachen Seemanns anklopfte, also öffnete ich die Eingangstür ohne Umschweife und ging direkt durch zum Salon, bevor man mich aufhalten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Person, die sich sehr für etwas einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1c9437-4fa5-4a89-bc92-89e530085dbe",
                                                "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                                "text": "Er war ein mächtiger Diener der Wissenschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Verbeugung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affab34a-15eb-4dcc-b24b-053d4374d691",
                                                "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                                "text": "Als Kinder mussten wir zur Begrüßung einen Diener machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
