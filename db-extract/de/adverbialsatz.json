                "senses": [
                    {
                        "sense_id": "baf7d2f9-b63f-3f51-a918-f12c550c86b0",
                        "entry_id": "3bb634b4-ccd8-3dca-b850-67e87e058096",
                        "glosses": [
                            "Gliedsatz, der die grammatische Funktion einer adverbialen Bestimmung hat"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "cfabde03-9722-45c4-82fd-0c8a776bbd4f",
                                "sense_id": "baf7d2f9-b63f-3f51-a918-f12c550c86b0",
                                "text": "In dem Satz „Komm, wann immer Du willst“ ist der Gliedsatz „wann immer Du willst“ ein Adverbialsatz; er hat die Funktion einer adverbialen Bestimmung der Zeit und kann daher genauer als Temporalsatz verstanden werden."
                            },
                            {
                                "example_id": "40c1ae49-e25e-4ffd-9cf7-7556a755e811",
                                "sense_id": "baf7d2f9-b63f-3f51-a918-f12c550c86b0",
                                "text": "„Adverbialsätze werden gewöhnlich durch Konjunktionen (Bindewörter) eingeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
