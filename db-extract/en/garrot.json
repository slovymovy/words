                        "entry_id": "99e48b16-faa1-34cc-ada8-3f8126b8a91a",
                        "glosses": [
                            "A stick or small wooden cylinder used for tightening a bandage, in order to compress the arteries of a limb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ed62fa-ea10-42c6-8eff-a10eb4275ed2",
                                "sense_id": "dacd2192-6283-3bf1-9851-32d55184ca42",
                                "text": "The Army doctor used a garrot to stop the bleeding from the injured soldier's wound."
                            }
                        ]
                    }
                ],
