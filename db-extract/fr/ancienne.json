                        "sense_id": "d6b95011-e27f-30bc-930a-3393630a6e9f",
                        "entry_id": "cf485844-ac79-3e54-970c-99421dcc5849",
                        "glosses": [
                            "Femme âgée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "265d3242-30ab-3418-bf41-b343e62df641",
                        "entry_id": "cf485844-ac79-3e54-970c-99421dcc5849",
                        "glosses": [
                            "Personne qui fait partie d’un groupe quelconque depuis longtemps, d’une promotion antérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d8ad97-f653-4ae7-a6d4-4ebe7c1e524c",
                                "sense_id": "265d3242-30ab-3418-bf41-b343e62df641",
                                "text": "Dès son premier livre de théorie, Woman Hating (1974), Andrea Dworkin est saluée par les anciennes, Kate Millett, Audre Lorde, Phyllis Chesler. Elles remarquent et admirent sa « rapidité » et sa « pureté », et sa capacité unique à exprimer et à susciter la colère."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3aa1ea5-00f5-375f-9f76-382bc51412d0",
                        "entry_id": "cf485844-ac79-3e54-970c-99421dcc5849",
                        "glosses": [
                            "Voiture ancienne ; voiture de collection."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad337e6-6d47-4022-a8f2-57b62b0ae7a5",
                                "sense_id": "e3aa1ea5-00f5-375f-9f76-382bc51412d0",
                                "text": "À 14 ans, il monte pour la première fois dans la belle ancienne d'Alain Roques, désormais son ami et coorganisateur."
                            }
                        ]
                    }
                ],
