{
    "word_family": [
        "я",
        "мой",
        "по-моему",
        "якать"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "a86d0270-03c9-341e-8e45-7c6b86650f4d",
                    "sense_definition": "форма родительного падежа местоимения <w>я</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У <w>меня</w> есть старший брат.",
                            "target_lang_translations": {
                                "en": "<w>I</w> have an older brother.",
                                "de": "<w>Ich</w> habe einen älteren Bruder."
                            }
                        },
                        {
                            "text": "У <w>меня</w> нет времени на это.",
                            "target_lang_translations": {
                                "en": "<w>I</w> don't have time for this.",
                                "de": "<w>Ich</w> habe keine Zeit dafür."
                            }
                        },
                        {
                            "text": "Сделай это для <w>меня</w>, пожалуйста.",
                            "target_lang_translations": {
                                "en": "Do this for <w>me</w>, please.",
                                "de": "Tu das bitte für <w>mich</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "у меня есть",
                        "у меня нет",
                        "для меня",
                        "без меня",
                        "от меня"
                    ],
                    "target_lang_definitions": {
                        "en": "genitive case form of the pronoun <w>I</w>",
                        "de": "Genitivform des Personalpronomens ich, oft verwendet in Besitzkonstruktionen oder nach bestimmten Präpositionen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "me",
                                "target_lang_sense_clarification": "used with prepositions (e.g., for me, from me)"
                            },
                            {
                                "target_lang_word": "I",
                                "target_lang_sense_clarification": "used in possession constructions (e.g., I have)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ich",
                                "target_lang_sense_clarification": "wird in deutschen Besitzkonstruktionen verwendet (z.B. Ich habe...)"
                            },
                            {
                                "target_lang_word": "mir",
                                "target_lang_sense_clarification": "Dativform, oft nach Präpositionen wie 'für' (im Sinne von 'für mich') oder bei Verben, die den Dativ verlangen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a53bd6f-0961-39c5-92cb-5e122d211a2c",
                    "sense_definition": "форма винительного падежа местоимения <w>я</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Меня</w> зовут Александр.",
                            "target_lang_translations": {
                                "en": "<w>My</w> name is Alexander.",
                                "de": "<w>Ich</w> heiße Alexander."
                            }
                        },
                        {
                            "text": "Ты <w>меня</w> понимаешь?",
                            "target_lang_translations": {
                                "en": "Do you understand <w>me</w>?",
                                "de": "Verstehst du <w>mich</w>?"
                            }
                        },
                        {
                            "text": "Никто <w>меня</w> не видел.",
                            "target_lang_translations": {
                                "en": "No one saw <w>me</w>.",
                                "de": "Niemand hat <w>mich</w> gesehen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "меня зовут",
                        "прости меня",
                        "подожди меня",
                        "слушай меня"
                    ],
                    "target_lang_definitions": {
                        "en": "accusative case form of the pronoun <w>I</w>",
                        "de": "Akkusativform des Personalpronomens ich, dient als direktes Objekt einer Handlung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "me",
                                "target_lang_sense_clarification": "direct object of a verb"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mich",
                                "target_lang_sense_clarification": "Akkusativform des Personalpronomens ich als direktes Objekt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "37b928ad-56c0-31e8-8eae-fcc26c36cd42",
                    "sense_definition": "река в России",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "<w>Меня</w> — одна из многочисленных рек, протекающих по территории России.",
                            "target_lang_translations": {
                                "en": "<w>Menya</w> is one of the numerous rivers flowing through the territory of Russia.",
                                "de": "Die <w>Menja</w> ist einer der zahlreichen Flüsse, die durch Russland fließen."
                            }
                        },
                        {
                            "text": "Туристы редко посещают реку <w>Меня</w>.",
                            "target_lang_translations": {
                                "en": "Tourists rarely visit the <w>Menya</w> river.",
                                "de": "Touristen besuchen selten den Fluss <w>Menja</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a river in Russia",
                        "de": "Ein Fluss in Russland."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Menya",
                                "target_lang_sense_clarification": "geographical name"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Menja",
                                "target_lang_sense_clarification": "Geografischer Eigenname des Flusses"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}