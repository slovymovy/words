                                "sense_id": "e74e452a-522f-30f6-8b99-d3919ca0b3d4",
                                "text": "She kissed him sexually."
                            }
                        ]
                    },
                    {
                        "sense_id": "3daaa3a1-b17d-3375-8538-e99a0062dff0",
                        "entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
                        "glosses": [
                            "With respect to sex (either of the two divisions of organisms)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a4a6f9-30c4-4fba-be26-eb543d511641",
                                "sense_id": "3daaa3a1-b17d-3375-8538-e99a0062dff0",
                                "text": "The firm discriminated sexually in its hiring and retention practices."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa45599c-a3ab-3995-afbb-fe04862133df",
                        "entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
                        "glosses": [
                            "With respect to sexual intercourse."
