                                    {
                                        "sense_id": "3aac05a9-28c9-3b85-8b57-da6ad4cf36d2",
                                        "entry_id": "a0b1d406-c24f-3bd5-8515-b06cc505e38e",
                                        "glosses": [
                                            "singular of pampas"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545d5648-ebbc-4bdc-8134-a5b2ea50a3ff",
                                                "sense_id": "3aac05a9-28c9-3b85-8b57-da6ad4cf36d2",
                                                "text": "Until the 1920's, Argentina was one of the wealthiest nations in the world, thanks to the fertile farms and ranches that spread over the pampa — the grasslands that stretch in a huge arc from Buenos Aires."
                                            }
                                        ]
                                    }
                                ]
