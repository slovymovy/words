    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "578e87fc-2161-31d8-8bc4-fc0fc819f56b",
                    "sense_definition": "Showing, having, or expressing a calm, controlled, and serious manner that commands respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to maintain a <w>dignified</w> silence despite the harsh accusations thrown at her.",
                            "target_lang_translations": {
                                "nl": "Ze slaagde erin een <w>waardig</w> stilzwijgen te bewaren ondanks de harde beschuldigingen die naar haar hoofd werden geslingerd."
                            }
                        },
                        {
                            "text": "The former president made a <w>dignified</w> exit after concluding his final speech.",
                            "target_lang_translations": {
                                "nl": "De voormalige president maakte een <w>waardige</w> aftocht na het afronden van zijn laatste toespraak."
                            }
                        }
                    ],
                    "synonyms": [
                        "august"
                    ],
                    "antonyms": [
                        "undignified"
                    ],
                    "common_phrases": [
                        "dignified silence",
                        "dignified manner",
                        "remain dignified"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een rustige, beheerste en ernstige houding tonend of hebbend die respect afdwingt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "waardig",
                                "target_lang_sense_clarification": "met waardigheid en zelfbeheersing"
                            },
                            {
                                "target_lang_word": "voornaam",
                                "target_lang_sense_clarification": "deftig en respect afdwingend"
                            },
                            {
                                "target_lang_word": "statig",
                                "target_lang_sense_clarification": "plechtig en indrukwekkend"
                            }
                        ]
                    }
                }
            ]
        },
        {
