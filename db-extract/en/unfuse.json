                        "glosses": [
                            "To separate before a fusion; to make no longer fused."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab37b06c-97cd-4c9c-b11f-ab028161e9b1",
                                "sense_id": "a59498c7-3ecf-36f8-83d2-f36358bf57d4",
                                "text": "Nobody can unfuse fused bones, Quen, nobody.\""
                            },
                            {
                                "example_id": "0318e19d-0c09-468b-87b9-d300d96b553e",
                                "sense_id": "a59498c7-3ecf-36f8-83d2-f36358bf57d4",
                                "text": "I've become permanently fused with him. And I can't unfuse. I'm sitting here waiting to unfuse"
                            },
                            {
                                "example_id": "36d2fdf1-883c-4d39-998d-0abe02229348",
                                "sense_id": "a59498c7-3ecf-36f8-83d2-f36358bf57d4",
                                "text": "A fused hem is almost impossible to change because adhesive residue sticks all over the place when you try to unfuse it."
                            }
                        ]
                    }
