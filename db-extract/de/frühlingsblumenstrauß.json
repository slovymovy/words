                "senses": [
                    {
                        "sense_id": "e30f038f-0210-392f-abe9-c946a5aa5cc8",
                        "entry_id": "690d4938-9b95-34f7-91a7-065f2bc4fcd3",
                        "glosses": [
                            "Blumenstrauß, zusammengestellt aus Frühlingsblumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7d81ad-73ac-4494-9069-a010532222d1",
                                "sense_id": "e30f038f-0210-392f-abe9-c946a5aa5cc8",
                                "text": "„Es wäre zum Beispiel ein Blödsinn, meinen Frühlingsblumenstrauß als Trend zu verkaufen.“"
                            },
                            {
                                "example_id": "a91080da-ee14-460e-b65c-7e86f3bdda4c",
                                "sense_id": "e30f038f-0210-392f-abe9-c946a5aa5cc8",
                                "text": "„Im Messenger plaudert man mit dem Floristen-Bot und bittet ihn, einen Frühlingsblumenstrauß für die Mutter zusammenzustellen.“"
                            },
                            {
                                "example_id": "b988c407-98a8-4483-88e5-499c3c8ef020",
                                "sense_id": "e30f038f-0210-392f-abe9-c946a5aa5cc8",
                                "text": "„Die Aromen tausender Duftkerzen vermischen sich zu einem Sinneseindruck, der einer saftigen Ohrfeige mit einem Frühlingsblumenstrauß ziemlich nahe kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
