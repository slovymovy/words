{
    "word_family": [
        "aarzelen",
        "aarzelend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "017dbcab-e282-3802-b2ec-35d0995584d9",
                    "sense_definition": "het kortstondig wachten voordat men iets doet of zegt, vaak door onzekerheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moedige politieagent sprong zonder <w>aarzeling</w> in het koude kanaal om het kind te redden. ",
                            "target_lang_translations": {
                                "en": "The brave police officer jumped into the cold canal without <w>hesitation</w> to save the child."
                            }
                        },
                        {
                            "text": "Na een korte <w>aarzeling</w> besloot de student toch het moeilijke examenonderdeel te maken.",
                            "target_lang_translations": {
                                "en": "After a short <w>hesitation</w>, the student decided to do the difficult part of the exam anyway."
                            }
                        }
                    ],
                    "synonyms": [
                        "twijfel",
                        "weifeling"
                    ],
                    "antonyms": [
                        "beslistheid",
                        "vastberadenheid"
                    ],
                    "common_phrases": [
                        "zonder aarzeling",
                        "enige aarzeling",
                        "korte aarzeling"
                    ],
                    "target_lang_definitions": {
                        "en": "waiting briefly before doing or saying something, often due to uncertainty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hesitation",
                                "target_lang_sense_clarification": "the act of pausing before doing something"
                            },
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "a brief stop in action or speech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43eba5b2-ce20-311b-a868-e3ac4507696c",
                    "sense_definition": "een toestand van innerlijke onzekerheid of twijfel over een te nemen besluit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>aarzeling</w> was duidelijk in zijn stem te horen toen hij de vraag beantwoordde.",
                            "target_lang_translations": {
                                "en": "The <w>hesitation</w> was clearly audible in his voice when he answered the question."
                            }
                        },
                        {
                            "text": "Na veel <w>aarzelingen</w> gaf mijn vader eindelijk toe en mochten we op vakantie.",
                            "target_lang_translations": {
                                "en": "After much <w>indecision</w>, my father finally gave in and we were allowed to go on holiday."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzekerheid",
                        "dubio",
                        "weifel"
                    ],
                    "antonyms": [
                        "zekerheid",
                        "overtuiging"
                    ],
                    "common_phrases": [
                        "veel aarzelingen",
                        "stem vol aarzeling"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of inner uncertainty or doubt regarding a decision to be made"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hesitation",
                                "target_lang_sense_clarification": "a state of doubt or reluctance"
                            },
                            {
                                "target_lang_word": "indecision",
                                "target_lang_sense_clarification": "the inability to make a decision"
                            },
                            {
                                "target_lang_word": "vacillation",
                                "target_lang_sense_clarification": "wavering between different opinions or actions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}