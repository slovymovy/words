                            "target_lang_translations": {
                                "cs": "Konference se zaměřila na nejnovější výzkum v <w>PLoP</w>."
                            }
                        },
                        {
                            "text": "Many software engineers attend the <w>PLoP</w> workshop annually.",
                            "target_lang_translations": {
