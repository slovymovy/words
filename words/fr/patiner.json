                {
                    "sense_id": "5b54f5b9-8e9b-3b83-874d-a917a851f309",
                    "sense_definition": "Glisser sur la glace ou sur une surface lisse en portant des patins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "glisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, les enfants adorent <w>patiner</w> sur la surface gelée du grand lac."
                        },
                        {
                            "text": "Elle a commencé à <w>patiner</w> très jeune et s'entraîne désormais chaque semaine."
                        }
                    ],
                    "common_phrases": [
                        "patiner sur la glace"
                    ]
                },
                {
                    "sense_id": "94b1aba9-595e-3450-a228-4d2af802d923",
                    "sense_definition": "Tourner rapidement sans faire avancer le véhicule par manque d'adhérence, en parlant des roues.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pneus de la voiture commencent à <w>patiner</w> sur cette route verglacée."
                        },
                        {
                            "text": "La camionnette est restée bloquée dans la boue car ses roues arrière <w>patinaient</w>."
                        }
                    ],
                    "common_phrases": [
                        "roues qui patinent"
                    ]
                },
                {
                    "sense_id": "9dc91045-96c5-357a-982e-f992d4f435a3",
                    "sense_definition": "Ne pas progresser et piétiner, en parlant d'un projet, d'une négociation ou d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stagnation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet de modernisation <w>patine</w> depuis plusieurs mois en raison de désaccords budgétaires."
                        },
                        {
                            "text": "Les négociations internationales semblent <w>patiner</w> sans issue claire à l'horizon."
                        }
                    ],
                    "synonyms": [
                        "faire du sur place"
                    ],
                    "common_phrases": [
                        "patiner dans la semoule"
                    ]
                },
                {
                    "sense_id": "fd57b7e2-b243-36bf-9c4e-054c3e3536fd",
                    "sense_definition": "Donner l'aspect du vieillissement naturel à un meuble ou à un objet d'art.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>patiner</w> ce meuble en chêne pour lui conférer un aspect ancien."
                        },
                        {
                            "text": "Elle a appris à <w>patiner</w> des cadres dorés lors d'un stage de restauration."
                        }
                    ],
                    "common_phrases": [
                        "patiner un meuble"
                    ]
                }
            ]
        }
