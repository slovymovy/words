                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d1ed64-07ff-46ba-a695-c244efb2b80b",
                                "sense_id": "e2fba318-ec6a-351e-b363-21bdcd426136",
                                "text": "Ne croyez-vous pas que vous vous laissez parfois autofasciner par ce pouvoir extraordinaire, quasi magique de l’historien et dont vous disposez grâce à ce plaisir dont nous avons parlé, pour attribuer à des acteurs du passé votre propre rôle, votre capacité extrêmement vivante à faire naître l’interrogation sur soi ?"
                            },
                            {
                                "example_id": "efed1e91-9ce0-4144-a2f1-6d5114384bc3",
                                "sense_id": "e2fba318-ec6a-351e-b363-21bdcd426136",
                                "text": "Une curieuse détresse, dans cette scène comique, ce tournis autofasciné."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f24f8ea-2143-37de-9b44-64bb5d8b4a78",
                        "entry_id": "5f3c97d6-83c8-3dea-bac2-7c05f472f2da",
                        "glosses": [
                            "Se fasciner soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
