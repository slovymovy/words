                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a4efc1-712c-4862-a670-896952e62040",
                                "sense_id": "72f06e37-d3e8-3c31-9420-ad0d5220ebe2",
                                "text": "Das Motiv des Weinlaubs als Ausschmückung der Kanzel ist ein Verweis auf das Bibelwort aus dem Johannesevangelium."
                            },
                            {
                                "example_id": "6e878285-3ba9-4761-9355-44a2f9a06834",
                                "sense_id": "72f06e37-d3e8-3c31-9420-ad0d5220ebe2",
                                "text": "Die Bibelworte beginnen mit dem dritten Verse des Alten Testament's, Gott sprach: Es werde Licht. Und es ward Licht."
                            },
                            {
                                "example_id": "73f33011-d68c-4d52-877d-0a14714922e9",
                                "sense_id": "72f06e37-d3e8-3c31-9420-ad0d5220ebe2",
                                "text": "Es kommt eben auch darauf an, wie man die Bibelworte auslegt."
                            }
                        ],
