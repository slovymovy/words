    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e5bd2a9-4dd7-3937-8c2e-5950c589bcbc",
                    "sense_definition": "Qui est propre à la campagne ou qui évoque le mode de vie champêtre par sa simplicité et sa solidité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "campagne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décoré leur salon de campagne avec des meubles <w>rustiques</w> en chêne massif."
                        },
                        {
                            "text": "Cette auberge de montagne offre une cuisine <w>rustique</w> et généreuse appréciée des randonneurs."
                        }
                    ],
                    "synonyms": [
                        "champêtre",
                        "campagnard"
                    ],
                    "antonyms": [
                        "urbain",
                        "raffiné",
                        "sophistiqué"
                    ],
                    "common_phrases": [
                        "meuble rustique",
                        "style rustique",
                        "vie rustique"
                    ]
                },
                {
                    "sense_id": "f2b4e746-8c97-3a4f-9c42-48741b9a33d5",
                    "sense_definition": "Qui supporte sans dommage les intempéries, le froid ou des conditions de vie difficiles, en parlant d'une plante ou d'un animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "robustesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante <w>rustique</w> passe tout l'hiver dehors sans avoir besoin de protection particulière."
                        },
                        {
                            "text": "L'éleveur a choisi une race bovine <w>rustique</w> parfaitement adaptée aux rudes pâturages d'altitude."
