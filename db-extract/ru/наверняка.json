        "ru-extract.jsonl": [
            {
                "entry_id": "ed3a3cfe-7dcf-374d-ad7e-34080edb6559",
                "word": "наверняка",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33fe8894-3d26-31fc-b551-05ee74d5eccd",
                        "entry_id": "ed3a3cfe-7dcf-374d-ad7e-34080edb6559",
                        "glosses": [
                            "несомненно, верно, точно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd859bfc-6db3-4e83-b7d8-d772250b5298",
                                "sense_id": "33fe8894-3d26-31fc-b551-05ee74d5eccd",
                                "text": "Капитан «Шани» по дыму догадался, что одно из судов наверняка военный крейсер."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce631a4-1942-32dd-b81c-ffe43b2b3411",
                        "entry_id": "ed3a3cfe-7dcf-374d-ad7e-34080edb6559",
                        "glosses": [
                            "с верным расчётом, без риска ошибиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5b9904-c5d5-4de4-a900-a9e5e9fce3c4",
                                "sense_id": "0ce631a4-1942-32dd-b81c-ffe43b2b3411",
                                "text": "Задача стрелков в такой охоте — подпустить медведя на расстояние верного выстрела и, прицелившись по лопаткам, бить наверняка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb54b7c0-b0f7-406f-b27e-d45f01424a29",
                        "source_entry_id": "ed3a3cfe-7dcf-374d-ad7e-34080edb6559",
                        "source_sense_description": "с достоверностью",
                        "target_lang_word": "surely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Without fail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "406c8243-0e5a-4fe4-bdcc-81fcc211cc27",
                                                "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                                "text": "slowly but surely"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Certainly, undoubtedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9b0d14-0b29-4e6f-ac77-7ad98fa65234",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Surely, you must be joking."
                                            },
                                            {
                                                "example_id": "3621f3cb-b892-44b0-ab9d-e6dd2977a6eb",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "You don’t suppose we're going to pay for you, surely?"
                                            },
                                            {
                                                "example_id": "43d2bcd0-c794-4516-846b-a4cd249eb952",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "She’s surely got the letter by now."
                                            },
                                            {
                                                "example_id": "9a311353-e1b1-495e-b931-1e8f75127d7e",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "But then I had the flintlock by me for protection. ¶ There were giants in the days when that gun was made; for surely no modern mortal could have held that mass of metal steady to his shoulder. The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…]."
                                            },
                                            {
                                                "example_id": "34663fcc-6e83-4c73-a424-c4edc32328ad",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Ted Striker: The stewardess said... both pilots?!\nDr. Rumack: Can you fly this plane and land it?\nTed Striker: Surely you can't be serious.\nDr. Rumack: I am serious; and don't call me Shirley."
                                            },
                                            {
                                                "example_id": "18d0c44d-e5af-404c-a843-a5a80d2b4334",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "With confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17183608-5e5e-41bb-8ca6-60914ff1a33d",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "His feet were planted surely on the ground."
                                            },
                                            {
                                                "example_id": "1db64fc2-249b-44ee-9da4-84ee0955ecf5",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0fabab0-b21f-4149-b681-ac6f79d4b9ed",
                        "source_entry_id": "ed3a3cfe-7dcf-374d-ad7e-34080edb6559",
                        "source_sense_description": "с достоверностью",
                        "target_lang_word": "certainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "In a way which is certain; with certainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d57d5d-7e5a-4160-9e91-43ef23e26163",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "he verily thought he had young live frogs in his belly, qui vivebant ex alimento suo, that lived by his nourishment, and was so certainly persuaded of it, that for many years following he could not be rectified in his conceit."
                                            },
                                            {
                                                "example_id": "acad7d4d-3217-4638-bf27-04d0a5664d95",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "The torque was \"built up\" in the special back axle and the car crawled tankwise but very certainly over the obstacles without a jar or hesitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "Without doubt, surely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f5edfd-a190-46a3-b3d7-c40fc07f1c6f",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "The accident was certainly caused by human error."
                                            },
                                            {
                                                "example_id": "c6e95e92-978c-49ae-9844-6e3da1e1bab4",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "That was certainly sweet of him."
                                            },
                                            {
                                                "example_id": "72e8830c-37fa-428a-a001-0713feed9d07",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "'I'm all grown up now' -'You certainly have (grown)!'"
                                            },
                                            {
                                                "example_id": "d45ba451-4f5d-428c-9d74-ab88e2d6ec73",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "b27e5847-2b91-4193-81d0-5d87b301fe6d",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "An emphatic affirmative answer; of course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f25142-62b5-44da-806f-561c4542c5e9",
                                                "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                                "text": "Would you like it with ice?  Certainly, and with lemon please."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab761349-6af3-4d39-8f4e-d11f794e0b6f",
