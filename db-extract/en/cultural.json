                                "target_senses": [
                                    {
                                        "sense_id": "daa68cda-0396-3205-8416-5a661569735a",
                                        "entry_id": "0d4f18b8-f8ca-35cb-a9e1-fcb5b028c16b",
                                        "glosses": [
                                            "dotyczący kultury"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f2f37c-b181-4976-9e76-fe468767dc3d",
                                                "sense_id": "daa68cda-0396-3205-8416-5a661569735a",
                                                "text": "Ze względu na cierpienie i śmierć nieuchronnie z nim związane jesteśmy zdecydowanie przeciwni tzw. ubojowi rytualnemu, a legalizację tego procederu w Polsce uważamy za kulturowy krok wstecz."
                                            },
                                            {
                                                "example_id": "676de3c9-3f99-486a-b240-0506dbe65e43",
                                                "sense_id": "daa68cda-0396-3205-8416-5a661569735a",
                                                "text": "Kabylowie są nieco bardziej „europejscy” i stąd mniejsze są różnice kulturowe."
                                            },
                                            {
                                                "example_id": "cccea7de-dc54-41e8-a1e5-8d69b9824f19",
                                                "sense_id": "daa68cda-0396-3205-8416-5a661569735a",
                                                "text": "Głównymi dyscyplinami wchodzącymi w skład kognitywistyki są: neurobiologia, neuropsychologia, neurokognitywistyka, społeczna nauka poznawcza, psychologia poznawcza, informatyka, sztuczna inteligencja, robotyka kognitywna, językoznawstwo kognitywne, teoria obliczeń i teoria informacji, antropologia kulturowa, filozofia umysłu oraz wybrane działy logiki (zwłaszcza logika epistemiczna, doksastyczna, semantyka logiczna i teoria systemów dedukcyjnych z jej twierdzeniami limitacyjnymi)."
                                            },
                                            {
                                                "example_id": "b5314211-3d52-48dd-8ce4-876dd3b8ab40",
                                                "sense_id": "daa68cda-0396-3205-8416-5a661569735a",
                                                "text": "\"Antropolodzy mają prawo twierdzić, że przyczynili się do zachowania kulturowego dziedzictwa społeczeństw, które badali, […]. Lecz prawdą jest również, iż mieli oni swój udział, czasem tylko pośredni, w utrzymywaniu struktur władzy reprezentowanych przez system kolonialny\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
