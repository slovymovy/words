                "senses": [
                    {
                        "sense_id": "953a5c2f-6e54-3ff6-a477-60b198cac290",
                        "entry_id": "93caf3b7-0032-3754-8402-88f51339f00b",
                        "glosses": [
                            "Stadt in Usbekistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724993a3-8fe0-43f1-b1c2-f5b9b8d877aa",
                                "sense_id": "953a5c2f-6e54-3ff6-a477-60b198cac290",
                                "text": "„Die Muslime haben sich gefragt, wie das sein kann und eine Woche später in Kokand in Usbekistan einen Muslim-Kongress für ganz Turkestan abgehalten.“"
                            },
                            {
                                "example_id": "932c080f-1406-4bdb-a23c-adfd78ca8224",
                                "sense_id": "953a5c2f-6e54-3ff6-a477-60b198cac290",
                                "text": "„Die Russen fürchteten, dass die Briten sie in Zentralasien gefährden könnten, indem sie Revolten muslimischer Stämme und die Herrscher von Buchara und Kokand unterstützten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
