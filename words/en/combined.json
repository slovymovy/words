                    "sense_id": "e74eb6e4-db22-3d15-86c6-cd09487acfdc",
                    "sense_definition": "Resulting from the addition of several sources, parts, elements, or aspects united together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>combined</w> efforts of the emergency workers kept the river from flooding the town.",
                            "target_lang_translations": {
                                "ru": "<w>Объединённые</w> усилия спасателей удержали реку от затопления города.",
                                "tr": "Acil durum çalışanlarının <w>ortak</w> çabaları, nehrin kasabayı basmasını engelledi."
                            }
                        },
                        {
                            "text": "Our <w>combined</w> income was enough to buy a small house in the countryside.",
                            "target_lang_translations": {
                                "ru": "Нашего <w>совокупного</w> дохода хватило, чтобы купить небольшой домик в деревне.",
                                "tr": "<w>Toplam</w> gelirimiz kırsalda küçük bir ev almaya yetti."
                            }
