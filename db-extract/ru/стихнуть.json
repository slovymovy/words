                        "sense_id": "e8ef388a-82a3-32a9-92c5-993739ee5181",
                        "entry_id": "81b9fed8-87eb-3c54-9a04-9423da2957a4",
                        "glosses": [
                            "to quiet down, to abate, to die down (of a storm, war, fighting, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da5356a-48cb-4fbd-8aa0-9deed0fe1f10",
                                "sense_id": "e8ef388a-82a3-32a9-92c5-993739ee5181",
                                "text": "Му́зыка сти́хла, и ка́мера пла́вно качну́лась в во́здухе — сло́вно ука́зывая, куда́ идти́.",
                                "translation": "The music stopped and the camera swayed smoothly in the air, as if it was indicating which way to go.",
                                "english": "The music stopped and the camera swayed smoothly in the air, as if it was indicating which way to go."
                            }
                        ]
                    }
                ],
