                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed38ab5-6b46-3cdc-91d5-01273a8fb448",
                                        "entry_id": "517c392c-5457-3503-bf92-0d097c20ca30",
                                        "glosses": [
                                            "etiket of stempel dat in een boek wordt aangebracht om aan te geven wie de eigenaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1d457c-dcb8-4453-9893-58a0dd270363",
                                                "sense_id": "1ed38ab5-6b46-3cdc-91d5-01273a8fb448",
                                                "text": "Veel lezers zetten hun naam in een boek, soms in combinatie met de aankoopdatum. Of ze hebben een ex libris."
                                            },
                                            {
                                                "example_id": "4295f4c3-9bb7-4c36-9867-596c54380c5f",
                                                "sense_id": "1ed38ab5-6b46-3cdc-91d5-01273a8fb448",
                                                "text": "Ze hebben eigenaren gehad die er hun ex librissen in plakten of er aantekeningen in maakten."
                                            },
                                            {
                                                "example_id": "b99daadc-b64f-4634-b2b4-0cbc86435de2",
                                                "sense_id": "1ed38ab5-6b46-3cdc-91d5-01273a8fb448",
                                                "text": "⧖ De jongeling scheen een liefhebber van lezen: niet dat de hier op een breed rek geschaarde boeken met zijn ex libris vercierd [sic!] waren; wellicht behoorden de meesten aan den ‘konstgheleerden’ Grijspaerdt; (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e8d283-b24c-3a7e-8da8-c041df5e88a3",
                                        "entry_id": "517c392c-5457-3503-bf92-0d097c20ca30",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord ex libris"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44fed20-4ce9-47ae-87b0-b628bfaae8a8",
                                                "sense_id": "48e8d283-b24c-3a7e-8da8-c041df5e88a3",
                                                "text": "Boek bevat een catalogue raisonné van maar liefst 918 nummers: boekomslagen (Wereldbibliotheek), ex-libris, vignetten, affiches, illustraties en een schitterende `verzenddoos', in 1930 ontworpen voor de firma Inventum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "495a1c32-0075-4614-a57d-bb7391ced8b3",
                        "source_entry_id": "fc23598e-e178-3f20-ab5c-c379648b47ae",
