                        "examples": [
                            {
                                "example_id": "bb070e3e-51af-4ad3-8526-0dda3c4a906a",
                                "sense_id": "ff362f0b-0911-3faf-bb36-0b04b3f5761f",
                                "text": "Nikolenka, wat is Troenila een schat van een hond. Hij herkende me, zei Natasja over haar lievelingshond."
                            },
                            {
                                "example_id": "ddd2b0ad-8f96-4058-8958-1e751eb9614f",
                                "sense_id": "ff362f0b-0911-3faf-bb36-0b04b3f5761f",
                                "text": "De lievelingshond van koning Bhumibol van Thailand is overleden, dat heeft het Thaise hof in een officiële verklaring bevestigd. De zeventien jaar oude hond Tongdaeng stierf zaterdag in het zomerpaleis in Hua Hin aan ouderdom."
                            }
