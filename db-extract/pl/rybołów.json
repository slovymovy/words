                        "cross_references": [
                            {
                                "target_word": "osprey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0714457e-64f9-38c9-800a-c3ba82021b34",
                                        "entry_id": "8fe7f0ac-201d-3214-a170-86148e92f2f7",
                                        "glosses": [
                                            "A bird of prey of genus Pandion that feeds on fish and has white underparts and long, narrow wings each ending in four finger-like extensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43b9d19-7d14-4f51-be77-255137042c8d",
                                                "sense_id": "0714457e-64f9-38c9-800a-c3ba82021b34",
                                                "text": "1594, George Peele (attributed), The Battle of Alcazar\nI will provide thee of a princely osprey."
                                            },
                                            {
                                                "example_id": "5cac62ad-1b5c-4dc7-aed3-b119733dfdb1",
                                                "sense_id": "0714457e-64f9-38c9-800a-c3ba82021b34",
                                                "text": "But (oh Jove!) your actions, / Soon as they move, as ospreys do the fish, / Subdue before they touch."
                                            },
                                            {
                                                "example_id": "921e3ba3-dd98-4edd-9853-245372050c9c",
                                                "sense_id": "0714457e-64f9-38c9-800a-c3ba82021b34",
                                                "text": "A pair of ospreys bred at a confidential nesting site in Co. Fermanagh in what has been described as like finding long-lost treasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec4178f-2f85-343d-a02a-48689b0e4a83",
                                        "entry_id": "8fe7f0ac-201d-3214-a170-86148e92f2f7",
                                        "glosses": [
                                            "Aigrette (ornamental feather)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77d5ba2a-d43e-4f17-aba8-b6958695c94a",
                        "source_entry_id": "65034775-4b27-3db5-a406-d0ef5a9d0aa7",
                        "source_sense_id": "d8e661e8-4640-3986-80ce-2d493fddb262",
                        "target_lang_word": "balbuzard pêcheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balbuzard pêcheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                        "entry_id": "d80df7c8-ee54-3f1f-9e49-5916236294e8",
                                        "glosses": [
                                            "Espèce d’oiseau rapace diurne (falconiforme) de la famille des accipitridés, piscivore de taille moyenne au ventre blanc, ainsi que la tête qui présente sur les yeux une bande sombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d0055a-545e-45a7-9031-ce19f571b620",
                                                "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                                "text": "Avec beaucoup de chance, vous pourriez apercevoir le balbuzard pêcheur, une espèce rare."
                                            },
                                            {
                                                "example_id": "50935787-585d-4a56-9a54-4cffe0565c0e",
                                                "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                                "text": "Le Balbuzard pêcheur se nourrit uniquement de poissons, qu’il pêche en plongeant pattes tendues vers l’avant, serres grandes ouvertes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
