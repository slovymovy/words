                            },
                            {
                                "target_lang_word": "подсчёт",
                                "target_lang_sense_clarification": "установление количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10f4340-c127-3b26-91a5-7c798cd140f5",
                    "sense_definition": "The final amount or result obtained through the process of calculating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "According to my <w>computation</w>, we should have enough funds to cover the entire project.",
                            "target_lang_translations": {
