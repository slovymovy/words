                            {
                                "example_id": "02501322-65a7-4420-8d74-02b8ca316a2b",
                                "sense_id": "9079dad5-a5a0-37ee-8393-801f11302e64",
                                "text": "Een aangename bijkomstigheid is dat de afgravingen dicht bij zee liggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef8c7759-0879-3ccc-81b4-cee18c56d9fd",
                        "entry_id": "4cdf0c27-d974-34b6-a9fa-89f69bab20e5",
                        "glosses": [
                            "een niet zo belangrijke omstandigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c192faf4-e797-4785-9909-60114fef6ead",
                                "sense_id": "ef8c7759-0879-3ccc-81b4-cee18c56d9fd",
                                "text": "Leerlingen van de middelbare school willen vooral hun vrienden en vriendinnetjes zien op school, de studie zelf is voor de meesten maar een bijzaak."
                            },
                            {
                                "example_id": "e488ea8e-a91f-4e92-8b9a-f204d642178b",
                                "sense_id": "ef8c7759-0879-3ccc-81b4-cee18c56d9fd",
                                "text": "Het overige was vanuit hun gezichtspunt een prettige bijkomstigheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07cddd9f-b097-4c0a-9350-1d41e4f1d203",
