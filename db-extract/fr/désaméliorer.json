                "senses": [
                    {
                        "sense_id": "d7beb9dd-de59-3e3b-b8dd-3a96a3735d96",
                        "entry_id": "e9d259fb-1f13-3b52-9cf6-11e3686d4f5a",
                        "glosses": [
                            "Revenir en arrière en annulant l’amélioration de (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55cd603-a725-479b-b4a7-ad1f4e062762",
                                "sense_id": "d7beb9dd-de59-3e3b-b8dd-3a96a3735d96",
                                "text": "Je pense qu’on ne ferait pas mal de la désaméliorer un peu et de rebrousser chemin."
                            },
                            {
                                "example_id": "aaaaf5a7-ac8c-41d8-83b8-1dd74a12205e",
                                "sense_id": "d7beb9dd-de59-3e3b-b8dd-3a96a3735d96",
                                "text": "Ne pourrait-on désaméliorer cet aspect du site?"
                            },
                            {
                                "example_id": "4539a44e-3b62-400e-a811-cf00d3b27106",
                                "sense_id": "d7beb9dd-de59-3e3b-b8dd-3a96a3735d96",
                                "text": "Quand on commença à faire, dans les hôpitaux, le bouillon, d’après le nouveau règlement en vigueur aujourd’hui, le Conseil municipal se récria, se plaignit de ce que le bouillon était trop bon; et, comme on doit les plus grands égards à l’autorité qui tient les cordons de la bourse, le Conseil des hôpitaux fut obligé de céder et de désaméliorer quelque peu le bouillon."
                            }
                        ]
                    }
                ],
