                                "example_id": "c39e771d-a5d2-4794-b28d-e7476ea70ba2",
                                "sense_id": "63538ab0-1467-36bb-8d48-4a38bcddcd8f",
                                "text": "Zgodnie z prawem szariatu pójdzie do więzienia na 16 miesięcy"
