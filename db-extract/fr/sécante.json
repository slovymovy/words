                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef8fdd98-a500-3995-a1aa-8b2347e93971",
                        "entry_id": "36253fd7-948b-3134-9fea-415f265a649e",
                        "glosses": [
                            "Droite qui en coupe une autre ou qui coupe un plan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ede7e8-3232-463c-8384-925b5e25bcdb",
                                "sense_id": "ef8fdd98-a500-3995-a1aa-8b2347e93971",
                                "text": "Comme des droites convergentes en mathématiques au collège. Il y aura forcément un point de rencontre mais je ne sais pas lequel de nous sera la sécante."
                            }
                        ]
                    },
                    {
                        "sense_id": "f49d7426-678e-3f1b-ba2a-dc7fb56010cc",
                        "entry_id": "36253fd7-948b-3134-9fea-415f265a649e",
                        "glosses": [
                            "Une des lignes trigonométriques d’un angle."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "dae90b68-610c-45ae-b6f8-22afe920138c",
                                "sense_id": "f49d7426-678e-3f1b-ba2a-dc7fb56010cc",
                                "text": "Sécante d’un arc."
                            },
                            {
                                "example_id": "df4885da-b441-4065-8fef-c0bb80e8ea72",
                                "sense_id": "f49d7426-678e-3f1b-ba2a-dc7fb56010cc",
                                "text": "Table des sécantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0858fbc6-172f-3c74-a94c-53cd3b80cdfe",
                        "entry_id": "36253fd7-948b-3134-9fea-415f265a649e",
                        "glosses": [
                            "Une des six fonctions trigonométriques de base. La sécante est l'inverse du cosinus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "541848a3-a031-426a-8674-36833cbed192",
                                "sense_id": "0858fbc6-172f-3c74-a94c-53cd3b80cdfe",
                                "text": "Dans un triangle, la sécante est le rapport de la longueur de l'hypoténuse par la longueur du côté adjacent."
                            },
                            {
                                "example_id": "34e85a04-e2c1-4c01-bb77-ddf3b459894c",
                                "sense_id": "0858fbc6-172f-3c74-a94c-53cd3b80cdfe",
                                "text": "Dans un cercle, la sécante est représentée par la fonction sec(θ)≡1/(cos(θ))"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6c0b0e8-42eb-472c-951b-4a9b890e4e0c",
                        "source_entry_id": "36253fd7-948b-3134-9fea-415f265a649e",
