                    "frequency": "Middle",
                    "semantic_group_id": "raum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im weiteren <w>Umfeld</w> des neuen Bahnhofs entstehen derzeit moderne Wohnungen und Einkaufszentren."
