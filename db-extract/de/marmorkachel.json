                        "glosses": [
                            "Kachel aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dbf0f78-8b6e-4236-92c8-1476488f4dd1",
                                "sense_id": "88418039-2dcc-3dd7-990e-874bfbbef3d3",
                                "text": "„An den Hängen rechts und links wuchert üppiges Grün, schlängeln sich boshafte Ranken und Kriechpflanzen zwischen den Steinen verfallener Paläste hindurch, winden sich fest um zerbrochene Säulen und fremdartige Monolithen und klettern auf Marmorkacheln hinauf, die längst vergessene Arbeiter gelegt haben.“"
                            },
                            {
                                "example_id": "e5c8110a-7b75-4b59-9fd1-31869927ed06",
                                "sense_id": "88418039-2dcc-3dd7-990e-874bfbbef3d3",
                                "text": "„Hier herrschte purer Luxus. Teure, handbehauene Marmorkacheln, vergoldete Dächer und lebensgroße Statuen vor den Grabmälern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
