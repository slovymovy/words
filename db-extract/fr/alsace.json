        "fr-extract.jsonl": [
            {
                "entry_id": "10981829-1e4f-3429-9bb1-d1645b43d082",
                "word": "Alsace",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                        "entry_id": "10981829-1e4f-3429-9bb1-d1645b43d082",
                        "glosses": [
                            "Ancienne région administrative de France, le long du Rhin, voisine de la Suisse et de l’Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7559c75e-0a55-45a2-8c58-6e4664dbae17",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "Puis, soudain, je me souviens que c’est aujourd’hui la veille de Noël ! Quel contraste ! Là-bas, en Alsace, la neige tombe en silence et recouvre tout de sa blancheur immaculée."
                            },
                            {
                                "example_id": "ed7e1682-1f60-427f-8f99-57d27f2ad050",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "C’est ainsi qu’elle lui apprit que leur chaland avait fait séjour en Alsace, en septembre de l’année précédente, amarré le long d’une des îles verdoyantes, dont la rive du Rhin est toute obstruée."
                            },
                            {
                                "example_id": "2867cde0-cdad-4cb9-a53c-72cf86db5ae6",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "Rencontré le lieutenant Bertet. Il n’en revient pas d’être déjà en Alsace. Il n’avait pris que des cartes de Prusse et de Bavière, comme s’il s'agissait dans cette guerre de délivrer la Pologne …."
                            },
                            {
                                "example_id": "d28c99c7-d21b-4292-afbf-bc533bdbad4f",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "La découverte des techniques de la broderie a permis à ces stagiaires, venant des États-Unis, d’Alsace ou de Plouénan, de se former."
                            },
                            {
                                "example_id": "aa88ad1e-29ac-40a1-b7af-380e2a74c307",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "[…] ; enfin les dernières irradiations constitueraient les latéméditerranéennes, le Chêne pubescent pourrait servir à les caractériser. […]. On compte environs 100 espèces de latéméditerranéennes qui font partie de la flore du Bassin de Paris et de l’Alsace."
                            },
                            {
                                "example_id": "77b89cf9-e4af-40e5-9547-0364d20b67b4",
                                "sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                                "text": "Une aube sale. Un ciel bouché. Et un brouillard irrégulier qui montait en écharpes de la vallée, ce brouillard que les gens du pays appellent les fumées d’Alsace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a48a76b-5f2f-4ddc-a0bc-c5c11dd1d09e",
                        "source_entry_id": "10981829-1e4f-3429-9bb1-d1645b43d082",
                        "source_sense_id": "8eb8241b-3393-3741-adb5-9c68171b07b4",
                        "source_sense_description": "Région administrative de France",
                        "target_lang_word": "Elsass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elsass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37ad54c9-e5d0-3c43-845f-b4cf3c663303",
                                        "entry_id": "24a3869c-9734-3544-a351-1ebda634019c",
                                        "glosses": [
                                            "Region im Nordosten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237ea3cb-fc1d-4645-9d18-6161dd68e8bf",
                                                "sense_id": "37ad54c9-e5d0-3c43-845f-b4cf3c663303",
                                                "text": "Einen Edelzwicker aus dem Elsass sollte man nicht verachten."
                                            },
                                            {
                                                "example_id": "f0c0c866-8aa9-4986-a7ee-8856ea105cb3",
                                                "sense_id": "37ad54c9-e5d0-3c43-845f-b4cf3c663303",
                                                "text": "„Die letzten Reste des Westjiddischen wurden von Wissenschaftlern nach den Zweiten Weltkrieg im Elsass, der Schweiz und in Südwestdeutschland aufgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
