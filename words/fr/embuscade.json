                },
                {
                    "sense_id": "852c0565-369b-35ad-97a0-7df42c76cbb7",
                    "sense_definition": "Troupe armée dissimulée dans un endroit favorable pour attaquer l'ennemi par surprise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "troupe_armée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commandant donna le signal à l'<w>embuscade</w> pour bloquer la retraite des troupes ennemies."
                        },
                        {
                            "text": "L'<w>embuscade</w> attendait en silence le passage des cavaliers au fond de la gorge."
