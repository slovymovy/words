                ],
                "senses": [
                    {
                        "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                        "entry_id": "071934e9-1940-34cc-ad9f-fc85ffb62a77",
                        "glosses": [
                            "äußerst wütend, mit sehr viel Wut, Zorn"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1c88055e-2278-489b-b5ff-f9399b4fb688",
                                "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                                "text": "„Seine Majestät wird mordssauer auf dich sein, wenn er davon erfährt!“"
                            },
                            {
                                "example_id": "cc206656-69aa-4497-a05a-a3bc536f8766",
                                "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                                "text": "„Ich war nie ein gewalttätiger Mann, habe immer versucht Konflikte friedlich zu lösen, aber jetzt bin ich mordssauer.“"
                            },
                            {
                                "example_id": "0c3730bd-8ada-4f3f-b1b5-bd9e080dce81",
                                "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                                "text": "„Aber sie hatte nicht, wie erwartet, mordssauer reagiert, sondern nur traurig den Kopf gesenkt und gemurmelt, dass sie sich die CD selbst wiederkaufen würde.“"
                            },
                            {
                                "example_id": "99b1e4d1-ff0a-45c1-b727-a718aa87f486",
                                "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                                "text": "„Theta würde wahrscheinlich mordssauer auf ihn sein, wenn sie herausfand, dass er das Geld zweckentfremdet hatte.“"
                            },
                            {
                                "example_id": "061f3d52-3b7b-4103-97a3-2f716fa720cf",
                                "sense_id": "2db082ae-aaa7-31ce-905c-b8196117386e",
                                "text": "„So wie sie ihn behandelte, schien sie mordssauer auf den Typen zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
