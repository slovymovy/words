                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f444c0-d980-44e0-bebd-8fd7b25fe2c7",
                                "sense_id": "c42ee8a9-b7ec-3f71-a328-9bc93f5dbcdd",
                                "text": "На пенёк парнишка встал, — // Носом до плеча достал! // Но зато его пенёк // Еле втёрся между ног!"
