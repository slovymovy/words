                                                "sense_id": "5e889036-5f21-381e-8885-891fb5b565f1",
                                                "text": "Ο κουλουράς φωνάζει «κουλούρια Θεσσαλονίκης!»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd15725-9ad5-389f-b8aa-931fd3450525",
