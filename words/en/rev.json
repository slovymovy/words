                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sieć dróg rowerowych REV",
                                "target_lang_sense_clarification": "infrastruktura w Montrealu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
