                                        "sense_id": "c15d7b4a-5979-3448-a81d-c77d86ea78d8",
                                        "entry_id": "5a6cb97e-53a0-315f-9644-54931d2ae51a",
                                        "glosses": [
                                            "indischer Bundesstaat an der Westküste des Landes; ehemalige portugiesische Kolonie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3e9f33-9354-4d62-8f01-1d93254323f2",
                                                "sense_id": "c15d7b4a-5979-3448-a81d-c77d86ea78d8",
                                                "text": "„Aber manche glauben dran und bleiben träumend hängen beim Backpacken, machen in Kapstadt ihre Lodge auf oder stehen mit blondem Filzhaar in Goa am Strand rum und halten sich für Siddharta.“"
                                            },
                                            {
                                                "example_id": "a066b6c0-b8b5-4cb2-8e14-fd31763a88aa",
                                                "sense_id": "c15d7b4a-5979-3448-a81d-c77d86ea78d8",
                                                "text": "„Nehru wurde zu jener Zeit vor allem von afrikanischen Nationalisten kritisiert, weil er immer noch zögerte, der portugiesischen Kolonialherrschaft in Goa ein Ende zu setzen.“"
                                            },
                                            {
                                                "example_id": "79286f5a-4ca3-4475-b805-66a0e7c4b986",
                                                "sense_id": "c15d7b4a-5979-3448-a81d-c77d86ea78d8",
                                                "text": "„Und was sind die? Kachra aus Goa, Strandgut, vom Arabischen Meer an Land geworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
