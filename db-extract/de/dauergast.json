                "senses": [
                    {
                        "sense_id": "13014879-02a3-34f5-93ce-22f87d61ea9b",
                        "entry_id": "2225365b-c68d-31fe-ad8e-15073467368e",
                        "glosses": [
                            "dauerhafter Gast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ef9e49-3315-49a1-936a-d0684ddfb7b5",
                                "sense_id": "13014879-02a3-34f5-93ce-22f87d61ea9b",
                                "text": "Im Alter war sie Dauergast eines billigen Hotels an der Ortseinfahrt, bis sie einmal zu oft mit der Köchin wegen des dürftigen Frühstücks aneinander geriet."
                            },
                            {
                                "example_id": "83552edb-d84a-4578-b06d-debeb8c4930a",
                                "sense_id": "13014879-02a3-34f5-93ce-22f87d61ea9b",
                                "text": "„Ebenfalls zu den Dauergästen des Bades zählt der Spanner mit dem Hasengebiss, der permanent draußen hinter der Glaswand des Bades den Schwimmern hinterherläuft.“"
                            },
                            {
                                "example_id": "c48cc779-8980-4aff-b14d-347b6dd21f66",
                                "sense_id": "13014879-02a3-34f5-93ce-22f87d61ea9b",
                                "text": "„Deshalb denkt sie, dass Dux als Dauergast in ihrer Klinik bleiben wird.“"
                            },
                            {
                                "example_id": "8c77a4b3-ca3f-400f-8edf-4d5e553c4258",
                                "sense_id": "13014879-02a3-34f5-93ce-22f87d61ea9b",
                                "text": "„Auch der spätere Akademieleiter Ludwig Dettmann wurde zu einem Dauergast in Bersnicken und einem Freund Großchens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
