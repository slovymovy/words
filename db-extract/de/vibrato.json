                ],
                "senses": [
                    {
                        "sense_id": "aadf6f46-ebe4-322a-aa15-ccec43a36d42",
                        "entry_id": "98d5c52d-85db-3593-9a45-d1dff9779b19",
                        "glosses": [
                            "leichtes Zittern oder Beben eines Tons, das mit der Stimme, sowie auf Saiten- und Blasinstrumenten durch bestimmte Techniken erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b0fac2-4c11-4fa7-9cbf-3b21de47496f",
                                "sense_id": "aadf6f46-ebe4-322a-aa15-ccec43a36d42",
                                "text": "„Lieber kein Vibrato als zu viel davon, lieber glockenreine Kopftöne als ein orgelndes Brustregister“"
                            },
                            {
                                "example_id": "32981126-c815-4b45-a137-2f17836926ba",
                                "sense_id": "aadf6f46-ebe4-322a-aa15-ccec43a36d42",
                                "text": "„Er zog die Saiten auf dem Griffbrett so sicher zum gewünschten Ton hin, dass man oft nicht wusste, ob das noch Bendings sind, wie es in der Fachsprache heißt, ob er den Tremolohebel dazu benutzte oder nur etwas Vibrato auf die Fingerkuppen drückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9908862-fffd-4f3f-859e-852df7078e8a",
                        "source_entry_id": "98d5c52d-85db-3593-9a45-d1dff9779b19",
                        "source_sense_id": "aadf6f46-ebe4-322a-aa15-ccec43a36d42",
                        "source_sense_description": "leichtes Zittern eines Tones",
                        "target_lang_word": "vibrato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vibrato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa434131-095e-3c34-afc3-cc83895a2393",
                                        "entry_id": "bb998080-7fe8-3c5f-8306-3fad0770adcc",
                                        "glosses": [
                                            "The musical effect or technique where the pitch or frequency of a note or sound is quickly and repeatedly raised and lowered over a small distance for the duration of that note or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af25a98b-d117-4e23-b986-891c52364f6c",
                                                "sense_id": "aa434131-095e-3c34-afc3-cc83895a2393",
                                                "text": "He felt his teeth methodically, one after the other, with a vibrato movement of finger and thumb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "299141d0-e91c-4122-bec1-6fed535ac17e",
                        "source_entry_id": "98d5c52d-85db-3593-9a45-d1dff9779b19",
                        "source_sense_id": "aadf6f46-ebe4-322a-aa15-ccec43a36d42",
                        "source_sense_description": "leichtes Zittern eines Tones",
                        "target_lang_word": "vibrato",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vibrato",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e837e35-2283-34f0-af91-35ba5910a855",
                                        "entry_id": "afab54a0-c857-3885-91c5-7e413e67db66",
                                        "glosses": [
                                            "Variation rapide de la hauteur d’un son autour de la fréquence. Ne pas confondre avec le trémolo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498d8b8d-ee8e-4d8e-bdba-5dcf1f2976d6",
                                                "sense_id": "0e837e35-2283-34f0-af91-35ba5910a855",
                                                "text": "Il [Laurent Voulzy] chante sans employer le moindre vibrato dont usent et abusent beaucoup de crooners."
                                            },
                                            {
                                                "example_id": "58f6584f-231a-49c7-97e0-6e6b987d646b",
                                                "sense_id": "0e837e35-2283-34f0-af91-35ba5910a855",
                                                "text": "Une fille à l'apparence fragile, au corps maigre, au regard perdu et à la voix pleine de vibratos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca3a8d16-e68e-4a77-aadd-e40a90012846",
                        "source_entry_id": "98d5c52d-85db-3593-9a45-d1dff9779b19",
