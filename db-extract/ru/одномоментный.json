                    }
                ],
                "senses": [
                    {
                        "sense_id": "22d8d094-16e2-38d1-8d48-f7bd3995f1d0",
                        "entry_id": "5cb85c73-1894-3883-a42e-c88435f93778",
                        "glosses": [
                            "относящийся к одному конкретному моменту; происходящий сразу, однократно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5538efaa-93e0-409f-833d-e0445f4bbd36",
                                "sense_id": "22d8d094-16e2-38d1-8d48-f7bd3995f1d0",
                                "text": "Для этого необходимо, наверное, очень длительное время, поскольку это процесс, а не одномоментное явление."
                            }
                        ]
                    },
                    {
                        "sense_id": "be9a2803-1fba-3f7d-9bbd-2ec4b2836daf",
                        "entry_id": "5cb85c73-1894-3883-a42e-c88435f93778",
                        "glosses": [
                            "(в сопротивлении материалов) решаемый со сведением системы к одному моменту и силовым нагрузкам (о задаче, теории)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b70da07f-3be4-4081-9560-62587ec357ee",
                        "source_entry_id": "5cb85c73-1894-3883-a42e-c88435f93778",
                        "target_lang_word": "one-time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                        "entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                                        "glosses": [
                                            "Of or pertaining to a specific period of time in the past, not extending to the present."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9041d2b0-da49-4483-936a-ac2ee83dca20",
                                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                                "text": "He was the one-time president of the club."
                                            },
                                            {
                                                "example_id": "dc6dde85-ee64-461e-b335-867118ce50b6",
                                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                                "text": "His one-time investment in a brickyard had put the idea into his head—an idea that he decided was a good one, for it enabled him to suggest that she ride along with him to inspect the quarry."
                                            },
                                            {
                                                "example_id": "7b093a76-38f5-4387-a261-4ca7c66f263f",
                                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                                "text": "Pollyanna never doubted now that John Pendleton was her Aunt Polly's one-time lover; […]"
                                            },
                                            {
                                                "example_id": "6b208f16-44eb-4848-ba05-6198806b2a1e",
                                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                                "text": "The old Ramsgate Harbour station of the one-time South Eastern Railway was a case in point, as also the stations in the Isle of Wight that you name, such as Ventnor West."
                                            },
                                            {
                                                "example_id": "1f2cf204-74b6-46ca-beb5-55dd2db52741",
                                                "sense_id": "4af4f5de-95c0-3b7f-abf6-bae1b29c033e",
                                                "text": "Has the one-time wonder fuel become the new asbestos – not to say mustard gas?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                        "entry_id": "3a02b3b6-72b8-3f20-a2b5-c5b20277796f",
                                        "glosses": [
                                            "Occurring or used in a single instance and then never again."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "facca33e-a539-4f56-b556-a8fba7358818",
                                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                                "text": "one-time charge/payment"
                                            },
                                            {
                                                "example_id": "1de858ab-de8b-4b90-95eb-ace5f228709a",
                                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                                "text": "He was an eloquent speaker, and his slip of the tongue was a one-time error."
                                            },
                                            {
                                                "example_id": "25919889-58e3-4081-b9b2-1dd18263df57",
                                                "sense_id": "356dfbae-3068-3779-bfe4-dd8a664d63e1",
                                                "text": "Even if an attacker manages to intercept a one-time password, that password has already been used and is no longer usable to authenticate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "one-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15247f97-4bcc-3b29-bfc2-74a64c26eff4",
                                        "entry_id": "74819eea-f9fc-377b-b230-98b4b9d670b6",
                                        "glosses": [
                                            "To shoot (the ball or puck) directly from a teammate's pass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef572727-d22e-4baf-898c-bf36134894b0",
                                                "sense_id": "15247f97-4bcc-3b29-bfc2-74a64c26eff4",
                                                "text": "Basel's good moment continued, and in stoppage time of the first half, Streller released Salah with a clever pass down the middle and the young Egyptian one-timed the ball over Čech."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "one-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "351712fe-1b14-3363-b9ca-9ad17673c61a",
                                        "entry_id": "08bcacb7-195f-3b2f-8a4d-b487bb664990",
                                        "glosses": [
                                            "The police."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18301596-c243-4396-ab93-445991472930",
                                                "sense_id": "351712fe-1b14-3363-b9ca-9ad17673c61a",
                                                "text": "Ayo, it's Hell on Earth\nWhose necks are gonna be first?\nThe projects is front line\nAnd the enemy is one-time\nI ain't gotta tell you\nIt's right in front of your eyes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f171d1b-79c3-40ed-8530-b9a63c06ee5a",
                        "source_entry_id": "5cb85c73-1894-3883-a42e-c88435f93778",
