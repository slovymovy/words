                "senses": [
                    {
                        "sense_id": "8f55df1e-b1ae-34ec-a7df-4316d4d5d64f",
                        "entry_id": "341b3fbc-2d59-33ec-abc5-6e66680fa6a0",
                        "glosses": [
                            "Avancer en faisant des mouvements ondulatoires comme un marsouin ; peut s’utiliser aussi pour une embarcation à moteur rapide (ce qui résulte en général d’un réglage incorrect de inclinaison de l’axe du moteur hors bord par rapport à la quille ou d’un défaut de répartition de la charge en longitudinal)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05450b7b-e7f6-3ee8-ad30-e9832a1225c0",
                        "entry_id": "341b3fbc-2d59-33ec-abc5-6e66680fa6a0",
                        "glosses": [
                            "Se déplacer en mer tel un marsouin en accélérant sous la surface puis en se projetant vigoureusement hors de l'eau pour bénéficier de la plus faible résistance de l'air avant de replonger et ainsi avancer plus vite tout en économisant de l'énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98145b7a-6392-4bb4-8c41-6c6409c41913",
                                "sense_id": "05450b7b-e7f6-3ee8-ad30-e9832a1225c0",
                                "text": "Les manchots papous marsouinent au large de îles Malouines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa6b7b5b-b024-4390-bb97-3783d7ffb0c4",
                        "source_entry_id": "341b3fbc-2d59-33ec-abc5-6e66680fa6a0",
                        "target_lang_word": "porpoise",
                        "target_lang_code": "en",
