    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                "word": "stickman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "92cbb058-02cf-467c-b239-1ee5c490ad6a",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "tags": [
                            "plural"
                        ],
                        "form": "stickmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eec2716a-d819-3ecd-9fa8-fc5a5466da64",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A simple drawing of a man with lines to represent limbs and torso."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce7a13d1-978e-32b4-8017-c0caee9eca61",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A dealer in gambling who gathers the dice with a stick."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22aa70fd-95a1-4aeb-9d7d-854d6608b930",
                                "sense_id": "ce7a13d1-978e-32b4-8017-c0caee9eca61",
                                "text": "Then, when it was his turn to shoot, he reached out with a completely empty hand and caught the dice the stickman threw to him."
                            },
                            {
                                "example_id": "57f28d5d-2cda-4d7f-b0e3-7f46f64090a6",
                                "sense_id": "ce7a13d1-978e-32b4-8017-c0caee9eca61",
                                "text": "The most reliable stickman on the floor, Jimmy McGuire, was running the table. Data could hear his silky tenor before he could see the player due to the dense ring of spectators around the pit."
                            }
                        ]
                    },
                    {
                        "sense_id": "af600099-070d-330b-a855-a84a51154ed8",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A player in a game played with a stick (such as hockey or lacrosse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6412d351-fdc2-468f-ace2-cc9f4ce83dff",
                                "sense_id": "af600099-070d-330b-a855-a84a51154ed8",
                                "text": "With defeats only at the hands of two club teams, the Crescents and the Mount Washington Club, the Orange and Black stickmen have an otherwise unbroken record of victories over Yale, Harvard, Swarthmore, Stevens, Rutgers, and New York University."
                            },
                            {
                                "example_id": "cdc1daf3-fa2d-43b6-bf5a-7d93e44601c9",
                                "sense_id": "af600099-070d-330b-a855-a84a51154ed8",
                                "text": "Because they have carried the puck so often and for so many miles, centers are usually the most experienced stickmen, and their talents are necessary to win a face-off."
                            },
                            {
                                "example_id": "ae114806-4b49-4124-a61c-93d66f67eb2d",
                                "sense_id": "af600099-070d-330b-a855-a84a51154ed8",
                                "text": "In an era when slashing was tolerated more than it is in contemporary hockey, Ed Van Impe was one of the most feared stickmen in the NHL."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf47602f-d63e-3785-8dbf-735e679681a4",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A person who makes confectionery by pulling candy onto a stick."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "d530cbe5-08a2-4b38-b507-9b52b8e8fad2",
                                "sense_id": "bf47602f-d63e-3785-8dbf-735e679681a4",
                                "text": "Stick candy is made by a stick puller or stickman, who pulls the hard candy after it has been boiled; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a437b390-2bcb-3b80-95e5-f63c384e817e",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A pickpocket's accomplice who takes the stolen goods in case the pickpocket is searched."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4e94e3e9-3f40-4497-af34-e5c36c71dde0",
                                "sense_id": "a437b390-2bcb-3b80-95e5-f63c384e817e",
                                "text": "In some cases, when the property is taken from the drunken man, one of the women on some pretext steps to the door and passes it to the “stickman” standing outside, who then makes off with it."
                            },
                            {
                                "example_id": "1649ce0e-fdbc-405b-8e78-f8150479ab9c",
                                "sense_id": "a437b390-2bcb-3b80-95e5-f63c384e817e",
                                "text": "It is doubtful if the Victorian Londoner needed any warning, for the artful mobsmen, toolers, whizzers and dippers, together with their stickman accomplices, were everywhere in the crowds, in the underground, on railway trains […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a54a4af6-4ba5-3e6f-8f23-b60f15bbbe47",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A stick seller, especially of walking sticks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff61f2b3-4819-4707-af64-b7d80b323873",
                                "sense_id": "a54a4af6-4ba5-3e6f-8f23-b60f15bbbe47",
                                "text": "There’s only one stick-man in the streets, as far as I know, I think—that has what you may call a capital in sticks. Only the other day I saw him sell a registered stick near Charing-cross."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f852424-eb69-397c-81b1-653db7dd17bb",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A cocksman."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "483248f0-dd46-357d-822f-f87efff45a4b",
                        "entry_id": "502ffaa2-472b-3941-812d-c25365e84995",
                        "glosses": [
                            "A drummer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8af10c-5f0d-4f87-b85f-3a830cf8da17",
                                "sense_id": "483248f0-dd46-357d-822f-f87efff45a4b",
                                "text": "Our second stickman was much more behind the scenes. Earl Young was the in-house drummer at Philadelphia Records."
                            }
                        ]
                    }
                ],
