                ],
                "senses": [
                    {
                        "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                        "entry_id": "81e2f344-62b0-3253-bc2f-f70eb12dbd91",
                        "glosses": [
                            "Spielgerät, mit dem sich Kinder in Schonräumen fortbewegen und das Verkehren lernen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3807bbd0-76d9-40d3-ace3-99086ca2bf01",
                                "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                                "text": "„Befasst sich das Kleinkind überwiegend mit Miniaturmodellen und Miniaturmodellsituationen (Spielautos, Spieleisenbahnen), so beansprucht das heranwachsende Kind zunehmend Fahrzeuge (Roller, Dreirad, Tretauto etc.), die als Spielfahrzeuge einsetzbar sind.“"
                            },
                            {
                                "example_id": "b4f2efe4-8fae-4688-8b9b-960e8318e77a",
                                "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                                "text": "„Erika Müller, Leiterin der Kita, und ihre Kollegen hatten beschlossen, das Geld in Spielfahrzeuge für die 178 zu betreuenden Kinder zu investieren.“"
                            },
                            {
                                "example_id": "aea142b4-63c6-4124-8535-b8723291caf2",
                                "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                                "text": "„Besonders beliebt waren die sogenannten Spielfahrzeuge.“"
                            },
                            {
                                "example_id": "42fa5573-14c0-40b4-9478-57cc11532a45",
                                "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                                "text": "„Die Firma Brandstätter stellte Anfang der siebziger Jahre unter anderem große Spielfahrzeuge her, doch angesichts der damaligen Ölkrise wurde das viel zu teuer.“"
                            },
                            {
                                "example_id": "a556d520-fd0d-40a6-b725-6f9d3188ca22",
                                "sense_id": "7d225272-395a-3a4e-8f5d-0d1cfe6fd891",
                                "text": "„Die Angebotspalette reicht heute von Fitnessgeräten über Fahrräder und Spielfahrzeuge bis zu Freizeit- und Gartenmöbeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
