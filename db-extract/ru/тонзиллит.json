                                    {
                                        "sense_id": "9339e418-4313-38fc-99de-af5538f1ed96",
                                        "entry_id": "597208e8-c25c-3d60-9639-c135c84225ee",
                                        "glosses": [
                                            "eine schmerzhafte Entzündung der Tonsillen, Kurzform für die Entzündung der Gaumenmandeln (Tonsillae palatinae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3101963c-788f-4dfb-a498-d7fa3c99ec16",
                                                "sense_id": "9339e418-4313-38fc-99de-af5538f1ed96",
                                                "text": "Die Tonsillitis wird meistens durch Bakterien, weniger häufig durch Viren ausgelöst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82e31cfd-8a78-49c3-90ad-8ddc519023d2",
                        "source_entry_id": "6350a1b8-5342-34e3-89c4-a83789c003bc",
                        "source_sense_id": "5bf08c61-8b41-329b-b209-9af2f1c3a6be",
                        "target_lang_word": "Mandelentzündung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandelentzündung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7fde73-69d6-3dea-9a59-799e020540dd",
                                        "entry_id": "d84f5f4d-78fb-3abc-801f-2790fc6d81b6",
                                        "glosses": [
                                            "ansteckende, schmerzhafte Entzündung der Tonsillen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a95295-d93a-444e-b7d7-bea7619d7360",
                                                "sense_id": "fe7fde73-69d6-3dea-9a59-799e020540dd",
                                                "text": "„Er erinnerte sich, wie Maja, seine eigene Fünfjährige, als Baby eine Mandelentzündung gehabt hatte.“"
                                            },
                                            {
                                                "example_id": "d3c92124-62d8-4dcf-b3ff-33c3ee62a8b1",
                                                "sense_id": "fe7fde73-69d6-3dea-9a59-799e020540dd",
                                                "text": "„Kinder leiden übrigens wesentlich häufiger unter Mandelentzündung als Erwachsene […].“"
                                            },
                                            {
                                                "example_id": "d1d99672-22e0-43b7-92c8-bfa6c34c3afc",
                                                "sense_id": "fe7fde73-69d6-3dea-9a59-799e020540dd",
                                                "text": "„Ein Arztbesuch ist meist erst notwendig, wenn die Beschwerden nach zwei bis drei Tagen nicht deutlich nachlassen und womöglich der Verdacht auf eine Mandelentzündung besteht.“"
                                            },
                                            {
                                                "example_id": "938c50d5-d37e-44ba-8c0e-fa90e584bdc2",
                                                "sense_id": "fe7fde73-69d6-3dea-9a59-799e020540dd",
                                                "text": "„Es war der dritte Tag in Folge, dass sie wegen ihrer Mandelentzündung nicht zur Schule konnte, und Amalia hatte mich vorsorglich auch zu Hause behalten, obwohl ich nur einen Schnupfen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
