                "forms": [],
                "senses": [
                    {
                        "sense_id": "978c7c8c-82ba-3355-a46c-ebe8c2150412",
                        "entry_id": "611c14fe-5ce9-36c0-8b74-370c63d4a236",
                        "glosses": [
                            "наречие к неясный; трудно различимо плохо видно и т. п."
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "4ab47cbf-55cb-49d0-8d53-507a59f6d0b7",
                                "sense_id": "978c7c8c-82ba-3355-a46c-ebe8c2150412",
                                "text": "Что-то вроде конспекта с неясно очерченными фигурами и мотивами."
                            }
                        ]
                    },
                    {
                        "sense_id": "333ca9d4-406e-31ed-a9a2-f02cefe77037",
                        "entry_id": "611c14fe-5ce9-36c0-8b74-370c63d4a236",
                        "glosses": [
                            "безл. нет чёткого представления о чём-либо, понимания чего-либо"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "ada1da71-6e1d-436a-8a9d-b36a84fc9d44",
                                "sense_id": "333ca9d4-406e-31ed-a9a2-f02cefe77037",
                                "text": "Но как этого добиться, неясно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aebcdf6f-717b-403d-8635-aacc44feebb1",
                        "source_entry_id": "611c14fe-5ce9-36c0-8b74-370c63d4a236",
                        "source_sense_description": "наречие",
                        "target_lang_word": "unclearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unclearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36b9c313-ec8e-3dd1-97ee-a6aa6ae2837c",
                                        "entry_id": "506896fe-c3da-302c-9297-604afbb24c30",
                                        "glosses": [
                                            "In an unclear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6697f7e3-acbd-4f81-914d-461087abf241",
                                                "sense_id": "36b9c313-ec8e-3dd1-97ee-a6aa6ae2837c",
                                                "text": "In such circumstances the liquor, the haste, or the gauze may make me see the woman's face unclearly, her features unclearly, or her skin unclearly; but they do not make me see her fineness of features unclearly, the clearness of her skin unclearly, or the freshness of her face unclearly, when what is meant is that her features are not very fine, her face not very fresh, or her skin not very clear. What these circumstances do is to give me something like illusions, not unclear perceptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7d860ab-2e64-43fb-a8fd-6f8926d536ee",
                        "source_entry_id": "611c14fe-5ce9-36c0-8b74-370c63d4a236",
                        "source_sense_description": "наречие",
                        "target_lang_word": "vaguely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
