                "senses": [
                    {
                        "sense_id": "5a070dd9-bd04-32c9-9dfc-3be5ab011454",
                        "entry_id": "0c47a3b1-090c-3a3b-b548-669bd4c3fbc9",
                        "glosses": [
                            "Donner à quelque chose une nature de phénomène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bc41ac-db2a-43df-b982-595e0b5c7ed7",
                                "sense_id": "5a070dd9-bd04-32c9-9dfc-3be5ab011454",
                                "text": "A tel point que l'on pouvait douter que la phénoménologie puisse penser l'infini comme tel, sans aussitôt le «phénoménaliser», c'est-à-dire le «finitiser» ou l'«indéfiniser»."
                            },
                            {
                                "example_id": "bd489af1-cefa-49c6-b9bb-27f628738c0c",
                                "sense_id": "5a070dd9-bd04-32c9-9dfc-3be5ab011454",
                                "text": "Le corps n'est pas une chose du monde, il est en son centre, il concentre en lui la Facticité que son sentir vient phénoménaliser en monde."
                            }
                        ]
                    }
                ],
