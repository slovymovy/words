                        "examples": [
                            {
                                "example_id": "0cd12a26-afc7-4d47-a4c8-273c12f9d3db",
                                "sense_id": "3b790178-320d-357a-8429-962964756e4f",
                                "text": "De drie mannen, alle drie in het zwart gekleed en met een muts dan wel pantykous over het gezicht, hadden om geld gevraagd. Daarna werd de man mishandeld."
                            },
                            {
                                "example_id": "65841634-a3ee-4867-8e10-5e8e7ce0fb12",
                                "sense_id": "3b790178-320d-357a-8429-962964756e4f",
                                "text": "Het Openbaar Ministerie (OM) heeft eerder laten weten dat het een behoorlijk aantal aanwijzingen heeft die wijzen op de betrokkenheid van Van U. bij de dood van Borst. Zo is een haar op de jas van Borst hoogstwaarschijnlijk afkomstig van de verwarde Van U., net als een DNA-spoor op haar pantykous."
                            },
                            {
                                "example_id": "389f30a8-7d14-4aa9-a8ae-97891938fe78",
                                "sense_id": "3b790178-320d-357a-8429-962964756e4f",
                                "text": "Ergens in een warenhuis op de afdeling beenmode draalt een man. „Heeft u ook pantykousen?” „Ja hoor meneer, welke maat heeft u nodig?”"
                            }
                        ]
                    }
