                        "entry_id": "e893e10d-b5d6-3f8d-bcb3-7e3079b2d35c",
                        "glosses": [
                            "umiejętność wykrywania nowych faktów oraz znajdywania związków między faktami, zwłaszcza z wykorzystaniem hipotez"
                        ],
