                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea762b0d-991f-356e-a45d-4db20dddc0d5",
                                        "entry_id": "194b3436-9dc6-39df-9e96-942e2d24c4d8",
                                        "glosses": [
                                            "Articles used in charging firearms and ordnance of all kinds; as powder, balls, shot, shells, percussion caps, rockets, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b729985-91c8-4e82-9444-84d2f4ee85e3",
                                                "sense_id": "ea762b0d-991f-356e-a45d-4db20dddc0d5",
                                                "text": "Hiro risks turning on a small flashlight, uses it to rummage around the yatcht, picking up valuable stuff: a few bottles of (presumably) drinkable water, some food, extra ammunition for his nine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fdf4c9-06e8-3111-8a96-23d1b1f23bfa",
                                        "entry_id": "194b3436-9dc6-39df-9e96-942e2d24c4d8",
                                        "glosses": [
                                            "Military stores, or provisions of all kinds for attack or defense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a1a556-cac0-457c-a345-f949c56a9c19",
                                                "sense_id": "a7fdf4c9-06e8-3111-8a96-23d1b1f23bfa",
                                                "text": "ammunition bread"
                                            },
                                            {
                                                "example_id": "092fc593-0989-4abf-8a15-c6e2be419825",
                                                "sense_id": "a7fdf4c9-06e8-3111-8a96-23d1b1f23bfa",
                                                "text": "ammunition shoes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                        "entry_id": "194b3436-9dc6-39df-9e96-942e2d24c4d8",
                                        "glosses": [
                                            "Arguments and information that can be used against the other party in a conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14aa6cd-a332-4044-9f0e-ee8235d139d5",
                                                "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                                "text": "They say that the booklet gives them ammunition which is proving effective in breaking down resistance against home building which was created by false propaganda."
                                            },
                                            {
                                                "example_id": "b7078cbf-8cd2-4cea-9ae0-c42af3ddc405",
                                                "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                                "text": "As long as the integration fight is in progress, some Southerners are willing to believe anything if it gives them ammunition in their fight to \"retain our traditional way of life.\" If you have any wise bits of philosophy, please pass them along."
                                            },
                                            {
                                                "example_id": "e6eb04aa-c2db-4e00-85c3-787095d74063",
                                                "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                                "text": "Providing your administrator(s) with evidence of research progress gives them ammunition to request additional funds from the site-based management pool."
                                            },
                                            {
                                                "example_id": "0b51c447-e6e4-4726-95cf-91dd81af51c7",
                                                "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                                "text": "The first thing to do is NOT constantly defend and argue with the ex or the children. It gives them ammunition and fuels their engines to come after you. In addition, you are just giving them more to use against you."
                                            },
                                            {
                                                "example_id": "7fb82386-2f6c-4c23-8773-bcd408524d32",
                                                "sense_id": "829effac-d15d-377f-9f03-f790eedd2e54",
                                                "text": "However, preventing a vote from taking place could give ammunition to the SNP, which argues that Scotland’s view carries little weight in the union."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ammunition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bea66f-c336-3e5b-aca9-baf307b2d5a6",
