                ],
                "senses": [
                    {
                        "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                        "entry_id": "fe18fc6a-3dad-39c6-9290-8f5392ffb75f",
                        "glosses": [
                            "segmentiertes Rohrformstück, dass nach bestimmten, meist standardisierten Maßen gekrümmt ist; Hohlkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33752ccd-f64b-476b-a174-bf2d4d08a996",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "„Mit der Maschine BRP-3-180/KATLA werden Segmentrohrbögen aus zwei oder mehreren unter einem Winkel zusammengefügten Rohrsegmenten schrittweise hergestellt / geschweißt.“"
                            },
                            {
                                "example_id": "c04c1cd7-78d1-4acb-9efb-d818bf381f53",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "„Gemäß der VDI-Richtlinie 2263 und unter Berücksichtigung des AD-Merkblattes S4 wurde aufgrund einer Spannungsanalyse mit dem Finite-Element-Programm ANSYS der Nachweis geführt, daß der Segementrohrbogen [sic!] DN700 […] mit einer Wandstärke von 3 mm explosionsdruckstoßfest bis 3,1 bar (ü) ist, sofern die angeschlossenen Rohrleitungen an einer Seite über ein Festlager dicht an der Flanschverbindung verfügen.“"
                            },
                            {
                                "example_id": "d1f1c4cf-9927-410a-ad0b-4e182a9d83ae",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "„Segmentrohrbogen aus geschleudertem glasfaserverstärktem Polyesterharz (UP-GF) passend zum Rohrsystem der Pos........ , liefern zur Verwendungsstelle transportieren und unter Beachtung der Verlegevorschriften des Herstellers ordnungsgemäß einbauen.“"
                            },
                            {
                                "example_id": "e642adf6-25e7-4466-a8eb-d22f97e7c1be",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "„Aus dem DE 86 24 053 U1 ist bereits ein Dreieckwerbeträger bekannt, der aus drei rechteckigen Werbeträgerrahmen, einem Segmentrohrbogen und einem Werbeträgermast mit einer am obe ren Ende angebrachten Keilverbindung besteht.“"
                            },
                            {
                                "example_id": "a847637f-c2fc-466d-8fd4-c74382930707",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "Die normgerechte Herstellung von Segmentrohrbogen erfolgt nach ANSI, DIN 2605 und DIN 2458 da es sich hierbei um nahtlose oder geschweißte Bogen mit Sonderradien handelt."
                            },
                            {
                                "example_id": "d096e6bb-1ad1-44b1-8e9b-fad9ad05b6d5",
                                "sense_id": "e4f0d384-df52-352b-9877-ae04202f7f91",
                                "text": "Die einzelnen Segmente zu einen Segmentrohrbogen können auch aus einem Plattenmaterial gefertigt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
