                "senses": [
                    {
                        "sense_id": "1d0afc19-f8f5-3741-b739-c3b480d90894",
                        "entry_id": "f349898e-9f4a-3e5a-98d6-b2e4bbebbc09",
                        "glosses": [
                            "Logiciel permettant de lire les nouvelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cdaf76c-f5bb-47ff-a013-297d16cadb63",
                                "sense_id": "1d0afc19-f8f5-3741-b739-c3b480d90894",
                                "text": "Ces géants du Web, comme Facebook et Google, laissent aussi libre cours aux agrégateurs de contenu auxquels Internet a donné naissance."
                            },
                            {
                                "example_id": "b837810d-e13a-4f8d-8f67-17adef235791",
                                "sense_id": "1d0afc19-f8f5-3741-b739-c3b480d90894",
                                "text": "Les appels au secours à Trump et à l’extrême droite américaine par Danielle Smith peuvent peut-être aider Poilievre en Alberta et en Saskatchewan, mais vont lui nuire dans le reste du Canada où les libéraux dominent déjà, font des gains considérables, selon l’agrégateur «QC 125 Canada», et sont en voie de s’assurer une majorité absolue."
                            }
                        ]
                    },
                    {
                        "sense_id": "eba2c8f2-ccd3-3966-af0e-826a45fba8b4",
                        "entry_id": "f349898e-9f4a-3e5a-98d6-b2e4bbebbc09",
                        "glosses": [
                            "Logiciel permettant de regrouper des services concurrents au même endroit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "de0348be-6802-35b4-abe3-8652b8490e4b",
                        "entry_id": "f349898e-9f4a-3e5a-98d6-b2e4bbebbc09",
                        "glosses": [
                            "Logiciel de services bancaires permettant de rassembler sous une seule application tous les comptes d’un utilisateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aceb9f68-7ad0-4777-8371-544d0da10f41",
                                "sense_id": "de0348be-6802-35b4-abe3-8652b8490e4b",
                                "text": "Les personnes qui détiennent des comptes bancaires et d’épargne dans différents établissements le constatent : il est très difficile d’avoir une idée à un instant T de sa situation financière globale… Pour régler ce problème, il existe désormais des solutions séduisantes : les agrégateurs de comptes."
                            }
                        ]
                    },
                    {
                        "sense_id": "62879bc5-d781-3c2f-b2e7-8823564eadef",
                        "entry_id": "f349898e-9f4a-3e5a-98d6-b2e4bbebbc09",
                        "glosses": [
                            "Acteur d’une agrégation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab1faee-e0ff-4cea-83d2-157f018fb108",
                                "sense_id": "62879bc5-d781-3c2f-b2e7-8823564eadef",
                                "text": "Les entreprises agroalimentaires sous contrat avec des agriculteurs sont des agrégateurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ecfb65f-23b0-441b-b7af-15c69fc42a79",
                        "source_entry_id": "f349898e-9f4a-3e5a-98d6-b2e4bbebbc09",
