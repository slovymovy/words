                ],
                "senses": [
                    {
                        "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                        "entry_id": "4c9a4a1a-729f-35cc-b896-8a7d48113bcb",
                        "glosses": [
                            "meist kurzer Schlaf nach dem Mittagessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f02fea-3600-4902-8293-283c4a4a2606",
                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                "text": "Nach seinem Mittagsschlaf fühlte er sich wieder fit."
                            },
                            {
                                "example_id": "182c635f-f563-4b98-af93-2a655e945fde",
                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                "text": "„Wenn Oma und Opa Mittagsschlaf machten, liefen Volker und ich in den Garten, um zu schaukeln und im Sandkasten Burgen zu bauen.“"
                            },
                            {
                                "example_id": "8b7ca00e-9193-4ba8-8bc6-66b0f723f96f",
                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                "text": "„Zu dieser Stunde ging sie nie einkaufen, sondern hielt ihren Mittagsschlaf.“"
                            },
                            {
                                "example_id": "d74d59f6-3a24-44f9-bb8f-1acbccaede30",
                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                "text": "„Danach mussten wir uns zum Mittagsschlaf auf Feldbetten niederlassen und schweigen.“"
                            },
                            {
                                "example_id": "dbd67694-f660-4cef-977d-9ceb11066e90",
                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                "text": "„Der Graf, der den gewohnten Mittagsschlaf sehr entbehrte, breitete die Karten fächerförmig aus und lachte über alles.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "662939c2-7e0a-4c51-8c9e-46dfec010cff",
                        "source_entry_id": "4c9a4a1a-729f-35cc-b896-8a7d48113bcb",
                        "source_sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
