                },
                {
                    "sense_id": "056768f4-5de2-3eea-9176-0640111378ab",
                    "sense_definition": "Spicy, pungent, or piquant, as some chili peppers and other spices are.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This kind of chili pepper is way too <w>hot</w> for my taste.",
                            "target_lang_translations": {
                                "ru": "Этот сорт перца чили слишком <w>острый</w> на мой вкус."
                            }
                        },
                        {
                            "text": "I love <w>hot</w> food, so please add extra spice to my curry.",
                            "target_lang_translations": {
                                "ru": "Я люблю <w>острую</w> пищу, поэтому, пожалуйста, добавь побольше специй в мой карри."
                            }
                        }
                    ],
                    "synonyms": [
                        "spicy",
                        "pungent",
                        "piquant"
                    ],
                    "antonyms": [
                        "mild",
                        "bland"
                    ],
                    "common_phrases": [
                        "hot sauce",
                        "hot pepper",
                        "hot curry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый, едкий или пикантный, как некоторые виды перца чили и другие специи."
