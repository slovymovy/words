                ],
                "senses": [
                    {
                        "sense_id": "9bff7da2-7f20-3fb8-b45f-adb01eae309a",
                        "entry_id": "173e1ad2-ffff-36bf-8990-df8e7fee3b52",
                        "glosses": [
                            "Relatif au peuple et à la culture des Innus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c539ffb-d7ee-4316-b747-2a8bde4b05c2",
                                "sense_id": "9bff7da2-7f20-3fb8-b45f-adb01eae309a",
                                "text": "Les communautés innues de la Côte-Nord."
                            },
                            {
                                "example_id": "46a747ae-1d0d-4eeb-b762-9fac80051f07",
                                "sense_id": "9bff7da2-7f20-3fb8-b45f-adb01eae309a",
                                "text": "Pendant ce temps, la réserve innue de Pakua Shippu, sur la rive nord de la rivière Saint-Augustin, sur la Basse-Côte-Nord, a pour la première fois élu une femme, Mary Mark, comme chef de bande."
                            },
                            {
                                "example_id": "6758c853-6788-43d8-beb4-568cc5611109",
                                "sense_id": "9bff7da2-7f20-3fb8-b45f-adb01eae309a",
                                "text": "La Nation innue est, dans les faits, constituée de plusieurs Premières Nations (neuf au Québec et deux au Labrador) occupant un large territoire, que nous nommons « Nitassinan » dans notre langue, lequel se situe au nord du St-Laurent, du lac St-Jean en passant par Schefferville et Sept-Îles jusqu’à la Basse Côte-Nord et au Labrador."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "ddf33378-4906-493e-be8b-f3baf5e6834d",
                        "source_entry_id": "173e1ad2-ffff-36bf-8990-df8e7fee3b52",
