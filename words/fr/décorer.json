                    "frequency": "High",
                    "semantic_group_id": "ornement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille se réunit chaque hiver pour <w>décorer</w> le sapin de Noël dans le salon."
                        },
                        {
                            "text": "Les enfants adorent <w>décorer</w> leur chambre avec de jolis dessins colorés."
                        }
                    ],
                    "common_phrases": [
                        "décorer le sapin",
                        "décorer la maison",
                        "décorer une pièce"
                    ]
                },
                {
                    "sense_id": "8a258add-9d2f-3ccb-b363-ac881deb3f3b",
                    "sense_definition": "Conférer une distinction honorifique, une médaille ou un titre à une personne pour ses mérites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a choisi de <w>décorer</w> ce médecin pour son dévouement exceptionnel pendant la crise."
                        },
                        {
                            "text": "Le courageux soldat a été <w>décoré</w> de la médaille militaire lors d'une cérémonie officielle."
                        }
                    ],
                    "common_phrases": [
                        "décorer de la médaille"
                    ]
                },
                {
                    "sense_id": "07890a70-557c-36d3-bbfe-1b31d80b9450",
                    "sense_definition": "Parer une réalité ordinaire ou médiocre de qualificatifs avantageux ou pompeux.",
