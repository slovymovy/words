{
    "word_family": [
        "heister"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f86e5ad0-315e-334e-ac8a-85dfb779b814",
                    "sense_definition": "A robbery or burglary, especially from an institution such as a bank or museum.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating a daring <w>heist</w> at the city bank.",
                            "target_lang_translations": {
                                "de": "Die Polizei untersucht einen dreisten <w>Raubüberfall</w> auf die Stadtbank."
                            }
                        },
                        {
                            "text": "Security was increased after the museum <w>heist</w> made headlines.",
                            "target_lang_translations": {
                                "de": "Die Sicherheitsvorkehrungen wurden erhöht, nachdem der <w>Raub</w> im Museum Schlagzeilen machte."
                            }
                        }
                    ],
                    "synonyms": [
                        "robbery",
                        "burglary",
                        "theft"
                    ],
                    "common_phrases": [
                        "bank heist",
                        "daring heist"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Raub oder Einbruch, insbesondere bei einer Institution wie einer Bank oder einem Museum."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Raub",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für gewaltsame Wegnahme."
                            },
                            {
                                "target_lang_word": "Einbruch",
                                "target_lang_sense_clarification": "Eindringen in ein Gebäude mit krimineller Absicht."
                            },
                            {
                                "target_lang_word": "Raubüberfall",
                                "target_lang_sense_clarification": "Ein Überfall, bei dem Eigentum gewaltsam entwendet wird."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d183becc-6004-3fed-8201-14990cac17c3",
                    "sense_definition": "A fiction genre in which a heist is central to the plot; a work in such a genre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director is famous for his fast-paced <w>heist</w> movies.",
                            "target_lang_translations": {
                                "de": "Der Regisseur ist berühmt für seine rasanten <w>Heist-Filme</w>."
                            }
                        },
                        {
                            "text": "This novel is a classic example of the <w>heist</w> genre.",
                            "target_lang_translations": {
                                "de": "Dieser Roman ist ein klassisches Beispiel für das <w>Raubfilm-Genre</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heist movie",
                        "heist film"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Genre, in dem ein Raubüberfall im Mittelpunkt der Handlung steht; ein Werk in diesem Genre."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Heist-Film",
                                "target_lang_sense_clarification": "Filmgenre, das sich auf die Planung und Durchführung eines Raubes konzentriert."
                            },
                            {
                                "target_lang_word": "Raubfilm",
                                "target_lang_sense_clarification": "Gebräuchliche Bezeichnung für Filme über Raubüberfälle."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94ea5028-4f94-357c-9f52-a3cb60bfac5c",
                    "sense_definition": "To steal, rob, or hold up (something).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminals planned to <w>heist</w> the jewelry store at midnight.",
                            "target_lang_translations": {
                                "de": "Die Kriminellen planten, das Juweliergeschäft um Mitternacht zu <w>überfallen</w>."
                            }
                        },
                        {
                            "text": "They tried to <w>heist</w> the armored truck during the delivery.",
                            "target_lang_translations": {
                                "de": "Sie versuchten, den Geldtransporter während der Lieferung zu <w>rauben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rob",
                        "steal"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in informal contexts regarding criminal activity."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas stehlen, rauben oder überfallen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rauben",
                                "target_lang_sense_clarification": "Sich etwas gewaltsam aneignen."
                            },
                            {
                                "target_lang_word": "ausrauben",
                                "target_lang_sense_clarification": "Einen Ort oder eine Person vollständig ausrauben."
                            },
                            {
                                "target_lang_word": "stehlen",
                                "target_lang_sense_clarification": "Etwas ohne Einverständnis des Besitzers wegnehmen."
                            }
                        ]
                    }
                }
            ]
        },
        {
