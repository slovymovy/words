                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b999502-4dc3-42a1-9e4f-a5c78830c8e0",
                                "sense_id": "68d9503c-3c67-3f05-9bc1-2b1a05899fa2",
                                "text": "There is not the least mystery about the meaning of the name of this river, the greenest vocabulist in the Algonquin tongue knows its meaning."
                            },
                            {
                                "example_id": "0113dee5-1f4e-4949-864a-6fd79c1e5a6b",
                                "sense_id": "68d9503c-3c67-3f05-9bc1-2b1a05899fa2",
                                "text": "Truth […] is easily discerned in the most floreate verbal fabric of the most prodigal vocabulist."
                            },
                            {
                                "example_id": "7c4e3c33-7c60-4c25-a028-da6852235728",
                                "sense_id": "68d9503c-3c67-3f05-9bc1-2b1a05899fa2",
                                "text": "Some words remain for me elusive and are probably jokes I’m not getting or neologisms of Wallace’s: contuded, hulpil, egregulous , ascapartic, gumlet. This is a virtuoso vocabulist at work, performing busily, somewhat aggressively demonstrating his skill."
                            }
                        ]
