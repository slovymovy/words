                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ecca5f-21da-4a78-b9f8-d06a1354aed9",
                                                "sense_id": "ad2c8b0c-4f8b-3c3b-97d6-77b833d29047",
                                                "text": "Orangenbäume können bei uns im Freien nicht überwintern."
                                            },
                                            {
                                                "example_id": "ec2f1015-9560-4c6a-8538-ecbbbc108182",
                                                "sense_id": "ad2c8b0c-4f8b-3c3b-97d6-77b833d29047",
                                                "text": "„Zudem gab es eine Orangerie, das heißt einen alten Glasanbau, in dem keine Orangenbäume, dafür aber ein paar tropische Topfpflanzen und ein Gartentisch mit Rattansesseln standen und natürlich Jeans Tomatenpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
