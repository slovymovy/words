        "fr-extract.jsonl": [
            {
                "entry_id": "10ab8c49-d611-30e2-aaf0-2428b955e34f",
                "word": "soue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f97ed783-5d17-41ce-af84-6375922ebf46",
                        "entry_id": "10ab8c49-d611-30e2-aaf0-2428b955e34f",
                        "tags": [
                            "plural"
                        ],
                        "form": "soues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                        "entry_id": "10ab8c49-d611-30e2-aaf0-2428b955e34f",
                        "glosses": [
                            "Abri dans lequel on élevait quelques porcs ; porcherie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6763c8e3-7a97-46a0-ad28-17df505b70bd",
                                "sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                                "text": "C’était pourtant un peu fort qu’on fût obligé de se serrer les tripes et même de crever de froid, à deux pas de ces paysans cossus dont on était venu garder la maison et qui n’avaient consenti à prêter une espèce de soue à cochons et quelques bottes de paille pour l’installation du poste, que sur l’ordre violent d’un officier qui n’avait pas exigé davantage."
                            },
                            {
                                "example_id": "486ce866-c5a2-4eb7-852d-7dc44b2f3d63",
                                "sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                                "text": "À l’odeur aussi, une odeur à faire vomir, on se serait cru dans une soue."
                            },
                            {
                                "example_id": "34aee6aa-b347-4a22-99c5-89053b35c1a7",
                                "sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                                "text": "Une fin d’après-midi, on passa devant la soue du cochon sans lui donner à manger. Il gueulait d’ailleurs comme à son habitude réclamant son dû."
                            },
                            {
                                "example_id": "2923d875-725f-4191-819b-356be44b944a",
                                "sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                                "text": "J'ai pas confiance en vous, misérables petits porcs. Aussitôt sortis de vos soues, vous avez plus rien dans le ventre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34f1519b-bf0b-4b42-84d0-b7f1c5cf9f97",
                        "source_entry_id": "10ab8c49-d611-30e2-aaf0-2428b955e34f",
                        "source_sense_id": "cb98b355-6372-3f88-9623-0a4c0582a175",
                        "target_lang_word": "Schweinestall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "Stall, in dem Hausschweine gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdad035-2258-491d-a042-a1a14e5437e1",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "Morgen wird der Schweinestall ausgemistet."
                                            },
                                            {
                                                "example_id": "d007560b-ebe8-42fb-941b-805e7be335a0",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Die Dondorfer Zinkwanne im ausgedienten Schweinestall vor Augen, prustete ich los.“"
                                            },
                                            {
                                                "example_id": "5abb44c0-231c-4ce3-97f5-5a468848098d",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Ein paar Kuh- und Schweineställe bildeten das Ganze dieser Hinterwäldler-Siedlung.“"
                                            },
                                            {
                                                "example_id": "8b8e6511-8ae8-4260-b382-9929bde2a5f7",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Er war ein Mannsbild und in der Faktorei ein Mädchen für alles und durfte im Schweinestall schlafen.“"
                                            },
                                            {
                                                "example_id": "3fb20b0b-18e5-4111-8b03-230c72a060f4",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Bald wurde der Schweinestall zu eng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "unordentlicher, schmutziger Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe1252-dd75-4b32-a6ea-4776e2da22e3",
                                                "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                                "text": "Wie kannst du in aller Ruhe in diesem Schweinestall sitzen und fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab5fc8f2-f23a-4f43-9171-975df7762f3b",
                        "source_entry_id": "10ab8c49-d611-30e2-aaf0-2428b955e34f",
