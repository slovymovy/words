                        "glosses": [
                            "een winst die groter is dan dat men ooit in het verleden heeft behaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba9959c0-7f29-4180-aeb4-4ae47d3e6834",
                                "sense_id": "295ec7ea-7535-3507-95bc-a1da13a7ca0d",
                                "text": "De iPhone levert Apple ook een luxeprobleem op. Het toestel doet het zo goed - het zorgt voor een recordwinst in 2014 van 18 miljard dollar - dat Apple er voor zijn succes grotendeels van afhankelijk wordt. De iPad en de Apple Watch, die na de iPhone worden aangekondigd, zijn ook successen, maar niks kan de iPhone evenaren."
                            },
                            {
                                "example_id": "565fe61d-7386-4abf-b7d4-c9c009a339ea",
                                "sense_id": "295ec7ea-7535-3507-95bc-a1da13a7ca0d",
                                "text": "Het debacle met de Galaxy Note 7 kostte Samsung miljarden. Niet alleen moest het bedrijf 2,5 miljoen telefoons terugroepen, het loopt ook omzet mis omdat er nog geen vervangend toestel is. Het bedrijf gaf vorig jaar een aantal winstwaarschuwingen. Desondanks boekte het bedrijf vorig kwartaal een recordwinst."
                            }
                        ]
                    }
