                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a178c3-188d-465f-ae95-22920001bbc0",
                                                "sense_id": "76a88a26-f666-32ba-9458-aa8c6970b2e8",
                                                "text": "Nach dem Polieren sieht die Münze wieder glänzend aus."
                                            },
                                            {
                                                "example_id": "a8959cd9-c11e-4361-9d7c-9e865ea3dec4",
                                                "sense_id": "76a88a26-f666-32ba-9458-aa8c6970b2e8",
                                                "text": "Wenn sie die matte Oberfläche mit diesem Mittel polieren, wird sie wieder glänzend."
                                            },
                                            {
                                                "example_id": "98bb4ae6-7adb-42a6-abff-32a5866b0cb4",
                                                "sense_id": "76a88a26-f666-32ba-9458-aa8c6970b2e8",
                                                "text": "Ihr glänzend schwarzes Haar fesselte meine Aufmerksamkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
