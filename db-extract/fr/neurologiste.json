                        "entry_id": "2d96825e-5f76-3045-96b8-c92ae039960c",
                        "glosses": [
                            "Médecin spécialiste en neurologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e0d61b-32ec-4f30-a3d4-d896daa7b634",
                                "sense_id": "27867f36-ce05-3781-9fb9-c719f1af455a",
                                "text": "Pour un neurologiste habitué à l’examen du tabès et de la sclérose latérale, les symptômes nets et insimulables étaient des modifications de l’état des muscles, des mouvements réflexes et à la rigueur des diverses sensibilités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab51bdac-6dc4-4ddf-8ca5-a1a4dcd0c3ea",
                        "source_entry_id": "2d96825e-5f76-3045-96b8-c92ae039960c",
                        "source_sense_id": "27867f36-ce05-3781-9fb9-c719f1af455a",
                        "source_sense_description": "Docteur en neurologie (1):",
                        "target_lang_word": "neurologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                        "entry_id": "95a26307-01b4-3538-b8b3-0e7bff6a219c",
                                        "glosses": [
                                            "A doctor or scientist who practices or specializes in neurology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d41657-ae7d-489d-9348-d1c4c9ebfd8d",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "When a neurologist ruled out medical causes like Lyme disease, Ms. Abaspour recalled, her husband said, “I think we should just give her a placebo — it’s all in her head.”"
                                            },
                                            {
                                                "example_id": "5cf1fd9f-e1d5-4bcc-b3c8-f860c8014f68",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "And most neurologists are in the habit of prescribing antispasticity drugs like tizanidine and baclofen, which are oral and inexpensive, but which cause drowsiness and weaken every muscle in the body, not just the target ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
