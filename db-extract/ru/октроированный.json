                        ],
                        "examples": [
                            {
                                "example_id": "89fd3fbc-3d18-437f-9e0a-5930ef5d763b",
                                "sense_id": "1f9a8ef9-53c3-3380-ba62-2fdc340d4967",
                                "text": "Он был противником и врагом Партий, насильственно вынужденных бунтом и революцией, но зато был другом октроированных конституций; и после недавних опытов, после стольких бедствий, претерпенных Европой, можно ли было думать иначе?"
                            }
                        ]
