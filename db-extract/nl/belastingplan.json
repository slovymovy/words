                        "examples": [
                            {
                                "example_id": "7b1cc30f-b4c3-4163-ad92-278c9be62669",
                                "sense_id": "c5e7f7bf-44b3-306e-b887-43d7fc74178d",
                                "text": "Het wordt gezien als een belangrijke ontwikkeling in de aanpak van bedrijven die relatief weinig belasting betalen: de regering van de Amerikaanse president Joe Biden heeft een voorstel ingediend voor een wereldwijd belastingplan. Het idee is dat grote multinationals in elk land waar zij actief zijn, belasting gaan betalen. Het voorstel is onderdeel van het plan om een wereldwijd minimumtarief voor de winstbelasting te laten gelden."
                            },
                            {
                                "example_id": "39ae7c09-e967-412f-a2c8-39d9490071f7",
                                "sense_id": "c5e7f7bf-44b3-306e-b887-43d7fc74178d",
                                "text": "Een maand geleden bereikte de G7, de groep van zeven grote economieën, al een akkoord over een nieuw belastingplan. Het OESO-akkoord is een belangrijke volgende stap voor de nieuwe regels. De G20 zal naar alle waarschijnlijkheid volgende week met het plan instemmen."
                            }
                        ]
                    }
