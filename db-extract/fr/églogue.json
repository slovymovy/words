        "fr-extract.jsonl": [
            {
                "entry_id": "20f1dc5e-6a30-3f72-bc22-651a4edde2de",
                "word": "églogue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c80f792d-0c99-4695-a768-88f1def59360",
                        "entry_id": "20f1dc5e-6a30-3f72-bc22-651a4edde2de",
                        "tags": [
                            "plural"
                        ],
                        "form": "églogues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                        "entry_id": "20f1dc5e-6a30-3f72-bc22-651a4edde2de",
                        "glosses": [
                            "Petit poème pastoral et bucolique qui met souvent en scène des bergers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ac728c-990e-4df3-a221-88e0b7214d38",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "– Nous avons vu de vous des églogues d’un style\nQui passent en doux attraits Théocrite et Virgile."
                            },
                            {
                                "example_id": "bcf52c7f-c8c7-4ac0-bc23-0339e7755fb7",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Écoutez Virgile hausser l’églogue à la hauteur du printemps ; Catulle mêler l’avril aux tentations plus fortes que les ambitions ; Longus adorer Chloé nue ; Dante épancher son inquiétude philosophique et lyrique sur le mystère de la femme ; Pétrarque soupirer ses aveux dans un exil que sa détresse enchante ; et, se rapprochant toujours plus de nous, Ronsard s’enivrer de la femme, parce qu’elle est une rose ; Shakespeare diviniser sa peine tumultueuse et insondable ; Racan bergeriser ; Segrais paganiser ; Voltaire proclamer le bon sens supérieur de l’amour."
                            },
                            {
                                "example_id": "c481b294-c15a-42ea-9127-b0797c83b77e",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Je veux, pour composer chastement mes églogues\nCoucher auprès du ciel, comme les astrologues"
                            },
                            {
                                "example_id": "346d1800-102b-4b2d-bacd-085709da2b75",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Elle s'enfuit vers les saules, mais désire auparavant être aperçue, disait délicieusement l’églogue, il y a deux mille ans."
                            },
                            {
                                "example_id": "607d672f-a0ea-43a0-9bd1-67c59d08b744",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Silvanus occupait sa vieillesse à faire des poèmes. Il composait des églogues et des élégies d’un style un peu dur, mais d’un tour ingénieux et dans lesquelles il introduisait les vers des anciens chaque fois qu’il en trouvait le moyen."
                            },
                            {
                                "example_id": "ad893963-9464-4b90-851a-6308fa4de2a8",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Oh ! les chastes églogues ! Oh ! les idylles chantées par les poètes ! Oh ! les paysanneries enrubannées et naïves qui défilent, conduites par la muse de Mme Deshoulières, au son des flageolets et des tambourins !"
                            },
                            {
                                "example_id": "2c316ec1-ca75-4694-89f0-c8704586d762",
                                "sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                                "text": "Je cherchai une discipline. Je la trouvai en me récitant à moi-même le début de la première églogue. Ainsi, par un ricochet inattendu, à vingt siècles de distance, et à travers des millions de kilomètres, Virgile, chantre d’un pays de soleil, sauvait ma raison au pays du froid…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31ea80e4-def5-4bef-a789-bf7ccaa06610",
                        "source_entry_id": "20f1dc5e-6a30-3f72-bc22-651a4edde2de",
                        "source_sense_id": "5816c4eb-64a7-38d1-b940-665004036347",
                        "target_lang_word": "bucolic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bucolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                                        "glosses": [
                                            "Rustic, pastoral, country-styled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3ff309-99c7-41a2-9ef6-09970c0dd6d5",
                                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                                "text": "The countryside was filled with charming, bucolic scenery, complete with rolling hills, fields of wildflowers, and quaint farmhouses."
                                            },
                                            {
                                                "example_id": "7791ed6d-25d1-4db1-8ee5-de1421aff551",
                                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                                "text": "A couple of years later the Metropolitan had reached its own most northerly point, Verney Junction, which was as bucolic as it sounds."
                                            },
                                            {
                                                "example_id": "9bdc0aab-50f1-48a0-af19-3b5123e7a2c0",
                                                "sense_id": "dc8798a9-8f4f-30fd-9d2a-a318a9089ec8",
                                                "text": "Before the area was a tech epicenter, it was a bucolic land of fruit orchards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                                        "glosses": [
                                            "Relating to the pleasant aspects of rustic country life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6554485-b33b-4869-adb2-8290bc1b470a",
                                                "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                                                "text": "The cozy bed and breakfast was located in a picturesque, bucolic setting, offering guests a chance to escape the city and enjoy the simple pleasures of the countryside."
                                            },
                                            {
                                                "example_id": "a91f797b-74cc-4426-9b49-f707965fb301",
                                                "sense_id": "f5011f73-d750-3cf1-8129-a5906965a9d8",
                                                "text": "In a sense, Mr. Maillier is living the classic French dream – working the land in the bucolic countryside, feeding his children good food, and keeping France’s gastronomic heritage alive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                                        "entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                                        "glosses": [
                                            "Pertaining to herdsmen or peasants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0cab98b-aa6c-42de-b3e8-9d94a1a365be",
                                                "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                                                "text": "Their traditional clothing and simple way of life reflected their bucolic roots as a community of shepherds and farmers."
                                            },
                                            {
                                                "example_id": "124b211a-a258-4369-ba5d-1bb52a23f4f5",
                                                "sense_id": "ee90814b-9d42-3402-9f80-0c885a22b0b7",
                                                "text": "Here we consider a bucolic example."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bucolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b55891-997c-3d23-89cb-3c58f17178a0",
                                        "entry_id": "629b930d-4e9c-3c13-aa18-5f122488bb20",
                                        "glosses": [
                                            "A pastoral poem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b47c2074-764a-3b11-80c2-6e8f324b4f40",
                                        "entry_id": "629b930d-4e9c-3c13-aa18-5f122488bb20",
                                        "glosses": [
                                            "A rustic, peasant."
                                        ],
