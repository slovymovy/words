                                "target_lang_word": "普什图语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50578497-b75f-3369-b65a-bc6c8ecc9a92",
                    "sense_definition": "A slang term for the country of Afghanistan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The soldiers were deployed to <w>Afghan</w> for a six-month tour of duty.",
                            "target_lang_translations": {
                                "ru": "Солдаты были отправлены в <w>Афган</w> на шестимесячный срок службы.",
                                "zh": "士兵们被派往<w>阿富汗</w>执行为期六个月的服役任务。"
                            }
                        },
                        {
                            "text": "He spent several years working as a contractor in <w>Afghan</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел несколько лет, работая подрядчиком в <w>Афгане</w>.",
                                "zh": "他在<w>阿富汗</w>做了几年合同工。"
                            }
                        }
                    ],
                    "traits": [
