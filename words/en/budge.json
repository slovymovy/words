        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "598da0f2-1e4d-3600-8a57-041335b0984d",
                    "sense_definition": "To move slightly or begin to move, or to be shifted from a fixed position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been pushing this heavy wooden table for ten minutes, but it won't <w>budge</w>."
                        },
                        {
                            "text": "Despite our best efforts to push the car out of the mud, it refused to <w>budge</w> an inch."
                        }
                    ],
                    "synonyms": [
                        "shift"
                    ],
                    "common_phrases": [
                        "won't budge",
                        "budge an inch"
                    ]
                },
                {
                    "sense_id": "0f7c560f-ffab-370e-818c-1ae315df1d87",
                    "sense_definition": "To cause something to move or shift from a fixed position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The box was so heavy that we could not <w>budge</w> it even a little bit."
