            {
                "entry_id": "6867355f-bbb5-32fc-b360-464fffc68d49",
                "word": "annonciation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f29abc29-968e-4e0e-8fd6-81a43fb94cca",
                        "entry_id": "6867355f-bbb5-32fc-b360-464fffc68d49",
                        "tags": [
