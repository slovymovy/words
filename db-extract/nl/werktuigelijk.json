                "senses": [
                    {
                        "sense_id": "a82a1e84-7ebf-390b-bb7e-74b8fdafca96",
                        "entry_id": "1454f472-efcd-3d23-a044-00cdc8a921f7",
                        "glosses": [
                            "op een manier die past bij een automatische machine; zonder nadenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7d55f3-faa3-419a-a53e-a2bcddfaefb1",
                                "sense_id": "a82a1e84-7ebf-390b-bb7e-74b8fdafca96",
                                "text": "\"Schrijven is altijd een klein wonder. Je moet een zekere poëtische gevoeligheid hebben voor dingen, dus alles bijna direct vertalen in poëzie. Iets in je doet dat bijna werktuigelijk.\""
                            },
                            {
                                "example_id": "ec8347db-7802-488a-b0a4-de2642772071",
                                "sense_id": "a82a1e84-7ebf-390b-bb7e-74b8fdafca96",
                                "text": "Bezieling ontstaat niet zomaar, niet met werktuigelijk handelen, niet na rationeel of pragmatisch denken, maar nadat wij ons zo diep ergens in hebben begeven, dat het ons hart en onze verbeelding raakt."
                            }
                        ]
                    }
