{
    "word_family": [
        "boldly",
        "boldness",
        "embolden",
        "boldface"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb378d32-fb0d-3428-9767-4f88b433bd0e",
                    "sense_definition": "Showing a willingness to take risks; confident and courageous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "courageous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer made a <w>bold</w> decision to cross the desert alone.",
                            "target_lang_translations": {
                                "ru": "Исследователь принял <w>смелое</w> решение пересечь пустыню в одиночку."
                            }
                        },
                        {
                            "text": "It was a <w>bold</w> move to quit his job without having another one lined up.",
                            "target_lang_translations": {
                                "ru": "Это был <w>решительный</w> шаг — уволиться с работы, не имея другого варианта."
                            }
                        }
                    ],
                    "synonyms": [
                        "audacious",
                        "brave",
                        "courageous",
                        "daring"
                    ],
                    "antonyms": [
                        "risk-averse",
                        "conservative",
                        "reluctant"
                    ],
                    "common_phrases": [
                        "bold move",
                        "bold decision",
                        "bold step"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий готовность идти на риск; уверенный и отважный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смелый",
                                "target_lang_sense_clarification": "не боящийся опасности"
                            },
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "готовый к действиям"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "смелый и вызывающий"
                            },
                            {
                                "target_lang_word": "отважный",
                                "target_lang_sense_clarification": "героически смелый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff7e4499-03f3-38b3-8fb7-bb26c5df1b85",
                    "sense_definition": "Printed or displayed with thick, heavy lines to make the text stand out.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure that the main headings are written in <w>bold</w> type.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что основные заголовки написаны <w>жирным</w> шрифтом."
                            }
                        },
                        {
                            "text": "The <w>bold</w> text in the manual highlights the most important safety instructions.",
                            "target_lang_translations": {
                                "ru": "<w>Жирный</w> текст в руководстве выделяет наиболее важные инструкции по технике безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bold type",
                        "bold font",
                        "bold text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напечатанный или отображаемый толстыми, тяжелыми линиями, чтобы текст выделялся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "о шрифте"
                            },
                            {
                                "target_lang_word": "полужирный",
                                "target_lang_sense_clarification": "типографский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d348f09d-60dd-34cf-9fe7-7a60182d642e",
                    "sense_definition": "Strong, vivid, or clear in appearance; easy to notice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist is known for her <w>bold</w> use of color and sharp lines.",
                            "target_lang_translations": {
                                "ru": "Художница известна своим <w>смелым</w> использованием цвета и четкими линиями."
                            }
                        },
                        {
                            "text": "She chose a <w>bold</w> pattern for the curtains to brighten up the room.",
                            "target_lang_translations": {
                                "ru": "Она выбрала <w>яркий</w> узор для штор, чтобы оживить комнату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bold colors",
                        "bold pattern",
                        "bold design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, яркий или четкий на вид; легко заметный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яркий",
                                "target_lang_sense_clarification": "о цвете или стиле"
                            },
                            {
                                "target_lang_word": "выразительный",
                                "target_lang_sense_clarification": "заметный и четкий"
                            },
                            {
                                "target_lang_word": "крупный",
                                "target_lang_sense_clarification": "о рисунке или узоре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b57716-a734-33c6-94b1-19f54576aef2",
                    "sense_definition": "Lacking respect; impudent or forward.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was quite <w>bold</w> when he interrupted the principal's speech.",
                            "target_lang_translations": {
                                "ru": "Студент повел себя довольно <w>дерзко</w>, прервав речь директора."
                            }
                        },
                        {
                            "text": "It was a bit <w>bold</w> of her to ask for a raise on her first day.",
                            "target_lang_translations": {
                                "ru": "С ее стороны было немного <w>нагло</w> просить о прибавке в первый же день."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward"
                    ],
                    "common_phrases": [
                        "bold as brass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий неуважение; дерзкий или бесцеремонный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "непочтительный"
                            },
                            {
                                "target_lang_word": "наглый",
                                "target_lang_sense_clarification": "бесцеремонный"
                            },
                            {
                                "target_lang_word": "самонадеянный",
                                "target_lang_sense_clarification": "излишне уверенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2a920a-bd65-3653-9490-e794ebd020c1",
                    "sense_definition": "Naughty or badly behaved.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told the <w>bold</w> child to sit in the corner for a timeout.",
                            "target_lang_translations": {
                                "ru": "Учитель велел <w>непослушному</w> ребенку посидеть в углу в наказание."
                            }
                        },
                        {
                            "text": "Stop being so <w>bold</w> and listen to what your mother is saying.",
                            "target_lang_translations": {
                                "ru": "Перестань так <w>озорничать</w> и послушай, что говорит мать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Irish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непослушный или плохо себя ведущий (часто в ирландском английском)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непослушный",
                                "target_lang_sense_clarification": "о ребенке"
                            },
                            {
                                "target_lang_word": "озорной",
                                "target_lang_sense_clarification": "балующийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83de0d08-2b71-3cf3-bec9-8a1d28009fbe",
                    "sense_definition": "Having a steep or abrupt slope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cliffs presented a <w>bold</w> face to the crashing waves of the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Скалы подставляли свой <w>отвесный</w> склон разбивающимся волнам Атлантики."
                            }
                        },
                        {
                            "text": "The mountain path followed a <w>bold</w> slope that was difficult to climb.",
                            "target_lang_translations": {
                                "ru": "Горная тропа шла по <w>крутому</w> склону, на который было трудно взобраться."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in descriptive literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий крутой или резкий склон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "об обрыве или склоне"
                            },
                            {
                                "target_lang_word": "отвесный",
                                "target_lang_sense_clarification": "вертикальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "989db90c-965a-3b90-845f-9f058c0da2b9",
                    "sense_definition": "Containing sexually explicit or suggestive content.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine was criticized for publishing <w>bold</w> images on its front cover.",
                            "target_lang_translations": {
                                "ru": "Журнал критиковали за публикацию <w>откровенных</w> изображений на обложке."
                            }
                        },
                        {
                            "text": "The cinema was warned against showing <w>bold</w> content during daytime hours.",
                            "target_lang_translations": {
                                "ru": "Кинотеатр предупредили о недопустимости показа <w>рискованного</w> контента в дневное время."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bold content"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий сексуально откровенный или провокационный контент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смелый",
                                "target_lang_sense_clarification": "откровенный"
                            },
                            {
                                "target_lang_word": "рискованный",
                                "target_lang_sense_clarification": "на грани приличия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e88c1018-8cfa-375a-84cc-0bcb5d6c8ad2",
                    "sense_definition": "To apply a thick or heavy weight to a font or text.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "typography_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>bold</w> the keywords so they are easier for the reader to find.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>выделить жирным</w> ключевые слова, чтобы читателю было легче их найти."
                            }
                        },
                        {
                            "text": "I will <w>bold</w> the subheads to improve the document's overall structure.",
                            "target_lang_translations": {
                                "ru": "Я <w>выделю жирным</w> подзаголовки, чтобы улучшить общую структуру документа."
                            }
                        }
                    ],
                    "synonyms": [
                        "embolden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применить жирное начертание к шрифту или тексту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять жирным",
                                "target_lang_sense_clarification": "о тексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8467e6fe-c4e0-3630-9bad-b0d0ef184721",
                    "sense_definition": "To make someone feel more confident or courageous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general's speech served to <w>bold</w> the spirits of the tired soldiers.",
                            "target_lang_translations": {
                                "ru": "Речь генерала послужила тому, чтобы <w>ободрить</w> дух уставших солдат."
                            }
                        },
                        {
                            "text": "Success in the first round helped to <w>bold</w> the young athlete for the final.",
                            "target_lang_translations": {
                                "ru": "Успех в первом раунде помог <w>придать смелости</w> молодому атлету перед финалом."
                            }
                        }
                    ],
                    "synonyms": [
                        "embolden"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать кому-либо больше уверенности или смелости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ободрять",
                                "target_lang_sense_clarification": "вселять смелость"
                            },
                            {
                                "target_lang_word": "придавать храбрости",
                                "target_lang_sense_clarification": "делать смелее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0724c4d2-dbeb-318d-b946-cc53d07ecd52",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Arthur <w>Bold</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Артура <w>Болда</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Bold</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Болд</w> живет в этом районе уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Болд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48daaf10-c5c6-3278-9ec5-6e681209fb17",
                    "sense_definition": "A civil parish in the Metropolitan Borough of St Helens, Merseyside, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The village of <w>Bold</w> is located in the historic county of Lancashire.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Болд</w> расположена в историческом графстве Ланкашир."
                            }
                        },
                        {
                            "text": "Many residents of <w>Bold</w> work in the nearby city of Liverpool.",
                            "target_lang_translations": {
                                "ru": "Многие жители <w>Болда</w> работают в близлежащем городе Ливерпуль."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гражданский приход в Англии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Болд",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}