                "senses": [
                    {
                        "sense_id": "8a707e53-a672-33f4-bc38-eeef0bb98157",
                        "entry_id": "5d505432-dd3e-3809-8890-5983a513ee23",
                        "glosses": [
                            "Louer par un panégyrique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a56b911e-e0df-4bc7-8bd9-b1a3d52a3458",
                                "sense_id": "8a707e53-a672-33f4-bc38-eeef0bb98157",
                                "text": "Le besoin de louer et panégyriquer l’Académie ne me revient pas, surtout s’il le veut faire en françois, où je doute qu’il soit un fort grand personnage."
                            },
                            {
                                "example_id": "4d125dc4-1139-4838-a620-3a0893a315ec",
                                "sense_id": "8a707e53-a672-33f4-bc38-eeef0bb98157",
                                "text": "Taisez-vous donc ! vous êtes toujours à chercher des prosélytes, à panégyriquer l’opium devant les nouveaux venus !"
                            },
                            {
                                "example_id": "706f1dc2-faa2-4be8-8961-dd90fa67b901",
                                "sense_id": "8a707e53-a672-33f4-bc38-eeef0bb98157",
                                "text": "Nos Alphonses brillent chacun dans leur domaine, l’écriture et l’édition, et ce serait faire injure à l’un que de panégyriquer l’autre."
                            }
                        ]
                    }
                ],
