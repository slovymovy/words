                "senses": [
                    {
                        "sense_id": "cb1bfb20-3ff1-38f6-b512-86eb77ba5cf4",
                        "entry_id": "af96b6ff-0f63-3710-82c2-996f0dd6920c",
                        "glosses": [
                            "Défaire le poisson du filet en secouant le filet."
                        ],
                        "tags": [
                            "Bretagne"
                        ],
                        "examples": [
                            {
                                "example_id": "07bd130f-8c39-437a-b71b-bf3f591dfad1",
                                "sense_id": "cb1bfb20-3ff1-38f6-b512-86eb77ba5cf4",
                                "text": "Quand la pêche donnait bien — ce qui, hélas ! n’était pas toujours le cas — c’était vraiment exaltant de voir les chaloupes se presser sous la jetée, leurs équipages « débesquer » les filets encore pleins, les porteurs se hâter, un panier à chaque bras, vers les usines, ou diriger sur elles les petites charrettes, les uns tirant, les autres poussant ces charrettes surchargées."
                            },
                            {
                                "example_id": "a95b22da-ca85-4dad-a688-fb08d4165db9",
                                "sense_id": "cb1bfb20-3ff1-38f6-b512-86eb77ba5cf4",
                                "text": "Aussitôt les hommes s’emploient à démailler le poisson, à « débesquer », sans toucher aux poissons."
                            }
                        ]
                    }
                ],
