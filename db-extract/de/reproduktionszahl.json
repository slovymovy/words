                "senses": [
                    {
                        "sense_id": "2c2462c9-b7f4-3360-b4b8-6a816dc39d97",
                        "entry_id": "11346bf3-106e-355b-ac73-4c58864aa454",
                        "glosses": [
                            "Vervielfältigungszahl, die angibt, mit welcher Geschwindigkeit sich etwas vermehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0d0ea9-b929-43fc-ae63-f617c3cfad6b",
                                "sense_id": "2c2462c9-b7f4-3360-b4b8-6a816dc39d97",
                                "text": "„Damit die Epidemie kontrollierbar wird, muss die Reproduktionszahl kleiner werden, idealerweise deutlich unter eins fallen.“"
                            },
                            {
                                "example_id": "8b076e01-36b9-41f6-88dc-67191e6d7dc2",
                                "sense_id": "2c2462c9-b7f4-3360-b4b8-6a816dc39d97",
                                "text": "„ Für die Überwindung der Covid-19-Pandemie wäre eine Verringerung der Reproduktionszahl auf unter 1 notwendig.“"
                            },
                            {
                                "example_id": "af84590c-ef26-4b2d-b3ad-a78bf93470ca",
                                "sense_id": "2c2462c9-b7f4-3360-b4b8-6a816dc39d97",
                                "text": "„Durch Infektionsschutzmaßnahmen lässt sich die Reproduktionszahl verringern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
