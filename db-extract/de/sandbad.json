                "senses": [
                    {
                        "sense_id": "3f5ca8eb-5489-31ff-9213-3a89d0ffad1b",
                        "entry_id": "dbd3160b-3bc7-3041-aaed-7f5d2a75c9d7",
                        "glosses": [
                            "Verhalten von Tieren, die durch das Wälzen im Sand die Haut, das Fell oder das Federkleid reinigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4a6a7f-991e-4b78-b5d5-30a13ae86373",
                                "sense_id": "3f5ca8eb-5489-31ff-9213-3a89d0ffad1b",
                                "text": "„Solange die Sonne am Himmel steht, hält sich die Wachtel möglichst still und verborgen zwischen Halmen und Ranken der Felder auf; während der Mittagsstunden pflegt sie ein Sandbad zu nehmen, behaglich hingestreckt sich zu sonnen oder auch zu schlafen; gegen Sonnenuntergang wird sie munter und rege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10acb497-afae-34f9-85c6-570595166200",
                        "entry_id": "dbd3160b-3bc7-3041-aaed-7f5d2a75c9d7",
                        "glosses": [
                            "Vorrichtung, um eine Überhitzung von Chemikalien zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635d4518-c337-40d9-b850-877e7a132e2b",
                                "sense_id": "10acb497-afae-34f9-85c6-570595166200",
                                "text": "„Auch mehrstündiges Erhitzen der Lösung auf 90 °C im Sandbad brachte keine nachweisbare Reduktion der Verbindung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "afa25916-0ba0-3864-862d-a20ad0717282",
                        "entry_id": "dbd3160b-3bc7-3041-aaed-7f5d2a75c9d7",
                        "glosses": [
                            "mit warmem Sand gefüllte, bettähnliche Wanne; früher zu medizinischen Zwecken verwendet"
                        ],
                        "tags": [
                            "Wellness"
                        ],
                        "examples": [
                            {
                                "example_id": "b40639ce-0dc6-47e0-a693-cdf732331bcd",
                                "sense_id": "afa25916-0ba0-3864-862d-a20ad0717282",
                                "text": "„Sturm liess in manchen Fällen das Sandbad mit Soolbädern der Saline Heinrichshall abwechseln.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
