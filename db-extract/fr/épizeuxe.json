                "senses": [
                    {
                        "sense_id": "a4837f8b-8cde-34be-821e-7bd77ca4e2ec",
                        "entry_id": "1cd6e0b6-2814-3f1b-b2da-90e391d87803",
                        "glosses": [
                            "Figure de style qui consiste à répéter plusieurs fois le même mot à la suite."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "2df8f567-00ca-4538-a171-11c9b3cfda5d",
                                "sense_id": "a4837f8b-8cde-34be-821e-7bd77ca4e2ec",
                                "text": "Les deux premiers mots de ces vers tirés de l’Andromaque de Racine, Acte III, scène 8, forment une épizeuxe :\nSonge, songe, Céphise, à cette nuit cruelle\nQui fut pour tout un peuple une nuit éternelle ;"
                            },
                            {
                                "example_id": "b5e51814-5e03-48df-a0a2-9922dc93bb3e",
                                "sense_id": "a4837f8b-8cde-34be-821e-7bd77ca4e2ec",
                                "text": "L’épizeuxe est à distinguer du bégaiement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c30e9c0a-8943-4f57-9c61-3178211faf8c",
                        "source_entry_id": "1cd6e0b6-2814-3f1b-b2da-90e391d87803",
                        "source_sense_id": "a4837f8b-8cde-34be-821e-7bd77ca4e2ec",
                        "target_lang_word": "Epizeuxis",
