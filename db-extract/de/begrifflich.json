                "senses": [
                    {
                        "sense_id": "3b5ac89e-a6a5-399e-a0d7-cbea048f5f89",
                        "entry_id": "8193287c-e103-3333-aa27-2ab54ebc85e6",
                        "glosses": [
                            "was den Ausdruck (den Begriff mit der Gesamtheit seiner Merkmale) angeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61422c78-ba96-4dce-b63a-47d6139503cc",
                                "sense_id": "3b5ac89e-a6a5-399e-a0d7-cbea048f5f89",
                                "text": "Liebe und Verliebtheit muss man begrifflich sauber trennen."
                            },
                            {
                                "example_id": "e3035569-19f5-4a24-9c15-3dc253290537",
                                "sense_id": "3b5ac89e-a6a5-399e-a0d7-cbea048f5f89",
                                "text": "Natürlich streben wir eine begriffliche Eindeutigkeit an."
                            },
                            {
                                "example_id": "ac40b1c6-4c94-4d0f-be58-fe293ab4692f",
                                "sense_id": "3b5ac89e-a6a5-399e-a0d7-cbea048f5f89",
                                "text": "Glück ist nur schwer begrifflich zu fassen."
                            },
                            {
                                "example_id": "52c92892-addc-4a25-bc97-ffac4128ad90",
                                "sense_id": "3b5ac89e-a6a5-399e-a0d7-cbea048f5f89",
                                "text": "Ich glaube, hier herrscht eine begriffliche Verwirrung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
