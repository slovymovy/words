                                "example_id": "53664841-1f5f-48ff-aa08-87041d523062",
                                "sense_id": "2caff82b-f585-3944-88a9-2f4f7e03a125",
                                "text": "Heniek z Wacławem zmartwychwstali po wczorajszej bibie."
