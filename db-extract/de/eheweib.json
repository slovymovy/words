                "senses": [
                    {
                        "sense_id": "ec273bb3-7a42-3b72-ac63-196ae3d145c1",
                        "entry_id": "6599b518-b092-3082-9a82-c0e1092db541",
                        "glosses": [
                            "verheiratete Frau"
                        ],
                        "tags": [
                            "derogatory",
                            "jocular",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f4189b50-7b8c-422e-8ae5-99b6b6aa2225",
                                "sense_id": "ec273bb3-7a42-3b72-ac63-196ae3d145c1",
                                "text": "„Das Reisegeld, so rät er ihm, bettelt man sich unterwegs zusammen, wie es bei Juden üblich ist; und von daheim geht man fort, indem man es dem Eheweib erst gar nicht verrät.“"
                            },
                            {
                                "example_id": "10892817-68bc-4bbf-8ec2-66d0aba6aed3",
                                "sense_id": "ec273bb3-7a42-3b72-ac63-196ae3d145c1",
                                "text": "„Er glaubte, sie müßte wenigstens das Eheweib eines Pastors oder eines Propstes hier in Rotterdam sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9535d23-fed8-467b-9a9c-317ad37e07ce",
                        "source_entry_id": "6599b518-b092-3082-9a82-c0e1092db541",
                        "source_sense_id": "ec273bb3-7a42-3b72-ac63-196ae3d145c1",
                        "source_sense_description": "veraltet, abwertend, scherzhaft: verheiratete Frau",
                        "target_lang_word": "épouse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                        "entry_id": "17cd16af-bec7-3482-9f5e-45db4b99047e",
                                        "glosses": [
                                            "Femme, dans le mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8741faac-6177-4741-8398-4695c26b1801",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "La scène de la réconciliation, où Béatrix fit rejurer haine à l’épouse qui jouait, dit-elle, la comédie du lait répandu, se passa dans un vrai bocage où elle minaudait environnée de fleurs ravissantes, de jardinières d’un luxe effréné."
                                            },
                                            {
                                                "example_id": "58b70d40-e149-4ce4-abbc-df506e9a9e69",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Alors, comme personne ne voulait plus d’elle pour épouse, elle s’était réfugiée là, dans la vieille maison de son frère et y vivait avec sa tante aveugle."
                                            },
                                            {
                                                "example_id": "5c6db09e-d1c1-4359-81f2-7d4d5d3fb0b7",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Cheikh Gaafar avait déjà deux épouses, et cinq filles. […] L’idée de convoler une troisième fois en noces lui plut : certes l’entente serait malaisée à son foyer."
                                            },
                                            {
                                                "example_id": "451f714f-62f3-4a84-bb91-e417c0ec1271",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Les Benjamites furent avertis qu’ils pourroient s’approcher secrètement du lieu de la fête, s’aposter de manière à bien voir les femmes qui s’y trouveroient, et enlever sans résistance celles qu’ils voudroient pour épouses."
                                            },
                                            {
                                                "example_id": "b762a9f9-89a0-4961-8663-0c3975d9399a",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Mais déjà Jourgeot, souriant à son tour, s’enquérait avec sollicitude de la santé de son épouse."
                                            },
                                            {
                                                "example_id": "c24862a6-f35f-4019-baef-fa2227b81fc4",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Je ne pense jamais au Siam sans évoquer le déjeuner que fit au Palais Royal le gouverneur de l’Indochine d’alors, M. Violette, accompagné de sa très digne épouse."
                                            },
                                            {
                                                "example_id": "5f09d505-d611-4a4e-933a-ddcc27a1fda3",
                                                "sense_id": "27715d34-184c-3ebf-a45b-8e73c6665a14",
                                                "text": "Rosebud se cherche toujours. Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de987065-8d26-3f2e-b542-51d976eb952d",
                                        "entry_id": "069ea57c-96ec-3a64-89fb-5f5094873381",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de épouser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2c63051-83e4-3e94-b2bd-2f8e05dc598d",
                                        "entry_id": "069ea57c-96ec-3a64-89fb-5f5094873381",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de épouser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8b4c12-58d3-45a3-b005-84e6c3e7da20",
                                                "sense_id": "c2c63051-83e4-3e94-b2bd-2f8e05dc598d",
                                                "text": "Il épouse une adolescente d’origine bretonne, Marie-Anne Barbette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e993767a-c3d8-3772-ac82-176f1309b22a",
                                        "entry_id": "069ea57c-96ec-3a64-89fb-5f5094873381",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de épouser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "653a47b1-f03d-4b39-95fb-5c3a1e4e06f2",
                                                "sense_id": "e993767a-c3d8-3772-ac82-176f1309b22a",
                                                "text": "La seule chose qui m’inquiétait parfois est qu’on puisse imaginer que j’épouse la cause de Hitler parce que j’ai accepté de l’incarner, avouait l’acteur allemand Bruno Ganz, acteur suisse, disparu en 2019, qui prêtait ses traits au dictateur dans La Chute d’Olivier Hirschbiegel en 2005."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7529aa-949f-3351-beaf-6009161d48ed",
                                        "entry_id": "069ea57c-96ec-3a64-89fb-5f5094873381",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de épouser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cefc4ba8-8d4f-3c12-af0e-383974e4aaba",
                                        "entry_id": "069ea57c-96ec-3a64-89fb-5f5094873381",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de épouser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
