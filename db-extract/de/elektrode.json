                                    {
                                        "sense_id": "5dc2176d-1a8e-376c-8e91-63facfe75ee6",
                                        "entry_id": "9328f034-f03b-3483-9222-277fa082d984",
                                        "glosses": [
                                            "The terminal through which electric current passes between metallic and nonmetallic parts of an electric circuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a66e47f-55d4-4ed3-8117-d8e180846b74",
                                                "sense_id": "5dc2176d-1a8e-376c-8e91-63facfe75ee6",
                                                "text": "From my laboratory in the Castle east\nTo the master bedroom, where the vampires feast\nThe ghouls all came from their humble abodes\nTo get a jolt from my electrodes\nThey did the Mash\nThey did the Monster Mash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f83e7e-aa1f-3343-bc87-8896a0cd6330",
                                        "entry_id": "9328f034-f03b-3483-9222-277fa082d984",
                                        "glosses": [
                                            "A collector or emitter of electric charge in a semiconducting device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d943809d-c546-47e9-868f-615e8b0144f0",
                        "source_entry_id": "452eba2e-b99c-342a-928e-4e232c4c605b",
                        "source_sense_id": "dc222876-b3dd-3e35-b862-3b148e5550a1",
                        "source_sense_description": "Technik: Bauelement, an dem elektrischer Strom in ein anderes Medium übergeht",
