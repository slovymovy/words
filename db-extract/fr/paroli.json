                ],
                "senses": [
                    {
                        "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                        "entry_id": "a96f7a4f-d3d3-381a-b0dd-2f8de614c09d",
                        "glosses": [
                            "Le double de ce qu’on a joué la première fois, au jeu de bassette, de pharaon, de trictrac, et d'autres encore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e03a24-e77d-4d6f-9755-d4e7b70f0823",
                                "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                                "text": "Offrir, tenir, gagner le paroli."
                            },
                            {
                                "example_id": "b43fd7f5-4304-4b56-abff-42e885f2ffee",
                                "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                                "text": "Jouer au trictrac, partie, paroli et le tout."
                            },
                            {
                                "example_id": "7f796d2d-b657-4ec5-b808-69edfc65a262",
                                "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                                "text": "Je jouais, en un mot, le tout pour le tout ; paroli, masse en avant !..."
                            },
                            {
                                "example_id": "96d2766a-c4de-448f-902a-de32311e15c4",
                                "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                                "text": "Que voulez-vous, le coup sur lequel j'ai tenu le paroli ne se représente pas trois fois dans toute une vie."
                            },
                            {
                                "example_id": "3437a9c8-c04e-48a0-9e57-2c2b10882e4c",
                                "sense_id": "749c74b8-ce94-3a9c-a6dc-9c3e006286bd",
                                "text": "Il faut qu’il ait les cartes en main, qu’il joue, qu’il coupe, qu’il trompe, qu’il égare les autres, qu’il fasse paroli et qu’il batte atout."
                            }
                        ]
                    }
                ],
