                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sculpteur a représenté les trois <w>Grâces</w> enlacées dans un marbre blanc éclatant."
                        },
                        {
                            "text": "Selon la mythologie, les <w>Grâces</w> accompagnaient fidèlement la déesse Vénus."
                        }
                    ],
                    "synonyms": [
