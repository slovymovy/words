                        ]
                    },
                    {
                        "translation_id": "94d47352-964d-491d-95a8-8cc82cb9d7dc",
                        "source_entry_id": "18331093-51f6-3250-889d-4a95c05b0df5",
                        "source_sense_id": "b14a3309-1c9f-3de9-96e7-12333ebc8f5f",
                        "target_lang_word": "fessée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fessée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                        "entry_id": "1704eb54-77e5-3819-b41f-7702b91b426a",
                                        "glosses": [
                                            "Châtiment corporel consistant en une série de claques ou de coups administrés sur les fesses à main nue ou à l’aide d’un instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b53af4-d5ed-4cf0-b564-36be8f2b4148",
                                                "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                                "text": "Tout se découvrit, les vols anciens et le dernier, et elle reçut une fessée d’orties, qui lui couvrit le derrière de camboules."
                                            },
                                            {
                                                "example_id": "b11bd96a-6dfa-49de-a23f-859271f2e391",
                                                "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                                "text": "Il ne faut pas croire, en effet, que l’histoire ait attendu ces derniers temps pour savoir que ce furent de simples polissons qui méritaient la fessée et qui avaient reçu par hasard un coup de fusil."
                                            },
                                            {
                                                "example_id": "40ca36b9-a865-4ab6-9189-82af8ddfe08b",
                                                "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                                "text": "Et c’est souvent que Lucette, par jeu ou par punition, recevait de son amant des fessées ou des fouettées avec la large ceinture de son pantalon qui faisait passer ses fesses du rose le plus tendre au rouge le plus vif."
                                            },
                                            {
                                                "example_id": "d8d585e4-26e5-4354-bb04-cc1dd08e4836",
                                                "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                                "text": "— Pour la détromper mon oncle, je crois qu’une bonne fessée s’impose."
                                            },
                                            {
                                                "example_id": "cd367f10-113a-4cfc-b599-71d13c68d622",
                                                "sense_id": "d0e4dcb0-129d-3f26-b017-947d8e48d4db",
                                                "text": "L’agresseur dévalorise également la victime en l’humiliant, à travers un ensemble de gestes. Dans plusieurs situations, l’humiliation se fait en présence d’autres personnes : c’est le cas pour une victime de violences sexuelles dont le père lui donnait des fessées devant des témoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472f1dcb-5ca7-3eac-ac40-b08d894c1fd3",
                                        "entry_id": "1704eb54-77e5-3819-b41f-7702b91b426a",
                                        "glosses": [
                                            "Défaite sévère et humiliante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f083ee43-133e-4ab4-80fe-653ac052b9e3",
                                                "sense_id": "472f1dcb-5ca7-3eac-ac40-b08d894c1fd3",
                                                "text": "On a joué au bowling et il m’a mis la fessée !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fessée",
                                "target_lang_code": "fr",
