        "nl-extract.jsonl": [
            {
                "entry_id": "28af2c23-ee52-32ef-9e7a-81f3556ed288",
                "word": "uitfrezen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e05ea20-4667-3b39-8d38-c4668c776a4e",
                        "entry_id": "28af2c23-ee52-32ef-9e7a-81f3556ed288",
                        "glosses": [
                            "materiaal verwijderen met behulp van een frees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed8689b-1cfd-475f-9ad6-48b5e83e536a",
                                "sense_id": "1e05ea20-4667-3b39-8d38-c4668c776a4e",
                                "text": "Veilig Verkeer Nederland (VVN) en de ANWB zijn dan ook groot voorstander van deze markering, omdat het uitfrezen van de middenmarkering in Zweden heeft geleid tot 20 procent minder slachtoffers op de zogenoemde ’dodenwegen’. Weggebruikers worden gealarmeerd door trilling en hard rammelend geluid als ze de markering overschrijden."
                            },
                            {
                                "example_id": "c30ff5f9-e507-498d-9bec-1ee7068fed6a",
                                "sense_id": "1e05ea20-4667-3b39-8d38-c4668c776a4e",
                                "text": "Het belangrijkste is echter het opknappen van het nieuwe huis. Wie na de verhuizing nog gaat verbouwen, roept een hoop ellende over zich af. Meubels kopen en gordijnen maken kan altijd later wel, maar schilderen of het uitfrezen van een muur voor nieuwe leidingen vormen een ramp in een bewoond huis."
                            },
                            {
                                "example_id": "96a15213-42b1-41b7-aa94-ad598f5acb43",
                                "sense_id": "1e05ea20-4667-3b39-8d38-c4668c776a4e",
                                "text": "Een slagader uitfrezen kost bijna evenveel kracht als het uitboren van een rotte kies. Er zijn al commerciële systemen waarbij een boor wordt aangedreven door een ronddraaiende spil in een holle catheter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b61d7ac-3d61-4fd5-a813-5cd2dd3d6e5c",
                        "source_entry_id": "28af2c23-ee52-32ef-9e7a-81f3556ed288",
                        "source_sense_id": "1e05ea20-4667-3b39-8d38-c4668c776a4e",
                        "target_lang_word": "cut out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                        "entry_id": "34837277-a787-3b98-9cc6-bd6980145fb3",
                                        "glosses": [
                                            "Well suited; appropriate; fit for a particular activity or purpose."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c94d12-7880-440f-b1a7-5d27c47b53c2",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "I'm not really cut out for camping outdoors. I'm allergic to mosquito bites."
                                            },
                                            {
                                                "example_id": "7db05aa4-8bfa-487d-8f38-9cd4d96c01f5",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "We've got our work cut out for us."
                                            },
                                            {
                                                "example_id": "df7a5963-3845-4039-830a-3820a0a97530",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "Do you think he is cut out for the role of manager?"
                                            },
                                            {
                                                "example_id": "b7f10ab0-9f74-4437-bf9a-a834cf14f14f",
                                                "sense_id": "54688d5b-5457-3705-a5f7-95e0ff2a3c07",
                                                "text": "I was cut out to be a jazzman the way the righteous are chosen for the church."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cut out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecafdbeb-b7fa-3a82-9349-6bf78f8aa76d",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see cut, out. To separate into parts with or as if with a sharp-edged instrument; sever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04df8b31-0444-4dd8-ae5e-bc855795eb65",
                                                "sense_id": "ecafdbeb-b7fa-3a82-9349-6bf78f8aa76d",
                                                "text": "Cut out the letters and paste them on the poster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To refrain from (doing something, using something etc.), to stop or cease (doing something)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6179f1-b29a-44ca-90ae-c10e9c333592",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "He had to cut out smoking in order to be prepared for the marathon."
                                            },
                                            {
                                                "example_id": "621abda5-6a59-4a81-a306-73f28a44caec",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "She kept clicking her heels. He told her to cut it out."
                                            },
                                            {
                                                "example_id": "28191c3d-f755-4ca9-9ac4-cd63d3252a50",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "Hockey is an exciting and healthful form of exercise, well suited to college students, but if it is to retain favor the intercollegiate league should cut out the muckerism which has attended its contests on the ice in recent years."
                                            },
                                            {
                                                "example_id": "f2f4dded-03f5-41ae-a875-92bb91082f7d",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "“Cut that joshing out,” she said, coolly and briskly. “Who do you think you are talking to? Your check, please. Oh, Lordy!—”"
                                            },
                                            {
                                                "example_id": "2852092b-532b-409a-8a28-0f83e0f4a657",
                                                "sense_id": "7fe37dd4-20dd-3817-9fc1-5728b458371d",
                                                "text": "I have no wind, if you want to know the truth. I'm quite a heavy smoker, for one thing — that is, I used to be. They made me cut it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To remove; to omit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844352a6-6a39-47b6-a35f-8558920deb70",
                                                "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                                "text": "If we cut out the middle-man, we will both have better profits."
                                            },
                                            {
                                                "example_id": "d26b1841-778d-4485-9d30-e1effaa4633a",
                                                "sense_id": "e6eb2da1-246a-371e-8190-07c2621e622f",
                                                "text": "Help me find a sharper knife\nI need to cut you out my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9550e715-339e-3e05-8c5c-a7cf6b865c16",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To oust; to replace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628c4036-f566-4156-85e8-6ea7ff91200e",
                                                "sense_id": "9550e715-339e-3e05-8c5c-a7cf6b865c16",
                                                "text": "[…] cut him out in the affections of his lady-love!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "448d9fe1-968b-3749-b930-7bb2371aaf80",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To separate (an animal) from the herd."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f5c4e8-918f-4615-bcc2-83ffbf3886c3",
                                                "sense_id": "448d9fe1-968b-3749-b930-7bb2371aaf80",
                                                "text": "There was little fear that the navigator of the captured Osprey, the man who had lived in Chile and \"cut out\" cattle on the Carrum Plains, would prove lacking in knowledge of riding, seamanship, or Spanish customs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To stop working, to switch off; (of a person on the telephone etc.) to be inaudible, be disconnected."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa70642-d9a5-45ce-be01-cb1fe6ae44e1",
                                                "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                                "text": "It was around then that the engine suddenly cut out."
                                            },
                                            {
                                                "example_id": "7a337a13-11a5-4d7d-8c7c-2c67d72277e5",
                                                "sense_id": "e338d7a5-900f-3970-acde-b84b29599b14",
                                                "text": "Can you say that again? You keep cutting out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba639814-8471-3bba-afab-5b393cdda026",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To leave suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e7710a-3ca1-42a5-8330-24c522e30ec8",
                                                "sense_id": "ba639814-8471-3bba-afab-5b393cdda026",
                                                "text": "He must have cut out of the party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81be3766-fa50-35dd-b0a2-e358e78a8dfa",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To arrange or prepare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be382b8-ec34-40a2-9490-24cf8e1ad4cd",
                                                "sense_id": "81be3766-fa50-35dd-b0a2-e358e78a8dfa",
                                                "text": "He has his work cut out for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f87acc18-244d-3b5d-a676-6fc200917a07",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To intercept."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e7194a-d2f4-4c0f-8072-ed8c970f9958",
                                                "sense_id": "f87acc18-244d-3b5d-a676-6fc200917a07",
                                                "text": "As lax as the visitors' defence was, Blackpool's backline was solid. In the first half the Seasiders cut out final balls to Meireles, one of Liverpool's best players, on two occasions and after the break the brilliant Craig Cathcart got enough on his headed clearance to prevent Torres from planting into the net at the far post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc009c5-c8df-3d06-90d4-f5e0caadbe22",
                                        "entry_id": "5ee5d78d-d85e-3396-b784-d0c11d79b5ba",
                                        "glosses": [
                                            "To take a ship out of a harbor etc. by getting between her and the shore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
