                            {
                                "target_word": "North Star",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "544570f9-9d1f-3b2c-9343-b3b891e517a7",
                                        "entry_id": "3c3c006e-22cf-3b70-b261-35757199bc36",
                                        "glosses": [
                                            "An aim or a goal, a dependable guiding light in a quickly changing world."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda88891-59d3-430f-be33-215fb91786f4",
                                                "sense_id": "544570f9-9d1f-3b2c-9343-b3b891e517a7",
                                                "text": "For Wilson, his religion served as guiding principle, not a series of explicit religious dictates governing politics: “Wilson's principles, derived from his religious faith, were his North Star, which pointed him in a general direction."
                                            },
                                            {
                                                "example_id": "3e8a4223-94a5-4391-96e6-de3eaabc2f17",
                                                "sense_id": "544570f9-9d1f-3b2c-9343-b3b891e517a7",
                                                "text": "His North Star was Rome, his compass was the Holy Office, “My polar star is Rome; my compass is the Holy Office.”"
                                            },
                                            {
                                                "example_id": "9cfe876e-3f32-4b61-9cef-1f1149026aa3",
                                                "sense_id": "544570f9-9d1f-3b2c-9343-b3b891e517a7",
                                                "text": "Believing that he would return to life when he was ready, she became his North Star."
                                            },
                                            {
                                                "example_id": "f7521301-fce7-40f4-9836-cfb8bc921922",
                                                "sense_id": "544570f9-9d1f-3b2c-9343-b3b891e517a7",
                                                "text": "The wise voice in my head agreed with her and told me something I'd never forget: Stop going against yourself. Be you. All the way. And watch life work for you. This voice, my intuition, has become my North Star in life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
