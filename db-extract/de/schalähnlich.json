                "senses": [
                    {
                        "sense_id": "9bf6b6c7-7782-360d-9a10-2792dfadf3db",
                        "entry_id": "df034c39-fc5c-3e55-9d70-bf6ecef19163",
                        "glosses": [
                            "wie ein Schal aussehend; einem Schal ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "265bd702-4ea2-44f0-a539-5d5342191a83",
                                "sense_id": "9bf6b6c7-7782-360d-9a10-2792dfadf3db",
                                "text": "„Ein weiteres langes Stück Seide band er schalähnlich um seinen Hals und die untere Gesichtshälfte, um den Mund zu verbergen.“"
                            },
                            {
                                "example_id": "b9e5492d-69d6-4ea4-8e14-2d7794ea2c03",
                                "sense_id": "9bf6b6c7-7782-360d-9a10-2792dfadf3db",
                                "text": "„Auch Pelzhandschuhe, Mützen und schalähnliche Pelzkragen, mit runden Pelzbommeln an Kordelschnüren, nähte der Kürschner für die Schlittenfahrt.“"
                            }
                        ],
