                "senses": [
                    {
                        "sense_id": "156640d4-24f1-39c0-83e4-15a8e5c1dce4",
                        "entry_id": "220afcac-2303-3822-ae5f-eb06d1944ae8",
                        "glosses": [
                            "Stock mit grob bearbeiteter Oberfläche, die noch Merkmale des natürlichen Wuchses aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155268ba-b4a1-4433-8d69-d25fe24fde37",
                                "sense_id": "156640d4-24f1-39c0-83e4-15a8e5c1dce4",
                                "text": "„Um den Spitzenschal, mit dem er Anna hatte überraschen wollen, und den Knotenstock, der ihn auf seinen Wanderungen durch die Stadt begleiten sollte, sah er sich geprellt.“"
                            },
                            {
                                "example_id": "fd047291-bc69-4626-9f29-8c00b4bed8a5",
                                "sense_id": "156640d4-24f1-39c0-83e4-15a8e5c1dce4",
                                "text": "„In blauen Blusen, mit breitkrempigen Hüten, Gamaschen bis zum Knie und in der Hand einen Knotenstock wie die Pferdehändler drängten sie sich um das Vieh herum, fragten die Bauern aus und verfehlten nicht, allen landwirtschaftlichen Versammlungen beizuwohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
