        "fr-extract.jsonl": [
            {
                "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                "word": "grésillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5da040e4-cce3-4e1d-ae5b-97845685f031",
                        "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "grésillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                        "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                        "glosses": [
                            "Action de grésiller ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4ce5ed-c86e-4ef8-b6f1-55405c508880",
                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                "text": "Le silence était si profond dans cette pièce qu'elle entendait le léger grésillement du néon."
                            },
                            {
                                "example_id": "f1ca5369-5351-4e90-b7cf-7bd1c1b9d58f",
                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                "text": "[…] le grésillement du rasoir électrique le matin, […]"
                            },
                            {
                                "example_id": "d26a1384-9d5b-48f8-ba85-58716cf6d406",
                                "sense_id": "ffadef51-54bb-37b1-ae21-d488f3b170bd",
                                "text": "Je suis assise sur le banc, enveloppée par l’obscurité, ses mains et son souffle chauds, et j’écoute les grillons, émerveillée de leur grésillement."
                            }
                        ]
                    },
                    {
                        "sense_id": "6361ff68-6fa1-39ca-99aa-35dd1114d063",
                        "entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                        "glosses": [
                            "Bruit confus et sans signification."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "10bdc72f-fd54-435a-a5d8-12d42703e58b",
                                "sense_id": "6361ff68-6fa1-39ca-99aa-35dd1114d063",
                                "text": "Comme je possédais pour tout bagage ce que m’avait enseigné l’abbé Trécourt, je commençai par tâtonner difficilement à travers les systèmes de Descartes et de Spinoza. Parfois, ils m’emportaient très haut, dans l’infini : j’apercevais la terre à mes pieds comme une fourmilière et la littérature même devenait un vain grésillement ; parfois je n’y voyais que de maladroits échafaudages, sans rapport avec la réalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24196adb-fb49-4277-9d3d-f263dff92652",
                        "source_entry_id": "cb663eab-d35d-39eb-b4d8-50588168f4f3",
                        "target_lang_word": "Zischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                        "entry_id": "68ab46b9-0a0d-33d4-8ffb-22eb5b0649d3",
                                        "glosses": [
                                            "zischendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8f53f5-396f-448c-a93e-ad0a74b37c24",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Er war schon recht angeheitert, und das Rauschen der Bäume zu beiden Seiten der Allee erinnerte ihn an das Zischen von Schlangen.“"
                                            },
                                            {
                                                "example_id": "d703708c-bb93-4c20-97e1-d7e05ce8c743",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Falls ein verräterisches Geräusch ertönt - ein Knurren, ein Zischen, ein hasserfüllter Schrei -, wird sie es wohl kaum rechtzeitig aus dem Tumult des Sturms heraushören, um sich zu retten.“"
                                            },
                                            {
                                                "example_id": "cb791ff4-a1c3-486c-9206-ec5bb447ee7a",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Ich stürzte nach hinten, schlug mit der Schulter gegen eine Kiste und hörte das Geschöpf nur Zentimeter von mir entfernt mit einem triumphierenden Zischen vorbeischlurfen.“"
                                            },
                                            {
                                                "example_id": "c3307371-a38a-4905-a324-b186b93b94bc",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Mit langgezogenem Zischen flog die Leuchtkugel im Bogen in die Düsternis empor und explodierte irgendwo über dem Wasser zu einem trüben Licht, das eine Zeitlang am Himmel hing.“"
                                            },
                                            {
                                                "example_id": "de138184-5710-45b3-9ea8-72d226d1a223",
                                                "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                                                "text": "„Mein Weg kreuzte den Strom der Automobile, das Zischen und Knurren ihrer Reifen, den stotternden Donner der Motorbremsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
