                    "sense_id": "2a40bd0f-b33e-35c2-963d-d1ce1d11fc0a",
                    "sense_definition": "A dairy product made from curdled or cultured milk.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dairy",
                    "name_type": "no",
                    "examples": [
