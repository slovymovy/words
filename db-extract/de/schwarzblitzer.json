                ],
                "senses": [
                    {
                        "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                        "entry_id": "01223501-7fba-35bc-b914-6433cb3b2eb4",
                        "glosses": [
                            "im Straßenverkehr eingesetztes Blitzgerät, dessen Blitz für das menschliche Auge nicht sichtbar ist, zum Erfassen von Verstößen gegen die Straßenverkehrsordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c24d0f7-8a07-4ae9-b6b2-ea5a8a9d7617",
                                "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                                "text": "„In dem unfallträchtigen Tunnel hatte die Senatsverwaltung für Stadtentwicklung im Auftrag der Polizei im Frühjahr eine neuartige Überwachungsanlage installiert, die mit Infrarotlicht arbeitet. […] Insgesamt wurden 16 sogenannte Schwarzblitzer und 16 Kameras eingebaut und Sensorstreifen in beiden Richtungen verlegt.“"
                            },
                            {
                                "example_id": "10d2db66-bc3b-4e2b-bdce-2efbe2e19826",
                                "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                                "text": "„Diese Technik darf nicht zu einem Sicherheitsrisiko werden. Aber genau das passiert schnell, wenn es plötzlich einen Lichtblitz im Tunnel gibt und das mitten im Kolonnenverkehr. In dem Fall ist die Geschwindigkeitsüberwachung nur eine zusätzliche Gefahr. Deshalb werden gerade in Tunneln häufig Schwarzblitzer eingesetzt.“"
                            },
                            {
                                "example_id": "052d6345-1bdb-4a46-a8a4-9a37ecc4855a",
                                "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                                "text": "„Eine besonders böse Falle sind die Schwarzblitzer im Autotunnel Ortskern Britz. Sie arbeiten mit Infrarotlicht, das fürs menschliche Auge nicht sichtbar ist und so Schreckreaktionen der Geblitzten verhindern soll.“"
                            },
                            {
                                "example_id": "7b500fcc-ea69-4446-ad31-a6e68599f7e7",
                                "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                                "text": "Zwölf dieser Anlagen werden dieser Tage im 1,7 Kilometer langen Autobahntunnel Britz (Berlin-Neukölln) installiert, wobei jede Spur von zwei Schwarzblitzern überwacht wird."
                            },
                            {
                                "example_id": "3ed10b74-a098-4d4f-bdf3-8cf6c2671a35",
                                "sense_id": "390189e0-48ec-36b9-ac05-4b91c1fe954d",
                                "text": "Ein so genannter Schwarzblitzer wird gegenwärtig im Polizeischutzbereich getestet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
