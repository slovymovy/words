                ],
                "senses": [
                    {
                        "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                        "entry_id": "5d7985cf-2f8c-3f90-bf15-a785e88bab14",
                        "glosses": [
                            "Se brancher soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d54616d-370f-4dc5-91f9-6aa976d299e0",
                                "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                                "text": "Gloire au Lip-daube du PaRaDem qui m'offre l'occasion de m'auto-brancher sur défibrillateur..."
                            },
                            {
                                "example_id": "87814b44-c80b-4ccd-9dce-47bdf2497491",
                                "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                                "text": "Dans des sociétés devenues folles de se désirer transparentes à force de s’auto-brancher en courant continu et à flux tendu il n’y a plus de place pour des asiles de paix, de vie et de vérité."
                            },
                            {
                                "example_id": "7491064a-697f-44b2-9e50-e164b048ac70",
                                "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                                "text": "L'autre point serait comment auto-brancher le milieu de la recherche sur lui-même, interconnecter, réseauter organiquement les chercheurs, les amateurs, les non-experts."
                            },
                            {
                                "example_id": "c7a521bd-e82f-4efc-bad4-624f8566afbd",
                                "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                                "text": "Ils ont du s'auto-brancher tous les 2!!!!"
                            },
                            {
                                "example_id": "f6e37d32-2ba7-4765-b8a9-70bfa395464a",
                                "sense_id": "9eae488e-c2a4-3234-9330-2ad97c208185",
                                "text": "Un clavier capable de s'auto brancher."
                            }
                        ]
                    }
