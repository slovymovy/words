                                        "entry_id": "f1ae3e6b-dba3-3374-894e-601498fb8ca3",
                                        "glosses": [
                                            "Qualifie une chevelure rousse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022cfdc9-02aa-4bfc-bbb3-15cd7892ebed",
                                                "sense_id": "95d53ecd-dda8-38f3-90df-b84a441fcf0d",
                                                "text": "Lizzie était maigre comme un clou. Cinquante kilos toute mouillée, des cheveux poil de carotte, des dents de lapin et de grosses lunettes. Un véritable épouvantail à moineaux !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
