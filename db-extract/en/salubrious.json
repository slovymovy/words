                                            {
                                                "example_id": "61ba730f-d145-4688-a3e2-a9fb3eab152d",
                                                "sense_id": "bf12c43c-e83c-3df2-9a88-f0b9d1476bdb",
                                                "text": "Das Essen war bekömmlich."
                                            },
                                            {
                                                "example_id": "acbdc043-4d7e-470b-9323-a5a84d747e15",
                                                "sense_id": "bf12c43c-e83c-3df2-9a88-f0b9d1476bdb",
                                                "text": "Um Kohl bekömmlicher zu machen, gibt man Kümmel hinzu."
                                            },
                                            {
                                                "example_id": "70fe8aa1-b4cb-43fa-93eb-062614900e29",
                                                "sense_id": "bf12c43c-e83c-3df2-9a88-f0b9d1476bdb",
                                                "text": "„Vom Verbot des § 9 Abs 1 lit a LMG sollen zwar allgemein verständliche, wahrheitsgemäße Angaben ausgenommen sein, die in der Anpreisung von Lebensmittel oft verwendet werden, wie schmackhaft, bekömmlich, leicht verdaulich, erfrischend, belebend, anregend, appetitanregend, süß, sauer, und dergleichen; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1e8346c-ac3a-476f-9108-3307aada2d9e",
                        "source_entry_id": "1f8c85ca-81eb-3767-84fe-6b0e18514150",
                        "source_sense_id": "5b2fd2d2-d4a3-3870-b4bc-f4d1e4fd4b88",
