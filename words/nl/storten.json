                {
                    "sense_id": "0ec5ec34-059f-30bc-a9e8-72625134d216",
                    "sense_definition": "Materiaal, zoals afval, puin of beton, in grote hoeveelheden ergens laten vallen of gieten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bouwvakkers <w>storten</w> het beton voor de fundering van het huis.",
                            "target_lang_translations": {
                                "en": "The construction workers are <w>pouring</w> the concrete for the house's foundation.",
                                "ru": "Строители <w>заливают</w> бетон для фундамента дома.",
                                "pl": "Robotnicy budowlani <w>wylewają</w> beton pod fundamenty domu."
                            }
                        },
                        {
                            "text": "Het is streng verboden om hier chemisch afval te <w>storten</w>.",
                            "target_lang_translations": {
                                "en": "It is strictly forbidden to <w>dump</w> chemical waste here.",
                                "ru": "Здесь строго запрещено <w>сбрасывать</w> химические отходы.",
                                "pl": "Surowo zabrania się <w>składowania</w> tutaj odpadów chemicznych."
                            }
