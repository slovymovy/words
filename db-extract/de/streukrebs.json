                        "examples": [
                            {
                                "example_id": "9b122daa-b6f2-4fad-8523-f11686aa4444",
                                "sense_id": "7d8e09f8-dbf5-305c-86ad-89a7ca5296d6",
                                "text": "„Obwohl er weiß, dass ein Streukrebs ihn nur noch wenige Monate leben lassen wird, versucht er trotz diverser Schwächeanfälle, auf dem Fernsehplateau den souveränen Spielleiter zu geben.“"
                            },
                            {
                                "example_id": "fc13a9d4-14d4-47c7-9e97-5d51e41f6cf1",
                                "sense_id": "7d8e09f8-dbf5-305c-86ad-89a7ca5296d6",
                                "text": "„Darauf hat der Streukrebs ihm die Frau genommen, und diese Frau war sein drittes Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
