                ],
                "senses": [
                    {
                        "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                        "entry_id": "04688a3c-4714-3521-b697-889767ebabd8",
                        "glosses": [
                            "Wort vor allem der politischen Auseinandersetzung, das eine parteiische Haltung/ Position (die des Sprechers/ Schreibers) mit einem positiv bewerteten Ausdruck wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10232c32-d674-4baf-be2b-2877f1e36e0c",
                                "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                                "text": "„Völkerschlacht nannte Karl Freiherr von Müffling…die große Leipziger Schlacht vom Oktober 1813 und schuf damit ein Fahnenwort von bleibender Geltung.“ Ladendorf (1906) scheint als erster diesen Ausdruck verwendet zu haben."
                            },
                            {
                                "example_id": "31aac587-a97a-4b88-9740-7f689875d362",
                                "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                                "text": "Ob etwas als Fahnenwort oder als Stigmawort aufgefasst wird, hängt ganz von der Einstellung des Sprechers/ Schreibers ab: Ein- und dasselbe Wort kann für Menschen mit verschiedenen Auffassungen das eine oder aber das andere sein."
                            },
                            {
                                "example_id": "49b99771-ec30-44f3-90bd-04592d864949",
                                "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                                "text": "Ein Werbeslogan der CDU hieß einmal: „Freiheit oder Sozialismus.“ Das kann man nur so verstehen, dass für die eigene Partei „Freiheit“ das Fahnenwort und „Sozialismus“ das Stigmawort sein sollte, während für politische Gegner genau das Umgekehrte unterstellt wurde."
                            },
                            {
                                "example_id": "1401bf93-d46e-4094-a7a4-dc96e1998d4d",
                                "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                                "text": "In Österreich wurde ein ganzes Forschungsprojekt zum Thema „Fahnenwörter der Politik“ durchgeführt und als Buch veröffentlicht."
                            },
                            {
                                "example_id": "e397c1b8-9091-4d91-ae18-a6042b5b8fb4",
                                "sense_id": "68580ff1-836f-3f1f-aae6-43b037da1e62",
                                "text": "„Als Fahnenwort sei der Begriff in der deutschen Sprache jedoch nie erfolgreich gewesen, zum Teil weil der Ausdruck fälschlicherweise oft als Nazi-Jargon betrachtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
