                "senses": [
                    {
                        "sense_id": "92c2f7a4-a012-31d9-b33b-6a71dff4e73f",
                        "entry_id": "b408f975-6ff2-3152-893e-5e1fc5929334",
                        "glosses": [
                            "Lively; active."
                        ],
                        "tags": [
                            "UK",
                            "US",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "c2e8d3d6-db21-4d54-b362-f11d0848b74c",
                                "sense_id": "92c2f7a4-a012-31d9-b33b-6a71dff4e73f",
                                "text": "1586, William Warner, Albion's England, Booke VI, Chapter XXXI, 1810, The Works of the English Poets, from Chaucer to Cowper, Volume IV, page 579,\nThere was a tricksie girle, I wot, // Albeit clad in gray, / As peart as bird, as straite as boult, // As fresh as flower in May."
                            },
                            {
                                "example_id": "2521eb95-3f68-4946-89da-c150960ad95e",
                                "sense_id": "92c2f7a4-a012-31d9-b33b-6a71dff4e73f",
                                "text": "I smiled; and she went on to say I looked a little more peart; maybe I would not be such a slow coach after all."
                            },
                            {
                                "example_id": "b5b1e08b-e0e2-401c-9917-2f1333d37fa8",
                                "sense_id": "92c2f7a4-a012-31d9-b33b-6a71dff4e73f",
                                "text": "\"[…]No young man could 'a' ben more peart and alive than that, Dotty.\""
                            },
                            {
                                "example_id": "e7ebae38-5697-4b05-803d-6cf7103b6f3b",
                                "sense_id": "92c2f7a4-a012-31d9-b33b-6a71dff4e73f",
                                "text": "\"Yore pa don't hold to card playin' but you needs to have quiet and rest. I'm pleased to see Annie's up to playin'. Baby looks a little more peart this mornin' too.\""
                            }
                        ]
                    }
                ],
