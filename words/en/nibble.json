                },
                {
                    "sense_id": "14433354-2020-32e0-93e5-9b31c478c6ee",
                    "sense_definition": "To reduce or use up something gradually, often followed by 'away at'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inflation continues to <w>nibble</w> away at the value of our savings.",
                            "target_lang_translations": {
                                "ru": "Инфляция продолжает <w>подтачивать</w> стоимость наших сбережений.",
                                "zh": "通货膨胀正在不断<w>蚕食</w>我们储蓄的价值。",
                                "fr": "L'inflation continue de <w>grignoter</w> la valeur de nos économies."
                            }
                        },
                        {
                            "text": "Small bank fees can <w>nibble</w> away at your monthly budget.",
                            "target_lang_translations": {
                                "ru": "Небольшие банковские комиссии могут <w>размывать</w> ваш ежемесячный бюджет.",
                                "zh": "小额银行手续费会不断<w>侵蚀</w>你的月度预算。",
                                "fr": "Les petits frais bancaires peuvent <w>grignoter</w> votre budget mensuel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble away at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно уменьшать или истощать запасы, ресурсы или стоимость.",
                        "zh": "指逐渐地消耗、减少或侵蚀某物（如资源、价值）。",
                        "fr": "Réduire ou consommer progressivement des ressources, des valeurs ou des budgets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтачивать",
                                "target_lang_sense_clarification": "постепенно уменьшать"
                            },
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "о ценности или бюджете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蚕食",
                                "target_lang_sense_clarification": "比喻逐渐侵占或消耗"
                            },
                            {
                                "target_lang_word": "侵蚀",
                                "target_lang_sense_clarification": "逐渐损害"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "grignoter",
                                "target_lang_sense_clarification": "réduire lentement"
                            },
                            {
                                "target_lang_word": "éroder",
                                "target_lang_sense_clarification": "diminuer progressivement"
                            },
                            {
                                "target_lang_word": "entamer",
                                "target_lang_sense_clarification": "diminuer une réserve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27dad292-afa4-33b4-bfcc-ca031d21d5f6",
                    "sense_definition": "To show a slight interest in something, such as a proposal or commercial opportunity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several investors started to <w>nibble</w> at the new tech startup's proposal.",
                            "target_lang_translations": {
                                "ru": "Несколько инвесторов начали <w>проявлять интерес</w> к предложению нового технологического стартапа.",
                                "zh": "几位投资者开始对这家科技初创公司的提案<w>感兴趣</w>。",
                                "fr": "Plusieurs investisseurs ont commencé à <w>s'intéresser</w> à la proposition de la nouvelle startup technologique."
                            }
                        },
                        {
                            "text": "We hope the buyers will <w>nibble</w> at the offer we made yesterday.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся, что покупатели <w>клюнут</w> на предложение, которое мы сделали вчера.",
                                "zh": "我们希望买家会对我们昨天提出的报价<w>感兴趣</w>。",
                                "fr": "Nous espérons que les acheteurs <w>mordront</w> à l'offre que nous avons faite hier."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble at the offer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять слабый интерес к предложению или коммерческой возможности.",
                        "zh": "指对某项提议或商业机会表现出初步的、谨慎的兴趣。",
                        "fr": "Montrer un intérêt léger ou préliminaire pour une proposition ou une opportunité."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявлять интерес",
                                "target_lang_sense_clarification": "осторожно интересоваться"
                            },
                            {
                                "target_lang_word": "клевать",
                                "target_lang_sense_clarification": "переносно о предложении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感兴趣",
                                "target_lang_sense_clarification": "初步的兴趣"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'intéresser",
                                "target_lang_sense_clarification": "montrer un intérêt prudent"
                            },
                            {
                                "target_lang_word": "mordre à l'hameçon",
                                "target_lang_sense_clarification": "se laisser tenter par une offre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8daaa40-dcd7-3cd1-b974-96ccfea89d49",
                    "sense_definition": "To make insignificant complaints or to find fault with minor details.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics began to <w>nibble</w> at the minor inconsistencies in the script.",
                            "target_lang_translations": {
                                "ru": "Критики начали <w>придираться</w> к мелким нестыковкам в сценарии.",
                                "zh": "评论家们开始对剧本中细微的不连贯之处<w>挑剔</w>起来。",
                                "fr": "Les critiques ont commencé à <w>chipoter</w> sur les incohérences mineures du scénario."
                            }
                        },
                        {
                            "text": "It is frustrating when colleagues <w>nibble</w> at every small detail of a project.",
                            "target_lang_translations": {
                                "ru": "Раздражает, когда коллеги <w>цепляются</w> к каждой мелкой детали проекта.",
                                "zh": "当同事对项目的每一个小细节都<w>吹毛求疵</w>时，真的很让人沮丧。",
                                "fr": "C'est frustrant quand les collègues <w>chipotent</w> sur chaque petit détail d'un projet."
                            }
                        }
                    ],
                    "synonyms": [
                        "niggle",
                        "piddle"
                    ],
                    "common_phrases": [
                        "nibble at details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывать незначительные жалобы или придираться к мелочам.",
                        "zh": "指对琐碎的细节进行挑剔或抱怨。",
                        "fr": "Faire des critiques insignifiantes ou trouver des défauts dans des détails mineurs."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придираться",
                                "target_lang_sense_clarification": "к мелким деталям"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "изводить мелкими замечаниями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "对细节不满"
                            },
                            {
                                "target_lang_word": "吹毛求疵",
                                "target_lang_sense_clarification": "过分挑剔"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "chipoter",
                                "target_lang_sense_clarification": "discuter sur des détails"
                            },
                            {
                                "target_lang_word": "ergoter",
                                "target_lang_sense_clarification": "discuter de façon pointilleuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650f2e29-ba52-3a35-be90-52cf5a65634a",
                    "sense_definition": "To catch or arrest someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>nibble</w> the thief just as he was leaving.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>сцапать</w> вора как раз в тот момент, когда он уходил.",
                                "zh": "警察在小偷离开时成功将其<w>抓获</w>。",
                                "fr": "La police a réussi à <w>choper</w> le voleur juste au moment où il partait."
                            }
                        },
                        {
                            "text": "He was worried the authorities would <w>nibble</w> him for his past crimes.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что власти <w>загребут</w> его за прошлые преступления.",
                                "zh": "他担心当局会因为他过去的罪行而将他<w>抓获</w>。",
                                "fr": "Il craignait que les autorités ne le <w>coincent</w> pour ses crimes passés."
                            }
                        }
                    ],
                    "synonyms": [
                        "nab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang for catching someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать или арестовать кого-либо (устаревший сленг).",
                        "zh": "指逮捕或抓住某人（俚语）。",
                        "fr": "Attraper ou arrêter quelqu'un (argot)."
