{
    "word_family": [
        "legendary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "777980fc-f9f1-3d7f-a98f-0feaa86a86de",
                    "sense_definition": "A traditional story from the past about famous people or events, which is not always true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "story_narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>legend</w> of King Arthur has been told for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Легенда</w> о короле Артуре рассказывается веками.",
                                "zh": "亚瑟王的<w>传说</w>已经流传了几个世纪。"
                            }
                        },
                        {
                            "text": "According to <w>legend</w>, a monster lives deep in the lake.",
                            "target_lang_translations": {
                                "ru": "Согласно <w>легенде</w>, глубоко в озере живет чудовище.",
                                "zh": "根据<w>传说</w>，湖的深处住着一只怪物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "myth",
                        "tall tale",
                        "folk tale",
                        "fable"
                    ],
                    "common_phrases": [
                        "urban legend",
                        "according to legend",
                        "ancient legend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная история из прошлого об известных людях или событиях, которая не всегда правдива.",
                        "zh": "关于过去著名人物或事件的传统故事，不一定真实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "история о чудесном или прошлом"
                            },
                            {
                                "target_lang_word": "предание",
                                "target_lang_sense_clarification": "устный рассказ, передающийся из поколения в поколение"
                            },
                            {
                                "target_lang_word": "сказание",
                                "target_lang_sense_clarification": "повествование исторического или легендарного содержания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传说",
                                "target_lang_sense_clarification": "关于过去著名人物或事件的传统故事，不一定真实"
                            },
                            {
                                "target_lang_word": "传奇故事",
                                "target_lang_sense_clarification": "带有历史或传奇色彩的民间叙事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "781c4b50-7e66-355c-91ce-ab7228827692",
                    "sense_definition": "A very famous and admired person, especially in a particular field.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person_ref",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a tennis <w>legend</w> who won many championships.",
                            "target_lang_translations": {
                                "ru": "Она — <w>легенда</w> тенниса, выигравшая множество чемпионатов.",
                                "zh": "她是一位网球<w>传奇人物</w>，赢得了许多锦标赛。"
                            }
                        },
                        {
                            "text": "The musician became a living <w>legend</w> before he turned thirty.",
                            "target_lang_translations": {
                                "ru": "Музыкант стал живой <w>легендой</w> еще до того, как ему исполнилось тридцать.",
                                "zh": "这位音乐家还不到三十岁就成了在世的<w>传奇人物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hero"
                    ],
                    "common_phrases": [
                        "living legend",
                        "sporting legend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень известный и уважаемый человек, особенно в определенной области.",
                        "zh": "非常有名且受人敬佩的人，尤其是在某个领域里。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "знаменитость, прославленный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传奇人物",
                                "target_lang_sense_clarification": "非常有名、备受敬佩的人，尤指某个领域中的人物"
                            },
                            {
                                "target_lang_word": "传奇",
                                "target_lang_sense_clarification": "口语中也可指某领域的传奇人物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa43486c-e85e-339a-ac55-8232b9b23b46",
                    "sense_definition": "An explanation of the symbols and colors used on a map or chart.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check the <w>legend</w> to see what the red lines on the map mean.",
                            "target_lang_translations": {
                                "ru": "Сверьтесь с <w>легендой</w>, чтобы узнать, что означают красные линии на карте.",
                                "zh": "查看<w>图例</w>，看看地图上的红线表示什么。"
                            }
                        },
                        {
                            "text": "The map <w>legend</w> indicates that the shaded areas are forests.",
                            "target_lang_translations": {
                                "ru": "<w>Легенда</w> карты указывает, что заштрихованные области — это леса.",
                                "zh": "地图<w>图例</w>显示，阴影区域是森林。"
                            }
                        }
                    ],
                    "synonyms": [
                        "key",
                        "guide"
                    ],
                    "common_phrases": [
                        "map legend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объяснение символов и цветов, используемых на карте или схеме.",
                        "zh": "地图或图表中对所用符号和颜色的说明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "пояснение к карте"
                            },
                            {
                                "target_lang_word": "условные обозначения",
                                "target_lang_sense_clarification": "знаки на карте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图例",
                                "target_lang_sense_clarification": "地图或图表中说明符号、颜色等含义的部分"
                            },
                            {
                                "target_lang_word": "图示说明",
                                "target_lang_sense_clarification": "较正式，指地图上的符号说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93de88e5-9543-3bd3-8918-3b52eeb0ebc3",
                    "sense_definition": "A very helpful, kind, or impressive person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_ref",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thanks for helping me move house, you are a <w>legend</w>!",
                            "target_lang_translations": {
                                "ru": "Спасибо, что помог мне с переездом, ты настоящий <w>герой</w>!",
                                "zh": "谢谢你帮我搬家，你真是个<w>大好人</w>！"
                            }
                        },
                        {
                            "text": "He bought everyone a drink at the party; what a <w>legend</w>.",
                            "target_lang_translations": {
                                "ru": "Он купил всем выпивку на вечеринке; ну что за <w>человек</w>.",
                                "zh": "他在聚会上给大家都买了酒，真是个<w>牛人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hero",
                        "brick"
                    ],
                    "common_phrases": [
                        "absolute legend"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in British and Australian English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень отзывчивый, добрый или впечатляющий человек.",
                        "zh": "非常帮忙、善良或令人佩服的人；常用于口语称赞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодчина",
                                "target_lang_sense_clarification": "разг.: отличный, очень полезный человек (you're a legend)"
                            },
                            {
                                "target_lang_word": "герой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大好人",
                                "target_lang_sense_clarification": "口语，指特别够意思、特别帮忙的人"
                            },
                            {
                                "target_lang_word": "牛人",
                                "target_lang_sense_clarification": "口语，指很厉害、很让人佩服的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0cbe3b-17a8-3975-9ed4-cd17943db348",
                    "sense_definition": "A false background story and identity created for a spy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "story_narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent spent years building his <w>legend</w> before entering the country.",
                            "target_lang_translations": {
                                "ru": "Агент потратил годы на создание своей <w>легенды</w> перед въездом в страну.",
                                "zh": "这名特工在入境前花了多年时间打造自己的<w>掩护身份</w>。"
                            }
                        },
                        {
                            "text": "His <w>legend</w> claimed he was a doctor working for an aid organization.",
                            "target_lang_translations": {
                                "ru": "Его <w>легенда</w> гласила, что он врач, работающий в гуманитарной организации.",
                                "zh": "他的<w>假身份</w>是一个为援助组织工作的医生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cover story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленная биография и личность, созданная для шпиона.",
                        "zh": "为间谍编造出来的虚假背景故事和身份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "прикрытие разведчика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掩护身份",
                                "target_lang_sense_clarification": "间谍为执行任务而建立的伪装身份和背景"
                            },
                            {
                                "target_lang_word": "假身份",
                                "target_lang_sense_clarification": "虚构出来用作掩护的身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e247722-64a6-3e09-a558-5fbce212d0fc",
                    "sense_definition": "Words written on a coin, medal, or below a picture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "text_explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coin bears the <w>legend</w> 'In God We Trust'.",
                            "target_lang_translations": {
                                "ru": "На монете выбита <w>легенда</w> 'In God We Trust'.",
                                "zh": "这枚硬币上刻着<w>铭文</w>“In God We Trust”。"
                            }
                        },
                        {
                            "text": "Read the <w>legend</w> beneath the engraving to understand the scene.",
                            "target_lang_translations": {
                                "ru": "Прочитайте <w>легенду</w> под гравюрой, чтобы понять сцену.",
                                "zh": "读一读版画下方的<w>题字</w>，就能理解这个场景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надпись на монете, медали или под изображением.",
                        "zh": "写在硬币、奖章上或图像下方的文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "надпись"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铭文",
                                "target_lang_sense_clarification": "刻在硬币、奖章等上的文字"
                            },
                            {
                                "target_lang_word": "题字",
                                "target_lang_sense_clarification": "写在图像下方或刻在物体上的文字"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fb471cf9-5a73-34f8-8298-44a3984a923a",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend named her newborn son <w>Legend</w>.",
                            "target_lang_translations": {
                                "ru": "Моя подруга назвала новорожденного сына <w>Ледженд</w>.",
                                "zh": "我朋友给她刚出生的儿子取名叫<w>莱真德</w>。"
                            }
                        },
                        {
                            "text": "<w>Legend</w> is becoming a more popular name in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Ледженд</w> становится все более популярным именем в последние годы.",
                                "zh": "<w>莱真德</w>这个名字近年来越来越常见。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя.",
                        "zh": "男性名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ледженд",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莱真德",
                                "target_lang_sense_clarification": "男性名字的音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c6fa7b7-f4de-3eda-971b-f9286a37c10f",
                    "sense_definition": "To tell a story or narrate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet <w>legended</w> the tales of old knights and battles.",
                            "target_lang_translations": {
                                "ru": "Поэт <w>слагал легенды</w> о старых рыцарях и битвах.",
                                "zh": "诗人<w>讲述</w>了古代骑士和战斗的故事。"
                            }
                        },
                        {
                            "text": "He <w>legended</w> out the history of his people in rhyme.",
                            "target_lang_translations": {
                                "ru": "Он <w>изложил в легенде</w> историю своего народа в стихах.",
                                "zh": "他用押韵的方式<w>叙述</w>了自己民族的历史。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассказывать историю или повествовать.",
                        "zh": "讲故事，叙述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слагать легенды",
                                "target_lang_sense_clarification": "рассказывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讲述",
                                "target_lang_sense_clarification": "古语，指讲述故事或传述事迹"
                            },
                            {
                                "target_lang_word": "叙述",
                                "target_lang_sense_clarification": "较书面，指叙说、铺陈故事"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}