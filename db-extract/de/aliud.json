                "senses": [
                    {
                        "sense_id": "393c12a9-d3e0-3189-b5ef-8546f60c8026",
                        "entry_id": "50e99cdf-c21d-388e-ad87-8fcaefb8626b",
                        "glosses": [
                            "Falschleistung, also zum Beispiel ein gelieferter Gegenstand, der nicht der bestellten und vereinbarten Gattung angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d359ebd-b008-42f8-b953-f86d06143996",
                                "sense_id": "393c12a9-d3e0-3189-b5ef-8546f60c8026",
                                "text": "„Akzeptiert der Gläubiger das Aliud in Kenntnis der Umstände als schuldgemäße, entfällt der Tatbestand der Nichtleistung […].“"
                            },
                            {
                                "example_id": "c61b9394-af6c-47a6-a6ef-0193166f7f90",
                                "sense_id": "393c12a9-d3e0-3189-b5ef-8546f60c8026",
                                "text": "„Das aliud war jedenfalls zunächst nicht die Sache, die geschuldet wurde.“"
                            },
                            {
                                "example_id": "0d13c794-7156-4a85-be3c-6a0c9c0eb584",
                                "sense_id": "393c12a9-d3e0-3189-b5ef-8546f60c8026",
                                "text": "„Kann der Verkäufer die Sache nicht zurückfordern, so stellt sich die Frage, ob der Käufer einen eventuellen Mehrwert des aliuds bezahlen muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
