                "senses": [
                    {
                        "sense_id": "b41496f3-c575-3a03-8a85-4b64531d8de6",
                        "entry_id": "b3659cc7-8259-3953-acff-7470e9d545cd",
                        "glosses": [
                            "kleine Lacke, Pfütze"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "557cd19e-41c5-4b91-b4da-aa5e49f89372",
                                "sense_id": "b41496f3-c575-3a03-8a85-4b64531d8de6",
                                "text": "„‚Land unter‘ hieß es am Eröffnungstag um 13:30 Uhr, und das obwohl beim Lokalaugenschein vor Ort kein noch so kleines ‚Lackerl‘ auf den Courts auszumachen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "16db4476-5bf0-32b6-ae30-3c316fa0685d",
                        "entry_id": "b3659cc7-8259-3953-acff-7470e9d545cd",
                        "glosses": [
                            "kleine Lacke Urin, besonders Tierurin"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "578375df-7d6d-4293-863e-9ef84fc62fd1",
                                "sense_id": "16db4476-5bf0-32b6-ae30-3c316fa0685d",
                                "text": "„Ein Lackerl da, ein Haufen dort - und schon ist man hineingetreten“"
                            },
                            {
                                "example_id": "12bf8136-ee90-477e-9a0c-f5e4ddf22aa4",
                                "sense_id": "16db4476-5bf0-32b6-ae30-3c316fa0685d",
                                "text": "„Es kann ziemlich frustrierend sein, wenn trotz aller Bemühungen doch wieder ein Lackerl danebengeht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6017834a-b1aa-3e46-b67f-d1e33244c9e5",
                        "entry_id": "b3659cc7-8259-3953-acff-7470e9d545cd",
                        "glosses": [
                            "kleine Menge Flüssigkeit, Flüssigkeitsrest im Trinkglas"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba2319e-6368-40db-b5f8-84ba714b5f43",
                                "sense_id": "6017834a-b1aa-3e46-b67f-d1e33244c9e5",
                                "text": "„Ihren Ex habe sie dann mit einem ‚Lackerl‘ angeschüttet, weil er im Zorn eine neue Topfpflanze zerstört hatte.“"
                            },
                            {
                                "example_id": "5c18030f-34eb-4dfd-aba0-3ad721016b7f",
                                "sense_id": "6017834a-b1aa-3e46-b67f-d1e33244c9e5",
                                "text": "„Sackerl fürs Lackerl in Flugzeugen läuft aus“"
                            },
                            {
                                "example_id": "94e9b988-24c8-4ea8-be67-723eb3d859f0",
                                "sense_id": "6017834a-b1aa-3e46-b67f-d1e33244c9e5",
                                "text": "„Pfiat di, Lackerl!“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
