                    },
                    {
                        "translation_id": "5e1bb1e2-ecf8-4e65-97e0-4e77dce23a61",
                        "source_entry_id": "8b061476-4fb1-30ec-8628-ba3993071d91",
                        "source_sense_description": "fish of the family Molidae",
                        "target_lang_word": "maanvis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maanvis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "27a059df-dc65-3413-b6ac-67160410f84c",
                                        "entry_id": "fb7608ca-6eb6-392a-874a-600bd93b0f1d",
                                        "glosses": [
                                            "bepaald soort grote schijfvormige zeevis, Mola mola"
                                        ],
                                        "tags": [
                                            "straalvinnigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b1ef4d-c720-4a0e-88a2-38ef60ad2058",
                                                "sense_id": "27a059df-dc65-3413-b6ac-67160410f84c",
                                                "text": "De maanvis of klompvis (Mola mola) is de zwaarst bekende beenvis. Een volwassen dier weegt gemiddeld 1 ton en is 1,8 meter groot. De maanvis, niet gevaarlijk voor mensen, is bedekt met parasieten. De berijder uit het filmpje hield dan ook een pijnlijke jeuk over aan zijn gedenkwaardige rit."
                                            },
                                            {
                                                "example_id": "0c3bacba-4e6b-48d7-99a0-12bc51762920",
                                                "sense_id": "27a059df-dc65-3413-b6ac-67160410f84c",
                                                "text": "Volgens Ecomare is het heel bijzonder om in de zomer een levende maanvis voor de Nederlandse kust te zien. In de winter spoelt wel eens een dode aan."
                                            },
                                            {
                                                "example_id": "b67ba1f8-01d6-4bbd-8f6e-36273fbcafe3",
                                                "sense_id": "27a059df-dc65-3413-b6ac-67160410f84c",
                                                "text": "Dit jaar worden honderden vissen de lucht in gelaten; en alle kleuren en maten. Sommige, zoals de walvissen, zijn wel dertig meter lang. Maar er worden ook roggen, inktvissen met lange tentakels, ronde maanvissen, kreeften, een 48 meter lange octopus en salamanders opgelaten. De Megabite vlieger is ongetwijfeld de eyecatchers van het Festival. Het is de grootste vlieger in Europa, ooit door de legendarische vliegeraar Peter Llyn in Nieuw Zeeland gemaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3c0460-c794-3e0a-872f-645b2e66588c",
                                        "entry_id": "fb7608ca-6eb6-392a-874a-600bd93b0f1d",
                                        "glosses": [
                                            "bepaald soort aquariumvis Pterophyllum scalare"
                                        ],
                                        "tags": [
                                            "straalvinnigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c86647ae-c81d-4086-adac-b4c903a0dad4",
                                                "sense_id": "0d3c0460-c794-3e0a-872f-645b2e66588c",
                                                "text": "De maanvis in het aquarium van Lenno is gedurende de film zowel een klankbord als spiegel voor zijn worstelingen en gedachten"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ae20ac5-8d17-4cff-a216-c44b025831e9",
                        "source_entry_id": "8b061476-4fb1-30ec-8628-ba3993071d91",
                        "source_sense_description": "fish of the family Molidae",
                        "target_lang_word": "môle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "môle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                        "entry_id": "dad1dbf2-7948-392e-a2a7-d1d2955af87b",
                                        "glosses": [
                                            "Massif de maçonnerie construit à l’extrémité d’une jetée, à l’entrée d’un port."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159a4d6b-65d8-4f37-aaf8-a62d9b6fab5c",
                                                "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                                "text": "À quatre heures, nous étions sur le môle, cherchant une barque et un patron pour faire le trajet du quai au navire, quinze ou vingt minutes tout au plus."
                                            },
                                            {
                                                "example_id": "4bd9c9f7-26ef-4377-9843-9f664291a8cc",
                                                "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                                "text": "Il y a plus encore : au sortir du port de Zeebrugge, dans la nuit, un yacht, naviguant tous feux éteints, me croisa au large du môle."
                                            },
                                            {
                                                "example_id": "6a8429f2-f6df-47d9-8e5e-e065c32f0574",
                                                "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                                "text": "Le premier soir des vacances, Antoine vêtu des libres vêtements de l’été partait avec Pierre sur le port : des pêcheurs marchaient sur le môle, lents à se mouvoir, difficiles à ébranler."
                                            },
                                            {
                                                "example_id": "7ab608e6-b4e8-4708-871e-8fe6bfa4a16d",
                                                "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                                "text": "Cependant, une fois le premier môle dépassé, lorsqu’ils atteignirent le deuxième bassin des remorqueurs, au-dessus duquel habitait Mademoiselle Giraud, il s’effraya."
                                            },
                                            {
                                                "example_id": "89c94fff-1045-42ad-a600-b7ce9201fa05",
                                                "sense_id": "e64fecff-fb7d-32e1-bc6d-580e46667f34",
                                                "text": "Arrivé à Québec, Ferrer pris un taxi de marque Subaru en direction du port, département des garde-côtiers, môle 11."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50c5d97-649f-38e9-8a70-f10e0572ebb2",
                                        "entry_id": "dad1dbf2-7948-392e-a2a7-d1d2955af87b",
                                        "glosses": [
                                            "Massif de maçonnerie destiné à détourner le cours d'une rivière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc690b0f-9434-462a-b06b-df7145ebfcb7",
                                                "sense_id": "f50c5d97-649f-38e9-8a70-f10e0572ebb2",
                                                "text": "La rivière, fermée par un long môle qui rejetait les courants sur la rive opposée, formait un étang d’une eau vaseuse et noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f0a75-0113-34ef-a00d-dacb43a6025d",
                                        "entry_id": "dad1dbf2-7948-392e-a2a7-d1d2955af87b",
                                        "glosses": [
                                            "Construction massive."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec7d5864-d0b9-4310-8cab-663a7c8af094",
                                                "sense_id": "b82f0a75-0113-34ef-a00d-dacb43a6025d",
                                                "text": "Le môle d’Adrien, à Rome, désigne le tombeau de cet empereur."
                                            },
                                            {
                                                "example_id": "1bec1676-ded0-4cf1-ad18-63a8f050315c",
                                                "sense_id": "b82f0a75-0113-34ef-a00d-dacb43a6025d",
                                                "text": "Surtout, elle accuse un retard extrêmement marqué auprès des retraités, des cadres et des personnes diplômées à partir d’une licence, qui forment des môles électoraux démographiquement importants voire croissants, dont la participation est plus élevée que la moyenne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "môle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28520ce6-6457-366a-a1f5-44a7e10f0a0d",
                                        "entry_id": "5c5d7e05-b080-3061-95b8-aefab3f0e883",
                                        "glosses": [
                                            "Désigne différents corps pouvant être expulsés de l’utérus (polypes, caillots, fibromyomes, etc.)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d508469d-1e96-3baa-a340-d859ec4ab3b3",
                                        "entry_id": "5c5d7e05-b080-3061-95b8-aefab3f0e883",
                                        "glosses": [
                                            "Dégénérescence kystique des villosités choriales, ayant l’aspect d’un amas de petites vésicules, reliées de petits filaments et enveloppés d’une membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f48a427-1183-4844-8b07-c7a35b0db322",
                                                "sense_id": "d508469d-1e96-3baa-a340-d859ec4ab3b3",
                                                "text": "Môle hydatiforme, môle invasive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d63250-7fe0-3781-a11b-f4ceffcee3bd",
                                        "entry_id": "5c5d7e05-b080-3061-95b8-aefab3f0e883",
                                        "glosses": [
                                            "Maladie des champignons de couche, causée par un champignon sphériacé, l’Hypomycea perniciosus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de59907b-2c79-32bc-a05e-c3ee11e6b0dc",
