                    {
                        "form_id": "0528fe66-a59e-4b0c-878e-29a0977e7c72",
                        "entry_id": "308e6b6e-f0bd-3fcb-9da3-5e97f13376e9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Feinstäube"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                        "entry_id": "308e6b6e-f0bd-3fcb-9da3-5e97f13376e9",
                        "glosses": [
                            "sehr feiner, mit bloßem Auge nicht sichtbarer Staub in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b129a0fe-7a31-4fb2-84f7-ff0babd96e21",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Am Institutsstandort in Leipzig selbst wurden nicht einmal hundert Mikrogramm Feinstaub pro Kubikmeter gemessen.“"
                            },
                            {
                                "example_id": "6c6629e7-c6f1-472e-becb-7e48c5b50c4f",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Man kann sie nicht riechen, man kann sie nicht schmecken und mit bloßem Auge sind Feinstäube auch nicht zu sehen. Feinstäube – das sind winzige Partikel, die nicht einmal ein Zehntel des Durchmessers eines Haares erreichen.“"
                            },
                            {
                                "example_id": "5a5f8074-4130-4bf5-97ae-92d365fe7c01",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„In Deutschland gehen 26 Prozent des Feinstaubs und 44 Prozent des Rußaufkommens auf den sogenannten Hausbrand aus Kaminen und Öfen zurück.“"
                            },
                            {
                                "example_id": "0bc7dcb4-1276-4f06-a0db-6ee2c1db06d2",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Er atmet den Feinstaub jeden Tag ein, denn mit seinem alten Schießprügel bewacht er die neuen Maschinen, die seit drei Jahren die Straße in den Fels treiben.“"
                            },
                            {
                                "example_id": "c6422490-2266-4ecc-9cd7-82c9a4daf1f1",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Die größten Verursacher von Feinstaub sind die Industrie, der Verkehr, die Landwirtschaft und die Kleinverbraucher.“"
                            },
                            {
                                "example_id": "bfb37931-340c-445d-9b65-b7f7ac5445a7",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„In Deutschland ist die Belastung mit Feinstaub sowohl im urbanen als auch im ländlichen Bereich deutlich zurückgegangen.“"
                            },
                            {
                                "example_id": "95957945-ef5d-4bf2-a1ee-29a8491a84f4",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Feinstaub fördert die Entwicklung von Lungentumoren.“"
                            },
                            {
                                "example_id": "ccd1a86f-46a2-4a05-a870-8cf947bb00a9",
                                "sense_id": "9c815ea8-fbf8-3596-919f-dbee56829844",
                                "text": "„Holzkohlen-Qualm belastet die Atemluft am Grill und in der Nachbarschaft mit Feinstaub und Ruß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
