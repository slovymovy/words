                    },
                    {
                        "translation_id": "08648734-3224-4bbc-b418-0c27270da085",
                        "source_entry_id": "2fab23ac-bf87-3c6b-8471-9ddd798bdbcb",
                        "source_sense_description": "study of the physical universe beyond the Earth's atmosphere",
                        "target_lang_word": "Astronomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astronomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "Sternkunde, Himmelskunde als exakte Naturwissenschaft"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5706cb-c14c-49c7-bed2-0a758ce1d593",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "Mit der Astronomie sehr eng verbunden ist die Physik."
                                            },
                                            {
                                                "example_id": "3b440b53-ebc0-45f9-8efc-c2abbcce4dba",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Mystische Anschauung der Astrologie und exakte Wissenschaft der Astronomie lassen sich zwar formell trennen, sie bilden jedoch in der Geistesgeschichte der Menschheit seit jeher eine eigentümliche Verquickung, die auch heutzutage noch zu den seltsamsten Ergebnissen führt.“"
                                            },
                                            {
                                                "example_id": "2ae5f1fe-7610-4dec-9208-1a7e49e34ca3",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Monsieur sagte recht verständig, die Astrologie sei als Wissenschaft auf jeden Fall sehr anrüchig, wenn nicht falsch; er habe sich einige Zeit damit beschäftigt, habe es aber schließlich aufgegeben und sich mit den unbezweifelbaren Wahrheiten begnügt, die die Astronomie ihn lehre.“"
                                            },
                                            {
                                                "example_id": "7cd86d60-cfd0-4d67-ba2e-f24aa8a3a35b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Im frühen 16. Jahrhundert gehörten Mineralogie, Alchemie, Astrologie und Astronomie zusammen.“"
                                            },
                                            {
                                                "example_id": "94f005d8-8c67-4362-b073-f38c078ce81b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "ein Unterrichtsfach"
                                        ],
                                        "tags": [
                                            "Schulwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81df49a4-9e35-4604-8a0f-1cdec2f9fe4b",
                                                "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                                "text": "Leider wird nur an sehr wenigen Schulen Astronomie unterrichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3110e1c6-57ce-4466-94cb-e6aad5342cf1",
                        "source_entry_id": "2fab23ac-bf87-3c6b-8471-9ddd798bdbcb",
                        "source_sense_description": "study of the physical universe beyond the Earth's atmosphere",
                        "target_lang_word": "Sternkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sternkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6239511-d879-3058-8a7a-fd2bda98073d",
                                        "entry_id": "266ec3e5-df6d-3770-be95-099cdd988b35",
                                        "glosses": [
                                            "die Wissenschaft von den Gestirnen (Astronomie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bce436a-f4a5-46da-a126-2258eead365d",
                                                "sense_id": "c6239511-d879-3058-8a7a-fd2bda98073d",
                                                "text": "„Zwar gibt es im deutschen Sprachraum nur etwa 800 Berufsastronomen, aber um sie herum flimmert eine ganze Milchstraße von Amateurastronomen und begeisterten Laien der Sternkunde.“"
                                            },
                                            {
                                                "example_id": "7ab3a671-e800-4311-a127-82874dec717a",
                                                "sense_id": "c6239511-d879-3058-8a7a-fd2bda98073d",
                                                "text": "„Sehr artig wär's, wenn Du doch einmal Deine Träume gern näher überlegst, die Nacht drauf in einem neuen Traum den vorigen zu bedenken, bei Tag aber recht lustig und vergnügt und fleißig zu sein, denn sonst läufst Du Gefahr, einem gewissen Mann ähnlich zu werden, der sehr bewandert in der Sternkunde war und alle Augenblicke in einen Graben fiel, ja endlich elendiglich in einem Brunnen ersoffen ist, weil er immer gen Himmel guckte“."
                                            },
                                            {
                                                "example_id": "a3ffeb84-3385-4981-a72d-72829454e30a",
                                                "sense_id": "c6239511-d879-3058-8a7a-fd2bda98073d",
                                                "text": "„Astrologische Symbole weisen darauf hin, dass der Mithraismus Sternkunde mit Religion verknüpfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
