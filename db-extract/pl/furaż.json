                ],
                "senses": [
                    {
                        "sense_id": "8e3f8751-81e6-34c5-8b3b-03ecf3d1c4e5",
                        "entry_id": "6c5b78ff-1b1c-3daa-98d5-94257a3ce4da",
                        "glosses": [
                            "obrok (pasza) dla koni wojskowych"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b39a1134-1d88-435e-b10f-5e2aa5aac68b",
                                "sense_id": "8e3f8751-81e6-34c5-8b3b-03ecf3d1c4e5",
                                "text": "Dlatego żandarmi pełnili służbę we własnym departamencie, nie pobierając żołdu. Wydawano im jedynie z magazynów państwowych żywność i furaż, czyli paszę i obrok dla koni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00c4a946-1fe9-4b62-a521-f89b0a478b99",
                        "source_entry_id": "6c5b78ff-1b1c-3daa-98d5-94257a3ce4da",
                        "source_sense_id": "8e3f8751-81e6-34c5-8b3b-03ecf3d1c4e5",
                        "target_lang_word": "fourrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a91f06bb-6a00-369c-92ea-7df93693116d",
                                        "entry_id": "4a301604-2dc7-3118-ad04-5d830031a6ab",
                                        "glosses": [
                                            "Paille, foin et toute autre espèce d’herbe qu’on donne pour nourriture aux bestiaux, aux chevaux, etc., lorsqu’on ne les fait pas paître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3bbd81c-df00-4911-b647-283acb4f40ac",
                                                "sense_id": "a91f06bb-6a00-369c-92ea-7df93693116d",
                                                "text": "Les prairies sont assez vastes ; elles occupent le fond de la vallée et toutes les parties facilement irrigables. Elles fournissent des fourrages abondants et très réputés que l'on exporte."
                                            },
                                            {
                                                "example_id": "1c8e66f2-2941-4794-9768-5b83b132f36e",
                                                "sense_id": "a91f06bb-6a00-369c-92ea-7df93693116d",
                                                "text": "Les herbes, nourriture première des herbivores, sont de qualité différente selon les lieux qui les produisent, et les fourrages ne sont pas également composés partout."
                                            },
                                            {
                                                "example_id": "94b8563f-9f72-41f6-9e8f-85b0263b0ff1",
                                                "sense_id": "a91f06bb-6a00-369c-92ea-7df93693116d",
                                                "text": "Le chameau remplace, au Maroc, le chemin de fer et les voitures. […] ; il se nourrit des herbes qu’il parvient à happer le long de la route ; à l’étape, on lui donne de la paille ou du fourrage vert et une ration d’orge tous les trois jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75accb2f-77a9-31c0-93c4-51f611364132",
                                        "entry_id": "4a301604-2dc7-3118-ad04-5d830031a6ab",
                                        "glosses": [
                                            "Provisions pour les chevaux de l’armée."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "792fd8c2-9dd3-4cb4-bc9e-c01a12ebf1c0",
                                                "sense_id": "75accb2f-77a9-31c0-93c4-51f611364132",
                                                "text": "Dans son arrondissement, le 3ᵉ corps vivait au jour le jour ; il s'adressa, pour avoir des fourrages, à M. le sous-préfet de Mauléon, qui, nuit et jour à cheval, parcourait son arrondissement pour obtenir et faire transporter les denrées nécessaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eebc8ab8-a2b1-361a-8af9-9b67b2365710",
                                        "entry_id": "4a301604-2dc7-3118-ad04-5d830031a6ab",
                                        "glosses": [
                                            "Foin ou herbe qui servait autrefois à bourrer les canons."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fourrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d390cda1-a3b3-33a7-a575-863ff0f16c92",
                                        "entry_id": "54fa102b-a77c-34dd-b56e-220b7e4fca17",
                                        "glosses": [
                                            "Action de fourrer, de doubler de fourrure, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf04ca1c-f2a7-4a84-bbc3-76b947cbe11a",
                                                "sense_id": "d390cda1-a3b3-33a7-a575-863ff0f16c92",
                                                "text": "Le fourrage d’un manteau."
                                            },
                                            {
                                                "example_id": "e0ef9ba3-f401-4815-9768-ad09dc820679",
                                                "sense_id": "d390cda1-a3b3-33a7-a575-863ff0f16c92",
                                                "text": "Il a fait mettre un fourrage à son pardessus."
                                            }
                                        ]
                                    },
                                    {
