                "senses": [
                    {
                        "sense_id": "348ad5af-2e58-3278-aea0-64731989d931",
                        "entry_id": "83b27cd6-1bfc-306a-8694-8da639912739",
                        "glosses": [
                            "Démonter, bousiller."
                        ],
                        "tags": [
                            "very-familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3ac44fb4-b17a-4a0e-a843-ec65fcc2c887",
                                "sense_id": "348ad5af-2e58-3278-aea0-64731989d931",
                                "text": "Je me demande vraiment pourquoi il a encore décidé de déconcrisser un système qui fonctionne super-bien."
                            },
                            {
                                "example_id": "ef2dfb94-032c-4351-9d82-e290f8d2d39f",
                                "sense_id": "348ad5af-2e58-3278-aea0-64731989d931",
                                "text": "Quand il s'est en allé il l'a laissé tout déconcrissé."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a1f0f28-fca7-345d-b795-ab1588f6018b",
                        "entry_id": "83b27cd6-1bfc-306a-8694-8da639912739",
                        "glosses": [
                            "S'en aller, partir."
                        ],
                        "tags": [
                            "very-familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "686ba9fa-6b61-4b95-86aa-7b3d5d0939f1",
                                "sense_id": "8a1f0f28-fca7-345d-b795-ab1588f6018b",
                                "text": "Il viens juste de déconcrisser par là-bas."
                            },
                            {
                                "example_id": "11fe2b75-86fe-458b-b3a0-e2c0cd892a74",
                                "sense_id": "8a1f0f28-fca7-345d-b795-ab1588f6018b",
                                "text": "Si tu ne déconcrisse pas tout de suite tu ne vas pas la trouver drôle."
                            }
                        ]
                    }
