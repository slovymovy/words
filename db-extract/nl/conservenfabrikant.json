                        "glosses": [
                            "bedrijf dat levensmiddelen conserveert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03414839-3415-4bd9-8e65-87fec8bd0dc0",
                                "sense_id": "b2d96fc9-eb0c-36b3-885f-c944409d26ff",
                                "text": "Conservenfabrikant Hak, die zelf nog in Nederland teelt, onderschrijft dat. \"Het areaal groenten en peulvruchten in Nederland is ruim tien jaar geleden fors teruggegaan door de sluiting van bedrijven als Burcht, Ruiten Troef en Jonker Fris\", zegt een woordvoerder. Buitenlandse telers hebben volgens Hak een belangrijk deel hiervan overgenomen. Ook telen Nederlandse bedrijven vaker in het buitenland."
                            },
                            {
                                "example_id": "a04d4319-0fad-45db-8186-de24451004c7",
                                "sense_id": "b2d96fc9-eb0c-36b3-885f-c944409d26ff",
                                "text": "Groenten- en peulvruchtenbedrijf HAK gaat de productie vanaf januari zes weken stilleggen. Met de huidige energieprijzen is het niet haalbaar om in de winter door te produceren, zegt de conservenfabrikant, die als marktleider vooral bekend is van de glazen potten appelmoes, doperwten en bruine bonen."
                            }
                        ]
                    }
