                ],
                "senses": [
                    {
                        "sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                        "entry_id": "c70f3758-a4ee-31da-bf0f-5fe4f30d146d",
                        "glosses": [
                            "Verhalten, unangenehme, jedoch notwendige Arbeiten und Entscheidungen aufzuschieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb34c11-336c-4b96-ab9a-8d973f42e38d",
                                "sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                                "text": "Erst wenn die Aufschieberitis chronisch wird und jemand gewohnheitsmäßig Aufgaben vertagt, die eigentlich erledigt werden müssen, spricht man von Prokrastination."
                            },
                            {
                                "example_id": "0f402a05-32e2-411f-80e4-6676b5499747",
                                "sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                                "text": "Seit etwa 15 Jahren nehmen sich Psychologie und Psychiatrie immer mehr dieses Themas an – eigentlich erstaunlich spät für ein Phänomen, das bereits seit dem 16. Jahrhundert einen Namen hat: Prokrastination."
                            },
                            {
                                "example_id": "c0364162-2938-417f-bb70-f6bf307dc4e8",
                                "sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                                "text": "Prokrastination kann sich auch als Teil einer psychischen Störung wie einer Depression, einer Angststörung, einer Aufmerksamkeitsdefizit-Hyperaktivitätsstörung (ADHS) oder einer Psychose äußern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56c6104-27f8-4c3c-b571-5ca943e46765",
                        "source_entry_id": "c70f3758-a4ee-31da-bf0f-5fe4f30d146d",
                        "source_sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                        "source_sense_description": "Psychologie: Verhalten, unangenehme, jedoch notwendige Arbeiten und Entscheidungen aufzuschieben",
                        "target_lang_word": "procrastination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procrastination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad20e20-5fdf-3ac7-8c51-20cabadfd6aa",
                                        "entry_id": "fdb7a8e4-062e-3cc6-82fc-f435ea9c5232",
                                        "glosses": [
                                            "The act of postponing, delaying or putting off, especially habitually or intentionally."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3289719a-ce34-43d8-ae3d-ae82e30881fd",
                                                "sense_id": "9ad20e20-5fdf-3ac7-8c51-20cabadfd6aa",
                                                "text": "Procrastination is the thief of time; year after year it steals until all are fled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "070ff362-5872-4d83-886b-911099c9ce14",
                        "source_entry_id": "c70f3758-a4ee-31da-bf0f-5fe4f30d146d",
                        "source_sense_id": "4f1427d1-158c-33a6-b35d-01b38f8dfad7",
                        "source_sense_description": "Psychologie: Verhalten, unangenehme, jedoch notwendige Arbeiten und Entscheidungen aufzuschieben",
                        "target_lang_word": "procrastination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procrastination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93c24048-85cb-34a4-9a3c-f30b6cbeca13",
                                        "entry_id": "3bcb7aeb-09d8-33e3-89e4-de015af2aa8f",
                                        "glosses": [
                                            "Penchant à différer, tendance à remettre au lendemain ou à plus tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b39169-58ac-48a7-a036-9f333fa706e4",
                                                "sense_id": "93c24048-85cb-34a4-9a3c-f30b6cbeca13",
                                                "text": "Je suis malheureusement un spécialiste de la procrastination."
                                            },
                                            {
                                                "example_id": "8c6b34df-65f9-4701-ba3c-d5a34c5f106b",
                                                "sense_id": "93c24048-85cb-34a4-9a3c-f30b6cbeca13",
                                                "text": "La paresse : la procrastination, ce refus d’accomplir les tâches nécessaires à une vie bien remplie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                        "entry_id": "3bcb7aeb-09d8-33e3-89e4-de015af2aa8f",
                                        "glosses": [
                                            "Action de reporter, de remettre à plus tard ce qui pourrait être fait le moment même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517f3678-f594-4532-a665-3292abfb8ee7",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "Ces sempiternelles procrastinations ne mèneront à rien."
                                            },
                                            {
                                                "example_id": "90af967e-de3f-4d37-9df4-baf12c9e73de",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "Il semblerait que, dans l’affaire turque, le président n’échappe pas à la procrastination ambiante. Cette pathologie consiste à tout remettre à plus tard."
                                            },
                                            {
                                                "example_id": "7cf10de4-0133-46ff-b857-9222dc77d5e3",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "« Plusieurs manufacturiers cherchent à rendre difficiles les conditions d’obtention des rabais pour justement susciter la procrastination chez le consommateur. »"
                                            },
                                            {
                                                "example_id": "3142488e-604c-48ec-8327-929f240e9c74",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "Et puis ce garage qui ne sert à rien, dont les planches commencent à se disjoindre, quand me déciderai-je à en faire une chambre d’amis ? Mais même le remords léger de toute cette procrastination diluée depuis tant d’années fait partie du plaisir."
                                            },
                                            {
                                                "example_id": "f8e6baa4-16ab-44c6-a85a-aaa0e4140736",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "Ceux qui ont tendance à se suraffirmer au détriment de leurs équipes engendrent souvent démotivation, procrastination, absence de remontées du terrain, rébellions, arrêts de travail fréquents, démissions, burn-out, voire pire."
                                            },
                                            {
                                                "example_id": "fd890c88-cdc6-40ec-999e-c6f2629be001",
                                                "sense_id": "c7d72e38-43f6-36b5-86ea-f0bc0f8368f0",
                                                "text": "Autres citations"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
