                                    {
                                        "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                                        "entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                                        "glosses": [
                                            "Pratique consistant à se costumer à l’image de personnages de mangas, de jeux vidéos, etc."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d644a8-49ee-4fe8-a88d-da6dab953583",
                                                "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                                                "text": "Au Japon, les défilés de cosplay sont très prisés par les jeunes."
                                            },
                                            {
                                                "example_id": "554b5d9e-9269-4c6f-b969-9bb578a13c33",
                                                "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                                                "text": "Dans le cadre du festival Anima se déroulait ce dimanche à Flagey, un concours de cosplay ou costume playing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6217193-8133-49df-abcf-17ac0788eb91",
                        "source_entry_id": "1e43a1b9-3c67-3ebb-ba36-99d8b2c62a94",
                        "source_sense_description": "subculture centered on dressing as characters",
                        "target_lang_word": "costumade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "costumade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4de155-c43f-3e41-bd2f-4b075840547d",
                                        "entry_id": "a034be9d-ddc9-349d-a254-3e748fbc6544",
                                        "glosses": [
                                            "Activité axée sur la personnification, qui consiste à se costumer en personnage de fiction, issu d’un jeu vidéo, d’une bande dessinée ou d’un film d’animation, et à jouer en public son personnage en imitant son comportement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ae9909-c94b-46f6-aa47-a4e5aa6af8ca",
                                                "sense_id": "6d4de155-c43f-3e41-bd2f-4b075840547d",
                                                "text": "L’art de la costumade est de ressembler le plus possible au personnage que l’on a choisi d’incarner, notamment par une reproduction, la plus fidèle possible, de son costume, de ses accessoires et de son maquillage. La costumade, ce n’est pas que du défilé et des séances photo, c’est aussi le plaisir de jouer son personnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
