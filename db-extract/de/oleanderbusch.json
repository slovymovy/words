                "senses": [
                    {
                        "sense_id": "f7ff2408-ab1a-3fff-b679-8bd0bf34dc7d",
                        "entry_id": "50f26b76-ed4d-3582-b2fa-533899ca0826",
                        "glosses": [
                            "Busch, der aus Oleander besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071590a9-7b0b-4074-9577-e6f686cfb4aa",
                                "sense_id": "f7ff2408-ab1a-3fff-b679-8bd0bf34dc7d",
                                "text": "„Der Weg dahin führt vorbei an Pinien, Zypressen, Oliven- und Zitronenbäumen und ist gesäumt mit rosa- und weißblühenden Oleanderbüschen.“"
                            },
                            {
                                "example_id": "5468bedd-9408-4b7a-8814-4f48187f86eb",
                                "sense_id": "f7ff2408-ab1a-3fff-b679-8bd0bf34dc7d",
                                "text": "„Wann mochten wohl die Palmen, Tannen und Oleanderbüsche gepflanzt worden sein?“"
                            },
                            {
                                "example_id": "e06e43d8-cc90-4ffc-b0bd-d3498648acf1",
                                "sense_id": "f7ff2408-ab1a-3fff-b679-8bd0bf34dc7d",
                                "text": "„Jim ging den Weg zwischen den mannshohen Oleanderbüschen, die den Parkplatz säumten, entlang zu den Garagen, über denen sein Zimmer lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
