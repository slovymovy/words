                "senses": [
                    {
                        "sense_id": "baadf777-fc0e-3f69-9c9e-718b6c8372e6",
                        "entry_id": "6bea40d0-f638-31e9-b161-ec3aaacea24b",
                        "glosses": [
                            "Rendre compréhensible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3970a9-673e-40d5-ad83-4ceaaefd730e",
                                "sense_id": "baadf777-fc0e-3f69-9c9e-718b6c8372e6",
                                "text": "Derrière la toile, il y a la pensée qui anime les couleurs, compréhensibilise les attitudes des personnages."
                            },
                            {
                                "example_id": "ffc1571c-beac-4d10-8198-feb237066f80",
                                "sense_id": "baadf777-fc0e-3f69-9c9e-718b6c8372e6",
                                "text": "Accordant à notre journaliste la liberté d'user de sa licence afin de reformuler -ainsi qu'un journaliste se doit parfois de faire- des phrases prononcées par d'autres, et ce afin de les \"recontexter\" voire de les condenser, voire de les \"compréhensibiliser\""
                            },
                            {
                                "example_id": "91ce922d-ee16-4d82-98df-fb223ba2b01d",
                                "sense_id": "baadf777-fc0e-3f69-9c9e-718b6c8372e6",
                                "text": "Que j'aime Pandora Hearts et son histoire incompréhensible, qui se compréhensibilise une fois quand elle se décompréhensibilise deux fois !"
                            }
                        ]
                    }
