                    {
                        "sense_id": "e7becb98-1b3b-3e50-9a73-fdac5558e2a3",
                        "entry_id": "39010b1b-e55f-3e8c-bb59-3aaff7ecba16",
                        "glosses": [
                            "een van de beenderen van de schedel (os zygomaticum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c935285e-a33c-49f4-97ff-5bee55d9c6fb",
                                "sense_id": "e7becb98-1b3b-3e50-9a73-fdac5558e2a3",
                                "text": "Het jukbeen was onbeschadigd gebleven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2c7e231-195e-4216-aa49-726309dd3a8c",
                        "source_entry_id": "39010b1b-e55f-3e8c-bb59-3aaff7ecba16",
                        "source_sense_id": "e7becb98-1b3b-3e50-9a73-fdac5558e2a3",
                        "source_sense_description": "een van de beenderen van de schedel",
                        "target_lang_word": "Jochbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jochbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                        "entry_id": "84032bdf-6f32-3510-9795-c92e116cfe8a",
                                        "glosses": [
                                            "Knochen des Gesichtsschädels, der den Oberkiefer mit dem Schläfenbein verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528fbca2-5c8c-4de5-b079-71e2361fca80",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Miroslav Klose hat anstatt des zunächst befürchteten erneuten Bruchs nur eine Prellung am Jochbein erlitten.“"
                                            },
                                            {
                                                "example_id": "b22d54c4-006a-4290-b4e9-bc8a97c145de",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Da kam bei Brokdorf ein Polizist vom Bremer Sondereinsatzkommando noch glimpflich davon. Einen ‚plötzlichen heftigen Druck am Kopf‘ spürte der Uniformierte: Eine Stahlkugel hatte – knapp am Auge vorbei – sein Jochbein zertrümmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e9a92e6-0b59-4025-8bfb-8aa9d4b53678",
                        "source_entry_id": "39010b1b-e55f-3e8c-bb59-3aaff7ecba16",
                        "source_sense_id": "e7becb98-1b3b-3e50-9a73-fdac5558e2a3",
                        "source_sense_description": "een van de beenderen van de schedel",
                        "target_lang_word": "cheekbone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheekbone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                        "entry_id": "59a8acac-5ff5-3dff-8a4c-e83d864cbe4b",
                                        "glosses": [
                                            "The small prominent bone of the cheek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e2128f-8d24-4acd-aa10-24aeea5b74de",
                                                "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            },
                                            {
                                                "example_id": "269b4283-0650-47a4-915b-4213a6d835cf",
                                                "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                                "text": "A youngish-looking man came up to him, and aggressive-looking type with a hook mouth, a lantern nose, and small beady little cheekbones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f4e5888-7bad-4fe3-9e52-f21561bbfba1",
                        "source_entry_id": "39010b1b-e55f-3e8c-bb59-3aaff7ecba16",
                        "source_sense_id": "e7becb98-1b3b-3e50-9a73-fdac5558e2a3",
