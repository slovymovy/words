                                        "entry_id": "e83fdc9e-13af-3ae4-8297-44d31cc4527f",
                                        "glosses": [
                                            "eine Süßspeise aus Mascarpone und Löffelbiskuits, die mit Kaffee getränkt sind"
                                        ],
