    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cc306ce-7ba3-3585-9460-4c22de8b7ef6",
                    "sense_definition": "Passer d'un état ou d'une situation à un autre ; commencer à être.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait de longues études pour <w>devenir</w> médecin dans sa ville natale."
                        },
                        {
                            "text": "Au fil des années passées ensemble, ils sont <w>devenus</w> d'excellents amis."
                        }
                    ],
                    "common_phrases": [
                        "devenir grand",
                        "devenir fou"
                    ]
                },
                {
                    "sense_id": "6c918463-7d44-362a-b9a0-e4e16ffd0280",
                    "sense_definition": "Avoir tel sort ou telle issue, en parlant d'une personne ou d'une situation incertaine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me demande souvent ce qu'il est <w>devenu</w> après toutes ces années sans nouvelles."
                        },
                        {
                            "text": "Si l'usine ferme définitivement, que vont <w>devenir</w> tous ces employés et leurs familles ?"
                        }
                    ],
                    "synonyms": [
                        "advenir"
                    ],
                    "common_phrases": [
                        "ne pas savoir que devenir"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bb75f24-2673-3a23-8150-2ebdf54af9b7",
                    "sense_definition": "Évolution future ou sort à venir d'une personne, d'une collectivité ou d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens s'inquiètent beaucoup pour le <w>devenir</w> économique et social de leur région."
                        },
                        {
                            "text": "Cette nouvelle loi jouera un rôle déterminant dans le <w>devenir</w> des générations futures."
                        }
                    ],
                    "synonyms": [
                        "avenir",
                        "destin",
                        "futur"
                    ],
                    "common_phrases": [
