                    {
                        "sense_id": "aaf5fd21-6940-377a-a787-b5bcaac1c554",
                        "entry_id": "129b6451-c42c-3e38-8056-b3b009aa9bbd",
                        "glosses": [
                            "een wet waarin staat aan welke eisen een product moet voldoen om te mogen worden verkocht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4a7dfe-cd13-42ec-ba7b-0008429470bd",
                                "sense_id": "aaf5fd21-6940-377a-a787-b5bcaac1c554",
                                "text": "„Aangezien de patronen steeds meer in opspraak raken en er eind vorig jaar is aangekondigd dat er op korte termijn ten aanzien van het kopen van lachgas(patronen) in de Warenwet strengere bepalingen zullen worden opgenomen, hebben wij vorige maand besloten de artikelen niet langer te verkopen”, zegt de woordvoerder van Bol.com tegen NH Nieuws."
                            },
                            {
                                "example_id": "8031bf2c-b262-4b07-a9b2-05ae6522ac70",
                                "sense_id": "aaf5fd21-6940-377a-a787-b5bcaac1c554",
                                "text": "Wel voegt de NVWA er aan toe dat producenten zich aan dezelfde regels moeten houden: consumenten mogen niet worden misleid door een combinatie van vegetarische vleesvervangers en toevoegingen van dieren of vleesproducten. „Producenten zijn zelf verantwoordelijk voor het naleven van de Warenwet.”"
                            }
                        ]
                    }
