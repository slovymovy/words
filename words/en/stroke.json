                    "sense_definition": "The symbol '/', often used to separate alternatives.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write the date using a <w>stroke</w> between the numbers.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите дату, используя <w>косую черту</w> между цифрами.",
                                "zh": "请在数字之间用<w>斜线</w>来书写日期。"
                            }
                        },
                        {
                            "text": "The <w>stroke</w> indicates either option is acceptable.",
                            "target_lang_translations": {
                                "ru": "<w>Косая черта</w> указывает, что приемлем любой вариант.",
                                "zh": "这条<w>斜线</w>表示两个选项均可。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ '/', часто используемый для разделения вариантов.",
                        "zh": "符号“/”，常用于分隔选项。"
                    },
                    "translations": {
