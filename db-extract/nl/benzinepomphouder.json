                        ],
                        "examples": [
                            {
                                "example_id": "6c35a481-65d0-475e-9ab8-24eb1c268689",
                                "sense_id": "19714361-b5a1-3429-892b-fcb05598ddd1",
                                "text": "Een benzinepomphouder die bezwaar maakte omdat hij bang is dat hij geen klandizie meer heeft als de weg wordt omgelegd, heeft ook gelijk gekregen van de Raad van State, schrijft Omroep Brabant. De gemeente moet beter bedrijfseconomisch onderzoek doen naar de gevolgen van de reconstructie van de weg."
                            },
                            {
                                "example_id": "ed664c5b-a336-4c71-b402-5a3431be6787",
                                "sense_id": "19714361-b5a1-3429-892b-fcb05598ddd1",
                                "text": "Een benzinepomphouder heeft bekend dat hij de dakloze man heeft aangevallen. Hij was jaloers, omdat het slachtoffer zijn vrouw complimenten had gemaakt."
                            },
                            {
                                "example_id": "185461fa-d16e-4878-8492-b64ad4ffde8a",
                                "sense_id": "19714361-b5a1-3429-892b-fcb05598ddd1",
                                "text": "Alcoholverkoop door benzinestations blijft verboden. Dat heeft de Raad van State bepaald, de hoogste bestuursrechter van het land. Een benzinepomphouder uit Hoogeveen had de zaak aangespannen."
                            }
                        ]
                    }
