                                            {
                                                "example_id": "0447c234-8caa-4bce-b209-c6f8854b0a55",
                                                "sense_id": "48cc0085-d2d9-3e9f-85e1-68ed618fe7af",
                                                "text": "This condition of muscle, this fusion of a number of simple spasms into an apparently smooth, continuous effort, is known as tetanus, or tetanic contraction."
                                            },
                                            {
                                                "example_id": "58dc3889-a370-45ba-9c62-6d9cee577dc4",
                                                "sense_id": "48cc0085-d2d9-3e9f-85e1-68ed618fe7af",
                                                "text": "“The convulsions were of a peculiar violence, Dr. Wilkins. I am sorry you were not here in time to witness them. They were quite—tetanic in character.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8867c5c-e34c-303a-a841-ec0f39bc6779",
                                        "entry_id": "00573e0b-4b33-3b42-aa1d-31a6dad82abc",
