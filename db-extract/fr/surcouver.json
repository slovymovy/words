                "senses": [
                    {
                        "sense_id": "4b5500aa-7db6-3d06-88d6-4131d1a55d11",
                        "entry_id": "066a52a9-7ab2-317f-9a86-ed5b7bafccef",
                        "glosses": [
                            "Couver de manière excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43f4d86-cdd1-4c54-bbdf-1032f9aca354",
                                "sense_id": "4b5500aa-7db6-3d06-88d6-4131d1a55d11",
                                "text": "À la disparition de leur père, Nathalie, qui avait alors vingt ans, s’était mise à surcouver sa jeune soeur, de peur que l’événement ne la marque à vie."
                            },
                            {
                                "example_id": "dfb957ac-0286-40ad-9520-b2f6b3e3303d",
                                "sense_id": "4b5500aa-7db6-3d06-88d6-4131d1a55d11",
                                "text": "Le problème, quand on est handicapé, c’est que les parents éprouvent le besoin de vous surcouver."
                            },
                            {
                                "example_id": "3fa0981e-4bc0-4761-853d-07eff9131e9b",
                                "sense_id": "4b5500aa-7db6-3d06-88d6-4131d1a55d11",
                                "text": "Si on n’a qu’un seul pommier, on va le «surcouver» en le traitant de manière continue avec des produits phytosanitaires divers."
                            }
                        ]
                    }
                ],
