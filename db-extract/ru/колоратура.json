                                        "entry_id": "9f76ec1d-ddca-3f0f-aabe-e9fbd7b99b1e",
                                        "glosses": [
                                            "verzierende stimmliche Variation beim Gesang"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccadf9b1-d46f-4995-a770-2e4a8fc4fcad",
                                                "sense_id": "61df6afb-961a-3475-b624-05519e789d2c",
                                                "text": "Das Museumsorchester erwärmte sich bald zur nötigen spritzigen Delikatesse mit genügend akustischem Freiraum für die atemraubenden Koloraturen von insgesamt vierzehn Goldkehlen."
                                            }
                                        ],
