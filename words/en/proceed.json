{
    "word_family": [
        "procedure",
        "proceeding",
        "procession",
        "procedural"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2e6859a-5939-3e52-874d-13a87d8863a8",
                    "sense_definition": "To move forward or travel in a particular direction.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All passengers must <w>proceed</w> to the departure gate immediately.",
                            "target_lang_translations": {
                                "ru": "Все пассажиры должны немедленно <w>проследовать</w> к выходу на посадку.",
                                "tr": "Tüm yolcular derhal biniş kapısına <w>ilerlemelidir</w>."
                            }
                        },
                        {
                            "text": "The crowd began to <w>proceed</w> slowly along the main street.",
                            "target_lang_translations": {
                                "ru": "Толпа начала медленно <w>продвигаться</w> по главной улице.",
                                "tr": "Kalabalık ana cadde boyunca yavaşça <w>ilerlemeye</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "go on",
                        "progress"
                    ],
                    "antonyms": [
                        "stop",
                        "recede"
                    ],
                    "common_phrases": [
                        "proceed to",
                        "proceed with caution"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вперед или направляться в определенную сторону (обычно официально).",
                        "tr": "Belirli bir yönde ilerlemek veya hareket etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проследовать",
                                "target_lang_sense_clarification": "официально: пройти к месту назначения"
                            },
                            {
                                "target_lang_word": "направляться",
                                "target_lang_sense_clarification": "идти в определенном направлении"
                            },
                            {
                                "target_lang_word": "продвигаться",
                                "target_lang_sense_clarification": "двигаться вперед"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilerlemek",
                                "target_lang_sense_clarification": "fiziksel olarak öne doğru gitmek"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "belirli bir yöne doğru hareket etmek"
                            },
                            {
                                "target_lang_word": "yönelmek",
                                "target_lang_sense_clarification": "belli bir yere doğru gitmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3d45052-0183-3017-9f0a-6ef97c07bc13",
                    "sense_definition": "To continue doing something that has already been started.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>proceed</w> with the original plan despite the difficulties.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>продолжать</w> действовать по первоначальному плану, несмотря на трудности.",
                                "tr": "Zorluklara rağmen orijinal planla <w>devam etmeye</w> karar verdik."
                            }
                        },
                        {
                            "text": "Please <w>proceed</w> with your work while I check the documents.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>продолжайте</w> работу, пока я проверяю документы.",
                                "tr": "Ben belgeleri kontrol ederken lütfen işinize <w>devam edin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "continue",
                        "carry on",
                        "keep on",
                        "go on"
                    ],
                    "antonyms": [
                        "stop",
                        "end",
                        "desist"
                    ],
                    "common_phrases": [
                        "proceed with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать делать то, что уже было начато.",
                        "tr": "Başlanmış olan bir eylemi veya süreci sürdürmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолжать",
                                "target_lang_sense_clarification": "не останавливаться, делать дальше"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "devam etmek",
                                "target_lang_sense_clarification": "başlanan bir işi sürdürmek"
                            },
                            {
                                "target_lang_word": "ilerlemek",
                                "target_lang_sense_clarification": "süreçte yol katetmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2f79a2-abe1-33e9-8f72-e62b47b65ea0",
                    "sense_definition": "To stop one activity or topic and start the next one.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the introduction, the speaker <w>proceeded</w> to explain the new theory.",
                            "target_lang_translations": {
                                "ru": "После вступления докладчик <w>перешел</w> к объяснению новой теории.",
                                "tr": "Girişten sonra konuşmacı yeni teoriyi açıklamaya <w>geçti</w>."
                            }
                        },
                        {
                            "text": "Let us <w>proceed</w> to the next item on the agenda.",
                            "target_lang_translations": {
                                "ru": "Давайте <w>перейдем</w> к следующему пункту повестки дня.",
                                "tr": "Gündemdeki bir sonraki maddeye <w>geçelim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "progress",
                        "go on"
                    ],
                    "common_phrases": [
                        "proceed to the next"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить от одного действия или темы к следующему.",
                        "tr": "Bir eylemi veya konuyu bitirip bir sonrakine geçmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перейти",
                                "target_lang_sense_clarification": "к следующему этапу или теме"
                            },
                            {
                                "target_lang_word": "приступить",
                                "target_lang_sense_clarification": "начать выполнение следующего действия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "sonraki aşamaya veya konuya geçmek"
                            },
                            {
                                "target_lang_word": "başlamak",
                                "target_lang_sense_clarification": "sıradaki işe koyulmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b251fcd0-5d6f-396a-80fd-557402bb9aa7",
                    "sense_definition": "To begin or carry on a legal action against someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company chose not to <w>proceed</w> against the former employee.",
                            "target_lang_translations": {
                                "ru": "Компания решила не <w>возбуждать дело</w> против бывшего сотрудника.",
                                "tr": "Şirket, eski çalışana karşı <w>yasal işlem başlatmamayı</w> seçti."
                            }
                        },
                        {
                            "text": "The judge allowed the case to <w>proceed</w> to trial.",
                            "target_lang_translations": {
                                "ru": "Судья разрешил <w>передать</w> дело в суд.",
                                "tr": "Yargıç davanın duruşmaya <w>taşınmasına</w> izin verdi."
                            }
                        }
                    ],
                    "antonyms": [
                        "desist"
                    ],
                    "common_phrases": [
                        "proceed against"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать или вести судебное разбирательство против кого-либо.",
                        "tr": "Biri hakkında hukuki işlem veya dava başlatmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбуждать дело",
                                "target_lang_sense_clarification": "начинать судебный процесс"
                            },
                            {
                                "target_lang_word": "преследовать по суду",
                                "target_lang_sense_clarification": "вести дело против кого-то"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dava açmak",
                                "target_lang_sense_clarification": "yasal süreç başlatmak"
                            },
                            {
                                "target_lang_word": "hukuki işlem başlatmak",
                                "target_lang_sense_clarification": "yasal yollara başvurmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aeceee8-32b0-3f36-8a19-0151015b8ec2",
                    "sense_definition": "To come from a specific source or origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strange noises seemed to <w>proceed</w> from the basement.",
                            "target_lang_translations": {
                                "ru": "Казалось, что странные звуки <w>исходят</w> из подвала.",
                                "tr": "Garip sesler bodrum katından <w>geliyor</w> gibiydi."
                            }
                        },
                        {
                            "text": "All authority in the organization <w>proceeds</w> from the central committee.",
                            "target_lang_translations": {
                                "ru": "Вся власть в организации <w>исходит</w> от центрального комитета.",
                                "tr": "Örgütteki tüm yetki merkez komiteden <w>kaynaklanır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proceed from"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исходить или происходить из определенного источника.",
                        "tr": "Belirli bir kaynaktan veya kökenden çıkmak, gelmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исходить",
                                "target_lang_sense_clarification": "иметь источник"
                            },
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "брать начало"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kaynaklanmak",
                                "target_lang_sense_clarification": "bir kaynaktan çıkmak"
                            },
                            {
                                "target_lang_word": "gelmek",
                                "target_lang_sense_clarification": "bir kökene dayanmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}