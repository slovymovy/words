                ],
                "senses": [
                    {
                        "sense_id": "8f9cd465-f8c3-3c61-b2f2-8852ce56f64e",
                        "entry_id": "3c76d6d9-058b-3932-a8c3-71c79c676d03",
                        "glosses": [
                            "Eigenschaft einer Weise/Tonfolge, singbar (kantabel) zu sein; Grad, in dem etwas eine melodische Schönheit entfalten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91fd2cf1-fab5-492f-a6a2-5bd816532169",
                                "sense_id": "8f9cd465-f8c3-3c61-b2f2-8852ce56f64e",
                                "text": "„Rilkes \"Sonette an Orpheus\" haben jahrzehntelang in erster Linie durch ihre Kantabilität, ihren Klangreichtum, ihre musikalische Leichtigkeit bezaubert.“"
                            },
                            {
                                "example_id": "247ffebe-fb00-4e1d-8c4a-56dfd771537a",
                                "sense_id": "8f9cd465-f8c3-3c61-b2f2-8852ce56f64e",
                                "text": "„Die Melodie und der rote Faden: Kantabilität und Nachvollziehbarkeit - Die Melodik des Bebop ist von einer Heterogenität geprägt, die bewusst die Grenzen des diatonischen Tonspektrums überschreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00aeaabf-16d6-3c81-b261-a89d0ecdc8c1",
                        "entry_id": "3c76d6d9-058b-3932-a8c3-71c79c676d03",
                        "glosses": [
                            "Eigenschaft, wie etwas gesungen wird, Art des Vortrages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41df72ba-2a5e-4f5e-a31b-adab7cb6e349",
                                "sense_id": "00aeaabf-16d6-3c81-b261-a89d0ecdc8c1",
                                "text": "„Seine Temperamentsgestik wie seine Kantabilität und die stampfende Rhythmik sprechen von gelöster Laune und fast ein bisschen Übermut.“"
                            },
                            {
                                "example_id": "defecbe6-598c-4d76-adbf-3b0875553c88",
                                "sense_id": "00aeaabf-16d6-3c81-b261-a89d0ecdc8c1",
                                "text": "„Zuerst Josef Krips, der, von Natur behäbig scheinend, stärkste rhythmische Energien entfaltet, ohne sich klangseliger Kantabilitäten zu versagen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
