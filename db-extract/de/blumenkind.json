                "senses": [
                    {
                        "sense_id": "de43135d-1d62-3f29-b657-ae0764e9f5ee",
                        "entry_id": "a49e02a9-7733-3b1b-80a7-281c0d2737a2",
                        "glosses": [
                            "Kind, das anlässlich einer Hochzeitsfeier vor dem Brautpaar Blumen streut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "918097e2-cd46-448a-a30a-41c3a7e32dc6",
                                "sense_id": "de43135d-1d62-3f29-b657-ae0764e9f5ee",
                                "text": "Wer kleine Kinder im Bekanntenkreis hat, der lässt diese gerne als Blumenkinder in der Kirche vorweg laufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5eee8bd8-fe1a-3c6c-b025-5ef68884c51f",
                        "entry_id": "a49e02a9-7733-3b1b-80a7-281c0d2737a2",
                        "glosses": [
                            "Mitglied einer gegenkulturellen Jugendbewegung der 1960er Jahre; Hippie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d2a264-e277-4b12-95bc-2de77811d26b",
                                "sense_id": "5eee8bd8-fe1a-3c6c-b025-5ef68884c51f",
                                "text": "Hippies wurden „Blumenkinder“ genannt, weil sie sich zum Zeichen für Frieden und Liebe mit Blumen schmückten."
                            },
                            {
                                "example_id": "8ee206f0-b0b4-4b19-a2de-02bc7f8e1fd2",
                                "sense_id": "5eee8bd8-fe1a-3c6c-b025-5ef68884c51f",
                                "text": "„Nach der Begegnung mit José begriff ich vollends, wie trostlos sie war, diese Vorstellung der Kirchenväter und der Blumenkinder gleichermaßen, die Liebe mit Lust verwechselten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27046eca-8098-4bea-b6bc-73000c694a13",
