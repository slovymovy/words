                "senses": [
                    {
                        "sense_id": "a8802b61-2f47-3a61-b892-130175b0853d",
                        "entry_id": "843768c2-d58a-3dc9-af98-9ec70426ff30",
                        "glosses": [
                            "высок. не сравнимый ни с чем, не имеющий в прошлом равного или похожего"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32dfa8b8-5dbb-4a12-b405-52f7a1ff01fc",
                                "sense_id": "a8802b61-2f47-3a61-b892-130175b0853d",
                                "text": "Начало российской истории представляет нам удивительный и едва ли не беспримерный случай."
                            },
                            {
                                "example_id": "685c9fdd-755e-4b4b-b8c4-62411cd9ad21",
                                "sense_id": "a8802b61-2f47-3a61-b892-130175b0853d",
                                "text": "С далёкого Северного Кавказа беспримерным в военной истории походом перебрасывались на Украину закалённые в боях дивизии 1-й Конной армии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d5f5325-548b-4826-9fd2-3f56a07940c1",
                        "source_entry_id": "843768c2-d58a-3dc9-af98-9ec70426ff30",
                        "source_sense_id": "a8802b61-2f47-3a61-b892-130175b0853d",
                        "target_lang_word": "unexampled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexampled",
