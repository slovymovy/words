                "senses": [
                    {
                        "sense_id": "6358b901-8497-31e8-a756-0e6e27a2ad54",
                        "entry_id": "4938d473-3a5f-374d-9c32-7c58fdfc0da3",
                        "glosses": [
                            "To drag on slowly and heavily; to dawdle or while away time indolently."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5629b5a9-64fb-3fe5-8368-cb0e8359d8f8",
                        "entry_id": "4938d473-3a5f-374d-9c32-7c58fdfc0da3",
                        "glosses": [
                            "To utter or pronounce in a dull, spiritless tone, as if by dragging out the utterance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4ed7f841-6216-371e-ba1e-bc13e2182781",
                        "entry_id": "4938d473-3a5f-374d-9c32-7c58fdfc0da3",
                        "glosses": [
                            "To move slowly and heavily; to move in a dull, slow, lazy manner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98744a56-e96b-483a-885e-b0387b9faffa",
                                "sense_id": "4ed7f841-6216-371e-ba1e-bc13e2182781",
                                "text": "Tush, tush, Tarleton, Kemp, nor Singer, nor all the litter of Fooles that now come drawling behinde them, neuer plaid the Clownes more naturally then the arrantest Sot of you all, shall, if hee will but boyle my Instructions in his brainepan."
                            },
                            {
                                "example_id": "9e0eded5-22cf-4190-b43d-1df05f93cd4d",
                                "sense_id": "4ed7f841-6216-371e-ba1e-bc13e2182781",
                                "text": "Looke what leysure the old bearded Bawd takes / How softly she goes / How one leg comes drawling after another / Now she has her money, her armes are broken."
                            }
                        ]
                    },
                    {
                        "sense_id": "edcbfba8-f02e-3e6e-a6f8-47482a7b9d0b",
                        "entry_id": "4938d473-3a5f-374d-9c32-7c58fdfc0da3",
                        "glosses": [
                            "To speak with a slow, spiritless utterance, as from affectation, laziness, or lack of interest."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "81ce7ef0-a9a1-4f8f-9065-13711e5e8db1",
                                "sense_id": "edcbfba8-f02e-3e6e-a6f8-47482a7b9d0b",
                                "text": "talk sometimes a pestilence , and sometimes a hero , mostly in a drawling and dreaming way about it"
                            }
                        ]
                    }
                ],
