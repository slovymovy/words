                "senses": [
                    {
                        "sense_id": "d1cbe0fe-d0b8-3b0e-a014-1059ae334387",
                        "entry_id": "339b1d8c-9171-32e3-b62d-c4bd2579c6e1",
                        "glosses": [
                            "unwillkürlich auftretendes und abebbendes Gefühl von Kälte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4eecd29-8555-4fed-ac25-e83d898df6bc",
                                "sense_id": "d1cbe0fe-d0b8-3b0e-a014-1059ae334387",
                                "text": "„Die Kälterschauer überfielen ihn immer heftiger, so daß er sich wie eine Kugel zusammenkrümmte, um die Eigenwärme zu bewahren.“"
                            },
                            {
                                "example_id": "9f681f12-0dd4-48be-b164-d54b10b58e4a",
                                "sense_id": "d1cbe0fe-d0b8-3b0e-a014-1059ae334387",
                                "text": "„Natascha wäre vollkommen glücklich gewesen, wenn der Gedanke an die bevorstehende und immer näher rückende Trennung sie nicht erschreckt hätte, ein Gedanke, der auch ihn blasswerden und Kälteschauer verspüren liess.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
