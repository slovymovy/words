                        "entry_id": "c45bccfe-2331-3c89-acaa-b80f89517228",
                        "glosses": [
                            "Celui qui souscrit un effet de commerce ou un acte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b998f0b1-5be7-4c51-bff5-cf3b12b58717",
                                "sense_id": "bfaf0425-060f-3f63-92c7-33d67533a9e0",
                                "text": "Il est vrai que cette dette était inexigible et que cependant le souscripteur a pu être judiciairement contraint à la payer à un tiers porteur de bonne foi. Mais quelle est la mesure de cette inexigibilité dont se trouve frappée la dette de jeu ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7b11179-2324-368f-9e82-67031e42950e",
                        "entry_id": "c45bccfe-2331-3c89-acaa-b80f89517228",
                        "glosses": [
                            "Celui qui prend part à une souscription."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd8fa4f-df21-41ec-8464-cecb082be70e",
                                "sense_id": "c7b11179-2324-368f-9e82-67031e42950e",
                                "text": "Les premiers souscripteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "8334a87e-1238-3397-a40f-25519c32f7ba",
                        "entry_id": "c45bccfe-2331-3c89-acaa-b80f89517228",
                        "glosses": [
                            "Celui qui souscrit à une publication, à une entreprise de librairie."
