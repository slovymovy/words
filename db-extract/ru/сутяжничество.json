                        "target_lang_word": "vitilitigation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitilitigation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3df6fe8-5d46-36e1-bf5e-1c85a616ca56",
                                        "entry_id": "52b93f9b-e420-303a-9f84-447a909106a3",
                                        "glosses": [
                                            "cavillous litigation; petty criticism or objection"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964264b3-eab2-47ee-aff7-938d2dc05039",
                                                "sense_id": "f3df6fe8-5d46-36e1-bf5e-1c85a616ca56",
                                                "text": "I am not so addicted to vitilitigation, as to contend about the propriety of those expressions in scripture, which seem to ascribe all our sacred passions principaly ^([sic]) to the heart."
                                            },
                                            {
                                                "example_id": "e05c419f-7388-4b2b-b91f-afc487f6614a",
                                                "sense_id": "f3df6fe8-5d46-36e1-bf5e-1c85a616ca56",
                                                "text": "I'll force you by right ratiocination\nTo leave your vitilitigation,\nAnd make you keep to th' question close,\nAnd argue dialecticos"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0133309c-22e3-4a99-898b-4aff724c8f41",
                        "source_entry_id": "b1be7980-288f-3608-9509-1dbdd5a35575",
