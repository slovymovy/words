                "senses": [
                    {
                        "sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                        "entry_id": "fcdce34d-e5d4-3fe9-b4aa-cff852020e1a",
                        "glosses": [
                            "een relatief grote zelfbedieningswinkel waar voedingsmiddelen en huishoudelijke artikelen worden verkocht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2400a921-fd39-465e-9a52-587237de4381",
                                "sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                                "text": "Owens speelde in de jaren 80 schoonzoon Elvin in de hitserie. Alhoewel hij in de jaren daarna geregeld kleine gastrolletjes had in televisieseries, bleef het grote werk uit voor de inmiddels 57-jarige. Hij ging daardoor werken buiten de entertainmentindustrie, en werd afgelopen week door een klant gefotografeerd in de supermarkt waar hij een baan heeft. De foto kwam online te staan, waar veel mensen honend reageerden."
                            },
                            {
                                "example_id": "53b3a5fe-89f0-46a7-89ca-a9bdbff3804a",
                                "sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                                "text": "Toch had ik haar hele lijst integraal ingekocht in een gigantische supermarkt in San Diego, genoeg voor de eerste zeven weken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b93ea86a-9f17-499a-8ae8-b1b4b01d4885",
                        "source_entry_id": "fcdce34d-e5d4-3fe9-b4aa-cff852020e1a",
                        "source_sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                        "target_lang_word": "Supermarkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Supermarkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                        "entry_id": "978f69f0-41f7-3672-9f35-5dcd7b75d440",
                                        "glosses": [
                                            "großes Einzelhandelsgeschäft, das Lebensmittel, Genussmittel und daneben meist auch Drogerieartikel und andere Artikel des täglichen Bedarfs anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b03ec43-8ae0-461c-910e-a418ab01e351",
                                                "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                                "text": "Jeden Samstag kaufe ich meine Lebensmittel im Supermarkt."
                                            },
                                            {
                                                "example_id": "0944bcc0-1d04-4990-8827-b6376637b454",
                                                "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                                "text": "„Bei uns in Berlin wundere ich mich seit zwanzig Jahren über die Menge der Lebensmittel, die in den Hallen der großen Supermärkte ausliegt.“"
                                            },
                                            {
                                                "example_id": "33a89c33-68c2-4c49-a188-567fbf469e83",
                                                "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                                "text": "„Auf der Suche nach einem Café kamen sie an einem Supermarkt vorbei.“"
                                            },
                                            {
                                                "example_id": "01b419d1-cd56-4a36-95f2-efc4a0bf808a",
                                                "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                                "text": "„In Dondorf hatte ein Supermarkt aufgemacht.“"
                                            },
                                            {
                                                "example_id": "bccd03c2-1391-41c9-babe-d8ee35d466fb",
                                                "sense_id": "1aeac821-41f0-3171-8295-c848b58009eb",
                                                "text": "„Im Supermarkt waren Obst und Gemüse unbezahlbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0594c02-af4b-42a9-bafe-08999fc4b07b",
                        "source_entry_id": "fcdce34d-e5d4-3fe9-b4aa-cff852020e1a",
                        "source_sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                        "target_lang_word": "supermarket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supermarket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c5d8e1-e6e9-3c1b-b6da-7bb9acc666ef",
                                        "entry_id": "17a75b69-302e-3d84-863f-4bd8f492e0ae",
                                        "glosses": [
                                            "A large self-service store that sells groceries and, usually, medications, household goods, and/or clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3cb816-1943-4fdb-9475-53128d1a821c",
                                                "sense_id": "a3c5d8e1-e6e9-3c1b-b6da-7bb9acc666ef",
                                                "text": "I went to the supermarket to buy some food."
                                            },
                                            {
                                                "example_id": "7a4dcdc3-87d9-445f-a4f8-57ee048f04fb",
                                                "sense_id": "a3c5d8e1-e6e9-3c1b-b6da-7bb9acc666ef",
                                                "text": "Cans of Coca-Cola Original Taste, Coca-Cola Zero Sugar, Diet Coke, and Sprite Zero sent to cafes and restaurants are being withdrawn as well as 6x250ml Appletiser multipacks sent to UK supermarkets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a4901a-3166-3d0e-9c94-2f09dc439d98",
                                        "entry_id": "17a75b69-302e-3d84-863f-4bd8f492e0ae",
                                        "glosses": [
                                            "A chain of such stores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05e16372-2396-31a7-bb12-a8174da06368",
                                        "entry_id": "17a75b69-302e-3d84-863f-4bd8f492e0ae",
                                        "glosses": [
                                            "A one-stop shop; a place offering a range of products or services."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "665411f1-db7b-4196-8d3a-afd0d16518f3",
                                                "sense_id": "05e16372-2396-31a7-bb12-a8174da06368",
                                                "text": "If you know what you want by filtering down the 1,600 or so trusts to a short list and then studying the information on each via online sources, then you can buy your trust and get all or nearly all of the commission back into your bank account via an Internet investment supermarket. Here, you select your fund, decide whether you want it as an Individual Savings Account (ISA), and pay for it with a credit card."
                                            },
                                            {
                                                "example_id": "1c582816-4705-4da1-932c-c2f1b194f933",
                                                "sense_id": "05e16372-2396-31a7-bb12-a8174da06368",
                                                "text": "Almina grew up in the age of the internet and the infinite supermarket of pornography it provides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abe580ce-6f6b-4d1f-83ff-37703ee4383f",
                        "source_entry_id": "fcdce34d-e5d4-3fe9-b4aa-cff852020e1a",
                        "source_sense_id": "4eb6e343-9ff1-3693-868d-44ac38547354",
                        "target_lang_word": "supermarché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supermarché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                        "entry_id": "b98c1c05-1b73-3cdd-8c27-fdff4166704e",
                                        "glosses": [
                                            "Magasin en libre-service assez grand (400 à 2 500 mètres carrés environ), proposant à la vente des produits alimentaires, d’hygiène, et optionnellement tous les biens de consommation courants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db79ab8-f8d9-48c5-a30b-7a42866f4379",
                                                "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                                "text": "Je me souviens de la première fois où je me suis posé cette question. C’était dans mon supermarché, au rayon moutardes. Je suis resté paralysé par la difficulté de choisir."
                                            },
                                            {
                                                "example_id": "96b31da1-6a48-4b5a-bd39-b88cb84815e9",
                                                "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                                "text": "Curieuse impression que le temps ici ne s’écoule pas, qu’il est un présent répété maintes et maintes fois. Qu’il n’y a pas d’Histoire. Même ma mémoire est muette. C’est en dehors de ce lieu, transcrivant tout ceci chez moi, que je me souviens de scènes vues ailleurs, dans d’autres supermarchés, en d’autres époques."
                                            },
                                            {
                                                "example_id": "aba88fec-87be-4073-82b8-9cce11e81afe",
                                                "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                                "text": "Si des mesures d’urgence ne viennent pas soutenir l’agroalimentaire français, et que les supermarchés ne répercutent pas la flambée des prix de l’énergie, certains industriels risquent de ne plus être en mesure de produire, alerte le président de l’Association nationale des industries alimentaires (Ania), Jean-Philippe André."
                                            },
                                            {
                                                "example_id": "c453cd3e-1c3a-4945-8d4c-bb259e205c9b",
                                                "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                                "text": "Un tiers-lieu, un slasheur, un restaurant clandestin, un pop-up store, un vide-dressing, des supermarchés coopératifs : tous ces nouveaux usages ont en commun d'être nés depuis 2008."
                                            },
                                            {
                                                "example_id": "dfa9f922-5be0-40a0-911e-95258a708420",
                                                "sense_id": "ef090d34-1a34-3cc5-9e56-876255543ae0",
                                                "text": "Par contre, il peut amener sa famille en ville pour visiter un zoo, faire des courses dans un magasin, un supermarché, un drugstore, où il se ravitaille dès lors comme tout client du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa407eac-8445-44e7-b62e-722db6302564",
                        "source_entry_id": "fcdce34d-e5d4-3fe9-b4aa-cff852020e1a",
