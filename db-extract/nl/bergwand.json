                        "target_lang_word": "paroi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paroi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99d49637-5a8d-35c5-9bda-66088e1ab318",
                                        "entry_id": "070bc5ce-0e65-3d3a-ba42-e39c67c7f757",
                                        "glosses": [
                                            "Cloison de maçonnerie qui sépare une chambre ou quelque autre pièce d’un appartement d’avec une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ecf498d-8d22-436c-8c60-f59ad39c7121",
                                                "sense_id": "99d49637-5a8d-35c5-9bda-66088e1ab318",
                                                "text": "J'essaie bien de cuire du porridge sur le réchaud à cadran, mais une vague plus forte envoie le porridge se coller au plafond et aux parois du poste."
                                            },
                                            {
                                                "example_id": "489fddf5-5123-42d7-a7fc-0c4fd1e85c87",
                                                "sense_id": "99d49637-5a8d-35c5-9bda-66088e1ab318",
                                                "text": "S’appuyer contre la paroi."
                                            },
                                            {
                                                "example_id": "363fb0f8-e5ba-46a2-9c8b-b119f75cdae4",
                                                "sense_id": "99d49637-5a8d-35c5-9bda-66088e1ab318",
                                                "text": "Les parois de cette chambre sont humides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                                        "entry_id": "070bc5ce-0e65-3d3a-ba42-e39c67c7f757",
                                        "glosses": [
                                            "Mur, clôture, enveloppe interne ou externe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1417e593-c1df-40a2-9e75-9b83ab096034",
                                                "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                                                "text": "[…], on descendit dans des caves, on suivit des souterrains dont les parois, […], laissaient suinter l'eau qui retombait en gouttes."
                                            },
                                            {
                                                "example_id": "0a360aef-96d7-49a5-9bf6-f41d1ef1e0fb",
                                                "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                                                "text": "Paroi de rochers."
                                            },
                                            {
                                                "example_id": "b1ea6124-85be-4af3-9523-8149c225d895",
                                                "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                                                "text": "Les parois d’un vase, d’un tube, d’un tuyau."
                                            },
                                            {
                                                "example_id": "10ac530a-1e93-424e-98e6-fa9b4f7dbf14",
                                                "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                                                "text": "La paroi du sabot ou muraille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e7c6ae-89b3-34f1-a7af-e346bc42c8b6",
                                        "entry_id": "070bc5ce-0e65-3d3a-ba42-e39c67c7f757",
                                        "glosses": [
                                            "Parties qui forment la clôture, les limites des diverses cavités du corps, et principalement de leurs faces internes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c77a2b-1c61-40f2-9574-3aee09e44f47",
                                                "sense_id": "98e7c6ae-89b3-34f1-a7af-e346bc42c8b6",
                                                "text": "L'ingestion d'un corps étranger métallique et sa traversée de la paroi réticulaire entraînent une péritonite locale aiguë. Le corps étranger pénètre le plus souvent dans la partie antérieure du réseau en direction du diaphragme […]."
                                            },
                                            {
                                                "example_id": "663c9f30-c85f-4f86-94e8-b07c4dade117",
                                                "sense_id": "98e7c6ae-89b3-34f1-a7af-e346bc42c8b6",
                                                "text": "La paroi cellulosique de la cellule végétale. Voir membrane et plasmodesme"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
