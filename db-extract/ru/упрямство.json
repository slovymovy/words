                        "cross_references": [
                            {
                                "target_word": "stubbornness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                        "entry_id": "864f6d6b-7b72-3d3b-8ea5-50cd3945b837",
                                        "glosses": [
                                            "The state of being stubborn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf384cd-7809-415a-aabb-b9dbbb274f55",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "[H]appy is your Grace / That can tranſlate the ſtubbornneſſe of fortune / Into ſo quiet and ſo ſweet a ſtile."
                                            },
                                            {
                                                "example_id": "3b38afaf-cca1-481b-b6fc-909e6574e7e6",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "Brant Rios and Eos Parish have been dating five years and experienced their state’s stubbornness firsthand Friday when they were the first couple to arrive at the Ouachita Parish Courthouse to be wed – and were the first to be turned away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a4a9ac-26db-4934-8cad-071ea68fc031",
                        "source_entry_id": "528ce3fe-0c9f-3595-992c-f8dd183967ab",
                        "source_sense_description": "свойство по значению прил. упрямый",
                        "target_lang_word": "pertinacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertinacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                        "entry_id": "b0bdf16c-98b8-3e08-b72e-56b30f4b13d5",
                                        "glosses": [
                                            "The state or characteristic of being pertinacious."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79d8ada-6e59-49c4-a80d-ef1983e7cf3d",
                                                "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                                "text": "1846, Edgar Allen Poe, The Black Cat\nWith my aversion to this cat, however, its partiality for myself seemed to increase. It followed my footsteps with a pertinacity which it would be difficult to make the reader comprehend."
                                            },
                                            {
                                                "example_id": "d1894253-3618-4609-a21b-78a4eb8c8343",
                                                "sense_id": "70bf4891-e351-3ba9-a75f-38621ab9716f",
                                                "text": "Again and again, however, and half a dozen other agains, with the inexorable pertinacity of a child intent upon some object important to itself, did he renew his efforts for admittance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50b4bbbd-1128-4189-8258-65ff7ac28c34",
                        "source_entry_id": "528ce3fe-0c9f-3595-992c-f8dd183967ab",
                        "source_sense_description": "свойство по значению прил. упрямый",
