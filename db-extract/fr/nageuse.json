                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f81451d-1fc6-4daf-940f-b960e692c1ef",
                                "sense_id": "996601aa-7c65-3c45-a95a-2052cd700065",
                                "text": "Alors, vive les reines : devant moi j’aperçois par intermittence, dans les spirales d’un nuage de bulles, les fesses bombées d’une nageuse au maillot échancré qui trace sans trop se poser de questions, petite fusée sexy."
                            },
                            {
                                "example_id": "164526ec-5388-44a9-8ac2-56650afc2fa7",
                                "sense_id": "996601aa-7c65-3c45-a95a-2052cd700065",
                                "text": "Aux championnats d’Europe en petit bassin les nageuses françaises Charlotte Bonnet et Béryl Gastaldello ont pris l’or et l’argent, jeudi en Roumanie."
                            }
                        ]
                    }
