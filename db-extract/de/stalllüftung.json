                "senses": [
                    {
                        "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                        "entry_id": "2d94bf3c-dc40-3472-a4c5-37ebabc929df",
                        "glosses": [
                            "Austausch der Raumluft durch Frischluftzufuhr in einen Stall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab44f63-2fae-4647-8aff-1131fd59a1c5",
                                "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                                "text": "„In Verbindung mit elektronischen Thermostaten sind sie zur Regelung der Stalllüftung bestens geeignet.“"
                            },
                            {
                                "example_id": "2a23a9f4-311c-4005-9d65-942721f91c2c",
                                "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                                "text": "„Um all dies zu vermeiden bzw. so gering wie möglich zu halten, ist es notwendig die Stalllüftung auf die Sommerlüftung vorzubereiten, damit diese an heißen Tagen 100 % Leistung bringen kann.“"
                            },
                            {
                                "example_id": "cd91b930-6b85-45c6-8788-513a8a4fbf28",
                                "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                                "text": "„Eine professionell geplante Stalllüftung mit ETAvent-Ventilatoren spart Im Jahresmix 50 % der Energiekosten.“"
                            },
                            {
                                "example_id": "2319e98f-f8cb-4c49-b51c-757c700aaf84",
                                "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                                "text": "„Der Stromverbrauch für die Stalllüftung ist keine unveränderliche Größe.“"
                            },
                            {
                                "example_id": "ed087244-401c-4e6f-a7c8-ea15c398e633",
                                "sense_id": "f8043bc3-939b-35d2-b2f4-1750bca60eb4",
                                "text": "„Für die Ventilatoren ist die Stalllüftung ein echter Härtetest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
