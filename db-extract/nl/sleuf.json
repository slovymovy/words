                ],
                "translations": [
                    {
                        "translation_id": "4d02d29d-8bb4-4e9d-94cf-597e06c1bd5f",
                        "source_entry_id": "18709b8d-b992-396a-bdfd-f450d38333b0",
                        "source_sense_id": "9a091d54-e4ce-3245-91d5-f2bb640cf90b",
