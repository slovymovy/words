                {
                    "sense_id": "05f183cb-01bf-3b34-b14c-644e469bedd6",
                    "sense_definition": "Возглас, выражающий требование прекратить какое-либо действие; хватит.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interjection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё, <достаточно>, я больше не хочу это обсуждать!",
                            "target_lang_translations": {
                                "en": "That's it, <enough>, I don't want to discuss this anymore!",
                                "zh": "行了，<够了>，我不想再讨论这件事了！",
                                "nl": "Klaar, <genoeg>, ik wil dit niet meer bespreken!",
                                "pl": "Wszystko, <dość>, nie chcę już więcej o tym dyskutować!",
                                "de": "Schluss, <genug>, ich möchte das nicht mehr diskutieren!",
                                "fr": "C'est bon, <ça suffit>, je ne veux plus en discuter !",
                                "it": "Basta, <basta>, non voglio più discuterne!",
                                "cs": "Dost, <stačí>, už o tom nechci diskutovat!",
                                "tr": "Tamam, <yeter>, bunu daha fazla tartışmak istemiyorum!",
                                "es": "Ya, <basta>, ¡no quiero discutir esto más!"
                            }
                        },
                        {
                            "text": "Прекратите шуметь, <достаточно>!",
                            "target_lang_translations": {
                                "en": "Stop making noise, <that's enough>!",
                                "zh": "别吵了，<够了>！",
                                "nl": "Stop met lawaai maken, <dat is genoeg>!",
                                "pl": "Przestańcie hałasować, <wystarczy>!",
                                "de": "Hört auf zu lärmen, <es reicht>!",
                                "fr": "Arrêtez de faire du bruit, <assez> !",
                                "it": "Smettetela di fare rumore, <basta>!",
                                "cs": "Přestaňte dělat hluk, <dost>!",
                                "tr": "Gürültü yapmayı kesin, <yeter>!",
                                "es": "Dejen de hacer ruido, ¡<basta>!"
                            }
                        }
                    ],
