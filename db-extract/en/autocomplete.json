    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dae80fb2-76a6-3fe4-a557-c13be236f4ca",
                "word": "autocomplete",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e518d2d-f204-39d8-b068-cae3e9027af6",
                        "entry_id": "dae80fb2-76a6-3fe4-a557-c13be236f4ca",
                        "glosses": [
                            "A software feature that predicts the rest of a word a user is typing."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ef91373a-3cb1-4f67-9868-1d723516bf65",
                                "sense_id": "0e518d2d-f204-39d8-b068-cae3e9027af6",
                                "text": "Tools like spellcheck, autocomplete, and speech-to-text impose someone's ideas of the rules of English automatically—invisible authorities that we can defy but not avoid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99645a3a-a977-4ed4-bacc-e43603bce8cc",
                        "source_entry_id": "dae80fb2-76a6-3fe4-a557-c13be236f4ca",
                        "source_sense_id": "0e518d2d-f204-39d8-b068-cae3e9027af6",
                        "source_sense_description": "feature",
                        "target_lang_word": "autocomplétion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocomplétion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0584b87f-6f67-3dbe-858e-b87309ade71d",
                                        "entry_id": "6afc09e9-a11d-37d2-9bfb-0e571439d886",
                                        "glosses": [
                                            "Fait de se compléter soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78296a26-5c7d-40bb-ac94-2c59fe1cafa5",
                                                "sense_id": "0584b87f-6f67-3dbe-858e-b87309ade71d",
                                                "text": "[…] les lacunes structurales d’un système des possibles qui n’est sans doute jamais donné comme tel dans l’expérience subjective des agents […] ne peuvent être comblées par la vertu magique d’une sorte de tendance du système à l’autocomplétion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e916f1e-7f45-3974-922a-c6f4963aec04",
                                        "entry_id": "6afc09e9-a11d-37d2-9bfb-0e571439d886",
                                        "glosses": [
                                            "Suggestion de complément proposée de manière automatique par une IHM pour former un mot à partir de tout ou partie des éléments de caractères saisis avec un clavier physique ou virtuel ou à travers d’un autre outil de saisie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f903298b-f0de-419d-bc9c-94ea2da3ecf5",
                                                "sense_id": "2e916f1e-7f45-3974-922a-c6f4963aec04",
                                                "text": "Camino 2.1 améliore sa barre d’URL avec une autocomplétion qui est annoncée comme étant plus efficace."
                                            },
                                            {
                                                "example_id": "0d8e8769-fcd0-4ac1-aa77-0653dfc328d3",
                                                "sense_id": "2e916f1e-7f45-3974-922a-c6f4963aec04",
                                                "text": "[…] l’autocomplétion lors de la citation d’une personne sera désormais plus fiable."
                                            },
                                            {
                                                "example_id": "c10cde8a-39d3-43f1-967f-2c123b1b99eb",
                                                "sense_id": "2e916f1e-7f45-3974-922a-c6f4963aec04",
                                                "text": "L’autocomplétion de chemin fonctionne de la même manière que l’autocomplétion de commande qu’on a vue dans le chapitre précédent : avec la touche Tab (Tabulation)."
                                            },
                                            {
                                                "example_id": "a1cfb657-46a1-41af-9056-a4c489c94562",
                                                "sense_id": "2e916f1e-7f45-3974-922a-c6f4963aec04",
                                                "text": "La fonction « d’autocomplétion » vous proposera ce lieu quand vous saisirez les premières lettres de l’alias que vous aurez défini : moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
