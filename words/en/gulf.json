{
    "word_family": [
        "engulf"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b9cfffe-c0b4-3d49-a5bf-5cc42f503476",
                    "sense_definition": "A portion of an ocean or sea extending into the land; a partially landlocked sea",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gulf</w> of Mexico is a large body of water surrounded by North America.",
                            "target_lang_translations": {
                                "ru": "Мексиканский <w>залив</w> — это огромный водоем, окруженный Северной Америкой."
                            }
                        },
                        {
                            "text": "Many ships sail through the <w>gulf</w> to reach the busy port.",
                            "target_lang_translations": {
                                "ru": "Многие корабли проходят через <w>залив</w>, чтобы добраться до оживленного порта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deep gulf",
                        "coastal gulf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть океана или моря, глубоко вдающаяся в сушу; частично замкнутое море"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залив",
                                "target_lang_sense_clarification": "географический объект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebd37b58-95d9-3ef1-95e9-2ef8af61d314",
                    "sense_definition": "A large difference or gap between groups, ideas, or people",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a widening <w>gulf</w> between the rich and the poor in many countries.",
                            "target_lang_translations": {
                                "ru": "Во многих странах между богатыми и бедными растет <w>пропасть</w>."
                            }
                        },
                        {
                            "text": "The <w>gulf</w> in class between the two teams was obvious during the match.",
                            "target_lang_translations": {
                                "ru": "<w>Разрыв</w> в классе между двумя командами был очевиден во время матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "abyss",
                        "rift"
                    ],
                    "common_phrases": [
                        "widening gulf",
                        "gulf in class",
                        "bridge the gulf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая разница или разрыв между группами, идеями или людьми"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропасть",
                                "target_lang_sense_clarification": "в переносном смысле о различиях"
                            },
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "большая разница"
                            },
                            {
                                "target_lang_word": "бездна",
                                "target_lang_sense_clarification": "огромное различие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3433019-3073-391e-9fc5-58542142ec8a",
                    "sense_definition": "A deep chasm, abyss, or hollow place in the earth",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers stared down into the dark <w>gulf</w> beneath the cliff.",
                            "target_lang_translations": {
                                "ru": "Исследователи вглядывались в темную <w>бездну</w> под утесом."
                            }
                        },
                        {
                            "text": "A mighty <w>gulf</w> opened up in the ground after the earthquake.",
                            "target_lang_translations": {
                                "ru": "После землетрясения в земле разверзлась огромная <w>пропасть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abyss"
                    ],
                    "common_phrases": [
                        "mighty gulf",
                        "dark gulf"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокая расщелина, бездна или пустота в земле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездна",
                                "target_lang_sense_clarification": "глубокая пропасть"
                            },
                            {
                                "target_lang_word": "пропасть",
                                "target_lang_sense_clarification": "глубокая расщелина"
                            },
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "глубокая впадина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2e97e3c-a8fa-387b-a108-eaa7991f0af7",
                    "sense_definition": "Something that swallows or consumes things irretrievably, like a whirlpool",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project became a <w>gulf</w> of ruin that swallowed all their investment gold.",
                            "target_lang_translations": {
                                "ru": "Проект стал <w>пучиной</w> разорения, поглотившей все их инвестиционное золото."
                            }
                        },
                        {
                            "text": "The ship was lost in the <w>gulf</w> of the violent whirlpool.",
                            "target_lang_translations": {
                                "ru": "Корабль сгинул в <w>пучине</w> яростного водоворота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gulf of ruin"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что безвозвратно поглощает вещи, подобно водовороту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "поглощающая бездна"
                            },
                            {
                                "target_lang_word": "водоворот",
                                "target_lang_sense_clarification": "в переносном смысле о разрушении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce64f772-4654-363c-b0ad-d1637bc10328",
                    "sense_definition": "The bottom part of a list of degree candidates who only just passed",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students who barely passed were placed in the <w>gulf</w> on the final list.",
                            "target_lang_translations": {
                                "ru": "Студенты, которые едва сдали, были помещены в <w>список едва сдавших</w> в итоговой ведомости."
                            }
                        },
                        {
                            "text": "He was relieved to find his name in the <w>gulf</w> rather than failing entirely.",
                            "target_lang_translations": {
                                "ru": "Он испытал облегчение, найдя свое имя в <w>списке едва сдавших</w>, а не провалившись совсем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Cambridge University slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical academic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть списка кандидатов на степень, которые едва сдали экзамен"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "список едва сдавших",
                                "target_lang_sense_clarification": "академический сленг Кембриджа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fc835702-ed55-365d-855b-03d2955c5720",
                    "sense_definition": "The Persian Gulf or the surrounding region",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Many <w>Gulf</w> states are major exporters of oil to the rest of the world.",
                            "target_lang_translations": {
                                "ru": "Многие страны <w>Залива</w> являются крупными экспортерами нефти в остальной мир."
                            }
                        },
                        {
                            "text": "The <w>Gulf</w> War had a significant impact on international relations in the nineties.",
                            "target_lang_translations": {
                                "ru": "Война в <w>Персидском заливе</w> оказала значительное влияние на международные отношения в девяностые годы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Gulf States",
                        "Gulf War"
                    ],
                    "target_lang_definitions": {
                        "ru": "Персидский залив или прилегающий к нему регион"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Персидский залив",
                                "target_lang_sense_clarification": "географический регион"
                            },
                            {
                                "target_lang_word": "Залив",
                                "target_lang_sense_clarification": "краткое название региона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4b20ada-fc78-3de6-a6a6-02a458b31473",
                    "sense_definition": "The Gulf of Mexico or the surrounding region",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Gulf</w> Stream brings warm water from the tropics to the North Atlantic.",
                            "target_lang_translations": {
                                "ru": "<w>Гольфстрим</w> несет теплые воды из тропиков в Северную Атлантику."
                            }
                        },
                        {
                            "text": "Several <w>Gulf</w> states in the US were affected by the hurricane.",
                            "target_lang_translations": {
                                "ru": "Несколько штатов США на побережье <w>Мексиканского залива</w> пострадали от урагана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Gulf Stream",
                        "Gulf Coast"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мексиканский залив или прилегающий к нему регион"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мексиканский залив",
                                "target_lang_sense_clarification": "географический регион"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e15a12b6-9ac8-3e60-bbcb-25a612d69bbc",
                    "sense_definition": "To <w>engulf</w> or swallow up",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stormy sea threatened to <w>gulf</w> the small boat in its waves.",
                            "target_lang_translations": {
                                "ru": "Штормовое море грозило <w>поглотить</w> маленькую лодку в своих волнах."
                            }
                        },
                        {
                            "text": "The dark waters <w>gulfed</w> him deep beneath the surface.",
                            "target_lang_translations": {
                                "ru": "Темные воды <w>затянули</w> его глубоко под поверхность."
                            }
                        }
                    ],
                    "synonyms": [
                        "abyss"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поглощать или заглатывать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "заглатывать целиком"
                            },
                            {
                                "target_lang_word": "засасывать",
                                "target_lang_sense_clarification": "о воде или бездне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71d5d77c-e0d7-3016-b24b-642d826cf3ee",
                    "sense_definition": "To award a degree to someone who has only just passed the examination",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor predicted that the lazy student would be <w>gulfed</w> at best.",
                            "target_lang_translations": {
                                "ru": "Профессор предсказал, что ленивый студент в лучшем случае <w>едва сдаст</w>."
                            }
                        },
                        {
                            "text": "He was <w>gulfed</w> in the final exams, barely securing his degree.",
                            "target_lang_translations": {
                                "ru": "Он <w>едва сдал</w> выпускные экзамены, с трудом получив степень."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical academic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Присвоить ученую степень тому, кто едва сдал экзамен"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачислить в список едва сдавших",
                                "target_lang_sense_clarification": "устаревший академический сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}