                "senses": [
                    {
                        "sense_id": "e6291634-e07c-3306-b4f8-042235131be7",
                        "entry_id": "ffd6fad1-af36-3613-a313-bd4a2970f6d2",
                        "glosses": [
                            "ein Tag, an dem sich uralte, oft langfristige Wettervorhersagen und Erntehoffnungen festmachen"
                        ],
                        "tags": [
                            "Volksbrauchtum"
                        ],
                        "examples": [
                            {
                                "example_id": "32b6cdfe-efc6-46b3-ad6f-d7dbd6b61512",
                                "sense_id": "e6291634-e07c-3306-b4f8-042235131be7",
                                "text": "„Der Lichtmeßtag war ein sogenannter Lurtag. Mit ihm begannen die Bräuche des Winteraustreibens […]“"
                            },
                            {
                                "example_id": "5c5e35ff-b5df-4244-bd43-65ff43b18386",
                                "sense_id": "e6291634-e07c-3306-b4f8-042235131be7",
                                "text": "„Der Johannistag ist ein wichtiger Lostag (auch Lurtag) im Kalender des Bauernjahres.“"
                            },
                            {
                                "example_id": "6e82ba07-0976-430b-ac4e-a46e037c3068",
                                "sense_id": "e6291634-e07c-3306-b4f8-042235131be7",
                                "text": "Die Schafskälte gehört zu den Lurtagen."
                            },
                            {
                                "example_id": "ae2b187d-1116-46da-b02b-1c8e980026b5",
                                "sense_id": "e6291634-e07c-3306-b4f8-042235131be7",
                                "text": "Lichtmess (2. Februar) ist ein besonderer Lurtag."
                            }
                        ],
                        "sense_index_json": "\"1\""
