                ],
                "senses": [
                    {
                        "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                        "entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "glosses": [
                            "A very direct or quick path or trip."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3242090a-3a73-4076-9ece-6ae624d4883f",
                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                "text": "to make / strike a beeline for / to something"
                            },
                            {
                                "example_id": "b56e3d42-4f60-4ff4-aa15-84c36d39180d",
                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                "text": "The children made a beeline to the swimming pool."
                            },
                            {
                                "example_id": "b4880828-087e-4248-8712-7f1d8c7daa3b",
                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                "text": "Discussing these and kindred topics they made a beeline across the back of the Customhouse and passed under the Loop Line bridge where a brazier of coke burning in front of a sentrybox or something like one attracted their rather lagging footsteps."
                            },
                            {
                                "example_id": "d61a4850-3295-48b2-b95a-06ad609e54b0",
                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                "text": "Hershie made a beeline for Thomas's table, not making eye-contact with the others — old-guard activists who still saw him as a tool of the war-machine."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b0a3a12-d372-3ba1-a573-ea851d36f982",
                        "entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                        "glosses": [
                            "A dynamite fuse made with a small quantity of dynamite powder along its length, so that the spark travels quickly and at a specific known rate."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
