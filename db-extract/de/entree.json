                        "examples": [
                            {
                                "example_id": "b0ee72b0-8488-4a6a-a1b7-cf1d790c767c",
                                "sense_id": "a5ed2d93-45bf-36cb-b3e3-3741231c438a",
                                "text": "„Diese Herkunft bereitete ihr ein vorzügliches Entree in die gehobenen Kreise von Paris.“"
                            },
                            {
                                "example_id": "57d9d5ac-4e83-46fd-bdfd-e45a6ef22b15",
                                "sense_id": "a5ed2d93-45bf-36cb-b3e3-3741231c438a",
                                "text": "„Das Entree erinnert Reto an die »Palazzi« der Geldaristokraten, bei denen er Unterhaltungsjazz gespielt hat.“"
                            }
                        ],
