        "nl-extract.jsonl": [
            {
                "entry_id": "d24cd9ce-8ea0-3f25-87b8-d4897147a634",
                "word": "onderscheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a3d1a7b-9cbf-3a3f-955f-48da44de8fbb",
                        "entry_id": "d24cd9ce-8ea0-3f25-87b8-d4897147a634",
                        "glosses": [
                            "differentiatie, verschil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f481f7-f7cd-40f0-9984-6171961bf297",
                                "sense_id": "7a3d1a7b-9cbf-3a3f-955f-48da44de8fbb",
                                "text": "Ik vond het mooi om te zien dat ze mijn situatie begreep en een onderscheid kon maken tussen hoofd- en bijzaak."
                            },
                            {
                                "example_id": "133f3883-cb2e-4d8b-9d80-a07d2e3c3b68",
                                "sense_id": "7a3d1a7b-9cbf-3a3f-955f-48da44de8fbb",
                                "text": "Buiten de wintermaanden gebruiken honderden boeren langs de Maas de grond voor de verbouw van bijvoorbeeld aardappelen en maïs en voor gras- en hooiland. De boeren betogen dat er geen onderscheid gemaakt moet worden tussen schade binnen en buiten de dijk."
                            },
                            {
                                "example_id": "15d03fac-1891-4d91-97f1-654417cd7328",
                                "sense_id": "7a3d1a7b-9cbf-3a3f-955f-48da44de8fbb",
                                "text": "\"Het gaat dus om regels of processen die direct onderscheid maken en om regels of processen die op het eerste gezicht neutraal lijken, maar er in de praktijk wel toe leiden dat de ene groep benadeeld wordt en de andere groep bevoordeeld.\""
                            }
                        ]
                    }
                ],
