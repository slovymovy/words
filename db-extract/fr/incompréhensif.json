                ],
                "senses": [
                    {
                        "sense_id": "e1c763d6-c937-3988-b1c9-e65d581e798a",
                        "entry_id": "4ef8c91d-7c0a-3e65-be81-83d8f53a758e",
                        "glosses": [
                            "Qui fait preuve d'incompréhension, qui ne comprend pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0dc24e-90de-4845-82f3-84b94d783adb",
                                "sense_id": "e1c763d6-c937-3988-b1c9-e65d581e798a",
                                "text": "Leurs enfants [d’ex-gauchistes], entre-temps presque aussi âgés que l’étaient à l’époque les parents, assistent incompréhensifs à ces débats autour d’idéaux qui leur sont tout à fait étrangers."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f1fc10-a1d2-3c4c-9d37-1c48c1217851",
                        "entry_id": "4ef8c91d-7c0a-3e65-be81-83d8f53a758e",
                        "glosses": [
                            "Qui ne fait pas preuve de compréhension, impassible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7cc0e6-91d0-4e9b-a25e-e48b2b5c8f5a",
                                "sense_id": "90f1fc10-a1d2-3c4c-9d37-1c48c1217851",
                                "text": "l'hostilité que lui témoignaient parfois des confrères incompréhensifs ou jaloux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5d098a5-46f8-45aa-aa6e-676d39e9d48b",
                        "source_entry_id": "4ef8c91d-7c0a-3e65-be81-83d8f53a758e",
                        "target_lang_word": "unsympathizing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsympathizing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44a44e38-a474-3c1b-bf0e-e73cb6524380",
                                        "entry_id": "be0ce615-5e37-303d-9aa0-591901f6fb39",
                                        "glosses": [
                                            "Failing to sympathize; lacking sympathy"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965800ec-9383-4888-a37a-6619955ff85f",
                                                "sense_id": "44a44e38-a474-3c1b-bf0e-e73cb6524380",
                                                "text": "It is often affirmed that utilitarianism renders men cold and unsympathizing; that it chills their moral feelings towards individuals; that it makes them regard only the dry and hard consideration of the consequences of actions, not taking into their moral estimate the qualities from which those actions emanate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdca568e-4bdd-41a2-a3ed-673bb479799f",
                        "source_entry_id": "4ef8c91d-7c0a-3e65-be81-83d8f53a758e",
                        "target_lang_word": "unsympathetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsympathetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f464e3-0471-359d-b318-64ae69417925",
                                        "entry_id": "7b525a34-c1da-3f6f-8591-01e3ff12adac",
                                        "glosses": [
                                            "Not sympathetic; ill-disposed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327cf3a9-b18f-467c-9d83-b49a5b7c696d",
                                                "sense_id": "11f464e3-0471-359d-b318-64ae69417925",
                                                "text": "His tall, gaunt, stringy figure is insensible to fatigue, and his dry, half-sarcastic, and often wholly unsympathetic manner is uninfluenced by any change in his surroundings."
                                            },
                                            {
                                                "example_id": "ec7cbdf2-8bd1-456f-9c86-4d45f3d56713",
                                                "sense_id": "11f464e3-0471-359d-b318-64ae69417925",
                                                "text": "After years of unsympathetic commercial use and dereliction, nothing of note remained inside, which accordingly has been reconfigured with modern amenities such as underfloor heating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
