                        "examples": [
                            {
                                "example_id": "b6fe1e0a-c85c-4d83-a4db-0885b274fbc7",
                                "sense_id": "6c826ccb-48b1-3b32-9687-9f9c5156519b",
                                "text": "Une méchine est une servante."
                            },
                            {
                                "example_id": "1eaf9069-f824-4179-9e2c-6aa3fd4ef3c2",
                                "sense_id": "6c826ccb-48b1-3b32-9687-9f9c5156519b",
                                "text": "Elle va droit devant elle tout au long d'une rue, quand à la distance d'une pierre lancée, elle voit sortir d'une maison une méchine portant deux pots à la main ;…."
                            },
                            {
                                "example_id": "0fd307a6-e054-4fc1-bc12-40bfac9a71d1",
                                "sense_id": "6c826ccb-48b1-3b32-9687-9f9c5156519b",
                                "text": "Le petit est dru, et des étroites croisées du manoir on entend ses cris perçants, signe, a dit la méchine, qu'il aura « durs poings et bon gousier »."
                            }
                        ]
                    }
