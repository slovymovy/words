                        "glosses": [
                            "Enfermer un produit, solide, liquide ou pâteux, dans des microparticules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16055dda-c627-4f89-8300-8217c90c2145",
                                "sense_id": "d61717d3-daf0-35d9-9d20-6afd5e12cc49",
                                "text": "Parmi les différentes technologies disponibles pour « microencapsuler », celle qui met en œuvre un lit d'air fluidisé permet de réaliser des microcapsules à base de lipides."
                            },
                            {
                                "example_id": "a3111021-40a9-4d4b-a750-dcab59040c30",
                                "sense_id": "d61717d3-daf0-35d9-9d20-6afd5e12cc49",
                                "text": "Le type de fabrication mis en œuvre dépend de la substance à microencapsuler, du diamètre à obtenir, des contraintes de production."
