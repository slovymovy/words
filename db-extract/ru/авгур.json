                                        "glosses": [
                                            "Individuo que sabe predecir el futuro por medio del agüero."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff4cde4-6fe4-444f-9ce0-6464367aeb02",
                                                "sense_id": "8a2bbc59-a7c1-3e15-a925-c7b8f1e31e3b",
