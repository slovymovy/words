                                        "glosses": [
                                            "streichfähige, in seltenen Fällen auch schnittfeste Kochwurst, die aus Leber und anderen Innereien sowie Fett, Speck, Muskelfleisch und verschiedenen Gewürzen wie Majoran oder Thymian hergestellt wird"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02f5bd9-51fa-4d45-9e5b-70c9ebf27972",
                                                "sense_id": "35d891aa-f0b1-332d-964e-48fcf3952556",
                                                "text": "Jeden Morgen schmiere ich mir Leberwurst auf mein Pausenbrot und gehe dann zur Schule.",
                                                "translation": "[…]"
                                            },
                                            {
                                                "example_id": "ada5ef87-5b91-4ec7-a6f5-fd16b1a22539",
                                                "sense_id": "35d891aa-f0b1-332d-964e-48fcf3952556",
                                                "text": "„So kam die Abenddämmerung herauf, die Großmama reichte Schnittchen mit Lachsschinken, Leberwurst und Essiggurke.“"
                                            },
                                            {
                                                "example_id": "38e8cafa-b6a4-453d-95ce-ff3cbad7ea27",
                                                "sense_id": "35d891aa-f0b1-332d-964e-48fcf3952556",
                                                "text": "„Ein warmer Geruch von frischer Blut- und Leberwurst schlug ihm entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
