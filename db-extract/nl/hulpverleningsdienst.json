                        "examples": [
                            {
                                "example_id": "03ab3e1a-c17b-4cbe-8c22-f2247004ac79",
                                "sense_id": "065f127a-f8e4-31c6-8a40-19d5ab90edbd",
                                "text": "Vijfentwintig huishoudens zitten nog zeker tot middernacht zonder gas. In een centrale ruimte van de serviceflat zijn mobiele kachels neergezet, waar de bewoners zich aan kunnen warmen. Volgens de Hulpverleningsdienst Drenthe zijn er geen gewonden."
                            },
                            {
                                "example_id": "f146477e-11a5-42fa-b517-4598cfb5157e",
                                "sense_id": "065f127a-f8e4-31c6-8a40-19d5ab90edbd",
                                "text": "Weginspecteurs van Rijkswaterstaat rijden vanaf nu met een blauw zwaailicht en een sirene. Rijkswaterstaat heeft de officiële status van hulpverleningsdienst gekregen, zodat ze die lichten mogen voeren en bij ongelukken sneller ter plaatse zijn."
                            }
