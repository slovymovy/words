{
    "word_family": [
        "temperate",
        "temperature",
        "tempering",
        "tempered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33067c88-0e2a-3bea-b7a0-5419cc1fcf9f",
                    "sense_definition": "A sudden state of anger or a fit of rage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often flies into a <w>temper</w> when things do not go his way.",
                            "target_lang_translations": {
                                "tr": "İşler istediği gibi gitmediğinde sık sık <w>öfke</w> nöbetine girer."
                            }
                        },
                        {
                            "text": "She slammed the door in a <w>temper</w> after the argument.",
                            "target_lang_translations": {
                                "tr": "Tartışmadan sonra <w>öfkeyle</w> kapıyı çarptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "rage"
                    ],
                    "common_phrases": [
                        "lose one's temper",
                        "fly into a temper"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ani bir öfke durumu veya hiddet nöbeti."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "öfke",
                                "target_lang_sense_clarification": "Ani ve şiddetli kızgınlık hali."
                            },
                            {
                                "target_lang_word": "hiddet",
                                "target_lang_sense_clarification": "Kontrolsüz ve ani sinirlenme durumu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f61b36de-c1b0-30e6-8ea4-42b79976cf86",
                    "sense_definition": "A natural tendency to become angry easily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager has a short <w>temper</w> and shouts at his employees.",
                            "target_lang_translations": {
                                "tr": "Müdürün <w>sinirli bir yapısı</w> var ve çalışanlarına bağırıyor."
                            }
                        },
                        {
                            "text": "She has quite a <w>temper</w> when she is under pressure at work.",
                            "target_lang_translations": {
                                "tr": "İşte baskı altındayken oldukça <w>huysuzlaşabiliyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a temper"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kolayca sinirlenmeye yönelik doğal bir eğilim."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sinirli yapı",
                                "target_lang_sense_clarification": "Kişinin genel olarak çabuk öfkelenen karakteri."
                            },
                            {
                                "target_lang_word": "huysuzluk",
                                "target_lang_sense_clarification": "Kolay sinirlenme eğilimi gösteren mizaç."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0c727a3-8f24-3294-b81e-4b5343523ee2",
                    "sense_definition": "A person's habitual mood or general way of reacting to the world.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a person of a calm <w>temper</w> who rarely gets upset.",
                            "target_lang_translations": {
                                "tr": "Nadir sinirlenen, sakin <w>mizaçlı</w> bir insandır."
                            }
                        },
                        {
                            "text": "His cheerful <w>temper</w> makes him very popular among his colleagues.",
                            "target_lang_translations": {
                                "tr": "Neşeli <w>huyu</w> onu meslektaşları arasında çok popüler kılıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "disposition",
                        "temperament"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir kişinin alışılmış ruh hali veya dünyaya karşı genel tepki biçimi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mizaç",
                                "target_lang_sense_clarification": "Kişinin doğuştan gelen genel karakter yapısı."
                            },
                            {
                                "target_lang_word": "huy",
                                "target_lang_sense_clarification": "Kişinin alışılmış davranış ve tepki biçimi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95a7c8a0-ef96-31b1-b3f2-5723fc85a31d",
                    "sense_definition": "The ability to remain calm and composed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to keep your <w>temper</w> during a difficult negotiation.",
                            "target_lang_translations": {
                                "tr": "Zorlu bir müzakere sırasında <w>soğukkanlılığınızı</w> korumak önemlidir."
                            }
                        },
                        {
                            "text": "She managed to recover her <w>temper</w> after the initial shock.",
                            "target_lang_translations": {
                                "tr": "İlk şoktan sonra <w>sükunetini</w> yeniden kazanmayı başardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep one's temper"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sakin ve soğukkanlı kalabilme yeteneği."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "soğukkanlılık",
                                "target_lang_sense_clarification": "Zor durumlarda sakin kalabilme durumu."
                            },
                            {
                                "target_lang_word": "sükunet",
                                "target_lang_sense_clarification": "Duygusal dengeyi koruma hali."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b721a490-b62b-3fd0-83a1-d58ed60bb9b2",
                    "sense_definition": "The degree of hardness or elasticity of a metal, often achieved through heating and cooling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith checked the <w>temper</w> of the steel blade.",
                            "target_lang_translations": {
                                "tr": "Demirci, çelik bıçağın <w>tavını</w> kontrol etti."
                            }
                        },
                        {
                            "text": "The metal was heated to improve the <w>temper</w> of the tool.",
                            "target_lang_translations": {
                                "tr": "Aletin <w>tavını</w> iyileştirmek için metal ısıtıldı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir metalin ısıtılıp soğutulmasıyla elde edilen sertlik veya esneklik derecesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tav",
                                "target_lang_sense_clarification": "Metalurjide metalin ısıtılıp soğutularak kazandığı sertlik derecesi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e226635-0d71-329d-b637-246349082f87",
                    "sense_definition": "To moderate, soften, or control something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moderation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>temper</w> your criticism with some positive feedback.",
                            "target_lang_translations": {
                                "tr": "Eleştirilerinizi biraz olumlu geri bildirimle <w>yumuşatmalısınız</w>."
                            }
                        },
                        {
                            "text": "He tried to <w>temper</w> his excitement with a sense of caution.",
                            "target_lang_translations": {
                                "tr": "Heyecanını bir temkin duygusuyla <w>dengelemeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "season"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi yumuşatmak, hafifletmek veya dengelemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yumuşatmak",
                                "target_lang_sense_clarification": "Sert bir ifadeyi veya duyguyu daha kabul edilebilir kılmak."
                            },
                            {
                                "target_lang_word": "dengelemek",
                                "target_lang_sense_clarification": "Aşırı bir durumu makul bir seviyeye çekmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434460f8-a6a2-3461-a231-cfb485ecb62a",
                    "sense_definition": "To strengthen metal or glass by heating and cooling it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory uses a special process to <w>temper</w> the glass for safety.",
                            "target_lang_translations": {
                                "tr": "Fabrika, güvenlik için camı <w>temperlemek</w> amacıyla özel bir işlem kullanıyor."
                            }
                        },
                        {
                            "text": "They <w>temper</w> the steel to make it more durable for construction.",
                            "target_lang_translations": {
                                "tr": "İnşaat için daha dayanıklı hale getirmek amacıyla çeliği <w>tavlarlar</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Metal veya camı ısıtıp soğutarak güçlendirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tavlamak",
                                "target_lang_sense_clarification": "Metali ısıtıp soğutarak sertliğini ayarlamak."
                            },
                            {
                                "target_lang_word": "temperlemek",
                                "target_lang_sense_clarification": "Camı veya metali dayanıklı hale getirmek için uygulanan ısıl işlem."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}