                    {
                        "translation_id": "bb1cddad-c4e6-4cf5-a709-892d6b355f49",
                        "source_entry_id": "36faaa3c-f30a-3b9a-9025-366b7018e7fc",
                        "source_sense_id": "42757d1b-be62-3b43-89c5-320db3ed75cc",
                        "target_lang_word": "threeside",
