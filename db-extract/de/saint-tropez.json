                "translations": [
                    {
                        "translation_id": "52d3a6dd-87e7-43a0-9a8e-b75b7f27c2a0",
                        "source_entry_id": "52d8af9a-413b-3dd7-8ab9-fb19281664e8",
                        "source_sense_id": "fef6fd64-b2e8-3d63-8ec7-7cfacdd0e877",
                        "source_sense_description": "Hafenort in Südfrankreich",
                        "target_lang_word": "Saint-Tropez",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saint-Tropez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                        "entry_id": "b3d39ec5-1956-39dc-8821-997f26f95923",
                                        "glosses": [
                                            "Commune française, située dans le département du Var."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87459328-904b-42ff-bbe7-9e9ca93bf22c",
                                                "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                                "text": "Peter Bike vouait aux furies son producteur français, le seul à ne pas être, en août, à Saint-Tropez."
                                            },
                                            {
                                                "example_id": "b764c24b-ce9d-4a34-b82a-3f493aef8fba",
                                                "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                                "text": "À côté, se trouve Saint-Tropez, où trois cent mille Parisiens, tous les ans, se retrempent dans la solitude, et qui est devenu, pour ainsi dire, la capitale intellectuelle des grandes vacances. Sempé n’en laisse rien ignorer."
                                            },
                                            {
                                                "example_id": "1bf8770e-fe56-46aa-8d3d-a1f8e552aafc",
                                                "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                                "text": "Au printemps 1953, ou plutôt à l’avant-printemps, nous partîmes tous les trois pour Saint-Tropez, sous le prétexte de prendre du repos, qui consistait en fait pour Sartre en un travail acharné, plus soutenu qu’à Paris parce que plus tranquille."
                                            },
                                            {
                                                "example_id": "26952e6e-bdef-4c98-8c31-e196a7872a3a",
                                                "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                                "text": "Précision : dans le port de Saint-Tropez, la quasi-totalité des yachts, qui appartiennent à des milliardaires français, battent, pour raison fiscale, pavillon de complaisance."
                                            },
                                            {
                                                "example_id": "e0e2e6be-4e47-4a1c-95c3-c2b0d8bc6903",
                                                "sense_id": "9b7b4439-3bfb-34a6-8829-7fab76d0ca88",
                                                "text": "Elle s’est enfermée, parce qu’elle arrive de la plage de Saint-Tropez, pieds nus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
