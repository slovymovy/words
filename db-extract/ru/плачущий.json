                "senses": [
                    {
                        "sense_id": "376e55b3-7298-3102-a086-dbe3f0baaa14",
                        "entry_id": "eeaf75b8-dd92-3346-8401-67efc9155f1e",
                        "glosses": [
                            "действ. прич. наст. вр. от плакать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5a4ea4-7799-4712-a812-88f404c5f111",
                                "sense_id": "376e55b3-7298-3102-a086-dbe3f0baaa14",
                                "text": "Мог на крышу закарабкаться, как заправский циркач, чтобы снять котёнка и вручить плачущему бутузу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fd5fbad-ff37-4a3e-8027-86137daa859e",
                        "source_entry_id": "eeaf75b8-dd92-3346-8401-67efc9155f1e",
                        "source_sense_id": "376e55b3-7298-3102-a086-dbe3f0baaa14",
                        "target_lang_word": "teary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2644375d-4bf4-37e1-a649-e75b3c8412e5",
                                        "entry_id": "26773af8-d838-38b1-b94f-086ad513540e",
                                        "glosses": [
                                            "Of a person, having eyes filled with tears; inclined to cry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd749f2-4190-4d73-8868-8ca2608a5d6b",
                                                "sense_id": "2644375d-4bf4-37e1-a649-e75b3c8412e5",
                                                "text": "No wonder Ryan was teary; he missed his parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b08bf95-9bfc-3f81-aa39-27e389027ed9",
                                        "entry_id": "26773af8-d838-38b1-b94f-086ad513540e",
                                        "glosses": [
                                            "Of eyes, filled with tears."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5dea2b-b261-407d-947b-61ea551f2730",
                                                "sense_id": "5b08bf95-9bfc-3f81-aa39-27e389027ed9",
                                                "text": "Wade looked into his girlfriend's teary eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c71392ec-1c04-4618-a71e-d7b01e92227b",
                        "source_entry_id": "eeaf75b8-dd92-3346-8401-67efc9155f1e",
                        "source_sense_id": "376e55b3-7298-3102-a086-dbe3f0baaa14",
                        "target_lang_word": "tearful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Accompanied by tears; crying, or about to cry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4762eb59-7d71-4afb-9084-6892ce470b15",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "Aaron got a little tearful until Laura came to reassure him."
                                            },
                                            {
                                                "example_id": "8a6bb657-913f-4e86-b124-097d17089f7f",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "The week that was yet to elapse, she spent in wandering through her uncle's favourite walks in hours of tearful vigil, beside his tomb, and in collecting together every trifle on which he had set a value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Sorrowful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83d4fa2-464a-4690-b443-ec5460465a6f",
                                                "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                                "text": "Receiving the news of Joseph Beam's death two days after Christmas was a piercing blow that sent me into a tearful and contemplative stupor from which I have not yet emerged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
