                ],
                "senses": [
                    {
                        "sense_id": "029eb71b-ab66-3cc7-a0ff-103c51acf33c",
                        "entry_id": "d89f7484-d5ac-3dd4-b39b-e2925b21fe8e",
                        "glosses": [
                            "die Bildmarke ist eine Marke, die aus einer bildlichen Abbildung besteht und mit ® gekennzeichnet werden kann"
                        ],
                        "tags": [
                            "Markenrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "796c7e73-20fc-4d8d-9b66-12239de9e5a7",
                                "sense_id": "029eb71b-ab66-3cc7-a0ff-103c51acf33c",
                                "text": "Bildmarken sind Markenzeichen, die beim Deutschen Patent- und Markenamt (DPMA) angemeldet, geprüft, registriert und eingetragen werden können."
                            },
                            {
                                "example_id": "3d95121f-5b28-45d0-b320-1819db456535",
                                "sense_id": "029eb71b-ab66-3cc7-a0ff-103c51acf33c",
                                "text": "„Bildmarken sind Bilder, Bildelemente oder Abbildungen (ohne Wortbestandteile). Wort-/Bildmarken bestehen aus einer Kombination von Wort- und Bildbestandteilen, oder aus Wörtern, die grafisch gestaltet sind.“"
                            },
                            {
                                "example_id": "e0e4d76b-88a3-460d-a94a-837634559139",
                                "sense_id": "029eb71b-ab66-3cc7-a0ff-103c51acf33c",
                                "text": "„Mit der in ihrer Werbung für Inspektionsarbeiten angeführten Bildmarke von VW hat die Werkstatt ein mit der Marke identisches Zeichen für identische Dienstleistungen (Wartung von Fahrzeugen) verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7e54b0f-d46e-360f-b1b9-4db336f099f8",
                        "entry_id": "d89f7484-d5ac-3dd4-b39b-e2925b21fe8e",
                        "glosses": [
                            "Markenrecht: eine Wort-/Bildmarke ist eine Marke, die aus einem Wort und bildlicher Gestaltung besteht und mit ® gekennzeichnet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c2f15d-53a2-479f-999b-4a207e6fab7c",
                                "sense_id": "e7e54b0f-d46e-360f-b1b9-4db336f099f8",
                                "text": "Bildmarken sind Markenzeichen, die beim Deutschen Patent- und Markenamt (DPMA) angemeldet, geprüft, registriert und eingetragen werden können."
                            },
                            {
                                "example_id": "6c0b768c-52e3-46b3-8ec0-bbe3fe237649",
                                "sense_id": "e7e54b0f-d46e-360f-b1b9-4db336f099f8",
                                "text": "„Wort-/Bildmarken bestehen aus einer Kombination von Wort- und Bildbestandteilen, oder aus Wörtern, die grafisch gestaltet sind.“"
                            },
                            {
                                "example_id": "1a6e5d22-78b5-47fc-abb9-6bf6bec24534",
                                "sense_id": "e7e54b0f-d46e-360f-b1b9-4db336f099f8",
                                "text": "„ Wort- und Bildmarken können darüber hinaus in Kombination als Wort-/Bildmarke geschützt werden (z. B. das geschwungene „M“ im Wort „McDonalds“).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
