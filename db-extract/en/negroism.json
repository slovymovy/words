                        "glosses": [
                            "A behaviour, speech pattern, etc. characteristic of black people."
                        ],
                        "tags": [
                            "dated",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "148f8ed4-d7d6-4433-863b-d641987826d1",
                                "sense_id": "fab353ad-f1f4-32ac-bba2-7625209f9406",
                                "text": "Most white children have negresses for nurses, and negro children for playmates. The first accents are caught from them, and the first efforts of speech are negroisms, the most corrupt of patoise."
                            },
                            {
                                "example_id": "0c9c322b-4905-41e9-99bf-a431de545527",
                                "sense_id": "fab353ad-f1f4-32ac-bba2-7625209f9406",
                                "text": "When I pitched headforemost into the world I landed in the crib of negroism. From the earliest rocking of my cradle, I had known about the capers Brer Rabbit is apt to cut and what the Squinch Owl says from the house top."
                            }
                        ]
                    }
