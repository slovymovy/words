{
    "word_family": [
        "wedging",
        "wedgy",
        "wedgie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8b77d12-7008-38a3-9af4-53979498d8f5",
                    "sense_definition": "A piece of material, such as metal or wood, thick at one edge and tapered to a thin edge at the other, used for splitting or securing objects.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stick a <w>wedge</w> under the door so it stays open while I carry these boxes.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подложи <w>клин</w> под дверь, чтобы она оставалась открытой, пока я ношу эти коробки."
                            }
                        },
                        {
                            "text": "The carpenter used a small wooden <w>wedge</w> to level the uneven table leg.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал небольшой деревянный <w>клин</w>, чтобы выровнять шатающуюся ножку стола."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden wedge",
                        "door wedge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет из металла или дерева, толстый с одного края и сужающийся к другому, используемый для раскалывания или закрепления объектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "инструмент или деталь"
                            },
                            {
                                "target_lang_word": "подпорка",
                                "target_lang_sense_clarification": "для фиксации двери или мебели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7e88f1-497c-3123-acda-263c137df352",
                    "sense_definition": "A piece of food or other material that has a triangular or tapered shape.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served a large <w>wedge</w> of cheese along with the fresh fruit platter.",
                            "target_lang_translations": {
                                "ru": "Она подала большой <w>кусок</w> сыра вместе с тарелкой свежих фруктов."
                            }
                        },
                        {
                            "text": "We ordered a box of baked potato <w>wedges</w> to go with our pizza tonight.",
                            "target_lang_translations": {
                                "ru": "Мы заказали порцию запеченных картофельных <w>долек</w> к пицце на сегодняшний вечер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedge of cheese",
                        "potato wedges",
                        "lemon wedge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок еды или другого материала, имеющий треугольную или сужающуюся форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломтик",
                                "target_lang_sense_clarification": "треугольной формы, например, лимона"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "сыра или торта"
                            },
                            {
                                "target_lang_word": "долька",
                                "target_lang_sense_clarification": "картофеля или фрукта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab32c3b5-82b6-32bb-9566-2623e6492703",
                    "sense_definition": "Something that creates a division, gap, or distance between people or things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The disagreement over money began to drive a <w>wedge</w> between the two business partners.",
                            "target_lang_translations": {
                                "ru": "Разногласия из-за денег начали вбивать <w>клин</w> между двумя деловыми партнерами."
                            }
                        },
                        {
                            "text": "Political trends are conspiring to drive that <w>wedge</w> deeper between the capital and the provinces.",
                            "target_lang_translations": {
                                "ru": "Политические тенденции способствуют тому, чтобы этот <w>раскол</w> между столицей и провинцией стал еще глубже."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drive a wedge",
                        "thin end of the wedge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что создает разделение, разрыв или дистанцию между людьми или вещами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "в переносном смысле, раздор"
                            },
                            {
                                "target_lang_word": "яблоко раздора",
                                "target_lang_sense_clarification": "причина спора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ff9b96-ecae-3dc4-bced-a0e75dd86619",
                    "sense_definition": "A type of golf club with a heavy, angled face used for short, high-trajectory shots.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled a sand <w>wedge</w> out of his bag to get the ball out of the bunker.",
                            "target_lang_translations": {
                                "ru": "Он достал из сумки <w>сэнд-вэдж</w>, чтобы выбить мяч из бункера."
                            }
                        },
                        {
                            "text": "The professional golfer used a pitching <w>wedge</w> to land the ball softly on the green.",
                            "target_lang_translations": {
                                "ru": "Профессиональный гольфист использовал <w>питчинг-вэдж</w>, чтобы мягко приземлить мяч на грин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sand wedge",
                        "pitching wedge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип клюшки для гольфа с тяжелой наклонной головкой, используемый для коротких ударов с высокой траекторией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вэдж",
                                "target_lang_sense_clarification": "специализированная клюшка для гольфа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dbfdc8a-9e81-3f15-a43d-7e18a154b22d",
                    "sense_definition": "A shoe with a sole that is thick at the back and tapers to a thinner front, forming a solid heel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to wear her comfortable <w>wedges</w> for the outdoor garden party.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть свои удобные туфли на <w>танкетке</w> на вечеринку в саду."
                            }
                        },
                        {
                            "text": "These black <w>wedges</w> provide more support than traditional high heels for long events.",
                            "target_lang_translations": {
                                "ru": "Эти черные туфли на <w>платформе</w> обеспечивают лучшую поддержку, чем традиционные каблуки, во время долгих мероприятий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedge heels",
                        "pair of wedges"
                    ],
                    "target_lang_definitions": {
                        "ru": "Туфли на подошве, которая толстая сзади и сужается кпереди, образуя сплошной каблук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танкетка",
                                "target_lang_sense_clarification": "вид сплошной подошвы"
                            },
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "обувь на толстой подошве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ca482d6-df01-3c80-9596-eb1fc5ff5881",
                    "sense_definition": "A large sandwich made on a long, cylindrical bread roll.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a chicken parm <w>wedge</w> from the local deli for my lunch break.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>сэндвич</w> с курицей и пармезаном в местной кулинарии на обед."
                            }
                        },
                        {
                            "text": "He ate a massive meatball <w>wedge</w> while watching the football game on Sunday.",
                            "target_lang_translations": {
                                "ru": "Он съел огромный <w>батон</w> с тефтелями, пока смотрел футбол в воскресенье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chicken parm wedge",
                        "meatball wedge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in parts of the Northeastern United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой сэндвич, приготовленный на длинном цилиндрическом батоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саб",
                                "target_lang_sense_clarification": "длинный сэндвич"
                            },
                            {
                                "target_lang_word": "бутерброд",
                                "target_lang_sense_clarification": "на длинной булке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e2f00e4-a87a-351d-bce0-e57dd65e93c7",
                    "sense_definition": "A significant amount of money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to make a big fat <w>wedge</w> from that construction job last summer.",
                            "target_lang_translations": {
                                "ru": "Ему удалось сорвать жирный <w>куш</w> на той стройке прошлым летом."
                            }
                        },
                        {
                            "text": "She has got some decent <w>wedge</w> saved up after working abroad for three years.",
                            "target_lang_translations": {
                                "ru": "У нее накопилась приличная <w>сумма</w> после трех лет работы за границей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "big fat wedge",
                        "decent wedge"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительная сумма денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куш",
                                "target_lang_sense_clarification": "крупная сумма денег"
                            },
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "сленг, деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f13ab6-7498-3cc2-a4d9-3c884b7a982e",
                    "sense_definition": "A group of birds, such as geese or swans, flying in a V-shaped formation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>wedge</w> of geese flew overhead as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Большой гусиный <w>клин</w> пролетел над головой, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "We watched the <w>wedge</w> of swans migrate south for the winter months.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как лебединый <w>клин</w> улетает на юг на зимние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "skein"
                    ],
                    "common_phrases": [
                        "wedge of geese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа птиц, таких как гуси или лебеди, летящих в форме буквы V."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "строй перелетных птиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db999c6c-1a13-37be-ad74-af7b0157bea8",
                    "sense_definition": "To force something into a narrow space or gap.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>wedged</w> the small package between the wall and the back of the sofa.",
                            "target_lang_translations": {
                                "ru": "Он <w>засунул</w> маленькую посылку между стеной и спинкой дивана."
                            }
                        },
                        {
                            "text": "I managed to <w>wedge</w> myself into the crowded elevator just before the doors closed.",
                            "target_lang_translations": {
                                "ru": "Мне удалось <w>втиснуться</w> в переполненный лифт прямо перед тем, как двери закрылись."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedge between",
                        "wedge into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протиснуть или загнать что-либо в узкое пространство или щель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втискивать",
                                "target_lang_sense_clarification": "с трудом помещать"
                            },
                            {
                                "target_lang_word": "зажимать",
                                "target_lang_sense_clarification": "между чем-то"
                            },
                            {
                                "target_lang_word": "вклинивать",
                                "target_lang_sense_clarification": "вставлять в узкое место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "736b8385-83ae-38fa-9eee-5406b0ac1cfa",
                    "sense_definition": "To support, secure, or hold something open using a wedge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>wedged</w> open the window with a screwdriver to let some fresh air in.",
                            "target_lang_translations": {
                                "ru": "Я <w>подпер</w> окно отверткой, чтобы впустить немного свежего воздуха."
                            }
                        },
                        {
                            "text": "The mechanic <w>wedged</w> the wheel to prevent the truck from rolling down the hill.",
                            "target_lang_translations": {
                                "ru": "Механик <w>заклинил</w> колесо, чтобы грузовик не скатился с холма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedge open",
                        "wedge shut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать, закреплять или удерживать что-либо открытым с помощью клина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "клином"
                            },
                            {
                                "target_lang_word": "заклинивать",
                                "target_lang_sense_clarification": "чтобы не закрывалось"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df9556b-114a-3885-beaa-da81a5e353ab",
                    "sense_definition": "To become stuck in an unresponsive state, particularly of a computer system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My computer <w>wedged</w> right after I tried to install the latest software update.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер <w>завис</w> сразу после того, как я попытался установить последнее обновление ПО."
                            }
                        },
                        {
                            "text": "The entire system <w>wedged</w> because of a memory leak in the background process.",
                            "target_lang_translations": {
                                "ru": "Вся система <w>встала</w> из-за утечки памяти в фоновом процессе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Technical/Computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависнуть или перестать отвечать (о компьютерной системе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависать",
                                "target_lang_sense_clarification": "о компьютере"
                            },
                            {
                                "target_lang_word": "глючить",
                                "target_lang_sense_clarification": "работать со сбоями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
