                                        "entry_id": "46a85933-2b91-3145-b088-fa5ab085babe",
                                        "glosses": [
                                            "Any Chinese martial art."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d5edb0e-c594-332d-81c2-63f36b144931",
                                        "entry_id": "46a85933-2b91-3145-b088-fa5ab085babe",
                                        "glosses": [
                                            "A modern exhibition and full-contact sport based on traditional Chinese martial arts, created in the People's Republic of China. Also known as modern wushu or contemporary wushu."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2edb6110-88ba-4390-9981-11f1fd2bbeb7",
                                                "sense_id": "2d5edb0e-c594-332d-81c2-63f36b144931",
                                                "text": "The techniques of contemporary wushu are indeed those which at one time were used for self-defense, but the basis and development of wushu are different from kung fu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f412e2f-6217-4087-ae13-af70a6f891c0",
                        "source_entry_id": "cc9d7ea8-ff5b-397d-a8be-f21e6221cb40",
