                                        "sense_id": "6d40fb7d-6370-3698-9369-cc0b8f420e16",
                                        "entry_id": "f4da823d-2ea4-3ff7-b5a1-fb9af676f6de",
                                        "glosses": [
                                            "минер. жирный на ощупь минерал, разновидность талька"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
