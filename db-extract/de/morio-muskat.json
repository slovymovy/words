                "senses": [
                    {
                        "sense_id": "b3d491cb-81da-34c8-8442-912b74b51aaa",
                        "entry_id": "28e468d9-ffab-3c34-aff0-a2550c1937cc",
                        "glosses": [
                            "eine in der Bundesforschungsanstalt für Rebenzüchtung, Geilweilerhof in Siebeldingen von Peter Morio (* 1887 † 1960) gezüchtete Weißweinrebe. Die Rebsorte Morio-Muskat ist eine Kreuzung aus Silvaner und Weißem Burgunder und genießt seit 1956 Sortenschutz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53adcf3-5eb2-4bad-b51c-55fc1753cbde",
                                "sense_id": "b3d491cb-81da-34c8-8442-912b74b51aaa",
                                "text": "„Morio-Muskat stellt mittlere Ansprüche an die Lage, er bevorzugt Feinerde, reiche, tiefgründige, nicht trockene Böden […].“"
                            },
                            {
                                "example_id": "e9f2052c-b5a0-4c0d-85ec-3e1e9b37bc78",
                                "sense_id": "b3d491cb-81da-34c8-8442-912b74b51aaa",
                                "text": "Morio-Muskat: „Ausgesprochen aromatische Traubensorte, im Zurückgehen begriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
