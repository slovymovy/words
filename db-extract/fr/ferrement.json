                    {
                        "sense_id": "ef020d9b-dca1-3533-b199-36013ce2da10",
                        "entry_id": "ce89d83c-bac5-3749-8a27-321edebba7ed",
                        "glosses": [
                            "Une des garnitures de fer qui entrent dans la construction d’un navire, d’une machine, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7555fdc8-3eee-3d16-a61e-5c5534f77c8a",
                        "entry_id": "ce89d83c-bac5-3749-8a27-321edebba7ed",
                        "glosses": [
                            "Nom générique de tout outil en métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28f899c-ec31-4931-a032-3017c79a8418",
                                "sense_id": "7555fdc8-3eee-3d16-a61e-5c5534f77c8a",
                                "text": "Nous avons utilisé les ferrements pour forcer cette porte."
                            },
                            {
                                "example_id": "2cc8505b-7e7e-4031-8f79-c2b80b9e0b6d",
                                "sense_id": "7555fdc8-3eee-3d16-a61e-5c5534f77c8a",
                                "text": "Le « chaloupier », chargé du ferrement, fixe à sa cheville une manicle fermée par un boulon et accrochée à une chaîne longue d’un mètre cinquante, formée de dix-huit maillons et pesant sept kilos."
                            },
                            {
                                "example_id": "0a360320-a22e-4dc2-8568-ed7cb0050aed",
                                "sense_id": "7555fdc8-3eee-3d16-a61e-5c5534f77c8a",
                                "text": "– Demain matin, tu prépareras une faux pour toi et une pour Christophe ; il y a dans la grange des manches et des ferrements…"
                            },
                            {
                                "example_id": "dd6e5779-f0a5-48c9-a9d2-9454adf81c98",
                                "sense_id": "7555fdc8-3eee-3d16-a61e-5c5534f77c8a",
                                "text": "Une vingtaine d’esclaves, munis - grâce aux Français - de haches, de houes, de crochets et autres ferrements, avaient la terrible charge d’abattre ces arbres dans les endroits escarpés et dangereux où ils poussaient, puis de les équarrir."
                            }
                        ]
                    }
