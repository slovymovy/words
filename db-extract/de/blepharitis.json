                                            {
                                                "example_id": "8931466b-e8ec-4666-88ce-1440e4a79e54",
                                                "sense_id": "8f12b022-c8f2-3293-a71e-dabec9ada1d9",
                                                "text": "La blépharite est une infirmité commune des enfants Indiens et compliquent souvent le trachome."
                                            },
                                            {
                                                "example_id": "a7ae72cc-48ca-47ae-9763-4a9f424dbbab",
                                                "sense_id": "8f12b022-c8f2-3293-a71e-dabec9ada1d9",
                                                "text": "Mme Berthe était bonne commerçante : ses deux lourdes paupières, ourlées de blépharite et de crayon gras, clignèrent, l’une après l’autre."
                                            }
