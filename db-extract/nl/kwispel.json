                            {
                                "example_id": "cf5ea3f6-5db3-4e4f-9f9e-04c029ba5d1c",
                                "sense_id": "ea4f95e9-5315-3066-b81e-d6eeec9276ec",
                                "text": "Kwispel je?"
                            },
                            {
                                "example_id": "bfd6a422-9a17-4621-b71e-b93676f631b3",
                                "sense_id": "ea4f95e9-5315-3066-b81e-d6eeec9276ec",
                                "text": "U lijkt me niet iemand om snel ruzie mee te krijgen. Hans Royaards: „Ik kwispel tegen iedereen. Vader (en ook mijn broer en mijn moeder) kon onaangenaam tegen mensen zijn. Dan draaide mijn hart in mijn lijf om. (…)\""
                            }
                        ]
