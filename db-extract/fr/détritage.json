                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd37e6a-c918-40b6-a6eb-c81beb505036",
                                "sense_id": "e5075465-5524-3667-b358-820eb79dcd1e",
                                "text": "Les olives propres à être passées sous la meule et placées sur le plancher de l’étage supérieur du moulin, sont versées dans le bassin de détritage par une trémie en bois à laquelle est adaptée une manche en toile."
                            },
                            {
                                "example_id": "292de6f9-94a7-4bd0-b361-b7ccfbc291a2",
                                "sense_id": "e5075465-5524-3667-b358-820eb79dcd1e",
                                "text": "Le détritage consiste donc à broyer les olives pour en déchirer les cellules contenant l’huile."
                            }
                        ]
