        "fr-extract.jsonl": [
            {
                "entry_id": "1e89797b-2067-3e1b-9e12-5d496137d38c",
                "word": "tarare",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "57f09f28-a23d-3e59-9686-8c3cb7f5bbd8",
                        "entry_id": "1e89797b-2067-3e1b-9e12-5d496137d38c",
                        "glosses": [
                            "Interjection dont on se servait pour marquer qu’on se moque de ce qu’on entend dire, ou qu’on ne le croit pas."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "dce0fb47-133c-4314-8209-d7aa82232b0f",
                                "sense_id": "57f09f28-a23d-3e59-9686-8c3cb7f5bbd8",
                                "text": "Il m’a voulu faire croire cela, mais tarare !"
                            },
                            {
                                "example_id": "509db34a-3551-46a8-ab55-10418369fd79",
                                "sense_id": "57f09f28-a23d-3e59-9686-8c3cb7f5bbd8",
                                "text": "Ils ont imaginé qu'ils pleureraient ou riraient à des scènes de tragédie ou de comédie, musiquées (…) et qu'ils resteraient admirateurs de Ragonde et de Platée ( Je t'en réponds : Tarare ponpon ! )"
                            },
                            {
                                "example_id": "0dcf0436-1e30-4d4f-a989-ec74a03e5359",
                                "sense_id": "57f09f28-a23d-3e59-9686-8c3cb7f5bbd8",
                                "text": "Que nous reste-t-il à dire, après la peinture de l'homme? que les Deux Fous sont un drame, un portrait très-exact de la cour de François Iᵉʳ ?… Tarare ! à quoi cela servirait-il ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0e0f1d99-c783-3c7b-abdd-b3bb8b79d0e1",
                "word": "Tarare",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd5c708c-ebfd-3aff-b398-eef40995568d",
                        "entry_id": "0e0f1d99-c783-3c7b-abdd-b3bb8b79d0e1",
                        "glosses": [
                            "Commune française, située dans le département du Rhône."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a286e1da-a1b8-4580-b88b-49e0876e78e9",
                                "sense_id": "cd5c708c-ebfd-3aff-b398-eef40995568d",
                                "text": "Originaire de Pont-Trambouze, une petite commune du Rhône à la frontière de la Loire, Patrice Verchère, fils d’un artisan et d’une salariée du textile, était candidat pour son troisième mandat dans la 8ᵉ circonscription qui couvre les cantons d’Écully, L’Arbresle, Tarare, Amplepuis, Thizy… l’ouest du département du Rhône."
                            }
                        ]
                    },
                    {
                        "sense_id": "df26a324-de4f-354b-b146-3b99e69800c8",
                        "entry_id": "0e0f1d99-c783-3c7b-abdd-b3bb8b79d0e1",
                        "glosses": [
                            "Canton français, situé dans le département du Rhône."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cc8cd045-fb11-3f1d-933c-ff3bfe2367fa",
                "word": "tarare",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7fa9661f-c26d-4cad-998a-5affc832abc4",
                        "entry_id": "cc8cd045-fb11-3f1d-933c-ff3bfe2367fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarares"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59345c7e-403d-3fb1-981f-62cf1d728a1c",
                        "entry_id": "cc8cd045-fb11-3f1d-933c-ff3bfe2367fa",
                        "glosses": [
                            "Appareil, sorte de ventilateur, qui sert à nettoyer le grain des balles et la menue paille, après le battage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4dd5be-a7a4-4e1e-8e7a-49861573b307",
                                "sense_id": "59345c7e-403d-3fb1-981f-62cf1d728a1c",
                                "text": "Ah ! le blé à Marigrate et vingt tarares à vous pouffer du poussier dans la figure ; la batteuse qui mange ses bottelées à pleine gueule, et se démener dans cette odeur de paille, de sueur et de pain !"
                            },
                            {
                                "example_id": "be544895-db4f-4a36-a194-97f0fc2c45e1",
                                "sense_id": "59345c7e-403d-3fb1-981f-62cf1d728a1c",
                                "text": "[…] eux, ils n’auront pas cette peine-là : ils ont acheté un tarare. Avec l’argent des fesses, bien entendu."
                            },
                            {
                                "example_id": "f2431ce5-b90c-46e3-9256-e44ad5708ca7",
                                "sense_id": "59345c7e-403d-3fb1-981f-62cf1d728a1c",
                                "text": "Beaucoup avaient une batteuse fixe dans la grange, souvent datant du début du siècle & entraînée par des chevaux, ou par une locomobile reliée par une longue courroie, au risque de prendre feu, quand ce n’était pas l’antique tarare à manivelle permettant de vanner à moindre effort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e490cf0-0640-40c3-8f5d-7a8b120e3532",
                        "source_entry_id": "cc8cd045-fb11-3f1d-933c-ff3bfe2367fa",
                        "source_sense_id": "59345c7e-403d-3fb1-981f-62cf1d728a1c",
                        "target_lang_word": "winnow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winnow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2128d3-82c2-3ea2-a50b-1ea7427dcb79",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To subject (granular material, especially food grain) to a current of air separating heavier and lighter components, as grain from chaff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0826694-6851-46fe-8ada-7534e74d34fa",
                                                "sense_id": "1a2128d3-82c2-3ea2-a50b-1ea7427dcb79",
                                                "text": "[W]ind began to winnow the river delta's dried sediments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To separate, sift, analyse, or test by separating items having different values."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883ddc6f-45a3-4e25-9480-9deaadf9f5fa",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the losers from the winners."
                                            },
                                            {
                                                "example_id": "28717366-c721-451c-9144-46b68c0a622d",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the field to twelve."
                                            },
                                            {
                                                "example_id": "edd393d0-edde-40a1-81b7-64a022dff6f1",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the winners from the losers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To blow upon or toss about by blowing; to set in motion as with a fan or wings."
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529a34cd-0212-4004-9d77-416a63b437d1",
                                                "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                                "text": "The light snow lay on the narrow and winding path before them, pure as if just fresh winnowed by the wind."
                                            },
                                            {
                                                "example_id": "e3b577dc-0071-4e2d-a380-fc5adec82618",
                                                "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                                "text": "Gulls average much larger than terns, with stouter build; the feet are larger and more ambulatorial, the wings are shorter and not so thin; the birds winnow the air in a steady course unlike the buoyant dashing flight of their relatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc604ea8-a2fe-3ddb-bda4-6fa53f22c6a1",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To move about with a flapping motion, as of wings; to flutter."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive",
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
