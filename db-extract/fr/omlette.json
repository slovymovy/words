                        "glosses": [
                            "Variante orthographique de omelette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c8c99d-4747-4b9e-a56a-8c5197a3c9ed",
                                "sense_id": "3e414844-d159-392b-8f75-15d2bdea626a",
                                "text": "Ils voulurent manger de la viande & ne trouvèrent que des œufs dont on leur fit une omlette."
                            },
                            {
                                "example_id": "3cd06d5b-dbaf-4cc7-a40c-b8bc780e3c88",
                                "sense_id": "3e414844-d159-392b-8f75-15d2bdea626a",
                                "text": "La friture j’aime ça et l’omlette aux confitures aussi"
                            },
                            {
                                "example_id": "694f060c-0a49-4aac-bd9a-9db40b349794",
                                "sense_id": "3e414844-d159-392b-8f75-15d2bdea626a",
                                "text": "[…] là il savourera une omlette aux fines herbes, les aiguillettes d’un canard et le pâté froid qui a fait la renommée de la mère Penaud."
                            },
                            {
                                "example_id": "0604e167-1502-479e-989a-18f36e4f9d9e",
                                "sense_id": "3e414844-d159-392b-8f75-15d2bdea626a",
                                "text": "Un titre bien mérité et encore davantage quand on a goûté aux délicieuses pâtisseries changeant au jour le jour : vacherin, omlette norvégienne, crème brulée."
                            },
                            {
                                "example_id": "9003e659-38f7-43e7-b394-3bc3c394f764",
                                "sense_id": "3e414844-d159-392b-8f75-15d2bdea626a",
                                "text": "Recettes d'omlette: Voici la liste des recettes d'omlette souvent faciles, rapides et économiques - et toujours délicieuses - trouvées parmi toutes les recettes partagées par les gourmets."
                            }
                        ]
                    }
