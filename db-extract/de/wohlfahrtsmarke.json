                ],
                "senses": [
                    {
                        "sense_id": "40f471c5-e970-3b03-b66b-768932159b90",
                        "entry_id": "2c413f9f-3073-38a6-abd2-a7f9d6d444cb",
                        "glosses": [
                            "Briefmarke mit einem Zuschlag auf das eigentliche Porto, der für wohltätige Zwecke verwendet wird"
                        ],
                        "tags": [
                            "Postwesen",
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "962237f3-8d42-4e93-bbc2-70b91fb6c62e",
                                "sense_id": "40f471c5-e970-3b03-b66b-768932159b90",
                                "text": "„Während Sonderbriefmarken regelmäßig verkauft werden, bis die gesamte Auflage verkauft ist, gibt es für die Wohlfahrtsmarken einen genau und im Vorfeld festgelegten Verkaufszeitraum. Nicht verkaufte Exemplare werden nach Ablauf der Verkaufsfrist regelmäßig vernichtet.“"
                            },
                            {
                                "example_id": "255b6656-e32a-42b6-bc90-8729f919fdea",
                                "sense_id": "40f471c5-e970-3b03-b66b-768932159b90",
                                "text": "„Die Schillingers prägten damit und nicht zuletzt mit den jahrelang gestalteten Blumenserien für die Wohlfahrtsmarken das Design von Natur- und Umwelt(schutz)marken in der Bundesrepublik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
