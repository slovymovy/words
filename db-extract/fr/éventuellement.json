        "fr-extract.jsonl": [
            {
                "entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                "word": "éventuellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a7d98a4-741e-3b7d-a924-e39610b5d66e",
                        "entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                        "glosses": [
                            "D’une manière éventuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ac0893-3796-4b98-bc8c-36cd5304af00",
                                "sense_id": "4a7d98a4-741e-3b7d-a924-e39610b5d66e",
                                "text": "Une bureaucratie manie beaucoup de petits papiers, éventuellement des armes. Elle est surtout un groupe d'hommes hiérarchiquement organisés. C'est à l'équilibre psychique des hommes qui composent cette machine centrale qu'on doit s'intéresser."
                            },
                            {
                                "example_id": "8a1a22b0-2e62-4af0-a32b-586bbfee679b",
                                "sense_id": "4a7d98a4-741e-3b7d-a924-e39610b5d66e",
                                "text": "Notre premier objectif final était de produire un cédérom interactif de la Bible Porta qui puisse être éventuellement commercialisé et qui de ce fait doit être multiplate-forme même si le produit de base est établi sur Macintosh."
                            }
                        ]
                    },
                    {
                        "sense_id": "49cd1519-165f-36c3-b40c-2c70f65f7ce4",
                        "entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                        "glosses": [
                            "À la fin, finalement, tôt ou tard"
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "1659edb0-06db-48ae-94a9-bffcde50fe21",
                                "sense_id": "49cd1519-165f-36c3-b40c-2c70f65f7ce4",
                                "text": "Nous allons y arriver éventuellement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b7b35e7-2666-4039-b465-a478cca5c97d",
                        "source_entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                        "target_lang_word": "eventuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eventuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                        "entry_id": "d403ed82-aba4-39a3-86fe-be1781490aea",
                                        "glosses": [
                                            "unter (bestimmten, gewissen) Umständen, in bestimmten Fällen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6530da4a-1f55-45ea-b93c-2713316f2785",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adjektivisch: Für eine eventuelle Beschädigung der Ware sind wir nur bedingt haftbar zu machen."
                                            },
                                            {
                                                "example_id": "a9533eb9-2475-4620-b189-362717389172",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Eventuell komme ich morgen später."
                                            },
                                            {
                                                "example_id": "506e7758-6b65-4719-914e-9ca471398dd8",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Wir telefonieren eventuell heute noch einmal."
                                            },
                                            {
                                                "example_id": "b80629b6-7c68-4526-bcb7-c0e7809a3bb4",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Willst du eventuell ein zweites Mal probieren?"
                                            },
                                            {
                                                "example_id": "20de7dc1-28e3-4c8b-ac97-ae9c8316857e",
                                                "sense_id": "8eb9d673-00d9-3bc9-a85f-399776394ffd",
                                                "text": "adverbial: Er ist eventuell krank und sollte zum Arzt gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a18c5f5b-829b-4a06-8312-2d158da2615c",
                        "source_entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                        "target_lang_word": "potentially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potentially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85361b78-611f-3e73-81f7-e45e4ada517b",
                                        "entry_id": "f1bc530e-68e3-3166-8723-4d19ae493d29",
                                        "glosses": [
                                            "In a manner showing much potential; with the possibility of happening in a given way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91504db-a7c1-463c-a151-d811c7864908",
                                                "sense_id": "85361b78-611f-3e73-81f7-e45e4ada517b",
                                                "text": "Nevertheless, it is clear that the global energy demand for air-conditioning will grow substantially as nations become more affluent, with the consequences of climate change potentially accelerating the demand."
                                            },
                                            {
                                                "example_id": "72f32088-9932-4dc8-ae47-9e161345e0b3",
                                                "sense_id": "85361b78-611f-3e73-81f7-e45e4ada517b",
                                                "text": "Its impending end has rung alarm bells across social media, with a baseline tariff as high as 145% depending on the carrier set to take effect on Chinese imports, potentially more than doubling the cost for all those cheap products deal-hungry Americans scooped up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03154f7-0f73-3ba8-92f9-baf34c1328e8",
                                        "entry_id": "f1bc530e-68e3-3166-8723-4d19ae493d29",
                                        "glosses": [
                                            "Powerfully, strongly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92f062a8-2f80-465c-a8d0-35a6b04daa23",
                                                "sense_id": "b03154f7-0f73-3ba8-92f9-baf34c1328e8",
                                                "text": "I freely assert, that the cosmopolite philosopher cannot, for his life, point out one single peaceful influence, which within the last sixty years has operated more potentially upon the whole broad world, taken in one aggregate, than the high and mighty business of whaling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c46e0d-e2ad-497e-924d-1669ee7b12d4",
                        "source_entry_id": "8cc14bbe-f846-3d50-9153-114f8c78f14f",
                        "target_lang_word": "possibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "Perhaps; indicates that the proposition may be true (is not certainly false) regardless of any facts or circumstances known to, stated by or implied by the speaker."
                                        ],
                                        "tags": [
                                            "modifying a clause or predicate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7deef97a-3ee5-4d06-ad06-94ac3d01c986",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Near-synonyms: maybe, perhaps, mayhap, mayhaps, by chance, perchance, peradventure; conceivably"
                                            },
                                            {
                                                "example_id": "02df7048-c149-419f-88c4-124d63a6bb58",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Possibly, they will make gains in the midterm elections."
                                            },
                                            {
                                                "example_id": "04493592-5c28-48fc-b83c-794fcdfa8453",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "It was possibly the costliest mistake in the organization's history."
                                            },
                                            {
                                                "example_id": "ff077c1b-bf07-4212-8b9a-e3ea94980206",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "This rare and possibly unique specimen must be conserved."
                                            },
                                            {
                                                "example_id": "97d3a85d-e4c3-42da-8017-6bf7a8427f96",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "“Well, everything does point to either a major epeirogenic deformation, or possibly just a simple disruption of isostasy throughout the entire plate network.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "In the realm of possibility; indicates that the action may successfully be performed (is not impossible) regardless of any facts or circumstances known to, stated by or implied by the speaker that might limit the performance."
                                        ],
                                        "tags": [
                                            "modifying a verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9a4a0e-0e4d-4d8a-99fa-8b36b3e452cb",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly cheat on my wife."
                                            },
                                            {
                                                "example_id": "929cad39-c4ea-40fb-847a-3e8884cceb64",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "It seems unlikely, but, yes, they could possibly win even now."
                                            },
                                            {
                                                "example_id": "ebaa713b-5d95-4193-aba2-83681d849f23",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I'm much stronger than you, so you can't possibly win."
                                            },
                                            {
                                                "example_id": "8abd20c2-52ca-433e-983d-ee3fa6309add",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly be there on time."
                                            },
                                            {
                                                "example_id": "c3662d54-b7b7-4b24-b657-128fab3fb7b2",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "The police don't know him, and the information they have leads them to think he could possibly have murdered his wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f08ea9-0ad9-44e2-aa3e-f3376ee838fd",
