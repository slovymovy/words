                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hosanna",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f67a7618-a214-353b-b472-79d812a26d5e",
                                        "entry_id": "cfd830db-944f-3ae6-81f3-895da85d79c4",
                                        "glosses": [
                                            "pierwotnie wezwanie do Boga o pomoc, współcześnie wykrzyknik stosowany jako radosna inwokacja"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d786ed7-ca19-481f-b4a8-a263164e6fc6",
                                                "sense_id": "f67a7618-a214-353b-b472-79d812a26d5e",
                                                "text": "Uciszcie się, uciszcie się, • Padnijcie na kolana! • Hosanna, mówcie, chwała Mu! • Witajcie śpiewem Pana"
                                            },
                                            {
                                                "example_id": "a46b66c0-f4cf-47ff-bd25-29a68e2aa2da",
                                                "sense_id": "f67a7618-a214-353b-b472-79d812a26d5e",
                                                "text": "Piersiom twoim hosanna! I pogarda światom, • Co bogów swoich wielbią w obojętnym niebie, • Bo ja, choć lichszy jestem niż najlichszy atom, • Żyć nie mogę bez ciebie ni umrzeć bez ciebie!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30f87e50-0d0f-4332-9f64-4717100c284f",
                        "source_entry_id": "6cd086b0-5297-3973-b4ba-0f416249cd74",
                        "source_sense_id": "a1f36f1f-6681-30dd-9304-40468c429f0d",
                        "source_sense_description": "liturgical word",
                        "target_lang_word": "оса́нна",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оса́нна",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                        "entry_id": "b7ae7f65-7b57-319c-9afe-9e64c000038f",
                                        "glosses": [
                                            "религ. молитвенный возглас, славословие"
                                        ],
                                        "tags": [
                                            "мн. нет"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f646b9-b735-4f92-911a-f3634add3a3d",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Многие же постилали одежды свои по дороге; а другие резали ветви с дерев и постилали по дороге. И предшествовавшие и сопровождавшие восклицали: осанна! благословен Грядущий во имя Господне!"
                                            },
                                            {
                                                "example_id": "d616c38a-424c-4074-b3ed-1a5b852786ef",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Не дрогнет же у меня рука отправить на тот свет хоть одного из тех идиотов, которые, корчась от боли, вопиют — осанна тебе, жизнь прекрасная!"
                                            },
                                            {
                                                "example_id": "3c16dab0-369e-4d14-ada3-1d039ccb3af6",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Святой Косьма расскажет вам, как явишася источницы бездны, влаги непричастны; он же уверит вас своим каноном и в том, что спасутся от вечных бед изрядные церковные люди поющие — осанна, благословен еси, Грядый!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
