                        "glosses": [
                            "Relatif à ou appuyé par deux groupes, en particulier deux partis politiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57fb6a28-77ff-45a1-b1a3-dd79fc3d7c25",
                                "sense_id": "f74c38f8-83fc-39ef-af83-2c594203dabe",
                                "text": "Le ralliement d’une sénatrice républicaine offre à M. Obama l’espoir de voir adopté un texte de loi bipartisan."
                            },
                            {
                                "example_id": "9621cf93-e4bd-4485-b214-a3bd904527de",
                                "sense_id": "f74c38f8-83fc-39ef-af83-2c594203dabe",
                                "text": "Obama compose une équipe « bipartisane »."
                            },
                            {
                                "example_id": "7eb546fb-183d-484c-8880-2a3c2fada6bf",
                                "sense_id": "f74c38f8-83fc-39ef-af83-2c594203dabe",
                                "text": "Il a toujours été difficile de définir ce qu’est une politique bipartisane à Washington."
                            }
                        ]
                    }
