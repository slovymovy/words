                "senses": [
                    {
                        "sense_id": "c782a192-13aa-3d5e-80fd-5c2c06f8e662",
                        "entry_id": "60926a2d-dfdc-331a-82e1-44d0007b68ec",
                        "glosses": [
                            "Se réguler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d4f87c-4f18-413f-81c1-aa8a4d38b5b5",
                                "sense_id": "c782a192-13aa-3d5e-80fd-5c2c06f8e662",
                                "text": "Les mères qui présentent des difficultés de régulation émotionnelle ne sont pas en mesure d’« apprendre » à leur bébé à s’auto-réguler."
                            },
                            {
                                "example_id": "fc38c60b-e880-4a19-86eb-b1446589beec",
                                "sense_id": "c782a192-13aa-3d5e-80fd-5c2c06f8e662",
                                "text": "Livré à son propre mouvement, le marché a ainsi pour vertu de s’auto-réguler : s’il génère temporairement du désordre, il s’emploie aussitôt à le dissiper en réajustant les prix conformément à la loi de l’offre et de la demande."
                            }
                        ]
                    }
