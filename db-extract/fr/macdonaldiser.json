                "senses": [
                    {
                        "sense_id": "16ae7ace-3e9b-3f14-9245-0a5d1b81a92d",
                        "entry_id": "cb0b7235-e72c-3ee0-98ff-8c3c6c70aeb3",
                        "glosses": [
                            "Donner à quelque chose un caractère faisant penser aux restaurants McDonald’s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c030b1fb-0813-4a7b-992a-71c9a03db6ca",
                                "sense_id": "16ae7ace-3e9b-3f14-9245-0a5d1b81a92d",
                                "text": "Pour se moderniser, il faut « macdonaldiser » la formation en tablant sur le leurre de la maîtrise de l’information, le critère phare de l’optimisation économique et des algorithmes décisionnels."
                            },
                            {
                                "example_id": "4eb611ed-67c2-40a9-9dd2-67bbc0aad237",
                                "sense_id": "16ae7ace-3e9b-3f14-9245-0a5d1b81a92d",
                                "text": "De la naissance à la mort, l'homme est en train de se \"macdonaldiser\" jusqu'à ne plus savoir d'où il vient, ce qu'il est."
                            },
                            {
                                "example_id": "cb92d265-3a4a-436e-b891-820090aae4bf",
                                "sense_id": "16ae7ace-3e9b-3f14-9245-0a5d1b81a92d",
                                "text": "Là, pour rester poli, on est en train de se faire macdonaldiser sévère depuis deux ans!"
                            }
                        ]
                    }
