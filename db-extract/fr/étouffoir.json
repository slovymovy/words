                    {
                        "sense_id": "2e7c1a36-fc30-3916-b091-3e2a8f52a4fc",
                        "entry_id": "50386773-a756-3608-93a6-9a491e9e562b",
                        "glosses": [
                            "Sorte de boîte faite de métal, dont on se sert pour étouffer et éteindre des charbons."
