                ],
                "senses": [
                    {
                        "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                        "entry_id": "aef1fa2f-e406-3125-a64b-3c7c3b53394c",
                        "glosses": [
                            "Heizkessel, der Heizöl als Brennstoff zur Erzeugung von Wärme und heißem Wasser verbrennt"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "27f098ba-9ea5-4e44-9d59-339bfef0d9a0",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Vor allem in Bayern heizen die Deutschen mit einer Ölheizung: Ganze 41 Prozent der bayerischen Haushalte haben einen Ölkessel zum Heizen installiert.“"
                            },
                            {
                                "example_id": "52d4e012-36bf-4335-8c14-ddc388961337",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Einen Raum weiter brummt der alte Ölkessel vor sich hin, der viel CO2 ausstößt.“"
                            },
                            {
                                "example_id": "3122d0dd-0993-4577-a886-a4e54fe3bece",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Als Redundanz wird ein Ölkessel vorgehalten.“"
                            },
                            {
                                "example_id": "274bc2cb-ae4c-4e83-9d14-4aa4f0d788bd",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Für die Spitzenlasten steht ein Ölkessel mit 900 kW bereit.“"
                            },
                            {
                                "example_id": "f0d55279-4385-4305-ae16-d3f82868c9a2",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Der bisherige Ölkessel wurde durch einen Wärmetauscher ersetzt, die Warmluftheizung aber beibehalten.“"
                            },
                            {
                                "example_id": "1ccd6a6f-8e98-4e91-8105-b1bba60dc534",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Günter Fauth aus Eibiswald wollte einen alten Ölkessel durch eine Wärmepumpe ersetzen.“"
                            },
                            {
                                "example_id": "3de28771-a998-425a-a462-3899691ab625",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Häuser und Wohnungen sanieren, Ölkessel tauschen und Photovoltaikanlagen installieren: Für die angepeilte Energiewende braucht es neben Zielen auch Arbeitskräfte.“"
                            },
                            {
                                "example_id": "212f6630-94a6-475e-a7fa-1279e565e535",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Ölkessel sind ein Auslaufmodell.“"
                            },
                            {
                                "example_id": "d742caad-3615-446b-b679-9c632461bf93",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Ölkessel, die ab dem 1.1.2024 bis zum 1.7.2026/2028 installiert werden, müssen ab 2029 mit mindestens 15 Prozent erneuerbarem Brennstoff beliefert werden; bis 2040 steigt der Anteil auf 60 Prozent“ – […]."
                            },
                            {
                                "example_id": "5d4fee7a-a38f-424e-831b-5ede6fa907d2",
                                "sense_id": "cb0ff562-7a62-3ec7-b2a8-24440ae98b39",
                                "text": "„Ihre Berechtigung haben Pelletkessel vor allem dort, wo sie alte Öl- und Gaskessel ersetzen und es kein Nah- oder Fernwärmenetz gibt oder geben wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                        "entry_id": "aef1fa2f-e406-3125-a64b-3c7c3b53394c",
                        "glosses": [
                            "(nach oben meist) offenes Gefäß zum Erhitzen von Ölen und Fetten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6a442d-8303-4a55-93d1-74e5900c1206",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "„Die Figur des heiligen Vitus im Ölkessel, des Schutzpatrons der Kirche, wird um 1550 datiert.“"
                            },
                            {
                                "example_id": "9f67d186-1a8c-4361-bf92-d7cd2ceac7fd",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "„Entsprechende künstlerische Darstellungen gibt es etwa von Albrecht Dürer im Zyklus „Die Apokalypse“ und von Hans Fries „Hl. Johannes im Ölkessel“.“"
                            },
                            {
                                "example_id": "39a85384-fa74-44d1-a698-f1ce31668ab6",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "„Wie die Bilder - übrigens ganz ähnlich wie in China - zeigen, bereitet es ihm satanisches Vergnügen, den Verdammten ob ihrer Todessünden höllische Qualen zu bereiten, sie im Feuer schmoren, im Ölkessel sieden zu lassen, sie zu foltern und ihnen die Gedärme herauszureißen.“"
                            },
                            {
                                "example_id": "c20152b4-e73b-4248-939f-3ee0929e3b1e",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "[Heiliger Johannes:] „Der Legende nach fand die Marter des Evangelisten im Ölkessel vor der Porta Latina in Rom statt.“"
                            },
                            {
                                "example_id": "99d437f6-a584-4df5-957d-09988a4a3070",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "„»Merry Dikson, der jungen Lady Kammerjungfer, hat mir viel Gutes von ihnen erzählt, und die schwarzen Burschen sollen Mickey Free in einem Ölkessel sieden, wenn er sich nicht dankbar erweist für die Freundlichkeit, die sie gegen das arme Mädchen gehabt haben.«“"
                            },
                            {
                                "example_id": "673e6c9b-b19f-422d-b071-7ddb112d4dd3",
                                "sense_id": "a3fc0343-920d-35e4-ac46-c0a8d43cd549",
                                "text": "„[…]; die Todesſtrafe war ſehr häufig und wurde durch Enthaupten, Ertränken, Rädern (Radbrechen), Hängen und Verbrennen, ſeltener durch Einmauern, Lebendbegraben, Pfählen und Aushungern, durch Sieden im Ölkeſſel, oft abwechſelnd mit kaltem Waſſer, Reißen mit glühenden Zangen u. ſ. w. vollſtreckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
