        "fr-extract.jsonl": [
            {
                "entry_id": "623cac98-bc65-39f2-895f-8c4035034137",
                "word": "douar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27eeb575-b97c-4cd4-8eb6-506eafa09897",
                        "entry_id": "623cac98-bc65-39f2-895f-8c4035034137",
                        "tags": [
                            "plural"
                        ],
                        "form": "douars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d08e8ea4-f285-3606-b3db-2fc280db9356",
                        "entry_id": "623cac98-bc65-39f2-895f-8c4035034137",
                        "glosses": [
                            "Groupe de tentes disposées en cercle, de façon à remiser les troupeaux dans l’espace laissé libre au centre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be734cb3-54af-4e80-9055-1e8300daa6aa",
                                "sense_id": "d08e8ea4-f285-3606-b3db-2fc280db9356",
                                "text": "D’ordinaire, elle le menait dans la gorge tourmentée et sauvage d’un oued assez loin du douar."
                            },
                            {
                                "example_id": "c2a6f3a7-9143-4415-9379-74c40106fbfb",
                                "sense_id": "d08e8ea4-f285-3606-b3db-2fc280db9356",
                                "text": "Mais généralement l’envoi de quelques troupes met fin aux troubles en peu de temps. Elles envahissent le territoire de la tribu à châtier, pillent les douars, razzient les troupeaux, détruisent les cultures, font des prisonniers et coupent des têtes, […]."
                            },
                            {
                                "example_id": "92d643d1-35d3-4cb1-b171-4dec6586cab5",
                                "sense_id": "d08e8ea4-f285-3606-b3db-2fc280db9356",
                                "text": "Les jeunes exilés pour cause de guerre, […] sur les cartes postales qu’ils envoient à leur familles […] expurgent les douars fouillés, les mechtas mises à sac, les filles aux longs cheveux qui se mordent les lèvres, les visages sculptés par le turban des jeunes Arabes de leur âge, semblables à leurs compagnons coiffés d’un calot."
                            }
                        ]
                    },
                    {
                        "sense_id": "6772ae38-b8c7-3431-99f2-8e836dfa63bd",
                        "entry_id": "623cac98-bc65-39f2-895f-8c4035034137",
                        "glosses": [
                            "Petit village du Maghreb."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                        "entry_id": "623cac98-bc65-39f2-895f-8c4035034137",
                        "glosses": [
                            "Groupe de familles obéissant à un chef en formant une fraction de la tribu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "42a0072c-1dd9-4383-bd45-d1d669bf1683",
                                "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                                "text": "Nous, les hommes des douars lointains, des hauts djebels, des larges vallées, nous savions que l’on ne bâtit pas sa maison si l’on n’a pas confiance dans la solidité du sol."
                            },
                            {
                                "example_id": "3bf70856-6263-415d-ae89-b02354be01fe",
                                "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                                "text": "[…]; et les premiers cavaliers revenant du champ de bataille racontaient les résultats de la journée. La souga n’avait pas réussi : pour faire bonne figure, on avait razzié deux ou trois douars et coupé autant de têtes ; […]."
                            },
                            {
                                "example_id": "b6679342-77e5-4935-ad10-9c278187825b",
                                "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                                "text": "Aussi, de la capitale, vont-ils parachuter dans les villages des dirigeants inconnus ou trop jeunes qui, investis par l’autorité centrale, entendent mener le douar ou le village comme une cellule d’entreprise."
                            },
                            {
                                "example_id": "2dc98996-a503-4e10-bb7c-4d4acc45044a",
                                "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                                "text": "Dans tous les villages, tous les douars, toutes les mechtas, placés sous ma responsabilité, je les ai convaincu de notre invincibilité sans, pratiquement, tirer un seul coup de feu."
                            },
                            {
                                "example_id": "5b66f138-0b45-4a29-87d4-733e33dc81c6",
                                "sense_id": "cbfbbace-8950-3019-a6aa-c7a4c7dc6501",
                                "text": "Le village est entouré d’une vingtaine de douars où les mariages endogènes entretiennent un même vieux nom pour tous et assurent la transmission des prénoms des morts aux nouveau-nés."
                            }
                        ]
                    }
                ],
