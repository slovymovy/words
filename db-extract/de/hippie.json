                ],
                "senses": [
                    {
                        "sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                        "entry_id": "b871dfc4-8f16-37f3-9491-cbe7b31fb10b",
                        "glosses": [
                            "Person aus einer Jugendbewegung der 1960er und 1970er Jahre, die sich oft durch antibürgerliches und links-anarchisches Gedankengut und unkonventionelles Auftreten auszeichneten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf74b53a-947f-412d-b3bf-98651a7e1bc1",
                                "sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                                "text": "Für viele konservative und bürgerliche Menschen war das Auftreten der Hippies eine unerträgliche Provokation."
                            },
                            {
                                "example_id": "2c203e79-14dd-4a61-9f2d-09b3580c8cf1",
                                "sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                                "text": "„Auf dem Platz vor Marias Restaurant mit den alten, von Schilf überdachten Tischen, hingen damals, als ich zum ersten Mal nach La Gonera gekommen war, die Hippies den ganzen Tag herum und kifften oder kifften nicht.“"
                            },
                            {
                                "example_id": "97c15047-f92d-4c78-b28e-7f7845732aaf",
                                "sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                                "text": "„Der Gottesdienst wurde von Hippies gestört, die dem Pfarrer bei der Predigt ins Wort fielen und Transparente hochhielten.“"
                            },
                            {
                                "example_id": "85f80844-623c-4f04-968f-955b09e5be8b",
                                "sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
                                "text": "„Bald nach Lilos Einzug trafen Hugo und ich in der Wohnung fast täglich neue Gesichter, junge Männer und Frauen, die sich zum großen Wir-Gefühl der Familie der Hippies bekannten: Hippie, das bedeutete ›hip‹, also ›up to date‹ sein, so Lilo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fdd6d0d-3052-4c60-a535-c7fca538056b",
                        "source_entry_id": "b871dfc4-8f16-37f3-9491-cbe7b31fb10b",
                        "source_sense_id": "1d132bc1-8f07-302c-8ac4-47f34fb2cd4d",
