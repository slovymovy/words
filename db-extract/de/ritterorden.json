                        "cross_references": []
                    },
                    {
                        "translation_id": "6fffdad8-c63c-4413-a461-7cc85e240253",
                        "source_entry_id": "551d736b-8741-3a91-b693-a199e97da744",
                        "source_sense_id": "f4ef0a76-9886-3be2-864e-8855c35d5e7f",
                        "target_lang_word": "ridderorde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridderorde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a3529577-8b48-3f2f-b5d5-6a8438955150",
                                        "entry_id": "37db70d2-4f8a-39dc-acde-9ea53a79fcb0",
                                        "glosses": [
                                            "vereniging van ridders, vereniging van mensen die een gemeenschappelijk ideaal nastreven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942087f2-d8a5-4f84-bec9-d6e25eb0d846",
                                                "sense_id": "a3529577-8b48-3f2f-b5d5-6a8438955150",
                                                "text": "De Orde van Malta. Wie zijn ze? Wat doen ze? Vooreerst zijn ze de ‘Soevereine en Militaire Orde van Sint-Jan van Jeruzalem van Rhodos en van Malta’. Ze staan op die naam, op hun website waarschuwen ze voor ‘valse ordes’. De Orde gaat terug tot 1048. Toen bouwde ze in Jeruzalem een abdij met hospitaal om pelgrims, armen en zieken te verzorgen. In 1113 werd ze onder de bescherming van de Heilige Stoel geplaatst. Wat doen ze? Zich wijden aan twee doelen: zieken en behoeftigen verzorgen enerzijds, en het christelijke geloof verdedigen anderzijds. Dat laatste gebeurde in die tijd met het zwaard. Je bent een ridderorde of je bent het niet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494a1f19-613a-3252-91a1-7ec719e88edd",
                                        "entry_id": "37db70d2-4f8a-39dc-acde-9ea53a79fcb0",
                                        "glosses": [
                                            "onderscheiding die door de koning wordt gegeven aan mensen die een uitzonderlijke prestatie hebben geleverd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce77830-0517-4925-b02e-9203221a91c3",
                                                "sense_id": "494a1f19-613a-3252-91a1-7ec719e88edd",
                                                "text": "De gepubliceerde mails hebben niet alleen voor commotie gezorgd rondom zijn rol binnen het goede doel. Er is ook opschudding ontstaan omdat Beckham uithaalt naar operaster Katherine Jenkins. Zij kreeg in 2014 een onderscheiding van de Britse ridderorde OBE. ,,Voor wat in godsnaam? Een beetje zingen langs een rugbyveld?\", schrijft hij neerbuigend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
