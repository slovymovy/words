                                "target_senses": [
                                    {
                                        "sense_id": "b8de8a1d-a6b2-38b1-8b9c-ab0ae1ee275a",
                                        "entry_id": "8dccf6bb-2ef8-3e42-a034-245c195e5665",
                                        "glosses": [
                                            "Vorgang, bei dem etwas oder eine Situation schlimmer wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f285c2-bea0-41da-b65c-3bef67d338a7",
                                                "sense_id": "b8de8a1d-a6b2-38b1-8b9c-ab0ae1ee275a",
                                                "text": "Das Ergebnis seines Plans war nur die Verschlimmerung der Ausgangssituation."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36f62dc4-e342-47ed-9285-de9715ac7dc2",
                        "source_entry_id": "d66d1150-8765-3922-9675-2611e3c01a1a",
                        "source_sense_id": "ec170ed1-8093-3a2e-aa08-d527675697c8",
