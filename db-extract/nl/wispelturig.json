                                        "sense_id": "414a2186-5e68-35fa-937a-7fb4b28d469f",
                                        "entry_id": "c78b8bf3-75e3-33f3-89a2-6b260bdbc07d",
                                        "glosses": [
                                            "zu unbeständigen, impulsiven Handlungen neigend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "011e60d2-f3c9-35b2-9187-01c4aab267bd",
                                        "entry_id": "c78b8bf3-75e3-33f3-89a2-6b260bdbc07d",
                                        "glosses": [
                                            "plötzlich, nicht in einzelnen Schritten zunehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad5b52c-8d78-47ee-8b76-4b3177160327",
                                                "sense_id": "011e60d2-f3c9-35b2-9187-01c4aab267bd",
                                                "text": "„Ab dem 50. Lebensjahr jedoch steigt die Anzahl der Neuerkrankungen sprunghaft an.“"
                                            },
                                            {
                                                "example_id": "0060ac13-696c-4676-90ed-566ef0fc1d91",
                                                "sense_id": "011e60d2-f3c9-35b2-9187-01c4aab267bd",
                                                "text": "„Die Strahlenbelastung in einem Wassertank des Meilers ist sprunghaft auf das 18-fache des bisherigen Wertes angestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cce0a879-04cf-42c9-b56c-e7ededa63ca3",
                        "source_entry_id": "12f5512d-586d-3b27-9507-82903c0c7b5e",
