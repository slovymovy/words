                        "tr": [
                            {
                                "target_lang_word": "korkunç",
                                "target_lang_sense_clarification": "suçlar ve kötülükler için"
                            },
                            {
                                "target_lang_word": "canavarca",
                                "target_lang_sense_clarification": "aşırı zalimce ve vahşice olan"
                            }
