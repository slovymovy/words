                "senses": [
                    {
                        "sense_id": "407a6bef-6e63-3f0d-bbe8-f1fec8c3ab91",
                        "entry_id": "7abc92ca-e63f-3c04-8fe6-f6b519a7a421",
                        "glosses": [
                            "Réduire quelque chose en lamelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181634c6-58d8-4683-adb4-d16a8f0adc85",
                                "sense_id": "407a6bef-6e63-3f0d-bbe8-f1fec8c3ab91",
                                "text": "Le cerveau de Lénine fut lamellisé, examiné à la loupe, sous microscope, sans qu’on découvre autre chose que la trace bleutée d’une ancienne syphilis."
                            }
                        ]
                    },
                    {
                        "sense_id": "87747e6f-d7e5-3da9-aa2b-e28c89d28065",
                        "entry_id": "7abc92ca-e63f-3c04-8fe6-f6b519a7a421",
                        "glosses": [
                            "Réaliser des entailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0f3b1e-2615-49c3-a58d-fe7f6ed682d6",
                                "sense_id": "87747e6f-d7e5-3da9-aa2b-e28c89d28065",
                                "text": "J’appelle aussitôt Pierre Dupasquier, le responsable de la compétition chez Michelin, qui fut durant toute ma carrière d’une aide très précieuse ; il me conseille de lamelliser mes pneus. En faisant trois lignes, au cutter, dans le sens longitudinal, ainsi qu’une multitude en latéral […]"
                            }
                        ]
                    }
