                ],
                "senses": [
                    {
                        "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                        "entry_id": "1792c2af-cdca-3718-b8ad-d42baf7a96ec",
                        "glosses": [
                            "gesegnetes, duftendes Öl, das für Salbungen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49508b3-d439-4f94-b9a7-9331baa293b7",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Denn das Salböl, das die ersten Christen verwendet hätten, habe große Mengen einer Substanz namens Keneh-Bosum enthalten.“"
                            },
                            {
                                "example_id": "02d21ef7-eebf-47dd-9d00-884901e69717",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Sie brachte ein Alabastergefäß mit Salböl, und ließ sich weinend hinten zu seinen Füßen nieder.“"
                            },
                            {
                                "example_id": "220f03ce-e123-48db-8102-5736a6001665",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Sie bricht zum Haus des Pharisäers auf und nimmt ein Alabastergefäß voll Salböl mit, ein Luxusprodukt von großem materiellem Wert.“"
                            },
                            {
                                "example_id": "55b3d62d-ac10-4c9b-a0aa-695bd0726ce5",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Während sich das ganze Haus mit dem Duft des Öls füllte, empörten sich einige Jünger Jesu über diese Geldverschwendung und fragten: »Warum wurde dieses Salböl nicht verkauft für dreihundert Denare und der Erlös den Armen gegeben?«“"
                            },
                            {
                                "example_id": "7c75561d-f71c-4b64-8505-fa9167d99c30",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Carter ließ die Mumie, die wegen der vielen Salböle im innersten Goldsarg festklebte vor das Grab tragen und einige Stunden von der Sonne bescheinen.“"
                            },
                            {
                                "example_id": "d808db6d-cb83-4168-bc72-5a298e167fba",
                                "sense_id": "42bf70e4-4659-3b21-bd29-8c1b7b9c25a7",
                                "text": "„Nikodemus, auch ein Mitglied des Hohen Rates, kam ebenfalls, brachte wohlriechende Salböle mit und half, den Leichnam Jesu in das Tuch, zusammen mit der Salböl-Mischung aus Myrrhe und Aloe, einzuwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
