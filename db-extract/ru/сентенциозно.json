                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e0fc3c-c36b-40bf-b609-7985f64edf8c",
                                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                                "text": "Les sentences sont un grand ornement de l'histoire, pourvu qu'elles n'y soient pas proposées sentencieusement"
                                            },
                                            {
                                                "example_id": "6d1fced9-c93c-4db4-899f-52f21e006322",
                                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                                "text": "Le maréchal de Villeroy faisait remarquer au roi [enfant] cette multitude prodigieuse, et sentencieusement lui disait : Voyez, mon maître, voyez tout ce peuple, cette affluence, ce nombre de peuple immense, tout cela est à vous"
                                            },
                                            {
                                                "example_id": "0a1a72fe-a44d-478f-89e9-97d70c7edb85",
                                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                                "text": "Les Indiens se vengent toujours, capitaine, dit sentencieusement le vieux chasseur."
                                            }
                                        ]
                                    }
                                ]
                            }
