                    {
                        "sense_id": "03ffd06b-0819-3d62-a783-610707e57d71",
                        "entry_id": "e8c8628a-5d97-30bc-bc03-6e4938036a49",
                        "glosses": [
                            "übertriebenes Bemühen, zu große Strebsamkeit"
