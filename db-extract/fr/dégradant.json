            {
                "entry_id": "a9c62215-8321-30c5-b31c-1b1a793b947c",
                "word": "dégradant",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                        "entry_id": "a9c62215-8321-30c5-b31c-1b1a793b947c",
                        "glosses": [
                            "Participe présent de dégrader."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9e3fbdfa-af8a-44a3-a0f1-9da6b0b39fb8",
                                "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                                "text": "Il en détermine les multiples aspects sensibles et curieux : il les fait viroter devant les yeux de manière à réveiller le jeu de mille facettes, non point sous une clarté capable de brusquement éblouir, mais sous une lumière atténuée, dégradant l’échelle mystérieuse des ombres, suffisante cependant pour faire chatoyer dans une fuite de reflets la vie secrète que chaque objet porte en lui."
                            },
                            {
                                "example_id": "006359cc-cc72-435b-9477-d8eca5e420e3",
                                "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                                "text": "À gauche, la savane, aux herbes hautes et drues, forme un camaïeu de verts, aux valeurs se dégradant du vert nil au vert d’eau, aux arêtes coupantes comme des rasoirs."
                            }
                        ]
                    }
                ],
