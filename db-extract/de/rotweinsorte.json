                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413619a0-8990-48bf-96a1-9da7c97025a1",
                                "sense_id": "642c3b98-5529-3203-8712-dbe3dc9aabed",
                                "text": "„Man bezeichnet die Sorten der Echten Weinrebe als Europäerreben und unterscheidet Weißweinsorten und Rotweinsorten.“"
                            },
                            {
                                "example_id": "0ea90536-5d9b-429e-a158-3ee06d444492",
                                "sense_id": "642c3b98-5529-3203-8712-dbe3dc9aabed",
                                "text": "„Die meisten weißen Rebsorten bevorzugen kühlere Weinanbaugebiete, da weniger Licht und Wärme für die Reife notwendig sind, als für die dunkleren Rotweinsorten.“"
                            }
                        ],
