                "senses": [
                    {
                        "sense_id": "5550c4de-b750-34e9-bb84-eb23b48e6871",
                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                        "glosses": [
                            "Qui ne s’exerce que par une tolérance qui peut cesser, par une permission révocable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3538436-83fd-4d9a-a3f5-c88e28672f53",
                                "sense_id": "5550c4de-b750-34e9-bb84-eb23b48e6871",
                                "text": "Autorité précaire. — Pouvoir précaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "487b78ac-7e5c-37a8-bf31-3657c9bd9d7b",
                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                        "glosses": [
                            "Qui est instable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "31d8ec65-5103-44f2-a99f-e724477c8ed1",
                                "sense_id": "487b78ac-7e5c-37a8-bf31-3657c9bd9d7b",
                                "text": "Trois mètres de long, deux de large, le lit qui occupe la moitié de l’espace, un radiateur électrique en équilibre précaire contre le mur."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                        "glosses": [
                            "Qui est incertain, éphémère."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fed04935-0cc4-4153-aa28-b596d9dfc2aa",
                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                "text": "Ainsi, depuis son entrée au Bonheur des Dames, elle était surtout blessée par le sort précaire des commis."
                            },
                            {
                                "example_id": "a1359f7f-e05f-4521-953d-66b8eeb5e492",
                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                "text": "Il est à peine besoin de faire remarquer que, vu la quantité de taxes et redevances auxquelles on les assujettissait […], les juifs se trouvaient dans une situation matérielle précaire."
                            },
                            {
                                "example_id": "d5ab8a4e-4c9b-4d83-b6a0-f41b80fe9caf",
                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                "text": "Dire que le français au Québec n’est pas en position précaire serait une absurdité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e15327c4-8bd1-4200-a624-3ea435b5db6a",
                        "source_entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
