    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fd03964d-a042-3e28-87d2-94757ec7d03f",
                "word": "pandectist",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01bf8b8e-53b6-3fd0-9571-7e5961fc71fb",
                        "entry_id": "fd03964d-a042-3e28-87d2-94757ec7d03f",
                        "glosses": [
                            "Pertaining to the Pandects compiled under the Roman emperor Justinian I."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "45153183-c2fb-48ff-adeb-136ed117a756",
                                "sense_id": "01bf8b8e-53b6-3fd0-9571-7e5961fc71fb",
                                "text": "First, the absolutist concept of ownership, which was advocated by pandectist philosophers, but which has been challenged as being an ahistorical assertion of the nature of ownership under Roman-Dutch law,\" and second, the feudal notions of property relations which underpin English land law."
                            },
                            {
                                "example_id": "e07aab85-bb70-4cee-8a61-7f3190d87346",
                                "sense_id": "01bf8b8e-53b6-3fd0-9571-7e5961fc71fb",
                                "text": "It is due to the pervasive influence of pandectist scholarship that the concept of ownership is generally described and understood as 'absolute' in nature."
                            },
                            {
                                "example_id": "ba4ef422-ba86-46aa-a2d2-08545ee2dde6",
                                "sense_id": "01bf8b8e-53b6-3fd0-9571-7e5961fc71fb",
                                "text": "Pandectist ideas were taken to be notions of general jurisprudence and therefore applicable to any developed legal system."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9ffb7cb-7c39-36ec-b3b8-2b5a55a8d113",
                        "entry_id": "fd03964d-a042-3e28-87d2-94757ec7d03f",
                        "glosses": [
                            "Pertaining to the German adaptation of Roman law in the early sixteenth century."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e119b4d-b127-4e06-93ea-135c0e4ecd2a",
                                "sense_id": "d9ffb7cb-7c39-36ec-b3b8-2b5a55a8d113",
                                "text": "In this way, the prestigious German pandectist science greatly influenced not only continental systems, but also English law and indirectly even American law."
                            },
                            {
                                "example_id": "d914fd4c-4d9b-472f-9d1a-957de14dd7d3",
                                "sense_id": "d9ffb7cb-7c39-36ec-b3b8-2b5a55a8d113",
                                "text": "Thinking in pandectist categories has become so matter-of-fact that in everyday legal practice, for example, the analogous application to unilateral legal transactions (einseitige Rechtsgeschäfte) of the provisions on the conclusion of contracts is no longer considered an issue"
                            },
                            {
                                "example_id": "787e8c61-a879-44ad-bd93-ce541740340f",
                                "sense_id": "d9ffb7cb-7c39-36ec-b3b8-2b5a55a8d113",
                                "text": "His main opus is the Lehrbuch des Pandektenrechts (textbook on pandectist law, 1861-70)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "465858ef-b06c-4e23-9cc8-4553fcbf86cb",
                        "source_entry_id": "fd03964d-a042-3e28-87d2-94757ec7d03f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "pandettistico",
                        "target_lang_code": "it",
