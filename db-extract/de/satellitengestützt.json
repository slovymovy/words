                "senses": [
                    {
                        "sense_id": "db598142-f87b-333d-b7d2-37d606b44f3d",
                        "entry_id": "c94e20f4-50b8-3f2d-b560-1b573b60dd99",
                        "glosses": [
                            "auf einem oder mehreren Satelliten (zum Beispiel Kommunikationssatelliten, Navigationssatelliten) basierend; (nur) mit Hilfe eines oder mehrerer Satelliten funktionierend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dca3759-0040-4645-a837-a6984fc1c637",
                                "sense_id": "db598142-f87b-333d-b7d2-37d606b44f3d",
                                "text": "„Es versprach eine entspannte Reise zu werden, über die Ostsee zurück vom polnischen Danzig nach Schweden. Doch kurz nach dem Start fiel in 150 Meter Höhe das GPS-Signal aus, berichtet der Fluglehrer. Die Maschine konnte die satellitengestützte Navigation nicht mehr nutzen.“"
                            }
