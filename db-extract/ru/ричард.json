                    },
                    {
                        "translation_id": "2d9b0e62-c5ee-4bdc-a03a-9b894adc93ef",
                        "source_entry_id": "e8df2d5f-328d-395a-a2ed-eb893cd6cd84",
                        "source_sense_id": "81038686-d8f0-36d1-a3ef-f95aa742a6d4",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Richard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Richard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e329aa1d-c84d-37eb-89c1-3a918d1b9d60",
                                        "entry_id": "05766768-7c83-3b02-a90e-b6dbb0db82ff",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47f4204-39e4-4e53-b60b-e0ee8ebc72df",
                                                "sense_id": "e329aa1d-c84d-37eb-89c1-3a918d1b9d60",
                                                "text": "Richard avait oublié de nous parler d’une vodka-pomme qu’il aurait consommée lors de la soirée au Set à Miami."
                                            },
                                            {
                                                "example_id": "0fe837c7-08ba-41dd-8a11-028678a73af5",
                                                "sense_id": "e329aa1d-c84d-37eb-89c1-3a918d1b9d60",
                                                "text": "Au premier tour de l’US Open, mardi, Richard Gasquet a disposé du Japonais Taro Daniel (6-4, 6-7, 6-2, 6-2), tandis que Benoît Paire a été balayé par l’Anglais Cameron Norrie (6-0, 7-6, 6-0)."
                                            },
                                            {
                                                "example_id": "98d9deb4-d615-4541-ae16-85a5da7df80d",
                                                "sense_id": "e329aa1d-c84d-37eb-89c1-3a918d1b9d60",
                                                "text": "Et c’est comme ça que Fesneau s’est retrouvé aux côtés de Bayrou pour négocier face à Richard Ferrand les circonscriptions concédées au MoDem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Richard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc1a4c2-557b-3864-b298-b8ae8a75166c",
                                        "entry_id": "345f4b6f-7d9f-3c19-89f2-e70365c07012",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cafadf6-f574-402c-a4fb-c4d23fa92652",
                                                "sense_id": "dfc1a4c2-557b-3864-b298-b8ae8a75166c",
                                                "text": "Signe que le nouveau centre d’excellence attire, plusieurs navigateurs se sont entraînés sous la houlette du Vendéen Étienne Saïz, l’ancien coach de Xavier Macaire. L’Allemand Jörg Riechers, la Vendéenne Charlotte Yven, l’Irlandais Kenneth Rumball, et des Rochelais : Alexis Thomas (26 ans, « Ma chance moi aussi », Robin Marais (35 ans, « Charente-Maritime ») et un petit nouveau, Romen Richard."
                                            },
                                            {
                                                "example_id": "697a4e7c-0579-49dc-b734-fff8ce6bfe39",
                                                "sense_id": "dfc1a4c2-557b-3864-b298-b8ae8a75166c",
                                                "text": "Un industriel, joué par Michel Bouquet, offrait Pierre Richard à son gamin pourri gâté qui voulait en faire son joujou vivant."
                                            },
                                            {
                                                "example_id": "7a564710-0de7-45d2-bdeb-372c26f8f52a",
                                                "sense_id": "dfc1a4c2-557b-3864-b298-b8ae8a75166c",
                                                "text": "Quant au bureau du club, il se renouvelle en raison des arrêts de Kévin Richard, vice-président, et Christelle Monteil, trésorière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
