                                        "glosses": [
                                            "Faculté, état médiumnique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205eef7b-ef64-450e-a92a-accc043e7322",
                                                "sense_id": "629d8041-482b-362c-97e5-283014638a58",
                                                "text": "Cela tenait de la médiumnité, et j’eus vraiment l’impression qu’elle avait un don surnaturel."
                                            },
                                            {
                                                "example_id": "e4e0ae1b-cd88-47ae-af9c-f99c47c83cd4",
                                                "sense_id": "629d8041-482b-362c-97e5-283014638a58",
                                                "text": "Cette expérience énigmatique est pour elle, une sorte d’embranchement, une chose d’étrange qui arrive et emmène vers une prise de décision et un passage vers la médiumnité."
                                            }
                                        ]
                                    }
