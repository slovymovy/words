                        "sense_id": "0a410a7d-d162-3525-b2bd-73406d64c705",
                        "entry_id": "02c8ce3d-3239-31ff-8333-7eca096ec9d6",
                        "glosses": [
                            "Politik, deren Ziel die Annexion eines Gebiets ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debfd4da-64ed-4fac-ab09-4d80fd1fcaf7",
                                "sense_id": "0a410a7d-d162-3525-b2bd-73406d64c705",
                                "text": "„Einer von Eschkols Mitarbeitern setzte dem Ministerpräsidenten auseinander, dass der Druck der Supermächte und internationale Faktoren zu einer Sitzung des UN-Sicherheitsrates führen konnten, auf der das Gremium zweifellos eine Resolution gegen die Annexionspolitik verabschieden würde.“"
                            },
                            {
                                "example_id": "ce9ffdcf-dd0d-473a-ade0-07da0b004bb8",
                                "sense_id": "0a410a7d-d162-3525-b2bd-73406d64c705",
                                "text": "„Unter dessen Nachfolger Lord Carnarvon wurde die Annexionspolitik entschlossen fortgesetzt, nun auch unmittelbar von London aus, denn die neue Regierung Disraeli hatte ausgesprochen imperialistische Ambitionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
