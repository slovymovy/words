                ],
                "senses": [
                    {
                        "sense_id": "9d2db851-6424-318b-afd9-b1f01b03087c",
                        "entry_id": "01001eea-fb97-360e-9cf4-ef7998aea835",
                        "glosses": [
                            "beschikbaar, voorradig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d54387ee-b745-4bf9-bf39-8811679ffa4d",
                                "sense_id": "9d2db851-6424-318b-afd9-b1f01b03087c",
                                "text": "Volgens de onderzoekers toont de tocht van de vos ook het belang van zee-ijs aan. De dieren gebruiken het ijs in hun zoektocht naar voedsel, dat in de winters minder voorhanden is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a38d6c4-9995-4e9d-8cc2-d82b63f566ad",
                        "source_entry_id": "01001eea-fb97-360e-9cf4-ef7998aea835",
                        "source_sense_id": "9d2db851-6424-318b-afd9-b1f01b03087c",
                        "source_sense_description": "beschikbaar, voorradig",
                        "target_lang_word": "available",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "available",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec7e70f-6546-3bab-973b-1def50e65cd0",
                                        "entry_id": "0e9dd47c-2887-3616-8e96-9ba1b0bb8971",
                                        "glosses": [
                                            "Such as one may avail oneself of; capable of being used for the accomplishment of a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47955b5-b020-4386-99a4-b3cb90d9ef7d",
                                                "sense_id": "8ec7e70f-6546-3bab-973b-1def50e65cd0",
                                                "text": "We have an available candidate."
                                            },
                                            {
                                                "example_id": "3261a487-b1c2-4302-a688-54ec3ab02577",
                                                "sense_id": "8ec7e70f-6546-3bab-973b-1def50e65cd0",
                                                "text": "For this scene, a large number of supers are engaged, and in order to further swell the crowd, practically all the available stage hands have to ‘walk on’ dressed in various coloured dominoes, and all wearing masks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09e8efb-4d40-304d-8e21-cbeacac1cddb",
                                        "entry_id": "0e9dd47c-2887-3616-8e96-9ba1b0bb8971",
                                        "glosses": [
                                            "Readily obtainable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50bb1ea4-c15a-4cc3-aa91-b2db19f4c45e",
                                                "sense_id": "a09e8efb-4d40-304d-8e21-cbeacac1cddb",
                                                "text": "The list shows the available products in the store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edbcbd98-e9b3-33f5-a3d1-d188fe726843",
                                        "entry_id": "0e9dd47c-2887-3616-8e96-9ba1b0bb8971",
                                        "glosses": [
                                            "Valid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c167a40c-eb09-4d20-985d-95e9c29f0c09",
                                                "sense_id": "edbcbd98-e9b3-33f5-a3d1-d188fe726843",
                                                "text": "This is an available plea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "560cb163-b36a-3b94-840b-f9bae486b030",
                                        "entry_id": "0e9dd47c-2887-3616-8e96-9ba1b0bb8971",
                                        "glosses": [
                                            "Having sufficient power, force, or efficacy to achieve the purpose; availing, effective."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace74df3-3a9a-45b5-a6b0-a2049dc0ebdb",
                                                "sense_id": "560cb163-b36a-3b94-840b-f9bae486b030",
                                                "text": "One thing however, I finally settled upon—and that was, if I ever did meet him that I would shoot him precisely as I would shoot a mad dog. In order to make this plan available, I had […] armed myself with a revolver."
                                            },
                                            {
                                                "example_id": "878f3482-6600-49e6-b028-8c359070d1a3",
                                                "sense_id": "560cb163-b36a-3b94-840b-f9bae486b030",
                                                "text": "The different navigations she had to pass through for this purpose were such that only an independent method of propulsion would be available."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b0c516-a5cc-3145-afe9-094c1a9acfd0",
                                        "entry_id": "0e9dd47c-2887-3616-8e96-9ba1b0bb8971",
                                        "glosses": [
                                            "Free to meet someone, speak on the telephone, enter a romantic relationship, or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37182483-a9af-494d-86b9-2dcbeeb41e9c",
                                                "sense_id": "76b0c516-a5cc-3145-afe9-094c1a9acfd0",
                                                "text": "I have a question for you when you're available."
                                            },
                                            {
                                                "example_id": "8f93bb48-e27e-4fdf-91a5-73bedeacef57",
                                                "sense_id": "76b0c516-a5cc-3145-afe9-094c1a9acfd0",
                                                "text": "Hi, this is Mark Smith calling. Is your mother available?"
                                            },
                                            {
                                                "example_id": "8c94615f-7f4b-4d02-b90e-3d83b7bc1786",
                                                "sense_id": "76b0c516-a5cc-3145-afe9-094c1a9acfd0",
                                                "text": "I asked her if she was available, but she said she had a boyfriend."
                                            },
                                            {
                                                "example_id": "f49d5d41-858d-447c-a0dd-b73c87c31670",
                                                "sense_id": "76b0c516-a5cc-3145-afe9-094c1a9acfd0",
                                                "text": "Van de Velde did not make himself available to journalists. “He wants to rest his mind,” Immers explained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16466be8-b786-4854-b5ff-b7e44433beca",
                        "source_entry_id": "01001eea-fb97-360e-9cf4-ef7998aea835",
                        "source_sense_id": "9d2db851-6424-318b-afd9-b1f01b03087c",
                        "source_sense_description": "beschikbaar, voorradig",
                        "target_lang_word": "at hand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c72bb2-f60b-37f0-b39c-78b8ce8d5364",
                                        "entry_id": "269284fe-d3a2-3c93-9aad-b8edd823f92c",
                                        "glosses": [
                                            "Within easy reach; nearby."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9989c026-dfdf-4330-aa07-fc8031e37896",
                                                "sense_id": "03c72bb2-f60b-37f0-b39c-78b8ce8d5364",
                                                "text": "I don't have the information at hand, but I can look it up."
                                            },
                                            {
                                                "example_id": "31d93dd8-1635-444b-822a-8bbca05ea68c",
                                                "sense_id": "03c72bb2-f60b-37f0-b39c-78b8ce8d5364",
                                                "text": "The King your brother is now hard at hand,\nMeete with the foole, and rid your royall ſhoulders\nOf ſuch a burden, as outweighs the ſands\nAnd all the craggie rockes of Caſpea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f231109-dd9b-3ffb-8cb1-20fe13224ef2",
                                        "entry_id": "269284fe-d3a2-3c93-9aad-b8edd823f92c",
                                        "glosses": [
                                            "Near; soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d335e60-3028-4e01-a24a-74487efb03b0",
                                                "sense_id": "2f231109-dd9b-3ffb-8cb1-20fe13224ef2",
                                                "text": "At last, one morning, the propeller was quiet, and the Narwhal was pervaded with an atmosphere of excitement. He felt it, as did the other dogs, and knew that a change was at hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0daf0dcc-aaf6-3a76-b624-bfc3d80e87f6",
                                        "entry_id": "269284fe-d3a2-3c93-9aad-b8edd823f92c",
                                        "glosses": [
                                            "Currently receiving attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f09202b6-64b5-4d35-a4ad-d3b964cd05b3",
                                                "sense_id": "0daf0dcc-aaf6-3a76-b624-bfc3d80e87f6",
                                                "text": "The problem at hand is not the inability of the Arabs and the Jews to live together peacefully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "738c10e9-f56d-4d83-90d9-984737af9035",
                        "source_entry_id": "01001eea-fb97-360e-9cf4-ef7998aea835",
