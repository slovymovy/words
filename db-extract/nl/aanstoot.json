                                "target_senses": [
                                    {
                                        "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                        "entry_id": "926ad5a7-e4ab-3fa2-af88-5afda61813b8",
                                        "glosses": [
                                            "A feeling of anger or annoyance caused by something offensive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f64118-32b9-4e9d-a043-94a74ec7bd71",
                                                "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                                "text": "Antipathy in one nation against another disposes each more readily to offer insult and injury, to lay hold of slight causes of umbrage, and to be haughty and intractable when accidental or trifling occasions of dispute occur."
                                            },
                                            {
                                                "example_id": "16d4bfb5-dbc1-41f6-b4a5-f2d2f17609a1",
                                                "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                                "text": "—He took umbrage at something or other, that muchinjured but on the whole eventempered person declared, I let slip."
                                            },
                                            {
                                                "example_id": "2639a889-9e3f-4c96-b105-30e0022a91ba",
                                                "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                                "text": "She looked very neurotic, moving in a jerky way, her body giving little twitches of habitual umbrage."
                                            },
                                            {
                                                "example_id": "9c117c6b-328b-442a-8693-ae592100d66d",
                                                "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                                "text": "If she knew [a psychiatrist was] observing her son with a view to finding out if he was foggy between the ears, there would be umbrage on her part, or even dudgeon."
                                            },
                                            {
                                                "example_id": "2fcba12b-a97e-4a7b-856e-becad2c4ef3c",
                                                "sense_id": "481b15fc-9824-3443-96f3-484e291754e1",
                                                "text": "When the call is over, Cooper thanks her — for leashing the dog, but for also endangering him, for living down to herself, for quite a performance of umbrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b814567-dba0-381e-ad61-b31201c1578a",
                                        "entry_id": "926ad5a7-e4ab-3fa2-af88-5afda61813b8",
                                        "glosses": [
                                            "A feeling of doubt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2908e3e-7b49-3b72-a021-a3ada5ee269c",
                                        "entry_id": "926ad5a7-e4ab-3fa2-af88-5afda61813b8",
                                        "glosses": [
                                            "Leaves that provide shade, as the foliage of trees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de90636e-66e4-432f-81cb-a5fad707b000",
                                                "sense_id": "e2908e3e-7b49-3b72-a021-a3ada5ee269c",
                                                "text": "It was a relief to change the cheerful meadow for the dark umbrage of the forest which they now entered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e58373ee-b70c-3319-8d9d-8e53334b0273",
                                        "entry_id": "926ad5a7-e4ab-3fa2-af88-5afda61813b8",
                                        "glosses": [
                                            "Shadow; shade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3649f80d-881e-4673-b505-9043eaf9ac8f",
                                                "sense_id": "e58373ee-b70c-3319-8d9d-8e53334b0273",
                                                "text": "[...] but in the verity of extolment I take him to be a soul of great article and his infusion of such dearth and rareness as, to make true diction of him, his semblable in his mirror, and who else would trace him, his umbrage, nothing more."
                                            }
                                        ]
