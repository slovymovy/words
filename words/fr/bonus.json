    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ef5ffb9-31e7-35c0-a68c-48ffbe2f4e50",
                    "sense_definition": "Somme d'argent ou avantage accordé en plus de la rémunération normale en récompense du travail ou des résultats.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "avantage_financier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque employé recevra un <w>bonus</w> de fin d'année si l'entreprise atteint ses objectifs financiers."
                        },
                        {
                            "text": "Son contrat de travail prévoit un <w>bonus</w> annuel lié aux performances de son équipe."
                        }
                    ],
                    "synonyms": [
                        "prime",
                        "gratification"
                    ],
                    "antonyms": [
                        "malus"
                    ],
                    "common_phrases": [
                        "bonus annuel",
                        "toucher un bonus"
                    ]
                },
                {
                    "sense_id": "5b91f9b3-5d94-3c95-919c-3333590a55c7",
                    "sense_definition": "Élément additionnel offert avec un produit commercial, notamment un contenu supplémentaire dans un jeu vidéo ou sur un support audiovisuel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenu_additionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réédition de l'album contient plusieurs pistes <w>bonus</w> enregistrées en concert."
                        },
                        {
                            "text": "Le joueur a débloqué un niveau <w>bonus</w> après avoir terminé l'aventure principale."
                        }
                    ],
                    "synonyms": [
                        "supplément"
                    ],
                    "common_phrases": [
                        "scène bonus",
                        "piste bonus"
                    ]
                },
                {
                    "sense_id": "59ac795b-4149-3003-9f41-8fb57f0776ab",
                    "sense_definition": "Avantage ou opportunité inattendue obtenue en surcroît d'une situation déjà favorable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surcroit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous espérions seulement réussir l'examen, alors cette mention très bien est vraiment du <w>bonus</w>."
                        },
                        {
                            "text": "Le beau temps pendant notre séjour en montagne a été un véritable <w>bonus</w>."
                        }
                    ],
                    "synonyms": [
                        "aubaine",
                        "surcroît"
                    ],
                    "common_phrases": [
                        "du bonus"
                    ]
                }
            ]
        }
    ]
