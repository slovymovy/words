                                "target_senses": [
                                    {
                                        "sense_id": "07dd0ac1-9082-3296-b524-896489e841e8",
                                        "entry_id": "0b8d25c2-8428-354f-a3b9-bdba339a437c",
                                        "glosses": [
                                            "Sentimiento de placer y contento, por haber dado cumplimiento a una necesidad o gusto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d24531c-f943-4f07-b85e-982f2e0ade47",
                                                "sense_id": "07dd0ac1-9082-3296-b524-896489e841e8",
                                                "text": "Ha sido una satisfacción volver a verte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08466054-b13b-3c81-b634-904e5b61d0df",
                                        "entry_id": "0b8d25c2-8428-354f-a3b9-bdba339a437c",
                                        "glosses": [
                                            "Acción de cumplir con un requerimiento, anhelo, sentimiento, queja o cualquier otra razón de una parte contraria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "378e5749-5593-408c-a4eb-e7568c016cd2",
                                                "sense_id": "08466054-b13b-3c81-b634-904e5b61d0df",
                                                "text": "Hemos dado satisfacción al pago de las deudas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "af72b620-eb96-3722-8410-33e3fa93ca15",
                                        "entry_id": "0b8d25c2-8428-354f-a3b9-bdba339a437c",
                                        "glosses": [
                                            "Acción de cumplir con una necesidad u obligación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fd7d60-02b2-49a0-8e5d-922b3823efdc",
                                                "sense_id": "af72b620-eb96-3722-8410-33e3fa93ca15",
                                                "text": "Hemos dado satisfacción a nuestra hambre."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "99872b61-89df-3daf-b0dc-5680aa963ae0",
                                        "entry_id": "0b8d25c2-8428-354f-a3b9-bdba339a437c",
                                        "glosses": [
                                            "Estado de ánimo altanero y soberbio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500e590a-5cd7-45ed-8226-2574508cf915",
                                                "sense_id": "99872b61-89df-3daf-b0dc-5680aa963ae0",
                                                "text": "Es molesta su satisfacción por habernos ganado en el billar."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26314010-b10e-4dd5-87de-1ada65200573",
                        "source_entry_id": "a2b184f5-c98e-3b4a-adb5-dad893214763",
