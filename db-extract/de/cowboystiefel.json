                "senses": [
                    {
                        "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                        "entry_id": "de93697a-9e1a-3012-b44a-cdd97bf309d1",
                        "glosses": [
                            "Sorte von Stiefeln, die als charakteristische Fußbekleidung von Cowboys gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2f5c55-73fa-42a2-99e6-08358f03f4b3",
                                "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                                "text": "„Er trug außerdem ein zerknittertes weißes T-Shirt, eine verblichene Jeans und verkratzte dunkelbraune Cowboystiefel.“"
                            },
                            {
                                "example_id": "2fca459b-fbf3-43fb-b041-01cb48e1b673",
                                "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                                "text": "„Statt der sonst üblichen Schuhe trug er jedoch ein Paar extravanger Cowboystiefel, die ihm vor Jahren einmal seine Frau geschenkt hatte und die ihm seiner Meinung nach in den Jahren darauf immer wieder Glück gebracht hatten.“"
                            },
                            {
                                "example_id": "210f4c4c-629b-4b4c-9174-0bc49725e3b1",
                                "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                                "text": "„Man soll den Boten nicht erschießen, aber von seinen Cowboystiefeln fallen andauernd Klümpchen getrockneter Kuhscheiße ab.“"
                            },
                            {
                                "example_id": "13456fd0-0140-4b57-9c78-e2515e0e1218",
                                "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                                "text": "„Joe Lon setzte sich auf den Barhocker und klemmte die Hacken seiner Cowboystiefel hinter die untere Querstrebe.“"
                            },
                            {
                                "example_id": "2d558725-eea7-4985-87a1-3f62847516ee",
                                "sense_id": "80a33d0b-c2ce-3fb4-9da2-32e8223a569c",
                                "text": "„Ihr schwarzes Westernhemd hatte rote Paspeln und rote Rosen an den Schultern, und ihre schwarzen, spitzen Cowboystiefel waren blau verziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
