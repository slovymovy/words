                        ],
                        "examples": [
                            {
                                "example_id": "ab715bfb-17cc-4b8d-a0d6-98450c75ea6d",
                                "sense_id": "b4bc8a57-06e7-3029-bc59-39b973b0d16e",
                                "text": "Soms heeft men veel zin in een salade, vooral in de winter als al dat gekookte eten wel eens wat zwaar valt, maar gedver, dan moet je kool snipperen, peterselie hakken, enzovoort."
                            },
                            {
                                "example_id": "0eb6967f-6db3-438d-8d45-b9eacf8bc7d7",
                                "sense_id": "b4bc8a57-06e7-3029-bc59-39b973b0d16e",
                                "text": "„Gedver”, zei de vrouw. „Je gaat toch niet met zo’n belachelijke strik de straat op?”"
                            }
                        ]
                    }
