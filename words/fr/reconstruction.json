                    "frequency": "Middle",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La population s'est mobilisée pour financer la <w>reconstruction</w> de la cathédrale ravagée par les flammes."
                        },
                        {
                            "text": "Après le passage du violent séisme, la <w>reconstruction</w> de la ville a pris plusieurs années."
                        }
                    ],
                    "synonyms": [
                        "réédification"
                    ],
                    "antonyms": [
                        "démolition",
                        "destruction"
                    ],
                    "common_phrases": [
