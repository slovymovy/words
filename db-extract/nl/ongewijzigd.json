                                "sense_id": "38a4c3b1-8be4-3db3-becb-1a65b33253a0",
                                "text": "Het plan blijft ongewijzigd ondanks de kritiek.",
                                "translation": "The plan remains unaltered despite the criticism.",
                                "english": "The plan remains unaltered despite the criticism."
                            },
                            {
                                "example_id": "b832586a-1c0d-4a0e-abd1-13b45408667c",
                                "sense_id": "38a4c3b1-8be4-3db3-becb-1a65b33253a0",
                                "text": "De prijzen zijn ongewijzigd gebleven sinds vorig jaar.",
                                "translation": "The prices have remained unchanged since last year.",
                                "english": "The prices have remained unchanged since last year."
                            },
                            {
