                        "source_sense_id": "70729618-1d02-3e2c-9373-f93bc6f2d844",
                        "target_lang_word": "Ausbeuter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausbeuter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42eab609-1ae5-3421-9bcd-7211139040d5",
                                        "entry_id": "d22198da-2d74-3f9f-ac54-0f410a382984",
                                        "glosses": [
                                            "jemand, der andere über Gebühr zum eigenen Vorteil ausnutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f73dc6-34db-4f84-a5f5-de693cf64261",
                                                "sense_id": "42eab609-1ae5-3421-9bcd-7211139040d5",
                                                "text": "In einer gänzlich freien Wirtschaft lassen die Ausbeuter nicht lange auf sich warten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59b3aa15-f56e-41b2-a4fa-d9cc9bc8061f",
                        "source_entry_id": "53329574-9adf-3e12-897b-3dedd552152e",
                        "source_sense_id": "70729618-1d02-3e2c-9373-f93bc6f2d844",
                        "target_lang_word": "exploiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exploiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50bf07dd-c033-305c-8bdd-ce6939ee123e",
                                        "entry_id": "eeea5cd7-a15f-3d64-b9e4-5783af1c4259",
                                        "glosses": [
                                            "Celui qui exploite, qui tire un profit illicite ou abusif d’une situation ou d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633d0afd-60cb-4560-b775-c5b7979e8462",
                                                "sense_id": "50bf07dd-c033-305c-8bdd-ce6939ee123e",
                                                "text": "La bouche grasse, les pommettes rouges, les yeux injectés de bourgogne, Guillaume-Adolphe Porcellet célébra la grève, la sainte grève!... Avec une rare éloquence, il parla des exploiteurs de peuples, des affameurs de pauvres."
                                            },
                                            {
                                                "example_id": "b7b93b85-d397-48c6-a63b-38c372ebb2c6",
                                                "sense_id": "50bf07dd-c033-305c-8bdd-ce6939ee123e",
                                                "text": "Ainsi toute cette philosophie sert,à voiler les misères de l'époque […]. Elle sert à détourner les exploités de la contemplation périlleuse pour les exploiteurs, de leur dégradation, de leur abaissement."
                                            },
                                            {
                                                "example_id": "3a03f1e1-4666-4c1d-8dc7-a948e19da1da",
                                                "sense_id": "50bf07dd-c033-305c-8bdd-ce6939ee123e",
                                                "text": "Les exploiteurs qui tiennent les cordons de la bourse et le goulot de la bouteille à l’encre ont beau ne pas regarder à la dépense et se donner une grande peine, ils n’arrivent plus à maquiller leur magma d’incohérences et de menaces."
                                            },
                                            {
                                                "example_id": "40f0b6fd-b0fe-41e9-86ca-67df7331c6fe",
                                                "sense_id": "50bf07dd-c033-305c-8bdd-ce6939ee123e",
                                                "text": "Les rabbins sont exactement aussi pervers et avides de pouvoir que leurs collègues des églises et mollahcraties ou autres exploiteurs de la fragilité mentale-affective humaine de par le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90108ae-2ad4-30f4-934a-2504106c0f41",
                                        "entry_id": "eeea5cd7-a15f-3d64-b9e4-5783af1c4259",
                                        "glosses": [
                                            "Élément de programme permettant d'exploiter une faille de sécurité informatique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
