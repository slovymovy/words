    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3451184e-3310-344a-8c14-bebf35653723",
                    "sense_definition": "Qui ne bouge pas du tout, qui demeure totalement immobile en parlant d'une personne, d'un regard ou d'une attitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immobilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté <w>figé</w> de stupeur en apprenant cette terrible nouvelle."
                        },
                        {
                            "text": "Elle gardait un sourire <w>figé</w> devant les photographes impatients."
                        }
                    ],
                    "synonyms": [
                        "immobile",
                        "pétrifié"
                    ],
                    "antonyms": [
                        "mobile",
                        "expressif"
                    ],
                    "common_phrases": [
                        "sourire figé",
                        "regard figé",
                        "rester figé"
                    ]
                },
                {
                    "sense_id": "2cd83038-70ee-3d28-9cda-d5ac9c91344b",
                    "sense_definition": "Qui n'évolue plus, qui refuse ou interdit tout changement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stabilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette langue n'est pas un système <w>figé</w>, elle évolue constamment."
                        },
                        {
                            "text": "La négociation est bloquée dans une situation devenue totalement <w>figée</w>."
                        }
                    ],
                    "synonyms": [
                        "immuable",
                        "statique",
                        "rigide"
                    ],
                    "antonyms": [
                        "évolutif",
                        "dynamique",
                        "souple"
                    ],
                    "common_phrases": [
                        "expression figée",
                        "situation figée"
                    ]
                },
                {
                    "sense_id": "5604a6f3-c760-33b1-bbaf-ecc5c92d7f88",
                    "sense_definition": "Qui est devenu solide ou pâteux sous l'effet du froid, en particulier pour un corps gras ou un liquide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La graisse de canard était déjà <w>figée</w> à la surface du plat."
                        },
                        {
                            "text": "Il faut réchauffer l'huile d'olive devenue <w>figée</w> dans la cave."
                        }
                    ],
                    "synonyms": [
                        "coagulé",
                        "solidifié"
                    ],
                    "antonyms": [
                        "fondu",
                        "liquide"
                    ],
                    "common_phrases": [
