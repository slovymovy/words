                                        "entry_id": "20da89d1-6748-3fb4-9853-239b60d81941",
                                        "glosses": [
                                            "Fully observant, vigilant, or aware."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a774e4d-763d-460a-a479-7cca4f1acf22",
                                                "sense_id": "907b09f7-5d42-3f9a-b5e3-778f204cfceb",
                                                "text": "The teacher kept a watchful eye on her pupils during the school trip."
                                            },
                                            {
                                                "example_id": "dcc0e149-5485-4e7b-be9c-827b5e20bf1c",
                                                "sense_id": "907b09f7-5d42-3f9a-b5e3-778f204cfceb",
                                                "text": "But there was so much at stake that I had to take some risk—though even when I was far away there has never been a day when the Shire has not been guarded by watchful eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
