                        "sense_id": "5c131568-64ef-33ee-b57b-60db943f4765",
                        "entry_id": "c2feb5d3-b16b-3ef6-8d1f-44088361813f",
                        "glosses": [
                            "Mélange de bouillon et de vin."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4779c340-6ced-458f-94d0-002b56fd34f8",
                                "sense_id": "5c131568-64ef-33ee-b57b-60db943f4765",
                                "text": "- M. le président : Le chabrot, c’est un mélange de bouillon et de vin."
                            },
                            {
                                "example_id": "3a924ee3-c326-41c6-ad06-d9b6e31e33c7",
                                "sense_id": "5c131568-64ef-33ee-b57b-60db943f4765",
                                "text": "On commençait la journée en mangeant une bonne soupe au lard brûlante où l’on faisait chabrot, un verre de vin rouge dans le bouillon."
                            },
                            {
                                "example_id": "747128dd-8830-406b-b8e5-17b9d04928b6",
                                "sense_id": "5c131568-64ef-33ee-b57b-60db943f4765",
                                "text": "Cette pratique du chabrot était une manière de communier dans un savoir pastoral."
                            },
                            {
                                "example_id": "54d70114-dddc-4099-81fa-2e537fcc27f4",
                                "sense_id": "5c131568-64ef-33ee-b57b-60db943f4765",
                                "text": "— C'est dégoûtant le chabrot. Ça pue !"
                            }
                        ]
                    }
