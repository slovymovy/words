                        "glosses": [
                            "Urlaub, dessen Hauptzweck die Möglichkeit zum Segeln ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914eed9a-adb0-4e7e-a08c-ccf6c0a41377",
                                "sense_id": "b97884d2-2d59-38e9-ba53-6e98564a2dde",
                                "text": "„Wenn mein Chef in seinem Büro Fotos von seinem Segelurlaub oder von seinen kleinen Kindern oder seinem Hund hängen hat, dann möchte er darauf angesprochen werden.“"
                            },
                            {
                                "example_id": "7dcd0512-020d-4dc8-a563-1186f0c5e02d",
                                "sense_id": "b97884d2-2d59-38e9-ba53-6e98564a2dde",
                                "text": "„Und doch ist das Risiko, sich mit dem Covid-19-Virus zu infizieren, bei einem Segelurlaub geringer als bei vielen anderen Ferienvergnügen.“"
                            }
                        ],
