                ],
                "senses": [
                    {
                        "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                        "entry_id": "0cd11349-6675-334b-9a7c-04e0099009d8",
                        "glosses": [
                            "seitlicher Rand einer Straße oder eines Radweges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17290dfb-b284-4f26-9a81-55e10bf247ad",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "Autofahrer bilden für Rettungsfahrzeuge eine Rettungsgasse, indem sie auf der linken Fahrspur an den linken Fahrbahnrand und der rechten Fahrspur an den rechten Fahrbahnrand fahren."
                            },
                            {
                                "example_id": "ea67c737-8dce-454d-aa79-dc26ea7b4420",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„England hebt sich etwas von den anderen europäischen Ländern ab: Einfache oder doppelte Linien am Fahrbahnrand oder auch in der Mitte bestimmen das Parkverbot.“"
                            },
                            {
                                "example_id": "1bfa3312-2db6-40e0-9b8c-72c87c4ab706",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„In dichtem Nebel sollten sich Autofahrer am rechten Fahrbahnrand und den Leitpfosten orientieren, damit sie nicht auf die Gegenfahrbahn geraten.“"
                            },
                            {
                                "example_id": "eef1fe30-98e1-4a96-b439-ebd2e4afa606",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Der Unfall geschah auf der Köllikerstrasse.“ […] „Die Frau kollidierte am Fahrbahnrand mit einem Baum, worauf sich das Auto um die eigene Achse drehte.“"
                            },
                            {
                                "example_id": "a6fe2909-61d5-4f82-97ed-4e039f242603",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Die Physiotherapeutin fuhr wie gewohnt auf dem Radweg. Plötzlich öffnete sich die Tür eines rechts am Fahrbahnrand parkenden BMW. Sabine Lühr-Tanck konnte nicht mehr ausweichen und stürzte.“"
                            },
                            {
                                "example_id": "3acba29d-81ed-40ab-970d-f7afcfa428a4",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Laut Polizei wollte der Autofahrer am Fahrbahnrand einparken und touchierte dabei die vorbeifahrende Radfahrerin auf dem Gehweg.“"
                            },
                            {
                                "example_id": "089c96c1-a00c-46ce-88fa-00e43636110e",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Großes Glück hat gestern Nachmittag ein Fahrzeuglenker in Aldrans (Tirol) gehabt. Er kam mit seinem Auto über den Fahrbahnrand hinaus. Im letzten Moment blieb das Auto aber vor dem Abgrund hängen.“"
                            },
                            {
                                "example_id": "4c51307e-9bfb-47af-b129-ecd9cea794cb",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "[Radfahren bei Olympia:] […] „die Niederländerin Ellen van Dijk rutschte vom Fahrbahnrand ab und stand plötzlich in der Böschung.“"
                            },
                            {
                                "example_id": "9cdb0ea6-6ec5-43a8-a53a-33a144c2136a",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Die B39 in Sinsheim ist laut Stadt wieder frei befahrbar. Die Strecke war zuletzt gesperrt, weil dort am Sonntag vor einer Woche eine Mauer am Fahrbahnrand eingestürzt war.“"
                            },
                            {
                                "example_id": "98c0dc20-b5db-41b3-9fc9-51dedb711009",
                                "sense_id": "67581345-374c-3ecf-b838-367a15de3451",
                                "text": "„Ein Auslieferungsfahrzeug eines Paketzustellers ist am helllichten Tag in Hildesheim gestohlen worden.“ […] „Etwa eine Stunde später entdeckte eine Streifenbesatzung der Autobahnpolizei den Pkw verschlossen am Fahrbahnrand. Ob Pakete gestohlen wurden, war zunächst unklar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
