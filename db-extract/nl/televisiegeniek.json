                        "examples": [
                            {
                                "example_id": "9721ce1c-5db8-4a8b-8919-a3e268fe5fae",
                                "sense_id": "a130eca3-03a3-373a-8e14-d87033899623",
                                "text": "Voor de sociaal-democraten blijft er weinig over dan hopen dat Stoiber een modderfiguur slaat in de twee televisiedebatten die op het programma staan. Van Stoiber is bekend dat hij minder televisiegeniek is dan Schröder."
                            },
                            {
                                "example_id": "221b4c5e-2de1-4239-9e82-659776b3c842",
                                "sense_id": "a130eca3-03a3-373a-8e14-d87033899623",
                                "text": "Het lag niet helemaal alleen aan de Giro dat ik zaterdag op de bank lag te suffen toen hij in San Lorenzo al Mare met een ploegentijdrit – geef toe: het minst televisiegenieke sportonderdeel sinds Eurosport de rechten op het Lets kampioenschap Bierviltjeshappen voor veteranen verloren is – van start ging."
                            }
