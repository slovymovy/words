        "pl-extract.jsonl": [
            {
                "entry_id": "ae69f59e-4f4c-395f-87b5-609f6e63b197",
                "word": "zajebiście",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "46f8f8b9-ced6-3699-8151-333d15292367",
                        "entry_id": "ae69f59e-4f4c-395f-87b5-609f6e63b197",
                        "glosses": [
                            "bardzo intensywnie"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "b2a633f2-1013-45db-ad0a-24e7b56c739e",
                                "sense_id": "46f8f8b9-ced6-3699-8151-333d15292367",
                                "text": "Pomalowałem se ściany zajebiście zieloną farbą."
                            },
                            {
                                "example_id": "102a3374-6040-41cc-9998-7cd03bead45c",
                                "sense_id": "46f8f8b9-ced6-3699-8151-333d15292367",
                                "text": "Podajcie jakiś zajebiście, ale to zajebiście mocno wciągający serial. Tak, żeby odpalać odcinek za odcinkiem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9970ec53-bec6-3077-b199-a015a27e94e7",
                        "entry_id": "ae69f59e-4f4c-395f-87b5-609f6e63b197",
                        "glosses": [
                            "wspaniale, świetnie"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "00a7bfd8-fda1-461c-8757-cee389c33461",
                                "sense_id": "9970ec53-bec6-3077-b199-a015a27e94e7",
                                "text": "Ale zajebiście… W końcu weekend!"
                            },
                            {
                                "example_id": "33ebb0c7-461d-4caa-897d-f1d0cf7840a1",
                                "sense_id": "9970ec53-bec6-3077-b199-a015a27e94e7",
                                "text": "Żałuj, że tam nie byłeś. Było zajebiście."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6243dcd3-876c-4564-b642-a62f3ed97702",
                        "source_entry_id": "ae69f59e-4f4c-395f-87b5-609f6e63b197",
                        "source_sense_id": "46f8f8b9-ced6-3699-8151-333d15292367",
                        "target_lang_word": "заебись",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заебись",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ce12ebc2-a71b-3af0-9a12-fa9c65b91ae8",
                                        "entry_id": "3d2eb6b2-193b-3567-8716-a62cedbcf852",
                                        "glosses": [
                                            "обсц. : хорошо; очень хорошо; качественно; на высоком уровне; на высшем уровне"
                                        ],
                                        "tags": [
                                            "наречие в качестве обстоятельства; образовано от императива ед. ч. глагола заебаться"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ba8011-0eff-4ef4-b1d2-9a0a1b614a64",
                                                "sense_id": "ce12ebc2-a71b-3af0-9a12-fa9c65b91ae8",
                                                "text": "Не знаешь как сделать заебись, не работает программа, не заключается выгодный договор с клиентом?"
                                            },
                                            {
                                                "example_id": "9b04ef72-a826-4e82-bb65-dfbf5290e426",
                                                "sense_id": "ce12ebc2-a71b-3af0-9a12-fa9c65b91ae8",
                                                "text": "В этом платье она выглядела заебись, на все сто."
                                            },
                                            {
                                                "example_id": "2bb7e62a-f89c-4f05-af38-191dd65e99a5",
                                                "sense_id": "ce12ebc2-a71b-3af0-9a12-fa9c65b91ae8",
                                                "text": "— Не доёбывайся ты до него, Бык, — защищает меня его приятель, Чура. — Малы́е заебись: бухло проставили."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "заебись",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                        "entry_id": "c341a3eb-1a93-37e4-bc72-4524155f6ec6",
                                        "glosses": [
                                            "обсц. : хорошо; очень хорошо; прекрасно; великолепно; замечательно"
                                        ],
                                        "tags": [
                                            "оценочная характеристика ситуации, чьих-либо действий как хороших, очень хороших, в высшей степени приемлемых"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3af7f6-36f6-4204-b0c8-a0eda061cb1b",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "— Заебись! Плюху нашёл!"
                                            },
                                            {
                                                "example_id": "a2e71cf4-da08-4774-ba1e-35416e8f9e34",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "Мы поможем тебе сделать заебись."
                                            },
                                            {
                                                "example_id": "79cee947-39e2-488b-b987-1540219755df",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "И СЕРЁЖКИ ОТ АРМАНИ — ТО-ТО БУДЕТ ЗАЕБИСЬ! Клон был абсолютно точным — сохранялась даже рифмовка брэнд-нэйма с матерным термином."
                                            },
                                            {
                                                "example_id": "8ce7649a-c3d5-4bdc-b38e-448ad4e384af",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "— Мост Квинсборо, — тоном экскурсовода сказал Ник, — такс фри. Бесплатно. — Заебись… — коротко прокомментировал Кислый."
                                            },
                                            {
                                                "example_id": "9b39bc99-e6d5-42d3-8aa7-9f01d185644b",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "— Дышит?! Заебись! Яйца ему в тисках прищемите."
                                            },
                                            {
                                                "example_id": "737b0a70-2d32-4eff-bcac-005dc007ed2d",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "Первым идёт Вэк, минуты через три выходит. — Ну что? — Заебись. Приняли. — «Демократический централизм» спрашивали? ❬…❭ На стенах — фотографии Беланова, Заварова, Платини, Сократеса и группы «Модерн токинг». — Ну как, заебись у нас? — спрашивает Обезьяна."
                                            },
                                            {
                                                "example_id": "60327415-eced-4b0f-8176-3710666244ad",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "Шварц! Классно. Заебись. Посмотрим Шварца."
                                            },
                                            {
                                                "example_id": "3817dd2e-bd9b-45a3-8fcb-240c03b8301f",
                                                "sense_id": "b0b6ce34-eb2f-3bd4-bba0-8ff039c40db8",
                                                "text": "— Не переживай, отец. Всё идёт просто заебись!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "заебись",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6edd26a-4c54-343a-8dc6-0dfc182ee460",
                                        "entry_id": "423a44b7-8f2f-30ed-b142-f2f314e52915",
                                        "glosses": [
                                            "обсц. форма единственного числа повелительного наклонения глагола заебаться"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
