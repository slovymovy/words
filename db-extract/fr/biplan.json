                "senses": [
                    {
                        "sense_id": "1346554f-e70c-357d-8970-438eb4cd97d0",
                        "entry_id": "6d332d2c-e5ef-3cf2-83a0-1754687a8f45",
                        "glosses": [
                            "Qui a deux faces parallèles entre elles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be3fb1b3-b918-4ddd-b7d2-2e50241a393d",
                                "sense_id": "1346554f-e70c-357d-8970-438eb4cd97d0",
                                "text": "Chez les mammifères, les vertèbres sont biplanes, sans cavité où peuvent se placer les coussinets. Les coussinets deviennent donc également biplans et sont appelés disques intervertébraux."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "78dba3e2-d951-3d80-bcdb-77fc4a9275e3",
                "word": "biplan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8417e184-2362-424f-bad3-6fa29fe1126d",
                        "entry_id": "78dba3e2-d951-3d80-bcdb-77fc4a9275e3",
                        "tags": [
                            "plural"
                        ],
                        "form": "biplans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                        "entry_id": "78dba3e2-d951-3d80-bcdb-77fc4a9275e3",
                        "glosses": [
                            "Avion pourvu de deux paires d'ailes, l'une au-dessus de l'autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48881fbf-11ff-4eff-a2c7-a07769b1a0b7",
                                "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                                "text": "Un groupe de biplans allemands, dans le but de dominer les cataractes et les usines, essayait de se maintenir au zénith en une phalange serrée que les Jaunes s’acharnaient à vouloir disperser."
                            },
                            {
                                "example_id": "5b4ad5d7-7673-4e15-ae46-17ff58852d60",
                                "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                                "text": "Nous avons fait comme un saut de mouton, puis j'ai arraché, avec le plus d'énergie peut-être qu'auparavant, le « manche à balai ». A cet instant notre biplan se trouva dans une position beaucoup plus normale, et fila d'un trait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "563416f4-788f-4957-bfed-1bca1c0b9508",
                        "source_entry_id": "78dba3e2-d951-3d80-bcdb-77fc4a9275e3",
                        "source_sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                        "target_lang_word": "Doppeldecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doppeldecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "ein Flugzeug mit zwei übereinander liegenden Flügeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638121b6-6e95-45b9-996d-74856046f4cc",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "Ich bin mit einem Doppeldecker geflogen."
                                            },
                                            {
                                                "example_id": "85d8d7ef-fe03-4fb5-a12b-07c8b9e3dc5a",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„In großer Höhe drehte ein Doppeldecker einen Looping nach dem andern und weit draußen übte die Marine Schießen.“"
                                            },
                                            {
                                                "example_id": "38e12bc7-f778-4799-8e19-38d345bfaaae",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„Er machte seinen Pilotenschein und kaufte sich später einen Doppeldecker, einen Zweisitzer, und unternahm sogar mit seiner Tochter Geneviève Rundflüge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "Kurzform für einen Omnibus mit zwei Stockwerken, siehe Doppeldeckerbus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84b6042-929b-4e47-8af4-18dd6e48ac51",
                                                "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                                "text": "Ich bin mit einem Doppeldecker mitgefahren."
                                            },
                                            {
                                                "example_id": "6b064d8c-fc2d-4608-95af-eaa38f91a198",
                                                "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                                "text": "In London haben wir mit einem Doppeldecker eine Stadtrundfahrt gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f35fbe9e-10a8-3775-9915-5bc59659ad08",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "Kurzform für eine Straßenbahn mit zwei Stockwerken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7e0eb3-ffe6-45d1-be11-ddc9b57c7349",
                                                "sense_id": "f35fbe9e-10a8-3775-9915-5bc59659ad08",
                                                "text": "Der Doppeldecker fuhr in den neu verlegten Schienen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
