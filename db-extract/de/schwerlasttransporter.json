                "senses": [
                    {
                        "sense_id": "dee3c2be-08d5-3479-a44d-a17fafc278af",
                        "entry_id": "a71c9d57-45f9-3ed0-a549-63211c9b4ec6",
                        "glosses": [
                            "großes, zur Beförderung von Gütern von sehr hohem Gewicht und Ausmaß genutztes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ee67ab-bf11-43a5-80c9-501145e4a109",
                                "sense_id": "dee3c2be-08d5-3479-a44d-a17fafc278af",
                                "text": "„Ein Schwerlasttransporter hat in der Nacht zu Montag fünf Brücken auf der A23 zwischen Pinneberg und Hamburg-Eidelstedt beschädigt.“"
                            },
                            {
                                "example_id": "447e4ea7-a4aa-4314-bf0d-60a71287d062",
                                "sense_id": "dee3c2be-08d5-3479-a44d-a17fafc278af",
                                "text": "„Wie ein Polizeisprecher erklärte, war ein 27-Jähriger nahe der Raststätte Schönberger Land unweit von Wismar mit hoher Geschwindigkeit auf einen Schwerlasttransporter aufgefahren.“"
                            },
                            {
                                "example_id": "bbb7b30b-02de-43d6-942e-5ab258cdab5a",
                                "sense_id": "dee3c2be-08d5-3479-a44d-a17fafc278af",
                                "text": "„Der 51-jährige Fahrer des Schwerlasttransporters war am Donnerstagabend in Richtung Süden unterwegs.“"
                            },
                            {
                                "example_id": "587a473e-b51c-48f8-a131-524f47e353a1",
                                "sense_id": "dee3c2be-08d5-3479-a44d-a17fafc278af",
                                "text": "„Die neue Intensivstation entsteht in Containern, die von speziellen Schwerlasttransportern angeliefert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
