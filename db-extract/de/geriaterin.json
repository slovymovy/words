                        ]
                    },
                    {
                        "translation_id": "8b8d0a6c-d6a9-4041-b9d0-6daa7cc14353",
                        "source_entry_id": "894a67a9-e03a-30e0-8b51-0df9ea91f314",
                        "source_sense_id": "e553001b-9a3e-3641-b19a-5872b60d02b5",
                        "source_sense_description": "Ärztin mit speziellen Kenntnissen auf dem Gebiet der Geriatrie",
                        "target_lang_word": "gériatre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gériatre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8450880-3348-3248-8f00-af416d059bbb",
                                        "entry_id": "4a94ae13-4820-3b47-bf42-11b4583d8743",
                                        "glosses": [
                                            "Médecin spécialisé dans les soins aux personnes âgées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff3dda7-8f1d-4387-866d-9debf57b55d2",
                                                "sense_id": "d8450880-3348-3248-8f00-af416d059bbb",
                                                "text": "C'est aussi après cet épisode que la gériatre pose « en tête à tête » à la patiente la question de sa perception de sa maladie ou plutôt de son état, en faisant l'hypothèse qu'elle aussi a perçu un signal intérieur de l'entrée en fin de vie."
                                            },
                                            {
                                                "example_id": "3af23d3b-aec7-4987-8050-4845c4d56209",
                                                "sense_id": "d8450880-3348-3248-8f00-af416d059bbb",
                                                "text": "Le problème est d'ailleurs des plus complexes : ce n'est pas seulement l’alimentation du vieillard bien portant ou malade qui doit préoccuper le gériatre, mais aussi celle de l'adulte sain dès le cap de la cinquantaine, véritable âge critique […]."
                                            },
                                            {
                                                "example_id": "0cb1c736-2161-4f19-bb99-6cacc752dfe0",
                                                "sense_id": "d8450880-3348-3248-8f00-af416d059bbb",
                                                "text": "Le gériatre de secteur doit être une médecin qualifié en gérontologie. Ceci implique une formation médicale gériatrique d'une part, et médico-sociale d'autre part."
                                            },
                                            {
                                                "example_id": "ac0d0c41-8f77-4380-9d8e-7186383b049f",
                                                "sense_id": "d8450880-3348-3248-8f00-af416d059bbb",
                                                "text": "Les opportunités pour les gériatres sont terribles ici. Cette spécialité est terriblement dévaluée. C'est très triste parce que je pensais vraiment,quand j'ai choisi la gériatrie, que c'était la spécialité du futur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
