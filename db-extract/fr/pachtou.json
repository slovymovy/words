                "senses": [
                    {
                        "sense_id": "1dd14458-fbc8-39d1-abb2-37817d5283a2",
                        "entry_id": "9f6d9415-4afd-3f1b-ac3d-29914c1f45c1",
                        "glosses": [
                            "Langue iranienne parlée en Afghanistan et au Pakistan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee780fe-9d51-45ef-985e-97a77837627c",
                                "sense_id": "1dd14458-fbc8-39d1-abb2-37817d5283a2",
                                "text": "Les uns ont fourni l’hébergement, les autres les repas ou l’assistance administrative. Quant aux interprètes capables de parler le patchou ou le dari, ils sont venus des rangs de l’ADAM, Association des Afghans de Montpellier."
                            },
                            {
                                "example_id": "a627b8ef-1279-4f44-9ad6-8f53a9a34c74",
                                "sense_id": "1dd14458-fbc8-39d1-abb2-37817d5283a2",
                                "text": "Karim et le soldat afghan s’entretinrent en pachtou. Je surpris une partie de leur échange – quelque chose au sujet de Toor et de sa déveine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
