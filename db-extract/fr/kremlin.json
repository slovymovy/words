                    {
                        "translation_id": "13fed40b-3c52-4222-8746-d53246cb9e64",
                        "source_entry_id": "0992457e-8ab2-398e-b377-64573c49ca0f",
                        "target_lang_word": "Κρεμλίνο",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Κρεμλίνο",
