                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Sessions</w> was appointed to the committee last year.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сешнс</w> был назначен в комитет в прошлом году."
                            }
