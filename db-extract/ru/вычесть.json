                                        "entry_id": "3adf832d-e6f8-3972-bf56-f572c2b94eb7",
                                        "glosses": [
                                            "To remove or reduce; especially to reduce a quantity or number."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2830cf3-2555-4a31-8b5f-130d9252d307",
                                                "sense_id": "b14df709-6143-3318-85e0-cb66bd7a48ba",
                                                "text": "If you subtract the $100 for gas from the total cost, it was a fairly inexpensive trip."
                                            }
                                        ]
                                    }
                                ]
