{
    "word_family": [
        "pry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d027a5d3-28b1-300e-9b85-1e1eb497c9ba",
                    "sense_definition": "The act of looking into or inquiring about someone's private affairs in an intrusive or annoying way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inquisitiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors were tired of the constant <w>prying</w> into their personal lives.",
                            "target_lang_translations": {
                                "de": "Die Nachbarn waren das ständige <w>Herumschnüffeln</w> in ihrem Privatleben leid."
                            }
                        },
                        {
                            "text": "She felt that his <w>prying</w> was an invasion of her privacy.",
                            "target_lang_translations": {
                                "de": "Sie empfand seine <w>Schnüffelei</w> als Verletzung ihrer Privatsphäre."
                            }
                        }
                    ],
                    "synonyms": [
                        "snooping",
                        "meddling"
                    ],
                    "common_phrases": [
                        "constant prying",
                        "unwanted prying"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Eindringen in die Privatsphäre anderer durch neugieriges Nachfragen oder Beobachten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schnüffelei",
                                "target_lang_sense_clarification": "umgangssprachlich für das neugierige Ausspionieren"
                            },
                            {
                                "target_lang_word": "Herumschnüffeln",
                                "target_lang_sense_clarification": "das aktive, störende Nachforschen"
                            },
                            {
                                "target_lang_word": "Einmischung",
                                "target_lang_sense_clarification": "das unerwünschte Einmischen in fremde Angelegenheiten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c7eb9fe-3668-389a-bb9f-6a1c3f381a35",
                    "sense_definition": "Present participle and gerund of <w>pry</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inquisitiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>prying</w> into my business and focus on your own work.",
                            "target_lang_translations": {
                                "de": "Hör auf, in meinen Angelegenheiten <w>herumzuschnüffeln</w>, und konzentrier dich auf deine eigene Arbeit."
                            }
                        },
                        {
                            "text": "He was caught <w>prying</w> open the locked drawer with a screwdriver.",
                            "target_lang_translations": {
                                "de": "Er wurde dabei erwischt, wie er die verschlossene Schublade mit einem Schraubenzieher <w>aufhebelte</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snooping",
                        "meddling"
                    ],
                    "common_phrases": [
                        "prying into",
                        "prying open"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'pry' (herumschnüffeln oder aufhebeln)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herumschnüffeln",
                                "target_lang_sense_clarification": "in fremden Angelegenheiten wühlen"
                            },
                            {
                                "target_lang_word": "aufhebeln",
                                "target_lang_sense_clarification": "mit Gewalt öffnen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}