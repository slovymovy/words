                        ],
                        "examples": [
                            {
                                "example_id": "61ab49d1-fa21-4969-9b62-f259bd357b4b",
                                "sense_id": "3552208d-9cc5-3c38-aa5e-c182bbe635d0",
                                "text": "Коричнево-ржавый (интенсивно ржавый), сырой, слипающийся суглинок со щебнем и камнем (70— 75%)"
                            },
                            {
                                "example_id": "852393e2-1eac-4bcd-a674-1a364b26e383",
                                "sense_id": "3552208d-9cc5-3c38-aa5e-c182bbe635d0",
                                "text": "Светло-ржавый, сырой, слипающийся крупинчатый суглинок, с единичными корешками"
                            },
                            {
                                "example_id": "4a714c21-8ed3-4378-b6de-6ab4787e2f93",
                                "sense_id": "3552208d-9cc5-3c38-aa5e-c182bbe635d0",
                                "text": "При этом образуется обильный, слипающийся в комки бурый осадок."
                            }
                        ]
                    }
