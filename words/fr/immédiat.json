                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est déjà sur le quai et son départ est <w>immédiat</w>."
                        },
                        {
                            "text": "Ce médicament permet de calmer la douleur avec une efficacité <w>immédiate</w>."
                        }
                    ],
                    "synonyms": [
