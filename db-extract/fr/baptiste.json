                                        "sense_id": "70ff46ad-b528-30e6-b82e-b422e135babd",
                                        "entry_id": "755a25bf-327d-3f28-a1cb-78d5b9cb41c8",
                                        "glosses": [
                                            "Variante informal de autista."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e4f860-54e2-439b-b4a1-81ec088daa02",
                                                "sense_id": "70ff46ad-b528-30e6-b82e-b422e135babd",
                                                "text": "ayer me saltó un tiktok del tren patagónico y tuve que largarme a llorar desconsoladamente\nmi nuevo sueño es subirme a todos los trenes que hay en el país y nunca terminar porque por arte de magia vuelven a reestablecer más\nme poseyó un niño bautista"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bautista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6aabccbb-12fe-38b7-ab6c-cb1e5be3cb50",
                                        "entry_id": "ae55b65c-5f6e-3eb8-b84d-538532f75311",
                                        "glosses": [
                                            "Que administra el bautismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90673bc4-ee81-4d44-8521-e3b4e5f74e7d",
                                                "sense_id": "6aabccbb-12fe-38b7-ab6c-cb1e5be3cb50",
                                                "text": "Salue te Dios hermosura\nde la yglesia gran bautista\nangel de humana figura\nluz de la sacra escritura\nfenix en la tierra vista."
                                            },
                                            {
                                                "example_id": "6b209e41-8ba9-405f-b64f-0d5b6042c5a3",
                                                "sense_id": "6aabccbb-12fe-38b7-ab6c-cb1e5be3cb50",
                                                "text": "Yo estaba furioso; maldecía los clubs y quien los inventó; maldecía también a Ugarte, que me había catequizado, y a Monsalud, que fue mi bautista."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17f70cd2-6644-3617-9303-258e1ad24c8b",
                                        "entry_id": "ae55b65c-5f6e-3eb8-b84d-538532f75311",
                                        "glosses": [
                                            "Que pertenece o concierne al baptismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c001ea-4b47-4f76-89ef-5c9079bc70a2",
                                                "sense_id": "17f70cd2-6644-3617-9303-258e1ad24c8b",
                                                "text": "Soberbia y humildad son enemigos que he visto abrazarse muchas veces, en palabras y gestos que transparentaban un alma de asceta, de bautista, un alma puritana."
                                            },
                                            {
                                                "example_id": "4c7598a9-5371-4ab9-8aeb-8457ec9e1616",
                                                "sense_id": "17f70cd2-6644-3617-9303-258e1ad24c8b",
                                                "text": "Un día en Londres ve en la fachada de una iglesia bautista un curioso letrero: ‘Sean bien venidos los extranjeros’."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
