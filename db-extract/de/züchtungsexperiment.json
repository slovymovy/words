                "senses": [
                    {
                        "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                        "entry_id": "1e3a3bd5-b00f-3d34-99c8-8c0d444b0ae7",
                        "glosses": [
                            "wissenschaftlicher Versuch, ein Lebewesen mit gewünschten Eigenschaften hervorzubringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a04d0980-c971-4ee3-9768-731b0a7cc5db",
                                "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                                "text": "„Ein besonders langwieriges Züchtungsexperiment startete Anfang der 1970er Jahre in der damaligen DDR.“"
                            },
                            {
                                "example_id": "dc689b48-e564-48fe-892e-4ff975391470",
                                "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                                "text": "„Muhammads rassistische Islam-Version, die den Weißen als Züchtungsexperiment eines verrückten schwarzen Wissenschaftlers identifiziert, beeindruckt Malcolm.“"
                            },
                            {
                                "example_id": "f109ed9f-3a6d-4b57-bbdb-c2940023d98a",
                                "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                                "text": "„Wir benutzen aber beispielsweise auch genetische Marker, um bei Züchtungsexperimenten nachzuvollziehen, ob eine bestimmte Eigenschaft vererbt wurde oder nicht.“"
                            },
                            {
                                "example_id": "67b0a016-7ce8-4b4e-a6e2-bc0e090f95ad",
                                "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                                "text": "„Die beiden Juristen und Bioethiker von der Stanford Law School betonen, dass die Risiken für die Tiere, die aus den Laboren und Züchtungsexperimenten der Forscher hervorgehen, relativ groß sind.“"
                            },
                            {
                                "example_id": "fde9f955-ec0e-47d4-8a96-746b8830f3c9",
                                "sense_id": "d0569994-aec9-3698-b366-d381b07fddc9",
                                "text": "„Lücker hält deswegen nichts von Züchtungsexperimenten wie denen in Indien, auch wenn die Kreuzung zweier Unterarten - was Afrikanische und Asiatische Löwen von der Art Löwe sind - ‚technisch kein Problem ist‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
