                                "target_senses": [
                                    {
                                        "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To cover or adorn with drapery or folds of cloth, or as with drapery."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a196918a-d14f-4f4e-96f3-986b0ddcdb45",
                                                "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                                                "text": "to drape a bust, a building, etc."
                                            },
                                            {
                                                "example_id": "b604aae7-5865-4c09-b5ec-56239fe4a265",
                                                "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                                                "text": "The whole people were still draped professionally."
                                            },
                                            {
                                                "example_id": "79dbd228-a922-4be3-97e1-4ea24e8fcefe",
                                                "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                                                "text": "These starry blossoms, pure and white, / Soft falling, falling, through the night, / Have draped the woods and mere."
                                            },
                                            {
                                                "example_id": "a9249739-0bf0-4773-9205-fc10570410bb",
                                                "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                                                "text": "The pair sat before a brilliant gold Buddha statue inside the ornate temple, built 150 years ago by the former Thai King – the supreme patriarch barefoot and draped in orange robes as they spoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc6ae4b4-e2c2-30a9-8517-889db8b98ddc",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To spread over, cover."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e79c4d-e0e6-42b8-a37f-fa9abf14ff7f",
                                                "sense_id": "cc6ae4b4-e2c2-30a9-8517-889db8b98ddc",
                                                "text": "I draped my towel over the radiator to dry."
                                            },
                                            {
                                                "example_id": "17b82e8c-382b-4b7b-ab9d-172380ce7c1f",
                                                "sense_id": "cc6ae4b4-e2c2-30a9-8517-889db8b98ddc",
                                                "text": "I cycled the three miles each morning between hedges draped with spangled cobwebs and berried bryony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a8ef2d-8eb4-3713-bc06-502c61533804",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To rail at; to banter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6449d9d-3d4a-4e21-9a17-522b52f0f0b5",
                                                "sense_id": "69a8ef2d-8eb4-3713-bc06-502c61533804",
                                                "text": "1672-679, William Temple, Memoirs\nAt my Arrival , the King asked me many questions about my Journey, about the Congress, draping us for spending him so money"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a96f604-c364-35be-bb55-5e6998566a42",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To make cloth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0751672d-9214-316a-b31b-f2ccfe9a4ae4",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To design drapery, arrange its folds, etc., as for hangings, costumes, statues, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0af6d4b8-9da0-3a19-9115-42b376e83ce8",
                                        "entry_id": "1d72573e-cd37-3e49-9596-a84e65c9eede",
                                        "glosses": [
                                            "To hang or rest limply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25aee2fa-17a5-4209-8b15-9cfd17b0064a",
                                                "sense_id": "0af6d4b8-9da0-3a19-9115-42b376e83ce8",
                                                "text": "I draped myself elegantly over the couch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83a8935f-30b6-4331-9624-aef9034f5618",
                        "source_entry_id": "5782ef1b-d967-3049-9c9a-026e062a395b",
                        "source_sense_id": "337b1ea7-f678-3df8-a8c0-3c9ed3c10d04",
                        "target_lang_word": "ornament",
