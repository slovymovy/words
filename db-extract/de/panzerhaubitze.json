                "senses": [
                    {
                        "sense_id": "4f7909c9-eaa7-3988-bec1-9b44da5da8a6",
                        "entry_id": "b163f943-765b-35b7-98b0-95b47e983d02",
                        "glosses": [
                            "Haubitze auf gepanzerter Selbstfahrlafette; gepanzerte, selbstfahrende Haubitze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc435dc-835c-4dd5-89ae-a7e6be7a25b6",
                                "sense_id": "4f7909c9-eaa7-3988-bec1-9b44da5da8a6",
                                "text": "„Eine Panzerhaubitze PzH 2000 von KraussMaffei schießt 30 Kilometer weit mit Standardmunition, 55 Kilometer mit V-LAP-Munition; 20 Schuss in zwei Minuten.“"
                            },
                            {
                                "example_id": "84e760eb-58cd-41dc-b5f5-da8372f5a87f",
                                "sense_id": "4f7909c9-eaa7-3988-bec1-9b44da5da8a6",
                                "text": "„Leichte Waffen lassen sich fast beliebig transportieren. […] Bei schweren Waffen sieht das anders aus[…]. Schützenpanzer, Mannschaftstransporter und Geschütze ohne Selbstfahrlafette lassen sich meist noch mit speziellen Flugzeugen transportieren[…]. Kampfpanzer und Panzerhaubitzen müssen, wenn sie etwa aus den USA in die Ukraine sollen, zunächst auf ein Schiff verladen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
