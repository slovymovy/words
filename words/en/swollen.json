    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be3c13e5-f868-3e2c-980a-0411ea578233",
                    "sense_definition": "Larger or thicker than normal, especially due to injury, illness, or fluid retention.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His ankle was painfully <w>swollen</w> after he tripped during the football game.",
                            "target_lang_translations": {
                                "cs": "Jeho kotník byl po zakopnutí během fotbalového zápasu bolestivě <w>nateklý</w>."
                            }
                        },
                        {
                            "text": "She woke up with a <w>swollen</w> eye after being stung by a bee.",
                            "target_lang_translations": {
                                "cs": "Probudila se s <w>opuchlým</w> okem poté, co ji bodla včela."
                            }
                        }
                    ],
                    "synonyms": [
                        "puffed",
                        "inflated",
                        "distended"
                    ],
                    "common_phrases": [
                        "swollen ankle",
                        "swollen eye",
                        "swollen knee"
                    ],
                    "target_lang_definitions": {
