                                    {
                                        "sense_id": "61a63a11-d4ef-3219-aeb5-22a643ade7af",
                                        "entry_id": "78f8fea0-245d-3c6a-8461-d1bb6cc0594b",
                                        "glosses": [
                                            "The front segment of a body which is divided into two or more segments, especially the cephalothorax of an arachnid or crustacean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c72287-aacf-4694-bb2e-481389d6e792",
                                                "sense_id": "61a63a11-d4ef-3219-aeb5-22a643ade7af",
                                                "text": "The front part, called the cephalothorax (or prosoma), is enclosed within a relatively hard and unyielding chitinous shell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
