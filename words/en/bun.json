                },
                {
                    "sense_id": "2ef62c4f-b9a9-35fc-9996-01c5ff420bc3",
                    "sense_definition": "A buttock.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been doing squats to get tight <w>buns</w> for the summer.",
                            "target_lang_translations": {
                                "ru": "Он делал приседания, чтобы подкачать <w>булки</w> к лету.",
                                "zh": "他一直在做深蹲，为了夏天能有紧致的<w>臀部</w>。"
                            }
                        },
                        {
                            "text": "The athlete showed off his nice <w>buns</w> in the tight cycling shorts.",
                            "target_lang_translations": {
                                "ru": "Атлет продемонстрировал свои отличные <w>ягодицы</w> в облегающих велосипедках.",
                                "zh": "这位运动员穿着紧身骑行裤，展示了他健美的<w>臀部</w>。"
                            }
                        }
