{
    "word_family": [
        "nonchalance",
        "nonchalamment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f56e3be-e3a2-345f-84f0-30bcf3538eb3",
                    "sense_definition": "Qui manque d'ardeur, d'empressement ou de soin dans ce qu'il fait ; qui agit avec mollesse et indifférence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet employé <w>nonchalant</w> remet constamment son travail au lendemain sans se soucier des délais."
                        },
                        {
                            "text": "Le professeur déplore l'attitude <w>nonchalante</w> de plusieurs élèves pendant les révisions."
                        }
                    ],
                    "synonyms": [
                        "indolent",
                        "mou",
                        "apathique"
                    ],
                    "common_phrases": [
                        "attitude nonchalante"
                    ]
                },
                {
                    "sense_id": "a8788a20-2da2-363d-b6d9-9b32b939bead",
                    "sense_definition": "Qui affiche une aisance décontractée, calme et détachée face aux événements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est entré dans la pièce avec un air <w>nonchalant</w>, les mains dans les poches."
                        },
                        {
                            "text": "Malgré la panique générale, elle a répondu d'un ton <w>nonchalant</w> et rassurant."
                        }
                    ],
                    "synonyms": [
                        "désinvolte",
                        "décontracté"
                    ],
                    "common_phrases": [
                        "air nonchalant",
                        "ton nonchalant",
                        "allure nonchalante"
                    ]
                }
            ]
        }
    ]
}