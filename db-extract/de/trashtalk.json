                        "examples": [
                            {
                                "example_id": "7cb80b16-60fd-407f-aa05-270d8d4858a7",
                                "sense_id": "2b4234f9-7ded-3d65-a107-0a83295a5889",
                                "text": "„Bei den Basketballerinnen gibt es kein Freisperren vorm Korb und keinen Trashtalk.“"
                            },
                            {
                                "example_id": "a54f368c-8b76-47ca-b4f1-e7bfd0f326b3",
                                "sense_id": "2b4234f9-7ded-3d65-a107-0a83295a5889",
                                "text": "„Einer der frappierendsten Momente der Fußballgeschichte trug sich im Sommer 2006 im Finale der Weltmeisterschaft in Deutschland zu - als Folge eines Trashtalks, dessen Inhalt erst viel später öffentlich wurde.“"
                            },
                            {
                                "example_id": "e20c54e4-d106-4589-8fb4-fa7eaccb397d",
                                "sense_id": "2b4234f9-7ded-3d65-a107-0a83295a5889",
                                "text": "„Nur Pacquiaos Trainer Freddy Roach ließ sich zum Trashtalk hinreißen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
