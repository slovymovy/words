                "translations": [
                    {
                        "translation_id": "95003b24-f734-4c16-b3fc-ffc7217e61bf",
                        "source_entry_id": "c7a3ae9b-a55e-3191-ae23-bffe93d451ce",
                        "source_sense_id": "16364d23-6f81-3cf7-be17-7a2c3b0595f8",
                        "source_sense_description": "Insektenart",
                        "target_lang_word": "centipede",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centipede",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "Any arthropod of class Chilopoda, which have a segmented body with one pair of legs per segment and from about 20 to 300 legs in total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4374c3fb-5dba-480a-b4ab-17f20ac3ece1",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "Centipedes differ from millipedes by having a single pair of legs on each body segment."
                                            },
                                            {
                                                "example_id": "96686866-bb91-476d-8614-ac4c115e709b",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "The existence of millipedes, centipedes, insects, and spiders along-side the first tetrapods sustained a robust ecosystem in which most animals were predators or scavengers."
                                            },
                                            {
                                                "example_id": "30ad95fa-d7c9-4868-aaff-4d6249ef810a",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "All centipedes (Chilopoda) and spiders (Aranea) are predatory and although they are often found on corpses their impact on the other fauna is not known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfa6b51-06ed-3ac0-951a-91d9272d4b90",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "A many-oared Chinese smuggling boat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80803945-d2af-47ba-921b-3d7cac922541",
                        "source_entry_id": "c7a3ae9b-a55e-3191-ae23-bffe93d451ce",
