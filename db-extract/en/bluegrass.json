                                "target_senses": [
                                    {
                                        "sense_id": "60eba7d2-ad2c-3dc4-8b8e-69b594353781",
                                        "entry_id": "c53ad752-fbe2-3586-9943-665c2381f96d",
                                        "glosses": [
                                            "US-amerikanische Volksmusikrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6e7700-1ecb-4373-b57b-e007ed67b803",
                                                "sense_id": "60eba7d2-ad2c-3dc4-8b8e-69b594353781",
                                                "text": "„Während er so mit Puderzucker von einem Donut am Schnauzbart dem Bluegrass auf dem Mittelwellensender lauscht, wird ihm klar, dass er seit seiner Zeit als Drogenermittler nicht mehr so lange ein Haus beobachtet hat.“"
                                            },
                                            {
                                                "example_id": "1782aacc-0879-4f36-83fe-6ac7f11d3e49",
                                                "sense_id": "60eba7d2-ad2c-3dc4-8b8e-69b594353781",
                                                "text": "„Er stand oben auf der Bühne und hat in der Band Mandoline gespielt. Bluegrass.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
