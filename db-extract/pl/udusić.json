                    },
                    {
                        "sense_id": "01e7d688-6714-3b78-94ad-82679667ffe9",
                        "entry_id": "004bd952-6b74-34a9-866f-599e6695fbd6",
                        "glosses": [
                            "ugotować na małym ogniu pod przykryciem, w niewielkiej ilości wody i tłuszczu"
                        ],
                        "tags": [],
