                "senses": [
                    {
                        "sense_id": "b2188f74-5d54-3bc3-a105-9510b5982b78",
                        "entry_id": "79c836ea-3611-32ae-8481-2903178b4900",
                        "glosses": [
                            "Donner un caractère musculaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88ba39c-e9cd-4669-8b23-7b080828b56c",
                                "sense_id": "b2188f74-5d54-3bc3-a105-9510b5982b78",
                                "text": "En effet, les cellules murales ainsi recrutées vont musculariser le réseau endothélial naissant en migrant le long du vaisseau et ainsi favorisent le remodelage."
                            },
                            {
                                "example_id": "32a3e2e3-6759-4cf8-b3e9-480ed47f02f3",
                                "sense_id": "b2188f74-5d54-3bc3-a105-9510b5982b78",
                                "text": "Il se forme à partir de quatre structures qui vont constituer le diaphragme primitif, puis il va se musculariser et migrer pour atteindre sa position définitive."
                            }
                        ]
                    }
