                "senses": [
                    {
                        "sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                        "entry_id": "bb225bb0-f61f-3746-b2cb-849e89c00565",
                        "glosses": [
                            "het inspreken van moed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd89315-ea1e-4fcd-9a41-99195924c74b",
                                "sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                                "text": "Gelukkig kreeg de neergevallen bokser een aanmoediging van de kant en ging het daarna beter."
                            },
                            {
                                "example_id": "ddbb17c9-6e84-4f36-ad62-6339f9123e1f",
                                "sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                                "text": "Om zijn woorden kracht bij te zetten, stak hij zijn rechterduim op. Hun zoon had echter geen oog voor deze aanmoediging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ba19300-446e-44d9-824e-c9852e5d40c0",
                        "source_entry_id": "bb225bb0-f61f-3746-b2cb-849e89c00565",
                        "source_sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                        "source_sense_description": "het inspreken van moed",
                        "target_lang_word": "Ermutigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ermutigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                                        "entry_id": "e81b01cb-4ada-3ed1-8f04-e45703d1ae9b",
                                        "glosses": [
                                            "Versuch, jemandem mehr Freude, Mut zu geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb34a50-4a7d-422a-aa94-b3ba97a72496",
                                                "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                                                "text": "„Alle Erziehung beginnt mit der Ermutigung des Menschen zu sich selbst.“"
                                            },
                                            {
                                                "example_id": "d53c9a65-b75b-4e5b-b0a3-5d1f9ddcf8af",
                                                "sense_id": "b5c3513f-04a5-3aa8-a633-a4d025bc93c2",
                                                "text": "„Auch die ‚aktive Hilfe zur Problembewältigung‘ ist eng verbunden mit der Ermutigung des/der Patienten/Patientin, vorhandene (konkrete) Probleme neu zu betrachten/zu analysieren, nach neuen Lösungen zu suchen und diese zu erproben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7ef320-173f-491b-b72a-b856655cf55b",
                        "source_entry_id": "bb225bb0-f61f-3746-b2cb-849e89c00565",
                        "source_sense_id": "7d5c68df-be1d-3a8e-83fc-5dd4ff33f8b9",
                        "source_sense_description": "het inspreken van moed",
