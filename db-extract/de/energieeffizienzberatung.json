                "senses": [
                    {
                        "sense_id": "a467843f-b96c-37ee-bb93-4d888b3fa689",
                        "entry_id": "1a70e19a-bbb5-38f1-a850-c6dfc54439a0",
                        "glosses": [
                            "fachkompetente Auskunft einer Person oder Organisation für eine andere Person oder Organisation zur Wirtschaftlichkeit im Bezug auf Energie und deren Einsparung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833c915f-5d4d-4a09-b42b-a410eeefd2b2",
                                "sense_id": "a467843f-b96c-37ee-bb93-4d888b3fa689",
                                "text": "„Gleichwohl wird empfohlen, vor Durchführung einer Energieeinsparinvestition eine Energieeffizienzberatung in Anspruch zu nehmen.“"
                            },
                            {
                                "example_id": "acc3f908-c849-4e0b-97be-f8751171094a",
                                "sense_id": "a467843f-b96c-37ee-bb93-4d888b3fa689",
                                "text": "„Dies sind: Die Energieeffizienzberatung, die Umstellung auf Ökostrom sowie der freiwillige CO2-Emissionsausgleich verbunden mit einem Beitrag zur globalen Aufforstung.“"
                            },
                            {
                                "example_id": "36ee4d4d-de39-4844-97ef-44170d1c257a",
                                "sense_id": "a467843f-b96c-37ee-bb93-4d888b3fa689",
                                "text": "„Bei der Energieeffizienzberatung für Unternehmen liegt das Augenmerk vorrangig in der Anlagentechnik und weniger stark auf der Gebäudehülle.“"
                            },
                            {
                                "example_id": "5cad8618-401a-4b4d-ba6a-c85451f690a3",
                                "sense_id": "a467843f-b96c-37ee-bb93-4d888b3fa689",
                                "text": "Die Energieeffizienzberatung können kleine und mittlere Unternehmen sowie Freiberufler in Anspruch nehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
