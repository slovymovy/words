                                        "glosses": [
                                            "de gran volumen, referido al tamaño."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57fb71e-27bd-4211-92da-8643b4468d73",
                                                "sense_id": "55709fb6-4f63-317c-b538-05b16b171bda",
                                                "text": "El voluminoso vientre del procurador sobresalía por debajo de la coraza, proporcionándole un perfil muy poco caballeresco."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
