                    "sense_id": "4ef33a07-8839-3f02-997b-d2aa0debadcf",
                    "sense_definition": "Женщина по отношению к своим детям.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "biological_parent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя <мать> работает учителем в школе.",
                            "target_lang_translations": {
                                "en": "My <mother> works as a teacher at school.",
                                "nl": "Mijn <moeder> werkt als lerares op een school.",
                                "zh": "我的<w>母亲</w>在学校当老师。",
                                "pl": "Moja <matka> pracuje jako nauczycielka w szkole.",
                                "de": "Meine <w>Mutter</w> arbeitet als Lehrerin an einer Schule.",
                                "fr": "Ma <mère> travaille comme enseignante dans une école.",
                                "it": "Mia <madre> lavora come insegnante a scuola.",
                                "cs": "Moje <matka> pracuje jako učitelka ve škole.",
                                "tr": "<w>Annem</w> okulda öğretmen olarak çalışıyor.",
                                "es": "Mi <madre> trabaja como profesora en la escuela."
                            }
                        },
                        {
                            "text": "Ребёнок крепко держал <мать> за руку.",
                            "target_lang_translations": {
                                "en": "The child held his <mother> tightly by the hand.",
                                "nl": "Het kind hield zijn <moeder> stevig bij de hand.",
                                "zh": "孩子紧紧地拉着<w>妈妈</w>的手。",
                                "pl": "Dziecko mocno trzymało <matkę> za rękę.",
                                "de": "Das Kind hielt seine <w>Mutter</w> fest an der Hand.",
                                "fr": "L'enfant tenait fermement sa <mère> par la main.",
                                "it": "Il bambino teneva stretta la <madre> per mano.",
                                "cs": "Dítě drželo <matku> pevně za ruku.",
                                "tr": "Çocuk, <w>annesinin</w> elini sıkıca tutuyordu.",
                                "es": "El niño sostenía fuertemente a su <madre> de la mano."
                            }
                        },
                        {
                            "text": "Она стала <матерью> в двадцать пять лет.",
                            "target_lang_translations": {
                                "en": "She became a <mother> at twenty-five.",
                                "nl": "Ze werd <moeder> op haar vijfentwintigste.",
                                "zh": "她在二十五岁时当了<w>母亲</w>。",
                                "pl": "Została <matką> w wieku dwudziestu pięciu lat.",
                                "de": "Sie wurde mit fünfundzwanzig Jahren <w>Mutter</w>.",
                                "fr": "Elle est devenue <mère> à vingt-cinq ans.",
                                "it": "È diventata <madre> a venticinque anni.",
                                "cs": "Stala se <matkou> v pětadvaceti letech.",
                                "tr": "Yirmi beş yaşında <w>anne</w> oldu.",
                                "es": "Ella se convirtió en <madre> a los veinticinco años."
                            }
                        }
                    ],
