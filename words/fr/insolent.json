                            {
                                "target_lang_word": "放肆",
                                "target_lang_sense_clarification": "不顾礼节，言行随意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90670f0d-b68b-3345-8533-7dc6bfdbc989",
                    "sense_definition": "Qui est remarquable et exceptionnel au point de paraître excessif ou provocant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune joueur de tennis affiche une réussite <w>insolente</w> depuis le début du tournoi.",
                            "target_lang_translations": {
                                "en": "This young tennis player has been putting together an <w>extraordinary</w> run of success since the start of the tournament.",
                                "ru": "Этот молодой теннисист с начала турнира демонстрирует <w>феноменальный</w> успех.",
                                "de": "Seit Turnierbeginn spielt dieser junge Tennisspieler <w>unverschämt</w> erfolgreich.",
                                "es": "Este joven tenista encadena una racha <w>descarada</w> de éxitos desde el inicio del torneo.",
                                "zh": "这位年轻的网球选手从比赛开始以来，一直取得<w>惊人</w>的战绩。"
                            }
                        },
                        {
                            "text": "Elle a une chance <w>insolente</w> à chaque fois qu'elle participe à cette loterie.",
                            "target_lang_translations": {
                                "en": "She has <w>outrageous</w> luck every time she enters this lottery.",
                                "ru": "У неё <w>баснословная</w> удача каждый раз, когда она участвует в этой лотерее.",
                                "de": "Sie hat jedes Mal <w>unverschämtes</w> Glück, wenn sie bei dieser Lotterie mitmacht.",
                                "es": "Tiene una suerte <w>descarada</w> cada vez que participa en esta lotería.",
                                "zh": "她每次参加这个彩票，运气都好得<w>离谱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incroyable",
                        "extraordinaire"
                    ],
                    "common_phrases": [
                        "chance insolente",
                        "santé insolente",
                        "succès insolent",
                        "bonheur insolent"
                    ],
                    "target_lang_definitions": {
                        "en": "Remarkable to the point of seeming excessive or provocative.",
                        "ru": "Настолько выдающийся и необычный, что кажется чрезмерным или вызывающим.",
                        "de": "So außergewöhnlich gut, dass es fast übertrieben oder provozierend wirkt.",
                        "es": "Extraordinario hasta el punto de parecer excesivo o provocador.",
                        "zh": "出色得超出常理，甚至显得过分而招人侧目。"
                    },
                    "translations": {
