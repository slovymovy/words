                    "sense_id": "69e9e765-faeb-3924-8efa-8c8451308561",
                    "sense_definition": "A small island.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat sailed past a tiny <w>islet</w> covered in green trees.",
                            "target_lang_translations": {
                                "ru": "Лодка проплыла мимо крошечного <w>островка</w>, покрытого зелёными деревьями."
                            }
                        },
                        {
                            "text": "Many birds nest on the rocky <w>islet</w> during the summer months.",
                            "target_lang_translations": {
                                "ru": "Многие птицы гнездятся на скалистом <w>островке</w> в летние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "eyot",
                        "holm"
                    ],
                    "common_phrases": [
                        "rocky islet",
                        "tiny islet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой остров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острово́к",
                                "target_lang_sense_clarification": "небольшой участок суши, окруженный водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cec8fe82-12d8-39d6-aa40-c00001d1133e",
                    "sense_definition": "An isolated piece of tissue that has a specific function.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>islet</w> cells in the pancreas are responsible for producing insulin.",
                            "target_lang_translations": {
                                "ru": "Клетки <w>островков</w> поджелудочной железы отвечают за выработку инсулина."
                            }
                        },
                        {
                            "text": "Researchers are studying how to protect the pancreatic <w>islet</w> from damage.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают, как защитить панкреатический <w>островок</w> от повреждений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pancreatic islet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изолированная группа клеток в организме, выполняющая специфическую функцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острово́к",
                                "target_lang_sense_clarification": "в биологии, например, панкреатические островки (островки Лангерганса)"
                            }
                        ]
                    }
                }
            ]
        }
