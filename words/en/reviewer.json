{
    "word_family": [
        "review",
        "reviewable",
        "reviewal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "895bdecb-bc76-3e52-92c2-32e9874e4d6d",
                    "sense_definition": "A person who evaluates and writes opinions about artistic works such as movies, books, or games.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "critic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie <w>reviewer</w> gave the new action film a very positive rating.",
                            "target_lang_translations": {
                                "ru": "Кино<w>рецензент</w> поставил новому боевику очень высокую оценку."
                            }
                        },
                        {
                            "text": "She works as a professional book <w>reviewer</w> for a popular lifestyle magazine.",
                            "target_lang_translations": {
                                "ru": "Она работает профессиональным книжным <w>обозревателем</w> в популярном журнале о стиле жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "critic"
                    ],
                    "common_phrases": [
                        "book reviewer",
                        "movie reviewer",
                        "game reviewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который оценивает и пишет отзывы о произведениях искусства, таких как фильмы, книги или игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецензент",
                                "target_lang_sense_clarification": "автор рецензии на произведение"
                            },
                            {
                                "target_lang_word": "критик",
                                "target_lang_sense_clarification": "профессиональный обозреватель"
                            },
                            {
                                "target_lang_word": "обозреватель",
                                "target_lang_sense_clarification": "ведущий рубрики с обзорами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4b8e9f0-6509-3731-b6b0-a67bd5c777b0",
                    "sense_definition": "A person who writes formal evaluations for newspapers, academic journals, or other professional publications.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "critic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reviewer</w> pointed out several factual errors in the historical biography.",
                            "target_lang_translations": {
                                "ru": "<w>Рецензент</w> указал на несколько фактических ошибок в исторической биографии."
                            }
                        },
                        {
                            "text": "An anonymous peer <w>reviewer</w> suggested that the scientist should provide more data.",
                            "target_lang_translations": {
                                "ru": "Анонимный научный <w>рецензент</w> предложил ученому предоставить больше данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "critic"
                    ],
                    "common_phrases": [
                        "peer reviewer",
                        "editorial reviewer",
                        "journal reviewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, составляющий официальные отзывы для газет, научных журналов или других профессиональных изданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецензент",
                                "target_lang_sense_clarification": "специалист, дающий отзыв на работу"
                            },
                            {
                                "target_lang_word": "эксперт",
                                "target_lang_sense_clarification": "лицо, проводящее экспертизу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80a91ef3-4e98-3387-a54e-4d045835a893",
                    "sense_definition": "A comprehensive study guide or material used to prepare for an examination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "study_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the whole weekend reading my exam <w>reviewer</w> to prepare for the finals.",
                            "target_lang_translations": {
                                "ru": "Я провел все выходные за чтением своего <w>пособия</w> для подготовки к экзаменам, чтобы подготовиться к финалам."
                            }
                        },
                        {
                            "text": "The teacher distributed a math <w>reviewer</w> containing all the formulas we need to know.",
                            "target_lang_translations": {
                                "ru": "Учитель раздал <w>материалы для повторения</w> по математике, содержащие все необходимые формулы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exam reviewer",
                        "board reviewer",
                        "study reviewer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Philippine English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комплексное учебное пособие или материал, используемый для подготовки к экзамену."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пособие для подготовки",
                                "target_lang_sense_clarification": "учебный материал"
                            },
                            {
                                "target_lang_word": "сборник для повторения",
                                "target_lang_sense_clarification": "материалы для подготовки к тестам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dc20672-f8f7-3391-af6f-6a4ea523e12d",
                    "sense_definition": "An official or inspector who examines a process, site, or document to ensure compliance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inspector",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>reviewer</w> visited the factory to check if safety standards were met.",
                            "target_lang_translations": {
                                "ru": "Государственный <w>инспектор</w> посетил завод, чтобы проверить соблюдение стандартов безопасности."
                            }
                        },
                        {
                            "text": "A compliance <w>reviewer</w> must sign off on the project before it can proceed.",
                            "target_lang_translations": {
                                "ru": "<w>Контролер</w> по нормативно-правовому соответствию должен утвердить проект, прежде чем он будет запущен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compliance reviewer",
                        "site reviewer",
                        "technical reviewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо или инспектор, проверяющий процесс, объект или документ на соответствие нормам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инспектор",
                                "target_lang_sense_clarification": "проверяющий соблюдение правил"
                            },
                            {
                                "target_lang_word": "контролер",
                                "target_lang_sense_clarification": "лицо, осуществляющее надзор"
                            },
                            {
                                "target_lang_word": "проверяющий",
                                "target_lang_sense_clarification": "лицо, проводящее проверку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}