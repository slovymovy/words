                    }
                ],
                "senses": [
                    {
                        "sense_id": "97bd8fc9-2e1f-3029-94c1-05f9d366337d",
                        "entry_id": "10f00dc0-0ddf-3aef-bb39-9ea5afc66a4a",
                        "glosses": [
