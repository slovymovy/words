                ],
                "senses": [
                    {
                        "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                        "entry_id": "40caa68d-581e-3b16-94c3-2766216f8dc4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5328f77-2d24-44e7-882c-36362f89e8d8",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Frau Wölfle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "88285dc4-e6fd-4823-b27d-f5bce57994ad",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Herr Wölfle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "726822d1-80c3-4643-aaf8-873d104f102b",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Die Wölfles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3063497e-f9ec-4266-a9a6-af46c3528936",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Der Wölfle trägt nie die Pullover, die die Wölfle ihm strickt."
                            },
                            {
                                "example_id": "2018b499-9eeb-4cc7-8933-872f6bd9b1d4",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wölfle kommt, geht der Herr Wölfle.“"
                            },
                            {
                                "example_id": "2de8b83f-0d9b-4d98-9792-d697d00f8f05",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Wölfle kommt und geht."
                            },
                            {
                                "example_id": "1cde97c5-9d09-4670-b1bf-766817b88293",
                                "sense_id": "0ea6fdc7-d748-37fe-9650-ff42d9c538ee",
                                "text": "Wölfles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
