                    {
                        "sense_id": "731487d8-922d-3e8d-b816-7af594746b9f",
                        "entry_id": "12b1cdba-9908-3a66-9dfb-14278ea7e80a",
                        "glosses": [
                            "A partition in a coal mine, made from wood or from canvas sheeting coated in tar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0bf557-3920-403c-9518-7f95d91c53f5",
                                "sense_id": "731487d8-922d-3e8d-b816-7af594746b9f",
                                "text": "A practice then prevailed of blasting without nicking the side of the place which still continues and of conducting the current of air too far by means of brattice, to both of which practices I raised a strong objection. They admitted their inability to make the men nick the coal as they formerly did and thought the application of brattice could not be properly defined, but that it should be left to the discretion of the manager of each particular mine as to the distance openings should be made apart between the intake and return air courses."
                            }
                        ]
                    },
                    {
                        "sense_id": "186c04ed-0a28-3253-8877-b19f5f9bb6b2",
                        "entry_id": "12b1cdba-9908-3a66-9dfb-14278ea7e80a",
                        "glosses": [
                            "A wooden structure used for attack or defence, such as an archery tower, or a penthouse built over the entry to a castle for archers to shoot from."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c08cff88-1c0e-4775-8579-9f4d769839e3",
                                "sense_id": "186c04ed-0a28-3253-8877-b19f5f9bb6b2",
                                "text": "[…] When a breach was made in the castle wall, a brattice could be built within to serve as a new temporary defence."
                            }
                        ]
                    }
                ],
