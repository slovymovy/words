                                "target_senses": [
                                    {
                                        "sense_id": "8811dd0d-bcf1-35c1-9beb-fbb7830ac561",
                                        "entry_id": "339ced8e-dca6-38d3-9a74-3ed37da9a61f",
                                        "glosses": [
                                            "Human conduct relative to social norms."
