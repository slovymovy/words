                "senses": [
                    {
                        "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                        "glosses": [
                            "begeisternder, ansteckender Schwung; Besonderheit, durch die etwas interessant und aufregend wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fddbfb-a551-4b06-9168-4f2c900ab543",
                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                "text": "Das Musical war so fad, es hatte überhaupt keinen Pep."
                            },
                            {
                                "example_id": "0a1a5655-c6f1-41f8-af7c-d1c82a93f5e0",
                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                "text": "„Wer 20000 Euro mit etwas mehr Pep anlegen will, kommt an der Börse nicht vorbei.“"
                            },
                            {
                                "example_id": "5db9d3b6-0a19-44c6-b4ef-b8aa6324c566",
                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                "text": "„Da gehört Pep in die Sache!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                        "glosses": [
                            "synthetisch hergestelltes Mittel, das das zentrale Nervensystem anregt und das als Droge verwendet wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "db57a3bf-7a3d-4bf2-ba6a-294a01801692",
                                "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                                "text": "„Pep ist das neue Ecstasy.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00ead694-16b1-466c-9c16-b7258aed11c5",
                        "source_entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                        "source_sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                        "source_sense_description": "begeisternder, ansteckender Schwung; Besonderheit, durch die etwas interessant und aufregend wird",
                        "target_lang_word": "pep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "840b834c-fb02-379b-8007-d5d49f38424b",
                                        "entry_id": "bf6d471e-6da5-33df-bd23-a906e7fa00e5",
                                        "glosses": [
                                            "To inject with energy and enthusiasm."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b3643eb-8f4e-4369-8b9f-0219e19be4ef",
                                                "sense_id": "840b834c-fb02-379b-8007-d5d49f38424b",
                                                "text": "At least a couple of weeks since I last slept,\nKept takin' sleepers, but now I keep myself pepped."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d975191c-1039-3f55-bfb0-d6f31cd46d2e",
                                        "entry_id": "d2c11ad0-e4ae-33af-8411-6f6e949454e5",
                                        "glosses": [
                                            "Energy, high spirits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b824f55a-4bb2-42c8-aab8-047ed174aed4",
                                                "sense_id": "d975191c-1039-3f55-bfb0-d6f31cd46d2e",
                                                "text": "She was particularly pleased with the wine, which at not infrequent intervals she tasted. Beyond all doubt it promised to be of vintage quality. Clearly the long hot summer had put more than a little pep into the berries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
