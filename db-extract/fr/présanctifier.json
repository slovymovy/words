                        "glosses": [
                            "Préparer à la sainteté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127b39e2-ae53-4a99-bc0b-cc2172771299",
                                "sense_id": "db27b45a-c8b0-356f-aa59-963fd8223056",
                                "text": "Les hommes sont toujours devant Dieu comme de tout petits ; il faut eux aussi les éduquer, les préparer, les présanctifier."
                            }
                        ]
                    },
                    {
                        "sense_id": "daef39e7-166e-3df4-ace4-0091a7ebbc2e",
                        "entry_id": "2082a3b4-c3d8-3ffa-964d-b714b36f2942",
                        "glosses": [
                            "Considérer d'avance comme saint."
                        ],
                        "tags": [],
                        "examples": [
