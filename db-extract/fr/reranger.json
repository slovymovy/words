                            {
                                "example_id": "4c049a88-e9a4-4041-9eea-e93ebaae986b",
                                "sense_id": "5ce78943-68cf-30d1-917e-f75f43001ad6",
                                "text": "N’ai-je pas un aspirateur tout neuf avec une flopée de bidules adaptables pour gober même les poussières invisibles. Je ferai un effort tant pis si extraire l’engin du placard, monter, changer les bidules, reranger, bouffe trois plus de temps qu’un coup de balai."
                            },
                            {
                                "example_id": "1db09e4c-0bf3-4dbd-ab00-cabcd8652c78",
                                "sense_id": "5ce78943-68cf-30d1-917e-f75f43001ad6",
                                "text": "Dommage que l'on ne puisse pas reranger le matériel dans la boite en fin de partie !"
                            }
                        ]
                    }
