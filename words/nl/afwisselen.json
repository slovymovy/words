                    "frequency": "Low",
                    "semantic_group_id": "alterneren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze kan de twee setjes kleding met elkaar <w>afwisselen</w>.",
                            "target_lang_translations": {
                                "en": "She can <w>alternate</w> between the two sets of clothes."
                            }
                        },
                        {
                            "text": "Je kunt deze twee boeken tijdens de vakantie <w>afwisselen</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>alternate</w> between these two books during the vacation."
                            }
                        }
                    ],
                    "target_lang_definitions": {
