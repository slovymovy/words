                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "385dc4e7-79d3-41bb-bb00-27ab3805b287",
                        "entry_id": "ad553975-a37a-3921-8e53-6c11db52b5ef",
                        "tags": [
                            "plural"
