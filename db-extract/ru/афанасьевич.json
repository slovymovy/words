                        "sense_id": "11fd7d64-29f5-3fa8-9f81-2261e55c2b0d",
                        "entry_id": "d2b4a844-2253-353f-82cc-809fde0a3037",
                        "glosses": [
                            "мужское отчество от имени Афанасий"
