                        "sense_id": "db2b7bca-d021-3236-895d-51edd150d58d",
                        "entry_id": "d6752f6d-e843-3cbd-ac50-49ce51adc74b",
                        "glosses": [
                            "met behulp van een kam achterwaarts kammen van haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7486552-006e-4db5-ae91-8a00ef5f4d6f",
                                "sense_id": "db2b7bca-d021-3236-895d-51edd150d58d",
                                "text": "Zijn haar was donker van de Brylcreem en strak achterovergekamd."
                            },
                            {
                                "example_id": "3c574bb8-05ea-4912-b48d-ae4883a41bcd",
                                "sense_id": "db2b7bca-d021-3236-895d-51edd150d58d",
                                "text": "De onbekende vrouw heeft een lengte van ongeveer 1.60m en een gezet postuur. Ze had achterovergekamd donker kort haar en sprak gebrekkig Nederlands. De vrouw droeg een donkere korte lederen jas. De politie waarschuwt vooral oudere burgers niet in te gaan op smoezen."
                            }
                        ]
                    }
