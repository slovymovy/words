                "senses": [
                    {
                        "sense_id": "5867bf8f-427d-3b64-aba6-056546a8c54d",
                        "entry_id": "39f2871c-b095-37af-95d6-bd8d2caa79f9",
                        "glosses": [
                            "ein vergeblicher Gang"
                        ],
                        "tags": [
                            "bildlich"
                        ],
                        "examples": [
                            {
                                "example_id": "0cd650f1-4403-4535-9ab2-e3762b8049c7",
                                "sense_id": "5867bf8f-427d-3b64-aba6-056546a8c54d",
                                "text": "„Bei all diesen negativen Eigenschaften ist es nicht verwunderlich, daß mit dem Wort Phrasen über Versagen, Mißlingen oder ungenügendes Resultat entstanden sind, wie ‚im Schneider sein‘ für keine 30 Punkte erzielt oder Jahre erreicht haben, bei den Jägern nichts erbeutet haben, einen ‚Schneidergang‘ gemacht haben, d.h. ohne Erfolg zurückkehren, obwohl Metzgergang und ‚Fleischergang‘ üblicher sind, beide von Adelung gebucht.“"
                            },
                            {
                                "example_id": "cf1236c1-d7ce-4717-880f-be077a152a24",
                                "sense_id": "5867bf8f-427d-3b64-aba6-056546a8c54d",
                                "text": "Metzgergang, ein vergeblicher Weg, weil die Fleischer oft nach einem Kalb über Land gehen, welches ihnen ein andrer schon weggekauft hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b48c25ea-97ba-31a2-bf3d-dc4e36481041",
                        "entry_id": "39f2871c-b095-37af-95d6-bd8d2caa79f9",
                        "glosses": [
                            "ein fruchtloses Bemühen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6c347f9b-0782-42a2-ab46-b17c2646206b",
                                "sense_id": "b48c25ea-97ba-31a2-bf3d-dc4e36481041",
                                "text": "„Haben Sie - vielleicht in einer Lohgrube Münzen gefunden?“ „Nein,“ sagte er lachend und schüttelte den Kopf - „Dann haben Sie einen „Metzgergang“ gemacht,“ meinte die Alte mitleidig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cabcc88-4f0c-4c8b-b133-b77e8e353f22",
                        "source_entry_id": "39f2871c-b095-37af-95d6-bd8d2caa79f9",
                        "source_sense_id": "5867bf8f-427d-3b64-aba6-056546a8c54d",
                        "source_sense_description": "bildlich: ein vergeblicher Gang",
                        "target_lang_word": "fool's errand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fool's errand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b067e7-bdf3-3a37-b949-44a3a6e75428",
                                        "entry_id": "407b71c9-8c10-30c1-8bac-dca004ab8217",
                                        "glosses": [
                                            "A foolish undertaking, especially one that is purposeless, fruitless, nonsensical, or certain to fail."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af1c14f8-d7cc-4715-a090-5377c990e5a9",
                                                "sense_id": "41b067e7-bdf3-3a37-b949-44a3a6e75428",
                                                "text": "If I were to travel only that I might be discontented with that which I can get at home, methinks I should go but on a fool's errand."
                                            },
                                            {
                                                "example_id": "db700315-c5d9-4266-97f2-36f0f1dfaf2d",
                                                "sense_id": "41b067e7-bdf3-3a37-b949-44a3a6e75428",
                                                "text": "Shultz took little notice of the Soviet view or that of others who said his Middle East mission was a fool's errand. \"You can't be too afraid of failing,\" said the 67-year-old diplomat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e7eb5f-781b-3a8d-aa47-64e1f71cf75a",
                                        "entry_id": "407b71c9-8c10-30c1-8bac-dca004ab8217",
                                        "glosses": [
                                            "Such an undertaking, assigned as a prank."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc1ea87-8b5f-4ac8-bd7b-d6946c8c23d8",
                                                "sense_id": "28e7eb5f-781b-3a8d-aa47-64e1f71cf75a",
                                                "text": "Meronyms: blinker fluid, key to the midway, left-handed monkey wrench, muffler bearing, skyhook"
                                            },
                                            {
                                                "example_id": "12423ccc-45dc-468f-9adb-2ddd6ac13e60",
                                                "sense_id": "28e7eb5f-781b-3a8d-aa47-64e1f71cf75a",
                                                "text": "Near-synonym: wild-goose chase"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
