                "senses": [
                    {
                        "sense_id": "dc9c2102-0f0d-3030-afa2-d2ad2b39199f",
                        "entry_id": "4e735b0a-ec91-30b2-9419-2214e7e5b9cb",
                        "glosses": [
                            "Fahrt, die der Beförderung von Holz dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341d0af0-500d-4cfb-bb12-e6e51f5dc81f",
                                "sense_id": "dc9c2102-0f0d-3030-afa2-d2ad2b39199f",
                                "text": "„Bei einer Holzfuhre hatte sich Robert den linken Daumen verstaucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19b7cdd9-4fa7-368e-a722-0e72f2a0847e",
                        "entry_id": "4e735b0a-ec91-30b2-9419-2214e7e5b9cb",
                        "glosses": [
                            "Ladung Holz auf einem dieses befördernden Fahrzeug beziehungsweise das mit Holz beladene Fahrzeug selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafe8688-89cd-47e9-8e12-bd0508a31117",
                                "sense_id": "19b7cdd9-4fa7-368e-a722-0e72f2a0847e",
                                "text": "„Es war eine kleine Brücke, nur eben groß genug, daß von den hin- und herfahrenden Holzfuhren jeweils eine hinüberkonnte.“"
                            },
                            {
                                "example_id": "93f5ff18-e973-4351-b77f-af67b4387ac5",
                                "sense_id": "19b7cdd9-4fa7-368e-a722-0e72f2a0847e",
                                "text": "„Nur manchmal kommt noch langsam eine Holzfuhre krachend daher oder auch ein schnelles Bernerwägelein […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
