{
    "word_family": [
        "firmowy",
        "firmować"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89fbaebd-cffa-32a6-9809-3ba29873c6a8",
                    "sense_definition": "jednostka gospodarcza prowadząca działalność zarobkową",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "biznes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój wujek otworzył niedawno kolejną <w>firmę</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дядя недавно открыл еще одну <w>фирму</w>."
                            }
                        },
                        {
                            "text": "Wiele osób szuka pracy w dużej <w>firmie</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди ищут работу в большой <w>фирме</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedsiębiorstwo"
                    ],
                    "common_phrases": [
                        "właściciel firmy",
                        "pracować w firmie"
                    ],
                    "target_lang_definitions": {
                        "ru": "хозяйственное, промышленное или торговое предприятие, занимающееся коммерческой деятельностью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фирма",
                                "target_lang_sense_clarification": "общее название коммерческой организации"
                            },
                            {
                                "target_lang_word": "предприятие",
                                "target_lang_sense_clarification": "более формальный термин для хозяйственной единицы"
                            },
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "синоним фирмы, часто используется для крупных организаций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc14e52-a556-3765-bad8-ce7063aecc03",
                    "sense_definition": "podmiot prawny prowadzący działalność gospodarczą",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biznes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta <w>firma</w> została zarejestrowana w sądzie rejestrowym.",
                            "target_lang_translations": {
                                "ru": "Эта <w>компания</w> была зарегистрирована в регистрационном суде."
                            }
                        },
                        {
                            "text": "Zarząd podjął decyzję o przekształceniu <w>firmy</w> w spółkę akcyjną.",
                            "target_lang_translations": {
                                "ru": "Правление приняло решение о преобразовании <w>компании</w> в акционерное общество."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedsiębiorstwo"
                    ],
                    "common_phrases": [
                        "rejestracja firmy"
                    ],
                    "target_lang_definitions": {
                        "ru": "юридическое лицо, осуществляющее предпринимательскую деятельность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юридическое лицо",
                                "target_lang_sense_clarification": "правовой статус организации"
                            },
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "организация как субъект права"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6cf1f01-0e37-35ce-817c-d89f69789208",
                    "sense_definition": "oficjalna nazwa, pod którą przedsiębiorca prowadzi działalność",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biznes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Firmą</w> jest imię i nazwisko osoby fizycznej lub nazwa osoby prawnej.",
                            "target_lang_translations": {
                                "ru": "<w>Фирменным наименованием</w> является имя и фамилия физического лица или название юридического лица."
                            }
                        },
                        {
                            "text": "W umowie należy podać pełną <w>firmę</w> kontrahenta.",
                            "target_lang_translations": {
                                "ru": "В договоре необходимо указать полное <w>фирменное наименование</w> контрагента."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "официальное наименование, под которым предприниматель или организация ведут свою деятельность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фирменное наименование",
                                "target_lang_sense_clarification": "юридический термин для названия компании"
                            },
                            {
                                "target_lang_word": "название",
                                "target_lang_sense_clarification": "общее обозначение имени организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29172233-91a6-3ca2-a29b-2227242edcbb",
                    "sense_definition": "dobra opinia lub renoma",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reputacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dbał o dobrą <w>firmę</w> swojego nazwiska w środowisku naukowym.",
                            "target_lang_translations": {
                                "ru": "Он заботился о <w>добром имени</w> своей фамилии в научной среде."
                            }
                        },
                        {
                            "text": "Przez lata pracy zyskał sobie nienaganną <w>firmę</w>.",
                            "target_lang_translations": {
                                "ru": "За годы работы он заслужил безупречную <w>репутацию</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "użycie w znaczeniu reputacji jest przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "хорошая репутация или доброе имя (устаревшее значение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репутация",
                                "target_lang_sense_clarification": "общественное мнение о ком-либо или чем-либо"
                            },
                            {
                                "target_lang_word": "доброе имя",
                                "target_lang_sense_clarification": "положительная характеристика личности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
