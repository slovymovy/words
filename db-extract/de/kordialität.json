                "senses": [
                    {
                        "sense_id": "9c9f5a4b-aa5e-36ec-9e61-587390aa2eb6",
                        "entry_id": "9bfc7b00-55ef-356f-9cfe-8207d682d4eb",
                        "glosses": [
                            "Herzlichkeit, Freundlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad657ac-2b70-4310-838f-5b94dc7ad824",
                                "sense_id": "9c9f5a4b-aa5e-36ec-9e61-587390aa2eb6",
                                "text": "Baron Erichsen folgte mit einem Gesichtsausdruck, der die voraufgegangenen Kordialitäten mit der Wirtin zu mißbilligen schien, trotzdem er sie als Pentzsche Verkehrsform genugsam kannte. (1919)"
                            },
                            {
                                "example_id": "58644d68-760a-4d09-8d33-e40efaba8a5a",
                                "sense_id": "9c9f5a4b-aa5e-36ec-9e61-587390aa2eb6",
                                "text": "„Jetzt kam er mir, als wir zur festgesetzten Stunde eintraten, mit einem Glas Champagner in der Hand entgegen und begrüßte mich mit einer so ungezwungenen, großmütigen Kordialität, daß der Bann ehrfürchtiger Beklommenheit, mit der wir gekommen waren, sich sofort verflüchtigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c11a1d8e-b07c-4dc3-b8bd-8bd31e26a38b",
                        "source_entry_id": "9bfc7b00-55ef-356f-9cfe-8207d682d4eb",
                        "source_sense_id": "9c9f5a4b-aa5e-36ec-9e61-587390aa2eb6",
                        "source_sense_description": "Herzlichkeit, Freundlichkeit",
                        "target_lang_word": "cordiality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordiality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                        "entry_id": "9aaf0e43-fe1a-3961-8ba3-b6ddd4913d78",
                                        "glosses": [
                                            "The quality of being cordial."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79493a29-74d4-469e-acdb-8a8073ac362f",
                                                "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                                "text": "Upon my entrance, Usher rose from a sofa on which he had been lying at full length, and greeted me with a vivacious warmth which had much in it, I at first thought, of an overdone cordiality—of the constrained effort of the ennuyé man of the world."
                                            },
                                            {
                                                "example_id": "0a651b67-3932-42ea-be93-f26e123d80c3",
                                                "sense_id": "a0ebf90b-dccc-365e-bdee-a90526076f00",
                                                "text": "Adam gave her—the spaniel, not Mrs. Florin—a gentle prod with his foot and a lump of sugar. She licked his shoe with evident cordiality. Adam was not above feeling flattered by friendliness in dogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                        "entry_id": "9aaf0e43-fe1a-3961-8ba3-b6ddd4913d78",
                                        "glosses": [
                                            "A friendly utterance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1901ae-c290-46ec-9dd5-f93971405549",
                                                "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                                "text": "to exchange cordialities with people"
                                            },
                                            {
                                                "example_id": "2851b62d-5e0d-49fd-947a-7e39c93af334",
                                                "sense_id": "049a715e-8e5c-35dc-9fa1-68265961868e",
                                                "text": "Lucia rivalled these cordialities with equal fervour and about as much sincerity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51c2b86a-8470-4d84-bddf-2fa9d66e10c4",
                        "source_entry_id": "9bfc7b00-55ef-356f-9cfe-8207d682d4eb",
                        "source_sense_id": "9c9f5a4b-aa5e-36ec-9e61-587390aa2eb6",
                        "source_sense_description": "Herzlichkeit, Freundlichkeit",
                        "target_lang_word": "cordialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                        "entry_id": "bb893b3f-690c-346b-9e85-12dfce28c585",
                                        "glosses": [
                                            "Affection dont les manifestations attestent la sincérité, la vivacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2470dab5-4124-4573-b078-fafb34468f3c",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "La plus franche cordialité régnait entre nous. Je passai là d’excellentes heures."
                                            },
                                            {
                                                "example_id": "d38dab9b-6bd4-47b0-8bd6-9995dde452e1",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Le bruit des voix, des carafes, des fourchettes, et des gosiers qui poussaient le bœuf vers les estomacs, cette rumeur de cordialité qui monte d’une table où les bonnes entrées n’empêchent pas les conversations, leur tapait un peu dans la tête."
                                            },
                                            {
                                                "example_id": "6bde5b34-f0f6-4cab-b000-188e115b82fa",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Lorsqu’au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu’elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
