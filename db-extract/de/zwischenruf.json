                ],
                "senses": [
                    {
                        "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                        "entry_id": "1e9a72fe-dc27-39e4-9045-e036039652ee",
                        "glosses": [
                            "Ruf während einer Rede oder Vorstellung einer anderen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524b4321-d2c5-443d-99fd-2a5703dace23",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "Der Redner wurde durch den Zwischenruf unterbrochen."
                            },
                            {
                                "example_id": "14250b43-5911-4468-878f-9c8cedc1d3bd",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "Man konnte viele zustimmende Zwischenrufe vernehmen."
                            },
                            {
                                "example_id": "5fe85ddb-6a3b-4160-aa24-93c58e6f5c61",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "Aufgrund der zahlreichen Zwischenrufe musste das Schauspiel schließlich abgebrochen werden."
                            },
                            {
                                "example_id": "d3967cfc-cc41-48d5-a3d7-ea1f0f0decf2",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "„Sie hatte sich in eine Art verhaltene Wut hineingesteigert, die sogar Halders ironische Zwischenrufe verstummen ließ.“"
                            },
                            {
                                "example_id": "04d262e0-d0f2-48c7-9fa3-6fdb2be7e954",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "„Die Zwischenrufe wurden lauter.“"
                            },
                            {
                                "example_id": "8dcce80c-b384-49d3-8c16-eb691948717e",
                                "sense_id": "9cc4260f-f604-3f89-b320-7218aeb84228",
                                "text": "„Als Busch im März 1881 trotz seines schlechten Befindens wieder nach München kam, war er ein reizbarer Gesellschafter, der die Veranstaltung eines Hypnotiseurs im Künstlerhaus durch Zwischenrufe störte und danach noch eine Szene machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
