                },
                {
                    "sense_id": "476ed7a9-ddb7-3372-9043-5dc62492513e",
                    "sense_definition": "D'une manière sobre, dépouillée ou austère, sans fioritures ni ornements superflus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sobriété",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grande salle commune était meublée très <w>sévèrement</w>, sans aucun tableau aux murs."
