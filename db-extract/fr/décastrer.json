                ],
                "senses": [
                    {
                        "sense_id": "927fe403-748c-37a4-999a-404079d62787",
                        "entry_id": "4e25144d-2a77-30f0-8922-04d7c98c3687",
                        "glosses": [
                            "Faire perdre son caractère castré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fd59bd-8d63-456f-8cb7-8f9bcfaf82c4",
                                "sense_id": "927fe403-748c-37a4-999a-404079d62787",
                                "text": "La tâche « violente, brutale » de la schizo-analyse est fixée : « défamiliariser, désœdipianiser, décastrer, déphalliciser, défaire théâtre, rêve et fantasme, décoder, déterritorialiser — un affreux curetage, une activité malveillante »."
                            },
                            {
                                "example_id": "db11bf7a-551b-4686-bd56-1e469611b68a",
                                "sense_id": "927fe403-748c-37a4-999a-404079d62787",
                                "text": "A la clinique, plusieurs choix s’offrent à vous : vous pouvez demander une simple visite de routine (un check-up), à faire castrer / stériliser ou même décastrer / déstériliser votre animal (oui, tout est possible dans Les Sims !), ou à le faire soigner s’il est visiblement malade."
                            },
                            {
                                "example_id": "652146bd-72cd-4560-aca7-492a2b4dd5bc",
                                "sense_id": "927fe403-748c-37a4-999a-404079d62787",
                                "text": "J'aimerais savoir si on peut décastrer notre animal et si oui comment?"
                            }
                        ]
                    }
                ],
