                "senses": [
                    {
                        "sense_id": "dfe487ca-ddf8-31e3-bd28-0ae985a8b256",
                        "entry_id": "9e194f41-7e66-345b-9984-7789913ef5f9",
                        "glosses": [
                            "(männliche) Person, die Siebenkampf betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c1bf80-014d-4408-a836-7a39574acbff",
                                "sense_id": "dfe487ca-ddf8-31e3-bd28-0ae985a8b256",
                                "text": "„Der Elmer Siebenkämpfer Lars Albert und die Frankfurter Fünfkämpferin Claudia Rath haben die deutschen Meisterschaften im Hallen-Mehrkampf in Frankfurt gewonnen.“"
                            },
                            {
                                "example_id": "98f6c9f8-4f53-4039-a6d8-0e2163013eb9",
                                "sense_id": "dfe487ca-ddf8-31e3-bd28-0ae985a8b256",
                                "text": "Harro hat sich für eine Karriere als Siebenkämpfer entschieden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
