                                "target_senses": [
                                    {
                                        "sense_id": "8d1d7656-3db9-3b9b-a8e5-32a67514d10e",
                                        "entry_id": "78c448f0-6e1e-3611-95be-198a807c4644",
                                        "glosses": [
                                            "een van de vijftig deelstaten van de Verenigde Staten van Amerika. De staat grenst aan Canada, en wordt omgeven door de Stille Oceaan, Beringzee en de Noordelijke IJszee."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f57716-1e9e-479e-bfc7-b652d3bb7031",
                                                "sense_id": "8d1d7656-3db9-3b9b-a8e5-32a67514d10e",
                                                "text": "De afgelopen tien jaar hebben zwarte beren in heel Amerika slechts tien dodelijke ongevallen veroorzaakt, waarvan acht in Alaska. De veel agressievere Grizzly, of bruine beer, komt maar heel zelden voor in de staten aan de westkust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b6c46c-f63b-49e8-b70a-01eaa34848fe",
                        "source_entry_id": "ce80325d-404f-3598-b172-3572a882f163",
                        "source_sense_description": "US state",
                        "target_lang_word": "Alaska",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alaska",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb83f27e-51bc-33f7-8d0c-c290caac2aa3",
                                        "entry_id": "b1eaf86a-a171-334d-ad7d-8c5d4ddc54ec",
                                        "glosses": [
                                            "Un des cinquante États des États-Unis d’Amérique, bordé par l’océan Arctique au nord (mer des Tchouktches et mer de Beaufort), le Canada à l’est (Yukon et Colombie-Britannique), le Pacifique Nord (golfe d’Alaska) au sud, et la mer de Béring à l’ouest, et dont la capitale est Juneau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a376c1c-5118-4a74-bc7d-526dcb479fe8",
                                                "sense_id": "eb83f27e-51bc-33f7-8d0c-c290caac2aa3",
                                                "text": "On pouvait alors déterminer la marche des races dites rouges. Parti des steppes mongoles, un courant humain déferlait en Sibérie, gagnait l’Alaska, envahissait peu à peu l’Amérique du Nord."
                                            },
                                            {
                                                "example_id": "25429067-fb2c-4b12-9c6c-755423d33169",
                                                "sense_id": "eb83f27e-51bc-33f7-8d0c-c290caac2aa3",
                                                "text": "Les autorités prirent soin que ce mouvement ne leur glissât pas des mains, comme cela s'était produit en Californie et en Alaska ; elles le surveillèrent et le régulèrent constamment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ce58b6-3f6d-4a20-9ead-883765db5eed",
                        "source_entry_id": "ce80325d-404f-3598-b172-3572a882f163",
