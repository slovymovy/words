                    "sense_definition": "Het gemeen, laaghartig of walgelijk zijn; gemene of laaghartige daad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>misselijkheid</w> van haar gemene streken riep bij iedereen grote verontwaardiging op.",
                            "target_lang_translations": {
                                "en": "The <w>vileness</w> of her dirty tricks provoked great indignation in everyone."
