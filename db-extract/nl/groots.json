                                        "entry_id": "cb64d02c-653d-3588-82d6-8f9fe4877022",
                                        "glosses": [
                                            "sich sehr positiv abhebend, hervorragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd41166-a6e9-4a2d-aeb4-da1a839b73b4",
                                                "sense_id": "c5cf62ae-dfa0-3088-b8ae-f84627cbb87c",
                                                "text": "Die Mannschaft spielte grandios!"
                                            },
                                            {
                                                "example_id": "41ec9cd2-54bd-460a-b4a0-c2d0aaaca412",
                                                "sense_id": "c5cf62ae-dfa0-3088-b8ae-f84627cbb87c",
                                                "text": "Die Aussicht von diesem Berg ist einfach grandios."
                                            },
                                            {
                                                "example_id": "474f9a05-ebc4-48d4-a633-86aecae58a89",
                                                "sense_id": "c5cf62ae-dfa0-3088-b8ae-f84627cbb87c",
                                                "text": "Unsere Firma hat grandiose Aussichten für die Zukunft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e37317bf-017d-4a00-a30c-86555e49135b",
                        "source_entry_id": "25f73d0c-31d2-3e5a-854b-4f726acd09fe",
                        "source_sense_id": "f4e8ff0f-b525-31e0-aae0-262ef324439e",
                        "source_sense_description": "verheven, groot van opzet",
                        "target_lang_word": "großartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "großartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                        "entry_id": "92eb0f19-1534-3307-ba82-ad519a5f5d4d",
                                        "glosses": [
                                            "deutlich besser als der Durchschnitt, sehr gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1515787f-1408-4b17-a32d-089f720f9718",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Das hast du großartig gemacht!"
                                            },
                                            {
                                                "example_id": "89e8d2a3-6918-4939-9d03-bb49a4daacf2",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Er ist ein großartiger Mensch."
                                            },
                                            {
                                                "example_id": "cb7949bc-cae4-43bf-aadf-0692cc181621",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "Alle Freunde zu der Feier einzuladen, ist eine großartige Idee."
                                            },
                                            {
                                                "example_id": "2806d9a3-fd05-4c3f-b59c-7c6b668a2929",
                                                "sense_id": "82eec423-5a71-301c-9c88-5120160a8b3e",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
