                "senses": [
                    {
                        "sense_id": "d03e690f-fdfa-3298-b199-954be1d66e7e",
                        "entry_id": "d7006156-a6a6-3ba5-959d-cfca0e90880e",
                        "glosses": [
                            "Échantillonner à une fréquence moins élevée que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0622d73e-8fea-4cc2-9557-ae994f347844",
                                "sense_id": "d03e690f-fdfa-3298-b199-954be1d66e7e",
                                "text": "Pourquoi suréchantillonner ou sous-échantillonner un signal ?"
                            },
                            {
                                "example_id": "d7f022aa-d9be-4c3b-9990-ad6964b0892c",
                                "sense_id": "d03e690f-fdfa-3298-b199-954be1d66e7e",
                                "text": "Ne pas sous-échantillonner ou rééchantillonner à 300 ppp pour les images au dessus de 450 ppp."
                            },
                            {
                                "example_id": "069d778a-b228-4db7-bfc8-7dd594178f85",
                                "sense_id": "d03e690f-fdfa-3298-b199-954be1d66e7e",
                                "text": "En préimpression, il n'est pas toujours nécessaire de sous-échantillonner les images à la résolution ciblée."
                            }
                        ]
                    }
