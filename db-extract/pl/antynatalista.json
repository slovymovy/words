                                "example_id": "abd74c02-d95e-4339-b792-2dea3122576d",
                                "sense_id": "006bd092-9544-39b0-829a-b3dc6558beca",
                                "text": "Niektórzy antynataliści uważają, że większość ludzi nie ocenia rzeczywistości w sposób realny"
                            }
                        ],
