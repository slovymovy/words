    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1fdd9f17-2d12-37e1-a9a1-75540097ce22",
                    "sense_definition": "Коренным образом, существенно, затрагивая самую суть дела.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот метод <w>принципиально</w> отличается от всех предыдущих.",
                            "target_lang_translations": {
                                "en": "This method differs <w>fundamentally</w> from all previous ones.",
                                "tr": "Bu yöntem öncekilerin hepsinden <w>kökten</w> farklıdır."
                            }
                        },
                        {
                            "text": "Для нас это <w>принципиально</w> важный вопрос.",
                            "target_lang_translations": {
                                "en": "For us, this is a <w>fundamentally</w> important question.",
                                "tr": "Bizim için bu, <w>son derece</w> önemli bir konudur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "принципиально новый",
                        "принципиально важно",
                        "принципиально отличаться",
                        "принципиально иной"
                    ],
                    "target_lang_definitions": {
                        "en": "In a fundamental way, substantially, affecting the very essence of the matter.",
                        "tr": "Kökten, esaslı bir şekilde, işin özünü etkileyecek biçimde."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fundamentally",
                                "target_lang_sense_clarification": "regarding the essence or core nature"
                            },
                            {
                                "target_lang_word": "radically",
                                "target_lang_sense_clarification": "completely or substantially (often used with changes or differences)"
                            },
                            {
                                "target_lang_word": "essentially",
                                "target_lang_sense_clarification": "in essence"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kökten",
                                "target_lang_sense_clarification": "esaslı ve köklü bir biçimde"
                            },
                            {
                                "target_lang_word": "esas itibarıyla",
                                "target_lang_sense_clarification": "temelde, özünde"
                            },
                            {
                                "target_lang_word": "temelden",
                                "target_lang_sense_clarification": "temel olarak, tamamen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ec1851c-63e0-3ef0-b9df-c8642595b9ff",
                    "sense_definition": "Строго следуя принципам и убеждениям; намеренно, чтобы подчеркнуть свою позицию.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>принципиально</w> не ест мясо уже много лет.",
                            "target_lang_translations": {
                                "en": "He hasn't eaten meat <w>on principle</w> for many years.",
                                "tr": "Yıllardır <w>prensip gereği</w> et yemiyor."
                            }
                        },
                        {
                            "text": "Мы <w>принципиально</w> не стали отвечать на это грубое письмо.",
                            "target_lang_translations": {
                                "en": "We didn't answer that rude letter <w>on principle</w>.",
                                "tr": "Bu kaba mektuba <w>ilkesel olarak</w> cevap vermedik."
                            }
                        }
                    ],
                    "synonyms": [
                        "бескомпромиссно"
                    ],
                    "common_phrases": [
                        "принципиально не",
                        "поступить принципиально",
                        "действовать принципиально"
                    ],
                    "target_lang_definitions": {
                        "en": "Strictly following principles and beliefs; intentionally, to emphasize one's position.",
                        "tr": "İlkelere ve inançlara sıkı sıkıya bağlı kalarak; kendi duruşunu vurgulamak amacıyla kasıtlı olarak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on principle",
                                "target_lang_sense_clarification": "due to a fixed belief or moral code"
                            },
                            {
                                "target_lang_word": "as a matter of principle",
                                "target_lang_sense_clarification": "formal phrase indicating adherence to principles"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "prensip gereği",
                                "target_lang_sense_clarification": "belirli bir ilkeye dayanarak"
                            },
                            {
                                "target_lang_word": "ilkesel olarak",
                                "target_lang_sense_clarification": "kendi prensiplerine bağlı kalarak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31d84570-14f8-39d5-a98c-ce2c34ec4de7",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>принципиальный</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это различие не <w>принципиально</w> для нашего исследования.",
                            "target_lang_translations": {
                                "en": "This difference is not <w>fundamental</w> to our research.",
                                "tr": "Bu fark araştırmamız için <w>önemli</w> değil."
                            }
                        },
                        {
                            "text": "Ваше согласие <w>принципиально</w> для начала работы над проектом.",
                            "target_lang_translations": {
                                "en": "Your consent is <w>crucial</w> for starting work on the project.",
                                "tr": "Proje üzerinde çalışmaya başlamak için onayınız <w>şarttır</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter form of the adjective 'принципиальный' (fundamental/crucial).",
                        "tr": "'Принципиальный' (temel, hayati, önemli) sıfatının nötr cins kısa formu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crucial",
                                "target_lang_sense_clarification": "of decisive importance"
                            },
                            {
                                "target_lang_word": "fundamental",
                                "target_lang_sense_clarification": "basic or essential"
                            },
                            {
                                "target_lang_word": "essential",
                                "target_lang_sense_clarification": "absolutely necessary"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "önemli",
                                "target_lang_sense_clarification": "büyük önemi olan, mühim"
                            },
                            {
                                "target_lang_word": "hayati",
                                "target_lang_sense_clarification": "büyük önem taşıyan, kritik"
                            },
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "temel oluşturan"
                            }
                        ]
                    }
                }
            ]
        }
