                            {
                                "example_id": "05406996-acee-48a4-9250-a61f193a9311",
                                "sense_id": "9e80da20-473b-38ea-80a9-3d208cf20c60",
                                "text": "De kern van een komeet is een losse samenklontering van bevroren gassen en stofkorrels. Als deze de zon nadert, sublimeert (verdampt) het bevroren oppervlak en hult de komeetkern zich in een wolk van gas en stof, de zogeheten coma."
                            },
                            {
                                "example_id": "61c8c599-7c30-4de3-add8-dd8ad789ce29",
                                "sense_id": "9e80da20-473b-38ea-80a9-3d208cf20c60",
                                "text": "In de ijle gaswolk (coma) rond de kern van komeet Halley komt formaldehyde voor."
                            }
                        ]
                    },
