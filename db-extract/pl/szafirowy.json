                                "sense_id": "6be0198a-5ce2-321f-9bb9-ea732af2d569",
                                "text": "Tu kupowano talerze, szklanki, żelazka, młynki, lalki, a niekiedy duże parasole szafirowe lub pąsowe"
                            },
                            {
                                "example_id": "6324cd04-8d65-4cec-9f20-1f92223b9956",
                                "sense_id": "6be0198a-5ce2-321f-9bb9-ea732af2d569",
                                "text": "Spiętrzony, poszarpany dziko łańcuch skał półwyspu otaczało szafirowe, wiecznie niespokojne morze"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
