                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fbb30bcd-e1a2-4951-aea3-5f0af0d1bf61",
                                "sense_id": "0a0337d1-d906-3400-9565-df2fccd48030",
                                "text": "Idylla maleńka taka: / Wróbel połyka robaka, / Wróbla kot dusi niecnota, / Pies chętnie rozdziera kota…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7b68e85f-e414-3af4-b392-e577f7de2823",
                        "entry_id": "82919526-5ba8-3fca-b40b-74b803614a03",
                        "glosses": [
                            "pogodny liryk opiewający uroki życia na wsi"
                        ],
                        "tags": [],
                        "examples": [
                            {
