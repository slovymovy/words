                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a516de7-a2d7-4203-9a5e-63f8baaa7c09",
                                                "sense_id": "6acf3c0d-acd3-3404-963a-0456f74b285a",
                                                "text": "Hmm... that's an interesting idea."
                                            },
                                            {
                                                "example_id": "d9751c14-a6bd-4b6a-8874-b8710f020732",
                                                "sense_id": "6acf3c0d-acd3-3404-963a-0456f74b285a",
                                                "text": "Hmm... I just can't decide between the two."
