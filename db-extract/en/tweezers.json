                    {
                        "translation_id": "3b8e4f38-9145-413b-82d6-33308ab06292",
                        "source_entry_id": "1337ec6a-ea56-3015-b840-3ebc2060926f",
                        "source_sense_id": "9ad093f2-9d32-3278-bc6f-3790491c3eaa",
                        "source_sense_description": "small pincer-like instrument, usually made of metal, used for handling small objects",
                        "target_lang_word": "pince à épiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pince à épiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                        "entry_id": "6eb8859c-0635-368a-aa6c-5cdd24f5d534",
                                        "glosses": [
                                            "Pince manuelle dont les branches font ressort et servant à enlever les poils ou à effectuer un travail de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ba5ef6-e9fa-46c4-9e07-cee6ee8ff4b5",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "La pince à épiler demeure néanmoins utile entre deux séances d’épilations à la cire."
                                            },
                                            {
                                                "example_id": "4bcd2ad6-e74c-45ca-9088-b75d001c4e94",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Par désœuvrement, elle prit une pince à épiler dans son sac sur la table de nuit, s’arracha un poil sur le mollet en grimaçant, remit la pince dans son sac, regarda Dobbs, se redressa d'un coup, reprit la pince à épiler, arracha un poil sur le nez de Dobbs…"
                                            },
                                            {
                                                "example_id": "fa025fad-9720-4d71-987c-1d550b3efe5f",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Le prélèvement se fera avec une pince à épiler par prélèvement direct des cheveux cassés fluorescents ou avec un grattoir en raclant la zone alopécique et en faisant ainsi tomber les cheveux."
                                            },
                                            {
                                                "example_id": "19ed5fe3-222d-48b5-b859-cd9e948027d8",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Nous collons un premier tenon à la pince à épiler et attendons son séchage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c98bb46-b6f6-4063-a69e-127dc51b845a",
                        "source_entry_id": "1337ec6a-ea56-3015-b840-3ebc2060926f",
                        "source_sense_id": "9ad093f2-9d32-3278-bc6f-3790491c3eaa",
                        "source_sense_description": "small pincer-like instrument, usually made of metal, used for handling small objects",
                        "target_lang_word": "pincette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pincette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                        "entry_id": "1d5186f2-fd65-33e6-afcd-35175b17e466",
                                        "glosses": [
                                            "Ustensile de fer à deux branches égales, dont on se sert pour remuer le feu, pour atteindre les bûches et les tisons dans une cheminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1878c2-f508-4836-96ca-6e0bb9ebec9c",
                                                "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                                "text": "Les principaux meubles du salon formaient un groupe autour de la cheminée, où deux tisons éteints renversés sur les chenets semblaient n’attendre que le secours de la pincette pour se rallumer."
                                            },
                                            {
                                                "example_id": "2d1150d2-b5c6-46fb-827f-5273a1554f94",
                                                "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                                "text": "Un brasier s’élargissait peu à peu, un tas de cendre fine montait, une couche épaissie de feuilles noires où couraient des millions d’étincelles. Mais c’était une besogne longue, sans fin ; car, lorsqu’on jetait trop de pages à la fois, elles ne brûlaient pas, il fallait les secouer, les retourner avec les pincettes ; et le mieux était de les froisser, d’attendre qu’elles fussent bien enflammées, avant d’en ajouter d’autres."
                                            },
                                            {
                                                "example_id": "e400968d-8e33-4cb1-b234-6fe8264c0c26",
                                                "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                                "text": "Du bout de sa pincette, Fernand Ricard sortait des cendres un objet tordu, noirâtre, impossible à définir."
                                            },
                                            {
                                                "example_id": "b3d1b06d-8e3a-4bdd-90ad-db9f9acffa41",
                                                "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                                "text": "Le garde-cendre, les chenets, les pelles, les pincettes, tout était du plus grand prix."
                                            },
                                            {
                                                "example_id": "43dac6bb-a2c0-4f49-ade4-c2c3a8001a47",
                                                "sense_id": "584144f6-0fc5-328d-8026-9502fb3e22bb",
                                                "text": "On ne le prendrait pas avec des pincettes. : se dit d’un objet sale, répugnant, d’un homme négligé dans sa mise, malpropre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80118278-13e4-3c7d-8d58-13c56f2666aa",
                                        "entry_id": "1d5186f2-fd65-33e6-afcd-35175b17e466",
                                        "glosses": [
                                            "Petits instruments de fer à deux branches dont on se sert pour saisir certains objets qu’on ne pourrait prendre facilement avec les doigts."
                                        ],
                                        "tags": [
                                            "Dans divers métiers"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b1b8c38-73a3-3b0c-822a-e0888d655d23",
                                        "entry_id": "1d5186f2-fd65-33e6-afcd-35175b17e466",
                                        "glosses": [
                                            "Pince à linge."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d8d2c0b-ea05-34c1-81c4-6a4c1a3f6a94",
                                        "entry_id": "1d5186f2-fd65-33e6-afcd-35175b17e466",
                                        "glosses": [
                                            "Fait de se blesser, et bien souvent de se faire une ampoule pleine de sang, en se pinçant."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b567e96-e979-4121-98b5-a0794ef23eff",
                                                "sense_id": "0d8d2c0b-ea05-34c1-81c4-6a4c1a3f6a94",
                                                "text": "Il s'est fait une pincette en refermant les anneaux de son classeur sur son doigt."
                                            }
                                        ]
                                    }
                                ]
                            },
