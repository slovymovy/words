{
    "word_family": [
        "instinct",
        "instinctively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96d5ead2-f239-3a1f-8a0b-90581d8ce8ec",
                    "sense_definition": "Relating to or prompted by a natural, unlearned behavior or impulse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother had an <w>instinctive</w> urge to protect her child from danger.",
                            "target_lang_translations": {
                                "zh": "这位母亲有一种<w>本能的</w>冲动，想要保护她的孩子免受危险。"
                            }
                        },
                        {
                            "text": "Birds have an <w>instinctive</w> ability to navigate across long distances during migration.",
                            "target_lang_translations": {
                                "zh": "鸟类在迁徙过程中具有一种<w>本能的</w>长距离导航能力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "innate",
                        "natural",
                        "inborn"
                    ],
                    "antonyms": [
                        "learned",
                        "acquired"
                    ],
                    "common_phrases": [
                        "instinctive reaction",
                        "instinctive behavior"
                    ],
                    "target_lang_definitions": {
                        "zh": "指源于天性、非后天习得的行为或冲动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "本能的",
                                "target_lang_sense_clarification": "形容源于生物本能的，非后天学习的。"
                            },
                            {
                                "target_lang_word": "天生的",
                                "target_lang_sense_clarification": "形容与生俱来的，强调自然属性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5276f37c-5569-33d9-9af1-584fa31b77b6",
                    "sense_definition": "Acting or reacting spontaneously without conscious thought or planning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instinct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pulling his hand away from the hot stove was an <w>instinctive</w> reaction.",
                            "target_lang_translations": {
                                "zh": "把手从热炉子上缩回来是一种<w>下意识的</w>反应。"
                            }
                        },
                        {
                            "text": "She made an <w>instinctive</w> decision to jump out of the way of the moving car.",
                            "target_lang_translations": {
                                "zh": "她做出了一个<w>直觉的</w>决定，跳开躲避那辆行驶中的汽车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spontaneous",
                        "impulsive",
                        "automatic"
                    ],
                    "antonyms": [
                        "deliberate",
                        "calculated"
                    ],
                    "common_phrases": [
                        "instinctive response",
                        "instinctive feeling"
                    ],
                    "target_lang_definitions": {
                        "zh": "指未经深思熟虑或计划，自发地做出反应。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "下意识的",
                                "target_lang_sense_clarification": "形容未经意识控制的自发反应。"
                            },
                            {
                                "target_lang_word": "直觉的",
                                "target_lang_sense_clarification": "形容基于直觉而非逻辑分析的反应。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}