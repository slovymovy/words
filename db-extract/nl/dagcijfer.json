                        "examples": [
                            {
                                "example_id": "9778f97f-e96f-4896-93bd-56a60fb9b505",
                                "sense_id": "731933f6-83eb-3a42-a459-9ffabe459f69",
                                "text": "De nieuwe maatregel is volgens autoriteiten nodig vanwege de toename van het aantal coronabesmettingen in sommige regio's. Vandaag werden 2449 nieuwe besmettingen binnen een etmaal gemeld, het hoogste dagcijfer sinds medio februari. Het gaat vooral om besmettingen onder jongere mensen die niet zijn gevaccineerd."
                            },
                            {
                                "example_id": "3f9205b2-07f1-4921-b409-ae484461907c",
                                "sense_id": "731933f6-83eb-3a42-a459-9ffabe459f69",
                                "text": "In India zijn het afgelopen etmaal 18.572 nieuwe coronabesmettingen gerapporteerd, het hoogste dagcijfer tot nu toe. Vooral in de dichtbevolkte metropolen als New Delhi en Mumbai is het aantal besmettingen hoog."
                            }
                        ]
                    }
