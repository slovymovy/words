                ],
                "senses": [
                    {
                        "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                        "entry_id": "6ff9f7ee-d5f6-3e2d-947b-dd3e0f4daa78",
                        "glosses": [
                            "Zahl der sprachlichen Einheiten, aus denen ein Text besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c82aff-9190-453c-bcdb-5c26e1cf70f3",
                                "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                                "text": "„Dividiert man die syntaktische Komplexität durch die Textlänge (Anzahl token), erhält man einen Wert, der angibt, um wie viel die syntaktische Komplexität ansteigt, wenn sich die Textlänge um ein Wort erhöht.“"
                            },
                            {
                                "example_id": "d181f161-f940-497a-9d67-f10b8f935cf8",
                                "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                                "text": "„Bekanntlich hängt Parameter b stark von der Textlänge ab, daher sollten komparative Urteile nur nach Durchführung eines Tests abgegeben werden (…).“"
                            },
                            {
                                "example_id": "1b0a0ac2-7a4d-44ef-93c1-2257237f0f15",
                                "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                                "text": "„Dem gleichen Modell entsprechen auch die Daten zur Entwicklung der Textlänge, die für schriftliche Texte von Kindern im Alter von 8;8 – 9;11 (D = 0.97) und für mündliche Texte vom 1. – 4. Schuljahr (D = 0.99) vorgestellt werden (…).“"
                            },
                            {
                                "example_id": "5d7239b5-97ef-4ded-9d88-6526250837f4",
                                "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                                "text": "„Man weiß, dass mit wachsender Textlänge auch die Zahl der types anwächst, jedoch ist schon sehr bald festgestellt worden, dass sich dieses Wachstum verlangsamt.“"
                            },
                            {
                                "example_id": "c7206df0-02d4-4c85-96f4-fed337f34baf",
                                "sense_id": "b45802b6-0f41-3961-8739-057a2fc0c98e",
                                "text": "Man kann die Textlänge je nach Interesse sehr verschieden definieren: durch die Zahl der Buchstaben, Silben, Wörter, Sätze oder noch anderer Einheiten, aus denen ein Text besteht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
