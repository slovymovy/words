                ],
                "senses": [
                    {
                        "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                        "entry_id": "bdf7145d-8143-353d-9d00-b80170905ab0",
                        "glosses": [
                            "Qui a un fonctionnement troublé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affe5ccf-cfc4-4b9d-a8c1-95a7d275da9f",
                                "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                                "text": "Le BIXI, en effet, est non seulement le symbole urbain par excellence, c’est aussi celui des rapports dysfonctionnels qu’entretiennent Québec et Montréal."
                            },
                            {
                                "example_id": "8a48aa4e-13b3-4c4f-861b-409938da3ffb",
                                "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                                "text": "L’apport de Freud à la psychiatrie a été, notamment, de montrer que névrose et psychose ne définissent pas des anormaux, mais des êtres qui ont tenté de trouver des solutions - certes dysfonctionnelles -, à des problèmes profondément humain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bdec92c-c324-45cd-8fdb-82b9e318db06",
                        "source_entry_id": "bdf7145d-8143-353d-9d00-b80170905ab0",
                        "source_sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                        "target_lang_word": "dysfunktional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysfunktional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "557d2a6f-b72a-3970-acf8-8f6e473b2e36",
                                        "entry_id": "9dff0e44-8048-3223-94ae-42e5631b129f",
                                        "glosses": [
                                            "mit fehlender oder mangelhafter Funktion"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caaf9ea5-cc47-4bf7-a1ef-b8d275b18ef0",
                                                "sense_id": "557d2a6f-b72a-3970-acf8-8f6e473b2e36",
                                                "text": "Dysfunktional ist eine Uhr, die die Zeit nicht genau angibt."
                                            },
                                            {
                                                "example_id": "efa57e26-e916-448d-9b89-856ced1532d0",
                                                "sense_id": "557d2a6f-b72a-3970-acf8-8f6e473b2e36",
                                                "text": "„Doch die wahre Herausforderung der Stadt, die vor hundert Jahren ihre angeblich goldenen Zwanziger erlebte, ist der Alltag. Das Wort von der dysfunktionalen ‚failed city‘ ist notorisch geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6fc8b2f-cf7b-3ad1-b208-2c86586c3306",
                                        "entry_id": "9dff0e44-8048-3223-94ae-42e5631b129f",
                                        "glosses": [
                                            "eine Dysfunktion betreffend, durch Dysfunktion verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37899b60-7be9-4e92-8ee9-87519cd555a5",
                        "source_entry_id": "bdf7145d-8143-353d-9d00-b80170905ab0",
                        "source_sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                        "target_lang_word": "dysfunctional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
