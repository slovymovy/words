                "senses": [
                    {
                        "sense_id": "422949f6-8359-3429-9475-9c14be5b614e",
                        "entry_id": "cbf9404c-4e49-38d3-a3b2-75ba856e555f",
                        "glosses": [
                            "der- oder diejenige, die in einem sportlichen Wettkampf den ersten Platz errungen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68854d66-fe0c-42d8-80f4-40ec2138c3cd",
                                "sense_id": "422949f6-8359-3429-9475-9c14be5b614e",
                                "text": "Er beendete das Rennen als Erstplatzierter."
                            },
                            {
                                "example_id": "bf721cb3-3fb0-4afa-a76b-aa221e34d4d9",
                                "sense_id": "422949f6-8359-3429-9475-9c14be5b614e",
                                "text": "„Um als Erstplatzierter oder als einer der drei besten Zweiten der fünf Vierergruppen noch eine realistische Chance aufs Weiterkommen zu haben, müssten die Berliner ihre beiden restlichen Gruppenspiele bei Volley Ljubljana aus Slowenien und beim russischen Meister Kuzbass Kemerowo mit 3:0 oder 3:1 gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
