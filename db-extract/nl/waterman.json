                    {
                        "sense_id": "c8cd3879-d92b-3cc1-8884-e40aa9a2af1f",
                        "entry_id": "9b50278f-37d6-3bce-9931-a3ee4059de1e",
                        "glosses": [
                            "een tamelijk onopvallend sterrenbeeld van de dierenriem (tussen rechte klimming 20ᵘ36ᵐ en 23ᵘ54ᵐ en tussen declinatie −25° en +3°)"
                        ],
                        "tags": [
                            "sterrenbeeld"
                        ],
                        "examples": [
                            {
                                "example_id": "ca1f80c1-2449-4a6e-9bbe-c34972ec7704",
                                "sense_id": "c8cd3879-d92b-3cc1-8884-e40aa9a2af1f",
                                "text": "Rond een sterretje in het sterrenbeeld Waterman, 39 lichtjaar van ons vandaan, cirkelen drie planeten die ongeveer zo groot zijn als de aarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1877e400-f8b3-361e-867c-764bf256b8f2",
                        "entry_id": "9b50278f-37d6-3bce-9931-a3ee4059de1e",
                        "glosses": [
                            "teken van de dierenriem waar de Zon in staat, van ca. 20 januari tot ca. 19 februari"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb92c0f-ed71-4aaf-9e37-242f5861e30a",
                                "sense_id": "1877e400-f8b3-361e-867c-764bf256b8f2",
                                "text": "Hij analyseert: „Rutte heeft als sterrenbeeld Waterman, dus een teamplayer."
                            }
                        ]
                    },
                    {
                        "sense_id": "5abbc3ee-b7a3-368d-acac-3709e85054fe",
                        "entry_id": "9b50278f-37d6-3bce-9931-a3ee4059de1e",
                        "glosses": [
                            "familienaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef02b18-9461-44d7-83d5-0ccf52f491a2",
                                "sense_id": "5abbc3ee-b7a3-368d-acac-3709e85054fe",
                                "text": "Elly Waterman, voorzitter van Wikimedia Nederland, had eigenlijk geen ander vonnis verwacht. \"De rechter heeft goed ingezien dat onze vereniging niets te maken heeft met de inhoud op Wikipedia. Voor buitenstaanders is dat soms moeilijk te begrijpen.\""
                            }
                        ]
                    }
