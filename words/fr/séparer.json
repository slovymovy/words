    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "263e0bd9-5f23-35e8-8413-264fc21772c4",
                    "sense_definition": "Éloigner des personnes ou des choses les unes des autres pour qu'elles ne soient plus ensemble.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eloignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a décidé de <w>séparer</w> les deux élèves bavards en classe."
                        },
                        {
                            "text": "Après dix ans de mariage, ils ont choisi de se <w>séparer</w> calmement."
                        }
                    ],
                    "antonyms": [
                        "réunir"
                    ],
                    "common_phrases": [
                        "se séparer de quelqu'un"
                    ]
                },
                {
                    "sense_id": "ba94271a-d864-3136-9ffc-70a7e9abaff0",
                    "sense_definition": "Diviser un objet ou un espace en plusieurs parties distinctes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un rideau épais permet de <w>séparer</w> la pièce en deux espaces distincts."
                        },
                        {
                            "text": "Il a pris un couteau bien aiguisé pour <w>séparer</w> le gâteau en parts égales."
                        }
                    ],
                    "synonyms": [
                        "diviser"
                    ],
                    "antonyms": [
                        "joindre",
                        "réunir"
                    ],
                    "common_phrases": [
                        "séparer en deux",
                        "séparer une pièce"
                    ]
                },
                {
                    "sense_id": "7e054cf7-9f38-35a8-af42-8b6d48f2b995",
                    "sense_definition": "Constituer une frontière ou marquer une distance entre deux espaces ou territoires.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frontiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les Pyrénées <w>séparent</w> naturellement la France et l'Espagne."
                        },
                        {
                            "text": "Une simple clôture en bois <w>sépare</w> notre jardin de celui du voisin."
                        }
                    ],
                    "common_phrases": [
                        "séparer deux pays"
                    ]
                },
                {
                    "sense_id": "26cba9c9-ce53-315e-afd5-7ec8ec06f78e",
                    "sense_definition": "Intervenir entre des personnes ou des animaux pour faire cesser une dispute ou un combat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre est rapidement intervenu sur le terrain pour <w>séparer</w> les deux joueurs."
                        },
                        {
                            "text": "Les passants ont tenté de les <w>séparer</w> avant l'arrivée de la police."
                        }
                    ],
                    "common_phrases": [
                        "séparer les combattants"
                    ]
                },
                {
                    "sense_id": "85eab5de-d175-3529-a0b5-14db8d282e5f",
                    "sense_definition": "Trier ou isoler des éléments qui étaient mélangés ou confondus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tri",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut d'abord <w>séparer</w> les blancs des jaunes d'œufs pour cette recette."
                        },
                        {
                            "text": "Cette machine industrielle permet de <w>séparer</w> facilement les déchets recyclables."
                        }
                    ],
                    "common_phrases": [
                        "séparer le bon grain de l'ivraie",
                        "séparer les déchets"
                    ]
                }
            ]
        }
    ]
}