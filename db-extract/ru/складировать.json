                ],
                "senses": [
                    {
                        "sense_id": "af1c167e-a2c4-3c7e-80be-176816693a0f",
                        "entry_id": "0c2e0dd8-4bc5-3362-bf14-1bdbc5850454",
                        "glosses": [
                            "офиц. располагать (расположить), размещать (разместить) где-либо для хранения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b2d1377-30ee-4f4d-aa45-efd5b456fe9b",
                                "sense_id": "af1c167e-a2c4-3c7e-80be-176816693a0f",
                                "text": "Сахар является единственным продуктом питания, который разрешается складировать на территории офиса компании."
                            },
                            {
                                "example_id": "8024d3c2-cc33-49b8-b61f-9d25b2e82bec",
                                "sense_id": "af1c167e-a2c4-3c7e-80be-176816693a0f",
                                "text": "Правда, в ожидании увеличения спроса на них танки пришлось складировать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f589549c-1f86-449c-897c-d33397fffff8",
                        "source_entry_id": "0c2e0dd8-4bc5-3362-bf14-1bdbc5850454",
                        "source_sense_id": "af1c167e-a2c4-3c7e-80be-176816693a0f",
                        "target_lang_word": "store",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "store",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa469545-2408-36df-b5ef-78b8aaae41d8",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "A place where items may be accumulated or routinely kept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c50ca93-5494-491a-86c0-6864aba08035",
                                                "sense_id": "aa469545-2408-36df-b5ef-78b8aaae41d8",
                                                "text": "This building used to be a store for old tires."
                                            },
                                            {
                                                "example_id": "84582f78-b97a-490c-bc4c-ac1de00b7c43",
                                                "sense_id": "aa469545-2408-36df-b5ef-78b8aaae41d8",
                                                "text": "And his subjects wrung all they could wring\nOut of temple and palace and store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53038c35-dfb8-396f-a7a8-72f92852c21f",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "A supply held in storage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710368c9-ddf8-4cc2-8965-25b37dc6ce7a",
                                                "sense_id": "53038c35-dfb8-396f-a7a8-72f92852c21f",
                                                "text": "But there was an infinite store of mercy in those eyes, for him too a word of pardon even though he had erred and sinned and wandered."
                                            },
                                            {
                                                "example_id": "aada0f05-4f98-47b9-af21-ae7329f59774",
                                                "sense_id": "53038c35-dfb8-396f-a7a8-72f92852c21f",
                                                "text": "By late summer a sufficient store of stone had accumulated, and then the building began[…], under the superintendence of the pigs."
                                            },
                                            {
                                                "example_id": "b69b3a09-5a97-49b9-90f3-88412bd89f52",
                                                "sense_id": "53038c35-dfb8-396f-a7a8-72f92852c21f",
                                                "text": "What surprised us all was how Will's lighthearted nature and constant store of good humor won over one of the great heiresses of King Henry's court, Anne Bourchier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd42737-9e0e-3773-8765-cfac65c3521c",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "A place where items may be purchased; a shop."
                                        ],
                                        "tags": [
                                            "North-American",
                                            "mainly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f91776-64fa-4abd-a51c-41172ee72439",
                                                "sense_id": "5cd42737-9e0e-3773-8765-cfac65c3521c",
                                                "text": "I need to get some milk from the grocery store."
                                            },
                                            {
                                                "example_id": "7a62763f-1c5c-4d9d-97f1-916e5c82fcc4",
                                                "sense_id": "5cd42737-9e0e-3773-8765-cfac65c3521c",
                                                "text": "There was some laughter, and Roddle was left free to expand his ideas on the periodic visits of cowboys to the town. “Mason Rickets, he had ten big punkins a-sittin' in front of his store, an' them fellers from the Upside-down-F ranch shot 'em up […].”"
                                            },
                                            {
                                                "example_id": "e74bf6b8-8003-49b8-a76c-2571632f2516",
                                                "sense_id": "5cd42737-9e0e-3773-8765-cfac65c3521c",
                                                "text": "In 1866 Colonel J. F. Meline noted that the rebozo had almost disappeared in Santa Fe and that hoop skirts, on sale in the stores, were being widely used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e453864-c776-3731-a9bd-885ea3a44d39",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "Memory."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd102414-5c09-46e8-af6d-05d23f1602ef",
                                                "sense_id": "1e453864-c776-3731-a9bd-885ea3a44d39",
                                                "text": "The main store of 1000 36-bit words seemed large at the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15587fe3-706b-31bd-8ba2-230e6d97ca5c",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "A great quantity or number; abundance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca62329-6b28-4d34-89ee-3a5619cd9e54",
                                                "sense_id": "15587fe3-706b-31bd-8ba2-230e6d97ca5c",
                                                "text": "I make my love engrafted to this store."
                                            },
                                            {
                                                "example_id": "ebb2134b-0802-4157-8be8-70affd59d07a",
                                                "sense_id": "15587fe3-706b-31bd-8ba2-230e6d97ca5c",
                                                "text": "With store of Ladies, whose bright eies\nRain influence, and judge the prise\nOf Wit, or Arms, while both contend\nTo win her Grace, whom all commend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0f9c36-e970-3642-85b6-0715e5c1f225",
                                        "entry_id": "8bb25ef4-1a44-38a2-bf55-72bee1789600",
                                        "glosses": [
                                            "A head of store cattle (feeder cattle to be sold to others for finishing); a store cattle beast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "store",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecae4ed8-972c-382d-97c4-065def3e98f3",
                                        "entry_id": "7a66acb6-e5df-3074-8ec8-afaa58b4d99e",
                                        "glosses": [
                                            "To keep (something) while not in use, generally in a place meant for that purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68ee7332-5930-4715-8b00-b1f09dcf90a2",
                                                "sense_id": "ecae4ed8-972c-382d-97c4-065def3e98f3",
                                                "text": "I'll store these books in the attic."
                                            },
                                            {
                                                "example_id": "8352f6a0-d67a-4bac-8d30-1a20174005a8",
                                                "sense_id": "ecae4ed8-972c-382d-97c4-065def3e98f3",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            },
                                            {
                                                "example_id": "b8715535-3593-4727-880e-df01589add89",
                                                "sense_id": "ecae4ed8-972c-382d-97c4-065def3e98f3",
                                                "text": "Following allocation to Toton on January 1 1996, it stayed there until transferral to Crewe in November 2000, before being stored at Eastleigh on December 17 the same year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b0133b-35c8-3e27-84b5-281bd58765da",
                                        "entry_id": "7a66acb6-e5df-3074-8ec8-afaa58b4d99e",
                                        "glosses": [
                                            "To contain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca993f0-8177-4301-9109-20b8c5fe235f",
                                                "sense_id": "30b0133b-35c8-3e27-84b5-281bd58765da",
                                                "text": "The cabinets store all the food the mice would like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c4dbe4-bc23-35a6-83dd-007e788b7b41",
                                        "entry_id": "7a66acb6-e5df-3074-8ec8-afaa58b4d99e",
                                        "glosses": [
                                            "Have the capacity and capability to contain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d587ab1-0d62-436e-96c9-ecb34151c220",
                                                "sense_id": "35c4dbe4-bc23-35a6-83dd-007e788b7b41",
                                                "text": "They sell boxes that store 24 mason jars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7d7d0a-d642-380b-b5c6-a94c5aaa5624",
                                        "entry_id": "7a66acb6-e5df-3074-8ec8-afaa58b4d99e",
                                        "glosses": [
                                            "To write (something) into memory or registers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b93e56-c4a7-4de3-9960-076feb83b5cc",
                                                "sense_id": "3b7d7d0a-d642-380b-b5c6-a94c5aaa5624",
                                                "text": "This operation stores the result on the stack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840847f7-d7d1-3051-b23e-3433de6483bc",
                                        "entry_id": "7a66acb6-e5df-3074-8ec8-afaa58b4d99e",
                                        "glosses": [
                                            "To stock, to fill (a container, repository, etc.) with things."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d7202d-7cc8-40c0-8930-2c31f7f72213",
                                                "sense_id": "840847f7-d7d1-3051-b23e-3433de6483bc",
                                                "text": "I have eaten my fill, and had my pockets well stored."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
