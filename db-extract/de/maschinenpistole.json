                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "submachine gun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14ed377-9289-31f5-842f-53c7842b37c9",
                                        "entry_id": "c3cd89df-e793-3627-802c-d9e912bcb323",
                                        "glosses": [
                                            "A type of short range machine gun that is carried as a personal weapon and uses pistol ammunition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd2991bf-ca4a-4918-bb1d-36829fba7a00",
                                                "sense_id": "a14ed377-9289-31f5-842f-53c7842b37c9",
                                                "text": "Bare-chested children and their parents gathered in doorways, on roofs and in windows as he passed, watched warily by Brazilian troops carrying submachine guns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39e3f014-5a20-4cc2-be3b-0adfde7b0b04",
                        "source_entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                        "source_sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                        "source_sense_description": "vollautomatische Handfeuerwaffe mit geringer Masse und kurzem Lauf",
                        "target_lang_word": "pistolet-mitrailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pistolet-mitrailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                        "entry_id": "16f4490f-ae5d-37b1-b4cc-67557588c166",
                                        "glosses": [
                                            "Synonyme de mitraillette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e2bbc4-e6cf-4932-bd1b-1b4e19f79e1f",
                                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                                "text": "Le pistolet-mitrailleur est une arme produite à grande échelle pendant la Seconde Guerre mondiale."
                                            },
                                            {
                                                "example_id": "2e294578-632d-48ca-bec7-adb7cd175872",
                                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                                "text": "Nadine Lemercier sortit la première, suivie de l’adjudant-chef Greudin armé du pistolet-mitrailleur."
                                            },
                                            {
                                                "example_id": "2de7ddc9-67a3-4388-8da3-38bebd5e6678",
                                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appeler un pistolet-mitrailleur propre ? »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e07c9855-ee26-4dd4-9732-7ba5929ff421",
                        "source_entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                        "source_sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                        "source_sense_description": "vollautomatische Handfeuerwaffe mit geringer Masse und kurzem Lauf",
                        "target_lang_word": "mitraillette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitraillette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                        "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                                        "glosses": [
                                            "Pistolet-mitrailleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a94d6b6a-69d3-4d4a-ae31-5df5055c69ba",
                                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                                "text": "Le para était à côté de moi : le canon de sa mitraillette me heurtait les côtes : « Il y en a un bon tas là-dedans pour vous, si vous faites le con. »"
                                            },
                                            {
                                                "example_id": "46217ed8-3212-48b9-b0f5-07aff8025c5a",
                                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                                "text": "Sus à l’ennemi ! Aurèle sonne le hallali. Tout à l’heure, il pensait rafale de mitraillette, sulfatage, pruneaux. Mais la balle de métal est trop noble : par elle meurent les héros."
                                            },
                                            {
                                                "example_id": "ea9becfb-be31-40e7-8254-b947c3939105",
                                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                                "text": "Tout se passe rapidement, les Allemands fouillent le véhicule, ainsi que les deux officiers et découvrent alors, dans le portefeuille du capitaine Mulsant, une notice explicative sur le fonctionnement de la mitraillette « Sten »."
                                            },
                                            {
                                                "example_id": "b0d60f01-dbb5-4060-b96d-ad50a590df92",
                                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                                "text": "La franchise d’Activision s’est imposée comme une référence absolue à coups de shoots en pleine tête des soldats nazis, et de rafales de mitraillettes sur des troupes communistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9f7a1c-506c-39f2-a08b-6bebc869dc26",
                                        "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                                        "glosses": [
                                            "Demi-baguette dans laquelle on met des frites, une viande cuite à la friture et éventuellement de la sauce."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc5a7e8-e732-47f8-915c-8a70dd29742e",
                                                "sense_id": "cf9f7a1c-506c-39f2-a08b-6bebc869dc26",
                                                "text": "Il a commandé une mitraillette fricadelle, une mitraillette avec fricadelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
