                    }
                ],
                "senses": [
                    {
                        "sense_id": "907bf819-447b-3a5d-a299-c9f9b76533e4",
                        "entry_id": "caf9f389-3e5b-3d9b-9726-fabdc691b25e",
                        "glosses": [
                            "Ventiler de façon particulièrement importante, plus que la normale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0c29569-8374-3f04-9abb-26bc0b30b569",
                        "entry_id": "caf9f389-3e5b-3d9b-9726-fabdc691b25e",
                        "glosses": [
                            "Respirer rapidement et profondément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18d7c11-f537-48b4-9144-3c39e6d66c80",
                                "sense_id": "b0c29569-8374-3f04-9abb-26bc0b30b569",
                                "text": "Elle poursuivit sur ses pensées décousues, tout pour s’empêcher d’hyperventiler."
                            },
                            {
                                "example_id": "3410001f-9b28-4847-963a-46809df4fcd8",
                                "sense_id": "b0c29569-8374-3f04-9abb-26bc0b30b569",
                                "text": "Roullier avait beau hyperventiler, il fit grincer la vitesse, signe que l’énervement le gagnait malgré lui."
                            },
                            {
                                "example_id": "c8506839-111a-4cbd-ae99-ed5f80ccd26d",
                                "sense_id": "b0c29569-8374-3f04-9abb-26bc0b30b569",
                                "text": "Chaque seconde de vide que vous imposerez à Arthur le fera hyperventiler, une bonne manière de se venger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37803dfd-87de-489d-bfad-2b111c3cacac",
                        "source_entry_id": "caf9f389-3e5b-3d9b-9726-fabdc691b25e",
                        "target_lang_word": "hyperventilieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperventilieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b19e9389-8038-37c3-912f-ceb34c086429",
                                        "entry_id": "0539f61f-b9c0-3bba-aea4-7ae470f1d54d",
                                        "glosses": [
                                            "sehr übersteigert atmen, zu schnell Luft holen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f9d081-6473-4b38-a911-08ae6efd61e4",
                                                "sense_id": "b19e9389-8038-37c3-912f-ceb34c086429",
                                                "text": "„Er beugte sich dicht über das Gesicht seines Opfers und sah dabei zu, wie der Mann fast eine Minute lang vor Schmerzen hyperventilierte.“"
                                            },
                                            {
                                                "example_id": "85418e15-3696-47e7-9bcd-97f2c0246cc4",
                                                "sense_id": "b19e9389-8038-37c3-912f-ceb34c086429",
                                                "text": "„Zuerst dachte er, er würde hyperventilieren, aber tatsächlich weinte er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9fa9bab-b38f-45f1-9eb6-3a152455a3d3",
                        "source_entry_id": "caf9f389-3e5b-3d9b-9726-fabdc691b25e",
                        "target_lang_word": "hyperventilate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperventilate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92db6d3e-bdb9-3fd7-a7cc-ca2f9c23969a",
                                        "entry_id": "c517f625-6afa-3b5a-849b-e26402fba196",
                                        "glosses": [
                                            "To breathe quickly and deeply, especially at an abnormally rapid rate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed243dba-8635-4e4b-8008-9a38cc54e95c",
                                                "sense_id": "92db6d3e-bdb9-3fd7-a7cc-ca2f9c23969a",
                                                "text": "When I tried it, I hyperventilated."
                                            },
                                            {
                                                "example_id": "86bfc399-09b2-464f-a61b-873f7ed6f887",
                                                "sense_id": "92db6d3e-bdb9-3fd7-a7cc-ca2f9c23969a",
                                                "text": "Sometimes her prose hyperventilates (\"Once, years ago, his and N.'s love for each other had glowed like phosphorescent fire on the surfaces of their bodies\"), and she has a weakness for epiphanies (\"There was a man, no longer young, though not yet old, who, traveling alone in northern Europe, began to feel that his soul was being drained slowly, almost secretly from him, drop by drop\")."
                                            },
                                            {
                                                "example_id": "268e4fb2-375a-4133-93d4-00fe20e6c1eb",
                                                "sense_id": "92db6d3e-bdb9-3fd7-a7cc-ca2f9c23969a",
                                                "text": "Sometimes on the highway I had to pull over to hyperventilate and sob."
                                            },
                                            {
                                                "example_id": "66a2263e-f93c-431d-934c-fab235d12ef1",
                                                "sense_id": "92db6d3e-bdb9-3fd7-a7cc-ca2f9c23969a",
                                                "text": "Even some middle-of-the-road economic commentators have been hyperventilating, saying that she’s essentially calling for price controls, which is odd, because she didn’t say anything like that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e619fbb6-d841-4596-9542-50b1bb11e2eb",
                        "source_entry_id": "caf9f389-3e5b-3d9b-9726-fabdc691b25e",
