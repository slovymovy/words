                        "glosses": [
                            "Mettre sous l’influence du club des Feuillants, à l’époque de la Révolution française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ac04b9-3d95-4db3-aeee-255034d206a6",
                                "sense_id": "cc63a014-e46c-3282-be59-d6ba86a4776d",
                                "text": "Continue de publier que toute la nation, excepté une douzaine de tes bons amis, est feuillantisée, brissotisée, girondisée ;"
                            },
                            {
                                "example_id": "e57bb893-6a69-4525-8d41-b16e59763a94",
                                "sense_id": "cc63a014-e46c-3282-be59-d6ba86a4776d",
                                "text": "Vous demandez des preuves de votre ambition coalisée, et votre projet de feuillantiser l’État ?"
                            }
                        ]
                    }
