                                                "example_id": "edaea00b-d321-4cf2-89da-2019e77cc4b7",
                                                "sense_id": "3a44ee12-170a-3190-9e1c-5691d449cd0a",
                                                "text": "squeeze the udder to get milk"
                                            },
                                            {
                                                "example_id": "d2ea100e-0291-4864-97ac-cdb9c96bf8fd",
                                                "sense_id": "3a44ee12-170a-3190-9e1c-5691d449cd0a",
                                                "text": "The udder of the hyena, tied on the left arm, enticed the affection of any desired woman."
                                            }
                                        ]
