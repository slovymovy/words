                                                "example_id": "c3d7986a-4ccf-439e-9972-67ed4e0193d2",
                                                "sense_id": "7f6aa048-5887-3b8c-97b0-8d033315f3f1",
                                                "text": "„Brunei gab 2013 rund 402 Millionen US-Dollar für sein Militär aus.“"
