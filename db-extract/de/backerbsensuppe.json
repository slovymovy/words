                "senses": [
                    {
                        "sense_id": "98560bb8-18a8-33be-a460-b2dd56b14944",
                        "entry_id": "8a924a1a-2a53-387d-8719-ece4620eeb77",
                        "glosses": [
                            "klare Suppe mit Backerbsen als Einlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abcbfd7f-01ff-419c-8157-45b2576d10e3",
                                "sense_id": "98560bb8-18a8-33be-a460-b2dd56b14944",
                                "text": "„Wenn die Backerbsensuppe da ist, ess ich sie ganz gern, aber wenn sie nicht da ist, fehlt sie mir nicht.“"
                            },
                            {
                                "example_id": "7e03e5b8-3377-449b-a4ae-e06c8f13b4d4",
                                "sense_id": "98560bb8-18a8-33be-a460-b2dd56b14944",
                                "text": "„Die Tante machte mir manchmal eine Backerbsensuppe, die ich vorher nicht gekannt hatte.“"
                            },
                            {
                                "example_id": "b1085cb1-07fe-49ba-ab71-528dd40191cc",
                                "sense_id": "98560bb8-18a8-33be-a460-b2dd56b14944",
                                "text": "„Trotz der tropischen Hitze bleibt er entspannt, löffelt Backerbsensuppe und pfeift seinen Ohrwurm: ‚Dance Into the Light‘ von Phil Collins.“"
                            },
                            {
                                "example_id": "e1369fc6-3103-4604-9c5f-dcb89ef124ee",
                                "sense_id": "98560bb8-18a8-33be-a460-b2dd56b14944",
                                "text": "„Im Preis enthalten ist auch die Vorsuppe, alternativ Grießnockerl-, Frittaten- oder Backerbsensuppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
