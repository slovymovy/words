{
    "word_family": [
        "overbid",
        "bid",
        "bidder",
        "bidding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a28b793-3e23-3d0b-95ce-29ef405c3bd6",
                    "sense_definition": "The present participle and gerund of <w>overbid</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>overbidding</w> at the auction and ended up paying far too much.",
                            "target_lang_translations": {
                                "zh": "他在拍卖会上<w>出价过高</w>，结果付出的钱远超预期。"
                            }
                        },
                        {
                            "text": "The company lost money by consistently <w>overbidding</w> on construction contracts.",
                            "target_lang_translations": {
                                "zh": "这家公司因为在建筑合同上持续<w>竞价过高</w>而亏损。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 overbid 的现在分词和动名词形式，指在竞标或拍卖中出价过高。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出价过高",
                                "target_lang_sense_clarification": "指在竞标或拍卖中报出的价格超过了物品的实际价值或预算。"
                            },
                            {
                                "target_lang_word": "竞价过高",
                                "target_lang_sense_clarification": "特指在竞争性投标过程中报出过高的价格。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03ef162d-d0e1-32e1-9d82-5f3eee20eff5",
                    "sense_definition": "An excessively high offer made in an auction or bidding process.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The buyer realized his <w>overbidding</w> had ruined his profit margin.",
                            "target_lang_translations": {
                                "zh": "买家意识到他的<w>过高报价</w>毁掉了他的利润空间。"
                            }
                        },
                        {
                            "text": "Careful research helps prevent the <w>overbidding</w> that often occurs in competitive markets.",
                            "target_lang_translations": {
                                "zh": "仔细的研究有助于避免竞争激烈的市场中常出现的<w>溢价竞标</w>行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overpayment"
                    ],
                    "target_lang_definitions": {
                        "zh": "在拍卖或投标过程中提出的过高报价。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过高报价",
                                "target_lang_sense_clarification": "指在交易中提出的超出合理范围的报价。"
                            },
                            {
                                "target_lang_word": "溢价竞标",
                                "target_lang_sense_clarification": "指为了赢得竞标而支付高于市场价值的金额。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}