                                "target_word": "positon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                        "entry_id": "9e01d564-05be-3dd9-aa5f-91e4b6dc6c8c",
                                        "glosses": [
                                            "Antiparticule de l'électron."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dbbcde-2a58-40c2-9542-881628e893f1",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "Les positons issus d'une lame d'aluminium irradié"
                                            },
                                            {
                                                "example_id": "970498a3-1dd8-4241-be3a-51ba32e02e46",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "[…] on a pu déceler l'existence de corpuscules d'électricité positive ayant la même masse que l'électron avec une charge électrique égale et de signe contraire, les électrons positifs ou positons. Quel est alors le véritable corpuscule élémentaire d'électricité positive ? Est-ce le proton ou le positon ?"
                                            },
                                            {
                                                "example_id": "1cebf97f-d1e0-484f-9202-83d679ece2f5",
                                                "sense_id": "d3a4700f-087b-3de4-be8e-17718e090e56",
                                                "text": "[…] ce qui suggère une symétrie complète entre l'électron positif ou '''positon '' et l'électron négatif ou négaton, qui auraient ainsi mêmes masses avec des charges égales et contraires."
                                            }
                                        ]
                                    }
