                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb063a0b-0013-3a14-8eb5-6c486571aebe",
                        "entry_id": "5dadf4fb-9961-3fb5-8d40-cb5d18a3eadf",
                        "glosses": [
                            "een bedrijf dat zorgt dat men een water kan oversteken met een veerboot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fde7856-f2f4-42eb-b864-716ef0a211da",
                                "sense_id": "eb063a0b-0013-3a14-8eb5-6c486571aebe",
                                "text": "De vrouw die eind december in een gebouw van veerdienst TESO in Den Helder met een mes een andere vrouw gijzelde, blijft negentig dagen langer vastzitten. Dit meldt het Openbaar Ministerie (OM)."
                            },
                            {
                                "example_id": "f2f150ba-bfab-4102-ae50-2586624eab00",
                                "sense_id": "eb063a0b-0013-3a14-8eb5-6c486571aebe",
                                "text": "Het is nog niet precies duidelijk wat de oorzaak is van het ongeluk tussen Dinahican, ongeveer 75 kilometer ten oosten van hoofdstad Manila, en het eiland Polillo. De ferry had plaats voor 286 passagiers en was dus niet overvol, wat regelmatig het geval is bij Filipijnse veerdiensten. Wel was het slecht weer met hoge golven. Dat heeft zeer waarschijnlijk een rol gespeeld. De boot begon drie uur na vertrek uit de haven van Real water te maken, kapseisde en zonk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d22fc2ae-25b1-4082-aa28-c8c4dde4c613",
                        "source_entry_id": "5dadf4fb-9961-3fb5-8d40-cb5d18a3eadf",
                        "source_sense_id": "eb063a0b-0013-3a14-8eb5-6c486571aebe",
                        "target_lang_word": "ferry-boat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferry-boat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4201ea33-829a-3303-85c8-a8e5c1d3e1a1",
                                        "entry_id": "af0d7277-b773-3d1b-9a57-5c7729a1a73b",
                                        "glosses": [
                                            "Alternative form of ferryboat."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9c51e7-afc2-4d24-8d05-4c74a8c380f7",
                                                "sense_id": "4201ea33-829a-3303-85c8-a8e5c1d3e1a1",
                                                "text": "Three miles below town the ferry-boat stopped at the mouth of a woody hollow and tied up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e203873-27a3-4d3a-809b-6ee7e90587fc",
                        "source_entry_id": "5dadf4fb-9961-3fb5-8d40-cb5d18a3eadf",
                        "source_sense_id": "eb063a0b-0013-3a14-8eb5-6c486571aebe",
                        "target_lang_word": "ferry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ferry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa888d7-b68c-3357-bdfd-4e986833150f",
                                        "entry_id": "267bbce2-af2a-329c-8d13-08445c15b740",
                                        "glosses": [
                                            "To carry; transport; convey."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84817441-99d1-4585-ad2e-500c7f9c27d2",
                                                "sense_id": "6fa888d7-b68c-3357-bdfd-4e986833150f",
                                                "text": "Trucks plowed through the water to ferry flood victims to safety."
                                            },
                                            {
                                                "example_id": "58afa318-ff55-46e1-b216-4d0d9f9504ae",
                                                "sense_id": "6fa888d7-b68c-3357-bdfd-4e986833150f",
                                                "text": "We ferried our stock in U-Haul trailers, and across the months, as we purchased more cowflesh from the Goat Man — meat vanishing into the ether again and again, as if into some quarkish void — we became familiar enough with Sloat and his daughter to learn that her name was Flozelle, and to visit with them about matters other than stock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12260193-fdcc-3d42-aebf-c2e4688dc40b",
                                        "entry_id": "267bbce2-af2a-329c-8d13-08445c15b740",
                                        "glosses": [
                                            "To move someone or something from one place to another, usually repeatedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e7795e-20ec-40f6-ba55-1b0c261e3018",
                                                "sense_id": "12260193-fdcc-3d42-aebf-c2e4688dc40b",
                                                "text": "Being a good waiter takes more than the ability to ferry plates of food around a restaurant."
                                            },
                                            {
                                                "example_id": "943e3707-30cc-454a-be04-57e7bb7d2730",
                                                "sense_id": "12260193-fdcc-3d42-aebf-c2e4688dc40b",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays. […] This would also let high-speed trains skirt cities as moving platforms ferry passengers to and from the city centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0454ae0a-f6e3-3d99-b31c-fd11b7dedcf7",
                                        "entry_id": "267bbce2-af2a-329c-8d13-08445c15b740",
                                        "glosses": [
                                            "To carry or transport over a contracted body of water, as a river or strait, in a boat or other floating conveyance plying between opposite shores."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e82b206-9f36-3716-a532-1ba5ff3678d6",
                                        "entry_id": "267bbce2-af2a-329c-8d13-08445c15b740",
                                        "glosses": [
                                            "To pass over water in a boat or by ferry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f18172a-a6c9-457f-9714-b384ed2efba4",
                                                "sense_id": "7e82b206-9f36-3716-a532-1ba5ff3678d6",
                                                "text": "They ferry over this Lethean sound / Both to and fro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ferry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f97539b-3a64-3839-b96b-ca15ff53f331",
                                        "entry_id": "f855510c-2106-33ca-b7cd-65ed569802c8",
                                        "glosses": [
                                            "A boat or ship used to transport people, smaller vehicles and goods from one port to another, usually on a regular schedule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8086eed5-9d04-4219-8830-db22c560c8d4",
                                                "sense_id": "2f97539b-3a64-3839-b96b-ca15ff53f331",
                                                "text": "Near-synonym: ferryboat"
                                            },
                                            {
                                                "example_id": "5a7dddd8-bce6-4e97-8481-38cce916f57b",
                                                "sense_id": "2f97539b-3a64-3839-b96b-ca15ff53f331",
                                                "text": "To reach Mui Wo, a small town on Lantau Island, you take a ferry from central Hong Kong, and after a 30-minute ride arrive at a small square with a car park and bus stops blackened by fumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c4ad89-475c-317d-adf8-c279127b7a0b",
                                        "entry_id": "f855510c-2106-33ca-b7cd-65ed569802c8",
                                        "glosses": [
                                            "A place where passengers are transported across water in such a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4adf63c9-679e-4e43-b7f9-c66b2fc1cc45",
                                                "sense_id": "93c4ad89-475c-317d-adf8-c279127b7a0b",
                                                "text": "It can pass the ferry backward into light."
                                            },
                                            {
                                                "example_id": "23a6373a-c60e-4da1-90e9-66cddd8edcc0",
                                                "sense_id": "93c4ad89-475c-317d-adf8-c279127b7a0b",
                                                "text": "to row us o'er the ferry"
                                            },
                                            {
                                                "example_id": "a9b6de31-ccf6-41d2-8f09-554fc871f43d",
                                                "sense_id": "93c4ad89-475c-317d-adf8-c279127b7a0b",
                                                "text": "She walked into the waiting-room of the ferry, and up the stairs, and by a marvellous swift, little run, caught the ferry-boat that was just going out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dce1ae6c-5c30-3a68-9837-3b388f01c839",
                                        "entry_id": "f855510c-2106-33ca-b7cd-65ed569802c8",
                                        "glosses": [
                                            "The service constituted by this watercraft's operation; the business (company) that operates such a service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14189d5e-fa01-411b-9bf0-9dfd5c953a3a",
                                                "sense_id": "dce1ae6c-5c30-3a68-9837-3b388f01c839",
                                                "text": "In those days there was a ferry at Sleepytown. Modern roads and bridges for motor vehicles have rendered such local river ferries obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd60737-634b-3da2-9827-b8c4c735d64b",
                                        "entry_id": "f855510c-2106-33ca-b7cd-65ed569802c8",
                                        "glosses": [
                                            "The legal right or franchise that entitles a corporate body or an individual to operate such a service: a right of ferry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a07b54-95df-40e6-a6c1-041d2e898de7",
                                                "sense_id": "9dd60737-634b-3da2-9827-b8c4c735d64b",
                                                "text": "granted a ferry to"
                                            },
                                            {
                                                "example_id": "a57f6c40-e6fb-4bad-bb9e-c1c7d2456ab1",
                                                "sense_id": "9dd60737-634b-3da2-9827-b8c4c735d64b",
                                                "text": "In 1794, the county court of Mason, granted a ferry to Benjamin Sutton, who owned two lots on the front of water street.\nIn 1801, the same privilege was re-granted to him by the court.\nIn 1797, a ferry was granted to Edmund Martin, by the county court.\nIn 1808, a ferry was granted, by the county court, to Jacob Boon.\nIn 1818, a ferry was granted, by the court, to J. K. Ficklin, and in 1823, another ferry was granted, by the court, to Benjamin Baylies.\nBonds with security, were executed by the grantees respectively. The ferrys of Ficklin and Baylies have not been in operation for two or three years past. Those of Sutton, Martin and Boon, have been in operation ever since their establishment. Boon and Martin are both dead. Sutton sold his lots and ferry to Armstrong. Powers and Campbell, who attended to the ferrys granted to Boon and Martin, live in the state of Ohio. Armstrong resides in Maysville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
