                                            {
                                                "example_id": "4a80f92d-4fd5-4a8f-a6c7-295ff94497b5",
                                                "sense_id": "276949c7-5a5f-3a2d-bd77-1c2c2ff93c8a",
                                                "text": "Bei der Tatortbesichtigung zeigten sich die Ermittler über die Arbeit der Einbrecher erstaunt: „Sie haben die Wand genau an jener Stelle aufgestemmt, an deren Rückseite der Geldschrank gestanden ist“, erzählt ein Polizist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65d84419-0f6d-3807-b53f-f39bc7f83479",
                                        "entry_id": "b9213b0a-4653-3be9-9be5-395b69c65a1c",
                                        "glosses": [
                                            "(sich) mit viel Kraft aufstützen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b16803-2ea0-4e5b-af54-248938c90235",
                                                "sense_id": "65d84419-0f6d-3807-b53f-f39bc7f83479",
                                                "text": "Sie stemmte die Arme auf und blickte Frau Behrend herausfordernd an."
                                            },
                                            {
                                                "example_id": "d06e389c-8a1d-489e-8913-cb456bf90d9a",
                                                "sense_id": "65d84419-0f6d-3807-b53f-f39bc7f83479",
                                                "text": "Rubina stemmte die Füße auf, noch einmal, mit Nachdruck."
                                            },
                                            {
                                                "example_id": "196745be-2037-44f2-9a50-8e4276873250",
                                                "sense_id": "65d84419-0f6d-3807-b53f-f39bc7f83479",
                                                "text": "Mit verzerrtem Angesicht und gebleckten Zähnen versuchte er, sich aufzustemmen, um dem neuen König Salomos Thron einzuräumen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d351593-38e9-37e1-a6ed-d7878422cf18",
                                        "entry_id": "b9213b0a-4653-3be9-9be5-395b69c65a1c",
                                        "glosses": [
                                            "seinen Körper schwungvoll in den Stütz bringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23618e7-3a96-458d-b2a3-c3682891d171",
                                                "sense_id": "9d351593-38e9-37e1-a6ed-d7878422cf18",
                                                "text": "Erschwert werden kann die Übung, wenn nun aus dem gewinkelten Sitz, mit beispielsweise Knien in Holmnähe, in den Stütz aufgestemmt werden muss."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
