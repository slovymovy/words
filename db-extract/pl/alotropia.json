                        "translation_id": "e4375ff9-e795-4670-9e64-b0a551ea27fc",
                        "source_entry_id": "2c4f1aab-9bac-301a-878f-6c125b5db504",
                        "source_sense_id": "baec88d6-ada2-305b-852d-464775e8467d",
                        "target_lang_word": "allotropie",
                        "target_lang_code": "fr",
