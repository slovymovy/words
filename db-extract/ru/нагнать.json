                ],
                "translations": [
                    {
                        "translation_id": "0432cc07-76df-4f92-b7bf-cd66581e468c",
                        "source_entry_id": "cf022163-5d4d-3a9b-b5b0-d20a9b6b784f",
                        "source_sense_description": "догнать",
                        "target_lang_word": "catch up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catch up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8df64b26-fdb7-3efa-b4ae-18f2fc79a4dc",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To pick up suddenly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e308a1e6-46ec-45f5-8612-0adc7b3e2ea8",
                                                "sense_id": "8df64b26-fdb7-3efa-b4ae-18f2fc79a4dc",
                                                "text": "Oscar stopped the horses and waved to Carl, who caught up his hat and ran through the melon patch to join them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cd41e0-fa67-300f-8919-c4f7d5cfed2d",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To entangle (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea0648d9-8b00-4792-b3b6-8fb134721f5c",
                                                "sense_id": "b0cd41e0-fa67-300f-8919-c4f7d5cfed2d",
                                                "text": "The speaker wires have got caught up with the wires from the lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49779979-74ef-3fad-8951-5ab05a50f29a",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To involve in (something)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e285c0-d62f-46a4-ae55-006929a4f454",
                                                "sense_id": "49779979-74ef-3fad-8951-5ab05a50f29a",
                                                "text": "That's why she got caught up in addiction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd19678-5935-3ddb-afb2-0509a97edb27",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To be brought up to date with news."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71f2c00f-0e0f-4e53-9926-a6be1f31a186",
                                                "sense_id": "7bd19678-5935-3ddb-afb2-0509a97edb27",
                                                "text": "I hadn't seen her for so long. It was great to catch up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ba6151-23ba-3e4b-bac1-0f3dc66391f5",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To bring (someone) up to date with the news."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2623c1a-bbdb-45aa-b94a-34b50b90bcf8",
                                                "sense_id": "10ba6151-23ba-3e4b-bac1-0f3dc66391f5",
                                                "text": "After Alice's vacation, her boss caught her up on policy changes."
                                            },
                                            {
                                                "example_id": "c97a5406-51f2-4318-aba9-0a7f326b48ab",
                                                "sense_id": "10ba6151-23ba-3e4b-bac1-0f3dc66391f5",
                                                "text": "I have to miss the end of the meeting, but you can catch me up later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787f79d5-0b75-3d7d-8d92-10441de447ec",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To reach something that had been ahead."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5c0429-3f18-4f5f-b51d-880a9bee0264",
                                                "sense_id": "787f79d5-0b75-3d7d-8d92-10441de447ec",
                                                "text": "Rose was three seconds behind, but managed to catch up with the race leader and eventually won."
                                            },
                                            {
                                                "example_id": "99db129c-0829-4f43-a09d-433ddaa4675c",
                                                "sense_id": "787f79d5-0b75-3d7d-8d92-10441de447ec",
                                                "text": "I'll go ahead and you can catch up with me later."
                                            },
                                            {
                                                "example_id": "39ead065-e078-42cc-8751-a16114288d97",
                                                "sense_id": "787f79d5-0b75-3d7d-8d92-10441de447ec",
                                                "text": "But you run / And you run to catch up with the sun / But it's sinking"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c07dc97-8d37-38f9-b977-2aba0d9ed7be",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To compensate for or make up a deficiency."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cfb4221-550a-4fd7-ba7f-3f69e066a432",
                                                "sense_id": "1c07dc97-8d37-38f9-b977-2aba0d9ed7be",
                                                "text": "After a slow start, they've been catching up lately."
                                            },
                                            {
                                                "example_id": "e18ab864-d7c6-46c9-9c5c-7175260a58a3",
                                                "sense_id": "1c07dc97-8d37-38f9-b977-2aba0d9ed7be",
                                                "text": "The sales quarter ends soon and we've got to try to catch up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c9b3b6e-0774-3a02-8511-97697c2175bd",
                                        "entry_id": "125b2bef-944e-3f9f-8333-ad5a22dbb261",
                                        "glosses": [
                                            "To finally overtake (someone or something) after a long period of approaching (them or it)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77802a45-3faf-4b39-a214-92d364ffc24a",
                                                "sense_id": "6c9b3b6e-0774-3a02-8511-97697c2175bd",
                                                "text": "His years of drinking were catching up with him."
                                            },
                                            {
                                                "example_id": "40106b21-7a03-4130-b9a2-75e3fbdf1353",
                                                "sense_id": "6c9b3b6e-0774-3a02-8511-97697c2175bd",
                                                "text": "You are reminded that old age is catching up with you each time you read in the newspaper that another athlete whom you idolized when you were young just passed away."
                                            },
                                            {
                                                "example_id": "7f90da79-43be-4b49-bda9-1414760f6ff6",
                                                "sense_id": "6c9b3b6e-0774-3a02-8511-97697c2175bd",
                                                "text": "The episode begins with a lifetime of junk food, beer and no exercise catching up with Homer in the form of painful heart contractions."
                                            }
                                        ]
                                    }
                                ]
                            },
