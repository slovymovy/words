                "senses": [
                    {
                        "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                        "entry_id": "4adbf4f6-b3c9-317d-b404-93fc7b2c38ab",
                        "glosses": [
                            "eine finno-ugrische Sprache mit zwei Schriftvarianten, die in Nordwestrussland gesprochen wird; wird auch als Gruppe zweier Sprachen betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceacd367-08c4-41fc-a180-8b3d45ecb39c",
                                "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                                "text": "„Viele spezielle Einrichtungen pflegen die Komi-Sprache als Hauptsprache, beispielsweise das Komi-National-Gymnasium und die Finnisch-ugrische Fakultät der Universität.“"
                            },
                            {
                                "example_id": "69638b4f-fa05-44bd-a9b0-375805d49677",
                                "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                                "text": "„In anderen Dialekten der Komi-Sprache, die auf dem Territorium der Republik der Komi zu finden sind, stößt man nicht auf altertümliche lexikalische Entlehnungen aus dem Lappischen.“"
                            },
                            {
                                "example_id": "1cf8b08d-0449-4334-8c00-76d7c11a72f0",
                                "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                                "text": "„Die Adjektive der Komi-Sprache haben unterschiedliche Formen -i- und -id.“"
                            },
                            {
                                "example_id": "209b69c6-bcfb-4bd0-ad50-626bff3a6f64",
                                "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                                "text": "„Das Perm-Volk, das einen der Komi-Sprache sehr ähnlichen Dialekt spricht, benutzt auch das in der Komi-Sprache abgefaßte Schrifttum.“"
                            },
                            {
                                "example_id": "2c9e6359-59fb-472a-bd0f-6eecc7ce8784",
                                "sense_id": "e02ab835-8b30-32f8-8844-23afd249fc02",
                                "text": "„Auch in der Komi-Sprache soll früher eine besondere Bedeutung für den Fliegenpilz bestanden haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
