                {
                    "sense_id": "207bceef-3ffa-3ff7-a857-7ab5947d5579",
                    "sense_definition": "Qui garde ses distances, manifeste de la réserve ou de la froideur dans ses relations avec autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis leur dispute, il se montre particulièrement <w>distant</w> avec ses collègues.",
                            "target_lang_translations": {
                                "en": "Since their argument, he has been particularly <w>aloof</w> with his colleagues.",
                                "ru": "После их ссоры он с коллегами особенно <w>холоден</w>.",
                                "de": "Seit ihrem Streit verhält er sich seinen Kollegen gegenüber besonders <w>distanziert</w>.",
                                "es": "Desde su discusión, se muestra especialmente <w>distante</w> con sus compañeros.",
                                "zh": "自从他们吵了一架以后，他对同事特别<w>冷淡</w>。"
                            }
                        },
                        {
                            "text": "Elle a répondu à ma question avec un ton très <w>distant</w> et formel.",
                            "target_lang_translations": {
                                "en": "She answered my question in a very <w>cold</w> and formal tone.",
                                "ru": "Она ответила на мой вопрос очень <w>холодным</w> и официальным тоном.",
                                "de": "Sie antwortete auf meine Frage in einem sehr <w>kühlen</w> und förmlichen Ton.",
                                "es": "Respondió a mi pregunta con un tono muy <w>distante</w> y formal.",
                                "zh": "她用十分<w>冷淡</w>而正式的语气回答了我的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "froid",
                        "réservé"
                    ],
                    "common_phrases": [
                        "air distant",
                        "ton distant"
                    ],
                    "target_lang_definitions": {
                        "en": "Keeping others at a distance and showing reserve or coldness in dealings with people.",
                        "ru": "Держащий других на расстоянии и проявляющий сдержанность или холодность в общении с людьми.",
                        "de": "Anderen Menschen gegenüber auf Abstand bedacht und im Umgang zurückhaltend oder kühl.",
                        "es": "Que mantiene las distancias y muestra reserva o frialdad en el trato con los demás.",
                        "zh": "与人保持距离，对人态度冷淡、不热络的。"
                    },
