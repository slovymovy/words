                ],
                "senses": [
                    {
                        "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                        "entry_id": "efea83a1-f7dc-3f92-8e55-4e8df784792a",
                        "glosses": [
                            "Bereitschaft, sich im Spiel um Fairness, Regeltreue und eine gute Leistung zu bemühen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e1981c-c853-4cc2-badd-6e899b3e3e61",
                                "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                                "text": "„Letztlich hängt Piagets Lehre von der Heteronomie der Moral und damit auch der Spielmoral mit der vom Egozentrismus des Kindes eng zusammen.“"
                            },
                            {
                                "example_id": "377ca927-3256-4c91-bc6d-81892998162c",
                                "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                                "text": "„Das fast zwanghafte Begehren, der Beste zu sein, Sieger zu werden, Prämien und Preise zu kassieren, erweist sich häufig als mächtiger, denn die Spielmoral.“"
                            },
                            {
                                "example_id": "78b2b4e9-1870-4d81-97f9-c84793912283",
                                "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                                "text": "„Das sollte schlappe Spielmoral oder unfaires Mauern entmutigen.“"
                            },
                            {
                                "example_id": "99f5ed26-588c-4eb0-9dff-4da523a86ac7",
                                "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                                "text": "„Im Handballspiel konnte man bisher gut in der Mannschaft sein, ausschlaggebend für die Spielmoral, fair mit seinen Gegnern, initiativ bei Spielnachmittagen.“"
                            },
                            {
                                "example_id": "2d8d95de-25a3-4fbc-886c-7e89de261cb4",
                                "sense_id": "4614e718-9105-3e51-b19e-62bf84a8c8ed",
                                "text": "„Aber als neuester, für die Spielmoral höchst verderblicher Verstoß gilt die gemimte Tragödie der vorgeblichen Verletzung, um den Vergeltungsmaßnahmen des Schiedsrichters zu entgehen und sich gleichzeitig der Sympathien der Zuschauer zu versichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
