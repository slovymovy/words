                {
                    "sense_id": "725d8a6d-e644-3a7a-bed7-42b1813da40d",
                    "sense_definition": "Mouvement brusque, sec et irrégulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux train s'arrêtait en gare en produisant une violente <w>saccade</w> qui réveillait les passagers."
                        },
                        {
                            "text": "La vieille horloge mécanique fonctionnait par <w>saccades</w> irrégulières avant de s'arrêter complètement."
                        }
                    ],
                    "synonyms": [
                        "secousse",
                        "soubresaut"
                    ],
                    "common_phrases": [
                        "par saccades"
                    ]
                },
                {
                    "sense_id": "c333434b-48b5-3037-8eb0-b81ae325b574",
                    "sense_definition": "Mouvement rapide et discontinu de l'œil permettant de changer de point de fixation visuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'appareil enregistre chaque <w>saccade</w> des yeux pendant que le patient lit un texte sur l'écran."
                        },
                        {
                            "text": "Une <w>saccade</w> oculaire trop lente peut révéler certains troubles neurologiques chez l'adulte."
                        }
                    ],
                    "common_phrases": [
                        "saccade oculaire"
                    ]
                },
                {
                    "sense_id": "b15be44e-ce19-3ca1-af04-8f73c9207439",
                    "sense_definition": "Brusque et rude secousse imprimée à la bride d'un cheval en lui tirant les rênes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moniteur lui a interdit de donner une telle <w>saccade</w> pour faire ralentir le cheval."
                        },
                        {
                            "text": "Le cavalier appliqua une <w>saccade</w> brutale sur les rênes pour stopper immédiatement sa monture."
                        }
                    ],
                    "synonyms": [
                        "secousse"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23acbd27-447e-393d-b04e-115a0657cdc7",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>saccader</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chanteur débutant <w>saccade</w> son texte sans faire attention au rythme imposé par la musique."
                        },
                        {
                            "text": "Il faut qu'elle ne <w>saccade</w> plus sa respiration pour retrouver rapidement son calme."
