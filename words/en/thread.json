                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f8a8d1-2582-3e91-b3f8-af40868d003d",
                    "sense_definition": "A helical ridge on a screw, nut, or bolt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>screw</w> <w>thread</w> was stripped, making it impossible to tighten the bolt.",
                            "target_lang_translations": {
                                "ru": "<w>Резьба</w> винта была сорвана, что сделало невозможным затягивание болта."
                            }
                        },
                        {
                            "text": "You need to match the <w>thread</w> size of the pipe to the connector.",
                            "target_lang_translations": {
                                "ru": "Вам нужно подобрать размер <w>резьбы</w> трубы к соединителю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "screw thread",
                        "pipe thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Винтовая нарезка на болте, винте или гайке."
