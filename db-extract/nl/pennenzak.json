                "senses": [
                    {
                        "sense_id": "ff88103f-caac-34db-a03e-665426e4197f",
                        "entry_id": "33dbb7a2-c9ec-35e0-a339-dc69db1c2db8",
                        "glosses": [
                            "bergplaats voor pennen en andere kleine school benodigdheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56aceec-f893-47a8-89ba-fc11fa2778cf",
                                "sense_id": "ff88103f-caac-34db-a03e-665426e4197f",
                                "text": "“Anderlecht is de grootste club in België. De club waar ik als kind van droomde”, bekende Hein Vanhaezebrouck. “Als ik in de basisschool zat was alles wat in mijn pennenzak zat paars en wit. Later is dat geminderd, maar Anderlecht is altijd een ploeg geweest waar ik naar opgekeken heb.”"
                            },
                            {
                                "example_id": "683d365b-3a30-4c50-a73e-f296d6535059",
                                "sense_id": "ff88103f-caac-34db-a03e-665426e4197f",
                                "text": "Zelf vind ik het hele sinterklaasgebeuren commercieel compleet opgefokt. Ik kies als ouder om daar niet in mee te gaan. Dus geen Cars-pennenzakken en Mega Mindy-boekentassen, geen cd’s van K3."
                            }
                        ]
                    }
                ],
