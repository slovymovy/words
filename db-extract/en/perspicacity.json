                    },
                    {
                        "translation_id": "892a34d7-6702-4c64-819b-40783c5b7f3e",
                        "source_entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "source_sense_description": "The human faculty or power to mentally grasp or understand clearly",
                        "target_lang_word": "Scharfsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharfsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a99c0cc-cf61-32ac-9b1b-8f41ce5dd576",
                                        "entry_id": "db1e167d-0398-3eee-aed0-095e7eb8f804",
                                        "glosses": [
                                            "Fähigkeit, das Wesentliche an einer Sache im Kern zu erkennen; scharfer Verstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c2ff1a-2e9b-4d43-b234-a1d8c617bf5f",
                                                "sense_id": "0a99c0cc-cf61-32ac-9b1b-8f41ce5dd576",
                                                "text": "Mit analytischem Scharfsinn stellte A. Einstein, bei der Betrachtung der Schwerkraft, bereits vor 70 Jahren fest: Das unser Weltall nichts anderes ist, als das sich beim Urknall plötzlich der Raum auftat und die Zeit zu laufen begann; und es sich bei beiden begrifflichen Phänomenen eigentlich um den natürlichen Begriff der \"Raumzeit\" und dessen Aufteilung handelt."
                                            },
                                            {
                                                "example_id": "1b72cb7a-bf00-44f5-9110-cbde33cec97d",
                                                "sense_id": "0a99c0cc-cf61-32ac-9b1b-8f41ce5dd576",
                                                "text": "„Die Liebe wird nur in der Ungedult des Verlangens unvorsichtig; aber wenn es darum geht, die Wiederkehr eines Glücks zu betreiben, dem widrige Umstände Hindernisse in den Weg legen, wird die Liebe alles mit größtem Scharfsinn sehen und voraussehen.“"
                                            },
                                            {
                                                "example_id": "de83bbbb-12cd-42b6-980f-cf30543a1109",
                                                "sense_id": "0a99c0cc-cf61-32ac-9b1b-8f41ce5dd576",
                                                "text": "„Er liebt Rätsel, Wortspiele, Hieroglyphen und entwickelt bei ihrer Lösung oft einen Scharfsinn, der den mit dem Durchschnittsverstand begabten Menschenkindern unnatürlich erscheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
