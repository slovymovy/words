                "senses": [
                    {
                        "sense_id": "0fa6be31-cb0f-3162-aafb-2c575bac846a",
                        "entry_id": "4819bbb0-1403-349f-9cd2-6a526192880e",
                        "glosses": [
                            "Stimulateur cardiaque."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8e4cd3-43f6-43c7-bdee-9586f4fa5179",
                                "sense_id": "0fa6be31-cb0f-3162-aafb-2c575bac846a",
                                "text": "Les techniciens nous préparent, espérons-le, un avenir réjouissant, celui de l'effondrement du savoir. En effet, chacun disposera un jour, intime comme un pacemaker, et chacun saura, par quelque oreillette invisible, tout ce qu'il y a à savoir. Ainsi tout un chacun, sans effort, après seulement quelques apprentissages techniques enfantins, sera porteur du savoir universel"
                            },
                            {
                                "example_id": "de9c9785-d819-4dc0-af80-aa325fcf30ff",
                                "sense_id": "0fa6be31-cb0f-3162-aafb-2c575bac846a",
                                "text": "Sa mère rentre à peine d’Angleterre quand elle reçoit un appel de Kate : Olivia a fait un malaise peu après son départ, le médecin l’a envoyée à l’hôpital, on va tenter de lui poser un pacemaker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a53e7235-e840-4e74-85a2-428bd6486fb8",
                        "source_entry_id": "4819bbb0-1403-349f-9cd2-6a526192880e",
                        "source_sense_id": "0fa6be31-cb0f-3162-aafb-2c575bac846a",
                        "target_lang_word": "Herzschrittmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzschrittmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b06f611d-c1c2-3e21-ae8b-a54045e54533",
                                        "entry_id": "5dc82476-746a-3094-b06b-6f62a6460533",
                                        "glosses": [
                                            "externer oder interner (implantierter) elektrischer Impulsgeber für den Herzmuskel bei Patienten mit Herzrhythmusstörungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e53cd9a3-bbdf-438d-aa06-2c8f1025d163",
                                                "sense_id": "b06f611d-c1c2-3e21-ae8b-a54045e54533",
                                                "text": "„Neue Technologien werden die Medizin weiter verändern. Die neuesten Herzschrittmacher können schon jetzt eigenständig Signale an die Ambulanz senden, noch bevor der Patient merkt, dass er gleich umkippen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
