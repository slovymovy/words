                            "comment": "Can be sensitive; used within the community or medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с параличом всех четырех конечностей (квадриплегик).",
                        "zh": "四肢瘫痪者。"
                    },
                    "translations": {
