                "senses": [
                    {
                        "sense_id": "36214134-4475-3646-9bc4-fd930fa0f471",
                        "entry_id": "d6d83cc8-faad-3656-8045-7d3e9b73114e",
                        "glosses": [
                            "Kraft, die von der Achse eines Fahrzeugs auf den Untergrund ausgeübt wird; Gewicht, das auf jeweils eine Achse eines Fahrzeugs entfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90cc92a3-b575-49c5-bad3-39e6a9545391",
                                "sense_id": "36214134-4475-3646-9bc4-fd930fa0f471",
                                "text": "„In diesem Sinne werden die Bahnunternehmen den Oberbau im Gesamtbereich für eine Radsatzlast von 22,5 Tonnen ausbauen (UIC-Streckenklasse D 4).“"
                            },
                            {
                                "example_id": "8ae48e4e-199f-4d1f-8a60-4a6609334717",
                                "sense_id": "36214134-4475-3646-9bc4-fd930fa0f471",
                                "text": "„Der neue ICx soll laut Andersen auf eine Radsatzlast von fast 18 Tonnen kommen.“"
                            },
                            {
                                "example_id": "a8a3b877-3bd1-4378-b293-8bae78de7409",
                                "sense_id": "36214134-4475-3646-9bc4-fd930fa0f471",
                                "text": "„Das Lok-Fahrwerk SF4 ist für eine maximale Laufgeschwindigkeit von 230 km/h und einer Radsatzlast von 22,5 Tonnen ausgelegt.“"
                            },
                            {
                                "example_id": "a9a9cdbe-4f61-47fa-9c8d-4e0a9614f47d",
                                "sense_id": "36214134-4475-3646-9bc4-fd930fa0f471",
                                "text": "„Testfahrten mit schweren Zügen mit Radsatzlasten von 32,5 t sollen auf dem nördlichen Teil der Erzbahn (Malmbanan) zwischen Kiruna und Narvik im Dezember 2018 starten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
