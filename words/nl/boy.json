                },
                {
                    "sense_id": "12777363-b630-346a-bb71-93e05390b669",
                    "sense_definition": "Mannelijke bediende, met name in een voormalige koloniale context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bediende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische documenten werd de inlandse bediende vaak aangeduid als een <w>boy</w>.",
                            "target_lang_translations": {
                                "zh": "在历史文献中，土著仆人常被称为<w>男仆</w>。"
                            }
                        },
                        {
                            "text": "De familie liet de thee serveren door de <w>boy</w>.",
                            "target_lang_translations": {
                                "zh": "这家人让那位<w>男佣</w>来端茶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "djongos"
