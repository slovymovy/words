            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "d09b4380-e2ed-3a55-ba0d-5caa8990ad20",
                    "sense_definition": "odmieniona forma zaimka osobowego <w>ja</w> (występująca w dopełniaczu, celowniku, bierniku i miejscowniku)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Według <w>mnie</w> to jest najlepsze rozwiązanie tego problemu.",
                            "target_lang_translations": {
                                "ru": "По <w>моему</w> мнению, это лучшее решение этой проблемы.",
                                "en": "In <w>my</w> opinion, this is the best solution to this problem."
                            }
                        },
                        {
                            "text": "Czy możesz <w>mnie</w> jutro odwiedzić w szpitalu?",
                            "target_lang_translations": {
                                "ru": "Ты можешь навестить <w>меня</w> завтра в больнице?",
                                "en": "Can you visit <w>me</w> at the hospital tomorrow?"
                            }
                        },
                        {
                            "text": "Nie ma <w>mnie</w> teraz w domu, zadzwoń później.",
                            "target_lang_translations": {
                                "ru": "<w>Меня</w> сейчас нет дома, позвони позже.",
                                "en": "<w>I</w> am not at home right now, call later."
                            }
                        },
                        {
                            "text": "Daj to <w>mnie</w>, a nie jemu.",
                            "target_lang_translations": {
                                "ru": "Дай это <w>мне</w>, а не ему.",
                                "en": "Give that to <w>me</w>, not to him."
                            }
                        }
                    ],
                    "common_phrases": [
                        "według mnie",
                        "dla mnie",
                        "u mnie",
                        "o mnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "склоняемая форма личного местоимения <w>ja</w> (в родительном, дательном, винительном и предложном падежах)",
                        "en": "inflected form of the personal pronoun 'ja' (I), used in the genitive, dative, accusative, and locative cases"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меня",
                                "target_lang_sense_clarification": "родительный и винительный падежи"
                            },
                            {
                                "target_lang_word": "мне",
                                "target_lang_sense_clarification": "дательный и предложный падежи"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "me",
                                "target_lang_sense_clarification": "objective form of 'I'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cedc60fc-c0af-3156-86cc-1e0e9de590ba",
                    "sense_definition": "forma czasownika <w>miąć</w> (trzecia osoba liczby pojedynczej, czas teraźniejszy)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczynka nerwowo <w>mnie</w> rąbek swojej sukienki.",
                            "target_lang_translations": {
                                "ru": "Девочка нервно <w>мнёт</w> край своего платья.",
                                "en": "The girl nervously <w>crumples</w> the hem of her dress."
                            }
                        },
                        {
                            "text": "On <w>mnie</w> w dłoniach kawałek papieru, zastanawiając się nad odpowiedzią.",
                            "target_lang_translations": {
                                "ru": "Он <w>мнёт</w> в руках кусок бумаги, обдумывая ответ.",
                                "en": "He <w>crumples</w> a piece of paper in his hands, pondering the answer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mnie papier",
                        "mnie w dłoniach"
                    ],
                    "target_lang_definitions": {
                        "ru": "форма глагола <w>miąć</w> (третье лицо единственного числа, настоящее время)",
                        "en": "third-person singular present form of the verb 'miąć' (to crumple, wrinkle, or crease)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнёт",
                                "target_lang_sense_clarification": "сминать, комкать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "crumples",
                                "target_lang_sense_clarification": "crushes or wrinkles something into folds"
                            },
                            {
                                "target_lang_word": "creases",
                                "target_lang_sense_clarification": "wrinkles or folds fabric or paper"
                            }
                        ]
                    }
                }
            ]
        }
    ]
