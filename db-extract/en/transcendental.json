                "senses": [
                    {
                        "sense_id": "b1ac709f-da0a-36d3-b311-2f97d6e10868",
                        "entry_id": "42ce77da-b990-3178-b147-13682a76895b",
                        "glosses": [
                            "Transcendantal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b577a8e4-ae15-438d-8c6e-c2a4c2f19745",
                                "sense_id": "b1ac709f-da0a-36d3-b311-2f97d6e10868",
                                "text": "At least since Kant, transcendental philosophies have been on the scene. However, such simple demonstration of the possibility of transcendental philosophy has not been effective and is not likely to be so — so strong is the presumption that transcendental philosophy just could not be possible, or, if it was possible earlier, it is not possible now."
                            }
                        ]
                    },
                    {
                        "sense_id": "05dac0ca-09c4-3493-98f4-5c059e9be6a8",
                        "entry_id": "42ce77da-b990-3178-b147-13682a76895b",
                        "glosses": [
                            "Transcendant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589b8db5-efe9-4b28-8214-dafd33eca58b",
                                "sense_id": "05dac0ca-09c4-3493-98f4-5c059e9be6a8",
                                "text": "Suppose that F<E is purely transcendental. Show that any simple extension of F contained in E (but not equal to F) is transcendental over F."
                            }
                        ]
                    }
