{
    "word_family": [
        "clutter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4210cb44-b5e5-357f-b4a2-3bbe42be73ca",
                    "sense_definition": "To remove unnecessary items from a space to make it tidy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>declutter</w> my desk before I start working on this project.",
                            "target_lang_translations": {
                                "zh": "在开始做这个项目之前，我需要<w>清理</w>一下我的书桌。"
                            }
                        },
                        {
                            "text": "It is much easier to <w>declutter</w> the living room when you have storage boxes.",
                            "target_lang_translations": {
                                "zh": "有了收纳盒，<w>清理</w>客厅会容易得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dejunk",
                        "tidy"
                    ],
                    "common_phrases": [
                        "declutter the living room",
                        "declutter the office"
                    ],
                    "target_lang_definitions": {
                        "zh": "清理空间中不必要的物品，使其变得整洁。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清理",
                                "target_lang_sense_clarification": "指清除杂物或不必要的东西。"
                            },
                            {
                                "target_lang_word": "整理",
                                "target_lang_sense_clarification": "指通过收拾使物品变得有序。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fd1c629-304b-3572-8a41-27fedecd06bf",
                    "sense_definition": "The act or process of removing clutter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thorough <w>declutter</w> can make a small apartment feel much larger.",
                            "target_lang_translations": {
                                "zh": "彻底的<w>清理</w>能让小公寓看起来宽敞许多。"
                            }
                        },
                        {
                            "text": "She spent the entire weekend on a massive <w>declutter</w> of her basement.",
                            "target_lang_translations": {
                                "zh": "她整个周末都在对地下室进行大规模的<w>清理</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "清除杂物的行为或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清理",
                                "target_lang_sense_clarification": "指清除杂物的过程。"
                            },
                            {
                                "target_lang_word": "大扫除",
                                "target_lang_sense_clarification": "指彻底的清理和整理工作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}