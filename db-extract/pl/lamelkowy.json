                        "cross_references": [
                            {
                                "target_word": "lamellar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e2fcc1-280e-330f-b94e-5512747cdb28",
                                        "entry_id": "bd384db2-54eb-3aeb-8ac2-c7a149283795",
                                        "glosses": [
                                            "Of or pertaining to a lamella, plate-like, flat and thin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fca0bea-61c6-427e-babf-00de028540bb",
                                                "sense_id": "d2e2fcc1-280e-330f-b94e-5512747cdb28",
                                                "text": "Like scale armor (see cat, no. 38), lamellar armor was widely used in the ancient world, possibly originating in the Near East and spreading rapidly throughout Asia. Lamellar differs from scale armor in two principal ways."
                                            },
                                            {
                                                "example_id": "9ddb6872-6ed0-4772-80d9-6c7958475b72",
                                                "sense_id": "d2e2fcc1-280e-330f-b94e-5512747cdb28",
                                                "text": "The term “lamellar armor” refers to a type of armor made up of horizontal rows of small overlapping plates joined by leather lacing. The individual plates are referred to as lamella (singular) and lamellae (plural), literally meaning thin plates or ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
