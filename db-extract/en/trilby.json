                        "entry_id": "b1236c57-d907-3ff3-9abd-d7cbd71ee367",
                        "glosses": [
                            "Chapeau trilby, feutre (chapeau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55f1736-39c8-45a9-8bec-a123ed576f22",
                                "sense_id": "34d12361-9ad1-37cc-85aa-6dd80a6dd0b6",
                                "text": "The title is a slang reference to the hat worn by shady criminals at the time, not dissimilar to the Fedoras and Trilbies worn by gangsters in earlier American films."
                            },
                            {
                                "example_id": "ec1677e6-dd4b-4ace-86e5-eac2e36db5c1",
                                "sense_id": "34d12361-9ad1-37cc-85aa-6dd80a6dd0b6",
                                "text": "The name of this hat, trilby, is inspired by an eponymous novel by George du Maurier.",
                                "translation": "Le nom de ce chapeau, trilby, est inspiré d'un roman éponyme de George du Maurier."
                            }
                        ]
                    }
