                    {
                        "translation_id": "91b8b056-3dee-4134-8575-7305079b2d3a",
                        "source_entry_id": "30dc510b-7401-333e-b00c-f0dcf69aaba3",
                        "source_sense_id": "4ca53682-5211-3211-ba45-cd0326ec327f",
