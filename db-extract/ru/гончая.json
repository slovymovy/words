                                    {
                                        "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                        "entry_id": "7f28aef3-639d-3375-9d51-12cef6dbb5a3",
                                        "glosses": [
                                            "ein Hund, der speziell für die Jagd ausgebildet und trainiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b630ab4-ce52-452d-881c-5a70ffa55a91",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "Auch Jagdhunde müssen zu bestimmten Zeiten im Wald an die Leine."
                                            },
                                            {
                                                "example_id": "f0a06942-d4bb-4547-9307-2c7a6330e0fc",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Hill streunt durch das Leben wie ein Jagdhund, immer mit der Nase auf der Erde und mit aufgestellten Ohren.“"
                                            },
                                            {
                                                "example_id": "3812dd5c-7dbd-489a-a69a-63740564f911",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Wieder sah sie das Bild vor sich, wie sich die Jagdhunde geifernd und gierig auf ihren eigenen Herrn stürzten.“"
                                            },
                                            {
                                                "example_id": "402168ff-8885-42cd-8fe6-4651a6e029d9",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Der Jagdhund wedelte um das Haus herum.“"
                                            },
                                            {
                                                "example_id": "b09b10af-cd52-4f65-b0dc-137bdb8b9e1a",
                                                "sense_id": "c9145e35-ef7b-3d89-a743-d337838a4248",
                                                "text": "„Die Förster und Jäger auf dem Gut sollen sich über die gut ausgebildeten Jagdhunde gefreut haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
