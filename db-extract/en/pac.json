                "senses": [
                    {
                        "sense_id": "018c8c4f-6553-389d-9040-b73af5750709",
                        "entry_id": "94e0c6d5-10e0-3629-b925-01fa2a02861d",
                        "glosses": [
                            "Proto-Algic (compare PA, PAn)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac7dd5a-ce50-4fa5-b163-0c8d57919443",
                                "sense_id": "018c8c4f-6553-389d-9040-b73af5750709",
                                "text": "This seems to me to lead to the conclusion that any hypothesis involving connections earlier than the Algic level, given our standards for proof of historical connection, is inherently unprovable until we know Proto-Algic (PAc) better."
                            },
                            {
                                "example_id": "e9dccbe0-ba63-475c-b25d-d536f17e51d7",
                                "sense_id": "018c8c4f-6553-389d-9040-b73af5750709",
                                "text": "[…] PAc (Proto-Algic: Proulx 1984b)."
                            },
                            {
                                "example_id": "fdbe43da-6424-4c4d-bea6-68c6f897e67e",
                                "sense_id": "018c8c4f-6553-389d-9040-b73af5750709",
                                "text": "The reflexes of **l and **r are:\nPAc PA W Y\nl *l l(r) r(l)"
                            }
                        ]
