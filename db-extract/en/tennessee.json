                                            {
                                                "example_id": "c84fc28d-9b83-4f13-9cf7-18d20691297c",
                                                "sense_id": "32458c23-8fc1-3993-9799-2758bbffe54f",
                                                "text": "Проведённая учёными экспертиза показала, что камень, возможно, является фрагментом известного метеорита, обнаруженного в Теннесси в 1853 году."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "318d68ee-8c76-352e-9900-4e781c5c0593",
                                        "entry_id": "4cead3d6-02d4-3a8d-b0d9-b868f6466509",
                                        "glosses": [
                                            "река на востоке США; левый, самый длинный и многоводный приток реки Огайо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57c3f71-66cb-4540-a423-017fb6722459",
                                                "sense_id": "318d68ee-8c76-352e-9900-4e781c5c0593",
                                                "text": "Земли и охотничьи угодья наших племён нельзя охватить глазом орла с неба: от Отца Вод Миссисипи до Аллеганских гор и от скалистого ущелья, где беснуется чудовище Ниагары, до чистых вод реки Теннесси."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Теннесси́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "560ddb06-83d4-32e4-96c6-741980629c77",
                                        "entry_id": "77b442cd-5578-3396-beb0-dad226801986",
                                        "glosses": [
                                            "американское мужское и женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ddcf34-c7d0-4548-9454-1369b34c8f42",
                                                "sense_id": "560ddb06-83d4-32e4-96c6-741980629c77",
                                                "text": "Поклонники поздравили мальчика в комментариях и заметили, что Теннесси кажется им очень милым."
                                            },
                                            {
                                                "example_id": "3196d128-84bc-4fbb-8f57-470acb935485",
                                                "sense_id": "560ddb06-83d4-32e4-96c6-741980629c77",
                                                "text": "Король Португалии пожаловал Куку титул виконта Монсеррат, а через пять месяцев после его свадьбы с Теннесси Клафлин английская королева Виктория учредила баронетство Кук."
                                            }
                                        ]
                                    }
                                ]
                            }
