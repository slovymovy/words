{
    "word_family": [
        "раз",
        "разом",
        "разовый"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "008c2032-5198-30a6-94a1-5a8a815fe7bd",
                    "sense_definition": "Тотчас, немедленно, в тот же момент.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_immediate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>сразу</w> ответил на его письмо.",
                            "target_lang_translations": {
                                "en": "I answered his letter <w>immediately</w>.",
                                "zh": "我<w>马上</w>回复了他的信。",
                                "cs": "Na jeho dopis jsem <w>ihned</w> odpověděl."
                            }
                        },
                        {
                            "text": "Мы решили <w>сразу</w> пойти домой.",
                            "target_lang_translations": {
                                "en": "We decided to go home <w>right away</w>.",
                                "zh": "我们决定<w>立刻</w>回家。",
                                "cs": "Rozhodli jsme se jít <w>hned</w> domů."
                            }
                        }
                    ],
                    "synonyms": [
                        "тотчас",
                        "сейчас же",
                        "тут же",
                        "моментально",
                        "немедленно"
                    ],
                    "common_phrases": [
                        "сразу же",
                        "сразу после",
                        "не сразу",
                        "почти сразу"
                    ],
                    "target_lang_definitions": {
                        "en": "Immediately; without any delay; at that very moment.",
                        "zh": "立刻，马上，在同一时刻。",
                        "cs": "Ihned, bez prodlení, v ten samý okamžik."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immediately",
                                "target_lang_sense_clarification": "without delay"
                            },
                            {
                                "target_lang_word": "right away",
                                "target_lang_sense_clarification": "common informal phrase"
                            },
                            {
                                "target_lang_word": "at once",
                                "target_lang_sense_clarification": "instantly"
                            },
                            {
                                "target_lang_word": "straight away",
                                "target_lang_sense_clarification": "common in UK English"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马上",
                                "target_lang_sense_clarification": "表示动作发生得很快"
                            },
                            {
                                "target_lang_word": "立刻",
                                "target_lang_sense_clarification": "表示动作紧接着发生"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ihned",
                                "target_lang_sense_clarification": "bez odkladu"
                            },
                            {
                                "target_lang_word": "okamžitě",
                                "target_lang_sense_clarification": "v ten samý moment"
                            },
                            {
                                "target_lang_word": "hned",
                                "target_lang_sense_clarification": "běžné, neformální vyjádření"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61b9ee1b-e376-378f-9941-ba344794d749",
                    "sense_definition": "Единовременно, в один приём, всё вместе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_simultaneous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Невозможно делать два дела <w>сразу</w>.",
                            "target_lang_translations": {
                                "en": "It is impossible to do two things <w>at once</w>.",
                                "zh": "不可能<w>同时</w>做两件事。",
                                "cs": "Není možné dělat dvě věci <w>najednou</w>."
                            }
                        },
                        {
                            "text": "Он хотел получить всё и <w>сразу</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to get everything <w>at once</w>.",
                                "zh": "他想<w>一次性</w>得到所有东西。",
                                "cs": "Chtěl dostat všechno a <w>najednou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "единовременно",
                        "одним махом",
                        "зараз",
                        "одновременно"
                    ],
                    "common_phrases": [
                        "всё сразу",
                        "сразу два",
                        "сразу несколько"
                    ],
                    "target_lang_definitions": {
                        "en": "At the same time; simultaneously; all together.",
                        "zh": "同时，一次性，全部一起。",
                        "cs": "Současně, v jeden moment, všechno dohromady."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at once",
                                "target_lang_sense_clarification": "simultaneously"
                            },
                            {
                                "target_lang_word": "all at once",
                                "target_lang_sense_clarification": "everything together"
                            },
                            {
                                "target_lang_word": "simultaneously",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同时",
                                "target_lang_sense_clarification": "表示在同一时间进行"
                            },
                            {
                                "target_lang_word": "一起",
                                "target_lang_sense_clarification": "表示共同进行"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zároveň",
                                "target_lang_sense_clarification": "ve stejný čas"
                            },
                            {
                                "target_lang_word": "současně",
                                "target_lang_sense_clarification": "formálnější vyjádření"
                            },
                            {
                                "target_lang_word": "najednou",
                                "target_lang_sense_clarification": "všechno v jeden okamžik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34bf569-2c3c-350d-a6ff-78b780c0e870",
                    "sense_definition": "В непосредственной близости, прямо за чем-либо (в пространстве или времени).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За деревней <w>сразу</w> начинался густой лес.",
                            "target_lang_translations": {
                                "en": "A dense forest began <w>immediately</w> beyond the village.",
                                "zh": "村子后面<w>紧</w>接着就是一片茂密的森林。",
                                "cs": "Za vesnicí <w>hned</w> začínal hustý les."
                            }
                        },
                        {
                            "text": "Магазин находится <w>сразу</w> за углом.",
                            "target_lang_translations": {
                                "en": "The shop is <w>right</w> around the corner.",
                                "zh": "商店<w>就</w>在拐角后面。",
                                "cs": "Obchod je <w>hned</w> za rohem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сразу за"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Directly; right (used to emphasize close proximity in space or time).",
                        "zh": "直接，紧接着（用于强调空间或时间上的极近距离）。",
                        "cs": "Přímo, těsně za něčím (v prostoru nebo čase)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "used with prepositions (e.g., right after, right behind)"
                            },
                            {
                                "target_lang_word": "immediately",
                                "target_lang_sense_clarification": "formal proximity (e.g., immediately after)"
                            },
                            {
                                "target_lang_word": "directly",
                                "target_lang_sense_clarification": "straight (e.g., directly behind)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧",
                                "target_lang_sense_clarification": "用于表示紧挨着或紧接着"
                            },
                            {
                                "target_lang_word": "直接",
                                "target_lang_sense_clarification": "表示没有间隔"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hned",
                                "target_lang_sense_clarification": "zdůraznění těsné blízkosti"
                            },
                            {
                                "target_lang_word": "přímo",
                                "target_lang_sense_clarification": "bezprostředně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
