                                        "sense_id": "5c801735-9185-3f94-975f-a5d0cc5694d6",
                                        "entry_id": "2daee624-3c15-3565-ad4d-d6ff53b618c3",
                                        "glosses": [
                                            "The state, quality, or manner of being ethical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9279c7a4-980e-41d9-b20e-19f3649a59ac",
                                                "sense_id": "5c801735-9185-3f94-975f-a5d0cc5694d6",
                                                "text": "Some reformers and sociologists, though the majority stuck by the older internationalist ethicalities, began to adopt imperialist and group Social Darwinist views."
                                            },
                                            {
                                                "example_id": "3ba5e30f-5c98-452a-a676-3b9b820c7873",
                                                "sense_id": "5c801735-9185-3f94-975f-a5d0cc5694d6",
                                                "text": "As compared to the numerous studies focused on the incidence of student-faculty sexual involvement, few researchers have examined student perceptions of the ethicality of this form of sexual intimacy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
