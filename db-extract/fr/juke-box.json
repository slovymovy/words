        "fr-extract.jsonl": [
            {
                "entry_id": "e4fc3694-6a5e-3345-a400-ea9875a865cc",
                "word": "juke-box",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e07a7fbf-3a52-4d25-98f5-aa8c56a5b586",
                        "entry_id": "e4fc3694-6a5e-3345-a400-ea9875a865cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "juke-boxes"
                    },
                    {
                        "form_id": "daa67b67-7979-48b2-ae42-d1e2d3366767",
                        "entry_id": "e4fc3694-6a5e-3345-a400-ea9875a865cc",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "jukebox"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                        "entry_id": "e4fc3694-6a5e-3345-a400-ea9875a865cc",
                        "glosses": [
                            "Machine de bar qui diffuse de la musique, selon le choix des clients, et contre rétribution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5bbd55-0f34-4640-8623-6f64fef71133",
                                "sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                                "text": "Je me levai et je glissai cinq cents dans la fente du juke-box qui se trouvait là."
                            },
                            {
                                "example_id": "aaafb174-995d-467a-984d-188d1d04a1d1",
                                "sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                                "text": "Bébé commanda un thé et s’approcha du juke-box."
                            },
                            {
                                "example_id": "6d425e5f-7fe0-48ae-a435-1c6e1e5785fe",
                                "sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                                "text": "Elle était maquillée\nComme une star de ciné\nAccoudée au juke-box\nLa la la la."
                            },
                            {
                                "example_id": "340bacb8-ad9d-4308-9599-bf101a9b948a",
                                "sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                                "text": "Il y avait des juke-boxes. Exactement deux juke-boxes. Des filles en pantalons, chandails et longs cheveux, des couples d'amoureux qui s'embrassaient passionnément blottis l'un dans l'autre et dans l'arrière-salle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fed30e0-4c30-4fb3-bf9f-25abfe2b843f",
                        "source_entry_id": "e4fc3694-6a5e-3345-a400-ea9875a865cc",
                        "source_sense_id": "cc7ef308-9aa1-32ff-ad23-5f14a5e8fa03",
                        "source_sense_description": "Machine à musique fonctionnant contre rétribution.",
                        "target_lang_word": "jukebox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jukebox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10d33237-489c-311d-aaa5-423515cafcd1",
                                        "entry_id": "2f34d69d-e7f6-3a61-852b-2ea183cf486b",
                                        "glosses": [
                                            "A coin-operated machine that plays recorded music, with push-buttons to make selections."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5c76b8-c3d4-4a05-842e-a73383868832",
                                                "sense_id": "10d33237-489c-311d-aaa5-423515cafcd1",
                                                "text": "Glenn Miller plays more sweet numbers than hot. His greatest success has been with the “juke boxes”, the nickel-in-a-slot automatic phonographs. Miller is easily the most outstanding juke-box artist of 1939."
                                            },
                                            {
                                                "example_id": "81816928-35f9-4691-80d0-cdb138693de7",
                                                "sense_id": "10d33237-489c-311d-aaa5-423515cafcd1",
                                                "text": "\"I love rock 'n roll\nSo put another dime in the jukebox, baby\nI love rock 'n roll\nSo come and take your time and dance with me\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d7139f-acaf-3d64-8288-4cb72622b0aa",
                                        "entry_id": "2f34d69d-e7f6-3a61-852b-2ea183cf486b",
                                        "glosses": [
                                            "A software application capable of replaying tracks from a digital music collection."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1392fdf6-518c-4e89-9423-f459cbd3bbce",
                                                "sense_id": "91d7139f-acaf-3d64-8288-4cb72622b0aa",
                                                "text": "Before you export a movie to tape, double-check the following: Make sure all unnecessary programs are closed, including your e-mail program, MP3 jukebox, and Web browser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b6b8b6-ac26-3ef4-af14-42e28cdc992f",
                                        "entry_id": "2f34d69d-e7f6-3a61-852b-2ea183cf486b",
                                        "glosses": [
                                            "An automated carousel for the storage and retrieval of tapes, CD-ROMs, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cba8aa7-105b-3b72-a17e-a75bf85f0cba",
                                        "entry_id": "2f34d69d-e7f6-3a61-852b-2ea183cf486b",
                                        "glosses": [
                                            "Ellipsis of jukebox musical."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0860014f-ef06-45ad-a6cf-5bd7f2b6df9b",
                                                "sense_id": "0cba8aa7-105b-3b72-a17e-a75bf85f0cba",
                                                "text": "Jukeboxes have frequently been compared to the megamusicals and are considered a direct offshoot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jukebox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b36252c-21ce-3dd0-b62e-6cdbd5bd8f04",
                                        "entry_id": "e0f424cf-0f7d-3fc8-aab6-b50e3f329970",
                                        "glosses": [
                                            "To play and listen to music from a jukebox."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101283f1-0b01-4992-aedd-ffa013ad236b",
                                                "sense_id": "9b36252c-21ce-3dd0-b62e-6cdbd5bd8f04",
                                                "text": "Haven't you ever wasted money jukeboxing in the bars that are bathed in pastis and grenadine?"
                                            },
                                            {
                                                "example_id": "a900ef83-fe4c-4ebe-8355-8cd0ad687aa1",
                                                "sense_id": "9b36252c-21ce-3dd0-b62e-6cdbd5bd8f04",
                                                "text": "She'd been forty-four, him forty-two when they met, both of them drinking a little too much, both of them fed up with romance. She'd said she'd been jukeboxed half to death."
                                            },
                                            {
                                                "example_id": "b3dd863e-fe3d-4827-8e48-dd12fb89a545",
                                                "sense_id": "9b36252c-21ce-3dd0-b62e-6cdbd5bd8f04",
                                                "text": "Behind the counter, repairing a clogged sink and making chocolate egg creams at the same time, to jukebox riffs of Patti LaBelle singing \"I Sold My Heart to the Junkman,\" was the proprietor, Rudy."
                                            },
                                            {
                                                "example_id": "ca864263-c801-483d-89b5-3fffdf6fe7d8",
                                                "sense_id": "9b36252c-21ce-3dd0-b62e-6cdbd5bd8f04",
                                                "text": "In the Mayfield Days everybody smoked so they all smelled good, teeth as white and wild as urinal cakes, chattered and jukeboxed into the slurring sunset when the real drunks came in Fresh off some shift furnace soot still in their hair"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eba4443-278c-3e93-b931-039800bc5555",
                                        "entry_id": "e0f424cf-0f7d-3fc8-aab6-b50e3f329970",
                                        "glosses": [
                                            "To play (music or digital content) on a jukebox"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51762182-ee2b-4139-aa56-ea3ad4f7e092",
                                                "sense_id": "6eba4443-278c-3e93-b931-039800bc5555",
                                                "text": "They are everywhere today, whistled in the streets, broadcasted, jukeboxed, danced to in ballrooms."
                                            },
                                            {
                                                "example_id": "0bfaff2b-2394-4946-a559-eb42f572902c",
                                                "sense_id": "6eba4443-278c-3e93-b931-039800bc5555",
                                                "text": "BMI members are turning out some perfectly terrible songs which nevertheless are recorded and jukeboxed and played on the air."
                                            },
                                            {
                                                "example_id": "427a096a-7203-40f4-98b6-de8c7e60b6c4",
                                                "sense_id": "6eba4443-278c-3e93-b931-039800bc5555",
                                                "text": "I'm no longer thinking about TV as real time content streaming, but rather as file jukeboxing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa2728c-8cfe-32ed-a8b9-1555b095abca",
                                        "entry_id": "e0f424cf-0f7d-3fc8-aab6-b50e3f329970",
                                        "glosses": [
                                            "To play or repeat as if on a jukebox."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f096ec-3a20-4fc5-ab90-f20875e52714",
                                                "sense_id": "3fa2728c-8cfe-32ed-a8b9-1555b095abca",
                                                "text": "Foamy-chopped dogs frisk the pavements for barf-free kebab or hot dropped fry, mobiles trilling de-daw-de-dee theme tunes, their birdsong jukeboxing the cigarette air as rain falls from a plum sky ..."
                                            },
                                            {
                                                "example_id": "f61fef2e-5cea-4650-97a3-b3e7ed136b0e",
                                                "sense_id": "3fa2728c-8cfe-32ed-a8b9-1555b095abca",
                                                "text": "Another one of her sister's old records jukeboxed on in her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f438b448-f29a-325f-88ee-b3de25d937a5",
                                        "entry_id": "e0f424cf-0f7d-3fc8-aab6-b50e3f329970",
                                        "glosses": [
                                            "To format or set up for playing by a jukebox."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f39b9d-1ba7-4afa-95d4-8f4f2217f1dc",
                                                "sense_id": "f438b448-f29a-325f-88ee-b3de25d937a5",
                                                "text": "And best of all, per-document-stored cost will be substantially under what it is on spinning spindles alone or when the disks are jukeboxed."
                                            },
                                            {
                                                "example_id": "d3dcfc66-447f-44f2-aebc-ecf349237516",
                                                "sense_id": "f438b448-f29a-325f-88ee-b3de25d937a5",
                                                "text": "Whether discs holding only a hundred images, even if \"jukeboxed\" in a CD-ROM drive, will be of practical use for large image collections remains to be seen, but at the very least the Photo CD will offer a relatively inexpensive method of obtaining a modest collection of digitized color images."
                                            },
                                            {
                                                "example_id": "e89699f6-7de9-459f-9bff-4b074e3968b5",
                                                "sense_id": "f438b448-f29a-325f-88ee-b3de25d937a5",
                                                "text": "Jukeboxing can put nearly 20-36 GB of information at users disposal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
