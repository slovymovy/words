        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44813ab8-4424-30ff-858c-a163ad2fe7f2",
                    "sense_definition": "An act of dishonesty, fraud, or deception used to gain an unfair advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The widespread <w>cheating</w> scandal shocked the sports world.",
                            "target_lang_translations": {
                                "ru": "Скандал с массовым <w>жульничеством</w> потряс спортивный мир.",
                                "tr": "Yaygın <w>hile</w> skandalı spor dünyasını şok etti."
                            }
                        },
                        {
                            "text": "Academic <w>cheating</w> can lead to expulsion from the university.",
                            "target_lang_translations": {
                                "ru": "Академическое <w>жульничество</w> может привести к отчислению из университета.",
