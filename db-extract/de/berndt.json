                ],
                "senses": [
                    {
                        "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                        "entry_id": "9566a6a2-a580-34de-9e8e-0a0a6adb24a5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535af302-ce15-460a-83fc-3cc4613c1e38",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Frau Berndt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7de7ec56-8e04-46fc-8d7d-5dd62e0dc2c0",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Herr Berndt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3417945f-3bc1-407a-8ac8-b948af64c87c",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Die Berndts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fef3279b-a5b8-498d-ab0f-d2a6dc0b7ba8",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Der Berndt trägt nie die Schals, die die Berndt ihm strickt."
                            },
                            {
                                "example_id": "40428f7e-706a-4221-a1c9-73dd95465853",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berndt kommt, geht der Herr Berndt.“"
                            },
                            {
                                "example_id": "e55c3013-cf2a-4fac-8e9f-f5852312b488",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Berndt kommt und geht."
                            },
                            {
                                "example_id": "0194fe49-c590-45dd-9fcd-188b6a00f44c",
                                "sense_id": "5cdf0fbd-d696-355b-ae30-9ee67fbcaf14",
                                "text": "Berndts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
