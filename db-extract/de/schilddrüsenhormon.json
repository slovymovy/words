                "senses": [
                    {
                        "sense_id": "23decac6-ab35-372d-a806-f893ec5c56a9",
                        "entry_id": "668ad9b0-f8b6-36ee-b672-99e9718627bc",
                        "glosses": [
                            "Hormon, das in der Schilddrüse gebildet wird"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc116ac-2802-487f-bcce-fb2f10eadce5",
                                "sense_id": "23decac6-ab35-372d-a806-f893ec5c56a9",
                                "text": "„Davon raten wir ab, weil auch die Frage der Dosierung hier unklar ist. Schilddrüsenhormone, mit denen wir behandeln, sind chemisch hergestellt, aber ident zum menschlichen Schilddrüsenhormon.“"
                            },
                            {
                                "example_id": "8a30e888-218c-4123-abbb-b4656644f33e",
                                "sense_id": "23decac6-ab35-372d-a806-f893ec5c56a9",
                                "text": "„Dabei geht es darum, dem Körper die fehlenden Hormone zuzuführen. Gegeben wird das Schilddrüsenhormon Levothyroxin, auch L-Thyroxin genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
