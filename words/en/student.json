{
    "word_family": [
        "studious",
        "studiousness",
        "study",
        "studentship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                    "sense_definition": "A person who is formally enrolled at a school, college, or university.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>student</w> is reading a book in the library.",
                            "target_lang_translations": {
                                "ru": "<w>Студент</w> читает книгу в библиотеке."
                            }
                        },
                        {
                            "text": "Every <w>university</w> <w>student</w> must register for classes before the semester begins.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>студент</w> университета должен записаться на курсы до начала семестра."
                            }
                        }
                    ],
                    "antonyms": [
                        "teacher"
                    ],
                    "common_phrases": [
                        "university student",
                        "college student",
                        "high school student"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, официально зачисленный в школу, колледж или университет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "студент",
                                "target_lang_sense_clarification": "учащийся вуза или колледжа"
                            },
                            {
                                "target_lang_word": "ученик",
                                "target_lang_sense_clarification": "учащийся школы"
                            },
                            {
                                "target_lang_word": "учащийся",
                                "target_lang_sense_clarification": "общее название для тех, кто учится"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                    "sense_definition": "A person who takes a deep interest in or learns about a particular subject or life in general.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>student</w> of history, she spends her weekends visiting ancient ruins.",
                            "target_lang_translations": {
                                "ru": "Как <w>исследователь</w> истории, она проводит свои выходные, посещая древние руины."
                            }
                        },
                        {
                            "text": "He is a lifelong <w>student</w> of human behavior and social interactions.",
                            "target_lang_translations": {
                                "ru": "Он всю жизнь является <w>учеником</w>, изучающим человеческое поведение и социальные взаимодействия."
                            }
                        }
                    ],
                    "synonyms": [
                        "scholar",
                        "devotee",
                        "disciple"
                    ],
                    "common_phrases": [
                        "student of history",
                        "student of life",
                        "serious student"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который глубоко интересуется или изучает определенный предмет или жизнь в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исследователь",
                                "target_lang_sense_clarification": "человек, изучающий предмет"
                            },
                            {
                                "target_lang_word": "ученик",
                                "target_lang_sense_clarification": "последователь или приверженец учения"
                            },
                            {
                                "target_lang_word": "знаток",
                                "target_lang_sense_clarification": "человек, глубоко погруженный в тему"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36caea9c-f1a0-3247-93bd-903643e3786a",
                    "sense_definition": "A shortened form of <w>Student's</w>, often used in the names of specific products or publications.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to use the <w>student</w> version of the software for the demonstration.",
                            "target_lang_translations": {
                                "ru": "Редактор решил использовать <w>студенческую</w> версию программного обеспечения для демонстрации."
                            }
                        },
                        {
                            "text": "He bought a <w>student</w> edition of the textbook to save money.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>учебное</w> издание учебника, чтобы сэкономить деньги."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма от «студенческий», часто используемая в названиях конкретных продуктов или изданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "студенческий",
                                "target_lang_sense_clarification": "предназначенный для студентов"
                            },
                            {
                                "target_lang_word": "учебный",
                                "target_lang_sense_clarification": "версия для обучения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}