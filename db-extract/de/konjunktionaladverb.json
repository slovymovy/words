                        "sense_id": "2f043dc8-d2c6-357a-9b55-a6e5a75b8141",
                        "entry_id": "33accf54-233a-312b-8a18-36c52d7cdaad",
                        "glosses": [
                            "] ein Adverb mit koordinierender Funktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b205feed-fed0-4f61-96d1-8b937b504460",
                                "sense_id": "2f043dc8-d2c6-357a-9b55-a6e5a75b8141",
                                "text": "Konjunktionaladverbien sind Wörter wie \"außerdem\", \"dazu\", \"zusätzlich\". Konjunktionaladverbien verbinden einen Teilsatz oder Satz mit einem anderen."
                            },
                            {
                                "example_id": "ea2dbce7-c37d-4ac1-b2ec-b4726285ab1a",
                                "sense_id": "2f043dc8-d2c6-357a-9b55-a6e5a75b8141",
                                "text": "Verwendung des Konjunktionaladverbs \"außerdem\": \"Wir wollen spazieren gehen. Wir haben genug gearbeitet; außerdem ist draußen schönes Wetter.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
