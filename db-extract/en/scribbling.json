                            }
                        ]
                    },
                    {
                        "translation_id": "e96a1430-0522-465e-b698-0fea8c10a8c4",
                        "source_entry_id": "a3ba0db4-ba68-32ef-a04e-1e1f9b323885",
                        "source_sense_description": "that which has been scribbled",
                        "target_lang_word": "Gekritzel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gekritzel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                        "entry_id": "426ebd44-71a5-317b-9bbf-3cc56adeaae8",
                                        "glosses": [
                                            "etwas unordentlich, schwer erkennbar oder ohne große Sorgfalt Dahingeschriebenes oder -gemaltes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89607c9-e202-4f52-8cb8-79fc8995d920",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "Der Block neben dem Telefon enthielt schon einiges Gekritzel meiner Mutter, die während des Telefonierens stets kritzelte."
                                            },
                                            {
                                                "example_id": "f116f4cb-aa40-47fd-964c-aa973bd6c4e6",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "Deine Schrift ist furchtbar! Niemand kann ein solches Gekritzel entziffern!"
                                            },
                                            {
                                                "example_id": "c96a1cd1-634a-4e87-bce6-3b93d5ce81e5",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "„Ihr Gekritzel war nur schwer zu entziffern, aber was klar daraus hervorging war die Tatsache, daß sie wütend war.“"
                                            },
                                            {
                                                "example_id": "2e3b9677-2eb3-4e2f-9758-36df9176125b",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "„Aber das habe ich erst später gelesen, als ich versucht habe, sein Gekritzel zu entziffern.“"
                                            },
                                            {
                                                "example_id": "010d5006-3718-4461-9f9f-4e71fb7a8488",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "„Den Namen im Gästebuch kann man nicht lesen. Bloß ein Gekritzel.“"
                                            },
                                            {
                                                "example_id": "1f17a258-70b0-4373-a742-ffca1dffc4dd",
                                                "sense_id": "9aa31efc-4edc-369e-8084-c6d142938872",
                                                "text": "„Es muss eine Belastung für Sie sein, mein Gekritzel zu entziffern – Schrift wage ich es nicht zu nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
