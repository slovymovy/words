    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                "word": "eschatology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "71162ee5-bedd-4c99-88ee-b2e1a3416b2d",
                        "entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "tags": [
                            "plural"
                        ],
                        "form": "eschatologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d09941f-3d4e-3d38-a238-04113311fccc",
                        "entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "glosses": [
                            "A system of doctrines concerning final matters, such as death."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "57dc940c-27fc-45bb-b11c-8ab2ad1ec9c3",
                                "sense_id": "4d09941f-3d4e-3d38-a238-04113311fccc",
                                "text": "These final pages are as deeply pleasureful as they are moving. Their comic eschatologies are consistent with the spirit that informs all of “Ada,” the spirit that is underscored by the last syllable in Ada's name when it is pronounced correctly in “the Russian way with two deep, dark ‘a’s” — da!"
                            }
                        ]
                    },
                    {
                        "sense_id": "81a24da1-9546-3430-87c4-2e93cadd191c",
                        "entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "glosses": [
                            "The study of the end times—the end of the world, notably in Christian and Islamic theology, the second coming of Christ, the Apocalypse, or the Last Judgment."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21f6b677-e0bc-4ac9-bcd8-bd465f516ae1",
                                "sense_id": "81a24da1-9546-3430-87c4-2e93cadd191c",
                                "text": "Eschatology and proleptics aside, I think this is a really stupid way to read a mystery novel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fce4d3a-ee71-43a3-a54b-8777a4892d4e",
                        "source_entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "source_sense_description": "system of doctrines concerning final matters, such as death",
                        "target_lang_word": "eschatologie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eschatologie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf6ef50-d07e-3335-a42e-5efab03ec8d8",
                                        "entry_id": "8f2ddff2-55c9-39c8-bdb2-f02333f21e11",
                                        "glosses": [
                                            "leer over het einde van de wereld en het laatste oordeel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd4babf-d58c-4c69-8cca-e81d163b406b",
                                                "sense_id": "3bf6ef50-d07e-3335-a42e-5efab03ec8d8",
                                                "text": "Het paulinisch onderricht aangaande de eschatologie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1534658-7c12-480b-b3cb-dcb073fdc3cf",
                        "source_entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "source_sense_description": "system of doctrines concerning final matters, such as death",
                        "target_lang_word": "eschatologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eschatologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4de0fb-5bf3-37ef-9199-23ad49b16c9a",
                                        "entry_id": "0bb7c406-c015-398d-a08a-3caeed9b0f81",
                                        "glosses": [
                                            "Étude des idées, doctrines théologiques ou philosophiques relatives à la destinée de l’Homme après la fin du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8750057-c697-4dfa-b87d-d7d9c13ed6a5",
                                                "sense_id": "4b4de0fb-5bf3-37ef-9199-23ad49b16c9a",
                                                "text": "Les Physiologues d’Ionie énoncent la loi d’invariance universelle : « Rien ne se crée, rien ne se perd », qui exclut l’idée de commencements absolus, de création ex nihilo, d’eschatologie finale sans périodique retour."
                                            },
                                            {
                                                "example_id": "d5e300b4-36b6-4587-82d6-de876e82748b",
                                                "sense_id": "4b4de0fb-5bf3-37ef-9199-23ad49b16c9a",
                                                "text": "Vous devez comprendre que les sionistes religieux sont persuadés qu'Israël est entré dans une période eschatologique. Pour eux, tous les événements auxquels on assiste ont été décidés par Dieu. Le Messie va arriver. […]. En miroir, les djihadistes sont tout autant dans l’eschatologie. Le cheikh Ahmed Yassine, le fondateur du Hamas, avait établi une théologie fondée sur la sourate 17 du Coran et conclu qu'Israël disparaîtrait d'ici à 2027. […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e23fbadf-dcea-4a2a-b012-3b21d49c9a08",
                        "source_entry_id": "7ea2b691-cb0a-3a8d-9fb6-32283d8af78d",
                        "source_sense_description": "system of doctrines concerning final matters, such as death",
                        "target_lang_word": "Eschatologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eschatologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                        "entry_id": "608d32c9-4381-3ee5-9c85-3e583dc575d9",
                                        "glosses": [
                                            "Lehre von den „letzten Dingen“, das heißt die Lehre von Tod, Auferstehung und damit verbunden die Lehre vom Anbruch einer neuen Welt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af9abf1-dbca-4597-ad79-f1704f2bbbff",
                                                "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                                "text": "Die Eschatologie wird heute verstanden als die Lehre von den Hoffnungen auf Vollendung des Einzelnen (individuelle Eschatologie) und der gesamten Schöpfung (universale Eschatologie), die sich aus dem Glauben ergibt."
                                            },
                                            {
                                                "example_id": "b75fa6d3-f0a8-4350-a512-9b685d9b18b3",
                                                "sense_id": "6017ee45-1290-39f0-9609-861dc03bfd20",
                                                "text": "„Das theologisch mehrdeutige Wort Eschatologie (»Lehre von den letzten Dingen«) wird, auf die allgemeine Religionsgeschichte übertragen, meist als Synonym zu Jenseitsvorstellungen benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
