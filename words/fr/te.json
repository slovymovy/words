    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "095bc0f4-9b99-31c3-a912-4b4c04539b7d",
                    "sense_definition": "Pronom personnel de la deuxième personne du singulier, employé comme complément d'objet direct ou indirect de la personne à qui l'on s'adresse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronom_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>te</w> donne ce livre parce que je sais que tu aimes lire."
                        },
                        {
                            "text": "Mon ami, je <w>te</w> téléphonerai dès que je serai arrivé à la gare."
                        }
                    ],
                    "common_phrases": [
                        "je te remercie"
                    ]
                },
                {
                    "sense_id": "44c68467-0796-32ce-bd10-50c4db47e215",
                    "sense_definition": "Pronom personnel réfléchi ou réciproque de la deuxième personne du singulier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pronom_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce que tu <w>te</w> souviens de notre premier voyage ensemble à Paris ?"
                        },
                        {
                            "text": "Tu <w>te</w> prépares rapidement tous les matins avant de partir travailler."
                        }
                    ]
                },
                {
                    "sense_id": "d296dac0-c541-35b2-a75b-69ae1a2dba5d",
                    "sense_definition": "Pronom explétif employé pour interpeller l'interlocuteur ou apporter de la vivacité au récit (datif éthique).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pronom_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>te</w> prend son manteau et disparaît sans dire au revoir."
                        },
                        {
                            "text": "Et là, il <w>te</w> sort une excuse complètement invraisemblable devant tout le monde !"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "2421db72-5eb2-3fa9-a49d-7cad6292cd18",
                    "sense_definition": "Variante dialectale ou populaire de <w>tu</w>, pronom personnel sujet de la deuxième personne du singulier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pronom_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En attendant, <w>te</w> feras comme nous tous pour finir le travail."
                        },
                        {
                            "text": "Dis donc, <w>te</w> crois vraiment que tout le monde est d'accord ?"
                        }
                    ],
                    "synonyms": [
                        "tu"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "régional ou populaire"
                        }
                    ]
                }
            ]
        },
