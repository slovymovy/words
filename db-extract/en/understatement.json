                "word": "understatement",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e677bc35-99e5-46a2-9ff6-996daa1b9da4",
                        "entry_id": "883fb563-3988-3eec-b416-291f4fd68060",
                        "tags": [
                            "plural"
                        ],
                        "form": "understatements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77a3b31a-4235-3eeb-9b01-af232d2097f7",
                        "entry_id": "883fb563-3988-3eec-b416-291f4fd68060",
                        "glosses": [
                            "A figure of speech whereby something is made to seem smaller or less important than it actually is, either through phrasing or lack of emphasis, often for ironic effect."
                        ],
                        "tags": [
                            "rhetoric",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "df51f72c-d209-4191-8cbb-856b190d5032",
                                "sense_id": "77a3b31a-4235-3eeb-9b01-af232d2097f7",
                                "text": "A master of understatement"
                            },
                            {
                                "example_id": "5343ab5f-e6ae-4dcf-ba39-32805636797d",
                                "sense_id": "77a3b31a-4235-3eeb-9b01-af232d2097f7",
                                "text": "And that mode of expression is very demurring and self-deprecating. Victorian English was all about understatement."
                            }
                        ]
                    },
                    {
                        "sense_id": "235222cf-4120-36d5-af59-ee1d1b2719ae",
                        "entry_id": "883fb563-3988-3eec-b416-291f4fd68060",
                        "glosses": [
                            "An instance of such phrasing or lack of emphasis; an incomplete statement."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d9f45d-a1bb-4548-8e10-e5d0707290f4",
                                "sense_id": "235222cf-4120-36d5-af59-ee1d1b2719ae",
                                "text": "Now that's an understatement."
                            }
                        ]
                    },
                    {
                        "sense_id": "2925c08d-5808-3434-a049-593659441708",
                        "entry_id": "883fb563-3988-3eec-b416-291f4fd68060",
                        "glosses": [
                            "An incomplete disclosure that intentionally withholds relevant information."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
