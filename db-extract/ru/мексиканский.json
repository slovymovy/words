                                    {
                                        "sense_id": "f693bc58-1b9f-33cf-88d2-dea08bb4a769",
                                        "entry_id": "82b8819d-0d60-3e65-90a6-3dd1846d30c1",
                                        "glosses": [
                                            "zum Volk der Mexikaner gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79df9801-5281-4643-b2f1-4d1da744d88b",
                                                "sense_id": "f693bc58-1b9f-33cf-88d2-dea08bb4a769",
                                                "text": "Der mexikanische Schüler machte große Fortschritte im Erlernen der deutschen Sprache."
                                            },
                                            {
                                                "example_id": "70db0fec-b973-4b33-bed1-0553eb607302",
                                                "sense_id": "f693bc58-1b9f-33cf-88d2-dea08bb4a769",
                                                "text": "„Illegaler Holzschlag ist für mexikanische Banden und Kartelle ein lukratives Geschäft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56c9982e-17c6-30e4-8ce3-54bbd76c56d1",
                                        "entry_id": "82b8819d-0d60-3e65-90a6-3dd1846d30c1",
                                        "glosses": [
                                            "zu Mexiko gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4edc2a7-6cc8-4976-b795-be5873f1d5c7",
                                                "sense_id": "56c9982e-17c6-30e4-8ce3-54bbd76c56d1",
                                                "text": "Mexikanisches Essen ist oft stark gewürzt."
                                            },
