{
    "word_family": [
        "flame",
        "flamer",
        "flameless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe329fb4-0ea2-3304-b163-32d0d9427548",
                    "sense_definition": "Present participle of <w>flame</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry wood was <w>flaming</w> brightly in the fireplace all night.",
                            "target_lang_translations": {
                                "ru": "Сухие дрова ярко <w>пылали</w> в камине всю ночь."
                            }
                        },
                        {
                            "text": "Anger was visibly <w>flaming</w> in his eyes as he listened to the harsh accusation.",
                            "target_lang_translations": {
                                "ru": "Гнев заметно <w>полыхал</w> в его глазах, пока он слушал суровые обвинения."
                            }
                        }
                    ],
                    "synonyms": [
                        "blazing",
                        "burning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола flame (пылать, гореть ярким пламенем)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пылающий",
                                "target_lang_sense_clarification": "горящий ярким огнем"
                            },
                            {
                                "target_lang_word": "пылая",
                                "target_lang_sense_clarification": "деепричастие от пылать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a8fe8d9-ee28-30c5-bf4d-f1fffa59940c",
                    "sense_definition": "Burning brightly with visible fire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters stepped back from the <w>flaming</w> debris to avoid the intense heat.",
                            "target_lang_translations": {
                                "ru": "Пожарные отступили от <w>пылающих</w> обломков, чтобы спастись от невыносимого жара."
                            }
                        },
                        {
                            "text": "They watched the <w>flaming</w> torch light up the dark entrance of the cave.",
                            "target_lang_translations": {
                                "ru": "Они наблюдали, как <w>горящий</w> факел освещает темный вход в пещеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "blazing",
                        "burning",
                        "fiery"
                    ],
                    "common_phrases": [
                        "flaming torch",
                        "flaming debris"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко горящий видимым огнем; охваченный пламенем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пылающий",
                                "target_lang_sense_clarification": "объятый пламенем"
                            },
                            {
                                "target_lang_word": "горящий",
                                "target_lang_sense_clarification": "охваченный огнем"
                            },
                            {
                                "target_lang_word": "пламенеющий",
                                "target_lang_sense_clarification": "излучающий яркое пламя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17367f81-f1f3-3640-a2ab-2fcb5e68e47c",
                    "sense_definition": "Having an intensely bright, fiery color resembling a flame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We paused to admire the <w>flaming</w> sunset over the ocean.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы полюбоваться <w>пламенным</w> закатом над океаном."
                            }
                        },
                        {
                            "text": "She was known throughout the town for her striking <w>flaming</w> red hair.",
                            "target_lang_translations": {
                                "ru": "Она была известна на весь город своими эффектными <w>огненно-рыжими</w> волосами."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiery",
                        "glowing",
                        "brilliant"
                    ],
                    "common_phrases": [
                        "flaming sunset",
                        "flaming red hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий очень яркий, огненный цвет, напоминающий пламя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пламенный",
                                "target_lang_sense_clarification": "огненно-яркого цвета"
                            },
                            {
                                "target_lang_word": "огненный",
                                "target_lang_sense_clarification": "цвета пламени"
                            },
                            {
                                "target_lang_word": "ярко-красный",
                                "target_lang_sense_clarification": "насыщенный красный или рыжий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f45f937-06ff-370e-975f-295d7a95de72",
                    "sense_definition": "Used as an intensifier expressing annoyance or frustration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent an hour stuck in that <w>flaming</w> traffic jam this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я провел целый час, застряв в этой <w>чертовой</w> пробке."
                            }
                        },
                        {
                            "text": "Close the <w>flaming</w> window before the room gets any colder!",
                            "target_lang_translations": {
                                "ru": "Закрой же это <w>проклятое</w> окно, пока в комнате не стало еще холоднее!"
                            }
                        }
                    ],
                    "synonyms": [
                        "bloody",
                        "cursed",
                        "blasted"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild expletive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное усилительное слово, выражающее раздражение или досаду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертов",
                                "target_lang_sense_clarification": "выражение досады"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "выражение раздражения"
                            },
                            {
                                "target_lang_word": "долбаный",
                                "target_lang_sense_clarification": "грубо-разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "830629d1-c856-3a46-be11-bbcdbeca5154",
                    "sense_definition": "Characterized by intense passion, enthusiasm, or strong emotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She declared her opposition with a <w>flaming</w> passion that surprised everyone.",
                            "target_lang_translations": {
                                "ru": "Она заявила о своем несогласии с такой <w>пламенной</w> страстью, что удивила всех."
                            }
                        },
                        {
                            "text": "The orator delivered a <w>flaming</w> speech that stirred the crowd into action.",
                            "target_lang_translations": {
                                "ru": "Оратор произнес <w>пылкую</w> речь, побудившую толпу к действию."
                            }
                        }
                    ],
                    "synonyms": [
                        "fervent",
                        "ardent",
                        "passionate"
                    ],
                    "common_phrases": [
                        "flaming passion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличающийся сильной страстью, воодушевлением или бурными эмоциями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пламенный",
                                "target_lang_sense_clarification": "страстный, горячий"
                            },
                            {
                                "target_lang_word": "страстный",
                                "target_lang_sense_clarification": "эмоциональный и пылкий"
                            },
                            {
                                "target_lang_word": "пылкий",
                                "target_lang_sense_clarification": "наполненный энтузиазмом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "851266f2-39be-3fab-bab9-ab683a0a78f2",
                    "sense_definition": "Blatant, conspicuous, or impossible to overlook.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His extravagant outfit made him a <w>flaming</w> spectacle at the formal dinner.",
                            "target_lang_translations": {
                                "ru": "Его экстравагантный наряд превратил его в <w>кричащее</w> зрелище на официальном ужине."
                            }
                        },
                        {
                            "text": "She wore an outfit of such <w>flaming</w> eccentricity that nobody could ignore her.",
                            "target_lang_translations": {
                                "ru": "Она надела наряд столь <w>вопиющей</w> эксцентричности, что никто не мог пройти мимо."
                            }
                        }
                    ],
                    "synonyms": [
                        "blatant",
                        "conspicuous",
                        "glaring"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used emphatically or stereotypically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кричащий, вызывающий, бросающийся в глаза."
