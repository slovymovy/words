                    {
                        "translation_id": "4ac19f7d-8513-4212-851a-f0df40d4efa5",
                        "source_entry_id": "bd148128-e678-3a47-895a-39a494623657",
                        "source_sense_id": "b7af13d8-ba39-3213-90e1-6d6f10d949c7",
                        "source_sense_description": "Tierlaut des Schafes und der Ziege",
                        "target_lang_word": "бе",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бе",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9222cd72-2643-30fb-a58f-f567099efbf6",
                                        "entry_id": "1b156a55-23e6-3769-9b60-501f0860f11e",
                                        "glosses": [
                                            "о крике овцы, реже козы"
                                        ],
                                        "tags": [
                                            "звукоподр."
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "бе",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a89031c6-958f-3003-a196-08b674e6d96c",
                                        "entry_id": "a085a755-9f22-3d03-8439-624ffbc75d0d",
                                        "glosses": [
                                            "то же, что бэ; название буквы «Б» (кириллица)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9cc4eb-b7e2-4f2a-8e0c-f0c9fb6ede05",
                                                "sense_id": "a89031c6-958f-3003-a196-08b674e6d96c",
                                                "text": "А и бе сидели на трубе."
                                            },
                                            {
                                                "example_id": "76a4abdf-cb6e-4604-85b6-8f5781708eda",
                                                "sense_id": "a89031c6-958f-3003-a196-08b674e6d96c",
                                                "text": "Я скажу а, а бе не скажу, хоть разорвитесь и лопните"
                                            },
                                            {
                                                "example_id": "13b2c793-3283-4dbe-bdcf-54b46b19fe1f",
                                                "sense_id": "a89031c6-958f-3003-a196-08b674e6d96c",
                                                "text": "Раньше, при царе Николке, попы вас учили: а да бе, а как буквы в склады сложить, тому не учили"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50324607-1ce5-33cd-94eb-af24e48c3d88",
                                        "entry_id": "a085a755-9f22-3d03-8439-624ffbc75d0d",
                                        "glosses": [
                                            "то же, что бэ; название буквы «B» (латиница)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba12d57a-9f8c-4eb4-b9b3-75b506c8e2ee",
                                                "sense_id": "50324607-1ce5-33cd-94eb-af24e48c3d88",
                                                "text": "На повороте лестницы было створчатое, никогда не отворяемое, паутиной заросшее оконце, в переплёте которого один квадратик был из рубинового стекла, и эта кровоточащая рана среди других бесцветных клеток, а также её несимметричное расположение (ход коня, бе восемь — це шесть) всегда меня глухо тревожили"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бе",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "57bfc2ec-e565-3165-b100-fac6b4fcf8f0",
                                        "entry_id": "c84b8d46-7356-33aa-9aed-cfe0303affdf",
                                        "glosses": [
                                            "выражает отвращение (звукоподражание рвоте)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153c218d-da58-4954-a357-a8d8f7e1f586",
                                                "sense_id": "57bfc2ec-e565-3165-b100-fac6b4fcf8f0",
                                                "text": "Это мама выдала её замуж за Изюма, в скобках Исаак, он гинеколог мамы, старик лысый, бе, ему тридцать шесть лет"
                                            },
                                            {
                                                "example_id": "1e73d7d1-87ed-47c1-8de2-70082fa3fe1d",
                                                "sense_id": "57bfc2ec-e565-3165-b100-fac6b4fcf8f0",
                                                "text": "Фи. Даже не фи, а бе-е-е. Если девушка на свидании заводила разговор о «группах» и «дисках» — неважно о каких!"
                                            },
                                            {
                                                "example_id": "455f072b-0199-4d39-ae55-3b7ebe69956d",
                                                "sense_id": "57bfc2ec-e565-3165-b100-fac6b4fcf8f0",
                                                "text": "Похоже на ужастик. Бе-е-е, какой противный… Давай сумо смотреть дальше."
                                            },
                                            {
                                                "example_id": "645fed34-dcff-43d6-b43c-83a0e0c1581b",
                                                "sense_id": "57bfc2ec-e565-3165-b100-fac6b4fcf8f0",
                                                "text": "— Бе, — скривился Мишка и упал спиной в снег"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7d8219-e87d-30d0-bf8e-74ceb26f3013",
                                        "entry_id": "c84b8d46-7356-33aa-9aed-cfe0303affdf",
                                        "glosses": [
                                            "детск. шутл. выражает лёгкое злорадство, чувство превосходства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321956bb-aa06-428c-b5bb-f89999b5c5a4",
                                                "sense_id": "ed7d8219-e87d-30d0-bf8e-74ceb26f3013",
                                                "text": "Вас, девушка, уж точно не возьмут. Бе-бе-бе-бе"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
