                ],
                "senses": [
                    {
                        "sense_id": "41546b05-938b-3d23-8bfb-75672bf9a0db",
                        "entry_id": "270d3d94-95fe-3ab8-850a-233ba6c7f9bd",
                        "glosses": [
                            "durch Kriegsfolgen elternloses Kind aus Ostpreußen, das in der Endphase des Zweiten Weltkriegs und in der ersten Zeit danach auf sich allein gestellt versuchen musste, zu überleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c79ba9d-679b-4b90-b569-d3c65c33b62f",
                                "sense_id": "41546b05-938b-3d23-8bfb-75672bf9a0db",
                                "text": "„Das Schicksal der Wolfskinder beschäftigt mich schon lange.“"
                            },
                            {
                                "example_id": "2a699639-b8be-490a-9711-8079833ae97e",
                                "sense_id": "41546b05-938b-3d23-8bfb-75672bf9a0db",
                                "text": "„Sie wurden später unter dem Namen »Wolfskinder« bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "733e9d2b-06cc-3088-9899-d817556d235e",
                        "entry_id": "270d3d94-95fe-3ab8-850a-233ba6c7f9bd",
                        "glosses": [
                            "Kind, das isoliert von jeder menschlichen Gesellschaft in der Wildnis bei Wölfen (und anderen Tieren) aufwächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da713739-8820-443e-8f7e-ee26528a3917",
                                "sense_id": "733e9d2b-06cc-3088-9899-d817556d235e",
                                "text": "„Die Entdeckung eines Wolfskinds ist nicht nur eine wissenschaftliche Sensation, sie ist auch im landläufigen Sinne der Worte sensationell: Ein Wolfskind ist eine spektakuläre Erscheinung, die zu entsprechenden öffentlichen Spektakeln führt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "06124e18-ffa5-3ec2-9b12-f82818f1c5e1",
                        "entry_id": "270d3d94-95fe-3ab8-850a-233ba6c7f9bd",
                        "glosses": [
                            "junger, noch nicht ausgewachsener Wolf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86874bb5-690f-4df2-8aeb-2498773fa658",
                                "sense_id": "06124e18-ffa5-3ec2-9b12-f82818f1c5e1",
                                "text": "„Von da an sind die Wolfskinder ständig mit den Vögeln zusammen. Sie sehen die Raben nicht nur, sondern speichern auch den Geruch ihrer Federn im Gehirn.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
