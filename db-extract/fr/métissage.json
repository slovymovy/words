                                        "glosses": [
                                            "A mixing or blending, especially one which is considered to be inappropriate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d92589c-1d8c-4970-9438-3b5f1ad45c05",
                                                "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                                "text": "as is clear in the works of Nathaniel Hawthorne, it has a horror of any spiritual miscegenation between the human and the natural."
                                            },
                                            {
                                                "example_id": "490306d8-a8b5-4eae-af63-9f39f07fbdbd",
                                                "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                                "text": "... if a miscegenation of Latin and Sanskrit may be permitted."
