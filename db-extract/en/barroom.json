                                                "sense_id": "1ce8f3ad-f2e2-355a-b409-31cc718b4f50",
                                                "text": "„Wir aber gehorchten deiner Stimme nicht und wurden dem König von Babel nicht untertan.“ (Bar 2,24a)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
