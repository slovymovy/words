                        "sense_id": "0a7de4ea-7683-3cca-b9c6-608b1ad4574f",
                        "entry_id": "26e006b5-e408-301b-bd15-a385107da25a",
                        "glosses": [
                            "Celui qui est chargé de la programmation, qui doit répartir dans le temps des programmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad1bf8b-29b2-4760-a053-c2ad8f9585b6",
                                "sense_id": "0a7de4ea-7683-3cca-b9c6-608b1ad4574f",
                                "text": "Un programmateur de Radio France."
                            },
                            {
                                "example_id": "3dd99ccf-2c17-4d96-a13a-0071f5935df4",
                                "sense_id": "0a7de4ea-7683-3cca-b9c6-608b1ad4574f",
                                "text": "Le programmateur établit un ensemble de programmes de sa salle ou ses salles pour une durée déterminée, généralement une saison."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
