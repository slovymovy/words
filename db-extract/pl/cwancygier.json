                        "target_lang_word": "Zwanziger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwanziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d20d128-0ac5-34c7-808f-98532e524db3",
                                        "entry_id": "8583809b-f810-3d42-8532-6b45e00bbd75",
                                        "glosses": [
                                            "Geldschein oder seltener eine Münze mit dem Wert 20 Währungseinheiten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df65e0b1-9eed-4999-83bf-b1b48b072126",
                                                "sense_id": "7d20d128-0ac5-34c7-808f-98532e524db3",
                                                "text": "„Er warf einen Zwanziger auf den Tisch, stand auf und ging.“"
                                            },
                                            {
                                                "example_id": "540f0c15-343c-4922-a1c5-0a09ef0d482a",
                                                "sense_id": "7d20d128-0ac5-34c7-808f-98532e524db3",
                                                "text": "„1901 in Berlin geboren, Tochter aus großbürgerlichem Hause, begann sie in den Zwanzigern ihre Schauspielerkarriere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b27be96-bd0f-3559-9898-6b04f6429436",
                                        "entry_id": "8583809b-f810-3d42-8532-6b45e00bbd75",
                                        "glosses": [
                                            "drittes Jahrzehnt eines Jahrhunderts oder eines Lebens"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f580ff-0046-4537-a951-fcbcd8ddc2b4",
                                                "sense_id": "4b27be96-bd0f-3559-9898-6b04f6429436",
                                                "text": "„In den letzten Jahren waren sich die beiden noch näher gekommen, auch wegen Sandys dritter Frau Dorene Marcus, einer klugen, freundlichen, belesenen Anwältin – sie hatte das Werk ihres Schwagers gelesen, seit sie in den Zwanzigern war, und erfreute sich an den gespenstischen Ähnlichkeiten und Unterschieden zwischen den beiden Männern.“"
                                            },
                                            {
                                                "example_id": "a50b927d-8a45-4a5a-9c75-2052816c508a",
                                                "sense_id": "4b27be96-bd0f-3559-9898-6b04f6429436",
                                                "text": "„Das Haus ist irgendwann in den Zwanzigern abgebrannt.“"
                                            },
                                            {
                                                "example_id": "4f4301e7-6aae-4e17-adb4-1437389e563b",
                                                "sense_id": "4b27be96-bd0f-3559-9898-6b04f6429436",
                                                "text": "„Marian Willard, eine der Stammkundinnen aus den Zwanzigern, erbot sich sogar, eine New Yorker Dependance der »Freunde« zu eröffnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15ecd1c2-a3f3-3b57-91c2-f8da4e98d00a",
                                        "entry_id": "8583809b-f810-3d42-8532-6b45e00bbd75",
                                        "glosses": [
                                            "Person im Alter von 20 bis 29 Jahren"
                                        ],
