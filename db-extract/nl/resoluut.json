                "senses": [
                    {
                        "sense_id": "d4535ea1-e277-3bd8-863f-cf6336eca55b",
                        "entry_id": "c50260f2-1851-39c1-813e-ebd6a54e4bd2",
                        "glosses": [
                            "met veel daadkracht en zonder aarzeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e9b4da-97f0-45ea-a365-22682864f489",
                                "sense_id": "d4535ea1-e277-3bd8-863f-cf6336eca55b",
                                "text": "Zijn bewegingen zijn resoluut, zijn kin is hoog geheven. Wat Albert vooral ziet, is de heldere en directe blik van de luitenant. Een en al vastberadenheid. Opeens wordt hem alles duidelijk, alles."
                            },
                            {
                                "example_id": "e3c953df-7c63-4fee-9212-ab1a36e863db",
                                "sense_id": "d4535ea1-e277-3bd8-863f-cf6336eca55b",
                                "text": "Hij keek nog een keer naar de stad en draaide zich vervolgens resoluut om."
                            }
                        ]
                    }
