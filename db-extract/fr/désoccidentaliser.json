                "senses": [
                    {
                        "sense_id": "f7948707-6733-33b2-ba08-90b73fbc1048",
                        "entry_id": "f0d45edb-1d12-3440-8d5b-1c8ed5fe8ddf",
                        "glosses": [
                            "Faire perdre le caractère, les valeurs, les couleurs, les interprétations, les mœurs, de la civilisation occidentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8bac1dc-7fa7-4ce6-a6d0-24c0b7007e33",
                                "sense_id": "f7948707-6733-33b2-ba08-90b73fbc1048",
                                "text": "Les disques de musique venus d’Afrique ont désoccidentalisé et réafricanisé la musique et la danse populaire aux États-Unis."
                            },
                            {
                                "example_id": "d39a42c2-adaa-4e72-9e0a-0e998e5daa2f",
                                "sense_id": "f7948707-6733-33b2-ba08-90b73fbc1048",
                                "text": "Ce temps est pourtant révolu et, selon l'historien britannique Peter Frankpan, auteur d'un ouvrage mondialement acclamé, Les routes de la soie, où il désoccidentalise l’histoire du monde, certains Occidentaux ne semblent pas encore l'avoir compris."
                            }
                        ]
                    }
