                        "examples": [
                            {
                                "example_id": "a5c6d65a-f2d6-4cb9-9713-c2a823656a42",
                                "sense_id": "71d90d64-1219-35c5-999a-d23780fa0bcd",
                                "text": "De inkoopmanagersindex meet de bedrijvigheid in de Nederlandse industrie. De omvang van de productie lag in november een stuk hoger dan in oktober. Het aantal nieuwe orders is zelfs in 31 maanden niet zo sterk toegenomen."
                            },
                            {
                                "example_id": "7dd28866-333c-40ed-bea2-3b509291dadb",
                                "sense_id": "71d90d64-1219-35c5-999a-d23780fa0bcd",
                                "text": "Ook in Frankrijk, de tweede economie van de eurozone, wijst de inkoopmanagersindex voor november met 44,6 op een krimpende economie. In Frankrijk werd in het laatste kwartaal een minieme groei van 0,2 procent behaald, na eerder een nulgroei."
                            }
                        ]
                    }
