                "senses": [
                    {
                        "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                        "entry_id": "962d5060-34c1-3092-a5bc-1e237cce6636",
                        "glosses": [
                            "süßes, spiralförmiges Gebäck, das mit Zimt befüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61610945-bad9-4483-8685-b58e72add6d3",
                                "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                                "text": "Willst du eine Zimtschnecke?"
                            },
                            {
                                "example_id": "56ff0fcb-cd3b-4bb7-85d3-840f7755c1e0",
                                "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                                "text": "Ihr Vater liebt Zimtschnecken sehr."
                            },
                            {
                                "example_id": "d4af69e3-8aaf-4045-969f-43a1f0777726",
                                "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                                "text": "Zimtschnecken sind in Skandinavien besonders beliebt."
                            },
                            {
                                "example_id": "67b688a5-c12c-44b3-83b1-7fb49c682740",
                                "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                                "text": "„Sie begann sofort, Kaffee zu kochen und Zimtschnecken aufzutischen.“"
                            },
                            {
                                "example_id": "4f8f5867-a915-4a07-ab97-ac79f4fc2435",
                                "sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                                "text": "„Und dort wurden weiterhin die köstlichen Zimtschnecken gebacken, die er so liebte,die sogenannten Knoten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcf34ec3-59b9-46d2-94cf-c51f8aa2ba86",
                        "source_entry_id": "962d5060-34c1-3092-a5bc-1e237cce6636",
                        "source_sense_id": "f60251d4-4ce2-3437-9927-4534936698d6",
                        "source_sense_description": "süßes, spiralförmiges Gebäck, das mit Zimt befüllt ist",
                        "target_lang_word": "cinnamon roll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinnamon roll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef3a283-1cb2-3302-9f1e-7b5a81d9885b",
                                        "entry_id": "2b840c45-a5a2-3d21-9f0e-c05dcb5cab75",
                                        "glosses": [
                                            "A rolled pastry flavored with cinnamon and sugar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                        "entry_id": "2b840c45-a5a2-3d21-9f0e-c05dcb5cab75",
                                        "glosses": [
                                            "A person perceived as good, gentle and kind, often a fictional character who undergoes emotional suffering."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b180f0d-8a67-460f-92d0-64e515768ced",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "2016, Alexandra Petri, ComPost • Opinion (satire), The Washington Post\nObama: Merrick Garland is a beautiful cinnamon roll, too good for this world, too pure"
                                            },
                                            {
                                                "example_id": "150840c9-4741-4954-8f55-b01ab8d70ce3",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "Even as a 9-year-old girl, I had a thing for sweet, innocent cinnamon rolls – fictional characters who are too good for this world, too pure."
                                            },
                                            {
                                                "example_id": "981b20cc-7332-42cd-abfd-a3cd1bada901",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "“Vanessa, I will not complain about finding you in my bed,” he said, his voice soft and pliant. / “I missed you, cinnamon roll. Didn’t think you’d mind.”"
                                            },
                                            {
                                                "example_id": "7182be40-54b6-466f-bfba-bd2035b4b305",
                                                "sense_id": "dbdc11bd-788f-3448-bc97-eae73f596ffd",
                                                "text": "“Your soul?” Delia’s heart leaped at his words, and she met him halfway for a kiss. “You cinnamon roll.” She raked her fingers through his hair and smiled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
