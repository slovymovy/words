                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het regenwater verzamelde zich in een natuurlijke <w>kom</w> tussen de heuvels.",
                            "target_lang_translations": {
