                        "entry_id": "7468834d-0491-3594-8297-203f66e9404f",
                        "glosses": [
                            "Genre monospécifique de plante alpine (1200-3100 m altitude), essentiellement acaule, à feuilles glauques tomenteuses-cotonneuses de la famille des astéracées, formant une rosette basilaire au centre de laquelle fleurit un capitule unique, et qui est endémique des éboulis schisteux et calcaires des Alpes (Berardia)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae21a262-d811-3736-b518-6bf3ece60011",
                        "entry_id": "7468834d-0491-3594-8297-203f66e9404f",
                        "glosses": [
                            "Synonyme de bérardie laineuse (espèce de plantes) (Berardia lanuginosa)."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": []
                    }
                ],
