                "senses": [
                    {
                        "sense_id": "4e92eec4-a6cc-367f-8861-39de6ead6999",
                        "entry_id": "7b09b665-5350-3313-b205-50598bea5878",
                        "glosses": [
                            "Qui a beaucoup de branches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1664d7e-d85d-4708-b6dd-416a5606063f",
                                "sense_id": "4e92eec4-a6cc-367f-8861-39de6ead6999",
                                "text": "Un arbre fort branchu."
                            },
                            {
                                "example_id": "947b3b31-46e2-49d9-a369-1f0632b218ce",
                                "sense_id": "4e92eec4-a6cc-367f-8861-39de6ead6999",
                                "text": "Ainsi parle Jean-Marie Defossez, qui exerce un nouveau métier, plus branchu que branché : sylvothérapeute. En d’autres termes, celui qui soigne par… les arbres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a73022d-72cc-42bb-8051-f081ace3835e",
                        "source_entry_id": "7b09b665-5350-3313-b205-50598bea5878",
                        "source_sense_id": "4e92eec4-a6cc-367f-8861-39de6ead6999",
                        "target_lang_word": "branchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "branchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                        "entry_id": "86f23ee5-1b40-300c-bdcf-387e29adca7e",
                                        "glosses": [
                                            "Having many branches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178e9d51-a85f-40a5-b132-175eadb36ced",
                                                "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                                "text": "The shrub was too branchy. It needed to be pruned so it would have a few strong shoots instead of many weak ones."
                                            },
                                            {
                                                "example_id": "a4628c1b-9997-4d3d-8359-c7d66d54819a",
                                                "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                                "text": "1795, William Blake, The Book of Los, Chapter II, lines 92-4, in Blake: The Complete Poems, 3rd edition, Routledge, 2007, p. 288,\n[…] there grew / Branchy forms, organizing the Human / Into finite inflexible organs,"
                                            },
                                            {
                                                "example_id": "6c853e3f-de93-4fd9-a6a1-e2032d7526a7",
                                                "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                                "text": "No branchy thicket shelter yields; / But blessed forms in whistling storms / Fly o'er waste fens and windy fields."
                                            },
                                            {
                                                "example_id": "9b727637-dfe2-4b71-9a1a-45776d5c782f",
                                                "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                                "text": "[T]he trees blew stedfastly one way, never writhing round, and scarcely tossing back their boughs once in an hour; so continuous was the strain bending their branchy heads northward— […]"
                                            },
                                            {
                                                "example_id": "aebcbf23-0380-41f6-a47e-f7918b8144d6",
                                                "sense_id": "93c57569-07b4-3494-bd6f-c0a3cdb84cc7",
                                                "text": "Towery city and branchy between towers; / Cuckoo-echoing, bell-swarmèd, lark-charmèd, rook-racked, river-rounded; / The dapple-eared lily below thee; that country and town did / Once encounter in, here coped and poisèd powers; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd3a5eb-d469-3f38-a862-607654eec8ea",
                                        "entry_id": "86f23ee5-1b40-300c-bdcf-387e29adca7e",
                                        "glosses": [
                                            "Tending to branch frequently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
