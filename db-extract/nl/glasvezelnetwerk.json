                        "examples": [
                            {
                                "example_id": "cd5b05b6-3f97-422e-96c6-878299135154",
                                "sense_id": "510be2a0-9aed-31bb-98cf-dcfddabdd7af",
                                "text": "Het Britse Cable en Wireless is eigenaar van het grootste glasvezelnetwerk in Groot-Brittannië. Het bedrijf werd in de 19e eeuw opgericht om delen van het Britse Rijk met elkaar te verbinden. Het was betrokken bij de aanleg van de eerste telecomkabels onder zee."
                            },
                            {
                                "example_id": "4533cdcf-c52d-48bd-acc8-17ad76f15861",
                                "sense_id": "510be2a0-9aed-31bb-98cf-dcfddabdd7af",
                                "text": "Door de kabels in de bestaande riolering te schuiven, hoeft er nauwelijks gegraven te worden en kunnen boerderijen veel goedkoper aan het glasvezelnetwerk worden aangesloten. De kabel wordt vlakbij een woning weer uit de riolering gehaald."
                            }
