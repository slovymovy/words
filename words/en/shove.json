                        "zh": "用桨或篙把船从岸边或码头推开。",
                        "cs": "Odtlačit loď od břehu nebo mola pomocí vesla či tyče."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчаливать",
                                "target_lang_sense_clarification": "отплывать от берега"
                            },
                            {
                                "target_lang_word": "отталкиваться",
                                "target_lang_sense_clarification": "удаляться, упираясь во что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撑离岸边",
