                "senses": [
                    {
                        "sense_id": "510536ab-25ff-36da-b9c6-b950f9705bf9",
                        "entry_id": "2ebe3d38-0ebb-3424-89fa-6995863b98bc",
                        "glosses": [
                            "bildgebendes Verfahren, das vor allem in der medizinischen Diagnostik eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab35c8db-af6e-4532-81a0-d3a090657502",
                                "sense_id": "510536ab-25ff-36da-b9c6-b950f9705bf9",
                                "text": "Die Magnetresonanztomographie basiert auf sehr starken Magnetfeldern sowie elektromagnetischen Wechselfeldern im Radiofrequenzbereich, mit denen bestimmte Atomkerne im Körper resonant angeregt werden."
                            },
                            {
                                "example_id": "0107fc01-8ec5-4e55-a037-bba489e9da1b",
                                "sense_id": "510536ab-25ff-36da-b9c6-b950f9705bf9",
                                "text": "„Bei Frauen ist sogar zusätzlich ein Bereich im rechten Stirnhirn aktiv, wie der Neuroradiologe Michael Forsting und seine Kollegin Elke Gizewski mit Hilfe der funktionellen Magnetresonanztomographie herausfanden.“"
                            }
                        ],
