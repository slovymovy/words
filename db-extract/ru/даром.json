                "senses": [
                    {
                        "sense_id": "48c2cc6e-1c1a-3441-b59b-fcb72cefedb2",
                        "entry_id": "6cc05fee-c056-3681-8a7b-7398d27d5a90",
                        "glosses": [
                            "без компенсации, бесплатно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f18825-6fde-4321-b504-cdf97a751e08",
                                "sense_id": "48c2cc6e-1c1a-3441-b59b-fcb72cefedb2",
                                "text": "Девчата мои вяжут как огнючки. Ныне — хоть даром отдавай. Не берут."
                            }
                        ]
                    },
                    {
                        "sense_id": "80767563-7919-301e-8e9b-7c901465d576",
                        "entry_id": "6cc05fee-c056-3681-8a7b-7398d27d5a90",
                        "glosses": [
