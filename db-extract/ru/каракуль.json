                                            "futro ze skór jagniąt karakułów"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bd2fdc-e3fb-47d1-915b-26f33d32d63e",
                                                "sense_id": "356120db-38aa-33bf-b332-96f025cd92c9",
                                                "text": "Kupiłam sobie czarne karakuły."
                                            },
                                            {
                                                "example_id": "87032ce4-383a-4e11-847a-b1f55cb2575c",
                                                "sense_id": "356120db-38aa-33bf-b332-96f025cd92c9",
                                                "text": "Z budynku wyszła kobieta w karakułach."
                                            }
