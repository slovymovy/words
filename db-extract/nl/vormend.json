                "forms": [],
                "senses": [
                    {
                        "sense_id": "80da00a5-429f-3183-a742-6b4bbdc63bfa",
                        "entry_id": "07c676c0-ebbc-3c45-994b-2a89588c4275",
                        "glosses": [
                            "bezig met iets te maken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "13da93c7-1519-38b4-a99f-35425d347de6",
                        "entry_id": "07c676c0-ebbc-3c45-994b-2a89588c4275",
                        "glosses": [
                            "van iets dat het belangrijk is voor de ontwikkeling van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bcacfcb-47c3-49ca-8abe-6db1ece4eb89",
                                "sense_id": "13da93c7-1519-38b4-a99f-35425d347de6",
                                "text": "De verhalen van zijn vader over diens werkloosheid hebben een vormende rol gespeeld in het verdere leven van Wim Kok."
                            },
                            {
                                "example_id": "9dda552f-e992-4431-93ad-3492017ad37b",
                                "sense_id": "13da93c7-1519-38b4-a99f-35425d347de6",
                                "text": "Voormalig atleet Lundvik – hij legde de 100 meter ooit ruim binnen de 11 seconden af – werd geboren in Londen. Daar werd hij geadopteerd door Zweedse expats die na zes terug verhuisden naar Zweden, waar hij de enige zwarte jongen op school bleek. “Een vormende periode,’’ zegt hij daarover. “In Londen was iedereen anders. In Zweden was ik ineens een uitzondering.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e6e3c89-be54-42d3-bb47-22cc6e030dab",
                        "source_entry_id": "07c676c0-ebbc-3c45-994b-2a89588c4275",
                        "source_sense_id": "80da00a5-429f-3183-a742-6b4bbdc63bfa",
                        "source_sense_description": "van iets dat het belangrijk is voor de ontwikkeling van iemand",
                        "target_lang_word": "educational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "educational",
