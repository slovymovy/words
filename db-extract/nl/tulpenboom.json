                        "entry_id": "3973b74b-62d9-38e8-ba65-1824e94b2eec",
                        "glosses": [
                            "Liriodendron een geslacht van planten uit de Magnoliaceae-familie (Tulpenboomfamilie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "907c09a0-f64c-4ec5-b74e-645c9a13e4f6",
                                "sense_id": "4f4b0741-7f97-3132-a055-f10d199fdc4c",
                                "text": "Ze was dol op de tuin bij Morley Cottage, met zijn uitzicht op Lyme Bay en een reusachtige honderdjarige tulpenboom in een hoek."
                            },
                            {
                                "example_id": "e1ac1cf4-9fdd-4447-8a55-c625fc774179",
                                "sense_id": "4f4b0741-7f97-3132-a055-f10d199fdc4c",
                                "text": "Boomkweker Pieter van den Berk uit Sint-Oedenrode ziet dat bepaalde zuidelijke boomsoorten als de honingboom en de tulpenboom het steeds beter doen in Nederland, maar aan olijfbomen en palmbomen waagt hij zich nog niet."
                            }
                        ]
                    }
