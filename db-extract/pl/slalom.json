                "translations": [
                    {
                        "translation_id": "11a9d4d0-ddac-47eb-af8a-1518b3924ad8",
                        "source_entry_id": "af57eb9d-ac9f-3ab8-acfb-7f844027a03e",
                        "source_sense_id": "02c77d15-6375-347f-b090-78f7287e5de7",
                        "target_lang_word": "slalom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slalom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc56cde-1320-3e56-ba09-03f900fdfbe2",
                                        "entry_id": "5c741ce2-4e95-3097-a2bf-1dc2fe021349",
                                        "glosses": [
                                            "The sport of skiing in a zigzag course through gates."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d4e4de-6384-4c9a-a2b6-d088e1d7679a",
                                                "sense_id": "dbc56cde-1320-3e56-ba09-03f900fdfbe2",
                                                "text": "Slalom is her strongest Olympic sport."
                                            },
                                            {
                                                "example_id": "790fbdc3-0b6e-4984-b2e4-afa80896d1a0",
                                                "sense_id": "dbc56cde-1320-3e56-ba09-03f900fdfbe2",
                                                "text": "The slalom gates are set closer together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e7da3c1-a7e5-3d7c-b85a-d7c00c96d4bd",
                                        "entry_id": "5c741ce2-4e95-3097-a2bf-1dc2fe021349",
                                        "glosses": [
                                            "Any similar activity on other vehicles, including canoes and water skis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d58e184-951a-417d-814b-29649b4bc637",
                                                "sense_id": "5e7da3c1-a7e5-3d7c-b85a-d7c00c96d4bd",
                                                "text": "Disowned by my father... I began an erratic and increasingly steep slalom. Rejected would-be mercenary pilot, failed Jesuit novice, unpublished writer of pornography… yet for all these failures I had a tenacious faith in myself, a messiah as yet without"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9063a9b7-88ae-37d7-99b6-769fbaf4955d",
                                        "entry_id": "5c741ce2-4e95-3097-a2bf-1dc2fe021349",
                                        "glosses": [
                                            "A course used for the sport of slalom."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee5e213-d75f-4a35-a6c6-41a0aaa0c7ec",
                                                "sense_id": "9063a9b7-88ae-37d7-99b6-769fbaf4955d",
                                                "text": "These first two slaloms have sixty gates each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf279da-c62e-353c-bccb-c76261650b7f",
                                        "entry_id": "5c741ce2-4e95-3097-a2bf-1dc2fe021349",
                                        "glosses": [
                                            "A race or competition wherein participants each perform the sport of slalom."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c8c8497-7788-41bd-a283-5f305f5010cc",
                                                "sense_id": "bdf279da-c62e-353c-bccb-c76261650b7f",
                                                "text": "He has won six World Cup slaloms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6566fb3-94b6-3530-9753-18c5bfea0b66",
                                        "entry_id": "5c741ce2-4e95-3097-a2bf-1dc2fe021349",
                                        "glosses": [
                                            "Short for autoslalom"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slalom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0996845f-e98c-301c-afb1-760d0d6b90a9",
                                        "entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                                        "glosses": [
                                            "To race in a slalom."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                        "entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                                        "glosses": [
                                            "To move in a slalom-like manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d769e06-60ec-466f-a239-e68c1ba72485",
                                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                                "text": "Snow fell, swirled, slalomed past our windows."
                                            },
                                            {
                                                "example_id": "8300973b-a17e-4758-967a-95a56a6396ea",
                                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                                "text": "Hiro climbs on his bike, eases it through the neighbourhood and onto the street, and then gosses it up to a few hundred miles an hour, slaloming between the stanchions of the monorail, practicing."
                                            },
                                            {
                                                "example_id": "88183ae3-99d5-4061-b43b-9d085d84f463",
                                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                                "text": "Gerrard plainly had other ideas as he set off on that final, driving run into the opposition penalty area, slaloming between Kamil Glik and Grzegorz Wojtkowiak and getting his shot away as a third defender, Artur Jedzejczyk, and the goalkeeper, Wojciech Szczesny, tried to close him out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
