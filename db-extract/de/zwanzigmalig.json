                    },
                    {
                        "form_id": "e3906f15-7232-4085-be26-767c4b0ac747",
                        "entry_id": "40bedece-bf58-3d6f-933e-65f3c9fdf6bc",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind zwanzigmalig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63df0b65-0f8a-3a19-8b74-77d3ef3fa632",
                        "entry_id": "40bedece-bf58-3d6f-933e-65f3c9fdf6bc",
                        "glosses": [
                            "attributiv gebraucht, auch adverbial: zwanzig Mal geschehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d20687c6-5f0b-4679-a335-cd865fbef498",
                                "sense_id": "63df0b65-0f8a-3a19-8b74-77d3ef3fa632",
                                "text": "„Es ist vollständig feuersicher und verliert diese Eigenschaft selbst bei zwanzigmaligem Waschen nicht.“"
                            },
                            {
                                "example_id": "46f32223-3c30-4ed2-b382-073dd8527e70",
                                "sense_id": "63df0b65-0f8a-3a19-8b74-77d3ef3fa632",
                                "text": "„Bis 1145 ist der zwanzigmalige Aufenthalt römisch-deutscher Kaiser hier belegt.“"
                            },
                            {
                                "example_id": "c8d13f13-530c-4e51-b8cc-cc5144da1241",
                                "sense_id": "63df0b65-0f8a-3a19-8b74-77d3ef3fa632",
                                "text": "„Nach zwanzigmaligem Kristallisieren des Acetats aus Essigester wurde ein wenig lösliches und ein leicht lösliches Acetat erhalten.“"
                            },
                            {
                                "example_id": "8169f70d-4858-4b92-b0cd-3c40f98ea6cc",
                                "sense_id": "63df0b65-0f8a-3a19-8b74-77d3ef3fa632",
                                "text": "„Nach etwa zwanzigmaligem Klingeln antwortet eine barsche weibliche Stimme.“"
