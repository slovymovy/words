                "senses": [
                    {
                        "sense_id": "ff1c1485-1277-362f-a733-d5899597efa7",
                        "entry_id": "c4c61000-6b1d-3a13-a064-20cd274522d6",
                        "glosses": [
                            "großer, ausgedehnter Gletscher, der die Insel Grönland bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25549c3a-c1b9-4236-8847-d20264ff6c94",
                                "sense_id": "ff1c1485-1277-362f-a733-d5899597efa7",
                                "text": "„Die Wärme staut sich verstärkt in der Atmosphäre – mit krassen Folgen: Die Pole, der Grönlandeisschild und die Gletscher der Hochgebirge schmelzen ab und lassen den Meeresspiegel ansteigen.“"
                            },
                            {
                                "example_id": "0c3c2e99-ab7c-4d8e-83ac-4bdf3c5e08eb",
                                "sense_id": "ff1c1485-1277-362f-a733-d5899597efa7",
                                "text": "„Viele Klimafolgen werden wahrscheinlich unumkehrbar sein, beispielsweise das Abschmelzen des Grönlandeisschildes, das über mehrere Jahrhunderte hinweg zu einem Ansteigen des Meeresspiegels von sieben Metern führen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
