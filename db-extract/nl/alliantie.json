                                "sense_id": "afd81d4c-bd8e-3d7c-95a1-b93b0b3206bd",
                                "text": "De twee landen sloten een economische alliantie om handel te bevorderen.",
                                "translation": "The two countries formed an economic alliance to promote trade.",
                                "english": "The two countries formed an economic alliance to promote trade."
                            },
                            {
                                "example_id": "0b120909-e474-4dde-a82a-421b7d3ba08a",
                                "sense_id": "afd81d4c-bd8e-3d7c-95a1-b93b0b3206bd",
                                "text": "De politieke partijen vormden een alliantie om samen te werken in de verkiezingen.",
                                "translation": "The political parties formed an alliance to cooperate in the elections.",
                                "english": "The political parties formed an alliance to cooperate in the elections."
                            },
                            {
                                "example_id": "9bcdf962-57bc-4495-a642-10eaa06c5464",
                                "sense_id": "afd81d4c-bd8e-3d7c-95a1-b93b0b3206bd",
                                "text": "De alliantie tussen de verschillende organisaties zorgde voor een gezamenlijke aanpak.",
                                "translation": "The alliance between the various organizations led to a collaborative approach.",
                                "english": "The alliance between the various organizations led to a collaborative approach."
                            }
                        ]
                    }
