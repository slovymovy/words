{
    "word_family": [
        "manifester",
        "manifestation",
        "manifestement",
        "manifestant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d727f2ed-c68e-3d16-92d9-ed403e8f16c0",
                    "sense_definition": "Déclaration écrite et publique par laquelle un souverain, un gouvernement ou un mouvement fait connaître ses intentions ou son programme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce groupe d'artistes a rédigé un <w>manifeste</w> pour défendre leur nouvelle vision esthétique."
                        },
                        {
                            "text": "Le parti politique a décidé de publier un <w>manifeste</w> avant les prochaines élections nationales."
                        }
                    ],
                    "synonyms": [
                        "déclaration",
                        "proclamation"
                    ],
                    "common_phrases": [
                        "publier un manifeste",
                        "signer un manifeste"
                    ]
                },
                {
                    "sense_id": "df16a852-61b3-3a03-a2b8-6c0c356d60b0",
                    "sense_definition": "Document récapitulant l'ensemble des marchandises ou des passagers transportés par un navire ou un aéronef.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine doit présenter le <w>manifeste</w> aux douaniers dès son arrivée au port."
                        },
                        {
                            "text": "Les agents vérifient chaque conteneur inscrit sur le <w>manifeste</w> officiel du navire."
                        }
                    ],
                    "common_phrases": [
                        "manifeste de cargaison"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a7d7a419-fab9-3179-a63e-ee4d2d26e11b",
                    "sense_definition": "Qui est évident, certain et incontestable pour tout le monde.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'agit d'une erreur <w>manifeste</w> commise lors de la rédaction du rapport financier."
                        },
                        {
                            "text": "Sa mauvaise foi était <w>manifeste</w> dès le début de la négociation entre les parties."
                        }
                    ],
                    "synonyms": [
                        "évident",
                        "flagrant",
                        "indéniable",
                        "notoire"
                    ],
                    "antonyms": [
                        "douteux",
                        "incertain"
                    ],
                    "common_phrases": [
                        "erreur manifeste"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a67c2f8-0db2-3679-b864-d952192b57bf",
                    "sense_definition": "Troisième personne du singulier du présent de l'indicatif du verbe <w>manifester</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque samedi, une foule nombreuse <w>manifeste</w> pacifiquement dans les rues du centre-ville."
                        },
                        {
                            "text": "Il ne <w>manifeste</w> aucun enthousiasme face à cette nouvelle proposition de son équipe."
                        }
                    ],
                    "common_phrases": [
                        "manifeste son désaccord",
                        "manifeste sa joie"
                    ]
                }
            ]
        }
    ]
