                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "Adwent początkowo miał charakter głównie pokutny"
                                            },
                                            {
                                                "example_id": "0c7c8700-9922-43bc-84a7-94ca32963f8d",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "Obecnie adwent obejmuje cztery niedziele przed Bożym Narodzeniem."
                                            },
                                            {
                                                "example_id": "df7c59e3-3392-441d-b450-5f519c4bd9e8",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "Minęła jesień, minął zwykłą koleją rzeczy adwent, nastąpił karnawał"
                                            },
                                            {
                                                "example_id": "4d002a55-8a25-40a9-95a4-0999b50cc6ab",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "Symbolami adwentu są: wieniec adwentowy, kalendarz adwentowy, lampion roratny i roratka."
                                            },
                                            {
                                                "example_id": "6be8dad6-007b-422e-a08d-bbebc32b9605",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "W liturgii katolickiej fiolet symbolizuje skruchę, post, powagę i dlatego jest barwą adwentu."
                                            },
                                            {
                                                "example_id": "9b8099a3-f448-4ca7-a6cb-363c664ab598",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "Z pierwszą niedzielą adwentu zaczyna się rok kościelny."
                                            },
                                            {
                                                "example_id": "e8325d95-079b-4ed4-8b9b-49d336b63919",
                                                "sense_id": "f178f519-69b6-3a03-9175-f13aed428929",
                                                "text": "W adwencie chodzimy przed świtem na roraty."
                                            }
                                        ],
