                        "entry_id": "2b7988bb-eccb-3ae8-bb43-d388bc468ac0",
                        "glosses": [
                            "Genre de plantes rhizomateuses, plus connues sous le nom générique de sceau de Salomon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea10a63-3f88-4adb-bec1-90b92ae03c87",
                                "sense_id": "d7cd0795-f3a0-3115-906f-134b5d40838f",
                                "text": "Le polygonate verticillé et le polygonate multiflore poussent dans les forêts d’Europe."
                            },
                            {
                                "example_id": "4655e98b-049b-4f41-9783-21b023bbea4d",
                                "sense_id": "d7cd0795-f3a0-3115-906f-134b5d40838f",
                                "text": "POLYGONATE, s. m., Nom grec d’une plante, qui se nomme vulgairement Genouillet, & que d’autres appellent aussi Sceau de Marie & Sceau de Salomon."
                            },
                            {
                                "example_id": "208a35b2-d699-4861-a7be-1906f310277c",
                                "sense_id": "d7cd0795-f3a0-3115-906f-134b5d40838f",
                                "text": "Autres noms communs : Polygonate officinal, grenouillet ^([sic : genouillet]), faux muguet, herbe aux panaris."
                            }
                        ]
                    }
                ],
