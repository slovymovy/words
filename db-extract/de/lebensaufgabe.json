                "senses": [
                    {
                        "sense_id": "6124174b-6cbe-3c94-a15f-ae5787cbc8c2",
                        "entry_id": "2fdde35e-6fac-32fc-98d4-7e09ded37e8c",
                        "glosses": [
                            "Aufgabe, die sich jemand in seinem Leben zu bewältigen vorgenommen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3410b198-71bf-481a-be3d-819c11dd2efe",
                                "sense_id": "6124174b-6cbe-3c94-a15f-ae5787cbc8c2",
                                "text": "„Seine Lebensaufgabe sah er als nicht erfüllt an.“"
                            },
                            {
                                "example_id": "f60842ce-9db7-45e2-b500-d6435c42a8d3",
                                "sense_id": "6124174b-6cbe-3c94-a15f-ae5787cbc8c2",
                                "text": "„War denn seine Lebensaufgabe nicht von den höchsten Autoritäten abgesegnet?“"
                            },
                            {
                                "example_id": "266ed298-8c80-4c7c-9bca-8621bd14cd27",
                                "sense_id": "6124174b-6cbe-3c94-a15f-ae5787cbc8c2",
                                "text": "„Die Vorstellung, dass Arbeit eine erfüllende Lebensaufgabe sein könnte, ließ sie nicht mehr los.“"
                            },
                            {
                                "example_id": "92fd78a0-74d6-444d-95f1-8f0755786b5e",
                                "sense_id": "6124174b-6cbe-3c94-a15f-ae5787cbc8c2",
                                "text": "„Er vertiefte sich so in die Arbeit, als sollte es seine Lebensaufgabe sein, die Grabinschrift für seinen Bruder zu verfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
