                    {
                        "sense_id": "4f872f12-a482-3737-a2ec-20656d61c61a",
                        "entry_id": "dcb34cae-8b1b-379b-8200-a84cb72b07ae",
                        "glosses": [
                            "наречие к чёткий; ясно, явственно, отчётливо"
