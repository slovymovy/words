    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "81b9b63c-b049-3892-8d85-e2f56f151b01",
                "word": "straightway",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a8d4844-1b8e-3147-97f4-5ffc85c9b0ae",
                        "entry_id": "81b9b63c-b049-3892-8d85-e2f56f151b01",
                        "glosses": [
                            "Synonym of straightaway or straight away (“at once, immediately”)."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b7ffce7-73a9-4ca1-b447-8d1c836b9406",
                                "sense_id": "3a8d4844-1b8e-3147-97f4-5ffc85c9b0ae",
                                "text": "Now, if in a stage coach in the depth of winter, when three passengers are warm and snug, a fourth, all besnowed and frozen, descends from the outside and takes place amongst them, straightway all the three passengers shift their places, uneasily pull up their cloak collars, re-arrange their \"comforters,\" feel indignantly a sensible loss of caloric—the intruder has at least made a sensation."
                            },
                            {
                                "example_id": "85826e60-235b-4943-88d9-9d2f85c6739c",
                                "sense_id": "3a8d4844-1b8e-3147-97f4-5ffc85c9b0ae",
                                "text": "Now one day of the days, […] the Sultan cast his eyes upon her as she stood before him, and said to his Grand Wazir, \"This be the very woman whereof I spake to thee yesterday, so do thou straightway bring her before me, that I may see what be her suit and fulfil her need.\""
                            },
                            {
                                "example_id": "12751705-a1a0-409e-96a4-06c4fbf58bf4",
                                "sense_id": "3a8d4844-1b8e-3147-97f4-5ffc85c9b0ae",
                                "text": "This made her angrier than before, and she blew her silver whistle twice. Straightway a great flock of wild crows came flying toward her, enough to darken the sky."
                            }
                        ]
                    },
                    {
                        "sense_id": "f92e9223-6c53-3eeb-bb95-94761319a5ad",
                        "entry_id": "81b9b63c-b049-3892-8d85-e2f56f151b01",
                        "glosses": [
                            "Directly."
                        ],
                        "tags": [
                            "nonstandard",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d249eaf1-2846-477b-9610-22cae388fa0f",
                                "sense_id": "f92e9223-6c53-3eeb-bb95-94761319a5ad",
                                "text": "But like as eyes not strong enough to look upon the sun yet do gladly look upon the objects which are by the sun enlightened, so, souls which have already strength to delight in the beauty of chastity are yet not straightway able to consider in her very self that truth which charity hath her light, insomuch that when it cometh to the doing of somewhat that is adverse to truth, they should so start back in horror as they do start back in horror if aught be proposed to be done that is adverse to chastity."
                            },
                            {
                                "example_id": "f319215b-af7b-4aa1-85fe-139dcc5fc629",
                                "sense_id": "f92e9223-6c53-3eeb-bb95-94761319a5ad",
                                "text": "Those who continually prefer to stir up waters find that they create only a whirlpool and are carried around in circles rather than progressing straightway."
                            },
                            {
                                "example_id": "00ec6aa7-f89b-4984-8ecb-f727027da63e",
                                "sense_id": "f92e9223-6c53-3eeb-bb95-94761319a5ad",
                                "text": "The National Highway 33-34 in these three districts cannot be operated even during light monsoon because the water level goes straightway into the road."
                            },
                            {
                                "example_id": "a548bb9e-7d28-47fe-a0af-ea6c5b4130ad",
                                "sense_id": "f92e9223-6c53-3eeb-bb95-94761319a5ad",
                                "text": "Moreover an idol in a temple if situated straightway to our main entrance as if persistently gazing posture; thus emits detrimentally harmful vibes. Vaastushastra, therefore, says that such idols emit highly charged damaging energies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
