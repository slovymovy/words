                        ],
                        "examples": [
                            {
                                "example_id": "9ce2462d-d16c-41f9-9131-024db294a8cf",
                                "sense_id": "bd4bde7d-416a-3d45-a3fe-33cff58df37c",
                                "text": "Wrzaskliwe, wygadane przekupki w spódnicach sztywnych od krochmalu i wysokich bieluśkich czepkach"
                            },
                            {
                                "example_id": "1fca2d10-5fb4-4e77-9e28-d361f580f054",
                                "sense_id": "bd4bde7d-416a-3d45-a3fe-33cff58df37c",
                                "text": "Dlaczego lubimy na ten przykład miluśkie, bieluśkie króliczki, a nie lubimy pajączków?"
                            }
                        ],
