                                        "entry_id": "d3692065-4bd0-3af7-81c4-23e2c9702bd0",
                                        "glosses": [
                                            "Relatif à la vie dans les cavernes ou les cavités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9a4665-bcf6-4df8-b879-ab893895817c",
                                                "sense_id": "4808ce5d-9fea-384b-a0a1-e512a49580d3",
                                                "text": "Dans la foulée on perça deux fenêtres dans les combles, qui perdirent leur côté cavernicole."
                                            }
                                        ]
                                    }
                                ]
                            },
