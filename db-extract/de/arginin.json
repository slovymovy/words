                        ],
                        "examples": [
                            {
                                "example_id": "b16c6197-c7ff-4755-a28f-c98c1dc86164",
                                "sense_id": "aabaf3ff-dd38-3fb6-91dd-6ce9236a04df",
                                "text": "Arginin kommt in größeren Mengen in Nüssen, Samen, Fleisch und Fisch vor."
                            },
                            {
                                "example_id": "8b9d1843-4a99-41ef-b560-7ce4505df2a6",
                                "sense_id": "aabaf3ff-dd38-3fb6-91dd-6ce9236a04df",
                                "text": "Erwachsene Tiere und Menschen können Arginin aus Glutaminsäure synthetisieren."
                            },
                            {
                                "example_id": "5c2db8c6-aece-4bd0-b7df-26903f6b415d",
                                "sense_id": "aabaf3ff-dd38-3fb6-91dd-6ce9236a04df",
                                "text": "Arginin unterstützt das Wachstum und ist an der Zellteilung beteiligt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
