                                            {
                                                "example_id": "fa0b4575-4640-4043-b2e2-39decdef3195",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Rund 13 Millionen Menschen leben in Malawi."
