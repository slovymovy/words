    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42357e65-4f71-3e29-a99d-8e938f6cbb56",
                "word": "backbench",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "82d1474b-fab3-3776-9c35-12d9a9591848",
                        "entry_id": "42357e65-4f71-3e29-a99d-8e938f6cbb56",
                        "glosses": [
                            "relating to the back benches in parliament"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a4a02d9-feb2-4d98-9619-a1db1b4e2c1c",
                                "sense_id": "82d1474b-fab3-3776-9c35-12d9a9591848",
                                "text": "He prefers to be a backbench MP."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1596fe-2884-3439-8838-675ecc51eef2",
                        "entry_id": "42357e65-4f71-3e29-a99d-8e938f6cbb56",
                        "glosses": [
                            "Pertaining to the preparation of a donor organ prior to transplantation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "37dc5195-5e07-45de-8126-9511af513ed8",
                                "sense_id": "4b1596fe-2884-3439-8838-675ecc51eef2",
                                "text": "Cold preservation is a component of the donor organ resection procedure, not the backbench preparation."
                            },
                            {
                                "example_id": "c13d5daa-7eb5-4d5a-81f8-bcca56ff4734",
                                "sense_id": "4b1596fe-2884-3439-8838-675ecc51eef2",
                                "text": "Regardless of the origin of the kidney graft, LD or deceased donor, backbench preparation for robotic implantation follows some specific steps."
                            },
                            {
                                "example_id": "1eb1adb3-0965-4df7-8661-f8960459c846",
                                "sense_id": "4b1596fe-2884-3439-8838-675ecc51eef2",
                                "text": "The transplant procedure involves obtaining the graft to be transplanted (from a cadaver or living donor), backbench work (special preparation of the graft before transplantation), and transplantation into the recipient."
                            }
                        ]
                    },
                    {
                        "sense_id": "6829975d-f5d5-3bff-ba1f-451b7e5a2200",
                        "entry_id": "42357e65-4f71-3e29-a99d-8e938f6cbb56",
                        "glosses": [
                            "Secondary or inactive."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "620a2bc5-9c5f-4a2c-a396-55b2ecef88aa",
                                "sense_id": "6829975d-f5d5-3bff-ba1f-451b7e5a2200",
                                "text": "In contrast, the less able, the backbench players, tend to stick around, and if they're in a position of power, they are also inclined to hire and promote other also-rans or, worse, people incapable of even finishing the race."
                            },
                            {
                                "example_id": "3cb09a23-0aeb-4a19-bd4b-7375cd632d3c",
                                "sense_id": "6829975d-f5d5-3bff-ba1f-451b7e5a2200",
                                "text": "In view of this, it is clear why internet service providers (ISPs) are inclined to play a backbench role when it comes to combating file sharing."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                "word": "backbench",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "557aa6fa-29e0-4cd3-92db-18b9932f143c",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "tags": [
                            "plural"
                        ],
                        "form": "backbenches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "651a8965-962f-340c-8e22-4c9bd77c5316",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c425ae54-1e2c-417a-ae58-39b7e183ee20",
                                "sense_id": "651a8965-962f-340c-8e22-4c9bd77c5316",
                                "text": "But no one was waiting at the backbench and the older fellow looked as if he had dug in to stay."
                            },
                            {
                                "example_id": "427ae15a-867d-46ef-9fd3-ac8a333cf048",
                                "sense_id": "651a8965-962f-340c-8e22-4c9bd77c5316",
                                "text": "Some other playgoers are supping on the day's pottage at the backbenches nearby, some with a glass of reddish everyday plonk."
                            }
                        ]
                    },
                    {
                        "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area.",
                            "In a house of legislature following the model of the Westminster system (such as the UK House of Commons), any bench behind either of the front benches and occupied by members of each party group who are not party leaders, cabinet ministers, holders of offices such as the whips, etc."
                        ],
                        "tags": [
                            "New-Zealand",
                            "UK",
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "4848de1f-55e2-4d71-9400-dbaea1c4c9da",
                                "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                                "text": "His spacious quarters indicate his transition from backbench upstart to established member of the governing team."
                            },
                            {
                                "example_id": "11fcaaaf-153b-4e24-9540-f2b2e4f443a9",
                                "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                                "text": "There was no separate back-bench organization ; indeed there were no back-bench caucuses in any Nigerian Legislative House, and any attempt to create one would probably have been regarded by the leadership concerned as a subversive move."
                            },
                            {
                                "example_id": "e64481b3-9ac6-4717-b824-6e57a5cef352",
                                "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                                "text": "Both Thatcher's and Major's PPSs developed the role of trying to see that those members considered loyal to the leadership won the main positions on backbench party committees."
                            },
                            {
                                "example_id": "b8b51e2b-bf71-43d3-9b57-2b6bc52eaab2",
                                "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                                "text": "In fall 1984, Brian Mulroney led a cabinet with far more political experience than the Conservative backbench."
                            },
                            {
                                "example_id": "a3aeb0a3-0c87-4b39-a547-325eac86121b",
                                "sense_id": "22d14b02-ec30-33f5-bfac-a596394a2d91",
                                "text": "2009, John Coakley, Michael Gallagher, Politics in the Republic of Ireland, page 301,\nIn situations of low ministerial turnover and increased professionalisation of politics, with most TDs regarding politics as a career, Taoisigh could find that impatience on the backbenches leads to calls for leadership turnover to effect promotions."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ea05760-ca9c-3712-ad45-f1b942ca5745",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area.",
                            "The back row of a classroom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55a45fe-6135-4116-9072-e6155785f131",
                                "sense_id": "8ea05760-ca9c-3712-ad45-f1b942ca5745",
                                "text": "The petitioner who was a student of Class X was in the backbench when a lady teacher was teaching there."
                            },
                            {
                                "example_id": "3b9e242d-397a-466b-bc01-19e8e0a8587f",
                                "sense_id": "8ea05760-ca9c-3712-ad45-f1b942ca5745",
                                "text": "For students who are seriously interested in studies, the front row gives them good proximity to the teacher, while for the students who want to avoid studying, the backbenches are good."
                            },
                            {
                                "example_id": "e9c1fa94-0c2f-47d8-80b7-9a10db5930ee",
                                "sense_id": "8ea05760-ca9c-3712-ad45-f1b942ca5745",
                                "text": "She slipped into a seat in the backbench and pulled out her casebook, notebook and Crim Law outline."
                            },
                            {
                                "example_id": "e8a30934-a265-46ec-a792-aac1b3595293",
                                "sense_id": "8ea05760-ca9c-3712-ad45-f1b942ca5745",
                                "text": "After lunch, I joined my group at the backbench for the next class."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b00f50c-bc9d-3f7f-874c-c5a8ce9f3835",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area.",
                            "The back pew of a church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bcc3eb5-cfa3-42d1-8895-7ffeeaceb4a2",
                                "sense_id": "5b00f50c-bc9d-3f7f-874c-c5a8ce9f3835",
                                "text": "Through this two-year, transcontinental colloquy, through this vast outpouring of personal sentiments and reactions from poor homes and rich, from backwoods cabins and metropolitan penthouses, from the young and old, from dubious backbench sitters and busy pillars of the congregations, from the bitter and the satisfied, each person telling it as he or she saw it."
                            },
                            {
                                "example_id": "20d4f51a-1e5a-4902-bad7-3d65941c13e7",
                                "sense_id": "5b00f50c-bc9d-3f7f-874c-c5a8ce9f3835",
                                "text": "We settled Gord with Thea, Jim and Jane in the backbench of church, then joined him there."
                            },
                            {
                                "example_id": "c652fdc9-81d4-47e3-b500-a8c1145f00d1",
                                "sense_id": "5b00f50c-bc9d-3f7f-874c-c5a8ce9f3835",
                                "text": "As a result of privatization, many are eager to do what a Norwegian rock-star-pastor recommends — namely to occupy the backbench of the church."
                            }
                        ]
                    },
                    {
                        "sense_id": "67b5c7fe-2326-33f1-9eb6-9cfdc340e16a",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area.",
                            "A back bench in a courtroom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d512b6a-0532-46e0-9b2a-d1847b2bc560",
                                "sense_id": "67b5c7fe-2326-33f1-9eb6-9cfdc340e16a",
                                "text": "Seated on the backbench of the courtroom, Emerald had mixed feelings."
                            },
                            {
                                "example_id": "d2909fd5-8765-496a-9b9f-27a64c56248a",
                                "sense_id": "67b5c7fe-2326-33f1-9eb6-9cfdc340e16a",
                                "text": "When they entered the courtroom Lawna noticed her father sitting lonely in the backbench."
                            },
                            {
                                "example_id": "d4d9ee35-aed0-42ec-980b-11b2d1b29bc4",
                                "sense_id": "67b5c7fe-2326-33f1-9eb6-9cfdc340e16a",
                                "text": "“This is way worse than we thought,” I whispered to Benjamin as we sat on a back bench in the diminutive courtroom."
                            },
                            {
                                "example_id": "2d008f90-84e8-43a7-a81d-4c0a268b9893",
                                "sense_id": "67b5c7fe-2326-33f1-9eb6-9cfdc340e16a",
                                "text": "Shekha, Sir Kakkar and Yavi were sitting on the front bench. Himani and Kjinlay were sitting on the backbench; all of them were concentrating on the proceedings of the court"
                            }
                        ]
                    },
                    {
                        "sense_id": "44b978cd-2adf-3d47-9f40-1b1b4fb8bb85",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A bench at the back of a room or seating area.",
                            "The back seat of an automobile, van, or bus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a4215e-d0a3-42be-a3f9-2c6f38a2eef6",
                                "sense_id": "44b978cd-2adf-3d47-9f40-1b1b4fb8bb85",
                                "text": "They scooted into a double seat near the rear and noticed that even with four people squeezed into the backbench, they had been lucky to find the last empty places."
                            },
                            {
                                "example_id": "b767f5f0-6781-4d85-bbc0-4c9bea70c7ba",
                                "sense_id": "44b978cd-2adf-3d47-9f40-1b1b4fb8bb85",
                                "text": "Chet and Wende looked helplessly at each other on the backbench of the Ford van."
                            },
                            {
                                "example_id": "736602f3-70fd-4b38-8e80-301054b1bb7e",
                                "sense_id": "44b978cd-2adf-3d47-9f40-1b1b4fb8bb85",
                                "text": "Lightning outlines Woo Doggy's silhouette outside the backbench door. Kris stretches over to unlock it."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6c2e3c3-59cb-3e48-a6b9-f5425a77f3aa",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A position of secondary importance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd56565-d5bb-4b84-8198-e39a2c48cddc",
                                "sense_id": "c6c2e3c3-59cb-3e48-a6b9-f5425a77f3aa",
                                "text": "Niger, as a country belongs to the backbench of African soccer."
                            },
                            {
                                "example_id": "fdba50d8-b86d-4ebe-a5d3-d6ae2340516e",
                                "sense_id": "c6c2e3c3-59cb-3e48-a6b9-f5425a77f3aa",
                                "text": "In other words, they were put on the proverbial backbench."
                            },
                            {
                                "example_id": "eec76e47-86e3-4c04-9262-0b649daee5e9",
                                "sense_id": "c6c2e3c3-59cb-3e48-a6b9-f5425a77f3aa",
                                "text": "So far we have made the Maoist experience sit at an analytical distance in a conceptual backbench, for our attention has been focused on the more recent happenings that have given rise to the current age."
                            },
                            {
                                "example_id": "f09d035f-de3e-48f3-9a63-f8f8b8dbd303",
                                "sense_id": "c6c2e3c3-59cb-3e48-a6b9-f5425a77f3aa",
                                "text": "The Harry Potter Devotee (HPD) offers ten names that might be characters in the Harry Potter series of books (preferably from the backbenches of the wizarding world to make it more challenging), and the adult must try to guess whether they are real or fake."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0fde65b-dc28-3d36-873a-7bbee9217604",
                        "entry_id": "5cf87fb3-7e50-3b58-88ab-a9fa8fa6e035",
                        "glosses": [
                            "A group of top-level journalists who jointly review submissions and decide on the layout and emphasis of the newspaper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced229d1-94a2-4391-8591-c901c10e262e",
                                "sense_id": "c0fde65b-dc28-3d36-873a-7bbee9217604",
                                "text": "A good spread could be allotted on a news page if the dead person was deemed worthy by the powerful and sceptical members of the “backbench” of the senior sub-editors."
                            },
                            {
                                "example_id": "4fb5408f-e247-4e89-ad2c-05f06c0b9ce8",
                                "sense_id": "c0fde65b-dc28-3d36-873a-7bbee9217604",
                                "text": "The attitude of the Observer backbench when I filed the story the following sunday showed how happy my sub-editing colleagues from the previous winter were with my feat."
                            },
                            {
                                "example_id": "3aae4df0-87f9-47ff-886f-48f7127a111f",
                                "sense_id": "c0fde65b-dc28-3d36-873a-7bbee9217604",
                                "text": "After his copy had dropped, MacKenzie had gone over to the backbench and instructed them: 'Don't change a word of this. Then if he's got it wrong the little fucker won't be able to wriggle out of this one!'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
