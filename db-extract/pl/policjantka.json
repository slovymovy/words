                    {
                        "translation_id": "5d11c7a9-1806-4498-af70-d80f6731329b",
                        "source_entry_id": "f2d9a8b7-ae85-3f02-b90b-38f24a6d1110",
                        "source_sense_id": "6f5699fa-6c76-3126-b0ba-0c485e6fb2b1",
                        "target_lang_word": "policistka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "policistka",
