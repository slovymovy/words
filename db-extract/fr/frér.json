                        "source_sense_id": "4bebcaa7-67f8-3e57-a862-5066234a15db",
                        "target_lang_word": "bro",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bro",
