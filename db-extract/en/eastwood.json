                                "sense_id": "f50ad6ed-d1e3-3f0d-aebc-5d8b5532437b",
                                "text": "Maniac, lunatic, call him Snoop Eastwood."
                            },
                            {
                                "example_id": "15a1eb3c-475e-4ead-a1d5-e57f53ac458e",
                                "sense_id": "f50ad6ed-d1e3-3f0d-aebc-5d8b5532437b",
                                "text": "The name is Dre Eastwood, when I'm packing a gun."
                            },
                            {
                                "example_id": "d2f9ce3f-57e5-4d64-9db5-5a27123fc4ff",
                                "sense_id": "f50ad6ed-d1e3-3f0d-aebc-5d8b5532437b",
                                "text": "Bustin' raps for my snaps, now they call me Eastwood."
                            },
                            {
                                "example_id": "7b2f4617-2062-4581-bbfb-9d4bfe74f6bf",
                                "sense_id": "f50ad6ed-d1e3-3f0d-aebc-5d8b5532437b",
                                "text": "I'm the maniac in black, Mr. Snoop Eastwood."
                            }
                        ]
