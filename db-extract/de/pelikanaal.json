                        "entry_id": "03cb7844-a224-39d7-a334-e6f7fb3c70bc",
                        "glosses": [
                            "Meeresfisch, der weltweit verbreitet ist, wissenschaftlich Eurypharynx pelecanoides; Tiefseefisch."
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cf9c2987-e89c-4b7f-88fd-0d0ec4bd829a",
                                "sense_id": "ca8add42-dca5-3c1d-afd7-464090630bd1",
                                "text": "Der Pelikanaal wurde 1882 von Léon Vaillant erstmals beschrieben."
                            },
                            {
                                "example_id": "27690cb4-db2e-49fe-9a60-1dba1c3b5699",
                                "sense_id": "ca8add42-dca5-3c1d-afd7-464090630bd1",
                                "text": "Der Pelikanaal (Eurypharynx pelecanoides) ist die namensgebende Art der Gattung und der Familie der Pelikanaale."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
