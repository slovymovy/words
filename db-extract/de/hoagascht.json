                "senses": [
                    {
                        "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                        "entry_id": "18accaf9-703e-3ea8-88e9-987586f4d9f9",
                        "glosses": [
                            "geselliger Abend oft in einer Gaststätte, bei dem nicht-kommerzielle Volksmusik geboten wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "bc59d2ff-7320-4302-9c17-c79f57a3dc49",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "„Für manche Beobachter ist der Hoagascht eines der letzten Biotope für nicht-kommerzialisiertes Brauchtum.“"
                            },
                            {
                                "example_id": "891943ea-ecad-41a3-a20d-61d56c137d13",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "„Seit ihrer Gründung hat die \"Sechsermusi\" bereits bei verschiedenen Trachtenjugendtagen oder Hoagaschten im Rosenheimer Umland mitgewirkt.“"
                            },
                            {
                                "example_id": "3d4a1d50-0e62-4632-8e47-54eee676790e",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "„In Bayern existiert noch eine echte Volksmusik […]. Wer einmal Gelegenheit hatte, bei einem Volkstanz, einem »Hoagascht« […] oder einem Adventssingen dabei zu sein, weiß, dass sie nichts mit Folklore zum Mitklatschen zu tun hat.“"
                            },
                            {
                                "example_id": "40e3f32d-3a2d-494f-9797-8893376f138c",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "Wieder einmal war die weibliche Dorfjugend nach der Arbeit in der großen Wohnstube eines Bauern zum »Hoagascht« […] zusammengekommen, wie es halt so Brauch war unter jungen Leuten. Die eine wusste dies, eine andere anderes zu berichten. Schließlich tanzten sie beim Klang einer Ziehharmonika.“"
                            },
                            {
                                "example_id": "581c2ce1-edc1-406a-b5b7-ad1402829a87",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "„Auf der Alm ist sportlich und musikalisch einiges geboten - vom Holzhauser Berglauf und Mountainbiker-Stammtisch über Musikanten- »Hoagascht« bis zur Bergmesse."
                            },
                            {
                                "example_id": "aa10d747-b791-42e4-898a-62bdbfbb84d4",
                                "sense_id": "96a22820-aea0-3925-b883-8c4586162cc5",
                                "text": "„Keine Leistungsschau war das Ziel, keine Großveranstaltung zunächst, sondern ein „Hoagascht\" eben - so wie ich ihn viele Jahre lang beim Stanglwirt in Going in Nordtirol erlebt habe. Ich glaube, daß das Innovatorische, das kreative, probierende Umgehen mit den Elementen der Volksmusik und des Volksliedes von dieser Art des Musizierens am meisten bezogen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
