                        "examples": [
                            {
                                "example_id": "2dc893db-8caa-4785-9589-82b0b68eb596",
                                "sense_id": "058f163f-0565-3e7b-b3b1-1bc3ad66cb4d",
                                "text": "Dora ziet lege chipszakken op de grond en de zaklamp op het nachtkastje."
                            },
                            {
                                "example_id": "2eec68d8-34a4-4d39-a351-e571e202b07d",
                                "sense_id": "058f163f-0565-3e7b-b3b1-1bc3ad66cb4d",
                                "text": "Voor het printen van de nieuwe soort zonnepanelen kan normaal printpapier gebruikt worden. Na een vel vol te hebben geprint met cellen kunnen er direct kabels op worden aangesloten. Het proces is volgens de onderzoekers vergelijkbaar met het bedrukken van de binnenkant van een chipszak met een zilveren laag."
                            },
                            {
                                "example_id": "2c8cfb1c-3733-4949-9c0c-3879de192989",
                                "sense_id": "058f163f-0565-3e7b-b3b1-1bc3ad66cb4d",
                                "text": "\"Wij treffen tussen het ingezameld plastic te veel verpakkingen aan die niet of slecht te recyclen zijn.\" zegt Dick Hoogendoorn van de Vereniging Afvalbedrijven. \"Een goed voorbeeld is het hele dunne folie van de chipszak. Die zijn flinterdun, maar het zijn meerdere lagen over elkaar, en dat maakt het lastig recyclebaar.\""
                            }
                        ]
                    }
