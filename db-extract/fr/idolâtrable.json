                        "glosses": [
                            "Qui peut ou doit être idolâtré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a12450-5317-419f-a43f-55f96f9e4bb2",
                                "sense_id": "250fdc2c-3982-35aa-a244-cd3cb2488785",
                                "text": "Retenez ceci : il n’y a de bon, de vrai, de gai, de triste, d’aimable, de variable, de désirable, de potable, de chantable, de célébrable, d’idolâtrable, que le delta qui existe depuis la ceinture d’une femme jusqu’à ses jarretières."
                            },
                            {
                                "example_id": "ca8a2327-7bbe-4ae6-9f1f-c2d5c48b9ae8",
                                "sense_id": "250fdc2c-3982-35aa-a244-cd3cb2488785",
                                "text": "L’insuccès colossal de cette entreprise ayant précipité le spéculateur au plus profond des abîmes, la jeune fille vivait avec sa mère sur de misérables débris de l’opulence d’autrefois, se cramponnant à l’espoir de cet héritage bienheureux qui devait l’unir à son Lépinoche qu’elle imaginait chaque jour plus beau, plus idolâtrable."
                            },
                            {
                                "example_id": "c00c7b3e-9f6d-44a6-9a8b-c0967fc176dd",
                                "sense_id": "250fdc2c-3982-35aa-a244-cd3cb2488785",
                                "text": "Arias et sa bande invitent des stars, des vamps « idolâtrables » et des travs acidulés."
                            }
                        ]
                    }
