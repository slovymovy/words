                                "sense_id": "8ec7cc4b-8197-3965-9233-207c6b39a6a8",
                                "text": "„Vor allem in den Großstädten sind viele auf Nebenjobs angewiesen.“"
                            },
                            {
                                "example_id": "abaf383f-1852-4406-a3d5-fb4c97b9b19b",
                                "sense_id": "8ec7cc4b-8197-3965-9233-207c6b39a6a8",
                                "text": "„Bachelor-Studierende mit Nebenjob haben im Durchschnitt kaum schlechtere Abschlussnoten als ihre Kommilitonen ohne Job.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
