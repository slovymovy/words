            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79a01470-6451-33f6-af8f-39eb4949e71d",
                    "sense_definition": "Toucher légèrement une partie sensible du corps pour provoquer un rire involontaire ou un tressaillement.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand frère aime <w>chatouiller</w> les pieds de sa petite sœur pour la faire rire."
                        },
                        {
                            "text": "Arrête de me <w>chatouiller</w> le cou, je n'arrive plus du tout à respirer !"
                        }
                    ],
                    "synonyms": [
                        "titiller"
                    ],
                    "common_phrases": [
                        "chatouiller la plante des pieds",
                        "chatouiller les côtes"
                    ]
                },
                {
                    "sense_id": "18286551-20d7-3b92-973d-3a977b6a28ab",
                    "sense_definition": "Procurer une impression légère et agréable aux sens, comme l'ouïe, le goût ou l'odorat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette douce mélodie de piano vient <w>chatouiller</w> agréablement nos oreilles pendant le dîner."
                        },
                        {
                            "text": "Une délicieuse odeur de pain chaud <w>chatouillait</w> les narines des passants matinaux."
                        }
                    ],
                    "synonyms": [
                        "caresser",
                        "titiller"
                    ],
                    "common_phrases": [
                        "chatouiller les narines",
                        "chatouiller l'oreille"
                    ]
                },
                {
                    "sense_id": "fdc16700-872e-32d9-990e-78b3aa8ffb9f",
                    "sense_definition": "Flatter l'orgueil ou l'amour-propre de quelqu'un de manière plaisante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ces compliments sincères sur son discours viennent <w>chatouiller</w> agréablement son amour-propre."
                        },
                        {
                            "text": "Les éloges de son supérieur ont beaucoup <w>chatouillé</w> sa vanité d'auteur débutant."
                        }
                    ],
                    "synonyms": [
                        "flatter"
                    ],
                    "common_phrases": [
