                    {
                        "translation_id": "d6a4c563-6185-479d-b7c6-b24d7dc9636b",
                        "source_entry_id": "66353dc8-3ba0-3c6c-9cc9-4156145230c1",
                        "source_sense_id": "699d5500-02e6-3a0c-87c6-3a0443053eab",
                        "source_sense_description": "Rücken eines Esels",
                        "target_lang_word": "dos d’âne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dos d’âne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01d38df8-8e72-30f2-9f35-7e7eeab5b156",
                                        "entry_id": "74916d66-a2ac-35dd-9e39-1539cd422d11",
                                        "glosses": [
                                            "Relief qui semble formé de deux parties réunies ensemble de manière à présenter une pente, un talus de chaque côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eac1d2e-518e-4fd5-a448-ea1b80ed8a76",
                                                "sense_id": "01d38df8-8e72-30f2-9f35-7e7eeab5b156",
                                                "text": "Nous y entrâmes par un pont de pierre en dos d'âne, dont une seule arche avait été rompue, et que nos pontonniers, qui avaient déjà jeté les madriers suffisants pour le passage de l'infanterie, s'occupaient activement à consolider […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86045eba-9dfd-354c-937f-9cf5f03d8cbc",
                                        "entry_id": "74916d66-a2ac-35dd-9e39-1539cd422d11",
                                        "glosses": [
                                            "Profil de cette forme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31e6fa2c-2274-4463-ae0c-505584d2d9c7",
                                                "sense_id": "86045eba-9dfd-354c-937f-9cf5f03d8cbc",
                                                "text": "Chez le sujet adulte, la selle se rapproche de plus en plus de la cavité et forme souvent un dos d’âne intra-cavitaire, situé à l'union de la face supérieure et de la face postérieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa61c25-eb6a-3ea8-98ae-c0b735f2d2e4",
                                        "entry_id": "74916d66-a2ac-35dd-9e39-1539cd422d11",
                                        "glosses": [
                                            "Accident du profil d'une route qui a cette forme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b8c503-7e78-45c0-b57e-b6bf2b9caeaa",
                                                "sense_id": "daa61c25-eb6a-3ea8-98ae-c0b735f2d2e4",
                                                "text": "Parfois, il s’enfonçait subitement, se relevait, et Mademoiselle lançait au timonier ce regard dont on punit le chauffeur, en auto, qui n’a pas prévu un dos d'âne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd2194f6-ca36-3af6-a2de-3794c4ef3ab7",
                                        "entry_id": "74916d66-a2ac-35dd-9e39-1539cd422d11",
                                        "glosses": [
                                            "Ralentisseur, bande épaisse d'enrobé destiné à faire ralentir les automobilistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27542ff7-2a48-4609-b567-2e1276391938",
                                                "sense_id": "fd2194f6-ca36-3af6-a2de-3794c4ef3ab7",
                                                "text": "Depuis quelques années, des dos d’âne sont installés à des endroits accidentogènes sur les routes nationales, pour faire ralentir les voitures et améliorer les conditions de circulation pour les autres usagers de la route, […]."
                                            },
                                            {
                                                "example_id": "6c093111-5ab8-4f1b-83c7-5fe7cc67fece",
                                                "sense_id": "fd2194f6-ca36-3af6-a2de-3794c4ef3ab7",
                                                "text": "Pour certains conducteurs, respecter cette vitesse plutôt faible est difficilement tenable. Pourtant, les nombreux dos d’âne qui les accompagnent sont souvent propices à lever le pied."
                                            },
                                            {
                                                "example_id": "6b82ac45-683c-453c-ba1a-445dbbad627d",
                                                "sense_id": "fd2194f6-ca36-3af6-a2de-3794c4ef3ab7",
                                                "text": "Pour rappel, la France est particulièrement friande des dos d'âne et en compte plus de 450.000 sur son territoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
