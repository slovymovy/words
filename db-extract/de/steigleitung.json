                "senses": [
                    {
                        "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                        "entry_id": "1abe048e-ca99-371a-88f6-93f429270830",
                        "glosses": [
                            "vertikal verlaufende Leitung zum Transport von Wasser, Gas oder Strom bei Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983c74e0-2043-4496-99ac-3b313e74dad1",
                                "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                                "text": "Die Steigleitung war verrostet."
                            },
                            {
                                "example_id": "a24527e5-a5ee-4621-b225-34a7f778e97b",
                                "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                                "text": "„Das Hochhaus verfügte über Rauchmelder, eine Steigleitung und eine Sprinkleranlage.“"
                            },
                            {
                                "example_id": "938d6489-27d3-4e71-9251-294d3eadef82",
                                "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                                "text": "„Ein gefährlicher Sonderfall war das Erstarren von Phosphor in der Steigleitung zu den Türmen.“"
                            },
                            {
                                "example_id": "de38a71e-cdd1-423d-8c89-f14a390162d7",
                                "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                                "text": "„Nasse Steigleitungen stehen ständig unter Wasserdruck.“"
                            },
                            {
                                "example_id": "399cf8ba-4a7b-4874-b85b-d40a00d2725f",
                                "sense_id": "68d840d8-6362-35df-9afe-6bfea6593c6c",
                                "text": "„Die trockenen Steigleitungen verfügten auf jedem Geschoss über einen Abgang und waren mit Feuerwehrschläuchen bestückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
