                            {
                                "target_word": "jasper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8597d424-2327-3a66-87d5-38a7f50b9b16",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A wasp."
                                        ],
                                        "tags": [
                                            "UK",
                                            "West-Country",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A person, a guy, especially seen as naïve or simple."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0e8a72a-4b2f-4b47-b069-909cba47c1f3",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "And list'nin to some big out-a-town jasper / Hearin' him tell about horse-race gamblin' / Not a wholesome trottin' race, no!"
                                            },
                                            {
                                                "example_id": "16eadc3d-c386-4f0e-a6bd-4a2954e4bae9",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "\"I stood there through almost an hour of it before they called Rooster Cogburn to the stand. I had guessed wrong as to which one he was, picking out a younger and slighter man with a badge on his shirt. And I was surprised when an old one-eyed jasper that was built along the lines of Grover Cleveland went up and was sworn.\""
                                            },
                                            {
                                                "example_id": "e1f1970b-e6ed-485e-ab61-15e1daa816c7",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "Standing on the corner like a just-got-in-town jasper"
                                            },
                                            {
                                                "example_id": "41f27622-576d-4443-bd3f-0aa0ba6485eb",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "“That jasper,” sniggered Darby, “never pulled out his ‘dummy’ for nothing but pissing, I bet you!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8859146-00f2-39f6-b673-07b6d00a7b49",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A stranger."
                                        ],
                                        "tags": [
                                            "Appalachia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "554acd94-a46b-40ee-bfde-9dbeaae63737",
                        "source_entry_id": "a774693d-367e-3ea3-8a6d-e64fd0dd90f1",
                        "source_sense_id": "45d37716-6432-34cc-8c17-d1dc91cd32ac",
                        "target_lang_word": "jaspe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaspe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                        "entry_id": "4a82fc10-a221-3217-a470-3f2c55ef5997",
                                        "glosses": [
                                            "Oxyde de silicium diversement coloré par des impuretés, sous forme de bandes ou de taches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051efa15-b50d-4221-88ea-1fa84605a8f9",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Afin d’en finir avec cette orfèvrerie symbolique, disons encore que […] la sarde évoque les Séraphins, la topaze les Chérubins, le jaspe les Trônes, la chrysolithe les Dominations, le saphir les Vertus, l’onyx les Puissances, le béryl les Principautés, le rubis les Archanges et l’émeraude les Anges."
                                            },
                                            {
                                                "example_id": "dae77a68-39b9-4819-bb0e-77f7eae3e884",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Vase de jaspe."
                                            },
                                            {
                                                "example_id": "48cba20e-a02b-40b5-b1cb-a455f632650c",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Jaspe panaché, sanguin."
                                            },
                                            {
                                                "example_id": "421e5766-d32b-4e82-87e4-7e833d2532c6",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Jaspe onyx."
                                            },
                                            {
                                                "example_id": "5deca5e7-d1b2-4041-8f03-3c24482456b7",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Jaspe fleuri, celui qui est de plusieurs couleurs."
                                            },
                                            {
                                                "example_id": "a594592e-c577-4222-b56a-34a31b7cc7a8",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Jaspe poudingue, poudingue jaspique des environs de Rennes."
                                            },
                                            {
                                                "example_id": "38bf13db-9bce-40a2-97b3-f35e1beff2ce",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Jaspe volcanique, ou obsidienne."
                                            },
                                            {
                                                "example_id": "916fa690-205a-41d3-94a4-c91e7ce609cf",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Le jaspe n’est qu’un quartz plus ou moins pénétré de parties métalliques, elles lui donnent les couleurs et rendent sa cassure moins nette que celle du quartz."
                                            },
                                            {
                                                "example_id": "ad1dd930-ffdd-4f92-bba8-ea924b296bca",
                                                "sense_id": "eac51c8e-a64c-3762-9508-d78d0ff58361",
                                                "text": "Des temples où siégeaient sur de riches carreaux\nCent idoles de jaspe à têtes de taureaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0ce6b2-3a95-33b9-8b82-fc2b5c5aef78",
                                        "entry_id": "4a82fc10-a221-3217-a470-3f2c55ef5997",
                                        "glosses": [
                                            "Imitation de la pierre, en particulier, celle dont le relieur marbre la tranche des livres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
