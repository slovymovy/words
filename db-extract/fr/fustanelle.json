                    {
                        "sense_id": "535de210-cad1-30e0-bb68-3332f83faf95",
                        "entry_id": "1b311d71-c8fc-39a8-bb3e-3e21b9340063",
                        "glosses": [
                            "Court jupon masculin du costume traditionnel grec et albanais, tuyauté et empesé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee7d5c1-312b-42db-8cfe-7c0f5811e4bf",
                                "sense_id": "535de210-cad1-30e0-bb68-3332f83faf95",
                                "text": "Les evzones, gardiens du Parlement, portent la fustanelle."
                            },
                            {
                                "example_id": "5f5382a1-d219-4dc0-b1f7-6e2475804587",
                                "sense_id": "535de210-cad1-30e0-bb68-3332f83faf95",
                                "text": "Un Albanais vêtu d'une fustanelle blanche vint lui ouvrir."
                            },
                            {
                                "example_id": "4e6dfddf-5d06-43f6-bf0d-f93b44050426",
                                "sense_id": "535de210-cad1-30e0-bb68-3332f83faf95",
                                "text": "Il y a bien des Albanais aussi, qui se promènent comme chez eux dans ce pays des ennemis ; de grands vieillards qui se drapent dans leurs cafetans doublés de fourrure, et font bouffer leurs courtes fustanelles de batiste à mille plis — avec la grâce de vieux soldats moustachus qui auraient mis des jupes de danseuses."
                            }
                        ]
                    }
                ],
