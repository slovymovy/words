                                    {
                                        "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                        "entry_id": "6f426f54-ecc0-3c36-a85b-e5cdff2778b8",
                                        "glosses": [
                                            "Fachmann im Weinbau, also in der Önologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869d587c-8460-41d6-a569-d5fc8b95f651",
                                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                                "text": "„Franz Wehrheim ist Betriebswirt, Önologe und hat einen Master of Business-Administration.“"
                                            },
                                            {
                                                "example_id": "0ccc5456-5ee5-4436-993d-1c39c40e6a61",
                                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                                "text": "„Der Winzer, Önologe und Biochemiker Jules Chauvet war in den 1970ern im Beaujolais auf der Suche nach authentischen Terroirweinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "655de8d2-e215-4d7d-9be9-c9564f1e6f1c",
                        "source_entry_id": "1e0c69c7-ee15-3461-ba6e-de80b7ceda61",
                        "source_sense_id": "635a35b6-1f5d-325e-a70d-f170abb72c02",
                        "source_sense_description": "an expert in the science of oenology",
                        "target_lang_word": "Önologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Önologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                        "entry_id": "27fdc58a-5b09-3632-a629-2d45546b0d51",
                                        "glosses": [
                                            "Fachfrau im Weinbau, also in der Önologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2000af74-b5d1-432d-bcd6-ca7397b80455",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„2002 übernahm die studierte Önologin Carolin die Verantwortung im Weingut als Nachfolgerin von ihrem Vater – mit gerade einmal 24 Jahren.“"
                                            },
                                            {
                                                "example_id": "5b8c51a5-0368-45e3-bb86-c389ca6024db",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„Zuerst hatte sie Betriebswirtschaft studiert und sich gleich anschließend zur Winzerin und Önologin ausbilden lassen.“"
                                            },
                                            {
                                                "example_id": "5587acaa-5840-4f3c-927d-6738f23014c9",
                                                "sense_id": "2ad1539f-2394-3cb8-91a9-aad25e1a0372",
                                                "text": "„Das ist für mich der Traumberuf schlechthin. Der Flying Winemaker ist ein beratender Önologe (oder eine Önologin), dessen Kunden oft in der ganzen Welt verstreut sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
