                                    {
                                        "sense_id": "8b5bc6e7-ae19-3304-addc-f09cd7140aec",
                                        "entry_id": "166e3847-e533-3b25-8f81-41caf0e7ad08",
                                        "glosses": [
                                            "Sans préjuger de la brillance des époques antérieures ou postérieures, se dit en particulier des œuvres, des auteurs, des écoles de la période qui va du XVIIᵉ au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f1a045-9965-4d26-ae02-5077909b0643",
                                                "sense_id": "8b5bc6e7-ae19-3304-addc-f09cd7140aec",
                                                "text": "La musique, la danse classique."
                                            },
                                            {
                                                "example_id": "5843e3fd-4c31-4bdf-8e51-f9bc3f3b8e78",
                                                "sense_id": "8b5bc6e7-ae19-3304-addc-f09cd7140aec",
                                                "text": "La pensée économique classique se développe en même temps que naissent la société industrielle et le capitalisme moderne."
                                            }
