    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "330efa2d-1386-38e8-ba85-6b589f44a104",
                    "sense_definition": "Produire un bruit retentissant, émettre un son distinct.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le réveil <w>sonne</w> tous les matins à sept heures précises."
                        },
                        {
                            "text": "Mon téléphone n'arrête pas de <w>sonner</w> depuis le début de la réunion."
                        }
                    ],
                    "common_phrases": [
                        "laisser sonner"
                    ]
                },
                {
                    "sense_id": "a410ecaf-303f-3fa8-9fa5-c75a82210020",
                    "sense_definition": "Actionner une sonnette ou un signal sonore pour avertir de sa présence ou appeler quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>sonner</w> à la porte avant d'entrer dans l'immeuble."
                        },
                        {
                            "text": "Le livreur a <w>sonné</w> deux fois mais personne ne lui a répondu."
                        }
                    ],
                    "common_phrases": [
                        "sonner à la porte"
                    ]
                },
                {
                    "sense_id": "018c747d-8f78-3aa9-8dd3-e170114c61f5",
                    "sense_definition": "Marquer ou annoncer un moment précis par des coups de cloche ou d'horloge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'horloge de l'église commence à <w>sonner</w> midi sous le soleil d'été."
                        },
                        {
                            "text": "Les cloches de la cathédrale ont <w>sonné</w> pour célébrer la grande fête."
                        }
                    ],
                    "common_phrases": [
                        "sonner les cloches",
                        "sonner midi"
                    ]
                },
                {
                    "sense_id": "981837c3-a744-3b9a-b3d5-2b09cae71f3e",
                    "sense_definition": "Produire un certain effet ou donner une certaine impression à l'esprit ou à l'oreille.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses excuses semblaient sincères, mais ses explications continuaient de <w>sonner</w> faux."
                        },
                        {
                            "text": "Cette phrase en langue étrangère peut <w>sonner</w> bizarre aux oreilles des débutants."
                        }
                    ],
                    "common_phrases": [
                        "sonner creux",
                        "sonner faux",
                        "sonner juste"
                    ]
                },
                {
                    "sense_id": "3af6e404-4b4c-36a7-9973-ffec256f5058",
                    "sense_definition": "Étourdir ou troubler profondément quelqu'un à la suite d'un coup violent ou d'un choc.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce coup violent a réussi à <w>sonner</w> le boxeur dès la première reprise."
                        },
                        {
                            "text": "La chute brutale l'a complètement <w>sonné</w> pendant de longues secondes."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé au participe passé"
                        }
                    ]
                },
                {
                    "sense_id": "1fa8ed23-ad1f-385d-bbf1-af0f0269f354",
                    "sense_definition": "Faire appel à quelqu'un, solliciter son avis ou sa présence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne viens pas intervenir dans cette discussion si personne ne t'a <w>sonné</w>."
                        },
                        {
                            "text": "Elle a donné son avis sur mon mariage alors que personne ne l'avait <w>sonnée</w>."
                        }
                    ],
                    "common_phrases": [
                        "on ne t'a pas sonné"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "principalement utilisé dans des tournures familières négatives"
                        }
                    ]
                },
                {
                    "sense_id": "813088d8-81b4-3914-9a08-a9be54765495",
                    "sense_definition": "Faire entendre distinctement une consonne ou une lettre dans la prononciation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "phonétique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette prononciation soignée, l'orateur a choisi de faire <w>sonner</w> la lettre finale."
                        },
                        {
                            "text": "Selon la règle classique de la versification, cette consonne ne doit pas <w>sonner</w> ici."
                        }
                    ],
                    "synonyms": [
                        "prononcer"
                    ],
                    "common_phrases": [
                        "faire sonner une consonne"
                    ]
                }
            ]
        }
    ]
}