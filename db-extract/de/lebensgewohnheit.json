                        "sense_id": "50fd6abf-2a9c-3813-888a-a59012bfe8d8",
                        "entry_id": "e2555d36-9cb8-33a6-887a-afa57754c80f",
                        "glosses": [
                            "Gesamtheit dessen, was ein Lebewesen gewohnt ist zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341f4c0f-a9dc-4aaa-a449-a4fa0525fc97",
                                "sense_id": "50fd6abf-2a9c-3813-888a-a59012bfe8d8",
                                "text": "„Hainstock hatte ihr die Lebensgewohnheiten der Käuze geschildert.“"
                            },
                            {
                                "example_id": "29873a6e-12f6-45bb-aa26-64fdd64c6385",
                                "sense_id": "50fd6abf-2a9c-3813-888a-a59012bfe8d8",
                                "text": "„In Europa leben viele Völker mit unterschiedlichen Lebensgewohnheiten auf engem Raum.“"
                            },
                            {
                                "example_id": "ed50fad0-6caf-418d-9f4f-8d4815a27033",
                                "sense_id": "50fd6abf-2a9c-3813-888a-a59012bfe8d8",
                                "text": "„Er hatte in Simon Balcairns Spalte gelesen, seine Tochter sei in einem Nachtklub gesehen worden, was aber Kenner von Miss Strappers Lebensgewohnheiten durchaus nicht wunderte.“"
                            }
                        ],
