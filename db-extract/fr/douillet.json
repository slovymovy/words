                                "target_senses": [
                                    {
                                        "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                                        "entry_id": "48915408-d56f-37e9-8b6e-5f10d28afd80",
                                        "glosses": [
                                            "Warm and comfortable; cosy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee609135-cefa-4aef-a7ac-7bf042bf0783",
                                                "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                                                "text": "I felt snug tucked up in my snug bed."
                                            },
                                            {
                                                "example_id": "e7ba8ff6-219a-4459-bf67-cdee322a8a12",
                                                "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                                                "text": "Now, if in a stage coach in the depth of winter, when three passengers are warm and snug, a fourth, all besnowed and frozen, descends from the outside and takes place amongst them, straightway all the three passengers shift their places, uneasily pull up their cloak collars, re-arrange their \"comforters,\" feel indignantly a sensible loss of caloric—the intruder has at least made a sensation."
                                            },
                                            {
                                                "example_id": "7b72a475-c6aa-4956-809c-1c208f3d9524",
                                                "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                                                "text": "I am one of those unambitious lawyers who never addresses a jury, or in any way draws down public applause; but, in the cool tranquillity of a snug retreat, do a snug business among rich men's bonds, and mortgages, and title-deeds."
                                            },
                                            {
                                                "example_id": "98f1c811-afc2-4b77-a0dc-226c3bd317f7",
                                                "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                                                "text": "That night Tarzan built a snug little bower high among the swaying branches of a giant tree, and there the tired girl slept, while in a crotch beneath her the ape-man curled, ready, even in sleep, to protect her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8b7ae0-83c7-3e3c-9e23-3f4536037fdb",
                                        "entry_id": "48915408-d56f-37e9-8b6e-5f10d28afd80",
                                        "glosses": [
                                            "Satisfactory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f782bea-ec8b-47cf-b1f0-fc013f1e217e",
                                                "sense_id": "9f8b7ae0-83c7-3e3c-9e23-3f4536037fdb",
                                                "text": "I am one of those unambitious lawyers who never addresses a jury, or in any way draws down public applause; but, in the cool tranquillity of a snug retreat, do a snug business among rich men's bonds, and mortgages, and title-deeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071a4376-3f2b-31c7-88a6-74fd64aa2467",
                                        "entry_id": "48915408-d56f-37e9-8b6e-5f10d28afd80",
                                        "glosses": [
                                            "Close-fitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad471c3-8f1e-4b19-98e1-233d1fbfdff4",
                                                "sense_id": "071a4376-3f2b-31c7-88a6-74fd64aa2467",
                                                "text": "[I]t does make it clear that adding the keyboard case to the PinePhone will more than double the thickness. You may still be able to slide the whole thing into your pocket, but it’s likely to be more of a snug fit than when using the phone on its own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7be63ac-e60a-372b-93ab-211324c2257a",
                                        "entry_id": "48915408-d56f-37e9-8b6e-5f10d28afd80",
                                        "glosses": [
                                            "Close; concealed; not exposed to notice."
                                        ],
                                        "tags": [],
                                        "examples": [
