                        "glosses": [
                            "de waarde van alle bezittingen bij elkaar opgeteld en uitgedrukt in geld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb12dd79-e898-4261-9a24-a096072e3742",
                                "sense_id": "ff3ea903-7550-3bda-a6ef-3a4ed2526635",
                                "text": "Wij zijn daarom gewoon, vermogen en rijkdom te meten naar de waardesom van hun bestanddeelen, en beschouwen het als een nadeel, wanneer de waarde van het bezit en zijn inkomsten daalt. Daarom schijnt het ons paradox, wanneer wij af en toe de opmerking moeten maken, dat de voorraad goederen en genietingen, rijkdom en welvaart, toegenomen zijn, terwijl hun waarde gedaald is."
                            }
                        ]
                    }
