                "senses": [
                    {
                        "sense_id": "7beee5dd-96d7-3800-903f-2ddf9c16be99",
                        "entry_id": "fb7ce9e0-0585-393d-a243-69ac0cbba6fa",
                        "glosses": [
                            "устар. название единицы длины, равной 10⁻⁶ метра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b097e02c-8f3d-4fb1-aa68-40b2a16e86dc",
                                "sense_id": "7beee5dd-96d7-3800-903f-2ddf9c16be99",
                                "text": "Оказалось, что нужно пропускать гелий не в капилляре, а через щель, ширина которой равна долям микрона."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97cd0bf9-3cc9-4768-8e99-9c457fd7f128",
                        "source_entry_id": "fb7ce9e0-0585-393d-a243-69ac0cbba6fa",
                        "source_sense_id": "7beee5dd-96d7-3800-903f-2ddf9c16be99",
                        "target_lang_word": "micron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                        "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                                        "glosses": [
                                            "Synonym of micrometre (“one-millionth of a metre”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227b7984-8b14-4152-9c3e-00907e61b683",
                                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                                "text": "2009, Jonathan Amos, (bbc.co.uk) Satellites weigh California water\nAs one spacecraft lurches and drags through the Earth's uneven gravity field, the second follows 210 km behind, measuring changes in their separation to the nearest micron (a thousandth of a millimetre)."
                                            },
                                            {
                                                "example_id": "17603cc7-b946-49bf-b897-710f762125f0",
                                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                                "text": "The microcannon was seen moving at about a micron per second, it was about 15 microns long, and the high speed photograph was done in water (density of 1 kg/L, viscosity of about 0.001 pascal seconds)."
                                            },
                                            {
                                                "example_id": "891c88e4-210f-4a1b-b6ea-555eb3694983",
                                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                                "text": "Little pozzolanic reaction is evident for glass above 300 microns but the pozzolanic activity increases as the particle size is reduced below this size with good pozzolanic properties generally being achieved below about 45 microns (Federico & Chidiac 2009). […] In a second mix 20% of the Portland cement was replaced with the same Vycor glass which was ground to pass 45-micron (median particle size ~ 10 micron)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7ad834-1f11-31d9-a443-ebf96950342f",
                                        "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                                        "glosses": [
                                            "A very tiny amount."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "micron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3885593d-525b-33c1-a248-5e711363b302",
