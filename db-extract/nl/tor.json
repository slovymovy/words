                                        "glosses": [
                                            "To finish by subjecting to a hammering process in a beetle or beetling machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e21e4e6d-7f34-484f-96b9-6cc8cd05184f",
                                                "sense_id": "72c4de77-4697-3a62-8ce2-5084799933ac",
                                                "text": "to beetle cotton goods"
                                            }
