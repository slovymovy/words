                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "456ff2b3-79a1-363e-b2ff-7c9d7f9dec8b",
                                        "entry_id": "c2b41bb3-bbd7-3a22-a7fb-8ffe8754ba5e",
                                        "glosses": [
                                            "A number expressed in the hexadecimal system."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
