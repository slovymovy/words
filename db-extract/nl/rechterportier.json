                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46d0efc-4036-4980-9b3a-77421191d9f1",
                                "sense_id": "b8c08661-7029-37af-b61d-2e619537d3a6",
                                "text": "Sla je linksaf, dan is het net alsof je richting het rechterportier wordt getrokken."
                            },
                            {
                                "example_id": "4b9c5a14-5dce-4fc8-a1b9-3248f295b165",
                                "sense_id": "b8c08661-7029-37af-b61d-2e619537d3a6",
                                "text": "Danglars zag een in een cape gehulde man naast het rechterportier galopperen."
                            },
                            {
                                "example_id": "babd590c-a998-4e51-accf-63c01ebb3f72",
                                "sense_id": "b8c08661-7029-37af-b61d-2e619537d3a6",
                                "text": "In het afgezette gebied, op de kruising van De Voochtstraat met de Zerboltstraat, staat een auto midden op straat met draaiende motor. Ook staan de ruitenwissers nog aan en is het rechterportier geopend. De auto is mogelijk van het slachtoffer."
                            }
                        ]
