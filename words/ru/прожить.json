                    "sense_id": "287b980e-0b2e-3849-9084-6394fb5ed062",
                    "sense_definition": "Провести жизнь или определённый отрезок времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "living_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой дедушка <w>прожил</w> очень долгую и счастливую жизнь.",
                            "target_lang_translations": {
                                "en": "My grandfather <w>lived</w> a very long and happy life.",
                                "pl": "Mój dziadek <w>przeżył</w> bardzo długie i szczęśliwe życie."
                            }
                        },
                        {
                            "text": "Они <w>прожили</w> в счастливом браке более сорока лет.",
                            "target_lang_translations": {
                                "en": "They <w>lived</w> in a happy marriage for over forty years.",
                                "pl": "Oni <w>przeżyli</w> w szczęśliwym małżeństwie ponad czterdzieści lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "просуществовать"
                    ],
                    "common_phrases": [
                        "прожить жизнь",
                        "прожить долго",
                        "прожить год",
                        "прожить до старости"
                    ],
                    "target_lang_definitions": {
                        "en": "To spend one's life or a specific period of time.",
                        "pl": "Spędzić życie lub określony czas; przeżyć."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "live",
                                "target_lang_sense_clarification": "to exist for a duration of time"
                            },
                            {
                                "target_lang_word": "spend",
                                "target_lang_sense_clarification": "to pass time or one's life"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeżyć",
                                "target_lang_sense_clarification": "spędzić określony czas lub życie"
                            },
                            {
                                "target_lang_word": "dożyć",
                                "target_lang_sense_clarification": "dożyć określonego wieku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c67e66-70c5-3e4e-b90a-a768b0c97ccb",
                    "sense_definition": "Пробыть, обитать где-либо в течение некоторого времени.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "living_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>прожили</w> в этом старом доме всё лето.",
                            "target_lang_translations": {
                                "en": "We <w>lived</w> in this old house all summer.",
                                "pl": "<w>Przemieszkaliśmy</w> w tym starym domu całe lato."
                            }
                        },
                        {
                            "text": "Студент <w>прожил</w> в общежитии весь учебный год.",
                            "target_lang_translations": {
                                "en": "The student <w>lived</w> in the dormitory for the entire academic year.",
                                "pl": "Student <w>mieszkał</w> w akademiku przez cały rok akademicki."
                            }
                        }
                    ],
                    "synonyms": [
