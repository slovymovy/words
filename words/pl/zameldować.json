{
    "word_family": [
        "meldować",
        "meldunek",
        "zameldowanie",
        "wymeldować",
        "przemeldować"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b82d9c99-b002-3245-b055-d2ca6da3bf62",
                    "sense_definition": "dokonać urzędowego zgłoszenia pobytu danej osoby pod określonym adresem",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administracja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel mieszkania <w>zameldował</w> nowego lokatora na okres jednego roku.",
                            "target_lang_translations": {
                                "ru": "Владелец квартиры <w>прописал</w> нового жильца сроком на один год."
                            }
                        },
                        {
                            "text": "Muszę jak najszybciej <w>zameldować</w> brata w moim nowym mieszkaniu.",
                            "target_lang_translations": {
                                "ru": "Мне нужно как можно скорее <w>зарегистрировать</w> брата в моей новой квартире."
                            }
                        }
                    ],
                    "synonyms": [
                        "zarejestrować"
                    ],
                    "antonyms": [
                        "wymeldować"
                    ],
                    "common_phrases": [
                        "zameldować na pobyt stały",
                        "zameldować na pobyt czasowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "официально зарегистрировать чьё-либо пребывание или проживание по определённому адресу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прописать",
                                "target_lang_sense_clarification": "по месту жительства (разг./традиц.)"
                            },
                            {
                                "target_lang_word": "зарегистрировать",
                                "target_lang_sense_clarification": "официально оформить регистрацию по месту жительства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2054d0-b9a2-3622-895b-9795b4b6dd72",
                    "sense_definition": "dokonać rejestracji po przybyciu do hotelu lub stawić się w określonym miejscu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rejestracja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej podróży zdołaliśmy szybko <w>zameldować</w> się w hotelu i odpocząć.",
                            "target_lang_translations": {
                                "ru": "После долгой дороги нам удалось быстро <w>заселиться</w> в отель и отдохнуть."
                            }
                        },
                        {
                            "text": "Wszyscy żołnierze musieli <w>zameldować</w> się u dowódcy przed wyznaczonym czasem.",
                            "target_lang_translations": {
                                "ru": "Все солдаты должны были <w>явиться</w> к командиру до назначенного времени."
                            }
                        }
                    ],
                    "antonyms": [
                        "wymeldować się"
                    ],
                    "common_phrases": [
                        "zameldować się w hotelu"
                    ],
                    "target_lang_definitions": {
                        "ru": "зарегистрироваться по прибытии в гостиницу или явиться в назначенное место (обычно с «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заселиться",
                                "target_lang_sense_clarification": "в гостиницу, зарегистрироваться при въезде (zameldować się)"
                            },
                            {
                                "target_lang_word": "зарегистрироваться",
                                "target_lang_sense_clarification": "в отеле (zameldować się)"
                            },
                            {
                                "target_lang_word": "явиться",
                                "target_lang_sense_clarification": "отметиться у начальства, прибыть (zameldować się)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "589244b2-65e7-38f6-ae79-180df9314c25",
                    "sense_definition": "złożyć oficjalny raport lub zdać sprawę przełożonemu z wykonania zadania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "raportowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kapitan natychmiast <w>zameldował</w> dowódcy o zakończeniu powierzonej misji.",
                            "target_lang_translations": {
                                "ru": "Капитан немедленно <w>доложил</w> командиру о завершении порученной миссии."
                            }
                        },
                        {
                            "text": "Pracownik <w>zameldował</w> dyrektorowi o gotowości projektu do wdrożenia.",
                            "target_lang_translations": {
                                "ru": "Сотрудник <w>доложил</w> директору о готовности проекта к внедрению."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaraportować",
                        "zgłosić"
                    ],
                    "common_phrases": [
                        "zameldować wykonanie zadania"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать официальный доклад или отчитаться перед начальником о выполнении задачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доложить",
                                "target_lang_sense_clarification": "официально сообщить руководству или командиру"
                            },
                            {
                                "target_lang_word": "рапортовать",
                                "target_lang_sense_clarification": "сдать рапорт, отчитаться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}