                "senses": [
                    {
                        "sense_id": "6ad2cc77-03d3-338f-8df9-447508a91ff1",
                        "entry_id": "d305d75d-7ad6-3a4e-99c0-5649a2d47e0c",
                        "glosses": [
                            "pejorative of соба́ка (sobáka): nasty little dog, stray dog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2242f2ea-178c-4b52-9b3e-1aae6f99512f",
                                "sense_id": "6ad2cc77-03d3-338f-8df9-447508a91ff1",
                                "text": "Сего́дня, одна́ко ж, меня́ ка́к бы све́том озари́ло: я вспо́мнил тот разгово́р двух собачо́нок, кото́рый слы́шал я на Не́вском проспе́кте.",
                                "translation": "To-day there came to me what seemed a heavenly inspiration. I remembered the conversation between the two dogs which I had overheard on the Nevski Prospect.",
                                "english": "To-day there came to me what seemed a heavenly inspiration. I remembered the conversation between the two dogs which I had overheard on the Nevski Prospect."
                            }
                        ]
                    }
                ],
