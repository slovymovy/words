                    },
                    {
                        "translation_id": "72abff3c-03dc-4113-8ebb-061fbfb4ca1a",
                        "source_entry_id": "b7eae806-ea4e-3009-b0ca-57269d883487",
                        "source_sense_id": "eac252ed-5aa7-33d2-8f1a-b00ec3c5ebc2",
                        "target_lang_word": "homeopatie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
