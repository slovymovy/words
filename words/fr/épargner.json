{
    "word_family": [
        "épargne",
        "épargnant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cc321c2-c5a5-37d1-82a5-c7c19666d8ca",
                    "sense_definition": "Mettre de l'argent en réserve au lieu de le dépenser.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaie d'<w>épargner</w> chaque mois pour s'offrir un voyage l'été prochain."
                        },
                        {
                            "text": "Elle a réussi à <w>épargner</w> une belle somme grâce à son travail."
                        }
                    ],
                    "synonyms": [
                        "économiser",
                        "thésauriser"
                    ],
                    "antonyms": [
                        "dépenser",
                        "gaspiller"
                    ],
                    "common_phrases": [
                        "épargner de l'argent"
                    ]
                },
                {
                    "sense_id": "4432dacf-997a-38b0-bb91-013ec7cb2a58",
                    "sense_definition": "Dispenser ou préserver quelqu'un d'une chose pénible, ne pas la lui faire subir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "soulagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a voulu lui <w>épargner</w> les détails trop inquiétants de son état."
                        },
                        {
                            "text": "Tu peux m'<w>épargner</w> tes explications inutiles, je connais déjà toute l'histoire."
                        }
                    ],
                    "synonyms": [
                        "dispenser",
                        "éviter"
                    ],
                    "antonyms": [
                        "imposer",
                        "infliger"
                    ],
                    "common_phrases": [
                        "épargner les détails",
                        "épargner la peine"
                    ]
                },
                {
                    "sense_id": "6e50f53c-4a4c-3784-934b-a48522d5e236",
                    "sense_definition": "Ménager quelque chose, ne l'employer qu'avec modération ou retenue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moderation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>épargner</w> nos provisions de bois car l'hiver sera particulièrement rude."
                        },
                        {
                            "text": "Le cuisinier n'a pas <w>épargné</w> les épices pour relever ce plat traditionnel."
                        }
                    ],
                    "synonyms": [
                        "ménager",
                        "conserver"
                    ],
                    "antonyms": [
                        "gaspiller",
                        "prodiguer"
                    ],
                    "common_phrases": [
                        "ne rien épargner"
                    ]
                },
                {
                    "sense_id": "e4422387-655e-325c-92ae-183aae07228c",
                    "sense_definition": "Laisser la vie sauve à quelqu'un, ne pas le tuer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat a supplié ses ennemis d'<w>épargner</w> sa vie pendant la bataille."
                        },
                        {
                            "text": "Le roi a décidé d'<w>épargner</w> les rebelles capturés après la révolte."
                        }
                    ],
                    "synonyms": [
                        "gracier"
                    ],
                    "antonyms": [
                        "abattre",
                        "exécuter",
                        "tuer"
                    ],
                    "common_phrases": [
                        "épargner la vie"
                    ]
                },
                {
                    "sense_id": "675e39bd-5e27-3164-8cfb-f954c1770046",
                    "sense_definition": "Ne pas détruire ou ne pas frapper, en parlant d'un fléau, d'une maladie ou d'un désastre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par miracle, la tempête a <w>épargné</w> ce petit village côtier et ses bateaux."
                        },
                        {
                            "text": "Cette terrible épidémie n'a malheureusement <w>épargné</w> aucune région du pays."
                        }
                    ],
                    "synonyms": [
                        "préserver"
                    ],
                    "antonyms": [
                        "dévaster",
                        "frapper",
                        "ravager"
                    ]
                }
            ]
        }
    ]
}