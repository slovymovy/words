                "senses": [
                    {
                        "sense_id": "840c6c10-8f2b-3892-921f-ffc97d23a334",
                        "entry_id": "77cd7d86-7bea-3c7d-a9d5-32367b1b4e41",
                        "glosses": [
                            "A small pool of standing water; a puddle."
                        ],
                        "tags": [
                            "UK",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "fe6edba8-f977-40cc-8d12-f31d033d8626",
                                "sense_id": "840c6c10-8f2b-3892-921f-ffc97d23a334",
                                "text": "Out of the wound the red bloud flowed fresh, / That vnderneath his feet soone made a purple plesh."
                            },
                            {
                                "example_id": "d2663f11-7b6a-4bd0-98fc-0a84eec1dc3f",
                                "sense_id": "840c6c10-8f2b-3892-921f-ffc97d23a334",
                                "text": "Hereof Aesop framed the Fable of the two Frogs that consulted together in time of drowth (when many plashes that they had repayred to were dry) what was to be done."
                            },
                            {
                                "example_id": "95a01759-bcea-4fdc-aea0-eb08edbf6003",
                                "sense_id": "840c6c10-8f2b-3892-921f-ffc97d23a334",
                                "text": "Who were the strugglers, what war did they wage, / Whose savage trample thus could pad the dank / Soil to a plash? [...]"
                            },
                            {
                                "example_id": "554dd9a7-f3a4-4a99-8afc-819166e9ae12",
                                "sense_id": "840c6c10-8f2b-3892-921f-ffc97d23a334",
                                "text": "These shallow plashes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a4ce6d2-b95b-3ef9-adcd-c5d9dc77fc40",
                        "entry_id": "77cd7d86-7bea-3c7d-a9d5-32367b1b4e41",
                        "glosses": [
                            "A splash, or the sound made by a splash."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efb08cf-073a-44f9-98c9-cd7f94ada2a9",
                                "sense_id": "7a4ce6d2-b95b-3ef9-adcd-c5d9dc77fc40",
                                "text": "Presently a gondola passed along the canal with its slow rhythmical plash, and as we listened we watched it in silence."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7e2eadb-8546-3c6a-8a25-93abfe2aa2e5",
                        "entry_id": "77cd7d86-7bea-3c7d-a9d5-32367b1b4e41",
                        "glosses": [
                            "A sudden downpour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a75fe7-2102-440b-9aa2-1a23b8a02586",
                                "sense_id": "e7e2eadb-8546-3c6a-8a25-93abfe2aa2e5",
                                "text": "[...] down burst torrents of thick rain and muddied us to the skin. The valley began to run in plashes of water, and Dakhil-Allah urged us across it quickly. [...]"
                            }
                        ]
                    }
                ],
