                                "target_senses": [
                                    {
                                        "sense_id": "d9ce7a67-07c6-39d1-b113-4c83c4fbad27",
                                        "entry_id": "fbc1941e-f60d-3a20-a3d2-1fe08efa23d0",
                                        "glosses": [
                                            "To plot, or contrive a plan; to manuever."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd2da072-23fe-4b7d-8a01-0cc95be6906d",
                                                "sense_id": "d9ce7a67-07c6-39d1-b113-4c83c4fbad27",
                                                "text": "Laura snatches coins from inside a truck to make a telephone call, scrounges shoes and clothes for them at a municipal beach, schemes to get a room key so she and Howie can sleep overnight in the Starlight Motel, steals a Jeepster from a deputy sheriff who's trying to arrest them."
                                            },
                                            {
                                                "example_id": "8d95fdaa-692d-4646-89f3-a56a622b3580",
                                                "sense_id": "d9ce7a67-07c6-39d1-b113-4c83c4fbad27",
                                                "text": "The openly ridiculous plot has The Pirate Captain (Hugh Grant) scheming to win the Pirate Of The Year competition, even though he’s a terrible pirate, far outclassed by rivals voiced by Jeremy Piven and Salma Hayek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce5e07b-54b3-3e56-97d2-52679085cfaf",
                                        "entry_id": "fbc1941e-f60d-3a20-a3d2-1fe08efa23d0",
                                        "glosses": [
                                            "To plan; to contrive; to manuever."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a80feb-6126-45c7-b5bf-295efffd094a",
                                                "sense_id": "bce5e07b-54b3-3e56-97d2-52679085cfaf",
                                                "text": "He schemed a plot. He made use of the hotel's stationery to write a letter."
                                            }
                                        ]
