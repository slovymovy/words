                "senses": [
                    {
                        "sense_id": "9fd8b020-f176-383f-8052-6071dc2ed04b",
                        "entry_id": "50839ee4-b26b-3691-a6f5-45ab02a3d620",
                        "glosses": [
                            "Kind aus einer Arbeiterfamilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3d3664-8d35-4f4a-8244-b87808ddd2c0",
                                "sense_id": "9fd8b020-f176-383f-8052-6071dc2ed04b",
                                "text": "„Heute sind etwa ein Fünftel der Gymnasiasten Arbeiterkinder.“"
                            },
                            {
                                "example_id": "2b576e4f-1b25-4a81-9b32-923161420040",
                                "sense_id": "9fd8b020-f176-383f-8052-6071dc2ed04b",
                                "text": "„Und so lasse ich Hilla Palm noch einmal selbst zu Wort kommen, Hilla Palm, Arbeiterkind aus Dondorf am Rhein, katholisch getauft und erzogen, jetzt heidnisch-katholisch, wie sie und ihr Hugo aus dem rheinisch-katholischen Großbürgertum gern scherzen.“"
                            },
                            {
                                "example_id": "ee7d2ee9-a7fc-48e3-a1c1-25773ea7394c",
                                "sense_id": "9fd8b020-f176-383f-8052-6071dc2ed04b",
                                "text": "„Bei Edgar Wieneken war es im umgekehrten Sinn peinlich, er wurde überall als Arbeiterkind eingeführt und vorgestellt; es gab sogar Priester, die, wenn sie ihn vorstellten, sagten: »Ein waschechtes Arbeiterkind«, das klang so, als wenn sie gesagt hätten: Seht mal, der hat gar keine Hörner und sieht ganz intelligent aus.“"
                            },
                            {
                                "example_id": "898e7935-8b60-4ffe-8f57-a6e3863c538b",
                                "sense_id": "9fd8b020-f176-383f-8052-6071dc2ed04b",
                                "text": "„Es gibt Arbeiterkinder, die es trotz allem [Anmerkung: trotz aller Benachteiligungen] in den Spitzensport schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
