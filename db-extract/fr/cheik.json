                "senses": [
                    {
                        "sense_id": "7785c806-c78f-357d-bc20-ee3e9fb4e47a",
                        "entry_id": "a053f6ae-3ef3-37ff-911d-00bdcbcf138d",
                        "glosses": [
                            "Chef de tribu chez les bédouins arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5491b1-b301-4f7f-965e-3558dea37586",
                                "sense_id": "7785c806-c78f-357d-bc20-ee3e9fb4e47a",
                                "text": "Le maréchal de Mac-Mahon au Sénat, c’est une individualité mêlée à d’autres individualités, tandis qu’à la Présidence, il est seul et unique. C’est comme si l’on offrait le poste de sénateur au bach-aga qui assistait à la séance de la Chambre dans la tribune diplomatique. Il répondrait simplement : « Je ne veux pas être sénateur, comme M. Tolain, puisque je suis bach-aga, grand cheik de ma tribu, presque sultan, presque calife, presque pacha. »"
                            },
                            {
                                "example_id": "89620b92-c693-46f8-aa3d-df2c8105f921",
                                "sense_id": "7785c806-c78f-357d-bc20-ee3e9fb4e47a",
                                "text": "Quand la tribu parcourt le désert, son chef, le cheik, chevauche à sa tête."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc86666-c179-355e-b131-c991bb9fd3e3",
                        "entry_id": "a053f6ae-3ef3-37ff-911d-00bdcbcf138d",
                        "glosses": [
                            "Homme respecté en raison de son grand âge ou de ses connaissances."
                        ],
                        "tags": [
                            "Pays musulmans"
                        ],
                        "examples": [
                            {
                                "example_id": "ae5f1da3-2216-49e7-a7af-2ce1be082607",
                                "sense_id": "9bc86666-c179-355e-b131-c991bb9fd3e3",
                                "text": "Le sultan tira leur chef à l’écart : \"Bon scheik, lui dit-il, vous savez peut-être déjà le sujet qui m'amène.\""
                            },
                            {
                                "example_id": "f9f0d830-fe8c-4d8f-95fc-529af25c6587",
                                "sense_id": "9bc86666-c179-355e-b131-c991bb9fd3e3",
                                "text": "Le blanc étant la couleur de distinction chez les Arabes, ils jugèrent que mon domestique était le chéik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1006e81-2b16-47e7-9f5f-af567815aba2",
                        "source_entry_id": "a053f6ae-3ef3-37ff-911d-00bdcbcf138d",
                        "source_sense_id": "9bc86666-c179-355e-b131-c991bb9fd3e3",
                        "source_sense_description": "Homme respecté en raison de son grand âge ou de ses connaissances",
                        "target_lang_word": "Scheich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4c41b6-ee8e-3189-a03a-65472c60df86",
                                        "entry_id": "27bef468-7d39-3dfe-bfe1-06037653f609",
                                        "glosses": [
                                            "Familienoberhaupt, Oberhaupt eines Stammes"
                                        ],
                                        "tags": [
                                            "arabischer Titel",
                                            "Ehrentitel",
                                            "auch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "813b8ca4-637c-4ef1-b5e8-f93eed71b65a",
                                                "sense_id": "7c4c41b6-ee8e-3189-a03a-65472c60df86",
                                                "text": "Heute trifft der Scheich aus Katar die Kanzlerin in Berlin."
                                            },
                                            {
                                                "example_id": "9b8e1917-6ff4-4cb4-825b-b0f0735e4612",
                                                "sense_id": "7c4c41b6-ee8e-3189-a03a-65472c60df86",
                                                "text": "„Wenn ich reich wär, reich wie ein Scheich wär […]“ - (alter Schlager (Gerd Böttcher - Geld wie Heu))"
                                            },
                                            {
                                                "example_id": "b01a456b-7a4d-4f9a-bad4-a27f7a953b65",
                                                "sense_id": "7c4c41b6-ee8e-3189-a03a-65472c60df86",
                                                "text": "„Der neue Scheich regierte ganz so wie sein Vorgänger und verschwand gleich ihm am letzten Freitag eines jeden Monats.“"
                                            },
                                            {
                                                "example_id": "9bd6cb8e-3e57-4608-8989-6c5dc41f8117",
                                                "sense_id": "7c4c41b6-ee8e-3189-a03a-65472c60df86",
                                                "text": "„Der Scheich sah nicht aus wie ein Scheich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37d94ca4-07df-3b7b-9891-4fd6f9f423bc",
                                        "entry_id": "27bef468-7d39-3dfe-bfe1-06037653f609",
                                        "glosses": [
                                            "Spitzname für den Bootsmann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e9aa32-3a28-4e76-a695-21655cae46ba",
                                                "sense_id": "37d94ca4-07df-3b7b-9891-4fd6f9f423bc",
                                                "text": "Der Scheich (Bootsmann) hatte extra seine weiße Dienstmütze aufgesetzt, denn egal auf welchem Schiff, der Scheich hatte immer eine weiße Mütze auf, und stimmte den ersten Shanty an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "986fcfbb-9a62-364b-9489-0de0f41a6591",
                                        "entry_id": "27bef468-7d39-3dfe-bfe1-06037653f609",
                                        "glosses": [
                                            "unangenehmer Mensch"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3ac988-32f7-4aa7-b956-5d7dfce9bf72",
                                                "sense_id": "986fcfbb-9a62-364b-9489-0de0f41a6591",
                                                "text": "Was für ein Scheich der ist, unangenehm."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "21c6a64e-4f00-3014-b70a-644f022c37b6",
                                        "entry_id": "27bef468-7d39-3dfe-bfe1-06037653f609",
                                        "glosses": [
                                            "Freund eines Mädchens"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f89c8-7880-4ee5-baf0-f4e3e1171b00",
                                                "sense_id": "21c6a64e-4f00-3014-b70a-644f022c37b6",
                                                "text": "Die hat jetzt auch einen Scheich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Scheich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80c77cde-9d22-3bd1-8937-7bb77fe42f3f",
                                        "entry_id": "a4d3a549-7229-32ff-a556-bba95d432fcf",
