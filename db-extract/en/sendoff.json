    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                "word": "sendoff",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f984a865-12ef-4ff6-a905-190323bee56b",
                        "entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "tags": [
                            "plural"
                        ],
                        "form": "sendoffs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b94e982-668d-37bd-9708-8d0c60867975",
                        "entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "glosses": [
                            "A party for a person (e.g. a fellow employee) who is leaving; a farewell party."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3ef878-6341-4248-8a11-8f41a0dd163f",
                                "sense_id": "5b94e982-668d-37bd-9708-8d0c60867975",
                                "text": "We had a sendoff for our departing colleague as he left for a new job."
                            }
                        ]
                    },
                    {
                        "sense_id": "d45b76b8-3b93-383b-8876-5b87d5063c08",
                        "entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "glosses": [
                            "A party to recognize the passing (death) of a friend and allow survivors to reminisce about the person's life."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92d66ff3-db31-4fbf-b027-93ee842e5229",
                        "source_entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "source_sense_description": "farewell party",
                        "target_lang_word": "fête d'adieu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fête d'adieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                        "entry_id": "309f42a9-225d-3f4b-b7e0-7fba018152f4",
                                        "glosses": [
                                            "Fête organisée pour un départ, le plus souvent celui d'un salarié d'une entreprise/administration, ou bien d'un ami avant un déménagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "807ec0ce-6e33-4771-95d6-ea6afdfba764",
                                                "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                                "text": "Frodo donna sa fête d’adieu : elle était restreinte, un simple dîner pour lui et ses quatre commensaux ; mais il était troublé, et il ne se sentait pas dans l’humeur adéquate."
                                            },
                                            {
                                                "example_id": "e5aa712f-980c-46e3-98b9-901712f39ac4",
                                                "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                                "text": "Mme la directrice et les professeurs ont organisé une petite fête d’adieu. La cérémonie s’est tenue à la cantine. Yves était beaucoup plus populaire qu’il ne l’imaginait, tous les parents d’élèves sont venus et je crois que ça l’a beaucoup ému."
                                            },
                                            {
                                                "example_id": "da125a5e-afc3-4010-83fa-43e4dfdcb033",
                                                "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                                "text": "Dane Stone donnait bien une réception à ses amis favoris. Et à en croire les brillantes iluminations et la musique qui s’échappait par toutes les fenétres, c’était une féte d’adieu que nul n’était prés d’oublier."
                                            },
                                            {
                                                "example_id": "61ee102e-6dff-478b-b661-03d38f4d0732",
                                                "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                                "text": "Elle ne vint cependant pas à la fête d’adieu que les gens du centre organisèrent quelques jours avant mon départ. Elle en avait décidé ainsi: « Moi, je fête quand je suis contente, pas quand je suis triste »."
                                            },
                                            {
                                                "example_id": "9999be9f-14dd-46a9-b7db-a467d5ae655f",
                                                "sense_id": "a30fc954-bf7d-301e-a6f4-69e2980b5d65",
                                                "text": "L’immeuble tout entier bruissait d’excitation, depuis que la grande nouvelle était connue. Puis la date du mariage ne fut plus qu’a une semaine. L’ensemble du personnel organisa une petite fete d’adieu en l’honneur de Carolyn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8423bb3-83bf-4777-b197-9c08649b5306",
                        "source_entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "source_sense_description": "farewell party",
                        "target_lang_word": "pot de départ",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pot de départ",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3210d9-aa61-3bb0-bd7c-34d256562011",
                                        "entry_id": "9e0479e0-a93d-3c6a-9c18-65ac326bda57",
                                        "glosses": [
                                            "Collation, plus ou moins alcoolisée, pour fêter, entre collègues, le départ d'un salarié d'une entreprise ou d'une administration."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b48fc7e-9489-4faa-a5fb-ba85e18d8cde",
                                                "sense_id": "1e3210d9-aa61-3bb0-bd7c-34d256562011",
                                                "text": "Octobre 2004 , je vais quitter Renault à la fin du mois, je prépare mon pot de départ. Inévitablement, c’est l’occasion d’un flash-back sur ma carrière professionnelle."
                                            },
                                            {
                                                "example_id": "4bf45d9e-39aa-43b3-89e2-510b6426e04b",
                                                "sense_id": "1e3210d9-aa61-3bb0-bd7c-34d256562011",
                                                "text": "Évidemment, le fameux « pot de départ » est préparé avec une discrétion douteuse. Derrière un paravent de l’open space, tu entends ton boss parler à un autre stagiaire, […]."
                                            },
                                            {
                                                "example_id": "fc375d18-df05-4743-9090-a8aa82f5bc1c",
                                                "sense_id": "1e3210d9-aa61-3bb0-bd7c-34d256562011",
                                                "text": "Tu sais que le DRH part à la retraite? - Oui, j'organise un pot de départ et je récolte l'argent, 10 euros chacun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f424a07-85ae-49cd-be77-3f0cf7fdbfa1",
                        "source_entry_id": "d1fe13e3-489a-3b9c-a64a-e3b7e9b6bf72",
                        "source_sense_description": "farewell party",
                        "target_lang_word": "Abschiedsfeier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschiedsfeier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                        "entry_id": "78f49129-c7f2-33d5-ab6e-074b7b440c02",
                                        "glosses": [
                                            "Feier, die veranstaltet wird, um jemanden zu verabschieden (beispielsweise bei einem Umzug, einer Reise oder Ähnlichem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8212df3b-18cf-4e39-b9c3-2c17b994f82e",
                                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                                "text": "Ich werde für ihn eine Abschiedsfeier organisieren."
                                            },
                                            {
                                                "example_id": "376b8b35-8fcc-40c9-9175-9661254444d3",
                                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                                "text": "„Freunde und Familie hatten eine königliche Abschiedsfeier für mich veranstaltet, viele von ihnen waren, trotz kühler Temperaturen, auf den verschiedensten Motorrädern aus allen Ecken Großbritanniens angereist.“"
                                            },
                                            {
                                                "example_id": "9f19055f-ccbd-4ae0-a14d-2ac83bde35d9",
                                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                                "text": "„Die Abschiedsfeier für Rolande begann pünktlich um sechs Uhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
