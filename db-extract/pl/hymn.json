                    {
                        "sense_id": "8c6f1eac-19ac-3591-9194-be29db34a435",
                        "entry_id": "1442064a-d0af-3e0e-a172-dce5cafe6fb9",
                        "glosses": [
                            "uroczysta i podniosła pieśń pochwalna o apostroficznym charakterze wypowiedzi, komponowana na cześć bóstwa, szczególnej osoby, wydarzenia, ojczyzny (kraju), a także idei"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "cf9637f6-9e9c-4136-8199-5a132ba6657a",
                                "sense_id": "8c6f1eac-19ac-3591-9194-be29db34a435",
                                "text": "Wydaje mi się, że włoski hymn narodowy jest bardzo długi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b593abc1-aa9e-454a-aa78-d96362741d3a",
