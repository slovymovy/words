                ],
                "senses": [
                    {
                        "sense_id": "a744f0ed-6d34-3cea-ab0b-99bcb186fd27",
                        "entry_id": "d27b2d4c-3fb5-3f4b-9b33-02c947bd036f",
                        "glosses": [
                            "Se prescrire à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed4737a-08c4-4caf-ba63-ec025d195045",
                                "sense_id": "a744f0ed-6d34-3cea-ab0b-99bcb186fd27",
                                "text": "S'auto-traiter, ce n'est pas uniquement s'auto-prescrire et obtenir la médication du pharmacien."
                            },
                            {
                                "example_id": "fb8b738f-60b3-48d3-9931-426e8c1350d9",
                                "sense_id": "a744f0ed-6d34-3cea-ab0b-99bcb186fd27",
                                "text": "Bref, 3 jours après avoir lu le livre du Dr Ameisen, je me suis décidé à m'auto-prescrire du Baclofène."
                            },
                            {
                                "example_id": "c42a9338-0148-4d7d-8cc7-291385da33ba",
                                "sense_id": "a744f0ed-6d34-3cea-ab0b-99bcb186fd27",
                                "text": "Avant toute chose, il ne faut surtout pas s'auto-prescrire de l'huile essentielle d'hélichryse."
                            }
                        ]
                    }
