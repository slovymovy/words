                                "target_lang_word": "mordiller",
                                "target_lang_sense_clarification": "mordre doucement et de façon répétée"
                            },
                            {
                                "target_lang_word": "croquer",
                                "target_lang_sense_clarification": "mordre tendrement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecf40811-6054-382a-9f3c-a94cae8302a9",
                    "sense_definition": "To make one's way through or across an area while taking small bites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cows <w>nibbled</w> their way across the green field.",
                            "target_lang_translations": {
                                "ru": "Коровы медленно <w>проедали</w> себе путь через зеленое поле.",
                                "zh": "牛群一边<w>吃</w>着草，一边穿过了绿色的田野。",
                                "fr": "Les vaches ont <w>grignoté</w> de l'herbe en traversant le champ vert."
                            }
                        },
                        {
                            "text": "He had <w>nibbled</w> his way through a whole bag of chips before the show ended.",
                            "target_lang_translations": {
                                "ru": "Он <w>схомячил</w> целую пачку чипсов еще до конца шоу.",
                                "zh": "节目结束前，他已经把一整袋薯片<w>吃</w>光了。",
                                "fr": "Il avait <w>grignoté</w> tout un paquet de chips avant la fin de l'émission."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвигаться куда-либо, попутно откусывая или съедая что-то маленькими порциями.",
                        "zh": "指一边移动一边沿途吃东西。",
                        "fr": "Avancer dans un espace tout en mangeant de petites portions."
