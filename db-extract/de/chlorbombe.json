                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b885e43b-ef56-47a6-963c-8994d36a97f9",
                                "sense_id": "a2c6b155-4123-389e-a871-7cc9d8dc95d1",
                                "text": "„Am 10. April schlug die erste Chlorbombe ein, verletzte aber niemanden.“"
                            },
                            {
                                "example_id": "b0706629-e91f-4edd-a3c1-15ef3472d951",
                                "sense_id": "a2c6b155-4123-389e-a871-7cc9d8dc95d1",
                                "text": "„Wenn eine Chlorbombe hochgeht, verteilt sich das grünliche Gas in der Luft.“"
                            },
                            {
                                "example_id": "2a817396-d235-4ea6-a84c-ff8f517c788f",
                                "sense_id": "a2c6b155-4123-389e-a871-7cc9d8dc95d1",
                                "text": "„In Hot Zone etwa, einem Spiel für Feuerwehrleute, explodiert im Einkaufszentrum eine Chlorgasbombe.“"
                            }
                        ],
