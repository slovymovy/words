                    "sense_id": "1db2757f-a933-37ec-8120-1d88a0a6ca66",
                    "sense_definition": "system transportu ludzi i towarów oraz infrastruktura służąca do przemieszczania się",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Codziennie rano korzystam z <w>komunikacji</w> miejskiej, aby dojechać do szkoły.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я пользуюсь общественным <w>транспортом</w>, чтобы доехать до школы.",
                                "en": "Every morning I use public <w>transport</w> to get to school."
                            }
                        },
                        {
                            "text": "Zimą <w>komunikacja</w> autobusowa w naszym mieście często ma opóźnienia.",
                            "target_lang_translations": {
                                "ru": "Зимой автобусное <w>сообщение</w> в нашем городе часто работает с задержками.",
                                "en": "In winter, the bus <w>service</w> in our city is often delayed."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "przewozy"
                    ],
                    "common_phrases": [
                        "komunikacja miejska",
                        "środki komunikacji",
                        "komunikacja autobusowa",
                        "komunikacja zbiorowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система транспорта людей и товаров, а также инфраструктура для перемещения",
                        "en": "A system of transporting people and goods, as well as the infrastructure used for movement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транспорт",
                                "target_lang_sense_clarification": "система перевозки"
                            },
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "транспортная связь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "transport",
                                "target_lang_sense_clarification": "system of moving people or goods"
                            },
                            {
                                "target_lang_word": "transportation",
                                "target_lang_sense_clarification": "the means or system of moving"
                            },
                            {
                                "target_lang_word": "links",
                                "target_lang_sense_clarification": "transport connections between places"
                            }
                        ]
