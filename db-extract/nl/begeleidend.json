                            {
                                "example_id": "44e9c1ae-1eea-4bc8-abd4-687da1e6ebc1",
                                "sense_id": "f91fda6d-4e60-3d68-b51c-cc50e4db026c",
                                "text": "Hoe deze computer werkt kunt u in de begeleidende gebruiksaanwijzing lezen."
                            },
                            {
                                "example_id": "18236b04-4d4c-4b31-9a06-7fc8d69a2d98",
                                "sense_id": "f91fda6d-4e60-3d68-b51c-cc50e4db026c",
                                "text": "Het produceren van zichtbaar licht is een begeleidend verschijnsel van het warmer worden van een gloeidraad."
                            },
                            {
                                "example_id": "6fc61e6b-85bd-4678-b3c8-d9e56b75c7e6",
                                "sense_id": "f91fda6d-4e60-3d68-b51c-cc50e4db026c",
                                "text": "De miniatuursymbolen aan haar halsketting zorgden voor een begeleidend klokkenspel van bescheiden aard."
                            },
                            {
                                "example_id": "572261eb-27ce-4acf-b097-bd02b1204a0a",
                                "sense_id": "f91fda6d-4e60-3d68-b51c-cc50e4db026c",
                                "text": "Want er waren geen begeleidende verwijten bij de beelden die ze nu voor zich zag."
                            }
                        ]
                    }
