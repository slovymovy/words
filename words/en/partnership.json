{
    "word_family": [
        "partner",
        "copartner",
        "copartnership"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29745027-9151-3601-82ab-75240edd6ca5",
                    "sense_definition": "The state of being a partner or participating in a joint activity with others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "association_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university works in <w>partnership</w> with local businesses to provide internships.",
                            "target_lang_translations": {
                                "ru": "Университет работает в <w>партнёрстве</w> с местными компаниями для предоставления стажировок.",
                                "zh": "大学与当地企业建立<w>伙伴关系</w>，为学生提供实习机会。"
                            }
                        },
                        {
                            "text": "A successful <w>partnership</w> relies on open communication and mutual trust.",
                            "target_lang_translations": {
                                "ru": "Успешное <w>партнёрство</w> держится на открытом общении и взаимном доверии.",
                                "zh": "成功的<w>合作</w>建立在坦诚沟通与相互信任的基础上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collaboration",
                        "cooperation",
                        "alliance",
                        "association"
                    ],
                    "antonyms": [
                        "rivalry",
                        "competition"
                    ],
                    "common_phrases": [
                        "in partnership with",
                        "working in partnership",
                        "public-private partnership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние партнёрства или участие в совместной деятельности с другими людьми.",
                        "zh": "指与他人共同参与某项活动或建立合作关系的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёрство",
                                "target_lang_sense_clarification": "совместная деятельность"
                            },
                            {
                                "target_lang_word": "сотрудничество",
                                "target_lang_sense_clarification": "взаимодействие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合作",
                                "target_lang_sense_clarification": "共同协作"
                            },
                            {
                                "target_lang_word": "伙伴关系",
                                "target_lang_sense_clarification": "合作的状态或性质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "285d8d99-4cc2-3b52-a40e-fa1657743120",
                    "sense_definition": "A formal arrangement where two or more people own and run a business together.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to form a <w>partnership</w> to combine their skills and resources.",
                            "target_lang_translations": {
                                "ru": "Они решили оформить <w>партнёрство</w>, чтобы объединить свои навыки и ресурсы.",
                                "zh": "他们决定建立<w>合伙</w>关系，以整合各自的技能与资源。"
                            }
                        },
                        {
                            "text": "The lawyers dissolved their <w>partnership</w> when one of them retired.",
                            "target_lang_translations": {
                                "ru": "Юристы расторгли своё <w>товарищество</w>, когда один из них вышел на пенсию.",
                                "zh": "其中一名律师退休后，他们解散了<w>合伙企业</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "firm",
                        "company",
                        "consortium",
                        "syndicate"
                    ],
                    "antonyms": [
                        "sole proprietorship"
                    ],
                    "common_phrases": [
                        "limited partnership",
                        "general partnership",
                        "form a partnership",
                        "dissolve a partnership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное соглашение, по которому два или более лица владеют бизнесом и управляют им совместно.",
                        "zh": "一种正式的商业安排，由两人或多人共同拥有并经营企业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищество",
                                "target_lang_sense_clarification": "организационно-правовая форма"
                            },
                            {
                                "target_lang_word": "партнёрство",
                                "target_lang_sense_clarification": "бизнес-союз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合伙企业",
                                "target_lang_sense_clarification": "法律上的商业实体"
                            },
                            {
                                "target_lang_word": "合伙",
                                "target_lang_sense_clarification": "共同经营的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443d7708-d4dc-355b-8d6e-0a3322f8f242",
                    "sense_definition": "In cricket, the period during which two specific batters play together, or the number of runs they score.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opening <w>partnership</w> scored over a hundred runs before the first wicket fell.",
                            "target_lang_translations": {
                                "ru": "Открывающее <w>партнёрство</w> набрало более ста очков до падения первой калитки.",
                                "zh": "在第一个出局门出现前，开局的<w>搭档得分</w>已超过一百分。"
                            }
                        },
                        {
                            "text": "Their solid <w>partnership</w> helped the team recover from a poor start.",
                            "target_lang_translations": {
                                "ru": "Их надежное <w>партнёрство</w> помогло команде оправиться после неудачного старта.",
                                "zh": "他们稳健的<w>搭档得分</w>帮助球队从糟糕的开局中恢复过来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stand"
                    ],
                    "common_phrases": [
                        "opening partnership",
                        "century partnership",
                        "break a partnership"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "cricket"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: период, в течение которого два отбивающих играют вместе, или количество очков, набранных ими за это время.",
                        "zh": "在板球运动中，指两名击球手共同在场击球的阶段，或他们在此期间共同得分的总数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёрство",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭档得分",
                                "target_lang_sense_clarification": "板球术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}