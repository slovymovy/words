                        ],
                        "form": "сте́льны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                        "entry_id": "053b8bc9-dd52-3121-ade5-74907626ab02",
                        "glosses": [
                            "о коровах и самках некоторых других млекопитающих: находящийся в состоянии беременности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d638ed16-9eb8-42d3-b473-0b6bb9fc2641",
                                "sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                                "text": "Стельный и молодой скот, встая и ложась, присматривать."
                            },
                            {
                                "example_id": "b28c134b-e619-4613-be1d-976d4b4a393a",
                                "sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                                "text": "Стоит бабка в церкви, молится своей «Заступнице усердной» — Бурёнушка стельная, дай, матерь божья, тёлочку!"
                            },
                            {
                                "example_id": "d64aa6d7-d906-4bb7-8f7e-4eaf7669cc3e",
                                "sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                                "text": "А что тут понимать, говорит, у меня коровы-то огуленные были, одна, правда, яловая — он её мне отдал, но вторая-то стельная, а он молчок, свояк мой — понял?.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11e32645-c9c0-444c-a853-65241b8acb16",
                        "source_entry_id": "053b8bc9-dd52-3121-ade5-74907626ab02",
                        "source_sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                        "target_lang_word": "pleine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f42926d7-9b4f-3114-952a-1632203dea41",
                                        "entry_id": "c03e048f-bc86-3168-82f2-1040e98db4e2",
                                        "glosses": [
                                            "Féminin singulier de plein."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd52515c-d6e5-451e-aeb6-8658961cc63f",
                                                "sense_id": "f42926d7-9b4f-3114-952a-1632203dea41",
                                                "text": "L’enfant se fait homme ou devient jeune fille, Et cependant que croît sa chair pleine de grâce, Son âme se répand par-delà la famille, Et cherche une âme sœur, une chair qu’il enlace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pleine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d323beaf-0e49-318e-a560-ab1c26c32e24",
                                        "entry_id": "5d6311cb-e12e-3bc4-b9e7-ed178277eece",
                                        "glosses": [
                                            "Qualifie une femelle gravide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a4ddfd-ec49-459a-97bb-9a227e1d815f",
                                                "sense_id": "d323beaf-0e49-318e-a560-ab1c26c32e24",
                                                "text": "Cette vache est pleine depuis des mois ; j’ai hâte qu’elle vêle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c92636-c793-39b1-ac77-51b10332cc3c",
                                        "entry_id": "5d6311cb-e12e-3bc4-b9e7-ed178277eece",
                                        "glosses": [
                                            "Qualifie une femme enceinte."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80912fbc-3850-4fd3-8e71-7ecee45e53e1",
                                                "sense_id": "c3c92636-c793-39b1-ac77-51b10332cc3c",
                                                "text": "Vivement que ma femme le ponde, ce mioche : depuis qu’elle est pleine, j’ai pas une minute à moi !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92b8e676-260e-4e4e-accd-d5e7755c92f2",
                        "source_entry_id": "053b8bc9-dd52-3121-ade5-74907626ab02",
                        "source_sense_id": "f8cd5cd6-7c42-31e2-a646-5bed38ea825d",
                        "target_lang_word": "grosse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "886d2645-59f0-3b5e-bd50-321bddbb790b",
                                        "entry_id": "4f9876c8-dc8c-3801-9c6b-98b0593e8bea",
                                        "glosses": [
                                            "Une douzaine de douzaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0592001b-de3d-48f0-a963-8818d0685b72",
                                                "sense_id": "886d2645-59f0-3b5e-bd50-321bddbb790b",
                                                "text": "Une grosse de plumes."
                                            },
                                            {
                                                "example_id": "fdd9c152-17c2-4a31-80f8-1af54dea743f",
                                                "sense_id": "886d2645-59f0-3b5e-bd50-321bddbb790b",
                                                "text": "Une grosse de soie, c’est douze douzaines d’écheveaux de soie."
                                            },
                                            {
                                                "example_id": "b9914213-5236-4bdb-92be-de9d59f22903",
                                                "sense_id": "886d2645-59f0-3b5e-bd50-321bddbb790b",
                                                "text": "— Tout de même, protesta Hélène… Moi, je tiens la comptabilité de notre affaire. Je connais les besoins de la clientèle. Je n’arriverais pas à vendre trois grosses de carrosses par an."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd066b1-a244-314d-9300-7b87d7666e9f",
                                        "entry_id": "4f9876c8-dc8c-3801-9c6b-98b0593e8bea",
                                        "glosses": [
                                            "Expédition, par un notaire, d’une obligation, d’un contrat, etc., ou, par un greffier, d’un jugement, d’un arrêt, qui est délivrée en forme exécutoire et qui était ordinairement écrite en plus gros caractères que la minute. Appelée aujourd’hui dans le droit français copie exécutoire (décret du 26 novembre 1971)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfdce156-68a0-4126-a96f-8fbd5b3794fe",
                                                "sense_id": "acd066b1-a244-314d-9300-7b87d7666e9f",
                                                "text": "La remise de la grosse à un huissier doit être accompagnée d’un certificat du greffier de la juridiction qui l’a rendue."
                                            },
                                            {
                                                "example_id": "12f5ceef-33e2-4961-b078-7dee7eb7176d",
                                                "sense_id": "acd066b1-a244-314d-9300-7b87d7666e9f",
                                                "text": "Le notaire garde la minute et m’en a délivré une grosse."
                                            },
                                            {
                                                "example_id": "9d8cac91-f61b-455f-9c37-7718d89ba4cb",
                                                "sense_id": "acd066b1-a244-314d-9300-7b87d7666e9f",
                                                "text": "— J’ai gagné ! Et maintenant, on fait quoi ?\nAttendez de recevoir la grosse, vous ne pouvez rien faire sans elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77798a09-fd78-369e-89d3-04b72cb293ef",
                                        "entry_id": "4f9876c8-dc8c-3801-9c6b-98b0593e8bea",
                                        "glosses": [
                                            "Écriture en gros caractères pour les copies des actes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726adea5-f5fd-4398-a327-c7dba64cc70d",
                                                "sense_id": "77798a09-fd78-369e-89d3-04b72cb293ef",
                                                "text": "Très au courant du formulaire il écrivit d’une plume alerte, d’abord en grosse : […], puis en minute : […], et la suite à l’avenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c120fbc-bc4b-3c00-ae96-afba3d50b228",
                                        "entry_id": "4f9876c8-dc8c-3801-9c6b-98b0593e8bea",
                                        "glosses": [
                                            "Femme en surpoids."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d5f07bb-c84a-4e23-bfae-b1fcaeaa5065",
                                                "sense_id": "2c120fbc-bc4b-3c00-ae96-afba3d50b228",
                                                "text": "La grosse laide"
                                            },
                                            {
                                                "example_id": "ee6b229e-0092-4d84-87f8-70e548638def",
                                                "sense_id": "2c120fbc-bc4b-3c00-ae96-afba3d50b228",
                                                "text": "Manu a décidé que c'était la bonne destination. Elle a demandé: «Ça va pour toi, grosse?» et Nadine a acquiescé avec enthousiasme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dad89a9-280e-320e-9934-1371a450189d",
                                        "entry_id": "fa2eb3cc-285e-37ec-99b9-f0a76361242d",
                                        "glosses": [
                                            "Féminin singulier de gros."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ed3b91-e9d6-450b-8511-056821f94ea0",
                                                "sense_id": "9dad89a9-280e-320e-9934-1371a450189d",
                                                "text": "À l’époque du frai, les brochets mâles se bagarrent souvent entre eux pour obtenir les faveurs d’une grosse femelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
