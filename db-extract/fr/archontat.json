                "senses": [
                    {
                        "sense_id": "7790358b-7414-32d3-b6aa-96c330af760f",
                        "entry_id": "593755b8-b831-39a7-b236-59bfd0bad8df",
                        "glosses": [
                            "Dignité de l’archonte."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "e75b47cc-6db9-4fc5-9583-4b4609dac363",
                                "sense_id": "7790358b-7414-32d3-b6aa-96c330af760f",
                                "text": "Nous savons aussi que l'archontat, d'abord conféré à vie, puis décennal, devint annuel au moment de l'institution des thesmothètes, ce qui permettait aux chefs des grandes familles de remplir les hautes charges à tour de rôle."
                            }
                        ]
                    },
                    {
                        "sense_id": "094411aa-eea4-3128-a5ce-1b497c382d6b",
                        "entry_id": "593755b8-b831-39a7-b236-59bfd0bad8df",
                        "glosses": [
                            "Temps pendant lequel l’archonte exerçait sa dignité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9107c27-5c8e-4c15-9d61-1d3d3c3b6acc",
                                "sense_id": "094411aa-eea4-3128-a5ce-1b497c382d6b",
                                "text": "Te rappelles-tu ce jour, sous l’archontat de Dionysodore, où un laid petit Juif, parlant le grec des Syriens, vint ici, parcourut tes parvis sans te comprendre, lut tes inscriptions tout de travers et crut trouver dans ton enceinte un autel dédié à un dieu qui serait le Dieu inconnu."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
