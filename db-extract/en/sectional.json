                "translations": [
                    {
                        "translation_id": "9d274fe1-90c6-4550-b0ed-b9746066b3b2",
                        "source_entry_id": "03441f80-d2c9-3c44-871e-4ea0d9ef56fe",
                        "source_sense_description": "relating to a section",
                        "target_lang_word": "partikular",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partikular",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0901977-67e2-3eaf-9825-08f0b2ad5f1e",
                                        "entry_id": "0b4b2a99-6a2b-322a-9749-cbea0dc51522",
                                        "glosses": [
                                            "(nur) einzelne betreffend; eine Minderheit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff15093-d8f6-45cb-bda2-1c70bcb47cc6",
                                                "sense_id": "b0901977-67e2-3eaf-9825-08f0b2ad5f1e",
                                                "text": "Der singuläre Horror von Auschwitz besteht gerade darin, daß er partikular und nicht universal war - sowohl bei der Auswahl der Opfer als auch in der Intention der Täter."
                                            },
                                            {
                                                "example_id": "9b800abe-06ae-4bc9-b09b-442c9e77e11b",
                                                "sense_id": "b0901977-67e2-3eaf-9825-08f0b2ad5f1e",
                                                "text": "Die Verpflichtung auf Demokratie, Verfassung und Gewaltenteilung; die Anerkennung allgemeiner Rechte und individueller Freiheiten, einschließlich der Geschlechtergleichheit; Diskurs, Ironie, Ambivalenz, Toleranz - diese Werte sind keineswegs partikular und auf bestimmte Regionen beschränkt."
                                            },
                                            {
                                                "example_id": "2318fc54-a771-4f84-a6c7-62950de2ca65",
                                                "sense_id": "b0901977-67e2-3eaf-9825-08f0b2ad5f1e",
                                                "text": "„Nun musste Brüning erfahren, dass der geistig und körperlich hinfällige Hindenburg in seinen Entscheidungen zunehmend von einer intriganten Kamarilla abhängig war und zum Vehikel zutiefst partikularer Interessen einzelner rechtsnationaler und ostelbischer Gruppen wurde.“"
                                            },
                                            {
                                                "example_id": "3edc57d5-43b6-4388-b585-2cca6f3d163a",
                                                "sense_id": "b0901977-67e2-3eaf-9825-08f0b2ad5f1e",
                                                "text": "„Das Sultanat von Delhi bemühte sich, die partikularen Herrschaftsformen, die in Indien dominierten, durch eine Zentralgewalt abzulösen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
