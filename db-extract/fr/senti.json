                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ebec5e-5452-4464-a01b-84cc6f51412c",
                                "sense_id": "11423799-1943-3383-9b7c-85e7f9b43614",
                                "text": "Cela est senti, cela est bien senti."
                            },
                            {
                                "example_id": "a8437e0e-8144-4147-90c3-e5893c1f7e7b",
                                "sense_id": "11423799-1943-3383-9b7c-85e7f9b43614",
                                "text": "Un discours bien senti."
                            },
                            {
                                "example_id": "28d4e6dd-f79d-4a73-bc32-9cd149d84a45",
                                "sense_id": "11423799-1943-3383-9b7c-85e7f9b43614",
                                "text": "Ça commençait par de grandes baffes gentilles sur la gueule du chiot qui faisait ce qu’il pouvait pour mordre. Alors ça se terminait par deux ou trois coups de pied bien sentis dans le ventre de l’animal."
                            }
                        ]
                    }
