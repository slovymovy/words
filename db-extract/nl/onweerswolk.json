                    {
                        "sense_id": "e6005902-1b1d-3417-9e4a-36bbedc63174",
                        "entry_id": "11473a5b-3a31-3743-addd-d412a3e4287b",
                        "glosses": [
                            "iets dat op uitbarsten staat"
