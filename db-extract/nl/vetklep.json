                    {
                        "sense_id": "a76e6449-cfe3-3488-b1a8-030f4b56f1a1",
                        "entry_id": "8d5021b1-9a01-334d-8c5d-267c5261ed4f",
                        "glosses": [
                            "iemand met overgewicht"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "16de89eb-8b8e-4a77-86d0-fa8e1879f0e4",
                                "sense_id": "a76e6449-cfe3-3488-b1a8-030f4b56f1a1",
                                "text": "In de laatste maanden van dit jaar werd ze echter regelmatig uitgescholden tijdens het sporten. Termen als 'vetklep', 'dikzak' en 'varken' kreeg ze naar haar hoofd geslingerd."
                            },
                            {
                                "example_id": "37bc3d24-2576-4d1c-9fe4-25d4ea947c76",
                                "sense_id": "a76e6449-cfe3-3488-b1a8-030f4b56f1a1",
                                "text": "Ga eerst eens aan jezelf werken voordat je weer commentaar op het uiterlijk van anderen geeft. Dikke vette vetklep”."
                            },
                            {
                                "example_id": "716dc419-518d-47a8-87a2-93ad9ad8c946",
                                "sense_id": "a76e6449-cfe3-3488-b1a8-030f4b56f1a1",
                                "text": "Pebe gaf Ke$ha's producer Dr. Luke de schuld van haar dochters problemen en vertelde aan People magazine dat hij Ke$ha's eetstoornis heeft veroorzaakt door haar constant een vetklep te noemen."
                            }
                        ]
                    }
