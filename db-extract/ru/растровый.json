                "senses": [
                    {
                        "sense_id": "87926c3b-420a-383e-a307-10925d4f8123",
                        "entry_id": "81b1b234-00a7-34b7-bc8d-5707cb594f26",
                        "glosses": [
                            "использующий растр для получения, хранения информации и её визуализации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7ffe79-b468-4604-857d-c6b557bed5e2",
                                "sense_id": "87926c3b-420a-383e-a307-10925d4f8123",
                                "text": "Растровое клише."
                            },
                            {
                                "example_id": "0f06616e-f8c6-42fc-9ecb-69a6de90511f",
                                "sense_id": "87926c3b-420a-383e-a307-10925d4f8123",
                                "text": "Растровые модели позволяют решать статические линейные задачи."
                            },
                            {
                                "example_id": "5798029e-869a-4a99-8f08-ac63f4778604",
                                "sense_id": "87926c3b-420a-383e-a307-10925d4f8123",
                                "text": "Винтер и Райан Карни из университета Брауна (США) трижды пытались отыскать пигментные клетки в перьях археоптерикса, но лишь третья попытка ― ее результаты были обнародованы в 2012 году ― оказалась удачной благодаря новейшему, чрезвычайно мощному растровому туннельному микроскопу."
                            }
                        ]
                    }
