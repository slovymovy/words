                    },
                    {
                        "translation_id": "c81d2119-3a43-41e4-aeef-4016bbeb7a5c",
                        "source_entry_id": "e68f3f0e-449d-3706-9a4d-21aa78394e0c",
                        "source_sense_description": "срок действия права, ответственности",
                        "target_lang_word": "prescription",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prescription",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75034a9b-0ccc-3164-8922-4f6ca5ba90fb",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "A written order from an authorized medical practitioner for provision of a medicine or other treatment, such as (ophthalmology) the specific lenses needed for a pair of glasses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00e99878-6018-4aa0-9df5-4661598b8b2c",
                                                "sense_id": "75034a9b-0ccc-3164-8922-4f6ca5ba90fb",
                                                "text": "The surgeon had written thousands of prescriptions for pain killers without proper examinations before the police raided the clinic."
                                            },
                                            {
                                                "example_id": "4b11f891-5761-412a-bf74-538c3ea826d1",
                                                "sense_id": "75034a9b-0ccc-3164-8922-4f6ca5ba90fb",
                                                "text": "An old traditional prescription for provoking erotic inclinations ran as follows, The toe of the foot of a man, anointed with oil, or honey, or the ashes of a weasel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef5a2d69-9ad5-3f7c-bd78-6673e9b4bb89",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "The medicine or treatment provided by such an order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904053f4-531b-470b-b77f-434ff6f86e4f",
                                                "sense_id": "ef5a2d69-9ad5-3f7c-bd78-6673e9b4bb89",
                                                "text": "I need you to pick up gramma's prescriptions on your way home."
                                            },
                                            {
                                                "example_id": "bdcccfb9-beb0-49ac-ae55-bde7fe311420",
                                                "sense_id": "ef5a2d69-9ad5-3f7c-bd78-6673e9b4bb89",
                                                "text": "\"Oh, yes; she is the only sort of person for a nurse. She always,\" cried Lady Anne, with a sneer, \"comes to you with a receipt for a pudding in one hand to make you ill, and then a prescription in the other to cure you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9301737-12bc-3027-9f7a-a34fd22d9772",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "Any plan of treatment or handling; the treatment or handling thus provided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c480b19d-81fb-4f96-8679-bd1fa5f67b72",
                                                "sense_id": "b9301737-12bc-3027-9f7a-a34fd22d9772",
                                                "text": "Early to bed and early to rise is a prescription for a long, healthy, and terrible life."
                                            },
                                            {
                                                "example_id": "54e2209e-4aa0-4cda-9721-0d096b55623d",
                                                "sense_id": "b9301737-12bc-3027-9f7a-a34fd22d9772",
                                                "text": "Change is the universal prescription for a wounded spirit. \"It will do you so much good,\" is the constant remark."
                                            },
                                            {
                                                "example_id": "8905c7f1-df86-4c54-b808-92e96913bd6d",
                                                "sense_id": "b9301737-12bc-3027-9f7a-a34fd22d9772",
                                                "text": "...looking at him I saw that I had been wrong in my prescription, if not in my diagnosis, and that the whisky was working against us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef079124-85d7-3c7d-8c90-8589a629d85d",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "Synonym of enactment, the act of establishing a law, regulation, etc., particularly in writing; an instance of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08aede5-39d3-457b-8dff-a9deb085b2f4",
                                                "sense_id": "ef079124-85d7-3c7d-8c90-8589a629d85d",
                                                "text": "A statute that cannot find justification for its prescription in one or more of these principles violates international law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54865b36-f28b-3d35-93d4-2e748fa2d073",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "The act of establishing or formalizing ideal norms for language use, as opposed to describing the actual norms of such use; an instance of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "988600df-7eba-39d9-a233-cea615dfaf54",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "An established time period within which a right must be exercised and after which it is null and permanently unenforceable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa1ea67f-922b-3963-beef-da3d799b5312",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "An established time period after which a person who has uninterruptedly, peacefully, and publicly used another's property acquires full ownership of it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89f54932-718a-376e-adde-4c4c55c7b89d",
                                        "entry_id": "186fe82d-79e4-3eea-80bc-087387624dd2",
                                        "glosses": [
                                            "Synonym of self-restraint, limiting of one's actions especially according to a moral code or social conventions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf8b96a-8992-4c51-a03c-0bb294368be9",
                                                "sense_id": "89f54932-718a-376e-adde-4c4c55c7b89d",
                                                "text": "There is an air of prescription about him which is always agreeable to Sir Leicester; he receives it as a kind of tribute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc5da1c6-51c0-4b2d-bbdd-c355e960ca91",
                        "source_entry_id": "e68f3f0e-449d-3706-9a4d-21aa78394e0c",
                        "source_sense_description": "срок действия права, ответственности",
                        "target_lang_word": "limitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99a8e086-0378-3edb-b69c-2850634348b9",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "The act of limiting or the state of being limited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "A restriction; a boundary, real or metaphorical, caused by some thing or some circumstance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc8814f3-ced2-47a8-9b07-61160c2500fd",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Getting into his wheelchair after his amputation, it felt like a limitation you could roll in."
                                            },
                                            {
                                                "example_id": "b689a04d-8916-4f97-bbe1-2b276ad9c084",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "He understood the exam material, but his fear was a limitation he could not overcome."
                                            },
                                            {
                                                "example_id": "1bb90989-7fa8-44fd-8aef-79a3809de221",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "The coaches are similar to those of the Hampshire diesel-electric units, which went into service in September, 1957, but have 8ft 6in wide bodies, instead of 9ft, because of loading gauge limitations on the South Eastern Division."
                                            },
                                            {
                                                "example_id": "f9b5a611-49d1-4d63-bf11-28c76a49c8e3",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            },
                                            {
                                                "example_id": "c94125f8-db87-4952-a767-e42b547b62ee",
                                                "sense_id": "465c01a1-9f0b-358f-8bd8-122fa433b0cc",
                                                "text": "Telling a story is like an invitation for others to share their stories with you. That’s what I discovered at TED when I shared my story about a limitation that held me back from my dream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf715ef-cbaf-3869-a062-994adfc14484",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "An imperfection or shortcoming that limits something's use or value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4841f5d2-29e5-4cd5-9adf-3bd485ca4385",
                                                "sense_id": "fdf715ef-cbaf-3869-a062-994adfc14484",
                                                "text": "Both the MI score and the t-score have their limitations. MI computes a logarithm representing the number of co-occurrences of words compared to their occurrences apart in the corpus, which can highlight rare collocations if the components tend not to occur with other words. The t-score formula is less susceptible to this but its numerical result cannot be meaningfully compared across corpora of different sizes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e218c59-0f62-38bd-9789-ca127dc559d9",
                                        "entry_id": "1fac6e9f-f438-3355-8c99-8110dcaaebaa",
                                        "glosses": [
                                            "A time period after which some legal action may no longer be brought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d274cca-b5cd-485b-8430-509e2d87626f",
                                                "sense_id": "0e218c59-0f62-38bd-9789-ca127dc559d9",
                                                "text": "The lawyer obtained impunity by dragging his obviously guilty client's case beyond the ten-year limitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
