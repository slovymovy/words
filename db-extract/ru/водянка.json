                                    {
                                        "sense_id": "582d9770-ca43-3fa0-8437-f0286b77d1f8",
                                        "entry_id": "f1c8f389-2acf-36ec-a6df-82128bc91922",
                                        "glosses": [
                                            "The abnormal accumulation of serous fluid in a tissue or cavity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ece7d0cb-e65e-4603-9ca2-973f87df8728",
                        "source_entry_id": "edbb56ef-34d5-3c74-b33a-12e8af57b37e",
                        "source_sense_id": "5a8b1d15-9d06-3e93-aa22-6c65dcf29dce",
                        "target_lang_word": "edema",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edema",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                        "entry_id": "b0e639ec-4c4d-3619-9cc2-815f101ef271",
                                        "glosses": [
                                            "An excessive accumulation of serum in tissue spaces or a body cavity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31eefff3-873a-44b3-991b-ca73dc992449",
                                                "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                                "text": "dependent edema"
                                            },
                                            {
                                                "example_id": "f03f46fa-ad67-48e5-a6aa-9579b37fcafd",
                                                "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                                "text": "lower extremity edema"
                                            },
                                            {
                                                "example_id": "b8082992-130a-4d1a-a37b-315e2f95c428",
                                                "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                                "text": "In the patients with myocardial edemas [247, 471] it was shown that, despite a considerable loss of fluid via the kidneys after the intravenous administration of a short-acting and very effective diuretic (furosemide), there was no increase in the blood and plasma viscosities."
                                            },
                                            {
                                                "example_id": "63eb9b76-0965-45ff-8de4-ed931f2d031d",
                                                "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                                "text": "In particular, changes in color and temperature, edemas, and ulcerations are noted. Palpation is applied as needed. In this chapter, only two skin and body surface changes will be discussed: peripheral edemas and ulcerations."
                                            },
                                            {
                                                "example_id": "027ceed5-ca88-44ac-88f4-e7f15789f106",
                                                "sense_id": "7a690c08-611a-3a37-962e-833db39c3c56",
                                                "text": "Local lymph edemas can often be found on the inside of a looped graft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22afb1ab-adbe-39d4-9ae6-9e363668e8b2",
                                        "entry_id": "b0e639ec-4c4d-3619-9cc2-815f101ef271",
                                        "glosses": [
                                            "A similar swelling in plants caused by excessive accumulation of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
