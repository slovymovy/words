            {
                "entry_id": "4f9a6be6-45c3-3bf4-b054-914aaaee213c",
                "word": "Sundanese",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "001c3a8c-cfb3-4a32-9c5e-b5d228320a67",
