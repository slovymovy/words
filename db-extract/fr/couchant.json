        "fr-extract.jsonl": [
            {
                "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                "word": "couchant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6ab4e1e3-7bf1-4a87-b726-181dfa7cd0c7",
                        "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "couchants"
                    },
                    {
                        "form_id": "86ac80ac-af31-45fd-bc1d-f086a1f58b02",
                        "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "couchante"
                    },
                    {
                        "form_id": "d7e4074d-7582-4c3d-bf35-64abf65c2368",
                        "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "couchantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b03a67f-e0e9-33a7-91a7-c67d78112f57",
                        "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                        "glosses": [
                            "Qui se couche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c02b9cc-364e-4501-a3bc-3925ff67c52c",
                                "sense_id": "1b03a67f-e0e9-33a7-91a7-c67d78112f57",
                                "text": "Le fleuve qui nous entraînait, coulait entre de hautes falaises, au bout desquelles on apercevait le soleil couchant."
                            },
                            {
                                "example_id": "a969b151-c6ba-4abd-9f82-a00e53b74a11",
                                "sense_id": "1b03a67f-e0e9-33a7-91a7-c67d78112f57",
                                "text": "Peu de spectacles, en Europe, dépassent en grandeur celui qu'on découvre de Honfleur quand le soleil couchant, de ses flammes marines, éclaire jusqu'en ses profondeurs l'estuaire de la Seine."
                            }
                        ]
                    },
                    {
                        "sense_id": "bce686d6-2b29-39d8-87ff-ce5547012904",
                        "entry_id": "0329ec7c-2fa5-3420-9855-cb818f6a0f1c",
                        "glosses": [
                            "Se dit du soleil, figuré ou non, représenté incomplet et posé en pointe, masqué en partie ou mouvant du flanc senestre de l’écu, pièce, meuble ou division."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69dc1a9b-5781-44fc-8365-7cd400897168",
                                "sense_id": "bce686d6-2b29-39d8-87ff-ce5547012904",
                                "text": "De sinople à la tour brochante sur un pan de mur, le tout d'argent maçonné de sable, accompagné de trois feuilles de hêtre d'or versées et posées en barre; au chef voûté du même chargé d'un soleil couchant non figuré de gueules, qui est de Saint-Jean-Soleymieux → voir illustration « soleil couchant »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                "word": "couchant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a2f58c5-20ed-4164-afe6-545951dffa89",
                        "entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                        "tags": [
                            "plural"
                        ],
                        "form": "couchants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4d6a872-cd9f-318e-b826-112b49f54a2d",
                        "entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                        "glosses": [
                            "Endroit de l’horizon où le Soleil semble se coucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7190870b-cf78-410a-85f9-f3c3b4c898e0",
                                "sense_id": "d4d6a872-cd9f-318e-b826-112b49f54a2d",
                                "text": "Vers le couchant, un chien aboyait ; d’autres lui répondirent : […]."
                            },
                            {
                                "example_id": "a2dda82e-3217-4e4b-8000-cddd3b2b147a",
                                "sense_id": "d4d6a872-cd9f-318e-b826-112b49f54a2d",
                                "text": "Dans l’azur à peine noirci du couchant, l’étoile du berger brillait d’un feu paisible, sans un scintillement ; l’air était calme ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3c2bc37-9fa1-3f6e-bf25-90df3fda5bd6",
                        "entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                        "glosses": [
                            "Lumière particulière du Soleil qui se couche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a064c4b-94bf-444d-a7a8-b41fa6181d94",
                                "sense_id": "e3c2bc37-9fa1-3f6e-bf25-90df3fda5bd6",
                                "text": "Qu’y a-t-il au fond des landes tristes à la fin du jour ?\nLe dernier rayon du couchant, droit comme un couteau d’or."
                            },
                            {
                                "example_id": "1c44cefa-3abd-4658-b1a7-8c96ab6f7d28",
                                "sense_id": "e3c2bc37-9fa1-3f6e-bf25-90df3fda5bd6",
                                "text": "[…], et ce qui sauvait du désespoir, c’était seulement la farouche splendeur des aubes et des couchants, des torrents tourbillonnants, de la cavalcade des nuages, et de l’infinie solitude."
                            },
                            {
                                "example_id": "491a31fe-3a89-48b7-8584-c5cee9d818fe",
                                "sense_id": "e3c2bc37-9fa1-3f6e-bf25-90df3fda5bd6",
                                "text": "Les reflets du couchant, le vent de la mer nous viennent aussi ce soir de chez nos ennemis, de l'Est, du Rhin."
                            }
                        ]
                    },
                    {
                        "sense_id": "10de4568-8ec9-3545-aa42-a6a88d54ad4c",
                        "entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                        "glosses": [
                            "Partie occidentale de la Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5773d7-cb07-4091-80f7-982bde497325",
                                "sense_id": "10de4568-8ec9-3545-aa42-a6a88d54ad4c",
                                "text": "S’ils nous cherchèrent ensuite, il est probable que ce fut du côté du couchant, persuadés que nous aurions essayé de nous rendre au Meschacebé ; […]."
                            },
                            {
                                "example_id": "279cac17-0648-47bc-a376-f53b5e94eb05",
                                "sense_id": "10de4568-8ec9-3545-aa42-a6a88d54ad4c",
                                "text": "Cette région est au couchant, vers le couchant. Du levant au couchant. Entre le midi et le couchant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b27dcee7-45f5-4401-9df5-262bc6c2c845",
                        "source_entry_id": "d76dbf24-c365-36e7-a5c0-4509df759b54",
                        "source_sense_id": "d4d6a872-cd9f-318e-b826-112b49f54a2d",
                        "source_sense_description": "Endroit de l’horizon où le Soleil semble se coucher",
                        "target_lang_word": "Abendhimmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abendhimmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                        "entry_id": "b4fc1ebf-bd30-36e8-89eb-1c71d6d74590",
                                        "glosses": [
                                            "Anblick des Himmels während des Sonnenuntergangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39b48e2c-7628-43c1-80a8-0aa403afb8cf",
                                                "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                                "text": "Grandios leuchtet der Abendhimmel über den Hügeln von Los Angeles."
                                            },
                                            {
                                                "example_id": "ba4c8600-1a26-48ec-85ef-cb225c64d55a",
                                                "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                                "text": "Der Asphalt entlädt seine Wärme, schickt sie in den wolkenlosen Abendhimmel."
                                            },
                                            {
                                                "example_id": "e714f077-a671-46ae-bb23-530b32bed2c7",
                                                "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                                "text": "Es waren Bilder, die binnen kürzester Zeit weltweit für Aufsehen sorgten: Ein mächtiger, orangefarbener Schweif zog sich über den Abendhimmel vor der kalifornischen Küste."
                                            },
                                            {
                                                "example_id": "7cc348a6-6539-42e3-bc15-64d0932b6872",
                                                "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                                "text": "„Wir standen nebeneinander und redeten in die Kuppeln und Dächer, in den durchglühten Abendhimmel hinein.“"
                                            },
                                            {
                                                "example_id": "195a7816-aba0-4627-b9dc-d09aab0d0675",
                                                "sense_id": "e21cfed6-628e-3450-8543-a2a41d8a9054",
                                                "text": "„Ihr Gesicht strahlte vor Freude, und das blonde Haar leuchtete förmlich vor dem Hintergrund des bläulich schwarzen Abendhimmels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
