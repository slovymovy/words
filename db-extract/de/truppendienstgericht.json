                ],
                "senses": [
                    {
                        "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                        "entry_id": "83ca2c38-a65a-3c00-9ece-449272660cf4",
                        "glosses": [
                            "Gericht der Bundeswehr, das für Disziplinarverfahren gegen Soldaten und für Verfahren über Beschwerden von Soldaten zuständig ist"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "f570dea6-0a27-4477-83a3-dc0cf8cad705",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„In vollem Umfang kommt diese Regelung nur beim Bundespatentgericht und beim Truppendienstgericht zur Geltung.“"
                            },
                            {
                                "example_id": "d64b2589-f215-4197-80ef-2e81e2a7ee91",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„Hält das Truppendienstgericht eine Arreststrafe nicht für begründet, so entscheidet der Disziplinarvorgesetzte, ob und mit welcher anderen Disziplinarstrafe er den Beschuldigten bestraft.“"
                            },
                            {
                                "example_id": "49fed48e-b605-4494-af37-af93f4b97d07",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„Das Truppendienstgericht Mitte in Koblenz meldete für die Zeit zwischen 1981 und 1991 19 verhandelte Fälle: 14 Disziplinarmaßnahmen, aber auch vier Freisprüche und eine Verfahrenseinstellung.“"
                            },
                            {
                                "example_id": "f7c14f6a-188b-4b11-9856-3b6433550ff3",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„Das Truppendienstgericht hat im Unterschied zu den Beschwerdeinstanzen nur über die Rechtmäßigkeit der angegriffenen.“"
                            },
                            {
                                "example_id": "127ee91f-3834-4789-819d-5b277b5d1e23",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„Lässt das Truppendienstgericht die Rechtsbeschwerde nicht zu, kann nach § 22b WBO Nichtzulassungsbeschwerde zum Bundesverwaltungsgericht erhoben werden.“"
                            },
                            {
                                "example_id": "97f3454b-b62c-42cf-9f6a-79f616c7364d",
                                "sense_id": "1a3bf1e2-c3ef-3b7e-b382-d7f8f2932fc0",
                                "text": "„Bei uns kamen diese Kerle schon bei der kleinsten Verfehlung vor ein Truppendienstgericht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
