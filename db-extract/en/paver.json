                                    {
                                        "sense_id": "3b19354c-c177-3dfc-896e-0dbe2bccb7db",
                                        "entry_id": "9b5d5c09-a6cf-31f7-829f-6ce7fb307594",
                                        "glosses": [
                                            "Mélange de sable et de gravier."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f331b6-6ced-40d1-b96d-854a25f2c4a0",
                                                "sense_id": "3b19354c-c177-3dfc-896e-0dbe2bccb7db",
                                                "text": "Le dosage devant la bétonnière est simple. Il faut doser à 350 kg – sous entendu 350 kg/m3 – soit 1 seau de ciment et 4,5 seaux de paveur. Il n'est pas très pratique d'avoir 4,5 seaux de paveur : le préposé à la bétonnière doit alors étalonner son coup de pelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dceaf045-6809-45db-8611-69e514e9f355",
                        "source_entry_id": "6f0f0c3f-23fa-30c6-bad4-cd07ac3dbe57",
                        "source_sense_description": "one who paves",
                        "target_lang_word": "paveuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paveuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b16a348-e489-33e2-bea8-a3d1ba189b98",
                                        "entry_id": "82d57257-2b91-3249-bca7-21f90a557181",
                                        "glosses": [
                                            "Ouvrière spécialisée dans la pose de pavé."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3d9d6d-c45b-45e7-a983-0d81411bac9d",
                                                "sense_id": "6b16a348-e489-33e2-bea8-a3d1ba189b98",
                                                "text": "Je me considère comme un paveur, et non une paveuse, parce que ce métier est celui des hommes et si moi je me lance dedans, c’est vraiment du lourd, je dirai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fa2f48-1ce1-31ee-8595-2122fe8be6e4",
                                        "entry_id": "82d57257-2b91-3249-bca7-21f90a557181",
                                        "glosses": [
                                            "Épouse d’un paveur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197a6152-e4b8-4b7d-8caf-1d136f9f523d",
                                                "sense_id": "41fa2f48-1ce1-31ee-8595-2122fe8be6e4",
                                                "text": "De même, en parlant de la femme d’un afficheur, d’un couvreur, d’un paveur, d’un tourneur, etc., on dit, l’afficheuse, la couvreuse, la paveuse, la tourneuse, etc., par la même analogie qu’on dit, la charbonnière, la perruquière, la chapelière, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ff461d-377d-38b7-9c38-438dc878e5de",
                                        "entry_id": "82d57257-2b91-3249-bca7-21f90a557181",
                                        "glosses": [
                                            "Engin servant à poser des pavés."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75349448-ad47-4519-ae4e-669d7f857678",
                                                "sense_id": "89ff461d-377d-38b7-9c38-438dc878e5de",
                                                "text": "Le véhicule de transfert de matériel se trouve au milieu du procédé de revêtement, juste derrière le camion et devant la paveuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
