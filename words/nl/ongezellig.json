{
    "word_family": [
        "gezellig",
        "gezelligheid",
        "ongezelligheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "230754ce-8daa-3c0c-81c8-4b92e010e6b4",
                    "sense_definition": "Niet gezellig; sfeerloos, onvriendelijk of onbehaaglijk.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sfeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De alleenstaande man woonde in een heel <w>ongezellig</w> en kaal huis.",
                            "target_lang_translations": {
                                "en": "The single man lived in a very <w>uncozy</w> and bare house."
                            }
                        },
                        {
                            "text": "Zonder kaarsen en muziek is de kamer een beetje <w>ongezellig</w>.",
                            "target_lang_translations": {
                                "en": "Without candles and music, the room is a bit <w>uninviting</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sfeerloos",
                        "kil",
                        "onbehaaglijk"
                    ],
                    "antonyms": [
                        "gezellig"
                    ],
                    "common_phrases": [
                        "een ongezellige kamer",
                        "ongezellig kaal"
                    ],
                    "target_lang_definitions": {
                        "en": "Not cozy, pleasant, or inviting; lacking atmosphere, cold, or uncomfortable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncozy",
                                "target_lang_sense_clarification": "lacking warmth or comfort"
                            },
                            {
                                "target_lang_word": "bleak",
                                "target_lang_sense_clarification": "cold and miserable"
                            },
                            {
                                "target_lang_word": "uninviting",
                                "target_lang_sense_clarification": "not attractive or pleasant"
                            },
                            {
                                "target_lang_word": "soulless",
                                "target_lang_sense_clarification": "lacking atmosphere or character"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "049515da-aed4-3c25-adc1-53790df5a97e",
                    "sense_definition": "Niet sociaal of onvriendelijk in de omgang met anderen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is erg <w>ongezellig</w> dat hij de hele avond op zijn telefoon zit te kijken.",
                            "target_lang_translations": {
                                "en": "It is very <w>unsociable</w> that he is looking at his phone the entire evening."
                            }
                        },
                        {
                            "text": "Zij deed gisteren heel <w>ongezellig</w> tegen haar gasten.",
                            "target_lang_translations": {
                                "en": "She acted very <w>unfriendly</w> towards her guests yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "onsociaal",
                        "onvriendelijk",
                        "stug"
                    ],
                    "antonyms": [
                        "gezellig"
                    ],
                    "common_phrases": [
                        "ongezellig doen"
                    ],
                    "target_lang_definitions": {
                        "en": "Antisocial, unfriendly, or poor company in social interactions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unsociable",
                                "target_lang_sense_clarification": "not wanting to mingle or converse with others"
                            },
                            {
                                "target_lang_word": "unfriendly",
                                "target_lang_sense_clarification": "not kind or pleasant in behavior"
                            },
                            {
                                "target_lang_word": "poor company",
                                "target_lang_sense_clarification": "not fun or engaging to be around"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}