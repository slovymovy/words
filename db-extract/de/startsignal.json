                "senses": [
                    {
                        "sense_id": "33f4b5ff-1990-34fd-87bd-a1fbcd1ee817",
                        "entry_id": "107e44b4-2112-32c0-8dc7-3fe57c52e268",
                        "glosses": [
                            "Zeichen, auf das hin ein Wettkampf, ein Wettrennen beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da1e3a7-74c2-43cd-a194-1a7775063761",
                                "sense_id": "33f4b5ff-1990-34fd-87bd-a1fbcd1ee817",
                                "text": "„Sie kauert in die Startblöcke, hebt den Hintern, der Coach gibt das Startsignal, fast sieht es aus, als falle sie hin, aber dann fängt sie sich auf und beschleunigt ansehnlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c4ce319a-335c-3836-9730-b5a9eaf1d932",
                        "entry_id": "107e44b4-2112-32c0-8dc7-3fe57c52e268",
                        "glosses": [
                            "Auslöser, Zeichen für den Beginn einer Aktion"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a04c8e57-8187-497a-aa29-54daabb92502",
                                "sense_id": "c4ce319a-335c-3836-9730-b5a9eaf1d932",
                                "text": "„Im Bürgerkrieg zwischen dem republikanischen Parlament unter Oliver Cromwell und der Krone errang die strategisch gelegene Stadt Bedeutung, weil hier König Karl I. seine Standarte aufpflanzte, was allgemein als Startsignal für die Kampfhandlungen gewertet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9689ebfb-7c06-4c86-9bb7-e976981cacf5",
                        "source_entry_id": "107e44b4-2112-32c0-8dc7-3fe57c52e268",
                        "source_sense_id": "33f4b5ff-1990-34fd-87bd-a1fbcd1ee817",
                        "source_sense_description": "Sport: Zeichen, auf das hin ein Wettkampf, ein Wettrennen beginnt",
                        "target_lang_word": "starting signal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starting signal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18f69624-7069-39f9-8642-178e936ecab1",
                                        "entry_id": "5e83b4e3-80f1-3118-9000-1dd531c4a1e1",
                                        "glosses": [
                                            "A railway signal controlling the starting of trains from a station or some other location, nowadays usually a colour-light signal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6a7f36-e675-437b-af78-c75eb79420df",
                                                "sense_id": "18f69624-7069-39f9-8642-178e936ecab1",
                                                "text": "As it happened, however, it was clear enough, when the platform starting-signal was lowered, for the signalman in box No. 5 to see his advance-starting signal, and he was therefore justified in allowing the train to go forward, and it was not until it had passed his box that, upon looking out, he saw that it had disappeared into the bank of fog, which had by that time hidden the advanced starting-signal from his view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e93c01c-b759-3547-a3e6-4702b26b0415",
                                        "entry_id": "5e83b4e3-80f1-3118-9000-1dd531c4a1e1",
                                        "glosses": [
                                            "A signal to begin a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11367df0-542c-4911-b0b4-e045f9c74cb2",
                                                "sense_id": "3e93c01c-b759-3547-a3e6-4702b26b0415",
                                                "text": "At the starting signal, pull up and back against the underside of the starting platform to get your body moving forward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
