                "senses": [
                    {
                        "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                        "entry_id": "76eabe49-1f0d-3866-9dc4-2bc29a45f257",
                        "glosses": [
                            "auf feuchtem Boden wachsende, grasähnliche Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c11cc1-16ee-4eca-a3ba-6ca2f96a9bef",
                                "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                                "text": "„Dort fuhr er rückwärts zwischen die hohen Kiefern, mitten ins Riedgras und das dichte Gestrüpp.“"
                            },
                            {
                                "example_id": "bbb9c9f2-8333-45bd-a8ed-86f6da66e0ef",
                                "sense_id": "819c27c8-b659-3767-9ecc-057bc02d44b3",
                                "text": "„Eine heiße Stille hing über der Flusslandschaft. Über den schmutzfleckigen und schiefen Schindelhütten, dem öden schotterbedeckten Industriegelände, den Feldern mit drahtfarbenem Riedgras, der verkraterten Steinwüste und den Eisenbahngleisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
