                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een prachtig <w>sneeuwen</w> kleed tijdens het winterfeest.",
                            "target_lang_translations": {
                                "en": "She wore a beautiful <w>snow-white</w> gown during the winter festival.",
                                "ru": "На зимнем празднике на ней было великолепное <w>белоснежное</w> платье."
                            }
                        },
                        {
                            "text": "Het landschap was bedekt met een <w>sneeuwen</w> deken die alles wit kleurde.",
                            "target_lang_translations": {
