                "senses": [
                    {
                        "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                        "entry_id": "46609ac1-3be8-3b22-955f-ff731d501736",
                        "glosses": [
                            "Kosten, die (unerwartet, in erheblichem oder unerwartetem Maße) auf jemand oder einen Betrieb, eine Institution zukommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6d8de4-1c9a-4fed-b6a6-05b43a8f0678",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "Aufgrund der gestiegenen Energiekosten musste ein erheblicher Kostenanfall bewältigt werden."
                            },
                            {
                                "example_id": "35a8431f-e3f6-4b4b-ade4-35b8c8739642",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "„In welcher Form und in welchen Zeitabständen werden die Kostenstellenverantwortlichen über den Kostenanfall informiert?“"
                            },
                            {
                                "example_id": "213c9852-d021-4ea2-a939-b8c93aad761f",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "„Das Verfahren \"Zahlung bei Lieferung\" müsse zu Gunsten der üblichen Methode \"Zahlung bei Kostenanfall\" ersetzt werden.“"
                            },
                            {
                                "example_id": "631fdbed-6f53-424e-915f-78bd93d6ed50",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "„Da aber nicht \"nach Kostenanfall\" gezahlt wird, sondern \"bei Lieferung\" entstehen zusätzliche Zinskosten von 849 Millionen Euro, die der vorfinanzierenden Industrie zu erstatten sind.“"
                            },
                            {
                                "example_id": "63389da2-e14f-43d7-b174-085e1453e92c",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "„[…] Die Union ist für Zahlung nach Kostenanfall.“"
                            },
                            {
                                "example_id": "4ebe8abd-3c6c-4c13-8a0e-aa5bacd80513",
                                "sense_id": "dfe3be7e-9bc1-35a1-9cc8-79ad2d1616c9",
                                "text": "„Der 1100 Seiten starke Industrievertrag müsse ganz neu verhandelt werden. In dem Text befindet sich noch eine weitere bittere Pille für den Minister: Zahlen soll Scharping dort gemäß Kostenanfall bei der Industrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
