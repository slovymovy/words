                        "refined manners",
                        "refined lady"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий хорошим образованием, вежливыми манерами и высоким социальным вкусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утончённый",
