                        ],
                        "form": "huisraadje"
                    },
                    {
                        "form_id": "92047bd9-6a53-4c58-a454-4d864b737851",
                        "entry_id": "efce8abf-9051-39e6-b930-31aea174b4ba",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "huisraadjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80e537ee-9650-346a-9603-189717cfe4d8",
                        "entry_id": "efce8abf-9051-39e6-b930-31aea174b4ba",
                        "glosses": [
                            "de gebruiksvoorwerpen die horen tot de inrichting van een huis, zoals het meubilair, klein- en groothuishoudelijke apparatuur en de huishoudwaar (keukengerei en tafelwaar)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b034c23-77c1-4f22-89a5-3c10664882d2",
                                "sense_id": "80e537ee-9650-346a-9603-189717cfe4d8",
                                "text": "Toen hij thuiskwam stond zijn huisraad op straat."
                            },
                            {
                                "example_id": "1241a6b1-1c37-48c1-ad31-36891e954d87",
                                "sense_id": "80e537ee-9650-346a-9603-189717cfe4d8",
                                "text": "Mijn complete huisraad had ik in verhuisdozen gepropt. Fonduevorken, een ficus en wat begonia's die ik van Alexander had gekregen. Enkele delen van de Winkler Prins lagen in de laadruimte verspreid tussen wat kleding. Ik had voor de zekerheid mijn oude judopakken ingepakt, hoewel ik na mijn dertiende niet meer gejudood heb. Maar ik wilde het goed doen. ‘Pak alles, en neem het zo snel mogelijk mee’, had mijn moeder gezegd."
                            },
                            {
                                "example_id": "bbfc03d8-2fd1-42d9-a951-5f4ba334748e",
                                "sense_id": "80e537ee-9650-346a-9603-189717cfe4d8",
                                "text": "De gemeente stelde 9 miljoen euro beschikbaar, opende een jongerenloket en regelde gezinscoaches. Maar de wijk krabbelt slechts langzaam op en het aantal klachten over de buitenruimte blijft groot. \"Ziet nou niemand van de gemeente dat het een rotzooi is?\", vraagt een bewoonster zich af bij de regionale omroep Rijnmond. Volgens haar is het elke dag weer raak met huisraad en vuilniszakken naast de containers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd69bc3a-6315-4235-93bd-ddd064cc4a9e",
                        "source_entry_id": "efce8abf-9051-39e6-b930-31aea174b4ba",
                        "source_sense_id": "80e537ee-9650-346a-9603-189717cfe4d8",
                        "source_sense_description": "alle roerende niet eetbare goederen in een huis",
                        "target_lang_word": "Hausrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1732e28-632a-3387-bf91-8b1d043a68ce",
                                        "entry_id": "039928bd-10d7-3e8b-9d28-f948bbc54a4d",
                                        "glosses": [
                                            "alle Dinge, die zu einem Haushalt gehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df4fb0e-322a-4fb3-8596-6847890516d2",
                                                "sense_id": "d1732e28-632a-3387-bf91-8b1d043a68ce",
                                                "text": "„Im Pfälzischen Erbfolgekrieg plündern französische Truppen die Königsgräber im Speyerer Dom und stecken den im Dom vermeintlich sicher eingelagerten Hausrat von Bürgern in Brand.“"
                                            },
                                            {
                                                "example_id": "ec56d031-2732-4869-9516-f4e6775fd1d2",
                                                "sense_id": "d1732e28-632a-3387-bf91-8b1d043a68ce",
                                                "text": "„Der Durchzug der Roten Armee mischt auch den Hausrat so mancher Familie in Groß Döbern.“"
                                            },
                                            {
                                                "example_id": "fc372296-566c-49d7-9c97-24a9ae61f3ba",
                                                "sense_id": "d1732e28-632a-3387-bf91-8b1d043a68ce",
                                                "text": "„Der kleinere Hausrat treibt sich herum, wird aufgefunden und mit einem Ausruf des Unmuts beiseite geschoben.“"
                                            },
                                            {
                                                "example_id": "bdf17448-5665-46f7-95e6-0a2d3178d09f",
                                                "sense_id": "d1732e28-632a-3387-bf91-8b1d043a68ce",
                                                "text": "„Um ihr Überleben zu sichern, musste sie sukzessive ihren Hausrat verkaufen, später sogar bei den verhassten britischen Invasoren Geld leihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf7293bd-2b84-4fcd-a872-90ee94777096",
                        "source_entry_id": "efce8abf-9051-39e6-b930-31aea174b4ba",
