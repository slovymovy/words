                                "target_senses": [
                                    {
                                        "sense_id": "2db1ab82-1a7e-35cb-bd54-3ef58eaf3532",
                                        "entry_id": "792d6a53-347f-3967-b558-45a0c6e04301",
                                        "glosses": [
                                            "Composé chimique de formule brute KCl, utilisé comme additif alimentaire (E508), comme traitement médical contre l’hypokaliémie, et à la base des engrais potassiques. À forte dose, il provoque la mort par arrêt cardiaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc98fd09-c815-42e3-a5ea-1fccb24cb866",
                                                "sense_id": "2db1ab82-1a7e-35cb-bd54-3ef58eaf3532",
                                                "text": "Les injections létales utilisées pour exécuter les condamnés à mort aux États-Unis contiennent du chlorure de potassium."
                                            },
                                            {
                                                "example_id": "e18461f7-bfba-4a59-a994-47829128b50c",
                                                "sense_id": "2db1ab82-1a7e-35cb-bd54-3ef58eaf3532",
                                                "text": "Le chlorure de potassium (KCI), matière première de l’industrie chimique pour la production de chlore et d’hydroxyde de potassium, est avant tout un produit de base de la fertilisation en agriculture, qui repose sur les trois éléments essentiels N, P, K (azote, phosphore, potassium)."
                                            },
                                            {
                                                "example_id": "1be615d7-0eda-4437-a691-4a6bf91cb44d",
                                                "sense_id": "2db1ab82-1a7e-35cb-bd54-3ef58eaf3532",
                                                "text": "Des erreurs médicamenteuses avec les solutions injectables de chlorure de potassium (KCl) en ampoule ont été signalées à l'ANSM, malgré la mise en oeuvre de mesures correctives depuis 2007 (nouvel étiquetage, ajout d'information dans le résumé des caractéristiques du produit et la notice, affiche, etc.)."
                                            },
                                            {
                                                "example_id": "42d800d5-42ea-45d7-9735-7f2cb3dcfbed",
                                                "sense_id": "2db1ab82-1a7e-35cb-bd54-3ef58eaf3532",
                                                "text": "Saboter des freins, trafiquer une direction, Blake n’a pas encore le savoir-faire, pas plus qu’il ne sait se procurer du chlorure de potassium pour provoquer un arrêt cardiaque."
                                            }
                                        ]
                                    }
