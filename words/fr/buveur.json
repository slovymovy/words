                    "frequency": "Middle",
                    "semantic_group_id": "consommation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, ce <w>buveur</w> de café commence sa journée par un espresso très fort."
                        },
                        {
                            "text": "Elle est une grande <w>buveuse</w> de thé vert et en prépare plusieurs tasses par jour."
                        }
                    ],
                    "common_phrases": [
