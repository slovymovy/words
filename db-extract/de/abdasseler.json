                "senses": [
                    {
                        "sense_id": "a8296080-b99d-3505-86ff-8352a061d863",
                        "entry_id": "7ae1008e-15bb-3408-ab59-8c140e0de2a2",
                        "glosses": [
                            "jemand, der Rinder von den Larven der Dasselfliege befreit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ff13cf-e9a4-4364-a058-6d56544d70a3",
                                "sense_id": "a8296080-b99d-3505-86ff-8352a061d863",
                                "text": "Die Abdasseler sollen in jedem Jahre neu unterwiesen werden, wobei die Erfahrungen des Vorjahres zu berücksichtigen sind."
                            },
                            {
                                "example_id": "1f8e5fdb-d609-4d66-9fe5-e8e88e71088a",
                                "sense_id": "a8296080-b99d-3505-86ff-8352a061d863",
                                "text": "Mißerfolge sollen nach Angabe der Abdasseler Kursiver Textin den Orten Bosbüll und Klixbüll festgestellt worden sein, wo trotz der Behandlung noch mehrere lebende Larven 3. Stadiums ausgepreßt werden konnten; …"
                            },
                            {
                                "example_id": "59c13977-2532-4506-bc6a-0aeada6aa3bc",
                                "sense_id": "a8296080-b99d-3505-86ff-8352a061d863",
                                "text": "Da ist etwa der sogenannte Abdasseler, der als Privatmann auf gesetzlicher Grundlage die Dasselfliege (Rinderbremse) gegen „Gebühr“ bekämpft."
                            }
                        ],
                        "sense_index_json": "\"1\""
