{
    "word_family": [
        "refuge"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48496879-2ca4-319a-81e1-34ce3e908b14",
                    "sense_definition": "Se retirer dans un lieu sûr ou auprès de quelqu'un pour se mettre en sûreté et à l'abri d'un danger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le violent orage, les randonneurs ont dû se <w>réfugier</w> dans une petite cabane isolée."
                        },
                        {
                            "text": "Dès que la pluie a commencé à tomber, nous nous sommes <w>réfugiés</w> sous un grand porche."
                        }
                    ],
                    "synonyms": [
                        "s'abriter",
                        "se replier"
                    ],
                    "antonyms": [
                        "s'exposer"
                    ],
                    "common_phrases": [
                        "se réfugier sous un arbre",
                        "se réfugier à l'abri"
                    ]
                },
                {
                    "sense_id": "347cb69c-c418-38e0-b2e6-750b23270f5a",
                    "sense_definition": "Chercher une protection morale ou psychologique dans une attitude ou une activité pour fuir une réalité pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux questions embarrassantes des journalistes, le ministre a préféré se <w>réfugier</w> dans un mutisme complet."
                        },
                        {
                            "text": "Après cette douloureuse épreuve, elle a choisi de se <w>réfugier</w> dans son travail quotidien."
                        }
                    ],
                    "synonyms": [
                        "s'enfermer",
                        "s'évader"
                    ],
                    "antonyms": [
                        "affronter"
                    ],
                    "common_phrases": [
                        "se réfugier dans le silence",
                        "se réfugier dans le travail"
                    ]
                },
                {
                    "sense_id": "65c2b6e3-84bf-3d26-a493-adb32355ef10",
                    "sense_definition": "Donner un abri ou procurer un lieu sûr à quelqu'un.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cette période troublée, le vieil homme décida de <w>réfugier</w> les blessés dans sa propre demeure."
                        },
                        {
                            "text": "Cette famille généreuse n'a pas hésité à <w>réfugier</w> des inconnus poursuivis par les autorités."
                        }
                    ],
                    "synonyms": [
                        "abriter",
                        "héberger"
                    ],
                    "antonyms": [
                        "expulser",
                        "chasser"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "emploi transitif rare et littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}