                "senses": [
                    {
                        "sense_id": "e5f4c09b-2d3d-3e22-9457-3d32da942143",
                        "entry_id": "e8b85bd8-95fe-3222-b008-ac0342c18381",
                        "glosses": [
                            "Donner un caractère afrikaner à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68c2639-1294-4ef1-94d4-6265dc380cb2",
                                "sense_id": "e5f4c09b-2d3d-3e22-9457-3d32da942143",
                                "text": "Les Afrikaners furent certes les leaders politiques, mais ils auraient préféré « afrikaneriser » les anglophones pour pouvoir mieux les intégrer."
                            },
                            {
                                "example_id": "95b2c610-a534-4975-b55d-50c7c89029d3",
                                "sense_id": "e5f4c09b-2d3d-3e22-9457-3d32da942143",
                                "text": "Les Afrikaners étant les seuls bilingues, par nécessité, ils parleront un anglais ’afrikanerisé’, dans chacune des situations dans lesquelles ils sont amenés à parler anglais (armée, administration, vie sociale, mariage, …) et, de ce fait, entraîneront l’apparition de l'ASA."
                            }
                        ]
                    }
