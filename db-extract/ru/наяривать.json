                        ],
                        "form": "ная́ривавши"
                    },
                    {
                        "form_id": "2bdf1627-dd0d-40bc-bf33-514fd136855e",
                        "entry_id": "29c9dbb6-28ba-3f65-a7a3-c551736dc24a",
