                "senses": [
                    {
                        "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                        "entry_id": "561edf4a-5324-3d18-9bca-4c0fc0d2a58a",
                        "glosses": [
                            "für einen vorübergehenden Zeitraum ausgestellte Lizenz für Fahranfänger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745a53e8-9a71-40f8-9d77-473bf71acaa1",
                                "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                                "text": "„Die Recherchen ergaben, dass es sich um einen Lernführerschein handelt, der in Deutschland keine Gültigkeit besitzt.“"
                            },
                            {
                                "example_id": "d5e0d657-a880-4896-bb24-d2b54437cb01",
                                "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                                "text": "„Ein 29-jähriger Pole mit Wohnsitz in Belgien ist am Freitag, 14.45 Uhr, auf der Autobahn 1 bei Wildeshausen mit einem britischen Lernführerschein angetroffen worden.“"
                            },
                            {
                                "example_id": "be9a06f6-c7a8-4de0-8492-3d2b8618ebd9",
                                "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                                "text": "„Zudem konnte er den Beamten der Bundespolizei lediglich seinen belgischen Lernführerschein vorzeigen, der ihn in Belgien allerdings als Fahrschüler ausweist.“"
                            },
                            {
                                "example_id": "59607f26-3a69-4c9d-a898-0df0ab6bef46",
                                "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                                "text": "„In einigen Staaten kann man bereits mit 14 Jahren einen Lernführerschein beantragen, eine vollwertige Fahrerlaubnis zum Teil schon mit 16 Jahren.“"
                            },
                            {
                                "example_id": "1b722210-a73e-40d8-aeb8-dbc01d76c74c",
                                "sense_id": "0fa08271-ce65-38b6-b6bf-92c7bd4637fb",
                                "text": "„Eine Überlandfahrt mit dem britischen Lernführerschein unternahm ein 22-jähriger Slowake.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
