                ],
                "senses": [
                    {
                        "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                        "entry_id": "c64a5d76-4f0d-396d-a924-261693861930",
                        "glosses": [
                            "Handlung, Vorgang, bei etwas die Qualität oder Quantität erhöhen, also etwas zu verbessern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21889604-1cf3-4017-b1f7-31cdd5ecec06",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Dass es bei den Diebestouren eher um ein Stück Glamour als um die Aufbesserung des Taschengeldes ging, lassen schon die bequemen Lebensumstände ihrer sieben Mitglieder ahnen.“"
                            },
                            {
                                "example_id": "f06dca04-3936-493e-8121-30c68a2d6c74",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Doch aus der Aufbesserung der Reisekasse ist dann nichts geworden.“"
                            },
                            {
                                "example_id": "390149ad-4002-406f-a1f7-64fd49f88199",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Groß ist das nicht, aber eine schöne Aufbesserung des Gartens.“"
                            },
                            {
                                "example_id": "36c56680-d99f-4af7-a863-16d87a7ba8d9",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Weitere technische Aufbesserungen des Videomaterials seien allerdings nicht möglich, fügte Kripochef Schwald hinzu.“"
                            },
                            {
                                "example_id": "e545768c-9a8d-460a-9a70-e80b1ffc96ea",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Läßt man die Witwen, Waisen und versorgungsberechtigten Eltern außer acht, für die Aufbesserungen nur zwischen 30 und 60 Mark monatlich vorgesehen sind, so werden selbst von den 700 000 Schwerbeschädigten nur die 165 000 Empfänger von Ausgleichsrenten betroffen.“"
                            },
                            {
                                "example_id": "ea21d283-a761-4956-9fe6-3a3fcf9d580a",
                                "sense_id": "378f7cc0-3c24-350c-ad31-f439f38980e8",
                                "text": "„Wird das Paket nicht noch einmal aufgeschnürt, bleibt es indes bei nur dürftigen Aufbesserungen der privaten Haushaltskassen im Lande.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
