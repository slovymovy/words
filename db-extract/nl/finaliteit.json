                                    {
                                        "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                                        "entry_id": "c653b194-be3c-3e1e-8126-348496b31bdd",
                                        "glosses": [
                                            "The state of being final; the condition from which no further changes occur."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68422715-1b8f-41cd-83b2-ddaf4ee52260",
                                                "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                                                "text": "The finality of my father's death suddenly hit me: there would be no more bedtime stories, no more games of catch in the back yard."
                                            },
                                            {
                                                "example_id": "45a5b57c-c253-49f9-a183-ba342a40a31d",
                                                "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                                                "text": "By way of contrast there is an air of finality about the closure of the Welsh Highland Railway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b9caad8-bd0a-406b-9424-bbd33ddde6bf",
                        "source_entry_id": "9624d872-38e5-3b4b-aa03-2baffedfcd44",
