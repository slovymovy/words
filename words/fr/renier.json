                        "renier sa famille"
                    ]
                },
                {
                    "sense_id": "92fb86e0-6328-3f36-8714-01583bca311d",
                    "sense_definition": "Abandonner publiquement ou rejeter une foi, une religion ou une doctrine à laquelle on adhérait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prisonnier a refusé de <w>renier</w> sa foi malgré les menaces des soldats."
                        },
                        {
                            "text": "Plusieurs convertis ont préféré fuir le pays plutôt que de <w>renier</w> leur religion."
                        }
                    ],
