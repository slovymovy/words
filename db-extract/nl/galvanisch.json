                                "target_senses": [
                                    {
                                        "sense_id": "2695ac5b-e6e4-3ebd-bf50-d4e9c3bce2c7",
                                        "entry_id": "3c42d7b5-a731-3c6e-adcf-ed22c5db80c3",
                                        "glosses": [
                                            "Of or pertaining to galvanism; electric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ea3b9d-e0d1-4414-830f-cc5be8005598",
                                                "sense_id": "2695ac5b-e6e4-3ebd-bf50-d4e9c3bce2c7",
                                                "text": "[S]he was quivering like a galvanic battery with the suppressed force of some powerful emotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c530d7cf-85be-3a8a-89c1-22dce7becff3",
                                        "entry_id": "3c42d7b5-a731-3c6e-adcf-ed22c5db80c3",
                                        "glosses": [
                                            "Energetic; vigorous."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc8c40b-f17c-4ce7-8fd9-bdfc85ddfda4",
                                                "sense_id": "c530d7cf-85be-3a8a-89c1-22dce7becff3",
                                                "text": "Whether the town existed during Mr. Tapley's time I have not been able to learn. . . . At that moment a galvanic motion had been pumped into it by the war movements of General Halleck."
                                            },
                                            {
                                                "example_id": "a05a8946-48bd-4bfb-a61b-167e0f96e6d6",
                                                "sense_id": "c530d7cf-85be-3a8a-89c1-22dce7becff3",
                                                "text": "Then he clenched his fists, and, with an agility astonishing in a man of his years, indulged in a series of galvanic little hops in front of the astounded Peter Truefitt."
                                            },
                                            {
                                                "example_id": "054bc6ae-e06b-44db-ad33-c33c4628101a",
                                                "sense_id": "c530d7cf-85be-3a8a-89c1-22dce7becff3",
                                                "text": "But the main event may well end up being the performance of Brahms’s galvanic Piano Concerto No. 1, with the exhilarating British pianist Paul Lewis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcb5b31-4f94-36df-a203-563ff920555d",
                                        "entry_id": "3c42d7b5-a731-3c6e-adcf-ed22c5db80c3",
                                        "glosses": [
                                            "Of a current that is not alternating, as opposed to faradic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ccdb62b-8b3f-4ac8-8006-403350fbb32a",
                                                "sense_id": "afcb5b31-4f94-36df-a203-563ff920555d",
                                                "text": "Physicians used galvanic currents, which required only a galvanic power source, and faradic treatments, which utilized an \"alternating\" induction coil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52360fa-974c-4ff7-949a-33b7cc892761",
                        "source_entry_id": "1ee967ea-bd2e-33ee-b045-bd77172e6892",
                        "source_sense_id": "274c2e37-195b-37b0-8963-c4980bf20a2e",
