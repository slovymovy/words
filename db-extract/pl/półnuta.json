                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcc74149-1376-3e1f-99f6-7fea93a70394",
                                        "entry_id": "2d1e9e77-1f24-3d70-ae8a-61a6e28af9f3",
                                        "glosses": [
                                            "Anything very minute; applied to animalcula and the like."
                                        ],
                                        "tags": [],
