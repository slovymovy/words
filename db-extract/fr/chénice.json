                "senses": [
                    {
                        "sense_id": "a6f32781-32f3-3d2b-a574-42e318238714",
                        "entry_id": "8e7ff168-7127-3e55-adda-19eb846def75",
                        "glosses": [
                            "Mesure grecque de deux setiers pour les solides."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "3304cce8-1fb6-415e-9dd1-910e6daa56b9",
                                "sense_id": "a6f32781-32f3-3d2b-a574-42e318238714",
                                "text": "CHÉNICE, Chœnice, Choinix, Chœnica, Chœnix, Chœnicium. Mesure de capacité pour grains, usitée chez les anciens Grecs. La chénice, 48ᵉ partie du médimne, se divisait en 4 cotyles et contenait 240 grandes drachmes d’eau = 1.08 litre = 1.902 pinte anglaise."
                            },
                            {
                                "example_id": "4434e07f-9fc0-4c25-9366-3bb1fe5bb197",
                                "sense_id": "a6f32781-32f3-3d2b-a574-42e318238714",
                                "text": "Le chénice est une mesure de capacité qui valait 1 litre 08, et dont on se servait pour les corps solides."
                            },
                            {
                                "example_id": "aceda267-5116-4961-8039-dd1bd842d73b",
                                "sense_id": "a6f32781-32f3-3d2b-a574-42e318238714",
                                "text": "Choenici ne insideas"
                            }
                        ]
                    }
