{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2913d6c4-6570-31c6-8e04-bb26f09ec022",
                    "sense_definition": "Senseless or foolish talk or writing; nonsense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed the entire report as absolute <w>balderdash</w>.",
                            "target_lang_translations": {
                                "ru": "Он отверг весь отчет, назвав его полной <w>чепухой</w>."
                            }
                        },
                        {
                            "text": "Do not listen to that <w>balderdash</w> because it is clearly not true.",
                            "target_lang_translations": {
                                "ru": "Не слушай этот <w>вздор</w>, потому что это явно неправда."
                            }
                        }
                    ],
                    "synonyms": [
                        "bunk",
                        "drivel",
                        "folderol",
                        "piffle",
                        "poppycock",
                        "rubbish",
                        "twaddle",
                        "nonsense"
                    ],
                    "common_phrases": [
                        "absolute balderdash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессмысленная или глупая речь или текст; чепуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чепуха́",
                                "target_lang_sense_clarification": "разговорное обозначение чего-то бессмысленного или глупого"
                            },
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "несерьезные слова, не заслуживающие внимания"
                            },
                            {
                                "target_lang_word": "белиберда́",
                                "target_lang_sense_clarification": "пренебрежительное обозначение несуразной или глупой информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fd5aa70-dc3a-303b-8c57-903688a04076",
                    "sense_definition": "Obscene or offensive language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker was removed from the stage for shouting <w>balderdash</w> at the audience.",
                            "target_lang_translations": {
                                "ru": "Выступающего удалили со сцены за то, что он выкрикивал <w>сквернословие</w> в адрес аудитории."
                            }
                        },
                        {
                            "text": "She refused to tolerate such <w>balderdash</w> in her presence.",
                            "target_lang_translations": {
                                "ru": "Она отказалась терпеть подобную <w>грязь</w> в своем присутствии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непристойная или оскорбительная речь (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверносло́вие",
                                "target_lang_sense_clarification": "использование непристойных или бранных выражений"
                            },
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "переносное значение для обозначения пошлых или оскорбительных слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab797e2b-0183-3e73-8b04-4fd23ca39070",
                    "sense_definition": "A worthless or poorly made mixture of liquids.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender served a strange <w>balderdash</w> that no one wanted to drink.",
                            "target_lang_translations": {
                                "ru": "Бармен подал странную <w>бурду</w>, которую никто не хотел пить."
                            }
                        },
                        {
                            "text": "The cheap wine was nothing more than a <w>balderdash</w> of leftover spirits.",
                            "target_lang_translations": {
                                "ru": "Дешевое вино было не чем иным, как <w>пойлом</w> из остатков спиртного."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is historically specific to early modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезная или плохо приготовленная смесь жидкостей (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурда́",
                                "target_lang_sense_clarification": "плохо приготовленный, невкусный напиток или смесь жидкостей"
                            },
                            {
                                "target_lang_word": "пойло",
                                "target_lang_sense_clarification": "пренебрежительное название некачественного напитка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3411bdfd-7f22-3023-ba0d-6174f27ca205",
                    "sense_definition": "To mix or adulterate substances, especially liquids.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dishonest merchants would often <w>balderdash</w> their wine with cheaper ingredients.",
                            "target_lang_translations": {
                                "ru": "Нечестные торговцы часто <w>разбавляли</w> свое вино более дешевыми ингредиентами."
                            }
                        },
                        {
                            "text": "It is illegal to <w>balderdash</w> food products for profit.",
                            "target_lang_translations": {
                                "ru": "Незаконно <w>фальсифицировать</w> продукты питания ради наживы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешивать или фальсифицировать вещества, особенно жидкости (устаревший глагол)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбавля́ть",
                                "target_lang_sense_clarification": "смешивать жидкость с чем-то менее качественным"
                            },
                            {
                                "target_lang_word": "фальсифици́ровать",
                                "target_lang_sense_clarification": "подделывать состав продукта путем добавления дешевых ингредиентов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}