                                        "entry_id": "4727d126-d9fa-3f97-89dc-d2f099f1afa5",
                                        "glosses": [
                                            "To make (someone or something) rich or richer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0487f8d-3f1e-4408-9514-1ed04fec35d6",
                                                "sense_id": "6a8ca129-c974-3008-bf40-c877a557df38",
                                                "text": "Hobbies enrich lives."
                                            },
                                            {
                                                "example_id": "ac2ad6d0-2b5e-4e93-82f3-7f887f336289",
                                                "sense_id": "6a8ca129-c974-3008-bf40-c877a557df38",
                                                "text": "The choke in a car engine enriches the fuel mixture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bdf823-94b3-3e0a-a854-eb339fad31bc",
                                        "entry_id": "4727d126-d9fa-3f97-89dc-d2f099f1afa5",
                                        "glosses": [
                                            "To adorn, ornate more richly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbe27d9a-cf6a-3469-b010-63c9221da5c0",
                                        "entry_id": "4727d126-d9fa-3f97-89dc-d2f099f1afa5",
                                        "glosses": [
                                            "To add nutrients or fertilizer to the soil; to fertilize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4260a6f6-9480-4d0e-9b26-e4d7d2de2dfb",
                                                "sense_id": "fbe27d9a-cf6a-3469-b010-63c9221da5c0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6bd2ff-b1f8-328f-89de-ee477f7c1a2b",
                                        "entry_id": "4727d126-d9fa-3f97-89dc-d2f099f1afa5",
                                        "glosses": [
                                            "To increase the amount of one isotope in a mixture of isotopes, especially in a nuclear fuel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3252c7-4eca-4587-9ba0-d56e65349047",
                                                "sense_id": "8e6bd2ff-b1f8-328f-89de-ee477f7c1a2b",
                                                "text": "The head of the UN’s nuclear watchdog says US strikes on Iran fell short of causing total damage to its nuclear program and that Tehran could restart enriching uranium “in a matter of months,” contradicting President Donald Trump’s claims the US set Tehran’s ambitions back by decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63b169f-5d46-30da-a9d5-edf6a8ad023e",
                                        "entry_id": "4727d126-d9fa-3f97-89dc-d2f099f1afa5",
                                        "glosses": [
                                            "To add nutrients to foodstuffs; to fortify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "400f97ae-53f8-35c9-aa7a-74a65eab9018",
