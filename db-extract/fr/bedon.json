                "entry_id": "e1cf96f2-6075-3b9c-bc97-8c39f6430cff",
                "word": "bedon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0f60f863-3c96-4861-b9f3-85506ed04b13",
                        "entry_id": "e1cf96f2-6075-3b9c-bc97-8c39f6430cff",
                        "tags": [
                            "plural"
                        ],
                        "form": "bedons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d942a0d2-775e-38e5-bd15-fdb97ba5bd64",
                        "entry_id": "e1cf96f2-6075-3b9c-bc97-8c39f6430cff",
                        "glosses": [
                            "Tambour à caisse hémisphérique semblable au nacaire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "91af1dbb-bfd0-409f-81ac-bc83690a081c",
                                "sense_id": "d942a0d2-775e-38e5-bd15-fdb97ba5bd64",
                                "text": "Le bedon de Suisse est semblable à une grosse caisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "505bba32-5c5f-3a6d-b57d-3bea0103cc23",
                        "entry_id": "e1cf96f2-6075-3b9c-bc97-8c39f6430cff",
                        "glosses": [
                            "Bedaine, ventre replet."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "608bf3a2-7f95-4ad7-9f40-1ec7f0c68fbc",
                                "sense_id": "505bba32-5c5f-3a6d-b57d-3bea0103cc23",
                                "text": "L’autre dimanche, devant le miroir, en laissant tomber mes derniers voiles, je me suis surpris, avec une pointe d’orgueil, une pointe de bedon."
                            },
                            {
                                "example_id": "d0c378be-7ced-4f51-90f7-11dfe653a6db",
                                "sense_id": "505bba32-5c5f-3a6d-b57d-3bea0103cc23",
                                "text": "Ma pointe voltige : une mouche !\nDécidément… c’est au bedon,\nQu’à la fin de l’envoi, je touche."
                            },
                            {
                                "example_id": "49ca8311-02dd-4a2a-affe-0e7de0f5c52b",
                                "sense_id": "505bba32-5c5f-3a6d-b57d-3bea0103cc23",
                                "text": "Effaçant le bedon, il se faufila entre la Prolétaire et la Sainte-Vierge-du-Mont-Carmel – deux barques, bien sûr – et poursuivit son chemin en zigzags parmi les avirons, les piles de voiles, les rouleaux de cordages, les nasses en fil de fer, les têtes de poissons pourries, les tas de coquilles vides, lambis, burgaux, palourdes, huîtres sauvages."
                            }
                        ]
                    },
                    {
                        "sense_id": "1956e3bd-9444-343d-b1a6-2df3923a0026",
                        "entry_id": "e1cf96f2-6075-3b9c-bc97-8c39f6430cff",
                        "glosses": [
                            "Homme gros et gras."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ff79e2c0-3fdf-4b31-8374-e4a88f9b978e",
                                "sense_id": "1956e3bd-9444-343d-b1a6-2df3923a0026",
                                "text": "Un gros bedon."
                            }
                        ]
                    }
