                    {
                        "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                        "entry_id": "c594124a-ae8a-343e-bd36-84172203061c",
                        "glosses": [
                            "handelingen die ervoor zorgen dat de stoffelijke overschotten van een levend wezen niet vergaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c512c2b-a61e-4f25-b9bb-d8d6741802da",
                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                "text": "Thanatopracteur Jannette Wendels ontving gisteren haar diploma voor de opleiding 'lichte balseming'."
                            },
                            {
                                "example_id": "6c63ecbb-2701-46dc-9f93-ea49a9192744",
                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                "text": "In het zuidwesten van Saoedi-Arabië zijn sporen ontdekt van een 9000 jaar oude beschaving. Deze wordt al-Maqar genoemd, en kenmerkte zich onder meer door de domesticatie van paarden en balseming van doden, 'op een totaal verschillende manier' dan de procedés die tot dan bekend waren."
                            },
                            {
                                "example_id": "504c1fef-5e62-47c3-94af-b6105a862836",
                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                "text": "Het schilderij met daarop de balseming van Christus is rond 1410-1420 vermoedelijk in Brugge gemaakt door een onbekende kunstenaar."
                            }
                        ]
                    }
                ],
