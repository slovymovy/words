                {
                    "sense_id": "a9257451-7dd1-3548-b82b-fdd5e58cdd76",
                    "sense_definition": "A state of organization or a set of rules that helps control behavior and creates order.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children often behave better when they have a clear <w>structure</w> in their daily lives.",
                            "target_lang_translations": {
                                "ru": "Дети часто ведут себя лучше, когда в их повседневной жизни есть чёткий <w>распорядок</w>.",
                                "tr": "Çocuklar, günlük yaşamlarında net bir <w>düzen</w> olduğunda genellikle daha iyi davranırlar.",
                                "pl": "Dzieci często zachowują się lepiej, gdy mają jasny <w>porządek</w> w codziennym życiu.",
                                "zh": "当孩子们在日常生活中拥有明确的<w>条理</w>时，他们的表现往往更好。"
                            }
                        },
                        {
                            "text": "The new manager brought much-needed <w>structure</w> to the chaotic department.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер привнёс столь необходимую <w>организованность</w> в хаотичный отдел.",
                                "tr": "Yeni müdür, kaotik departmana çok ihtiyaç duyulan bir <w>düzen</w> getirdi.",
                                "pl": "Nowy menedżer przyniósł tak potrzebne <w>zorganizowanie</w> w chaoticznym dziale.",
                                "zh": "新经理为混乱的部门带来了急需的<w>秩序</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement",
                        "form"
                    ],
                    "antonyms": [
                        "chaos",
                        "disorder"
                    ],
                    "common_phrases": [
                        "provide structure",
                        "lack of structure",
                        "need structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние организованности или набор правил, которые помогают контролировать поведение и создают порядок.",
                        "tr": "Davranışları kontrol etmeye yardımcı olan ve düzen oluşturan örgütlenme durumu ya da kurallar bütünü.",
                        "pl": "Stan zorganizowania lub zbiór zasad pomagających kontrolować zachowanie i tworzących porządek.",
                        "zh": "一种组织状态或一套有助于控制行为并建立秩序的规则。"
                    },
