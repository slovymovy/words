                    {
                        "sense_id": "eaf0be63-9013-3d67-8cfb-adb02838043b",
                        "entry_id": "921f4c0a-07a2-3db5-ac2e-10a89f3b5d49",
                        "glosses": [
                            "Fachgebiet der Medizin/Biologie, das sich mit der Frage beschäftigt, wie Infektionskrankheiten einzudämmen sind, Krankheiten, die durch einen Erreger – zum Beispiel Bakterien, Pilze, Parasiten oder auch Viren, Transposons und Prionen – übertragen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cbfd8f1-4c50-466a-bc03-dd25d6a05065",
                                "sense_id": "eaf0be63-9013-3d67-8cfb-adb02838043b",
                                "text": "„Das Helmholtz-Zentrum für Infektionsforschung (HZI) in Braunschweig wird 50 Jahre alt. Mit der Vortragsreihe „Infektionsforschung im Wandel der Zeit“ zum Jubiläum lädt das HZI interessierte Besucher zu einem Blick hinter die Kulissen ein – von den Anfängen der Infektionsforschung am Zentrum bis hin zu den modernen Ansätzen von heute.“"
                            },
                            {
                                "example_id": "bd4fdebb-d853-4b3f-97e5-a7449c118578",
                                "sense_id": "eaf0be63-9013-3d67-8cfb-adb02838043b",
                                "text": "„Zelluläre In-vitro-Modelle sind in der Infektionsforschung von Nutzen, um molekulare Vorgänge bei Wirt-Pathogen-Interaktionen zu analysieren.“"
                            }
                        ],
