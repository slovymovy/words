                {
                    "sense_id": "3111d429-846e-3f10-96c4-db0d7e361bf7",
                    "sense_definition": "Unité militaire spéciale entraînée pour exécuter des missions rapides, discrètes et périlleuses sur des objectifs précis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a envoyé un <w>commando</w> pour libérer les otages retenus dans la forêt."
                        },
                        {
                            "text": "Ce <w>commando</w> d'élite s'entraîne chaque jour dans des conditions climatiques extrêmes."
                        }
                    ],
                    "common_phrases": [
                        "commando marine",
                        "commando parachutiste"
                    ]
                },
                {
                    "sense_id": "e34ccbf5-df97-33cc-a821-fc0651a19ccf",
                    "sense_definition": "Soldat membre d'une troupe d'élite ou des forces spéciales.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>commandos</w> ont progressé en silence pour ne pas alerter les sentinelles ennemies."
                        },
                        {
                            "text": "Ce jeune militaire rêve de devenir un <w>commando</w> au sein de la marine nationale."
