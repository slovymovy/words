                        "glosses": [
                            "Se perfectionner par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b7f439-4d67-422c-a6a5-ccb1753b1191",
                                "sense_id": "3f47df9f-6b33-3172-bc4a-651d0048c6f5",
                                "text": "Zohar II, 215b évoque quatre formes de Tikkunim : le premier tikkun, nous dit le Zohar, est celui de soi-même : c’est le devoir qui incombe à chacun de s’autoperfectionner ; le second tikkun consiste dans la restauration de l’harmonie de l'univers, le troisième porte sur le monde supérieur et enfin le quatrième est le tikkun du Nom divin."
                            },
                            {
                                "example_id": "ead91f9e-3e82-4c18-b040-838ad7f9bed5",
                                "sense_id": "3f47df9f-6b33-3172-bc4a-651d0048c6f5",
                                "text": "Se remettre en cause et s’autoperfectionner sont des actions indispensables en liaison avec la complexité croissante du monde et l’accélération et la multiplication des changements qui caractérisent notre société."
                            }
                        ]
                    }
