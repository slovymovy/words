                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bf1cd55-7845-44bc-8c5c-0d58f6dbe90a",
                                "sense_id": "3f98b928-a075-3f60-85a1-c3cb8df1598b",
                                "text": "„Marianne servierte einen mit Backpflaumen gefüllten Schweinerücken mit einer kräftigen, dunklen Sauce, die auch nicht im Entferntesten vergleichbar war mit irgendetwas, was je an Sauce über meine Lippen gekommen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
