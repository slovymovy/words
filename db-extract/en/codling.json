                    {
                        "sense_id": "d32cfa76-9ca0-3e34-9001-384d01aad99c",
                        "entry_id": "f1946b5d-e5f1-3fc3-8ee1-e8a0be325f69",
                        "glosses": [
                            "A small, immature apple"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3082dbe5-a8ca-4653-889a-5f314992dc2a",
                                "sense_id": "d32cfa76-9ca0-3e34-9001-384d01aad99c",
                                "text": "Malvolio: Not yet old enough for a man, nor yong enough\nfor a boy: as a squash is before tis a pescod, or a Codling\nwhen tis almost an Apple: Tis with him in standing water,\nbetweene boy and man. He is verie well-fauour'd,\nand he speakes verie shrewishly: One would thinke his\nmothers milke were scarse out of him"
                            },
                            {
                                "example_id": "6443d5a9-bbd3-4795-b915-b9976d92009d",
                                "sense_id": "d32cfa76-9ca0-3e34-9001-384d01aad99c",
                                "text": "To make Codling Cream.\nTake twenty fair codlings, core them, beat them in a mortar with a pint of cream, strain it into a dish, put into it some crumbs of brown bread, with a little-sack, and dish it up."
                            }
                        ]
                    },
