                            },
                            {
                                "target_lang_word": "podoba",
                                "target_lang_sense_clarification": "způsob, jakým se věc jeví nebo vyvíjí"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "характер",
