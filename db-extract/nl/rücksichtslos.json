                "senses": [
                    {
                        "sense_id": "f0f9680b-9389-3e8c-a827-18abf6a21b79",
                        "entry_id": "05c1aef2-514f-3ac9-b497-8ec8151348d6",
                        "glosses": [
                            "meedogenloos (zonder rekening te houden met)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31c713e-008d-4f48-9200-0314483e7c15",
                                "sense_id": "f0f9680b-9389-3e8c-a827-18abf6a21b79",
                                "text": "Het KNGMG hoopt dat er nog gesprekken volgen met de vele instituten en bedrijven in binnen- en buitenland die gebruikmaken van de kennis en faciliteiten van de VU. \"We begrijpen dat de kosten hoog zijn voor de VU, en dat er financiële problemen zijn, maar dit is rücksichtslos. Dit moet je niet zelfstandig als instituut doen. Verschillende organisaties willen het gesprek aangaan. Verken nu eerst goed samen wat de mogelijkheden zijn voordat je iets afbreekt dat je niet snel weer opbouwt.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b481dd8b-ca40-476f-b774-7cb75c13583c",
                        "source_entry_id": "05c1aef2-514f-3ac9-b497-8ec8151348d6",
                        "source_sense_id": "f0f9680b-9389-3e8c-a827-18abf6a21b79",
                        "target_lang_word": "rücksichtslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rücksichtslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                        "entry_id": "4aaf714c-b16b-38af-8b34-35394455da46",
                                        "glosses": [
                                            "andere nicht schonend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61639fd2-74ac-4956-a215-706649aa2087",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Er habe mehrfach beobachtet, dass durch die rücksichtslose Raserei Fußgänger gefährdet worden seien.“"
                                            },
                                            {
                                                "example_id": "65b17c8e-74f9-4978-ab91-13f45a11c8f5",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                                            },
                                            {
                                                "example_id": "9f25ab8e-314f-4e7c-a748-d96b85d5fb95",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Das ist rücksichtsloses Verhalten, für das mir jedes Verständnis fehlt und das wir nicht hinnehmen.“"
                                            },
                                            {
                                                "example_id": "eefd427b-38bd-4310-8d7e-d6fadc4e79e1",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Nordkorea hatte zuvor die Rede Trumps in Seoul und seine Warnungen als ‚rücksichtslose Äußerungen eines verkalkten Alten‘ bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
