                        "entry_id": "d5bdc74e-7f7b-385b-a517-96362388fc98",
                        "glosses": [
                            "A removable protective shield separating the inner workings of a machine from operator and observer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c649fdc-3614-42cc-889c-3d1ceedd433b",
                                "sense_id": "ee5b982d-2399-3387-a135-0a383380e19d",
                                "text": "The keyboard's faceplate, that is, the cover holding the plastic key against the rubber keyboard, is usually molded ABS (acrylonitrile butadiene styrene) plastic."
                            }
                        ]
                    },
                    {
                        "sense_id": "b76639a2-47a1-3948-9215-58eff6df1198",
                        "entry_id": "d5bdc74e-7f7b-385b-a517-96362388fc98",
                        "glosses": [
                            "A rigid flat surface that has an active role in the interaction of a device with an operator or user."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c03c8c38-7902-3822-8a01-db6c365d80ea",
                        "entry_id": "d5bdc74e-7f7b-385b-a517-96362388fc98",
                        "glosses": [
                            "A transparent window forming part of a helmet directly in front of the wearer's face, allowing them to see out."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e525b92f-1018-46df-a460-c983a76b7678",
