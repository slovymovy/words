                                                "sense_id": "8f774f03-0e0a-32fa-92c0-32528348f83d",
                                                "text": "Een zebra is een ontembaar bang dier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca8cebdd-046e-3ee6-a754-8df8691fa42f",
                                        "entry_id": "30cf3de5-7149-3525-86fa-2cc1e2ff87c9",
                                        "glosses": [
