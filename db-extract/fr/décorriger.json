                "senses": [
                    {
                        "sense_id": "e4bd5840-ad9b-3326-8d45-f03a5209e77c",
                        "entry_id": "b0101569-5777-32de-bdb2-100ea5e8b697",
                        "glosses": [
                            "Faire revenir à l’état qui précédait une correction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d6274f-5ec0-4b32-b1b1-194db6f4cb07",
                                "sense_id": "e4bd5840-ad9b-3326-8d45-f03a5209e77c",
                                "text": "Actuellement se fait jour une réflexion plus approfondie, doublée d’une volonté de \"décorriger\" les endiguements réalisés par le passé ."
                            },
                            {
                                "example_id": "79fb98fe-1bb4-40eb-8d0c-bcd9d27620b3",
                                "sense_id": "e4bd5840-ad9b-3326-8d45-f03a5209e77c",
                                "text": "\"Décorriger\" les cours d'eau : une option difficile mais incontournable."
                            },
                            {
                                "example_id": "51571ccf-a220-4a71-b18f-332416651052",
                                "sense_id": "e4bd5840-ad9b-3326-8d45-f03a5209e77c",
                                "text": "C’est l’exemple parfait de ce qu’il convient de « décorriger ». Vous voyez à droite la même rivière."
                            },
                            {
                                "example_id": "a9e222c2-d873-4e3a-a428-74488a20036c",
                                "sense_id": "e4bd5840-ad9b-3326-8d45-f03a5209e77c",
                                "text": "Faut-il ajouter que le Misanthrope corrigé l’apprend et qu’il se « décorrige » ?"
                            }
                        ]
                    }
                ],
