                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ea161c0-ea78-4076-9d17-fabc6904ae90",
                        "source_entry_id": "1348e452-7785-3487-b05e-2856746079d9",
                        "target_lang_word": "obliger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obliger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ea405d-b2ac-3e75-b502-09c7de156096",
                                        "entry_id": "4684049e-cc4c-31ac-888b-15793da684ee",
                                        "glosses": [
                                            "Mettre quelqu’un dans l’obligation de faire ou de dire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9217965d-0487-4db6-a3ee-2cb65cad97f9",
                                                "sense_id": "e9ea405d-b2ac-3e75-b502-09c7de156096",
                                                "text": "Les défenseurs, après avoir perdu les faubourgs, manquant d’eau, furent obligés de capituler."
                                            },
                                            {
                                                "example_id": "ef7054a2-a0c9-48d5-b992-cc0a7a6e3b2a",
                                                "sense_id": "e9ea405d-b2ac-3e75-b502-09c7de156096",
                                                "text": "– Je suis citoyen britannique ! – continua Bert, obstiné. – Vous n’êtes pas obligés d’écouter, mais rien ne me force à me taire."
                                            },
                                            {
                                                "example_id": "529ac69b-2201-4a7b-bfed-e8c06c1ea95c",
                                                "sense_id": "e9ea405d-b2ac-3e75-b502-09c7de156096",
                                                "text": "J'écoute encore un peu, politesse et hiérarchie obligent, je m'ennuie, je grognasse quelques onomatopées, je raccroche."
                                            },
                                            {
                                                "example_id": "b43035ce-ca43-43f8-be24-a3d72a732547",
                                                "sense_id": "e9ea405d-b2ac-3e75-b502-09c7de156096",
                                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                        "entry_id": "4684049e-cc4c-31ac-888b-15793da684ee",
                                        "glosses": [
                                            "Lier quelqu’un par un contrat, par une promesse, contraindre à exécuter la chose à laquelle on s’est engagé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c4b0aa-49bc-4574-9386-190633273a23",
                                                "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                                "text": "Son contrat l’oblige à cela."
                                            },
                                            {
                                                "example_id": "f1a3ed19-6501-4394-ab26-cd262133a07d",
                                                "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                                "text": "Faire obliger le mari et la femme."
                                            },
                                            {
                                                "example_id": "6424d9a8-7100-4a88-bc55-d9b181e3a92f",
                                                "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                                "text": "Il y a dans le bail une clause qui l’y oblige."
                                            },
                                            {
                                                "example_id": "8fe8171f-f763-4fbb-a1e7-4ae9351ea3ad",
                                                "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                                "text": "S’obliger solidairement."
                                            },
                                            {
                                                "example_id": "5d47fa46-ec50-4524-9d0f-017a22405c91",
                                                "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                                                "text": "Prêtez-moi cette somme, je m’oblige à vous la rendre dans deux jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc75f13-b0ea-3e95-9e97-e0d1e7c32878",
                                        "entry_id": "4684049e-cc4c-31ac-888b-15793da684ee",
                                        "glosses": [
                                            "Hypothéquer ou cautionner."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d47711e-72aa-4479-985a-f77aacbef92e",
                                                "sense_id": "3fc75f13-b0ea-3e95-9e97-e0d1e7c32878",
                                                "text": "Il a obligé tous ses biens."
                                            },
                                            {
                                                "example_id": "0c3f76c4-dc74-47a1-81ab-ff2e581c5cd2",
                                                "sense_id": "3fc75f13-b0ea-3e95-9e97-e0d1e7c32878",
                                                "text": "S’obliger pour quelqu’un, lui servir de caution, répondre des pertes ou des dommages qui peuvent arriver par sa faute, des engagements qu’il ne remplirait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                                        "entry_id": "4684049e-cc4c-31ac-888b-15793da684ee",
                                        "glosses": [
                                            "Contraindre, forcer ou mettre dans la nécessité de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ec6f6a-9753-4677-81d9-092f2218a32f",
                                                "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l'obligeant à vivre dans des usines malsaines, […]."
                                            },
                                            {
                                                "example_id": "b783ecc4-04fe-4091-b79e-e4e7340d3b02",
                                                "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                                                "text": "C’est les Jésuites qui ont fait assassiner Henri IV ; c’est encore eux qui ont fait révoquer l’Édit de Nantes, à la suite de quoi tous les protestants ont été obligés de quitter la France; […]."
                                            },
                                            {
                                                "example_id": "164d0dc1-34e7-4aac-88d5-86dcf2139d79",
                                                "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                                                "text": "Pour dormir ils étaient obligés de se hisser sur les racines de mangliers qui abondaient dans cette région."
                                            },
                                            {
                                                "example_id": "fbd1d968-447d-4927-9e0d-06c52fbce0f7",
                                                "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                                                "text": "Le 8 février, il combat contre un triplace, armé de trois mitrailleuses, et l’oblige à descendre dans nos lignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                        "entry_id": "4684049e-cc4c-31ac-888b-15793da684ee",
                                        "glosses": [
                                            "Attacher quelqu’un par un service, faire plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a00017f-58e4-4046-9877-8ed199ea2656",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Il était généreux ; il ne craignait point d'obliger des ingrats, suivant ce grand précepte de Zoroastre : \"Quand tu manges, donne à manger aux chiens, dussent-ils te mordre.\""
                                            },
                                            {
                                                "example_id": "d684dffd-64aa-480e-99e7-1b8d62684c45",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Vous m’obligerez beaucoup de ne pas chercher à me revoir."
                                            },
                                            {
                                                "example_id": "67a3a36a-be8a-4107-8aa7-8cffcec0c6d9",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Il avait eu la douleur de voir ceux qu’il avait obligés et dont il se croyait sûr le renier et l’abandonner."
                                            },
                                            {
                                                "example_id": "0692ff04-ca7d-4df3-9308-5ef4c8072cd6",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "— Vous m’avez obligé, répondit-il en me donnant une poignée de main, aujourd’hui je vous oblige, chacun son tour."
                                            },
                                            {
                                                "example_id": "4db0b3d4-12d2-4661-a175-b79b02e77165",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Vous pouvez donc entrer dans ce petit cabinet comme dans toutes les autres chambres de ce logis ; mais, si vous m’en croyez, vous n’en ferez rien, pour m’obliger et en considération des idées douloureuses que j’y attache et des mauvais présages que ces idées font naître malgré moi dans mon esprit."
                                            },
                                            {
                                                "example_id": "fa4aab4e-3b8b-432c-a1a5-d0b50c780a97",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Comme le sens critique qu’il croyait exercer sur tout lui faisait complètement défaut, le raffinement de politesse qui consiste à affirmer à quelqu’un qu’on oblige, sans souhaiter d’en être cru, que c’est à lui qu’on a obligation, était peine perdue avec lui, il prenait tout au pied de la lettre."
                                            },
                                            {
                                                "example_id": "6b0d9380-5138-44b3-8bf5-8310bc4190f2",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Il m’a obligé quand j’étais dans le malheur."
                                            },
                                            {
                                                "example_id": "7370ca1c-5520-4de2-82c2-fbaf0bbc910c",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Vous m’obligerez extrêmement, infiniment."
                                            },
                                            {
                                                "example_id": "9fb273a4-25ca-480e-b85a-6e0f7db79971",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Il oblige tout le monde."
                                            },
                                            {
                                                "example_id": "f4ed4245-a47e-411d-8176-269c832b3d19",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Il m’a obligé de son crédit, de sa bourse."
                                            },
                                            {
                                                "example_id": "a8a80a9e-d1f3-423f-aa09-efa2ef5dd20b",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "Vous m’obligerez beaucoup d’aller lui parler pour moi."
                                            },
                                            {
                                                "example_id": "86fee728-d20e-4c3f-a65f-49271bb4610c",
                                                "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                                                "text": "En me rendant ce service vous n’obligerez pas un ingrat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
