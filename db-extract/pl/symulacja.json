                    }
                ],
                "translations": [
                    {
                        "translation_id": "dacf4550-c022-4ad2-b52b-362a670d7c9b",
                        "source_entry_id": "4bcbfda6-1ed0-3872-8830-825b95dacbbd",
                        "source_sense_id": "bd3c4a54-08b3-3fa3-b7a6-b1bf18bfc8bf",
                        "target_lang_word": "simulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "623d356b-e3d9-3bd7-b394-abcbc6bb7af5",
                                        "entry_id": "36bb0b9c-7801-3313-a112-ffe1f826a18e",
                                        "glosses": [
                                            "Something that simulates a system or environment in order to predict actual behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d4cb2c-b320-4e38-b62b-ff082ef55a7f",
                                                "sense_id": "623d356b-e3d9-3bd7-b394-abcbc6bb7af5",
                                                "text": "This exercise is a simulation of actual battle conditions."
                                            },
                                            {
                                                "example_id": "5e658b64-5f66-4f16-b5cb-d00861992108",
                                                "sense_id": "623d356b-e3d9-3bd7-b394-abcbc6bb7af5",
                                                "text": "The most reliable simulation predicts that the hurricane will turn north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf097e9-70b7-36fc-868a-2d32042c4009",
                                        "entry_id": "36bb0b9c-7801-3313-a112-ffe1f826a18e",
                                        "glosses": [
                                            "The process of simulating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae4e8118-5220-4770-aaba-5ca4e1fdd08a",
                                                "sense_id": "9cf097e9-70b7-36fc-868a-2d32042c4009",
                                                "text": "Despite extensive simulation in the design phase, the aircraft failed to behave as expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2818daa-25c0-36ec-9d34-3f4beb444ba7",
                                        "entry_id": "36bb0b9c-7801-3313-a112-ffe1f826a18e",
                                        "glosses": [
                                            "A video game designed to convey a more or less realistic experience, as of a sport or warfare."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "398ff32e-db97-44f7-8164-2c80f7eec621",
                                                "sense_id": "f2818daa-25c0-36ec-9d34-3f4beb444ba7",
                                                "text": "Some kids in the classroom will be playing simulations after school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "492e35fe-b6fe-38f4-a584-d2a65bdb4f1a",
                                        "entry_id": "36bb0b9c-7801-3313-a112-ffe1f826a18e",
                                        "glosses": [
                                            "Assuming an appearance which is feigned, or not true."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f06edeff-749c-4b30-a64b-0c5d6f77d4ef",
                                                "sense_id": "492e35fe-b6fe-38f4-a584-d2a65bdb4f1a",
                                                "text": "For to him that opens himself, Men will hardly shew themselves averse, but will (fair) let him go on, and turn their freedom of speech to freedom of thought. And therefore it is a good shrewd Proverb of the Spaniard, Tell a lye, and find a Troth; as if there were no way of discovery, but by Simulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b01657-bcbe-3e34-a6ad-d577ad6a7927",
                                        "entry_id": "36bb0b9c-7801-3313-a112-ffe1f826a18e",
                                        "glosses": [
                                            "The act of falling over in order to be awarded a foul, when no foul has been committed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be0c215-552f-4eba-93e0-038c5de6bab2",
                                                "sense_id": "64b01657-bcbe-3e34-a6ad-d577ad6a7927",
                                                "text": "\"Players are very good at simulation,\" said Premier League referee Graham Poll. \"I'm not saying they do practice, but I find it hard to believe they are so good at something without practicing. We have to issue more cards because it is the only way we can stop simulation spoiling the game. It is a cancer.\""
                                            },
                                            {
                                                "example_id": "6a6d1cdc-b908-4720-9713-cb3ad516c5fb",
                                                "sense_id": "64b01657-bcbe-3e34-a6ad-d577ad6a7927",
                                                "text": "In the build-up to the second spot-kick, André Villas-Boas felt United striker Danny Welbeck had deliberately tripped over the leg of Branislav Ivanovic rather than an intentional foul being committed. \"Referees have pretty clear orders on simulation, but it is difficult for them to assess the difference between simulation and fouls in those situations,\" he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6550bac8-1e41-4396-b019-168f2a04c558",
                        "source_entry_id": "4bcbfda6-1ed0-3872-8830-825b95dacbbd",
                        "source_sense_id": "bd3c4a54-08b3-3fa3-b7a6-b1bf18bfc8bf",
                        "target_lang_word": "Simulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Simulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02178686-c42b-3c33-a9c7-856f5fd57526",
                                        "entry_id": "716412a0-ddb2-3242-9f11-771b54349dc1",
                                        "glosses": [
                                            "die Darstellung einen Sachverhalt, Zustand oder Umstand in veränderter, (stark abgewandelter oder gegensätzlicher) Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e503cadf-3c5c-4376-bd1d-4cf8244820f0",
                                                "sense_id": "02178686-c42b-3c33-a9c7-856f5fd57526",
                                                "text": "„Kriegsneurosen wurden nur von einer Minderheit von Psychiatern als Simulation verkannt, ein Fehler, den unter anderem Freud (1920a) rügte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70be20ee-95c3-37b1-86f0-c2f958784fc8",
                                        "entry_id": "716412a0-ddb2-3242-9f11-771b54349dc1",
                                        "glosses": [
                                            "System, das mit ähnlichen Eigenschaften wie ein Original erstellt wurde, um Reaktionen und Veränderungen des Originals zu ermitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6720d952-0be3-4208-9ca0-afafb10826c1",
                                                "sense_id": "70be20ee-95c3-37b1-86f0-c2f958784fc8",
                                                "text": "Die Simulation des globalen Wetters kann Wettervorhersagen und Klimaveränderungen vorausberechnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd20bbff-5f4b-303d-94da-e7debe559fb4",
                                        "entry_id": "716412a0-ddb2-3242-9f11-771b54349dc1",
                                        "glosses": [
                                            "Prozess, bei dem [1] benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cf1b7d7-7ac2-422b-b6e2-72ef4d91ab96",
                        "source_entry_id": "4bcbfda6-1ed0-3872-8830-825b95dacbbd",
                        "source_sense_id": "bd3c4a54-08b3-3fa3-b7a6-b1bf18bfc8bf",
                        "target_lang_word": "симуляция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "симуляция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e80213cf-6974-3eaf-9900-a90b3619c6df",
                                        "entry_id": "c1bd9eb1-c408-3852-ab33-e4b874cfd1e4",
                                        "glosses": [
                                            "действие по значению гл. симулировать; создание ложного впечатления, представления о чём-либо; притворство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d1e0fb-edfe-4f76-beab-942b78c11353",
                                                "sense_id": "e80213cf-6974-3eaf-9900-a90b3619c6df",
                                                "text": "Я не знаю случаев симуляции умопомешательства до совершения преступления, но они могут встретиться.",
                                                "translation": "Je n'ai pas recueilli de faits où la folie ait été simulée avant l'accomplissement d'un crime."
                                            },
                                            {
                                                "example_id": "db005cfc-7015-434b-9449-77321ad9bed7",
                                                "sense_id": "e80213cf-6974-3eaf-9900-a90b3619c6df",
                                                "text": "Каторжного с мигренью или ишиасом легко заподозрить в симуляции и не пустить в лазарет; однажды я видел, как целая толпа каторжных просилась у смотрителя тюрьмы в лазарет и он отказывал всем, не желая разбирать ни больных, ни здоровых."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
