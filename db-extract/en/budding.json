    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9d2536af-4e93-326b-bc75-14073e009464",
                "word": "budding",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                        "entry_id": "9d2536af-4e93-326b-bc75-14073e009464",
                        "glosses": [
                            "Beginning to develop."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "05f49985-e306-4d30-b074-1c71bbca394b",
                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                "text": "He's a budding deejay."
                            },
                            {
                                "example_id": "a06fd780-f35d-414d-a374-289a94e2e24c",
                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                "text": "The most surprising thing was to discover that each job had its little tricks, peculiarities that had been learned in the experience of years, and one of the really pleasing features was the unlimited patience and kindliness of the chargehands and fitters, who would go to great lengths to teach the budding engineer all they themselves knew."
                            },
                            {
                                "example_id": "eb9a734a-3be5-43aa-9ad4-3594f7f57af0",
                                "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                                "text": "Council's tip shops in Acacia Ridge and Geebung are treasure troves for everyone from budding home stylists to outdoor enthusiasts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f35dd94-423c-45dc-8094-27757cb64fee",
                        "source_entry_id": "9d2536af-4e93-326b-bc75-14073e009464",
                        "source_sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "en herbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en herbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8ed058-2d4f-38b7-8fb9-ac393164cd65",
                                        "entry_id": "dac1baf7-87f8-3101-969b-0137ef8f1fca",
                                        "glosses": [
                                            "Qualifie de jeunes plants lorsqu’ils sont encore verts et qu’ils s’élèvent peu au-dessus des sillons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce7fba0-01ea-43a8-b182-2759677cd5b2",
                                                "sense_id": "cb8ed058-2d4f-38b7-8fb9-ac393164cd65",
                                                "text": "De la vue qu’encadrait la fenêtre de sa chambre, il retint le bleu lavande du ciel orageux et des collines et les tons rompus de bleu-vert du champ de blé en herbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e92e013-321f-3f29-a3b3-967afa7b4b97",
                                        "entry_id": "dac1baf7-87f8-3101-969b-0137ef8f1fca",
                                        "glosses": [
                                            "Qualifie un jeune homme ou une jeune femme qui étudie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bde50a2-a4b1-40d5-a793-0d3f4f15af68",
                                                "sense_id": "1e92e013-321f-3f29-a3b3-967afa7b4b97",
                                                "text": "C’est un avocat en herbe, un docteur en herbe, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba938d6a-f252-3588-954a-ebf66ac3a4dd",
                                        "entry_id": "dac1baf7-87f8-3101-969b-0137ef8f1fca",
                                        "glosses": [
                                            "Qualifie un professionnel qui apprend encore son métier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eba9a37-45ee-4eef-85be-6598c941ef37",
                                                "sense_id": "ba938d6a-f252-3588-954a-ebf66ac3a4dd",
                                                "text": "Vous allez voir défiler les uns après les autres tous les gens de talent, petits et grands, artistes en herbe ou en gerbe, qui élèvent, à la gloire de la France, ce monument de tous les jours appelé l’Opéra, réunion de forces, de volontés, de génies qui ne se trouve qu’à Paris…"
                                            },
                                            {
                                                "example_id": "43d520c1-9298-4a07-9b45-62a7af876398",
                                                "sense_id": "ba938d6a-f252-3588-954a-ebf66ac3a4dd",
                                                "text": "Le front de Victor Hugo fera raser autant de crânes, que la gloire de Napoléon a fait tuer de maréchaux en herbe."
                                            },
                                            {
                                                "example_id": "c9ec7e4d-6b0c-4046-82fb-cda360620060",
                                                "sense_id": "ba938d6a-f252-3588-954a-ebf66ac3a4dd",
                                                "text": "Un jardinier qui sabote une pelouse\nEst un assassin en herbe."
                                            },
                                            {
                                                "example_id": "0f59cd61-1a11-4632-a1e3-5488b710a3ef",
                                                "sense_id": "ba938d6a-f252-3588-954a-ebf66ac3a4dd",
                                                "text": "Comme toute comédienne en herbe qui se respecte, j’arrive en avance à mon audition de 16 heures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
