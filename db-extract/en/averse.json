                        "sense_id": "86934f58-1869-3e3d-aa3a-a9cfd4739719",
                        "entry_id": "d6c77806-579c-36be-8cfd-36c1e82c3164",
                        "glosses": [
                            "转过身"
                        ],
                        "tags": [
                            "obsolete",
