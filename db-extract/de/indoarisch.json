                        "form_id": "0641053d-6a07-444b-a1cb-1c9f8acf98c1",
                        "entry_id": "ba93b0b2-72af-3758-afec-149ebb919d71",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind indoarisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                        "entry_id": "ba93b0b2-72af-3758-afec-149ebb919d71",
                        "glosses": [
                            "die Indoarier Vorderasiens betreffend, von ihnen stammend"
                        ],
                        "tags": [
                            "Völkerkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "b35301fd-50ff-4f27-be01-5dcd8dc826bc",
                                "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                                "text": "Ihre Zivilisation entstand demnach durch Vermischung von eingewanderten Volksgruppen wie den Ariern mit einheimischen, nicht indoarischen Ureinwohnern."
                            },
                            {
                                "example_id": "b03060e9-5792-4de1-9c47-15a5ad8c90e8",
                                "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                                "text": "Die Theorie der arischen Invasion hat mindestens so viele Gegner wie Befürworter: Vor allem in Indien sprechen sich sowohl Wissenschaftler als auch Politiker gegen den fremdländischen Ursprung der indoarisch sprechenden Bevölkerung auf dem Subkontinent aus."
                            },
                            {
                                "example_id": "66666e5f-7d82-4c31-8275-7d9afa5a1935",
                                "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                                "text": "Das Romani nimmt als einziger Vertreter des indoarischen Zweiges eine Sonderposition in der Sprachlandschaft Europas ein."
                            },
                            {
                                "example_id": "ee2f588b-3bb8-43b0-bd91-29bd5fee54d6",
                                "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                                "text": "Die indoarischen Ortschaften Dha-Hanu waren deshalb von Beginn der Öffnung an beliebtes touristisches Ausflugsziel."
                            },
                            {
                                "example_id": "d85ddcfe-3036-461b-bd3b-da457bb314d9",
                                "sense_id": "e4c425c5-0982-3b17-95d0-9181b715a891",
                                "text": "Indoarisch waren zudem die Namen einiger mitannischer Herrscher, wofür auf Schuttarna, Parsasatar, Artatama und Tuschratta verwiesen werden kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
