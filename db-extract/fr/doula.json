            {
                "entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                "word": "doula",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84aad558-415d-4e68-a009-028457ebfcea",
                        "entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                        "tags": [
                            "plural"
                        ],
                        "form": "doulas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "060b2c39-84f1-34dc-894b-2430c1f36863",
                        "entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                        "glosses": [
                            "Personne, qui fournit un accompagnement, une information et un soutien aux futures mères et à leur entourage durant la grossesse, l’accouchement et la période postnatale. C'est une activité de service à la personne."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "08b86c42-058b-4d4a-b35f-43a5df1f1dad",
                                "sense_id": "060b2c39-84f1-34dc-894b-2430c1f36863",
                                "text": "Une doula ne fait pas d’accompagnement médical, elle n’est pas thérapeute, elle ne fait pas de suivi de grossesse."
                            },
                            {
                                "example_id": "7b37c668-bc1c-4483-af34-892f6e32c571",
                                "sense_id": "060b2c39-84f1-34dc-894b-2430c1f36863",
                                "text": "Le lendemain, la joie au cœur, sa rose écarlate à son cimier, il sortit du camp sur son beau destrier et prit la direction du Nord envié par tous ses compagnons, car il serait le premier à voir « France la doula »."
                            }
                        ]
                    },
                    {
                        "sense_id": "0811680e-0bd8-3d4e-add3-9a22f2df5eea",
                        "entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                        "glosses": [
                            "Professionnel fournissant accompagnement et soutien lors de grandes étapes de la vie, hors du domaine de la périnatalité : puberté, préconception, PMA, grossesse, avortement, fausse-couche, deuil périnatal, adoption, ménopause, deuil, fin de vie, ..."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "6da4e407-12f8-4c2f-b6d2-2e1e434b6e73",
                                "sense_id": "0811680e-0bd8-3d4e-add3-9a22f2df5eea",
                                "text": "Les doulas de fin de vie n’administrent pas leurs médicaments aux patients, ne surveillent pas les signes vitaux, ne prennent pas de décisions médicales ni ne conseillent leurs patients à ce sujet, n’imposent pas leurs valeurs ou leurs jugements et ne font pas le travail que feraient des thérapeutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7f40e36-1d0d-4b84-a0fe-8e2aaf9d99b0",
                        "source_entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                        "target_lang_word": "doula",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0181fbca-bf5c-44cc-bde4-3d7b3da62997",
                        "source_entry_id": "35e44432-5d2b-32cc-b893-8e22ea23af27",
                        "target_lang_word": "doula",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doula",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d61d6c0b-4646-3fa2-b8aa-ecacf7a37e7b",
                                        "entry_id": "c62f2ad3-4d67-3e68-bdce-3b63d94c736b",
                                        "glosses": [
                                            "A trained support person who provides emotional, physical and practical assistance to a pregnant woman or couple before, during or after childbirth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9454f7ef-e79f-4a3f-bd8c-13c91c0cf624",
                                                "sense_id": "d61d6c0b-4646-3fa2-b8aa-ecacf7a37e7b",
                                                "text": "The function of the doula varies in different cultures from a little help here and there to complete succoring, including bathing, cooking, carrying, and feeding. Whatever the doula does, however, is less important than the fact that she is there."
                                            },
                                            {
                                                "example_id": "a6a2d8ed-557f-4322-b288-9364dcf5e59d",
                                                "sense_id": "d61d6c0b-4646-3fa2-b8aa-ecacf7a37e7b",
                                                "text": "Rebekah Rosler, a therapist and doula, decided to leave, even though her family history in New York goes back to the 1870s, she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977861ad-4400-315f-bdf8-3a94a0460aa9",
                                        "entry_id": "c62f2ad3-4d67-3e68-bdce-3b63d94c736b",
                                        "glosses": [
                                            "A trained person who provides similar support to someone who is diagnosed with an incurable condition and is receiving end-of-life care."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74b648c8-6792-4491-8864-a51ef078f4b5",
