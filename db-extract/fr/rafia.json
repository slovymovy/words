                        "glosses": [
                            "Fibre ou lien tiré de Raphia ruffia (ou Raphia farinifera) originaire de Madagascar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2427c87a-2134-411b-b0e1-7e80cbf6fd7f",
                                "sense_id": "7e884d70-c420-392a-908f-c157e6db4276",
                                "text": "Évidemment il y a là les inévitables boîtes de carton, qui sont devenues artistiques parce qu’on les a recouvertes de rafia."
                            },
                            {
                                "example_id": "d45c7d86-2ba9-4ecd-afa2-e84db952483a",
                                "sense_id": "7e884d70-c420-392a-908f-c157e6db4276",
                                "text": "C’est pourtant elle qui inventa de tresser finement des joncs, du rafia, d’en figurer des feuilles, d’en façonner des ceintures, des sandales."
                            }
                        ]
                    }
