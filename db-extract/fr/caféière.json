                        "sense_id": "4df66af1-63f3-3018-924d-bd00af7e186f",
                        "entry_id": "0a80afa6-6357-3c10-9312-c12ee98129ae",
                        "glosses": [
                            "Lieu planté de caféiers."
                        ],
                        "tags": [
