                "senses": [
                    {
                        "sense_id": "7c80bf71-68c4-37fd-99b5-e1a4ff606930",
                        "entry_id": "f83e9c50-c13b-32ba-ac98-a07b50f04adf",
                        "glosses": [
                            "Junge im Alter von neunem Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767b2037-3e90-4890-892f-433aa8c2673a",
                                "sense_id": "7c80bf71-68c4-37fd-99b5-e1a4ff606930",
                                "text": "„Patrick, der Neunjährige, war fast das genaue Gegenteil. Noch immer sehr verspielt, hielt er sich meist an seine Schwester, sie würde schon wissen, was gut war, und sie würde auch alles richten.“"
                            },
                            {
                                "example_id": "8a14884f-9b72-4eca-96d8-ca5b06e9f68d",
                                "sense_id": "7c80bf71-68c4-37fd-99b5-e1a4ff606930",
                                "text": "„Selbst nachdem er durch die Katzenklappe geschlüpft war und durchs Treppenhaus strich, war das Geschrei des Neunjährigen noch zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
