                    {
                        "sense_id": "81e09108-e25c-39d9-a681-4ae76d2e8240",
                        "entry_id": "7d50049f-cb4f-35d0-8714-ebb9ad6ee3af",
                        "glosses": [
                            "De couleur châtain-roux à reflets cuivrés le plus souvent utilisé pour les cheveux. #9D3E0C"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2beeaf2-a85b-41da-b78c-96714ea8bbbf",
                                "sense_id": "81e09108-e25c-39d9-a681-4ae76d2e8240",
                                "text": "Le chapeau de paille ne pouvait parvenir à enfermer les masses de sa chevelure auburn."
                            },
                            {
                                "example_id": "15bf85f4-cbf9-4ab2-ae4a-0f6aa467c3bf",
                                "sense_id": "81e09108-e25c-39d9-a681-4ae76d2e8240",
                                "text": "Une femme aux cheveux auburn s’approche du véhicule, un carton dans les bras"
                            },
                            {
                                "example_id": "b2e8332f-a191-4e78-ba17-a3884ce15f6a",
                                "sense_id": "81e09108-e25c-39d9-a681-4ae76d2e8240",
                                "text": "Les cheveux mouillés de la fille tombaient en mèches auburnes collant sur son front, son visage gonflé luisait, ainsi que ses yeux bleus profonds aux pupilles épinglées, elle s’essuya les joues, rouges du froid de la pluie."
                            }
                        ]
                    }
                ],
                "translations": [
