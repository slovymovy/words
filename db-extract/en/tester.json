                    },
                    {
                        "sense_id": "34e2ccb1-0997-3753-9719-24268f60c5f2",
                        "entry_id": "7ddf7c75-7bc3-3db6-be54-d556cf079e9e",
                        "glosses": [
                            "A sixpence."
                        ],
                        "tags": [
