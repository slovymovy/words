                "senses": [
                    {
                        "sense_id": "08bd1c58-ddb9-3473-9784-ae3b1319386c",
                        "entry_id": "39ddf926-2662-3f0c-8d76-b8fde106abc3",
                        "glosses": [
                            "Variante de empéguer."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f68a818e-e9aa-4884-8b5f-e1af471e7a3b",
                                "sense_id": "08bd1c58-ddb9-3473-9784-ae3b1319386c",
                                "text": "Il a aussi déjà empêgué les hélices des bateaux de pêche du Conquet."
                            },
                            {
                                "example_id": "6dfd1140-9695-4642-937b-a52fdebc187d",
                                "sense_id": "08bd1c58-ddb9-3473-9784-ae3b1319386c",
                                "text": "Car une fois que tu es empêgué, aprés c'est repiquage sur repiquage. Et la récolte fond comme neige au soleil."
                            },
                            {
                                "example_id": "00fae018-f8ea-4348-8c87-8c1ea050b6b3",
                                "sense_id": "08bd1c58-ddb9-3473-9784-ae3b1319386c",
                                "text": "J’espérais qu’il arrive empêgué aux obsèques et que ce soit l’occasion pour lui de mettre sa menace à exécution."
                            },
                            {
                                "example_id": "d72ce457-9bd8-440f-b0e5-feeda1f65226",
                                "sense_id": "08bd1c58-ddb9-3473-9784-ae3b1319386c",
                                "text": "Quatre vingts bagnoles s'empêguent joyeusement sur l'A1: grotesque!"
                            }
                        ]
                    }
