                        "entry_id": "6f6b00e8-a430-3916-856f-3ba507f9a356",
                        "glosses": [
                            "ein Stück Papier, das so gefaltet ist, dass ein knallendes Geräusch entsteht, wenn man es ruckartig bewegt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
