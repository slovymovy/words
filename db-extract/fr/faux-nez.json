                                    },
                                    {
                                        "sense_id": "bee72236-61cd-346b-b863-6932883478a7",
                                        "entry_id": "a7f9185d-ebdf-3a16-bacf-e6bffe83ec49",
                                        "glosses": [
                                            "ein zweites oder mehrfaches Benutzerkonto einer bereits auf einer Seite angemeldeten Person"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e535df9d-a102-4688-8f0e-9941a7eca9cf",
                                                "sense_id": "bee72236-61cd-346b-b863-6932883478a7",
                                                "text": "Das Erstellen von Sockenpuppen ist verpönt, da jeder Mensch auch im Internet nur eine einzige Identität haben sollte."
                                            },
                                            {
                                                "example_id": "63af5274-e6ff-4bb1-b1ac-e2ff88c007fa",
                                                "sense_id": "bee72236-61cd-346b-b863-6932883478a7",
                                                "text": "Ein Zweitbenutzerkonto wird erst zur Sockenpuppe, wenn es missbräuchlich eingesetzt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
