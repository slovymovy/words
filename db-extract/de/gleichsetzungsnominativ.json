                "senses": [
                    {
                        "sense_id": "4cf6ea4e-8f62-365e-a19b-cce86bed6418",
                        "entry_id": "f23ae54d-a72a-3a61-85d4-f1a060516141",
                        "glosses": [
                            "ein zweites Satzglied (außer dem Subjekt) im Nominativ im gleichen Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7259d118-240d-4a35-9ea8-f35a5d83fe32",
                                "sense_id": "4cf6ea4e-8f62-365e-a19b-cce86bed6418",
                                "text": "Im Satz „Der Junge ist ein guter Schüler.“ ist \"ein guter Schüler\" der Gleichsetzungsnominativ."
                            },
                            {
                                "example_id": "14da7db4-b5ef-4088-988a-190f5e1483e1",
                                "sense_id": "4cf6ea4e-8f62-365e-a19b-cce86bed6418",
                                "text": "Der Gleichsetzungsnominativ steht in dem Satz „Der Junge ist ein guter Schüler.“ für die grammatische Funktion \"Prädikatsnomen\"."
                            },
                            {
                                "example_id": "ebd0972f-9e01-467b-b7a5-d24d73fb3de8",
                                "sense_id": "4cf6ea4e-8f62-365e-a19b-cce86bed6418",
                                "text": "„Diese Frage wird virulent bei Sätzen mit Gleichsetzungsnominativen.“"
                            },
                            {
                                "example_id": "610e961a-0a65-4608-9cbf-a58edc59296a",
                                "sense_id": "4cf6ea4e-8f62-365e-a19b-cce86bed6418",
                                "text": "„Die Verben sein, werden und bleiben können statt des Gleichsetzungsnominativs auch ein Adjektiv, ein Adverb oder andere Angaben bei sich haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
