                "senses": [
                    {
                        "sense_id": "516bd00c-b107-35ca-9b21-cf5784330a2b",
                        "entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "glosses": [
                            "полит. неравноправный договор, навязанный одним государством другому (в международном праве)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf3a588c-030f-32df-b0ff-a7da2cc76816",
                        "entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "glosses": [
                            "политика навязывания своих условий, требований сильной стороной другой, более слабой в политическом и экономическом отношении стороне при заключении каких-либо соглашений"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "61ad21c6-be4e-3163-a0ea-bf86e1323ca4",
                        "entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "glosses": [
                            "жёсткие требования, навязывание своей воли кому-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ff07cc1-15e3-4320-bb51-933281b4356b",
                        "source_entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "target_lang_word": "diktat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diktat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a281a9-d954-3e0a-bcd4-ca37ef106a46",
                                        "entry_id": "76d7cc32-47c5-3b76-84d4-53b5f2e5424e",
                                        "glosses": [
                                            "a harsh penalty or settlement imposed upon a defeated party by the victor"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                        "entry_id": "76d7cc32-47c5-3b76-84d4-53b5f2e5424e",
                                        "glosses": [
                                            "a dogmatic decree or command, especially issued by one who rules without popular consent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e19d3ab-4d74-4158-a74d-632b99a8bc09",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "Whatever the pressures that have invoked the Minister's diktat, the outcome is Gilbertian."
                                            },
                                            {
                                                "example_id": "9e4be91f-7943-43de-8860-38adbe0810b9",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "Today, regional diktat is now supplemented (though not wholly replaced) by other means of recruiting elites."
                                            },
                                            {
                                                "example_id": "ceb832a0-df1b-4e05-9929-25fd25d8a76f",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "It should be noted that Saddam's power was held up by fear and diktat."
                                            },
                                            {
                                                "example_id": "0f3a7592-9c50-4a7a-9983-906f70106355",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "Trump—according not to the paranoid fears of his opponents, but his own professed desires—would have the government’s law enforcement institutions act as political weapons, aimed by his diktat."
                                            },
                                            {
                                                "example_id": "5a9f5d30-458c-4108-aa25-644a26cbc88f",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "He added that “the issues are still the same” and that Russian President Putin “still wishes to impose his diktat on Ukraine.”"
                                            },
                                            {
                                                "example_id": "e160086c-7066-4f9d-9216-af8beb9ee4a3",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "But amid all the disruption and norm-breaking, it’s Mr. Trump’s apparently keen interest in shaping American culture that may be most intriguing. To critics, it’s nothing less than a sign of his authoritarian bent – reminiscent of the Stalin-esque playbook that made government diktats over artistic expression a feature of the old Soviet Union."
                                            },
                                            {
                                                "example_id": "8989ff8e-8b4d-4e35-979f-e62bf191a440",
                                                "sense_id": "f0319e59-c599-3e8b-890b-8346fe40d5b8",
                                                "text": "Traditional social codes can sometimes prove as strict as any government diktat. Late last year, Chinese e-commerce giant JD faced a boycott by customers infuriated by its casting of trailblazing woman comedian Yang Li in a promotional live stream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79df3129-dbe9-47d2-97a2-094ad6f444c0",
                        "source_entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "target_lang_word": "diktat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diktat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28035cf1-8e0c-35a2-b07d-c9353e0f6a0e",
                                        "entry_id": "60848daa-f999-31c9-8655-8c97a84c6413",
                                        "glosses": [
                                            "Nom donné par dénigrement, en Allemagne, à un ordre ou un traité imposé par la force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                                        "entry_id": "60848daa-f999-31c9-8655-8c97a84c6413",
                                        "glosses": [
                                            "Mesure imposée de façon autoritaire, dictée à l’interlocuteur, au partenaire d’un dialogue, sans qu’il puisse riposter, en raison d’une situation inégale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c23ab4-5e10-43e0-b72d-a352641f55a1",
                                                "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                                                "text": "Le diktat du PDG, revient à dire que c’est lui qui décide, sans en référer aux partenaires sociaux."
                                            },
                                            {
                                                "example_id": "f90f6a70-24f8-465b-a199-3aafd2b7f4b9",
                                                "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                                                "text": "Gouverner par diktats, au lieu d’échanger des points de vue, caractéristique des régimes autoritaires."
                                            },
                                            {
                                                "example_id": "1395966c-537e-42ba-bf62-8cc253edaafd",
                                                "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                                                "text": "L’incompétence (l’ignorance, la sottise), préfère le diktat à la discussion intelligente, quand les circonstances, les conditions truquées de l’échange le rendent possible."
                                            },
                                            {
                                                "example_id": "0e8951ae-ed77-4069-9c92-4f0d6875fcdb",
                                                "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                                                "text": "Rien à voir avec les salons antiquité-brocante où les vendeurs désabusés distillent leurs diktats avec une prétention condescendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f77a9a8-aa5f-3ac6-9eec-597bf41a5a33",
                                        "entry_id": "60848daa-f999-31c9-8655-8c97a84c6413",
                                        "glosses": [
                                            "Pression psychologique insidieuse qui s’impose du fait de l'évolution des modes de vie."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156f7c9c-bfbb-4368-8e85-b6c6b7963409",
                                                "sense_id": "6f77a9a8-aa5f-3ac6-9eec-597bf41a5a33",
                                                "text": "Une résistance face au malaise de la société, une volonté d’échapper à ce diktat de l’urgence, à l’immédiateté devenue norme, ,.. ."
                                            },
                                            {
                                                "example_id": "9f5cdc89-77f8-45a9-ab14-cfcf57ee18e0",
                                                "sense_id": "6f77a9a8-aa5f-3ac6-9eec-597bf41a5a33",
                                                "text": "Comme le rappelle un rescapé, cité par Cécile Asanuma-Brice, « la radioactivité vole tout. Tôt ou tard, tout disparaîtra ». Les habitants vivent emprisonnés dans le règne de la mesure. Sous le diktat des dosimètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67655b9f-65b7-4075-b060-b18f0d052ded",
                        "source_entry_id": "4759bf12-b886-303b-8c29-72a56d288cc2",
                        "target_lang_word": "dictat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f9a021d-a745-3d1c-979a-6752c0171e9e",
                                        "entry_id": "8bed8324-8349-3758-b016-71d67658f659",
                                        "glosses": [
                                            "Contrainte jugée excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "149790f7-396d-4cc5-83da-81cd80e109f6",
                                                "sense_id": "8f9a021d-a745-3d1c-979a-6752c0171e9e",
                                                "text": "Le gouvernement du Parti populaire, fidèle à ce qu’est Mariano Rajoy, un conservateur des hypothèques, un de ces bureaucrates du XIXᵉ siècle comme ceux qui portaient des manchettes en coutil noir pour protéger la blancheur de leur chemise, est devenu, grâce au soutien d’une majorité absolue, une sorte d’émissaire des dictats des marchés pour augmenter la précarité des citoyens transformés en malheureux consommateurs."
                                            },
                                            {
                                                "example_id": "f7900de1-5115-4166-abba-438a5192a5e2",
                                                "sense_id": "8f9a021d-a745-3d1c-979a-6752c0171e9e",
                                                "text": "Leur matière et leur patine profonde quasi laquée témoignent d’une extrême ancienneté (plusieurs siècles pour certains) et nous renvoient à une interrogation sur nous-mêmes à travers la quête du sens et de nos origines, à une époque pas si lointaine pour certains et encore vivante (mais pour combien de temps encore…) pour d’autres où l’homme se pensait en harmonie avec le cosmos et la nature et ne souhaitait pas encore lui imposer son dictat en «désémerveillant» le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
