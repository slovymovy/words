                        "translation_id": "36b1ccd5-fc34-41ac-abdc-6df5ed411295",
                        "source_entry_id": "6699b08e-7104-3c11-9b26-893d18af711a",
                        "source_sense_description": "to infer by extending known information",
                        "target_lang_word": "extrapoler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
