                        "sense_id": "bf465bf1-421e-3da5-8154-73aac388726d",
                        "entry_id": "53823913-cfa8-3ff2-9fc7-66d94e795722",
                        "glosses": [
                            "zdolność przeżywania emocji i odczuwania wrażeń; bycie wyczulonym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2110b6-4c84-4ba5-8e65-89f48f274c2e",
                                "sense_id": "bf465bf1-421e-3da5-8154-73aac388726d",
                                "text": "Dzięki kredytom, które za chwilę wygra, spłaci co bardziej naglące długi, zapłaci pierw­szą tran­szę za statek, znów będzie w ruchu i prze­kona się, jakie to cuda ma do zaofe­ro­wa­nia galaktyka oso­bie o jego wyjątkowych zdol­no­ściach i wraż­li­wo­ści"
                            }
