                "senses": [
                    {
                        "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                        "entry_id": "6d2b4b86-9d45-316c-941a-3f9680e1d23c",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8669644e-3e86-47fd-86c9-821106c0348e",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Frau Napier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c845b1fa-3f4d-4b13-b376-965e2bde8d6e",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Herr Napier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3481dae0-8d35-47c3-9bc8-5ed55e09d24c",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Die Napiers fliegen heute nach Neapel."
                            },
                            {
                                "example_id": "4082b816-3807-4b71-b400-49447a2fd806",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Der Napier trägt nie die Pullover, die die Napier ihm strickt."
                            },
                            {
                                "example_id": "48326d5a-862e-4198-9296-7a8e4ad96e00",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Napier kommt, geht der Herr Napier.“"
                            },
                            {
                                "example_id": "678ca5cc-0191-4d94-9273-8087eb0d8ce5",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Napier kommt und geht."
                            },
                            {
                                "example_id": "d1849c69-1c1c-4462-86d3-8336e6cd238c",
                                "sense_id": "5e77f5c8-8666-346b-afb2-cff312414d6e",
                                "text": "Napiers kamen, sahen und siegten."
                            }
                        ],
