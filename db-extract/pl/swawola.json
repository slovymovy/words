                "translations": [
                    {
                        "translation_id": "27f5bf34-2f98-4c69-97cc-581bcc3d525c",
                        "source_entry_id": "c1c5f3b4-9cb6-35c7-84d7-08518ba64871",
                        "source_sense_id": "09dab161-81ff-3a23-ab54-f1460e62de28",
                        "target_lang_word": "frolic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                        "entry_id": "62334816-53ca-3ae8-845c-584e27e24b29",
                                        "glosses": [
                                            "Merry, joyous, full of mirth; later especially, frolicsome, sportive, full of playful mischief."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b45a1966-96f4-452f-a3f7-297a67722692",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "The frolick wind that breathes the Spring,\nZephyr with Aurora playing,\nAs he met her once a Maying\nThere on Beds of Violets blew,"
                                            },
                                            {
                                                "example_id": "31791c87-8351-407d-8eeb-a2c33f2663a8",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "For women, born to be controul’d,\nStoop to the forward and the bold,\nAffect the haughty and the proud,\nThe gay, the frollick, and the loud."
                                            },
                                            {
                                                "example_id": "a9f49b89-8815-433f-bbb0-e0786ad3f18d",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "You meet him at the tables and conversations of the wise, the impertinent, the grave, the frolic, and the witty; [...]"
                                            },
                                            {
                                                "example_id": "711aeb69-0f97-4c81-aeba-b757126027e9",
                                                "sense_id": "0be8ab81-7681-3b15-855d-44a370e50c99",
                                                "text": "Beale, under this frolic menace, took nothing back at all; he was indeed apparently on the point of repeating his extravagence, but Miss Overmore instructed her little charge that she was not to listen to his bad jokes [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b77bf2-767d-3c03-9eb0-b7623e4b0ed4",
                                        "entry_id": "62334816-53ca-3ae8-845c-584e27e24b29",
                                        "glosses": [
                                            "Free; liberal; bountiful; generous."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                        "entry_id": "6a8d4356-4ba3-3be7-b23c-8ede9e822d25",
                                        "glosses": [
                                            "To make merry; to have fun; to romp; to behave playfully and uninhibitedly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43e717e-36bf-4bbe-97b7-7396cf8627ce",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "We saw the lambs frolicking in the meadow."
                                            },
                                            {
                                                "example_id": "78b2d9fc-11b2-4860-8e65-8e0a324adae5",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "Fools on parade frolic and fuck about to make her gaze\nTurn to a scribble on a page by a picture that holds her absence\nBut you're daft to think she'd care"
                                            },
                                            {
                                                "example_id": "c1e56481-7cef-429c-ae03-b69347a1d10e",
                                                "sense_id": "503b9ad0-8329-3bc7-8bc4-ebe7625f7e6b",
                                                "text": "“So, so beautiful. I'm gonna do one last roly-poly before we go. [snorting, squealing] At least I had one moment of joy in a life of drudgery. Where will the truffle hunt take us next?” “Nowhere. You're free, Jamebone. I'm releasing you from nose jail.” “Really? I can stay here in this paradise and prance and frolic?” “Just stick to frolicking.” “[emotional] Thank you, Mr. Bender. You're the kindest person I've ever met.” “Really? [crying] That's horrible.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e9477a5-46ad-3158-bdf6-94e3646237c8",
                                        "entry_id": "6a8d4356-4ba3-3be7-b23c-8ede9e822d25",
                                        "glosses": [
                                            "To cause to be merry."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frolic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "Gaiety; merriment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644afcd2-246b-486e-97c7-7049ed0f64d3",
                                                "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                                "text": "the annual jubilee […] filled the souls of old and young with visions of splendour, frolic and fun."
                                            },
                                            {
                                                "example_id": "a1753113-755f-4bd3-88c3-653ab0128227",
                                                "sense_id": "8af6d0dd-dc38-3841-9bec-9fac05033154",
                                                "text": "By the old-fashioned magnificence of this procession, it might worthily have included his Holiness in person, with a suite of attendant Cardinals, if those sacred dignitaries would kindly have lent their aid to heighten the frolic of the Carnival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f74e9e7-5e6a-3327-b110-7e905b0d59ce",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "A playful antic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17bc6d97-9093-4a46-9fd8-305c88c53bcb",
                                                "sense_id": "4f74e9e7-5e6a-3327-b110-7e905b0d59ce",
                                                "text": "He would be at his frolic once again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f9d7ca-abc6-3273-afdf-a20c4ed0b547",
                                        "entry_id": "49bcb1dd-d35e-3a33-b553-b2d02124d8f0",
                                        "glosses": [
                                            "A social gathering."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b903f1-7c1b-4a63-9f3e-894f44987ae7",
                                                "sense_id": "64f9d7ca-abc6-3273-afdf-a20c4ed0b547",
                                                "text": "He came clattering up to the school door with an invitation to Ichabod to attend a merry-making or “quilting frolic,” to be held that evening at Mynheer Van Tassel’s"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e001b42-56d9-4adc-a8ba-f378b4e91b21",
                        "source_entry_id": "c1c5f3b4-9cb6-35c7-84d7-08518ba64871",
                        "source_sense_id": "09dab161-81ff-3a23-ab54-f1460e62de28",
                        "target_lang_word": "Ausgelassenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgelassenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                        "entry_id": "cea9ac67-3bbd-3771-9ac8-6088e0df078d",
                                        "glosses": [
                                            "unbekümmerte Fröhlichkeit"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049e83f6-7cf8-4891-9f76-453f72456e20",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "In großer Ausgelassenheit feierten sie das Ende der Prüfungen."
                                            },
                                            {
                                                "example_id": "92e21852-a926-404b-b328-f8115b7d045d",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "„Es leuchtete in einer solchen Heiterkeit und Jugendfrische, einer so unschuldsvollen Jugendfrische, dass es an die kindliche Ausgelassenheit eines vierzehnjährigen Knaben erinnerte, und war doch das Anlitz des erhabenen Kaisers.“"
                                            },
                                            {
                                                "example_id": "3d8db2cb-8ddb-4806-bb29-04ef3cc1eadd",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "„P. C. sparte in seiner Ausgelassenheit nicht mit abgeschmackten Witzen, über die nur seine Dame lachte; meine schlechte Laune machte mich ernst, und C. C., die nichts davon begriff, blieb still.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ba53dff-ff7e-4c87-8daf-0d164c3201a3",
                        "source_entry_id": "c1c5f3b4-9cb6-35c7-84d7-08518ba64871",
                        "source_sense_id": "09dab161-81ff-3a23-ab54-f1460e62de28",
                        "target_lang_word": "Unfug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                        "entry_id": "c8c2c686-0329-3073-a32c-3a56648c51b3",
                                        "glosses": [
                                            "unsinniger oder ungehöriger Zustand; unsinnige oder ungehörige Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c5bbcc-5011-427c-b59c-a7418682a95d",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Es ist ein Unfug, die Kinder zu erziehen, will sagen, ihnen zu befehlen, dafür aber den Erwachsenen zu gehorchen. Es ist schon deshalb ein Unfug, weil die Kindheit Stil hat und eine freimütige Vornehmheit, die man wohl zerstören, aber durch nichts ersetzen kann."
                                            },
                                            {
                                                "example_id": "fe620db1-9f39-49ce-a703-80d6c696168a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Daniels Sohn hat sich mit ihm auch angefreundet, die beiden pokulieren und würfeln zusammen und treiben viel Unfug."
                                            },
                                            {
                                                "example_id": "a15e443c-5455-418b-97f9-9f7b7e934e4c",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Der Unfug mußte amtlich mit aller Strenge unterdrückt werden, denn man konnte darin ebensogut eine Verhöhnung der ehrsamen Schneiderzunft als des städtischen Polizeiwesens erblicken."
                                            },
                                            {
                                                "example_id": "247b0906-7bc3-4543-b8cc-eb420765590a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "„Allerdings ist die Liste dessen, was man einst als unvermeidlich angesehen, später aber als Unfug erkannt hat, länger als unsere DNA.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71607378-c361-462e-87a0-63360841777a",
                        "source_entry_id": "c1c5f3b4-9cb6-35c7-84d7-08518ba64871",
                        "source_sense_id": "09dab161-81ff-3a23-ab54-f1460e62de28",
                        "target_lang_word": "zurlo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f872d5e8-0149-43d4-a2bf-4bbfddb67365",
                        "source_entry_id": "c1c5f3b4-9cb6-35c7-84d7-08518ba64871",
                        "source_sense_id": "1bf741ee-b312-3966-bcd2-eae3bfc75e01",
                        "target_lang_word": "Willkür",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willkür",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Verhaltensweise nach ausschließlich eigenen Wünschen und Interessen ohne Rücksicht auf andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c890e6-e0d8-41b6-9eac-2c110da6dfb6",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "Dieses Gerichtsurteil ist reine Willkür."
                                            },
                                            {
                                                "example_id": "75a28298-a864-488f-9265-406eac233b3c",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "„Staatliche Willkür riss vor 200 Jahren diese Einheit auseinander.“"
                                            },
                                            {
                                                "example_id": "51db3324-bb84-4eab-b828-d5766260bb0f",
                                                "sense_id": "fb974259-42d8-35b0-a7a9-55e5e0f9b03f",
                                                "text": "„Auch später war das 13. Jahrhundert von den Auseinandersetzungen zwischen dem Koblenzer Bürgertum und der erzbischöflichen Willkür geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Unbegründetheit einer Festlegung; Freiheit bei der Wahl"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft",
                                            "auch allgemein bei Entscheidungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff67cff3-6f59-4797-9886-fcba7abbdf2f",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "Die Stromrichtung wurde aus Willkür festgelegt, denn die Bewegung der Ladungsträger war damals noch nicht bekannt."
                                            },
                                            {
                                                "example_id": "a1c9f1d2-98eb-46fd-8ecd-c86a1ee59c11",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "„Sie allein ist unendlich, wie sie allein frei ist und das als ihr erstes Gesetz anerkennt, daß die Willkür des Dichters kein Gesetz über sich leide.“"
                                            },
                                            {
                                                "example_id": "703ed490-5b4b-4960-b77b-fa83b82e6d88",
                                                "sense_id": "278e2968-61e0-308d-80ee-cbb97584dfed",
                                                "text": "„»Eine jede Handlung ist recht, die oder nach deren Maxime die Freiheit der Willkür eines jeden mit jedermanns Freiheit nach einem allgemeinen Gesetze zusammen bestehen kann«.“ (Kant)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24798655-156a-35c8-8ad3-1e96e7f8b7ff",
                                        "entry_id": "66580879-8b01-3ff8-b6ec-23da58e36eae",
                                        "glosses": [
                                            "Fähigkeit, Bewegungen oder Körperfunktionen bewusst herbeizuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a878910e-ab03-4fcf-ab2a-87bfe0741888",
                                                "sense_id": "24798655-156a-35c8-8ad3-1e96e7f8b7ff",
                                                "text": "Yogis sollen durch Willkür ihre Körpertemperatur beeinflussen können."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
