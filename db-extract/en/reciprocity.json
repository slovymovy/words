                                                "sense_id": "ede71f5b-d3b1-3886-b2b1-f76688d38ae1",
                                                "text": "„Die Sanktion für Dienste an anderen ist in Japan selbstverständlich Reziprozität […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86c5e5d2-bccf-3264-a4f8-6fd0aeb37a9d",
                                        "entry_id": "171a152f-1ae9-3e39-abb0-ff872808bc21",
                                        "glosses": [
                                            "gegenseitiger Austausch von Gütern oder Leistungen als Teil langfristiger Beziehungen"
                                        ],
                                        "tags": [
                                            "wirtschaftsethnologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c762f0ac-793b-40d0-8b88-6eb6e0af8adc",
                                                "sense_id": "86c5e5d2-bccf-3264-a4f8-6fd0aeb37a9d",
                                                "text": "„In nicht-kapitalistischen Gesellschaften überschneiden sich die Konzepte von Formalismus und Substantivismus nicht, da diese nicht auf den Markt, sondern auf Redistribution und Reziprozität ausgerichtet sind.“"
                                            }
                                        ],
