                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The perfumer dissolved the jasmine <w>concrete</w> in alcohol to create a pure scent.",
                            "target_lang_translations": {
                                "ru": "Парфюмер растворил жасминовый <w>конкрет</w> в спирте, чтобы создать чистый аромат.",
                                "zh": "调香师将茉莉<w>浸膏</w>溶解在酒精中，以调制出纯净的香气。"
                            }
                        },
                        {
                            "text": "This expensive <w>concrete</w> captures the true and heavy aroma of the flower.",
                            "target_lang_translations": {
                                "ru": "Этот дорогой <w>конкрет</w> передает истинный и тяжелый аромат цветка.",
                                "zh": "这种昂贵的<w>浸膏</w>捕捉到了花朵真实而浓郁的香气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jasmine concrete",
                        "rose concrete"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полутвердый воскообразный экстракт, полученный из растений, используемый в процессе изготовления духов.",
                        "zh": "从植物中提取的半固体蜡状提取物，用于香水制造过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкре́т",
                                "target_lang_sense_clarification": "парфюмерный экстракт"
