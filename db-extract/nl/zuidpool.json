                ],
                "senses": [
                    {
                        "sense_id": "4e2c1eed-c043-3917-97ab-6055c1e4459c",
                        "entry_id": "111fda4a-0940-34de-a1db-49165079857c",
                        "glosses": [
                            "het met ijs bedekte landplateau rond 90 graden zuiderbreedte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccf5e54-f5fe-43c2-ac3d-78ab653b63f6",
                                "sense_id": "4e2c1eed-c043-3917-97ab-6055c1e4459c",
                                "text": "Het hoogste punt van de Zuidpool ligt op ruim 5000 meter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b7431e1-dbf5-4f89-85d6-964aeaca38eb",
                        "source_entry_id": "111fda4a-0940-34de-a1db-49165079857c",
                        "source_sense_id": "4e2c1eed-c043-3917-97ab-6055c1e4459c",
                        "source_sense_description": "Noordpool",
                        "target_lang_word": "Südpol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südpol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "705cab39-3a24-37c4-8892-72ad89ae2152",
                                        "entry_id": "edc784c3-cdaa-31eb-875f-3169e9f3835b",
                                        "glosses": [
                                            "Punkt der Erde, der am weitesten im Süden liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af147252-1247-407f-82a6-1b562a00c410",
                                                "sense_id": "705cab39-3a24-37c4-8892-72ad89ae2152",
                                                "text": "„Der Nordpol ist kein Festland, ist nicht mit dem Nordkap zu verwechseln und, anders als der Südpol, nicht von Bergen umgeben.“"
                                            },
                                            {
                                                "example_id": "5bd8a0f9-18b3-4939-9eca-9a9d2d30458d",
                                                "sense_id": "705cab39-3a24-37c4-8892-72ad89ae2152",
                                                "text": "„Sein Südpol ist weit stärker mit Festland bedeckt als der Nordpol, der nur aus einem kleinen Landkäppchen besteht.“"
                                            },
                                            {
                                                "example_id": "4f9fdf16-59e6-4b58-a1d1-2cf587e5b8ad",
                                                "sense_id": "705cab39-3a24-37c4-8892-72ad89ae2152",
                                                "text": "„Das Indische Meer, τὸ Ινδικὸν πέλαγος, Oceanus Indicus, […] umsäumt das westliche Aufrica wie das südliche Asien, gränzet in Süden an das Eismeer des Südpoles, in Osten an den großen Ocean, in Westen (unter der Südspitze von Africa) an das Atlantische Meer.“ (1835)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ede14d04-e77e-32e8-ad52-de5a0c24dc3b",
                                        "entry_id": "edc784c3-cdaa-31eb-875f-3169e9f3835b",
                                        "glosses": [
                                            "Punkt eines Magneten, an dem die Feldlinien nach gängiger Definition austreten"
                                        ],
                                        "tags": [
                                            "Magnetismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07246307-220c-4425-bd17-995cd2a06229",
                                                "sense_id": "ede14d04-e77e-32e8-ad52-de5a0c24dc3b",
                                                "text": "„Abbildung 27.2: Wenn man einen Magneten in der Mitte teilt, erhält man keine separaten Nord- und Südpole; stattdessen entstehen zwei neue Magnete, von denen jeder einen eigenen Nord- und Südpol zeigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a450a364-3b79-42e4-a060-66f171e5186b",
