                        "sense_id": "b6996a1d-c1c0-36e7-a2cf-3673125c1564",
                        "entry_id": "0a513772-5f90-384a-8102-fd10849c4e8b",
                        "glosses": [
                            "To smell out; sniff about, around, or all over; investigate or check by smelling; detect a smell or a scent."
                        ],
                        "tags": [
                            "emphatic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d39463fe-858f-4613-ba85-c8a5b29b7665",
                                "sense_id": "b6996a1d-c1c0-36e7-a2cf-3673125c1564",
                                "text": "I'll tell you News, Sirs, I carry a little Muist-box (which is the Word of GOD) in my Bosom, and when I meet with the ill Air of ill company, that's like to gar me Swarf, I besmell my self with the 'sweet lavour of it, and with the Name ..."
                            },
                            {
                                "example_id": "87a68e36-537f-4f06-a219-66b19ce75b7a",
                                "sense_id": "b6996a1d-c1c0-36e7-a2cf-3673125c1564",
                                "text": "Juan positioned himself by the side of the building, peeked through an open window, and found the feast a sight to behold, and a scent to besmell."
                            }
                        ]
                    }
