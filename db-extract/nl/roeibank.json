                "senses": [
                    {
                        "sense_id": "d0c3e0e7-4b5f-3bef-8751-abc652dd1f2c",
                        "entry_id": "c1c3d08e-f0eb-3e29-9207-23858b086f66",
                        "glosses": [
                            "dwarsscheepse houten plank waarop een of twee roeiers zitten tijdens het roeien van een roeiboot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59d9f1e-7d73-44ab-a2bc-1e3d828c508a",
                                "sense_id": "d0c3e0e7-4b5f-3bef-8751-abc652dd1f2c",
                                "text": "Het 23 meter lange schip ligt op zijn kant en is compleet met mast, roeibanken en roeren. De binnenkant van het schip is met slib bedekt, waardoor onduidelijk is of het lading vervoerde."
                            },
                            {
                                "example_id": "b29f4619-61e7-4662-8df4-8080cb026669",
                                "sense_id": "d0c3e0e7-4b5f-3bef-8751-abc652dd1f2c",
                                "text": "Op de roeibank gebeurt het meest. De fysieke inspanning schakelt mijn alledaagse gedachten uit en zorgt ervoor dat essentiële ideeën concreter worden. De roeibank is een onmisbaar apparaat voor mijn schrijven.” HP de Tijd 25/12"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "953b091b-5b54-4be2-944b-291834ddac3c",
                        "source_entry_id": "c1c3d08e-f0eb-3e29-9207-23858b086f66",
                        "source_sense_id": "d0c3e0e7-4b5f-3bef-8751-abc652dd1f2c",
                        "source_sense_description": "dwarsscheepse houten plank waarop een of twee roeiers zitten tijdens het roeien van een roeiboot",
                        "target_lang_word": "thwart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thwart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "482e6de5-477d-34cb-96eb-849cb39c642c",
                                        "entry_id": "6aa47916-5801-3701-b7a4-9b617662a4ff",
                                        "glosses": [
                                            "Placed or situated across something else; cross, oblique, transverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20718b34-e32e-412a-abf6-946e3ec24598",
                                                "sense_id": "482e6de5-477d-34cb-96eb-849cb39c642c",
                                                "text": "Which elſe to ſeveral Sphears thou muſt aſcribe,\n Mov'd contrarie with thwart obliquities,\n Or ſave the Sun his labour, and that ſwift\n Nocturnal and Diurnal rhomb ſuppos'd,\n Inviſible elſe above all Starrs, the Wheele\n Of Day and Night; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d85111e-eb5e-350e-853b-49e29ac62c24",
                                        "entry_id": "6aa47916-5801-3701-b7a4-9b617662a4ff",
                                        "glosses": [
                                            "Of people: having a tendency to oppose; obstinate, perverse, stubborn."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0723239b-b487-4c3c-9910-35585caa85df",
                                                "sense_id": "2d85111e-eb5e-350e-853b-49e29ac62c24",
                                                "text": "[…] harke Nature, heare deere Goddeſſe, ſuſpend thy purpoſe, if thou did'ſt intend to make this creature fruitful into her wombe, conuey ſterility, drie vp in hir the organs of increaſe, and from her derogate body neuer ſpring a babe to honour her, if ſhee muſt teeme, create her childe of ſpleene, that it may liue and bee a thourt diſuetur'd^([sic – meaning disnatured]) torment to her, […]"
                                            },
                                            {
                                                "example_id": "8bf4525f-6c26-4008-9310-156cb936df98",
                                                "sense_id": "2d85111e-eb5e-350e-853b-49e29ac62c24",
                                                "text": "[…] and it is without all controuerſie, that learning doth make the minds of men gentle, generous, maniable, and pliant to gouernment; whereas Ignorance makes them churliſh, thwart, and mutinous; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f8635b7-b262-3bc8-8c21-ff0663148edd",
                                        "entry_id": "6aa47916-5801-3701-b7a4-9b617662a4ff",
                                        "glosses": [
                                            "Of situations or things: adverse, unfavourable, unlucky."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "thwart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55fc0c1c-39b0-303f-abc4-1e8665513dd4",
                                        "entry_id": "50db8f26-e70b-3c60-af08-45af4fc29f91",
                                        "glosses": [
                                            "Across the direction of travel or length of; athwart, crosswise, obliquely, transversely."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683ac91d-edea-412d-89f4-339800691104",
                                                "sense_id": "55fc0c1c-39b0-303f-abc4-1e8665513dd4",
                                                "text": "With adverſe blaſt up-turns them from the South\n Notus and Afer black with thundrous Clouds\n From Serraliona; thwart of theſe as fierce\n Forth ruſh the Levant and the Ponent VVindes\n Eurus and Zephir with their lateral noiſe,\n Sirocco, and Libecchio."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thwart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f4184a-5e73-3ec3-a4a4-431bd28abe42",
                                        "entry_id": "8105be8a-af33-3e07-a27e-fd43473e3656",
                                        "glosses": [
                                            "Across, athwart."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "thwart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                        "entry_id": "ace3b493-02f2-3838-a0d4-90a4dcbd11a8",
                                        "glosses": [
                                            "To cause to fail; to frustrate, to prevent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12d242d-66f3-4b8c-aad6-b261d5e6a4e4",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "Our plans for a picnic were thwarted by the thunderstorm."
                                            },
                                            {
                                                "example_id": "f10f0a2b-050a-4ef3-981a-48298746b007",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "The police thwarted the would-be assassin."
                                            },
                                            {
                                                "example_id": "c987e102-d1f0-4e86-8159-f1a651918a30",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "If thou grieueſt that beeing the daughter of a Prince, and enuie thwarteth thée with ſuch hard exigents, thinke that royaltie is a faire marke; that Crownes haue croſſes when mirth is in Cottages; that the fairer the Roſe is, the ſooner it is bitten with Catterpillers; […]"
                                            },
                                            {
                                                "example_id": "b6c5afbc-3a46-4e52-830a-3e02117a7c52",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "The Underſtanding and Will never diſagreed; for the Propoſals of the one never thwarted the Inclinations of the other."
                                            },
                                            {
                                                "example_id": "f6482070-0ae2-413e-b13a-b7282d94c544",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "Hear ye the serf I bred, begin to reckon\n Upon his rights and pleasure! Who am I—\n Thou abject, who am I, whose will thou thwartest?"
                                            },
                                            {
                                                "example_id": "c75892e9-3d2d-464f-b2cf-478ab0d0aa43",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "Not unnaturally, \"Auntie\" took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head. Then, thwarted, the wretched creature went to the police for help; she was versed in the law, and perhaps had spared no pains to keep on good terms with the local constabulary."
                                            },
                                            {
                                                "example_id": "63155f8e-54aa-44bc-b7f0-92e537435a05",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "The film ends with the colorful deaths of Nico's enemies after he thwarts their attempts to assassinate a U.S. Senator investigating ties between drug dealers and the CIA."
                                            },
                                            {
                                                "example_id": "fbef85b1-b5e1-4302-8f95-cedc43f06a5e",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "More than a mere source of Promethean sustenance to thwart the cold and cook one's meat, wood was quite simply mankind's first industrial and manufacturing fuel."
                                            },
                                            {
                                                "example_id": "23cec283-7f21-4393-bbfe-aef950cdf127",
                                                "sense_id": "099fd0a0-5025-38df-84f1-da2b2449841e",
                                                "text": "Everton were now firmly on the back foot and it required some sharp work from Johnny Heitinga and Phil Jagielka to thwart [Theo] Walcott and Thomas Vermaelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad33ebb-c088-3859-b147-7e60d283e70e",
                                        "entry_id": "ace3b493-02f2-3838-a0d4-90a4dcbd11a8",
                                        "glosses": [
                                            "To place (something) across (another thing); to position crosswise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fecc24e3-66e5-39df-954e-36d8a16d7d29",
                                        "entry_id": "ace3b493-02f2-3838-a0d4-90a4dcbd11a8",
                                        "glosses": [
                                            "To hinder or obstruct by placing (something) in the way of; to block, to impede, to oppose."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dd7f672-c3dc-3d84-b41f-a412ee2d777b",
                                        "entry_id": "ace3b493-02f2-3838-a0d4-90a4dcbd11a8",
                                        "glosses": [
                                            "To move (something) across or counter to; to cross."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb85831-1f1a-4395-8f89-be38556ce8aa",
                                                "sense_id": "5dd7f672-c3dc-3d84-b41f-a412ee2d777b",
                                                "text": "An arrow thwarts the air."
                                            },
                                            {
                                                "example_id": "1a09f6fb-493b-4d22-a69c-b1ea6e90d435",
                                                "sense_id": "5dd7f672-c3dc-3d84-b41f-a412ee2d777b",
                                                "text": "Thither came Uriel, gliding through the Eeven\n On a Sun beam, ſwift as a ſhooting Starr\n In Autumn thwarts the night, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thwart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e38e2eb-4586-3e7c-94c4-ec3c89e105b0",
                                        "entry_id": "a28ee5a3-6959-347f-9aec-df1c61093972",
                                        "glosses": [
                                            "A seat across a boat on which a rower may sit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1936e6b-c4f5-4260-bc21-0ecbb6591e00",
                                                "sense_id": "4e38e2eb-4586-3e7c-94c4-ec3c89e105b0",
                                                "text": "The fisherman sat on the aft thwart to row."
                                            },
                                            {
                                                "example_id": "aeee8dc8-9296-43e1-98e7-0905c37ca0d3",
                                                "sense_id": "4e38e2eb-4586-3e7c-94c4-ec3c89e105b0",
                                                "text": "When taking his seat in a boat, the learner should first observe that the thwart is firmly fixed, and that the mat upon it is securely tied to that part of it which is farthest from his rowlock."
                                            },
                                            {
                                                "example_id": "1cf10345-30fe-41c5-b609-9b18fd75bbb9",
                                                "sense_id": "4e38e2eb-4586-3e7c-94c4-ec3c89e105b0",
                                                "text": "Jane Porter had been the first of those in the lifeboat to awaken the morning after the wreck of the Lady Alice. The other members of the party were asleep upon the thwarts or huddled in cramped positions in the bottom of the boat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd9749d-ba76-3961-ab14-adc48a4aa8ac",
                                        "entry_id": "a28ee5a3-6959-347f-9aec-df1c61093972",
                                        "glosses": [
                                            "A brace, perpendicular to the keel, that helps maintain the beam (“breadth”) of a marine vessel against external water pressure and that may serve to support the rail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b63c55-71cb-4457-a53d-e7791cea930b",
                                                "sense_id": "5fd9749d-ba76-3961-ab14-adc48a4aa8ac",
                                                "text": "A well-made dugout canoe rarely needs a thwart."
                                            },
                                            {
                                                "example_id": "7e90192f-caf4-4487-8a28-05ac8128c787",
                                                "sense_id": "5fd9749d-ba76-3961-ab14-adc48a4aa8ac",
                                                "text": "A conſiderable number of thwarts were laid from gunwale to gunwale, to which they were ſecurely laſhed on each ſide, as a ſtrengthening to the boat [a canoe]."
                                            },
                                            {
                                                "example_id": "d9729176-745c-4ec3-aa0a-ee9613efe0db",
                                                "sense_id": "5fd9749d-ba76-3961-ab14-adc48a4aa8ac",
                                                "text": "My barge was sixty feet in length, and not more than twelve in the widest part; by taking away one thwart beam near the stern, laying a floor two feet below the gunwale, and raising an arched roof about seven feet above the floor, a commodious room was formed, fourteen feet long, and ten wide, with a closet behind it; […]"
                                            },
                                            {
                                                "example_id": "05051711-8ad3-4981-a973-bcb5f67b954f",
                                                "sense_id": "5fd9749d-ba76-3961-ab14-adc48a4aa8ac",
                                                "text": "I looked down into the Old Town [a canoe]; there was no yoke, only a straight ash thwart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60d20223-9a6c-3f23-a2df-aec081ad8230",
                                        "entry_id": "a28ee5a3-6959-347f-9aec-df1c61093972",
                                        "glosses": [
                                            "An act of thwarting; something which thwarts; a hindrance, an obstacle."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
