                "senses": [
                    {
                        "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                        "entry_id": "5d01c9e3-1b7c-3aec-b5c3-af98461e0046",
                        "glosses": [
                            "gemäßigtes, nicht zu intensives Lauftempo"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "63b39582-66a5-440f-bc7d-da99c5c48398",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„In den letzten Jahren laufe ich in normalem, moderatem Joggingtempo.“"
                            },
                            {
                                "example_id": "b6b6d29c-136f-4675-ac0a-f3187fc2496d",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„Bei längeren Intervallen kannst du die Gehpause durch sehr lockeres Joggingtempo ersetzen.“"
                            },
                            {
                                "example_id": "62419c24-6d25-4a09-ba8f-325ecae3b7d7",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„An diesem Punkt angelangt, kannst Du deine Trainingszeit auf etwa 30 Minuten erhöhen und auch nach und nach auch Dein Joggingtempo steigern.“"
                            },
                            {
                                "example_id": "aa116795-6a93-4a36-8816-0f6eee8c8ba4",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„Am Neujahrstag 1990 liefen rund 25.000 Menschen im Herzen der wiedervereinten Stadt, heute waren es knapp 4.500, die das Neue Jahr auf der rund vier Kilometer langen Strecke im lockeren Joggingtempo sportlich begannen.“"
                            },
                            {
                                "example_id": "f6e906e7-d8d7-43d0-a630-6619f193f449",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„Ein gutes Joggingtempo ist anstrengend, aber es soll kein «Auskotzen» sein.“"
                            },
                            {
                                "example_id": "0a9aaa19-c296-45d1-8b0c-911e1e68a677",
                                "sense_id": "11e6be5c-55e0-3945-8607-24ecd04824fd",
                                "text": "„Frei von Stress und mit losgelösten Gedanken laufen ich nun die fünf Kilometer im entspannten Joggingtempo nach Hause…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
