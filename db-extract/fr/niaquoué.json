                        "examples": [
                            {
                                "example_id": "96de2b99-3eee-4a71-8050-51c9f464e3fc",
                                "sense_id": "370a7311-af35-343b-a8b2-db0575747895",
                                "text": "Pour un « niaquoué », S. M. l’Empereur Bao Dai n'est que l’exécutant des volontés françaises, l’exécuteur de nos plus basses œuvres."
                            },
                            {
                                "example_id": "21e2478c-bdde-43da-9625-f3f62d68796c",
                                "sense_id": "370a7311-af35-343b-a8b2-db0575747895",
                                "text": "Et, autour des ancêtres, en grands atours, le ly thuong et les notables, et les vieux et les vieilles, et tous les niaquoués et toutes les niaquouées et tous les bécons ont les mains jointes et se courbent, les yeux au sol, en nous désignant les deux places d'honneur à chaque bout."
                            }
                        ]
