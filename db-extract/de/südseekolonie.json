                "senses": [
                    {
                        "sense_id": "dbe8d765-b0a8-35d4-842a-aaec82d5eabb",
                        "entry_id": "f15046f1-3a69-3fd1-9f6d-f0abff2cafc6",
                        "glosses": [
                            "Kolonie in der Südsee/im Pazifik"
                        ],
                        "tags": [
                            "Geopolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "6ffa5440-5d58-4a82-8e51-f269c50003a9",
                                "sense_id": "dbe8d765-b0a8-35d4-842a-aaec82d5eabb",
                                "text": "„Diese Südseekolonien zu beherrschen erwies sich als sehr aufwendig: Riesige Wassermassen trennten die einzelnen Eilande, teilweise waren tage- und wochenlange Bootsfahrten nötig.“"
                            },
                            {
                                "example_id": "4e719717-84ed-47f2-8d1d-05f9a9857439",
                                "sense_id": "dbe8d765-b0a8-35d4-842a-aaec82d5eabb",
                                "text": "„Die deutschen Südseekolonien lagen sämtlich zwischen dem 14. südlichen und dem 9. nördlichen Breitengrad.“"
                            },
                            {
                                "example_id": "ab533643-c8d8-4c79-8e12-e6e6e325ab00",
                                "sense_id": "dbe8d765-b0a8-35d4-842a-aaec82d5eabb",
                                "text": "„Hahl sah Limbrock als idealen Missionar und Mann der Tat an, der die wirtschaftliche Entwicklung und die deutsche Sprache in der deutschen Südseekolonie maßgeblich förderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
