                "translations": [
                    {
                        "translation_id": "d494c29a-a627-4826-9d07-ad51833fffe9",
                        "source_entry_id": "5256ea7f-e63f-3b25-8a50-4ed104f45d1e",
                        "source_sense_description": "the act of exterminating",
                        "target_lang_word": "extermination",
