{
    "word_family": [
        "glimmering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b76040ed-03a0-3747-84a7-a8b33ca1b1c0",
                    "sense_definition": "A faint or remote possibility, especially of something positive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even in the darkest times, there was always a <w>glimmer</w> of hope that things would improve.",
                            "target_lang_translations": {
                                "ru": "Даже в самые темные времена всегда оставался <w>проблеск</w> надежды на то, что все наладится."
                            }
                        },
                        {
                            "text": "The doctor's words provided a tiny <w>glimmer</w> of optimism for the family.",
                            "target_lang_translations": {
                                "ru": "Слова врача подарили семье крошечную <w>искорку</w> оптимизма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glimmer of hope",
                        "glimmer of understanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабая или отдаленная возможность, особенно чего-то положительного; проблеск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "слабое проявление надежды, понимания"
                            },
                            {
                                "target_lang_word": "искорка",
                                "target_lang_sense_clarification": "переносное значение, слабое проявление чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de78210b-0c75-35d0-ae96-a1ef5b37eee3",
                    "sense_definition": "A faint, unsteady light or a dim glow.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see a faint <w>glimmer</w> of light through the dense trees.",
                            "target_lang_translations": {
                                "ru": "Сквозь густые деревья мы видели слабое <w>мерцание</w> света."
                            }
                        },
                        {
                            "text": "The pleasant <w>glimmer</w> of the fireflies illuminated the dark backyard.",
                            "target_lang_translations": {
                                "ru": "Приятное <w>мерцание</w> светлячков освещало темный задний двор."
                            }
                        }
                    ],
                    "synonyms": [
                        "shimmer",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "faint glimmer of light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, неровный свет или тусклое свечение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "слабый, колеблющийся свет"
                            },
                            {
                                "target_lang_word": "отблеск",
                                "target_lang_sense_clarification": "слабое отражение света"
                            },
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "внезапно появившийся луч света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51b08547-2458-3abc-a8c3-89ac3a61bd92",
                    "sense_definition": "The mineral mica.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mineral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist identified the shiny flecks in the rock as <w>glimmer</w>.",
                            "target_lang_translations": {
                                "ru": "Геолог определил блестящие крупинки в породе как <w>слюду</w>."
                            }
                        },
                        {
                            "text": "This soil contains high amounts of <w>glimmer</w> and other silicate minerals.",
                            "target_lang_translations": {
                                "ru": "Эта почва содержит большое количество <w>слюды</w> и других силикатных минералов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in translation or specific mineralogical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Минерал слюда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слюда",
                                "target_lang_sense_clarification": "минерал"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99ea8df2-e2ac-3a64-baa4-2ef7ff1e50ff",
                    "sense_definition": "To shine with a faint, unsteady light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant stars began to <w>glimmer</w> in the night sky.",
                            "target_lang_translations": {
                                "ru": "Далекие звезды начали <w>мерцать</w> в ночном небе."
                            }
                        },
                        {
                            "text": "A single candle continued to <w>glimmer</w> in the window of the old cabin.",
                            "target_lang_translations": {
                                "ru": "Одинокая свеча продолжала <w>мерцать</w> в окне старой хижины."
                            }
                        }
                    ],
                    "synonyms": [
                        "flicker",
                        "shimmer",
                        "twinkle",
                        "gleam"
                    ],
                    "common_phrases": [
                        "glimmer in the dark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светиться слабым, неровным светом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "светиться неровным, колеблющимся светом"
                            },
                            {
                                "target_lang_word": "брезжить",
                                "target_lang_sense_clarification": "слабо светиться, рассветать"
                            },
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "едва светиться в темноте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}