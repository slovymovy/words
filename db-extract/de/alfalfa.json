                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alfalfa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "520205b6-83b9-3a7f-ad50-92180bfe8da9",
                                        "entry_id": "bf14b260-3047-3574-be88-47d294f9846c",
                                        "glosses": [
                                            "A plant, principally of Medicago sativa, grown as a pasture crop."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bcdcbd-e101-4ec7-8880-6cf6e018de21",
                                                "sense_id": "520205b6-83b9-3a7f-ad50-92180bfe8da9",
                                                "text": "“No place for rabbits now, but I could easy build a few hutches and you could feed alfalfa to the rabbits.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a0af64-18a4-31c8-8b8a-c2284d84adbe",
                                        "entry_id": "bf14b260-3047-3574-be88-47d294f9846c",
                                        "glosses": [
                                            "A type or breed of this plant."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da67f05a-b660-4a9c-bf61-bd4a164ed7c1",
                        "source_entry_id": "5e5af4c0-37ad-32c1-a167-a6a728ac4d7f",
                        "source_sense_id": "c69405c7-4d39-32c6-8acb-9fc23807e4df",
                        "source_sense_description": "Handelsname für die Samen der Luzerne (Medicago sativa)",
                        "target_lang_word": "luzerne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luzerne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b4b489b-cf8d-34b5-9772-a341c83ce517",
                                        "entry_id": "68921fb8-f402-3988-b7a8-2411dce651b1",
                                        "glosses": [
                                            "Plante fourragère de la famille des Fabacées (ou Légumineuses) à feuilles en trèfle et à gousses en spirale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d5aa9b-7f96-446b-beb7-43f47853d1d9",
                                                "sense_id": "1b4b489b-cf8d-34b5-9772-a341c83ce517",
                                                "text": "Quand on fait la moisson du chanvre, il se passe quelquefois d’étranges phénomènes dans la personne des travailleurs mâles et femelles. […]. Du reste, il m’est arrivé, à moi, enfant, jouant et me roulant dans des amas de luzerne, des phénomènes analogues."
                                            },
                                            {
                                                "example_id": "915313bb-e00b-46c5-956a-b2b2025aa77e",
                                                "sense_id": "1b4b489b-cf8d-34b5-9772-a341c83ce517",
                                                "text": "En arrivant sur les bords du Danube, en face de la Lobau, je remarquai sur la rive, ou croît une herbe fine, des ondulations semblables aux grands sillons des champs à luzerne."
                                            },
                                            {
                                                "example_id": "bfbe24be-9193-4ea1-8369-a00ce4f6681c",
                                                "sense_id": "1b4b489b-cf8d-34b5-9772-a341c83ce517",
                                                "text": "Des engrais verts telles la vesce velue et la luzerne fixent l’azote de l’air grâce à une symbiose avec une bactérie qui infeste leurs racines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d814648-5319-30b9-b70b-3ce815423632",
                                        "entry_id": "68921fb8-f402-3988-b7a8-2411dce651b1",
                                        "glosses": [
                                            "Champ de luzerne, luzernière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8137fa6-c74c-4a31-9d27-62b9f1566ea0",
                                                "sense_id": "2d814648-5319-30b9-b70b-3ce815423632",
                                                "text": "Comme elle passait en ce moment devant une luzerne nouvellement fauchée, dont la moisson mise en petites meules, faisait des tas noirs sur la terre rase, elle franchit le fossé de la route, et se creusant un abri dans une de ces meules, elle s’y coucha enveloppée d’une douce chaleur parfumée de l’odeur du foin."
                                            }
                                        ]
                                    }
                                ]
                            },
