                "senses": [
                    {
                        "sense_id": "90d2a326-3b7b-3304-8070-fd1def19c204",
                        "entry_id": "92f30cef-b49f-33c2-bfb1-fbe71805c235",
                        "glosses": [
                            "Person, deren Füße für Werbezwecke abgebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9daff6d-980c-45e8-8a60-6efc620f1e0b",
                                "sense_id": "90d2a326-3b7b-3304-8070-fd1def19c204",
                                "text": "„Wenn Sie von Natur aus schöne Füße und keinerlei Fußfehlstellungen zu beklagen haben, ist Ihre Chance, als Fußmodel etwas dazuverdienen zu können, gar nicht mal so schlecht.“"
                            },
                            {
                                "example_id": "7709962b-9091-4737-b323-8bcc7ffffa9c",
                                "sense_id": "90d2a326-3b7b-3304-8070-fd1def19c204",
                                "text": "„Hickey, die nebenberuflich als Hand- und Fußmodel arbeitet, bekam den Zuschlag für Fotoaufnahmen zu einem neuen Buchcover.“"
                            },
                            {
                                "example_id": "7eed6649-bb64-4f4e-b664-56e5e73812a3",
                                "sense_id": "90d2a326-3b7b-3304-8070-fd1def19c204",
                                "text": "„Er hätte Fußmodel werden können.“"
                            },
                            {
                                "example_id": "0250d0d0-5569-43ae-8f9e-8594a044fef0",
                                "sense_id": "90d2a326-3b7b-3304-8070-fd1def19c204",
                                "text": "„Er gebärdet sich, als wäre er Fußmodel und seine Einnahmequelle mit einem fürchterlichen Unfall für immer zunichte gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
