                "senses": [
                    {
                        "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                        "entry_id": "1f3a0569-47ed-3311-a99c-8779d2e3cd65",
                        "glosses": [
                            "Versorgung eines Raumes/Systems mit Luft durch überhöhten Luftdruck"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "819ce577-b839-4521-aaaf-8eaba033d892",
                                "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                                "text": "„Die “Glaubensschulen” machen die Sache nicht einfacher, allen voran die Diskussion um Überdrucklüftung und Injektorbelüftung.“"
                            },
                            {
                                "example_id": "81a14f85-2993-4a9e-b59b-e24cbf479edc",
                                "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                                "text": "„Entwicklung einer Überdrucklüftung zur Rauchfreihaltung von Flucht- und Rettungswegen.“"
                            },
                            {
                                "example_id": "3abb9247-6122-470b-8c9d-9e784b425e78",
                                "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                                "text": "„Bei der Überdrucklüftung wird frische Luft mit Hilfe von Ventilatoren in den Stall geblasen und die Abluft durch den Überdruck im Stall hinausgedrückt.“"
                            },
                            {
                                "example_id": "e2503a24-c5ab-4771-802e-c897de7dbc88",
                                "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                                "text": "„Zur Wahl stehen eine lüfterlose Variante und eine Variante mit Überdrucklüftung.“"
                            },
                            {
                                "example_id": "3eb88926-7c3b-448b-9fc8-7309f80cb915",
                                "sense_id": "386ca15f-9628-3f82-8267-8cee212a3af8",
                                "text": "„Dort ist unter anderem eine Überdrucklüftung installiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
