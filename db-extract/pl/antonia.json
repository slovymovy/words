                        "examples": [
                            {
                                "example_id": "3b556224-3c2f-4d03-a1ef-2e1e3ad297db",
                                "sense_id": "130cf70d-a8b2-3166-8d89-38ed3fcd059c",
                                "text": "Kolejnym punktem na liście przygotowanej przez Antonię, rodowitą zagrzebiankę, była pijalnia czekolady"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c998a8a4-3e98-4de7-8086-619b7f9bc52e",
                        "source_entry_id": "676f35ff-0ee8-376c-8202-bf67886d4b9d",
                        "source_sense_id": "130cf70d-a8b2-3166-8d89-38ed3fcd059c",
                        "target_lang_word": "Antonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e59d80a9-45fd-3c9d-9cb3-fe0796a901d2",
                                        "entry_id": "b5494da5-7f05-31a9-ae10-b0b50d594883",
                                        "glosses": [
                                            "A female given name from Spanish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30db971-0f74-4c96-9793-2eb482ec7f8d",
                                                "sense_id": "e59d80a9-45fd-3c9d-9cb3-fe0796a901d2",
                                                "text": "Mom, I ask, will you call me Ant.\n\"Oh, Antonia,\" my mother sighs. Her face looks pained. She is quiet for a few moments and then she says, \"Antonia is such a lovely name. When I named you, you were the sweetest, most perfect little baby. - - - \""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b038435-7c84-4a56-9315-0c7173dcb8cc",
                        "source_entry_id": "676f35ff-0ee8-376c-8202-bf67886d4b9d",
                        "source_sense_id": "130cf70d-a8b2-3166-8d89-38ed3fcd059c",
                        "target_lang_word": "Antonia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antonia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d36a025-ce3a-3b12-b0e3-a6e25d5b5e7a",
                                        "entry_id": "2ff1c9c8-20a8-3432-a8ba-5fa9f0c1de83",
                                        "glosses": [
                                            "Prénom féminin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b450315d-026e-4dff-8b4c-bf7edd3b9538",
                                                "sense_id": "8d36a025-ce3a-3b12-b0e3-a6e25d5b5e7a",
                                                "text": "Il adopta donc le plan d’Antonia, qui voulait aborder la haute sphère de sa profession, avoir un magnifique appartement, femme de chambre, voiture, et lutter avec notre belle amphitryonne, par exemple…"
                                            },
                                            {
                                                "example_id": "22da308f-c5d0-4f24-baa7-a00ba1fa408f",
                                                "sense_id": "8d36a025-ce3a-3b12-b0e3-a6e25d5b5e7a",
                                                "text": "D’aussi loin qu’elle s’en souvienne, Antonia, dite Toni, a mené sa vie par et pour les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02d3439a-cd61-4405-b03c-86f794add050",
                        "source_entry_id": "676f35ff-0ee8-376c-8202-bf67886d4b9d",
                        "source_sense_id": "130cf70d-a8b2-3166-8d89-38ed3fcd059c",
                        "target_lang_word": "Antoinette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antoinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dad0de24-4c8c-355e-90f3-e1a5b5f62fca",
                                        "entry_id": "5b5e9c45-468a-3ecb-aac8-e195af49e703",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6e2489-d7dd-4620-9c63-ef2bace275fc",
                                                "sense_id": "dad0de24-4c8c-355e-90f3-e1a5b5f62fca",
                                                "text": "Il y avait une quantité de choses des colonies chez cette petite Antoinette : un perroquet, des oiseaux de toutes couleurs dans une volière, des collections de coquilles et d’insectes."
                                            },
                                            {
                                                "example_id": "1c9ffafa-7598-4ef5-bea4-4229f4e7249c",
                                                "sense_id": "dad0de24-4c8c-355e-90f3-e1a5b5f62fca",
                                                "text": "Les ressorts de la Citroën s'affaissèrent sous le poids d’Antoinette, et elle dut s'y prendre à trois fois avant de démarrer le moteur."
                                            },
                                            {
                                                "example_id": "c2b03726-2261-4e9d-b4ac-1371eccd97b2",
                                                "sense_id": "dad0de24-4c8c-355e-90f3-e1a5b5f62fca",
                                                "text": "Ce concert sera aussi l’occasion de marquer le cinquantenaire de la renaissance de l’orgue de l’église, en présence de l’organiste Antoinette Keraudren qui l’avait inauguré après sa restauration en 1971."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
