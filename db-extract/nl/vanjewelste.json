                "senses": [
                    {
                        "sense_id": "71406166-a5b8-34f1-a8c4-1c57a94e57e8",
                        "entry_id": "6c29df69-20a0-356d-8511-9f5a5dce3cef",
                        "glosses": [
                            "heel echt, heel groot, van formaat"
