                        "glosses": [
                            "Someone who makes speculative theories or deals in abstract ideas; a theorist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1d44a0-3de2-4ccd-808e-09bc9f98e9bf",
                                "sense_id": "9919230b-1c41-3f93-90c5-875d1a8a998d",
                                "text": "The very ingenious speculatist, Mr. Hume, seems to wish as well as think, that as death is unavoidable by the political as well as the animal body, the British constitution may die in the arms of despotism."
                            },
                            {
                                "example_id": "9b21f4b3-138a-4d8d-ab83-47f7ce600604",
                                "sense_id": "9919230b-1c41-3f93-90c5-875d1a8a998d",
                                "text": "The objections of these speculatists, if its forces do not quadrate with their theories, are as valid against such an old and beneficent government as against the most violent tyranny or the greenest usurpation."
                            }
                        ]
                    }
