                                "sense_id": "3a45bf7b-66bc-3a21-8bd4-8203922a2f41",
                                "text": "Seine Mutter wurde in Seattle geboren."
                            },
                            {
                                "example_id": "a17520b5-f50d-46aa-866a-865ffdbbcbc1",
                                "sense_id": "3a45bf7b-66bc-3a21-8bd4-8203922a2f41",
                                "text": "Letztes Jahr ist er aus Seattle nach Köln gezogen."
                            },
                            {
                                "example_id": "e53e9d38-af3e-4371-b748-ebb589b0d99c",
                                "sense_id": "3a45bf7b-66bc-3a21-8bd4-8203922a2f41",
                                "text": "„Soweit ich weiß, war er aus Seattle nach Italien gekommen, um dort Familienangehörige zu besuchen, und hatte sich freiwillig gemeldet, als Italien in den Krieg eintrat.“"
                            }
                        ],
