                    {
                        "sense_id": "98849c69-336f-305d-b95a-00eb643c0edc",
                        "entry_id": "3a7895a8-5fb1-3eb4-82c4-1a3c0c4b8578",
                        "glosses": [
                            "Zone naturelle d’intérêt écologique faunistique et floristique."
                        ],
                        "tags": [
                            "Administration",
                            "Urbanisme",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "0d07e7c2-04d5-4f9a-a85d-339f53830a93",
                                "sense_id": "98849c69-336f-305d-b95a-00eb643c0edc",
                                "text": "D’après les recommandations édictées au niveau national dans le cadre de la modernisation de l’inventaire ZNIEFF (Muséum National d’Histoire Naturelle, Institut Français de l’Environnement, Ministère de l’Environnement, 1996), la reconnaissance en ZNIEFF d’un secteur du territoire est argumentée uniquement par des critères patrimoniaux (habitats, flore et faune)."
                            },
                            {
                                "example_id": "cb5272c9-04b1-4506-a75c-7539ff26d5b0",
                                "sense_id": "98849c69-336f-305d-b95a-00eb643c0edc",
                                "text": "En plus de traverser une zone Natura 2000 et des Zones naturelles d’intérêt écologique, faunistique et floristique (ZNIEFF), le projet de l’A69 pourrait artificialiser 316 hectares de terres agricoles, de forêts et de zones humides."
                            }
                        ]
                    }
