    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d2c8592-a021-3bfa-b692-ae680d3b5a8b",
                    "sense_definition": "Detailed descriptions or requirements for how something is to be made, built, or done; plural of <w>spec</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "specifications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer reviewed the technical <w>specs</w> before starting the construction project.",
                            "target_lang_translations": {
                                "ru": "Инженер изучил технические <w>характеристики</w> перед началом строительного проекта."
                            }
                        },
                        {
                            "text": "You need to check the minimum <w>specs</w> to see if the software will run on your laptop.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно проверить минимальные <w>требования</w>, чтобы понять, пойдет ли программа на твоем ноутбуке."
                            }
                        }
                    ],
                    "synonyms": [
                        "specifications",
                        "requirements",
                        "parameters"
                    ],
                    "common_phrases": [
                        "technical specs",
                        "minimum specs",
                        "product specs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of specifications"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробное описание или требования к тому, как что-то должно быть сделано, построено или выполнено; сокращение от specifications."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "характеристики",
                                "target_lang_sense_clarification": "технические параметры устройства или системы"
                            },
                            {
                                "target_lang_word": "спецификации",
                                "target_lang_sense_clarification": "детальные технические требования"
                            },
                            {
                                "target_lang_word": "параметры",
                                "target_lang_sense_clarification": "показатели работы или состава"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ad68fa7-9b36-355d-a107-a7db8ecd5706",
                    "sense_definition": "A pair of glasses used to correct vision; abbreviation of <w>spectacles</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took off his <w>specs</w> and rubbed his tired eyes after reading for hours.",
                            "target_lang_translations": {
                                "ru": "Он снял <w>очки</w> и потер уставшие глаза после многочасового чтения."
                            }
                        },
                        {
                            "text": "I need a new pair of <w>specs</w> because my current ones are scratched.",
                            "target_lang_translations": {
                                "ru": "Мне нужна новая пара <w>очков</w>, потому что мои нынешние поцарапаны."
                            }
                        }
                    ],
                    "synonyms": [
                        "glasses",
                        "spectacles",
                        "eyeglasses"
                    ],
                    "common_phrases": [
                        "pair of specs",
                        "wear specs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal British and Australian usage"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "common in UK and Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пара очков для коррекции зрения; сокращение от spectacles."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очки",
                                "target_lang_sense_clarification": "прибор для коррекции зрения (разг.)"
                            },
                            {
                                "target_lang_word": "окуляры",
                                "target_lang_sense_clarification": "шутливое или сленговое обозначение очков"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c04495f6-02f1-35a4-a07d-8386c4ab1d7f",
                    "sense_definition": "Third-person singular simple present indicative of <w>spec</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect <w>specs</w> high-quality materials for all her luxury building designs.",
                            "target_lang_translations": {
                                "ru": "Архитектор <w>прописывает</w> высококачественные материалы для всех своих проектов элитных зданий."
                            }
                        },
                        {
                            "text": "He usually <w>specs</w> out the hardware requirements before the coding begins.",
                            "target_lang_translations": {
                                "ru": "Обычно он <w>детально описывает</w> требования к оборудованию до начала написания кода."
                            }
                        }
                    ],
                    "synonyms": [
                        "specifies"
                    ],
                    "common_phrases": [
                        "specs out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "jargon used in technical fields"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа глагола spec (указывать в спецификации)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прописывает",
                                "target_lang_sense_clarification": "указывает конкретные параметры в документации"
                            },
                            {
                                "target_lang_word": "задает",
