                                "target_senses": [
                                    {
                                        "sense_id": "1e51e837-7551-33f1-adc7-87fd6ea45e1c",
                                        "entry_id": "58a1fc77-1761-3689-8b4c-b324baef0f67",
                                        "glosses": [
                                            "Abkürzung für die Terrorgruppe „Islamischer Staat im Irak und Syrien“ bzw. „Islamischer Staat im Irak und in Syrien“ bzw. „Islamischer Staat im Irak und in (Groß-)Syrien“"
                                        ],
                                        "tags": [
                                            "Islamismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b952f566-81e4-420f-8946-420ee1353a0c",
                                                "sense_id": "1e51e837-7551-33f1-adc7-87fd6ea45e1c",
                                                "text": "„Es war das erste Mal, dass sich der ISIS, der sich in Syrien und im Irak ausgebreitet hat, zu einem Anschlag im sunnitisch dominierten Saudi-Arabien bekannt hat.“"
                                            },
                                            {
                                                "example_id": "59fc55ba-c99e-440f-a89c-f9961ef707c4",
                                                "sense_id": "1e51e837-7551-33f1-adc7-87fd6ea45e1c",
                                                "text": "Was will die ISIS? Was bedeuten die Begriffe Islamischer Staat, ISIS und ISIL?"
                                            }
