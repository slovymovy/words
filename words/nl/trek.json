                },
                {
                    "sense_id": "c1a0a865-1587-3e93-b50e-ae856c1a9c34",
                    "sense_definition": "Zin of lust om iets te doen of te hebben.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb totaal geen <w>trek</w> in een lange discussie vandaag.",
                            "target_lang_translations": {
                                "en": "I have absolutely no <w>desire</w> for a long discussion today.",
                                "ru": "У меня сегодня совсем нет <w>желания</w> вести долгую дискуссию.",
                                "de": "Ich habe heute überhaupt keine <w>Lust</w> auf eine lange Diskussion."
                            }
                        },
                        {
                            "text": "Zij had weinig <w>trek</w> om mee te gaan naar het drukke feest.",
                            "target_lang_translations": {
                                "en": "She had little <w>desire</w> to go along to the busy party.",
                                "ru": "У нее было мало <w>желания</w> идти на шумную вечеринку.",
                                "de": "Sie hatte wenig <w>Lust</w>, auf die überfüllte Party mitzugehen."
                            }
