                        "glosses": [
                            "Qui appartient au dauphin de Dauphiné, et, par suite, au dauphin fils aîné du roi de France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be1d44b-2f56-4bc0-988e-57c928ef26e8",
                                "sense_id": "7280c68e-5b82-3c65-8a88-4345bd064a1c",
                                "text": "Cette ordonnance veut que les secrétaires delphinaux ordinaires et extraordinaires soient tenus à une résidence (...)"
                            },
                            {
                                "example_id": "0712dda9-2711-45ff-9a7a-8bf7ab329c8b",
                                "sense_id": "7280c68e-5b82-3c65-8a88-4345bd064a1c",
                                "text": "« Heremi nullius sunt » : les hermes ne sont à personne, affirment les habitants de Saint-Martin-de-Queyrières, en Briançonnais, aux enquêteurs delphinaux. — (Fabrice Mouthon & Nicolas Carrier, Paysans des Alpes: Les communautés montagnardes au Moyen Âge, Presses universitaires de Rennes, 2010, p. 72)"
                            }
                        ]
                    }
