                {
                    "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                    "sense_definition": "A resolution of disputed points pursuant to discussion; a mutual clarification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This little <w>explanation</w> with Mr. Knightley gave Emma considerable pleasure.",
                            "target_lang_translations": {
                                "ru": "Это небольшое <w>объяснение</w> с мистером Найтли доставило Эмме огромное удовольствие.",
                                "zh": "这次与奈特利先生的小小<w>沟通</w>让艾玛感到非常愉快。"
                            }
                        },
                        {
                            "text": "After a frank <w>explanation</w>, the two friends resolved their differences.",
                            "target_lang_translations": {
                                "ru": "После откровенного <w>объяснения</w> друзья уладили свои разногласия.",
                                "zh": "经过一次坦诚的<w>沟通</w>，两位朋友化解了分歧。"
                            }
                        }
                    ],
