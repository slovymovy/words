                        "examples": [
                            {
                                "example_id": "f560321e-1ea7-4a9b-91f8-1a22d9b845c5",
                                "sense_id": "92814671-a7ce-3e47-bd04-52b1ea0f2718",
                                "text": "Dans sa dernière création musicale, inspirée par la poésie de Rumi et les écrits millénaires de Zarathoustra, Ariana Vafadari chante la figure d’Anahita, divinité iranienne des eaux, de la fécondité et de la sagesse."
                            }
                        ]
                    }
