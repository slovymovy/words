                                        "entry_id": "c863729e-373e-3443-a864-8406a8338724",
                                        "glosses": [
                                            "To reproduce (documents) on such film."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d850cbb3-5e2b-4039-bbfe-0528f454b4f4",
                                                "sense_id": "ddea0156-5363-3521-a614-ee1f6014f71e",
                                                "text": "Power set up a camera in the British Museum and eventually microfilmed many pre-1640 English books that he selected from Pollard and Redgrave’s Short-Title Catalogue (STC) and other important works in the museum’s collections."
                                            }
