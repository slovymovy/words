                    },
                    {
                        "form_id": "d0a1a0b0-6661-4838-9792-8585365b122b",
                        "entry_id": "f65cc065-356c-3cf2-9fe1-55b632778604",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "incarnadines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                        "entry_id": "f65cc065-356c-3cf2-9fe1-55b632778604",
                        "glosses": [
                            "Qui a la couleur de l’incarnadin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc37e0f-3bcc-4224-91bb-a687b0db6e31",
                                "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                                "text": "Ses cheveux incultes se tordaient autour de son front et de ses joues en longs serpents noirs, mal retenus par un ruban incarnadin que débordaient et cachaient çà et là les boucles rebelles."
                            },
                            {
                                "example_id": "89109435-7008-4d86-857c-0bc59865b2f1",
                                "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                                "text": "(…) Le nez mignon avec la bouche\nIncarnadine, grasse, et divine d’orgueil"
                            },
                            {
                                "example_id": "fb7c0856-7a59-4aab-a6fc-34cec314ca01",
                                "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                                "text": "Elle avait les cheveux de la nuit, mais sur le visage de l'Aurore, car son visage resplendissait de cette fraîcheur incarnadine éblouissante et rare, qui avait résisté à tout dans cette vie nocturne de Paris dont elle vivait depuis des années et qui brûle tant de roses à la flamme de ses candélabres."
                            },
                            {
                                "example_id": "a75e6bd9-df81-40f5-9196-5c648e765e00",
                                "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                                "text": "Sur le bord de la rivière, la lueur du jour incarnadin teinte en rose les larmes éparses, figées en neige candide, des amandiers pensifs."
                            },
                            {
                                "example_id": "19d35932-de4a-46d4-9def-02326e3101f5",
                                "sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                                "text": "Soudain, sous son képi cassé et ramené en arrière, ses trait se détendirent, sa figure devint subitement enfantine et ses yeux se fixèrent sur sa main mutilée où le sang fleurissait de roses incarnadines la gaze du pansement sommaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "439ee65d-1546-4cc3-9fc6-cf5a1ae3d2dd",
                        "source_entry_id": "f65cc065-356c-3cf2-9fe1-55b632778604",
                        "source_sense_id": "7c9080d8-7683-36fc-bd0a-3580167a6508",
                        "target_lang_word": "incarnadine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incarnadine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7a3b5c-40cd-3c14-9ea6-e253ee9f96d1",
                                        "entry_id": "26ea6139-fa12-3906-81ce-d304387446a0",
                                        "glosses": [
                                            "Of the pale pink or pale red colour of flesh; carnation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823d821c-521f-436e-971f-8c1c751c257d",
                                                "sense_id": "db7a3b5c-40cd-3c14-9ea6-e253ee9f96d1",
                                                "text": "Incarnadine, or Incarnate, that is of a bright Carnation or Fleſh Colour, or of the Colour of a Damask-Roſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0284d4fd-09ad-3f70-867d-d812f5b88199",
                                        "entry_id": "26ea6139-fa12-3906-81ce-d304387446a0",
                                        "glosses": [
                                            "Of the blood-red colour of raw flesh; crimson."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d85cfc4-9085-4f8c-a2a6-93d2ff4fdf02",
                                                "sense_id": "0284d4fd-09ad-3f70-867d-d812f5b88199",
                                                "text": "Wild and dishevelled, thy luxuriant hair / Falls scattered o'er thy throbbing bosom, fair / As snow incarnadine with morning's ray;— [...]"
                                            },
                                            {
                                                "example_id": "836a5872-3913-4af2-9294-815c71096cee",
                                                "sense_id": "0284d4fd-09ad-3f70-867d-d812f5b88199",
                                                "text": "The bandages on his hands – cerise and incarnadine, opalescent and viridian – were grotesqueries that only emphasised his stature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487c0373-2f03-3020-a946-f38bdc40f1c0",
                                        "entry_id": "26ea6139-fa12-3906-81ce-d304387446a0",
                                        "glosses": [
                                            "Bloodstained, bloody."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fee663-52c7-4693-af33-e8a886dfbd85",
                                                "sense_id": "487c0373-2f03-3020-a946-f38bdc40f1c0",
                                                "text": "His poem, however, is meetly enough entituled—Christ Crucified! But the Rev. William Ellis Wall is worse than [Pontius] Pilate. That \"wretch,\" as this miserable calls the Roman governor, was careful to wash his hands of all guilt in the transaction; but the Rev. William Ellis Wall holds forth triumphantly his two unhallowed and incarnadine maniples of reeking digits, boasting of the infamous achievement in a most egregious preface."
                                            },
                                            {
                                                "example_id": "54149294-c529-40b3-b06f-66acad666ac5",
                                                "sense_id": "487c0373-2f03-3020-a946-f38bdc40f1c0",
                                                "text": "\"Basically I am a very good person.\" This from the latest serial killer–destined for the chair, they say–who, with incarnadine axe, recently dispatched half a dozen registered nurses in Texas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c88ba77-8a53-3c65-b18d-49664a88f4f3",
                                        "entry_id": "26ea6139-fa12-3906-81ce-d304387446a0",
                                        "glosses": [
                                            "Of a red colour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a05d71-6572-45a6-9287-ab991db5049e",
                                                "sense_id": "7c88ba77-8a53-3c65-b18d-49664a88f4f3",
                                                "text": "Let the wine incarnadine, / In crystal goblets gleaming, / Be the sign, O muse divine, / Of golden moments teeming."
                                            },
                                            {
                                                "example_id": "fc5686e8-027f-441e-b664-822b7fb6beea",
                                                "sense_id": "7c88ba77-8a53-3c65-b18d-49664a88f4f3",
                                                "text": "Green orchards with ripe fruit incarnadine, / Each several member autumn-canopied / So thickly as to bend beneath its freight, [...]"
                                            },
                                            {
                                                "example_id": "690526d2-66f9-47ff-b98a-875945d7c58d",
                                                "sense_id": "7c88ba77-8a53-3c65-b18d-49664a88f4f3",
                                                "text": "The chaplain glanced at the bridge table that served as his desk and saw only the abominable orange-red, pear-shaped, plum tomato he had obtained that same morning from Colonel Cathcart, still lying on its side where he had forgotten it like an indestructible and incarnadine symbol of his own ineptitude."
                                            },
                                            {
                                                "example_id": "3b28fc8c-c9c2-40d8-a151-fcb4dac96d0c",
                                                "sense_id": "7c88ba77-8a53-3c65-b18d-49664a88f4f3",
                                                "text": "I'd like to call attention to one last element of this page. [Charlotte] Salomon's insignia, here incarnadine and enclosed in a circle, like a wax seal, elsewhere floating on the lower left hand side of the page."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incarnadine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bec9711-0096-3fdd-a936-1a9963d4fd06",
                                        "entry_id": "637b01b1-a6a6-3d8a-9b30-d63143b49406",
                                        "glosses": [
                                            "The pale pink or pale red colour of flesh; carnation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca30d28-62ac-4bb1-9956-fbb00cab137e",
                                                "sense_id": "6bec9711-0096-3fdd-a936-1a9963d4fd06",
                                                "text": "To dye SILK FLESH colour or INCARNADINE. For every pound of ſilk, put in a quarter of a pound of Braſil; boil it, ſtrain it through a ſieve, and pour freſh cold water upon it."
                                            },
                                            {
                                                "example_id": "b78f0136-b860-4362-a397-0340d60ea761",
                                                "sense_id": "6bec9711-0096-3fdd-a936-1a9963d4fd06",
                                                "text": "The woman whom he now saw was a noble, beautiful creature, [...] Beautiful chestnut hair, shaded with veins of gold, a brow which seemed chiselled marble, cheeks which seemed made of roses, a pale incarnadine, a flushed whiteness, an exquisite mouth, whence came a smile like the gleam of sunshine, and a voice like music, a head which Raphael would have given to Mary, on a neck which Jean Goujon would have given to Venus."
                                            },
                                            {
                                                "example_id": "6c95511e-8f29-40d7-8ca2-cb97cb29f577",
                                                "sense_id": "6bec9711-0096-3fdd-a936-1a9963d4fd06",
                                                "text": "Incarnadine – this remarkable colour of the human skin – how does it arise in painting? [...] Painting what transpires within the soul, it becomes external image: incarnadine, and the colours that surround the head or the human figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7f87dd-96f9-3d15-8de1-b1ae879daa88",
                                        "entry_id": "637b01b1-a6a6-3d8a-9b30-d63143b49406",
                                        "glosses": [
                                            "The blood-red colour of raw flesh; crimson."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af1967d-caa1-49a9-aa77-648c6468f772",
                                                "sense_id": "2b7f87dd-96f9-3d15-8de1-b1ae879daa88",
                                                "text": "Now thou [the sea] must wear an unmix'd crimson; no / Barbaric blood can reconcile us now / Unto that horrible incarnadine, / But friend or foe will roll in civic slaughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220cee4f-3a28-3f33-a218-28fbdc9c02aa",
                                        "entry_id": "637b01b1-a6a6-3d8a-9b30-d63143b49406",
                                        "glosses": [
                                            "A red colour."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8f86ea-30b0-43b6-938e-d9de40485438",
                                                "sense_id": "220cee4f-3a28-3f33-a218-28fbdc9c02aa",
                                                "text": "Now sixty-eight years of age she [Elizabeth I] has chosen for the occasion of a dance in her honor a long flowing velvet gown of incarnadine red."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incarnadine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b256534b-f9c5-3eea-a5a9-b798342bfeff",
                                        "entry_id": "4e2a104b-b2f6-33bd-80bc-c41454fa4c96",
                                        "glosses": [
                                            "To make flesh-coloured."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0d0dbb-960c-425d-aceb-2f61f0f9f79b",
                                                "sense_id": "b256534b-f9c5-3eea-a5a9-b798342bfeff",
                                                "text": "[T]he clouds, till that time thick in the sky, broke away from the upper heaven, and allowed the noonday sun to pour down through the lantern upon her, irradiating her with a warm light that was incarnadined by her pink doublet and hose, and reflected in upon her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                        "entry_id": "4e2a104b-b2f6-33bd-80bc-c41454fa4c96",
                                        "glosses": [
                                            "To make red, especially blood-coloured or crimson; to redden."
                                        ],
                                        "tags": [
                                            "also",
                                            "archaic",
                                            "figuratively",
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f48251-1822-4d8b-9126-130df806510c",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "Will all great Neptunes ocean waſh this blood / Cleane from my Hand? no: this my Hand will rather / The multitudinous Seas incarnardine, / Making the Greene one, Red."
                                            },
                                            {
                                                "example_id": "2ba2efed-147f-4d41-9085-0bd026311380",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "Virgins of equall birth, [...] / Shall draw thy picture, and record thy life; / One ſhall enſphere thine eyes, another ſhall / Impearl thy teeth[,] a third thy white and ſmall / Hand ſhall beſnow, a fourth incarnadine / Thy roſie cheek, [...]"
                                            },
                                            {
                                                "example_id": "954b7d70-adae-4d68-9d98-8af2a6619726",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "[H]e dies. / His wife her cheeks rends inconſolable, / His babes are fatherleſs, his blood the glebe / Incarnadines, and where he bleeds and rots / More birds of prey than women haunt the place."
                                            },
                                            {
                                                "example_id": "cf32759f-179c-4d17-b469-8ef632e91806",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "And he, who turn'd the waters into blood, / Shall next incarnadine these desart sands, / Whilst dogs and vultures hunt us on the track."
                                            },
                                            {
                                                "example_id": "4c316b7b-eafa-4fa1-825c-cf83eaa8bb4a",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "[...] Aaron lifting high / The fatal wand, with gaze upturn'd to heaven, / Smote on the flood; and swifter than the lapse / Of falling star, abhorr'd contagion spread / O'er all the current, whose discolour'd train / In utmost amplitude from shore to shore / Still roll'd and inexhaustible roll'd on / A putrid sea of blood; with bitterness / Of scorn and anger Aaron mock'd the griev'd / Magician; then with Moses from my wrath / Withdrew; but left their witcheries behind / Incarnadining every lake and pool, / And long canal; [...]"
                                            },
                                            {
                                                "example_id": "96843b5f-35c6-4537-852c-ca91031416b0",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "These were the times when the hardy military virtues might flourish—when Cressy and Agincourt could occur, and the war of the Roses incarnadine the soil of England: [...]"
                                            },
                                            {
                                                "example_id": "1f5e6d0d-65ad-43b3-8dee-f19193ad2279",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "And David's Lips are lock't; but in divine\nHigh piping Péhlevi, with \"Wine! Wine! Wine!\nRed Wine!\" — the Nightingale cries to the Rose\nThat yellow Cheek of her's to'incarnadine."
                                            },
                                            {
                                                "example_id": "fa23d456-5381-43d6-843d-8b2e84c9e7f7",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "Repose had again incarnadined her cheeks; and having, at Gabriel's request, arranged her hair this morning as she had worn it years ago on Norcombe Hill, she seemed in his eyes remarkably like the girl of that fascinating dream, which, considering that she was now only three or four-and-twenty, was perhaps not very wonderful"
                                            },
                                            {
                                                "example_id": "26a33068-18d4-4854-9da4-5b6bfbe4a4d9",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "The tangled constellations wane and die, / The witchery of waking dawn entwines / A wreath of primrose glory in the sky / And all the orient incarnadines— [...] [From the New York Sun.]"
                                            },
                                            {
                                                "example_id": "9b30f6d5-5004-40de-b7b5-8260de6a4b1e",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "The red light flamed on the white sails of a vessel gliding down the channel, bound to a southern port in a land of palms. Beyond her, it smote upon and incarnadined the shining, white, grassless faces of the sand-dunes."
                                            },
                                            {
                                                "example_id": "d2ca94eb-33c9-4b0b-a575-ab5c41105a9f",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "When I repeat to Moody my father's tribute such a sudden wine-dark flush incarnadines his face that I am startled."
                                            },
                                            {
                                                "example_id": "8ac3396c-2617-492d-a3e3-7eb5c0e61c08",
                                                "sense_id": "6746a21e-d296-391c-aad5-b6d4341b1917",
                                                "text": "\"And what of all the men you shot in Malaya and the Indies?\" he asked. \"What did you think when their blood incarnadined the oceans of Asia? Tell me!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
