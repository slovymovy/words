                "senses": [
                    {
                        "sense_id": "e09df4ec-f328-33c6-8bad-044068bb3c33",
                        "entry_id": "f84e19e4-0011-386e-a402-be3db43b97f1",
                        "glosses": [
                            "Enfant noir."
                        ],
                        "tags": [
                            "dated",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c3bb399-83cc-4330-97b4-25680c7eccdc",
                                "sense_id": "e09df4ec-f328-33c6-8bad-044068bb3c33",
                                "text": "On dit au marchand qui propoſe des Nègres : je te donnerai, tant d'onces d'or, ou tant de pièces pour chaque Nègre, chaque Négreſſe, chaque Négrillon & chaque Négritte. Après avoir quelquefois beaucoup marchandé, on conclud ; on donne au marchand négrier les marchandiſes convenues, & on embarque les Nègres ou on les laiſſe en magaſin (quand on en a établi un dans quelque port) juſqu'à plus grand nombre."
                            },
                            {
                                "example_id": "f84d46cf-a143-43d1-8b6a-342ce66bf2e8",
                                "sense_id": "e09df4ec-f328-33c6-8bad-044068bb3c33",
                                "text": "Elle marche […] et ce sont douze négrillons, six de chaque côté, tous crêpus et vêtus de cotillons plissés, qui portent la longue queue de sa robe traînante."
                            },
                            {
                                "example_id": "1ddc89d2-7b5e-40fe-b354-def2aa2154fa",
                                "sense_id": "e09df4ec-f328-33c6-8bad-044068bb3c33",
                                "text": "On présente au petit Tony un négrillon de cinq ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf92c59c-9227-34da-a3eb-67f3fc4d23d7",
                        "entry_id": "f84e19e4-0011-386e-a402-be3db43b97f1",
                        "glosses": [
                            "Enfant blanc dont le teint est très brun, très foncé."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4138d740-6908-378b-9e9f-a3834151621e",
                        "entry_id": "f84e19e4-0011-386e-a402-be3db43b97f1",
                        "glosses": [
                            "Brownie (sorte de pâtisserie)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "30f29cc3-b237-455e-a2f0-1ce7899f18d3",
                                "sense_id": "4138d740-6908-378b-9e9f-a3834151621e",
                                "text": "Il est 16 h et je mange un négrillon (franchement, j'aime mieux le mot brownie) devant mon ordi."
                            }
                        ]
                    }
