                "senses": [
                    {
                        "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                        "entry_id": "3d3a4ccc-592b-374d-a537-83975b4db5e5",
                        "glosses": [
                            "weibliche Person, die in Gröden (mehrere Orte möglich) lebt oder aus Gröden stammt"
                        ],
                        "tags": [
                            "Personenbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "e28ce3da-16e4-4bfb-b605-4dd03f5162c2",
                                "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                                "text": "„Nadia Delago legt gut los, oben fehlen nur 17 Hundertstel. Im technisch anspruchsvollen Teil hat die Grödenerin zu kämpfen.“"
                            },
                            {
                                "example_id": "65a9592e-0f96-4de8-b218-fce075cfd59f",
                                "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                                "text": "„Die Grödenerinnen haben ein angebornes Schachertalent.“"
                            },
                            {
                                "example_id": "c89b25ef-ede5-4a7a-8e78-cf56782a1202",
                                "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                                "text": "„Dieser Handel mit Schnitzwaaren und Spitzen führte bald zum noch jetzt allgemein verbreiteten Hausieren der Grödenerinnen, […]“"
                            },
                            {
                                "example_id": "931f15f8-9736-4f9d-aaf2-439f2b843ef4",
                                "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                                "text": "„Umso mehr sind die Grödenerin und ihr Partner froh, dass es nun nach zwei Monaten Bauzeit endlich mit dem täglichen Verkauf von Eis und Kaffee […] losgehen kann.“"
                            },
                            {
                                "example_id": "6ba4ec91-6e7d-4644-a63b-d696e879a7f6",
                                "sense_id": "b7e061b5-a842-378a-a793-9e3af87b4682",
                                "text": "Aus dem Ausland erreicht Grödener und Grödenerinnen in Gröden telefonisch per Telefon mit der Vorwahl […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
