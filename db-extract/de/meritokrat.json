                "senses": [
                    {
                        "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                        "entry_id": "ddea8361-a780-3efc-9453-272051da9163",
                        "glosses": [
                            "Funktionsträger aufgrund seiner bewiesenen Fähigkeiten beziehungsweise Anhänger dieses Herrschaftsprinzips"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706af518-df0c-4d3e-b811-ae2b15749a62",
                                "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                                "text": "Wölfls Förderer war Freiherr Raimund von Wetzlar, ein Neureicher und Neuadliger, ein Meritokrat also und deshalb in den Augen des alten Adels kein Gleichrangiger."
                            },
                            {
                                "example_id": "30792778-703d-4bcf-a687-36bbfcfe6486",
                                "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                                "text": "„Er ist ein republikanischer Meritokrat.“"
                            },
                            {
                                "example_id": "b109d8c4-f6ce-4e7d-befa-ae3d6308f2e5",
                                "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                                "text": "„War jener als ‚Retter der Demokratie‘ ein anerkannter Meritokrat, so wird Felipe sich noch unter nicht allzu leichten Bedingungen den Thron ‚verdienen‘ müssen.“"
                            },
                            {
                                "example_id": "2715b0e5-4e6f-4910-b822-66d03d7c9fa7",
                                "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                                "text": "„Der ideale Meritokrat schlug vor: Gib nur jenem, der es auch verdient.“"
                            },
                            {
                                "example_id": "df4a3f31-1485-4f33-8349-d59d42804570",
                                "sense_id": "bb0d38b5-0d3c-3b78-8c04-de00cec0398f",
                                "text": "„Meritokraten sind aus Notwendigkeit meist Anhänger der Spezialisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
