                "senses": [
                    {
                        "sense_id": "6ef9a1ed-6c49-3843-970b-e3abca5e4204",
                        "entry_id": "7b9f851e-036d-3445-8fa9-5ae5d4ecd7bb",
                        "glosses": [
                            "Se briser sous l'action du gel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8ba618-331c-4d3a-b487-21b938b8932a",
                                "sense_id": "6ef9a1ed-6c49-3843-970b-e3abca5e4204",
                                "text": "Inversement, une dalle rocheuse unie ou même une corniche largement diaclasée, sans pergélisol, où l'eau ne reste pas, se trouve dans de mauvaises conditions pour géliver."
                            },
                            {
                                "example_id": "ec986578-5086-48bb-a7ae-24c73b9f1ad1",
                                "sense_id": "6ef9a1ed-6c49-3843-970b-e3abca5e4204",
                                "text": "Un versant jeune présente des éboulis nombreux, avec une pente de gravité ; la roche est fréquemment à nu et continue à se géliver, chaque escarpement rocheux reculant sous cette action."
                            }
                        ]
                    }
                ],
