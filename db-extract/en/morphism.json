                                        "glosses": [
                                            "Application entre deux ensembles munis d’une même espèce de structure, qui respecte cette structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3295185a-bcce-4cda-b4e5-c73d2694b113",
                                                "sense_id": "a14d52f1-551b-30d4-a498-5785145ea6f6",
                                                "text": "Les morphismes ont des applications particulièrement importantes en physique moderne, en particulier la mécanique quantique."
                                            },
                                            {
                                                "example_id": "fa2cfafa-6f51-4a93-baa9-64c49e4fde1b",
                                                "sense_id": "a14d52f1-551b-30d4-a498-5785145ea6f6",
                                                "text": "Un morphisme d’anneaux entre anneaux unitaires n’est pas forcément unitaire."
                                            }
                                        ]
                                    }
                                ]
                            }
