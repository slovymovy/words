    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2589b73a-dffe-3111-9638-a2ef61772026",
                    "sense_definition": "een beetje dik op een aangename of gezonde manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby heeft <w>mollige</w> wangen die iedereen graag even wil aanraken.",
                            "target_lang_translations": {
                                "en": "The baby has <w>chubby</w> cheeks that everyone wants to touch for a moment.",
                                "pl": "Dziecko ma <w>pulchne</w> policzki, których każdy chce choć na chwilę dotknąć."
                            }
                        },
                        {
                            "text": "Na een kwartier stopte er een oude gedeukte Toyota met een <w>mollige</w> vrouw voorin.",
                            "target_lang_translations": {
                                "en": "After fifteen minutes, an old dented Toyota stopped with a <w>plump</w> woman in the front.",
                                "pl": "Po kwadransie zatrzymała się stara, poobijana Toyota z <w>pulchną</w> kobietą z przodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "gezet",
                        "volslank",
                        "gevuld",
                        "rond"
                    ],
                    "antonyms": [
                        "mager",
                        "slank",
                        "dun"
                    ],
                    "common_phrases": [
                        "mollige wangen",
                        "mollige baby",
                        "mollige handjes"
                    ],
                    "target_lang_definitions": {
                        "en": "slightly fat in a pleasant or healthy way",
                        "pl": "nieco tęgi w przyjemny, uroczy lub zdrowy sposób"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plump",
                                "target_lang_sense_clarification": "having a full and rounded shape"
                            },
                            {
                                "target_lang_word": "chubby",
                                "target_lang_sense_clarification": "slightly overweight in a cute or soft way, often used for children"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pulchny",
                                "target_lang_sense_clarification": "o osobie, ciele lub dziecku mającym miękkie, zaokrąglone kształty"
                            },
                            {
                                "target_lang_word": "pyzaty",
                                "target_lang_sense_clarification": "głównie o policzkach lub twarzy: zaokrąglony i pełny"
                            },
                            {
                                "target_lang_word": "puszysty",
                                "target_lang_sense_clarification": "eufemistycznie o osobie o pełniejszych kształtach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd05d8d3-8516-38c0-aaa8-3c9589ff3e2d",
                    "sense_definition": "zacht en verend aanvoelend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "textuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>mollige</w> kussen op de bank zorgde voor extra comfort tijdens het lezen.",
                            "target_lang_translations": {
                                "en": "The <w>plump</w> cushion on the sofa provided extra comfort while reading.",
                                "pl": "<w>Puszysta</w> poduszka na kanapie zapewniała dodatkowy komfort podczas czytania."
                            }
                        },
                        {
                            "text": "Zij liep op blote voeten over het <w>mollige</w> tapijt in de slaapkamer.",
                            "target_lang_translations": {
                                "en": "She walked barefoot across the <w>plush</w> carpet in the bedroom.",
                                "pl": "Szła boso po <w>puszystym</w> dywanie w sypialni."
                            }
                        }
                    ],
                    "synonyms": [
                        "zacht",
                        "donzig",
                        "veerkrachtig"
                    ],
                    "antonyms": [
                        "hard",
                        "stug"
                    ],
                    "common_phrases": [
                        "mollig kussen",
                        "mollig tapijt"
                    ],
                    "target_lang_definitions": {
                        "en": "feeling soft and springy to the touch",
                        "pl": "miękki i sprężysty w dotyku"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plump",
                                "target_lang_sense_clarification": "full and rounded, used for cushions or pillows"
                            },
                            {
                                "target_lang_word": "plush",
                                "target_lang_sense_clarification": "soft and thick, used for carpets or fabrics"
                            },
                            {
                                "target_lang_word": "soft",
                                "target_lang_sense_clarification": "yielding easily to touch or pressure"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "puszysty",
                                "target_lang_sense_clarification": "o dywanie, tkaninie lub poduszce: miękki, gruby i sprężysty"
                            },
                            {
                                "target_lang_word": "miękki",
                                "target_lang_sense_clarification": "uginający się pod dotykiem, przyjemny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
