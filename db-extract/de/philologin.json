                        "glosses": [
                            "eine Frau, die in der Philologie ausgebildet und bewandert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b448c22d-0f91-4101-ae9c-6440625df340",
                                "sense_id": "9e2f1f44-7394-31da-8855-b309dad393c5",
                                "text": "Manche Philologinnen befassen sich mit Texten einer längst vergessenen Sprache entweder als Sprachwissenschaftlerin (Linguistin) oder als Literaturwissenschaftlerin."
                            }
                        ],
                        "sense_index_json": "\"1\""
