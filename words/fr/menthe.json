            "senses": [
                {
                    "sense_id": "09043f71-ccd2-31b5-b3b5-7bd1d3df900a",
                    "sense_definition": "Plante aromatique de la famille des lamiacées, cultivée pour ses feuilles très odorantes utilisées en cuisine et en phytothérapie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai planté de la <w>menthe</w> fraîche dans mon jardin pour parfumer mes plats."
                        },
                        {
                            "text": "Nous avons bu un délicieux thé à la <w>menthe</w> bien chaud après le dîner."
                        }
                    ],
                    "common_phrases": [
                        "menthe fraîche",
                        "menthe poivrée",
                        "feuilles de menthe",
                        "thé à la menthe"
                    ]
                },
                {
                    "sense_id": "fdfc801c-0903-379c-a7cd-5db7300213a3",
                    "sense_definition": "Boisson ou sirop à base d'extrait ou d'arôme de menthe, généralement de couleur verte.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En été, les enfants aiment boire une <w>menthe</w> à l'eau bien fraîche en terrasse."
                        },
                        {
                            "text": "Le serveur a apporté un grand verre de <w>menthe</w> avec des glaçons."
                        }
                    ],
                    "common_phrases": [
                        "menthe à l'eau",
                        "sirop de menthe"
                    ]
                },
                {
                    "sense_id": "1ecc762b-c0b9-306f-a261-25016f4b7853",
                    "sense_definition": "Couleur vert tendre et pastel rappelant la teinte de certaines feuilles de menthe.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une jolie robe couleur <w>menthe</w> pour la fête d'été."
                        },
                        {
                            "text": "Les murs de la chambre ont été repeints dans un ton <w>menthe</w> très apaisant."
                        }
                    ],
                    "common_phrases": [
                        "vert menthe"
                    ]
                },
                {
                    "sense_id": "393f6a34-b0e9-3a63-bf76-2ebcebb6f287",
                    "sense_definition": "Nom usuel donné à diverses plantes d'autres genres botaniques en raison de leur odeur ou de leur aspect similaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat adore se frotter contre la <w>menthe</w> des chats plantée au bord de l'allée."
                        },
                        {
                            "text": "Cette herbe sauvage est parfois appelée fausse <w>menthe</w> en raison de son feuillage aromatique."
