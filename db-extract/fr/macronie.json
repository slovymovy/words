                "senses": [
                    {
                        "sense_id": "b87dc373-2940-3d8a-8f4a-8c11dce20307",
                        "entry_id": "69ae6da0-e125-3719-8b0d-d567c7fa5081",
                        "glosses": [
                            "Partisanerie d’Emmanuel Macron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba911b29-4b32-4d18-973d-796c0bada3ff",
                                "sense_id": "b87dc373-2940-3d8a-8f4a-8c11dce20307",
                                "text": "« Pascal Canfin, Fabienne Keller et Nathalie Loiseau représentaient cette arrogance inouïe de la macronie, épuisante humainement et politiquement, déconnectée de la réalité numérique. Si l’on n’était pas d’accord avec eux, on était des fachos. Si l’on était d’accord, on “rejoignait leurs positions”."
                            }
                        ]
                    },
                    {
                        "sense_id": "995d6e30-a950-3ea6-b788-8648f344467d",
                        "entry_id": "69ae6da0-e125-3719-8b0d-d567c7fa5081",
                        "glosses": [
                            "Clique, entourage proche d'Emmanuel Macron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a254bb77-f3c8-4a8b-8b27-d98fd53919e5",
                                "sense_id": "995d6e30-a950-3ea6-b788-8648f344467d",
                                "text": "Certaines sources au sein de la macronie commencent à évoquer la possibilité d’un remaniement fin août ou début septembre."
                            },
                            {
                                "example_id": "8acc5455-d9b7-4f94-8da6-67a280ba69db",
                                "sense_id": "995d6e30-a950-3ea6-b788-8648f344467d",
                                "text": "À première vue, l'une des grandes brûlées de la macronie semble avoir parfaitement digéré ses mésaventures, […]"
                            }
                        ]
                    }
