                "senses": [
                    {
                        "sense_id": "8d7d8432-48a3-3868-9c29-2befedbff597",
                        "entry_id": "07ef1d9b-8512-3f25-b2f8-91432d4ac8e3",
                        "glosses": [
                            "Action de rendre gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77916005-0f9f-434f-8cb2-b7d15ff0bcdd",
                                "sense_id": "8d7d8432-48a3-3868-9c29-2befedbff597",
                                "text": "La race de Durham n’avait été élevée jusqu'à la perfection que parce qu'elle n'avait été menée zootechniquement que dans une direction unique - l'aptitude à l’engraissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "e65cbb12-c25d-3377-bc99-ad3fe84f7e0e",
                        "entry_id": "07ef1d9b-8512-3f25-b2f8-91432d4ac8e3",
                        "glosses": [
                            "État de celui qui engraisse, qui devient gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8907323f-9ecc-4c62-98b9-2282164f2966",
                                "sense_id": "e65cbb12-c25d-3377-bc99-ad3fe84f7e0e",
                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l’engraissement. Il est aussi le plus répandu."
                            },
                            {
                                "example_id": "5d464366-9871-4e29-8738-a41113c5296e",
                                "sense_id": "e65cbb12-c25d-3377-bc99-ad3fe84f7e0e",
                                "text": "L’engraissement est un des premiers signes de la vieillesse. — Il suit un régime contre l’engraissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f475b0a4-9542-38af-8072-9d5a8537e247",
                        "entry_id": "07ef1d9b-8512-3f25-b2f8-91432d4ac8e3",
                        "glosses": [
                            "Par engraissement : Caractérise une façon d'assembler en force deux pièces de bois en faisant en sorte qu'il n'y ai aucun vide entre elles."
                        ],
                        "tags": [],
                        "examples": []
                    }
