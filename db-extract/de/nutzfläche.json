                "senses": [
                    {
                        "sense_id": "0ac9d880-e0d1-30ad-9cde-1d871823a23d",
                        "entry_id": "1d2291fc-8252-3c0d-8aef-4128c602a0f0",
                        "glosses": [
                            "räumlicher Bereich (zum Beispiel Erdboden oder Teil eines Gebäudes), der auf eine bestimmte Weise genutzt, verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be84d5bf-d3fe-4635-919a-27e028cc1687",
                                "sense_id": "0ac9d880-e0d1-30ad-9cde-1d871823a23d",
                                "text": "„Die Wohn- und Nutzfläche des Gebäudes beträgt ohne die beantragte Erweiterung 801 m² […].“"
                            },
                            {
                                "example_id": "e36fb925-6f1d-47ce-aa6e-ea3c26d2ab89",
                                "sense_id": "0ac9d880-e0d1-30ad-9cde-1d871823a23d",
                                "text": "„Die gesamte Nutzfläche betrug 937,0 Hektaren, davon über die Hälfte Naturwiesen und Weiden.“"
                            },
                            {
                                "example_id": "95c83670-8bed-449b-b495-142167092ab8",
                                "sense_id": "0ac9d880-e0d1-30ad-9cde-1d871823a23d",
                                "text": "„Wird Land für Bauwerke in Anspruch genommen und berührt dies die Umwandlung von landwirtschaftlicher Nutzfläche zu Bauland, so muss das Antrags- und Genehmigungsverfahren für die Änderung der Nutzung landwirtschaftlichen Bodens durchgeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
