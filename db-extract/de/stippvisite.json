                    {
                        "translation_id": "afd046ca-eaa5-46d5-b18a-599af519ca3e",
                        "source_entry_id": "913c3b39-dfc7-35aa-a9b2-6f63609edcdc",
                        "source_sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                        "source_sense_description": "Deutschland, Schweiz: kurzer Besuch",
                        "target_lang_word": "flying visit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flying visit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "caab8f35-3b87-3ebd-8476-bfa04770163e",
                                        "entry_id": "e08cbba6-fb22-3779-bd6e-771c2e2d5d84",
                                        "glosses": [
                                            "A very short visit."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa47a937-9ad0-4e59-aa07-b7e614b35b8d",
                                                "sense_id": "caab8f35-3b87-3ebd-8476-bfa04770163e",
                                                "text": "My favorite novelist was on a flying visit to London last week for a book signing."
                                            },
                                            {
                                                "example_id": "160aa03f-1a15-4f86-a7b7-3db05511b48c",
                                                "sense_id": "caab8f35-3b87-3ebd-8476-bfa04770163e",
                                                "text": "Rishi Sunak is not interested in the climate emergency – and everyone knows it. Forced to make a flying visit to Cop27, Mr Sunak’s intransigence made him an outcast at the UN summit in Sharm el-Sheikh, Egypt."
                                            },
                                            {
                                                "example_id": "404380e5-5e21-4c7b-bfe8-bff47d8ad119",
                                                "sense_id": "caab8f35-3b87-3ebd-8476-bfa04770163e",
                                                "text": "COVID seems to have increased traffic to such locations, as 'staycations' have become more popular. But for me, it's a flying visit. I am merely changing trains to continue along the coast to Hastings, aboard another Southern Class 377."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f894a47-3d6c-4701-8bf0-679b47df0b24",
                        "source_entry_id": "913c3b39-dfc7-35aa-a9b2-6f63609edcdc",
