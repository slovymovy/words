                                        "entry_id": "07060a4c-4ca4-36cc-b903-b7328d993227",
                                        "glosses": [
                                            "The superior or head of an abbey or monastery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f346540b-f1e8-420f-89e1-fc92bbfc016f",
                                                "sense_id": "7b665521-ba8e-3f7e-9b4e-750e8c405750",
                                                "text": "The newly appointed abbot decided to take a tour of the abbey with the cardinal's emissary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c62f3a82-f516-3a4e-a0b8-a32e12ee7c1f",
                                        "entry_id": "07060a4c-4ca4-36cc-b903-b7328d993227",
                                        "glosses": [
                                            "The pastor or administrator of an order, including minor and major orders starting with the minor order of porter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45621dc5-3248-3922-b63d-87616f972ba4",
                                        "entry_id": "07060a4c-4ca4-36cc-b903-b7328d993227",
                                        "glosses": [
                                            "A layman who received the abbey's revenues, after the closing of the monasteries."
                                        ],
