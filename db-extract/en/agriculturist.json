                    {
                        "sense_id": "fdc1cfe1-7df6-3e3a-9ead-09e8377dc39c",
                        "entry_id": "65870ffb-25e3-3e90-9323-4d7621a4c79d",
                        "glosses": [
                            "One who practices agriculture, a farmer, a gardener."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3774e811-8513-387a-b2b7-40e7fd0cb4c3",
                        "entry_id": "65870ffb-25e3-3e90-9323-4d7621a4c79d",
                        "glosses": [
                            "An expert in agriculture who advises farmers."
                        ],
                        "tags": [],
