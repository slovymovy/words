                ],
                "senses": [
                    {
                        "sense_id": "18a8dda1-29d7-3882-b90a-cb1b94cd64b1",
                        "entry_id": "b5646ef3-adaf-3762-89bc-7979e1a8c3cb",
                        "glosses": [
                            "Personne, le plus souvent bénévole, qui assiste une personne dépendante dans sa vie quotidienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c696ec4-22ad-42e3-b441-618d3c532a60",
                                "sense_id": "18a8dda1-29d7-3882-b90a-cb1b94cd64b1",
                                "text": "La construction d’un triangle de soin peut se réaliser avec une assistante sociale, une psychologue, ou sur place, par exemple, avec un aidant bénévole appartenant à une association de proximité."
                            },
                            {
                                "example_id": "c870455d-1d7f-4137-beba-3fe1131a95dc",
                                "sense_id": "18a8dda1-29d7-3882-b90a-cb1b94cd64b1",
                                "text": "Le médecin traitant n’a de réponse à aucune question. Il m’offre sa sympathie et sa désolation, ainsi que le nom d’une association d’« aidants » qui pourra m’aider à aider ma mère, et m’aider moi parce que ça ne va pas être facile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51bb9179-a288-4c60-97dc-79c04bb976f6",
                        "source_entry_id": "b5646ef3-adaf-3762-89bc-7979e1a8c3cb",
                        "source_sense_id": "18a8dda1-29d7-3882-b90a-cb1b94cd64b1",
                        "target_lang_word": "caregiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caregiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                        "entry_id": "1bfb52a6-9a5a-306b-9e9a-266a917596a1",
                                        "glosses": [
                                            "A carer; a person who looks after another person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7ceb96-b8a0-4927-a432-2fcf4c63ba5c",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "‘Caregivers in this role can suffer as much as the patients. It can be very stressful.’"
                                            },
                                            {
                                                "example_id": "810525a9-2ff3-40c1-98fc-c224c9f7a7ce",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "The coronavirus has turned caregivers around the world into homeschoolers."
                                            },
                                            {
                                                "example_id": "00136011-1db1-4a3e-82e2-526ea9d4dcab",
                                                "sense_id": "ef6738dc-517b-327d-8dd1-10f6334d484d",
                                                "text": "Taking care of an elderly parent or seriously ill spouse or family member can be physically and emotionally draining — and expensive for the caregiver in more ways than one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6960c2ce-7a99-4946-b0de-7d847f1a67a0",
                        "source_entry_id": "b5646ef3-adaf-3762-89bc-7979e1a8c3cb",
                        "source_sense_id": "18a8dda1-29d7-3882-b90a-cb1b94cd64b1",
                        "target_lang_word": "carer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                        "entry_id": "42839f18-0529-3c0d-b19a-b54a4ceb4c91",
                                        "glosses": [
                                            "Someone who regularly looks after another person, either as a job or often through family responsibilities."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8bdcca-68c3-48c6-8748-85d520087079",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "Have you thought of a job as a carer for disabled people?"
                                            },
                                            {
                                                "example_id": "2be5ca9c-bcdf-4d5b-8df9-d6af4930176e",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "They retired early to be a full-time carer for their partner."
                                            },
                                            {
                                                "example_id": "e72bede2-d4a4-41c3-8fbf-909952172b54",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "He said Robins had not been in trouble with the law before and had no previous convictions. Jail would have an adverse effect on her and her three children as she was the main carer."
                                            },
                                            {
                                                "example_id": "c397800a-5412-45e8-ac04-d49c2314058a",
                                                "sense_id": "6b4cbc89-1dc0-30e7-a96a-58ea6d2d39f8",
                                                "text": "Her business was a one-woman outfit that offered accredited first-aid training courses for teachers, carers, sports coaches, antenatal classes, workplace groups, and the police; the classes ranged from basic defibrillator training to what was now called psychological first aid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "831ddae0-efd7-4828-bb98-3620afeb7d34",
                        "source_entry_id": "b5646ef3-adaf-3762-89bc-7979e1a8c3cb",
