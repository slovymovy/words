                "senses": [
                    {
                        "sense_id": "6bbba97b-0dff-34dc-8f0a-7f209a601988",
                        "entry_id": "106dd2e4-5ccd-325b-b172-f3da0b5a7fcd",
                        "glosses": [
                            "Erdzeitalter innerhalb des Phanerozoikums, das auf dem Paläozoikum folgt und ins Känozoikum übergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f83a90-0e31-40ff-9598-df99906c184a",
                                "sense_id": "6bbba97b-0dff-34dc-8f0a-7f209a601988",
                                "text": "„Im Erdmittelalter (Mesozoikum) mit den Abschnitten Trias […], Jura […] und Kreide […] werden die Dinosaurier die beherrschenden Landlebewesen.“"
                            },
                            {
                                "example_id": "f70fcb6a-7d63-440b-a367-40cf5b1043c2",
                                "sense_id": "6bbba97b-0dff-34dc-8f0a-7f209a601988",
                                "text": "„Am Anfang des Erdmittelalters, vor etwa 252 Millionen Jahren, sah die Erde völlig anders aus als heute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
