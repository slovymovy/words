                "senses": [
                    {
                        "sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                        "entry_id": "c5a196c1-411e-372a-984b-0bfcfb3b7641",
                        "glosses": [
                            "Qui fait outrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ac6eda-bbd3-4cca-9451-7765a45ae729",
                                "sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                                "text": "«Il y a plein de cas outrageux, et on voulait faire quelque chose pour serrer la vis aux courtiers», a-t-on ajouté."
                            },
                            {
                                "example_id": "e59396cc-54f3-4ff7-8640-ea9ff7d41bf7",
                                "sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                                "text": "Paroles outrageuses."
                            },
                            {
                                "example_id": "dea3c963-b777-4159-8652-574d4cfe042a",
                                "sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                                "text": "Il est outrageux en paroles."
                            },
                            {
                                "example_id": "553e1845-7c23-4a0e-b697-c2fcbdc27fd8",
                                "sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                                "text": "On l’a traité d’une manière outrageuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d84c7e-5947-416b-9712-35baee07ace5",
                        "source_entry_id": "c5a196c1-411e-372a-984b-0bfcfb3b7641",
                        "source_sense_id": "0f71c05c-b429-3ff8-90d9-9e81e5e32fd8",
                        "source_sense_description": "Qui fait outrage",
                        "target_lang_word": "outrageous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrageous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e82452ef-06a9-3db0-b0d8-e0d05d2606e9",
                                        "entry_id": "3c4ddc26-0965-3e0b-bfb1-8aa4474123df",
                                        "glosses": [
                                            "Violating morality or decency; provoking indignation or affront."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c26d16-5210-4b2c-9b80-ec8c45de3b3d",
                                                "sense_id": "e82452ef-06a9-3db0-b0d8-e0d05d2606e9",
                                                "text": "To be, or not to be, that is the Question: / Whether 'tis Nobler in the minde to suffer / The Slings and Arrowes of outragious Fortune, / Or to take Armes against a Sea of troubles, / And by opposing end them [...]."
                                            },
                                            {
                                                "example_id": "92aa14b7-4f42-42f3-97eb-442a5c25805a",
                                                "sense_id": "e82452ef-06a9-3db0-b0d8-e0d05d2606e9",
                                                "text": "The Irish-French rugby union whistler Alain Rolland was roundly condemned for his outrageous decision that lifting a player into the air then turning him over so he falls on his head or neck amounted to dangerous play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92db6cea-fb4d-3768-a8f6-167580f3ddb1",
                                        "entry_id": "3c4ddc26-0965-3e0b-bfb1-8aa4474123df",
                                        "glosses": [
                                            "Transgressing reasonable limits; extravagant, immoderate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0c04f4-bbb9-4e97-ba2b-db46beb7226a",
                                                "sense_id": "92db6cea-fb4d-3768-a8f6-167580f3ddb1",
                                                "text": "\"Now, the Lord have mercy upon me!\" exclaimed Sir Robert, sinking back in his chair; \"there is nothing in the world so unreasonable as a pretty woman. Well, let me hear what outrageous proposition is about to come from two at once!\""
                                            },
                                            {
                                                "example_id": "3cb74e86-e233-4533-a5a8-45491190465c",
                                                "sense_id": "92db6cea-fb4d-3768-a8f6-167580f3ddb1",
                                                "text": "Audience members praised McKellen, best known for Shakespearean roles and as Gandalf in The Lord of the Rings, for his show-stealing turn as Twankey in a series of outrageous glitzy dresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b10543b-9868-3555-96fe-35cd31c71d4d",
                                        "entry_id": "3c4ddc26-0965-3e0b-bfb1-8aa4474123df",
                                        "glosses": [
                                            "Shocking; exceeding conventional behaviour; provocative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a38507-4aed-438a-8e00-75153c8b0419",
                                                "sense_id": "3b10543b-9868-3555-96fe-35cd31c71d4d",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            },
                                            {
                                                "example_id": "359bdcb4-ebad-4d1d-91d1-8649bd2369e3",
                                                "sense_id": "3b10543b-9868-3555-96fe-35cd31c71d4d",
                                                "text": "\"It's something I really am quite nervous about,\" he admits, before adding, with relish: \"You have to be a bit outrageous and challenging sometimes.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f9e486-928d-3d9f-9caf-cc03db2ba8c1",
                                        "entry_id": "3c4ddc26-0965-3e0b-bfb1-8aa4474123df",
                                        "glosses": [
                                            "Fierce, violent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9a113e-5f66-44b3-bd7e-ad63bdb2207b",
                                                "sense_id": "f5f9e486-928d-3d9f-9caf-cc03db2ba8c1",
                                                "text": "For els my feeble vessell, crazd and crackt / Through thy strong buffets and outrageous blowes, / Cannot endure, but needes it must be wrackt [...]."
                                            },
                                            {
                                                "example_id": "071d43ae-85d0-4494-abdd-54d7de52c7ae",
                                                "sense_id": "f5f9e486-928d-3d9f-9caf-cc03db2ba8c1",
                                                "text": "For when he knew his Rival freed and gone, / He ſwells with Wrath; he makes outrageous Moan: / He frets, he fumes, he ſtares, he ſtamps the Ground; / The hollow Tow'r with Clamours rings around: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
