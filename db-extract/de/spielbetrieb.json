                "senses": [
                    {
                        "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                        "entry_id": "39ef7892-c6f3-313e-a19c-3db7cc682072",
                        "glosses": [
                            "organisatorische Abwicklung und Durchführung von Spielen oder Aufführungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b885a358-4a65-46ae-9581-2d7344282edd",
                                "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                                "text": "„Die ersten weiblichen Croupiers wurden in Hamburg 1997 eingestellt, bis dahin war der gesamte Spielbetrieb in männlicher Hand.“"
                            },
                            {
                                "example_id": "8c9f19f8-44f7-45d7-a018-079b27d7ce54",
                                "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                                "text": "„Die Metropolitan Opera in New York nimmt den Spielbetrieb nach ihrem Umzug in ein neues Gebäude des Lincoln Center for the Performing Arts auf.“"
                            },
                            {
                                "example_id": "3498f86d-251c-414a-b770-6cd48ac718a6",
                                "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                                "text": "„Die Regierung hatte den Spielbetrieb aufgrund der öffentlichen Sicherheit zunächst ausgesetzt.“"
                            },
                            {
                                "example_id": "36d67c25-c887-421b-bd3f-c58336a1b5c5",
                                "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                                "text": "„Als erster Club aus dem Profibetrieb meldete er eine Mannschaft für Flüchtlinge im Spielbetrieb an, initiiert hatten das die Fans, die als eher links gelten.“"
                            },
                            {
                                "example_id": "c900b47c-b3c9-49cb-bc40-f30ac2f33887",
                                "sense_id": "f30cf079-3fc2-30f5-a03c-3ae7f966508d",
                                "text": "„Die Nachricht, dass Chinas U20 außer Konkurrenz am Spielbetrieb der Regionalliga Südwest teilnimmt, verursachte in der Sommerpause Aufruhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
