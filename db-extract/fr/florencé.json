                                        "examples": [
                                            {
                                                "example_id": "e25c5f69-7f32-4375-8667-38911cbfcecd",
                                                "sense_id": "088f186a-3593-32bd-b64c-04f43e8a2685",
                                                "text": "Nymphs and Shepherds, dance no more / By sandy Ladon's lilied banks;"
                                            },
                                            {
                                                "example_id": "49d6a59a-300d-437f-8df0-7e1fb8857d7a",
                                                "sense_id": "088f186a-3593-32bd-b64c-04f43e8a2685",
                                                "text": "1906, Percy MacKaye, Jeanne d'Arc, Act III, New York: Macmillan, p. 114, https://archive.org/details/jeannedarcadrama00mack\nShe drives you from the bridge. Her armour!— Now— / Oh, she is blown about and fluttered o'er / By clouds of little golden butterflies, / And where she thrusts her lilied banner through, / She glitters double—in the air and river."
                                            },
                                            {
                                                "example_id": "5f41804d-8cb7-4f97-b4b1-0dfeb0531afa",
                                                "sense_id": "088f186a-3593-32bd-b64c-04f43e8a2685",
                                                "text": "The summer term had been busy and stuffy, and to a Rugby player there were few attractions in punts among lilied backwaters."
                                            }
