                    {
                        "translation_id": "d39ae4a2-0277-4bf9-8c5a-e9ec189f9a23",
                        "source_entry_id": "6aba6039-c215-3f4f-a54e-bf8918b8e749",
                        "source_sense_id": "4ae5fca4-fcd8-3049-bb59-dbab2f099485",
