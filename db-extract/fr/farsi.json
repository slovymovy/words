                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac83fa7d-f46c-375b-a5c6-a883b3705964",
                        "entry_id": "28928865-91b4-33d6-92c0-4975179d0f8e",
                        "glosses": [
                            "Persan, langue de l’Iran, aussi parlée dans quelques pays voisins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25041ea-4f73-41b5-bcd8-c3d4b3a7fb13",
                                "sense_id": "ac83fa7d-f46c-375b-a5c6-a883b3705964",
                                "text": "Le farsi ne distingue pas de genres dans les substantifs et dans les adjectifs."
                            },
                            {
                                "example_id": "c3d5067e-e8f9-40d3-9e6a-54b944898fde",
                                "sense_id": "ac83fa7d-f46c-375b-a5c6-a883b3705964",
                                "text": "Attar était iranien et écrivait en farsi."
                            },
                            {
                                "example_id": "6d18309c-b266-47cd-80c8-bce4d124617b",
                                "sense_id": "ac83fa7d-f46c-375b-a5c6-a883b3705964",
                                "text": "Seul le nombre restreint de linguistes et d’analystes maîtrisant le farsi limitera l’exploitation de cette masse de données."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a637281-104a-3b0a-87ee-cfc4ac0aef60",
                        "entry_id": "28928865-91b4-33d6-92c0-4975179d0f8e",
                        "glosses": [
                            "Style calligraphique arabe issu de la Perse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31914d2b-aa98-4b22-968c-70a5f43f9b81",
                                "sense_id": "0a637281-104a-3b0a-87ee-cfc4ac0aef60",
                                "text": "Le diwani est un style calligraphique proche du farsi développé dans l'Empire ottoman."
                            }
