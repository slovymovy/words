                        "entry_id": "3cb6e97d-88ec-3fe3-aa1f-711536240103",
                        "glosses": [
                            "Qui peut être cadavérisé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e0aea7ce-4f3d-445d-b9e8-de7ace83387f",
                                "sense_id": "757dbef5-5430-31b9-8928-d9a49f2af034",
                                "text": "Le simulacre est le produit d’une réalité trafiquée. … Il n’est donc pas cadavérisable."
                            },
                            {
                                "example_id": "de959d75-8b2e-41a7-9bf7-1dfaecdf4b13",
                                "sense_id": "757dbef5-5430-31b9-8928-d9a49f2af034",
                                "text": "Dans certains cas c’est le corps lui-même qui devient cadavérisable, libérant la pensée de sa « mort conservée » : je pense ici notamment à l’hypocondrie, à cette « grossesse d’un enfant mort » selon la formulation de Pierre Fédida."
                            },
                            {
                                "example_id": "a7d3fffb-53cb-441a-aa6f-dbc6b370ff90",
                                "sense_id": "757dbef5-5430-31b9-8928-d9a49f2af034",
                                "text": "Toutefois, dans la clinique de l’informe, c’est souvent le corps du vivant qui devient lui-même cadavérisable."
                            }
                        ]
                    }
