            "senses": [
                {
                    "sense_id": "e68e201a-8415-38b6-9959-418c6d5d9285",
                    "sense_definition": "usunąć błędy lub usterki z czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "korekta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel szybko <w>poprawił</w> wszystkie błędy w wypracowaniu ucznia.",
                            "target_lang_translations": {
                                "ru": "Учитель быстро <w>исправил</w> все ошибки в сочинении ученика."
                            }
                        },
                        {
                            "text": "Muszę jeszcze raz sprawdzić ten tekst i <w>poprawić</w> błędy ortograficzne.",
                            "target_lang_translations": {
                                "ru": "Мне нужно ещё раз проверить этот текст и <w>исправить</w> орфографические ошибки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poprawić błąd",
                        "poprawić ocenę"
                    ],
                    "target_lang_definitions": {
                        "ru": "исправить ошибки или недостатки в чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправить",
                                "target_lang_sense_clarification": "ошибки, неточности, дефекты"
                            },
                            {
                                "target_lang_word": "поправить",
                                "target_lang_sense_clarification": "внести небольшие коррективы"
                            },
                            {
                                "target_lang_word": "скорректировать",
                                "target_lang_sense_clarification": "внести поправки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a738f961-75e3-362c-bfe0-d68944537638",
                    "sense_definition": "ułożyć coś staranniej, zmienić ułożenie czegoś na ciele lub w przestrzeni",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "korekta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wejściem do gabinetu dyrektora nerwowo <w>poprawił</w> krawat.",
                            "target_lang_translations": {
                                "ru": "Перед входом в кабинет директора он нервно <w>поправил</w> галстук."
                            }
                        },
                        {
                            "text": "Dziewczyna spojrzała w lustro i <w>poprawiła</w> fryzurę przed wyjściem.",
                            "target_lang_translations": {
                                "ru": "Девушка посмотрела в зеркало и <w>поправила</w> причёску перед выходом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poprawić krawat",
                        "poprawić włosy",
                        "poprawić okulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "уложить аккуратнее, изменить положение чего-либо на теле или в пространстве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправить",
                                "target_lang_sense_clarification": "одежду, волосы, очки"
                            },
                            {
                                "target_lang_word": "оправить",
                                "target_lang_sense_clarification": "одежду, складки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbc423e7-5b31-30ae-832f-950ae3888068",
                    "sense_definition": "sprawić, że coś staje się lepsze pod względem jakości, stanu lub samopoczucia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "polepszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciepła herbata z cytryną szybko <w>poprawiła</w> jej nastrój po ciężkim dniu.",
                            "target_lang_translations": {
                                "ru": "Тёплый чай с лимоном быстро <w>поднял</w> ей настроение после тяжёлого дня."
                            }
                        },
                        {
                            "text": "Nowy program ma na celu <w>poprawić</w> jakość życia mieszkańców miasta.",
                            "target_lang_translations": {
                                "ru": "Новая программа направлена на то, чтобы <w>улучшить</w> качество жизни жителей города."
                            }
                        }
                    ],
                    "common_phrases": [
