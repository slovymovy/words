                "senses": [
                    {
                        "sense_id": "b8cb082c-d5fe-3f7f-95ef-d3c1d4f439c7",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "To add numbers to (a folio or leaf, or all the folios or leaves, of a book); also, to add numbers to the folios or leaves of (a book); to folio, to page, to paginate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4a56e9e4-21fb-3695-a049-528882503129",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "To spread (glass) with a thin coat of mercury and tin, or other substances forming a foil, to create a mirror; to foil, to silver."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c04c7c07-ac8e-4e15-a54b-a8bdf793d1f0",
                                "sense_id": "4a56e9e4-21fb-3695-a049-528882503129",
                                "text": "to foliate a looking-glass"
                            },
                            {
                                "example_id": "989a7e2a-5076-42fd-9891-1ee947bb537b",
                                "sense_id": "4a56e9e4-21fb-3695-a049-528882503129",
                                "text": "[T]he production of the Rainbovv is as much to be aſcribed to the reflection of the concave ſurface of the air, as to the refraction of the Globular drops: this vvill be evidently manifeſt by theſe Experiments, if you foliate that part of a Glaſs-ball that is to reflect an Iris, as in the Carteſian Experiment, above mention'd, the reflections vvill be abundantly more ſtrong, and the colours more vivid: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "06bac49c-9ce7-3fd9-9f01-586aaddd516f",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "To decorate (an architectural feature, as an arch or window) with foils (“small arcs in the traceries of arches, windows, etc.”)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee1eb981-02d3-482a-869f-6c5b5c807949",
                                "sense_id": "06bac49c-9ce7-3fd9-9f01-586aaddd516f",
                                "text": "All European architecture, bad and good, old and new, is derived from Greece through Rome, and coloured and perfected from the East. […] Now observe: those old Greeks gave the shaft; Rome gave the arch; the Arabs pointed and foliated the arch."
                            }
                        ]
                    },
                    {
                        "sense_id": "00d6ed19-999a-375d-848c-d89d964c5cb1",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "To beat (metal) into a foil or thin sheet."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8b4c2dce-7f31-4ee8-a26e-77181da4da8f",
                                "sense_id": "00d6ed19-999a-375d-848c-d89d964c5cb1",
                                "text": "[I]f Gold be foliated and held betvveen your Eye and the Light, the Light looks blue, and therefore maſſy Gold lets into its Body the blue-making rays to be reflected to and fro vvithin it till they be ſtopt and ſtifled, vvhilſt it reflects the yellovv-making outvvards, and thereby looks yellovv."
                            }
                        ]
                    },
                    {
                        "sense_id": "25e24806-4e4e-3621-b537-71d4171fc5ca",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "To split into layers or leaves."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c836f4af-dd18-3281-850a-cca81e6ceffa",
                        "entry_id": "ac18f370-36df-3157-85e3-575d71bc4bc5",
                        "glosses": [
                            "Of a plant: to produce leaves."
                        ],
