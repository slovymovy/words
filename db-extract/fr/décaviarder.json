                "senses": [
                    {
                        "sense_id": "2ca48a58-0cd5-3018-838f-58b4eaf07071",
                        "entry_id": "19e0c55f-fe07-3890-8370-ceb84c232045",
                        "glosses": [
                            "Remettre dans un document (quelque chose qui avait été caviardé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0fac6c-6fd1-440f-9d31-fbf5a5aab4c2",
                                "sense_id": "2ca48a58-0cd5-3018-838f-58b4eaf07071",
                                "text": "Les avocats d’Ottawa ont convaincu la juge de la Cour fédérale qu’ils devaient « rafraîchir » les documents utilisés en preuve, c’est-à-dire décaviarder certains passages qui n’ont plus besoin d’être secrets."
                            },
                            {
                                "example_id": "4acd933b-b3fb-41f6-9c86-985dde6cf5ce",
                                "sense_id": "2ca48a58-0cd5-3018-838f-58b4eaf07071",
                                "text": "Elle est tirée du mandat de perquisition de l’AMF, que le tribunal a accepté de décaviarder un peu plus à la demande des médias."
                            }
                        ]
                    }
