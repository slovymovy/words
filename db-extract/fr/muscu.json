                    {
                        "sense_id": "6be79801-b2db-3ee3-932e-030c60cb7235",
                        "entry_id": "0859877d-e6a6-3f55-bff8-4e9366c244c9",
                        "glosses": [
                            "Musculation."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "711a804c-9e71-4744-9221-fddd6b3a084a",
                                "sense_id": "6be79801-b2db-3ee3-932e-030c60cb7235",
                                "text": "« Les mecs qui se moquent le plus des gens qui font de la muscu, ce sont les gens qui font de la muscu ! », s’amuse l’éditeur Grégoire Hellot, lui-même pratiquant à ses heures."
                            },
                            {
                                "example_id": "2edf3883-e62e-4b96-87dc-41be7e897301",
                                "sense_id": "6be79801-b2db-3ee3-932e-030c60cb7235",
                                "text": "À côté du riz basmati, de l’avocat, du skyr et d’autres ingrédients stars, elles se font petit à petit une place dans les conseils nutritionnels des influenceurs fitness et muscu, Sissy Mua et Tibo InShape en tête."
                            },
                            {
                                "example_id": "4bbae948-3b3a-4aee-89a5-fb8acaaf3517",
                                "sense_id": "6be79801-b2db-3ee3-932e-030c60cb7235",
                                "text": "Contacté sur le forum Meso-Rx, Marouane, 21 ans, vient quant à lui de faire le grand saut dans le vide, un an à peine après avoir commencé la muscu en raison « des moqueries sur [son] physique »."
                            },
                            {
                                "example_id": "429e7721-4596-4c2a-ae78-14710e295de3",
                                "sense_id": "6be79801-b2db-3ee3-932e-030c60cb7235",
                                "text": "Mon mari fait de la muscu. Il a de gros biscotos, qu’on voit poindre sous les manches de ce tee-shirt des Yankees."
                            }
                        ]
                    }
                ],
