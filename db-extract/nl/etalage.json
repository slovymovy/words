                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01de448a-9700-4118-a2c9-2705d4e18ba7",
                        "source_entry_id": "d773c9f8-3363-3956-babb-f03d8ebd2769",
                        "target_lang_word": "étalage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étalage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                        "entry_id": "892bac16-62d9-3beb-bf95-5d42db637ffd",
                                        "glosses": [
                                            "Exposition de marchandises qu’on veut vendre, ou ces marchandises elles-mêmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5721cc1-b2af-492d-a702-b5ea7d1acff3",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "Modeste vit à l’étalage d’un libraire le portrait lithographié d’un de ses favoris, de Canalis."
                                            },
                                            {
                                                "example_id": "e7fcdef1-1e1e-429e-b457-6729c2d9d0df",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "L’influence d’un étalage bien compris, comportant à la fois l’aspect tentateur de la marchandise savamment présentée et l’affichage d’un prix modique, est très grand sur la clientèle."
                                            },
                                            {
                                                "example_id": "05b62436-8ae6-4bc8-b50e-bbd7d2206646",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "Il fallait la voir regarder, de ses yeux bordés de rouge, les étalages des bas de soie brodés, et les chapeaux joliment chiffonnés, qui, chez les modistes, se dressent fièrement au haut des champignons de palissandre !"
                                            },
                                            {
                                                "example_id": "9eb81c9c-875a-4993-969b-4bed1c11fdde",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "Les attifages des riches, sans cesse transformés par ceux qui exploitent leur snobisme, sont immédiatement exposés dans les villes en des milliers d’étalages, à la convoitise de celles qui rêvent de se comparer aux plus enviées."
                                            },
                                            {
                                                "example_id": "55da1db1-9ce8-4757-9c94-cc5eb0c4e818",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "J’ai donc repris la file des passants […] et nous avançâmes par saccades à cause des boutiques dont chaque étalage fragmentait la foule."
                                            },
                                            {
                                                "example_id": "e45b6a2f-40fa-4b27-b96f-59de84fcdff0",
                                                "sense_id": "5bc5236a-02c8-335f-a5f6-2712ca6bd03a",
                                                "text": "Mais il y a aussi le flot ininterrompu des brochures et opuscules sur l’islam qui encombrent les kiosques et les étalages de livres sur les trottoirs des grandes villes d’Égypte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc17452-3599-3cfa-a694-475d54d6ee38",
                                        "entry_id": "892bac16-62d9-3beb-bf95-5d42db637ffd",
                                        "glosses": [
                                            "Marchandises qu’on étale, qu’on déploie pour servir de montre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b8f295-7de4-4ab9-a682-e8d04430ad73",
                                                "sense_id": "8dc17452-3599-3cfa-a694-475d54d6ee38",
                                                "text": "Ce magasin n’a de beau que l’étalage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab71040-bb6b-34e1-b853-fe98443aaad9",
                                        "entry_id": "892bac16-62d9-3beb-bf95-5d42db637ffd",
                                        "glosses": [
                                            "Tout ce dont on fait parade par vanité, par ostentation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f87b34-3a19-490e-b278-1b509ac97e8f",
                                                "sense_id": "eab71040-bb6b-34e1-b853-fe98443aaad9",
                                                "text": "Malgré tout cet étalage de loyauté, dit Ivanhoé au comte d’Essex, il est fort heureux que le roi ait eu la précaution de t’emmener avec lui, ainsi que tant de ses braves soldats."
                                            },
                                            {
                                                "example_id": "f3ac5f43-d801-4cfa-9976-d53b1f59231f",
                                                "sense_id": "eab71040-bb6b-34e1-b853-fe98443aaad9",
                                                "text": "L'autopsie. Pourquoi faire ? Tous les poulets et pandores du Calvados ont déjà identifié le Vieux Marlou à son étalage de ratiches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93595f5-4fc0-3d23-93d2-6fb4baeaa5ec",
                                        "entry_id": "892bac16-62d9-3beb-bf95-5d42db637ffd",
                                        "glosses": [
                                            "Action d’étaler une chose."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffcb9740-1f82-46de-96ff-c0c1fb8e39dd",
                                                "sense_id": "d93595f5-4fc0-3d23-93d2-6fb4baeaa5ec",
                                                "text": "L’étalage à la main de la laine sur le tablier sans fin peut présenter des inconvénients au point de vue de la régularité de la nappe à carder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756837a5-8f66-3ae0-945f-b823509ac40d",
                                        "entry_id": "892bac16-62d9-3beb-bf95-5d42db637ffd",
                                        "glosses": [
                                            "Partie d’un haut fourneau. (plus courant au pluriel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69059b99-9d8d-4293-be17-c953b4cfdea3",
                                                "sense_id": "756837a5-8f66-3ae0-945f-b823509ac40d",
                                                "text": "Dans les étalages, il a été démontré qu’avec une conduite moderne, les conditions thermiques fluctuent raisonnablement et que l’usure est dominée par les attaques chimiques."
                                            }
                                        ]
                                    }
                                ]
                            },
