                    {
                        "translation_id": "a07becf7-e793-42d1-baf1-d208b12bdd78",
                        "source_entry_id": "c4245ffc-bf16-3d88-b5fb-66af86bf5e7f",
                        "source_sense_id": "477b224a-dfe4-37cb-8c34-065242f99acd",
