                            {
                                "example_id": "d03d8779-5e19-4494-9d85-1af8f32440bc",
                                "sense_id": "7ac3a3b4-67c8-39fd-9736-c3fe230ec08b",
                                "text": "'De huidige boekenmarkt wordt gekenmerkt door een select aantal bestsellerauteurs en verder een heleboel schrijvers die amper iets aan hun boeken verdienen. Veel uitgevers hebben als verdienmodel om boeken al heel snel te verramsjen, dan blijft er voor auteurs niets meer over."
                            },
                            {
                                "example_id": "b3c55aca-ce04-4ee8-af60-e422de79f7a2",
                                "sense_id": "7ac3a3b4-67c8-39fd-9736-c3fe230ec08b",
                                "text": "Sinds de dood drie jaar geleden van Appie Baantjer, geestelijk vader van De Cock, ontfermt Peter Römer zich over het culturele erfgoed dat de schrijver naliet. „Ik maak me druk over Baantjer”, erkent Peter, die zondag 61 jaar werd. „Het is nationale trots die nooit mag worden verramsjt!”"
                            }
