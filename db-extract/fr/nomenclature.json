        "fr-extract.jsonl": [
            {
                "entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                "word": "nomenclature",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b30bb03d-df7c-403b-b6c2-d6b6f851ac9e",
                        "entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                        "tags": [
                            "plural"
                        ],
                        "form": "nomenclatures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32ab404b-2e22-3589-b046-984b02c03df5",
                        "entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                        "glosses": [
                            "Système des noms employés pour désigner les différents objets d’une science ou d’un art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c14c8e-11b3-4255-87a7-f95ece638f02",
                                "sense_id": "32ab404b-2e22-3589-b046-984b02c03df5",
                                "text": "Ce résultat est inévitable, et nous nous serons inutilement mis en frais de nomenclature géographique !"
                            },
                            {
                                "example_id": "b0070a53-2142-4f9e-9b11-91e5e54af826",
                                "sense_id": "32ab404b-2e22-3589-b046-984b02c03df5",
                                "text": "Celui qui ne connaît d’un animal que le nom et la place qui lui revient dans un système de nomenclature plus ou moins bien assis, ne mérite pas plus le titre de naturaliste qu’un garçon de bibliothèque n’est digne de l’épithète de savant […]."
                            },
                            {
                                "example_id": "bf505411-7ae7-4208-8a50-bdad89c0f0e3",
                                "sense_id": "32ab404b-2e22-3589-b046-984b02c03df5",
                                "text": "Pour lui, toutes les formes qu'il faut distinguer les unes des autres, et qui se maintiennent dans son jardin, sont des espèces : c'est ce qu'on appelle le Jordanisme.\nLe Jordanisme, on le voit, n'est qu'une des conséquences de la nomenclature binaire."
                            },
                            {
                                "example_id": "4211069a-fa9c-4818-9658-aaf1992fe721",
                                "sense_id": "32ab404b-2e22-3589-b046-984b02c03df5",
                                "text": "Sous l’appellation unique de mécanographes, l’I.N.S.E.E. englobe dans sa nomenclature les diverses tâches qui relèvent de la technique mécanographique : […], etc. C'est ce poste unique que nous avons dû conserver."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfef2e7a-f8b3-3727-9652-041969c82eb4",
                        "entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                        "glosses": [
                            "Ensemble des mots qui composent un dictionnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c414907e-124e-443c-ba74-f8a8b0cde1a2",
                                "sense_id": "cfef2e7a-f8b3-3727-9652-041969c82eb4",
                                "text": "La nomenclature de ce dictionnaire n’est pas exacte, n’est pas complète."
                            }
                        ]
                    },
                    {
                        "sense_id": "8064cf77-cd62-3f62-839a-53d5adce14e6",
                        "entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                        "glosses": [
                            "Liste des pièces représentées sur un plan d’ensemble, comportant pour chaque pièce le repère (numéro d’identification), la quantité, le matériau (« matière ») et le cas échéant une référence."
                        ],
                        "tags": [
                            "Dessin industriel"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeea64e0-5be7-4c42-9ab7-ab1abd90bdce",
                        "source_entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
                        "target_lang_word": "Nomenklatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nomenklatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf74030-24f6-3c5a-8049-baba9e9dd2ee",
                                        "entry_id": "9d342892-4d7f-3162-9699-fbff52fe3c52",
                                        "glosses": [
                                            "System der (allgemein) gültigen Fachausdrücke und Namen eines Fachgebietes oder Wissenschaftszweiges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f75074f-d4fb-42da-80bb-3262ed389989",
                                                "sense_id": "eaf74030-24f6-3c5a-8049-baba9e9dd2ee",
                                                "text": "Carl von Linné gilt mit seinem 1735 veröffentlichten Werk „Systema naturae“ als Begründer moderner wissenschaftlicher Nomenklatur."
                                            },
                                            {
                                                "example_id": "bbb9232e-23bd-48f6-90fe-cda70015edfc",
                                                "sense_id": "eaf74030-24f6-3c5a-8049-baba9e9dd2ee",
                                                "text": "Dieser Chefastrologe sprach mit der größten Ernsthaftigkeit vom Wechselspiel zwischen den Planetenkonstellationen und der Weltgeschichte, und er bediente sich dafür einer überaus scholastischen Nomenklatur."
                                            },
                                            {
                                                "example_id": "f761c9b5-54c2-4020-bce9-2758af4dd15d",
                                                "sense_id": "eaf74030-24f6-3c5a-8049-baba9e9dd2ee",
                                                "text": "Wie bodenständig es in der B-Klasse zugeht, beweist Mercedes schon mit der Wahl der Nomenklatur für die Innenausstattungen: Diese tragen Bezeichnungen wie Den Helder, Venlo oder Domburg, also niederländische Städtenamen."
                                            },
                                            {
                                                "example_id": "064bdbb9-a28a-4575-902f-39ebf4ff5cea",
                                                "sense_id": "eaf74030-24f6-3c5a-8049-baba9e9dd2ee",
                                                "text": "„Obwohl Otto Lilienthal sein Fluggerät bereits Flugzeug nannte, war es in heutiger Nomenklatur ein Hängegleiter, ein durch Gewichtsverlagerung des Piloten gesteuertes Fluggerät."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01467d81-b1ba-353b-a142-5378f93a51f2",
                                        "entry_id": "9d342892-4d7f-3162-9699-fbff52fe3c52",
                                        "glosses": [
                                            "Verzeichnis der (allgemein) gültigen Fachausdrücke und Namen eines Fachgebietes oder Wissenschaftszweiges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f51548e-bbea-4b52-ac34-696e0d757f65",
                                                "sense_id": "01467d81-b1ba-353b-a142-5378f93a51f2",
                                                "text": "Biologen oder Paläontologen benutzen häufig die Nomenklatur „International Code of Zoological Nomenclature“."
                                            },
                                            {
                                                "example_id": "858d86e8-e77f-455f-bda6-8109d767b1d7",
                                                "sense_id": "01467d81-b1ba-353b-a142-5378f93a51f2",
                                                "text": "Erst vor wenigen Jahren haben sich die Hirnforscher von Edingers Nomenklatur verabschiedet, die von urtümlichen Vorsilben wie »paleo-« und »archeo-« strotzte, und moderne Namen für das Vogelgehirn eingeführt."
                                            },
                                            {
                                                "example_id": "3b7429da-7d33-4b70-8837-71f2fa78d02e",
                                                "sense_id": "01467d81-b1ba-353b-a142-5378f93a51f2",
                                                "text": "Gesondert aufzuführen sind insbesondere Angaben über Einzelchromosomen gemäß der Pariser Nomenklatur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7674c3ca-62cc-4074-bf83-7bcf581a0e27",
                        "source_entry_id": "91b63510-78d5-3d7d-9d92-fcf1d7984dd8",
