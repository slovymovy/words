                    }
                ],
                "translations": [
                    {
                        "translation_id": "76afc967-e71a-4847-9497-8a5156c6f3e3",
                        "source_entry_id": "079b512a-0e34-38a0-bd71-538792503837",
                        "target_lang_word": "psychologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                        "entry_id": "36101ee3-f286-36d4-b962-273ca7f546c7",
                                        "glosses": [
                                            "An expert in the field of psychology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc10a0c-9a0d-43ea-ac56-7c6b0c4ae086",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "In 2009, the Obama Administration released guidelines on enhanced interrogation written in 2003 and 2004 by the CIA Office of Medical Services. ^((OMS).1-3(appendix F)) The OMS guidelines, even in redacted form, and opinions from the US Department of Justice's (DOJ’s) Office of Legal Counsel show that CIA physicians, psychologists, and other health care personnel had important roles in enhanced interrogation."
                                            },
                                            {
                                                "example_id": "1630121e-1cb8-4117-bc64-64ec776e1d7a",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "Investigating why IBM salespeople were so successful, researchers found that IBM set easy targets for their salespeople rather than targets that were difficult to reach and so most of their salespeople achieved their targets. IBM had hired psychologists to define optimum motivational goals for their salespeople and it was discovered that if the targets were achievable the salespeople became very confident and motivated (unlike their demotivated cousins in rival companies) and went out and sold even more computers."
                                            },
                                            {
                                                "example_id": "6ebd5c8d-7122-4a01-8396-f6313e7031f0",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "Self-help programs can give people the nudge they need to see a psychologist or encourage healthy changes, but that is not always the case, experts say. […] Redding’s study asked four psychologists with expertise in anxiety and depressive disorders to rate each self-help book on five criteria: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14a4bffa-933d-49e3-9300-2224ed41c6de",
                        "source_entry_id": "079b512a-0e34-38a0-bd71-538792503837",
                        "target_lang_word": "psicologo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psicologo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "36bdd5df-499d-3cf1-ab2a-6a8a98f939ca",
                                        "entry_id": "c4906313-237d-3aa4-a0a9-6780c438ae2c",
                                        "glosses": [
                                            "chi si occupa per studio o professione di psicologia"
                                        ],
                                        "tags": [
                                            "professione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e944016f-04b8-4919-9404-d571fec67589",
                                                "sense_id": "36bdd5df-499d-3cf1-ab2a-6a8a98f939ca",
                                                "text": "già presente in Toscana e Campania, “lo psicologo di base” è un professionista del sistema sanitario italiano"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5faf0ec4-4344-4b61-91f9-46ad370a78ad",
                        "source_entry_id": "079b512a-0e34-38a0-bd71-538792503837",
                        "target_lang_word": "Psychologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                        "entry_id": "dedfefcb-bb36-38d5-ba5e-e19292091a91",
                                        "glosses": [
                                            "jemand, der ein Studium der Psychologie, der Wissenschaft vom Erleben und Verhalten des Menschen, erfolgreich abgeschlossen hat"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6a2728a-92d3-4f23-99eb-b4215d9c8573",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Wiegt das Interesse an der Geheimhaltung bestimmter Tatsachen weniger als der Schutz von Leben, Gesundheit etc., darf der Psychologe die Verschwiegenheitspflicht brechen.“"
                                            },
                                            {
                                                "example_id": "78d767ed-4a68-49ff-a285-ad4e82fffbbc",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Um dem abzuhelfen, machten sich Soziologen, Analytiker, Gynäkologen, Psychologen und diverse Sachbuchautoren an die Arbeit.“"
                                            },
                                            {
                                                "example_id": "6c0a7ea1-ddba-49cc-8f9a-72cdd7f1b819",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„In einem berühmten Experiment ließ ein Psychologe jedesmal eine Glocke erklingen, wenn er einem Hund Futter gab.“"
                                            },
                                            {
                                                "example_id": "5123100f-b585-4f81-a4d1-06e1127059ee",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Ähnliche Modelle der transgenerationalen Weitergabe erkannten Psychologen später bei den Kindern der Vietnam-Krieg-Veteranen und den Kindern von Kriegsflüchtlingen, zum Beispiel aus dem Kosovo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f53ee8-b0ca-4e1d-ac22-189ee0d307ae",
                        "source_entry_id": "079b512a-0e34-38a0-bd71-538792503837",
