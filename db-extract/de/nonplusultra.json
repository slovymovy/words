                        ]
                    },
                    {
                        "translation_id": "cd206790-e2ff-4cf0-83cf-65f1338b630d",
                        "source_entry_id": "1e135f58-c188-3d06-a838-266551790ae6",
                        "source_sense_id": "913adab9-2fc4-3760-8a8f-88967b7862ed",
                        "source_sense_description": "etwas, das nicht mehr zu übertreffen ist, das Allerbeste",
                        "target_lang_word": "nec plus ultra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nec plus ultra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d0a6a7b-9af5-3839-9e4d-be6122009818",
                                        "entry_id": "a9e5177e-af52-3a1b-afde-23ce92d30b8b",
                                        "glosses": [
                                            "Limite spatiale ou matérielle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7bb7e8-703f-49ec-b5b4-ad9d159fd1a8",
                                                "sense_id": "2d0a6a7b-9af5-3839-9e4d-be6122009818",
                                                "text": "Il y a une limite qu’on ne franchit pas. À Cadix et devant Murillo, Horace Vernet rencontra cette limite, son nec plus ultra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                        "entry_id": "a9e5177e-af52-3a1b-afde-23ce92d30b8b",
                                        "glosses": [
                                            "Degré le plus haut ; ce qu’il y a ou ce qui se fait de mieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff67862c-f71a-47f7-9a64-715f3d37f11c",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "Il y a dans les Marrons du feu une feuille qui ne contient que treize syllabes ; c’est le nec plus ultra du genre, et il n’est pas donné à beaucoup de s’élever à cette hauteur."
                                            },
                                            {
                                                "example_id": "446675bd-72ad-4071-9160-3ba0e56e2721",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "— C’est antique, mademoiselle, fit observer le marchand qui, semblable à tous ses confrères, croyait avoir tout dit avec ce nec plus ultra du bric-à-brac."
                                            },
                                            {
                                                "example_id": "14933c78-b226-45c2-aee8-90ed4c397406",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "Le goût est la qualité fondamentale qui résume toutes les autres qualités. C’est le nec plus ultra de l’intelligence."
                                            },
                                            {
                                                "example_id": "6f282216-0565-4c33-999f-2754a6d1a1a0",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "Bien sûr vous avez commencé votre visite par la salle des fêtes, mais Patelin vaut vraiment le détour, puisque dans le genre, c'est le nec plus ultra des trous paumés."
                                            },
                                            {
                                                "example_id": "3eaf0e1f-8e8c-4e44-b887-498ac224f8f6",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "Représentant 10 % des quelque six millions de jambons ibériques produits chaque année, l’étiquette noire est considérée comme un produit de luxe et le nec plus ultra de l’appellation (au minimum quatre fois plus cher que l’entrée de gamme)."
                                            },
                                            {
                                                "example_id": "da217d9e-25e4-4053-9642-f8f432d47cc3",
                                                "sense_id": "3bb60562-f37f-399b-a0dc-cfd9345d4fd0",
                                                "text": "Pour lui, l’approche narrative de Lubitsch était le nec plus ultra en matière d’élégance, d’astuce et de subtilité, sous-tendues par une espèce de léger cynisme qui était la quintessence de l’esprit d’Europe centrale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
