                "senses": [
                    {
                        "sense_id": "db251341-cc4f-39dd-b2ac-fbbdbb9f6330",
                        "entry_id": "e712c8eb-996b-3e83-93bc-e01909b29367",
                        "glosses": [
                            "The act of revolving."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9bdfa1fe-35c0-4b0d-9f64-e8d59071372f",
                                "sense_id": "db251341-cc4f-39dd-b2ac-fbbdbb9f6330",
                                "text": "In the Arab World, an area considered by Western powers as their preserve, nonalignment meant the termination of revolvement in their orbit ."
                            },
                            {
                                "example_id": "a84fb25d-59b7-4534-8fb4-cdadb47bf256",
                                "sense_id": "db251341-cc4f-39dd-b2ac-fbbdbb9f6330",
                                "text": "You will see them but not before your own world intensifies its outer eccentric movement or revolvement."
                            },
                            {
                                "example_id": "85e06765-947e-4440-a33b-e81ac4a841df",
                                "sense_id": "db251341-cc4f-39dd-b2ac-fbbdbb9f6330",
                                "text": "This angular revolvement shows the parallax movement of sun."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3197547-b943-3505-a200-19d17c59a466",
                        "entry_id": "e712c8eb-996b-3e83-93bc-e01909b29367",
                        "glosses": [
                            "The time period from when credit in a revolving credit account is granted until the point when it is due or up for renewal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "671287d7-62c7-4fde-8015-1684c69d8c72",
                                "sense_id": "b3197547-b943-3505-a200-19d17c59a466",
                                "text": "In case of a non-automatic revolving credit, the issuing bank must amend the credit each time a revolvement is due."
                            },
                            {
                                "example_id": "70d7ac86-86da-46e9-a329-5930e45e8c40",
                                "sense_id": "b3197547-b943-3505-a200-19d17c59a466",
                                "text": "When the revolvement is automatic there is no requirement for any amendment from the issuing bank."
                            },
                            {
                                "example_id": "6c7f530c-186b-4d14-bf2f-38d3c22263bb",
                                "sense_id": "b3197547-b943-3505-a200-19d17c59a466",
                                "text": "A revolving credit may also be cumulative. In such instances, any undrawn balance in one revolvement is carried forward to the next."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ca32a4f-d1ce-3507-b8b3-f14c6b472fbb",
                        "entry_id": "e712c8eb-996b-3e83-93bc-e01909b29367",
                        "glosses": [
                            "The distribution of equity capital to members of a cooperative, based on their participation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dde466b8-4ff6-4fd5-894b-ecabdca436ac",
                                "sense_id": "3ca32a4f-d1ce-3507-b8b3-f14c6b472fbb",
                                "text": "Mid-America Dairymen Inc, Springfield, MO, has announced revolvement of nearly $3.1 million in equity capital to its 13,000 member families, brining total equity returned to members in 1992 to more than $11.6 million."
                            },
                            {
                                "example_id": "ad878731-9349-4128-b63d-b585a5ebfd28",
                                "sense_id": "3ca32a4f-d1ce-3507-b8b3-f14c6b472fbb",
                                "text": "The bylaws of the institution clearly provide that there is no express or implied right for such capital to be retired at the end of the revolvement cycle or at any other time ;"
                            },
                            {
                                "example_id": "4d152c28-4a74-424c-aa72-cd1e601c9d7a",
                                "sense_id": "3ca32a4f-d1ce-3507-b8b3-f14c6b472fbb",
                                "text": "Unfortunately, the Cooperative will not keep pace with its growing mound of allocated equity, in which case the board of directors must either lengthen the revolvement cycle or borrow long term debt to shore-up and maintain the Cooperative's liquidity position, both of which weaken value proposition for patrons ."
                            }
                        ]
                    }
