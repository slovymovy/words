                ],
                "senses": [
                    {
                        "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                        "entry_id": "51fd65a8-415e-3b92-ba69-8ca10d4e7b6b",
                        "glosses": [
                            "heimlicher, nur wenigen bekannter Weg, der abseits der großen, bekannten Straßen verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9596d1-90da-43c5-a6da-fb6229dd5c83",
                                "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                                "text": "An Silvester achtet die Polizei auch auf Wagen, die Schleichwege benutzen."
                            },
                            {
                                "example_id": "1e5382f5-c3a6-47cf-a32d-536bcf3ef088",
                                "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                                "text": "Der Schleichweg erwies sich im Nachhinein als Sackgasse."
                            },
                            {
                                "example_id": "8c4373bf-c711-460f-b5c3-6f160ab3a83a",
                                "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                                "text": "Da vorne kommt gleich eine Baustelle, lass uns doch hier abbiegen und den Schleichweg nach Handorf nehmen."
                            },
                            {
                                "example_id": "1fe433f4-be68-46b4-ae97-d9707060482b",
                                "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                                "text": "Dieses Löwenfell ist sicherlich auf Schleichwegen ins Land gekommen."
                            },
                            {
                                "example_id": "3c1c054c-85af-4d4c-ad0a-73d41eaf2bc8",
                                "sense_id": "26847dc3-bbbf-37fc-905a-e705e4ce5d31",
                                "text": "„Als Fahrer werden sie nicht mehr gebraucht; sie wollen, verständlich genug, zu ihren Familien zurückkehren, und zu Fuß, auf Schleichwegen durch das Leba-Moor hindurch, rechnen sie sich bessere Chancen aus als mit Pferd und Wagen auf der Chaussee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
