                        "entry_id": "1ea41920-34f0-321e-81b9-9df46167aa54",
                        "glosses": [
                            "The property of being, or that which causes something to be, resplendent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8796bd92-9673-485e-9773-72bfdc493c9c",
                                "sense_id": "32f84f87-881d-3cf1-887b-f54d1fb48994",
                                "text": "Son! thou in whom my glory I behold / In full resplendence, heir of all my might."
                            },
                            {
                                "example_id": "34700ed7-46ba-4845-9462-c7ad9f199414",
                                "sense_id": "32f84f87-881d-3cf1-887b-f54d1fb48994",
                                "text": "The sun above gleams like a shining jewel, but even its brightness is nothing compared to the resplendence of the Empire."
                            }
                        ]
                    }
                ],
