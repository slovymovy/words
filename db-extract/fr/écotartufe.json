                    {
                        "sense_id": "1c2d4527-9c38-39e6-a3cd-5cd69a33731e",
                        "entry_id": "87cad55e-ed9e-36dd-8338-c7d4334cf264",
                        "glosses": [
                            "Personne qui ne met pas en concordance ses actes et son discours sur le plan écologique, écolo beau parleur, hypocrite."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c2db2d-4b76-4a49-b753-7728639caea5",
                                "sense_id": "1c2d4527-9c38-39e6-a3cd-5cd69a33731e",
                                "text": "En parlant d'écotartufe, mon voisin, il se pose là ! Il se dit écolo à qui veut l'entendre mais il faut voir l'état de son jardin."
                            },
                            {
                                "example_id": "f4e01557-224a-481d-9e59-bd638918379e",
                                "sense_id": "1c2d4527-9c38-39e6-a3cd-5cd69a33731e",
                                "text": "Il ne me viendrait pas à l’esprit de traiter Vincent Cheynet d’écotartufe au motif qu’il a accepté d’intervenir (à mes côtés) à une assemblée de rentrée du PS « productiviste » dans le Nord, ni de reprocher à Yves Cochet ou à Paul Ariès d’être allés parler de la décroissance au MEDEF."
                            }
                        ]
                    }
