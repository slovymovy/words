                                        "entry_id": "2970aace-d00c-35d9-8323-aca1d3ca0190",
                                        "glosses": [
                                            "An unattractive or ugly person."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fa5a820-9d6d-4db4-918a-d6efcbd81ede",
                                                "sense_id": "2fa237d6-340e-3d47-bd96-f4616b79fbb3",
                                                "text": "Mike's new bird's a right minger! I wouldn't touch her with yours, mate!"
                                            },
                                            {
                                                "example_id": "766f1efa-ffe4-45a6-b907-3b50b3b85e94",
                                                "sense_id": "2fa237d6-340e-3d47-bd96-f4616b79fbb3",
                                                "text": "Two suits [destroyed] in one day! Look at it, thanks to you, I couldn't even get on the cover of Minger Monthly!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
