                "senses": [
                    {
                        "sense_id": "071d5dea-52b4-3774-bdaf-dbd4c47e4e20",
                        "entry_id": "8502421f-a225-334f-9516-40f7ca0599c3",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным дракон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f06bfc-cfea-4560-97cf-9962f5e39044",
                                "sense_id": "071d5dea-52b4-3774-bdaf-dbd4c47e4e20",
                                "text": "Вот оно ― драконье привидение в лилиях и с Лордовским глазом."
                            }
                        ]
                    },
                    {
                        "sense_id": "587bbb49-f020-3394-9570-b457d15ae69a",
                        "entry_id": "8502421f-a225-334f-9516-40f7ca0599c3",
                        "glosses": [
                            "свойственный или принадлежащий дракону"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e71e284-6cf7-47cc-a99d-d5d1ce56bf0f",
                                "sense_id": "587bbb49-f020-3394-9570-b457d15ae69a",
                                "text": "Хальдора кольнуло раскаяние, и он прижался к тяжелому драконьему боку."
                            }
                        ]
                    }
                ],
                "translations": [
