                    {
                        "sense_id": "438c45de-abaf-3c30-a3b9-0b01c59a93a6",
                        "entry_id": "d97fabce-4022-33a4-9366-a1bf0bd6d6e7",
                        "glosses": [
                            "Peuple gaulois ayant vécu dans un territoire couvrant une partie des départements français de la Drôme, de l’Isère, des Hautes-Alpes, des Alpes-de-Haute-Provence et du Vaucluse."
                        ],
                        "tags": [
                            "Celtologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4aa5a13b-70bb-41ee-a1cb-08c225498143",
                                "sense_id": "438c45de-abaf-3c30-a3b9-0b01c59a93a6",
                                "text": "Les Voconces ou Vocontiens, — on appelait ainsi les habitants de la vallée de la Drôme et d’autres vallées voisines, — avaient alors la passion des tauroboles, sacrifices des taureaux."
                            },
                            {
                                "example_id": "ce9e6f65-8a0e-4014-a6ac-0d03a4ae33bb",
                                "sense_id": "438c45de-abaf-3c30-a3b9-0b01c59a93a6",
                                "text": "Aymar du Périer, citoyen de Die, conseiller au parlement de Grenoble, dans son Discours historique touchant l’estat général des Gaules, a donné la première notice sur les Vocontiens."
                            }
                        ]
                    }
