                        "examples": [
                            {
                                "example_id": "e847ce8a-636a-443e-953d-23200f8480b4",
                                "sense_id": "698ee0ea-e631-3a3d-a32e-6800c517df56",
                                "text": "Erzgebirgisch: Gieh fei wag!",
                                "translation": "Geh auf jeden Fall weg! (vorsichtshalber)"
                            },
                            {
                                "example_id": "d449a2be-2402-484d-8819-619235700f85",
                                "sense_id": "698ee0ea-e631-3a3d-a32e-6800c517df56",
                                "text": "Sieh fei zu, dass de dei Zimmer aufreimst!",
                                "translation": "Sieh nur zu, dass du dein Zimmer aufräumst!"
                            }
                        ],
                        "sense_index_json": "\"2\""
