                ],
                "senses": [
                    {
                        "sense_id": "e40a1a17-9fde-3113-b3a2-de5560689eff",
                        "entry_id": "8d0e0886-8e22-3be0-acf7-6de89b65a5df",
                        "glosses": [
                            "Bourdonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c44d5e-1385-4edc-9a1b-f9e50a83cb3a",
                                "sense_id": "e40a1a17-9fde-3113-b3a2-de5560689eff",
                                "text": "Les mouches à charogne, de grosses voumas bleues, vertes et noires, bombillaient sur la plaie tuméfiée et suintante qu’il leur offrait et s’y gobergeaient de sérosités."
                            },
                            {
                                "example_id": "23a61a3a-2f8f-4ab5-9bf0-9b6bb6cdc1c6",
                                "sense_id": "e40a1a17-9fde-3113-b3a2-de5560689eff",
                                "text": "Dès que je t’aperçus, le courant de glace se remit à gronder, la mer à mugir, les bourdons à bombiller, et le silence avait disparu."
                            },
                            {
                                "example_id": "003f6828-a728-4d48-bb8d-37ba4d0d6339",
                                "sense_id": "e40a1a17-9fde-3113-b3a2-de5560689eff",
                                "text": "Elle avait entendu entendu le sifflement des avions au-dessus d’elle, ce bruit qui démolissait les nerfs, comme lorsqu’un moustique ne cesse de bombiller et grésiller."
                            }
                        ]
                    }
                ],
