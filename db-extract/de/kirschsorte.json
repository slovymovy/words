                        "examples": [
                            {
                                "example_id": "c2c6e9b6-7471-4b59-9285-d38a64627aa1",
                                "sense_id": "3683c9b5-011c-3cf7-9938-e098d76c6101",
                                "text": "„Obwohl in Tokio bereits früh blühende Kirschsorten in voller Blüte stehen, beginnt die offizielle Sakura-Saison erst mit der Blütezeit der weitverbreiteten Somei-Yoshino-Sorte, die sich durch sehr blass rosafarbene, fast weiße Blütenblätter auszeichnet.“"
                            },
                            {
                                "example_id": "414faa44-5bd5-48ea-b0da-8634fed44084",
                                "sense_id": "3683c9b5-011c-3cf7-9938-e098d76c6101",
                                "text": "„Auf terrassenförmigen Obstwiesen wachsen Oliven- und Pfirsichbäume sowie etliche Kirschsorten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
