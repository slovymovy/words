                ],
                "senses": [
                    {
                        "sense_id": "eee0a358-5a68-3f2f-bbf3-77cede911b77",
                        "entry_id": "d89ab139-0053-33fe-8d7b-9d0cc954bf96",
                        "glosses": [
                            "Schreibkundiger, der in einer Stadt Schreibarbeiten für öffentliche Belange durchführte"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "d531fe17-9dc5-4780-a38e-ec3e35665089",
                                "sense_id": "eee0a358-5a68-3f2f-bbf3-77cede911b77",
                                "text": "„Das Amt des Stadtschreibers verlangte also zunächst die Kenntnis der lateinischen Muster und die Beherrschung der lateinischen Schreibkunst.“"
                            },
                            {
                                "example_id": "4d216317-2dd1-4dbc-a8ab-91bb8dc0e8c8",
                                "sense_id": "eee0a358-5a68-3f2f-bbf3-77cede911b77",
                                "text": "„Man muss bedenken, dass Wielands Stelle als Stadtschreiber noch alles andere als sicher war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "281f044f-0c94-336f-bb0a-07b29ce4afaa",
                        "entry_id": "d89ab139-0053-33fe-8d7b-9d0cc954bf96",
                        "glosses": [
                            "Schriftsteller, der von einer Stadt ausgewählt wird, um vorübergehend in ihr zu leben und stadtbezogen zu schreiben"
                        ],
                        "tags": [
                            "heute"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b08841-a1de-46c7-9c93-fd5947a60cc2",
                                "sense_id": "281f044f-0c94-336f-bb0a-07b29ce4afaa",
                                "text": "Zu den Städten, die einen Stadtschreiber auswählen, gehört Mainz."
                            },
                            {
                                "example_id": "06029f1f-7a09-41d8-8dc3-f3627ab90351",
                                "sense_id": "281f044f-0c94-336f-bb0a-07b29ce4afaa",
                                "text": "„Diese Jury hat sich dann für Wolfgang Koeppen als ersten Stadtschreiber entschieden.“"
                            },
                            {
                                "example_id": "0fc01685-97ca-45ad-b8c8-6f8dc78bbe0a",
                                "sense_id": "281f044f-0c94-336f-bb0a-07b29ce4afaa",
                                "text": "„Sie war Stadtschreiberin in Kitzbühel, er Stadtschreiber in Graz, beide waren sie schon beim Bachmann-Wettlesen in Klagenfurt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
