                        "glosses": [
                            "De manière kabbalistique, en recourant à la kabbale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2812752c-1f66-471f-904b-6d8e96dc4bac",
                                "sense_id": "0b9348e6-30f9-3b26-8ebc-5f45c2438728",
                                "text": "La Gloire divine est ainsi désignée kabbalistiquement comme le \"Cœur du ciel\"."
                            },
                            {
                                "example_id": "e05bdde4-453c-436f-a313-af879fa0901b",
                                "sense_id": "0b9348e6-30f9-3b26-8ebc-5f45c2438728",
                                "text": "Prononcer kabbalistiquement le nom d’AGLA, c’est donc subir toutes les épreuves de l’initiation et en achever toutes les œuvres."
                            },
                            {
                                "example_id": "18ea651d-43bc-4d8b-8515-dc33c5a06b94",
                                "sense_id": "0b9348e6-30f9-3b26-8ebc-5f45c2438728",
                                "text": "Son Diable amoureux, où la passion est kabbalistiquement analysée, suffit à lui assurer l’estime et la sympathie, non l’admiration des adeptes."
                            }
                        ]
                    }
