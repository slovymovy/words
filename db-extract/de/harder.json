                ],
                "senses": [
                    {
                        "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                        "entry_id": "10c8846d-ebbb-32ca-8ce9-dafa109a7983",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597a37e0-76a6-4567-b1bb-c40d2cf2a67a",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Harder kommt und geht."
                            },
                            {
                                "example_id": "f3bf15a3-bd39-44fa-a84c-dac05586adce",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Harders kamen, sahen und siegten."
                            },
                            {
                                "example_id": "0fd73d29-dea9-41fa-9a3b-680b18555ff6",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Frau Harder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "46a85990-7880-4690-bd6b-e17d5c437a6a",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Herr Harder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "227eb5b8-8304-4ec6-a6a2-1543943ab476",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Die Harders fahren heute nach Lübeck."
                            },
                            {
                                "example_id": "2a20adff-ec9d-475f-9e78-8d3569bfcf10",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Der Harder trägt nie die Schals, die die Harder ihm strickt."
                            },
                            {
                                "example_id": "50d8936a-dc06-46d9-98b6-178fe1dce526",
                                "sense_id": "e4f58449-64d4-386c-b7c0-c88621bf0e6a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Harder kommt, geht der Herr Harder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
