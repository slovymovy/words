            {
                "entry_id": "ead45d48-961d-3e73-9385-402b479364b0",
                "word": "sandelhout",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "90fcff07-ecec-3106-b059-aa4a8b5a8bd9",
                        "entry_id": "ead45d48-961d-3e73-9385-402b479364b0",
                        "glosses": [
                            "een bepaald houtsoort (Santalum album of verwante soorten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa893b11-581c-4fc7-a743-a631a338ecd5",
                                "sense_id": "90fcff07-ecec-3106-b059-aa4a8b5a8bd9",
                                "text": "Van sandelhout wordt welriekende olie gewonnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4eae0cf-41d6-4363-8ce3-08c5aab29cd4",
                        "source_entry_id": "ead45d48-961d-3e73-9385-402b479364b0",
                        "source_sense_id": "90fcff07-ecec-3106-b059-aa4a8b5a8bd9",
                        "source_sense_description": "een bepaald houtsoort (Santalum album of verwante soorten)",
                        "target_lang_word": "Sandelholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandelholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40ab7dc5-33d6-32d4-bb17-735f10ce78e8",
                                        "entry_id": "02be021d-bc09-30b6-a493-d38ea5685900",
                                        "glosses": [
                                            "Holz des Sandelbaums und verwandter Baumarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b5cf05-5cc8-4df8-875b-83abf7da9324",
                                                "sense_id": "40ab7dc5-33d6-32d4-bb17-735f10ce78e8",
                                                "text": "„Seine Wälder sind aus Aloe und Sandelholz, so wie die duftenden Haine von Camorin, und zwischen den Bäumen flattern fröhliche Vögel mit süßem Gesang.“"
                                            },
                                            {
                                                "example_id": "0cddeff6-e0d7-4273-86b3-23501482399c",
                                                "sense_id": "40ab7dc5-33d6-32d4-bb17-735f10ce78e8",
                                                "text": "„Er verströmte den schwachen, würzigen Duft nach Patchouli oder Sandelholz, der von ihrer Haut ausgegangen war.“"
                                            },
                                            {
                                                "example_id": "17b18e29-9be9-4722-8a6e-c5c8acff1bb9",
                                                "sense_id": "40ab7dc5-33d6-32d4-bb17-735f10ce78e8",
                                                "text": "„Der Geruch nach Sandelholz war allgegenwärtig, aber Moniques abgefahrene Sitarmusik half, die Leere zu füllen.“"
                                            },
                                            {
                                                "example_id": "f0ade8e8-fa9a-4ac2-aa4a-56c0852b9566",
                                                "sense_id": "40ab7dc5-33d6-32d4-bb17-735f10ce78e8",
                                                "text": "„Er glaubte, außer dem Sandelholz auch Schweiß und Parfum riechen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801c43b5-c70f-4294-bcd1-3e8280623bd2",
                        "source_entry_id": "ead45d48-961d-3e73-9385-402b479364b0",
                        "source_sense_id": "90fcff07-ecec-3106-b059-aa4a8b5a8bd9",
                        "source_sense_description": "een bepaald houtsoort (Santalum album of verwante soorten)",
                        "target_lang_word": "sandalwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandalwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a17a95-f20c-3871-befb-9c40642cd420",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "Any of various tropical trees of the genus Santalum, native or long naturalized in India, Australia, Hawaii, and many south Pacific islands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "The aromatic heartwood of these trees used in ornamental carving, in the construction of insect-repellent boxes and chests, and as a source of certain perfumes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d4410f-a978-4737-8dcc-fe7259bb973f",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "You ſhall put in a little bag the Powder of Sandalwood with the aforeſaid well-ſcenting Spices, and heart-ſtrengthening Powders, and lay it warm upon the left breaſt."
                                            },
                                            {
                                                "example_id": "92f03927-39b6-47c7-afd6-2bc5bd58b103",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "The branches of the white cedar will keep off moths when placed amongst clothes or furs. Boxes of red cedar (cedar of Lebanon) will do the same, as also sandalwood."
                                            },
                                            {
                                                "example_id": "909a4f21-8a68-488c-95d4-568ef46c191c",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "Sandalwood is a favorite cosmetic with Burmese ladies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22ab36b1-5ac0-4df0-87fe-a0b1ac967ebd",
                        "source_entry_id": "ead45d48-961d-3e73-9385-402b479364b0",
                        "source_sense_id": "90fcff07-ecec-3106-b059-aa4a8b5a8bd9",
                        "source_sense_description": "een bepaald houtsoort (Santalum album of verwante soorten)",
                        "target_lang_word": "santal",
