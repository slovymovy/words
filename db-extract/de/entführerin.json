                        "entry_id": "34bd45d8-abf5-3580-9fed-ac4d30382064",
                        "glosses": [
                            "weibliche Person, die andere Menschen gegen ihren Willen an einen anderen Ort bringt, um dadurch ein Lösegeld zu erpressen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df85bb99-53c5-49d2-89a9-875749320283",
                                "sense_id": "a0afcd2b-6ea7-3ff8-990e-d0e149af9500",
                                "text": "Die Entführerin übermittelte den Angehörigen des Entführungsopfers ihre Lösegeldforderung."
                            },
                            {
                                "example_id": "54b0d53f-410c-410f-8f98-1a00ac7c6ca2",
                                "sense_id": "a0afcd2b-6ea7-3ff8-990e-d0e149af9500",
                                "text": "„Einen Tag nach der Entführung der drei Monate alten Nora aus dem Salzburger Einkaufszentrum, wurde die mutmaßliche Entführerin verhört.“"
                            }
                        ],
