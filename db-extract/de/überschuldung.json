                        "examples": [
                            {
                                "example_id": "19d39a40-b5ce-4841-9cc6-9c3d7efd8ab1",
                                "sense_id": "56174291-444a-30d0-af3b-06ff28476940",
                                "text": "Mikrokredite führen in Kambodscha zu Überschuldung, Landverlust und Suiziden. Auch Deutschland ist beteiligt und hat nun die Neuvergabe gestoppt."
                            },
                            {
                                "example_id": "8ae994d5-9b11-4375-a3e3-642b8fd48a92",
                                "sense_id": "56174291-444a-30d0-af3b-06ff28476940",
                                "text": "Kohlendioxid macht den größten Anteil an der ökologischen Überschuldung aus. Wir stoßen davon deutlich mehr aus, als die Erde absorbieren kann."
                            }
                        ]
                    }
