                        "entry_id": "8a3caf57-a618-3841-bfbd-29d947e3fdeb",
                        "glosses": [
                            "État de dépendance à plusieurs substances psychoactives ou toxiques, ou à plusieurs conduites addictives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d764b3-4844-4cfe-9fb7-8ecc413ae324",
                                "sense_id": "1c249087-c7d0-38b5-be7e-febc8809b24f",
                                "text": "Le terme de polyaddiction désigne la combinaison et l’intrication de plusieurs addictions chez une même personne."
                            },
                            {
                                "example_id": "8b93f3b4-e703-4bac-8428-db2d2c504700",
                                "sense_id": "1c249087-c7d0-38b5-be7e-febc8809b24f",
                                "text": "On parle de polyaddiction en présence de plusieurs conduites addictives ou de multiples dépendances à des substances psychoactives."
                            },
                            {
                                "example_id": "f1ef7784-dd41-4632-8838-fbea37e19a79",
                                "sense_id": "1c249087-c7d0-38b5-be7e-febc8809b24f",
                                "text": "La polyaddiction est un type de comorbidité fréquent, une deuxième addiction ayant un rôle renforçateur de la première addiction."
                            }
                        ]
                    }
