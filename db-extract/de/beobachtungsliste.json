                        "source_sense_id": "6046ac34-fb31-37ba-acf1-c94c00ad015f",
                        "source_sense_description": "Ergebnis einer automatisierten Überwachung/Beobachtung von digitalen Seiten in Bearbeitungssystemen",
                        "target_lang_word": "volglijst",
                        "target_lang_code": "nl",
