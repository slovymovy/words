                    {
                        "sense_id": "ffe478ff-8cd2-38ad-8f64-0f7a53a64782",
                        "entry_id": "99e2b617-6aa9-3d79-a947-cfb982dcb399",
                        "glosses": [
                            "sport waarbij het gaat om de snelheid van galopperende paarden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0f7c6f-525c-4e1d-8204-f17230d7e992",
                                "sense_id": "ffe478ff-8cd2-38ad-8f64-0f7a53a64782",
                                "text": "Van de Nederlandse sporters en scheidsrechters die deelnamen aan het onderzoek, denkt 27 procent dat matchfixing zich in de eigen omgeving heeft voorgedaan. 8 procent kent iemand die is benaderd om de uitkomst van een wedstrijd te beïnvloeden. 4 procent heeft daar zelf mee te maken gehad, blijkt uit de enquête die de makers hebben laten uitvoeren in het voetbal, tennis, de draf- en rensport, boksen en basketbal."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aaa78ab-78f4-36bc-9499-f35414bd6dc1",
                        "entry_id": "99e2b617-6aa9-3d79-a947-cfb982dcb399",
                        "glosses": [
                            "sport waarbij het gaat om de snelheid van raceauto's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690e1967-9e99-437d-af9d-9c836c2b6a75",
                                "sense_id": "7aaa78ab-78f4-36bc-9499-f35414bd6dc1",
                                "text": "Altijd al een keer mee willen rijden in een echte racewagen? Dat kan! Op maandagavond krijgen lezers van Autovisie en De Telegraaf de mogelijkheid om écht hard over Zandvoort te gaan. Verder is er een driftworkshop, worden er door Rensportschool Zandvoort demonstraties gegeven en Huub Vermeulen vertelt wat je moet doen om coureur te worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfcd767b-3af1-3438-8eed-bb49368e5c16",
                        "entry_id": "99e2b617-6aa9-3d79-a947-cfb982dcb399",
                        "glosses": [
                            "sport waarbij het gaat om de snelheid van rennende mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cacf2625-2174-449d-9cdc-65548a6ad1be",
                                "sense_id": "bfcd767b-3af1-3438-8eed-bb49368e5c16",
                                "text": "Vorig jaar liepen in totaal bijna vijftigduizend mensen mee, schrijft de New York Times.17 procent daarvan liep voor een van de 340 goededoelenorganisaties die geld willen ophalen. Variërend van Teamforkids die rensport voor jongeren organiseert, tot Shoes4Africa die schoenen ophaalt voor Kenya. Rennen voor een goed doel, blijkt bovendien motiverend voor marathonlopers om vol te houden."
                            }
                        ]
                    }
