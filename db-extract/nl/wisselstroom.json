                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eacbf452-9705-3045-966d-5a923071dbe5",
                                        "entry_id": "dceae907-5d33-375f-8093-578132128974",
                                        "glosses": [
                                            "elektrischer Strom, der periodisch seine Polarität (Richtung) und seinen Wert (Stromstärke) ändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d54779-199c-4c6d-bd77-a6aebb2e3729",
                                                "sense_id": "eacbf452-9705-3045-966d-5a923071dbe5",
                                                "text": "Der Wechselstrom im europäischen Verbundnetz ist annähernd sinusförmig und hat eine Frequenz von 50 Hertz."
                                            },
                                            {
                                                "example_id": "09be7619-22e7-4f27-891e-cfebad91ef3f",
                                                "sense_id": "eacbf452-9705-3045-966d-5a923071dbe5",
                                                "text": "„Tesla ist der Entdecker von Wechselstrom und Drehstrom.“"
                                            },
                                            {
                                                "example_id": "42515225-3c30-415c-a7c5-20a87eb525b0",
                                                "sense_id": "eacbf452-9705-3045-966d-5a923071dbe5",
                                                "text": "„Seit Monaten preist Edison seine Gleichstromkraftwerke an. Gleichzeitig verbreitet er, wie gefährlich jener Wechselstrom sei, den Westinghouse den Leuten verkaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
