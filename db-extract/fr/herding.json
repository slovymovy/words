                "entry_id": "03cf6485-6999-3854-a621-67a32ffd091a",
                "word": "herding",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ba6ac85-f032-3878-bf8b-c7fab33d97fa",
                        "entry_id": "03cf6485-6999-3854-a621-67a32ffd091a",
                        "glosses": [
                            "Comportement grégaire, consistant à établir des sondages proches d’autres précédemment publiés par crainte de se tromper."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a1de14-056e-4305-9903-22e5eb7e059b",
                                "sense_id": "8ba6ac85-f032-3878-bf8b-c7fab33d97fa",
                                "text": "L’article original de Nate Silver sur le herding est convainquant à cet égard."
                            },
                            {
                                "example_id": "6d79faf4-25cf-4637-8082-bc78385a2e8d",
                                "sense_id": "8ba6ac85-f032-3878-bf8b-c7fab33d97fa",
                                "text": "À quelques jours du premier tour, plusieurs statisticiens accusent les sondeurs français de s’inspirer des résultats de leurs concurrents. Un phénomène appelé le « herding »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c398e0-0b36-4072-b6c2-3a405a88e710",
                        "source_entry_id": "03cf6485-6999-3854-a621-67a32ffd091a",
                        "source_sense_id": "8ba6ac85-f032-3878-bf8b-c7fab33d97fa",
