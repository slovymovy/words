                "senses": [
                    {
                        "sense_id": "26e38318-c0db-3d8d-88eb-72d52b1a3234",
                        "entry_id": "2f483c7b-0d26-3eb1-952e-3fc3bf2ca035",
                        "glosses": [
                            "Celui qui, en dégustant le vin, sait en déterminer la provenance, la date et les diverses caractéristiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec931bdd-ed2c-4c99-9cb1-43fadacb6587",
                                "sense_id": "26e38318-c0db-3d8d-88eb-72d52b1a3234",
                                "text": "Il y avait à Bercy des gourmets, courtiers piqueurs de vin."
                            }
                        ]
                    },
                    {
                        "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                        "entry_id": "2f483c7b-0d26-3eb1-952e-3fc3bf2ca035",
                        "glosses": [
                            "Celui qui apporte dans les choses de la table une recherche de délicatesse et de raffinement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f909522c-ac4f-42dc-98d5-ff8120c6a7d2",
                                "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                                "text": "On pêche fréquemment dans le Rhône le barbeau et le goujon, quelquefois la truite ordinaire, la truite saumonée et même le saumon, le plus souvent la carpe, le brochet et les deux espèces d'anguilles de nos marais , que distinguent fort bien nos pêcheurs et mieux encore nos gourmets."
                            },
                            {
                                "example_id": "0095d4ee-96a9-4932-b4e5-d6b2fd777f9c",
                                "sense_id": "15ba7526-7d55-391a-b325-918eeef8d4a1",
                                "text": "Fins gourmets, les Chinois se délectent d'une holothurie vivant dans les eaux tropicales, la bêche-de-mer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b9215f2-9787-4940-a23b-c4393bfaa563",
                        "source_entry_id": "2f483c7b-0d26-3eb1-952e-3fc3bf2ca035",
                        "target_lang_word": "Feinschmecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feinschmecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                                        "entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                                        "glosses": [
                                            "Mensch mit einem verwöhnten und/oder anspruchsvollen Geschmack und einem ausgeprägten Sinn für feine Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8eb7a9-4abc-4f6c-bf06-e7d32ccec5fb",
                                                "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                                                "text": "„In keiner anderen deutschen Stadt gibt es so viele chinesische Restaurants wie in Berlin. Als Ende der 20er Jahre bereits das erste in der Hauptstadt eröffnete, bejubelten die Feinschmecker die \"neue, kulinarische Weltoffenheit\" der Metropole.“"
                                            },
                                            {
                                                "example_id": "ba16db79-b1b4-48da-8c4b-379eef1fc0f5",
                                                "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                                                "text": "„Er war ein schöner Mann, ein Feinschmecker und Schlemmer und sehr geistreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
