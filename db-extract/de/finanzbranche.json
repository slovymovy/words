                "senses": [
                    {
                        "sense_id": "7d5a53dd-714e-3f79-8fd5-16e724e31a82",
                        "entry_id": "b7471b21-c16c-353f-84a2-a5435fcf3fd2",
                        "glosses": [
                            "Geschäftszweig, der sich mit dem Geldwesen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f6b3e1e-8fe7-456e-acd9-decabd4cb1d1",
                                "sense_id": "7d5a53dd-714e-3f79-8fd5-16e724e31a82",
                                "text": "„Die Digitalisierung beeinflusst die gesamte Finanzbranche, sie ist gleichzeitig auch die Determinante dieser Entwicklung.“"
                            },
                            {
                                "example_id": "fab1a7c9-000a-4e20-b573-deaa603be70a",
                                "sense_id": "7d5a53dd-714e-3f79-8fd5-16e724e31a82",
                                "text": "„Die durchsetzungsstarken Akteure der Finanzbranche plündern dabei nicht nur die Staatshaushalte aus, sondern auch ihre Unternehmen.“"
                            },
                            {
                                "example_id": "143559fa-08a3-4c08-8015-b72fe15e2588",
                                "sense_id": "7d5a53dd-714e-3f79-8fd5-16e724e31a82",
                                "text": "„Nach seiner Amtszeit als Fed Chef wechselte er in eine weitaus lukrativere Position in der Finanzbranche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
