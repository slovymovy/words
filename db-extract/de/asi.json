                "senses": [
                    {
                        "sense_id": "c92ce22c-b4ac-34ee-a4ec-6857a32627ec",
                        "entry_id": "2a86ace2-d7bc-32d3-bb03-54efb227ab1d",
                        "glosses": [
                            "chav (working-class person, typically associated with low education, aggressive behaviour, and/or vulgarity in lifestyle, clothing, and speech)"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "bd6f26e6-8bfe-4512-af9e-2b1e2088ca11",
                                "sense_id": "c92ce22c-b4ac-34ee-a4ec-6857a32627ec",
                                "text": "Hier in dem Viertel wohnen echt nur noch Asis.",
                                "translation": "There are nothing but chavs living in this neighbourhood anymore.",
                                "english": "There are nothing but chavs living in this neighbourhood anymore."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc2d4d88-8835-30d6-9c1f-308779ac63b5",
                        "entry_id": "2a86ace2-d7bc-32d3-bb03-54efb227ab1d",
                        "glosses": [
                            "someone who behaves anti-socially or selfishly in a particular situation"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b5658302-fc4b-42f2-86d7-0db1e60b9b09",
                                "sense_id": "dc2d4d88-8835-30d6-9c1f-308779ac63b5",
                                "text": "Boa, du Asi, gib mir mein Handy wieder!",
                                "translation": "Whoa, you thief, give me back my mobile!",
                                "english": "Whoa, you thief, give me back my mobile!"
                            }
                        ]
                    }
                ],
