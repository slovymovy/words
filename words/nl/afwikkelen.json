                    }
                },
                {
                    "sense_id": "fff4de09-8cf9-3f8c-8464-6fbf67254eb7",
                    "sense_definition": "iets dat opgerold is, zoals een draad of kabel, weer losmaken door het eraf te draaien",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "losmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de draad voorzichtig <w>afwikkelen</w> om te voorkomen dat er knopen in komen.",
                            "target_lang_translations": {
                                "en": "You must <w>unwind</w> the thread carefully to prevent knots from forming."
                            }
                        },
                        {
                            "text": "Hij had de draad te ver ineens <w>afgewikkeld</w> en deze raakte daardoor hopeloos verward.",
                            "target_lang_translations": {
                                "en": "He had <w>unwound</w> the thread too far at once, and it became hopelessly tangled as a result."
                            }
                        }
                    ],
                    "synonyms": [
                        "afrollen",
                        "loswikkelen"
                    ],
                    "antonyms": [
                        "opwikkelen",
                        "oprollen"
                    ],
                    "common_phrases": [
                        "draad afwikkelen",
                        "kabel afwikkelen",
                        "verband afwikkelen"
                    ],
                    "target_lang_definitions": {
