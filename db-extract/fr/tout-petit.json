                "senses": [
                    {
                        "sense_id": "493e7358-67c2-3f93-8650-641ea6920fb1",
                        "entry_id": "6df2b831-8b9a-35f7-88ec-38027b9ed45b",
                        "glosses": [
                            "Bébé ; enfant en bas âge. Communément admis de 0 à 36 mois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7fed5a-a903-48fc-a3ea-a7187258ff4b",
                                "sense_id": "493e7358-67c2-3f93-8650-641ea6920fb1",
                                "text": "Elle le conduisait, l’avertissait comme un tout-petit."
                            },
                            {
                                "example_id": "379fe30c-cc4d-4cfb-aea7-0073dfe3a3a0",
                                "sense_id": "493e7358-67c2-3f93-8650-641ea6920fb1",
                                "text": "Ici un vieillard tuberculeux tisonnant un poêle et prolongeant son agonie tout en criblant innocemment de ses bacilles les tout petits confiés à sa garde."
                            },
                            {
                                "example_id": "bde4bbd1-28ef-4c5f-b929-c2836812c099",
                                "sense_id": "493e7358-67c2-3f93-8650-641ea6920fb1",
                                "text": "À l’occasion de la semaine des tout-petits, se tenant cette semaine, et de la Journée nationale de l’enfant, qui se déroulera le 20 novembre prochain, la Ville de Bécancour désire souligner l’importance de la jeunesse et de la famille en offrant gracieusement un livre aux enfants d’âges préscolaires de 0-5 ans fréquentant un CPE ou une autre installation du territoire, et ce, afin de favoriser l’accès à la culture et d’encourager le plaisir de la lecture."
                            },
                            {
                                "example_id": "77853147-c5e9-4837-ac05-e8a77ca3a2c2",
                                "sense_id": "493e7358-67c2-3f93-8650-641ea6920fb1",
                                "text": "«On me disait tout le temps que je n’irais jamais plus loin, parce que j’avais trop de misère», raconte celle qui a toujours rêvé de travailler auprès des tout-petits."
                            }
                        ]
                    }
