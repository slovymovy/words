                        "entry_id": "7c380aa7-8d9f-3c4e-a206-6de249b8fca5",
                        "glosses": [
                            "den Saturn umgebender Ring aus Eis, Staub und Gestein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b05d8aa-2414-4fc4-83f6-be5ce3ac5dd6",
                                "sense_id": "1aa0be9b-fd7a-378d-adea-9a9ae2fcfa5e",
                                "text": "„Für Planetenforscher sind die Saturnringe mehr als nur ein fantastisches Kunstwerk der Natur.“"
                            },
                            {
                                "example_id": "ae8b0ce0-5e5b-4798-b4f4-d8df1edd04ea",
                                "sense_id": "1aa0be9b-fd7a-378d-adea-9a9ae2fcfa5e",
                                "text": "„Der Auf- und Untergang der Sonne, des Mondes, der Lichtwechsel des Mondes, der Venus, des Saturnringes und viele andere bedeutsame Erscheinungen entsprachen ihrer Voraussage in den astronomischen Jahrbüchern.“"
                            }
                        ],
