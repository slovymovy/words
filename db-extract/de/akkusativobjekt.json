                "senses": [
                    {
                        "sense_id": "0d5c8f92-a1df-3b1b-8ec0-722a7b2154c4",
                        "entry_id": "ce49c00d-0862-3686-b155-dcf8f315c838",
                        "glosses": [
                            "syntaktische Funktion eines Satzgliedes, das vom Verb abhängig ist und im Akkusativ steht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a07276cd-83cd-4ffd-bb80-e2e7b7e2e52a",
                                "sense_id": "0d5c8f92-a1df-3b1b-8ec0-722a7b2154c4",
                                "text": "In dem Satz „Sie sucht ihre Freundin“ ist „ihre Freundin“ ein nominales Satzglied, das Akkusativobjekt zum Verb „suchen“ ist."
                            },
                            {
                                "example_id": "5d1f92b0-84c8-491e-b05a-e38e839d0701",
                                "sense_id": "0d5c8f92-a1df-3b1b-8ec0-722a7b2154c4",
                                "text": "„Auch Funktionsverbgefüge dienen der Exaktheit, wenn sie Begriffe hervorheben (in Rechnung stellen), ein Akkusativobjekt einsparen helfen (eine Genehmigung erteilen) oder Schattierungen ausdrücken, die das Einzelverb nicht ausdrücken kann (in Erfahrung bringen, zum Abschluss bringen, zur Unterzeichnung schreiten).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
