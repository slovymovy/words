                        ],
                        "examples": [
                            {
                                "example_id": "109dbed2-1782-442f-964c-c5f5f5eaf5df",
                                "sense_id": "adb88925-278e-334c-9702-5f337de40406",
                                "text": "„Dennoch war eine Übereinkunft zwischen den Eltern nicht der einzige gesellschaftlich anerkannte Weg, eine Ehe zu kontraktieren.“"
                            },
                            {
                                "example_id": "75b89f93-2782-4585-b1a4-650561112baa",
                                "sense_id": "adb88925-278e-334c-9702-5f337de40406",
                                "text": "„Dies beweist die Tatsache am besten, daß viele kommunitarische Unternehmen ständig fremde Arbeitskräfte kontraktieren […].“"
                            },
                            {
                                "example_id": "0e0de614-8e03-4b40-b11f-f889910d1aa7",
                                "sense_id": "adb88925-278e-334c-9702-5f337de40406",
                                "text": "„Verschiedene deutsche Ärzte wollten sich kontraktieren lassen […].“"
                            },
                            {
                                "example_id": "5002cc31-1b36-41d5-b597-a98acd47a5d9",
                                "sense_id": "adb88925-278e-334c-9702-5f337de40406",
                                "text": "„Wer seine Arbeit innerhalb der kontraktierten Zeit getan hat, kann sie (auch wenn sie ihn innerlich weiter verfolgt) raum-zeitlich hinter sich lassen […].“"
                            },
                            {
                                "example_id": "046a7bc9-6151-4c71-8a71-e1a6569eed03",
                                "sense_id": "adb88925-278e-334c-9702-5f337de40406",
                                "text": "„Es ist wichtig, zu Beginn klar zu kontraktieren, ob dies gewünscht ist (Teamsupervison) oder ob es um Fallsupervision gehen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
