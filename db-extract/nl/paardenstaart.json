                                        "entry_id": "495a5f5f-5bfd-3db7-893a-64d95b498949",
                                        "glosses": [
                                            "Any waterfall, the descending water of which maintains contact with bedrock most of the time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
