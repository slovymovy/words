                "senses": [
                    {
                        "sense_id": "edaf3af7-c082-3cdd-95cd-199aa310a12e",
                        "entry_id": "23034ab2-d3ac-39ad-80e2-a2d1a44f9c7f",
                        "glosses": [
                            "Qui est enduit ou garni de caoutchouc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f3d06d-71fe-43ae-8895-21cacdbee3c7",
                                "sense_id": "edaf3af7-c082-3cdd-95cd-199aa310a12e",
                                "text": "Les premiers imperméables avaient fait leur apparition, mais on remarquait un nombre surprenant d’étoffes caoutchoutées et brillantes. Les journaux en effet avaient rapporté que deux cents ans auparavant, pendant les grandes pestes du Midi, les médecins revêtaient des étoffes huilées pour leur propre préservation."
                            },
                            {
                                "example_id": "7e67d4d3-4eb2-4f3c-9673-fecb56e10465",
                                "sense_id": "edaf3af7-c082-3cdd-95cd-199aa310a12e",
                                "text": "Pour rentrer, je prends une voiture de l’Urbaine aux roues caoutchoutées, dont les lanternes ont la couleur de celles qui remisent à Vaugirard."
                            },
                            {
                                "example_id": "4488e59d-7e2b-4f3c-80d6-381463bba66b",
                                "sense_id": "edaf3af7-c082-3cdd-95cd-199aa310a12e",
                                "text": "Les vêtements de la victime avaient trempé le siège et dégoutté sur le tapis caoutchouté du plancher."
                            }
                        ]
                    },
                    {
                        "sense_id": "40f283c3-6043-34c7-a5ff-418f27a3acd7",
                        "entry_id": "23034ab2-d3ac-39ad-80e2-a2d1a44f9c7f",
                        "glosses": [
                            "Qui a la consistance du caoutchouc."
                        ],
