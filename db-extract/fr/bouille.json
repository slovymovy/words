                            "Franche-Comté"
                        ],
                        "examples": [
                            {
                                "example_id": "36eef3e1-7e5f-467f-b9a8-f077e1cdf8d1",
                                "sense_id": "ac7e32ec-25f4-3d2b-bf13-44bfc50b39c1",
                                "text": "La laiterie était encore à M&mnoux & on livrait les bouilles (c'est-à-dire bidons) dans une charrette, au début tirée à pied, puis avec le tracteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "79acffac-9ee6-3597-aaeb-8e32a055e819",
                        "entry_id": "e20d15c3-eddc-30c6-9b13-d78c8e49b7df",
                        "glosses": [
                            "Hottes de bois dans lesquelles on porte le raisin vendangé."
                        ],
                        "tags": [
