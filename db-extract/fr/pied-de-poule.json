                                        "entry_id": "f66c7217-2e4c-3a20-ad99-d72328bb9a07",
                                        "glosses": [
                                            "Keimscheibe auf dem Dotter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e62614-b879-4fb2-ad60-c8bd80780dad",
                                                "sense_id": "c8965bf4-35a9-35b3-ba7b-b42026cf2295",
                                                "text": "Die Keimscheibe, genannt der Hahnentritt, schwimmt oben auf dem Eidotter drauf."
