                ],
                "senses": [
                    {
                        "sense_id": "2a87ff79-00cf-35b6-9fd5-ae620bee667a",
                        "entry_id": "285b5d69-f58f-3406-8b83-5bad453c22a7",
                        "glosses": [
                            "Tafel zum Anheften von Notizen"
                        ],
                        "tags": [
                            "Büromaterial"
                        ],
                        "examples": [
                            {
                                "example_id": "3c585074-9125-496f-abae-ea7a195c9a28",
                                "sense_id": "2a87ff79-00cf-35b6-9fd5-ae620bee667a",
                                "text": "„Das Datum wird an der von der Kreativgruppe angefertigten Pinnwand mit gut lesbar gestalteten, laminierten Wort- und Bildkarten zu Monaten, Zahlen Wettererscheinungen und Jahreszeiten täglich aktualisiert.“"
                            },
                            {
                                "example_id": "42e10477-1665-4462-af09-7b6a9d2064a5",
                                "sense_id": "2a87ff79-00cf-35b6-9fd5-ae620bee667a",
                                "text": "„Ich schaute die Wand hinter Sara an, wo an einer kleinen Pinnwand Fotos und Weihnachtskarten hingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                        "entry_id": "285b5d69-f58f-3406-8b83-5bad453c22a7",
                        "glosses": [
                            "Internetseite, auf welcher Personen Anmerkungen, Anfragen oder Angebote hinterlassen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf73e7c-c745-4ed8-a2b7-b37cd135e383",
                                "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                                "text": "„Wenn du früher im Wochenblatt inserieren konntest, so ist heute der Kleinanzeigenmarkt von meinestadt.de Wuppertal gleichzeitig Marktplatz und Pinnwand für dein Gratis-Inserat.“"
                            },
                            {
                                "example_id": "0437c579-07a6-471c-80ee-ce4a0e46d9b2",
                                "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                                "text": "„Die Eintrittskarten an der Pinnwand in Lothar Binders Homeoffice – er ist Außendienstmitarbeiter eines Computer-Unternehmens – zeugen vom Einsatzwillen des Gültsteiners: U-21-Weltmeisterschaft in Deutschland, Europameisterschaft in Schweden, Weltmeisterschaft 2011 in Deutschland und zuletzt Deutschland gegen Brasilien in Fürth.“"
                            },
                            {
                                "example_id": "7a5632d9-3f7d-46d3-aced-b01c6acbf519",
                                "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                                "text": "„Denn Netzwerke wie Facebook oder Google Plus zeigen automatisch ein kleines Vorschaubild auf der Pinnwand des Nutzers an, wenn dieser einen Artikel verlinkt.“"
                            },
                            {
                                "example_id": "abb86a56-1d4f-4bff-9665-cfe7a89454f6",
                                "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                                "text": "„Dementsprechend können Nutzer über eine Browser-Erweiterung Fotos und Videos von beliebigen Webseiten an ihre virtuelle Pinnwand hängen.“"
                            },
                            {
                                "example_id": "407be63a-e4c1-442f-80a9-ad2364bfb5f6",
                                "sense_id": "9fc8d0ac-d6c9-350e-93c8-68fb461ae912",
                                "text": "„Tausende Facebook-Nutzer veröffentlichen derzeit ein Foto auf ihrer Pinnwand, mit dem sie der kommerziellen Nutzung ihrer Daten widersprechen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
