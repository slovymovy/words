                ],
                "senses": [
                    {
                        "sense_id": "c8804cbc-2aae-361b-9de2-2aea70aa5d11",
                        "entry_id": "05965492-32a6-3ab9-978d-a90b0b8bba9b",
                        "glosses": [
                            "Demi-dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b98e4a5d-f93d-46cc-9efd-44508b2232aa",
                                "sense_id": "c8804cbc-2aae-361b-9de2-2aea70aa5d11",
                                "text": "Ebenso hält sich auch das minderwertigste männliche Wesen den Frauen gegenüber für einen Halbgott.",
                                "translation": "De même, le plus médiocre des mâles se croit en face des femmes un demi-dieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ff182f-a030-3eaa-a9ca-412bae97ea26",
                        "entry_id": "05965492-32a6-3ab9-978d-a90b0b8bba9b",
                        "glosses": [
                            "Personne qui sort du lot, qui en impose."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f8f1c4e6-35b0-44f6-923f-0f6c8c12e9aa",
                                "sense_id": "c6ff182f-a030-3eaa-a9ca-412bae97ea26",
                                "text": "In einem Augenblick wird ein Halbgott zum Sterblichen, ein Genie zum gewöhnlichen Menschen.",
                                "translation": "En un instant, un demi-dieu devient un mortel, un génie se transforme en homme ordinaire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
