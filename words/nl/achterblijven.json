                                "target_lang_sense_clarification": "not taken or moved with the rest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67097bea-c6ba-3084-a215-59db1af5f91b",
                    "sense_definition": "minder snel vooruitgaan dan anderen of een bepaald niveau niet halen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prestatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerprestaties van deze klas <w>blijven achter</w> bij die van de rest van de school.",
                            "target_lang_translations": {
                                "en": "The learning performance of this class <w>lags behind</w> that of the rest of the school."
                            }
                        },
                        {
                            "text": "Als je niet elke dag studeert, zul je snel bij de andere studenten <w>achterblijven</w>.",
                            "target_lang_translations": {
                                "en": "If you don't study every day, you will quickly <w>fall behind</w> the other students."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterlopen",
                        "achterop raken",
                        "een achterstand hebben"
                    ],
                    "antonyms": [
                        "voorlopen",
                        "bijblijven"
                    ],
                    "common_phrases": [
                        "ver achterblijven bij",
                        "niet kunnen achterblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To progress more slowly than others or fail to reach a certain expected level"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lag behind",
                                "target_lang_sense_clarification": "moving slower than the group"
                            },
                            {
                                "target_lang_word": "to fall behind",
                                "target_lang_sense_clarification": "failing to keep up with progress"
                            },
                            {
                                "target_lang_word": "to trail",
                                "target_lang_sense_clarification": "being behind in a competition or ranking"
                            }
                        ]
                    }
                }
