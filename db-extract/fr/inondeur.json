                "senses": [
                    {
                        "sense_id": "977c1fb4-29e4-30d3-a8a4-01f693c6582d",
                        "entry_id": "5a6e9049-9a0a-38bf-9183-a00f89b6049d",
                        "glosses": [
                            "Personne ou chose qui inonde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5444b3c2-441b-4397-844c-8f56696ade51",
                                "sense_id": "977c1fb4-29e4-30d3-a8a4-01f693c6582d",
                                "text": "Ce n’était pas un irrigueur, un inondeur, de ceux qui pensent que l’océan du dehors on peut lui ajouter une petite mer intérieure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a63fc5-2007-4dd7-a207-cffff50b0bbd",
                        "source_entry_id": "5a6e9049-9a0a-38bf-9183-a00f89b6049d",
                        "source_sense_id": "977c1fb4-29e4-30d3-a8a4-01f693c6582d",
                        "target_lang_word": "flooder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flooder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd1301a-d17b-39b5-b2be-7611eda0113e",
                                        "entry_id": "373609ff-debf-3bcb-9e97-a13f6f32aaf6",
                                        "glosses": [
                                            "A channel or device for carrying and controlling water used in flood irrigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a52a608-1d87-4b2f-bf32-870d78885ab8",
                                                "sense_id": "dbd1301a-d17b-39b5-b2be-7611eda0113e",
                                                "text": "If this first catch-water is to be employed at any time as a flooder, the upper edge of its bank must be carefully trimmed to the level; but I believe, on the whole, it will be more advisable to make a separate flooder immediately below, which may be cut at the exact level by means of the plumb rule, to the depth of one, and width of two feet; with an outlet from the catch-water at every five or ten Irish chains."
                                            },
                                            {
                                                "example_id": "82285391-89bf-4fa7-8afc-a71c0792e6c8",
                                                "sense_id": "dbd1301a-d17b-39b5-b2be-7611eda0113e",
                                                "text": "When we got the water raised to a sufficient height, we formed a main conducting flooder along the head of the ridges, and made small feeders from it to conduct the water occasionally into each ridge."
                                            },
                                            {
                                                "example_id": "85a13332-2a6e-4d46-ac54-1b6a4c57cd04",
                                                "sense_id": "dbd1301a-d17b-39b5-b2be-7611eda0113e",
                                                "text": "GARDEN FLOODER is a lawn and garden irrigating device that allows flooding of large areas without excessive runoff, erosion or evaporation. Made of polyethylene, the flooder is designed so that water flow is slowed without greatly reducing the volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b00241e-3a08-351d-933b-9e735ffa5625",
                                        "entry_id": "373609ff-debf-3bcb-9e97-a13f6f32aaf6",
                                        "glosses": [
                                            "A person who floods message boards, chat rooms etc. with unwanted or repetitive comments."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff2e8f5-01f1-4ade-9a43-2dd99eb43029",
                                                "sense_id": "4b00241e-3a08-351d-933b-9e735ffa5625",
                                                "text": "The flooder may be seeking attention (\"see what I can do!\") or trying to disrupt the socializing in the rooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11a61c9-ab0d-3348-985f-9bf083cefdb4",
                                        "entry_id": "373609ff-debf-3bcb-9e97-a13f6f32aaf6",
                                        "glosses": [
                                            "Something that tends to flood."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276f1279-c634-49bc-af1b-a0f224a1345e",
                                                "sense_id": "e11a61c9-ab0d-3348-985f-9bf083cefdb4",
                                                "text": "The Director of Works and Mr. John Locket confirmed the fact that this River is a \"terrible flooder.\""
                                            },
                                            {
                                                "example_id": "27ee87e9-fb27-4297-b062-6f437be5310f",
                                                "sense_id": "e11a61c9-ab0d-3348-985f-9bf083cefdb4",
                                                "text": "I believe that Congress acted, and I think they stated they acted, in recognition of the fact that this would provide some flood control on the Kansas River system, which had been a bad flooder and is a bad flooder."
                                            },
                                            {
                                                "example_id": "b4ba74af-0ab5-427f-bb4a-2cf683d94a56",
                                                "sense_id": "e11a61c9-ab0d-3348-985f-9bf083cefdb4",
                                                "text": "As to the Clearwater situation, it is the major flooder. The Army engineers' Mr. Fernald testified here several times that it is the worst flooder in the Columbia River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921c6de8-120f-35ea-a94f-ecc11299d554",
                                        "entry_id": "373609ff-debf-3bcb-9e97-a13f6f32aaf6",
                                        "glosses": [
                                            "A device for controlling or maintaining the flow of liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe2c4b5-283c-4352-8b52-f4786fc9e63d",
                                                "sense_id": "921c6de8-120f-35ea-a94f-ecc11299d554",
                                                "text": "This has lead ^([sic]) to the development of another type of flooder used in the eastern fields. The bottom collar on the pump is tapped for a1/4-inch street ell just below the standing valve seat, so that the standing valve will not seal the hole."
                                            },
                                            {
                                                "example_id": "1ba09d04-c21a-49ed-bfcf-e9d8c125d2eb",
                                                "sense_id": "921c6de8-120f-35ea-a94f-ecc11299d554",
                                                "text": "The flooder pipes are connected through cocks to a supply header on the aisle side of the dehumidifier."
                                            },
                                            {
                                                "example_id": "6db6dac6-ce56-446b-b6d9-a839f6b551b2",
                                                "sense_id": "921c6de8-120f-35ea-a94f-ecc11299d554",
                                                "text": "Fresh water was added through the last bank of flooder sprays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flooder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf9516d-7259-32de-a8b6-44b0cee04cbc",
                                        "entry_id": "4a16edaa-fd82-3fe7-b408-9308d4a7a95c",
                                        "glosses": [
                                            "A person employed to handle issues arising from flooding."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6957dc80-4d55-459d-9583-62f13554a471",
                                                "sense_id": "5cf9516d-7259-32de-a8b6-44b0cee04cbc",
                                                "text": "You know, Dan, that's the man I rowed with all day, never did know I had a peg leg in that big boot, and that I wasn't really a flooder."
                                            },
                                            {
                                                "example_id": "83471d54-9279-45ce-a9e0-8dc6865df1bd",
                                                "sense_id": "5cf9516d-7259-32de-a8b6-44b0cee04cbc",
                                                "text": "Different operators give different answers. One experienced miscible flooder says a minimum of 30% more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
