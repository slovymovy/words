                                "example_id": "77963722-221b-441e-b24d-2b6769cd87b9",
                                "sense_id": "172f125e-5959-3502-a39b-f005a50c629b",
                                "text": "Um Monopole zu verhindern, muss die Übernahme großer Unternehmen durch das Kartellamt genehmigt werden."
                            },
                            {
                                "example_id": "6ebdc000-b94c-466c-a5c7-e784e6b22637",
                                "sense_id": "172f125e-5959-3502-a39b-f005a50c629b",
                                "text": "Das Kartellamt kann hohe Geldstrafen gegen Firmen verhängen, die mit ihren Konkurrenten höhere Preise absprechen."
                            }
