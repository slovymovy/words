                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                        "entry_id": "590c958b-8023-341e-a9cc-062e85d273ab",
                                        "glosses": [
                                            "Extending throughout an entire nation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25de1c49-a5c6-4967-9bf5-f5364d507c49",
                                                "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                                "text": "Near-synonym: (in federations) federal"
                                            },
                                            {
                                                "example_id": "3532580c-df02-4d10-8f44-d36712fb7642",
                                                "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                                "text": "There was a nationwide search on for the bankrobbers."
                                            },
                                            {
                                                "example_id": "622c72ff-30e2-44ef-b10a-21a6442f0d68",
                                                "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                                "text": "To assist in this mind-bogglingly complex endeavour, Switzerland has developed sophisticated software tools that allow infrastructure managers (IMs), operators and local/national authorities to co-ordinate civil engineering projects with planned service enhancements, demand forecasts, pathing requirements, nationwide timetables, and asset utilisation up to 15 years ahead."
                                            },
                                            {
                                                "example_id": "5c901686-6f65-4205-9591-321df1a90e51",
                                                "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                                "text": "Kraft Heinz said the new products will be available nationwide to all school administrators to procure and offer to students either for purchase in the lunchroom – though the company did not disclose the cost to schools – or for free through the National School Lunch Program (NSLP)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nationwide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04b28ff1-077c-3056-a2fb-92bd7d81ce1b",
                                        "entry_id": "a48df22c-85a8-3970-82f3-16272a51a989",
                                        "glosses": [
                                            "Throughout a nation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc65c0c-99bd-49b6-8143-6569484c378d",
                                                "sense_id": "04b28ff1-077c-3056-a2fb-92bd7d81ce1b",
                                                "text": "Near-synonym: (in federations) federally"
                                            },
                                            {
                                                "example_id": "00a7684e-cf0c-4520-82f1-8a4c19ba9a44",
                                                "sense_id": "04b28ff1-077c-3056-a2fb-92bd7d81ce1b",
                                                "text": "…Toote became the principal Black surrogate (highest “rank” in the Reagan campaign operation), booking Reagan for appearances before Black organizations and traveling nationwide in his behalf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
