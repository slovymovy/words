                "senses": [
                    {
                        "sense_id": "c548a3df-5d1a-3fcd-8649-42babfd11ec4",
                        "entry_id": "6004c91c-99b7-3aec-94b8-e14e3ebb4dd9",
                        "glosses": [
                            "Sorte de manteau militaire, qui avait ordinairement des manches fort larges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13811d41-99f0-4182-8469-58ef5be8346f",
                                "sense_id": "c548a3df-5d1a-3fcd-8649-42babfd11ec4",
                                "text": "Les mousquetaires portaient des casaques."
                            },
                            {
                                "example_id": "f52b6526-b500-4c9b-8d41-a45966b0b66b",
                                "sense_id": "c548a3df-5d1a-3fcd-8649-42babfd11ec4",
                                "text": "Les valets eux-mêmes, dépouillant leurs somptueuses livrées pour revêtir de fortes casaques de cuir, ont été armés de pistolets et occupent différents postes stratégiques de défense."
                            }
                        ]
                    },
                    {
                        "sense_id": "353395d5-36bb-39c5-a962-4fb0ab815936",
                        "entry_id": "6004c91c-99b7-3aec-94b8-e14e3ebb4dd9",
                        "glosses": [
                            "Sorte de vêtement de dessus, veste, veston."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0533963-37e1-4c2f-a5bd-79fc650f5069",
                                "sense_id": "353395d5-36bb-39c5-a962-4fb0ab815936",
                                "text": "La paysanne avait retiré sa casaque. En corset blanc, un fichu de couleur noué sur les épaules, les manches de chemise retroussées jusqu’aux coudes, elle était accroupie dans les plis de sa jupe de cotonnade bleue, que retenaient deux bretelles croisées derrière le dos."
                            },
                            {
                                "example_id": "eb178e60-35b1-4be2-aadc-3d890f5b1c9b",
                                "sense_id": "353395d5-36bb-39c5-a962-4fb0ab815936",
                                "text": "Été comme hiver, il était vêtu d’un pantalon de velours à côtes et d’une grossière casaque de droguet qu’il portait sous sa blouse noire de paysan."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d824a97-b6ed-3c87-813e-943e6809568c",
                        "entry_id": "6004c91c-99b7-3aec-94b8-e14e3ebb4dd9",
                        "glosses": [
                            "Partie supérieure de la tenue des jockeys."
                        ],
