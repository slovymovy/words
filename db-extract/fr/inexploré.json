                ],
                "senses": [
                    {
                        "sense_id": "7fffad42-9770-30bf-9036-2c069aa871d2",
                        "entry_id": "354dbd0d-ff92-3e16-af11-8e86a128e516",
                        "glosses": [
                            "Qui n’a pas été exploré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4020ff-d175-4a13-bb27-e8b0d39ed0fc",
                                "sense_id": "7fffad42-9770-30bf-9036-2c069aa871d2",
                                "text": "Cette séparation, dont les phénomènes étonnent, provient d’un mystère inexploré, peut-être inexplorable."
                            },
                            {
                                "example_id": "4b374d3d-d7c8-4fa8-9d41-451817f29e5b",
                                "sense_id": "7fffad42-9770-30bf-9036-2c069aa871d2",
                                "text": "La vallée de la Lanterne dans son cours supérieur et moyen est restée longtemps à peu près inexplorée, l’attention des botanistes ayant été plutôt sollicitée par les deux chaînes voisines du Jura et des Vosges […]"
                            },
                            {
                                "example_id": "7b9901ff-e912-497b-84fc-eac4d918f1bf",
                                "sense_id": "7fffad42-9770-30bf-9036-2c069aa871d2",
                                "text": "On se figure sans peine l’empressement que je mis à me rendre à une invitation qui me permettait de voir le Sultan, sa cour, son armée et une région à peu près inexplorée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9ada41f-8ac2-4954-ad24-6a76c291d0f7",
                        "source_entry_id": "354dbd0d-ff92-3e16-af11-8e86a128e516",
                        "source_sense_id": "7fffad42-9770-30bf-9036-2c069aa871d2",
                        "target_lang_word": "uncharted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
