{
    "word_family": [
        "cuddle",
        "cuddlesome",
        "cuddliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97b87879-8b8e-3153-884e-716055d38ecc",
                    "sense_definition": "Suitable for cuddling or designed to be hugged, often used to describe soft toys or animals.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cuddly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child refused to go to sleep without her favorite <w>cuddly</w> teddy bear.",
                            "target_lang_translations": {
                                "ru": "Ребенок отказывался ложиться спать без своего любимого <w>мягкого</w> медвежонка."
                            }
                        },
                        {
                            "text": "This <w>cuddly</w> toy is made from the softest material available.",
                            "target_lang_translations": {
                                "ru": "Эта <w>плюшевая</w> игрушка сделана из самого мягкого материала."
                            }
                        }
                    ],
                    "synonyms": [
                        "cuddlesome"
                    ],
                    "common_phrases": [
                        "cuddly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий для объятий или предназначенный для того, чтобы его обнимали; часто используется для описания мягких игрушек или животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "об игрушках, приятный на ощупь"
                            },
                            {
                                "target_lang_word": "плюшевый",
                                "target_lang_sense_clarification": "о мягких игрушках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bac1a4aa-dd31-393c-9ffd-9d01fc368d50",
                    "sense_definition": "Fond of or prone to hugging and physical affection.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuddly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My girlfriend is very <w>cuddly</w> when we watch movies together on the sofa.",
                            "target_lang_translations": {
                                "ru": "Моя девушка очень <w>ласковая</w>, когда мы вместе смотрим фильмы на диване."
                            }
                        },
                        {
                            "text": "Some dog breeds are known for being more <w>cuddly</w> and affectionate than others.",
                            "target_lang_translations": {
                                "ru": "Некоторые породы собак известны тем, что они более <w>любят обниматься</w> и проявлять нежность, чем другие."
                            }
                        }
                    ],
                    "synonyms": [
                        "cuddlesome"
                    ],
                    "common_phrases": [
                        "cuddly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любящий обниматься или склонный к проявлению физической нежности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласковый",
                                "target_lang_sense_clarification": "любящий нежность и объятия"
                            },
                            {
                                "target_lang_word": "любящий обниматься",
                                "target_lang_sense_clarification": "о человеке или животном"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}