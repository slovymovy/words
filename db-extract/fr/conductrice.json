                ],
                "senses": [
                    {
                        "sense_id": "7d653e0e-2bef-3754-8e95-559b0a62a4e6",
                        "entry_id": "4a217609-7cf2-33c1-a042-9e1bbb7edf57",
                        "glosses": [
                            "Celle qui conduit, qui mène un déplacement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97450c4-e0e7-44e6-9e09-026a77384c22",
                                "sense_id": "7d653e0e-2bef-3754-8e95-559b0a62a4e6",
                                "text": "Tout cela fournissait à la conductrice de quoi occuper et amuser les enfants toute la journée, et de la matière à jaser."
                            },
                            {
                                "example_id": "7e882c2a-f36a-447f-ba12-56db8db3c04c",
                                "sense_id": "7d653e0e-2bef-3754-8e95-559b0a62a4e6",
                                "text": "Le duc de Guise suivit sa conductrice, qui n’était rien moins que la fille de Jacques de Matignon maréchal de France ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "da517343-be3b-3d84-b27d-752059b7cf61",
                        "entry_id": "4a217609-7cf2-33c1-a042-9e1bbb7edf57",
                        "glosses": [
                            "Celle qui a les commandes d’un véhicule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1fc6594a-2c4d-3ae3-a48c-1a8351755e99",
                        "entry_id": "4a217609-7cf2-33c1-a042-9e1bbb7edf57",
                        "glosses": [
                            "Agente chargée de la conduite des travaux, sous les ordres d’un ingénieur."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2621f28d-b673-4bf3-b4c0-16e7aeef6a9d",
                        "source_entry_id": "4a217609-7cf2-33c1-a042-9e1bbb7edf57",
                        "target_lang_word": "Fahrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0d5eeb-902e-32ac-aa0c-14c638f22678",
                                        "entry_id": "a2d49b51-2a70-364a-bc8f-7aea58e94aea",
                                        "glosses": [
                                            "weiblicher Fahrer eines Fahrzeugs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a55b47a-1a62-4159-8457-23fcc01e6d3c",
                                                "sense_id": "5e0d5eeb-902e-32ac-aa0c-14c638f22678",
                                                "text": "Fahrerinnen fahren oft viel vorsichtiger und regel-konformer als die Fahrer."
                                            },
                                            {
                                                "example_id": "cbecda48-4c48-449b-945c-40cf00988046",
                                                "sense_id": "5e0d5eeb-902e-32ac-aa0c-14c638f22678",
                                                "text": "„Die Fahrerin hätte jedoch auf Grund des außergewöhnlichen Verhaltens der Fußgängerin ihre Geschwindigkeit reduzieren und bremsbereit sein müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9d5e113-3c38-46fd-b734-dd756e1aa493",
                        "source_entry_id": "4a217609-7cf2-33c1-a042-9e1bbb7edf57",
                        "target_lang_word": "Schaffnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaffnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                                        "entry_id": "af16a6ec-d1bf-32eb-b9d1-155d88a48335",
                                        "glosses": [
                                            "weibliche Person, die als Schaffner arbeitet, also in der Bahn/Straßenbahn und so weiter Fahrkarten kontrolliert"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3067dc16-0c4f-4601-8ee3-e652c8fcee3a",
                                                "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                                                "text": "„Im Herbst 1914 berichteten Zeitungen von den ersten Schaffnerinnen in Berlin.“"
                                            },
                                            {
                                                "example_id": "009234d4-ae8f-4db2-b217-e002f4500175",
                                                "sense_id": "c359c8af-685c-3699-b83e-625bbe4798c2",
                                                "text": "„Sie arbeitete zunächst als Bürokraft und ab 1957 als Schaffnerin bei den Wiener Verkehrsbetrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                        "entry_id": "af16a6ec-d1bf-32eb-b9d1-155d88a48335",
                                        "glosses": [
                                            "weibliche Person, welche die wirtschaftlichen Angelegenheiten regelt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b680d480-993e-446e-b069-f75ddfd6ec21",
                                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                                "text": "„Und die Drescher antworteten dem Hennchen: ‚Wir geben dir nicht früher das Hintergetreide, bevor du uns nicht von der Schaffnerin süßen Schmetten bringst.‘“"
                                            },
                                            {
                                                "example_id": "fd47228c-d45e-4973-82da-ee12d298d2a9",
                                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                                "text": "„Im entgegengesetzten Fall müssen Sie entweder oder es muß die Schaffnerin das Gut verlassen.“"
                                            },
                                            {
                                                "example_id": "28735c06-74ef-4a35-8692-cee9d34a76b1",
                                                "sense_id": "50b92af0-5202-3387-a5e5-2f3a232ee67e",
                                                "text": "„Sie steckte die Hand unter ihr Brustmieder und zog einen Speziestaler herau, der sorgfältig in ein Tuch eingewickelt war, und zeigte ihn der Schaffnerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4f2e655-50b1-4d49-9b90-2b35d44d5199",
