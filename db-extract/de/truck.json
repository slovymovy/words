                "senses": [
                    {
                        "sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                        "entry_id": "506820c4-11e7-3fe5-a523-c988848c4be4",
                        "glosses": [
                            "großer LKW/Lastzug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8840400e-8e2e-4e7f-9f6a-b415da606781",
                                "sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                                "text": "„Zwanzig Minuten redete der Fahrer aus dem Kongo, der Solomon in seinem Truck versteckt hatte, auf den schwer Bewaffneten ein.“"
                            },
                            {
                                "example_id": "1725db89-90d6-4ef6-8241-de503d01db1a",
                                "sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                                "text": "„Paul Hopkins war froh, dass sein riesiger Truck endlich leer war.“"
                            },
                            {
                                "example_id": "b58256f8-5a43-4bba-9e38-8dac36432331",
                                "sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                                "text": "„Ich lief durch das Getümmel, um nach Davids Truck Ausschau zu halten, und kam an einem deutschen Team vorbei, das zum ohrenbetäubenden Sound von Trash Metal in atemberaubender Geschwindigkeit einen Reifen wechselte.“"
                            },
                            {
                                "example_id": "1ff64977-1dac-4635-b4d8-d30a8b4a522a",
                                "sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                                "text": "„Ich war so abgelenkt, dass ich nicht einmal registriert hatte, dass ich auf eine steile, nicht einsehbare Kuppe zufuhr, und jetzt donnert auf einmal ein riesiger Truck darüber, nimmt die ganze Straßenbreite ein und rast direkt auf mich zu, viel zu schnell, um noch bremsen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ff2596-a052-4c75-aea3-8c2297144f75",
                        "source_entry_id": "506820c4-11e7-3fe5-a523-c988848c4be4",
                        "source_sense_id": "81c871ef-e5e4-306b-944a-67f7a0e3c229",
                        "source_sense_description": "großer LKW/Lastzug",
                        "target_lang_word": "camion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                        "entry_id": "3bacc704-ca81-3ecc-8d16-0e21b694b83b",
                                        "glosses": [
                                            "Véhicule terrestre automobile équipé d’un, deux ou trois essieux directeurs ainsi que de un à trois essieux porteurs et destiné au transport de marchandises."
                                        ],
                                        "tags": [],
                                        "note": "Le nom est générique et s’applique à un ensemble de véhicules spécialisés soit automoteurs, soit attelés à une remorque ou une semi-remorque",
                                        "examples": [
                                            {
                                                "example_id": "79be94f1-0830-4d14-87ea-c7b1e980fcbb",
                                                "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                                "text": "Je traversai une cour encombrée de jeeps et de camions militaires et j’arrivai devant l’entrée du bâtiment inachevé."
                                            },
                                            {
                                                "example_id": "9ec5a407-b274-46f6-9e1b-26531a842896",
                                                "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                                "text": "Sans les camionneurs, l’économie brésilienne serait paralysée. Sur les routes en bon état de Rio, de Sâo Paulo ou de Belo Horizonte, les camions circulent par milliers, tous les jours."
                                            },
                                            {
                                                "example_id": "17a890a7-694b-4c8b-b507-b7659ec6fb3c",
                                                "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                                "text": "Un matin du mois de Juin, il mousine un petit crachin froid. Un gros camion vient de quitter le Champ du Trou : il emporte nos meubles."
                                            },
                                            {
                                                "example_id": "00a1e386-72f3-44c3-a096-e09352011ebf",
                                                "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                                "text": "Les petits coups de freins de Chak et l’épais tapis de neige se conjuguèrent pour ralentir le camion, et ce fut quasiment au pas qu’il s’engagea dans l’ouverture."
                                            },
                                            {
                                                "example_id": "10d1c660-b3ae-4bda-8ba1-23943a4e356e",
                                                "sense_id": "0a6e1d81-5b53-3742-ab32-cca99ab1a2d5",
                                                "text": "Les sept premiers camions à être testés par Euro NCAP Truck Safe sont : le DAF XF, l'Iveco S-WAY, le MAN TGX, le Mercedes-Benz Trucks Actros, le Renault Trucks T, le Scania R-series, ainsi que le Volvo FH."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca340d57-c2bf-37ed-b054-a498e3117a2b",
                                        "entry_id": "3bacc704-ca81-3ecc-8d16-0e21b694b83b",
                                        "glosses": [
                                            "Fardier ; haquet ; chariot bas."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9258577-a6ca-4b5c-ba9a-c2b13586e903",
                                                "sense_id": "ca340d57-c2bf-37ed-b054-a498e3117a2b",
                                                "text": "Quelquefois, en arrivant au canal, les ponts des écluses étaient déjà tournés. Des fiacres, des camions s’arrêtaient là. Les cochers juraient, le monde s’inquiétait."
                                            },
                                            {
                                                "example_id": "ee579115-4a03-44f4-a864-a65104fee141",
                                                "sense_id": "ca340d57-c2bf-37ed-b054-a498e3117a2b",
                                                "text": "Alors on fit le prix, et sans plus tarder, car ils étaient pressés, mon mari partit avec eux sur un camion. Par malheur, à cause de la réquisition, on n’avait plus qu’un cheval, et pas bien solide."
                                            },
                                            {
                                                "example_id": "c3854cd5-1bd2-4466-8768-9afd91ccb79f",
                                                "sense_id": "ca340d57-c2bf-37ed-b054-a498e3117a2b",
                                                "text": "La plupart du temps, les véhicules que vous rencontrez sur les routes sont des camions ou des fardiers chargés d’énormes muids."
                                            },
                                            {
                                                "example_id": "d6955bb2-b661-41f9-ba6a-5caf59ef6ec6",
                                                "sense_id": "ca340d57-c2bf-37ed-b054-a498e3117a2b",
                                                "text": "Traversant une rue sous la pluie, abrité par son parapluie, il ne vit pas arriver un lourd camion hippomobile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66379fbf-c6a7-3fa0-9479-79801a935c32",
                                        "entry_id": "3bacc704-ca81-3ecc-8d16-0e21b694b83b",
                                        "glosses": [
                                            "Récipient d’assez grande capacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbeaae4-3844-43a9-8865-dd379f4da8c7",
                                                "sense_id": "66379fbf-c6a7-3fa0-9479-79801a935c32",
                                                "text": "Il se passait que des peintres étaient en train de badigeonner à neuf l’intérieur de la voûte et les portes, et que, le soir, ils remisaient leurs camions dans le corps de garde."
                                            },
                                            {
                                                "example_id": "52507c9c-a39b-4bb5-972b-ca90ae459b6f",
                                                "sense_id": "66379fbf-c6a7-3fa0-9479-79801a935c32",
                                                "text": "On mélange le tout dans un vase de verre, appelé camion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cda7ec5e-2909-3b21-875c-6882d83add35",
                                        "entry_id": "3bacc704-ca81-3ecc-8d16-0e21b694b83b",
                                        "glosses": [
                                            "Seau utilisé par les peintres en bâtiments pour délayer les peintures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510797d7-d0c2-49f0-ac41-d92f8e0ce2f0",
                                                "sense_id": "cda7ec5e-2909-3b21-875c-6882d83add35",
                                                "text": "On met le liquide (peinture ou vernis) dans le camion en ayant soin de bien le tamiser et on referme le camion […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c440400-a4e3-30a4-9abb-2a204ac2d46e",
                                        "entry_id": "b16365f2-4af1-3df8-b856-5435523c089b",
                                        "glosses": [
                                            "Petite épingle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cb19d4-ab92-4ccd-95f8-23ad9270df2c",
                                                "sense_id": "8c440400-a4e3-30a4-9abb-2a204ac2d46e",
                                                "text": "Ces petites épingles appelées, dans les magasins de modes, camions."
                                            },
                                            {
                                                "example_id": "ed3ceaf3-b7de-4858-924b-30cff2d5302b",
                                                "sense_id": "8c440400-a4e3-30a4-9abb-2a204ac2d46e",
                                                "text": "Eh ! non, monsieur, je vous dis une grosse épingle, et vous me présentez un camion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
