                ],
                "senses": [
                    {
                        "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                        "entry_id": "3033c21f-030c-36c7-8603-3648a68ac30c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccce06b8-9559-474b-b549-e0a17b80670d",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Frau Hensle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "26b8f7bf-6745-4579-9098-698d17b1133e",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Herr Hensle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "100c0b86-c170-490d-af20-99f5021ce442",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Die Hensles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a9489506-8110-4120-aa19-288fae3f0ee3",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Der Hensle trägt nie die Schals, die die Hensle ihm strickt."
                            },
                            {
                                "example_id": "55971b29-1536-4961-b6df-ccf8760b7c7c",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hensle kommt, geht der Herr Hensle.“"
                            },
                            {
                                "example_id": "118bbc5e-3914-43cb-8490-df540878d3a4",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Hensle kommt und geht."
                            },
                            {
                                "example_id": "4f7901b1-a09b-49d9-a809-30fe6d0b60e7",
                                "sense_id": "41e06acf-9b2c-322e-8630-7accc367f425",
                                "text": "Hensles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
