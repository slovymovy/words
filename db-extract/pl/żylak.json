                        "translation_id": "4086c280-35d5-475f-84c3-26265f50fe05",
                        "source_entry_id": "1eb28765-0552-3ccd-9961-c0892b777354",
                        "source_sense_id": "df6e699b-8884-3483-9c40-33e5b76650c5",
                        "target_lang_word": "variz",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "variz",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "37b3746e-93a3-3639-95dd-c5faf9b2b39b",
                                        "entry_id": "776dbb08-ac46-34af-bd24-aa0630853c4a",
                                        "glosses": [
                                            "Vena tortuosa y permanentemente engrosada, a causa del mal funcionamiento de las válvulas que impiden el flujo retrógrado de la sangre."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7936935f-700e-4009-a7d9-67754039d546",
                                                "sense_id": "37b3746e-93a3-3639-95dd-c5faf9b2b39b",
                                                "text": "No se le debe confundir con la dilatacion varicosa de la safena á su paso por el pliegue del corvejon, defecto que, aunque excesivamente raro, merece mencionarse. La distincion de ambas cosas no puede ser más sencilla, pues mientras la variz cede y desaparece á la sola compresion verificada con los dedos, el alifafe subsiste."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3373c6f5-246a-4edf-969b-44c0aac6a74b",
                        "source_entry_id": "1eb28765-0552-3ccd-9961-c0892b777354",
                        "source_sense_id": "df6e699b-8884-3483-9c40-33e5b76650c5",
                        "target_lang_word": "Krampfader",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krampfader",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                        "entry_id": "05441821-a632-34d6-850e-99c5f2eda07e",
                                        "glosses": [
                                            "defekte Vene, in der das Blut nicht mehr zurückfließt (meist äußerlich sichtbar)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3cdafc-008e-46c3-a2f9-49749d1bfd5e",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "Sie hat sich die Krampfadern an den Beinen ziehen lassen."
                                            },
                                            {
                                                "example_id": "ad3ea67c-69c8-4cc4-b607-4426f56cb322",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Herrliche Zeiten ohne motorisierte Schützeneinheiten, in denen heute dafür gesorgt wird, daß auch Leute mit Krampfadern zu ihrem Militärdienst kommen!“"
                                            },
                                            {
                                                "example_id": "3893f0bb-8645-4035-94fb-83a435541b0c",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Ihre dickschenkligen Beine waren von Krampfadern durchzogen.“"
                                            },
                                            {
                                                "example_id": "5b473965-79f2-446d-b89e-dd2dd1c6e6ed",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Die ältere Frau hatte Krampfadern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
