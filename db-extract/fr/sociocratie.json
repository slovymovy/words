                        "entry_id": "2a86cfea-669d-3034-9214-baff228c7479",
                        "glosses": [
                            "Mode de prise de décision et de gouvernance qui permet à une organisation de se comporter comme un organisme vivant, de s'auto-organiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2962fd2d-f98a-4967-b29a-760a7d223f88",
                                "sense_id": "d9bcbe91-7160-33bd-868b-264024ddbbff",
                                "text": "J’ai décidé d’expérimenter avec l’aide de mon père, Bernard-Marie, expert en mode de gouvernance, un nouveau système, s’inspirant de la sociocratie, allant dans le sens des fondamentaux des AMAP."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7c7e5de-aad5-4b3f-b091-3511daa6d519",
                        "source_entry_id": "2a86cfea-669d-3034-9214-baff228c7479",
                        "source_sense_id": "d9bcbe91-7160-33bd-868b-264024ddbbff",
                        "target_lang_word": "Soziokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soziokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "061c863e-6683-3c80-9896-e350488dba32",
                                        "entry_id": "4f77b485-f107-3aee-b635-1fcf589224ab",
                                        "glosses": [
                                            "Organisationsform einer Familie, einer Institution, eines Unternehmen oder Ähnlichem, die ausschließlich auf Selbstorganisation setzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f988705-2115-4988-868f-b51593317df3",
                                                "sense_id": "061c863e-6683-3c80-9896-e350488dba32",
                                                "text": "„Die Soziokratie ist die Mutter der Holakratie und ein sehr einfaches System für mehr Mitbestimmung der Mitarbeitenden, mehr Engagement, bessere Lösungen und konstruktive Zusammenarbeit.“"
                                            },
                                            {
                                                "example_id": "01b5152a-61bf-4238-b101-231df813d749",
                                                "sense_id": "061c863e-6683-3c80-9896-e350488dba32",
                                                "text": "„Soziokratie ist kein Idealismus, Soziokratie ist objektiv, wissenschaftlich bestätigt und in der Praxis erprobt.““"
                                            },
                                            {
                                                "example_id": "ee356076-a5bb-46c2-8b9b-bff2e4086dec",
                                                "sense_id": "061c863e-6683-3c80-9896-e350488dba32",
                                                "text": "„Eine Alternative ist die Soziokratie, gern als ‚gemeinsame Herrschaft‘ bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
