                        "examples": [
                            {
                                "example_id": "29f7747a-29f8-4080-82ab-c544e0b9029e",
                                "sense_id": "867c7c1f-f84c-3afe-9406-205cff225cba",
                                "text": "Un homme-oiseau dont on découvre l’évolution est tout aussi étonnant que l’animal sauvage que devient le lycéen incarné par Paul Kircher."
                            },
                            {
                                "example_id": "19c9faf2-1531-41fa-a7a9-a9797b154ca8",
                                "sense_id": "867c7c1f-f84c-3afe-9406-205cff225cba",
                                "text": "Les quatre \"hommes-oiseaux\" symbolisent les quatre points cardinaux et le périlleux rituel vise à stimuler la fertilité de la terre."
                            },
                            {
                                "example_id": "a6a16608-b81b-40d3-99a7-78f5ae2b198e",
                                "sense_id": "867c7c1f-f84c-3afe-9406-205cff225cba",
                                "text": "Les Hommes-oiseaux sont des créatures plus ou moins intelligentes qui auraient habité les îles au centre du Lac Rumare durant durant l'ère Méréthique."
                            }
                        ]
                    }
