                                    {
                                        "sense_id": "b31a064c-eefb-382f-8a85-5014fbfe5ea1",
                                        "entry_id": "825139d1-ee92-3893-8d04-e416a098a3d5",
                                        "glosses": [
                                            "een fysieke of bedrijfsmatige tussenpersoon die op een beurs zorgde voor het samenbrengen van vraag en aanbod in een aantal hem/haar toegewezen beursfondsen"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93cba29d-dc94-4d61-b6b6-cc5974dc0685",
                                                "sense_id": "b31a064c-eefb-382f-8a85-5014fbfe5ea1",
                                                "text": "Ik zag de handelaren weer met snelle tred rondstappen, beursboekje in de hand.\nIk zag de hoekmannen weer staan.\nIk hoorde de arbitrageanten, hangende uit hun nissen, telefoons om hun nek, weer roepen."
                                            },
                                            {
                                                "example_id": "b3828b73-83ab-4839-bb9d-df53a8e2c00d",
                                                "sense_id": "b31a064c-eefb-382f-8a85-5014fbfe5ea1",
                                                "text": "„Aan het begin van deze eeuw zag je dat veel hoekmannen nadat ze van de beursvloer verdwenen, als daghandelaren aan de slag gingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92992351-9c92-3be0-bb72-0fc4cd6e5282",
                                        "entry_id": "825139d1-ee92-3893-8d04-e416a098a3d5",
                                        "glosses": [
                                            "beeld aan de zijkant van de achterkant van een schip"
                                        ],
