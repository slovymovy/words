                    },
                    {
                        "sense_id": "54b0776f-9b61-320c-a9d3-90a546f9db1a",
                        "entry_id": "2acefc99-4268-3331-aca2-371cc58c176b",
                        "glosses": [
                            "To square."
                        ],
                        "tags": [
                            "ambitransitive",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "76b4335a-97c7-48a9-8e4c-d3aa63fb8116",
                                "sense_id": "54b0776f-9b61-320c-a9d3-90a546f9db1a",
                                "text": "quadrating the circle"
                            }
                        ]
                    },
                    {
                        "sense_id": "db46462d-5e48-3a7c-852e-6232563a4abe",
                        "entry_id": "2acefc99-4268-3331-aca2-371cc58c176b",
                        "glosses": [
                            "To square; to agree; to suit; to correspond (with)."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "58eb0b09-456a-4dfd-a2cb-2a90fdff0374",
                                "sense_id": "db46462d-5e48-3a7c-852e-6232563a4abe",
                                "text": "not quadrating with American ideas of right, justice and reason"
                            },
                            {
                                "example_id": "05cde631-3c20-4aec-969d-432d279709e9",
                                "sense_id": "db46462d-5e48-3a7c-852e-6232563a4abe",
                                "text": "The objections of these speculatists, if its forces do not quadrate with their theories, are as valid against such an old and beneficent government as against the most violent tyranny or the greenest usurpation."
                            },
                            {
                                "example_id": "f69136ae-aaa8-43b7-bd6b-e174df6d6ce0",
                                "sense_id": "db46462d-5e48-3a7c-852e-6232563a4abe",
                                "text": "In short I am resolved, from this instance, never to give way to the weakness of human nature more, nor to think anything virtue which doth not exactly quadrate with the unerring rule of right."
                            }
                        ]
                    }
                ],
