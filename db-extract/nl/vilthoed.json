                        "translation_id": "9208510c-31d4-4ce0-a10c-e2f8b2e17e36",
                        "source_entry_id": "c3e1c516-690e-3733-bf46-e7b1ba9279d8",
                        "source_sense_id": "d16cd2bc-6361-3892-8304-435a9ee5487f",
                        "source_sense_description": "hoed",
                        "target_lang_word": "Filzhut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Filzhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bffdc573-85e9-3519-b909-59e9e9ee970f",
                                        "entry_id": "bcba90dd-7010-3abf-83ce-4216c72aa315",
                                        "glosses": [
                                            "Hut aus Filz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5790bcd1-e84f-47e1-9329-78f4b0f2c6a8",
                                                "sense_id": "bffdc573-85e9-3519-b909-59e9e9ee970f",
                                                "text": "„Durch die Okulare sah er eine dunkel gekleidete Frau mit breitrandigem Filzhut, unter dem das graue Haar hervorquoll.“"
                                            },
                                            {
                                                "example_id": "275f925d-723a-413f-b73e-2239a37c6b88",
                                                "sense_id": "bffdc573-85e9-3519-b909-59e9e9ee970f",
                                                "text": "„Nichts als Hüte, Strohhüte und Filzhüte, Damenhüte und Herrenhüte, weiche Hüte und harte macht diese Stadt.“"
                                            },
                                            {
                                                "example_id": "622b0a2b-43d4-4320-b117-4053fca88dae",
                                                "sense_id": "bffdc573-85e9-3519-b909-59e9e9ee970f",
                                                "text": "„Vor der Kirche steht eine Frau, sie trägt einen beigen Sommermantel, auf dem Kopf trägt sie einen eleganten schwarzen Filzhut mit Band.“"
                                            },
                                            {
                                                "example_id": "f6bdecd1-e534-4e83-aff5-640db12e86a3",
                                                "sense_id": "bffdc573-85e9-3519-b909-59e9e9ee970f",
                                                "text": "„Er trug einen grauen Filzhut mit ringsherum heruntergeklappter Krempe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e148870e-0480-429f-a3d8-2dc01f839d2b",
                        "source_entry_id": "c3e1c516-690e-3733-bf46-e7b1ba9279d8",
