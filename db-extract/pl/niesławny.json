                                        "entry_id": "b4e6cd65-f368-3e71-a520-2d5ce49ce3c6",
                                        "glosses": [
                                            "не заслуживающий славы, уважения; недостойный, позорный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b721ed-3d7d-4826-9b00-aa8aeedeec05",
                                                "sense_id": "c32a78a5-a046-3602-befd-143113d62a9c",
                                                "text": "― Помнишь ли, пустой, пустой, бесславный, малодушный, вечно, вечно пустой человек!"
                                            },
                                            {
                                                "example_id": "7c25734d-2d12-47e7-b94b-4d983d78784f",
                                                "sense_id": "c32a78a5-a046-3602-befd-143113d62a9c",
                                                "text": "Что ж, их ждет та же участь, тот же бесславный конец, что и их бесноватого предшественника…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
