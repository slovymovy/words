                "senses": [
                    {
                        "sense_id": "8fdeb75e-9195-3a5a-8c8d-42e21af313a2",
                        "entry_id": "3b153b01-a39f-3cce-a247-bf67a330a2ab",
                        "glosses": [
                            "Manipuler à une échelle microscopique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4103ca9-c3a9-4ad2-9d30-463a5d297f58",
                                "sense_id": "8fdeb75e-9195-3a5a-8c8d-42e21af313a2",
                                "text": "Car pour micromanipuler les bactéries et même les microopérer, — c'est ainsi qu'il est possible d'extraire d'un liquide pollué par des germes microbiens d'espèces variées un seul microbe — il faut posséder des microinstruments."
                            },
                            {
                                "example_id": "37ed192d-be46-4f70-a450-be6e90260806",
                                "sense_id": "8fdeb75e-9195-3a5a-8c8d-42e21af313a2",
                                "text": "Les animaux développés à partir des embryons micromanipulés naissent dix-neuf jours après le transfert."
                            }
                        ]
                    }
                ],
