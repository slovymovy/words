    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7f50fa7-a20f-398e-8dcd-52c266bd28be",
                    "sense_definition": "een grote zwarte vogel uit het geslacht Corvus",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk, er zit een zwarte <w>kraai</w> in de boom!",
                            "target_lang_translations": {
                                "en": "Look, there is a black <w>crow</w> in the tree!",
                                "pl": "Spójrz, na drzewie siedzi czarna <w>wrona</w>!"
                            }
                        },
                        {
                            "text": "De <w>kraai</w> vloog weg toen ik dichterbij kwam.",
                            "target_lang_translations": {
                                "en": "The <w>crow</w> flew away when I came closer.",
                                "pl": "<w>Wrona</w> odleciała, gdy podszedłem bliżej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zwarte kraai"
                    ],
                    "target_lang_definitions": {
                        "en": "a large black bird of the genus Corvus",
                        "pl": "duży czarny ptak z rodzaju Corvus (wrona, kruk)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "the bird"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wrona",
                                "target_lang_sense_clarification": "ptak z rodzaju Corvus"
                            },
                            {
                                "target_lang_word": "czarnowron",
                                "target_lang_sense_clarification": "gatunek Corvus corone (zwarte kraai)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c97c77af-f51e-36bf-8254-6c8dcaf8f61c",
                    "sense_definition": "het schorre geluid dat een vogel zoals een haan of een kraai maakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een luide <w>kraai</w> kondigde de haan de nieuwe ochtend aan.",
                            "target_lang_translations": {
                                "en": "With a loud <w>crow</w>, the rooster announced the new morning.",
                                "pl": "Głośnym <w>pianiem</w> kogut obwieścił nadejście nowego poranka."
                            }
                        },
                        {
                            "text": "Ik hoorde de schorre <w>kraai</w> van de vogel in het bos.",
                            "target_lang_translations": {
                                "en": "I heard the hoarse <w>caw</w> of the bird in the forest.",
                                "pl": "Usłyszałem ochrypłe <w>krakanie</w> ptaka w lesie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the harsh sound made by a bird such as a rooster or a crow",
                        "pl": "ochrypły dźwięk wydawany przez ptaka, na przykład koguta lub wronę"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "the sound of a rooster"
                            },
                            {
                                "target_lang_word": "caw",
                                "target_lang_sense_clarification": "the sound of a crow"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pianie",
                                "target_lang_sense_clarification": "głos koguta"
                            },
                            {
                                "target_lang_word": "krakanie",
                                "target_lang_sense_clarification": "głos wrony lub kruka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40e244ca-3252-358d-9274-a974a1bd57e3",
                    "sense_definition": "een begrafenisondernemer of iemand die bij een begrafenis werkt, vaak in het zwart gekleed",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kraai</w> liep statig voor de rouwstoet uit naar het graf.",
                            "target_lang_translations": {
                                "en": "The <w>undertaker</w> walked stately ahead of the funeral procession to the grave.",
                                "pl": "<w>Grabarz</w> kroczył uroczyście przed konduktem żałobnym w stronę grobu."
                            }
                        },
                        {
                            "text": "Vroeger noemden mensen een begrafenisondernemer vaak gekscherend een <w>kraai</w>.",
                            "target_lang_translations": {
                                "en": "In the past, people often jokingly called an undertaker a <w>crow</w>.",
                                "pl": "Kiedyś ludzie żartobliwie nazywali przedsiębiorcę pogrzebowego <w>krukiem</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak informeel of licht spottend gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an undertaker or someone working at a funeral, often dressed in black",
                        "pl": "przedsiębiorca pogrzebowy lub pracownik zakładu pogrzebowego, potocznie określany ze względu na czarny ubiór"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "undertaker",
                                "target_lang_sense_clarification": "funeral professional"
                            },
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "informal term for an undertaker"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "grabarz",
                                "target_lang_sense_clarification": "pracownik cmentarny lub pogrzebowy"
                            },
                            {
                                "target_lang_word": "przedsiębiorca pogrzebowy",
                                "target_lang_sense_clarification": "osoba prowadząca zakład pogrzebowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9023707d-7707-3021-ad80-54f59675fea8",
                    "sense_definition": "een onaangename of lelijke vrouw",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude <w>kraai</w> zat de hele dag alleen maar te klagen.",
                            "target_lang_translations": {
                                "en": "That <w>old crow</w> sat complaining all day long.",
                                "pl": "Ta stara <w>wiedźma</w> przez cały dzień tylko narzekała."
                            }
                        },
                        {
                            "text": "Hij noemde zijn gemene buurvrouw een valse <w>kraai</w>.",
                            "target_lang_translations": {
                                "en": "He called his mean neighbor a nasty <w>hag</w>.",
                                "pl": "Nazwał swoją wredną sąsiadkę fałszywą <w>jędzą</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "beledigend bedoeld"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an unpleasant or ugly woman",
                        "pl": "nieprzyjemna, złośliwa lub brzydka kobieta (wyzwisko)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "old crow",
                                "target_lang_sense_clarification": "derogatory term for a woman"
                            },
                            {
                                "target_lang_word": "hag",
                                "target_lang_sense_clarification": "unpleasant woman"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wiedźma",
                                "target_lang_sense_clarification": "złośliwa kobieta"
                            },
                            {
                                "target_lang_word": "jędza",
                                "target_lang_sense_clarification": "nieprzyjemna, dokuczliwa kobieta"
                            },
                            {
                                "target_lang_word": "ropucha",
                                "target_lang_sense_clarification": "brzydka lub złośliwa kobieta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8de3ffc5-f7ab-3d75-acd6-c96fb37e6795",
                    "sense_definition": "een historisch type Scandinavisch zeilschip",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het museum staat een replica van een middeleeuwse <w>kraai</w>.",
                            "target_lang_translations": {
                                "en": "In the museum, there is a replica of a medieval <w>corvus</w>.",
                                "pl": "W muzeum znajduje się replika średniowiecznej <w>krajery</w>."
                            }
                        },
                        {
                            "text": "De <w>kraai</w> werd vroeger veel gebruikt voor de handel op de Oostzee.",
                            "target_lang_translations": {
                                "en": "The <w>corvus</w> was used a lot in the past for trade on the Baltic Sea.",
                                "pl": "<w>Krajera</w> była dawniej powszechnie używana do handlu na Morzu Bałtyckim."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische scheepsterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a historical type of Scandinavian sailing ship",
                        "pl": "historyczny typ skandynawskiego statku żaglowego"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corvus",
                                "target_lang_sense_clarification": "historical ship type"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "krajera",
                                "target_lang_sense_clarification": "historyczny typ żaglowca (crayer)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f90855f-a43a-3752-b7f7-25bf86b5ac44",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>kraaien</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kraai</w> van plezier als ik dat goede nieuws hoor.",
                            "target_lang_translations": {
                                "en": "I <w>crow</w> with pleasure when I hear that good news.",
                                "pl": "<w>Pieję</w> z zachwytu, kiedy słyszę tę dobrą wiadomość."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>kraai</w> ik als een haan om iedereen wakker te maken.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>crow</w> like a rooster to wake everyone up.",
                                "pl": "Każdego ranka <w>pieję</w> jak kogut, żeby wszystkich obudzić."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to crow'",
                        "pl": "pierwsza osoba liczby pojedynczej czasu teraźniejszego od czasownika „kraaien” (piać, krakać, piszczeć z radości)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "to make a sound of joy or a rooster's cry"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pieję",
                                "target_lang_sense_clarification": "od piania koguta lub z radości"
                            },
                            {
                                "target_lang_word": "kraczę",
                                "target_lang_sense_clarification": "od krakania ptaka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21d5fe5c-59f4-393b-8f58-9d500b3f25ba",
                    "sense_definition": "de gebiedende wijs van <w>kraaien</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kraai</w> nu eens niet zo hard tegen me!",
                            "target_lang_translations": {
                                "en": "Don't <w>crow</w> so loudly at me for once!",
                                "pl": "Nie <w>wrzeszcz</w> tak na mnie choć raz!"
                            }
                        },
                        {
                            "text": "Kom op, <w>kraai</w> als een haan voor het toneelstuk.",
                            "target_lang_translations": {
                                "en": "Come on, <w>crow</w> like a rooster for the play.",
                                "pl": "Dalej, <w>zapiej</w> jak kogut do tej sztuki."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'to crow'",
                        "pl": "tryb rozkazujący od czasownika „kraaien” (piej, kracz)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "command to make a sound"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "piej",
                                "target_lang_sense_clarification": "rozkaz wydawania głosu koguta"
                            },
                            {
                                "target_lang_word": "kracz",
                                "target_lang_sense_clarification": "rozkaz wydawania głosu wrony"
                            }
                        ]
                    }
                }
            ]
        }
    ]
