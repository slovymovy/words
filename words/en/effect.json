{
    "word_family": [
        "effective",
        "effectively",
        "effectiveness",
        "effectual",
        "effectuate",
        "ineffective",
        "side-effect"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab5edbfd-b7f1-357c-8578-804b9c2a2129",
                    "sense_definition": "The result or outcome produced by a specific cause.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>effect</w> of the heavy rain was a flooded basement.",
                            "target_lang_translations": {
                                "ru": "<w>Результатом</w> сильного дождя стал затопленный подвал."
                            }
                        },
                        {
                            "text": "Scientists are studying the long-term <w>effect</w> of the new medicine on patients.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают долгосрочный <w>эффект</w> нового лекарства на пациентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequence"
                    ],
                    "antonyms": [
                        "consequence",
                        "result"
                    ],
                    "common_phrases": [
                        "cause and effect",
                        "side effect",
                        "positive effect",
                        "negative effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат или последствие, вызванное определенной причиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффект",
                                "target_lang_sense_clarification": "результат действия"
                            },
                            {
                                "target_lang_word": "последствие",
                                "target_lang_sense_clarification": "результат, следствие"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "итог процесса"
                            },
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "воздействие на что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d824e0f9-27c7-3f87-b3e3-4a9aa5917259",
                    "sense_definition": "The state of being binding, active, or enforceable, especially regarding a law or rule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new safety regulations will <w>come</w> <w>into</w> <w>effect</w> starting next Monday.",
                            "target_lang_translations": {
                                "ru": "Новые правила техники безопасности вступят в <w>силу</w> со следующего понедельника."
                            }
                        },
                        {
                            "text": "The contract remains in <w>effect</w> until both parties agree to terminate it.",
                            "target_lang_translations": {
                                "ru": "Контракт остается в <w>силе</w> до тех пор, пока обе стороны не согласятся его расторгнуть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "come into effect",
                        "take effect",
                        "in effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние юридической силы, действия или применимости, особенно в отношении закона или правила."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "юридическая сила закона"
                            },
                            {
                                "target_lang_word": "действие",
                                "target_lang_sense_clarification": "период действия правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8470ea8b-91ed-3de3-8c3f-72a0b9b00edd",
                    "sense_definition": "An impression or sensation produced in the mind of a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used bright colors to create a dramatic <w>effect</w> in the painting.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркие цвета, чтобы создать драматический <w>эффект</w> в картине."
                            }
                        },
                        {
                            "text": "He spoke loudly just for oratorical <w>effect</w> to impress the large audience.",
                            "target_lang_translations": {
                                "ru": "Он говорил громко просто ради ораторского <w>эффекта</w>, чтобы произвести впечатление на большую аудиторию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dramatic effect",
                        "visual effect",
                        "for effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впечатление или ощущение, производимое на человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффект",
                                "target_lang_sense_clarification": "произведенное впечатление"
                            },
                            {
                                "target_lang_word": "впечатление",
                                "target_lang_sense_clarification": "ощущение в уме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1bcd4d-8869-37a5-b2b7-5cb8054128f5",
                    "sense_definition": "An illusion or technical trick used in film or media to simulate imagined events.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie won an award for its incredible special <w>effect</w> sequences.",
                            "target_lang_translations": {
                                "ru": "Фильм получил награду за невероятные сцены со <w>спецэффектами</w>."
                            }
                        },
                        {
                            "text": "The sound <w>effect</w> of the explosion was very realistic in the theater.",
                            "target_lang_translations": {
                                "ru": "Звуковой <w>эффект</w> взрыва в кинотеатре был очень реалистичным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "special effect",
                        "sound effect",
                        "visual effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иллюзия или технический прием, используемый в кино или медиа для имитации воображаемых событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффект",
                                "target_lang_sense_clarification": "технический прием в кино"
                            },
                            {
                                "target_lang_word": "спецэффект",
                                "target_lang_sense_clarification": "визуальный или звуковой трюк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54f7fd91-6f92-3054-9171-217be13482fb",
                    "sense_definition": "The general intent, meaning, or purpose of something said or written.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't use those exact words, but he said something to that <w>effect</w>.",
                            "target_lang_translations": {
                                "ru": "Он не использовал именно эти слова, но сказал что-то в этом <w>смысле</w>."
                            }
                        },
                        {
                            "text": "The manager sent a memo to the <w>effect</w> that all staff must attend.",
                            "target_lang_translations": {
                                "ru": "Менеджер разослал служебную записку о <w>том</w>, что весь персонал должен присутствовать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "to that effect",
                        "to the effect that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий смысл, намерение или цель сказанного или написанного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "общая суть сказанного"
                            },
                            {
                                "target_lang_word": "содержание",
                                "target_lang_sense_clarification": "основная мысль сообщения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f5e2d3d-f41f-320d-abf5-693fb2fa45b9",
                    "sense_definition": "Personal belongings or movable property.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel is not responsible for any personal <w>effects</w> left in the room.",
                            "target_lang_translations": {
                                "ru": "Отель не несет ответственности за любые личные <w>вещи</w>, оставленные в номере."
                            }
                        },
                        {
                            "text": "After the fire, they tried to recover their household <w>effects</w> from the ruins.",
                            "target_lang_translations": {
                                "ru": "После пожара они пытались извлечь из руин свое домашнее <w>имущество</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal effects",
                        "household effects"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личные вещи или движимое имущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещи",
                                "target_lang_sense_clarification": "личные пожитки"
                            },
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "движимая собственность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f024bb5-95e3-35ff-b0b6-78f9bb1a4b2b",
                    "sense_definition": "A scientific phenomenon or physical law, often named after its discoverer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Doppler <w>effect</w> explains why a siren changes pitch as it passes.",
                            "target_lang_translations": {
                                "ru": "<w>Эффект</w> Доплера объясняет, почему высота звука сирены меняется при ее прохождении мимо."
                            }
                        },
                        {
                            "text": "Students learned about the greenhouse <w>effect</w> and its impact on global temperatures.",
                            "target_lang_translations": {
                                "ru": "Студенты узнали о парниковом <w>эффекте</w> и его влиянии на глобальную температуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "greenhouse effect",
                        "doppler effect",
                        "placebo effect"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Научное явление или физический закон, часто называемый в честь первооткрывателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффект",
                                "target_lang_sense_clarification": "физическое явление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21e025ba-9648-35ab-a3f0-00a53b559547",
                    "sense_definition": "To bring about, implement, or make something happen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new CEO hopes to <w>effect</w> change within the corporate culture quickly.",
                            "target_lang_translations": {
                                "ru": "Новый генеральный директор надеется быстро <w>осуществить</w> изменения в корпоративной культуре."
                            }
                        },
                        {
                            "text": "It is difficult to <w>effect</w> repairs when the necessary parts are missing.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>произвести</w> ремонт, когда отсутствуют необходимые детали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "effect change",
                        "effect repairs",
                        "effect a cure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществлять, внедрять или приводить к выполнению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "приводить в исполнение"
                            },
                            {
                                "target_lang_word": "производить",
                                "target_lang_sense_clarification": "вызывать изменения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}