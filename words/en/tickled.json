{
    "word_family": [
        "tickle",
        "tickler",
        "ticklish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "928cc434-ea4c-3007-aea0-9289e39ae8b7",
                    "sense_definition": "Very pleased or delighted.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>tickled</w> pink by the surprise party her friends organized.",
                            "target_lang_translations": {
                                "ru": "Она была <w>в полном восторге</w> от вечеринки-сюрприза, которую устроили её друзья."
                            }
                        },
                        {
                            "text": "He was <w>tickled</w> to receive such a kind letter from his old teacher.",
                            "target_lang_translations": {
                                "ru": "Он был <w>очень рад</w> получить такое доброе письмо от своего старого учителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "delighted",
                        "pleased",
                        "thrilled"
                    ],
                    "antonyms": [
                        "displeased",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "tickled pink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень довольный, обрадованный или польщенный чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очень довольный",
                                "target_lang_sense_clarification": "выражает сильное удовлетворение или радость"
                            },
                            {
                                "target_lang_word": "польщенный",
                                "target_lang_sense_clarification": "когда кто-то чувствует приятное удивление от внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3f3fc65-bb1d-3db0-ac6c-1b1cd0ce23d2",
                    "sense_definition": "Simple past and past participle of <w>tickle</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby laughed loudly when his father <w>tickled</w> his feet.",
                            "target_lang_translations": {
                                "ru": "Малыш громко смеялся, когда отец <w>пощекотал</w> ему ступни."
                            }
                        },
                        {
                            "text": "She <w>tickled</w> the child until he could not stop giggling.",
                            "target_lang_translations": {
                                "ru": "Она <w>щекотала</w> ребенка, пока тот не начал безудержно хихикать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола «щекотать», означающего прикосновение к телу, вызывающее смех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пощекотал",
                                "target_lang_sense_clarification": "форма прошедшего времени мужского рода"
                            },
                            {
                                "target_lang_word": "пощекотала",
                                "target_lang_sense_clarification": "форма прошедшего времени женского рода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
