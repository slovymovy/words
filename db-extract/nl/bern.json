                                "target_senses": [
                                    {
                                        "sense_id": "4df19655-589e-3573-91ec-803ef57cd3b6",
                                        "entry_id": "a5066d47-9114-32ec-934f-e3d75e82df93",
                                        "glosses": [
                                            "Stadt in der Schweiz; Bundesstadt der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037a4e79-055f-4fce-9070-3e2b7bb43292",
                                                "sense_id": "4df19655-589e-3573-91ec-803ef57cd3b6",
                                                "text": "Die BernShow bringt Ihnen die Geschichte von Bern in multivisuellen Bildern näher und zeigt das moderne Bern in all seinen Facetten."
                                            },
                                            {
                                                "example_id": "0555bf7c-2341-42b9-8280-9e5c0cae4dd7",
                                                "sense_id": "4df19655-589e-3573-91ec-803ef57cd3b6",
                                                "text": "Nach Art. 32 des Bundesgesetzes über die Bundesversammlung vom 13. Dezember 2002 versammelt sich die Bundesversammlung in Bern. Gemäss Art. 58 des Regierungs- und Verwaltungsorganisationsgesetzes vom 21. März 1997 ist die Stadt Bern Amtssitz des Bundesrates, der Departemente und der Bundeskanzlei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8855ed49-9ea6-3921-b21b-0eff8709386c",
                                        "entry_id": "a5066d47-9114-32ec-934f-e3d75e82df93",
                                        "glosses": [
                                            "Schweizer Kanton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfefd9e0-49fe-4b28-a142-bd78cf44fdd3",
                                                "sense_id": "8855ed49-9ea6-3921-b21b-0eff8709386c",
                                                "text": "Jede siebte Schweizerin und jeder siebte Schweizer lebt im Kanton Bern: Mit 13% der schweizerischen Bevölkerung ist Bern damit der zweitgrösste Kanton nach Zürich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "780858d5-54bb-3e20-9972-df2d879fe87b",
                                        "entry_id": "a5066d47-9114-32ec-934f-e3d75e82df93",
                                        "glosses": [
                                            "Verona; Stadt in Italien"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50648cd1-0496-4f57-8c5a-c823f2accc14",
                                                "sense_id": "780858d5-54bb-3e20-9972-df2d879fe87b",
                                                "text": "Bern ist der veraltete Name der italienischen Stadt Verona."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
