                    }
                ],
                "senses": [
                    {
                        "sense_id": "286dfbf0-05e7-3612-a7b3-909ac2464a79",
                        "entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                        "glosses": [
                            "Vocalise d’une grande virtuosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae83e2c-f019-4de6-aa03-cc0757a3d3f9",
                                "sense_id": "286dfbf0-05e7-3612-a7b3-909ac2464a79",
                                "text": "Les opéras de Rossini regorgent de coloratures."
                            }
                        ]
                    },
                    {
                        "sense_id": "5962e903-59c5-31a3-9b70-3f495966c26e",
                        "entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                        "glosses": [
                            "Personne capable de cette virtuosité vocale, notamment dans les aiguës."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "f1b52b98-f02f-43da-9f4c-dfb22d3ba66c",
                                "sense_id": "5962e903-59c5-31a3-9b70-3f495966c26e",
                                "text": "Les plus grandes coloratures ont interprété l’air de la Reine de la nuit de Mozart (\"La Flûte enchantée\") ou \"Les oiseaux dans la charmille\" d’Offenbach (\"Les contes d’Hoffmann\")."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "000e3d2a-def8-4993-ad7b-fdc792b9c7a3",
                        "source_entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                        "target_lang_word": "Koloratur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koloratur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61df6afb-961a-3475-b624-05519e789d2c",
                                        "entry_id": "9f76ec1d-ddca-3f0f-aabe-e9fbd7b99b1e",
                                        "glosses": [
                                            "verzierende stimmliche Variation beim Gesang"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccadf9b1-d46f-4995-a770-2e4a8fc4fcad",
                                                "sense_id": "61df6afb-961a-3475-b624-05519e789d2c",
                                                "text": "Das Museumsorchester erwärmte sich bald zur nötigen spritzigen Delikatesse mit genügend akustischem Freiraum für die atemraubenden Koloraturen von insgesamt vierzehn Goldkehlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d15139e6-5e62-4a24-90c3-d7e8dd8c2dc1",
                        "source_entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                        "target_lang_word": "coloratura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coloratura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c7d474-6ed8-30de-8ee3-15acf45127a7",
                                        "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                                        "glosses": [
                                            "Florid or fancy passages in vocal music."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff266c13-2bb1-4887-9ca7-ccf22880b598",
                                                "sense_id": "66c7d474-6ed8-30de-8ee3-15acf45127a7",
                                                "text": "The singing is generally excellent, with Simon Keenlyside standing out for his richly vocalized (and amusingly dour) Papageno and Diana Damrau for her spot-on coloratura and genuine venom as the Queen of the Night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bbab5d-52e2-3118-90e6-d9fb62196a9d",
                                        "entry_id": "c630b8d8-a6c9-3eb6-95ed-b37ee383199e",
                                        "glosses": [
                                            "A singer of such passages, especially a soprano."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff2113a-72c5-4b50-bdfc-9c61f73dc926",
                                                "sense_id": "a9bbab5d-52e2-3118-90e6-d9fb62196a9d",
                                                "text": "The middle one, of course, was the coloratura Julia Kristeva, known as the most voluptuous Salome in the business."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coloratura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                                        "entry_id": "b9ec098a-5bb9-3f71-83e5-d0b269adee58",
                                        "glosses": [
                                            "Pertaining to coloratura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8be76ed-ce18-40b6-a3cb-297251165ad9",
                                                "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                                                "text": "She has a lighter and more coloratura voice."
                                            },
                                            {
                                                "example_id": "f352395c-16d2-43b6-a0c8-b3eda48fc4a7",
                                                "sense_id": "aa808234-dc2f-3826-ab86-fe986ef4ec9d",
                                                "text": "I drew a deep breath, this time fortunately unmixed with gin and tonic. I was profoundly stirred. “You mean,” I said, my voice quavering like that of a coloratura soprano, “that I went through that soul-shattering experience all for nothing?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
