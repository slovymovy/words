                "senses": [
                    {
                        "sense_id": "e01aa335-a2d1-3534-9e09-38b212223a67",
                        "entry_id": "326d3d84-1751-3b74-9f8b-9c6431b7d191",
                        "glosses": [
                            "Bóg"
                        ],
                        "tags": [
                            "childish",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "255c53b7-7ad9-413a-91c1-00b6336022be",
                                "sense_id": "e01aa335-a2d1-3534-9e09-38b212223a67",
                                "text": "Tam w górze jest Bozia. Bozia gniewa się na niegrzeczne dzieci, a grzecznym daje bułeczki, ciasteczka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "489446ce-a869-3845-a597-545d02583604",
                        "entry_id": "326d3d84-1751-3b74-9f8b-9c6431b7d191",
                        "glosses": [
                            "święty obrazek"
                        ],
                        "tags": [
                            "childish",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "41af1e83-45e4-44f9-88ec-fe1aa5966e24",
                                "sense_id": "489446ce-a869-3845-a597-545d02583604",
                                "text": "Mając nie całe dwa lata, zabierała ją mamusia do kościoła i wskazując na ołtarz, mówiła: „Tam przed nami jest Bozia, złóż rączki i patrz tam.”"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
