                                "example_id": "61a71495-5fbf-4000-96b7-f36f9350b846",
                                "sense_id": "f83dcf41-ec7a-371c-a37d-a5eea4972446",
                                "text": "Sublimitäten sind oft nur mit einem entwickelten Feingespür wahrnehmbar."
                            }
                        ],
