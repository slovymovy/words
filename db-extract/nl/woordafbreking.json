                "translations": [
                    {
                        "translation_id": "59948264-bafc-426d-8ebd-482210da1c5b",
                        "source_entry_id": "e29d116b-2d31-3e04-8815-93012ca0b0c6",
                        "source_sense_id": "66953832-c026-352f-a2f8-8c9becc9bb7a",
                        "target_lang_word": "Worttrennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Worttrennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                        "entry_id": "ae52499f-e39a-3426-ab5f-da66ab851b61",
                                        "glosses": [
                                            "Aufspaltung, Trennung eines Wortes in Silben zum Zwecke der Verteilung auf eine weitere Zeile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf77ff39-f6b3-49fd-96c7-06078e7ca3f3",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "Die Angaben zur Worttrennung sind für Schreibanfänger sehr hilfreich."
                                            },
                                            {
                                                "example_id": "ee7ae9b6-82d7-4907-a9e8-8a2571766eac",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "Die Worttrennung orientiert sich oft an den Silben des Wortes, hält sich aber keineswegs immer an sie: Das Wort \"Atom\" z.B. ist zweisilbig, soll aber nicht getrennt werden."
                                            },
                                            {
                                                "example_id": "b46fd308-5c82-437b-a277-d8aef82f6f2a",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Die Worttrennungen am Zeilenende konnten dann auch nach grammatischen Regeln durchgeführt werden.“"
                                            },
                                            {
                                                "example_id": "732ca975-61e8-467a-a5ce-ed5bd1256d07",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Die geltenden Regeln zur Worttrennung lassen – besonders bei Fremdwörtern – häufig mehrere Trennmöglichkeiten zu.“"
                                            },
                                            {
                                                "example_id": "a2f47f67-d3d7-4519-be03-33b6cef7b92a",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Nach der neuen Regelung der Worttrennung am Zeilenende ergeben sich bei vielen Fremdwörtern mehrere Trennvarianten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00507bc0-6ecb-4c18-a6ac-fa294dc927e3",
                        "source_entry_id": "e29d116b-2d31-3e04-8815-93012ca0b0c6",
