{
    "word_family": [
        "human",
        "humanity",
        "humanize",
        "humanism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36cdb10a-4362-38cf-89d4-b57417ae4892",
                    "sense_definition": "Having the appearance or characteristics of a human being.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human-like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists developed a <w>humanoid</w> robot that can walk and talk like a person.",
                            "target_lang_translations": {
                                "zh": "科学家们开发出了一种可以像人一样行走和说话的<w>类人</w>机器人。"
                            }
                        },
                        {
                            "text": "The alien creature had a <w>humanoid</w> shape with two arms and two legs.",
                            "target_lang_translations": {
                                "zh": "那个外星生物有着两臂两腿的<w>人形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humaniform"
                    ],
                    "common_phrases": [
                        "humanoid robot"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有人类外貌或特征的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "类人的",
                                "target_lang_sense_clarification": "形容具有人类特征的物体或生物"
                            },
                            {
                                "target_lang_word": "人形的",
                                "target_lang_sense_clarification": "形容外形像人的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15a64066-8a4b-3c1d-a6ac-f4d7c11f12ae",
                    "sense_definition": "A being that has the appearance or characteristics of a human.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human-like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many science fiction stories, a <w>humanoid</w> is a creature from another planet.",
                            "target_lang_translations": {
                                "zh": "在许多科幻故事中，<w>类人生物</w>是指来自另一个星球的生物。"
                            }
                        },
                        {
                            "text": "The engineers are working to make the <w>humanoid</w> move more naturally.",
                            "target_lang_translations": {
                                "zh": "工程师们正在努力让这个<w>人形机器人</w>的动作看起来更自然。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humaniform"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有人类外貌或特征的生物或机器人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "类人生物",
                                "target_lang_sense_clarification": "指外形像人的生物"
                            },
                            {
                                "target_lang_word": "人形机器人",
                                "target_lang_sense_clarification": "指外形像人的机器人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}