                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67719225-b48d-4eb2-ac31-d81b00b87013",
                                "sense_id": "2e3f0035-6db4-3e58-9d48-5dcda6e9c484",
                                "text": "Le législateur entend bien qu’effracter est donc un « plus », quelque chose qui produit un effet au-delà de l’objet du délit principal."
                            },
                            {
                                "example_id": "830f71e4-f064-4589-85af-a557e474925f",
                                "sense_id": "2e3f0035-6db4-3e58-9d48-5dcda6e9c484",
                                "text": "Les protagonistes sont encore maintenus captifs dans un monde à part, secret, qui devait rester caché, non visible, et que le thérapeute va effracter."
