                                                "sense_id": "f5111a03-2dde-3a4f-bbc6-fcd9dbf90e02",
                                                "text": "Ich spiele jede Woche Lotto."
                                            },
                                            {
                                                "example_id": "11e2f53f-290e-4a26-8bf3-88a7185456a1",
                                                "sense_id": "f5111a03-2dde-3a4f-bbc6-fcd9dbf90e02",
                                                "text": "Und was machst du mit der Million, wenn du im Lotto gewinnst?"
                                            }
