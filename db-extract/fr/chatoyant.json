                                "target_senses": [
                                    {
                                        "sense_id": "6f6f7f32-e80b-3297-8570-20b50733e480",
                                        "entry_id": "21b641e9-bd10-3dee-8b97-3c1092291290",
                                        "glosses": [
                                            "vol opvallende kleuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e867f6af-fa80-4495-a216-f85c93df81c4",
                                                "sense_id": "6f6f7f32-e80b-3297-8570-20b50733e480",
                                                "text": "Het marktplein met al zijn geweven stoffen maakte een kleurrijke indruk."
                                            },
                                            {
                                                "example_id": "f29c231a-be90-46b7-a06f-f352a5d324f7",
                                                "sense_id": "6f6f7f32-e80b-3297-8570-20b50733e480",
                                                "text": "Een figuratieve ambachtsman die flirtte met pop-art, die niks moet hebben van het minimalisme van grote rode vlakken of barbaarse abstracte kunst, maar portretten maakt en reusachtige kleurrijke natuurschilderingen. Een vrolijke, innemende snuiter bovendien."
                                            },
                                            {
                                                "example_id": "d6d12afc-fa21-4bea-85a6-0220d28874d4",
                                                "sense_id": "6f6f7f32-e80b-3297-8570-20b50733e480",
                                                "text": "Op de trail had ik eindelijk het gevoel een hippie te zijn omdat ik in een gemeenschap leefde van vrije geesten, kleurrijk en stoffig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
