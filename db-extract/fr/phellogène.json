            {
                "entry_id": "d94f94b0-0838-3d60-8432-19a125f63569",
                "word": "phellogène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd899fd0-36db-449a-8e80-f1935d42ec93",
                        "entry_id": "d94f94b0-0838-3d60-8432-19a125f63569",
                        "tags": [
                            "plural"
                        ],
                        "form": "phellogènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30521008-3fda-3039-bdfa-12d42c1ac642",
                        "entry_id": "d94f94b0-0838-3d60-8432-19a125f63569",
                        "glosses": [
                            "Méristème secondaire à l'origine du périderme, mis en place par dédifférenciation de cellules du parenchyme cortical sous-épidermique et parfois par l’épiderme, destiné à produire du phelloderme vers l'intérieur et du suber (liège) vers l'extérieur."
                        ],
                        "tags": [
                            "Histologie végétale"
                        ],
                        "examples": [
                            {
                                "example_id": "813f7b32-66d2-46a7-b830-c7773e7640a3",
                                "sense_id": "30521008-3fda-3039-bdfa-12d42c1ac642",
                                "text": "Quelques rares espèces ont un seul phellogène qui fonctionne de nombreuses années, voire pendant toute la durée de vie de l'arbre (hêtre, chêne liège)."
                            }
                        ]
                    }
                ],
