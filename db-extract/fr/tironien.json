                                        "glosses": [
                                            "Of or pertaining to Marcus Tullius Tiro (died circa 4 BCE), scribe of Cicero and inventor of an early shorthand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58d422e-9d41-4977-add0-c09827339ffe",
                                                "sense_id": "d68c3b29-46db-394a-904e-a9c03a15b308",
                                                "text": "The mark which expressed the word talis, being a little more sloped or inclined, expressed qualis; and the difference in the Tironian signs which stood for the complete words Ager and Amicus, was scarcely perceptible."
                                            }
