                "senses": [
                    {
                        "sense_id": "7f3381d4-bcfa-3f96-a7b1-a0a4f298f474",
                        "entry_id": "3877732e-b042-351e-945b-82937c11635e",
                        "glosses": [
                            "устар. то же, что мочка; пучок льна для прядения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59188203-ec4e-4516-bafb-9e36967dda22",
                                "sense_id": "7f3381d4-bcfa-3f96-a7b1-a0a4f298f474",
                                "text": "Смотри же, сена повыше наклади под подушку! да выдерни у бабы из мычки клочок пеньки, заткнуть мне уши на ночь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "76cb5c6c-5df5-3736-ba52-48b515b6b4aa",
                        "entry_id": "3877732e-b042-351e-945b-82937c11635e",
                        "glosses": [
                            "перен. борода (похожая на пучок льна)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750e8e81-6dca-4b2e-8e70-a63cef4a423a",
                                "sense_id": "76cb5c6c-5df5-3736-ba52-48b515b6b4aa",
                                "text": "Мужичок, с жёлтой мычкой на подбородке и в разноцветном зипунишке, сидит и трясётся на грядке, на которой и воробью сидеть в пору."
                            }
                        ]
                    }
