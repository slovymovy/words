                "entry_id": "4fa043a7-e48a-37ea-9fa5-ca0f679dc30e",
                "word": "merzlota",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37415eba-8dc8-473a-8dbe-3f569c1ca739",
                        "entry_id": "4fa043a7-e48a-37ea-9fa5-ca0f679dc30e",
                        "tags": [
                            "plural"
                        ],
                        "form": "merzlotas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06c9137f-5506-3b77-8525-df66ac3c0c63",
                        "entry_id": "4fa043a7-e48a-37ea-9fa5-ca0f679dc30e",
                        "glosses": [
                            "Couche du sol ne dégelant jamais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad8b7c0-0427-482f-9333-821e652e1275",
                                "sense_id": "06c9137f-5506-3b77-8525-df66ac3c0c63",
                                "text": "L'agronome doit tenir grand compte de la merzlota dont l'influence sur l'agriculture n'est pas encore très bien connue."
                            },
                            {
                                "example_id": "6c2d7e2a-e674-44b2-918c-00608aa40c9a",
                                "sense_id": "06c9137f-5506-3b77-8525-df66ac3c0c63",
                                "text": "Citant des experts, les journaux affirmaient que les marécages de Sibérie pris dans la merzlota fondent rapidement sous l'effet des changements climatiques. La situation serait donc grosse de projections de milliards de tonnes de méthane dans l'atmosphère et susceptible de provoquer une catastrophe écologique."
                            },
                            {
                                "example_id": "4cc217f8-4180-44fb-a93c-66c5431dd3b3",
                                "sense_id": "06c9137f-5506-3b77-8525-df66ac3c0c63",
                                "text": "Ces immeubles ont été construits sur la merzlota (terre gelée toute l’année); à l’époque, c’était un exploit technique sans précédent. Mais après 20, 30, 40 ans d’exploitation, l’expérience a montré qu’ils n’étaient pas éternels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5cff6d5-eec7-4535-b179-0f18b5caa2e3",
                        "source_entry_id": "4fa043a7-e48a-37ea-9fa5-ca0f679dc30e",
                        "source_sense_id": "06c9137f-5506-3b77-8525-df66ac3c0c63",
                        "target_lang_word": "мерзлота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мерзлота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "50016159-c9d4-3934-88e0-f3fda6bb8ed3",
                                        "entry_id": "42196c11-a170-3975-82e6-4603be492bcb",
                                        "glosses": [
                                            "мёрзлое состояние почвы; промёрзшая почва"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2e4d8b-3be2-4db0-85eb-feb86a75b908",
                                                "sense_id": "50016159-c9d4-3934-88e0-f3fda6bb8ed3",
                                                "text": "Каждое лето мерзлота чуть-чуть отступала, и в каждый вершок оттаявшей земли немедленно вонзался и укреплялся там тончайшими волосками щупалец — корень."
                                            },
                                            {
                                                "example_id": "129c06c6-c76f-4236-8494-9dc2619581aa",
                                                "sense_id": "50016159-c9d4-3934-88e0-f3fda6bb8ed3",
                                                "text": "Ибо в неведомом все мы едины, и не только солнце и луна связаны друг с другом, как день и ночь, но и человек с ними, и с каждой живой тварью, и с каждой рыбой в море, и даже с болотной травою, и даже с бурым льдом мерзлоты."
                                            },
                                            {
                                                "example_id": "1383f435-b435-4438-9219-9b0c7026a6c5",
                                                "sense_id": "50016159-c9d4-3934-88e0-f3fda6bb8ed3",
                                                "text": "Корни деревьев стелются подо мхом поверху, глубже — вечная мерзлота."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
