                                        "entry_id": "14e49cf2-c737-3800-ab54-1de84d721057",
                                        "glosses": [
                                            "Comme une bête le ferait, stupidement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdcd26b0-eea2-4e91-acb7-1d7afc4ea130",
                                                "sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                                                "text": "Il a bêtement agi. Il a répondu bêtement."
                                            },
                                            {
                                                "example_id": "3367deeb-6099-4b5e-9f3f-cadeb79c9498",
                                                "sense_id": "19d7fbb7-eeb8-3e55-b45f-5a38f1e1dcdf",
                                                "text": "Il parle et agit bêtement."
                                            }
                                        ]
