                        "examples": [
                            {
                                "example_id": "e952b9c8-b71f-4540-be22-785c04a28be5",
                                "sense_id": "215c13c9-4657-38c2-a17a-30b0b5f8af82",
                                "text": "„Über die deutsche Gegenwartsliteratur schweigt sich Remarque im übrigen in den sechziger Jahren weitgehend aus.“"
                            },
                            {
                                "example_id": "203002ad-245c-4c93-ac40-5f9b3cbef55c",
                                "sense_id": "215c13c9-4657-38c2-a17a-30b0b5f8af82",
                                "text": "„Er selbst, Schmidt, tue für die Gegenwartsliteratur das, was Wieland für das 18. Jahrhundert getan habe.“"
                            }
                        ],
