                "entry_id": "e8dfe81d-a3ea-3d51-891a-169b5fa74d74",
                "word": "sonar",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0634fb1b-b2a8-42aa-86e5-51cb98f468c3",
                        "entry_id": "e8dfe81d-a3ea-3d51-891a-169b5fa74d74",
                        "tags": [
                            "plural"
                        ],
                        "form": "sonars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecc5b3f1-3ea2-301e-a8d4-c8177138ecd6",
                        "entry_id": "e8dfe81d-a3ea-3d51-891a-169b5fa74d74",
                        "glosses": [
                            "Artificial echolocation by use of electronic equipment, with hydrophones to locate objects underwater, using the same wave-analysis principles that radar uses."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3b956d1d-a009-421a-99d1-f04066edc711",
                                "sense_id": "ecc5b3f1-3ea2-301e-a8d4-c8177138ecd6",
                                "text": "They were able to detect the sunken wreck using sonar."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e4b501d-121a-3d26-9ec5-91cb13fb1752",
                        "entry_id": "e8dfe81d-a3ea-3d51-891a-169b5fa74d74",
                        "glosses": [
                            "A device that provides such echolocation."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "fc2151e8-df06-426f-b004-4f41b71d500b",
                                "sense_id": "7e4b501d-121a-3d26-9ec5-91cb13fb1752",
                                "text": "They finally bought a new sonar to replace the 40-year-old unit that sometimes didn't work right."
                            }
                        ]
                    },
                    {
                        "sense_id": "afe2d201-0a21-3b11-8b01-bc1a5ef0ea89",
                        "entry_id": "e8dfe81d-a3ea-3d51-891a-169b5fa74d74",
                        "glosses": [
                            "Any echolocation."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ab7645-2eff-4379-ae41-89ee0ef4ac3d",
                                "sense_id": "afe2d201-0a21-3b11-8b01-bc1a5ef0ea89",
                                "text": "Submarines and bats both use sonar to navigate."
                            }
                        ]
                    }
                ],
