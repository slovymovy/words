            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6123ecf-8398-3fe4-9d92-a2680679c4f9",
                    "sense_definition": "verschillende draden of elementen door elkaar weven om een geheel te vormen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar probeert verschillende materialen in het tapijt te <w>verweven</w>.",
                            "target_lang_translations": {
