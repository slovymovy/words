                        "target_lang_word": "Diadem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diadem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "837b0989-ed51-3c14-bb07-6cc26d046e75",
                                        "entry_id": "bb8b2dca-d66f-3528-80b3-1a6816a69545",
                                        "glosses": [
                                            "kostbarer Haarreif aus Edelmetall, mit Schmucksteinen oder Perlen besetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "222537e1-a27a-4ffc-975a-441221381d25",
                                                "sense_id": "837b0989-ed51-3c14-bb07-6cc26d046e75",
                                                "text": "Die Prinzessin trägt zur Feier des Tages ein Diadem."
                                            },
                                            {
                                                "example_id": "698a8ddf-a1fe-425c-8da9-5c95134cd403",
                                                "sense_id": "837b0989-ed51-3c14-bb07-6cc26d046e75",
                                                "text": "„Vor ihm auf dem Tisch liegen ein überdimensionaler Gürtel aus reinem Gold, zweieinhalb Kilo schwer, und ein protziges Diadem, ebenfalls aus Gold.“"
                                            },
                                            {
                                                "example_id": "8218f017-2e9b-4740-a468-edd796f33fa5",
                                                "sense_id": "837b0989-ed51-3c14-bb07-6cc26d046e75",
                                                "text": "„Sie nahm ihr mondförmiges Diadem ab und drehte es wie ein Spielzeug in ihren Händen.“"
                                            },
                                            {
                                                "example_id": "7116c046-6afe-442a-8eeb-3d16e188d738",
                                                "sense_id": "837b0989-ed51-3c14-bb07-6cc26d046e75",
                                                "text": "„Im Tempel befand sich mit großer Sicherheit die Bronzestatue der Göttin Sequana, einer erhabenen Frau in gegürtetem Faltengewand, mit einem Diadem auf der Stirn und schulterlangen Haaren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8cb4c93-7cda-4613-8bd7-db3663e74916",
                        "source_entry_id": "0ca3a4be-7ef9-3167-a035-119bc50bf94e",
                        "source_sense_id": "b9823185-6861-3069-a84a-88428cd8c4a8",
                        "source_sense_description": "band (met edelstenen versierd) voor om het hoofd",
                        "target_lang_word": "diadem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diadem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf5dcfa-2b54-320e-a8b2-e25cf8084a52",
                                        "entry_id": "bcacf43d-e78a-3bf1-943d-b10ae5c62d1a",
                                        "glosses": [
                                            "An ornamental headband worn as a badge of royalty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d19ef1d-64ef-4eca-a042-ec6dfdf0e355",
                                                "sense_id": "fcf5dcfa-2b54-320e-a8b2-e25cf8084a52",
                                                "text": "The Apollon wing of the Louvre has a set of historic crowns, diadems and sovereign jewellery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f4bed5-6ee7-392b-82ae-0cddb25db1a9",
                                        "entry_id": "bcacf43d-e78a-3bf1-943d-b10ae5c62d1a",
                                        "glosses": [
                                            "A crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670e7dde-2212-47d8-83ce-dac329c169c3",
                                                "sense_id": "c8f4bed5-6ee7-392b-82ae-0cddb25db1a9",
                                                "text": "And vvhen the princely Perſean Diadem, / Shall ouervveigh his vvearie vvitleſſe head, / And fall like mellovved fruit, vvith ſhakes of death, / In faire Perſea noble Tamburlain / Shall be my Regent, and remaine as King:"
                                            },
                                            {
                                                "example_id": "74fc0f3d-0312-4045-b585-06b37dc17bc9",
                                                "sense_id": "c8f4bed5-6ee7-392b-82ae-0cddb25db1a9",
                                                "text": "I am his firſt borne ſonne, that vvas the laſt / That vvare the Imperiall Diademe of Rome, […]"
                                            },
                                            {
                                                "example_id": "42d738b5-33bb-47ff-a959-754d29dedbce",
                                                "sense_id": "c8f4bed5-6ee7-392b-82ae-0cddb25db1a9",
                                                "text": "The fever’d diadem on my brow / I claim’d and won usurpingly— / Hath not the same fierce heirdom given / Rome to the Caesar—this to me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc77132-e5ca-3a8d-bd3c-47cab4418a38",
                                        "entry_id": "bcacf43d-e78a-3bf1-943d-b10ae5c62d1a",
                                        "glosses": [
                                            "Regal power; sovereignty; empire—considered as symbolized by the crown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f64c08b5-2341-3b78-8ffa-7f7c4c8ce6a3",
                                        "entry_id": "bcacf43d-e78a-3bf1-943d-b10ae5c62d1a",
                                        "glosses": [
                                            "An arch rising from the rim of a crown (rarely also of a coronet), and uniting with others over its centre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "diadem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                        "entry_id": "7966bb41-db59-3f80-b564-4d06f19b777e",
                                        "glosses": [
                                            "To adorn with a diadem; to crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6b7afd-48bf-4148-b1b2-44bc08e64087",
                                                "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                                "text": "The star of her destiny is the morning star of the new-born century. O’er the Golden Gate it glitters, diademming this youthful Queen of the Pacific in her robes of freedom gorgeously inlaid with gold."
                                            },
                                            {
                                                "example_id": "b627eb50-1ab6-4e6b-80d0-c0f66738c4e6",
                                                "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                                "text": "Paul cites as an example the Macedonian churches and mentions specifically several things about their liberality which adorn their grace and crown it with beauty as the lily work diademmed the pillars of the Temple."
                                            },
                                            {
                                                "example_id": "8b28bf3f-b553-4ba2-8fbc-b631b1800456",
                                                "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                                "text": "From many lands and from far distant climes have come great men and women to rest within our heart and to do great deeds and shape the noble events that have diademmed our crown with stars of splendor."
                                            },
                                            {
                                                "example_id": "22761d1b-9a62-4776-81a0-082a9f4b1b8f",
                                                "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                                "text": "butt (maomant scoffin, but apoxyomenously deturbaned but thems bleachin banes will be after making a bashman’s haloday out of the euphorious hagiohygiecynicism of his die and be diademmed)."
                                            },
                                            {
                                                "example_id": "17e250d2-e1b9-473f-81b2-9d2151961365",
                                                "sense_id": "110168ad-c2cd-3f33-922e-01e52c0d90dd",
                                                "text": "Vardan, brave champion [or, “martyr”] who routed the enemy,\n You diademmed the Church in your rosy blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "280c133b-6466-43f3-b617-f925031843b5",
