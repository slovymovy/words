            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6bb6ba51-f261-3345-98f2-dda2f86434c8",
                    "sense_definition": "iets op een bepaalde manier begrijpen of interpreteren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interpretatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft die opmerking helaas <w>opgevat</w> als een ernstige belediging.",
                            "target_lang_translations": {
                                "en": "Unfortunately, he <w>interpreted</w> that remark as a serious insult."
                            }
                        },
                        {
                            "text": "Je moet zijn woorden niet verkeerd <w>opvatten</w> want hij bedoelt het goed.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>take</w> his words the wrong way because he means well."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschouwen",
                        "uitleggen"
                    ],
                    "common_phrases": [
                        "verkeerd opvatten",
                        "als belediging opvatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to understand or interpret something in a particular way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interpret",
                                "target_lang_sense_clarification": "to explain or understand the meaning of something"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to understand or regard in a specified way"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "to regard or consider something as"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "504132df-6145-3ccb-84fd-b626d234fe15",
                    "sense_definition": "opnieuw beginnen met een taak of werkzaamheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hervatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een week vorstverlet werd het werk aan de weg weer <w>opgevat</w>.",
                            "target_lang_translations": {
                                "en": "After a week of frost delay, the work on the road was <w>resumed</w>."
                            }
                        },
                        {
                            "text": "Zij besloten na de korte pauze hun studie weer <w>op te vatten</w>.",
                            "target_lang_translations": {
                                "en": "They decided to <w>take up</w> their studies again after the short break."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het werk opvatten",
                        "de draad opvatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to start a task or activity again after an interruption"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resume",
                                "target_lang_sense_clarification": "to begin again after a pause"
                            },
                            {
                                "target_lang_word": "take up",
                                "target_lang_sense_clarification": "to start doing a particular job or activity again"
                            },
                            {
                                "target_lang_word": "restart",
                                "target_lang_sense_clarification": "to start something again"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "704be801-3ba0-38bd-92fe-0835a0f39f2a",
                    "sense_definition": "iets met de handen oppakken of vastnemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeider moest de zware gereedschappen voorzichtig <w>opvatten</w>.",
                            "target_lang_translations": {
                                "en": "The worker had to <w>pick up</w> the heavy tools carefully."
                            }
                        },
                        {
                            "text": "Zij <w>vatte</w> de steel van de pan stevig <w>op</w> om niet te morsen.",
                            "target_lang_translations": {
