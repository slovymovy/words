                                        "glosses": [
                                            "Someone who blackmails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9209f7-c997-41eb-ad21-3d07f7557b02",
                                                "sense_id": "f97fdcc1-3130-3c00-90bf-a4b04c615bd7",
                                                "text": "This sex blackmailer and dryhanded public virgin was lunching secretly each week with the East Coast spokesman for organized crime, Frank Costello, in N.Y. Central Park's Tavern on the Green (according to the Time magazine obituary)."
                                            },
                                            {
                                                "example_id": "f8a804b8-5ba5-4ba0-a8ba-7f1ee52b4268",
                                                "sense_id": "f97fdcc1-3130-3c00-90bf-a4b04c615bd7",
                                                "text": "Ordinary people have already been face-swapped into videos for humorous or prank purposes and there is no reason to believe that abusers, harassers, stalkers, and blackmailers will not soon be face-swapping victims into compromising video as part of their arsenal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
