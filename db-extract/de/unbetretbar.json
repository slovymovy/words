                ],
                "senses": [
                    {
                        "sense_id": "486ac216-f8f2-35fd-a66d-87c81866574b",
                        "entry_id": "05fc1186-eaf8-33a0-ab59-0bbd0f81a892",
                        "glosses": [
                            "so, dass es nicht betreten werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "9539004d-bec6-4654-be11-4f785731ef32",
                                "sense_id": "486ac216-f8f2-35fd-a66d-87c81866574b",
                                "text": "„Zum Teil waren [die Moore] unbetretbar, immer kleiner wurden die Kiefern und Birken an ihrem Rand, und in ihrer Mitte stand Schilf und hohes Riedgras um unbewegliche Wasserblänken.“"
                            },
                            {
                                "example_id": "f3ad590a-e73c-4e74-9e33-2550dfddee98",
                                "sense_id": "486ac216-f8f2-35fd-a66d-87c81866574b",
                                "text": "„Für Ursel war ihm das alles undenkbar, war dieser Boden unbetretbar. Alp seiner Nächte die Vorstellung, sie könnte Blux wieder begegnen, mit ihm Beziehungen haben, seinetwegen das Leben einer Witwe führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
