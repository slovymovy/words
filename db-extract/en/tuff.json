                    {
                        "translation_id": "7a4289e8-4bf2-4986-9877-15c63e8f296b",
                        "source_entry_id": "d72f7edd-3e9d-3f22-9c84-86ca40cc1af1",
                        "source_sense_id": "ede7edc2-ec08-34a7-ab6e-f793646d7c13",
