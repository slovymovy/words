{
    "word_family": [
        "mix",
        "mixer",
        "admixture",
        "intermixture",
        "remix"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cb9369e-7a1c-3ece-85ba-373d0b2592b8",
                    "sense_definition": "A substance made by mixing other substances together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour the cake <w>mixture</w> into a greased baking tin.",
                            "target_lang_translations": {
                                "ru": "Вылейте <w>смесь</w> для кекса в смазанную маслом форму для выпечки.",
                                "zh": "把蛋糕<w>混合料</w>倒入涂了油的烤盘里。"
                            }
                        },
                        {
                            "text": "Air is a <w>mixture</w> of gases including oxygen and nitrogen.",
                            "target_lang_translations": {
                                "ru": "Воздух — это <w>смесь</w> газов, включая кислород и азот.",
                                "zh": "空气是包括氧气和氮气在内的气体<w>混合物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "mix",
                        "combination"
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
                        "cake mixture",
                        "flour mixture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, полученное путем смешивания других веществ.",
                        "zh": "由多种物质混合而成的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合物",
                                "target_lang_sense_clarification": "化学或物理上的混合物质"
                            },
                            {
                                "target_lang_word": "混合料",
                                "target_lang_sense_clarification": "用于烹饪或工业的配料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5bd28b5-99b5-3901-a282-addb3bd8e1ee",
                    "sense_definition": "A combination of different things, people, or emotions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a strange <w>mixture</w> of relief and sadness.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала странную <w>смесь</w> облегчения и грусти.",
                                "zh": "她感到一种如释重负与悲伤交织的<w>混合</w>情绪。"
                            }
                        },
                        {
                            "text": "The crowd was a <w>mixture</w> of tourists and local residents.",
                            "target_lang_translations": {
                                "ru": "Толпа представляла собой <w>смесь</w> туристов и местных жителей.",
                                "zh": "人群是游客和当地居民的<w>混合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "mix",
                        "medley",
                        "combination",
                        "melange",
                        "cocktail"
                    ],
                    "common_phrases": [
                        "mixture of emotions",
                        "odd mixture",
                        "strange mixture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сочетание различных вещей, людей или эмоций.",
                        "zh": "不同事物、人群或情感的结合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "комбинация"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "комбинация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合",
                                "target_lang_sense_clarification": "多种成分的组合"
                            },
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "不同事物的融合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "846b6d96-462f-3d4f-bc74-221e48b98fc5",
                    "sense_definition": "The action or process of combining things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mixture</w> of these chemicals produces a strong reaction.",
                            "target_lang_translations": {
                                "ru": "<w>Смешивание</w> этих химикатов вызывает сильную реакцию.",
                                "zh": "这些化学物质的<w>混合</w>会产生强烈的反应。"
                            }
                        },
                        {
                            "text": "Careful <w>mixture</w> of the ingredients is essential for the recipe.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>смешивание</w> ингредиентов необходимо для этого рецепта.",
                                "zh": "按照食谱要求仔细<w>混合</w>配料至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "combination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс соединения вещей.",
                        "zh": "将事物结合在一起的动作或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивание",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合",
                                "target_lang_sense_clarification": "动作或过程"
                            },
                            {
                                "target_lang_word": "掺和",
                                "target_lang_sense_clarification": "将不同成分混在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a16f7940-f501-3401-b963-f45b92b886f4",
                    "sense_definition": "A liquid medicine made from several ingredients.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a soothing <w>mixture</w> for my cough.",
                            "target_lang_translations": {
                                "ru": "Врач прописал успокаивающую <w>микстуру</w> от кашля.",
                                "zh": "医生给我开了一种止咳的<w>合剂</w>。"
                            }
                        },
                        {
                            "text": "Shake the bottle to blend the <w>mixture</w> before use.",
                            "target_lang_translations": {
                                "ru": "Встряхните бутылку, чтобы перемешать <w>микстуру</w> перед использованием.",
                                "zh": "使用前摇匀瓶子，使<w>合剂</w>混合均匀。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compound"
                    ],
                    "common_phrases": [
                        "cough mixture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое лекарство, изготовленное из нескольких ингредиентов.",
                        "zh": "由多种成分制成的液态药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "микстура",
                                "target_lang_sense_clarification": "лекарство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合剂",
                                "target_lang_sense_clarification": "药学上的液态药物"
                            },
                            {
                                "target_lang_word": "药水",
                                "target_lang_sense_clarification": "口语化的液态药物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
