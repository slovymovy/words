                "senses": [
                    {
                        "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                        "entry_id": "74ffde28-5e27-3a5a-99a3-a47e845e1847",
                        "glosses": [
                            "Künstler, der musikalische Werke schafft"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7211413a-ff09-48df-bd79-4c4e2d1e23b4",
                                "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                                "text": "„Inmitten der zauberhaften Kulisse der Klosteranlage Polling, Leverkühns Pfeiffering, konzentriert sich der Pianist und Komponist Gerold Huber anlässlich der Tage für alte und neue Musik auf das Faustische, Dunkle im Tonsetzer Leverkühn.“"
                            },
                            {
                                "example_id": "f851f941-ab34-4862-86a5-d690eb1aa279",
                                "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                                "text": "„Kaum ein Tonsetzer war sein ganzes leben lang mit dem Höchsten so vertraut, ein Katholik, wie er im Buche steht, und doch hat wohl keiner unter den gläubigen Komponisten die Vollkommenheit der Schöpfung so radikal in Frage gestellt.“"
                            },
                            {
                                "example_id": "ed457720-94a0-481e-87df-67e979c6e229",
                                "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                                "text": "„Verglichen mit den Zyklen von Schubert und Schumann mutet das, was die romantischen Tonsetzer aus dem Zarenreich unter dem Gattungsbegriff ‚Ballade‘ komponiert haben, reichlich naiv an.“"
                            },
                            {
                                "example_id": "d96281b9-e2b4-4195-be99-f2f6a77d602e",
                                "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                                "text": "„Doch der Tonsetzer Cage, der so gern und gut Tonsetzer spielte, wollte als 'ernsthafter Mensch' verstanden werden, und er war klug und die Güte selbst.“"
                            },
                            {
                                "example_id": "342df25d-3f70-4dee-8541-0e50a44549b6",
                                "sense_id": "dc52edd8-95b1-3718-922a-d957601454af",
                                "text": "„Von Cecil Frederick Gottlieb Coles, 29 Jahre alt, einem der hoffnungsvollsten jungen Tonsetzer Britanniens, ausgebildet in London und in Deutschland, der Assistent gewesen war von Richard Strauss in Stuttgart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
