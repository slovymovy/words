{
    "word_family": [
        "geschuifel",
        "schuifelaar",
        "schuif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c3d276b-5b33-34ae-b719-c3a7a3564ba1",
                    "sense_definition": "zich langzaam voortbewegen door de voeten over de vloer te slepen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voortbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man begon langzaam naar de uitgang te <w>schuifelen</w>.",
                            "target_lang_translations": {
                                "en": "The old man slowly began to <w>shuffle</w> toward the exit."
                            }
                        },
                        {
                            "text": "Hij was in het pikkedonker voorzichtig naar de andere kant van de grot <w>geschuifeld</w>.",
                            "target_lang_translations": {
                                "en": "In the pitch dark, he had cautiously <w>shuffled</w> to the other side of the cave."
                            }
                        }
                    ],
                    "synonyms": [
                        "sloffen",
                        "schuiven"
                    ],
                    "antonyms": [
                        "rennen",
                        "snelwandelen"
                    ],
                    "common_phrases": [
                        "voetje voor voetje schuifelen",
                        "naar voren schuifelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move forward slowly by dragging one's feet across the floor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to shuffle",
                                "target_lang_sense_clarification": "moving slowly without lifting feet"
                            },
                            {
                                "target_lang_word": "to scuff",
                                "target_lang_sense_clarification": "dragging feet while walking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ee8fec4-3382-3aa4-934b-ead854c3def8",
                    "sense_definition": "onrustig de voeten heen en weer bewegen zonder echt van plek te veranderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerlingen zaten ongeduldig op hun stoelen te <w>schuifelen</w> tijdens de lange uitleg.",
                            "target_lang_translations": {
                                "en": "The students were <w>fidgeting</w> impatiently in their chairs during the long explanation."
                            }
                        },
                        {
                            "text": "Er werd wat <w>geschuifeld</w> op de banken, maar verder bleven de kinderen waar zij waren.",
                            "target_lang_translations": {
                                "en": "There was some <w>shuffling</w> on the benches, but otherwise the children stayed where they were."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiebelen",
                        "draaien"
                    ],
                    "common_phrases": [
                        "onrustig schuifelen",
                        "op je stoel schuifelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move one's feet restlessly back and forth without actually changing location."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fidget",
                                "target_lang_sense_clarification": "moving restlessly while seated"
                            },
                            {
                                "target_lang_word": "to shuffle",
                                "target_lang_sense_clarification": "shifting feet or position while staying in place"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}