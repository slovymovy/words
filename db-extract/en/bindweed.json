                        "entry_id": "201fe814-0225-35ab-9d86-30f3b687ea3a",
                        "glosses": [
                            "Any of several trailing vine-like plants in the family Convolvulaceae with funnel-shaped flowers:",
                            "true bindweed (Convolvulus)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3450c8ee-ab7e-42d3-ad4f-2d6876516b73",
                                "sense_id": "bace314e-3f8a-371b-beb2-fc5281ce87c9",
                                "text": "the slender bindweed wound about with its pale and delicate flowers—so delicate, yet so deadly; and one or two late flowers yet put forth their wan blossoms, pining as if gentle exiles of the spring, and yet very, very lovely."
                            }
                        ]
