                ],
                "senses": [
                    {
                        "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                        "entry_id": "df7a31fc-b267-391e-8929-fd9446bdc12f",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5d695e-6d2a-4400-987e-c5d2b0d2a805",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Frau Willisch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a346d856-e1c9-455b-8108-8ec43cba701a",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Herr Willisch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "720c6532-a7f1-4115-9f08-80d622247245",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Die Willischs kommen heute aus dem Mostviertel."
                            },
                            {
                                "example_id": "3eb79bdc-650c-4167-a29d-7b4efbf92104",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Der Willisch trägt nie die Schals, die die Willisch ihm strickt."
                            },
                            {
                                "example_id": "f485fac2-7649-4032-ae48-fca5395a9d8f",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Willisch kommt, geht der Herr Willisch.“"
                            },
                            {
                                "example_id": "4fc70119-2994-4808-bbe5-a76160bdbc60",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Willisch kommt und geht."
                            },
                            {
                                "example_id": "d7829494-8ab3-4cc1-8d19-c1a9df0ddd58",
                                "sense_id": "d6ab1b38-8c92-3e93-8acd-90fd31cb2b6e",
                                "text": "Willischs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
