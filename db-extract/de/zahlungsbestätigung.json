                                "sense_id": "0d5e0833-dffb-3557-a924-f9bfcf81cf91",
                                "text": "„Die Zahlungsbestätigung wird auch per E-Mail zugesandt.“"
                            },
                            {
                                "example_id": "1eb964fd-7595-40eb-a89c-7c07f19d0c20",
                                "sense_id": "0d5e0833-dffb-3557-a924-f9bfcf81cf91",
                                "text": "„An der Kasse müssen sie dann das Smartphone entsperren, je nach Anbieter auch die App öffnen und an das Kartenlesegerät halten, bis eine Zahlungsbestätigung erscheint.“"
                            }
