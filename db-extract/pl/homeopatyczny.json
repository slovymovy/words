                            {
                                "example_id": "a47a6ad8-5dd5-4cc4-9c0a-91ca31a61ecb",
                                "sense_id": "802cc0e9-f1be-32ca-b918-b9462380495d",
                                "text": "Wielu wątpi, czy sprzedaż środków homeopatycznych dla pacjentów onkologicznych jest etyczna."
                            }
