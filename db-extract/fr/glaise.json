                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ab422516-b47f-4650-a7e2-041809542838",
                        "entry_id": "2fe47499-88c0-365b-9763-ace2951c1cd1",
                        "tags": [
