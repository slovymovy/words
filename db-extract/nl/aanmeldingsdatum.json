                        "examples": [
                            {
                                "example_id": "61559381-49e6-47ef-81bf-baf33fc85c08",
                                "sense_id": "8dd922f0-28e1-3eb2-86b5-9d1565cf8986",
                                "text": "Universiteiten en hogescholen hebben de uiterste aanmeldingsdatum vervroegd, zodat studenten tijd hebben voor een studiekeuze-controle die hen helpt bepalen of de opleiding bij ze past. Instellingen hopen dat er dan minder studenten van studie wisselen of uitvallen."
                            },
                            {
                                "example_id": "48d3def2-1689-41a8-8eb4-104a9893a6f0",
                                "sense_id": "8dd922f0-28e1-3eb2-86b5-9d1565cf8986",
                                "text": "„We wachten de aanmeldingen die vandaag nog binnenkomen af”, zegt Van de Kamp die naar minstens drie genomineerden per categorie streeft, „en als er van een bepaalde categorie te weinig zijn, dan benaderen we nogmaals de sportverenigingen in de omgeving om personen aan te dragen en verlengen we de aanmeldingsdatum."
                            }
                        ]
