                "senses": [
                    {
                        "sense_id": "b80cf71e-eb5b-398c-b648-8f10d6b9d1a8",
                        "entry_id": "19e641d7-f081-3428-9b81-2439a268a1e4",
                        "glosses": [
                            "To prepare for Arctic weather; to winterize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1ff29349-7e4c-4106-81f5-0bbc991620b5",
                                "sense_id": "b80cf71e-eb5b-398c-b648-8f10d6b9d1a8",
                                "text": "Whether the field is in the Far North or close to the Equator, the canvas covering offers full protection, for the material is not only processed against the ravages of fire, mildew and rotting but given an arcticizing treatment which keeps it flexible at 40° below zero."
                            },
                            {
                                "example_id": "8e301a72-4429-47cd-99f4-03b5cb2b57c8",
                                "sense_id": "b80cf71e-eb5b-398c-b648-8f10d6b9d1a8",
                                "text": "So far as \"arcticizing\" man is concerned, clothing is the hardest problem of all."
                            },
                            {
                                "example_id": "cb0702e4-b8d5-45bf-9657-ebcdc5338295",
                                "sense_id": "b80cf71e-eb5b-398c-b648-8f10d6b9d1a8",
                                "text": "We have the prefabricated wooden sides and top that we need to arcticize it, plus the bunks and portable stove, but it will take several hours."
                            },
                            {
                                "example_id": "8a1f2b98-c869-42ca-9576-016a4a3d0517",
                                "sense_id": "b80cf71e-eb5b-398c-b648-8f10d6b9d1a8",
                                "text": "Fortunately, the RCN carrier Magnificent had been “arcticized,” although this meant only that it had had its working and living quarters prepared for low-temperature operations."
                            }
                        ]
                    }
