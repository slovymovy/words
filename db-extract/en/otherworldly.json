                "senses": [
                    {
                        "sense_id": "fe09eb1e-8070-38c6-8fd1-9e5f96130d7f",
                        "entry_id": "b199da6f-5d08-3739-9e9b-113ccb055af8",
                        "glosses": [
                            "来世的，阴间的，冥界的，超脫塵俗的，另一世界的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b785ea7-9024-4ec4-9c61-ead3e2161eac",
                                "sense_id": "fe09eb1e-8070-38c6-8fd1-9e5f96130d7f",
                                "text": "Every religion that becomes ascendant, in so far as it is not otherworldly, must necessarily set its stamp upon the methods and administration of the law.",
                                "translation": "每一種宗教，只要不是超凡脫俗的，就必然會在法律的方法和管理上打上自己的烙印。"
                            },
                            {
                                "example_id": "3ee0e1a8-a113-46f5-b685-2cefae75bb62",
                                "sense_id": "fe09eb1e-8070-38c6-8fd1-9e5f96130d7f",
                                "text": "Dana has the otherworldly temperament of a mystic."
                            }
                        ]
                    },
                    {
                        "sense_id": "4734f8c5-d11b-32e0-9d96-15a852cf0a05",
                        "entry_id": "b199da6f-5d08-3739-9e9b-113ccb055af8",
                        "glosses": [
                            "怪异的，不自然的；超凡的；不属于这个世界的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d36e1c0-34ba-4cfc-bf38-227ea79688f6",
                                "sense_id": "4734f8c5-d11b-32e0-9d96-15a852cf0a05",
                                "text": "An almost otherworldly resilience has characterized the 40-year arc of the Clintons’ political lives, a well-documented pattern of dazzling success, shattering setback and inevitable recovery."
                            },
                            {
                                "example_id": "028be72c-1b39-4fe8-b6f5-bdeca350b9bc",
                                "sense_id": "4734f8c5-d11b-32e0-9d96-15a852cf0a05",
                                "text": "The sudden inundation from the remnants of Ida transformed familiar scenes of life in New York into otherworldly and waterlogged chaos on Wednesday night."
                            }
                        ]
                    }
                ],
