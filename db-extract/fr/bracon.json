                "senses": [
                    {
                        "sense_id": "c2ad3981-cab2-3d27-b7ce-42cbbe281465",
                        "entry_id": "ea9ed8b7-17f1-3d3b-bf81-08d6bd1f7b0d",
                        "glosses": [
                            "Étai installé obliquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a456f20d-682c-49e0-aa21-76670458cd80",
                                "sense_id": "c2ad3981-cab2-3d27-b7ce-42cbbe281465",
                                "text": "Le bracon est un élément qui vise dans certains cas à verrouiller la liaison poteau/traverse et à augmenter la résistance de la charpente."
                            }
                        ]
                    },
                    {
                        "sense_id": "98a06c2f-d6ae-34e4-b661-c87684f48027",
                        "entry_id": "ea9ed8b7-17f1-3d3b-bf81-08d6bd1f7b0d",
                        "glosses": [
                            "Renfort du poteau busqué d’une porte d’écluse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0c767762-fe6a-45d5-809f-e16b2844aee1",
                                "sense_id": "98a06c2f-d6ae-34e4-b661-c87684f48027",
                                "text": "Ce système de deux écharpes, […], que l’on peut raccourcir au moyen de moufles, […], pourrait permettre de raccourcir le bracon."
                            }
                        ]
                    },
                    {
                        "sense_id": "20f105e9-e921-3919-8d8f-de09a9cf557b",
                        "entry_id": "ea9ed8b7-17f1-3d3b-bf81-08d6bd1f7b0d",
                        "glosses": [
                            "Profilé servant à rigidifier une liaison d’angle."
                        ],
                        "tags": [
                            "Construction métallique"
                        ],
                        "examples": [
                            {
                                "example_id": "1f577bdc-40a5-4380-9ee4-606032d47416",
                                "sense_id": "20f105e9-e921-3919-8d8f-de09a9cf557b",
                                "text": "Une lisse de bardage associée à un bracon d’anti-déversement est disposée à mi hauteur des poteaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee01ba38-efd5-3334-9004-d86331c3d076",
                        "entry_id": "ea9ed8b7-17f1-3d3b-bf81-08d6bd1f7b0d",
                        "glosses": [
                            "Dans le cas d’une antenne satellite parabolique, bras dans l’axe, supportant la tête (convertisseur) du foyer, ou point focal."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "da10b4c1-1b58-3971-a66e-c900f825dd32",
                        "entry_id": "ea9ed8b7-17f1-3d3b-bf81-08d6bd1f7b0d",
                        "glosses": [
                            ", Pièce de bois oblique reliant le poteau à la panne pour en diminuer la portée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45a8c74-ebbe-441d-8427-e4ab58f23d92",
                                "sense_id": "da10b4c1-1b58-3971-a66e-c900f825dd32",
                                "text": "Un bracon c’est une jambe de force qui en général part d’une base (par exemple pied d’un poteau ou une poutre horizontale) et qui va supporter en biais une structure."
                            }
                        ]
                    }
