                ],
                "senses": [
                    {
                        "sense_id": "ced277d6-8a12-35e7-a7e5-75b06bec07d0",
                        "entry_id": "d807585a-9ebc-3c8e-9c2d-f71ece0ed26b",
                        "glosses": [
                            "jemand, der sich für etwas (Person, Vorhaben, ...) einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1532a01-96ec-4ea6-b7a8-252f56635414",
                                "sense_id": "ced277d6-8a12-35e7-a7e5-75b06bec07d0",
                                "text": "„Außerhalb Berlins waren die Auseinandersetzungen um Liebknecht kaum registriert worden, jedenfalls nicht jenseits der Kreise seiner politischen Freunde und Unterstützer wie Erich Mühsam.“"
                            },
                            {
                                "example_id": "fc51175e-50cb-4c7e-822c-4572f9a14c36",
                                "sense_id": "ced277d6-8a12-35e7-a7e5-75b06bec07d0",
                                "text": "„So war der zähe Kampf, den Beneš und Jaksch zwischen 1940 und 1942 miteinander führten und den Jaksch überhaupt nur wagen konnte, weil er Helfer und Unterstützer im britischen Außenministerium hatte, höchst ungleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
