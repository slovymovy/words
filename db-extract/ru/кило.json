                        "examples": [
                            {
                                "example_id": "96f61ef5-07db-42a0-8158-56c5f8b7ffb7",
                                "sense_id": "5d3d0956-b547-3a5a-b77f-4675d2b6d85d",
                                "text": "— Почём мандарины? — осведомился тогда у неё Коровьев. — Тридцать копеек кило, — ответила продавщица."
                            },
                            {
                                "example_id": "02beec36-3bdd-4195-8059-582999d20a84",
                                "sense_id": "5d3d0956-b547-3a5a-b77f-4675d2b6d85d",
                                "text": "Крахмал и изделия из него, как-то: макароны, декстрин и т. п., — норма не свыше 5 кило, пошлина в 20 % стоимости."
                            }
                        ]
                    }
