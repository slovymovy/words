                    "frequency": "Low",
                    "semantic_group_id": "audio_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Edison demonstrated his newly invented <w>phonograph</w> to the amazed audience."
                        },
                        {
                            "text": "The museum maintains an operational cylinder <w>phonograph</w> in its historical collection."
                        }
                    ],
                    "synonyms": [
                        "talking phonograph"
