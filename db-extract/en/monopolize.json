                    },
                    {
                        "sense_id": "0545021f-18ad-3a4f-bcac-061634e970ed",
                        "entry_id": "bb252d9e-6887-3e6c-aebe-bf7fd8309338",
                        "glosses": [
                            "To dominate or to get total control of something by excluding everyone else."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1268d162-ba8c-4109-8802-04851d6868cf",
                                "sense_id": "0545021f-18ad-3a4f-bcac-061634e970ed",
                                "text": "Teachers try not to let any one student monopolize a class discussion."
                            },
                            {
                                "example_id": "0fdcd4dd-1cdc-465f-bbf6-860bed0eee62",
                                "sense_id": "0545021f-18ad-3a4f-bcac-061634e970ed",
                                "text": "\"Now, Mr. Malone, I have given you rather more of my time than I had intended. The individual must not monopolize what is meant for the world.\""
                            }
                        ]
                    }
                ],
