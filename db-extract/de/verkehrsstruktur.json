                ],
                "senses": [
                    {
                        "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                        "entry_id": "045ca3e1-24f8-3cd0-ad61-39991e6d8edb",
                        "glosses": [
                            "Aufbau, Gliederung des Verkehrssystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b29202b-0a56-47d5-a147-2c494204432e",
                                "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                                "text": "„So wurde der Breitscheidplatz jüngst durch einen Gestaltungswettbewerb aufwändig behübscht, ohne jedoch seine verkorkste Verkehrsstruktur zu korrigieren.“"
                            },
                            {
                                "example_id": "a0077179-e361-4872-834b-60308db88a18",
                                "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                                "text": "„Die Pariser Wirtschaftsorganisation OECD veröffentlichte 1999 eine nüchterne Bestandsaufnahme der Siedlungs- und Verkehrsstruktur in der Bundesrepublik.“"
                            },
                            {
                                "example_id": "44d34b61-fb68-4be8-a91a-09878976077d",
                                "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                                "text": "„Die Möglichkeit, sich in vorgegebene Verkehrsstrukturen ‚einzuspielen’, Erfahrung, Wissen, Können im Zusammenhang mit Verkehr zu sammeln, entspricht der Forderung nach Regelanpassung.“"
                            },
                            {
                                "example_id": "6be04bf1-a911-4e23-a8f3-d84eefa930ce",
                                "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                                "text": "„Der VCD spricht sich vielmehr für Verkehrsstrukturen aus, die Unfälle gar nicht erst entstehen lassen, die menschliche Fehler tolerieren und die Verletzbarkeit des menschlichen Körpers als Maßstab haben.“"
                            },
                            {
                                "example_id": "e3a11b77-fe79-4d31-b229-bed24090e9f1",
                                "sense_id": "beca11aa-f1f9-360e-a1ad-4ef0ab72386f",
                                "text": "„Wer an die Verbesserung der Verkehrsstruktur herangeht, muss dabei mindestens in Jahrzehnten denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
