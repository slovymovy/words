                ],
                "senses": [
                    {
                        "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                        "entry_id": "067989fb-3255-34e4-9fa2-9a315d545512",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9602d22a-a766-416e-8ee8-616bdaa70358",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Frau Wölle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bb915d16-3d9d-4259-b5eb-072799ebbd94",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Herr Wölle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "92fe446f-e454-4fbd-8969-9e272b6558ec",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Die Wölles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4f47b903-74e8-44ee-b8f8-7b4c7dcb1cfa",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Der Wölle trägt nie die Schals, die die Wölle ihm strickt."
                            },
                            {
                                "example_id": "ea6299d1-6c52-4559-9ae5-28cf7ed80fd9",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wölle kommt, geht der Herr Wölle.“"
                            },
                            {
                                "example_id": "74a491ed-9693-41f6-9dde-bae100001e74",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Wölle kommt und geht."
                            },
                            {
                                "example_id": "5fd3eec9-0e4a-495f-ac28-a2b7477a52d1",
                                "sense_id": "2dfecde5-8011-308c-a56a-449779c6e04f",
                                "text": "Wölles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
