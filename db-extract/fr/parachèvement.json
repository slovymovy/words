                            {
                                "example_id": "28014058-10f0-41d7-bbb0-b9c6dd7d10ce",
                                "sense_id": "579ebe8e-2056-3617-a14a-70ced7c62700",
                                "text": "Pour le parachèvement des métaux en feuille l'IMTS permettra de trouver toute une gamme de machine, de la grignoteuse, à la cisaille, en passant par la rectifieuse de bande et bien sûr par la poinçonneuse."
                            },
                            {
                                "example_id": "86ac9314-98b3-420e-ac64-24b88ba016a5",
                                "sense_id": "579ebe8e-2056-3617-a14a-70ced7c62700",
                                "text": "La fin de vie n’est pas simplement une vie qui s’achève, c’est le parachèvement d’une vie, disait le philosophe boulonnais Damien Le Gay."
                            }
                        ]
                    }
