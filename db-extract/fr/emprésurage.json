                        "glosses": [
                            "Opération d’ajout au lait d’un coagulant, la présure, pour obtenir du caillé."
                        ],
                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c828c4a9-9b04-4e97-8a59-9d572998d6c7",
                                "sense_id": "e795dbf4-11a0-351f-b58c-507db148794f",
                                "text": "La cheddarisation s'effectue par cuisson de la caséine et de la matière grasse du lait 4 h. 45 à 5 heures durant, à une température d’emprésurage de 31°C (1/2 h.) puis à 39°C."
                            },
                            {
                                "example_id": "2250315b-0f26-4a20-8695-1da3d3857fb7",
                                "sense_id": "e795dbf4-11a0-351f-b58c-507db148794f",
                                "text": "Originaire de Touraine, il est fabriqué à partir d'un lait faiblement emprésuré. L'affinage dure au moins 10 jours après l'emprésurage."
                            }
                        ]
                    }
