{
    "word_family": [
        "pouchy",
        "pouched",
        "pouching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e1a5800f-07a3-3e31-b495-38fa75c9d58d",
                    "sense_definition": "A small bag usually closed with a drawstring.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept her gold coins in a small leather <w>pouch</w> tied to her belt.",
                            "target_lang_translations": {
                                "ru": "Она хранила свои золотые монеты в маленьком кожаном <w>мешочке</w>, привязанном к поясу.",
                                "zh": "她把金币装在一个系在腰带上的皮制<w>小袋</w>里。"
                            }
                        },
                        {
                            "text": "The traveler carried a small <w>pouch</w> for his tobacco and matches.",
                            "target_lang_translations": {
                                "ru": "Путешественник носил с собой небольшой <w>кисет</w> для табака и спичек.",
                                "zh": "旅行者随身带着一个装烟草和火柴的<w>荷包</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather pouch",
                        "tobacco pouch",
                        "drawstring pouch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой мешочек, обычно закрывающийся на завязки.",
                        "zh": "一种通常用抽绳封口的小袋子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешо́чек",
                                "target_lang_sense_clarification": "небольшой мягкий контейнер"
                            },
                            {
                                "target_lang_word": "кисе́т",
                                "target_lang_sense_clarification": "мешочек для табака или мелочей, затягиваемый шнурком"
                            },
                            {
                                "target_lang_word": "су́мка",
                                "target_lang_sense_clarification": "небольшое вместилище из кожи или ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小袋",
                                "target_lang_sense_clarification": "小型软质容器"
                            },
                            {
                                "target_lang_word": "荷包",
                                "target_lang_sense_clarification": "传统式样的小布袋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5a0dad-0cfb-3c38-91c7-784a71a95cae",
                    "sense_definition": "An organic pocket in which a marsupial carries its young.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A baby kangaroo stays inside its mother's <w>pouch</w> for several months.",
                            "target_lang_translations": {
                                "ru": "Детеныш кенгуру остается в материнской <w>сумке</w> в течение нескольких месяцев.",
                                "zh": "袋鼠宝宝要在母亲的<w>育儿袋</w>里待上好几个月。"
                            }
                        },
                        {
                            "text": "The joey peeked out from the <w>pouch</w> to look at the grass.",
                            "target_lang_translations": {
                                "ru": "Кенгуренок выглянул из <w>сумки</w>, чтобы посмотреть на траву.",
                                "zh": "小袋鼠从<w>育儿袋</w>里探出头来观察草地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marsupium"
                    ],
                    "common_phrases": [
                        "kangaroo pouch",
                        "marsupial pouch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кожная складка у сумчатых животных, в которой они вынашивают детенышей.",
                        "zh": "有袋类动物身上用于哺育幼崽的皮肤囊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "су́мка",
                                "target_lang_sense_clarification": "биологический орган сумчатых"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "育儿袋",
                                "target_lang_sense_clarification": "有袋类动物的生物器官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d592576-0056-3ec2-8bc5-54fdb0826698",
                    "sense_definition": "Any pocket or bag-shaped object, such as a cheek pouch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hamster stuffed several seeds into its cheek <w>pouch</w> to eat later.",
                            "target_lang_translations": {
                                "ru": "Хомяк запихнул несколько семян в защечный <w>мешок</w>, чтобы съесть их позже.",
                                "zh": "仓鼠把几粒种子塞进<w>颊囊</w>里，留着以后吃。"
                            }
                        },
                        {
                            "text": "Pelicans have a large <w>pouch</w> under their beak for catching fish.",
                            "target_lang_translations": {
                                "ru": "У пеликанов под клювом есть большой <w>мешок</w> для ловли рыбы.",
                                "zh": "鹈鹕喙下有一个巨大的<w>囊</w>，用来捕鱼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheek pouch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой объект в форме кармана или мешка, например, защечный мешок.",
                        "zh": "任何袋状或囊状的物体，例如颊囊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешо́к",
                                "target_lang_sense_clarification": "анатомическое или биологическое вместилище"
                            },
                            {
                                "target_lang_word": "зоб",
                                "target_lang_sense_clarification": "расширение пищевода у птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "囊",
                                "target_lang_sense_clarification": "解剖学或生物学上的袋状结构"
                            },
                            {
                                "target_lang_word": "颊囊",
                                "target_lang_sense_clarification": "动物口腔两侧的储食袋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e7d6c0c-0f8b-3bb4-9782-cdb341a8f555",
                    "sense_definition": "A cyst or sac containing fluid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor identified a small <w>pouch</w> of fluid near the joint.",
                            "target_lang_translations": {
                                "ru": "Врач обнаружил небольшую <w>полость</w> с жидкостью рядом с суставом.",
                                "zh": "医生在关节附近发现了一个积液的<w>囊腔</w>。"
                            }
                        },
                        {
                            "text": "The infection caused a large <w>pouch</w> or cyst to form in the tissue.",
                            "target_lang_translations": {
                                "ru": "Инфекция вызвала образование в тканях большой <w>сумки</w> или кисты.",
                                "zh": "感染导致组织内形成了一个巨大的<w>囊肿</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Киста или полость, содержащая жидкость.",
                        "zh": "体内含有液体的囊肿或腔体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "су́мка",
                                "target_lang_sense_clarification": "медицинский термин, соединительная ткань"
                            },
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "патологическое образование с жидкостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "囊肿",
                                "target_lang_sense_clarification": "病理性的液体囊状物"
                            },
                            {
                                "target_lang_word": "囊腔",
                                "target_lang_sense_clarification": "组织内的空腔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72fe11cb-7384-3db9-8316-ed75c3ac6921",
                    "sense_definition": "A protuberant belly; a paunch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had developed a slight <w>pouch</w> over the years from lack of exercise.",
                            "target_lang_translations": {
                                "ru": "За эти годы из-за отсутствия физических упражнений у него появилось небольшое <w>брюшко</w>.",
                                "zh": "多年缺乏锻炼，他长出了一个微凸的<w>小肚子</w>。"
                            }
                        },
                        {
                            "text": "The old man patted his <w>pouch</w> contentedly after the heavy meal.",
                            "target_lang_translations": {
                                "ru": "Старик довольно похлопал себя по <w>животу</w> после плотного обеда.",
                                "zh": "饱餐一顿后，老人心满意足地拍了拍自己的<w>肚腩</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "referring to a belly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий живот; брюшко.",
                        "zh": "突出的腹部；小肚子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брю́шко",
                                "target_lang_sense_clarification": "небольшой выпирающий живот"
                            },
                            {
                                "target_lang_word": "живо́тик",
                                "target_lang_sense_clarification": "разговорное обозначение живота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小肚子",
                                "target_lang_sense_clarification": "微凸的腹部"
                            },
                            {
                                "target_lang_word": "肚腩",
                                "target_lang_sense_clarification": "腹部赘肉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c801010-8a46-321a-a523-1e5de8a79679",
                    "sense_definition": "A bulkhead in the hold of a vessel, to prevent grain etc. from shifting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew installed a <w>pouch</w> in the hold to secure the loose grain.",
                            "target_lang_translations": {
                                "ru": "Экипаж установил <w>перегородку</w> в трюме, чтобы закрепить насыпное зерно.",
                                "zh": "船员在货舱内安装了<w>隔板</w>以固定散装谷物。"
                            }
                        },
                        {
                            "text": "Without a proper <w>pouch</w>, the cargo might shift and destabilize the ship.",
                            "target_lang_translations": {
                                "ru": "Без надлежащей <w>перегородки</w> груз может сместиться и нарушить остойчивость судна.",
                                "zh": "如果没有合适的<w>隔板</w>，货物可能会移位并导致船只失去平衡。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перегородка в трюме судна для предотвращения смещения груза.",
                        "zh": "船舱内用于防止散装货物移动的隔板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегоро́дка",
                                "target_lang_sense_clarification": "морской термин для фиксации груза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔板",
                                "target_lang_sense_clarification": "航海中用于固定货物的结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63caf839-a1a1-32fd-b9fc-9ba3a9f02a94",
                    "sense_definition": "To enclose within a pouch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beggar <w>pouched</w> the coin quickly before anyone else could see it.",
                            "target_lang_translations": {
                                "ru": "Нищий быстро <w>спрятал</w> монету, пока ее никто не увидел.",
                                "zh": "乞丐迅速将硬币<w>揣入</w>袋中，以免被别人看见。"
                            }
                        },
                        {
                            "text": "He carefully <w>pouched</w> the delicate jewelry in a velvet bag.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>положил</w> изящное украшение в бархатный мешочек.",
                                "zh": "他小心翼翼地将精致的珠宝<w>装入</w>天鹅绒袋中。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить что-либо в мешочек или сумку.",
                        "zh": "将某物装入袋中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "класть в мешо́к",
                                "target_lang_sense_clarification": "помещать внутрь сумки"
                            },
                            {
                                "target_lang_word": "припря́тать",
                                "target_lang_sense_clarification": "быстро убрать в карман или сумку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装入袋中",
                                "target_lang_sense_clarification": "放入小袋内"
                            },
                            {
                                "target_lang_word": "揣入",
                                "target_lang_sense_clarification": "迅速放入袋或口袋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d158b847-40b0-3d08-8f73-93c8f80a0118",
                    "sense_definition": "To transport within a pouch, especially a diplomatic pouch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>pouched</w> the encryption device to our embassy in Beijing for security.",
                            "target_lang_translations": {
                                "ru": "В целях безопасности мы <w>отправили</w> устройство шифрования в наше посольство в Пекине дипломатической почтой.",
                                "zh": "出于安全考虑，我们通过<w>外交邮袋寄送</w>将加密设备发往北京大使馆。"
                            }
                        },
                        {
                            "text": "The sensitive documents were <w>pouched</w> to the capital yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Секретные документы были <w>отправлены</w> в столицу вчера утром диппочтой.",
                                "zh": "机密文件已于昨天上午通过<w>外交邮袋寄送</w>发往首都。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diplomatic pouch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить в специальной сумке, особенно дипломатической почтой.",
                        "zh": "通过外交邮袋等特殊渠道运送。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отправля́ть дипломати́ческой по́чтой",
                                "target_lang_sense_clarification": "пересылка официальных документов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外交邮袋寄送",
                                "target_lang_sense_clarification": "官方文件的安全转运"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db3174c9-7a40-3ea8-b318-478a5245f1dd",
                    "sense_definition": "To swallow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heron has a wide throat to <w>pouch</w> its prey whole.",
                            "target_lang_translations": {
                                "ru": "У цапли широкое горло, чтобы <w>заглатывать</w> добычу целиком.",
                                "zh": "苍鹭喉咙宽大，能将猎物整只<w>吞食</w>。"
                            }
                        },
                        {
                            "text": "You may conclude the fish has <w>pouched</w> the bait when the line moves.",
                            "target_lang_translations": {
                                "ru": "Когда леска дернется, можно сделать вывод, что рыба <w>заглотила</w> наживку.",
                                "zh": "当鱼线移动时，你可以断定鱼已经<w>吞食</w>了鱼饵。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проглатывать целиком.",
                        "zh": "整个吞下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загла́тывать",
                                "target_lang_sense_clarification": "глотать добычу или наживку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吞食",
                                "target_lang_sense_clarification": "将猎物或诱饵整吞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "250cf477-6570-3408-9c17-e8e3bf960e27",
                    "sense_definition": "To pout.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pouched</w> his mouth in a silent expression of disapproval.",
                            "target_lang_translations": {
                                "ru": "Он <w>надул</w> губы, безмолвно выражая неодобрение.",
                                "zh": "他<w>撅嘴</w>表示无声的反对。"
                            }
                        },
                        {
                            "text": "The child <w>pouched</w> his lips and refused to answer the question.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>надул</w> губы и отказался отвечать на вопрос.",
                                "zh": "孩子<w>撅嘴</w>拒绝回答问题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надувать губы.",
                        "zh": "撅嘴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надува́ть гу́бы",
                                "target_lang_sense_clarification": "выражать недовольство мимикой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撅嘴",
                                "target_lang_sense_clarification": "通过面部表情表达不满"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}