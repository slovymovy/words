                    {
                        "sense_id": "59eece03-e11d-3656-9c92-f658859a772a",
                        "entry_id": "50b5391b-8b4a-30df-9371-2a8136635068",
                        "glosses": [
                            "een club, vereniging of team dat in de hoofdklasse speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df94cbb0-0c90-42ec-a7e2-e8da9088939e",
                                "sense_id": "59eece03-e11d-3656-9c92-f658859a772a",
                                "text": "De trainer bij de eersteklasser deed zijn racistische uitingen in de wedstrijd afgelopen weekeinde tegen de Amsterdamse club WV-HEDW, meldt het AD. Toen een speler van Argon de bal op een vervelende manier teruggaf aan de keeper van WV-HEDW zou een donkere speler van de Amsterdamse club \"viezerik\" hebben gezegd."
                            },
                            {
                                "example_id": "ff818450-fdb5-433e-9914-fdc31f25ca2d",
                                "sense_id": "59eece03-e11d-3656-9c92-f658859a772a",
                                "text": "De eersteklasser uit Hoofddorp speelt vandaag namelijk een gelegenheidspotje tegen oud-spelers van het eerste. Oud-Reiger Warmerdam is ook uitgenodigd. En het inspelen gaat eigenlijk wel lekker. \"Zet mij maar in de spits\", zegt hij tegen de andere 'Reiger Legends'."
                            }
                        ]
                    },
                    {
                        "sense_id": "3456bf34-fbbd-3cc3-9078-591550d2927c",
                        "entry_id": "50b5391b-8b4a-30df-9371-2a8136635068",
                        "glosses": [
                            "leerling die in de eerste klas van de middelbare school zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0748910d-ae29-4d06-b4aa-77b0cf2dd30a",
                                "sense_id": "3456bf34-fbbd-3cc3-9078-591550d2927c",
                                "text": "Volgens Onderwijsminister Slob moeten middelbare scholen komend schooljaar \"extra scherp\" bekijken of een eersteklasser daar op het juiste niveau zit."
                            }
                        ]
                    }
