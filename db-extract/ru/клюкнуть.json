                    {
                        "sense_id": "3b9a1806-3d66-3f35-93ce-21e01cf05f2d",
                        "entry_id": "891f06bf-3c6c-30bd-a3df-494eabd46ea3",
                        "glosses": [
                            "жарг. выпить спиртной напиток"
