                        "examples": [
                            {
                                "example_id": "41650f71-2f3a-43f9-8df0-0463baf17e4b",
                                "sense_id": "15256272-06f6-3ca7-b0d2-080743417044",
                                "text": "„Im Jahre 1963 wurde von der amerikanischen Firma Bechtel innerhalb von vier Monaten die Realisierbarkeit einer Ölleitung über die Alpen festgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
