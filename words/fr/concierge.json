                    "frequency": "High",
                    "semantic_group_id": "habitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>concierge</w> réceptionne les colis pour les résidents lorsqu'ils sont au travail."
                        },
                        {
                            "text": "Elle est descendue voir la <w>concierge</w> pour lui signaler une fuite d'eau dans l'entrée."
                        }
                    ],
                    "synonyms": [
