                        "source_sense_id": "ee47dbeb-41a4-3ce3-9975-05fe33171279",
                        "target_lang_word": "debit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb961b2e-c7f2-3906-bf07-01b96adfce60",
                                        "entry_id": "3f1198f5-ab88-3d0b-b38c-ea5e1c22938c",
                                        "glosses": [
                                            "In bookkeeping, an entry in the left hand column of an account."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "704e29d3-c4ae-4e31-a536-68deeced20af",
                                                "sense_id": "bb961b2e-c7f2-3906-bf07-01b96adfce60",
                                                "text": "A cash sale is recorded as debit on the cash account and as credit on the sales account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db95806-d68c-3396-bedd-c6e6e8e44592",
                                        "entry_id": "3f1198f5-ab88-3d0b-b38c-ea5e1c22938c",
                                        "glosses": [
                                            "A sum of money taken out of a bank account. Thus called, because in bank's bookkeeping a cash withdrawal diminishes the amount of money held on the account, i.e. bank's debt to the customer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "debit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c137bd91-7659-3ed8-8577-315cddb50209",
                                        "entry_id": "f2c757d0-783d-315d-8c25-9ff493f77e0e",
                                        "glosses": [
                                            "To make an entry on the debit side of an account."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4a470d-d0f2-4839-be11-e05a37bf6b33",
                                                "sense_id": "c137bd91-7659-3ed8-8577-315cddb50209",
                                                "text": "The economist also observed that some of the Victoria Line's cost should be debited to existing lines, as they would benefit from the rebuilding of their interchange stations with the new tube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc2e344-4a8d-34a9-96e1-0c580a19d7f9",
                                        "entry_id": "f2c757d0-783d-315d-8c25-9ff493f77e0e",
                                        "glosses": [
                                            "To record a receivable in the bookkeeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559bcc06-c98e-48d1-80d9-03f09993c10b",
                                                "sense_id": "fbc2e344-4a8d-34a9-96e1-0c580a19d7f9",
                                                "text": "We shall debit the amount of your purchase to your account."
                                            },
                                            {
                                                "example_id": "27eca767-3d89-4689-a10b-4ff41ec09bc3",
                                                "sense_id": "fbc2e344-4a8d-34a9-96e1-0c580a19d7f9",
                                                "text": "We shall debit your account for the amount of the purchase."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debit",
                                "target_lang_code": "en",
                                "target_senses": [
