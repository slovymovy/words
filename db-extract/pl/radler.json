                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pivo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6972ebb8-2256-32c9-a4c0-2d06fd33abf0",
                                        "entry_id": "41260aa7-0d8d-30ec-a2e0-1829b883ad72",
                                        "glosses": [
                                            "kvašený, slabě alkoholický nápoj vyráběný z vody, obilovin (především ječmene) a chmele pomocí pivovarských kvasinek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41aa31f7-e834-4b01-b93d-6e9d46036570",
                                                "sense_id": "6972ebb8-2256-32c9-a4c0-2d06fd33abf0",
                                                "text": "Dobré pivo se vaří leckde, nejen v Česku."
                                            },
                                            {
                                                "example_id": "be3da45d-7927-4457-9085-e93698afcec1",
                                                "sense_id": "6972ebb8-2256-32c9-a4c0-2d06fd33abf0",
                                                "text": "vepřové výpečky na černém pivu se sladkými bramborami"
                                            },
                                            {
                                                "example_id": "efec8c3c-5df6-4596-b148-2f73974f3395",
                                                "sense_id": "6972ebb8-2256-32c9-a4c0-2d06fd33abf0",
                                                "text": "Některým lidem pivo nechutná, protože je hořké."
                                            },
                                            {
                                                "example_id": "0d364263-0c7c-4c29-84ec-1e1fd4afea66",
                                                "sense_id": "6972ebb8-2256-32c9-a4c0-2d06fd33abf0",
                                                "text": "Tomu, co tady ti tři povídají, dohromady moc nerozumí. Ani tomu rozumět nechce. Vlastně je mu úplně jedno, o čem se baví. Najedl se guláše a teď se nemůže hnout. Zkusí třetí pivo? Proč ne. Na mase a na pivu se tu nešetří. Keramik se napije z láhve jako Cajthaml. Poslední hlt už sotva polkne. Začíná mu být pořádně zle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3043f8eb-1cff-3e78-8404-4e4f747d80bb",
                                        "entry_id": "41260aa7-0d8d-30ec-a2e0-1829b883ad72",
                                        "glosses": [
                                            "druh či značka piva (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31db5041-f50a-4b69-ab48-a9f2b2ed2969",
                                                "sense_id": "3043f8eb-1cff-3e78-8404-4e4f747d80bb",
                                                "text": "Které pivo máš rád?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef0f9c4-eff5-39fc-9bb9-4c4244c42aa5",
                                        "entry_id": "41260aa7-0d8d-30ec-a2e0-1829b883ad72",
                                        "glosses": [
                                            "sklenice piva (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4c5e18-a190-409c-9f53-87ace820884b",
                                                "sense_id": "4ef0f9c4-eff5-39fc-9bb9-4c4244c42aa5",
                                                "text": "Dvě piva, prosím!"
                                            },
                                            {
                                                "example_id": "4162aecf-d658-41f2-b6dc-bb385ef28635",
                                                "sense_id": "4ef0f9c4-eff5-39fc-9bb9-4c4244c42aa5",
                                                "text": "Moc se tady nekasej. Po osmi pivech bys měl dost i ty!"
                                            }
                                        ]
                                    }
                                ]
                            },
