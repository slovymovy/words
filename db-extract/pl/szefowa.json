                "senses": [
                    {
                        "sense_id": "98edec44-8e19-3cc9-8a0e-38e7d8516001",
                        "entry_id": "0cb530d0-5b9e-33c3-ba4f-e3a9272e75ac",
                        "glosses": [
                            "przełożona, zwierzchniczka"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ff97ed0d-8b7f-4626-85ce-b159bc073450",
                                "sense_id": "98edec44-8e19-3cc9-8a0e-38e7d8516001",
                                "text": "Moja szefowa to taka rycząca czterdziestka."
                            },
                            {
                                "example_id": "cdcba953-9aba-4108-a307-673065f2d508",
                                "sense_id": "98edec44-8e19-3cc9-8a0e-38e7d8516001",
                                "text": "Lepiej nie mów za dużo przy Wiktorze, to piesek szefowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fb0b15ae-dfaa-31dd-b262-389ea17d7518",
                        "entry_id": "0cb530d0-5b9e-33c3-ba4f-e3a9272e75ac",
                        "glosses": [
                            "poufale o kobiecie podejmującej decyzje"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c3def73b-d2ab-47f5-a8d2-7e289529f13b",
                                "sense_id": "fb0b15ae-dfaa-31dd-b262-389ea17d7518",
                                "text": "To gdzie wnieść te meble, szefowo?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1f6e86f1-ac28-325e-8cb1-30af5242c129",
                        "entry_id": "0cb530d0-5b9e-33c3-ba4f-e3a9272e75ac",
                        "glosses": [
                            "żona szefa"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5e0738-ccc5-45f4-876f-8f5f36191ec8",
                                "sense_id": "1f6e86f1-ac28-325e-8cb1-30af5242c129",
                                "text": "Czy szefowa nie wie, gdzie poszedł szef?"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
