                        "target_lang_word": "Komorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135224ac-7d7f-320f-ab31-dc56a4fc35ca",
                                        "entry_id": "e2ce31a6-0cde-3704-9873-d6eddfaea0ec",
                                        "glosses": [
                                            "eine Bantusprache mit vier Dialekten (Shimaore, Shimwali, Shindzuani, Shingazidja), die auf den Komoren gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f647b4b-0a5e-46c8-9c17-1566d1f594c3",
                                                "sense_id": "135224ac-7d7f-320f-ab31-dc56a4fc35ca",
                                                "text": "„Heute sprechen die Menschen dort überwiegend Komorisch, die beiden anderen amtlichen Sprachen sind Arabisch und Französisch.“"
                                            },
                                            {
                                                "example_id": "5ffdad8e-6d29-45cb-84b7-b80581d8d114",
                                                "sense_id": "135224ac-7d7f-320f-ab31-dc56a4fc35ca",
                                                "text": "„Eine weitere kleine Gruppe auf Mayotte, beschränkt auf die Verwaltungszentren Mamoudzou und Petite Terre, die ebenfalls nicht das Komorische als Muttersprache pflegt, ist die der französischstämmigen oder kreolischen Zuwanderer.“"
                                            },
                                            {
                                                "example_id": "2c9e36e8-2e80-4220-8107-ab3bfceee936",
                                                "sense_id": "135224ac-7d7f-320f-ab31-dc56a4fc35ca",
                                                "text": "„Das Komorische zeigt Ähnlichkeiten mit den nördlichen Swahili-Dialekten, die jedoch nicht auf der Ebene der spontanen Verstehbarkeit liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
