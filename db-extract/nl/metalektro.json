                "senses": [
                    {
                        "sense_id": "582843db-9321-320d-b451-2b587d7db748",
                        "entry_id": "6757138e-cd0d-38dc-b9ea-2e19002df697",
                        "glosses": [
                            "deel van de metaalindustrie waarin elektrische apparatuur wordt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "401f971a-edd0-4e4c-9536-b02db64f400a",
                                "sense_id": "582843db-9321-320d-b451-2b587d7db748",
                                "text": "In de Metalektro werken zo’n 160.000 mensen bij ongeveer 1.100 bedrijven. Het is een grote, belangrijke en trotse sector, waar essentieel werk wordt verricht. De bedrijven en werkzaamheden zijn heel divers. Maar alle bedrijven in de Metalektro zijn of actief in de metaalindustrie of in de elektrotechnische industrie."
                            },
                            {
                                "example_id": "f4552b7b-0aef-4dd5-871d-34f5f218f3d6",
                                "sense_id": "582843db-9321-320d-b451-2b587d7db748",
                                "text": "Pensioenfonds ABP voor overheid en onderwijs zegt dat het \"geen grote klap\" oplevert als hun belangen in één klap met tientallen procenten worden afgewaardeerd. PME, het Pensioenfonds van de Metalektro, heeft slechts 0,1 procent van het totale vermogen in Grieks staatspapier belegd. Ook de blootstelling van dit fonds is beperkt."
                            },
                            {
                                "example_id": "bc0acbe1-99eb-433b-b487-445fff380484",
                                "sense_id": "582843db-9321-320d-b451-2b587d7db748",
                                "text": "PME, het pensioenfonds voor de Metalektro, zal volgend jaar de pensioenen niet verhogen. Daardoor loopt het fonds al meer dan vijf procent achter bij de ontwikkeling van de lonen. Het fonds zal volgend jaar de premie niet verhogen."
                            }
                        ]
                    }
