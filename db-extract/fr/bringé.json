                                        "sense_id": "b73bb984-2560-387a-9d5b-f3871c03d15c",
                                        "entry_id": "e1fc6098-c8cc-3f10-abc3-f1c327de5e62",
                                        "glosses": [
                                            "An animal so coloured."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548977fd-a53d-4b60-b6e9-286e417b1d56",
                                                "sense_id": "b73bb984-2560-387a-9d5b-f3871c03d15c",
                                                "text": "I snatch at the puppy closest to me, the brindle, which is limp in my hand, and shove it down my shirt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brindle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "218f050a-2089-305b-8cab-b81bf3f921cb",
                                        "entry_id": "b8e790bd-b22e-363f-8df3-79f5a897891e",
                                        "glosses": [
                                            "Having such a colouration; brindled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c42aaa3-a4cb-4d11-bb01-612fd6426987",
                                                "sense_id": "218f050a-2089-305b-8cab-b81bf3f921cb",
                                                "text": "It is brindle. Stripes of black and brown ride its ribs like a zebra’s."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brindle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bae01ba-7ea0-36ef-a8ce-331efc555b33",
                                        "entry_id": "df4e0207-9fff-3088-8923-0c2fc3914418",
                                        "glosses": [
                                            "To form streaks of a different color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80a58b4-33d0-4155-93fb-8c559c27cfbf",
                                                "sense_id": "3bae01ba-7ea0-36ef-a8ce-331efc555b33",
                                                "text": "Sorely too as I laboured and toiled, the reward of toil would not come ; already my back began to curve, and my hair to brindle itself with gray, yet I saw no luck before me."
                                            },
                                            {
                                                "example_id": "697b26b8-f86c-47d1-9d7c-8a5a7a5db8cf",
                                                "sense_id": "3bae01ba-7ea0-36ef-a8ce-331efc555b33",
                                                "text": "It is the perfect opposition of dark and light that brindles the tiger with gold flame and dark flame."
                                            },
                                            {
                                                "example_id": "0bafb567-1d5c-4134-a234-7917eb3b58a2",
                                                "sense_id": "3bae01ba-7ea0-36ef-a8ce-331efc555b33",
                                                "text": "The darkest areas (the points) may brindle or become bleached by brilliant sunlight, especially in chocolate and white points."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
