                        "sense_id": "afc32925-d074-3606-99d3-818dfd97356f",
                        "entry_id": "ad1f5219-b32c-3751-b7c4-26c0df830fc0",
                        "glosses": [
                            "Commis de mercerie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7da5c230-c65d-4de0-a552-e013c6ede203",
                                "sense_id": "afc32925-d074-3606-99d3-818dfd97356f",
                                "text": "Les bonnetons et les bobinards ont l’air de battre monnaie, murmura Favier en parlant des vendeurs de la bonneterie et de la mercerie."
                            }
                        ]
                    }
                ],
                "translations": [],
