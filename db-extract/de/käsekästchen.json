                        "entry_id": "18f5abcc-3bac-39b4-9187-a6f4bddd173f",
                        "glosses": [
                            "synonym of Tic-Tac-Toe (“tic-tac-toe, noughts and crosses”)"
                        ],
                        "tags": [
                            "broadly",
                            "informal",
