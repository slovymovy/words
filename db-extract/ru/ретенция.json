                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3663dec2-669e-4402-b875-4f7e1f15aa71",
                                                "sense_id": "7e861161-e13f-37d2-a728-057dab4d4445",
                                                "text": "Eine Retention erreicht man schon mit einem ganz einfachen Gipsverband."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eec68daf-4c27-3e84-a2bc-0de5b3e08f69",
