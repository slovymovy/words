                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "110f5d1f-57ce-32bf-b9c5-ed4aeb96bab4",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "The act of regulating or the condition of being regulated."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "334cd6cf-8416-34ca-a87e-71bde5410f0e",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "A law or administrative rule, issued by an organization, used to guide or prescribe the conduct of members of that organization."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ecbc61-c6a0-429e-94f7-5aaac08919f2",
                                                "sense_id": "334cd6cf-8416-34ca-a87e-71bde5410f0e",
                                                "text": "Army regulations state a soldier AWOL over 30 days is a deserter."
                                            },
                                            {
                                                "example_id": "12c42a4c-f2c3-4cfc-afd3-42bb8552c7e7",
                                                "sense_id": "334cd6cf-8416-34ca-a87e-71bde5410f0e",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            },
                                            {
                                                "example_id": "86a84f48-3413-45f6-9778-4d3b957420cf",
                                                "sense_id": "334cd6cf-8416-34ca-a87e-71bde5410f0e",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra-wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfdb0f3-f21e-30e5-993a-5ac46913d667",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "A type of law made by the executive branch of a government, usually as authorized by a statute made by the legislative branch giving the executive the authority to do so."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8804954-db08-3c74-afee-6939babc9e1f",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "A type of law made by the executive branch of a government, usually as authorized by a statute made by the legislative branch giving the executive the authority to do so.",
                                            "A numbered provision within such kind of legislation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53292c41-c977-46ba-ac23-59f0039b1454",
                                                "sense_id": "b8804954-db08-3c74-afee-6939babc9e1f",
                                                "text": "Regulation 18B of the Defence (General) Regulations 1939 (S.R. & O. 1939/927) authorized the British government to intern suspected spies and collaborators during World War II."
                                            },
                                            {
                                                "example_id": "7be2db08-3cdc-4efd-8018-928fb244fa5f",
                                                "sense_id": "b8804954-db08-3c74-afee-6939babc9e1f",
                                                "text": "(2) These Regulations extend to England and Wales only, subject to paragraph (3).\n(3) This regulation and regulation 2(h) and (v)(i) and (ii) extend to England and Wales, Scotland and Northern Ireland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87b8a8ff-a790-34d3-84b7-89d6ba302daf",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "A form of legislative act which is self-effecting, and requires no further intervention by the Member States to become law."
                                        ],
                                        "tags": [
                                            "European-Union",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df914b73-e116-3428-9699-2de16e6465f0",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "Mechanism controlling DNA transcription."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7deced42-cc7d-314f-99f0-79b6b49dd591",
                                        "entry_id": "e0c5b930-1524-3a2a-adb1-11af4bdbd079",
                                        "glosses": [
                                            "Physiological process which consists in maintaining homoeostasis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "regulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6af0811-0c99-3346-961b-af2a6e37d498",
                                        "entry_id": "1d767580-92f2-328b-8c6e-869818cd233e",
                                        "glosses": [
                                            "In conformity with applicable rules and regulations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ae6965-a553-489d-8a7a-5360b1d98dd6",
                                                "sense_id": "a6af0811-0c99-3346-961b-af2a6e37d498",
                                                "text": "\"The hat is regulation as well, I assume.\""
                                            },
                                            {
                                                "example_id": "c7240873-3e7e-4dd4-859e-2c666cd41da6",
                                                "sense_id": "a6af0811-0c99-3346-961b-af2a6e37d498",
                                                "text": "It is regulation that these directives are to be destroyed on receipt."
                                            },
                                            {
                                                "example_id": "ff247469-fc7f-4b5e-92c6-ac252f3e65de",
                                                "sense_id": "a6af0811-0c99-3346-961b-af2a6e37d498",
                                                "text": "It is the responsibility of every legionare to be sure that he is regulation height as well."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9693538-4c4a-4f68-b055-d6b1e074dd65",
                        "source_entry_id": "3aa5d6fc-9da7-3200-b8cf-52eff611312e",
                        "source_sense_id": "03c0a16b-6a8d-3c90-ae30-7f83ed051723",
                        "target_lang_word": "Regelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beecbe40-7ddf-3049-9efe-05577580a822",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "das Ordnen, Regeln"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f16d9179-b5ef-48de-bfaf-e3e12b3f0f5e",
                                                "sense_id": "beecbe40-7ddf-3049-9efe-05577580a822",
                                                "text": "Die Regelung des Verkehrs erfolgt durch die Verkehrspolizei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "Verfahren, bei dem das Ergebnis über eine Rückkopplung Einfluss auf die Stellgröße nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd87dd3-124c-444f-b0de-372d81252e85",
                                                "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                                "text": "Bei der Regelung wird der tatsächliche Wert des Ausgangs auf den Regler zurückgeführt, so dass auf Störungen reagiert werden kann und der Sollwert trotz ungenauer Modelle erreicht wird."
                                            },
                                            {
                                                "example_id": "7db32cc4-08d0-4f2a-859d-fc2818ac7859",
                                                "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                                "text": "Zur Realisierung einer digitalen Regelung ist es erforderlich, dass das kontinuierliche Signal mit einer geeigneten Abtastrate abgetastet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "Festlegung, Vorschrift, die etwas ordnet oder reguliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f65e68-6317-4962-887e-a8f7493db5c5",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "Die Innenministerkonferenz hatte bereits im Dezember beschlossen, die bisher großzügige Regelung zu verschärfen."
                                            },
                                            {
                                                "example_id": "8a8d7734-d0ff-4a28-98f8-4627ce8852c9",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "Ab wann tritt die neue Regelung für das Kindergeld in Kraft?"
                                            },
                                            {
                                                "example_id": "f089601a-ad30-4b22-acfd-b9413f9e20cc",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "„Nach der neuen Regelung der Worttrennung am Zeilenende ergeben sich bei vielen Fremdwörtern mehrere Trennvarianten.“"
                                            },
                                            {
                                                "example_id": "71eacda0-56b8-42be-b32a-859b82a4a9ba",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "„Das EU-Parlament hat für eine Regelung gestimmt, wonach unverkaufte Kleidung nicht mehr vernichtet werden darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "337db0cb-f5f0-4a02-abd1-196d1bddbd50",
                        "source_entry_id": "3aa5d6fc-9da7-3200-b8cf-52eff611312e",
                        "source_sense_id": "8c64269c-f3a4-358c-9f7f-5bd74057d8df",
                        "target_lang_word": "Regulierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regulierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                        "entry_id": "7e0c9a36-92bf-3099-a454-75993edb6392",
                                        "glosses": [
                                            "Steuerung, Kontrollieren eines Prozesses oder von Störungen; Maßnahme, um bestimmte Vorgänge, Zustände zu beeinflussen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf6869b-005d-462f-af3e-24113a1f8a42",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Diese Ansteckungsrisiken könnten den Druck in Richtung einer strengeren Regulierung des Bereichs erhöhen.“"
                                            },
                                            {
                                                "example_id": "ad54ccd4-2ec8-4891-a7a3-0b9b6dc788ad",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Der Tierschutzbund fordert daher eine Regulierung des Internethandels und eine europaweite, verpflichtende Kennzeichnung und Registrierung für Haustiere, um deren Herkunft besser rückverfolgen zu können.“"
                                            },
                                            {
                                                "example_id": "ccbba77c-7f6e-4fae-8728-c459327d2462",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Dies verdeutliche die Rolle des Waldes zur Regulierung des Klimas und bei der Speicherung von CO2.“"
                                            },
                                            {
                                                "example_id": "e0d9e8eb-5ff9-4b88-954c-beeb6d85659f",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Der Vorstandssprecher der Deutschen Automatenwirtschaft, Georg Stecker, forderte eine einheitliche bundesweite Regulierung des gesamten Glücksspielmarktes - etwa mit einer einheitlichen Sperrdatei für Spieler.“"
                                            },
                                            {
                                                "example_id": "7948aa38-fab3-44b6-87f1-29c504a33da7",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Fischer und Krebs hatten in Seattle in den fünfziger Jahren einen wichtigen biochemischen Mechanismus entdeckt, der bei der Regulierung des Stoffwechsels eine zentrale Rolle spielt: die Phosphorylierung.“"
                                            },
                                            {
                                                "example_id": "ec2467cd-f019-4af2-9bcd-bea771daa2de",
                                                "sense_id": "07a2607e-ac6e-3bda-b423-f62a4af45e7d",
                                                "text": "„Die Richter hatten den Berliner Mietendeckel nur aus rein formalen Gründen für nichtig erklärten, nicht die Regulierung des Wohnungsmarkts an sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
