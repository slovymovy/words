                "senses": [
                    {
                        "sense_id": "a9ca4456-e6c7-3096-a649-84af840088a1",
                        "entry_id": "d4061b73-b751-3915-8c03-87227a633944",
                        "glosses": [
                            "Moyen d’amuser ou de se divertir par de petits amusements."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "585339f5-35a5-48e7-8759-531b469ba59b",
                                "sense_id": "a9ca4456-e6c7-3096-a649-84af840088a1",
                                "text": "Je ne puis moins en faveur de cette chestifve condition où mon âge me poulse que de luy fournir de jouets et d’amusoires comme à l'enfance"
                            },
                            {
                                "example_id": "0b91419a-ecf4-4596-a70e-430680627902",
                                "sense_id": "a9ca4456-e6c7-3096-a649-84af840088a1",
                                "text": "Et cela avait donné: ou ces fauves dangereux, dont les hommes, trop lâches, se servaient pour agresser autrui, ou alors ces minuscules et stupides amusoires, que des imbéciles, de ces temps pernicieux révéraient, comme s’il s’était agi, et peut-être plus encore, de leurs propres enfants !"
                            },
                            {
                                "example_id": "8a124b43-8cdd-4058-8a88-aa59f946d588",
                                "sense_id": "a9ca4456-e6c7-3096-a649-84af840088a1",
                                "text": "Cela n’est pas sérieux, ce n’est qu’une amusoire."
                            }
                        ]
                    }
                ],
