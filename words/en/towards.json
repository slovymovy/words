{
    "word_family": [
        "toward",
        "untoward"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "18f3fa77-e157-31ed-b462-7113de0e816a",
                    "sense_definition": "In the direction of someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To the left towers the Jungfrau, with the train heading directly <w>towards</w> it.",
                            "target_lang_translations": {
                                "ru": "Слева возвышается Юнгфрау, и поезд направляется прямо <w>к</w> ней.",
                                "zh": "左侧耸立着少女峰，火车正直接<w>朝</w>它驶去。"
                            }
                        },
                        {
                            "text": "She started walking <w>towards</w> the city center.",
                            "target_lang_translations": {
                                "ru": "Она пошла <w>в сторону</w> центра города.",
                                "zh": "她开始<w>向</w>市中心走去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toward"
                    ],
                    "antonyms": [
                        "fromwards"
                    ],
                    "common_phrases": [
                        "walk towards",
                        "move towards",
                        "look towards",
                        "turn towards"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative form of toward"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении кого-либо или чего-либо.",
                        "zh": "朝向某人或某物的方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "к",
                                "target_lang_sense_clarification": "предлог направления (указывает на приближение)"
                            },
                            {
                                "target_lang_word": "в сторону",
                                "target_lang_sense_clarification": "указывает на общее направление движения"
                            },
                            {
                                "target_lang_word": "по направлению к",
                                "target_lang_sense_clarification": "формальное указание направления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "向",
                                "target_lang_sense_clarification": "表示动作的方向"
                            },
                            {
                                "target_lang_word": "朝",
                                "target_lang_sense_clarification": "表示动作的方向"
                            },
                            {
                                "target_lang_word": "往",
                                "target_lang_sense_clarification": "表示去往某处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "aed4a7a9-0810-3f34-a755-7d776f16a235",
                    "sense_definition": "In the direction of something indicated by context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thus as he spake, lo far away they spyde / A varlet running <w>towards</w> hastily.",
                            "target_lang_translations": {
                                "ru": "Пока он говорил, они заметили вдалеке слугу, поспешно бегущего <w>навстречу</w>.",
                                "zh": "他正说着，忽然看见远处有个仆人正匆忙地<w>朝</w>这边跑来。"
                            }
                        },
                        {
                            "text": "He saw the light in the distance and moved <w>towards</w>.",
                            "target_lang_translations": {
                                "ru": "Он увидел свет вдалеке и двинулся <w>в ту сторону</w>.",
                                "zh": "他看见远处的灯光，便<w>往</w>那边走去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toward"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage as an adverb without an object is largely archaic or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении чего-либо, понятного из контекста.",
                        "zh": "朝向上下文所指的方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навстречу",
                                "target_lang_sense_clarification": "движение по направлению к кому-либо/чему-либо"
                            },
                            {
                                "target_lang_word": "в ту сторону",
                                "target_lang_sense_clarification": "указание направления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那边",
                                "target_lang_sense_clarification": "指代某个方向"
                            },
                            {
                                "target_lang_word": "过来",
                                "target_lang_sense_clarification": "表示向说话人或目标靠近"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4e05287-198b-3514-8c6e-028b5e8bd0b1",
                    "sense_definition": "Near; at hand; in a state of preparation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have a trifling foolish banquet <w>towards</w>.",
                            "target_lang_translations": {
                                "ru": "У нас <w>готовится</w> пустяковый глупый банкет.",
                                "zh": "我们有一场无聊的宴会<w>正在筹备</w>。"
                            }
                        },
                        {
                            "text": "Great events were <w>towards</w> in the royal court.",
                            "target_lang_translations": {
                                "ru": "При королевском дворе <w>намечались</w> великие события.",
                                "zh": "王室宫廷里<w>即将发生</w>大事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toward"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий; под рукой; в состоянии подготовки.",
                        "zh": "临近的；在准备中的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предстоящий",
                                "target_lang_sense_clarification": "ожидаемый в ближайшем будущем"
                            },
                            {
                                "target_lang_word": "готовящийся",
                                "target_lang_sense_clarification": "находящийся в процессе подготовки"
                            },
                            {
                                "target_lang_word": "намечающийся",
                                "target_lang_sense_clarification": "планируемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "即将到来",
                                "target_lang_sense_clarification": "指事件即将发生"
                            },
                            {
                                "target_lang_word": "筹备中",
                                "target_lang_sense_clarification": "指正在准备的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}