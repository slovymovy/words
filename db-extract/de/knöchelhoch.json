                "senses": [
                    {
                        "sense_id": "17871aab-ad63-3d05-8b9a-7306bbde99a7",
                        "entry_id": "d8cc26bf-9c8e-3dad-a0e5-594c0d857707",
                        "glosses": [
                            "vom Boden bis zum Knöchel reichend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ff8510-a21d-4368-909c-794cfba88151",
                                "sense_id": "17871aab-ad63-3d05-8b9a-7306bbde99a7",
                                "text": "„Feste, knöchelhohe Schuhe sind wichtig, denn der Boden ist uneben, Wurzeln ragen heraus und es ist meist schlammig.“"
                            },
                            {
                                "example_id": "004868b9-2e0f-4732-8647-54ed0ee7cb78",
                                "sense_id": "17871aab-ad63-3d05-8b9a-7306bbde99a7",
                                "text": "„Die Kinder sollten nach heftigen Regenfällen ihre Klassenzimmer räumen, in denen das Wasser knöchelhoch stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
