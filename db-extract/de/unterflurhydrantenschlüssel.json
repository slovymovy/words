                "senses": [
                    {
                        "sense_id": "3e97c5ca-e011-3c92-b84b-59a743a9eed1",
                        "entry_id": "c7f93233-6d0d-3d45-ac2d-5d1d3100fad3",
                        "glosses": [
                            "Werkzeug zum Öffnen unterirdischer Wasserleitungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a6ea47-6bd9-4d40-beb4-189e8a426aee",
                                "sense_id": "3e97c5ca-e011-3c92-b84b-59a743a9eed1",
                                "text": "„Es sei an dieser Stelle darauf hingewiesen, dass die bei der Feuerwehr verwendeten Unterflurhydrantenschlüssel aufgrund der verschiedenen Bewegungen und erforderlichen Kraftrichtungen beim Anheben und Verschwenden des Straßenkappendeckels unergonomisch gestaltet sind.“"
                            },
                            {
                                "example_id": "da9e4904-43c6-4d79-bb43-825e96997654",
                                "sense_id": "3e97c5ca-e011-3c92-b84b-59a743a9eed1",
                                "text": "„An den Brandschutz wurde auch gedacht. In einem Schuppen steht ein Feuerwehrschrank, in dem sich alle Armaturen und Schläuche die für einen Erstangriff befinden, wie Strahlrohre, Schläuche, ein Verteiler und ein Standrohr mit Unterflurhydrantenschlüssel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
