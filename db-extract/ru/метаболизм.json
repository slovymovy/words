                        "sense_id": "bbe8f4f8-95ea-3479-b4d1-7435614ee888",
                        "entry_id": "248d2b82-d87a-389c-aef2-8b815d4f4b77",
                        "glosses": [
                            "биохим. превращение определённых веществ внутри клеток с момента их поступления до образования конечных продуктов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ea94c1a-91af-4793-84b4-5138fe4bb6a0",
