                        "source_sense_id": "4c429e70-1858-350a-844d-ad07643f0637",
                        "target_lang_word": "Potsdamer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Potsdamer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5071b2-eeeb-3397-94ec-6d105b9f4700",
                                        "entry_id": "6d4d5da9-4d43-3da5-a725-757c5bc2a262",
                                        "glosses": [
                                            "Bewohner von Potsdam, jemand, der aus Potsdam stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10fa305-9eff-4d47-a144-4f169c7f2d1b",
                                                "sense_id": "ba5071b2-eeeb-3397-94ec-6d105b9f4700",
                                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Potsdamer."
                                            },
                                            {
                                                "example_id": "5c2d5c86-fbca-44c0-8b56-bb45b0a51005",
                                                "sense_id": "ba5071b2-eeeb-3397-94ec-6d105b9f4700",
                                                "text": "„Zunächst weigerte sich der wegen diverser Delikte polizeibekannte Potsdamer, den Bundespolizisten seinen Ausweis vorzuzeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Potsdamer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a89b2b03-ce20-3150-a5b9-bd59a0f27568",
                                        "entry_id": "3f747760-bbf8-3d7b-bc37-7436ba2512b1",
                                        "glosses": [
                                            "die Stadt Potsdam betreffend, aus Potsdam kommend, stammend, zu Potsdam gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53df0a6c-fd28-4d15-94f4-41d0b3504571",
                                                "sense_id": "a89b2b03-ce20-3150-a5b9-bd59a0f27568",
                                                "text": "„Ansprechpartner für die Forscher sind weltweit nicht nur Wissenschaftskollegen, sondern auch die Vertreter der politischen Praxis, ein Feld, auf dem die Potsdamer Politikwissenschaftler über umfangreiche Erfahrungen verfügen.“"
                                            },
                                            {
                                                "example_id": "77ccbd78-4f3e-460c-93ba-1eab19f02edf",
                                                "sense_id": "a89b2b03-ce20-3150-a5b9-bd59a0f27568",
                                                "text": "„Im Januar 2013 nahmen Fahnder einen 32-Jährigen fest, der im Potsdamer Stadtgebiet 32 Einbrüche begangen haben soll — vor allem in Praxen und Büros.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
