                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почти",
                                "target_lang_sense_clarification": "на грани определенного состояния"
                            },
                            {
                                "target_lang_word": "практически",
                                "target_lang_sense_clarification": "в значительной степени"
                            },
                            {
                                "target_lang_word": "на грани",
                                "target_lang_sense_clarification": "вплотную к чему-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
