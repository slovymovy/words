                "senses": [
                    {
                        "sense_id": "5f61b5f7-ac82-3c0a-a9b2-f6c57ce8cd69",
                        "entry_id": "d34159c6-2040-395d-9d30-5fb6d8087b4f",
                        "glosses": [
                            "Petit du dragon et de la dragonne (animaux fabuleux)."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "19b78e94-3e2d-4f0d-a045-fb527221c892",
                                "sense_id": "5f61b5f7-ac82-3c0a-a9b2-f6c57ce8cd69",
                                "text": "Regarde les indications sur la carte du bas afin de faire glisser les bonnes couleurs de flammes, ailes, thorax et ventres aux trois dragonneaux !"
                            }
                        ]
                    },
                    {
                        "sense_id": "98fb3d28-ef80-32a6-a53c-3b3dafe17b02",
                        "entry_id": "d34159c6-2040-395d-9d30-5fb6d8087b4f",
                        "glosses": [
                            "Ver filiforme qui se loge dans le tissu cellulaire des membres inférieurs particulièrement, connu aussi sous le nom de veine de Médine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6495b2e3-632a-42f6-bb32-dbe4e3134f77",
                                "sense_id": "98fb3d28-ef80-32a6-a53c-3b3dafe17b02",
                                "text": "Les travaux des helmintologistes laissent peu à désirer sur la connaissance du ver désigné sous le nom de Dragonneau, Veine de Médine, Ver de Guinée ou Filaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e7f3cb-2a25-329f-8290-ac12bac5eb61",
                        "entry_id": "d34159c6-2040-395d-9d30-5fb6d8087b4f",
                        "glosses": [
                            "Callionyme dragonnet, poisson faisant partie des acanthoptérygiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09220c7-a592-4e65-a650-945163b3c8f5",
                                "sense_id": "49e7f3cb-2a25-329f-8290-ac12bac5eb61",
                                "text": "Le callionyme dragonneau, la baudroie, la raie, la pastenague, le turbot, etc., etc., ont aussi bien les yeux au[-]dessus de la tête, mais l’axe de la pupille est vertical, et en conséquence le regard se divise latéralement et selon la ligne horizontale."
                            }
                        ]
                    },
                    {
                        "sense_id": "825abe00-9b77-3e14-94b3-a2320aea6400",
                        "entry_id": "d34159c6-2040-395d-9d30-5fb6d8087b4f",
                        "glosses": [
                            "Dragon (tache maladive dans l’œil)."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": []
                    },
