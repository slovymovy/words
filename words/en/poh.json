        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "21fdab08-a116-3fa4-b49c-945bf5538d5d",
                    "sense_definition": "Used to show that something is trivial, unimportant, or not worth attention.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dismissive_interjection",
                    "name_type": "no",
                    "synonyms": [
                        "pht",
                        "pooh",
                        "pshaw",
                        "pish"
                    ],
                    "common_phrases": [
                        "oh poh",
                        "poh mere trifle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употребляется, чтобы показать, что что-то является пустяком, неважно или не заслуживает внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подумаешь!",
                                "target_lang_sense_clarification": "о чём-то пустяковом, не стоящем внимания"
                            },
                            {
                                "target_lang_word": "пустяки!",
                                "target_lang_sense_clarification": "о чём-то неважном или несущественном"
                            },
                            {
                                "target_lang_word": "чепуха!",
                                "target_lang_sense_clarification": "пренебрежительное отбрасывание чего-то как ерунды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "928c9508-f522-35d2-9d43-d465937c8348",
                    "sense_definition": "Used to express disagreement, impatience, or mild irritation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dismissive_interjection",
                    "name_type": "no",
                    "synonyms": [
                        "tush",
                        "bah"
                    ],
                    "common_phrases": [
                        "oh poh",
                        "poh youre joking"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употребляется для выражения несогласия, нетерпения или лёгкого раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да ну!",
                                "target_lang_sense_clarification": "выражает несогласие или недоверие"
                            },
                            {
                                "target_lang_word": "полно!",
                                "target_lang_sense_clarification": "выражает нетерпение; призыв не говорить глупостей"
                            },
                            {
                                "target_lang_word": "что за вздор!",
                                "target_lang_sense_clarification": "раздражённое несогласие с чужими словами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "403977b8-14e8-38ce-af16-5de67d4c9f13",
                    "sense_definition": "Used to express disgust or repulsion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "negative_reaction_interjection",
                    "name_type": "no",
                    "synonyms": [
                        "ick",
                        "bleah",
                        "eww",
                        "yuck"
                    ],
                    "common_phrases": [
                        "poh its disgusting",
                        "oh poh"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употребляется для выражения отвращения или омерзения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу!",
                                "target_lang_sense_clarification": "выражение отвращения или брезгливости"
                            },
                            {
                                "target_lang_word": "фи!",
                                "target_lang_sense_clarification": "несколько книжное или старомодное выражение отвращения"
                            },
                            {
                                "target_lang_word": "тьфу!",
                                "target_lang_sense_clarification": "резкое выражение омерзения"
                            }
                        ]
                    }
                }
            ]
        },
