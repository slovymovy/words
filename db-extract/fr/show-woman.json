                "senses": [
                    {
                        "sense_id": "d1fb3ad6-dc13-337d-a427-5512d89783d7",
                        "entry_id": "1c67d872-8e51-3058-ae0f-13fd3c59b95e",
                        "glosses": [
                            "Femme artiste se produisant sur scène (ou encore, par analogie, personnalité publique, sportive…) qui a le sens du spectacle et la capacité d’enflammer son public."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "74cc9dc9-8c4a-4f14-ad5c-dee3c47f43ae",
                                "sense_id": "d1fb3ad6-dc13-337d-a427-5512d89783d7",
                                "text": "Véritable show-woman, on se souvient aussi de son apparition aux côtés de Daniel Craig (qui interprète James Bond) lors de la cérémonie des JO de Londres en 2012, de son spectaculaire (mais faux) saut en parachute, et de son sens de l’humour bien à elle."
                            },
                            {
                                "example_id": "4a3b450e-aae8-4287-99e7-a597718574ed",
                                "sense_id": "d1fb3ad6-dc13-337d-a427-5512d89783d7",
                                "text": "Sobtchak, elle est vraiment un show-man, ou plutôt une show-woman, commente Artiom, admiratif."
                            },
                            {
                                "example_id": "c709ecb6-ee7e-439a-97f7-c833f47ae874",
                                "sense_id": "d1fb3ad6-dc13-337d-a427-5512d89783d7",
                                "text": "Chantal Chambel, une show-woman!"
                            }
                        ]
                    }
                ],
