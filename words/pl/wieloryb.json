            "senses": [
                {
                    "sense_id": "71ecd0ee-f333-3c96-8cd7-d0bd60f50117",
                    "sense_definition": "duży ssak morski przystosowany do życia w wodzie, o wrzecionowatym ciele",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwierzę",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Błękitny <w>wieloryb</w> jest największym zwierzęciem żyjącym na Ziemi.",
                            "target_lang_translations": {
                                "en": "The blue <w>whale</w> is the largest animal living on Earth."
                            }
                        },
                        {
                            "text": "Podczas rejsu po oceanie turyści obserwowali pływające w oddali <w>wieloryby</w>.",
                            "target_lang_translations": {
                                "en": "During the ocean cruise, tourists observed <w>whales</w> swimming in the distance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "połów wielorybów",
                        "płetwal wieloryb"
                    ],
                    "target_lang_definitions": {
                        "en": "a large marine mammal adapted to living in water, with a streamlined, spindle-shaped body"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whale",
                                "target_lang_sense_clarification": "large marine mammal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6aa22d49-52c1-3012-a8c8-ab7b521a0722",
                    "sense_definition": "potoczne określenie dowolnego dużego ssaka z rzędu waleni",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zwierzę",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W języku potocznym każdy duży morski ssak bywa nazywany <w>wielorybem</w>.",
                            "target_lang_translations": {
                                "en": "In colloquial speech, every large marine mammal is sometimes called a <w>whale</w>."
                            }
                        },
                        {
                            "text": "Dzieci często mylą różne gatunki waleni i na wszystkie mówią po prostu <w>wieloryby</w>.",
                            "target_lang_translations": {
                                "en": "Children often confuse different species of cetaceans and simply call them all <w>whales</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "użycie potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a colloquial term for any large mammal of the order Cetacea"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whale",
                                "target_lang_sense_clarification": "any cetacean broadly or colloquially"
                            },
                            {
                                "target_lang_word": "cetacean",
                                "target_lang_sense_clarification": "marine mammal of the order Cetacea"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "24ff0804-8c14-32f0-a1f3-a064f7f57916",
                    "sense_definition": "gwiazdozbiór nieba równikowego",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "W bezchmurną jesienną noc można dostrzec konstelację <w>Wieloryba</w>.",
                            "target_lang_translations": {
                                "en": "On a cloudless autumn night, you can spot the constellation <w>Cetus</w>."
                            }
                        },
                        {
                            "text": "Astronom skierował teleskop w stronę <w>Wieloryba</w>, aby zbadać odległą gwiazdę zmienną.",
                            "target_lang_translations": {
                                "en": "The astronomer pointed the telescope toward <w>Cetus</w> to study a distant variable star."
                            }
                        }
                    ],
                    "synonyms": [
                        "Cet"
                    ],
                    "common_phrases": [
                        "gwiazdozbiór Wieloryba",
                        "konstelacja Wieloryba"
                    ],
                    "target_lang_definitions": {
                        "en": "a constellation in the equatorial region of the sky"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Cetus",
                                "target_lang_sense_clarification": "constellation"
                            },
                            {
                                "target_lang_word": "the Whale",
                                "target_lang_sense_clarification": "constellation Cetus"
                            }
                        ]
                    }
