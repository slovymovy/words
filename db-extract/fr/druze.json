                "entry_id": "a3e9d1ab-93ad-3f4d-8ace-7f36423c1649",
                "word": "druze",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4b9c3b0f-11dd-4628-999d-550742666fd1",
                        "entry_id": "a3e9d1ab-93ad-3f4d-8ace-7f36423c1649",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "druzes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f05d7a82-5791-3b8a-a87a-b6d545913c97",
                        "entry_id": "a3e9d1ab-93ad-3f4d-8ace-7f36423c1649",
                        "glosses": [
                            "Relatif aux Druzes, communauté du Moyen-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff078b48-6652-480e-898b-1b0f03fc5128",
                                "sense_id": "f05d7a82-5791-3b8a-a87a-b6d545913c97",
                                "text": "Les dirigeants druzes de la ville ont fait savoir après cette visite qu’ils rejetaient l’idée d’une riposte."
                            },
                            {
                                "example_id": "f13a5a21-a2b6-43b7-bec9-a1ee7944260c",
                                "sense_id": "f05d7a82-5791-3b8a-a87a-b6d545913c97",
                                "text": "Il n'y a ni liturgie, ni lieux de culte dans le mouvement druze."
                            },
                            {
                                "example_id": "bfee7af9-b5a4-4bc4-a342-0c2a9fde0785",
                                "sense_id": "f05d7a82-5791-3b8a-a87a-b6d545913c97",
                                "text": "Au XIIe siècle, se crée le premier émirat druze au Mont-Liban."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1763c929-8adc-4a8f-bdd0-1e26886dc7b7",
                        "source_entry_id": "a3e9d1ab-93ad-3f4d-8ace-7f36423c1649",
                        "source_sense_id": "f05d7a82-5791-3b8a-a87a-b6d545913c97",
                        "target_lang_word": "Druze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7870a2-092a-33e3-8578-fb1bfb51ca6d",
                                        "entry_id": "6c487284-a273-37d3-bfbe-34332833d46c",
                                        "glosses": [
                                            "A member of a secretive Ismaili Shiite community based mainly in the Middle East, specifically Lebanon, Syria, and Israel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a66bbf0-85c1-4053-9564-a3756e25b082",
                                                "sense_id": "1e7870a2-092a-33e3-8578-fb1bfb51ca6d",
                                                "text": "At Acre, 15,000 Druzes elected a six-member council comprising sheiks and mukhtars, their first official representative body since the establishment of Israel."
                                            },
                                            {
                                                "example_id": "895d36d3-d09b-47dc-8ff0-f83246da8b60",
                                                "sense_id": "1e7870a2-092a-33e3-8578-fb1bfb51ca6d",
                                                "text": "This backlash also fails to take into account that Israel, for all its faults, is a multicultural society where almost half of graduating doctors today are Arabs or Druze."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Druze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40744ae3-0118-38e6-a501-822b6d09406c",
                                        "entry_id": "86179eef-00dd-3ab0-a496-78d820eb2d6d",
                                        "glosses": [
                                            "Of or relating to this religious community."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071b920b-e246-4fa3-b228-aaef8f30ba56",
                                                "sense_id": "40744ae3-0118-38e6-a501-822b6d09406c",
                                                "text": "\"The judges were very surprised when they found out I was Druze,\" she told Sonia Verma in The Times."
                                            },
                                            {
                                                "example_id": "afb742a8-674a-40dd-b7c7-21e2922762b2",
                                                "sense_id": "40744ae3-0118-38e6-a501-822b6d09406c",
                                                "text": "Druze men shouted insults when she walked down the street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23f62014-a57b-48c2-91f4-deaa16beb387",
                        "source_entry_id": "a3e9d1ab-93ad-3f4d-8ace-7f36423c1649",
