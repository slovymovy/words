                ],
                "senses": [
                    {
                        "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                        "entry_id": "fa0e4a41-580c-3f5b-8f67-cf3884ae58f9",
                        "glosses": [
                            "Kernfamilie, die aus nur einem Elternteil und Kind(ern) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8509919e-9dc8-46f0-beba-b592534453b6",
                                "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                                "text": "„Neben der ungleichen räumlichen Verteilung der kollektiven Einrichtungen bestehen zudem auch Ungerechtigkeiten aufgrund des Familieneinkommens: Familien mit bescheidenen Mitteln – insbesondere Einelterfamilien – können im Gegensatz zu den wohlhabenderen Familien die Unzulänglichkeiten des Angebots nicht durch die Zulage für eine bezahlte Betreuung zuhause (AGED) ausgleichen, da diese für die meisten Familien ausserhalb ihrer Möglichkeiten liegt.“"
                            },
                            {
                                "example_id": "c2556092-c69f-49e3-bc1a-fab9b4001091",
                                "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                                "text": "„Das größte Verbesserungspotential ergibt sich bei Einelterfamilien mit günstigen unbeobachtbaren Charakteristika.“"
                            },
                            {
                                "example_id": "f8113391-d01b-4411-bc3d-5146c113e99e",
                                "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                                "text": "„Die ›Einelterfamilien‹ werfen zum Beispiel Betreuungsprobleme auf, die das Versicherungssystem nicht übernehmen kann.“"
                            },
                            {
                                "example_id": "96e20e9f-d706-45d4-8cbd-a18a65b1ff71",
                                "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                                "text": "„In Ehepaarfamilien wächst nur jedes zweite, in Einelterfamilien sogar nur jedes dritte Kind mit Geschwistern auf.“"
                            },
                            {
                                "example_id": "e3885d9a-3f1a-4280-99f8-5ec92d40bb70",
                                "sense_id": "bbfc8774-463c-3cf8-a4c5-8e7ea3780aba",
                                "text": "„In einer einfachen Partnerschaft lebten 1999 2,3% der 20–24-jährigen Frauen […], während in der Schweiz die Zahlen unverheirateter Mütter 2007 bei 16,7% und der Einelterfamilien 2007 bei 13,5% lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
