            "senses": [
                {
                    "sense_id": "ca20c05b-21bf-3db5-96ea-3cdc5e3fbbc9",
                    "sense_definition": "het voorkomen of hevig woeden van bliksem en donder",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Blijf binnen, want het gaat vanavond hevig <w>onweren</w>.",
                            "target_lang_translations": {
                                "en": "Stay indoors, because it is going to <w>thunderstorm</w> heavily tonight.",
                                "es": "Quédate dentro, porque esta noche <w>va a haber una fuerte tormenta</w>."
                            }
                        },
                        {
                            "text": "Toen het gisteren zo hard <w>onweerde</w>, viel plotseling alle elektriciteit uit.",
                            "target_lang_translations": {
                                "en": "When it <w>stormed</w> so hard yesterday, all the electricity suddenly went out.",
                                "es": "Cuando ayer <w>hubo una tormenta</w> tan fuerte, de repente se cortó toda la electricidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "donderen"
                    ],
                    "common_phrases": [
                        "gaan onweren",
                        "hard onweren"
                    ],
                    "target_lang_definitions": {
                        "en": "to thunderstorm; for lightning and thunder to occur or rage violently",
                        "es": "Haber o descargar una tormenta con truenos y relámpagos"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to thunderstorm",
                                "target_lang_sense_clarification": "to have a storm with thunder and lightning"
                            },
                            {
                                "target_lang_word": "to storm",
                                "target_lang_sense_clarification": "with lightning and thunder"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "haber tormenta",
                                "target_lang_sense_clarification": "producirse tempestad con truenos"
                            },
                            {
                                "target_lang_word": "tronar",
                                "target_lang_sense_clarification": "sonar truenos"
                            }
                        ]
                    }
                }
            ]
        },
