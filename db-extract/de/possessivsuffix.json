                    {
                        "sense_id": "b2a5817d-4032-32b8-a3b2-07cf0b5e8053",
                        "entry_id": "a2592f26-0803-3dc6-ba7f-33e771722223",
                        "glosses": [
                            "Endung zur Kennzeichnung des Besitzers/der Besitzerin einer Sache, kommt in uralischen, semitischen und indoeuropäischen Sprachen vor, auch im Türkischen. Im Deutschen stattdessen wird ein Possessivpronomen, z.B. \\\"mein\\\", \\\"dein\\\" etc., verwendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebb02a7-58c9-4867-a989-ee784d080496",
                                "sense_id": "b2a5817d-4032-32b8-a3b2-07cf0b5e8053",
                                "text": "(Finnisch) saunamme \"unsere Sauna\", saunani \"meine Sauna\": -mme und -ni sind Possessivsuffixe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
