                        "sense_id": "d4f13c80-9fb6-3342-a097-1e6dfb8c2a84",
                        "entry_id": "05cd7abf-7e06-3617-9960-b9a5a908d8ea",
                        "glosses": [
                            "Rechercher sur Internet en utilisant le moteur de recherche Bing."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "c9b5837b-ee97-46d5-aa20-4e23bd1d590d",
                                "sense_id": "d4f13c80-9fb6-3342-a097-1e6dfb8c2a84",
                                "text": "Les consommateurs se sont vite moqués du coup de communication raté en clamant “On ne peut pas binguer Google, mais on peut googler Bing !”."
                            },
                            {
                                "example_id": "5f1e8b73-a646-47c4-9115-c0ef245e6a43",
                                "sense_id": "d4f13c80-9fb6-3342-a097-1e6dfb8c2a84",
                                "text": "Mais c’est clair que je vais \"binguer\" beaucoup plus souvent."
                            },
                            {
                                "example_id": "aa58449b-1481-4aaa-96dc-77daeba84990",
                                "sense_id": "d4f13c80-9fb6-3342-a097-1e6dfb8c2a84",
                                "text": "Si vous binguez \"bing\", vous obtiendrez environ dix millions de résultats."
                            }
                        ]
                    }
