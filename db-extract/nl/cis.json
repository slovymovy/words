                                                "sense_id": "fcdf16ff-9f4e-3e14-abaa-42f893f2af1c",
                                                "text": "Die meisten Menschen sind cis."
                                            },
                                            {
                                                "example_id": "3e058fd0-504f-4ef8-839b-5ad9586c6c88",
                                                "sense_id": "fcdf16ff-9f4e-3e14-abaa-42f893f2af1c",
                                                "text": "„Die eine Frau ist trans und die andere nicht-trans, das nennt man cis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
