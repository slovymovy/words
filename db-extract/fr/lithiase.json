                                                "sense_id": "9a85228f-84f8-3d4b-b75b-11ded48113bf",
                                                "text": "Das ist eine Uhr mit fünfzehn Steinen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "2ad6079c-c660-3a6f-b0c8-19e8fd048825",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
