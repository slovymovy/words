                        "sense_id": "1d462962-6a20-3793-b4c3-df0b7e0751b2",
                        "entry_id": "9fd3d7ab-b2f5-39da-8326-0daa38156580",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным толчок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2388daf6-3514-40a9-8a20-577006139c5e",
                                "sense_id": "1d462962-6a20-3793-b4c3-df0b7e0751b2",
                                "text": "Маятниковый тренажер с тензоплатформой служит для тренировок и для исследований толчкового движения спортсменов ― толкателей ядра."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fb82b3-578b-33e8-9cf0-04f805bd2bc0",
                        "entry_id": "9fd3d7ab-b2f5-39da-8326-0daa38156580",
                        "glosses": [
                            "предназначенный, используемый для толчка, отталкивания"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7207ff94-ac7a-4b6a-ba67-6b782ac1579b",
                        "source_entry_id": "9fd3d7ab-b2f5-39da-8326-0daa38156580",
                        "target_lang_word": "impact",
