                "senses": [
                    {
                        "sense_id": "e3f7ebf6-bfd2-3c11-bed7-b74f38633d5d",
                        "entry_id": "ff24434e-668b-3012-a06a-a17d2396708c",
                        "glosses": [
                            "spezieller Arbeitstisch, der meist von Handwerkern genutzt wird, mit montierten Vorrichtungen wie einem Schraubstock"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f148e956-1a4d-498f-bd1d-73de6cd0e08c",
                                "sense_id": "e3f7ebf6-bfd2-3c11-bed7-b74f38633d5d",
                                "text": "Der Chef trug ihm auf, den Akkuschrauber zu holen, der auf der Werkbank lag."
                            },
                            {
                                "example_id": "21c3ab15-aeed-464d-893d-2e0a6796f8b6",
                                "sense_id": "e3f7ebf6-bfd2-3c11-bed7-b74f38633d5d",
                                "text": "„Ein kleiner Mann drehte sich von der Werkbank um.“"
                            },
                            {
                                "example_id": "78a9957d-d253-4290-ab7d-922150792582",
                                "sense_id": "e3f7ebf6-bfd2-3c11-bed7-b74f38633d5d",
                                "text": "„Georg K. Glaser steht an seiner Werkbank und erklärt mir Handwerkszeug wie Niet-, Schlicht- und Kugelhammer, Fausteisen, Rehfuß, Geisfuß, Postillion, Salzfass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "220097c6-4c02-422d-b418-e49678831241",
                        "source_entry_id": "ff24434e-668b-3012-a06a-a17d2396708c",
