                                        "entry_id": "2544ebe8-f952-3647-83bf-e73d5c76a0d5",
                                        "glosses": [
                                            "Very tired."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71dcbe0-db82-456b-9167-0df50a410d52",
                                                "sense_id": "a8c745f0-469f-3a71-adfc-f041aa94602a",
                                                "text": "[Yawn] Well, I'm all in! Time to turn in! Good night all!"
                                            },
                                            {
                                                "example_id": "a7ac6264-2ba5-4967-ae4a-46e8c0ec693f",
                                                "sense_id": "a8c745f0-469f-3a71-adfc-f041aa94602a",
                                                "text": "By half past seven we were both pretty nearly all in, and wet from innumerable fordings of the river, so we stopped and boiled some hot water with the sugar left over from lunch."
                                            },
                                            {
                                                "example_id": "f5a6f66b-c267-46c8-a64d-3b74c395548e",
                                                "sense_id": "a8c745f0-469f-3a71-adfc-f041aa94602a",
                                                "text": "Either the celebrated lilt of her voice was born in, or she had used it so much and so long that it might as well have been. She looked all in, no doubt of that, but the lilt was there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "397a5fdd-ab27-3e1a-8b98-6a182081913a",
                                        "entry_id": "2544ebe8-f952-3647-83bf-e73d5c76a0d5",
                                        "glosses": [
                                            "With everything included."
                                        ],
