                    {
                        "sense_id": "e2313d52-eb11-3ccc-833f-722c8d6baa27",
                        "entry_id": "4f3e0fd4-8e81-3efe-a70b-e5e7ea73ce9c",
                        "glosses": [
                            "Vanellus vanellus een soort weidevogel"
                        ],
