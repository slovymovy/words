                    "sense_id": "5cae8284-625b-3f17-8f21-6db1accefacf",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>schroef</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schroef_materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een doosje <w>schroeven</w> gekocht om de houten tafel stevig vast te zetten.",
                            "target_lang_translations": {
                                "fr": "J'ai acheté une boîte de <w>vis</w> pour fixer solidement la table en bois."
                            }
                        },
                        {
                            "text": "Tussen de oude spullen op zolder lagen nog losse <w>schroeven</w> en spijkers.",
                            "target_lang_translations": {
                                "fr": "Parmi les vieilles affaires au grenier, il y avait encore des <w>vis</w> et des clous en vrac."
                            }
                        }
                    ],
                    "common_phrases": [
                        "losse schroeven",
                        "schroeven en moeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme plurielle du nom « schroef » (vis)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vis",
                                "target_lang_sense_clarification": "pièces métalliques de fixation au pluriel"
                            }
                        ]
                    }
                }
            ]
        },
        {
