                "senses": [
                    {
                        "sense_id": "96870e33-7426-3d6f-9cdc-5a017b5fe6bf",
                        "entry_id": "2228c728-5718-30a8-b602-9674c8926199",
                        "glosses": [
                            "Relatif aux agences de presse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15a3f17-e752-4001-8f71-2d4ba8360e66",
                                "sense_id": "96870e33-7426-3d6f-9cdc-5a017b5fe6bf",
                                "text": "La langue agencière n’est donc pas, malgré les apparences, le fief indéniable de l’objectivité discursive."
                            },
                            {
                                "example_id": "68fdfa00-201d-4bb7-8d60-a6f0910b5638",
                                "sense_id": "96870e33-7426-3d6f-9cdc-5a017b5fe6bf",
                                "text": "La mise en forme agencière repose en effet sur des formats relativement rigides qui la rendent facilement reconnaissable. La dépêche d’agence réclame la plus grande concision, le souci de dire l’essentiel dès le premier paragraphe."
                            }
                        ]
                    }
                ],
