                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I checked the fridge for eggs, but I didn't find <w>any</w>.",
                            "target_lang_translations": {
                                "ru": "Я проверил холодильник на наличие яиц, но не нашел <w>ни одного</w>.",
                                "nl": "Ik controleerde de koelkast op eieren, maar ik vond er <w>geen</w>.",
                                "pl": "Sprawdziłem lodówkę pod kątem jajek, ale nie znalazłem <w>żadnego</w>.",
                                "de": "Ich habe im Kühlschrank nach Eiern gesucht, aber ich habe <w>keine</w> gefunden.",
