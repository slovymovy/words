                        "source_sense_id": "cde99d7a-a368-3374-afe9-ffdf5456bbe5",
                        "source_sense_description": "een vorm van kanker die zich in de baarmoederhals ontwikkelt",
                        "target_lang_word": "Gebärmutterhalskrebs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebärmutterhalskrebs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d261ed4e-c00a-3491-ad5a-ca17df9646b1",
                                        "entry_id": "bf966d41-a7ff-3053-bc59-e0a2b16d8bac",
                                        "glosses": [
                                            "bösartiger Tumor im Bereich des Gebärmutterhalses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d943bed-50ae-45fb-a573-81489e32c81b",
                                                "sense_id": "d261ed4e-c00a-3491-ad5a-ca17df9646b1",
                                                "text": "„Die menopausale Hormontherapie hat keine Auswirkungen auf Gebärmutterhalskrebs, aber hier regelmäßig eine Vorsorge zu machen, ist immer gut.“"
                                            },
                                            {
                                                "example_id": "c545704d-f70e-46f7-8f12-818d00df9399",
                                                "sense_id": "d261ed4e-c00a-3491-ad5a-ca17df9646b1",
                                                "text": "„Um Gebärmutterhalskrebs früh festzustellen, gibt es seit Jahrzehnten eine Vorsorgeuntersuchung.“"
                                            },
                                            {
                                                "example_id": "7ae66e74-bc6e-4ad4-b135-0c27838f2107",
                                                "sense_id": "d261ed4e-c00a-3491-ad5a-ca17df9646b1",
                                                "text": "„Im Jahr 2017 bekamen in Deutschland laut RKI 4340 Frauen die Diagnose Gebärmutterhalskrebs.“"
                                            },
                                            {
                                                "example_id": "04f32cf0-1f83-4ae1-aeab-8022612bd93f",
                                                "sense_id": "d261ed4e-c00a-3491-ad5a-ca17df9646b1",
                                                "text": "„Bei Frauen ab einem Alter von 20 Jahren wird zur Früherkennung von Gebärmutterhalskrebs der äußere Muttermund mit einem speziellen Mikroskop (Kolposkop) betrachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
