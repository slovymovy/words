                                            {
                                                "example_id": "200e3e35-5ed5-4ea3-9ff7-cf54783ac23b",
                                                "sense_id": "772abc2a-0acd-39c4-9af1-3df68e10e9b1",
                                                "text": "Jak się układa pani Magdalenie na nowej drodze życia?"
                                            },
                                            {
                                                "example_id": "16fe4d19-f376-43aa-b88c-078624370dc8",
                                                "sense_id": "772abc2a-0acd-39c4-9af1-3df68e10e9b1",
