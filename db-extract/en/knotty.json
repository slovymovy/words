                                        "examples": [
                                            {
                                                "example_id": "e4f9e08b-2f5a-4de2-9a1b-a02a22b068cd",
                                                "sense_id": "0df55a47-660c-3615-844a-162caa3677bc",
                                                "text": "Wypadały teraz przed jego oczy smugi zarośli, jakich jeszcze nigdy nie widział, płoty z sękatych, nieociosanych żerdzi, na których wisiały przedziwne, niezmiernie długie sople lodu…"
                                            }
