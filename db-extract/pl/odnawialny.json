                "translations": [
                    {
                        "translation_id": "09dc9891-5642-4b51-8e20-ca67e5ebeef2",
                        "source_entry_id": "7e16b9ac-9d0f-3d1c-b3a4-cda4298bd6dc",
                        "source_sense_id": "8cc7cf6c-54fc-3121-903a-0fd51b1c78e6",
                        "target_lang_word": "renewable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Able to be renewed; capable of renewal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f4db24-4acf-48d1-af0b-b02a81521d43",
                                                "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                                "text": "Under the pilot project, the private sector will supply, install, operate and maintain e-vehicle charging stations; monitor and verify the energy efficiency, performance and savings in using renewable energy; and optimize the use of clean energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Sustainable; able to be regrown or renewed; having an ongoing or continuous source of supply."
                                        ],
                                        "tags": [
                                            "of a resource"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43984897-1f40-4ab2-baee-af56881d956a",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable sources of energy"
                                            },
                                            {
                                                "example_id": "b76420fd-ebf5-4151-bf74-d9d3e4f8e0bb",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "Solar and wind power are renewable, but coal is not."
                                            },
                                            {
                                                "example_id": "666de4f8-c13a-4982-9722-07dfdd20ba65",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable resource"
                                            },
                                            {
                                                "example_id": "78d500ef-6109-441e-9e33-e0a81aa7fd27",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable energy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable resource or source of energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95de28b-b768-4fea-b2a4-41c49035a5c8",
                                                "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                                "text": "Klein diagnoses impressively what hasn’t worked. No more claptrap about fracked gas as a bridge to renewables. Enough already of the international summit meetings that produce sirocco-quality hot air, and nonbinding agreements that bind us all to more emissions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable fuse; a fuse which can be opened in order to replace the element."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf5c417-866e-4baf-a6f3-8ab13bcd1f67",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "You'll find the link can be removed from a \"Union\" Renewable and replaced before most fuses can be taken apart."
                                            },
                                            {
                                                "example_id": "63d2bf21-b684-4d45-b5af-f450937ab251",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "It is a pretty safe bet that he can show you where you are using fuses of the wrong type (renewables for non-renewables and vice versa ) -or where fuses that ought to be good for twenty or more renewals are ready for the scrap"
                                            },
                                            {
                                                "example_id": "e64f9ee2-f881-42bd-8604-5cd32331c321",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "Here is a newly designed All-Purpose Superfuse. Use it wherever you need One-Times, Renewables or Dual Element fuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14e90c6a-a093-418f-9a93-60f4dcb0c290",
                        "source_entry_id": "7e16b9ac-9d0f-3d1c-b3a4-cda4298bd6dc",
                        "source_sense_id": "8cc7cf6c-54fc-3121-903a-0fd51b1c78e6",
                        "target_lang_word": "obnovitelný",
