    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c42c5056-5ded-33bd-8140-f28adcbbaba0",
                "word": "unshaven",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b127a8f-59db-389e-b3cf-ce77882f886a",
                        "entry_id": "c42c5056-5ded-33bd-8140-f28adcbbaba0",
                        "glosses": [
                            "Not having shaved; not shaven; untrimmed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "01ea98ef-6c71-4f7a-b69a-13572638f891",
                                "sense_id": "7b127a8f-59db-389e-b3cf-ce77882f886a",
                                "text": "He was an unshaven little man in a threadbare coat like a gaberdine, with his feet in slippers, and I thought him a harmless fool."
                            },
                            {
                                "example_id": "a9da2546-4df2-4c24-b96e-d55a97df92a5",
                                "sense_id": "7b127a8f-59db-389e-b3cf-ce77882f886a",
                                "text": "She was frankly disappointed. For some reason she had expected to discover a burglar of one or another accepted type—either a dashing cracksman in full-blown evening dress, lithe, polished, pantherish, or a common yegg, a red-eyed, unshaven, burly brute in the rags and tatters of a tramp."
                            }
                        ]
                    },
                    {
                        "sense_id": "52217c6a-4b09-34c7-8218-6ad1cc4efde5",
                        "entry_id": "c42c5056-5ded-33bd-8140-f28adcbbaba0",
                        "glosses": [
                            "Unkempt."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "24e75150-bb9a-49f4-b5f2-de67af08f4c0",
                                "sense_id": "52217c6a-4b09-34c7-8218-6ad1cc4efde5",
                                "text": "The recruit's face was smooth but for a single almost imperceptible hair protruding from his chin. \"Unshaven!\" screamed the officer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7844c28-9108-4052-8166-d4005ebc4feb",
                        "source_entry_id": "c42c5056-5ded-33bd-8140-f28adcbbaba0",
                        "source_sense_description": "not having shaved",
                        "target_lang_word": "unrasiert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrasiert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dd0ecbc-315a-3232-9190-835e95bb3758",
                                        "entry_id": "8d45ff5e-d860-3bc4-a725-778d26255e01",
                                        "glosses": [
                                            "nicht rasiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1094c3f1-e998-4a1b-a0ca-64bf59c99289",
                                                "sense_id": "9dd0ecbc-315a-3232-9190-835e95bb3758",
                                                "text": "Nachdem er die ganze Nacht durchgemacht hatte, ging er morgens unrasiert zur Arbeit."
                                            },
                                            {
                                                "example_id": "d71e9710-dde1-415a-9505-5c856df2df48",
                                                "sense_id": "9dd0ecbc-315a-3232-9190-835e95bb3758",
                                                "text": "„Unrasiert und schmutzig traf er ein, und weil er wußte, was sich in solchen Fällen schickte, tat er, als wäre er außer Atem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
