                "senses": [
                    {
                        "sense_id": "884622e3-cb30-3506-bdbb-8eeaf4af2926",
                        "entry_id": "01f0632f-6953-3598-8469-fc9d4c039183",
                        "glosses": [
                            "Niederlage im Endspiel eines Wettkampfes"
