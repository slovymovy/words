                ],
                "senses": [
                    {
                        "sense_id": "b1b1f020-2281-33ab-a183-d1950b4af795",
                        "entry_id": "7f9c2a4d-b81b-36ee-af6d-9cd212b13103",
                        "glosses": [
                            "Untiring; not becoming tired."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a974f9a9-2602-483f-a4b1-391dc1094eec",
                                "sense_id": "b1b1f020-2281-33ab-a183-d1950b4af795",
                                "text": "Mr. Collins repeated his apologies in quitting the room, and was assured with unwearying civility that they were perfectly needless."
                            },
                            {
                                "example_id": "49ba2c47-434c-4a50-815d-9681bfb30865",
                                "sense_id": "b1b1f020-2281-33ab-a183-d1950b4af795",
                                "text": "As a child that has fallen happily asleep in its nurse's arms, and wakes to find itself alone and laid in a strange place, and searches corners and cupboards, and runs from room to room, despair growing silently in its heart, even so Portly searched the island and searched, dogged and unwearying, till at last the black moment came for giving it up, and sitting down and crying bitterly."
                            },
                            {
                                "example_id": "00866187-03fe-467d-adf7-d2f25d1495ca",
                                "sense_id": "b1b1f020-2281-33ab-a183-d1950b4af795",
                                "text": "Night and day are given over to pleasure\nAnd they think it will last a thousand autumns,\nUnwearying autumns."
                            }
                        ]
                    }
                ],
