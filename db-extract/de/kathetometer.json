                "senses": [
                    {
                        "sense_id": "5e94c8c8-6dab-32cd-95ef-281355dd5b27",
                        "entry_id": "3571f130-8cd1-3dc9-95f3-b4e71ebe13dd",
                        "glosses": [
                            "Vorrichtung zur Beobachtung und Vermessung von Änderungen der Lage eines Gegenstandes im Raum"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "d176dc83-fe3e-45b7-b33a-7ed1155275fc",
                                "sense_id": "5e94c8c8-6dab-32cd-95ef-281355dd5b27",
                                "text": "„Das Kathetometer muß vor der Messung sehr gut justiert und während der Messung vor Störungen bewahrt werden.“"
                            },
                            {
                                "example_id": "a6978dad-544f-4112-a633-0c2873ead27d",
                                "sense_id": "5e94c8c8-6dab-32cd-95ef-281355dd5b27",
                                "text": "„Die Lage der Tropfen im Gleichgewicht sowie ihr Steigen oder Fallen werden mit einem Kathetometer bei schwacher Vergrößerung beobachtet […].“"
                            },
                            {
                                "example_id": "8ee04f7f-d574-49d0-aa81-51cbd23a6803",
                                "sense_id": "5e94c8c8-6dab-32cd-95ef-281355dd5b27",
                                "text": "„Die Bestimmung der Länge der Feder erfolgt meistens mit Hilfe eines geeigneten Kathetometers.“"
                            },
                            {
                                "example_id": "e1e63831-2614-4bfa-8dd8-0916246f5323",
                                "sense_id": "5e94c8c8-6dab-32cd-95ef-281355dd5b27",
                                "text": "„Ein Kathetometer ist einfach ein Fernrohr, das auf einer festen, mit einer Meßteilung versehenen Schiene gleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
