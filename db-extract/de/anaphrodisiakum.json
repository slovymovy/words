                                    }
                                ]
                            },
                            {
                                "target_word": "antaphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3d7708-699e-3897-bd92-8bf3f698fcf9",
                                        "entry_id": "165a57ad-2d1f-35b4-b83d-c965dda849ab",
                                        "glosses": [
                                            "A medicinal substance capable of reducing (inhibiting or eliminating) the sex drive/libido."
