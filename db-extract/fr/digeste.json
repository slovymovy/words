                                "target_senses": [
                                    {
                                        "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To distribute or arrange methodically; to work over and classify; to reduce to portions for ready use or application."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a0636a-a4ab-4708-8f4b-d710e77d8f59",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "We have cause to be glad that matters are so well digested."
                                            },
                                            {
                                                "example_id": "f49ed5a4-50b5-4d1e-8aa4-012e3507c78c",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "to digest laws"
                                            },
                                            {
                                                "example_id": "564e5204-75bb-4c4d-9085-9a16bed64833",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "joining them together and digesting them into order"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "291f11a8-7f8b-342b-b2fb-0644b671cd35",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To separate (the food) in its passage through the alimentary canal into the nutritive and nonnutritive elements; to prepare, by the action of the digestive juices, for conversion into blood; to convert into chyme."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To think over and arrange methodically in the mind; to reduce to a plan or method; to receive in the mind and consider carefully; to get an understanding of; to comprehend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef38d6a-0c82-454b-b796-458482d78dd8",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "Feelingly digest the words you speak in prayer."
                                            },
                                            {
                                                "example_id": "e5639e21-b726-4218-a53c-f28157135c2e",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "How shall this bosom multiplied digest / The senate's courtesy?"
                                            },
                                            {
                                                "example_id": "f024c0f0-699a-47cb-8ded-657fb343773f",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "Grant that we may in such wise hear them [the Scriptures], read, mark, learn, and inwardly digest them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55825388-332f-36b9-bf94-5ad37ace6e7b",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To bear comfortably or patiently; to be reconciled to; to brook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8647daa3-5391-4d13-88a2-f894379166a9",
                                                "sense_id": "55825388-332f-36b9-bf94-5ad37ace6e7b",
                                                "text": "I never can digest the loss of most of Origen's works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94297d6a-722c-3adc-a8f4-53147bd68b64",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To expose to a gentle heat in a boiler or matrass, as a preparation for chemical operations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To undergo digestion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd69aba6-b718-4091-8236-09e931ae8862",
                                                "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                                "text": "I just ate an omelette and I'm waiting for it to digest."
                                            },
                                            {
                                                "example_id": "d1382cee-88b8-491a-a9de-390bf4c92cda",
                                                "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                                "text": "I was at the Mathematical School, where the Maſter taught his Pupils after a Method ſcarce imaginable to us in Europe. The Propoſition and Demonſtration were fairly written on a thin Wafer, with Ink compoſed of a Cephalick Tincture. This the Student was to ſwallow upon a faſting Stomach, and for three days following eat nothing but Bread and Water. As the Wafer digeſted, the Tincture mounted to his Brain, bearing the Propoſition along with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b42c74-82fb-3078-99d2-6d2bcf1b520b",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To suppurate; to generate pus, as an ulcer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfae7000-3a06-4c47-b157-f2557c6c6a60",
                                                "sense_id": "35b42c74-82fb-3078-99d2-6d2bcf1b520b",
                                                "text": "The Lips of the Abſceſs digeſted vvell, but from vvithin it onely gleeted, and thruſt out Fat, vvhich vve daily cut off vvithout the loſs of a drop of blood, and dreſſed up the Abſceſs vvith mundif. ex apio, continuing the uſe of diſcutient Fomentations and Cataplaſins."
                                            }
