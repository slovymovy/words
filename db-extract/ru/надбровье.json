                    {
                        "translation_id": "212cffa5-4546-4bff-8031-47352b42ff2d",
                        "source_entry_id": "4a5fee3d-04b5-3023-b756-c0ed5562098e",
                        "source_sense_id": "92524ef2-1ab1-3f58-a280-43c435bd2528",
                        "target_lang_word": "arcade sourcilière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcade sourcilière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a521de6f-63bc-3b66-98cf-c0bd5e601afc",
                                        "entry_id": "99d7e9d1-e046-3acd-bb32-f76877c885df",
                                        "glosses": [
                                            "Saillie que présente l’os frontal, au-dessus de l’orbite de l’œil."
                                        ],
                                        "tags": [
                                            "Squelette"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1a5c1c-6f90-41db-aeef-5fb3faa47fe0",
                                                "sense_id": "a521de6f-63bc-3b66-98cf-c0bd5e601afc",
                                                "text": "Chaque arcade sourcilière, ornée d’un duvet assez rare, dépasse d’une ligne environ l’écaille brune du verre en en doublant en quelque sorte le cercle."
                                            },
                                            {
                                                "example_id": "e38f3eb5-29b1-462a-acec-e958d78ec1f1",
                                                "sense_id": "a521de6f-63bc-3b66-98cf-c0bd5e601afc",
                                                "text": "« Le fantôme de l’Opéra ! »\nJammes avait jeté cette phrase sur un ton d’indicible terreur et son doigt désignait dans la foule des habits noirs un visage si blême, si lugubre et si laid, avec les trous noirs des arcades sourcilières si profonds, que cette tête de mort ainsi désignée remporta immédiatement un succès fou."
                                            },
                                            {
                                                "example_id": "aaf667ea-a9fc-4238-98ef-e5b979ddc76e",
                                                "sense_id": "a521de6f-63bc-3b66-98cf-c0bd5e601afc",
                                                "text": "La chose survint dans la cour de l’école, lors d’une récréation. En pleine course – dans le tohu-bohu d’une partie de barres ou de tout autre jeu – je heurtais l’un de mes camarades qui courait en sens inverse et fus projeté contre un mur, si violemment que je me fendis l’arcade sourcilière jusqu’à l’os."
                                            },
                                            {
                                                "example_id": "762bd281-108f-46c0-9e89-8717346e7aad",
                                                "sense_id": "a521de6f-63bc-3b66-98cf-c0bd5e601afc",
                                                "text": "Une vie banale, où l’on peut aussi se blesser, mais simplement parce que, en accompagnant Mathilde au poney, on s’est cogné par inattention l’arcade sourcilière contre la porte du box."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
