                        "glosses": [
                            "taktische Positionierung von Einsatzkräften, um das Übergreifen eines Brandes auf einen anderen Bereich, der noch nicht brennt, zu verhindern"
                        ],
                        "tags": [
                            "Feuerwehr"
                        ],
                        "examples": [
                            {
                                "example_id": "d0c7e4b5-8f96-4059-bf9b-9953cd7b513d",
                                "sense_id": "06ccea9b-6c4f-3a14-8c03-abb2a52bb1d1",
                                "text": "„Der Waldbrand wütete offiziellen Angaben zufolge auf einer Fläche von mehr als 180 Hektar. Es handele sich vorrangig um Bodenfeuer. Zum Schutz der Ortschaften werde eine sogenannte Riegelstellung eingerichtet.“"
                            }
                        ],
