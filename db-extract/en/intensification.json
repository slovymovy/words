                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "zusätzliches Personal, das für eine bestimmte Aufgabe bereitgestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d5edfe-0495-4545-8eb5-0c29843cb976",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "Da die Front bröckelte mussten immer neue Truppen als Verstärkung abgestellt werden."
                                            },
                                            {
                                                "example_id": "705ac011-4cd8-431d-87f5-b831c92fe94a",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "„Durch diesen Korridor kam hin und wieder Verstärkung, aber der Abwehrkampf der Wehrmacht war aussichtslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Vergrößerung der Amplitude, zum Beispiel Erhöhung der Lautstärke von Geräuschen"
                                        ],
                                        "tags": [
                                            "bezogen auf Wellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db16ed4-1f5f-4d7f-abbc-e131e22857ab",
                                                "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                                "text": "Da die Schwingungen den Passanten einen Gleichschritt aufzwangen kam es zu einer bedrohlichen Verstärkung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "982568d0-e796-37b3-9723-5c936b3f578c",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Intensivierung, Zunahme, Verdichtung"
