    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27d1a8e0-7229-37d1-bd5e-09e978e594f7",
                "word": "neuroscience",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "329c8df4-dbde-4bd0-9eee-59087bc840bd",
