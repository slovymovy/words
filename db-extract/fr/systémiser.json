                "senses": [
                    {
                        "sense_id": "dfbe055c-fa45-3607-8284-0590876efb1f",
                        "entry_id": "52b6025f-4d25-30e7-aae5-dc5c18024a51",
                        "glosses": [
                            "Considérer en tant que système organisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4961fdc3-6330-4a1d-b2f4-8c11e4b7bb9a",
                                "sense_id": "dfbe055c-fa45-3607-8284-0590876efb1f",
                                "text": "Certes, écrit Beaufils, le cerveau [des femmes] ne les prédispose guère, à l’inverse des hommes, à “systémiser”."
                            },
                            {
                                "example_id": "b8a5bac9-d980-48da-87d2-5d96978addde",
                                "sense_id": "dfbe055c-fa45-3607-8284-0590876efb1f",
                                "text": "Outre qu'elle propose un nouveau système d'animation faciale, elle parvient à le systémiser."
                            },
                            {
                                "example_id": "0cf4ba55-afe4-475f-8037-49e46378cdab",
                                "sense_id": "dfbe055c-fa45-3607-8284-0590876efb1f",
                                "text": "C'est à cette époque que la médecine tibétaine commença à se systémiser."
                            }
                        ]
                    }
