        "fr-extract.jsonl": [
            {
                "entry_id": "62f7a119-44f3-3136-99b9-cf0eaa4d948c",
                "word": "Loir",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "266c413f-c091-300b-b87a-89ae41071a53",
                        "entry_id": "62f7a119-44f3-3136-99b9-cf0eaa4d948c",
                        "glosses": [
                            "Rivière du centre-ouest de la France prenant sa source à Fruncé dans l’Eure-et-Loir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d10761-5914-4047-b9d8-269e0333fe7d",
                                "sense_id": "266c413f-c091-300b-b87a-89ae41071a53",
                                "text": "Le Loir prenait autrefois sa source dans la commune de Champrond, près la ferme du Loir. Des titres du XIIᵉ siècle, provenant de l’abbaye de Thiron, signalent la fontaine qui est à mi-côte au-dessous de la ferme dite Abbaye du Loir, comme étant l'ancienne source de cette rivière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
                "word": "loir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e00c525-e8c7-42f5-a227-b2636bcf8399",
                        "entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
                        "tags": [
                            "plural"
                        ],
                        "form": "loirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                        "entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
                        "glosses": [
                            "Petit mammifère de la famille des gliridés ou myoxidés, sous-ordre des myomorphes, ordre des rongeurs vrais ; il en existe plusieurs espèces en Europe, en Asie et en Afrique."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c7786c92-85d1-4b86-8db8-5e56c2e09b20",
                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                "text": "Le loir gris atteint près de quinze à vingt centimètres de long, queue non comprise, essentiellement végétarien, il engraisse fortement juste avant l’hibernation."
                            },
                            {
                                "example_id": "b60db7f6-311c-4d44-9fa0-7ddf9b3fe7c2",
                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                "text": "Il faut donc conclure qu’à l’instar de l’ours, du loir et de la marmotte, Gaston hiberne!"
                            },
                            {
                                "example_id": "46cde2a6-28e1-4c15-9f2c-c84086b3c91c",
                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                "text": "Tout à coup, dans le grenier, les loirs commencèrent une sarabande, qui se termina par une bagarre, avec des bonds et des cris pointus. Puis, le silence se fit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c90d2c8-f8e6-45a0-9721-81df1a435bd4",
                        "source_entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
                        "source_sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                        "source_sense_description": "Petit mammifère de la famille des gliridés",
                        "target_lang_word": "Siebenschläfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siebenschläfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de2604a2-fa82-3ee7-a8c8-ca33875aa00a",
                                        "entry_id": "5694a509-12e8-34ca-abab-c15e8322860f",
                                        "glosses": [
                                            "nachtaktives Nagetier aus der Familie der Bilche (Gliridae) mit besonders langem Winterschlaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35197c1f-1a96-4b7a-9448-9b8b152ac5b3",
                                                "sense_id": "de2604a2-fa82-3ee7-a8c8-ca33875aa00a",
                                                "text": "Der Siebenschläfer ist in unseren Obstgärten daheim."
                                            },
                                            {
                                                "example_id": "eee62934-2c0e-4054-b194-41ac46cf7b2b",
                                                "sense_id": "de2604a2-fa82-3ee7-a8c8-ca33875aa00a",
                                                "text": "Auch Nagetiere haben das Problem der schwerverdaulichen Pflanzennahrung, das die meisten – ausgenommen etwa Siebenschläfer – wie die Hasentiere durch Caecotrophie, die doppelte Verdauung, lösen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a85b10c6-bb7b-32d1-9bef-7c66ee4a8b08",
                                        "entry_id": "5694a509-12e8-34ca-abab-c15e8322860f",
                                        "glosses": [
                                            "Siebenschläfertag, ein Lostag, der 27. Juni, der der Überlieferung nach dafür steht, dass, wenn es an diesem Tag regnet, weitere 7 Wochen regnen soll"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b5c1708-7bf0-4d73-8def-105776e48ebe",
                                                "sense_id": "a85b10c6-bb7b-32d1-9bef-7c66ee4a8b08",
                                                "text": "Gut, dass es heute, am Siebenschläfer, nicht geregnet hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a14360e3-3199-330d-b6f6-88a203fac5f2",
                                        "entry_id": "5694a509-12e8-34ca-abab-c15e8322860f",
                                        "glosses": [
                                            "Person, die lange schläft; jemand, der spät aufsteht"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d790c3-2689-4230-b5ba-e2470ce839f5",
                                                "sense_id": "a14360e3-3199-330d-b6f6-88a203fac5f2",
                                                "text": "Mein Bruder ist ein Siebenschläfer, so schwer ist er aus dem Bett zu kriegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15164089-4970-4ee3-ac6a-46ba170254fa",
                        "source_entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
