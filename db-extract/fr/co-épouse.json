                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9fcd42dc-d3d4-46af-bf48-5004d9ba9bf1",
                        "source_entry_id": "54a4f2b3-c307-38ed-bf29-94bd2776a4f7",
                        "source_sense_id": "d6666713-efa3-3712-ae31-5174ee7c284b",
                        "target_lang_word": "fellow-wife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "813a4046-9076-44f0-86c2-c659a956f101",
                        "source_entry_id": "54a4f2b3-c307-38ed-bf29-94bd2776a4f7",
                        "source_sense_id": "d6666713-efa3-3712-ae31-5174ee7c284b",
                        "target_lang_word": "wife-in-law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wife-in-law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77f18161-f249-3d1b-b32a-4eaeb9646bc2",
                                        "entry_id": "94769acd-13f9-379c-83eb-8f1dd2c55fac",
                                        "glosses": [
                                            "A wife in law only, such as one who has abandoned her husband"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62629b3b-aef7-3ed6-8db6-ac341d7c9ba6",
                                        "entry_id": "94769acd-13f9-379c-83eb-8f1dd2c55fac",
                                        "glosses": [
                                            "A wife who provides domestic or social support, but not love or affection"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "282263e7-1a96-33f1-9e57-962164ac66e5",
                                        "entry_id": "94769acd-13f9-379c-83eb-8f1dd2c55fac",
                                        "glosses": [
                                            "Another wife of one's husband. Typically used in cases of divorce and subsequent remarriage for one's husband's ex-wife, but sometimes used in polygamy for a co-wife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caef8231-120a-44c0-8169-318e34fe4fe0",
                                                "sense_id": "282263e7-1a96-33f1-9e57-962164ac66e5",
                                                "text": "Instead she arranges, offhand, a nice little farewell dinner for her husband that was and the lady, Flora, who is to be her successor three months hence. […] Flora is generously constrained to leave the sometime-husband and wife to talk the matter over. \"Are we not wives-in-law?\" says Madame. And the upshot is that although Flora interrupts them by phone from her flat below several times until the receiver is left off, Madame easily wins back her husband. Indeed, so complete is their absorption that they have forgotten completely the trifling circumstance that they are no longer man and wife."
                                            },
                                            {
                                                "example_id": "9ec16a06-5031-453d-84fe-6fbc6ceeb2a4",
                                                "sense_id": "282263e7-1a96-33f1-9e57-962164ac66e5",
                                                "text": "the collection of people who would gather in either of the two houses for Christmas and Thanksgiving, and sometimes again in summer. This collection involved former mothers-in-law, former husbands, ex-wives of former husbands, and doddering uncles from distant marriages, as well as, of course, the various and sundry children and dogs (dogs-in-law as one family member calls them) of the now recombined families. In the process, I believe, we were responsible for the creation of a new American family relative—the wife-in-law, or the husband-in-law."
                                            },
                                            {
                                                "example_id": "ed2725e2-70a6-411f-a759-7a07b7b383bc",
                                                "sense_id": "282263e7-1a96-33f1-9e57-962164ac66e5",
                                                "text": "\"Your plan provides Browne with two charming wives and gives me but one. […]\"\n\"But, my lord,\" said Saunders, \"doesn't the plan give Lady Deppingham two husbands? It's quite a fair division.\"\n\"It would make Lord Deppingham my husband-in-law, I imagine,\" said Drusilla quaintly. \"I've always had a horror of husbands-in-law.\"\n\"And you would be my wife-in-law,\" supplemented Lady Agnes. \"How interesting!\""
                                            },
                                            {
                                                "example_id": "7d7ad92c-38ee-4def-9769-e7450f21b801",
                                                "sense_id": "282263e7-1a96-33f1-9e57-962164ac66e5",
                                                "text": "Many husbands, like the wives-in-law themselves, were deeply divided and upset over a family life that could no longer be defined as a single unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3f3d417-2a56-44fc-ba66-57f1d4c6a3ed",
                        "source_entry_id": "54a4f2b3-c307-38ed-bf29-94bd2776a4f7",
                        "source_sense_id": "d6666713-efa3-3712-ae31-5174ee7c284b",
                        "target_lang_word": "sister-wife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sister-wife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f04807c2-d5d3-37ac-9416-e5723d00846b",
                                        "entry_id": "9543203c-e383-3e22-b87c-f2e4c2de1b14",
                                        "glosses": [
                                            "A woman who is simultaneously sister and wife to her spouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640f387c-e714-4b4f-b923-0ab6e6702833",
                                                "sense_id": "f04807c2-d5d3-37ac-9416-e5723d00846b",
                                                "text": "Ptolemy VII […] married Cleopatra, the sister-wife of his predecessor."
                                            },
                                            {
                                                "example_id": "a19b64dd-e846-4edc-8a20-3aff586f942f",
                                                "sense_id": "f04807c2-d5d3-37ac-9416-e5723d00846b",
                                                "text": "My Grecians shall victorious prove, By me led on to War, the Sister-Wife of Jove."
                                            },
                                            {
                                                "example_id": "27693e15-0183-4bed-8f85-2a4dc176365a",
                                                "sense_id": "f04807c2-d5d3-37ac-9416-e5723d00846b",
                                                "text": "Anat as sister-wife of Baal, Isis as mother of Horos and sister-wife of Osiris, Hera as sister-wife of Zeus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b13a67e-0abe-39e0-a989-f901abfdc94c",
                                        "entry_id": "9543203c-e383-3e22-b87c-f2e4c2de1b14",
                                        "glosses": [
                                            "In a polygamous marriage, a woman who is simultaneously the sister and co-wife of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ab5787-d902-40c3-a91a-259020d423d5",
                                                "sense_id": "7b13a67e-0abe-39e0-a989-f901abfdc94c",
                                                "text": "Enmities between sister-wives will [be,] from their having known each other too intimately all their lives, more unmannerly than where they are strangers to each other"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd347d18-bd7c-3dbd-8046-53f164dd36e1",
                                        "entry_id": "9543203c-e383-3e22-b87c-f2e4c2de1b14",
                                        "glosses": [
                                            "A co-wife in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1efc8e-4710-4a12-a0bf-ae55fe1b9b0f",
                                                "sense_id": "bd347d18-bd7c-3dbd-8046-53f164dd36e1",
                                                "text": "Yüeh-niang and her sister-wives, all dressed in formal gowns, came out from inside to greet them and ushered them into the rear reception hall"
                                            },
                                            {
                                                "example_id": "0cdcc5d9-2fbd-4433-ba3f-5a084a16520b",
                                                "sense_id": "bd347d18-bd7c-3dbd-8046-53f164dd36e1",
                                                "text": "The concept of 'sisterhood' was popularly applied to the official organizations for Mormon women, and Mormon co-wives were and are still known as 'sister-wives'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
