                "senses": [
                    {
                        "sense_id": "0d9b4bce-7bce-3fca-9a59-d5b491bcb558",
                        "entry_id": "5131cb56-20b6-332f-8606-b666a8fc43cd",
                        "glosses": [
                            "zu erbringende Leistung oder zu tragende Kosten (Aufwand), die zusätzlich erfolgen oder eine gewisse Grenze überschreiten, mehr ausmachen, als gedacht/geplant/normalerweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0db8abe-5bd1-4520-b5c9-888d7a739a7c",
                                "sense_id": "0d9b4bce-7bce-3fca-9a59-d5b491bcb558",
                                "text": "„Der bürokratische Aufwand, um diesen Mehraufwand anhand von Belegen nachzuweisen, ist jedoch unangemessen hoch.“"
                            },
                            {
                                "example_id": "3ab6f477-a928-4548-bfe1-3d510ce38fbc",
                                "sense_id": "0d9b4bce-7bce-3fca-9a59-d5b491bcb558",
                                "text": "„Der Börsengang ist im Hinblick auf die Kommunikation im Vergleich zu derjenigen, die durch die Anleihe erforderlich wurde, mit einem erheblichen Mehraufwand verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
