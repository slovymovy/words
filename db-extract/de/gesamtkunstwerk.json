                ],
                "senses": [
                    {
                        "sense_id": "ffa56780-1d14-3548-8e04-4f9e48e36cfa",
                        "entry_id": "70bfad0c-ba32-3078-a541-b6f395b2e2d8",
                        "glosses": [
                            "Gesamtkunstwerk (artistic creation that encompasses music, theatre and the visual arts; a masterpiece)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c106f5b2-c122-4ad2-b374-2bf21d1139de",
                                "sense_id": "ffa56780-1d14-3548-8e04-4f9e48e36cfa",
                                "text": "Anke Finger, Das Gesamtkunstwerk der Moderne, 2006, 27.\nBegeleitend zu den Symbolisten möchte ich auch die Beziehung zwischen dem Gesamtkunstwerk und der Synästhesie betrachten, die zumindest Elemente des Gesamtkunstwerkverständnisses bis heute prägen.",
                                "translation": "Concomitant with the symbolists I would also like to consider the relation between the Gesamtkunstwerk and synesthaesia, which characterise at least elements of the understanding of the Gesamtkunstwerk to date.",
                                "english": "Concomitant with the symbolists I would also like to consider the relation between the Gesamtkunstwerk and synesthaesia, which characterise at least elements of the understanding of the Gesamtkunstwerk to date."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae9f2d0c-7909-3914-a2c9-9cb51d83f517",
                        "entry_id": "70bfad0c-ba32-3078-a541-b6f395b2e2d8",
                        "glosses": [
                            "a dazzling or flashy personality, particularly one who wears extraordinary clothes, piercings, tattoos, etc."
                        ],
                        "tags": [
                            "humorous",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "dfcf4bd1-0639-428f-92ad-afe34544c6d3",
                                "sense_id": "ae9f2d0c-7909-3914-a2c9-9cb51d83f517",
                                "text": "Peters Mutter mit ihrer Federboa und den anstößigen Witzen ist wirklich ein Gesamtkunstwerk.",
                                "translation": "Peter’s mother with her feather boa and those objectionable jokes is really something else.",
                                "english": "Peter’s mother with her feather boa and those objectionable jokes is really something else."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a196e89-8bf4-372e-9dd8-dd3574a0907e",
                        "entry_id": "70bfad0c-ba32-3078-a541-b6f395b2e2d8",
                        "glosses": [
                            "a place, scene, or idea, often seemingly chaotic, which is implied to have an underlying beauty"
                        ],
                        "tags": [
                            "humorous",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "0628eeab-8606-4c3f-8fb4-b12016d4f755",
                                "sense_id": "3a196e89-8bf4-372e-9dd8-dd3574a0907e",
                                "text": "Mein Arbeitszimmer ist keine Müllhalde, das ist ein Gesamtkunstwerk.",
                                "translation": "My study is not a rubbish dump, it’s a piece of installation art.",
                                "english": "My study is not a rubbish dump, it’s a piece of installation art."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
