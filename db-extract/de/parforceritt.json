                    {
                        "sense_id": "892ecaa9-589a-3864-9eb9-4cc12817f46d",
                        "entry_id": "9d9882f3-10ca-348a-befa-ed022fec049f",
                        "glosses": [
                            "ein mit größten Anstrengungen vollführter Ritt"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "e49a7716-8e99-4ab2-9511-e3e4725d02b0",
                                "sense_id": "892ecaa9-589a-3864-9eb9-4cc12817f46d",
                                "text": "Nach seinem Parforceritt zum Titel-Hattrick wurde der Deutschland-Achter zum Partyboot."
                            },
                            {
                                "example_id": "eea9ad10-68a9-4fdb-9f50-2a71fe8ce93b",
                                "sense_id": "892ecaa9-589a-3864-9eb9-4cc12817f46d",
                                "text": "Solch ein spektakulärer Parforceritt bleibt im Gedächtnis hängen - bei den begeisterten Sportfans und beim Hauptdarsteller sowieso."
                            },
                            {
                                "example_id": "959de9c1-9bd7-4361-a03e-7d7aa52245d9",
                                "sense_id": "892ecaa9-589a-3864-9eb9-4cc12817f46d",
                                "text": "Der erst 19 Jahre alte Schalker Sebastian Ernst lief als Zweiter nur 20,98 Sekunden, sodass er Tobias Unger bei dessen Parforceritt zur neuen Bestmarke von 20,56 Sekunden nie gefährden konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e96e8d8-422d-33bd-8ca9-df1737ff1a2d",
                        "entry_id": "9d9882f3-10ca-348a-befa-ed022fec049f",
                        "glosses": [
                            "mit großer Anstrengung und/oder unter Anspannung aller Kräfte bewältigte Leistung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6486a1-cf5c-46e6-a517-dfc7d62c36fe",
                                "sense_id": "3e96e8d8-422d-33bd-8ca9-df1737ff1a2d",
                                "text": "Merkel hat beim politischen Parforceritt über den Chaos-Parcours der Finanz- und Schuldenkrise einige Hindernisse genommen, andere gerissen und musste etliche Kehrtwenden machen."
                            },
                            {
                                "example_id": "d4569967-c853-4acc-a6e9-9bcdd4f378de",
                                "sense_id": "3e96e8d8-422d-33bd-8ca9-df1737ff1a2d",
                                "text": "Wie recht hatte doch erst vor einigen Wochen der Oberste Datenschützer des Landes Schleswig-Holstein, Thilo Weichert, mit seinem vielfach belächelten, aber auch heftig kritisierten Parforceritt gegen den „Gefällt mir“-Knopf, der direkt in die Datenzentrale von Facebook führt und einen Cookie als Anwort schickt?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
