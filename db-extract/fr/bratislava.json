                        "sense_id": "bbe4ab76-01ef-3dbb-ac09-5ebee325dd78",
                        "entry_id": "595def83-8108-31d8-8c95-3a95fcc5c9aa",
                        "glosses": [
                            "Ville slovaque, capitale de la Slovaquie."
