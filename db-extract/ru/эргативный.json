                                            {
                                                "example_id": "9d32141d-c782-4f83-86d1-88abf44f4b1f",
                                                "sense_id": "ea871601-8cb5-3cf0-a6de-2483128026db",
                                                "text": "Językami ergatywnymi są m.in. język baskijski, berberyjski, kurdyjski, tybetański, większość języków kaukaskich, niektóre języki australijskie."
