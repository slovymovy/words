                    {
                        "translation_id": "171af5dc-de6f-420c-b902-809ce096cbe6",
                        "source_entry_id": "5057ec15-4ba9-3ed4-a3db-c6e964857a2d",
                        "source_sense_id": "42b09bbc-dcc8-3674-8f44-ead4abc337b3",
