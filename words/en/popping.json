                },
                {
                    "sense_id": "ddca1217-2f0f-3a43-bc0c-caad9ff15f80",
                    "sense_definition": "A style of funk dance involving rapid contractions and relaxations of the muscles to switch between poses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been practicing <w>popping</w> and locking for the competition.",
                            "target_lang_translations": {
                                "ru": "Он тренировал <w>паппинг</w> и локинг для соревнований.",
                                "nl": "Hij heeft geoefend op <w>popping</w> en locking voor de wedstrijd."
                            }
                        },
                        {
                            "text": "The street performer drew a crowd with his impressive <w>popping</w> moves.",
                            "target_lang_translations": {
                                "ru": "Уличный артист собрал толпу своими впечатляющими движениями в стиле <w>паппинг</w>.",
                                "nl": "De straatartiest trok een menigte met zijn indrukwekkende <w>popping</w>-bewegingen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "popping and locking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль фанк-танца, основанный на резком сокращении и расслаблении мышц для смены поз.",
                        "nl": "Een funk-dansstijl waarbij spieren snel worden aangespannen en ontspannen om tussen houdingen te wisselen."
                    },
                    "translations": {
