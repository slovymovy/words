                                                "sense_id": "33406fd5-ad00-3cf2-a8dd-75e54cf12680",
                                                "text": "The girls are constantly reshuffled into new permutations in order to feed the J-pop market's insatiable demand for fresh looks and faces."
                                            },
                                            {
                                                "example_id": "976d72fe-5e94-478c-94d0-ac74ef161268",
                                                "sense_id": "33406fd5-ad00-3cf2-a8dd-75e54cf12680",
                                                "text": "She may be declining in popularity, relevance and quality, but Ayumi Hamasaki is still the undisputed Queen of J-Pop, and it will be a long while before anyone can surpass her."
                                            }
                                        ]
                                    }
