                    {
                        "translation_id": "173376ff-7824-4add-a6df-71bb080ab951",
                        "source_entry_id": "747b6c7c-029b-3f9c-8808-64cf76396d8f",
                        "source_sense_id": "abe2f3c0-91ed-3d6a-bb90-ee9d79d75e11",
