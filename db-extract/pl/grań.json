                                "target_senses": [
                                    {
                                        "sense_id": "f06094fc-cfdf-3e13-8e47-0a84276a968e",
                                        "entry_id": "f68df25f-17af-3d31-b2b8-77e800694c3c",
                                        "glosses": [
                                            "A rocky outcrop; a rugged steep cliff or rock."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44bc2b0-0ec9-4757-9231-16779ace71ed",
                                                "sense_id": "f06094fc-cfdf-3e13-8e47-0a84276a968e",
                                                "text": "\"Have, then, thy wish!\"—he whistled shrill, / And he was answered from the hill; / Wild as the scream of the curlieu, / From crag to crag the signal flew."
                                            },
                                            {
                                                "example_id": "095d1e20-ef12-4787-be19-bbc2609cfa66",
                                                "sense_id": "f06094fc-cfdf-3e13-8e47-0a84276a968e",
                                                "text": "Break, break, break, / At the foot of thy crags, O Sea! / But the tender grace of a day that is dead / Will never come back to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea7d029-59e1-3dd9-9568-fff3999f1c53",
                                        "entry_id": "f68df25f-17af-3d31-b2b8-77e800694c3c",
                                        "glosses": [
                                            "A rough, broken fragment of rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05523048-9752-3b44-84e1-5c46637fd293",
                                        "entry_id": "f68df25f-17af-3d31-b2b8-77e800694c3c",
                                        "glosses": [
                                            "A partially compacted bed of gravel mixed with shells, of the Pliocene to Pleistocene epochs."
                                        ],
                                        "tags": [
                                            "countable",
