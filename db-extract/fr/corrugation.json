                                "example_id": "5dfd8226-bdcc-4f2a-b6d8-c50d3b625e49",
                                "sense_id": "b488b7d3-960c-3ffe-bfc6-58a60feb68cc",
                                "text": "Les corrugations de William Thurston permettent d’aboutir au retournement de la sphère."
                            }
                        ]
