                ],
                "senses": [
                    {
                        "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                        "entry_id": "40ceeef4-8419-3902-bb41-bba9ac9a5505",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd8871e-a69b-4111-8193-277fe6883dbb",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Gittels kamen, sahen und siegten."
                            },
                            {
                                "example_id": "225617e8-9581-4d04-bde9-8d1a337c5854",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Frau Gittel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9c7f8d0f-04ac-43b7-a651-840f6cf65430",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Herr Gittel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cf27d7b3-2fba-450f-a90b-cf3d43a1a68d",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Die Gittels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "e4db78ef-b9ab-413f-a4d2-8fda460310b6",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Der Gittel trägt nie die Pullover, die die Gittel ihm strickt."
                            },
                            {
                                "example_id": "de6666e7-d9e0-4683-9c08-6d928a7cf17d",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gittel kommt, geht der Herr Gittel.“"
                            },
                            {
                                "example_id": "03473ba2-be8b-4e66-a9ca-2a9ec7df1aa7",
                                "sense_id": "64c4e517-36d8-3011-806a-37d75ba8489c",
                                "text": "Gittel kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
