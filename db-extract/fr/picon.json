                "senses": [
                    {
                        "sense_id": "e9aff3ac-64ff-30d8-9f3c-78e0a20c3207",
                        "entry_id": "20f63d79-4913-3463-ab90-8ee7163847a1",
                        "glosses": [
                            "Picon, apéritif liquoreux et amer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267c4884-5211-406f-8d2f-e20172db334d",
                                "sense_id": "e9aff3ac-64ff-30d8-9f3c-78e0a20c3207",
                                "text": "Et, pourvu que son verre, qui est grand, s'empourpre de picon ou s'illumine d'absinthe, (…) il n'a cure et peu lui chaut du souper non plus que du gîte."
                            },
                            {
                                "example_id": "73db3776-952a-4c58-a8f6-0049eb8c2e61",
                                "sense_id": "e9aff3ac-64ff-30d8-9f3c-78e0a20c3207",
                                "text": "Les passagers croupissaient, répartis dans l’ombre des entreponts, dans les W.C., au fumoir, par petits groupes soupçonneux et nasillards. Tout ça, bien imbibés de picons, et cancans, du matin au soir."
                            },
                            {
                                "example_id": "c40c672c-c5ea-4159-bcdc-5565d0099d05",
                                "sense_id": "e9aff3ac-64ff-30d8-9f3c-78e0a20c3207",
                                "text": "Le café-crème l’emportait nettement sur les vermouths, picons, vins sucrés ou alcools."
                            },
                            {
                                "example_id": "abd083fd-d3f7-480f-a86f-f2bdbb8ff7c7",
                                "sense_id": "e9aff3ac-64ff-30d8-9f3c-78e0a20c3207",
                                "text": "— Mon fils boira un picon, comme moi ! Ça ne lui fera pas d’mal. C’est une question d’habitude, ça aussi…"
                            }
                        ]
                    }
                ],
