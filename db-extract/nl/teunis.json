                        "source_sense_id": "72c75a3b-2fc8-3bb7-aeed-508ff23300bb",
                        "source_sense_description": "spelwoord voor de letter t",
                        "target_lang_word": "Tommy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
