                                    {
                                        "sense_id": "9e7edf7e-8119-34a7-bbd6-4461efb5d1f3",
                                        "entry_id": "94d38bda-ea82-3254-b2f8-ceb9197cb657",
                                        "glosses": [
                                            "Vice de prononciation, qui consiste notamment à incorrectement prononcer les s, c’est-à-dire à les prononcer en mettant la langue entre les dents, au lieu d’en appliquer le bout sur les dents d’en haut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1136728-75c4-429b-a8df-8fb410ae9245",
                                                "sense_id": "9e7edf7e-8119-34a7-bbd6-4461efb5d1f3",
                                                "text": "Elle affectait la voix basse, les murmures, le susseyement, les soupirs."
                                            }
                                        ]
                                    }
