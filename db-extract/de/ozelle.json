                ],
                "senses": [
                    {
                        "sense_id": "0b1891f3-36c1-31bd-8f48-a2bd257c72a9",
                        "entry_id": "3f391115-332e-38fe-9594-dbabd3ef90f0",
                        "glosses": [
                            "Sinnesorgan niederer Tiere zur Wahrnehmung der Richtung des Lichtes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "175f30e4-3306-4dfa-969f-8570072659f3",
                                "sense_id": "0b1891f3-36c1-31bd-8f48-a2bd257c72a9",
                                "text": "„Die Augen bestehen aus je vier Ozellen nahe der Einlenkung der Fühler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a868287-86c8-3a80-b35d-2c48b521729d",
                        "entry_id": "3f391115-332e-38fe-9594-dbabd3ef90f0",
                        "glosses": [
                            "augenähnliche Zeichnung auf der Körperoberfläche von Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3a5da1-fabc-4954-90b3-eb308fd36c3f",
                                "sense_id": "3a868287-86c8-3a80-b35d-2c48b521729d",
                                "text": "„Die Oberseite der Tiere zeigt ein dunkles grau, der mit unregelmäßig verteilten Ozellen bedeckt ist.“"
                            },
                            {
                                "example_id": "f32645d9-80c8-4798-a8b7-24d487545b00",
                                "sense_id": "3a868287-86c8-3a80-b35d-2c48b521729d",
                                "text": "„Da KULLANDER in seiner Arbeit nur die peruanischen Arten bearbeitet, erwähnt er lediglich, dass Astronotus von anderen Fundorten nur wenige oder gar keine Ozellen in der Rückenflosse zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
