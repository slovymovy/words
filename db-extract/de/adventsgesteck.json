                ],
                "senses": [
                    {
                        "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                        "entry_id": "538ba91f-9c34-3d1b-a834-49344cf620ca",
                        "glosses": [
                            "traditionelles Gesteck aus Nadelbaumzweigen, das im Advent zur Dekoration eingesetzt wird und meist mit vier Kerzen ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ad601b-5356-4f2b-bc43-98566eaa5b2b",
                                "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                                "text": "„Im Anschluss daran werden wieder die traditionellen Adventsgestecke und -kränze verkauft.“"
                            },
                            {
                                "example_id": "fe57edbf-70b9-4847-afac-9c7b1c4f14c3",
                                "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                                "text": "„Beim Betreten des Gebäudes begrüßten winterliche Adventsgestecke die Besucher, frisches Gebäck, dessen Düfte den ganzen Raum erfüllten, wurde einladend präsentiert.“"
                            },
                            {
                                "example_id": "c5901f59-b784-4773-86b0-ce10e78be0f0",
                                "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                                "text": "„Während des Familiensonntages bieten die Frauen im Rahmen eines Basars weihnachtliche Bastelarbeiten und Adventsgestecke zum Verkauf an.“"
                            },
                            {
                                "example_id": "a004142e-93b5-4de3-b7a9-074103a08b3e",
                                "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                                "text": "„In den frühen Morgenstunden in der Nacht auf Samstag hat laut Feuerwehr ein brennendes Adventsgesteck einen Einsatz ausgelöst.“"
                            },
                            {
                                "example_id": "f4fb064e-ae5f-4e88-b24c-45e966a05d2d",
                                "sense_id": "67bc4a67-9b9f-320e-83f2-e42cf8404c71",
                                "text": "„Das Feuer wurde vermutlich durch ein brennendes Adventsgesteck ausgelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
