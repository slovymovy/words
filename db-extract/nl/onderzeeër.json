                                        "glosses": [
                                            "Being, relating to, or made for use underwater, especially beneath the sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a01f5a13-aac8-41b3-aaee-a57a47d39452",
                                                "sense_id": "1c83c30a-45a1-329d-bb58-a6e82914871e",
                                                "text": "Near-synonym: submerged (synonymous in \"being underwater\" sense)"
                                            },
                                            {
                                                "example_id": "813d618b-553b-415a-a668-3756a0d0e18b",
                                                "sense_id": "1c83c30a-45a1-329d-bb58-a6e82914871e",
                                                "text": "[…] a Chorus of Sea-nymphs, who[…] arrive, in a winged car, from the submarine palace of their father Oceanus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3343b1b2-fff2-3055-8acf-9a4cb61b31c4",
                                        "entry_id": "0928731b-b5c8-3229-b36f-80a12ff62ec6",
                                        "glosses": [
                                            "Hidden or undisclosed."
                                        ],
                                        "tags": [
                                            "not-comparable"
