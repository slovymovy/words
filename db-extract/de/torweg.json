                "senses": [
                    {
                        "sense_id": "f16ce7d8-041f-334b-a54f-ce735c4db566",
                        "entry_id": "0d5d6aca-4d93-3e31-9bdc-fb3311f8b097",
                        "glosses": [
                            "Weg, auf dem man ein Tor passieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6b354b-5644-4dd8-b426-00135e3ecf30",
                                "sense_id": "f16ce7d8-041f-334b-a54f-ce735c4db566",
                                "text": "„Aus den Torwegen kamen überall Wagen, bis oben hin mit Haus- und Küchengeräten beladen, und fuhren durch die Strassen.“"
                            },
                            {
                                "example_id": "efa60234-ec78-41b4-bada-b1924ec37f54",
                                "sense_id": "f16ce7d8-041f-334b-a54f-ce735c4db566",
                                "text": "„Aus einem Torweg kam ein Briefträger .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bdee47c-a3a3-4854-8df5-0e6fa6a1cb8b",
                        "source_entry_id": "0d5d6aca-4d93-3e31-9bdc-fb3311f8b097",
                        "source_sense_id": "f16ce7d8-041f-334b-a54f-ce735c4db566",
                        "source_sense_description": "Weg, auf dem man ein Tor passieren kann",
                        "target_lang_word": "gateway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gateway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3432446b-cb47-3d4b-acd2-1c40c29530cd",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "A passage that can be closed by use of a gate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55a4b72-e4c3-4f91-8101-edf4bcaef631",
                                                "sense_id": "3432446b-cb47-3d4b-acd2-1c40c29530cd",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0163c92-536b-3a95-ab13-543f415a6185",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "A place regarded as giving access to somewhere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50f8b78-33a2-431b-9919-0f2d7c10c9cd",
                                                "sense_id": "a0163c92-536b-3a95-ab13-543f415a6185",
                                                "text": "The staff offer a touch of Norfolk courtesy as they guide passengers onto connecting services. The bustling concourse has a wide selection of information and retail, including a very active city tourism presence. This station now feels like a real gateway to Norwich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2428fb-230c-3681-9b5e-f14750d367aa",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "Any point that represents the beginning of a transition from one place or phase to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d136b22-026d-3e41-adf9-690aaaf9a1ad",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "Any point that represents the beginning of a transition from one place or phase to another.",
                                            "Any thing or area of interest that tends to lead to deeper involvement."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e1122d9-6632-4737-9fcf-8c8352000b1b",
                                                "sense_id": "3d136b22-026d-3e41-adf9-690aaaf9a1ad",
                                                "text": "a gateway drug"
                                            },
                                            {
                                                "example_id": "c8b0e111-2e49-4cd0-9b30-cdaeffa3e9e9",
                                                "sense_id": "3d136b22-026d-3e41-adf9-690aaaf9a1ad",
                                                "text": "Just as they say that marijuana leads to harder drugs, Gallegly is claiming that crush is a “gateway fetish”—a term I've never heard before. He claims that if someone starts with bugs they'll end up escalating to human babies in no time."
                                            },
                                            {
                                                "example_id": "add1503e-b5f7-4a43-9d5c-86838fe7ba28",
                                                "sense_id": "3d136b22-026d-3e41-adf9-690aaaf9a1ad",
                                                "text": "According to Mellody, love addiction is a gateway addiction leading to additional addictions: to sex, food, drugs, alcohol, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c96f0b6-a820-30a3-8222-bb1dbb5d61d9",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "A point at which freight moving from one territory to another is interchanged between transportation lines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44bc6cc4-459d-3a63-96d4-0c47eb5a657e",
                                        "entry_id": "537eeaa4-982c-399f-b269-c1c808a13f01",
                                        "glosses": [
                                            "In wireless internet, an access point with additional software capabilities such as providing NAT and DHCP, which may also provide VPN support, roaming, firewalls, various levels of security, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
