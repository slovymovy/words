                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                        "entry_id": "e2c1c764-40ba-3f06-8418-bc9f015b8343",
                        "glosses": [
                            "qualitativ minderwertiges Getränk"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "da8c8594-46e3-43ff-b886-3d94b1872a8e",
                                "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                                "text": "Was ist denn das für ein Gesöff?"
                            },
                            {
                                "example_id": "0607d7a4-72f1-496d-8d90-a3b8da5cdb9d",
                                "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                                "text": "„Dieses Gesöff war natürlich der Grund für meinen ausgewachsenen Kater.“"
                            },
                            {
                                "example_id": "c82b78ce-b6ec-476a-b30c-887a6dcefa1d",
                                "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                                "text": "„Er stand auf und goss sich noch was von seinem Gesöff nach.“"
                            },
                            {
                                "example_id": "607d991b-ab17-4d34-8532-53c9152b210a",
                                "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                                "text": "„Er trank das barbarisch scharfe Gesöff und konnte trotzdem nicht von den Augen am Spieltisch loskommen.“"
                            },
                            {
                                "example_id": "a7fa21e1-fc49-4786-875f-6ee965f04bed",
                                "sense_id": "29b41604-a05c-3aa0-85a9-99644a6d133b",
                                "text": "„Kanther fingerte aus seiner Manteltasche einen Flachmann hervor und nahm einen kräftigen Schluck von einem Gesöff, das verdächtig nach Absinth roch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
