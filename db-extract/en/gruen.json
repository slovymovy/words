                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b69147-432f-43b3-a890-841dba42689a",
                                                "sense_id": "d8b3a287-b887-3db5-a70c-0a93ebb3d7b9",
                                                "text": "Rot und Grün wollen bald Koalitionsverhandlungen aufnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "da82bdde-8ce4-3b33-9284-160f853011c3",
