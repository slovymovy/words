                        "glosses": [
                            "Drüse, in der Keimzellen und Geschlechtshormone gebildet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce781d9-ca72-4101-9632-a52befd84649",
                                "sense_id": "d77d27ba-0bc5-35d7-8b4d-7459496d8427",
                                "text": "„Gesucht wird das ideale Medikament, das sich wie das natürliche Östrogen Estradiol positiv auf Blutgefäße, Knochengewebe, Fett- und Gehirnstoffwechsel auswirkt, aber gleichzeitig Keimdrüsen und Brustgewebe in Ruhe läßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "550ed1bf-2350-452c-a7fe-20e46ac5ac44",
                        "source_entry_id": "2d462d7c-6676-3045-afca-795ba7bd422b",
                        "source_sense_id": "d77d27ba-0bc5-35d7-8b4d-7459496d8427",
                        "source_sense_description": "Anatomie: Drüse, in der Keimzellen und Geschlechtshormone gebildet werden",
                        "target_lang_word": "gonad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0304378c-fff5-3c8e-b2d1-d19191171256",
                                        "entry_id": "bf860fb8-89ae-374b-9013-09c21fa21a16",
                                        "glosses": [
                                            "A sex organ that produces gametes; specifically, a testicle or ovary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca938c5f-0fdb-408b-9eec-33325ad62d1b",
                                                "sense_id": "0304378c-fff5-3c8e-b2d1-d19191171256",
                                                "text": "The shape of his gonads must set the ambit of his emotions? No. […] What Bart feels like is mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8b1df83-5c57-340b-8387-196b0ada1309",
