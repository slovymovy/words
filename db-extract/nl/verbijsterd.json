                        "target_lang_word": "éberlué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éberlué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "689b6598-3e64-33e1-ac87-07beb293187b",
                                        "entry_id": "2af1ec5c-22aa-3d2c-9c14-1ed9054abbfa",
                                        "glosses": [
                                            "Étonné fortement, surpris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81516d7-2a01-4250-948e-12b843953596",
                                                "sense_id": "689b6598-3e64-33e1-ac87-07beb293187b",
                                                "text": "– Veux-tu me promettre de répondre oui à la question que je vais te poser ?\n– Non, fit Joseph éberlué. C’est-à-dire que cela dépend."
                                            },
                                            {
                                                "example_id": "fefb6c38-fe55-48f5-8ac4-de1819c14d62",
                                                "sense_id": "689b6598-3e64-33e1-ac87-07beb293187b",
                                                "text": "Le mot « mariage » explosa dans ma tête, et je fus plus éberluée que le jour où, en pleine classe, une camarade s’était mise à aboyer."
                                            },
                                            {
                                                "example_id": "cb24a245-fc5f-4652-a490-5b43a2002a5a",
                                                "sense_id": "689b6598-3e64-33e1-ac87-07beb293187b",
                                                "text": "Elle avait voulu profiter de ses vacances pour pénétrer dans l’intimité d’une famille française : elle en était éberluée."
                                            }
                                        ]
                                    }
                                ]
                            },
