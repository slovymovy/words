                        "entry_id": "0f1fc423-9f67-3b70-bd9e-575b9e7d821f",
                        "glosses": [
                            "Action de dynamiser, de rendre dynamique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2fb09d-46c9-41c9-83f4-6beafb3a3885",
                                "sense_id": "5e207552-b797-3ae7-8807-0ab320d90487",
                                "text": "Un programme pour assurer le développement et la dynamisation des ressources humaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb730414-8472-3c4b-984f-74e06edfd4ec",
                        "entry_id": "0f1fc423-9f67-3b70-bd9e-575b9e7d821f",
                        "glosses": [
                            "(Homéopathie) Agitation d’une substance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9da183b-1c15-47e6-93f7-c5d6969e14e9",
                                "sense_id": "cb730414-8472-3c4b-984f-74e06edfd4ec",
                                "text": "Lors de l’élaboration d’un médicament homéopathique, la substance de base est diluée dans un solvant neutre, généralement l’eau, au centième. Le produit est alors fortement agité : c’est la dynamisation."
                            },
                            {
                                "example_id": "fac64743-c72b-4186-9faa-45e22e8aaa7b",
                                "sense_id": "cb730414-8472-3c4b-984f-74e06edfd4ec",
                                "text": "La réponse se trouve dans un troisième principe relié bien sûr à la dilution : la dynamisation, appelée également succussion, qui consiste à secouer vigoureusement chaque nouvelle dilution."
                            }
                        ]
                    }
                ],
