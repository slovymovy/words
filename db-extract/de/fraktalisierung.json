                "senses": [
                    {
                        "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                        "entry_id": "47760a12-c942-3239-9596-b9321647d8de",
                        "glosses": [
                            "Herunterbrechung/Spaltung/Aufteilung in Teile/Teilbereiche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61063d1e-318d-444d-813e-7ad45b1e9648",
                                "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                                "text": "„Zum einen sind es Folgen der globalisierten Wirtschaft und die parallel dazu auftretende Fraktalisierung der Gesellschaft, die neue Definitionen des Sozialstaatsbegriffs fordern.“"
                            },
                            {
                                "example_id": "9ab92db7-1ac4-48ab-b2cb-423bf847c390",
                                "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                                "text": "„Manche Interpreten sprechen von Fraktalisierungen und einer dadurch entstehenden uneinholbaren Offenheit ([…]).“"
                            },
                            {
                                "example_id": "9f7fc3b9-1a6a-45b8-9859-375c6c3b303f",
                                "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                                "text": "„Wie können die Automobilhersteller in einer Zeit der Fraktalisierung des Marktes, der Vermischung der Konzepte und der dauernden Innovation noch eine Produktplanung absichern?“"
                            },
                            {
                                "example_id": "299b61f1-7bfe-40ba-868c-2547b93ba76d",
                                "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                                "text": "„Die Fraktalisierung des Selbst findet ihren unmittelbaren Ausdruck in den Möglichkeiten des Klonens und der Vorstellung einer identischen Replikation von Menschen mit all ihren Konsequenzen für Subjektivität, Originalität und Integrität des Seins.“"
                            },
                            {
                                "example_id": "0a13d9ca-ba0f-4954-afe8-8859131a962c",
                                "sense_id": "2bf7b77f-47e4-3635-adc3-f1a21e3938c6",
                                "text": "„Diese Fraktalisierung ist genauso ungewöhnlich wie die Degradierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9aef2ea0-674e-33f3-9aa0-d9cac104e571",
                        "entry_id": "47760a12-c942-3239-9596-b9321647d8de",
                        "glosses": [
                            "Aufteilung größerer Aufgaben in strukturell ähnliche kleinere Ziele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b3e68f-8ace-4231-8f03-f450f04c3a4f",
                                "sense_id": "9aef2ea0-674e-33f3-9aa0-d9cac104e571",
                                "text": "„Die Fraktalisierung soll bis zur Ebene der Mitarbeiter fortgesetzt werden, so daß letztendlich jeder Arbeitsplatz als eigenständiges Unternehmen betrachtet wird.“"
                            },
                            {
                                "example_id": "d1e56e5c-53e4-4fb5-bcd6-7ca28ae0ff0e",
                                "sense_id": "9aef2ea0-674e-33f3-9aa0-d9cac104e571",
                                "text": "„So sind die Organisationsformen der marktnahen und kundenspezifischen Modularisierung oder Fraktalisierung wichtige Konzepte der 90er Jahre, die es erlauben sollen, schnell auf Marktänderungen und Kundenwünsche organisatorisch zu reagieren […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
