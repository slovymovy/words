{
    "word_family": [
        "wrathful",
        "wrathfully",
        "wrathfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3877bfc9-b2c3-3d91-b4ab-6dae4f6c478c",
                    "sense_definition": "Extreme, intense, or violent anger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "anger_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens feared the <w>wrath</w> of the ruthless dictator.",
                            "target_lang_translations": {
                                "ru": "Граждане боялись <w>гнева</w> безжалостного диктатора.",
                                "de": "Die Bürger fürchteten den <w>Zorn</w> des rücksichtslosen Diktators."
                            }
                        },
                        {
                            "text": "She tried to avoid her boss's <w>wrath</w> by finishing the project ahead of schedule.",
                            "target_lang_translations": {
                                "ru": "Она пыталась избежать <w>гнева</w> начальника, закончив проект раньше срока.",
                                "de": "Sie versuchte, den <w>Zorn</w> ihres Chefs zu vermeiden, indem sie das Projekt vorzeitig abschloss."
                            }
                        }
                    ],
                    "synonyms": [
                        "fury",
                        "rage",
                        "ire",
                        "indignation"
                    ],
                    "antonyms": [
                        "calm",
                        "delight",
                        "pleasure"
                    ],
                    "common_phrases": [
                        "incur the wrath",
                        "face the wrath",
                        "wrath of God"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, глубокий или яростный гнев.",
                        "de": "Ein extrem starkes, intensives oder gewaltsames Gefühl von Wut."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнев",
                                "target_lang_sense_clarification": "сильное чувство возмущения"
                            },
                            {
                                "target_lang_word": "ярость",
                                "target_lang_sense_clarification": "крайняя степень гнева, бешенство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zorn",
                                "target_lang_sense_clarification": "starkes, heftiges Gefühl von Wut, oft tiefsitzend"
                            },
                            {
                                "target_lang_word": "Wut",
                                "target_lang_sense_clarification": "starke emotionale Erregung, oft mit aggressivem Verhalten verbunden"
                            },
                            {
                                "target_lang_word": "Ingrimm",
                                "target_lang_sense_clarification": "literarischer Begriff für unterdrückten, grollenden Zorn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95c7f859-6654-35d3-a764-764c9f887f91",
                    "sense_definition": "Punishment or vengeance inflicted as a result of anger, especially divine punishment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anger_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes the <w>wrath</w> visited upon the wicked city.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает <w>кару</w>, обрушившуюся на нечестивый город.",
                                "de": "Der alte Text beschreibt die <w>Vergeltung</w>, die über die gottlose Stadt hereinbrach."
                            }
                        },
                        {
                            "text": "He believed his misfortune was the <w>wrath</w> of the heavens for his past mistakes.",
                            "target_lang_translations": {
                                "ru": "Он верил, что его несчастье было <w>гневом</w> небес за его прошлые ошибки.",
                                "de": "Er glaubte, sein Unglück sei der <w>Zorn</w> des Himmels für seine vergangenen Fehler."
                            }
                        }
                    ],
                    "antonyms": [
                        "mercy",
                        "forgiveness"
                    ],
                    "common_phrases": [
                        "divine wrath",
                        "day of wrath"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        },
                        {
                            "trait_type": "form",
                            "comment": "religious"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказание или возмездие как следствие гнева, особенно божественное наказание.",
                        "de": "Eine Strafe oder Vergeltung, die als Folge von Zorn zugefügt wird, insbesondere im religiösen Kontext."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "кара за причиненное зло"
                            },
                            {
                                "target_lang_word": "кара",
                                "target_lang_sense_clarification": "суровое наказание, часто свыше"
                            },
                            {
                                "target_lang_word": "гнев",
                                "target_lang_sense_clarification": "в значении божественного наказания"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vergeltung",
                                "target_lang_sense_clarification": "Strafe oder Genugtuung für eine Handlung"
                            },
                            {
                                "target_lang_word": "Gottes Zorn",
                                "target_lang_sense_clarification": "spezifisch für göttliche Strafe"
                            },
                            {
                                "target_lang_word": "Strafe",
                                "target_lang_sense_clarification": "allgemeiner Begriff für eine Sanktion"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f62e14ad-94fa-3b47-bde0-6021c3a12d1d",
                    "sense_definition": "Full of anger; extremely angry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "angry_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wrath</w> king demanded to know who had stolen his crown.",
                            "target_lang_translations": {
                                "ru": "<w>Разгневанный</w> король потребовал узнать, кто украл его корону.",
                                "de": "Der <w>zornige</w> König verlangte zu wissen, wer seine Krone gestohlen hatte."
                            }
                        },
                        {
                            "text": "He was <w>wrath</w> to see his commands ignored by the soldiers.",
                            "target_lang_translations": {
                                "ru": "Он был <w>разгневан</w>, увидев, что солдаты игнорируют его приказы.",
                                "de": "Er war <w>erzürnt</w>, als er sah, dass seine Befehle von den Soldaten ignoriert wurden."
                            }
                        }
                    ],
                    "synonyms": [
                        "wroth"
                    ],
                    "antonyms": [
                        "calm",
                        "pleased"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный гнева; крайне разгневанный (устаревшее).",
                        "de": "Voll von Zorn; extrem wütend (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгневанный",
                                "target_lang_sense_clarification": "охваченный гневом"
                            },
                            {
                                "target_lang_word": "яростный",
                                "target_lang_sense_clarification": "полный ярости"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zornig",
                                "target_lang_sense_clarification": "von Zorn erfüllt"
                            },
                            {
                                "target_lang_word": "wütend",
                                "target_lang_sense_clarification": "in einem Zustand von Wut"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b69dfc3f-e16c-3095-a500-2911c44a8b84",
                    "sense_definition": "To make someone angry or to become angry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anger_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>wrath</w> him, for he has a terrible temper.",
                            "target_lang_translations": {
                                "ru": "Не <w>гневи</w> его, ибо у него ужасный характер.",
                                "de": "Versuche nicht, ihn zu <w>erzürnen</w>, denn er hat ein schreckliches Temperament."
                            }
                        },
                        {
                            "text": "The knight <w>wrathed</w> at the insult to his honor.",
                            "target_lang_translations": {
                                "ru": "Рыцарь <w>разгневался</w> из-за оскорбления его чести.",
                                "de": "Der Ritter <w>geriet in Zorn</w> über die Beleidigung seiner Ehre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злить кого-то или самому приходить в ярость (устаревшее).",
                        "de": "Jemanden wütend machen oder selbst in Zorn geraten (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гневить",
                                "target_lang_sense_clarification": "приводить в гнев"
                            },
                            {
                                "target_lang_word": "разгневаться",
                                "target_lang_sense_clarification": "прийти в состояние гнева"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erzürnen",
                                "target_lang_sense_clarification": "jemanden in Zorn versetzen"
                            },
                            {
                                "target_lang_word": "in Zorn geraten",
                                "target_lang_sense_clarification": "selbst wütend werden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}