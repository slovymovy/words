                    }
                ],
                "senses": [
                    {
                        "sense_id": "842c466c-95bc-373c-9600-307f6bf63b4b",
                        "entry_id": "922a4935-3f52-313c-b606-7a3f31268581",
                        "glosses": [
                            "Se tuer l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b43f79-ea31-4721-a937-c40da557f392",
                                "sense_id": "842c466c-95bc-373c-9600-307f6bf63b4b",
                                "text": "Épargnons notre poudre et nos balles. Ces bêtes-là jouent un jeu à s’entre-tuer, et nous arriverons toujours à temps pour relever les vaincus."
                            },
                            {
                                "example_id": "16c9fb45-4376-420e-95bd-6bb2bc40283e",
                                "sense_id": "842c466c-95bc-373c-9600-307f6bf63b4b",
                                "text": "Les hommes anéantissent leur civilisation avant de l’avoir achevée. Partout ils se battent et s’exterminent, partout ! Jusque dans l’Amérique du Sud, on s’entre-tue."
                            },
                            {
                                "example_id": "6f51a183-5669-4339-a150-69078ad440d8",
                                "sense_id": "842c466c-95bc-373c-9600-307f6bf63b4b",
                                "text": "Cependant, s’entre-tuer ne peut pas être la principale occupation de la vie. La gloire de notre civilisation est de nous mettre en état de vivre presque normalement, quelquefois."
                            }
                        ]
                    }
                ],
