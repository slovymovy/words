                "senses": [
                    {
                        "sense_id": "22312bfc-ad53-3eda-a205-df736b6922a9",
                        "entry_id": "89e5eaa0-6367-3796-9bee-118fed2fedc1",
                        "glosses": [
                            "Handwerker, der lüftungstechnischen Anlagen eines Gebäudes, installiert, anschließt, repariert"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "6357e45e-53a5-4dab-b0ec-f23bf36a238b",
                                "sense_id": "22312bfc-ad53-3eda-a205-df736b6922a9",
                                "text": "Der Lüftungsinstallateur montiert die Brandschutzklappe laut Herstellerangabe."
                            },
                            {
                                "example_id": "e6d044b6-f477-42fc-b8a9-6e8f3339d997",
                                "sense_id": "22312bfc-ad53-3eda-a205-df736b6922a9",
                                "text": "Die Lüftungsinstallateure installieren auf der Baustelle alle Lüftungskomponenten laut der vorliegenden Lüftungszeichnung."
                            },
                            {
                                "example_id": "7b858d7e-f9db-4e58-b341-31fab81b3534",
                                "sense_id": "22312bfc-ad53-3eda-a205-df736b6922a9",
                                "text": "Der Lüftungsingenieur erteilte auf der Baubesprechung den Lüftungsmonteuren klare Anweisungen, zum Bauzeitenplan und dem Fertigstellungstermin."
                            },
                            {
                                "example_id": "7a466d1c-7f2e-4226-b7fb-b35998fcfb09",
                                "sense_id": "22312bfc-ad53-3eda-a205-df736b6922a9",
                                "text": "Es ist die Aufgabe des Lüftungsinstallateurs alle Lüftungskomponenten Sach- und Fachgerecht zu montieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
