                "senses": [
                    {
                        "sense_id": "3d4ed0a1-ade6-3168-8d70-6a61a724f4af",
                        "entry_id": "e780ee6f-9324-30dd-99ab-7bcf1e198e08",
                        "glosses": [
                            "menschlicher Held oder Gottheit, der die Erfindung oder Übermittlung einer wesentlichen Kulturtechnik zugeschrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7fdddb6-4d71-4b76-94c1-c8eb0e956e31",
                                "sense_id": "3d4ed0a1-ade6-3168-8d70-6a61a724f4af",
                                "text": "„Wenn sie beschlossen, dass der Name des Mannes nicht Huemac war, ein Kulturheros, der in zahlreichen Geschichten vorkam, sondern Quetzalcoatl, wie der ehemalige Lehrer Fray Toribio als Erster vorschlug, dann funktionierte die Geschichte perfekt, da eines der vielen Jahressymbole, die mit dem Gott Quetzalcoatl in Verbindung gebracht wurden, dem Jahr 1519 entsprach.“"
                            },
                            {
                                "example_id": "f7d33ed4-0ce7-4487-8817-3c9be4a3aea1",
                                "sense_id": "3d4ed0a1-ade6-3168-8d70-6a61a724f4af",
                                "text": "„Dynastische und kulturelle Traditionen der Azteken wurden vornehmlich als Helden- und Klagelieder im kulturellen Gedächtnis verankert, vergleichbar den babylonischen Überlieferungen über den Kulturheros Gilgamesch und den altgriechischen Versdichtungen der Ilias und Odyssee über den Trojanischen Krieg.“"
                            },
                            {
                                "example_id": "3a5fc587-6f24-49fc-8739-77435bf60bb2",
                                "sense_id": "3d4ed0a1-ade6-3168-8d70-6a61a724f4af",
                                "text": "„So konnte man in den Chilam Balam-Prophezeiungen lesen, dass es eine Invasion bärtiger Fremder geben werde, die vielleicht Abgesandte des Kulturheros Kukulkaan, der gefiederten Schlange, seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47e4fb6f-b9a3-4da7-b50a-0efca8579adc",
                        "source_entry_id": "e780ee6f-9324-30dd-99ab-7bcf1e198e08",
