                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c658392d-7a1d-4196-8b0b-2445a7c8ff66",
                                "sense_id": "ba56d8d2-2654-3c65-9e13-02730e821964",
                                "text": "Proboszcz przypomniał akolicie, iż w monstrancji brakowało lunuli."
                            },
                            {
                                "example_id": "5f0a5e4f-c017-4285-9884-f0e9b8179da0",
                                "sense_id": "ba56d8d2-2654-3c65-9e13-02730e821964",
                                "text": "Parafianie ofiarowali kościołowi pięknie zdobioną, pozłacaną lunulę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "76a8b67b-b3ab-3d66-9735-1cc5d4627f97",
                        "entry_id": "954102e1-7ed7-3cbc-ae49-29e1f42b88c2",
                        "glosses": [
                            "noszona na szyi szczególnie w starożytności i w średniowieczu ozdoba w kształcie półksiężyca, symbol płodności"
                        ],
                        "tags": [],
                        "examples": [
