                                        "glosses": [
                                            "Courant électrique caractérisé par un changement de sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca65a5d-68b6-4a27-9c37-1e4ab7463dac",
                                                "sense_id": "7fad023c-1a33-339a-96a5-afc9ae9f079b",
                                                "text": "Un générateur hydroélectrique produit un courant alternatif à tension adaptée à sa puissance. Sur les petites productions, il peut s'agir du 220V monophasé mais plus souvent du triphasé 380 V."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a02ca67-fdd1-37da-b05f-95028963cd8d",
                                        "entry_id": "60f06883-8391-30b9-adb2-3936fdab0058",
                                        "glosses": [
                                            "Électricité domestique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99d15b9e-29b9-443e-bda3-15c99eab9be2",
                                                "sense_id": "0a02ca67-fdd1-37da-b05f-95028963cd8d",
                                                "text": "C’est à Nikola Tesla que nous devons le courant alternatif, cette forme de transmission de l’électricité qui est utilisée partout pour faire fonctionner les multiples appareils qui nécessitent un branchement."
                                            }
