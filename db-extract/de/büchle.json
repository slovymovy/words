                ],
                "senses": [
                    {
                        "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                        "entry_id": "189636b0-f36c-3b89-ae44-cf7b1fa4c9aa",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe73e329-39b3-414c-92a6-bddedded5743",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Die Büchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "2c3a435d-08cc-43e0-b265-4f558792d229",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Frau Büchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9c26421d-25f7-4156-91fa-0f6f736db744",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Herr Büchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aa851653-7369-4e2a-b242-1d1cae276fed",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Der Büchle trägt nie die Pullover, die die Büchle ihm strickt."
                            },
                            {
                                "example_id": "b9050c78-6c79-4796-a93f-e6825e606de3",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Büchle kommt, geht der Herr Büchle.“"
                            },
                            {
                                "example_id": "c405c9fc-d771-4b70-b4c6-53c8cf85137a",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Büchle kommt und geht."
                            },
                            {
                                "example_id": "db3f7cb2-4055-4bf9-955a-12051e5dc5c9",
                                "sense_id": "aa6b568c-c653-37a2-950d-cfde6d37dfbd",
                                "text": "Büchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
