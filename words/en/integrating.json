{
    "word_family": [
        "integration",
        "integrator",
        "integral",
        "integrate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ca3fde1-b3a4-3823-b945-a6cbb58ca27c",
                    "sense_definition": "present participle and gerund of <w>integrate</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>integrating</w> new software into their daily workflow.",
                            "target_lang_translations": {
                                "zh": "公司正在将新软件<w>整合</w>到日常工作流程中。"
                            }
                        },
                        {
                            "text": "We are <w>integrating</w> different departments to improve communication.",
                            "target_lang_translations": {
                                "zh": "我们正在<w>整合</w>不同的部门以改善沟通。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "integrating systems",
                        "integrating technology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指将不同部分组合或合并成一个整体的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "整合",
                                "target_lang_sense_clarification": "指将分散的事物或部门合并，使其成为一个统一的整体。"
                            },
                            {
                                "target_lang_word": "集成",
                                "target_lang_sense_clarification": "常用于技术、系统或软件领域，指将多个组件结合在一起。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e66adec-1764-36fa-954b-16acfd8a4fc8",
                    "sense_definition": "Serving to combine or unite separate parts into a whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>integrating</w> mechanism ensures all components work together seamlessly.",
                            "target_lang_translations": {
                                "zh": "这种<w>整合性</w>机制确保了所有组件能够无缝协作。"
                            }
                        },
                        {
                            "text": "They developed an <w>integrating</w> strategy to unify the diverse team members.",
                            "target_lang_translations": {
                                "zh": "他们制定了一项<w>整合性</w>策略来统一多元化的团队成员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unifying",
                        "coordinating"
                    ],
                    "antonyms": [
                        "dividing",
                        "separating"
                    ],
                    "common_phrases": [
                        "integrating mechanism",
                        "integrating strategy"
                    ],
                    "target_lang_definitions": {
                        "zh": "起结合或统一作用的，用于将独立部分汇聚成整体的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "整合性的",
                                "target_lang_sense_clarification": "形容具有将不同部分统一起来的功能或性质。"
                            },
                            {
                                "target_lang_word": "统一的",
                                "target_lang_sense_clarification": "强调使各部分协调一致，形成一个整体。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}