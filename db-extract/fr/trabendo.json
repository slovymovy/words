                        "glosses": [
                            "Petit trafic commercial."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "eb33e1b1-9aca-4779-8f1a-164166f667f2",
                                "sense_id": "7a926508-7fb0-3863-9c67-9554680ed251",
                                "text": "— Je faisais un peu de trabendo, j'avais plusieurs cartouches de clopes algériennes à écouler."
                            },
                            {
                                "example_id": "a6a3fb7a-6a87-483a-b756-3694a2c79b08",
                                "sense_id": "7a926508-7fb0-3863-9c67-9554680ed251",
                                "text": "[…] ils ne supportent pas le sous-développement du pays lors de leur séjour estival, mais de l’autre côté ils contribuent matériellement à l’essor du trabendo qui affaiblit toutes les initiatives d’émancipation nationale."
                            },
                            {
                                "example_id": "0f90a338-59e1-4400-ad75-75cb7c3b3f89",
                                "sense_id": "7a926508-7fb0-3863-9c67-9554680ed251",
                                "text": "Le trabendo mafieux ne peut pas fonctionner sans la complicité active et grassement rétribuée de certains responsables."
                            },
                            {
                                "example_id": "66f8b06b-5409-496d-8973-b719c848e34a",
                                "sense_id": "7a926508-7fb0-3863-9c67-9554680ed251",
                                "text": "Ali et moi déambulons sous le tablier du métro aérien qui abrite, entre les étals du marché, les bicraves, les petits trafics du trabendo, […]."
                            }
                        ]
                    }
