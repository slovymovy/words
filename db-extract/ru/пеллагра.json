                        "cross_references": [
                            {
                                "target_word": "pellagra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "278dd865-71ef-3ecf-aff6-e69f77c46b0b",
                                        "entry_id": "59d4601a-2d07-32e6-8014-de1ca7c1cab2",
                                        "glosses": [
                                            "A disease characterised by skin lesions and mental confusion, primarily caused by a niacin deficiency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c706a73c-cd17-4f02-80eb-d20b7ac80247",
                                                "sense_id": "278dd865-71ef-3ecf-aff6-e69f77c46b0b",
                                                "text": "In 1755 the French physician Gaspar Casal (1680–1759) published an account of pellagra, then a new disease in Spain."
                                            },
                                            {
                                                "example_id": "40d63148-a91e-4c00-9913-faba0b3613ec",
                                                "sense_id": "278dd865-71ef-3ecf-aff6-e69f77c46b0b",
                                                "text": "Mixing the alkali into the recipe in the right way chemically releases the otherwise unavailable niacin in the corn, which stops pellagra in its tracks, and allowed corn-based agricultural populations to grow and spread."
                                            }
                                        ]
                                    }
