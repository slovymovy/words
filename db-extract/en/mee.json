            {
                "entry_id": "5cd8c6a4-b65a-398b-9aa6-a556f96f5d79",
                "word": "mee",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "609c83c4-ab19-4a42-9c39-cc257d8c34bf",
