                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddce8443-cc68-4016-95ca-21542eb8de68",
                                                "sense_id": "f83997e3-fbce-30b5-9de7-a13107c721fd",
                                                "text": "To prevent spoilage, store in a cool, dry place."
                                            }
                                        ]
