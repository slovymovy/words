                        "glosses": [
                            "iemand die tijdens verkiezingen door de stemgerechtigden verkozen is voor een functie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb44921-8576-452d-a729-7a66703ca5f1",
                                "sense_id": "0d298681-f4a2-3c36-b884-58caac370c83",
                                "text": "De gemeente Wierden heeft de lijst met de gekozen raadsleden bekendgemaakt. Eén gekozene laat zondermeer verstek gaan. Herman Pluimers (CDA, Enter) heeft al voor de verkiezingen aangegeven alleen als wethouder beschikbaar te zijn. Zijn plaats wordt ingenomen door Johan ter Beke."
                            },
                            {
                                "example_id": "c3c84e4e-af38-4382-9112-66b23d2fc982",
                                "sense_id": "0d298681-f4a2-3c36-b884-58caac370c83",
                                "text": "Paus Gegorius X kwam aan de macht en regeerde nog geen 5 jaar. Bij de verkiezing van zijn opvolger waren de kardinalen er binnen enkele dagen uit, maar zij moesten zich al snel weer naar Rome reppen, omdat de gekozene, Innocentius V, al na een half jaar bezweek."
                            }
                        ]
                    }
