{
    "word_family": [
        "rigidité",
        "rigidifier",
        "rigidification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a053cd8-b123-3a64-9d44-541cb313d26e",
                    "sense_definition": "Qui ne plie pas facilement et résiste aux déformations mécaniques.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour construire cette étagère solide, il faut utiliser un panneau bien <w>rigide</w>."
                        },
                        {
                            "text": "Cette boîte en plastique <w>rigide</w> protège efficacement le matériel fragile pendant le transport."
                        }
                    ],
                    "synonyms": [
                        "raide",
                        "ferme"
                    ],
                    "antonyms": [
                        "flexible",
                        "souple"
                    ],
                    "common_phrases": [
                        "matériau rigide",
                        "boîte rigide"
                    ]
                },
                {
                    "sense_id": "2c7c1be6-eb46-35a1-bc5f-3f247c5c5b72",
                    "sense_definition": "Qui fait preuve d'une sévérité stricte ou d'une intransigeance absolue dans les règles ou les principes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce directeur applique une discipline <w>rigide</w> et n'accepte aucune exception au règlement."
                        },
                        {
                            "text": "Son père conservait une attitude <w>rigide</w> qui empêchait toute discussion ouverte en famille."
                        }
                    ],
                    "synonyms": [
                        "inflexible",
                        "intransigeant",
                        "sévère"
                    ],
                    "antonyms": [
                        "amène",
                        "souple"
                    ],
                    "common_phrases": [
                        "discipline rigide",
                        "règlement rigide"
                    ]
                },
                {
                    "sense_id": "8e34cabe-beeb-3fc3-8749-b1532626b59f",
                    "sense_definition": "Qui manque d'ouverture d'esprit, d'adaptabilité intellectuelle ou de nuance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son esprit <w>rigide</w>, il refuse obstinément d'examiner les arguments de ses contradicteurs."
                        },
                        {
                            "text": "Une pensée trop <w>rigide</w> empêche souvent d'imaginer des solutions novatrices face aux crises."
                        }
                    ],
                    "synonyms": [
                        "dogmatique",
                        "borné"
                    ],
                    "antonyms": [
                        "souple"
                    ],
                    "common_phrases": [
                        "esprit rigide",
                        "pensée rigide"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f748486a-6d41-3a68-a7b5-f05d0203b42b",
                    "sense_definition": "Personne intransigeante, sévère ou incapable de souplesse et d'adaptation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne_intransigeante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un véritable <w>rigide</w> qui refuse de modifier ses habitudes malgré les demandes unanimes."
                        },
                        {
                            "text": "Dans cette négociation complexe, les <w>rigides</w> ont immédiatement bloqué toute possibilité d'accord mutuel."
                        }
                    ],
                    "synonyms": [
                        "intransigeant"
                    ]
                }
            ]
        }
    ]
