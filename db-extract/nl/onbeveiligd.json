                "senses": [
                    {
                        "sense_id": "900f5097-b427-3d81-86e7-f6532af3bc3f",
                        "entry_id": "1c522fc9-d11b-3c67-ae06-2f74c415dd3f",
                        "glosses": [
                            "zonder bescherming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8097ed39-29f8-4083-a511-9ed15117f089",
                                "sense_id": "900f5097-b427-3d81-86e7-f6532af3bc3f",
                                "text": "Exact. Vandaar ook de reactie van Google: je moet je Glass niet uitlenen aan een vreemde en al helemaal niet zonder een oogje in het zeil te houden. Nogal logisch dat er anders rare dingen kunnen gebeuren. Als je je laptop, telefoon of tablet onbeheerd en onbeveiligd achterlaat, kan iemand daar ook programma's op zetten om je te bespioneren. Dat maakt andere beveiligingsonderzoekers wat sceptisch over deze vondst."
                            },
                            {
                                "example_id": "30666fa8-1e8a-4eaa-b5dd-9a602d87a15c",
                                "sense_id": "900f5097-b427-3d81-86e7-f6532af3bc3f",
                                "text": "Netelenbos benadrukt dat koopvaardijschepen niet onbeveiligd voor de kust van Somalië kunnen varen. Alle andere Europese landen staan volgens haar privébeveiligers op koopvaardijschepen toe."
                            }
                        ]
                    }
