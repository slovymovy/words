                "senses": [
                    {
                        "sense_id": "71cfa579-058f-3249-ba1c-1f81b259abb2",
                        "entry_id": "e2a0d894-05da-3d93-97d8-7e4d394e620e",
                        "glosses": [
                            "ein bestimmter Spruch aus der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c787be4a-026d-4452-92da-a86fa3b8fad1",
                                "sense_id": "71cfa579-058f-3249-ba1c-1f81b259abb2",
                                "text": "Ein Sprichwort oder ein Bibelspruch können sehr geeignet sein, eine Situation zu entspannen."
                            },
                            {
                                "example_id": "51a39768-bd66-40cc-9f77-38d4d0952543",
                                "sense_id": "71cfa579-058f-3249-ba1c-1f81b259abb2",
                                "text": "Ich will jetzt aber bloß keine Bibelsprüche hören!"
                            },
                            {
                                "example_id": "4dd02d33-da95-464d-84b5-818535032483",
                                "sense_id": "71cfa579-058f-3249-ba1c-1f81b259abb2",
                                "text": "„Aufrecht vor dem Chorpult stehend, psalmodiert er Bibelsprüche.“"
                            },
                            {
                                "example_id": "ca4e60a3-9272-4144-84d3-c0db60c5cdc4",
                                "sense_id": "71cfa579-058f-3249-ba1c-1f81b259abb2",
                                "text": "„Fast jedem Eintrag ist ein Bibelspruch vorangestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
