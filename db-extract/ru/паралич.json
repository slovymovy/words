                                            {
                                                "example_id": "b5f9f90c-7f6b-4a67-b712-728527c8e9af",
                                                "sense_id": "2111cf46-7a53-3406-9d93-4874d314b871",
                                                "text": "Wtedy jedna strona twarzy wykrzywia się. To nie paraliż, to po prostu porażenie nerwu twarzowego. Ta choroba wywołana jest deficytem wapnia w organizmie."
                                            }
