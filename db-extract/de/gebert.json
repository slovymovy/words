                ],
                "senses": [
                    {
                        "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                        "entry_id": "5c086643-12c3-331b-b953-1a95de74fae8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2fdc71-ddc1-484d-b22a-8248a21efb98",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Frau Gebert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5c45cf1f-4ddc-41b6-bff8-9bae94e3812f",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Herr Gebert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ea5a8e30-18e3-4c42-832b-6b3fa54ee401",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Die Geberts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "77340799-cc61-4d75-ba59-cc56543b81d5",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Der Gebert trägt nie die Schals, die die Gebert ihm strickt."
                            },
                            {
                                "example_id": "cbff5999-3b6a-499d-bd87-09443aa01a4b",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebert kommt, geht der Herr Gebert.“"
                            },
                            {
                                "example_id": "7a028434-db5d-4291-8772-dd272e4a74df",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Gebert kommt und geht."
                            },
                            {
                                "example_id": "b252a19c-3d08-400a-ac16-e4adb3f21cac",
                                "sense_id": "e80fe132-d3f0-3551-b71b-d476c111b77c",
                                "text": "Geberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
