    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                "word": "timekeeping",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "673408e2-1805-4554-9d55-a6f50918fcab",
                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "timekeepings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c647d1d-f1d8-362b-bc3a-f854b276dfbc",
                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "glosses": [
                            "The measurement of time, or determining what the local time is: the act or process of keeping the time."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a1e5e72-9535-312b-8c22-484b29912749",
                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "glosses": [
                            "The measurement of time, or determining what the local time is: the act or process of keeping the time.",
                            "Measuring and recording the time spent by employees on the clock, including the timepoints at which they clocked in and clocked out."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "glosses": [
                            "The quality of being punctual, keeping to a set time."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "45985aed-68e6-4917-8cb9-dedeaa2779f0",
                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                "text": "Timekeeping is better than on many Irish main lines; indeed, such delays as do occur are often attributable to late running of the Dublin-Sligo trains."
                            },
                            {
                                "example_id": "f80902b8-bcdc-4322-b1a1-bc4f7de6f3e3",
                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                "text": "As already indicated, timekeeping is very poor. Point-to-point times are not kept, even with a clear road, and whilst fast running has never been a feature of the route because of the large number of junctions and speed restrictions, this Sunday night lethargy is hard to explain."
                            },
                            {
                                "example_id": "083fc333-0acd-41fc-9e25-be177e7939c1",
                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                "text": "Our correspondent found that timekeeping had suffered following the substitution of Class 5 4-6-0s on these workings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad13f71d-5040-4935-b075-c0e16ad6e4ac",
                        "source_entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "source_sense_description": "the measurement of time",
                        "target_lang_word": "contrôle ou pointage de présence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2faabd1d-464c-4962-a6a9-78ba1b8d551d",
                        "source_entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "source_sense_description": "the measurement of time",
                        "target_lang_word": "chronométrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronométrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "855f378c-a07c-33a2-a725-ceeb5cdcdb2e",
                                        "entry_id": "25177771-92ce-3947-be2f-afbe4ea131ee",
                                        "glosses": [
                                            "Mesure du temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bba2ca2-ceb2-4555-a260-9a676b69f582",
                                                "sense_id": "855f378c-a07c-33a2-a725-ceeb5cdcdb2e",
                                                "text": "Lorsque le raid comporte des étapes quotidiennes ou peu espacées dans le temps, le responsable du chronométrage va se positionner aux emplacements d’étape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb68d309-0865-4ac0-8c94-477d85a17b91",
                        "source_entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "source_sense_description": "the measurement of time",
                        "target_lang_word": "ponctualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponctualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                        "entry_id": "dd6ca298-288d-36b7-a6cd-fa085e187541",
                                        "glosses": [
                                            "Exactitude à faire certaines choses dans un temps donné, comme on se l’est proposé, ou comme on l’a promis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162e2ed2-7479-48eb-b56d-e28345b8db5b",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "Au marché et à la devanture du bureau des Postes, c’est avec une grande ponctualité et une assiduité jamais démentie que les ’'miskines’' et les alyatimes se donnent rendez-vous."
                                            },
                                            {
                                                "example_id": "cf3d21d5-6e62-4952-b2cf-bcb98ca64931",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "On pouvait subodorer que c’était mal barré pour l’équipe de Suisse quand une conférence de presse d’avant-tournoi, la semaine dernière, a commencé avec 35 minutes de retard. Pour le pays de la ponctualité, il s’agissait bien entendu d’un impair considérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04b515e8-aa67-416d-aa23-c423cf4e3216",
                        "source_entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                        "source_sense_description": "the measurement of time",
                        "target_lang_word": "exactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de celui qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f779d5f-b5a4-41cf-9b6e-07e78b73211a",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "La collection des vice-présidents des États-Unis, qu’il avait décrite avec tant d’exactitude, formait une image persistante."
                                            },
                                            {
                                                "example_id": "8afb063d-41cc-43e8-b592-fffa816e4732",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "Mais, à part une série d’ouvrages géographiques, historiques, ethnographiques, parmi lesquels il y a des œuvres magistrales, et quelques bijoux littéraires sans prétention à l’exactitude scientifique, beaucoup de ces livres révèlent une connaissance insuffisante du sujet et n’ont souvent servi qu’à propager une foule de notions erronées […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de ce qui est conforme ; conformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb669b2-ed73-4117-b6fa-8a5504d64702",
                                                "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                                "text": "L’industrie moderne est caractérisée par un souci toujours plus grand de l’exactitude ; au fur et à mesure que l’outillage devient plus scientifique, on exige que le produit présente moins de défauts cachés et que sa qualité réponde ainsi parfaitement, durant l'usage, aux apparences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Caractère de ce qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3c4415-e1a4-4abb-9a3f-9cddcac91bdb",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir; […]."
                                            },
                                            {
                                                "example_id": "f858e23a-96a2-4ed1-bddb-e55b66e24624",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "L’exactitude d’une mesure, d’un calcul, d’une horloge, d’une balance. — L’exactitude de l’esprit, des définitions."
                                            },
                                            {
                                                "example_id": "7f7c40a8-924c-425e-a449-d7c7bf813f54",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Il faut avoir de l’exactitude dans les affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
