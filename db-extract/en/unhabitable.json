                        "glosses": [
                            "Not fit for people to live in; not able to be inhabited."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9288436d-6808-43be-88f4-a21278ebb06a",
                                "sense_id": "67bd830c-c943-360c-8fe4-c78b307e865b",
                                "text": "They conceived the torrid Zone unhabitable, and so made frustrate the goodliest part of the earth. But we now know ’tis very well empeopled, and the habitation thereof esteemed so happy, that some have made it the proper seat of Paradise, and beene so farre from judging it unhabitable that they have made it the first habitation of all."
                            },
                            {
                                "example_id": "1da6415f-07dc-4564-920b-b1080758e14d",
                                "sense_id": "67bd830c-c943-360c-8fe4-c78b307e865b",
                                "text": "[…] I could hardly have nam’d a Place in the unhabitable Part of the World where I could have been cast more to my Advantage:"
                            }
                        ]
                    }
