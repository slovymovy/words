{
    "word_family": [
        "déjucher",
        "juchoir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00811a81-e2b5-365a-a2b3-6b512a775537",
                    "sense_definition": "Pour un oiseau ou une volaille, se poser ou s'installer sur une branche ou un perchoir pour se reposer ou dormir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_percher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la tombée de la nuit, les poules rentrent dans l'abri pour aller <w>jucher</w>."
                        },
                        {
                            "text": "Plusieurs corbeaux <w>juchent</w> sur les branches les plus hautes du vieux chêne."
                        }
                    ],
                    "synonyms": [
                        "percher"
                    ],
                    "antonyms": [
                        "déjucher"
                    ],
                    "common_phrases": [
                        "aller jucher",
                        "jucher sur une branche"
                    ]
                },
                {
                    "sense_id": "7c847f54-b43f-3090-a730-9a9bc3718323",
                    "sense_definition": "Pour une personne, monter, s'asseoir ou se tenir dans un endroit élevé et souvent précaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_hauteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune garçon s'est <w>juché</w> sur un muret afin de mieux apercevoir le défilé."
                        },
                        {
                            "text": "Pour réparer la toiture, il a dû se <w>jucher</w> au sommet d'une grande échelle."
                        }
                    ],
                    "synonyms": [
                        "se percher",
                        "grimper"
                    ],
                    "antonyms": [
                        "descendre"
                    ],
                    "common_phrases": [
                        "se jucher sur",
                        "être juché sur"
                    ]
                },
                {
                    "sense_id": "c779a65f-3279-3e1f-b73d-c7258799e7a6",
                    "sense_definition": "Pour un bâtiment, un village ou un lieu, être situé ou édifié sur un sommet ou une hauteur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu_hauteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce village médiéval <w>juché</w> sur la falaise offre un panorama splendide sur la vallée."
                        },
                        {
                            "text": "Une ancienne chapelle blanche semble <w>jucher</w> au sommet de cette colline aride."
                        }
                    ],
                    "synonyms": [
                        "surplomber"
                    ],
                    "common_phrases": [
                        "juché sur la falaise",
                        "juché au sommet"
                    ]
                },
                {
                    "sense_id": "e4b8f22e-03c3-3de1-918e-ea4469f2309a",
                    "sense_definition": "Placer, hisser ou installer quelqu'un ou quelque chose tout en haut d'un endroit avec effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "placer_hauteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les déménageurs ont réussi à <w>jucher</w> cette lourde armoire au dernier étage."
                        },
                        {
                            "text": "Il a <w>juché</w> son enfant sur ses épaules pour traverser la foule compacte."
                        }
                    ],
                    "synonyms": [
                        "hisser",
                        "percher"
                    ],
                    "antonyms": [
                        "abaisser",
                        "descendre"
                    ],
                    "common_phrases": [
                        "jucher sur ses épaules"
                    ]
                },
                {
                    "sense_id": "b402b2cf-11d5-3095-a846-f2ca73985e28",
                    "sense_definition": "Figuré. Occuper ou atteindre une position sociale ou hiérarchique particulièrement importante.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "statut_eleve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il s'est <w>juché</w> à la tête du parti, il refuse d'écouter les critiques."
                        },
                        {
                            "text": "Une fois <w>juché</w> au sommet de la hiérarchie, il a vite oublié ses origines modestes."
                        }
                    ],
                    "common_phrases": [
                        "se jucher au pouvoir"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dda802ec-04f0-352c-954f-569b1903fbea",
                    "sense_definition": "Action, pour les oiseaux ou la volaille, de se percher pour passer la nuit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_percher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éleveur vérifie soigneusement le <w>jucher</w> quotidien des faisans avant d'éteindre les lumières."
                        },
                        {
                            "text": "À l'heure du <w>jucher</w>, toutes les volailles montent docilement sur leurs perchoirs en bois."
                        }
                    ],
                    "synonyms": [
                        "perchement"
                    ],
                    "common_phrases": [
                        "heure du jucher"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Terme spécialisé d'élevage ou de fauconnerie, peu courant dans la langue générale"
                        }
                    ]
                }
            ]
        }
    ]
}