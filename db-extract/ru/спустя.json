                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b258d09-a7bd-4b89-b0aa-09603f776adf",
                                                "sense_id": "87d56250-1672-3ea1-8dc8-d546152457a6",
                                                "text": "You came in late yesterday and today you came in even later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "Afterward in time (used with than when comparing with another time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec679b2-6e22-4780-b009-8a8884087342",
                                                "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                                "text": "My roommate arrived first. I arrived later."
                                            },
                                            {
                                                "example_id": "2e1942c6-e786-494f-b346-c2d275e38c82",
                                                "sense_id": "2565b7b7-5b99-30a0-9c37-31878c53b671",
                                                "text": "I arrived later than my roommate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d057ca-a51b-3e18-9351-da624f6df269",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "At some unspecified time in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd576342-5c81-4ae7-91bf-d552217162e5",
                                                "sense_id": "71d057ca-a51b-3e18-9351-da624f6df269",
                                                "text": "I wanted to do it now, but I’ll have to do it later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                        "entry_id": "87d9e377-eebd-3233-8790-3d8fe83d33a1",
                                        "glosses": [
                                            "What if (something problematic or unanticipated happens); if not (something undesirable will happen)."
                                        ],
                                        "tags": [
                                            "Manglish",
                                            "Singlish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c17f87-4d2c-4684-a36c-fb40f1863d1f",
                                                "sense_id": "82fa92d7-d54c-37fa-b1cc-1cf32bf83e96",
                                                "text": "Compare Malay nanti (“later; if not”)"
