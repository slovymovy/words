        "nl-extract.jsonl": [
            {
                "entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                "word": "solipsisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
                        "entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                        "glosses": [
                            "filosofische leer die ervan uitgaat dat er maar één enkel bewustzijn bestaat, nl. dat van de waarnemer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0f412a-8520-43e1-93ad-9aed3876a2b6",
                                "sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
                                "text": "Wittgenstein schreef in zijn Tractatus dat het solipsisme helemaal juist is, je kunt het alleen niet zeggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caea7ebc-81e4-45bd-9673-cf4309c714e5",
                        "source_entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                        "source_sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
                        "target_lang_word": "Solipsismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Solipsismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4045e196-e7c1-3f02-8928-54f7d78edfa1",
                                        "entry_id": "382283a5-dc51-3268-9f71-be0ca3d3c0da",
                                        "glosses": [
                                            "erkenntnistheoretische Position, die annimmt: Nur ich selbst allein existiere; es gibt weder andere Subjekte noch andere Körper außer mir"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd78ce9-fba0-4190-9c5e-d47e2f565925",
                                                "sense_id": "4045e196-e7c1-3f02-8928-54f7d78edfa1",
                                                "text": "„Und natürlich ist der Solipsismus auch nie als ernsthafte Überzeugung von einem gesunden Menschen vertreten worden (wem gegenüber auch?); er gehört vielmehr ausschließlich ins philosophische Denklabor und wird dort gelegentlich als eine rein methodische Fiktion herangezogen, […]“."
                                            },
                                            {
                                                "example_id": "deb80bdc-99cc-438d-87fd-c6ae970555c2",
                                                "sense_id": "4045e196-e7c1-3f02-8928-54f7d78edfa1",
                                                "text": "„Daraus […] führte der Weg zum absoluten Pessimismus und zum Gefühl der Ohnmacht (Schopenhauer) oder zum Solipsismus (Fichte), in dem das Ich zum Ursprung und Ende aller Dinge erklärt wurde.“"
                                            },
                                            {
                                                "example_id": "2860af80-2202-42ae-bf62-4b7985910e38",
                                                "sense_id": "4045e196-e7c1-3f02-8928-54f7d78edfa1",
                                                "text": "„Bemühen wir uns zunächst um ein Verständnis dessen, was der Solipsismus ‚meint‘. Hier gilt es zu bedenken, daß Wittgensteins Solipsismus nicht der methodische Solipsismus Descartes’ ist, der beansprucht, die Re-Konstruktion der Welt auf der Grundlage der Gewißheit der eigenen Existenz leisten zu können, sondern der kontemplative Solopsismus Schopenhauers, den dieser als den ‚Zustand der reinen Objektivität der Anschauung‘ in der folgenden Weise beschreibt:[…].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5bda00e-f0a0-4a7c-af9e-f4c36cff9fef",
                        "source_entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                        "source_sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
                        "target_lang_word": "solipsism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solipsism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13126d8c-12be-3f71-8746-9183d9142ddc",
                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "The idea that the self is all that exists or that can be proven to exist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "Self-absorption, an unawareness of the views or needs of others; self-centeredness; egoism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c212b797-e152-4758-9fd8-f3025674288d",
                                                "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                                "text": "The solipsism that too frequently infects high commands has no place on a battlefield."
                                            },
                                            {
                                                "example_id": "b7491c68-5e98-466b-8f31-21723e797c35",
                                                "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                                "text": "Self-mythology has always been part of The Darkness’ shtick, but here Hawkins and crew forget to back it up with music catchy enough to transcend the solipsism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c484cb-a32b-3768-ae6d-58531be8ec67",
                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "Self-absorption, an unawareness of the views or needs of others; self-centeredness; egoism.",
                                            "Masturbation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d091165-853b-4330-8052-75437f3b4186",
                        "source_entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                        "source_sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
                        "target_lang_word": "solipsisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solipsisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99e927ae-c8c0-3ffd-8955-e7458036e201",
                                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                                        "glosses": [
                                            "Attitude du sujet pensant pour qui sa conscience propre est l’unique réalité, les autres consciences, le monde extérieur n’étant que des représentations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae423db7-174c-39ca-9537-cd5603d985ed",
                                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                                        "glosses": [
                                            "Idéalisme limite d’après lequel il n’y aurait, pour le sujet pensant, d’autre réalité que lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f869d479-437e-4a4b-8083-85f195d773d3",
                                                "sense_id": "ae423db7-174c-39ca-9537-cd5603d985ed",
                                                "text": "Les notions de souverainité de l'individu et de propriété de soi semblent exclure tout rapport à autrui et devoir conduire à un solipsisme radical ou à un individualisme atomiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e06f053-aaab-36f6-8ca0-82d8abd992f1",
                                        "entry_id": "d6c25930-4010-3eb6-804f-77bfab2d753f",
                                        "glosses": [
                                            "Caractère d’une personne, d’un univers de pensée qui est entièrement centré sur soi, hors de toute décision philosophique."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab3c6cfc-777f-4c9e-942d-1bc83b7909d8",
                                                "sense_id": "1e06f053-aaab-36f6-8ca0-82d8abd992f1",
                                                "text": "Très tôt j’ai souffert de solipsisme, c’est dire que j’ai perdu dès l’âge de douze ans toute croyance en la réalité du monde extérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19eaf33b-6061-4f10-9925-b87e0a23fa1f",
                        "source_entry_id": "962f012f-1386-3511-8ba8-a2e31cf35360",
                        "source_sense_id": "33404f06-e190-3fa2-b913-01875cf5722c",
