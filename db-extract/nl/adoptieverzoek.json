                        "glosses": [
                            "vraag om een kind te mogen adopteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d6c7b9-6b6c-4a4a-a8bc-7b2e42beec8a",
                                "sense_id": "592329a4-971f-32fb-b6bf-d7f02b06107d",
                                "text": "De vrouw kan zelf geen kinderen krijgen omdat ze zich om medische redenen moest laten steriliseren. Ze adopteerde hierna drie kinderen uit het buitenland, twee met haar man en één nadat ze was gescheiden. Een vierde adoptieverzoek werd tot haar grote verdriet afgewezen."
                            },
                            {
                                "example_id": "0610ab4e-f9f2-4338-a35a-268cd23bb625",
                                "sense_id": "592329a4-971f-32fb-b6bf-d7f02b06107d",
                                "text": "Drie jaar later kreeg ze toestemming om een tweede kind uit Malawi adopteren. Eerst wees een rechter het adoptieverzoek voor de 4-jarige Chifundo 'Mercy' James af omdat Madonna niet voldeed aan de eis dat ze minimaal anderhalf jaar in Malawi moest wonen. Het hooggerechtshof draaide die beslissing later terug."
                            }
                        ]
                    }
