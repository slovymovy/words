                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Stadtluft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                        "entry_id": "166a7028-8393-36d3-b51a-811be5e5502f",
                        "glosses": [
                            "die Luft in einer Stadt, die Atmosphäre einer Stadt (im Gegensatz zum Land, Dorf)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75ce1de-cfa4-4915-bdb0-5ffaf2752957",
                                "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                                "text": "„Vor Jahrhunderten machte Stadtluft frei. Jetzt macht Stadtluft wohl nur noch krank.“"
                            },
                            {
                                "example_id": "e9d98573-d518-460b-a277-a77748c7316e",
                                "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                                "text": "„Die Tiere bekamen belastete Stadtluft zum Atmen. Kernspinaufnahmen ihrer Hirne und Analysen nach deren Tod zeigten, dass ihre Blut-Hirn-Schranke nicht mehr gut funktionierte.“"
                            },
                            {
                                "example_id": "72584a5f-4fb1-494b-b7f9-a4f1efdeef58",
                                "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                                "text": "„Die Aerzte meinten, die Kranke dürfe ihrer Aufsicht und Hilfe nicht entzogen werden, und hielten sie darum in der dumpfen Stadtluft zurück.“"
                            },
                            {
                                "example_id": "783df23f-5894-492a-bc80-941cf75e0037",
                                "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                                "text": "„Sie hatte kaum die Tür hinter sich geschlossen, als in der Stadtluft ein großes Läuten losging, wie er noch nie eins vernommen hatte.“"
                            },
                            {
                                "example_id": "e9f135b6-cacf-443f-98ba-842aa4f5da5e",
                                "sense_id": "6bf42a2c-dd29-36cb-b940-72d1ecf517a8",
                                "text": "„Stadtluft macht frei, und sie stinkt wie die Pest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
