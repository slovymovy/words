                "senses": [
                    {
                        "sense_id": "e356171a-6199-351a-b4a6-44b26e52c942",
                        "entry_id": "916c75d8-1149-34ab-a9d4-57a621f2156f",
                        "glosses": [
                            "Pilot, der einer militärischen Einheit angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b578c5-faf4-41a4-9474-04a088064ba0",
                                "sense_id": "e356171a-6199-351a-b4a6-44b26e52c942",
                                "text": "„Doch ein halbes Jahr später verunglückte der Militärpilot bei einem Flugzeugabsturz an der Ostfront tödlich. Ursache war ein Pilotenfehler.“"
                            },
                            {
                                "example_id": "bc9a9d35-884b-469c-8b3a-36970b572faa",
                                "sense_id": "e356171a-6199-351a-b4a6-44b26e52c942",
                                "text": "„Scheidet ein Militärpilot aus eigenem Verschulden vor Ablauf von 8 Jahren ab beendeter Ausbildung als Militärpilot aus, so hat er die für ihn aufgewendeten fliegerischen Ausbildungskosten dem Bund zu ersetzen.“"
                            },
                            {
                                "example_id": "a13194a2-6aff-4ef9-9f5b-8a01e08db10d",
                                "sense_id": "e356171a-6199-351a-b4a6-44b26e52c942",
                                "text": "„Glaubt man den Augenzeugen, so war es nicht das erste Mal, daß ein Militärpilot das Husarenstück versucht hat, während der Betriebszeit unter den Seilen durchzutauchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
