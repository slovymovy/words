                    "frequency": "Low",
                    "semantic_group_id": "water_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaking roof began to <w>puddle</w> on the kitchen floor.",
                            "target_lang_translations": {
                                "cs": "Z děravé střechy se začala na kuchyňské podlaze <w>tvořit louže</w>.",
                                "zh": "漏水的屋顶开始在厨房地板上形成<w>积水</w>。"
                            }
                        },
                        {
                            "text": "Spilled coffee started to <w>puddle</w> around the edge of the cup.",
                            "target_lang_translations": {
                                "cs": "Rozlitá káva se začala <w>rozlévat</w> kolem okraje šálku.",
                                "zh": "洒出的咖啡开始在杯子边缘<w>积聚</w>。"
                            }
