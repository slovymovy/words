                "senses": [
                    {
                        "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                        "entry_id": "f09ba66e-b648-308b-96f2-2d18d965a57d",
                        "glosses": [
                            "moistening."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0f1537d1-56ce-4cf7-b891-aff53639a36e",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "The cure of such an effect must be performed by two means, that is, evacuation and cooling with humectation."
                            },
                            {
                                "example_id": "bf2a9f23-bb9f-46c1-9717-5b93062dcc17",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "That which is concreted by exsiccation or expression of humidity, will be resolved by humectification, as earth, dirt and clay."
                            },
                            {
                                "example_id": "87056885-64c9-48ac-afc8-3006ab7dbf57",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "It hath been observed by the ancients, that plates of metal, and especially of brass, applied presently to a blow, will keep it down from swelling. The cause is repercussion, without humectiation, or entrance of any body."
                            },
                            {
                                "example_id": "5cee3ff3-9b53-432a-b008-b6649abb644c",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "Thereafter, humectation of soil was recorded in the autumn, following rains."
                            },
                            {
                                "example_id": "f2aa9402-a3ee-4f2d-924e-a357777b5980",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "Emollients are useful in spa services because of their three main properties: occlusion, lubrication, and humectation."
                            },
                            {
                                "example_id": "12389590-628d-4348-a0e3-3c3e78159620",
                                "sense_id": "6ca45545-b14b-38dd-84dc-c372a21e3dba",
                                "text": "Substitutive treatment (artificial tears) is the most useful medication. It tries to recover for a short time the humectation, osmolarity and lubrication of the ocular surface, although the etiologic causes persist."
                            }
                        ]
                    }
                ],
