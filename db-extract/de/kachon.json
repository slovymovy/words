                "senses": [
                    {
                        "sense_id": "81bb3f51-6586-3e8f-a3b3-210ee680ecaa",
                        "entry_id": "008ce62d-d782-3c43-a392-b7a6f4866ea1",
                        "glosses": [
                            "kistenartiges Perkussionsinstrument, das zumeist mit den Händen bespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b47e8f5a-40c1-42f0-9cb5-4ed1dfd3f5f4",
                                "sense_id": "81bb3f51-6586-3e8f-a3b3-210ee680ecaa",
                                "text": "„Doch mit seinem unfehlbaren Rhythmusgefühl unterstreicht er am Kachon und gelegentlich am kleinen Becken, dass er ihre überwiegend selbst geschriebenen Songs verinnerlicht hat.“"
                            },
                            {
                                "example_id": "4268c073-2ea3-4b49-9487-08e2998ab0e3",
                                "sense_id": "81bb3f51-6586-3e8f-a3b3-210ee680ecaa",
                                "text": "„Laura sitzt auf der sogenannten Kachon, einem Percussion-Instrument, und beweist beim Trommeln, Klatschen und Stampfen ausgesprochenes Gefühl für Bewegung und Rhythmus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
