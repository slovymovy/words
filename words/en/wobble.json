{
    "word_family": [
        "wobbly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                    "sense_definition": "To move with an uneven or rocking motion, or unsteadily to and fro.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowl of jelly <w>wobbled</w> on the table when someone bumped it.",
                            "target_lang_translations": {
                                "cs": "Mísa s želé se na stole <w>zakymácela</w>, když do něj někdo strčil."
                            }
                        },
                        {
                            "text": "The old table <w>wobbles</w> because one of its legs is shorter than the others.",
                            "target_lang_translations": {
                                "cs": "Ten starý stůl se <w>viklá</w>, protože jedna z jeho nohou je kratší než ostatní."
                            }
                        }
                    ],
                    "synonyms": [
                        "jiggle",
                        "rock",
                        "shake",
                        "wiggle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se nerovnoměrným, kolébavým nebo nejistým způsobem tam a zpět."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "viklat se",
                                "target_lang_sense_clarification": "pohybovat se tam a sem, typické pro nábytek nebo uvolněné části"
                            },
                            {
                                "target_lang_word": "kymácet se",
                                "target_lang_sense_clarification": "vychylovat se z rovnovážné polohy, ztrácet stabilitu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9c9714b-2331-3bc7-8b07-87f3d064ba66",
                    "sense_definition": "To tremble or quaver.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her voice <w>wobbled</w> as she tried to hold back tears during the speech.",
                            "target_lang_translations": {
                                "cs": "Její hlas se <w>zachvěl</w>, když se během projevu snažila zadržet slzy."
                            }
                        },
                        {
                            "text": "The singer's voice <w>wobbled</w> slightly during the high note.",
                            "target_lang_translations": {
                                "cs": "Zpěvaččin hlas se během vysokého tónu mírně <w>zachvěl</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "quaver",
                        "quiver",
                        "shake",
                        "shudder",
                        "tremble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Třást se nebo chvět (často o hlase)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chvět se",
                                "target_lang_sense_clarification": "vytvářet jemný, rychlý pohyb, často v důsledku emocí"
                            },
                            {
                                "target_lang_word": "třást se",
                                "target_lang_sense_clarification": "projevovat chvění, např. hlasu při pláči nebo rozrušení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "153d1eb7-2013-330f-aca8-4214abe21bfc",
                    "sense_definition": "To vacillate in one's opinions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>wobbling</w> between two different job offers for several days.",
                            "target_lang_translations": {
                                "cs": "Několik dní <w>kolísal</w> mezi dvěma různými pracovními nabídkami."
                            }
                        },
                        {
                            "text": "She started to <w>wobble</w> on her decision after hearing the new information.",
                            "target_lang_translations": {
                                "cs": "Poté, co slyšela nové informace, začala ve svém rozhodnutí <w>váhat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "falter",
                        "vacillate",
                        "waffle",
                        "waver"
                    ],
                    "target_lang_definitions": {
                        "cs": "Být nerozhodný, kolísat v názorech nebo rozhodnutích."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kolísat",
                                "target_lang_sense_clarification": "být nejistý, nemoci se rozhodnout mezi možnostmi"
                            },
                            {
                                "target_lang_word": "váhat",
                                "target_lang_sense_clarification": "odkládat rozhodnutí kvůli nejistotě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcab15bf-7328-3085-bb77-58496a34638b",
                    "sense_definition": "To cause to wobble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>wobble</w> the ladder while I am standing on it.",
                            "target_lang_translations": {
                                "cs": "<w>Nerozkolísej</w> ten žebřík, zatímco na něm stojím."
                            }
                        },
                        {
                            "text": "He <w>wobbled</w> the table to see if it was stable.",
                            "target_lang_translations": {
                                "cs": "Zkusil se stolem <w>zakývat</w>, aby zjistil, jestli je stabilní."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, aby se něco začalo viklat nebo kolísat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozkolísat",
                                "target_lang_sense_clarification": "uvést věc do stavu kolísání nebo viklání"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44f9f960-2dff-3b67-aa23-7d40df8f8996",
                    "sense_definition": "An unsteady motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chair has a slight <w>wobble</w> that makes it uncomfortable.",
                            "target_lang_translations": {
                                "cs": "Židle má mírné <w>viklání</w>, kvůli kterému je nepohodlná."
                            }
                        },
                        {
                            "text": "There is a noticeable <w>wobble</w> in the front wheel of the bicycle.",
                            "target_lang_translations": {
                                "cs": "Na předním kole kola je patrné <w>házení</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shake"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nejistý, kolébavý pohyb nebo stav."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kývání",
                                "target_lang_sense_clarification": "pohyb tam a zpět"
                            },
                            {
                                "target_lang_word": "viklání",
                                "target_lang_sense_clarification": "stav, kdy se předmět pohybuje kvůli nedostatečné stabilitě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15acaf66-577d-3268-a7ba-94ec4e9df923",
                    "sense_definition": "A tremulous sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer added a slight <w>wobble</w> to her voice for dramatic effect.",
                            "target_lang_translations": {
                                "cs": "Zpěvačka přidala do svého hlasu pro dramatický efekt mírné <w>chvění</w>."
                            }
                        },
                        {
                            "text": "The recording had a strange <w>wobble</w> due to the old tape.",
                            "target_lang_translations": {
                                "cs": "Nahrávka měla kvůli staré pásce podivné <w>kolísání</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "quaver",
                        "tremolo",
                        "vibrato"
                    ],
                    "target_lang_definitions": {
                        "cs": "Chvějivý, rozechvělý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chvění",
                                "target_lang_sense_clarification": "vibrace nebo třes v hlase či zvuku"
                            },
                            {
                                "target_lang_word": "vibrato",
                                "target_lang_sense_clarification": "hudební termín pro kolísání výšky tónu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c39784f-5860-3768-ac72-02900b5598c3",
                    "sense_definition": "A low-frequency oscillation sometimes used in dubstep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy <w>wobble</w> in the bass line defines this electronic music genre.",
                            "target_lang_translations": {
                                "cs": "Výrazné <w>wobble</w> v basové lince definuje tento žánr elektronické hudby."
                            }
                        },
                        {
                            "text": "Modern producers often use software to create that signature dubstep <w>wobble</w>.",
                            "target_lang_translations": {
                                "cs": "Moderní producenti často používají software k vytvoření toho typického dubstepového <w>wobble</w> efektu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nízkofrekvenční oscilace zvuku, často používaná v elektronické hudbě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "wobble",
                                "target_lang_sense_clarification": "přejatý termín pro specifický zvukový efekt v dubstepu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe77492-dc89-3158-ae39-2351a8171864",
                    "sense_definition": "A variation in the third nucleotide of a codon that codes for a specific aminoacid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wobble</w> position allows for flexibility in the genetic code.",
                            "target_lang_translations": {
                                "cs": "Pozice <w>wobble</w> umožňuje flexibilitu v genetickém kódu."
                            }
                        },
                        {
                            "text": "Scientists study the <w>wobble</w> effect to understand how tRNA binds to mRNA.",
                            "target_lang_translations": {
                                "cs": "Vědci studují <w>wobble</w> efekt, aby pochopili, jak se tRNA váže na mRNA."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Variabilita v párování třetí báze kodonu s antikodonem tRNA."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "wobble efekt",
                                "target_lang_sense_clarification": "odborný termín pro flexibilitu v genetickém kódu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}