            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22dc997a-17a6-3fbe-8f90-b9eb65db1609",
                    "sense_definition": "iemand op een agressieve, vijandige of intimiderende manier benaderen of in het nauw drijven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agressief_benaderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd aan alle kanten door zijn vijanden <w>belaagd</w>.",
                            "target_lang_translations": {
                                "en": "He was <w>beset</w> on all sides by his enemies."
                            }
                        },
                        {
                            "text": "De soldaten probeerden de vijandige stelling te <w>belagen</w>.",
                            "target_lang_translations": {
                                "en": "The soldiers tried to <w>assail</w> the enemy position."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestormen",
                        "aanvallen",
                        "bedreigen"
                    ],
                    "antonyms": [
                        "beschermen",
                        "verdedigen"
                    ],
                    "common_phrases": [
                        "door vijanden belagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To approach or corner someone in an aggressive, hostile, or intimidating manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beset",
                                "target_lang_sense_clarification": "to attack or harass from all sides"
                            },
                            {
                                "target_lang_word": "beleaguer",
                                "target_lang_sense_clarification": "to surround or harass constantly"
                            },
                            {
                                "target_lang_word": "besiege",
                                "target_lang_sense_clarification": "to surround or crowd in on aggressively"
                            },
                            {
                                "target_lang_word": "waylay",
                                "target_lang_sense_clarification": "to lie in wait for and attack"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8d446fd-18e7-3e7d-b2d8-3eaf5408bf0d",
                    "sense_definition": "iemand op een opdringerige of hinderlijke wijze lastigvallen, bijvoorbeeld met vragen of verzoeken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lastigvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister werd door de journalist met een microfoon veel te opdringerig <w>belaagd</w> en achtervolgd.",
                            "target_lang_translations": {
                                "en": "The minister was <w>harassed</w> and pursued far too intrusively by the journalist with a microphone."
                            }
                        },
                        {
                            "text": "Beroemdheden worden vaak op straat <w>belaagd</w> door opdringerige fotografen.",
                            "target_lang_translations": {
                                "en": "Celebrities are often <w>pestered</w> on the street by pushy photographers."
                            }
                        }
                    ],
                    "synonyms": [
                        "lastigvallen",
                        "hinderen",
                        "harasseren",
                        "stalken"
                    ],
                    "antonyms": [
                        "met rust laten"
                    ],
                    "common_phrases": [
                        "door journalisten belagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pester or harass someone in an intrusive or annoying way, such as with questions or requests."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harass",
                                "target_lang_sense_clarification": "to subject to aggressive pressure or intimidation"
                            },
                            {
                                "target_lang_word": "pester",
                                "target_lang_sense_clarification": "to trouble or annoy someone with frequent requests or questions"
                            },
                            {
                                "target_lang_word": "besiege",
                                "target_lang_sense_clarification": "to overwhelm with questions or requests"
                            },
                            {
                                "target_lang_word": "badger",
                                "target_lang_sense_clarification": "to repeatedly ask someone to do something"
                            }
                        ]
                    }
                }
            ]
        },
