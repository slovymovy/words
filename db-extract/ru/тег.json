                                    {
                                        "sense_id": "2a5824f6-1ec0-3b4a-b376-7e86a50108e0",
                                        "entry_id": "9d10c96d-b215-3150-a5bc-d9b07ff4b940",
                                        "glosses": [
                                            "Physical appendage.",
                                            "A metallic binding, tube, or point, at the end of a string, or lace, to stiffen it."
