                    "sense_definition": "Matka ojca lub matki.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja <w>babcia</w> ma siedemdziesiąt lat.",
                            "target_lang_translations": {
                                "ru": "Моей <w>бабушке</w> семьдесят лет.",
                                "en": "My <w>grandmother</w> is seventy years old."
                            }
                        },
                        {
                            "text": "W każdy weekend odwiedzamy naszą <w>babcię</w> na wsi.",
                            "target_lang_translations": {
                                "ru": "Каждые выходные мы навещаем нашу <w>бабушку</w> в деревне.",
                                "en": "Every weekend we visit our <w>grandma</w> in the countryside."
                            }
                        }
                    ],
