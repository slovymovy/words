                ],
                "senses": [
                    {
                        "sense_id": "1c3729a2-7fac-3ccd-bbf8-8882ce0ad5ec",
                        "entry_id": "9a8e4d66-2e34-33a8-aa54-e492fc69a2b4",
                        "glosses": [
                            "Eigenschaft, einzigartig/unvergleichlich zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2200c3c-e079-497b-afdc-aa37a8f15528",
                                "sense_id": "1c3729a2-7fac-3ccd-bbf8-8882ce0ad5ec",
                                "text": "„Auf unserer Reise kamen wir an Orte, die uns den Blick öffneten für die Schönheit und Einzigartigkeit der Landschaft, die trotz des Einflusses des Menschen auf die Natur noch heute zu finden sind.“"
                            },
                            {
                                "example_id": "03d88bb1-698e-4d01-9a3a-8784fc1ce430",
                                "sense_id": "1c3729a2-7fac-3ccd-bbf8-8882ce0ad5ec",
                                "text": "„Das ehemalige Refektorium des Klosters ließ sich leicht in einen Theatersaal verwandeln; was er vielleicht an Eleganz vermissen ließ, machte er wett durch seine Einzigartigkeit.“"
                            },
                            {
                                "example_id": "0817ab6e-30a1-4201-9846-973925150b8c",
                                "sense_id": "1c3729a2-7fac-3ccd-bbf8-8882ce0ad5ec",
                                "text": "„Es ist schwierig festzustellen, ob man wirklich anders ist, besonders wenn alle Teenager in ihrer Vorstellung von Einsamkeit und Einzigartigkeit feststecken und jeder und jede sich für eine kleine einsame Monade im weiten Universum hält, der Radiohead-Song Creep der Rhythmus des Herzschlags jedes einzelnen verdammten Individuums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
