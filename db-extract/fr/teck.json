                                "target_senses": [
                                    {
                                        "sense_id": "57e87a17-4d99-39ab-a8cd-344458546796",
                                        "entry_id": "32c26a93-15bb-3009-aaaa-2bca8a5ec2d4",
                                        "glosses": [
                                            "Holz des in Südostasien heimischen Teakbaums, das besonders wertvoll und dauerhaft ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3cb35c-f4d9-490f-8f18-512007488c02",
                                                "sense_id": "57e87a17-4d99-39ab-a8cd-344458546796",
                                                "text": "„Da gibt es neue Vollholzmöbel, die auch individuell lackiert werden, Gartenmöbel aus Teak und moderne Möbel aus recyceltem Teakholz […].“"
                                            },
                                            {
                                                "example_id": "f9cad77d-63da-40b1-9bc3-6b485e1c2757",
                                                "sense_id": "57e87a17-4d99-39ab-a8cd-344458546796",
                                                "text": "„Heute macht sich kaum einer mehr Gedanken, woher das Teak für riesige Gartenmöbel kommt. Teak, Tectona grandis, stammt ursprünglich aus asiatischen Urwäldern, dort, wo die letzten Orang-Utans zu Hause sind […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
