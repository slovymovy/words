                                        "sense_id": "14835801-2919-3429-882f-a35d5f3c4296",
                                        "entry_id": "5109e7c3-e2df-36b6-a63e-6799428d7d7f",
                                        "glosses": [
                                            "mehrere Sprachen betreffend; mehreren Sprachen gemeinsam"
