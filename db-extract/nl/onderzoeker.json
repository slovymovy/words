                        "entry_id": "ece53910-2e56-31e0-b1bd-7e6e7c8d2f5c",
                        "glosses": [
                            "iemand die een onderzoek uitvoert"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "892803f7-a99d-3990-8c40-b733b2b45043",
                        "entry_id": "ece53910-2e56-31e0-b1bd-7e6e7c8d2f5c",
                        "glosses": [
                            "een beoefenaar van de wetenschap"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "97c92676-3aad-46b7-bce2-8c738ce5bee4",
                                "sense_id": "892803f7-a99d-3990-8c40-b733b2b45043",
                                "text": "De onderzoeker probeerde de gang van zaken te doorgronden."
                            },
                            {
                                "example_id": "592351cf-21c5-4de0-94a9-6e1766c63927",
                                "sense_id": "892803f7-a99d-3990-8c40-b733b2b45043",
                                "text": "\"Onderzoekers zijn hier welkom\": Macron was vandaag kritisch over het beleid van zijn Amerikaanse collega. \"Wie had ooit kunnen denken dat zo'n grote democratie, met een economie die juist steunt op vrije wetenschap, zo'n grote fout zou maken\", zei Macron. Amerikaanse onderzoekers zijn hier welkom, voegde hij eraan toe. En om ze op te vangen heeft Parijs 100 miljoen euro beschikbaar. \"Europa moet een toevluchtsoord zijn voor wetenschappers die worden bedreigd.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08495291-1001-41c7-8659-7f0229efdf35",
                        "source_entry_id": "ece53910-2e56-31e0-b1bd-7e6e7c8d2f5c",
                        "source_sense_id": "60973a2a-f6c6-338c-938e-dd08fa18a874",
                        "source_sense_description": "iemand die een onderzoek uitvoert",
                        "target_lang_word": "Forscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                        "entry_id": "6f8e0149-b77a-38c4-b475-249c8b3901c2",
                                        "glosses": [
                                            "Person, die Erscheinungen der Welt und ihre möglichen Zusammenhänge wissenschaftlich untersucht und somit möglichst valide Erkenntnisse über die Welt gewinnen möchte"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Forschung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b7928be-4b8e-4782-9f6a-a683df3d95b1",
                                                "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                                "text": "Viele Forscher versuchen herauszufinden, wie das Gehirn funktioniert."
                                            },
                                            {
                                                "example_id": "4017f7fd-9494-43a4-a1b3-5e3c94384ed4",
                                                "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                                "text": "„Der Forscher trotzt Sonnenglut und Überschwemmungen, Überfällen und Krankheiten, bis er schließlich Timbuktu im heutigen Mali erreicht.“"
                                            },
                                            {
                                                "example_id": "9408195d-4723-4de0-bb55-94b712d8feef",
                                                "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                                "text": "„Er wurde Forscher.“"
                                            },
                                            {
                                                "example_id": "39c71aba-b99f-4971-9e6a-b608f34291c6",
                                                "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                                "text": "„In einer Langzeitstudie in Neuseeland wollen Forscher beobachtet haben, dass geduldigere Schüler im Schnitt einen besseren Schulabschluss machen.“"
                                            },
                                            {
                                                "example_id": "a69481c6-c536-471d-9747-d678c211bc5d",
                                                "sense_id": "de9a6682-f9ca-371f-9f98-777cb2b5f7c7",
                                                "text": "„Das Privatleben eines Forschers läßt sich nur bedingt mit seinem wissenschaftlichen Tun verbinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39e533f6-df8d-4f05-867a-aed446356a9f",
                        "source_entry_id": "ece53910-2e56-31e0-b1bd-7e6e7c8d2f5c",
                        "source_sense_id": "60973a2a-f6c6-338c-938e-dd08fa18a874",
                        "source_sense_description": "iemand die een onderzoek uitvoert",
                        "target_lang_word": "researcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "researcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                        "entry_id": "5757c58a-ab04-3d64-8102-957f22dc4046",
                                        "glosses": [
                                            "One who researches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984817fe-06c0-45cb-8ddd-92ab2996a127",
                                                "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            },
                                            {
                                                "example_id": "af3c5209-ce52-4ae2-b4ca-22746b1ee164",
                                                "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                                "text": "The Amazon is larger than the next two largest rainforests combined, according to Rhett Butler, a rainforest researcher and the CEO of Mongabay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee6329bf-6d26-4ca5-b021-02a8d19a66dd",
                        "source_entry_id": "ece53910-2e56-31e0-b1bd-7e6e7c8d2f5c",
                        "source_sense_id": "60973a2a-f6c6-338c-938e-dd08fa18a874",
                        "source_sense_description": "iemand die een onderzoek uitvoert",
                        "target_lang_word": "chercheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chercheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ff70528-566d-3a5f-9cfd-94144c348486",
                                        "entry_id": "56d4cdc8-4798-308e-90eb-e44e7642c43c",
                                        "glosses": [
                                            "Personne qui cherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8774c5be-540d-4f48-b765-b6d57ebab189",
                                                "sense_id": "1ff70528-566d-3a5f-9cfd-94144c348486",
                                                "text": "L’apologue du lampadaire est paraît-il bien connu des chercheurs : un type qui a perdu ses clés explore en vain les dessous d’un lampadaire en pleine nuit. Pourquoi chercher seulement là ? Parce que c’est le seul endroit éclairé."
                                            },
                                            {
                                                "example_id": "2f381434-5b61-4b28-9db3-abc26c34dfc9",
                                                "sense_id": "1ff70528-566d-3a5f-9cfd-94144c348486",
                                                "text": "Chercheur d’or, chercheur d’aventures, chercheur de querelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56785380-0216-360d-8bca-084f3174c680",
                                        "entry_id": "56d4cdc8-4798-308e-90eb-e44e7642c43c",
                                        "glosses": [
                                            "Esprit curieux poursuivant sans cesse de nouvelles découvertes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266dfd57-b75a-4a58-b192-9803154a1bfa",
                                                "sense_id": "56785380-0216-360d-8bca-084f3174c680",
                                                "text": "En mars 1978 apparaissait chez les libraires le premier reprint qui, s'il livrait enfin à de nombreux chercheurs le texte intégral, n'en respectait ni la pagination, ni le format."
                                            },
                                            {
                                                "example_id": "0d17feb1-45b4-4e99-9581-6f9bdf54b232",
                                                "sense_id": "56785380-0216-360d-8bca-084f3174c680",
                                                "text": "Les deux officiers avaient trouvé plusieurs clés USB, ainsi que trois disques durs externes et des brouillons de formules mathématiques, certainement le fruit des recherches du défunt chercheur."
                                            },
                                            {
                                                "example_id": "2755501c-256e-46ab-8123-c1cd6d509243",
                                                "sense_id": "56785380-0216-360d-8bca-084f3174c680",
                                                "text": "Des chercheurs qui cherchent, on en trouve. Des chercheurs qui trouvent, on en cherche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b4330c-6d20-3ac5-92c2-8640cd83aa6c",
                                        "entry_id": "56d4cdc8-4798-308e-90eb-e44e7642c43c",
                                        "glosses": [
                                            "Homme, qui seul ou membre d’une équipe, se consacre à la recherche scientifique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826cbe3b-4888-49d0-b12c-8b8d7829238f",
                                                "sense_id": "28b4330c-6d20-3ac5-92c2-8640cd83aa6c",
                                                "text": "L’activité d’un chercheur se mesure essentiellement par ses publications."
                                            },
                                            {
                                                "example_id": "2be16757-2066-481a-b22b-4e01c1484c19",
                                                "sense_id": "28b4330c-6d20-3ac5-92c2-8640cd83aa6c",
                                                "text": "Il ne faudrait pas passer sous silence le fait que les chercheurs et chercheures francophones se rencontrent aussi dans le cadre de colloques annuels et autres activités organisées par les centres de recherches dans les provinces."
                                            },
                                            {
                                                "example_id": "d785a08c-0166-473d-8919-77f641353831",
                                                "sense_id": "28b4330c-6d20-3ac5-92c2-8640cd83aa6c",
                                                "text": "Il y a deux catégories de chercheurs qui ne cherchent plus. Ceux qui ont trouvé, en général multirécompensés, qui passent leur temps à intervenir dans des émissions télévisées et finissent conseillers du gouvernement. Et ceux qu’on a licenciés, nettement moins demandés."
                                            },
                                            {
                                                "example_id": "3d5f0c90-fd96-4d4f-8755-776bd2812c15",
                                                "sense_id": "28b4330c-6d20-3ac5-92c2-8640cd83aa6c",
                                                "text": "Un chercheur doit en permanence se remettre en question, quel que soit son âge. On ne détient jamais la vérité entière. Il faut faire ce métier non pas pour soi-même, mais pour essayer de contribuer pour les autres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chercheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "080096a3-e73b-35e0-a99c-19cd770fd562",
                                        "entry_id": "d01e59e0-a76e-3d98-88df-a373621effb8",
                                        "glosses": [
                                            "Petite lunette attachée à un instrument d’observation, typiquement un télescope, pour trouver plus facilement les astres en vue de son observation dans l’instrument principal dont le grossissement plus important rend le repérage difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b974df14-90b2-4f91-979d-998d8951823f",
                                                "sense_id": "080096a3-e73b-35e0-a99c-19cd770fd562",
                                                "text": "Il est peu probable que le chercheur soit parfaitement aligné avec le télescope quand il est neuf ou quand il a voyagé. Or, si cet alignement est imprécis, vous aurez beau mettre l’étoile voulue au centre du chercheur, vous ne la verrez pas dans l’image produite par la caméra."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chercheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fda771d9-6783-3653-914d-a6db23f3efbc",
                                        "entry_id": "1b32124d-4a29-3984-baf1-0a48a0309446",
                                        "glosses": [
                                            "Qui recherche, suit une piste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f381dc-e492-434b-9333-c85ec50efe0a",
                                                "sense_id": "fda771d9-6783-3653-914d-a6db23f3efbc",
                                                "text": "Missile à tête chercheuse."
                                            },
                                            {
                                                "example_id": "2c9961b5-808a-47f0-a723-287c18b1051e",
                                                "sense_id": "fda771d9-6783-3653-914d-a6db23f3efbc",
                                                "text": "C’est un esprit chercheur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
