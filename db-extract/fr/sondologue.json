                        ],
                        "examples": [
                            {
                                "example_id": "05facbca-ab40-4c54-8063-b68abb870e90",
                                "sense_id": "f0b98820-0d3a-34e1-a887-64f6201b997d",
                                "text": "Christophe Büchi est devenu malgré lui un expert ès Röstigraben, un sondologue des turpitudes des âmes suisses."
                            }
                        ]
                    }
