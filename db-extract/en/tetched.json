                        "sense_id": "b3748e85-776e-34fc-9f36-72d42a3be034",
                        "entry_id": "bd0cd973-dfa3-3ba7-a9c5-623010df2a81",
                        "glosses": [
                            "Touched: mildly deranged, somewhat mentally dysfunctional."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "631202b1-4b3f-4164-a2d6-259a84cef930",
                                "sense_id": "b3748e85-776e-34fc-9f36-72d42a3be034",
                                "text": "\"His mind was as keen as a razor, an' as straight-edged, 'xcept jest on one subject. On that he was, so to say, a little—wal—a little tetched.\""
                            },
                            {
                                "example_id": "4860b5dc-9769-4759-b473-dfc7c193bf77",
                                "sense_id": "b3748e85-776e-34fc-9f36-72d42a3be034",
                                "text": "Just because he has trouble with the last verse of the Star Spangled Banner doesn't mean he's tetched. Maybe he has a mental block because you've been hammering him over the skull for three years about it."
                            },
                            {
                                "example_id": "8f817d31-bb0a-41fa-a382-e35524cd1e1f",
                                "sense_id": "b3748e85-776e-34fc-9f36-72d42a3be034",
                                "text": "There's a murderer about, but how can you spot him when everyone is moon-tetched?"
                            }
                        ]
                    },
                    {
                        "sense_id": "470f3d68-aed1-3fe9-88f7-3c8e878f1271",
                        "entry_id": "bd0cd973-dfa3-3ba7-a9c5-623010df2a81",
                        "glosses": [
                            "Touched: physically contacted, impacted, or handled."
                        ],
                        "tags": [
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6ea96213-8e82-4d0c-8650-0c3cf13b0c4d",
                                "sense_id": "470f3d68-aed1-3fe9-88f7-3c8e878f1271",
                                "text": "\"They ain't bin tetched or handled by any one but the Kempany's agents.\""
                            },
                            {
                                "example_id": "54ad0a7d-13b1-49bd-b035-ba32cea5fa84",
                                "sense_id": "470f3d68-aed1-3fe9-88f7-3c8e878f1271",
                                "text": "\"That bullet never tetched ye!\""
                            }
                        ]
                    }
