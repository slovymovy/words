                "senses": [
                    {
                        "sense_id": "5067fc31-6b09-3b09-8792-b14dc053c950",
                        "entry_id": "afc92933-4feb-33eb-be27-d14eb7adfeb8",
                        "glosses": [
                            "ein aus Russland stammendes, alkoholarmes, kohlensäurehaltiges Erfrischungsgetränk, das aus Wasser, Malz, Mehl und anderen Zutaten – hier zumeist aus gegorenem beziehungsweise vergorenem Brot oder aber aus verschiedenen Früchten und Beeren – gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173f2a9b-8ccb-4967-b160-8ac05e920505",
                                "sense_id": "5067fc31-6b09-3b09-8792-b14dc053c950",
                                "text": "„Unter den goldenen Kuppeln der Erlöserkirche, die 1997 auf den Fundamenten einer Schwimmhalle mit Spenden privater Sponsoren wieder errichtet wurde, stehen Rentner an Imbissständen, essen für wenige Rubel Blinis und trinken Kwass, den herben Brottrunk. / Viele können sich nicht einmal den Kwass leisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8454021c-397a-4031-a8f1-26b09a09dd78",
                        "source_entry_id": "afc92933-4feb-33eb-be27-d14eb7adfeb8",
                        "source_sense_id": "5067fc31-6b09-3b09-8792-b14dc053c950",
                        "target_lang_word": "kvass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kvass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b824b704-d946-3a7a-900d-e8fbc356e3ad",
                                        "entry_id": "1775c036-29a0-352b-9426-46f8edde7f7d",
                                        "glosses": [
                                            "A fermented cereal-based low alcoholic beverage, often flavored with fruit, honey and herbs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "254082b4-d74d-4440-87e3-75434e11fc78",
                                                "sense_id": "b824b704-d946-3a7a-900d-e8fbc356e3ad",
                                                "text": "She […] talked constantly, mostly of her childhood, the young ladies’ school she had attended, and the pleasures of Kiev in the summertime.\n“Days are long and hot, but nights are languorous and starlit. People refresh themselves in their flower gardens and some walk in the parks, drink kvass and lemonade, and listen to the symphonies […]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76abca06-f73b-46a7-91bc-2e0282719104",
                        "source_entry_id": "afc92933-4feb-33eb-be27-d14eb7adfeb8",
                        "source_sense_id": "5067fc31-6b09-3b09-8792-b14dc053c950",
