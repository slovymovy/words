                "senses": [
                    {
                        "sense_id": "fcfd665c-6720-3923-a55c-3e1e3ce99562",
                        "entry_id": "0d45b583-4398-31b5-b4ae-5ba39bc70cd8",
                        "glosses": [
                            "To command incompetently."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7149100a-9692-4ad8-93b5-a479a9aaecd0",
                                "sense_id": "fcfd665c-6720-3923-a55c-3e1e3ce99562",
                                "text": "If a Governour make a new Sacrament, I will not obey, because: his command is null, and the thing simply evil. If he miscommand a Circumstance of Time, or Place, or Gesture, I will consider the consequents."
                            },
                            {
                                "example_id": "8622d8dc-cb3f-4e22-a4e3-bde51e9769e2",
                                "sense_id": "fcfd665c-6720-3923-a55c-3e1e3ce99562",
                                "text": "If either the superiors miscommand, or the inferiors disobey, it is an affront to peace."
                            },
                            {
                                "example_id": "b5ce5cc3-2388-4ab0-bf93-0b39d7b5a1c4",
                                "sense_id": "fcfd665c-6720-3923-a55c-3e1e3ce99562",
                                "text": "The truant skipped his drill, but had an eye no man could turn aside or miscommand for where the quarry of his spirit lay."
                            },
                            {
                                "example_id": "151cf2df-33b9-4bb5-9b3f-f0aa78fd8d2c",
                                "sense_id": "fcfd665c-6720-3923-a55c-3e1e3ce99562",
                                "text": "Also at this time we would question the engineers about the failsafe mode that the satellite must go into in case an operator miscommands, or a failure of a redundant system in an attitude control system"
                            }
                        ]
                    }
