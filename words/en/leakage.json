{
    "word_family": [
        "leak",
        "leaky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9c35ed4-ea17-3536-b9a0-7f6a3f467036",
                    "sense_definition": "An act of leaking, or the substance or information that escapes through a leak.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_or_info_escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber was called to investigate a slow water <w>leakage</w> under the kitchen sink.",
                            "target_lang_translations": {
                                "ru": "Сантехника вызвали, чтобы исследовать медленную <w>утечку</w> воды под кухонной раковиной."
                            }
                        },
                        {
                            "text": "The company suffered a major data <w>leakage</w> after their servers were hacked.",
                            "target_lang_translations": {
                                "ru": "Компания пострадала от крупной <w>утечки</w> данных после взлома их серверов."
                            }
                        }
                    ],
                    "synonyms": [
                        "leak",
                        "escape",
                        "spill"
                    ],
                    "common_phrases": [
                        "water leakage",
                        "data leakage",
                        "prevent leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт утечки, либо вещество или информация, уходящие через течь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "жидкости, газа или информации"
                            },
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "проникновение жидкости через отверстие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62ad6a66-16f5-33e1-8b49-877dd3d1085c",
                    "sense_definition": "The quantity or amount of substance or value lost due to a leak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_or_info_escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to measure the total <w>leakage</w> of gas from the pipeline over the last month.",
                            "target_lang_translations": {
                                "ru": "Нам нужно измерить общую <w>утечку</w> газа из трубопровода за последний месяц."
                            }
                        },
                        {
                            "text": "The financial <w>leakage</w> from the project was much higher than initially estimated.",
                            "target_lang_translations": {
                                "ru": "Финансовая <w>утечка</w> из проекта оказалась гораздо выше, чем предполагалось изначально."
                            }
                        }
                    ],
                    "synonyms": [
                        "loss",
                        "wastage"
                    ],
                    "common_phrases": [
                        "measure the leakage",
                        "total leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество или объем вещества или стоимости, потерянные в результате утечки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "объем потерянного вещества или финансов"
                            },
                            {
                                "target_lang_word": "потеря",
                                "target_lang_sense_clarification": "убыль из-за утечки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41de54c-bcc7-3cd7-a352-e1352e6aaeea",
                    "sense_definition": "An undesirable flow of electric current through insulation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_leakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician checked the old wiring for any sign of electrical <w>leakage</w>.",
                            "target_lang_translations": {
                                "ru": "Техник проверил старую проводку на наличие признаков <w>утечки</w> электричества."
                            }
                        },
                        {
                            "text": "High humidity can increase current <w>leakage</w> across the circuit board.",
                            "target_lang_translations": {
                                "ru": "Высокая влажность может увеличить <w>утечку</w> тока по плате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "current leakage",
                        "electrical leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежелательное протекание электрического тока через изоляцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "электрического тока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d86b63e-995f-3915-ad8e-7aaf3d77dfca",
                    "sense_definition": "The loss of revenue generated by tourism to the economies of other countries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "economic_leakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Importing foreign goods for luxury resorts leads to significant economic <w>leakage</w>.",
                            "target_lang_translations": {
                                "ru": "Импорт иностранных товаров для роскошных курортов приводит к значительной экономической <w>утечке</w>."
                            }
                        },
                        {
                            "text": "The government is trying to reduce tourism <w>leakage</w> by encouraging local sourcing.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается сократить <w>утечку</w> доходов от туризма, поощряя закупки у местных производителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic leakage",
                        "tourism leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеря доходов, полученных от туризма, в пользу экономики других стран."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "капитала или доходов в туризме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d55469f9-7c2f-3efd-aa7b-d1367a58e4c0",
                    "sense_definition": "Loss of retail stock, especially due to theft, damage, or administrative errors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "retail_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supermarket chain implemented new security measures to combat inventory <w>leakage</w>.",
                            "target_lang_translations": {
                                "ru": "Сеть супермаркетов ввела новые меры безопасности для борьбы с <w>убылью</w> запасов."
                            }
                        },
                        {
                            "text": "Shoplifting remains the primary cause of stock <w>leakage</w> in retail stores.",
                            "target_lang_translations": {
                                "ru": "Кражи в магазинах остаются основной причиной <w>недостачи</w> товара в розничной торговле."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrinkage",
                        "loss"
                    ],
                    "common_phrases": [
                        "stock leakage",
                        "inventory leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеря розничных запасов, особенно из-за краж, повреждений или административных ошибок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убыль",
                                "target_lang_sense_clarification": "товарных запасов"
                            },
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "активов или запасов"
                            },
                            {
                                "target_lang_word": "недостача",
                                "target_lang_sense_clarification": "товаров в рознице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75976dc1-f20c-342c-b696-b103d9423e98",
                    "sense_definition": "The situation where sound is picked up by a microphone from an unintended source.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "audio_leakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using closed-back headphones helps prevent headphone <w>leakage</w> into the vocal mic.",
                            "target_lang_translations": {
                                "ru": "Использование наушников закрытого типа помогает предотвратить <w>проникновение</w> звука из наушников в вокальный микрофон."
                            }
                        },
                        {
                            "text": "The sound engineer complained about drum <w>leakage</w> on the acoustic guitar track.",
                            "target_lang_translations": {
                                "ru": "Звукорежиссер пожаловался на <w>проникновение</w> звука барабанов в трек акустической гитары."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleed",
                        "spill"
                    ],
                    "common_phrases": [
                        "sound leakage",
                        "headphone leakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, когда звук улавливается микрофоном из нежелательного источника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проникновение",
                                "target_lang_sense_clarification": "нежелательного звука в микрофон"
                            },
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "звукового сигнала"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}