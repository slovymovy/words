                                        "entry_id": "44f043ba-cee6-39b2-a8cf-67b3ceadf813",
                                        "glosses": [
                                            "ville et municipalité autonome du nord-est de la Chine, située sur le golfe de Bohai à 150 km au sud-est de Pékin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50dfc927-173f-475c-9173-f2efd3de1ead",
                                                "sense_id": "77873ee9-7c42-3998-8ad9-c533783075b5",
                                                "text": "Une impressionnante série d’explosions a secoué mercredi 12 août la ville portuaire de Tianjin, dans le nord-est de la Chine."
                                            },
                                            {
                                                "example_id": "be10445d-85b4-4619-85ed-3076263b2abd",
                                                "sense_id": "77873ee9-7c42-3998-8ad9-c533783075b5",
                                                "text": "Tianjin, ville limitrophe de Pékin, a interdit dimanche à ses 14 millions d’habitants de sortir des limites municipales après une augmentation du nombre de cas de COVID-19."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
