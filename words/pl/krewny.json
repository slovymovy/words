                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niedawne badania molekularne wykazały, że najbliższymi <w>krewnymi</w> drozda chińskiego są drozd śpiewak i paszkot.",
                            "target_lang_translations": {
                                "en": "Recent molecular studies showed that the closest <w>relatives</w> of the Chinese thrush are the song thrush and the mistle thrush.",
                                "ru": "Недавние молекулярные исследования показали, что ближайшими <w>сородичами</w> китайского дрозда являются певчий дрозд и деряба.",
                                "nl": "Recent moleculair onderzoek heeft aangetoond dat de zanglijster en de grote lijster de nauwste <w>verwanten</w> zijn van de Chinese lijster.",
                                "de": "Neuere molekulare Untersuchungen haben gezeigt, dass die nächsten <w>Verwandten</w> der Chinesischen Singdrossel die Singdrossel und die Misteldrossel sind.",
                                "fr": "Des études moléculaires récentes ont montré que les plus proches <w>parents</w> de la grive de Verreaux sont la grive musicienne et la grive draine.",
                                "it": "Recenti studi molecolari hanno dimostrato che i <w>parenti</w> più stretti del tordo cinese sono il tordo bottaccio e la tordela.",
                                "cs": "Nedávné molekulární studie ukázaly, že nejbližšími <w>příbuznými</w> drozda čínského jsou drozd zpěvný a brávník.",
                                "tr": "Son moleküler araştırmalar, Çin ardıcının en yakın <w>akrabalarının</w> öter ardıç ve ökse ardıcı olduğunu göstermiştir.",
                                "es": "Estudios moleculares recientes demostraron que los <w>parientes</w> más cercanos del zorzal chino son el zorzal común y el zorzal charlo.",
                                "zh": "最近的分子研究表明，宝兴歌鸫最近的<w>近亲</w>是欧歌鸫和槲鸫。"
                            }
                        },
                        {
                            "text": "Szympans jest najbliższym żyjącym <w>krewnym</w> człowieka.",
                            "target_lang_translations": {
                                "en": "The chimpanzee is the closest living <w>relative</w> of humans.",
                                "ru": "Шимпанзе — ближайший живущий <w>сородич</w> человека.",
                                "nl": "De chimpansee is de nauwste levende <w>verwant</w> van de mens.",
                                "de": "Der Schimpanse ist der nächste lebende <w>Verwandte</w> des Menschen.",
                                "fr": "Le chimpanzé est le plus proche <w>parent</w> vivant de l'Homme.",
                                "it": "Lo scimpanzé è il <w>parente</w> vivente più prossimo dell'uomo.",
                                "cs": "Šimpanz je nejbližším žijícím <w>příbuzným</w> člověka.",
                                "tr": "Şempanze, insanın yaşayan en yakın <w>akrabasıdır</w>.",
                                "es": "El chimpancé es el <w>pariente</w> vivo más cercano del ser humano.",
                                "zh": "黑猩猩是人类现存最近的<w>近亲</w>。"
                            }
                        }
