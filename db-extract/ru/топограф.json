                        "examples": [
                            {
                                "example_id": "0f28ef94-f80e-4bad-8cd6-8bb1d90444ef",
                                "sense_id": "e624852b-8263-3aed-b902-fadd9228ebdf",
                                "text": "Полковник Ахте оставил при себе капитана Кованько; топограф же Карлинов должен был идти со мною через амурские пустынные леса и делать съёмку местности."
                            },
                            {
                                "example_id": "ee0952b2-2d39-43f9-abe7-5eae44adbcd3",
                                "sense_id": "e624852b-8263-3aed-b902-fadd9228ebdf",
                                "text": "Топограф Экспедиции С. А. Янченко при помощи малой мензулы и соответствующего кипрегеля заснял водораздел Уральского хребта, начиная от р. Итьи .. до Сибиряковской дороги."
                            }
                        ]
                    }
