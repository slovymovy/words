                                        "entry_id": "0d2fda19-1a49-31a6-b6d7-bfda16e6d34c",
                                        "glosses": [
                                            "Récipiendaire du grade le plus élevé dans la plupart des ordres de chevalerie dont une croix est l’insigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8eada12-0264-4b6d-bfd0-09767c8b36a0",
                                                "sense_id": "4012c007-a1a3-3cf5-b3ea-bbee680e657a",
                                                "text": "Le corps du grand maître d’Aubusson fut porté à l’église Saint-Jean sur les épaules des principaux grand-croix."
                                            },
                                            {
                                                "example_id": "61a9169c-c65c-4706-ae1c-21085ea43fe2",
                                                "sense_id": "4012c007-a1a3-3cf5-b3ea-bbee680e657a",
                                                "text": "Il fut fait conseiller du conseil de marine et grand-croix de l’ordre de Saint-Louis."
                                            },
                                            {
                                                "example_id": "906b2074-b7dc-40b2-b11c-85c55f240d9a",
                                                "sense_id": "4012c007-a1a3-3cf5-b3ea-bbee680e657a",
                                                "text": "Monsieur Yacha Heifetz, au nom du Président de la République et en vertu des pouvoirs qui nous sont conférés, nous vous faisons Grand-Croix de la Légion d'Honneur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grand-croix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
