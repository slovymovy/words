    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                "word": "wassail",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f06f5c61-9d5b-40a6-b7e6-4fb9c6b6ac73",
                        "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "tags": [
                            "plural"
                        ],
                        "form": "wassails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d47e59f1-9fdc-3020-b890-3083d0122674",
                        "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "glosses": [
                            "A toast to health, usually on a festive occasion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "81c7aff6-5f5d-3471-9646-7329f0c0a3c4",
                        "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "glosses": [
                            "The beverage served during a wassail, especially one made of ale or wine flavoured with spices, sugar, roasted apples, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7bbf94c-0bc9-4d0f-a550-fc4036fcffff",
                                "sense_id": "81c7aff6-5f5d-3471-9646-7329f0c0a3c4",
                                "text": "Add ſugar, nutmeg and ginger, / VVith ſtore of ale too; / And thus ye muſt doe / To make the vvaſſaile a ſvvinger."
                            }
                        ]
                    },
                    {
                        "sense_id": "45a6158d-342c-39ec-a56e-82a2667ed784",
                        "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "glosses": [
                            "Revelry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56754863-6efa-4678-853c-84d326c0665e",
                                "sense_id": "45a6158d-342c-39ec-a56e-82a2667ed784",
                                "text": "In merry wassail he […] peals his loud song."
                            },
                            {
                                "example_id": "29236877-f396-40e9-9081-8fa51c37c6fa",
                                "sense_id": "45a6158d-342c-39ec-a56e-82a2667ed784",
                                "text": "The victors abandoned themselves to feasting and wassail."
                            },
                            {
                                "example_id": "edda2190-7e66-4af9-80fc-fdab6566f707",
                                "sense_id": "45a6158d-342c-39ec-a56e-82a2667ed784",
                                "text": "A blinding light against a garish blue sky made vision difficult, thanks to the previous night's wassail."
                            },
                            {
                                "example_id": "7c96a62c-0d00-40d5-aa79-307953da1aa8",
                                "sense_id": "45a6158d-342c-39ec-a56e-82a2667ed784",
                                "text": "Then as dawn brightened and the day broke\nGrendel's powers of destruction were plain:\ntheir wassail was over, they wept to heaven\nand mourned under morning."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed5936b8-4d6a-3200-be5e-3c6b4e3572e8",
                        "entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "glosses": [
                            "A festive or drinking song or glee."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "013eef49-eb9e-4612-87fe-96a59fec81f6",
                                "sense_id": "ed5936b8-4d6a-3200-be5e-3c6b4e3572e8",
                                "text": "Have you done your wassail? 'Tis a handsome, drowsy ditty, I'll assure you."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72698d17-c17c-45aa-b547-8465198de068",
                        "source_entry_id": "c4c4410d-5404-377b-b392-3ff0f55572e2",
                        "source_sense_description": "beverage served during a wassail",
                        "target_lang_word": "Glühwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glühwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                        "entry_id": "9e2a8689-358f-3a33-9165-45171eb0a1b5",
                                        "glosses": [
                                            "heiß gemachter, gewürzter Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfac94fd-03b5-482f-a3bf-5900a27d44b8",
                                                "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                                "text": "Auf dem Weihnachtsmarkt sind an den Verkaufsständen mit Glühwein meist die längsten Schlangen."
                                            },
                                            {
                                                "example_id": "596f6fd9-63a4-4a80-bb16-614940dc278e",
                                                "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                                "text": "„Sicher wäre es gut, wenn sie ihren Glühwein rasch bekäme, aber er kann ihn noch nicht bestellen, Frau von Teschow hat noch etwas auf dem Herzen.“"
                                            },
                                            {
                                                "example_id": "e9c217ac-066d-462f-af0a-d819b9c02c8c",
                                                "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                                "text": "„Sie finden, daß in Kühtai schlichtweg zuwenig los sei, und bieten ihren Gästen auf eigene Faust ein größeres Freizeitangebot an: Tandemflüge mit Paragleitern, Fackelläufe, kostenlose Skitests, Eisstockschießen, Rodelabende mit Glühwein, Live-Shows von Popsängern und Zauberern.“"
                                            },
                                            {
                                                "example_id": "a5b73cae-a56a-4d8f-a46f-188d5e47019a",
                                                "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                                "text": "„Er hat auch die Grippe, aber ich habe ihn mit einer Kanne Glühwein gestärkt.“"
                                            },
                                            {
                                                "example_id": "b7f4f883-e2a9-46ae-abf4-d533a69976c2",
                                                "sense_id": "36ddcbac-4e4d-34f1-88e9-25d1684c6613",
                                                "text": "„Während Cyprian in Paris mit ihren Freunden von Film und Theater feierte, verbrachte Sylvia mit Adrienne und deren Eltern ein paar ruhige Tage auf dem Land, die kalten Abende gewärmt von Glühwein und einem kräftigen Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
