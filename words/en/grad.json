    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7dc18305-0ede-3a2e-b7ac-a367e2401979",
                    "sense_definition": "A shortened form of <w>graduate</w>, referring to a person who has completed a course of study.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking to hire a recent college <w>grad</w> for the entry-level position.",
                            "target_lang_translations": {
                                "ru": "Компания ищет недавнего <w>выпускника</w> колледжа на начальную позицию."
                            }
                        },
                        {
                            "text": "Many recent <w>grads</w> struggle to find a job immediately after finishing their degrees.",
                            "target_lang_translations": {
                                "ru": "Многие недавние <w>выпускники</w> с трудом находят работу сразу после получения диплома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recent college grad",
                        "high school grad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in North American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова graduate, обозначающая человека, окончившего учебное заведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускник",
                                "target_lang_sense_clarification": "человек, окончивший учебное заведение"
                            },
                            {
                                "target_lang_word": "дипломированный специалист",
                                "target_lang_sense_clarification": "лицо с высшим образованием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e861a42-de9d-369b-9982-29aad81a0937",
                    "sense_definition": "A shortened form of <w>graduation</w>, the ceremony or process of receiving an academic degree.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you planning to attend the <w>grad</w> party after the ceremony tonight?",
                            "target_lang_translations": {
                                "ru": "Ты планируешь пойти на <w>выпускную</w> вечеринку после сегодняшней церемонии?"
                            }
                        },
                        {
                            "text": "She bought a beautiful new dress specifically for her <w>grad</w> night.",
                            "target_lang_translations": {
                                "ru": "Она купила красивое новое платье специально для своего <w>выпускного</w> вечера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grad party",
                        "grad night"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a modifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова graduation, означающая церемонию или процесс получения академической степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускной",
                                "target_lang_sense_clarification": "относящийся к окончанию учебного заведения"
                            },
                            {
                                "target_lang_word": "вручение дипломов",
                                "target_lang_sense_clarification": "церемония окончания обучения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f6158f4-65cd-3732-b468-26058c9b015f",
                    "sense_definition": "An abbreviation of <w>gradian</w>, a unit of measurement for angles equal to one hundredth of a right angle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer switched his calculator from degrees to <w>grads</w> to perform the specific calculation.",
                            "target_lang_translations": {
                                "ru": "Инженер переключил калькулятор с градусов на <w>грады</w>, чтобы выполнить специфический расчет."
                            }
                        },
                        {
                            "text": "In some European countries, the <w>grad</w> is still used as a standard unit for surveying.",
                            "target_lang_translations": {
                                "ru": "В некоторых европейских странах <w>град</w> до сих пор используется как стандартная единица в геодезии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от gradian, единица измерения углов, равная одной сотой прямого угла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "град",
                                "target_lang_sense_clarification": "единица измерения угла"
                            },
                            {
                                "target_lang_word": "гон",
                                "target_lang_sense_clarification": "метрическая единица измерения угла"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5ca38fb0-877d-3bd0-9b93-c7ea2914a0bc",
                    "sense_definition": "A type of Soviet-designed multiple rocket launcher system or a rocket fired from such a system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "The military deployed a <w>Grad</w> rocket launcher to the front lines during the conflict.",
                            "target_lang_translations": {
                                "ru": "Военные развернули ракетную установку «<w>Град</w>» на передовой во время конфликта."
                            }
                        },
                        {
                            "text": "The sound of a <w>Grad</w> salvo is much deeper and louder than smaller mortar attacks.",
                            "target_lang_translations": {
                                "ru": "Звук залпа «<w>Града</w>» гораздо глубже и громче, чем при атаках из небольших минометов."
                            }
                        }
                    ],
                    "synonyms": [
