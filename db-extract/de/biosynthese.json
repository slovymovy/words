                                "example_id": "8437758a-b9b4-415e-a32c-99d81ec1b4e1",
                                "sense_id": "1252d3c2-82b5-385c-b965-7b18fb51258c",
                                "text": "„Trotz der überragenden Bedeutung von Proteinen für fast alle Lebensfunktionen der Zelle ist ihre Biosynthese keineswegs vollständig aufgeklärt.“"
                            },
                            {
                                "example_id": "75359075-cfcb-413b-a3ba-c1110aacaf04",
                                "sense_id": "1252d3c2-82b5-385c-b965-7b18fb51258c",
                                "text": "„Papaverin und die sich von ihm ableitenden Alkaloide entstehen bei der Biosynthese aus zwei Molekülen Dopa, von denen das eine in Dopamin, das andere in 3,4-Dihydroxyphenylacetaldehyd umgewandelt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
