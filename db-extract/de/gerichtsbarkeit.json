                    {
                        "form_id": "2e534b33-40af-49a1-823b-7e64be0266ce",
                        "entry_id": "e3fe3ac5-eda0-36cd-a269-c24e9489e206",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gerichtsbarkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c45e36fd-2cc5-35e0-a590-632fbd6a7f14",
                        "entry_id": "e3fe3ac5-eda0-36cd-a269-c24e9489e206",
                        "glosses": [
                            "Befugnis, Recht zu sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ed7e19-903e-4153-9f1b-afb996e83a0a",
                                "sense_id": "c45e36fd-2cc5-35e0-a590-632fbd6a7f14",
                                "text": "„Sie besitzen sogar eine eigene Gerichtsbarkeit, eigene Kirchenhoheit und eine eigene Polizei.“"
                            },
                            {
                                "example_id": "b0a19b5d-584f-40ad-9186-e5a6c0a6cc85",
                                "sense_id": "c45e36fd-2cc5-35e0-a590-632fbd6a7f14",
                                "text": "„Dalacquas Haus stand unter spanischer Gerichtsbarkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "88a3ca9e-90da-3447-a94a-76b187b85af0",
                        "entry_id": "e3fe3ac5-eda0-36cd-a269-c24e9489e206",
                        "glosses": [
                            "Institutionen der Rechtsprechung und -pflege"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3191d7-c9e3-473d-8553-aa46bcd0620a",
                                "sense_id": "88a3ca9e-90da-3447-a94a-76b187b85af0",
                                "text": "„Aus diesen Grundgesetzartikeln wird nicht nur deutlich, welche fünf selbstständigen Gerichtsbarkeiten bestehen, sondern auch, dass die instanzmäßig höchsten Gerichte in diesen Gerichtsbarkeiten oberste Gerichtshöfe des Bundes sind.“"
                            },
                            {
                                "example_id": "7855a414-f605-4a59-a54c-f0c0d12ab44c",
                                "sense_id": "88a3ca9e-90da-3447-a94a-76b187b85af0",
                                "text": "„Für Bäcker, die zu klein oder mit lebensmittelfremden Materialien buken, sah die Gerichtsbarkeit des Mittelalters prangermäßige Strafen vor, die den derben Volkswitz munter machten.“"
                            },
                            {
                                "example_id": "ed406b8f-8095-4385-8a62-931eae736ca9",
                                "sense_id": "88a3ca9e-90da-3447-a94a-76b187b85af0",
                                "text": "„Die Überlegenheit der Studenten wurde noch dadurch verstärkt, dass sie nicht der Gerichtsbarkeit der Stadt, sondern einer eigenen universitären Jurisdiktion unterstanden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "392939f7-1452-3d11-a904-7b9ff8217888",
                        "entry_id": "e3fe3ac5-eda0-36cd-a269-c24e9489e206",
                        "glosses": [
                            "Ausübung der Rechtsprechung und -pflege"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42c02c1b-e295-47cd-9a8a-c07dba1d1179",
                        "source_entry_id": "e3fe3ac5-eda0-36cd-a269-c24e9489e206",
                        "source_sense_id": "c45e36fd-2cc5-35e0-a590-632fbd6a7f14",
