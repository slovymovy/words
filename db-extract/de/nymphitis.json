                                        "examples": [
                                            {
                                                "example_id": "e7e8571a-5b72-4cfd-ac69-9ea35b48eeb8",
                                                "sense_id": "1cdb331a-714f-3129-86c4-180f4e270137",
                                                "text": "Since the above was written, this case has returned with an amazing change for the better. The tremulousness has disappeared in hands and voice; she has grown at the rate of half an inch a month; she looks bright; walks with a more sprightly, easy gait; her mind is clear and active, and the last vestige of nymphitis has disappeared."
                                            },
                                            {
                                                "example_id": "c953e07c-6a13-493d-b62c-668d725be7e1",
                                                "sense_id": "1cdb331a-714f-3129-86c4-180f4e270137",
                                                "text": "Eighty-four were pus kidney with or without obstruction; on twelve it was found necessary to do a nephrectomy; one case refused nephrectomy, but by dilation and irrigation he has been apparently well and has worked every day for a year. One case with pus in the left kidney and very advanced nymphitis died one year after stopping my irrigations."
                                            }
                                        ]
                                    }
