                        "sense_id": "851045f5-d08a-3a12-8342-e6dcf76ee2d4",
                        "entry_id": "8227c0c8-bb33-35a2-a694-1d85ecbc5a14",
                        "glosses": [
                            "церк. то же, что иподиакон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6818f290-a32d-4403-b980-30b1b80a6283",
                                "sense_id": "851045f5-d08a-3a12-8342-e6dcf76ee2d4",
                                "text": "Провожающие расходились. Переминаясь с ноги на ногу, иподьяконы грели пальцы в рукавах."
                            }
                        ]
                    }
                ],
