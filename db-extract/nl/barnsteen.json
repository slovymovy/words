                    {
                        "sense_id": "97c36c90-efc1-3978-8465-b72ed5c1320a",
                        "entry_id": "54315850-4f46-3eac-b4a1-c98c05d0b103",
                        "glosses": [
                            "fossiele hars (van de den Pinus succinifera) die tot de halfedelstenen wordt gerekend"
                        ],
