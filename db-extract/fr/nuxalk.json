        "fr-extract.jsonl": [
            {
                "entry_id": "fe0f7974-505a-3a74-b362-152bde271ab2",
                "word": "nuxalk",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "56d57f4e-5a88-3626-853c-1dc241cb7236",
                        "entry_id": "fe0f7974-505a-3a74-b362-152bde271ab2",
                        "glosses": [
                            "Langue amérindienne de la famille salish parlée en Colombie-Britannique au Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6dfc5a9-854a-4e58-b868-8cd08fa598d7",
                                "sense_id": "56d57f4e-5a88-3626-853c-1dc241cb7236",
                                "text": "Le centre propose des expositions dynamiques et interactives offertes en trois langues — le nuxalk, l’anglais et le français — afin de souligner l’importance du saumon pour le peuple Nuxalk et d’affirmer son lien profond et historique avec le saumon et les rivières de son territoire traditionnel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ebe9711-9184-4741-a88c-71a37f978b73",
                        "source_entry_id": "fe0f7974-505a-3a74-b362-152bde271ab2",
                        "source_sense_id": "56d57f4e-5a88-3626-853c-1dc241cb7236",
                        "target_lang_word": "Nuxalk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nuxalk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3963dd31-20b7-366f-b80f-66bcd5709885",
                                        "entry_id": "9157dc9c-ec57-3fdf-90e0-84012df2a0e5",
                                        "glosses": [
                                            "An indigenous people of the Central Coast region in British Columbia, centred in the area in and around Bella Coola."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc355d9-cf86-4ce3-8b51-8a358242f64b",
                                                "sense_id": "3963dd31-20b7-366f-b80f-66bcd5709885",
                                                "text": "About 2,500 people live in Bella Coola and the surrounding area. It is the ancient home of the Bella Coola−or Nuxalk−people. When Mackenzie came to this lush place one summer evening in 1793, completing his epic journey across North America, the Nuxalks accepted him, feasted him on roast salmon and provided him lodging."
                                            },
                                            {
                                                "example_id": "31fc2ea5-79d7-4e04-ad4c-3d1b2ba4e883",
                                                "sense_id": "3963dd31-20b7-366f-b80f-66bcd5709885",
                                                "text": "Henson said her team worked closely with the Nuxalk, Haíɫzaqv, Kitasoo/Xai'xais, Gitga'at and Wuikinuxv First Nations to sample and analyze the DNA."
                                            },
                                            {
                                                "example_id": "9c6f7ed0-a8f1-468d-90c6-31aa256890db",
                                                "sense_id": "3963dd31-20b7-366f-b80f-66bcd5709885",
                                                "text": "Chef Ximana Nola Mack grew up in a smokehouse in Bella Coola, B.C., immersed in Nuxalk (nu-halk) and Carrier food traditions, in a family strengthened by fishing, foraging, preparing and eating meals together. Like most Indigenous families, they have felt the intergenerational impacts of these actions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nuxalk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33e8ee30-7f86-3388-9fff-e58b9ecf83c0",
                                        "entry_id": "3d120758-5e32-3f0a-b600-306a8e60d404",
                                        "glosses": [
                                            "Salish language traditionally spoken by the Nuxalk people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "092f76c1-ac05-49c0-b4e7-0189f835cea7",
                                                "sense_id": "33e8ee30-7f86-3388-9fff-e58b9ecf83c0",
                                                "text": "On August 22, 2024, the new Welcome Centre at Snootli Creek Hatchery will officially open. The Centre features dynamic and interactive displays written in three languages: Nuxalk, English and French."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c8fb621-a330-4317-9c33-87db740de54e",
                        "source_entry_id": "fe0f7974-505a-3a74-b362-152bde271ab2",
                        "source_sense_id": "56d57f4e-5a88-3626-853c-1dc241cb7236",
