                    {
                        "translation_id": "a73241e3-eb77-434f-94ad-aa8ab24576cb",
                        "source_entry_id": "aed3211e-912f-3844-bb59-e85803858803",
                        "source_sense_id": "16d14f7f-54f4-3db7-8db9-d936c75b51eb",
                        "source_sense_description": "bepaald soort vinkachtige, Carduelis cannabina",
                        "target_lang_word": "linnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                        "entry_id": "1b25e9dc-9953-3886-bf49-9cda1a27c134",
                                        "glosses": [
                                            "A small passerine bird, the common linnet (Linaria cannabina, syn. Carduelis cannabina), in the finch family Fringillidae, native to Europe, western Asia, and north Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958027e8-d6af-4a1d-baff-bd9ae30a2ea0",
                                                "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                                "text": "⁠I do but sing because I must,\nAnd pipe but as the linnets sing:\nAnd unto one her note is gay,\n⁠For now her little ones have ranged;\n⁠And unto one her note is changed,\nBecause her brood is stol’n away."
                                            },
                                            {
                                                "example_id": "ccb0ec6e-328e-416e-986a-26f77e62277b",
                                                "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                                "text": "I heard a linnet courting\nHis lady in the spring […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac450e52-79c8-3254-8122-599bc1434606",
                                        "entry_id": "1b25e9dc-9953-3886-bf49-9cda1a27c134",
                                        "glosses": [
                                            "A house finch (Haemorhous mexicanus), of North America."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0be6afe0-3932-43f1-85b0-2b48e810a300",
                        "source_entry_id": "aed3211e-912f-3844-bb59-e85803858803",
