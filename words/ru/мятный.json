    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73337e8b-ea4e-368d-8538-f05632196596",
                    "sense_definition": "Приготовленный из мяты или содержащий мяту, с добавлением мяты.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mint_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечером она любит пить горячий <w>мятный</w> чай с мёдом.",
                            "target_lang_translations": {
                                "en": "In the evening, she likes to drink hot <w>mint</w> tea with honey."
                            }
                        },
                        {
                            "text": "В магазине продавалась вкусная <w>мятная</w> жевательная резинка.",
                            "target_lang_translations": {
                                "en": "Tasty <w>mint</w> chewing gum was sold in the store."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мятный чай",
                        "мятная конфета",
                        "мятная паста",
                        "мятный леденец"
                    ],
                    "target_lang_definitions": {
                        "en": "Made from mint or containing mint, with added mint."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mint",
                                "target_lang_sense_clarification": "flavored with or containing mint"
                            },
                            {
                                "target_lang_word": "minty",
                                "target_lang_sense_clarification": "having a taste of mint"
                            },
                            {
                                "target_lang_word": "peppermint",
                                "target_lang_sense_clarification": "specifically made of or flavored with peppermint"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cc5df9f-016c-39e6-b4d8-aa4b4e4830db",
                    "sense_definition": "Обладающий вкусом, запахом или светло-зелёным оттенком, характерным для мяты; освежающий.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mint_qualities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она выбрала для летнего платья нежный <w>мятный</w> цвет.",
                            "target_lang_translations": {
                                "en": "She chose a delicate <w>mint</w> color for her summer dress."
                            }
                        },
                        {
                            "text": "В воздухе отчётливо чувствовался свежий <w>мятный</w> запах.",
                            "target_lang_translations": {
                                "en": "A fresh <w>minty</w> scent was clearly felt in the air."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мятный цвет",
                        "мятный запах",
                        "мятный оттенок"
                    ],
                    "target_lang_definitions": {
                        "en": "Having the taste, aroma, or characteristic light green shade of mint; refreshing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mint",
                                "target_lang_sense_clarification": "referring to the light pastel green color"
                            },
                            {
                                "target_lang_word": "minty",
                                "target_lang_sense_clarification": "smelling, tasting, or looking like mint"
                            },
                            {
                                "target_lang_word": "mint-green",
                                "target_lang_sense_clarification": "having the pale green color of mint"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "627a2623-7d35-3d5e-a18a-409b9b31c84b",
                    "sense_definition": "Связанный с растением <w>мята</w> или с её культивацией.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mint_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе лежали свежие <w>мятные</w> листья для приготовления лимонада.",
                            "target_lang_translations": {
                                "en": "Fresh <w>mint</w> leaves for making lemonade lay on the table."
                            }
                        },
                        {
                            "text": "В саду выделялись аккуратные <w>мятные</w> заросли с пряным ароматом.",
                            "target_lang_translations": {
                                "en": "Neat <w>mint</w> patches with a spicy aroma stood out in the garden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мятные листья",
                        "мятные стебли"
                    ],
                    "target_lang_definitions": {
                        "en": "Related to the mint plant or its cultivation."
