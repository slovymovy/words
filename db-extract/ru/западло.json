                                                "sense_id": "9173d154-a958-3339-b195-039ef22a8368",
                                                "text": "shameful publicity"
                                            },
                                            {
                                                "example_id": "30a2c6dc-4027-4d28-bc71-ef9d66cefce4",
                                                "sense_id": "9173d154-a958-3339-b195-039ef22a8368",
                                                "text": "a shameful act"
                                            },
                                            {
                                                "example_id": "05da18c6-c414-4005-9575-968ceb54d3e8",
                                                "sense_id": "9173d154-a958-3339-b195-039ef22a8368",
                                                "text": "\"They have turned a great old English institution into a shameful clip-joint. It's a shuddering, howling tragedy.\""
