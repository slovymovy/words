                "senses": [
                    {
                        "sense_id": "2e73d2ae-b30e-3570-9671-99accd81f827",
                        "entry_id": "1bd63815-6138-3de4-aad7-9ce310ffc4e6",
                        "glosses": [
                            "das Holz der Zeder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7a416f-7d0e-445d-8f3f-e9ae0034668b",
                                "sense_id": "2e73d2ae-b30e-3570-9671-99accd81f827",
                                "text": "„Als er den Bau des Hauses vollendet hatte, überdeckte er es mit Balken und Brettern aus Zedernholz.“"
                            },
                            {
                                "example_id": "1ee62a73-9cc4-4b45-bb7e-26cd61b61549",
                                "sense_id": "2e73d2ae-b30e-3570-9671-99accd81f827",
                                "text": "„An Waffen besitzen sie sechs Fuß lange Bogen aus Zedernholz, die an einem Ende mit einer kurzen eisernen Spitze versehen sind und auch als Speere verwendet werden können; die Pfeile haben eiserne, steinerne oder knöcherne Widerhaken.“"
                            },
                            {
                                "example_id": "ed0e08f0-12ee-474e-9e39-048049626527",
                                "sense_id": "2e73d2ae-b30e-3570-9671-99accd81f827",
                                "text": "„Bevor Cranmer die Filets an Stäben befestigt, tränkt er das Zedernholz mit Fischblut - \"so kann es nicht brennen\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
