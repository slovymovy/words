{
    "word_family": [
        "denouncement",
        "denunciation",
        "denunciator",
        "denunciatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38a715a7-b1e0-3c17-beea-e015e9a0177e",
                    "sense_definition": "To publicly criticize or speak out against someone or something as being wrong or evil.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The world leaders gathered to <w>denounce</w> the violence and call for immediate peace in the region.",
                            "target_lang_translations": {
                                "ru": "Мировые лидеры собрались, чтобы <w>осудить</w> насилие и призвать к немедленному миру в регионе."
                            }
                        },
                        {
                            "text": "Many citizens chose to <w>denounce</w> the policy after seeing its negative impact on the local community.",
                            "target_lang_translations": {
                                "ru": "Многие граждане решили <w>выступить против</w> этой политики, увидев её негативное влияние на местное сообщество."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "criticize",
                        "decry",
                        "damn"
                    ],
                    "antonyms": [
                        "praise",
                        "commend",
                        "support",
                        "approve"
                    ],
                    "common_phrases": [
                        "denounce the violence",
                        "denounce the policy",
                        "publicly denounce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично критиковать или высказываться против кого-либо или чего-либо, считая это неправильным или злым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "выражать резкое неодобрение"
                            },
                            {
                                "target_lang_word": "обличать",
                                "target_lang_sense_clarification": "раскрывать правду о дурном поступке"
                            },
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "официально или строго критиковать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99523c5b-87de-3189-868a-645adce89047",
                    "sense_definition": "To make a formal or public accusation against someone, often to the authorities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accusation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness decided to <w>denounce</w> his former partner to the authorities to avoid a longer prison sentence.",
                            "target_lang_translations": {
                                "ru": "Свидетель решил <w>донести</w> на своего бывшего партнёра властям, чтобы избежать более длительного тюремного срока."
                            }
                        },
                        {
                            "text": "It was common during the war for neighbors to <w>denounce</w> someone to the police for suspicious activities.",
                            "target_lang_translations": {
                                "ru": "Во время войны соседи часто <w>доносили</w> на кого-либо в полицию за подозрительную деятельность."
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "charge",
                        "discredit"
                    ],
                    "antonyms": [
                        "protect",
                        "defend"
                    ],
                    "common_phrases": [
                        "denounce to the authorities",
                        "denounce a traitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать официальное или публичное обвинение против кого-либо, часто перед властями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доносить",
                                "target_lang_sense_clarification": "сообщать властям о чьей-либо вине"
                            },
                            {
                                "target_lang_word": "обвинять",
                                "target_lang_sense_clarification": "выдвигать официальное обвинение"
                            },
                            {
                                "target_lang_word": "разоблачать",
                                "target_lang_sense_clarification": "вскрывать чьи-либо тайные действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f51433d1-e398-31fd-ab5b-8de7981fa4e1",
                    "sense_definition": "To formally announce the termination or withdrawal from a treaty, agreement, or armistice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government issued a formal notification to <w>denounce</w> the treaty after the terms were repeatedly violated.",
                            "target_lang_translations": {
                                "ru": "Правительство выпустило официальное уведомление, чтобы <w>денонсировать</w> договор после того, как его условия неоднократно нарушались."
                            }
                        },
                        {
                            "text": "If a country decides to <w>denounce</w> the convention, it must provide six months' notice to the other members.",
                            "target_lang_translations": {
                                "ru": "Если страна решит <w>расторгнуть</w> конвенцию, она должна уведомить об этом других участников за шесть месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "proscribe"
                    ],
                    "antonyms": [
                        "ratify",
                        "sign",
                        "uphold"
                    ],
                    "common_phrases": [
                        "denounce the treaty",
                        "denounce the convention"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in legal and diplomatic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально объявить о прекращении действия или выходе из договора, соглашения или перемирия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "денонсировать",
                                "target_lang_sense_clarification": "расторгать международный договор"
                            },
                            {
                                "target_lang_word": "расторгать",
                                "target_lang_sense_clarification": "прекращать действие соглашения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffb7d43c-4010-3449-8a32-217f1530dbeb",
                    "sense_definition": "To announce or proclaim something in a formal or threatening manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient scrolls seemed to <w>denounce</w> wrath upon any who dared to enter the forbidden tomb.",
                            "target_lang_translations": {
                                "ru": "Древние свитки, казалось, <w>провозглашали</w> гнев на любого, кто осмелится войти в запретную гробницу."
                            }
                        },
                        {
                            "text": "The messenger arrived at the gates to <w>denounce</w> war against the neighboring kingdom.",
                            "target_lang_translations": {
                                "ru": "Посланник прибыл к воротам, чтобы <w>объявить</w> войну соседнему королевству."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack"
                    ],
                    "common_phrases": [
                        "denounce war",
                        "denounce wrath"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is largely replaced by 'announce' or 'proclaim' in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять или провозглашать что-либо в официальной или угрожающей манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оглашать",
                                "target_lang_sense_clarification": "официально объявлять"
                            },
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "торжественно объявлять"
                            },
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "предвещать что-то опасное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}