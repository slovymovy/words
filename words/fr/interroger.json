{
    "word_family": [
        "interrogation",
        "interrogatoire",
        "interrogatif",
        "interrogateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a97ea921-2008-3ebb-a369-14ff8f9c4cf2",
                    "sense_definition": "Poser des questions à une personne afin d'obtenir des informations ou de vérifier ses connaissances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "questionner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le policier a décidé d'<w>interroger</w> un témoin après l'accident."
                        },
                        {
                            "text": "Le professeur <w>interroge</w> un élève sur la leçon d'histoire."
                        }
                    ],
                    "synonyms": [
                        "questionner"
                    ],
                    "common_phrases": [
                        "interroger un témoin",
                        "interroger un élève"
                    ]
                },
                {
                    "sense_id": "47691233-96ee-3ebf-947a-4bbc6cc8dc6e",
                    "sense_definition": "Réfléchir profondément sur soi-même, sur ses actes ou sur ses choix moraux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette situation difficile, elle s'<w>interroge</w> sur la décision à prendre."
                        },
                        {
                            "text": "Nous devons nous <w>interroger</w> sur les conséquences de nos actions quotidiennes."
                        }
                    ],
                    "common_phrases": [
                        "s'interroger sur"
                    ]
                },
                {
                    "sense_id": "e06f3e98-c911-3416-94a3-220f007ddfb8",
                    "sense_definition": "Susciter des doutes, inciter à la réflexion ou poser un problème.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce changement soudain d'attitude <w>interroge</w> beaucoup ses proches."
                        },
                        {
                            "text": "Les résultats contradictoires de cette étude <w>interrogent</w> toute l'équipe de recherche."
                        }
                    ],
                    "synonyms": [
                        "poser question",
                        "poser un problème"
                    ]
                },
                {
                    "sense_id": "ac2ab8b3-6e89-32e0-816a-d5ebfd4bdf63",
                    "sense_definition": "Consulter ou analyser attentivement des documents, des faits ou des données pour y trouver des réponses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour mieux comprendre cette époque, les historiens doivent <w>interroger</w> les textes anciens."
                        },
                        {
                            "text": "Le sociologue <w>interroge</w> les statistiques récentes afin de dégager des tendances nettes."
                        }
                    ],
                    "common_phrases": [
                        "interroger les textes"
                    ]
                }
            ]
        }
    ]
}