{
    "word_family": [
        "nagger",
        "nagging",
        "naggy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1f87a20-d2b7-382a-bd10-67be2aca12e7",
                    "sense_definition": "to repeatedly remind or complain to someone in an annoying way, often about insignificant or unnecessary matters",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents always <w>nag</w> me about cleaning my room even when it is already tidy.",
                            "target_lang_translations": {
                                "ru": "Мои родители вечно меня <w>пилят</w> по поводу уборки в комнате, даже когда там и так чисто.",
                                "zh": "即使房间已经很整洁了，我父母还是总是<w>唠叨</w>我打扫房间。"
                            }
                        },
                        {
                            "text": "Stop trying to <w>nag</w> at me to finish my homework because I will do it later.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>ворчать</w> на меня из-за домашнего задания, я сделаю его позже.",
                                "zh": "别再<w>唠叨</w>让我写作业了，我待会儿会写的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ride"
                    ],
                    "common_phrases": [
                        "nag at me",
                        "nag about chores"
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно напоминать о чем-то или жаловаться в раздражающей манере, часто по пустякам",
                        "zh": "指以令人烦恼的方式反复提醒或抱怨某人，通常是关于琐碎或不必要的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилить",
                                "target_lang_sense_clarification": "изводить попрёками"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "придираться",
                                "target_lang_sense_clarification": "делать замечания по мелочам"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить просьбами или жалобами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "指反复说个不停，令人厌烦"
                            },
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "指对细节吹毛求疵"
                            },
                            {
                                "target_lang_word": "埋怨",
                                "target_lang_sense_clarification": "指不断表达不满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                    "sense_definition": "to bother or worry someone with persistent thoughts, memories, or feelings",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental-bother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The feeling that I had forgotten to lock the front door <w>nagged</w> at me all afternoon.",
                            "target_lang_translations": {
                                "ru": "Чувство, что я забыл запереть входную дверь, <w>не давало мне покоя</w> весь день.",
                                "zh": "我忘了锁前门的感觉整个下午都在<w>困扰</w>着我。"
                            }
                        },
                        {
                            "text": "A persistent doubt began to <w>nag</w> him as he reviewed the final contract.",
                            "target_lang_translations": {
                                "ru": "Пока он просматривал финальный контракт, его начало <w>грызть</w> навязчивое сомнение.",
                                "zh": "当他审阅最终合同时，一个挥之不去的疑虑开始<w>折磨</w>着他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "haunt",
                        "worry"
                    ],
                    "common_phrases": [
                        "nag at the mind",
                        "nagging doubt"
                    ],
                    "target_lang_definitions": {
                        "ru": "беспокоить или тревожить навязчивыми мыслями, воспоминаниями или чувствами",
                        "zh": "指以挥之不去的想法、记忆或感觉来困扰或折磨某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "о совести или беспокойстве"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "о навязчивых мыслях"
                            },
                            {
                                "target_lang_word": "не давать покоя",
                                "target_lang_sense_clarification": "о постоянном беспокойстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指思想或情绪上的不安"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指心理上的持续痛苦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                    "sense_definition": "to cause persistent physical pain or discomfort",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical-bother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>nagging</w> pain in his left knee that wouldn't go away after the race.",
                            "target_lang_translations": {
                                "ru": "После забега у него в левом колене появилась <w>нывшая</w> боль, которая никак не проходила.",
                                "zh": "比赛结束后，他左膝盖有一种<w>隐隐作痛</w>的感觉，一直没好。"
                            }
                        },
                        {
                            "text": "The cold wind continued to <w>nag</w> at his face as he walked home.",
                            "target_lang_translations": {
                                "ru": "Холодный ветер продолжал <w>щипать</w> его лицо, пока он шел домой.",
                                "zh": "他走回家时，冷风不断地<w>刺痛</w>着他的脸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worry"
                    ],
                    "common_phrases": [
                        "nagging pain",
                        "nagging injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "причинять постоянную физическую боль или дискомфорт",
                        "zh": "指引起持续的身体疼痛或不适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "о тупой постоянной боли"
                            },
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "о хронической боли"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "о продолжительной боли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隐隐作痛",
                                "target_lang_sense_clarification": "指持续的轻微疼痛"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指持续的身体不适"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3696661-ca87-3b13-99eb-6d25fdca1299",
                    "sense_definition": "a person who frequently complains or reminds others in an annoying way",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoying-person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to work with him because he was such a constant <w>nag</w>.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел с ним работать, потому что он был ужасным <w>ворчуном</w>.",
                                "zh": "没人愿意和他一起工作，因为他是个十足的<w>唠叨鬼</w>。"
                            }
                        },
                        {
                            "text": "She is a bit of a <w>nag</w> when it comes to keeping the kitchen clean.",
                            "target_lang_translations": {
                                "ru": "Она та еще <w>придира</w>, когда дело касается чистоты на кухне.",
                                "zh": "在保持厨房清洁这件事上，她有点<w>挑剔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrew"
                    ],
                    "common_phrases": [
                        "a constant nag",
                        "bit of a nag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe a person in an informal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который постоянно жалуется или раздражающе напоминает о чем-либо",
                        "zh": "指经常以令人烦恼的方式抱怨或提醒他人的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчун",
                                "target_lang_sense_clarification": "тот, кто постоянно недоволен"
                            },
                            {
                                "target_lang_word": "придира",
                                "target_lang_sense_clarification": "тот, кто цепляется к мелочам"
                            },
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "надоедливый человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唠叨鬼",
                                "target_lang_sense_clarification": "指爱唠叨的人"
                            },
                            {
                                "target_lang_word": "挑剔的人",
                                "target_lang_sense_clarification": "指爱找茬的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "662659cb-109c-3a06-9031-30a7400e3e67",
                    "sense_definition": "a repeated complaint, reminder, or instance of nagging",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ignored her usual <w>nags</w> about my driving and kept my eyes on the road.",
                            "target_lang_translations": {
                                "ru": "Я проигнорировал её обычные <w>придирки</w> к моему вождению и не отрывал глаз от дороги.",
                                "zh": "我无视了她对我驾驶习惯的惯常<w>唠叨</w>，继续注视着前方。"
                            }
                        },
                        {
                            "text": "After several <w>nags</w> from his boss, he finally finished the report.",
                            "target_lang_translations": {
                                "ru": "После нескольких <w>напоминаний</w> от босса он наконец закончил отчет.",
                                "zh": "在老板几次<w>催促</w>后，他终于完成了报告。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "usual nags",
                        "constant nags"
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянная жалоба, напоминание или проявление ворчливости",
                        "zh": "指反复的抱怨、提醒或唠叨的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирки",
                                "target_lang_sense_clarification": "мелкие замечания"
                            },
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "нытье",
                                "target_lang_sense_clarification": "постоянные жалобы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "指反复的抱怨"
                            },
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "指琐碎的指责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                    "sense_definition": "a persistent, bothersome thought or worry that stays in the mind",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental-bother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a little <w>nag</w> at the back of his mind telling him he was wrong.",
                            "target_lang_translations": {
                                "ru": "Где-то на задворках сознания его <w>мучила</w> мысль о том, что он неправ.",
                                "zh": "他脑海深处有一个小小的<w>心事</w>，告诉他自己错了。"
                            }
                        },
                        {
                            "text": "The thought of the unpaid bill became a persistent <w>nag</w> throughout the day.",
                            "target_lang_translations": {
                                "ru": "Мысль о неоплаченном счете стала навязчивым <w>беспокойством</w> на весь день.",
                                "zh": "没付账单的想法整天都在<w>困扰</w>着他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "persistent nag",
                        "nag at the back"
                    ],
                    "target_lang_definitions": {
                        "ru": "навязчивая, беспокоящая мысль или тревога",
                        "zh": "指留在脑海中挥之不去的烦人想法或忧虑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "червь сомнения",
                                "target_lang_sense_clarification": "навязчивое подозрение"
                            },
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "тревожная мысль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心事",
                                "target_lang_sense_clarification": "指令人不安的念头"
                            },
                            {
                                "target_lang_word": "忧虑",
                                "target_lang_sense_clarification": "指持续的担心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47d58bd-a485-3eb2-9b76-17624a4009fa",
                    "sense_definition": "an old, worn-out, or useless horse",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "horse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer tried to sell the old <w>nag</w> at the market, but no one wanted it.",
                            "target_lang_translations": {
                                "ru": "Фермер пытался продать старую <w>клячу</w> на рынке, но она никому не была нужна.",
                                "zh": "农夫试图在市场上卖掉那匹<w>老马</w>，但没人想要。"
                            }
                        },
                        {
                            "text": "They used to lure the <w>nags</w> into the truck with oats and sugar.",
                            "target_lang_translations": {
                                "ru": "Раньше они заманивали <w>лошадок</w> в грузовик овсом и сахаром.",
                                "zh": "他们过去常会用燕麦和糖把<w>马</w>引诱到卡车里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hack",
                        "jade",
                        "plug"
                    ],
                    "common_phrases": [
                        "old nag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and often derogatory term for a horse"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старая, изнуренная или бесполезная лошадь",
                        "zh": "指一匹年老、破旧或无用的马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кляча",
                                "target_lang_sense_clarification": "старая больная лошадь"
                            },
                            {
                                "target_lang_word": "одр",
                                "target_lang_sense_clarification": "изнуренная лошадь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老马",
                                "target_lang_sense_clarification": "指年老体衰的马"
                            },
                            {
                                "target_lang_word": "劣马",
                                "target_lang_sense_clarification": "指品质低劣的马"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e187a01-06da-329f-9627-369bf4b9045b",
                    "sense_definition": "a small horse or a pony",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child rode a sturdy little <w>nag</w> across the field.",
                            "target_lang_translations": {
                                "ru": "Ребенок ехал через поле на крепком маленьком <w>пони</w>.",
                                "zh": "孩子骑着一匹结实的小<w>马</w>穿过了田野。"
                            }
                        },
                        {
                            "text": "He kept a small <w>nag</w> in the stable for short trips to the village.",
                            "target_lang_translations": {
                                "ru": "В конюшне он держал небольшую <w>лошадку</w> для коротких поездок в деревню.",
                                "zh": "他在马厩里养了一匹小<w>马</w>，用于去村里的短途旅行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dobbin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage for a healthy pony"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшая лошадь или пони",
                        "zh": "指一匹小马或矮种马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пони",
                                "target_lang_sense_clarification": "маленькая лошадка"
                            },
                            {
                                "target_lang_word": "лошадка",
                                "target_lang_sense_clarification": "небольшая лошадь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小马",
                                "target_lang_sense_clarification": "指体型较小的马"
                            },
                            {
                                "target_lang_word": "矮种马",
                                "target_lang_sense_clarification": "指品种较小的马"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}