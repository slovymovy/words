                ],
                "senses": [
                    {
                        "sense_id": "8d282a43-b9a0-3a8a-bbec-6bf60e311f83",
                        "entry_id": "99f9ac1f-c854-3afb-91c4-890db596fa47",
                        "glosses": [
                            "a surname, Slavin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2034a662-4b22-4d18-9e3a-017e804bd0bd",
                                "sense_id": "8d282a43-b9a0-3a8a-bbec-6bf60e311f83",
                                "text": "2 октября́ 2020 го́да Ири́на Сла́вина соверши́ла акт самосожже́ния пе́ред зда́нием ГУ МВД Росси́и по Нижегоро́дской о́бласти, опубликова́в пе́ред самоуби́йством пост в сети́ Facebook: «В мое́й сме́рти прошу́ вини́ть Росси́йскую Федера́цию».",
                                "translation": "On October 2, 2020, Irina Slavina committed an act of self-immolation in front of the building of the Main Directorate of the Ministry of Internal Affairs of Russia for the Nizhny Novgorod Region, having published a post on Facebook before the suicide: \"I ask you to blame the Russian Federation for my death.\"",
                                "english": "On October 2, 2020, Irina Slavina committed an act of self-immolation in front of the building of the Main Directorate of the Ministry of Internal Affairs of Russia for the Nizhny Novgorod Region, having published a post on Facebook before the suicide: \"I ask you to blame the Russian Federation for my death.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [
            {
                "entry_id": "14439d3d-d072-38c5-a3bf-5c9e8fd2d63e",
                "word": "Славин",
                "pos": "name",
