                        ],
                        "examples": [
                            {
                                "example_id": "24d0ca5f-833b-4f21-a0c1-c0aff4ed1fe3",
                                "sense_id": "6ba6d9c0-7c46-3d8b-96c9-6dcd5988dd6b",
                                "text": "Et ils continuent de giberner, mais un tel sommeil s'était emparé de moi que je m'en allai dormir dans la grange."
                            },
                            {
                                "example_id": "037f405c-5cc0-4da0-9544-19b71ab5aa48",
                                "sense_id": "6ba6d9c0-7c46-3d8b-96c9-6dcd5988dd6b",
                                "text": "Malgré les avions dans le ciel, des états-majors entiers gibernaient sur la place du village."
                            },
                            {
                                "example_id": "f18be26b-f772-4aac-9b45-1935a7bd3f04",
                                "sense_id": "6ba6d9c0-7c46-3d8b-96c9-6dcd5988dd6b",
                                "text": "Les jeunes gens prennent l'habitude de « giberner » ensemble dans un restaurant de la rue Faber près de l’esplanade des Invalides."
                            }
                        ]
