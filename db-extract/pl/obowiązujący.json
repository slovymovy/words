                                    {
                                        "sense_id": "218cd0c2-da30-3a89-8c32-1b0eeda1a756",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
                                        "glosses": [
                                            "Well grounded or justifiable, pertinent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8b44d46-7ecc-4336-9ff5-d60e01e5b446",
                                                "sense_id": "218cd0c2-da30-3a89-8c32-1b0eeda1a756",
                                                "text": "I will believe him as soon as he offers a valid answer."
                                            },
                                            {
                                                "example_id": "e0360332-79c2-481b-89fe-1ca1dcf78257",
                                                "sense_id": "218cd0c2-da30-3a89-8c32-1b0eeda1a756",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86be6a16-0443-37ed-a1a3-5a9f48b913d0",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
                                        "glosses": [
                                            "Acceptable, proper or correct; in accordance with the rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aad4cde-f2df-4767-b893-6c9f9824efdc",
                                                "sense_id": "86be6a16-0443-37ed-a1a3-5a9f48b913d0",
                                                "text": "A valid format for the date is DD/MM/YY."
                                            },
                                            {
                                                "example_id": "125c9b0d-5de8-4bdd-b011-993eb926bf8b",
                                                "sense_id": "86be6a16-0443-37ed-a1a3-5a9f48b913d0",
                                                "text": "Do not drive without a valid license."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd5501a-de2d-3847-98bd-911a0a157d4b",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
                                        "glosses": [
                                            "Related to the current topic, or presented within context, relevant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7977b7c6-1afe-3fcb-8635-a03a72d6a22b",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
                                        "glosses": [
                                            "Of a formula or system: such that it evaluates to true regardless of the input values."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2af760d1-1c43-3555-8462-b495c7e14657",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
                                        "glosses": [
                                            "Of an argument: whose conclusion is always true whenever its premises are true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee924e15-3072-40c6-875c-1eebf149001a",
                                                "sense_id": "2af760d1-1c43-3555-8462-b495c7e14657",
                                                "text": "An argument is valid if and only if the set consisting of both (1) all of its premises and (2) the contradictory of its conclusion is inconsistent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9949fe2-ab97-3c71-9eb1-56e0721d8feb",
                                        "entry_id": "409abdc7-1bbc-35ad-90c1-545d61cb6385",
