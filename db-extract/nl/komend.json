                                ]
                            },
                            {
                                "target_word": "coming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfea65c4-7c56-3da8-ab9b-b59f51470cdc",
                                        "entry_id": "b99c2bd5-86a2-3a2c-b8f2-ecc20e279a4c",
                                        "glosses": [
                                            "The act of arriving; an arrival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a29f25-3b24-49cf-a818-a732a002a296",
                                                "sense_id": "dfea65c4-7c56-3da8-ab9b-b59f51470cdc",
                                                "text": "The/this Sunday coming / coming Sunday."
                                            },
                                            {
                                                "example_id": "b676b24b-aafa-4bbf-b7cb-1d0ad30ddb57",
                                                "sense_id": "dfea65c4-7c56-3da8-ab9b-b59f51470cdc",
                                                "text": "But he found it strange to think […] of all these little things that cluster round the comings, and the stayings, and the goings, that he would know nothing of them, nothing of what they had been, as long as he lived, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba51fc19-bfd4-3bfa-961a-ebe11436267a",
                                        "entry_id": "e25c7d60-e205-352a-b7f1-eefc139a13d3",
                                        "glosses": [
                                            "Approaching; of the future, especially the near future; the next."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8edfd83-d0bf-4254-93fa-a8036810c2c7",
                                                "sense_id": "ba51fc19-bfd4-3bfa-961a-ebe11436267a",
                                                "text": "We expect great things from you this coming year."
                                            },
                                            {
                                                "example_id": "33136f37-0433-4ed2-964a-23f2b451e54d",
                                                "sense_id": "ba51fc19-bfd4-3bfa-961a-ebe11436267a",
                                                "text": "She will have two or three paintings in the coming exhibition."
                                            },
                                            {
                                                "example_id": "bfe081a8-480b-40a2-bdfa-42137a2aa5bc",
                                                "sense_id": "ba51fc19-bfd4-3bfa-961a-ebe11436267a",
                                                "text": "Oh! if you wish that happiness / your coming days and years may bless,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4dbae2e-3acf-3cdd-be81-e08bcfb614b3",
                                        "entry_id": "e25c7d60-e205-352a-b7f1-eefc139a13d3",
                                        "glosses": [
                                            "Newly in fashion; advancing into maturity or achievement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47f2637-59ec-4eef-840d-0c3ef9f9c60c",
                                                "sense_id": "a4dbae2e-3acf-3cdd-be81-e08bcfb614b3",
                                                "text": "Ergonomic wallets are the coming thing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24c8369-7e84-3dda-991f-8b0039b61034",
                                        "entry_id": "e25c7d60-e205-352a-b7f1-eefc139a13d3",
                                        "glosses": [
                                            "Ready to come; complaisant; fond."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4ef186-a34d-462f-b66f-ef6115463dab",
                                                "sense_id": "b24c8369-7e84-3dda-991f-8b0039b61034",
                                                "text": "How coming to the poet every muse!"
                                            },
                                            {
                                                "example_id": "3d158de8-190d-4601-8428-ff075505ab17",
                                                "sense_id": "b24c8369-7e84-3dda-991f-8b0039b61034",
                                                "text": "That he had been so affectionate a husband, was no ill argument to the coming dowager, that he might prove as kind to her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
