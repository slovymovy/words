                "forms": [
                    {
                        "form_id": "c3b7da2f-412a-461f-99d2-2bed3cf3c8e2",
                        "entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
                        "tags": [
                            "plural"
                        ],
                        "form": "acupunctures"
                    },
                    {
                        "form_id": "0ce9f172-3ce5-4492-a611-16d54449b43b",
                        "entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
                        "tags": [],
                        "form": "acuponcture"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fb4e94b-4c2b-3415-865f-12009c9a10e5",
                        "entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
                        "glosses": [
                            "Technique pseudo-scientifique consistant en l’utilisation d'aiguilles réparties sur des points précis du corps dans le but de produire un effet positif sur l'organisme du malade ainsi traité."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "0d4041d8-c22d-4968-af2e-5c7b7d4c33dd",
                                "sense_id": "8fb4e94b-4c2b-3415-865f-12009c9a10e5",
                                "text": "La vogue de l’acupuncture lui fournit l’occasion de donner quelques détails sur ce procédé, usité à la Chine et au Japon, et peut-être trop vite abandonné parmi nous."
                            },
                            {
                                "example_id": "206bee8e-d4f3-4f72-af81-e8249a1141ba",
                                "sense_id": "8fb4e94b-4c2b-3415-865f-12009c9a10e5",
                                "text": "Enfin, de nombreuses approches médicales ou paramédicales sont à disposition pour améliorer la santé des yeux, depuis « le massage yoga jusqu’à l’acupuncture, en passant par le shiatsu, la phytothérapie, l’aromathérapie, la mésothérapie, l’hypnose et les remèdes de grand-mère, à l’instar du sachet de thé noir infusé en cas d’inflammation », liste la docteure Marie-Anne Giacometti dans le livre Comment prendre soin de vos yeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "157f2ad9-24e8-35c8-953a-0938f67097e4",
                        "entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
                        "glosses": [
                            "Opération consistant à introduire une ou plusieurs aiguilles dans la partie douloureuse du corps."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2243dfb-d288-4875-94d1-b0b9e0f80537",
                        "source_entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
                        "target_lang_word": "Akupunktur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akupunktur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac1fb487-f4a6-35e5-b6ac-fc2802285561",
                                        "entry_id": "00cfa3f4-80e5-3353-b661-4af6e9b505e5",
                                        "glosses": [
                                            "traditionelles chinesisches Heilverfahren, bei dem Nadeln in die Haut gestochen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992a8e8f-8ba1-47e8-afa1-2e6f8f32a180",
                                                "sense_id": "ac1fb487-f4a6-35e5-b6ac-fc2802285561",
                                                "text": "Die erste Erwähnung der Akupunktur in Europa findet man im Jahr 1675."
                                            },
                                            {
                                                "example_id": "09f41ce7-d250-44f0-87a3-a951161348a0",
                                                "sense_id": "ac1fb487-f4a6-35e5-b6ac-fc2802285561",
                                                "text": "Um sich das Rauchen abzugewöhnen, will es Beate nun mit Akupunktur versuchen."
                                            },
                                            {
                                                "example_id": "fc17ddcf-b290-4643-acb3-fa4b87770581",
                                                "sense_id": "ac1fb487-f4a6-35e5-b6ac-fc2802285561",
                                                "text": "Die Verspannungen am Rücken versucht der Arzt mit Hilfe der Akupunktur zu lösen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "950c170c-b77b-41c6-bf90-3d280a7c6ffa",
                        "source_entry_id": "39c8206d-0fe9-353a-b3f0-3202f0810be2",
