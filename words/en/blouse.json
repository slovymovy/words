{
    "word_family": [
        "blouson"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc9f89b2-162a-3cbd-a1bb-f25684582964",
                    "sense_definition": "A shirt for women or girls, typically with buttons and a collar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to wear a white <w>blouse</w> with her blue skirt for the interview.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть белую <w>блузку</w> с синей юбкой на собеседование."
                            }
                        },
                        {
                            "text": "The silk <w>blouse</w> felt very soft against her skin.",
                            "target_lang_translations": {
                                "ru": "Шелковая <w>блузка</w> была очень мягкой на ощупь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silk blouse",
                        "white blouse",
                        "sleeveless blouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женская или девичья рубашка, обычно с пуговицами и воротником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блузка",
                                "target_lang_sense_clarification": "женская кофта из легкой ткани"
                            },
                            {
                                "target_lang_word": "блуза",
                                "target_lang_sense_clarification": "разговорный вариант блузки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fc7be0b-6d0a-3b94-ad67-1642bce44617",
                    "sense_definition": "A loose-fitting shirt reaching from the neck to the waist, often worn by workers or artists.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter wore a stained <w>blouse</w> to protect his clothes from oil pigments.",
                            "target_lang_translations": {
                                "ru": "Художник надел испачканную <w>блузу</w>, чтобы защитить одежду от масляных красок."
                            }
                        },
                        {
                            "text": "Traditional European peasants often wore a simple linen <w>blouse</w> while working in the fields.",
                            "target_lang_translations": {
                                "ru": "Традиционные европейские крестьяне часто носили простую льняную <w>блузу</w> во время работы в поле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "artist blouse",
                        "linen blouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободная рубашка длиной от шеи до талии, которую часто носят рабочие или художники."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блуза",
                                "target_lang_sense_clarification": "просторная верхняя рубаха, носимая навыпуск"
                            },
                            {
                                "target_lang_word": "спецодежда",
                                "target_lang_sense_clarification": "в контексте рабочей одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad48118-619e-3fb0-9aec-f6b7968cbd6f",
                    "sense_definition": "A loose-fitting jacket that is part of a military or official uniform.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uniform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier made sure his service <w>blouse</w> was pressed and the buttons were polished.",
                            "target_lang_translations": {
                                "ru": "Солдат позаботился о том, чтобы его служебная <w>гимнастёрка</w> была выглажена, а пуговицы начищены."
                            }
                        },
                        {
                            "text": "He wore a heavy wool <w>blouse</w> as part of his winter dress uniform.",
                            "target_lang_translations": {
                                "ru": "Он носил тяжелый шерстяной <w>китель</w> как часть своей зимней парадной формы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "service blouse",
                        "uniform blouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободная куртка или китель, являющийся частью военной или официальной формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гимнастёрка",
                                "target_lang_sense_clarification": "форменная военная рубашка"
                            },
                            {
                                "target_lang_word": "китель",
                                "target_lang_sense_clarification": "часть форменной одежды"
                            },
                            {
                                "target_lang_word": "мундир",
                                "target_lang_sense_clarification": "военная или официальная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe261cdd-b2c8-30ff-bf27-8bedc6bae89b",
                    "sense_definition": "A short, tight-fitting garment worn under a sari.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor took precise measurements to ensure the sari <w>blouse</w> fit perfectly.",
                            "target_lang_translations": {
                                "ru": "Портной снял точные мерки, чтобы <w>блузка</w> под сари сидела идеально."
                            }
                        },
                        {
                            "text": "She chose a gold-colored <w>blouse</w> to match the embroidery on her wedding sari.",
                            "target_lang_translations": {
                                "ru": "Она выбрала золотистую <w>блузку</w> (чоли) в тон вышивке на своем свадебном сари."
                            }
                        }
                    ],
                    "synonyms": [
                        "bodice"
                    ],
                    "common_phrases": [
                        "sari blouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая, облегающая одежда, надеваемая под сари."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чоли",
                                "target_lang_sense_clarification": "традиционная индийская блузка под сари"
                            },
                            {
                                "target_lang_word": "блузка",
                                "target_lang_sense_clarification": "в контексте индийского костюма"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd77e9ee-66d0-39a9-812f-37bb35d132d6",
                    "sense_definition": "To hang or cause to hang in loose, full folds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "draping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric was designed to <w>blouse</w> over the belt for a relaxed look.",
                            "target_lang_translations": {
                                "ru": "Ткань была задумана так, чтобы <w>свисать напуском</w> над ремнем для создания непринужденного образа."
                            }
                        },
                        {
                            "text": "She adjusted the tunic so it would <w>blouse</w> slightly at the waist.",
                            "target_lang_translations": {
                                "ru": "Она поправила тунику так, чтобы та слегка <w>собиралась складками</w> на талии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blouse over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свисать или заставлять свисать свободными, полными складками (напуском)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напускать",
                                "target_lang_sense_clarification": "делать напуск из ткани"
                            },
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "о ткани, образующей складки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a0a11d-55ee-306d-990b-c96e59c0ae07",
                    "sense_definition": "To tuck the bottoms of trousers into the tops of boots, often using a strap or elastic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant ordered the recruits to <w>blouse</w> their boots before the morning inspection.",
                            "target_lang_translations": {
                                "ru": "Сержант приказал новобранцам <w>заправить брюки</w> в ботинки перед утренним осмотром."
                            }
                        },
                        {
                            "text": "If I fail to <w>blouse</w> my boots properly, I might get a reprimand from the officer.",
                            "target_lang_translations": {
                                "ru": "Если я не смогу правильно <w>заправить штанины</w> в берцы, я могу получить выговор от офицера."
                            }
                        }
                    ],
                    "antonyms": [
                        "unblouse"
                    ],
                    "common_phrases": [
                        "blouse boots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заправлять низ брюк в голенища сапог, часто используя ремешок или резинку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заправлять",
                                "target_lang_sense_clarification": "брюки в сапоги с напуском"
                            },
                            {
                                "target_lang_word": "подтягивать",
                                "target_lang_sense_clarification": "фиксировать штанины над берцами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}