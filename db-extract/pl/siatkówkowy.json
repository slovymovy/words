                    {
                        "translation_id": "1de61c1c-4cd5-452c-8462-1e6a8bdc7c69",
                        "source_entry_id": "4ef0fe58-bf40-3094-beb4-87eb823c250d",
                        "source_sense_id": "0e37cd17-8aa9-327c-970a-f32e434b9120",
                        "target_lang_word": "rétinal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétinal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "064c825d-831c-3dd5-b8c9-0c2eba5eba6d",
                                        "entry_id": "c7fe62e5-4004-3a41-8b2b-9910db6cc6eb",
                                        "glosses": [
                                            "Qui concerne la rétine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7924354d-aa81-4eb2-9e96-35e1db782c27",
                                                "sense_id": "064c825d-831c-3dd5-b8c9-0c2eba5eba6d",
                                                "text": "Plus tard les observations des M. M. Hirschberg et Ostwalt sur l’œdème traumatique ont démontré, que l’œdème de la rétine se répand le long des ramifications des vaisseaux rétinaux comme effet simple du relâchement des parois vasculaires après l’ischémie immédiate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rétinal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e015e856-ac07-3672-ab6f-396e7fb0bcff",
                                        "entry_id": "c02067e1-15d7-3cd8-98cd-9d6c9ef7cf8e",
                                        "glosses": [
                                            "Une des trois formes de la vitamine A (ou rétinol), la forme déshydrogénée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c687a1cb-b568-451c-88da-44165427e170",
                                                "sense_id": "e015e856-ac07-3672-ab6f-396e7fb0bcff",
                                                "text": "Dans l’obscurité le rétinal a une forme courbe, appelé cis-rétinal s’imbriquant dans l’opscine du photopigment. Quand le cis-rétinal absorbe un photon (unité fondamentale de la lumière), il se redresse et prend la forme trans-rétinal."
                                            },
                                            {
                                                "example_id": "25d4f634-05b3-45c6-b6b5-095267e211d6",
                                                "sense_id": "e015e856-ac07-3672-ab6f-396e7fb0bcff",
                                                "text": "Sur plus de 600 caroténoïdes identifiés, seule une cinquantaine environ sont des précurseurs de la vitamine A. Le β-carotène est un précurseur du rétinal (vitamine A), mais beaucoup d'autres comme le lycopène ne sont pas des précurseurs de la vitamine A."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
