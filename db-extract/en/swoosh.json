                                                "text": "Der Zug saust durch die Lande."
                                            },
                                            {
                                                "example_id": "d3d80f9b-bf61-4c8e-bc8f-9851b714ddc0",
                                                "sense_id": "b306e92c-d73a-3f96-a054-49c797157e42",
                                                "text": "Die Granaten sind von morgens bis abends durch die Luft gesaust."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ed49161-c09e-373c-9190-646f3ecef30c",
