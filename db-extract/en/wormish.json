                        "examples": [
                            {
                                "example_id": "ca44b138-a3cd-4de6-85bd-9327f9eea05d",
                                "sense_id": "668eed4d-a5e5-33db-9a45-5c697c7666eb",
                                "text": "He has scarcely time wishfully to choose the prettiest one of the nurses who look curiously down from the windows above when he glides, still wormish, underneath a portcullis, which clangs behind him like the clang of doom, and the elevator slowly ascends."
                            },
                            {
                                "example_id": "218bd712-fdeb-4a98-a989-ad25b2308f72",
                                "sense_id": "668eed4d-a5e5-33db-9a45-5c697c7666eb",
                                "text": "Among his [Darwin's] typically methodical observations of wormish habits was the following: \"Worms do not possess any sense of hearing. They took not the least notice of the shrill notes from a metal whistle, which was repeatedly sounded near them […]"
                            }
