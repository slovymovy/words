                                    },
                                    {
                                        "sense_id": "f94c8704-b49d-33be-880b-ae12ca1721eb",
                                        "entry_id": "d5cec670-6fb0-34cf-ada9-a545336ae2e7",
                                        "glosses": [
                                            "vyzí maso (maso získané z velké ryby vyzy velké)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881c3d1c-f8ae-4bf2-b66a-0e606839adc8",
                                                "sense_id": "f94c8704-b49d-33be-880b-ae12ca1721eb",
                                                "text": "Kterýž nás masem, vínem, vyzinou, rybami a slepicemi dostatečně opatřiti poručil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ece309cd-d93e-3e9c-b365-1009ab1e7195",
                                        "entry_id": "d5cec670-6fb0-34cf-ada9-a545336ae2e7",
                                        "glosses": [
                                            "vyza (velká ryba vyza velká)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08ca66e-0e3c-4566-919f-dd9daa93d2a6",
                                                "sense_id": "ece309cd-d93e-3e9c-b365-1009ab1e7195",
                                                "text": "K ucpání pí častěji teplé podmáslí neb sirovátku. Aneb pí svařenou vodu z ječmenného sladu aneb z měchýře z vyziny (Hausenblase)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
