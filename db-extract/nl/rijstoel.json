                "senses": [
                    {
                        "sense_id": "db95dda7-ae74-3805-985a-64b92f536644",
                        "entry_id": "a9691667-5160-33bb-9616-62bc8e483e6a",
                        "glosses": [
                            "stoel met wielen, waarop iemand die niet in staat is om te lopen, zich kan voortbewegen, of voortbewogen kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19667144-2b9d-465e-951b-f308f389b0f2",
                                "sense_id": "db95dda7-ae74-3805-985a-64b92f536644",
                                "text": "Bloemen, natte woorden en straks een gift voor een rijstoel als Roy iets aan zijn voet had. Ze moesten op de post der nationale liefdadigheid gaan zorgen voor rijstoelen, mooie rijstoelen, waarover je je niet schamen moest, waarvoor men vanzelf eerbied zou tonen, dacht ze."
                            },
                            {
                                "example_id": "11ae1266-c04f-43ba-9629-ced6dfa57706",
                                "sense_id": "db95dda7-ae74-3805-985a-64b92f536644",
                                "text": "Dag voor dag had hij gezien hoe die vreeselijke ziekte een voor een al heur ledematen aangreep en bemeesterde tot er op den duur van haar niets meer overbleef dan een zwak, ellendig schepsel dat schudde en beefde waar het lag of zat. Toen had hij voor haar een rijstoel laten maken waarin ze in den zomer zachtjes voortgestuwd werd door de luwe dreven van zijn woud."
                            }
                        ]
                    }
