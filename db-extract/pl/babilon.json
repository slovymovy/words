                        "entry_id": "3311c97e-b05d-3f41-9df2-1ca69439218d",
                        "glosses": [
                            "starożytne miasto położone w Mezopotamii, dawna stolica Babilonii, obecnie teren Iraku"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "01cfc4c4-d084-482c-9c8d-3630528b192c",
                                "sense_id": "dd8c0303-2662-372c-a0d8-696bacc3939b",
                                "text": "Pierwszego jej unicestwienia dokonał król Nabuchodonozor, który ponadto zniszczył kraj, a jego mieszkańców uprowadził na 70 lat w niewolę do Babilonu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e50b258d-bd56-3cd0-90a3-48abe1fc53c2",
                        "entry_id": "3311c97e-b05d-3f41-9df2-1ca69439218d",
                        "glosses": [
                            "osada śródleśna w Polsce położona w województwie pomorskim, w gminie Chojnice"
                        ],
                        "tags": [],
