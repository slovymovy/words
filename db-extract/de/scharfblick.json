                        "examples": [
                            {
                                "example_id": "9dad7f56-6d03-4aae-9f05-06e8cde8df38",
                                "sense_id": "3bf1d585-0a27-3012-b185-ec2c0acc2e7f",
                                "text": "„Die Wahl gereichte seinem militärisch-seemännischen Scharfblicke wirklich zur Ehre, und ungestört hatte er bereits eine geraume Zeit sein Wesen getrieben.“"
                            }
                        ],
