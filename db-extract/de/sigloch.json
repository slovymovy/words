                ],
                "senses": [
                    {
                        "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                        "entry_id": "311eee5a-50c4-3c9e-8839-8d3d7fb43cbb",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb096dc7-9106-4509-8ea8-9f6e93394a93",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Frau Sigloch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2f2d1cec-42c5-4ea6-ac9d-32eff0fa7117",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Herr Sigloch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6867ef20-a303-436e-b0cd-5fb5b9790db8",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Die Siglochs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bf203671-cd81-4850-924d-c5c1d94afe43",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Der Sigloch trägt nie die Schals, die die Sigloch ihm strickt."
                            },
                            {
                                "example_id": "565e7ae2-704a-4521-bca9-c669d3dc0050",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sigloch kommt, geht der Herr Sigloch.“"
                            },
                            {
                                "example_id": "ae4f9255-9a7c-4c62-8c9c-1a39ae9a7ef7",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Sigloch kommt und geht."
                            },
                            {
                                "example_id": "f11c9497-d17c-46e2-a844-5ba0140881a7",
                                "sense_id": "71bcf7b0-7a62-3e16-aaeb-97a352b83765",
                                "text": "Siglochs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
