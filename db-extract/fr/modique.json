                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b3f4a7-aefd-4343-ba4f-bd3a70101583",
                                "sense_id": "e2d4f175-584a-3fa6-9628-9c85a28e01d1",
                                "text": "[…] il se trouvait logé pour une somme assez modique."
                            },
                            {
                                "example_id": "c8539738-c8c6-43b5-ab96-fbed172a39cc",
                                "sense_id": "e2d4f175-584a-3fa6-9628-9c85a28e01d1",
                                "text": "Leurs rentes étaient trop modiques ; ils craignirent d’y faire mauvaise figure."
                            },
                            {
                                "example_id": "5ff9a54b-58da-4b44-8de3-7e9defbb02bf",
                                "sense_id": "e2d4f175-584a-3fa6-9628-9c85a28e01d1",
                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu’il eut la gentillesse de rendre intelligentes, […]."
                            }
                        ]
                    }
                ],
