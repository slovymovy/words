                                                "sense_id": "715781e6-5c9f-3c29-8add-a8cf1446cca9",
                                                "text": "Mam na imię Stela i jestem astronomką z Olsztyna."
                                            },
                                            {
                                                "example_id": "47c1b355-6d8e-49b7-90d6-3e807f5b0568",
                                                "sense_id": "715781e6-5c9f-3c29-8add-a8cf1446cca9",
                                                "text": "15 sierpnia przypadają imieniny Steli."
                                            },
                                            {
                                                "example_id": "cddb24a9-da5a-4576-85ba-7ad9e97b680e",
                                                "sense_id": "715781e6-5c9f-3c29-8add-a8cf1446cca9",
                                                "text": "Pani Stelo, proszę nas jutro odwiedzić."
                                            }
