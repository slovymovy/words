                                                "sense_id": "e881908a-0356-317b-ae5d-163b5f2fdb31",
                                                "text": "„Nur im Sozialismus ist der Mensch wahrhaft frei und lehnt Pornographie aus tiefster Überzeugung ab.“"
                                            },
                                            {
                                                "example_id": "48265f35-0965-49a9-93b2-92ea599c3efa",
                                                "sense_id": "e881908a-0356-317b-ae5d-163b5f2fdb31",
                                                "text": "„Leider war damals die goldene Morgendämmerung der Pornographie noch nicht in Sicht.“"
                                            },
                                            {
                                                "example_id": "841b56c4-05a3-49c7-8ca9-56cbf8a2e64b",
                                                "sense_id": "e881908a-0356-317b-ae5d-163b5f2fdb31",
                                                "text": "„Ein verwunderliches Angebot, denn ich bin weder Kenner noch Freund noch Besitzer von Pornographien und habe mich auch Schatz gegenüber nie in dieser Richtung geäußert.“"
                                            },
                                            {
                                                "example_id": "dab67e3b-6790-4c45-9892-b6d594edca61",
                                                "sense_id": "e881908a-0356-317b-ae5d-163b5f2fdb31",
                                                "text": "„Und dennoch war es von Pornographie so weit entfernt, wie es nur sein konnte.“"
                                            }
                                        ],
