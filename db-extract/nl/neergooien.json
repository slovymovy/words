        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "c3e39ca0-4df4-3de7-ae54-218503ed4ffa",
                "word": "neergooien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e048c10-6cd0-3cda-99bf-79c5563cd1fd",
                        "entry_id": "c3e39ca0-4df4-3de7-ae54-218503ed4ffa",
                        "glosses": [
                            "op een onzorgvuldige wijze iets op de grond smijten"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b786394-9e1c-416d-bfc8-82997aaa4bbd",
                                "sense_id": "3e048c10-6cd0-3cda-99bf-79c5563cd1fd",
                                "text": "De jonge Bert Tanke liep ook regelmatig mee naar de plaats waar de man het bedrijfsafval dumpte. „Het was destijds een grasveld met een hek ervoor. Die man vertelde dan dat hij de troep er van de KNKS mocht neergooien. Daar is ie zeker een paar jaar mee bezig geweest.” En het is er al die jaren blijven liggen, stelt hij vast. Dat nu die verontreiniging is aangetroffen, verbaast hem dan ook niks."
                            },
                            {
                                "example_id": "9a2d985f-c261-4972-8cfb-308f14ad56c2",
                                "sense_id": "3e048c10-6cd0-3cda-99bf-79c5563cd1fd",
                                "text": "Het zou helpen als mensen stilstaan bij waar ze hun afval neergooien."
                            },
                            {
                                "example_id": "a64d5cbd-ec1f-42a4-aeae-f56be1f1233a",
                                "sense_id": "3e048c10-6cd0-3cda-99bf-79c5563cd1fd",
                                "text": "Hij verdween de kloof in, kwam even later samen met twee andere jongens bij mij zitten en gooide zijn rugzak naast mij neer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9b4c03e-ad4a-4833-ba23-773ee88854ca",
                        "source_entry_id": "c3e39ca0-4df4-3de7-ae54-218503ed4ffa",
                        "source_sense_id": "3e048c10-6cd0-3cda-99bf-79c5563cd1fd",
                        "target_lang_word": "throw down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "throw down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f385508d-4a87-31c5-8d52-767dee21999d",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To cause something one is holding to drop, often forcefully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39a28cc8-c2d2-46bf-b8cd-417403379f4b",
                                                "sense_id": "f385508d-4a87-31c5-8d52-767dee21999d",
                                                "text": "The soldiers threw down their weapons and surrendered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27d5c62-eb48-3de0-8b85-dc0a2d657147",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To destroy or demolish."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1cd5b7-367f-4347-a991-a7243e1f5369",
                                                "sense_id": "c27d5c62-eb48-3de0-8b85-dc0a2d657147",
                                                "text": "to throw down a tower"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb21801f-8cab-365d-90ce-d816be25f371",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To produce or perform (something) admirably or forcefully."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8216e52e-517b-406a-85ab-b341fca1de87",
                                                "sense_id": "bb21801f-8cab-365d-90ce-d816be25f371",
                                                "text": "...this guide tracks the artists and recordings that throw down the funk!"
                                            },
                                            {
                                                "example_id": "c8a4d840-caca-4c33-b560-32514a84ac8f",
                                                "sense_id": "bb21801f-8cab-365d-90ce-d816be25f371",
                                                "text": "“Punch up the rhymes. Throw down some beats. Show off that body. You'll be unstoppable.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c98de7bf-ead6-3da2-aeb3-92a95d925db5",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To accomplish or produce something in a grand, respectable, or successful manner; to \\\"represent\\\"."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a962237-c56f-45cf-9e30-f489b1942e7b",
                                                "sense_id": "c98de7bf-ead6-3da2-aeb3-92a95d925db5",
                                                "text": "Yeah, they could literally throw down. When their sound came out, it was earth-shaking."
                                            },
                                            {
                                                "example_id": "cf6b46e6-3b53-4f34-8c74-ed0bac4ec09a",
                                                "sense_id": "c98de7bf-ead6-3da2-aeb3-92a95d925db5",
                                                "text": "“You're performing for the who's who of radio and records at the Soul Train Awards tonight and you've got to throw down”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc7b0f8-92c0-3543-bfa2-4f52d9ab3596",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To drink a large amount quickly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab9c9b63-56bc-4ef5-9123-c03951c75ac4",
                                                "sense_id": "ffc7b0f8-92c0-3543-bfa2-4f52d9ab3596",
                                                "text": "\"We need to finish these five pitchers in half an hour, so throw down as fast as you can!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To fight; to make a stand."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b335ab1-98b0-4593-9bef-84dcaa455696",
                                                "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                                "text": "Let's you and me 'throw down' right here, right now!"
                                            },
                                            {
                                                "example_id": "a610838d-9a92-4a7d-94cb-0c8f0ead266d",
                                                "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                                "text": "When someone near me at a show called the band My Boring Racket, I was ready to throw down, but for the good sense of an accompanying female..."
                                            },
                                            {
                                                "example_id": "0b2fedc0-7198-4d59-8b3d-26c7947992ed",
                                                "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                                "text": "Today's young and hip black male who fancies himself a radical, who is ready to throw down for the cause, is not talking about neo-colonialism, about global struggle."
                                            },
                                            {
                                                "example_id": "9ede4c41-0a75-4891-966b-f613527c2122",
                                                "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                                "text": "She said no words and was the first to throw down. She stepped up to Dee, and pow!"
                                            },
                                            {
                                                "example_id": "1d7f24e5-56ff-4e3f-b2ba-cab4f56e6454",
                                                "sense_id": "6be041fb-70e7-379f-a04c-926fc9b763f3",
                                                "text": "The time has come. I'm ready to take action. I wanna kick ass and take names later. I wanna throw down, baby boy and baby girl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d86ef72-ae56-32c8-8653-9ff2626b7dc5",
                                        "entry_id": "1033694c-24cb-381c-a665-da97ff795ea9",
                                        "glosses": [
                                            "To make an individual contribution to a group effort (e.g. money pool, collaborative record album)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb079132-20dc-4960-a4d6-4ece2075ee59",
                                                "sense_id": "5d86ef72-ae56-32c8-8653-9ff2626b7dc5",
                                                "text": "\"We're goin' in on a pizza; you in?\" \"Yeah, I'll throw down.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
