                                    {
                                        "sense_id": "d3eced10-8d1b-3895-ba04-e8061b8bdc79",
                                        "entry_id": "4747db9a-4480-3028-956c-8fceff8678d5",
                                        "glosses": [
                                            "Any agent, natural or artificial, that acts to preserve, especially when added to food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c446c235-d1ae-4910-9138-c54010b673a6",
                                                "sense_id": "d3eced10-8d1b-3895-ba04-e8061b8bdc79",
                                                "text": "Salt, sugar, and acid all act as preservatives when making pickles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preservative",
                                "target_lang_code": "en",
