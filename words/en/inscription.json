{
    "word_family": [
        "inscribe",
        "inscriptional",
        "inscriptive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ccd01673-b60c-3212-8f10-3d472b37d30f",
                    "sense_definition": "Text carved or engraved on a surface such as a wall, plaque, memorial, or gravestone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "written_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone monument features a mysterious <w>inscription</w> that historians are still trying to translate.",
                            "target_lang_translations": {
                                "ru": "На древнем каменном монументе высечена таинственная <w>надпись</w>, которую историки до сих пор пытаются перевести."
                            }
                        },
                        {
                            "text": "She paused to read the memorial <w>inscription</w> carved into the base of the statue.",
                            "target_lang_translations": {
                                "ru": "Она остановилась, чтобы прочитать мемориальную <w>надпись</w>, высеченную на постаменте статуи."
                            }
                        }
                    ],
                    "synonyms": [
                        "engraving",
                        "lettering"
                    ],
                    "common_phrases": [
                        "memorial inscription",
                        "stone inscription",
                        "faint inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текст, высеченный или выгравированный на поверхности, такой как стена, табличка, мемориал или надгробие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надпись",
                                "target_lang_sense_clarification": "текст на твердой поверхности"
                            },
                            {
                                "target_lang_word": "эпиграф",
                                "target_lang_sense_clarification": "в контексте архитектурных памятников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af850de-b9f2-3836-a1be-c5164d513486",
                    "sense_definition": "A short message or dedication written by hand in the front of a book or on a gift.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "written_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote a personal <w>inscription</w> on the title page before handing the book back to the fan.",
                            "target_lang_translations": {
                                "ru": "Автор оставил личное <w>посвящение</w> на титульном листе, прежде чем вернуть книгу поклоннику."
                            }
                        },
                        {
                            "text": "I found an old copy of the novel with a handwritten <w>inscription</w> from my grandfather.",
                            "target_lang_translations": {
                                "ru": "Я нашел старый экземпляр романа с рукописной <w>надписью</w> от моего дедушки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "handwritten inscription",
                        "personal inscription",
                        "author inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое сообщение или посвящение, написанное от руки в начале книги или на подарке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надпись",
                                "target_lang_sense_clarification": "рукописная пометка"
                            },
                            {
                                "target_lang_word": "посвящение",
                                "target_lang_sense_clarification": "дарственная надпись"
                            },
                            {
                                "target_lang_word": "дарственная надпись",
                                "target_lang_sense_clarification": "текст на подарке или книге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e2dea9-9e03-3935-b69e-d77550b0875f",
                    "sense_definition": "The specific text or wording stamped onto a coin or medal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "written_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare gold coin bears a Latin <w>inscription</w> around the edge of the emperor's portrait.",
                            "target_lang_translations": {
                                "ru": "На редкой золотой монете вокруг портрета императора идет латинская <w>надпись</w>."
                            }
                        },
                        {
                            "text": "Collectors often look at the coin <w>inscription</w> to determine the exact year and place of minting.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры часто изучают <w>надпись</w> на монете, чтобы определить точный год и место чеканки."
                            }
                        }
                    ],
                    "synonyms": [
                        "legend"
                    ],
                    "common_phrases": [
                        "coin inscription",
                        "latin inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный текст или формулировка, отчеканенная на монете или медали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надпись",
                                "target_lang_sense_clarification": "текст на монете или медали"
                            },
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "нумизматический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b651d83-bc71-331c-b733-8dcf754c9442",
                    "sense_definition": "The formal act of <w>inscribing</w> or entering something onto an official list or record.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administrative_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inscription</w> of the site on the World Heritage list brought many new tourists to the region.",
                            "target_lang_translations": {
                                "ru": "<w>Внесение</w> этого объекта в список Всемирного наследия привлекло в регион много новых туристов."
                            }
                        },
                        {
                            "text": "The committee approved the official <w>inscription</w> of the new members into the society's registry.",
                            "target_lang_translations": {
                                "ru": "Комитет одобрил официальное <w>зачисление</w> новых членов в реестр общества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "official inscription",
                        "formal inscription"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in formal or administrative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный акт внесения или записи чего-либо в официальный список или реестр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внесение",
                                "target_lang_sense_clarification": "в список или реестр"
                            },
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "регистрация в списке"
                            },
                            {
                                "target_lang_word": "регистрация",
                                "target_lang_sense_clarification": "официальный акт"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}