                                        "entry_id": "0eff6ef5-daf9-3038-89a1-87fbf71dba48",
                                        "glosses": [
                                            "middelgebergte in het zuidoosten van België, Noord-Luxemburg en een klein stuk Frankrijk"
                                        ],
                                        "tags": [
                                            "toponiem: gebergte"
                                        ],
                                        "examples": [
                                            {
