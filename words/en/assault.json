                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "в юридическом контексте"
                            },
                            {
                                "target_lang_word": "угроза физическим насилием",
                                "target_lang_sense_clarification": "состав преступления"
                            },
                            {
                                "target_lang_word": "посягательство",
                                "target_lang_sense_clarification": "попытка причинения вреда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
