                "senses": [
                    {
                        "sense_id": "a604a97c-3d25-3faf-af33-0c6f3c746c02",
                        "entry_id": "5dfb7a15-437b-3fa7-a602-6daa045150cd",
                        "glosses": [
                            "unter der Hälfte liegender Anteil der Bevölkerung; nicht überwiegender Teil der Bevölkerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52c3d54-7c4c-4c18-9834-37a9374b27ec",
                                "sense_id": "a604a97c-3d25-3faf-af33-0c6f3c746c02",
                                "text": "„Regierungsgegner solidarisierten sich am Wochenende spontan mit der kurdischen Bevölkerungsminderheit, nachdem Sicherheitskräfte am Freitag einen Kurden auf einer Demonstration in der südöstlichen Provinz Diyarbakir erschossen hatten.“"
                            },
                            {
                                "example_id": "4ef04a5d-2097-4328-8d05-a19c3792ad53",
                                "sense_id": "a604a97c-3d25-3faf-af33-0c6f3c746c02",
                                "text": "„Unter den beiden Parteien der katholisch-irischen Bevölkerungsminderheit findet ein Rollenwechsel statt: Die gemäßigte SDLP-Partei, die eigentliche ‚Erfinderin‘ des Friedensprozesses, muss als Verliererin dieser Wahl betrachtet werden.“"
                            },
                            {
                                "example_id": "38e95450-760f-40f1-a816-7e07af87d60f",
                                "sense_id": "a604a97c-3d25-3faf-af33-0c6f3c746c02",
                                "text": "„Die Uiguren, die die Bevölkerungsminderheit stellen, betrachteten den Militäraufmarsch mit angespannten Gesichtern.“"
                            },
                            {
                                "example_id": "51be3869-c0e6-42ce-b5fd-f23942deb380",
                                "sense_id": "a604a97c-3d25-3faf-af33-0c6f3c746c02",
                                "text": "„Im kaiserlichen Deutschland machte der Anteil der jüdischen Bevölkerungsminderheit etwa 1% der Gesamtbevölkerung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
