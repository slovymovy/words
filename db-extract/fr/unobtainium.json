                                "example_id": "ae33830e-4266-454d-9115-c874cb62119b",
                                "sense_id": "a772d4ad-a842-3b68-b3c1-dfd977211976",
                                "text": "Des supraconducteurs dans des météorites : l'unobtainium d'Avatar à portée de main ?"
                            },
                            {
                                "example_id": "68939c98-81cf-432f-badf-d5a4b14aba54",
                                "sense_id": "a772d4ad-a842-3b68-b3c1-dfd977211976",
                                "text": "L'histoire de l'Unobtanium, le matériau qui explique toutes les histoires de nos films de science-fiction, d'Avatar à X-Men"
                            }
                        ]
