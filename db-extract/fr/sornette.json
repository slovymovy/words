        "fr-extract.jsonl": [
            {
                "entry_id": "e367f23b-90b7-30aa-bb84-4bd8280e4afd",
                "word": "sornette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20f44631-cd85-4f63-ac62-0598a5eac0ba",
                        "entry_id": "e367f23b-90b7-30aa-bb84-4bd8280e4afd",
                        "tags": [
                            "plural"
                        ],
                        "form": "sornettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                        "entry_id": "e367f23b-90b7-30aa-bb84-4bd8280e4afd",
                        "glosses": [
                            "Propos frivole, bagatelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c41b8bd-7a0b-4a00-9837-714c4bc8f09c",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "Il est à peine croyable que ces sornettes aient fourni pâture à des hommes auxquels la sagacité ne faisait pas entièrement défaut."
                            },
                            {
                                "example_id": "93b99677-08c1-4996-925d-85b617adb68c",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "Femme d’affaires redoutable, Ivanka est à la tête de plusieurs sociétés qui utilisent des sous-traitants chinois peu respectueux des droits de l’homme et autres sornettes."
                            },
                            {
                                "example_id": "0f18d1be-9709-4b43-b9d4-00b3081df4f6",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "LA LÉZARDIÈRE.- Allons, mon cher, laissons là nos perruques et toutes ces sornettes."
                            },
                            {
                                "example_id": "68b4b7b4-7443-4157-9b9e-062fa6d7b70b",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "C’était une femme du vieux temps qui fréquentait encore l’église et croyait aux sornettes d’Andrei Potocki, le curé."
                            },
                            {
                                "example_id": "b8b1a16e-694b-4383-81be-8324532b44a8",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "Ce fut, pêle-mêle, l’ingratitude des concitoyens plus enclins à débiner les chaussettes à clous qu'à les soutenir, les manies exaspérantes du margis Barguinoux et les sornettes lourdingues du juteux Pénardin, la promotion qui ne viendrait jamais, je ne sais quoi encore, […]."
                            },
                            {
                                "example_id": "eca112ae-96c0-4fc4-a728-93f0b44a6c10",
                                "sense_id": "df5da7b0-e66c-3ace-82f4-a3da4bdd379c",
                                "text": "Elle se levait à quatre heures du matin pour regarder des vidéos antivaccins. Elle lisait tout ce qui s’écrivait sur le sujet, la moindre sottise, la moindre sornette."
                            }
                        ]
                    },
                    {
                        "sense_id": "47bf1897-d9ee-3421-a7f9-04f733c5523a",
                        "entry_id": "e367f23b-90b7-30aa-bb84-4bd8280e4afd",
                        "glosses": [
                            "Surnom ; sobriquet."
                        ],
                        "tags": [
                            "Berry",
                            "Sologne"
                        ],
                        "examples": [
                            {
                                "example_id": "a615279c-6f95-43ff-82ec-ef9c190d8ab6",
                                "sense_id": "47bf1897-d9ee-3421-a7f9-04f733c5523a",
                                "text": "[…] Tous ces hommes d'ailleurs, (…) parmi lesquels se recrutait une main-d'œuvre occasionnelle, avaient ainsi leur sobriquet, leur sornette comme on dit en Sologne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e8d0fad-685f-484d-ae76-d306fbb93da1",
                        "source_entry_id": "e367f23b-90b7-30aa-bb84-4bd8280e4afd",
                        "target_lang_word": "twaddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "Empty or silly idle talk or writing; nonsense, rubbish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c6d97c-9ef2-4685-aad9-136266240963",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "You're talking a load of twaddle. Get your facts straight, man!"
                                            },
                                            {
                                                "example_id": "ca87bb01-20fb-41b1-8a3e-77539214a92c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "\"What ineffable twaddle!\" I cried, slapping the magazine down on the table; \"I never read such rubbish in my life.\""
                                            },
                                            {
                                                "example_id": "e6dd98eb-0953-479f-9298-ae517b816273",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I would rather be rude than to listen to twaddle from a man I’ve known."
                                            },
                                            {
                                                "example_id": "f834bbe0-13d3-489d-bef1-0d2aba51677f",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "It was her other self who had written that letter. It not only bored, it rather disgusted her real self. \"Flippant and silly,\" said her real self. Yet she knew that she'd send it and she'd always write that kind of twaddle to Nan Pym."
                                            },
                                            {
                                                "example_id": "12949f06-1ab1-4bc4-87c1-99fcf75c6a8c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I improvised for three or four minutes, speaking complete twaddle in character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ca7b9f-92b1-38c8-bfbc-df1bbe47b3aa",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "One who twaddles; a twaddler."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                        "entry_id": "8b75e73d-354c-3d2b-b86b-71cae2344415",
                                        "glosses": [
                                            "To talk or write nonsense; to prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4a32-5ae8-425a-bfef-b30f4fed617e",
                                                "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
