{
    "word_family": [
        "ruim",
        "ruimte",
        "verruiming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9547cd2-213c-373e-8c56-043b9d390a9d",
                    "sense_definition": "Groter, breder of ruimer maken van een fysieke opening of ruimte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_verruimen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gebruikte een boor om het gat wat te <w>verruimen</w>.",
                            "target_lang_translations": {
                                "en": "He used a drill to <w>widen</w> the hole a bit."
                            }
                        },
                        {
                            "text": "We moeten de doorgang <w>verruimen</w> zodat de meubels erdoor passen.",
                            "target_lang_translations": {
                                "en": "We need to <w>widen</w> the passage so the furniture can fit through."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergroten",
                        "verbreden",
                        "verwijden"
                    ],
                    "antonyms": [
                        "vernauwen",
                        "verkleinen"
                    ],
                    "common_phrases": [
                        "een gat verruimen",
                        "de doorgang verruimen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a physical opening or space larger, wider, or more spacious."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "widen",
                                "target_lang_sense_clarification": "to make a physical opening or passage broader"
                            },
                            {
                                "target_lang_word": "enlarge",
                                "target_lang_sense_clarification": "to make a physical space or hole bigger"
                            },
                            {
                                "target_lang_word": "broaden",
                                "target_lang_sense_clarification": "to make physically wider"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c6a4062-b080-3781-addd-f9fa5e16e900",
                    "sense_definition": "Regels, wetten of mogelijkheden minder streng maken of voor meer mensen openstellen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_verruimen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering besloot de regels voor gezinshereniging te <w>verruimen</w>.",
                            "target_lang_translations": {
                                "en": "The government decided to <w>relax</w> the rules for family reunification."
                            }
                        },
                        {
                            "text": "Zij ging handtekeningen verzamelen voor het <w>verruimen</w> van het kinderpardon.",
                            "target_lang_translations": {
                                "en": "She started collecting signatures to <w>broaden</w> the scope of the amnesty for children."
                            }
                        }
                    ],
                    "synonyms": [
                        "versoepelen",
                        "uitbreiden"
                    ],
                    "antonyms": [
                        "verstrengen",
                        "beperken"
                    ],
                    "common_phrases": [
                        "de regels verruimen",
                        "het beleid verruimen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make rules, laws, or possibilities less strict, or to open them up to more people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relax",
                                "target_lang_sense_clarification": "to make rules or regulations less strict"
                            },
                            {
                                "target_lang_word": "broaden",
                                "target_lang_sense_clarification": "to expand the scope of rules or criteria"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "to make restrictions less severe"
                            },
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "to increase the scope or possibilities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1c3a3ac-757c-308b-b6de-41d844bb8116",
                    "sense_definition": "Zichzelf verbreden of groter worden, vaak in figuurlijke of geestelijke zin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk_verruimen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Terwijl mijn innerlijke ruimte zich <w>verruimde</w>, nam ook de gevoelskwaliteit toe.",
                            "target_lang_translations": {
                                "en": "As my inner space <w>expanded</w>, the quality of my feelings also increased."
                            }
                        },
                        {
                            "text": "Zijn blikveld <w>verruimde</w> zich naarmate hij meer van de wereld zag.",
                            "target_lang_translations": {
                                "en": "His horizon <w>broadened</w> as he saw more of the world."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbreden",
                        "ontplooien"
                    ],
                    "antonyms": [
                        "vernauwen",
                        "krimpen"
                    ],
                    "common_phrases": [
                        "de geest verruimen",
                        "de blik verruimen"
                    ],
                    "target_lang_definitions": {
                        "en": "To broaden or expand oneself, often in a figurative, mental, or spiritual sense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "broaden",
                                "target_lang_sense_clarification": "to expand one's mind, horizon, or perspective"
                            },
                            {
                                "target_lang_word": "expand",
                                "target_lang_sense_clarification": "to grow or increase in mental or spiritual capacity"
                            },
                            {
                                "target_lang_word": "widen",
                                "target_lang_sense_clarification": "to increase the scope of one's view or perspective"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}