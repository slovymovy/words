                "senses": [
                    {
                        "sense_id": "8806813c-8e66-3b55-a3f0-f00774281351",
                        "entry_id": "61ac355c-59cc-3fd6-900b-01a9a2b43b61",
                        "glosses": [
                            "Gruppe von Sprachen, die bestimmte lautliche und/oder grammatische Eigenschaften gemeinsam haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7de0f1-0daf-4e13-9b9c-c408ceb0ef57",
                                "sense_id": "8806813c-8e66-3b55-a3f0-f00774281351",
                                "text": "Einer von mehreren Sprachtypen sind die flektierenden Sprachen."
                            },
                            {
                                "example_id": "b286711f-dfad-4bdb-9d90-1c9943fc70ed",
                                "sense_id": "8806813c-8e66-3b55-a3f0-f00774281351",
                                "text": "„Unseres Erachtens ist es am zweckmäßigsten, fünf Sprachtypen zu unterscheiden. Die zumeist herkömmlichen Bezeichnungen dieser Typen sind: isolierender (analytischer), agglutinierender, flektierender, introflexiver und polysynthetischer Typ.“"
                            },
                            {
                                "example_id": "b35febba-03ca-48de-a42e-9324b3c682de",
                                "sense_id": "8806813c-8e66-3b55-a3f0-f00774281351",
                                "text": "„Diesem Sprachtyp entsprechen insbesondere die indoeuropäischen Sprachen…“"
                            },
                            {
                                "example_id": "b81c07a5-2d2f-4540-9e23-2bd0c90ae36d",
                                "sense_id": "8806813c-8e66-3b55-a3f0-f00774281351",
                                "text": "„Der Grund für diese Divergenz dürfte im Sprachtyp zu sehen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
