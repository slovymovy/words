                            }
                        },
                        {
                            "text": "<w>Vanochtend</w> vroeg was het nog erg koud buiten.",
                            "target_lang_translations": {
                                "en": "Early <w>this morning</w> it was still very cold outside.",
                                "ru": "Рано <w>сегодня утром</w> на улице было ещё очень холодно.",
                                "pl": "Wczesnym <w>rankiem</w> na zewnątrz było jeszcze bardzo zimno.",
                                "de": "<w>Heute Morgen</w> früh war es draußen noch sehr kalt.",
                                "fr": "<w>Ce matin</w> tôt, il faisait encore très froid dehors.",
                                "it": "<w>Stamattina</w> presto faceva ancora molto freddo fuori.",
                                "cs": "<w>Dnes brzy ráno</w> byla venku ještě velká zima.",
                                "tr": "<w>Bu sabah</w> erkenden dışarısı hala çok soğuktu.",
                                "es": "<w>Esta mañana</w> temprano todavía hacía mucho frío fuera.",
                                "zh": "<w>今天早上</w>很早的时候，外面还是很冷。"
                            }
