                        "examples": [
                            {
                                "example_id": "a44c80f2-fa55-457f-8248-0d0d42d0eded",
                                "sense_id": "34b6d879-a2fa-3300-bb9e-e3dd9eb84b83",
                                "text": "La DCA allemande ouvre le feu avec une furie invraisemblable."
                            },
                            {
                                "example_id": "cd900daa-c86c-450f-9e0c-d29fa82cba51",
                                "sense_id": "34b6d879-a2fa-3300-bb9e-e3dd9eb84b83",
                                "text": "Pendant notre parachutage, deux chasseurs sont descendus par la DCA, un Bearcat et un Hellcat de l’Aéronavale."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b83405c-27cd-3d5e-92fd-060b5c832fb4",
                        "entry_id": "d661f939-9021-3c09-a952-51f77d040197",
                        "glosses": [
                            "Abréviation de division cellulaire asymétrique."
                        ],
                        "tags": [],
