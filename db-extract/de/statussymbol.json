                "senses": [
                    {
                        "sense_id": "049260e0-9ebf-32db-bbe7-5d0e2a3d760d",
                        "entry_id": "986702f6-7e61-3bab-89d0-60c40091320d",
                        "glosses": [
                            "etwas, mit dem jemand seine besondere Stellung in der Gesellschaft betonen will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc28bd2-0116-41f4-bf41-f5699be4ddab",
                                "sense_id": "049260e0-9ebf-32db-bbe7-5d0e2a3d760d",
                                "text": "„Das Haus als Statussymbol der Fulbe – das fand ich interessant, denn traditionell sind sie ein Nomadenvolk.“"
                            },
                            {
                                "example_id": "6baa40c5-0914-455d-a56e-b0e46efe8ffe",
                                "sense_id": "049260e0-9ebf-32db-bbe7-5d0e2a3d760d",
                                "text": "„In Deutschland fallen die paar Pfunde über dem Gürtel nicht auf, in Äthiopien, wo ein Bäuchlein Statussymbol und das untrügliche Zeichen eines gewissen Wohlstands ist, schon.“"
                            },
                            {
                                "example_id": "09360e19-3ee9-47df-ad0c-193df893b566",
                                "sense_id": "049260e0-9ebf-32db-bbe7-5d0e2a3d760d",
                                "text": "„In hallstattzeitlichen Fürstengräbern hat man bislang über 300 einachsige Wagen entdeckt, die dem Toten als Statussymbole begegeben wurden.“"
                            },
                            {
                                "example_id": "0ffc251c-883f-4299-952b-b9f2bdba1438",
                                "sense_id": "049260e0-9ebf-32db-bbe7-5d0e2a3d760d",
                                "text": "„Solaranlagen waren erst Öko-Schnickschnack, dann Statussymbol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
