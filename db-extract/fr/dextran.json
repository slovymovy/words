                "senses": [
                    {
                        "sense_id": "8a1aa597-fe70-3333-8771-22ea9b485bcb",
                        "entry_id": "67afa556-e4f6-33da-9a63-0324cf91f0ba",
                        "glosses": [
                            "Polysaccharide obtenu en faisant agir la bactérie Leuconostoc mesenteroides sur une solution de glucose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a296827-2252-48f0-bf0d-3176deeb1a7f",
                                "sense_id": "8a1aa597-fe70-3333-8771-22ea9b485bcb",
                                "text": "Le dextran est obtenu en faisant agir une bactérie Leuconostoc mesenteroides sur des solutions stériles de glucose."
                            },
                            {
                                "example_id": "491374bf-9359-422c-a6f0-14d64ccfe28a",
                                "sense_id": "8a1aa597-fe70-3333-8771-22ea9b485bcb",
                                "text": "Chez 6 rats sur 10, un oedème est apparu, caractéristique de l’action perméabilisante du dextran au niveau des vaisseaux tégumentaires."
                            },
                            {
                                "example_id": "409ffd86-5a3f-4035-b82d-77973e5dfc75",
                                "sense_id": "8a1aa597-fe70-3333-8771-22ea9b485bcb",
                                "text": "Le dextran est inerte et, à cause de sa taille, ne peut diffuser d’une cellule à l’autre, ce qui permet à cette substance de remplir deux des conditions d’un bon marqueur cellulaire, la spécificité et l’innocuité."
                            }
                        ]
                    }
