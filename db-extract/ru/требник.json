                                            {
                                                "example_id": "ffdba124-0996-42a2-a96c-028e4ff41e13",
                                                "sense_id": "ec651822-2bd0-357d-b1d4-a54213733b3c",
                                                "text": "Das hier ist ein Brevier für gutes Benehmen."
                                            },
                                            {
                                                "example_id": "d95bd763-a20a-4f18-9fd1-9d8c6fbf6b62",
                                                "sense_id": "ec651822-2bd0-357d-b1d4-a54213733b3c",
                                                "text": "„Das Laoner Brevier war eine Sammlung von praktischen Verhaltungsmaßregeln auf der Flucht und von Erfahrungen, die von den Emigranten auf der Via Dolorosa untereinander weitergegeben wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3c0658e-fb43-435d-b2f2-244b00184ea7",
                        "source_entry_id": "427ed24c-8a3e-38e8-be61-7ac082c424e4",
                        "source_sense_id": "0b2c512e-072c-3354-90e8-88587c1cfd6e",
                        "target_lang_word": "Gebetbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebetbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                        "entry_id": "746f2ae5-e83b-3a2a-be8e-270d0804305e",
                                        "glosses": [
                                            "Buch mit Gebeten, vor allem für die Verwendung im Gottesdienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3abe406d-125a-4810-ac93-191725e55f43",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Das so lange erwartete gemeinsame Gebet- und Gesangbuch für die katholischen Gemeinden im deutschen Sprachbereich, das »Gotteslob«, liegt nun vor.“"
                                            },
                                            {
                                                "example_id": "98ca9127-0eca-4e3e-b524-f5b89f88cac9",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Sie hielt ihr Gebetbuch in der Hand.“"
                                            },
                                            {
                                                "example_id": "ddbf5500-c89c-4b6a-8212-093305d84a4c",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Jüdische Druckereien machten ihren größten Umsatz mit dem Verlegen von Gebetbüchern und mit traditionellen religiösen Werken.“"
                                            },
                                            {
                                                "example_id": "803134b8-1642-4bc9-92ab-e2a34cdd4756",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Prinzessin Marja wagte sie nicht zu fragen, zog die Tür wieder hinter sich zu, setzte sich bald mit dem Gebetbuch in ihren Lehnstuhl und kniete bald vor dem Schrein mit den Heiligenbildern.“"
                                            }
                                        ],
