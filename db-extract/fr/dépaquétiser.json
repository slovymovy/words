                "senses": [
                    {
                        "sense_id": "c69e286a-6236-3983-907e-6036c1d85d18",
                        "entry_id": "10888b64-5154-3906-be38-5fb44bb31e50",
                        "glosses": [
                            "Reconstituer ce qui avait découpé en morceaux (paquets)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ea3528-dd12-4810-adfe-7f2441ec6cc9",
                                "sense_id": "c69e286a-6236-3983-907e-6036c1d85d18",
                                "text": "Le temps de remplissage étant constant et très court, il n'y a pas de perte de temps à paquétiser et dépaquétiser l'information."
                            },
                            {
                                "example_id": "8b068f24-b4be-4013-a7e9-9ba2a800924e",
                                "sense_id": "c69e286a-6236-3983-907e-6036c1d85d18",
                                "text": "un décodeur par système, couplé au décodeur par canal, pour dépaquétiser le premier signal codé reçu décodé par canal à l'aide d'un format de paquet MPEG 2 ;"
                            },
                            {
                                "example_id": "cc0527c4-8abe-4169-ba22-e389666b24e2",
                                "sense_id": "c69e286a-6236-3983-907e-6036c1d85d18",
                                "text": "au moins une interface de données en paquets (240) pour paquétiser le flux de données en paquets de réception produisant un flux de paquets de réception, et pour dépaquétiser un flux de paquets de transmission en le flux de données en paquets de transmission ;"
                            }
                        ]
                    }
