                                "sense_id": "74d2aebe-373d-3ba2-b0e6-656e7835c046",
                                "text": "You great fat, blasted, blear-eyed, blundering, thundering, brainless, God-forsaken, doddering, damned fool!"
                            },
                            {
                                "example_id": "095da7df-d710-4c74-84be-fc4eebf81f39",
                                "sense_id": "74d2aebe-373d-3ba2-b0e6-656e7835c046",
                                "text": "Treat the doddering old fool with sympathy."
                            },
                            {
                                "example_id": "352f3626-a0a0-4f39-ad39-9a0083807e20",
                                "sense_id": "74d2aebe-373d-3ba2-b0e6-656e7835c046",
                                "text": "She treats him not as a doddering old fool but as a man hampered in his movements by injury."
                            }
                        ]
                    }
