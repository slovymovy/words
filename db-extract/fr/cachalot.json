        "fr-extract.jsonl": [
            {
                "entry_id": "aaf686f8-fb16-3bda-b169-1d44bb0b2970",
                "word": "cachalot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd21a7e2-7731-400f-8f77-ae3abafdf1b1",
                        "entry_id": "aaf686f8-fb16-3bda-b169-1d44bb0b2970",
                        "tags": [
                            "plural"
                        ],
                        "form": "cachalots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                        "entry_id": "aaf686f8-fb16-3bda-b169-1d44bb0b2970",
                        "glosses": [
                            "Espèce de mammifère marin, cétacé à dents à grosse tête carrée, de la famille des physétéridés."
                        ],
                        "tags": [
                            "Cétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e87a48c4-c1ef-42a8-8b66-11bda427d537",
                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                "text": "Pendant que sous la mer profonde\nLes cachalots et les requins\nCes écumeurs géants de l’onde\nLibres dévorent le fretin\nNous autres cloués à la rive\nOù la bourrasque a rejeté\nNotre barque un instant rétive\nNous pleurons notre liberté."
                            },
                            {
                                "example_id": "120bfb33-389d-4fcf-b4db-23b4c28a8814",
                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                "text": "Lorsque la marée se retire, on voit des écueils à perte de vue sortant des flots leurs dos de monstres, tout reluisants et blanchis d’écume, comme des cachalots gigantesques échoués."
                            },
                            {
                                "example_id": "1a4766fe-e1d2-44f7-9c32-1f3908b0d82b",
                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                "text": "Vers le soir, j’aperçois un cachalot qui disparaît vers l’Ouest."
                            },
                            {
                                "example_id": "3963a8cf-edf9-49a5-b073-d5749e75e9b7",
                                "sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                                "text": "Il était grand et gros, lent dans ses paroles et ses mouvements ; les étudiants l'avaient surnommé le Cachalot (« féroce et vorace »), car il était cruel, ambitieux et avide d'honneurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c381ecf-42c4-4488-a201-b26d2a4e60c4",
                        "source_entry_id": "aaf686f8-fb16-3bda-b169-1d44bb0b2970",
                        "source_sense_id": "a342a47d-5bd6-3bfb-af52-39287ecce999",
                        "target_lang_word": "Pottwal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pottwal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                        "entry_id": "75dec7a1-97e4-3394-b7bc-fcb5c8bca006",
                                        "glosses": [
                                            "größter Zahnwal, wissenschaftlich: Physeter macrocephalus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d52b8b93-c321-41b5-be57-de99825b10c6",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Pottwale besitzen - wie alle Zahnwale - ein unpaares, einzelnes Blasloch."
                                            },
                                            {
                                                "example_id": "442f434b-4a56-44b6-bfa7-0bdc2aceaceb",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "„Schweinswale sind im Vergleich mit Pottwalen oder Blauwalen Zwerge.“"
                                            },
                                            {
                                                "example_id": "9deafe81-35ec-4306-8ebb-4b03f00fabc2",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Wissenschaftler haben nun errechnet, dass die Ausscheidungen eines Pottwals dazu beitragen, pro Jahr die Menge an Kohlendioxid auszugleichen, die dem Ausstoß von etwa 40.000 Autos entspricht."
                                            },
                                            {
                                                "example_id": "91aeda00-8c04-478b-82b6-8e5a0dde12ce",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Im Pazifik wurden [… von japanischen Walfängern] insgesamt 190 Wale gefangen, darunter Zwerg-, Sei- und Pottwale."
                                            },
                                            {
                                                "example_id": "867c455d-683e-4dd7-989f-2d1f8e09c308",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "„2015 wurde ein Pottwal an einem der isländischen schwarzen Strände angespült, rund dreißig Autominuten von Vík entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "267b2e22-2675-4f39-855e-57b7fcdb2a2a",
