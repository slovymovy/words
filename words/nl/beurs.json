                        "ru": [
                            {
                                "target_lang_word": "выставка",
                                "target_lang_sense_clarification": "демонстрация продукции"
                            },
                            {
                                "target_lang_word": "ярмарка",
                                "target_lang_sense_clarification": "торговое мероприятие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fair",
                                "target_lang_sense_clarification": "trade or public event"
                            },
                            {
