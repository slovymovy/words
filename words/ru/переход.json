{
    "word_family": [
        "ходить",
        "переходить",
        "проход",
        "выход",
        "вход",
        "заход",
        "поход"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bb7015e-fc45-3999-b7c7-45bf38f3b303",
                    "sense_definition": "Специально оборудованное место для пересечения дороги или путей пешеходами.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>переходе</w> я сначала смотрю, чтобы машина остановилась, только потом перехожу.",
                            "target_lang_translations": {
                                "de": "Am <w>Fußgängerüberweg</w> schaue ich erst, ob das Auto anhält, und gehe erst dann hinüber."
                            }
                        },
                        {
                            "text": "Пешеходный <w>переход</w> был закрыт на ремонт.",
                            "target_lang_translations": {
                                "de": "Der <w>Fußgängerüberweg</w> war wegen Reparaturarbeiten gesperrt."
                            }
                        }
                    ],
                    "synonyms": [
                        "зебра"
                    ],
                    "common_phrases": [
                        "пешеходный переход",
                        "подземный переход"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein speziell markierter oder ausgestatteter Bereich, an dem Fußgänger eine Straße oder Gleise überqueren können."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fußgängerüberweg",
                                "target_lang_sense_clarification": "Offizieller Begriff für einen Zebrastreifen."
                            },
                            {
                                "target_lang_word": "Zebrastreifen",
                                "target_lang_sense_clarification": "Umgangssprachliche Bezeichnung für den Fußgängerüberweg."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9705b4e-0caf-3b41-9359-2bf8fe1dde85",
                    "sense_definition": "Специальное сооружение или коридор для перемещения между зданиями, уровнями или частями пространства.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я встретил его на исходе дня, в <w>переходе</w> возле метро.",
                            "target_lang_translations": {
                                "de": "Ich traf ihn am Ende des Tages in der <w>Unterführung</w> bei der U-Bahn."
                            }
                        },
                        {
                            "text": "Между двумя корпусами университета построили крытый <w>переход</w>.",
                            "target_lang_translations": {
                                "de": "Zwischen den beiden Universitätsgebäuden wurde ein überdachter <w>Verbindungsgang</w> gebaut."
                            }
                        }
                    ],
                    "synonyms": [
                        "коридор",
                        "проход"
                    ],
                    "common_phrases": [
                        "подземный переход",
                        "крытый переход"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein bauliches Verbindungselement oder ein Korridor, der Gebäude, Ebenen oder Räume miteinander verbindet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verbindungsgang",
                                "target_lang_sense_clarification": "Ein Gang, der zwei Gebäude oder Bereiche verbindet."
                            },
                            {
                                "target_lang_word": "Unterführung",
                                "target_lang_sense_clarification": "Ein unterirdischer Durchgang, oft bei Bahnhöfen oder Straßen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3caf9067-b09f-3138-91f9-0bdd69b73e7f",
                    "sense_definition": "Процесс изменения состояния, качества или системы, перемещение из одного статуса в другой.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Страна начала <w>переход</w> к рыночной экономике.",
                            "target_lang_translations": {
                                "de": "Das Land begann den <w>Übergang</w> zur Marktwirtschaft."
                            }
                        },
                        {
                            "text": "Этот <w>переход</w> на новую систему управления занял много времени.",
                            "target_lang_translations": {
                                "de": "Diese <w>Umstellung</w> auf das neue Managementsystem hat viel Zeit in Anspruch genommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "трансформация",
                        "преобразование"
                    ],
                    "common_phrases": [
                        "переход к рынку",
                        "переход на новый уровень"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Prozess des Wechsels von einem Zustand, einer Qualität oder einem System zu einem anderen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Übergang",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für den Wechsel von einem Zustand zum nächsten."
                            },
                            {
                                "target_lang_word": "Umstellung",
                                "target_lang_sense_clarification": "Bezieht sich meist auf die Änderung eines Systems oder einer Arbeitsweise."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c292c5-b401-38a9-b7ce-0a6c4949b1c7",
                    "sense_definition": "Длительное перемещение группы людей или войск пешком на значительное расстояние.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Исторический <w>переход</w> Суворова через Альпы стал легендарным.",
                            "target_lang_translations": {
                                "de": "Suworows historischer <w>Marsch</w> über die Alpen wurde legendär."
                            }
                        },
                        {
                            "text": "Солдаты совершили тяжелый <w>переход</w> через горный перевал.",
                            "target_lang_translations": {
                                "de": "Die Soldaten vollbrachten einen schweren <w>Marsch</w> über den Gebirgspass."
                            }
                        }
                    ],
                    "synonyms": [
                        "поход",
                        "марш"
                    ],
                    "common_phrases": [
                        "горный переход",
                        "длительный переход"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine längere Wanderung oder ein Marsch einer Gruppe von Menschen oder Truppen über eine große Distanz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Marsch",
                                "target_lang_sense_clarification": "Besonders im militärischen Kontext verwendet."
                            },
                            {
                                "target_lang_word": "Wanderung",
                                "target_lang_sense_clarification": "Eine längere Strecke, die zu Fuß zurückgelegt wird."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06dfdfa9-fcb1-3d5b-afb7-da0195498c92",
                    "sense_definition": "Смена спортсменом своей спортивной команды или клуба.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Официальный <w>переход</w> игрока в новый клуб состоится в конце сезона.",
                            "target_lang_translations": {
                                "de": "Der offizielle <w>Transfer</w> des Spielers zum neuen Verein findet am Ende der Saison statt."
                            }
                        },
                        {
                            "text": "Этот <w>переход</w> стал самым громким событием в спортивных новостях.",
                            "target_lang_translations": {
                                "de": "Dieser <w>Wechsel</w> wurde zum größten Ereignis in den Sportnachrichten."
                            }
                        }
                    ],
                    "synonyms": [
                        "трансфер"
                    ],
                    "common_phrases": [
                        "трансферный переход",
                        "официальный переход"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Wechsel eines Sportlers von einem Team oder Verein zu einem anderen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Transfer",
                                "target_lang_sense_clarification": "Der gängige Fachbegriff im Sport für den Vereinswechsel."
                            },
                            {
                                "target_lang_word": "Wechsel",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für den Vereinswechsel eines Spielers."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}