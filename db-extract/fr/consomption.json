        "fr-extract.jsonl": [
            {
                "entry_id": "0e5a7d10-3b6a-35a1-b167-7148c18a0131",
                "word": "consomption",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "80447c1d-a27f-4f5a-b98d-30e466b296ad",
                        "entry_id": "0e5a7d10-3b6a-35a1-b167-7148c18a0131",
                        "tags": [
                            "plural"
                        ],
                        "form": "consomptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff3e98d0-b1af-3348-81ad-8e5d2bec53a3",
                        "entry_id": "0e5a7d10-3b6a-35a1-b167-7148c18a0131",
                        "glosses": [
                            "Action d’être consumé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc1e115-4fb3-4bf7-b974-188eb7f845ea",
                                "sense_id": "ff3e98d0-b1af-3348-81ad-8e5d2bec53a3",
                                "text": "La victime fut brûlée jusqu’à l’entière consomption."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                        "entry_id": "0e5a7d10-3b6a-35a1-b167-7148c18a0131",
                        "glosses": [
                            "Amaigrissement progressif qui précède souvent la mort dans la plupart des maladies chroniques, et surtout dans la tuberculose."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f73fffb2-8a57-44b0-8318-5a77c1104ef1",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "Fièvre de consomption."
                            },
                            {
                                "example_id": "e14cc605-875c-4ded-9ac5-3db019ce9986",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "Nulle race ne compte plus de morts par amour ; le suicide y est rare ; ce qui domine, c’est la lente consomption. Le cas est fréquent chez les jeunes conscrits bretons."
                            },
                            {
                                "example_id": "578be4f6-cedc-406e-91ca-55db4d4c6f11",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "Sa femme, après quinze ans d’esclavage, l’a quitté : il lui faisait vraiment l’existence trop rude : elle est morte de consomption."
                            },
                            {
                                "example_id": "ac1f81e1-217a-4997-a6a7-5939d08eff6a",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "Il est à Zoni, il vit dans une maison de santé. Le pauvre garçon meurt de consomption."
                            },
                            {
                                "example_id": "bf19d021-cecf-400d-938c-f9535bf1e5cb",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "En en dissimulant les traces de consomption, les gantelets de maille réussissaient presque à ressusciter ce qu'avaient eu de vigueur les mains."
                            },
                            {
                                "example_id": "4f5388b1-48bf-4ea1-ae87-0a5c50b992db",
                                "sense_id": "6f30800b-d9cf-31db-95e9-dad5bf2461bb",
                                "text": "De Chopin qui se mourait de « consomption », Sophie d’Agoult disait avec ravissement : « Je trouve qu’il tousse avec une grâce exquise ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f1dd69-7632-4f51-9440-11c39b5e5981",
                        "source_entry_id": "0e5a7d10-3b6a-35a1-b167-7148c18a0131",
                        "target_lang_word": "consumption",
                        "target_lang_code": "en",
