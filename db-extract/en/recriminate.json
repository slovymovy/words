                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf0138f8-e141-32e6-9986-fb0defa3f095",
                        "entry_id": "409a49fb-48a4-3d42-b030-61e2e55732ad",
                        "glosses": [
                            "To accuse in return, state an accusation in return, make a countercharge."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5b655f-3e01-4ff9-a3a7-3f59f1dfd531",
                                "sense_id": "bf0138f8-e141-32e6-9986-fb0defa3f095",
                                "text": "Tom said Harry had lied, and Harry recriminated by saying Tom had manipulated him."
                            },
                            {
                                "example_id": "3b3d87f0-b104-44dd-bf98-64a366b8af0b",
                                "sense_id": "bf0138f8-e141-32e6-9986-fb0defa3f095",
                                "text": "It is not my business to recriminate, hoping sufficiently to clear myself in this matter."
                            },
                            {
                                "example_id": "c3639311-8603-4a06-9152-e3d06146eae8",
                                "sense_id": "bf0138f8-e141-32e6-9986-fb0defa3f095",
                                "text": "Besides, he might come and begin a string of abuse or complainings; I’m certain I should recriminate, and God knows where we should end!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7880ebdc-690b-4f28-9ebb-e99d50da328c",
                        "source_entry_id": "409a49fb-48a4-3d42-b030-61e2e55732ad",
                        "source_sense_id": "bf0138f8-e141-32e6-9986-fb0defa3f095",
                        "source_sense_description": "to accuse in return",
                        "target_lang_word": "récriminer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récriminer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e50b7a4e-b591-326b-b36e-d99f35230db5",
                                        "entry_id": "8b4da6e4-2494-3871-82ec-8fdbafd9fcf8",
                                        "glosses": [
                                            "Répondre à des accusations par d’autres accusations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb7ed98-d613-4b61-9411-4db73a3f27bb",
                                                "sense_id": "e50b7a4e-b591-326b-b36e-d99f35230db5",
                                                "text": "Il ne s’est défendu qu’en récriminant."
                                            },
                                            {
                                                "example_id": "91057bfd-1e93-45ba-8f95-6e4d27206625",
                                                "sense_id": "e50b7a4e-b591-326b-b36e-d99f35230db5",
                                                "text": "Récriminer contre son accusateur."
                                            },
                                            {
                                                "example_id": "51e509d7-58be-4dfb-9599-4666c7386c8c",
                                                "sense_id": "e50b7a4e-b591-326b-b36e-d99f35230db5",
                                                "text": "— D'où venez-vous encore, coureur de ruelles ! fit la jeune femme avec un léger accent de mécontentement.\n— Coureur de ruelles ! récrimina-t-il ; par les terres de Gascogne que je pourrais posséder, je ne suis pas un coureur de ruelles."
                                            },
                                            {
                                                "example_id": "062f35d1-5a5d-41e6-8c36-8cc316466879",
                                                "sense_id": "e50b7a4e-b591-326b-b36e-d99f35230db5",
                                                "text": "— Si ce temps a été long pour toi, sois persuadée qu’il l’a été pour moi aussi. Mais ce que je te dis là n’est pas pour récriminer ni revenir dans le passé ; laissons-le derrière nous et tous deux tâchons de n’y plus penser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3ce328-d72f-3fcd-97a4-c7b23db9e02a",
                                        "entry_id": "8b4da6e4-2494-3871-82ec-8fdbafd9fcf8",
                                        "glosses": [
                                            "Reprocher, trouver à redire, critiquer amèrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cffe2694-2152-45cf-85b4-a4827d05bfa8",
                                                "sense_id": "7a3ce328-d72f-3fcd-97a4-c7b23db9e02a",
                                                "text": "D'ailleurs, quand elle se fût désespérée, quand tous ses compagnons se seraient plaints, quand ils auraient récriminé, pouvaient-ils empêcher ce qui était ?"
                                            },
                                            {
                                                "example_id": "2e108071-8c41-4b21-82ca-c33350fd9360",
                                                "sense_id": "7a3ce328-d72f-3fcd-97a4-c7b23db9e02a",
                                                "text": "Angèle. — Eh bien ! ce portrait est là pour me dire : \"Souviens-toi que tous les maris sont des parjures et des infidèles\" ! Il n’y a pas à récriminer, c’est inhérent à la fonction."
                                            },
                                            {
                                                "example_id": "444d4047-4f52-47ca-b1ff-962ddda77974",
                                                "sense_id": "7a3ce328-d72f-3fcd-97a4-c7b23db9e02a",
                                                "text": "On dirait qu’ils récriminent pour la forme, comme si le rapport de force était en leur faveur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
