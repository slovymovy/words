                        "glosses": [
                            "Second contre-maître qui était préposé aux cordages, aux ancres, etc."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5c475378-caf3-4a41-8a31-a0d39a191b9f",
                                "sense_id": "ee5083e8-ec56-30ea-b75e-8b3cecc7650e",
                                "text": "On ne renvoie plus en France aucun officier major ni marinier, jusqu'aux plus petits emplois des navires, comme charpentiers, calfats, quartiers-maîtres, bossemans, seconds-chirurgiens."
                            },
                            {
                                "example_id": "d01e8a5b-5ac3-4c35-a833-9798822cdfb2",
                                "sense_id": "ee5083e8-ec56-30ea-b75e-8b3cecc7650e",
                                "text": "L’équipage du Chancellor se compose du capitaine Huntly, du second Robert Kurtis, du lieutenant Walter, d’un bosseman et de quatorze matelots, anglais ou écossais."
                            },
                            {
                                "example_id": "24328504-a2c2-476a-9b1f-5c77380509a7",
                                "sense_id": "ee5083e8-ec56-30ea-b75e-8b3cecc7650e",
                                "text": "Quant à Pierre Berger, sa place de second nous laisse supposer qu'il est le bosseman : il n'est donc pas affecté à la propulsion du bateau, mais doit sonder la profondeur de la rivière, une perche à la main, et surveiller les obstacles."
                            }
                        ]
                    }
