                        "source_sense_description": "de grondstof voor bier, jenever en whisky, vervaardigd door het laten kiemen...",
                        "target_lang_word": "Malz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0605abb-a673-39ca-925a-bf421c945bd2",
                                        "entry_id": "97cb2cf2-0894-3f20-ad00-b921ba3588a4",
                                        "glosses": [
                                            "in Wasser gekeimtes und anschließend getrocknetes (gedarrtes) Getreide, meist Gerste; wird hauptsächlich zur Bierherstellung verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131677d4-cfdf-4965-8969-5487f2ddd36e",
                                                "sense_id": "c0605abb-a673-39ca-925a-bf421c945bd2",
                                                "text": "„Für die Herstellung von Malz werden spezielle Getreidesorten, sogenannte Braugersten (meist zweizeilige Sommergersten, aber auch Wintergersten) oder Brauweizen eingesetzt.“"
                                            },
                                            {
                                                "example_id": "c0a41b2b-a0e9-42ed-8427-fc81cd0aedd0",
                                                "sense_id": "c0605abb-a673-39ca-925a-bf421c945bd2",
                                                "text": "„Auch Deutschland hat daran einen Anteil, denn von dort kommt das Malz und die über 20 Jahre alte Abfüllanlage.“"
                                            },
                                            {
                                                "example_id": "6accabbe-5418-4a03-9dab-67fa2a32297f",
                                                "sense_id": "c0605abb-a673-39ca-925a-bf421c945bd2",
                                                "text": "„Mit Malz bezeichnet der Brauer gekeimte, enzymatisch aufgeschlossene und dann getrocknete Gerstenkörner.“"
                                            },
                                            {
                                                "example_id": "6a42dd50-3fe6-4b4e-bc25-e7581db99093",
                                                "sense_id": "c0605abb-a673-39ca-925a-bf421c945bd2",
                                                "text": "„Aus geschrotetem Malz und Wasser entsteht Maische, die geklärt (»geläutert«) wird, der feste Rückstand dient als Tierfutter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
