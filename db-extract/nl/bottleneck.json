                "senses": [
                    {
                        "sense_id": "2ea70852-aec9-37c0-8a42-020f1bdf75b1",
                        "entry_id": "517ab58d-5992-34f0-b441-f8ce791a4d5f",
                        "glosses": [
                            "een buisje van gepolijst glas of metaal, door gitaristen gebruikt om bepaalde typische klanken te produceren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b15717-4920-4416-803a-452a151ea913",
                                "sense_id": "2ea70852-aec9-37c0-8a42-020f1bdf75b1",
                                "text": "Een bottleneck wordt gebruikt om slide-gitaar te spelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f163121-7d57-3540-8670-a8b6daf190f5",
                        "entry_id": "517ab58d-5992-34f0-b441-f8ce791a4d5f",
                        "glosses": [
                            "een wegvernauwing, in het bijzonder een die voor vertraging zorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15a88a55-fc60-4d6e-9ec1-bd7c7c4bea15",
                                "sense_id": "0f163121-7d57-3540-8670-a8b6daf190f5",
                                "text": "Er is een bottleneck op de vluchtroute."
                            }
                        ]
                    },
                    {
                        "sense_id": "52ebb68b-7ead-3439-ba98-88b1ec3b7831",
                        "entry_id": "517ab58d-5992-34f0-b441-f8ce791a4d5f",
                        "glosses": [
                            "iets dat het tot stand komen van een bepaald proces bemoeilijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242695db-483a-4ca5-a534-ae00bcba2890",
                                "sense_id": "52ebb68b-7ead-3439-ba98-88b1ec3b7831",
                                "text": "Dat is een echte bottleneck voor de rest van het systeem."
                            },
                            {
                                "example_id": "8e3ecb13-b1fc-4403-9c23-bec9fd97966c",
                                "sense_id": "52ebb68b-7ead-3439-ba98-88b1ec3b7831",
                                "text": "Het binnenkomen was de bottleneck waar ze prima doorheen waren gegleden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd2d1db6-1670-4f52-bce0-6229d7793de2",
                        "source_entry_id": "517ab58d-5992-34f0-b441-f8ce791a4d5f",
                        "source_sense_id": "2ea70852-aec9-37c0-8a42-020f1bdf75b1",
                        "source_sense_description": "een buisje van gepolijst glas of metaal, door gitaristen gebruikt om bepaalde typische klanken te produceren",
                        "target_lang_word": "bottleneck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottleneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45e397c0-10c1-3375-b534-6be4816ecb09",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The narrow portion that forms the pouring spout of a bottle; the neck of a bottle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "473a0c70-a521-3b06-959b-34691af1c85f",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The narrow portion that forms the pouring spout of a bottle; the neck of a bottle.",
                                            "A portion of a bottleneck placed on the finger and used as a guitar slide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "In traffic, any narrowing of the road, especially resulting in a delay."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e98138f-852d-44b8-8f33-37c09a44e45b",
                                                "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                                "text": "\"Permissive\" working allows more than one train to be in a block section at one time but trains must be run at low speed in order to stop on sight behind the train in front. Such working is often authorised to allow freight trains to \"bunch\" together to await a path through a bottleneck instead of being strung out over several block sections, as would be necessary if absolute working were in force."
                                            },
                                            {
                                                "example_id": "d692a00e-dfc9-40f5-9163-dfa38baa30ca",
                                                "sense_id": "f120d9f5-1518-3923-8dd0-667d6e85d16a",
                                                "text": "At one time, Reading was regarded as a notorious bottleneck in the rail network, almost incapable of managing the number of services that needed to pass through the station each day. [...]\n A road widening scheme at Cow Lane has also allowed two-way traffic to run beneath the railway for the first time, helping to remove a notorious road traffic bottleneck in the town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                        "entry_id": "dceb6445-a59a-3172-9336-53422e9541f4",
                                        "glosses": [
                                            "The part of a process that is too slow or cumbersome."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b13406-aa2c-4236-a74b-faf2ade1e823",
                                                "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                                "text": "It is easy to create entries; processing the paperwork is the bottleneck."
                                            },
                                            {
                                                "example_id": "7ea9ef38-15f5-4ef6-8f65-711280727791",
                                                "sense_id": "179c8ecd-da89-393d-9aa6-f12b1c2c9205",
                                                "text": "The bottleneck in this computer program is the inefficient sorting process; we should replace it with a faster one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bottleneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8189304-c543-37bd-9666-2becbe71b67c",
                                        "entry_id": "9181b3d7-5b0d-3744-966e-49155eb8d663",
                                        "glosses": [
                                            "To slow by causing a bottleneck."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfbeb5af-5efe-4678-a93b-69d5dae9e446",
                                                "sense_id": "d8189304-c543-37bd-9666-2becbe71b67c",
                                                "text": "The merge bottlenecked the traffic every morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d66de4d4-8352-3f9a-b3a4-7f48ae807e4d",
                                        "entry_id": "9181b3d7-5b0d-3744-966e-49155eb8d663",
                                        "glosses": [
                                            "To form a bottleneck."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ea53d1-28e0-4c5f-b21d-c5495a489eba",
                                                "sense_id": "d66de4d4-8352-3f9a-b3a4-7f48ae807e4d",
                                                "text": "The traffic bottlenecked at the merge every morning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
