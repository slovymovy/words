                        "examples": [
                            {
                                "example_id": "8281a19f-ac5a-499a-a425-1799e6004bbd",
                                "sense_id": "84930671-8747-36ca-ab00-5005c72abf41",
                                "text": "Toen aan de carrière van Napoleon in Waterloo een einde kwam en zijn rijk moest worden herverdeeld, werden Nederland en Pruisen het maar niet eens over dit glooiende landschap vol bos en grasland. De inzet? De grootste zinkmijn van Europa, in het huidige Kelmis."
                            },
                            {
                                "example_id": "e3b18962-ad41-49bb-8f55-c4ae3abd24be",
                                "sense_id": "84930671-8747-36ca-ab00-5005c72abf41",
                                "text": "De lood-, zilver- en zinkmijnen van Tarnowkie Gory zijn beroemd door hun drie eeuwen oude ondergrondse watersysteem waar het water permanent moest worden opgepompt om ervoor te zorgen dat de mijnen niet onderliepen. Dat water werd getransporteerd naar steden in industrieën in de buurt."
                            }
                        ]
