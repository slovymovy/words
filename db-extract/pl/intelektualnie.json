                "senses": [
                    {
                        "sense_id": "90635b5d-ee1f-3493-affd-100c9fd9e4f3",
                        "entry_id": "4256dc41-de95-30a1-bbe0-7b15587bdb60",
                        "glosses": [
                            "pod względem intelektualnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8d20b5-abdc-4ebe-b4ca-1d70b139a43f",
                                "sense_id": "90635b5d-ee1f-3493-affd-100c9fd9e4f3",
                                "text": "Zoomerzy wyróżniają się jako generacja, która angażuje się w najmniejszą ilość aktywności seksualnej, jednocześnie będąc najbardziej intelektualnie zainteresowaną tematem seksualności"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a8feb60-afa0-4199-a27d-76a2327479af",
                        "source_entry_id": "4256dc41-de95-30a1-bbe0-7b15587bdb60",
                        "source_sense_id": "90635b5d-ee1f-3493-affd-100c9fd9e4f3",
                        "target_lang_word": "intellectually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellectually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                        "entry_id": "2b2d0375-c3c7-34ef-86da-2f1c643ed613",
                                        "glosses": [
                                            "In an intellectual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8d5dee-57d5-4789-896b-6a65e72df6ff",
                                                "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                                "text": "And just because the intellectuals are mostly intellectually honest it is inevitable that they should follow their own convictions whenever they have discretion and that they should give a corresponding slant to everything that passes through their hand."
                                            },
                                            {
                                                "example_id": "b399f819-9af4-435e-8d35-5a421324bfc4",
                                                "sense_id": "1b243cab-0251-347b-8941-807c29f9fb21",
                                                "text": "Nevertheless intellectually, ideologically and politically he identified with industrialists whom he, just like Smith, saw as the usherers of progress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea153ced-3e21-443f-bd9a-5523233810e8",
                        "source_entry_id": "4256dc41-de95-30a1-bbe0-7b15587bdb60",
                        "source_sense_id": "90635b5d-ee1f-3493-affd-100c9fd9e4f3",
                        "target_lang_word": "intellektuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellektuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                        "entry_id": "6bdd9573-024e-3fcf-857d-f7e48e790241",
                                        "glosses": [
                                            "den Geist/Intellekt/Verstand betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1070d982-341b-44c9-b140-33067f4ab334",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "Das ist ein intellektuelles Spiel."
                                            },
                                            {
                                                "example_id": "bb0b837d-ff2a-4a99-bf3e-767bd13621e4",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Zu den Schülern dieses intellektuellen Zentrums zählte auch Paulus.“"
                                            },
                                            {
                                                "example_id": "64eca3b1-ef31-49ef-8354-30df56f58b93",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                                            },
                                            {
                                                "example_id": "09a253ea-6f4f-4081-bcca-95179a8ad5d2",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Der Glaube, dass es einen Gott gibt, bleibt jedoch trotz der Versuche des menschlichen Geistes, sich über sogenannte Gottesbeweise, über intellektuelle Erkenntnisse und logische Schlüsse, Sicherheit zu verschaffen, ein Wagnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
