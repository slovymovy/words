                        "glosses": [
                            "энтомол. небольшой жук, поедающий листья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b06294c-8d0f-454b-8e22-80d06ba89a75",
                                "sense_id": "20d81ecd-6445-3133-b8bd-bb05c98a6e06",
                                "text": "На стенах висят плакаты, где нарисованы разные вредители леса: гусеницы, жуки-дровосеки, жуки-точильщики, листоеды."
                            }
                        ]
                    }
