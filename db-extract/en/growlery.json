                "senses": [
                    {
                        "sense_id": "b82ed569-02ba-3a04-a05e-ba3d35737740",
                        "entry_id": "8a7b1285-5440-3a82-91f7-7cdef817490b",
                        "glosses": [
                            "A place to retreat to, alone, when ill-humoured."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ebb017-4d01-45fa-b521-a00890be2cfd",
                                "sense_id": "b82ed569-02ba-3a04-a05e-ba3d35737740",
                                "text": "\"Sit down, my dear,\" said Mr. Jarndyce. \"This, you must know, is the Growlery. When I am out of humour, I come and growl here.\""
                            },
                            {
                                "example_id": "541c84a8-224b-423e-9b9c-044d4e73b311",
                                "sense_id": "b82ed569-02ba-3a04-a05e-ba3d35737740",
                                "text": "Hi ! the Howlery ! ho ! the Growlery ! Ha ! the Sniffery, Snarlery, Scowlery ! There we may stay, If we choose, all day; But it 's only a smile that can bring us away."
                            },
                            {
                                "example_id": "619a2bdb-fb00-4ac3-91f4-2484adbb5b87",
                                "sense_id": "b82ed569-02ba-3a04-a05e-ba3d35737740",
                                "text": "As such, the Growlery again frustrates what Doublass sees as a peculiarly American obsession with pigeonholing things in terms of race."
                            }
                        ]
                    }
                ],
