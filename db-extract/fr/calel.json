                        "glosses": [
                            "Sorte de lampe à huile."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ad205e45-248d-4f8d-b4b9-118505e30d3c",
                                "sense_id": "21989eeb-fda1-32c4-9ef9-6c8391691961",
                                "text": "Je ferai aussi une troisième espèce de lampe destinée à remplacer le lum des Dauphinois ou le calel des Languedociens, etc., pour l'usage des pauvres et surtout pour les gens de la campagne, dont il est impossible de changer les habitudes."
                            },
                            {
                                "example_id": "3434f3d7-a2c6-4bfd-b583-5655fea67756",
                                "sense_id": "21989eeb-fda1-32c4-9ef9-6c8391691961",
                                "text": "La messe finie, on rentrait vite à la maison sous les étoiles, on s’embarrait soigneusement, on soufflait sur la braise pour rallumer le feu et, à la lueur du calel, on mangeait les « bougnettes » arrosées de vin chaud, parfumé à la cannelle, au laurier et aux clous de girofle."
                            }
                        ]
                    }
