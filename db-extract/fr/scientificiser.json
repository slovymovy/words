                "senses": [
                    {
                        "sense_id": "2d1daf9c-ab6e-33e2-871e-2bdff6958ad4",
                        "entry_id": "8a025cbc-6ae8-3126-8583-599733249a4a",
                        "glosses": [
                            "Donner un caractère scientifique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9396de-81f1-4cfe-b923-81e57a83ed35",
                                "sense_id": "2d1daf9c-ab6e-33e2-871e-2bdff6958ad4",
                                "text": "Nous vivons en effet dans une société qui a cherché à « scientificiser » la décision politique."
                            },
                            {
                                "example_id": "faaa9a1c-f888-4c1e-a275-04fe8125657e",
                                "sense_id": "2d1daf9c-ab6e-33e2-871e-2bdff6958ad4",
                                "text": "Relevons toutefois, en guise de réponse, que l’accent mis sur le rapport entre les choses et les mots par le dispositif interprétatif contribue autant à scientificiser le débat qu’à le littérariser."
                            },
                            {
                                "example_id": "e8e473dc-0646-4326-8c39-881907fbf384",
                                "sense_id": "2d1daf9c-ab6e-33e2-871e-2bdff6958ad4",
                                "text": "La question de l’origine des langues se scientificise : est-ce à dire qu’elle ne se perpétue pas sous une forme mythique ?"
                            }
                        ]
                    }
