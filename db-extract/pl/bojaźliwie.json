                                "target_senses": [
                                    {
                                        "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "In a fearful manner; characterized by fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2863584-dfa8-40cb-b814-d7873fd08965",
                                                "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                                "text": "I stepped fearfully into the pitch-dark cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "very; very much."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c278a20e-37ba-4bfb-b1f9-82013bc8ab26",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "He's a fearfully good striker."
                                            },
                                            {
                                                "example_id": "424a3e69-00dc-40fb-bb36-916fc9a50475",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "Remember, when a horse is on its side the kicking-strap is useless, and the breechen nearly so, to prevent the swing of its hind legs; your aim is to get it away from the steps or wheel-plate of the trap, which, in its struggles, may cut its legs fearfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1ae0211-d888-4e7b-a28e-8a2dcff27962",
                        "source_entry_id": "ae8de5d0-dc1e-3162-a9b3-cb9a3832001c",
                        "source_sense_id": "3069c33c-89ea-3c68-a878-ece23e89e9a4",
                        "target_lang_word": "peureusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peureusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                                        "entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
                                        "glosses": [
                                            "D’une façon peureuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d2208e0-078a-4c2c-908b-399301188640",
                                                "sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                                                "text": "Une petite pluie mince et tenace dégoulinait sans arrêt depuis la veille et les passants, recroquevillés sous leurs riflards, les yeux rivés sur le pavé en larmes, glissant peureusement parmi les files des voitures serrées, lui fournissaient l’impression vague de spectres titubants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a1cc59-c6a6-4fe4-86eb-b7b400e18fee",
                        "source_entry_id": "ae8de5d0-dc1e-3162-a9b3-cb9a3832001c",
                        "source_sense_id": "3069c33c-89ea-3c68-a878-ece23e89e9a4",
                        "target_lang_word": "timidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                        "entry_id": "f9892c39-9887-3e4a-821e-c64c868ad962",
                                        "glosses": [
                                            "D’une manière timide, avec timidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d86cc84-a714-4aef-a229-9c4550135472",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Sa casquette à carreaux lui attirant des quolibets, il l'ôta timidement."
                                            },
                                            {
                                                "example_id": "396797c7-7ceb-4b3d-b0e0-631ba51d8a46",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Enfin, elle articula timidement, d'une voix aiguë et mal assurée comme un violon qui crincrine : — Vous n'auriez pas une goutte de lait ?"
                                            },
                                            {
                                                "example_id": "ef9bd7e5-ca8d-4b83-aa1c-b22dc51d4fe2",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Hélas ! le citoyen, timidement fidèle, N'oserait en ces lieux imiter ce saint zèle,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
