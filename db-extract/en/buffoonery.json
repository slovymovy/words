                ],
                "senses": [
                    {
                        "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                        "entry_id": "d2fa18a7-0552-3457-bc0f-ae2a6fe66cbc",
                        "glosses": [
                            "The behaviour expected of a buffoon; foolishness, silliness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "807874c5-ddd9-40da-a384-56419b0e1cdd",
                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                "text": "Araminta, come I'll talk ſeriouſly to you now, could you but ſee vvith my Eyes the buffoonry of one Scene of Addreſs, a Lover, ſet out with all his Equipage and Appurtenances; […]"
                            },
                            {
                                "example_id": "1a75a5c1-f6ff-4f41-8627-1af53cc52377",
                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                "text": "[W]e ſet him [the Devil] up like a Scare-Crovv to fright Children and old VVomen, to fill up old Stories, make Songs and Ballads, and in a VVord, carry on the lovv priz'd Buffoonry of the common People; […]"
                            },
                            {
                                "example_id": "9724639e-5d59-4b17-ab03-49c9a859583c",
                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                "text": "[…] One could not expect any body to take such a part—Nothing but buffoonery from beginning to end."
                            },
                            {
                                "example_id": "4178decf-c695-4351-b61d-fe42d03310bb",
                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                "text": "The Temperance Reform was too serious a matter for trifling jokes and buffooneries."
                            },
                            {
                                "example_id": "ce8f726f-9d3d-4800-94ed-fe2b45471891",
                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                "text": "Preamble is a hard-boiled steel commuter built for comfort, durability, and buffoonery on pavement and gravel."
                            }
                        ]
                    }
                ],
