{
    "word_family": [
        "faith",
        "faithfully",
        "faithfulness",
        "faithless",
        "unfaithful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f5518b0-178e-31dd-956a-9b6498b5d6a5",
                    "sense_definition": "Loyal, reliable, and adhering firmly to a person, cause, or duty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>faithful</w> dog waits for me by the door every single day.",
                            "target_lang_translations": {
                                "ru": "Мой <w>верный</w> пёс ждет меня у двери каждый божий день.",
                                "zh": "我那<w>忠诚</w>的狗每天都在门口等我。"
                            }
                        },
                        {
                            "text": "She has been a <w>faithful</w> friend to me for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она была мне <w>верным</w> другом более двадцати лет.",
                                "zh": "二十多年来，她一直是我<w>忠诚</w>的朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loyal",
                        "devoted",
                        "steadfast",
                        "constant",
                        "staunch",
                        "reliable",
                        "true"
                    ],
                    "antonyms": [
                        "disloyal",
                        "unfaithful",
                        "treacherous"
                    ],
                    "common_phrases": [
                        "faithful friend",
                        "faithful dog",
                        "faithful servant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преданный, надежный и твердо придерживающийся кого-либо или чего-либо (долга, дела).",
                        "zh": "忠诚、可靠，坚定地支持某人、某事业或履行职责。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рный",
                                "target_lang_sense_clarification": "loyal, constant"
                            },
                            {
                                "target_lang_word": "пре́данный",
                                "target_lang_sense_clarification": "devoted"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠诚",
                                "target_lang_sense_clarification": "loyal, devoted"
                            },
                            {
                                "target_lang_word": "可靠",
                                "target_lang_sense_clarification": "reliable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "735fafbe-9845-3946-b700-5fb76435f67c",
                    "sense_definition": "Engaging in sexual or romantic relations only with one's spouse or long-term partner.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sem_loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He promised to be <w>faithful</w> to his wife for the rest of his life.",
                            "target_lang_translations": {
                                "ru": "Он обещал быть <w>верным</w> своей жене до конца жизни.",
                                "zh": "他承诺余生都会对妻子保持<w>忠贞</w>。"
                            }
                        },
                        {
                            "text": "It is important for partners to remain <w>faithful</w> to build trust in a marriage.",
                            "target_lang_translations": {
                                "ru": "Партнерам важно оставаться <w>верными</w> друг другу, чтобы построить доверие в браке.",
                                "zh": "伴侣之间保持<w>忠贞</w>对于建立婚姻信任至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "monogamous",
                        "constant",
                        "true"
                    ],
                    "antonyms": [
                        "unfaithful",
                        "cheating"
                    ],
                    "common_phrases": [
                        "faithful husband",
                        "faithful wife",
                        "remain faithful"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хранящий верность супругу или партнеру; не изменяющий.",
                        "zh": "在性或浪漫关系中只对配偶或长期伴侣保持忠诚，不背叛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рный",
                                "target_lang_sense_clarification": "monogamous"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠贞",
                                "target_lang_sense_clarification": "monogamous, faithful in marriage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12a19da7-3ae2-34c9-b3b8-bd3ad1a59ee7",
                    "sense_definition": "Accurate and consistent with the original or reality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie is a <w>faithful</w> adaptation of the classic novel.",
                            "target_lang_translations": {
                                "ru": "Этот фильм — <w>точная</w> адаптация классического романа.",
                                "zh": "这部电影是对那部经典小说的<w>忠实</w>改编。"
                            }
                        },
                        {
                            "text": "He made a <w>faithful</w> copy of the painting that looked exactly like the original.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>точную</w> копию картины, которая выглядела в точности как оригинал.",
                                "zh": "他制作了一幅<w>忠实</w>的画作复制品，看起来和原作一模一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accurate",
                        "exact",
                        "precise",
                        "true"
                    ],
                    "antonyms": [
                        "inaccurate",
                        "distorted",
                        "loose"
                    ],
                    "common_phrases": [
                        "faithful copy",
                        "faithful reproduction",
                        "faithful account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точный, соответствующий оригиналу или действительности.",
                        "zh": "准确且与原件或事实一致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то́чный",
                                "target_lang_sense_clarification": "exact"
                            },
                            {
                                "target_lang_word": "ве́рный",
                                "target_lang_sense_clarification": "true to original"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠实",
                                "target_lang_sense_clarification": "true to original"
                            },
                            {
                                "target_lang_word": "准确",
                                "target_lang_sense_clarification": "accurate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c16338f-0be5-3da8-b9cb-e05af2422e93",
                    "sense_definition": "Having strong religious faith.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sem_religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>faithful</w> community gathered every Sunday to worship together.",
                            "target_lang_translations": {
                                "ru": "<w>Верующая</w> община собиралась каждое воскресенье для совместной молитвы.",
                                "zh": "这个<w>虔诚</w>的社区每周日都会聚在一起做礼拜。"
                            }
                        },
                        {
                            "text": "She remained a <w>faithful</w> believer despite the hardships she faced.",
                            "target_lang_translations": {
                                "ru": "Она оставалась <w>преданной</w> верующей, несмотря на выпавшие ей трудности.",
                                "zh": "尽管面临重重困难，她依然是一位<w>虔诚</w>的信徒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "devout",
                        "believing",
                        "pious"
                    ],
                    "antonyms": [
                        "faithless"
                    ],
                    "common_phrases": [
                        "faithful believer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренне верующий, обладающий сильной религиозной верой.",
                        "zh": "拥有坚定的宗教信仰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рующий",
                                "target_lang_sense_clarification": "believing"
                            },
                            {
                                "target_lang_word": "пре́данный",
                                "target_lang_sense_clarification": "devout"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虔诚",
                                "target_lang_sense_clarification": "devout, pious"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9be8bb9-f0b2-3ac2-95ab-420285ba0355",
                    "sense_definition": "The practicing members of a religion or followers of a cause.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest blessed the <w>faithful</w> at the end of the service.",
                            "target_lang_translations": {
                                "ru": "Священник благословил <w>верующих</w> в конце службы.",
                                "zh": "牧师在礼拜结束时为<w>信徒</w>们祈福。"
                            }
                        },
                        {
                            "text": "Thousands of the <w>faithful</w> traveled to the holy city for the festival.",
                            "target_lang_translations": {
                                "ru": "Тысячи <w>верующих</w> отправились в священный город на праздник.",
                                "zh": "成千上万的<w>信徒</w>前往圣城参加节日庆典。"
                            }
                        }
                    ],
                    "synonyms": [
                        "believers",
                        "followers",
                        "congregation"
                    ],
                    "antonyms": [
                        "nonbelievers"
                    ],
                    "common_phrases": [
                        "the faithful"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верующие; последователи определенной религии или дела.",
                        "zh": "宗教的信徒或某项事业的追随者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рующие",
                                "target_lang_sense_clarification": "believers"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信徒",
                                "target_lang_sense_clarification": "believers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d91da683-4ef6-3a44-8b53-bb53291feec7",
                    "sense_definition": "Someone or something that is reliable or trusted over a long time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sem_loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to wear my old <w>faithfuls</w>, the boots I have had for a decade.",
                            "target_lang_translations": {
                                "ru": "Я решил надеть свои старые <w>надежные</w> ботинки, которые ношу уже десять лет.",
                                "zh": "我决定穿上我那双<w>可靠的</w>旧靴子，它们我已经穿了十年了。"
                            }
                        },
                        {
                            "text": "This car is an old <w>faithful</w> that never breaks down in winter.",
                            "target_lang_translations": {
                                "ru": "Эта машина — старая <w>надежная</w> подруга, которая никогда не ломается зимой.",
                                "zh": "这辆车是个<w>可靠的</w>老伙计，冬天从不抛锚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "standby"
                    ],
                    "common_phrases": [
                        "old faithful"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то или что-то надежное, проверенное временем.",
                        "zh": "长期以来一直可靠或值得信赖的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "reliable"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可靠的",
                                "target_lang_sense_clarification": "reliable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}