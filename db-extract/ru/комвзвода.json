                                "example_id": "44849c9c-482f-421e-b139-bae3743c792f",
                                "sense_id": "9e3a148e-594a-3616-966b-dcdfb704bf22",
                                "text": "В 41-м вступил добровольцем в ленинградское ополчение, был комвзвода артиллерии."
                            },
                            {
                                "example_id": "7c563d7f-3aa7-40c3-ac57-9f80cd3874eb",
                                "sense_id": "9e3a148e-594a-3616-966b-dcdfb704bf22",
                                "text": "Сержант не доложил комвзвода, тот — комроты… и так до министра и выше."
                            }
                        ]
                    }
