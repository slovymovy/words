                        "form": "die Wartezeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                        "entry_id": "c0db52e0-7617-3931-a83b-a770323fcf64",
                        "glosses": [
                            "die Zeit, die bis zu einem geplanten Ereignis vergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776ddedf-2f20-4395-b1c9-1ca2139ee621",
                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                "text": "„Normal sind Wartezeiten von bis zu fünf Monaten.“"
                            },
                            {
                                "example_id": "9458f275-d9be-4e77-846d-dfb9dc602d87",
                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                "text": "„Holländer zeigen immer diese stoische Ruhe, wenn etwas schiefläuft, ob es nun um den Nahverkehr, die Wartezeiten im Krankenhaus oder chronische Stromausfälle geht.“"
                            },
                            {
                                "example_id": "2c2e3067-c929-4418-aaf8-633d72ca31ef",
                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                "text": "„Wer aktuell nach Dänemark ein- oder ausreisen möchte, muss gelegentlich mit Wartezeiten an den Grenzübergängen rechnen.“"
                            },
                            {
                                "example_id": "67d455e3-4e2b-4602-81b4-1982b6b8798b",
                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                "text": "„Nach sechs Wochen Wartezeit kam der Lama endlich.“"
                            },
                            {
                                "example_id": "3c2771a9-7aea-429d-91a9-4941e1020081",
                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                "text": "„Von Zeit zu Zeit wandte er sich, in die Hände klatschend, zum Kapellmeister, damit dieser den Einsatz zu einer Polka oder einer Mazurka gebe, um die Wartezeit zu überbrücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ad21409-1143-462e-9bb6-9f8bc9687447",
                        "source_entry_id": "c0db52e0-7617-3931-a83b-a770323fcf64",
                        "source_sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
