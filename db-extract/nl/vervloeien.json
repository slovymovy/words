                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3cd741f-1b20-3946-8928-39b215318a7a",
                        "entry_id": "27959af9-d72d-3d21-9ddb-46df06ce6329",
                        "glosses": [
                            "geleidelijk overgaan van de ene in de andere vorm met veel tussenstadia en zonder duidelijke begrenzingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f28286b-ad01-4e21-97d8-10f37856a107",
                                "sense_id": "d3cd741f-1b20-3946-8928-39b215318a7a",
                                "text": "Ook het nieuwste aandenken in dit nimmer opdrogende tranendal springt in het oog: het gezicht van moeder verworden tot een hologram, gegoten in een plastic blok en beschenen door een lichtbron die haar verstilde blik doet vervloeien van geel naar groen en van rood naar blauw."
                            },
                            {
                                "example_id": "0b80609d-f472-4600-8ebe-a42914ab655f",
                                "sense_id": "d3cd741f-1b20-3946-8928-39b215318a7a",
                                "text": "Wie ze snel achtereen bekijkt, ziet al die beelden vervloeien tot kleurige vlekken onder een veelal zonnige hemel (of binnenshuis onder lamplicht), beelden zonder duidelijke betekenis. HP de Tijd 13/05"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e71df357-5a7d-428c-aff5-de49d37c5fbc",
                        "source_entry_id": "27959af9-d72d-3d21-9ddb-46df06ce6329",
                        "source_sense_id": "d3cd741f-1b20-3946-8928-39b215318a7a",
                        "source_sense_description": "geleidelijk overgaan van de ene in de andere vorm met veel tussenstadia en zonder duidelijke begrenzingen",
                        "target_lang_word": "blend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cff79e9b-0029-3591-8cff-243475ae2c44",
                                        "entry_id": "d560d0fe-9687-3cea-a6de-5bba50aa317d",
                                        "glosses": [
                                            "A mixture of two or more things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7292bf-307b-422d-aaf4-b2bc94b984a4",
                                                "sense_id": "cff79e9b-0029-3591-8cff-243475ae2c44",
                                                "text": "Their music has been described as a blend of jazz and heavy metal."
                                            },
                                            {
                                                "example_id": "5749d33d-8087-4d4e-8a31-30d37517dd92",
                                                "sense_id": "cff79e9b-0029-3591-8cff-243475ae2c44",
                                                "text": "Our department has a good blend of experienced workers and young promise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7050be1c-83c8-3bdb-a01f-beb244130d1b",
                                        "entry_id": "d560d0fe-9687-3cea-a6de-5bba50aa317d",
                                        "glosses": [
                                            "A word formed by combining two other words; a grammatical contamination, portmanteau word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5b0c6f-502a-438a-8fd0-d830b8c9eef9",
                                                "sense_id": "7050be1c-83c8-3bdb-a01f-beb244130d1b",
                                                "text": "Blends, also known as portmanteau words, are not an original part of English. That is, none occur in Old or Middle English, nor even in Elizabethan English, with the earliest known example being the rare and now obsolete term tomaxe, a blend of tomahawk and axe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "284fa720-5987-341b-9912-fe69605b3cb7",
                                        "entry_id": "728e2f61-63e1-3088-b3af-3e50a1c75bfb",
                                        "glosses": [
                                            "To mingle; to mix; to unite intimately; to pass or shade insensibly into each other."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63863373-a3f5-475b-8f30-afb858620dc2",
                                                "sense_id": "284fa720-5987-341b-9912-fe69605b3cb7",
                                                "text": "To make hummus you need to blend chickpeas, olive oil, lemon juice and garlic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfb0a82-edb1-350e-ab66-bdef57e1f244",
                                        "entry_id": "728e2f61-63e1-3088-b3af-3e50a1c75bfb",
                                        "glosses": [
                                            "To be mingled or mixed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee67516-e94a-495d-8425-dc952fca08d8",
                                                "sense_id": "ecfb0a82-edb1-350e-ab66-bdef57e1f244",
                                                "text": "There is a tone of solemn and sacred feeling that blends with our conviviality."
                                            },
                                            {
                                                "example_id": "e087a10e-280d-461a-9c17-254074fba67a",
                                                "sense_id": "ecfb0a82-edb1-350e-ab66-bdef57e1f244",
                                                "text": "To feel no other breezes than are blown / Through its tall woods with high romances blent"
                                            },
                                            {
                                                "example_id": "f1e8813a-d6b4-4ab3-9d2b-5b211b8017ba",
                                                "sense_id": "ecfb0a82-edb1-350e-ab66-bdef57e1f244",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            },
                                            {
                                                "example_id": "9de19bc1-dc48-4f19-91fb-0a3c24e2bd37",
                                                "sense_id": "ecfb0a82-edb1-350e-ab66-bdef57e1f244",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3891884-cfa0-3fb7-8b6a-529d3e098e52",
                                        "entry_id": "728e2f61-63e1-3088-b3af-3e50a1c75bfb",
                                        "glosses": [
                                            "To pollute by mixture or association; to spoil or corrupt; to blot; to stain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8aef26-c866-437c-b3d6-b5964b8d804d",
                                                "sense_id": "c3891884-cfa0-3fb7-8b6a-529d3e098e52",
                                                "text": "These stormes, which now his beauty blend,\nShall turn to calmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
