                                        "sense_id": "c9070225-9c47-3662-ab1c-331d6aa54aee",
                                        "entry_id": "aa06a83d-79b0-3c3d-b44b-aed1a4d20fab",
                                        "glosses": [
                                            "Lack of restraint; the quality of being unrestrained."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15ecb3f1-d46a-4efb-b994-648a1ed4bdab",
                                                "sense_id": "c9070225-9c47-3662-ab1c-331d6aa54aee",
                                                "text": "His bluntly effective touring cohort — the guitarist Robin Finck, the bassist Justin Meldal-Johnsen and the drummer Ilan Rubin — gave him all the power he could use, surging and thrashing with deceptive unrestraint."
                                            }
