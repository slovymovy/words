                ],
                "senses": [
                    {
                        "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                        "entry_id": "6cea08b4-adde-36bb-8ff9-8c30cca844f6",
                        "glosses": [
                            "leicht abwertend: anhaltendes, einfaches, wenig ansprechendes Singen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89cdd8c-aa81-4ae0-8249-66a91427a004",
                                "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                                "text": "„Die Wilden sangen eine Weile - wenn man ihren zittrigen, von Zungenschnalzen und Zähneklappern unterbrochenen Singsang als Gesang bezeichnen konnte, in dem die gellenden Frauenstimmen das Gebrummel der Männer übertönten.“"
                            },
                            {
                                "example_id": "6893aa5f-94ae-4c39-814e-485103c87949",
                                "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                                "text": "„Schlachten, Arbeiten, Essen werden vom Singsang der Krieger und Mädchen begleitet.“"
                            },
                            {
                                "example_id": "beb4fdff-848d-436e-ae0e-c624e088908b",
                                "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                                "text": "„Sie tanzten jetzt im Takt, und der Singsang erfaßte sie immer mehr und fiel in festen Rhythmus.“"
                            },
                            {
                                "example_id": "3e2c3384-3b2c-4485-8743-e0ec725baf6f",
                                "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                                "text": "„Hermanns Singsang lullte ein.“"
                            },
                            {
                                "example_id": "30601de8-17ea-4cbd-b4fe-8eadc554df86",
                                "sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                                "text": "„Die Großmütter sprachen in einem murmelnden Singsang, wiegten sich vor und zurück und redeten in Zungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b45173e-2c6d-4fe7-b5a0-86785d355f8c",
                        "source_entry_id": "6cea08b4-adde-36bb-8ff9-8c30cca844f6",
                        "source_sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                        "source_sense_description": "leicht abwertend: anhaltendes, einfaches, wenig ansprechendes Singen",
                        "target_lang_word": "sing-song",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sing-song",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a71943-4593-3d81-9a8c-8aad50e48d2c",
                                        "entry_id": "21f31cf8-fd23-36c9-bad5-46714122cdf3",
                                        "glosses": [
                                            "Alternative form of singsong."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3592cd77-108e-46eb-b7f4-20665915225c",
                                                "sense_id": "f1a71943-4593-3d81-9a8c-8aad50e48d2c",
                                                "text": "As Jürgen Klopp took Sadio Mané in his arms and spun him like a beloved ballroom partner, there was a moment of sing-song communion with the Kop. They love these big fat emotional notes here."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sing-song",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe78468d-2c42-3a24-9fe4-910d683d448b",
                                        "entry_id": "853b5a88-294e-3cff-831a-65843f3826cc",
                                        "glosses": [
                                            "Alternative form of singsong."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac172ec2-8bcb-4193-a4a0-aa0b06bd354c",
                                                "sense_id": "fe78468d-2c42-3a24-9fe4-910d683d448b",
                                                "text": "[S]he put on a kind of sing-song voice whenever she was pissed, it was one of the signs that she was really gone […]"
                                            },
                                            {
                                                "example_id": "5236e5a8-63bf-4432-980e-5db4398c4187",
                                                "sense_id": "fe78468d-2c42-3a24-9fe4-910d683d448b",
                                                "text": "Though Bane’s sing-song voice gives his pronouncements a funny lilt, he doesn’t have any of the Joker’s deranged wit, and Nolan isn’t interested in undercutting his seriousness for the sake of a breezier entertainment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88f16d5c-5700-4155-a0df-44815b823484",
                        "source_entry_id": "6cea08b4-adde-36bb-8ff9-8c30cca844f6",
                        "source_sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                        "source_sense_description": "leicht abwertend: anhaltendes, einfaches, wenig ansprechendes Singen",
                        "target_lang_word": "cantilène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantilène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e10074db-2964-38cc-9d13-9cfbb8b425a3",
                                        "entry_id": "52a05043-5693-3c5f-a8b6-a2cca0f670dd",
                                        "glosses": [
                                            "Phrase musicale d’une mélodie du genre simple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc5ef206-aeca-4f35-8cf3-78425f915fa4",
                                                "sense_id": "e10074db-2964-38cc-9d13-9cfbb8b425a3",
                                                "text": "Plus d’une fois, je suis resté attendri, songeant à de délicieux moments : soit que je revisse cette délicieuse fille assise près de ma table, occupée à coudre, paisible, silencieuse, recueillie et faiblement éclairée par le jour qui, descendant de ma lucarne, dessinait de légers reflets argentés sur sa belle chevelure noire; soit que j’entendisse son rire jeune, ou sa voix au timbre riche chanter les gracieuses cantilènes qu’elle composait sans efforts."
                                            },
                                            {
                                                "example_id": "8a53c8b1-57af-4753-9ccf-a13183529afd",
                                                "sense_id": "e10074db-2964-38cc-9d13-9cfbb8b425a3",
                                                "text": "Un homme accroupi à terre, la tête renversée, les yeux clos, comme en rêve, chanta une cantilène ancienne où le mot amour alternait avec le mot mort."
                                            },
                                            {
                                                "example_id": "8d7e7ee5-dd72-42a9-9b97-e0943068a00d",
                                                "sense_id": "e10074db-2964-38cc-9d13-9cfbb8b425a3",
                                                "text": "Le coude souple, le front plissé, il matérialisait la philosophie en cantilène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f2a53f-7387-3e96-b650-0f3d995a18d8",
                                        "entry_id": "52a05043-5693-3c5f-a8b6-a2cca0f670dd",
                                        "glosses": [
                                            "Chanson monotone."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb26da4-4222-4c6f-974d-379abbb2ce65",
                                                "sense_id": "20f2a53f-7387-3e96-b650-0f3d995a18d8",
                                                "text": "Ta voix m’est plus douce que la plus douce des cantilènes."
                                            },
                                            {
                                                "example_id": "b694f215-9a85-43e7-8022-c33974ff90fc",
                                                "sense_id": "20f2a53f-7387-3e96-b650-0f3d995a18d8",
                                                "text": "Avec ma mère, et seulement avec elle, je parlais le russe dans la cantilène d’Odessa. Je ne l’ai plus pratiqué et je n’ai pas appris à la lire. Je connais par cœur des vers de Pouchkine qu’elle aimait, mais je ne sais pas les retrouver sur une page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23005c75-bc44-383a-8d87-525381261984",
                                        "entry_id": "52a05043-5693-3c5f-a8b6-a2cca0f670dd",
                                        "glosses": [
                                            "Morceau de poésie."
                                        ],
                                        "tags": [
                                            "Middle-Ages",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84208635-0f5a-449c-b176-966b531de1dc",
                                                "sense_id": "23005c75-bc44-383a-8d87-525381261984",
                                                "text": "D'interminables querelles ont opposé - et opposent encore - les médiévistes sur les origines de La Chanson de Roland, ses rapports avec l'histoire, l'existence de cantilènes qui auraient précédé sa composition, l'auteur (ou les auteurs) du poème qui nous est parvenu, la forme primitive de celui-ci, etc."
                                            },
                                            {
                                                "example_id": "da8ed862-cf60-433e-97cd-948dc4c8fc3e",
                                                "sense_id": "23005c75-bc44-383a-8d87-525381261984",
                                                "text": "La cantilène de sainte Eulalie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec94c4b9-3c6c-431f-8a9f-06821b693a9e",
                        "source_entry_id": "6cea08b4-adde-36bb-8ff9-8c30cca844f6",
                        "source_sense_id": "0f0c35f4-a1f1-3525-8cb9-493d3b38f68e",
                        "source_sense_description": "leicht abwertend: anhaltendes, einfaches, wenig ansprechendes Singen",
                        "target_lang_word": "mélopée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélopée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d442f327-1c67-3395-9efe-cf853a2dd231",
                                        "entry_id": "18dc0b1b-5835-31a4-a2f0-2b3bce95a0df",
                                        "glosses": [
                                            "Composition du chant, on ne l’emploie qu’en parlant de la musique antique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                        "entry_id": "18dc0b1b-5835-31a4-a2f0-2b3bce95a0df",
                                        "glosses": [
                                            "Déclamation chantée ; chant récitatif ; chant monotone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c0e5446-aa8f-497f-9c72-d5fd97f89a26",
                                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                                "text": "S’accompagnant de son gimbri, il nous chante, d'une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            },
                                            {
                                                "example_id": "5f6cdacc-49e4-4983-b6d6-a19b52335405",
                                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                                "text": "Brusquement, le grondement sonore des tambourins, vient couvrir toutes les voix. Les chanteuses, d’une voix chevrotante, entonnent une étrange mélopée : « Nous célébrons une fête pour nos seigneurs les esprits. »"
                                            },
                                            {
                                                "example_id": "86b264ad-1de3-48a1-bd81-ab99bddb52f2",
                                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                                "text": "Je fredonne une mélopée de mon pays, bercé par les cahots incessants du chemin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mélopée",
