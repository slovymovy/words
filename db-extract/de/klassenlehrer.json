                ],
                "senses": [
                    {
                        "sense_id": "67115ac5-ae22-363b-b276-5a25914985df",
                        "entry_id": "91e12014-5250-332a-a0bb-6f0b21c2b0fb",
                        "glosses": [
                            "Lehrer, der für eine ihm zugewiesene Schulklasse (meist über mehrere Jahre) verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b085f8-cab1-443a-9dd5-55fba2e5ae9f",
                                "sense_id": "67115ac5-ae22-363b-b276-5a25914985df",
                                "text": "Der Klassenlehrer belehrte seine Klasse in Vorbereitung auf die Klassenfahrt."
                            },
                            {
                                "example_id": "b62de9be-0eee-40cc-bed8-439c503dfd38",
                                "sense_id": "67115ac5-ae22-363b-b276-5a25914985df",
                                "text": "„Durch Vermittlung seines Klassenlehrers trat die Demonstrationsperson wiederholt im Kinderfunk des Senders Hamburg auf und hinterließ nach Meinung der Redakteurin einen außergewöhnlichen Eindruck …“"
                            },
                            {
                                "example_id": "7866b2cc-e5ab-4e70-aac5-a644486252d3",
                                "sense_id": "67115ac5-ae22-363b-b276-5a25914985df",
                                "text": "„Mein Klassenlehrer in der Grundschule wollte mich auf die Sonderschule abschieben.“"
                            },
                            {
                                "example_id": "71b149be-9ff5-48c0-9ac8-3bef1c7e68dd",
                                "sense_id": "67115ac5-ae22-363b-b276-5a25914985df",
                                "text": "„Die Klasse hieß 1. IG nach den Initialen des Klassenlehrers, Ingibjörn Grétarsson, der sie während Elisabets gesamter Schullaufbahn unterrichtet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
