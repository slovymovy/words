                ],
                "senses": [
                    {
                        "sense_id": "cef15931-c3aa-32f1-be1c-ffaad23da43e",
                        "entry_id": "c7328a74-d228-3a94-a704-8243b0844e88",
                        "glosses": [
                            "Faire perdre la virginité (à une femme, ce latinisme n'étant guère utilisé que par des écrivains pour qui l'étymon virgo — jeune fille — est sensible)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ed84b409-8856-4ff3-b1e3-df1030a3327f",
                                "sense_id": "cef15931-c3aa-32f1-be1c-ffaad23da43e",
                                "text": "Nous avons un de nos confrères, qui avait une maîtresse de seize ans, dont il jouissait à sa manière, comme je prétends jouir de ta femme à la mienne, quand une fois je l’aurai dévirginée."
                            },
                            {
                                "example_id": "006e682a-fe35-4524-af77-67a2411ee8f4",
                                "sense_id": "cef15931-c3aa-32f1-be1c-ffaad23da43e",
                                "text": "Les Thespiens disaient que les filles de ce roi n'avaient pas été dévirginées par Hercule en quelques heures, mais offertes successivement par leur père qui voulait avoir des enfants de lui."
                            }
                        ]
                    }
                ],
