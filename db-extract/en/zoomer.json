                        ],
                        "examples": [
                            {
                                "example_id": "0b0134f2-688d-4d87-a753-c075ec51e9fc",
                                "sense_id": "0f370f9a-e5ed-3e15-8e8f-24363b75a636",
                                "text": "A recent study released by the Conference Board of Canada states that the Zoomers (Baby Boomers who refuse to age), Gen X and Gen Y have more in common than we might think."
