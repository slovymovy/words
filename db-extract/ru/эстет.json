                                "target_senses": [
                                    {
                                        "sense_id": "45b437ed-fd92-3798-a0c8-f862359547ba",
                                        "entry_id": "8b42629f-21fa-382c-a226-b2b7f0f0bbfb",
                                        "glosses": [
                                            "chi antepone la ricerca del concetto di bello a qualsiasi altro valore"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a16dda2f-d2b9-3105-862e-451a32dce9f8",
                                        "entry_id": "8b42629f-21fa-382c-a226-b2b7f0f0bbfb",
                                        "glosses": [
                                            "(anche spregiativo) persona di gusti, modi e linguaggio eccessivamente raffinati e ricercati"
                                        ],
