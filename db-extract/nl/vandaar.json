                                "sense_id": "b8b64266-dd46-31b4-b4a7-838be945a32b",
                                "text": "Hij had vreselijke haast. Vandaar die bon."
                            },
                            {
                                "example_id": "06ed18ff-e6fd-4864-876b-78b48e43eedb",
                                "sense_id": "b8b64266-dd46-31b4-b4a7-838be945a32b",
                                "text": "'Zijn telefoon lag op zijn bed en daar kwam ik uw gegevens tegen, vandaar dat ik u bel."
                            },
                            {
                                "example_id": "3238133a-47fa-4552-b5f6-f81e3f20f808",
                                "sense_id": "b8b64266-dd46-31b4-b4a7-838be945a32b",
                                "text": "Er was drie jaar voor de verbouwing uitgetrokken, vandaar dat het zaak was om goed te beginnen en een sterk team te vormen."
                            }
                        ]
