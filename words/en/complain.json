{
    "word_family": [
        "complaint",
        "complainer",
        "complainant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                    "sense_definition": "To express feelings of pain, dissatisfaction, or resentment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Joe was always <w>complaining</w> about the noise made by his neighbors.",
                            "target_lang_translations": {
                                "ru": "Джо вечно <w>жаловался</w> на шум от соседей.",
                                "zh": "乔总是因为邻居制造的噪音而<w>抱怨</w>。"
                            }
                        },
                        {
                            "text": "She called the manager to <w>complain</w> about the poor service.",
                            "target_lang_translations": {
                                "ru": "Она позвонила менеджеру, чтобы <w>пожаловаться</w> на плохое обслуживание.",
                                "zh": "她打电话给经理<w>投诉</w>服务质量差的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grumble",
                        "moan",
                        "whine",
                        "gripe",
                        "grouse"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "complain about",
                        "complain of",
                        "nothing to complain about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать чувство боли, неудовлетворенности или обиды",
                        "zh": "表达痛苦、不满或怨恨的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "выражать недовольство или боль"
                            },
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "разг. надоедливо жаловаться"
                            },
                            {
                                "target_lang_word": "сетовать",
                                "target_lang_sense_clarification": "книжн. выражать сожаление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "表达不满或怨恨"
                            },
                            {
                                "target_lang_word": "发牢骚",
                                "target_lang_sense_clarification": "口语，指不断地抱怨"
                            },
                            {
                                "target_lang_word": "诉苦",
                                "target_lang_sense_clarification": "向人倾诉自己的痛苦或困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                    "sense_definition": "To make a formal accusation or bring a formal charge against someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have <w>complained</w> about me to the police again.",
                            "target_lang_translations": {
                                "ru": "Они снова <w>пожаловались</w> на меня в полицию.",
                                "zh": "他们又向警察<w>控告</w>我了。"
                            }
                        },
                        {
                            "text": "If you are cheated by a company, you should <w>complain</w> to the authorities.",
                            "target_lang_translations": {
                                "ru": "Если компания вас обманула, вам следует <w>подать жалобу</w> в соответствующие органы.",
                                "zh": "如果你被一家公司欺骗了，你应该向有关部门<w>投诉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "charge"
                    ],
                    "common_phrases": [
                        "complain to the police",
                        "complain to the manager"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдвигать официальное обвинение или претензию против кого-либо",
                        "zh": "提出正式指控或向有关部门投诉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать жалобу",
                                "target_lang_sense_clarification": "официальное действие"
                            },
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "сообщать о нарушении властям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投诉",
                                "target_lang_sense_clarification": "向有关部门或机构提出正式意见"
                            },
                            {
                                "target_lang_word": "控告",
                                "target_lang_sense_clarification": "向司法机关提出正式指控"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b9aab22-3c2f-38cc-a1ed-2bc0385e37d2",
                    "sense_definition": "To make a creaking or squeaking sound under pressure, like wood or metal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden stairs <w>complained</w> under his heavy weight.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная лестница <w>скрипела</w> под его тяжелым весом.",
                                "zh": "老旧的木楼梯在他沉重的体重下<w>嘎吱作响</w>。"
                            }
                        },
                        {
                            "text": "We could hear the <w>complaining</w> wheels of the cart from far away.",
                            "target_lang_translations": {
                                "ru": "Мы слышали <w>скрипящие</w> колеса телеги издалека.",
                                "zh": "我们从很远的地方就能听到那辆手推车轮子发出的<w>吱吱</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creak",
                        "groan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать скрип или скрежет под давлением (о дереве или металле)",
                        "zh": "指木头或金属在压力下发出吱吱作响的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрипеть",
                                "target_lang_sense_clarification": "издавать резкий звук трения"
                            },
                            {
                                "target_lang_word": "стонать",
                                "target_lang_sense_clarification": "перен. издавать протяжный звук под нагрузкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吱吱作响",
                                "target_lang_sense_clarification": "形容物体受压时发出的声音"
                            },
                            {
                                "target_lang_word": "嘎吱作响",
                                "target_lang_sense_clarification": "形容木质结构受压时的声音"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}