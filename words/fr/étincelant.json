                {
                    "sense_id": "c773976d-fd73-333f-804f-6a67eb27f2da",
                    "sense_definition": "Qui se distingue par une grande vivacité intellectuelle ou une brillante créativité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eclat_intellectuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur a captivé le public grâce à un esprit <w>étincelant</w> et plein d'humour.",
                            "target_lang_translations": {
                                "en": "This author captivated the audience with a <w>scintillating</w> wit full of humour.",
                                "ru": "Этот автор покорил публику <w>блестящим</w> умом, полным юмора.",
                                "de": "Dieser Autor fesselte das Publikum mit einem <w>sprühenden</w> und humorvollen Geist.",
                                "es": "Este autor cautivó al público con un ingenio <w>brillante</w> y lleno de humor.",
                                "zh": "这位作家凭借<w>才思敏捷</w>的头脑和诙谐幽默，赢得了观众的心。"
                            }
                        },
                        {
                            "text": "Sa conversation était toujours <w>étincelante</w> et riche en réparties inattendues.",
                            "target_lang_translations": {
                                "en": "Her conversation was always <w>scintillating</w>, full of unexpected witty retorts.",
                                "ru": "Её беседа всегда была <w>искромётной</w> и полной неожиданных остроумных реплик.",
                                "de": "Ihre Unterhaltung war stets <w>sprühend</w> und voller unerwarteter schlagfertiger Antworten.",
                                "es": "Su conversación era siempre <w>chispeante</w> y rica en réplicas inesperadas.",
                                "zh": "她的谈吐总是十分<w>机智</w>，常有出人意料的妙语。"
                            }
                        }
                    ],
