                "entry_id": "80f47ed5-9863-3b00-bfd7-5c7f7d3b6cd4",
                "word": "Ravenna",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6361ca5-d2f3-3e14-a634-402086206f22",
                        "entry_id": "80f47ed5-9863-3b00-bfd7-5c7f7d3b6cd4",
                        "glosses": [
                            "A province in the region of Emilia-Romagna, in northern Italy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8cdd0255-7a41-3fa1-add2-ad3402bbf501",
                        "entry_id": "80f47ed5-9863-3b00-bfd7-5c7f7d3b6cd4",
                        "glosses": [
                            "A coastal city, the present-day capital of the province of Ravenna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2643fceb-680e-4696-be65-54c79ee9bb9f",
                                "sense_id": "8cdd0255-7a41-3fa1-add2-ad3402bbf501",
                                "text": "Ravenna served as the capital city of the Western Roman Empire from 402 until the latter's collapse in 476; thereafter it was the capital of the Ostrogothic Kingdom and then of the Byzantine Exarchate of Ravenna until the last exarch was executed by the Lombards in 751."
                            }
                        ]
                    },
                    {
                        "sense_id": "719e4414-7414-387f-ba81-46f950c7d25d",
                        "entry_id": "80f47ed5-9863-3b00-bfd7-5c7f7d3b6cd4",
                        "glosses": [
                            "A city, the county seat of Portage County, Ohio, United States, named after the Italian city."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b834e4d9-8ffe-4f58-939b-77e14c2957c2",
