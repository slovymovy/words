                "senses": [
                    {
                        "sense_id": "edce621e-9980-39e7-b1f3-ba57dd15813d",
                        "entry_id": "c04dcb9b-e15a-3e5a-aa59-e7730f7ffc08",
                        "glosses": [
                            "die Grimmigkeit, die Wildheit"
                        ],
                        "tags": [],
                        "examples": [],
