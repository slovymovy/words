                ],
                "senses": [
                    {
                        "sense_id": "0fd5091b-4f3f-3c9d-8f5d-fc2f7d433e84",
                        "entry_id": "466323ab-2369-3b40-9ec9-ac435156154a",
                        "glosses": [
                            "задвижной стержень для запирания дверей, ворот и т. п., а также деталь дверного замка в виде металлического стержня"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a5961c-977a-4731-bc8e-9718cfbe0cab",
                                "sense_id": "0fd5091b-4f3f-3c9d-8f5d-fc2f7d433e84",
                                "text": "Телегин тщательно запер двери на все крючки и задвижки."
                            },
                            {
                                "example_id": "7f49d04d-90b8-4566-931a-042f42ae61e0",
                                "sense_id": "0fd5091b-4f3f-3c9d-8f5d-fc2f7d433e84",
                                "text": "С той стороны отодвинули задвижку; Райский толкнул калитку ногой .."
                            },
                            {
                                "example_id": "144ff198-b2de-4bfe-a8bc-6ad2ec75d94d",
                                "sense_id": "0fd5091b-4f3f-3c9d-8f5d-fc2f7d433e84",
                                "text": "Одна половинка дверей из прихожей в залу никогда не открывалась. Он сам отодвинул железные задвижки и внизу и вверху .."
                            },
                            {
                                "example_id": "b4d58561-1e54-4ca0-8392-62c402907c1c",
                                "sense_id": "0fd5091b-4f3f-3c9d-8f5d-fc2f7d433e84",
                                "text": "Двери запирались одною задвижкою, окна не имели ещё двойных рам."
                            }
                        ]
                    },
                    {
                        "sense_id": "f69f36c1-fe22-3f78-8898-d6fee2a69d43",
                        "entry_id": "466323ab-2369-3b40-9ec9-ac435156154a",
                        "glosses": [
                            "приспособление для закрывания какого-либо отверстия (обычно в виде заслонки)"
                        ],
