                "senses": [
                    {
                        "sense_id": "a0fcc7e1-aed3-3d63-b458-72ea2ea76654",
                        "entry_id": "3580d765-2922-323a-bb95-f404722c9341",
                        "glosses": [
                            "техн. пропитывать жиром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964500f5-87e8-4d5b-871e-298fa578f21f",
                                "sense_id": "a0fcc7e1-aed3-3d63-b458-72ea2ea76654",
                                "text": "После размягчения нужно ополоснуть кожу в чистой воде, дать стечь воде настолько, чтобы кожа оставалась гибкой и чуть влажной, а затем жировать её."
                            }
                        ]
                    }
                ],
