                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The teacher called on <w>Gram</w> to answer the question about history.",
                            "target_lang_translations": {
                                "ru": "Учитель вызвал <w>Грэма</w> ответить на вопрос по истории."
                            }
                        },
                        {
                            "text": "Young <w>Gram</w> was named after his grandfather who lived in Scotland.",
                            "target_lang_translations": {
                                "ru": "Юный <w>Грэм</w> был назван в честь своего дедушки, который жил в Шотландии."
