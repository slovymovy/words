                                    {
                                        "sense_id": "54c862f8-fb0d-3474-bd7f-b82a56603879",
                                        "entry_id": "2d3b1ec7-30fc-353c-a769-83cd105120b1",
                                        "glosses": [
                                            "A Japanese food made by putting ingredients into white rice, wrapping the outside with laver, and shaping it into a triangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fab64f-a858-492d-afc1-b76d2725c840",
                                                "sense_id": "54c862f8-fb0d-3474-bd7f-b82a56603879",
                                                "text": "The sprawling multipage menu offers cleanly executed dishes meant to accompany the sake, including standards like boiled edamame, and the filling rice balls called onigiri that you would expect at any izakaya, or Japanese pub."
                                            },
                                            {
                                                "example_id": "8da2ca65-83ab-4141-ac99-0a6a353cf781",
                                                "sense_id": "54c862f8-fb0d-3474-bd7f-b82a56603879",
                                                "text": "He cooks his breakfast of rice and misoshiru and packs onigiri rice balls for his lunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "576abbcf-0b11-4a31-8abf-9ad72575f1dd",
                        "source_entry_id": "aab95e93-9a13-305b-bd57-f99a3c774584",
                        "source_sense_id": "4eda0bd5-63aa-3ab5-bfe4-f8e9a516fde5",
                        "target_lang_word": "onigiri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onigiri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                        "entry_id": "13f19055-95cc-384d-b043-e50ae6e8e1fc",
                                        "glosses": [
                                            "Boulette de riz japonaise souvent avec du nori et fourrée de garniture comme du thon, du saumon ou une umeboshi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4238adc-c5e8-4af1-9b9f-fd56740cfbae",
                                                "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                                "text": "Écrasez le thon et assaisonnez-le de mayonnaise épicée et d’échalote. Ouvrez le moule à onigiri et remplissez-le à moitié de riz. Salez et poivrez."
                                            },
                                            {
                                                "example_id": "f6ad5c7f-7269-45f9-afb3-2a630cd98980",
                                                "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                                "text": "Les onigiris sont des triangles de riz qui servent d’en-cas, à consommer un peu n’importe où. Très souvent, les Japonais les décorent en coupant des petits morceaux d’algue nori afin de leur donner l’aspect d'un visage de chat, de chien, etc."
                                            },
                                            {
                                                "example_id": "7dfdbd9c-a8d8-4fb0-acaa-2a032c0bcfed",
                                                "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                                "text": "Ma voisine fait une grimace rigolote aussitôt la prune croquée, mais elle continue de manger avec plaisir l’onigiri."
                                            },
                                            {
                                                "example_id": "6d3f6c8f-0e51-42f8-a40d-246175e682a2",
                                                "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                                "text": "Tous les matins, Sunja marchait jusqu’au poste de police pour leur remettre trois onigiri d’orge et de millet. S’il restait un peu d’argent pour un œuf de poule, elle le faisait bouillir puis mariner dans du shouyu pour agrémenter le modeste bento d’Isak."
                                            },
                                            {
                                                "example_id": "107c4225-8d3e-4763-b652-f53807fe8201",
                                                "sense_id": "fecb3570-4426-3087-be4c-124d995193c4",
                                                "text": "Dunes en forme d’Onigiri\nÀ croquer, tout est permis, oui"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
