                        "entry_id": "f891705c-43a9-3594-8e5a-5cd087534150",
                        "glosses": [
                            "Sorte de chanson ou de danse espagnole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7367d042-30ab-4468-9353-3eb81af43da3",
                                "sense_id": "d0fbabe9-e223-3dfd-90a2-f0ca1689422f",
                                "text": "Il me prit envie de chanter avec les jeunes Turcs, qui parurent charmés de m’entendre. Je chantai une séguedille espagnole."
                            },
                            {
                                "example_id": "fcb53695-3e7c-4ad9-b8d3-8324239a9d17",
                                "sense_id": "d0fbabe9-e223-3dfd-90a2-f0ca1689422f",
                                "text": "Près des remparts de Séville\nChez mon ami Lilas Pastia\nNous danserons la Séguedille\nEt boirons du Manzanilla."
                            }
                        ]
                    }
