                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zegekrans",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0bc2541-a221-3dbc-b5f3-7df107ce058c",
                                        "entry_id": "cd87dfd4-2d0c-33fb-9d98-a74475f6f796",
                                        "glosses": [
                                            "een lauwerkrans zoals deze in de Romeinse tijd aan de overwinnende krijgsheer van een oorlog gegeven werd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b19cfd-c793-4a9a-a4cc-0697ad883092",
                                                "sense_id": "e0bc2541-a221-3dbc-b5f3-7df107ce058c",
                                                "text": "Caesar nam een zegekrans in ontvangst en begon aan zijn triomfantelijke intocht in Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31580ea-8089-3d6c-bb04-84f9632e9a6d",
                                        "entry_id": "cd87dfd4-2d0c-33fb-9d98-a74475f6f796",
                                        "glosses": [
                                            "overdrachtelijk een onderscheiding gegeven aan een overwinnaar, bijvoorbeeld in sport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af20ee3c-431c-4bfb-9503-469997d65cf5",
                                                "sense_id": "f31580ea-8089-3d6c-bb04-84f9632e9a6d",
                                                "text": "De zegekrans in deze discipline ging verrassend niet naar de drievoudig kampioen, maar naar een nieuweling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
