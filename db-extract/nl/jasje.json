                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d42751e-b02d-4d4e-b59c-7ff320a125ad",
                                "sense_id": "7c25e777-cf83-3db5-ba3e-52baca40dc0e",
                                "text": "'Odelle ' Door de boogvormige doorgang naar de kamer keek hij naar het feest, dat geen kop of staart meer had en alleen nog een zee van uitgedrukte peuken en gilletjes was, lipjes van bierblikjes, nutteloos geworden haaraccessoires en een jasje dat verkreukeld op de vloer lag."
                            },
                            {
                                "example_id": "b71984da-bb00-4659-a09f-acd156257f29",
                                "sense_id": "7c25e777-cf83-3db5-ba3e-52baca40dc0e",
                                "text": "' Hij lachte weer even, maar deed er toen het zwijgen toe en trok zijn modieuze leren jasje wat strakker om zich heen, alsof dat hem troostte."
                            },
                            {
                                "example_id": "7754673e-5c9d-449b-9e56-ef5edf7fd2f4",
                                "sense_id": "7c25e777-cf83-3db5-ba3e-52baca40dc0e",
                                "text": "' Hij lachte weer even, maar deed er toen het zwijgen toe en trok zijn modieuze leren jasje wat strakker om zich heen, alsof dat hem troostte."
