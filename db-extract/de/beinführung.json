                "senses": [
                    {
                        "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                        "entry_id": "72fd779a-bfbe-3225-9af2-2b03b0089190",
                        "glosses": [
                            "Bewegung der Extremität zum Laufen und Stehen (und Möglichkeit dazu)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223a72d0-1ace-4183-8721-e2c6cf6515a1",
                                "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                                "text": "„Das Fußbrett sollte Höhen- und Winkelverstellbar sein, um eine optimale Beinführung zu gewährleisten.“"
                            },
                            {
                                "example_id": "80773b97-bedd-4f8b-8dc9-14a5f537943e",
                                "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                                "text": "„Auch ist die seitliche Beinführung des nachziehenden Beines so flach als möglich zu gestalten.“"
                            },
                            {
                                "example_id": "8d8af031-963f-46d6-8b67-e6a0e19da76e",
                                "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                                "text": "„Mit flexibler Toplinie und größerer Dynamik durch saubere Beinführung ergatterten sie sich von den elf internationalen Wertungsrichtern 28 Kreuze, die für das Viertelfinale reichten.“"
                            },
                            {
                                "example_id": "352f0f68-4f43-4617-bca9-df0b9f39a14a",
                                "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                                "text": "„Den Anfang machte die Prinzengarde, die in stattlicher Formation die Beine warf und mit Spagat und Beinführungen für Jubel sorgte.“"
                            },
                            {
                                "example_id": "77ae5bc0-5d46-418f-9a66-e5629f314344",
                                "sense_id": "4018e6f8-d9ac-3103-8696-6d7a26484b86",
                                "text": "„Der gilt bei Kennern der Szene wegen akrobatischer Einlagen wie Rädchen, Beinführungen und Sprungspagaten und des anstrengenden Marschschritts als Königsklasse des Gardetanzsports.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
