                                        "examples": [
                                            {
                                                "example_id": "dff820ec-9976-4a18-b97d-b8eb845fcd5c",
                                                "sense_id": "d7e63dda-cc24-3c16-a2e6-bafc567d6f2b",
                                                "text": "The choice of treats is between a sweet mandarin orange and maybe a lumpy rennet apple. Nothing is packaged; there is only food here in this market, most of it requiring washing and chopping and cooking."
                                            }
                                        ]
