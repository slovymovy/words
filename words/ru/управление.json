{
    "word_family": [
        "управлять",
        "управленец",
        "управляющий",
        "самоуправление"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8015cda2-d2fc-3cde-bcd4-2e3d0ab59c8f",
                    "sense_definition": "Деятельность по руководству чем-либо, организации работы, заведованию и контролю.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mgmt_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эффективное <управление> компанией требует большого опыта и знаний.",
                            "target_lang_translations": {
                                "en": "Effective <management> of the company requires a lot of experience and knowledge.",
                                "zh": "有效的公司<w>管理</w>需要丰富的经验和知识。"
                            }
                        },
                        {
                            "text": "Кризисное <управление> помогло спасти завод от банкротства.",
                            "target_lang_translations": {
                                "en": "Crisis <management> helped save the factory from bankruptcy.",
                                "zh": "危机<w>管理</w>帮助工厂免于破产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "руководство",
                        "администрирование"
                    ],
                    "common_phrases": [
                        "система управления",
                        "кризисное управление",
                        "взять управление",
                        "оперативное управление"
                    ],
                    "target_lang_definitions": {
                        "en": "The activity of running a company, organization, or system; the process of dealing with or controlling things or people.",
                        "zh": "指对公司、组织或系统进行经营、组织工作、管理和控制的活动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "management",
                                "target_lang_sense_clarification": "business or general organization"
                            },
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "public or bureaucratic"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理",
                                "target_lang_sense_clarification": "指对组织或业务的经营与管理"
                            },
                            {
                                "target_lang_word": "行政",
                                "target_lang_sense_clarification": "指公共或官僚机构的事务管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83eda404-722d-3005-b77c-761fba4dd5a1",
                    "sense_definition": "Действие по направлению хода или движения механизма, транспортного средства.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "steering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дистанционное <управление> игрушечной машиной очень нравится детям.",
                            "target_lang_translations": {
                                "en": "Remote <control> of the toy car is very popular with children.",
                                "zh": "孩子们非常喜欢玩具车的远程<w>控制</w>。"
                            }
                        },
                        {
                            "text": "Водитель потерял <управление> автомобилем на скользкой дороге.",
                            "target_lang_translations": {
                                "en": "The driver lost <control> of the car on the slippery road.",
                                "zh": "司机在湿滑的路面上失去了对汽车的<w>控制</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "регулирование"
                    ],
                    "common_phrases": [
                        "рулевое управление",
                        "дистанционное управление",
                        "пульт управления",
                        "потерять управление"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of directing the course of a vehicle or the operation of a machine.",
                        "zh": "指引导车辆行驶方向或操作机器运行的行为。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "of a mechanism or vehicle"
                            },
                            {
                                "target_lang_word": "steering",
                                "target_lang_sense_clarification": "guiding direction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "指对机器或车辆的操作"
                            },
                            {
                                "target_lang_word": "操纵",
                                "target_lang_sense_clarification": "指对机械或车辆的驾驶与引导"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb8735fe-d7bc-3a89-b0e8-ccef04a03bad",
                    "sense_definition": "Административное учреждение или крупное структурное подразделение в составе организации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mgmt_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наше <управление> переехало в новый офис в центре города.",
                            "target_lang_translations": {
                                "en": "Our <department> moved to a new office in the city center.",
                                "zh": "我们的<w>部门</w>搬到了市中心的新办公室。"
                            }
                        },
                        {
                            "text": "Главное <управление> банка выпустило новые инструкции для сотрудников.",
                            "target_lang_translations": {
                                "en": "The bank's main <directorate> issued new instructions for employees.",
                                "zh": "银行总<w>管理局</w>为员工发布了新指令。"
                            }
                        }
                    ],
                    "synonyms": [
                        "правление"
                    ],
                    "common_phrases": [
                        "главное управление",
                        "начальник управления",
                        "следственное управление"
                    ],
                    "target_lang_definitions": {
                        "en": "An administrative division, department, or government body responsible for a specific area.",
                        "zh": "指组织内部的行政部门、机构或负责特定领域的政府机关。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "department",
                                "target_lang_sense_clarification": "subdivision of an organization"
                            },
                            {
                                "target_lang_word": "directorate",
                                "target_lang_sense_clarification": "high-level administrative unit"
                            },
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "government agency"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部门",
                                "target_lang_sense_clarification": "组织内部的职能单位"
                            },
                            {
                                "target_lang_word": "管理局",
                                "target_lang_sense_clarification": "负责特定行政事务的机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c190bef-22a3-33a7-8cc3-2c24f715fc73",
                    "sense_definition": "Вид подчинительной связи в грамматике, при котором главное слово требует от зависимого определённого падежа.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русском языке существует падежное <управление> предлогов.",
                            "target_lang_translations": {
                                "en": "In Russian, there is case <government> of prepositions.",
                                "zh": "俄语中存在介词的格<w>支配</w>。"
                            }
                        },
                        {
                            "text": "Учитель объяснил нам глагольное <управление> на уроке русского языка.",
                            "target_lang_translations": {
                                "en": "The teacher explained verbal <government> to us in the Russian class.",
                                "zh": "老师在俄语课上为我们讲解了动词<w>支配</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "глагольное управление",
                        "падежное управление",
                        "сильное управление"
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatical relationship where a head word requires a dependent word to take a specific form (case).",
                        "zh": "语法中的一种从属关系，即中心词要求从属词采用特定的格形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "government",
                                "target_lang_sense_clarification": "in grammar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支配",
                                "target_lang_sense_clarification": "语法中指词语对格的限定关系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}