                "senses": [
                    {
                        "sense_id": "51d5d229-65c1-392f-bbc7-490358bf3a26",
                        "entry_id": "08533e17-5664-3edc-9191-927df75e8328",
                        "glosses": [
                            "politische Bewegung und Einstellung zur Vereinigung der Völker germanischen Ursprungs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "febc8da0-12d3-48ba-afa4-c36cf7ceacaa",
                                "sense_id": "51d5d229-65c1-392f-bbc7-490358bf3a26",
                                "text": "„Hitlers antibolschewistischer Glaube verschmolz, […], ganz zwanglos mit einem nicht weniger grundsätzlichen ideologischen Thema, das er vom Pangermanismus übernommen hatte: dem Bedürfnis des Volkes, einen «Lebensraum» im Osten zu kontrollieren, der so ausgedehnt war, wie es die rassischen und strategischen Gründe erforderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62e920a9-e559-40ca-acf8-e944dd0af0b7",
                        "source_entry_id": "08533e17-5664-3edc-9191-927df75e8328",
                        "source_sense_id": "51d5d229-65c1-392f-bbc7-490358bf3a26",
                        "source_sense_description": "Politik: politische Bewegung und Einstellung zur Vereinigung der Völker germanischen Ursprungs",
                        "target_lang_word": "Pan-Germanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pan-Germanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0539f97b-5286-3ba2-808f-a6155db9ba41",
                                        "entry_id": "e87ae809-6a18-3e1f-bb40-3ce875d5f6f9",
                                        "glosses": [
                                            "A movement striving to create a political union of all Germans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee711333-7f6c-4771-b4c4-529cef9cb37e",
                        "source_entry_id": "08533e17-5664-3edc-9191-927df75e8328",
                        "source_sense_id": "51d5d229-65c1-392f-bbc7-490358bf3a26",
                        "source_sense_description": "Politik: politische Bewegung und Einstellung zur Vereinigung der Völker germanischen Ursprungs",
                        "target_lang_word": "pangermanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pangermanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b30b21d-7511-3d76-8836-1b8a9fa7d12d",
                                        "entry_id": "2d7e2fc2-0207-315e-824c-6b21c838da85",
                                        "glosses": [
                                            "Doctrine politique suivant laquelle tous les peuples germaniques doivent être groupés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611c5817-c156-4b07-a4af-300183b70818",
                                                "sense_id": "2b30b21d-7511-3d76-8836-1b8a9fa7d12d",
                                                "text": "Établir la vérité sur les âges disparus n’a jamais été la préoccupation dominante de leurs recherches : ils ont surtout demandé à ces âges des précédents à leur politique, des précurseurs à leurs grands hommes. Le pangermanisme n’a pas consisté seulement à étendre dans l’espace la grandeur du nom allemand, mais encore à la reculer dans le temps, à incorporer à leur patrimoine des terres d’aujourd’hui et des êtres de jadis."
                                            },
                                            {
                                                "example_id": "bc2b376f-bc4c-46ab-80e5-38224bc378ab",
                                                "sense_id": "2b30b21d-7511-3d76-8836-1b8a9fa7d12d",
                                                "text": "Il s’est inspiré de l’historien allemand Treitschke, maître du pangermanisme moderne et violent adversaire de la France […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
