                    "sense_id": "ac496760-dc9e-3b6e-9d03-90c6aee38f9a",
                    "sense_definition": "Covered or coated with a layer of plaster.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surface_coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>plastered</w> the ceiling to create a smooth finish.",
                            "target_lang_translations": {
                                "nl": "De werkers <w>bepleisterden</w> het plafond om een gladde afwerking te creëren."
                            }
                        },
                        {
                            "text": "The old cottage had <w>plastered</w> walls that were painted a soft white.",
                            "target_lang_translations": {
                                "nl": "Het oude huisje had <w>bepleisterde</w> muren die zachtwit waren geschilderd."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedekt of bekleed met een laag pleisterwerk of gips."
                    },
                    "translations": {
