                    {
                        "sense_id": "ebac8cf7-2b30-3f31-858d-dbeef6c67cac",
                        "entry_id": "8ed54a9d-6877-3e89-b429-e93fa209cee7",
                        "glosses": [
                            "gebiedende wijs van verwachten"
