        "nl-extract.jsonl": [
            {
                "entry_id": "208f6ba6-a2e6-32aa-bb1b-e02734ef0b71",
                "word": "langzamerhand",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "15b9d5f1-ff20-3b6a-a4a1-d59c12148a53",
                        "entry_id": "208f6ba6-a2e6-32aa-bb1b-e02734ef0b71",
                        "glosses": [
                            "geleidelijk aan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c4d903-48e8-458e-adf1-b2818f9bfac3",
                                "sense_id": "15b9d5f1-ff20-3b6a-a4a1-d59c12148a53",
                                "text": "Langzamerhand kwam ik in een gestage cadans en ik begon me steeds meer op mijn gemak te voelen in deze omgeving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78a70f19-ebd3-4d46-9a34-b3c34fe26dae",
                        "source_entry_id": "208f6ba6-a2e6-32aa-bb1b-e02734ef0b71",
                        "source_sense_id": "15b9d5f1-ff20-3b6a-a4a1-d59c12148a53",
                        "target_lang_word": "gradually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gradually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "In a gradual manner; making slow progress; slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3386cf-1314-417c-98e4-c47b4e80980f",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The most likely conclusion, the researchers say, is that the Levallois method was not taken to Eurasia by African migrants, but evolved there gradually and independently."
                                            },
                                            {
                                                "example_id": "8e59594e-b4da-44f4-879f-a59203f643f4",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The instrument of this dumbing down in Nineteen Eighty-Four was Newspeak, the official language of the English Socialist Party (Ingsoc). Newspeak was a sort of Totalitarian Esperanto that sought gradually to diminish the range of what was thinkable by eliminating, contracting and manufacturing words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "by degrees"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291a7cab-11fc-4167-afc0-f69d0bf0d090",
                                                "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                                "text": "Horns, upon the due accession of Moisture, doth gradually become Soft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5d4e314-cd26-49af-9bcb-989848d26efa",
                        "source_entry_id": "208f6ba6-a2e6-32aa-bb1b-e02734ef0b71",
                        "source_sense_id": "15b9d5f1-ff20-3b6a-a4a1-d59c12148a53",
                        "target_lang_word": "little by little",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little by little",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                        "entry_id": "e26f6f72-a2d5-3d57-8be2-0da540b66c9d",
                                        "glosses": [
                                            "A small amount at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf96de4-5e0e-4d44-84f8-218a580455b2",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "\"[…]Everything else has gone from me, little by little, but I have kept this.[…]\""
                                            },
                                            {
                                                "example_id": "e5efcccc-ac06-432b-a08f-fb8d2d846ea8",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Little by little his head cleared, and he began once more to take a personal interest in the battle."
                                            },
                                            {
                                                "example_id": "7b7dcc75-b754-4bad-97d0-4179f46a50b7",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Cos little by little / We gave you everything / You ever dreamed of. / Little by little / The wheels of your life / Have slowly fallen off."
                                            },
                                            {
                                                "example_id": "9d0f0796-1320-498e-b021-11c36c91b5c0",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Iraq's government has been removing blast walls little by little since late 2008, trying to restore a semblance of normalcy to this bunker city."
                                            },
                                            {
                                                "example_id": "d908bc45-7a7b-4565-b66f-9f296830913d",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "What came instead over the following years were many of the same projects delivered individually to little-by-little add capacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e12f1c3-fd21-467d-a6aa-1d7e949e5ca6",
                        "source_entry_id": "208f6ba6-a2e6-32aa-bb1b-e02734ef0b71",
                        "source_sense_id": "15b9d5f1-ff20-3b6a-a4a1-d59c12148a53",
                        "target_lang_word": "au fur et à mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au fur et à mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                        "entry_id": "4de0a6ed-c71e-3fac-b39b-d0b55bdc5720",
                                        "glosses": [
                                            "Progressivement ; à proportion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a7e671-f01e-4700-9abb-fb11ebe33c66",
                                                "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                                "text": "J'ai développé le projet au fur et à mesure des mois et des années."
                                            },
                                            {
                                                "example_id": "74e1865f-bded-4858-95e3-bf6a04c04241",
                                                "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                                "text": "Art. 20. Le comité des fonds tient un registre dans lequel sont énoncées au fur et à mesure les dépenses ainsi autorisées, avec indication de l'époque à laquelle leur paiement est présumé devoir s'effectuer."
                                            },
                                            {
                                                "example_id": "0e9abc49-2546-477d-9605-482dcfa6470e",
                                                "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                                "text": "Par voie de conséquence, l'accumulation de capital humain et la croissance augmenteraient également au fur et à mesure du développement de l'économie."
                                            },
                                            {
                                                "example_id": "8a0456ba-1982-4462-9f46-66e2f89b9bd4",
                                                "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                                "text": "Tambour battant, je lançais dans sa direction des ballons soufflés au fur et à mesure. Dix minutes plus tard, une vingtaine de ballons multicolores trônaient à ses pieds ; […]."
                                            },
                                            {
                                                "example_id": "6f21e804-fc5d-4b85-88e9-332668024270",
                                                "sense_id": "28dd0d19-539f-39cb-89f9-6ab29ee6c29a",
                                                "text": "Il me conduisit à travers d'innombrables et immenses salles, dans lesquelles il me présenta à des hordes de gens, dont j'oubliais les noms au fur et à mesure qu'il les énonçait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
