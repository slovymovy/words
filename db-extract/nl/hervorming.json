                            {
                                "target_word": "Reformation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                        "entry_id": "438edb43-601c-3152-8464-a539afc4fc27",
                                        "glosses": [
                                            "im engeren Sinn eine kirchliche Erneuerungsbewegung des 16. Jahrhunderts, die zur Spaltung des westlichen Christentums in verschiedene Konfessionen führte"
                                        ],
                                        "tags": [
                                            "historical",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b94b27c-e9fd-4840-9b86-a45b7b7c0311",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "„Die Reformation war einer der großen Wendepunkte in der Geschichte des Abendlandes.“"
                                            },
                                            {
                                                "example_id": "f87755e5-260a-4d72-bcb3-f515e59f5e3d",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Mit seinen Thesen löste Martin Luther am 31. Oktober 1517 die Reformation aus."
                                            },
                                            {
                                                "example_id": "7fe8d44e-b6b5-4c5a-8e63-49b67d25c364",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Um die Reformation durchzusetzen, baute Martin Luther von Anfang an auf Schrift und Bild."
                                            },
                                            {
                                                "example_id": "a99fc37b-2658-4574-bb5c-593e6a95282e",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Danke, Luther! Die Reformation kann gar nicht genug gefeiert werden. Denn Luther hat nicht nur eine religiöse Revolution ausgelöst, sondern auch einen politischen Wandel, der die Welt verändert hat, meint Astrid Prange."
                                            },
                                            {
                                                "example_id": "33931b66-5994-464f-9f14-e794ae8e4b85",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Im Allgemeinen gilt der Augsburger Religionsfrieden von 1555 als vorläufiges Ende des Zeitalters der Reformation in Deutschland."
                                            },
                                            {
                                                "example_id": "c8a34491-0e78-459f-af01-63b2182e0715",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Nach der Reformation und der Gegenreformation mussten die Menschen entweder Protestant oder Katholik sein."
                                            },
                                            {
                                                "example_id": "6e7ecfd5-d029-4657-8668-2576a8897cc5",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "Infolge der Reformation kam es zu mehreren Religionskriegen in Europa."
                                            },
                                            {
                                                "example_id": "dc3c2de0-cb31-4f64-b1d6-04e9758cd45e",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "„Missals“ wiegt 20 Kilogramm, ist 800 Jahre alt und 15 Millionen Britische Pfund (22 Millionen Euro) wert. Es ist das prächtigste katholische Messbuch, das den Bilder- und Büchersturm der Reformation überlebt hat."
                                            },
                                            {
                                                "example_id": "be6abf2d-e377-493c-adbf-82845e3e9c7c",
                                                "sense_id": "2404637e-2044-305c-985a-a36446b535a9",
                                                "text": "„Die Ursprünge einer anderen Zielsetzung des Deutschunterrichts liegen in der Reformation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "805ef7f5-1007-3fcf-8b28-16eeb65885cd",
                                        "entry_id": "438edb43-601c-3152-8464-a539afc4fc27",
                                        "glosses": [
                                            "Umgestaltung, Erneuerung, Veränderung"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf200603-606c-4eab-942f-17ef8727f48d",
                                                "sense_id": "805ef7f5-1007-3fcf-8b28-16eeb65885cd",
                                                "text": "„95 Forderungen ‚zur Reformation von Bildungsinstitutionen‘ haben die Protestierenden an der HU im November aufgestellt – sie forderten neben besseren Bedingungen im Bachelor auch weniger Einfluss der Wirtschaft auf die Unis, faire Arbeitsbedingungen für Angestellte im öffentlichen Dienst und die Abschaffung des dreigliedrigen Schulsystems.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
