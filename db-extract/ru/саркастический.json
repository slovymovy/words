                ],
                "senses": [
                    {
                        "sense_id": "528d66dd-1c33-326e-b5b6-13844b23b574",
                        "entry_id": "cd8c491c-7350-3616-a39a-e6f7e0502455",
                        "glosses": [
                            "исполненный сарказма, язвительно-насмешливый"
                        ],
                        "tags": [],
