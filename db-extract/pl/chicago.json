                                    {
                                        "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                                        "entry_id": "1a7cb224-b823-34ee-94fa-875455db107f",
                                        "glosses": [
                                            "Grande ville de l’Illinois (États-Unis d’Amérique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e38f6a7-106b-4f1b-aa32-cbe49763ac51",
                                                "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                                                "text": "L'étranger n'est pas resté insensible aux malheurs de nos populations : Chicago a adopté Reims ; Glasgow, Guivry et Martinpuich ; un journal de New-York, le Delincator, Landres-et-Saint-Georges des Ardennes ; M. et Mme Houston, de Philadelphie, Arcis-le-Ponsart ; une Société de Toronto (Canada), Vimy ; […]."
                                            },
                                            {
                                                "example_id": "6ef549bf-a9f6-44bc-816f-cd9905f5832f",
                                                "sense_id": "62df6223-e58b-32ae-9603-00827bddde04",
                                                "text": "Le manufacturier québécois pourrait fournir jusqu'à 600 autobus à la ville de Chicago et à ses banlieues au cours des prochaines années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5708cda7-c100-4d50-b65c-d5fdd1e8dbd3",
                        "source_entry_id": "30cd2b26-eb85-3911-9ed7-f4aea44fd95a",
                        "source_sense_id": "dae1c999-82f2-3838-aabc-ac036f2b95f8",
