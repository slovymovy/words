                "senses": [
                    {
                        "sense_id": "7836c07e-a2f9-36e9-9a46-5a2396369ba9",
                        "entry_id": "e7e4356a-f380-34b5-ab23-f21c68169e8b",
                        "glosses": [
                            "krótka anegdota lub powiedzenie, zręcznie dostosowane do okoliczności"
                        ],
                        "tags": [],
