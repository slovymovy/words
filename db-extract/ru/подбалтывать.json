                "senses": [
                    {
                        "sense_id": "b45f577e-b0d7-37ac-b20a-b88db1dcdbd6",
                        "entry_id": "5a4ab18b-4dd1-3fd1-a7d8-a26f0fc62bae",
                        "glosses": [
                            "добавлять, побалтывая, помешивая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f82a46a-7a1d-470d-8382-1dea8bb212d0",
                                "sense_id": "b45f577e-b0d7-37ac-b20a-b88db1dcdbd6",
                                "text": "Кашу делали совсем жидкой, жиже нормального супа, и в нее для густоты подбалтывали картофельную муку, крахмал, найденный нами вместе с «отработанной» манной крупой, которой чистили беленькие кроличьи шубки детей."
                            }
                        ]
                    },
                    {
                        "sense_id": "27fcac9d-0b55-3624-8c4d-ec7256f97a91",
                        "entry_id": "5a4ab18b-4dd1-3fd1-a7d8-a26f0fc62bae",
                        "glosses": [
                            "слегка болтать в разные стороны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2d2215-8af6-431c-b0c2-bc8922a0deea",
                                "sense_id": "27fcac9d-0b55-3624-8c4d-ec7256f97a91",
                                "text": "Самолёт стало подбалтывать, заволакивать облаками, и полковник вынужден был оставить недобритой намыленную щеку, отключить автопилот и обеими руками взяться за штурвал."
                            }
                        ]
                    }
