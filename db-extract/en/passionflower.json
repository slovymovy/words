                        "tags": [
                            "plural"
                        ],
                        "form": "passionflowers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7362b1c3-70b4-3318-8d86-71c05f252122",
                        "entry_id": "67065ca6-dfb2-31e4-895d-7237b51096cb",
                        "glosses": [
                            "Any of very many vines, in North America and elsewhere, of the genus Passiflora that bear edible fruit called passion fruit, and showy flowers of a structure symbolic of the Passion of Christ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a55cf13-7003-45a8-9d69-5f8cce39d356",
                                "sense_id": "7362b1c3-70b4-3318-8d86-71c05f252122",
                                "text": "The Priests observed frequent fasts, and abstained at all times from certain animals and fruits, especially from the Granadilla, the fruit of the Passion-flower, because, say the lying Jesuits, of the mysteries which are signified in that marvellous blossom: the people also were frequently required to fast."
                            }
                        ]
                    },
                    {
                        "sense_id": "40242a98-35b7-358f-9bc8-4ae448c686d8",
                        "entry_id": "67065ca6-dfb2-31e4-895d-7237b51096cb",
                        "glosses": [
                            "The flower of this plant."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c8b271f-d882-46c3-a068-59e66bfe8a61",
                        "source_entry_id": "67065ca6-dfb2-31e4-895d-7237b51096cb",
                        "source_sense_description": "plant of the genus Passiflora",
                        "target_lang_word": "Passionsblume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passionsblume",
