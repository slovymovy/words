                                        "glosses": [
                                            "The act of exchange of an asset of lesser liquidity with a more liquid one, such as cash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a985fb0e-6c38-39ed-b33d-dbb96e16123f",
                                        "entry_id": "6af56122-b52f-3b35-b52f-cb6fb8bca7ed",
                                        "glosses": [
                                            "The selling of the assets of a business as part of the process of dissolving the business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeb84700-2cfd-4223-9aed-f572e397a57c",
                                                "sense_id": "a985fb0e-6c38-39ed-b33d-dbb96e16123f",
                                                "text": "The store is having a liquidation sale: everything must go as they go out of business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5a57e1-5d22-320a-9daf-59089f4f02c8",
                                        "entry_id": "6af56122-b52f-3b35-b52f-cb6fb8bca7ed",
                                        "glosses": [
                                            "The murder of dehumanized victims."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15fd118b-c0ec-49ec-8c6e-7f0a62752b9b",
                                                "sense_id": "4f5a57e1-5d22-320a-9daf-59089f4f02c8",
                                                "text": "Near-synonyms: devitalization, fatality; see also Thesaurus:death, Thesaurus:killing"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
