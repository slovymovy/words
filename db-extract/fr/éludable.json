                        "glosses": [
                            "Que l’on peut éluder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd797fc-3b08-4873-b0bf-08313d2c7178",
                                "sense_id": "0a00dcd7-6f3b-3da6-b417-1cb8425c6088",
                                "text": "Certaines questions sont trop spécifiques ou trop pointues et ne sont pas éludables."
                            }
                        ]
                    },
                    {
                        "sense_id": "e09cc209-5f7f-3a95-a0d2-d8047895f9c2",
                        "entry_id": "9cf6c338-29c6-39e3-a408-21f42d9cc417",
                        "glosses": [
                            "Qualifie une dépense qui disparaît lorsque cesse l’activité à laquelle elle est liée."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "84d19bee-fb3b-4efe-bcef-8c163955b082",
                                "sense_id": "e09cc209-5f7f-3a95-a0d2-d8047895f9c2",
                                "text": "On distingue les charges éludables, qui disparaissent dès que l’agent quitte l’entreprise (par exemple, le salaire brut et les congés payés) et les charges inéludables, ou éludables à terme, qui ne disparaîtront qu’après un délai plus ou moins long (par exemple, le logement et la formation professionnelle)."
                            },
                            {
                                "example_id": "26768a38-a99f-40e7-acfe-42867c266883",
                                "sense_id": "e09cc209-5f7f-3a95-a0d2-d8047895f9c2",
                                "text": "Les dépenses immédiatement éludables concernent les dépenses d’exploitation comme les consommations intermédiaires ou les salaires ; les dépenses éludables à terme concernent les retraites qu’il faut provisionner."
                            }
                        ]
                    }
