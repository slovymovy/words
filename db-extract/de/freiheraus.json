                        "examples": [
                            {
                                "example_id": "8ab24657-1cad-48a5-9335-6a82f8794249",
                                "sense_id": "3b8f7762-44e8-34e6-81e3-475fa95e397e",
                                "text": "„In Hamburg zum Beispiel gibt es eine große Gruppe persischer Muslime, die ganz selbstverständlich zu Weihnachten in die Kirche gehen. Die Jüngeren sagen freiheraus, es komme ja nicht darauf an, wo man zum Herrn bete, sondern dass man an einem so wichtigen Tag irgendwie Verbindung »nach oben« habe […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44afa97e-06fd-4d44-ac74-9448592de75b",
                        "source_entry_id": "5a70c4d1-677b-34b7-b105-f90d581585da",
                        "source_sense_id": "3b8f7762-44e8-34e6-81e3-475fa95e397e",
                        "source_sense_description": "ohne Scheu, ohne Zögern",
                        "target_lang_word": "outright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
