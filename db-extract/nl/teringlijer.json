                        "examples": [
                            {
                                "example_id": "aea2ab8b-7f67-4ee1-b1b5-44c49e786b2a",
                                "sense_id": "4c6ccea1-b811-34f9-afd0-31707a78213b",
                                "text": "An 'n avond wachtte een troep van de ergste teringlijers hem af, om de hoek van de fabriek en ze ranselden d'r op en sloegen zijn linkerbeen kreupel."
                            },
                            {
                                "example_id": "4acf1261-21da-41b0-a4cf-d2f7d40a04f4",
                                "sense_id": "4c6ccea1-b811-34f9-afd0-31707a78213b",
                                "text": "Dit meisje, Roseyn B. heet ze, zou op Koninginnedag 2007 een agent in zijn gezicht geslagen en gestompt hebben, én hem hebben uitgemaakt voor vieze homo en teringlijer."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0d0b93d-9f52-336a-8682-bf2d6405e9cb",
                        "entry_id": "2bcbe8cd-9e08-3fee-b3cd-b723a900a55a",
                        "glosses": [
                            "wandelend geraamte, soort vlokreeftje Caprella linearis dat aan de zeekust leeft"
                        ],
                        "tags": [
                            "kreeftachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "937b5ef7-d283-44ff-915e-45498e8b9e11",
                                "sense_id": "c0d0b93d-9f52-336a-8682-bf2d6405e9cb",
                                "text": "Tijdens een duikje bij de Zeelandbrug zag ik duizenden van deze hele kleine vlokreeftjes ook wel \"spookkreeftjes\" en \"teringlijers\" genoemd."
                            }
                        ]
