                "senses": [
                    {
                        "sense_id": "a84cf15d-9fa8-3ab5-b8de-01f6bab2b16d",
                        "entry_id": "c7021e19-0a87-317f-bfb8-4568e5219f29",
                        "glosses": [
                            "zufriedenes Gefühl, das durch die Freude an jemanden oder etwas ausgelöst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e1f473-d394-4bf7-a292-6256da373695",
                                "sense_id": "a84cf15d-9fa8-3ab5-b8de-01f6bab2b16d",
                                "text": "Er verfolgte das Spiel seiner Mannschaft mit Wohlgefallen."
                            },
                            {
                                "example_id": "f5244890-11de-40a1-8ea2-154420b5497d",
                                "sense_id": "a84cf15d-9fa8-3ab5-b8de-01f6bab2b16d",
                                "text": "„Ehre sei Gott in der Höhe und Friede auf Erden bei den Menschen seines Wohlgefallens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0810eb5-05d2-4179-828d-ddabe1692f02",
                        "source_entry_id": "c7021e19-0a87-317f-bfb8-4568e5219f29",
                        "source_sense_id": "a84cf15d-9fa8-3ab5-b8de-01f6bab2b16d",
                        "source_sense_description": "zufriedenes Gefühl, das durch die Freude an jemanden oder etwas ausgelöst wird",
                        "target_lang_word": "plaisir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaisir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Sentiment, sensation agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3153929f-9300-4e60-9c37-4d9586f5a500",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "« L’homme est né pour le plaisir : il le sent, il n’en faut point d’autre preuve. Il suit donc sa raison en se donnant au plaisir. »"
                                            },
                                            {
                                                "example_id": "05adaadc-1544-4154-92e7-364787e93a2b",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Bon vin, bons mots, gaillardes chansonnettes ;\nSont aiguillons aux amoureux désirs,\nEn toute porte entr’ouverte aux plaisirs\nL’adroit Amour aisément s’insinue."
                                            },
                                            {
                                                "example_id": "7348e426-0c05-4d1c-a606-b28ab6445d8f",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Dans Thomas l’imposteur, il avait combiné à une apparence de psychologie « rudimentaire » des aperçus ou constats très fins et pénétrants, dépatinant les sentiments les plus convenus (amour, plaisir, ambition), les sortant du lieu commun."
                                            },
                                            {
                                                "example_id": "42b130fc-8f02-4e6e-b9f2-8bbacfd15df3",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "J’eus le plaisir d’y admirer miss Gertrude Ederle, Ailen Riggin et Helen Wainwright, qui vinrent faire une démonstration de plongeons et de nages modernes."
                                            },
                                            {
                                                "example_id": "c67a1c83-c5c2-420b-936f-ddd792e2dbda",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Le Traité du plaisir de Maurice Bedel a été publié en 1945."
                                            },
                                            {
                                                "example_id": "7c50d512-960c-4f55-9e04-800e582afb6f",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Depuis Michelet, on a aussi, bien souvent, incriminé l’influence exercée par le prêtre sur le comportement des épouses ; […]. En multipliant les interdits, il gênait l’épanouissement du plaisir des couples, quelle qu’ait pu être la valeur érotique de la transgression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Divertissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786eb312-6edb-4b00-ac50-0ede52d99ad8",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Que faire donc ? je ne fume jamais ; la fidélité matrimoniale est bien ennuyeuse ; dans une intrigue où le cœur n'est que chatouillé on ne vise qu'au dénoûment : la promenade est mon unique plaisir ; triste plaisir à vingt ans !"
                                            },
                                            {
                                                "example_id": "bd9756f0-82f7-44d6-a5f4-4b6628d9ba42",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Cette femme […] avait un goût décidé pour la dissipation et l’amusement : très bornée dans ses dépenses, elle ne pouvait se procurer les plaisirs dont elle était avide, ni consentir à s’en priver."
                                            },
                                            {
                                                "example_id": "0515c92d-3ce6-4d05-b460-b57e0f54c9d0",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "[…], des marchands d’un champagne dont la médiocrité n’était dépassée que par son prix qui ne cessait de monter, ne se préoccupaient plus, à Montmartre comme à Montparnasse, que d’adapter les soi-disants plaisirs de Paris à des images étrangères et le plus souvent chromolithographiques."
                                            },
                                            {
                                                "example_id": "72a847f3-36d2-44ec-a533-f0126a3811b0",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Empêcher la vie des gens et leur plaisir devrait-il être permis ? De quoi se mêle un ministre ? De quel droit, avec quelle permission ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f025f234-bbad-3482-a230-6e636eca50db",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Volonté ; consentement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Grâce ; faveur ; service ; bon office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bd0475-ab8f-4e58-afb1-64dec52866ce",
                                                "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                                "text": "C’est un homme qui ne cherche, qui ne demande qu’à faire plaisir. Faites-moi un plaisir."
                                            },
                                            {
                                                "example_id": "cd1c1def-ea9b-423f-9b41-adddf8b6b62f",
                                                "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                                "text": "Vous allez me faire le plaisir de vous torcher la figure et le sourire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7242e2-b484-3d6c-9eaa-8c03b8b870eb",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Espèce d’oublie légère, roulée en cornet."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e8c20e-006c-4603-a53e-3f23563e001e",
                                                "sense_id": "ff7242e2-b484-3d6c-9eaa-8c03b8b870eb",
                                                "text": "C’étaient les vendeurs de plaisirs portant, sur le dos, leur grand cylindre rouge surmonté d’une tourniquet de loterie qui appelaient les promeneurs avec une crécelle et les invitaient à gagner leurs oublies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dee1fda-4fa8-4ad3-b346-e39a7e9ff884",
                        "source_entry_id": "c7021e19-0a87-317f-bfb8-4568e5219f29",
                        "source_sense_id": "a84cf15d-9fa8-3ab5-b8de-01f6bab2b16d",
                        "source_sense_description": "zufriedenes Gefühl, das durch die Freude an jemanden oder etwas ausgelöst wird",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Contentement, plaisir que nous éprouvons quand les choses sont telles que nous pouvons les souhaiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5e510d-8c84-4990-8521-9811874399f6",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "À plusieurs reprises, il s’était frotté joyeusement les mains, ce qui, chez lui, ne pouvait passer pour une satisfaction banale."
                                            },
                                            {
                                                "example_id": "921ff455-b957-4587-be79-0b4aed2d239f",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Et il savait que la satisfaction de ses désirs d’un moment ne méritait point qu’il s’engageât toute sa vie."
                                            },
                                            {
                                                "example_id": "8e3940a8-8e0d-409d-a389-7d1ef1914bec",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Vois-tu, dans le monde entier, question rigolade et satisfaction, il n’y a que Paris qui compte, et dans Paris, Montmartre."
                                            },
                                            {
                                                "example_id": "5f115236-b8c5-4369-b259-a112730405c9",
                                                "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                                                "text": "Ce prologue le fatiguait, mais il ne pouvait l’écourter. L’éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s’entendre les phraser et de jouir de ces cadences étudiées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Réponse à un besoin de sorte qu’il ne soit plus nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9686134b-48f0-44eb-afb9-460c22772cb2",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Satisfaction des besoins naturels."
                                            },
                                            {
                                                "example_id": "53860a98-f80a-4bbf-bbd1-5dbd405b5f41",
                                                "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                                                "text": "Attendu que la société Cometik fait grief à l’arrêt d’anéantir les effets du contrat, de la condamner à rembourser à Mme X... les sommes par elle versées en exécution de celui-ci et de rejeter ses demandes, alors, selon le moyen, que l’objet d’un contrat entre dans le champ de l’activité principale du professionnel lorsqu’il participe à la satisfaction des besoins de l’activité professionnelle ; que la cour d’appel a elle-même retenu que le contrat conclu le 17 juillet 2014 par Mme X... portait « notamment sur la création d’un site Internet dédié à son activité » ; qu’en retenant pourtant que ce contrat n’entre pas dans le champ de l’activité principale du professionnel, la cour d’appel n’a pas tiré les conséquences légales de ses propres constatations et a violé l’article L. 121-16-1, III, du code de la consommation, dans sa rédaction applicable en la cause ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Action de satisfaire quelqu’un en réparation de l’offense qu’on lui a faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e652c61e-54cf-4212-8ba2-d8dbf784fca2",
                                                "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                                                "text": "Il faut que la satisfaction soit proportionnée à l’offense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                        "entry_id": "816be1ec-958b-36ed-8c9a-fa362d8d98d3",
                                        "glosses": [
                                            "Ce qu’on est obligé de faire à l’égard de Dieu, en réparation des péchés qu’on a commis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03046292-1163-4eb8-b06d-1369e6251ebf",
                                                "sense_id": "3d42219c-fdd4-3e15-97b8-ec17a6a9ab38",
                                                "text": "La satisfaction fait partie du sacrement de Pénitence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
