                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "о деньгах, документах или товарах"
                            },
                            {
                                "target_lang_word": "контрафактный",
                                "target_lang_sense_clarification": "о нелегально воспроизведённой продукции"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vals",
                                "target_lang_sense_clarification": "over geld, papieren of documenten"
                            },
                            {
                                "target_lang_word": "vervalst",
                                "target_lang_sense_clarification": "nagemaakt om echt te lijken"
