                    {
                        "sense_id": "93fdb210-ec73-3964-8467-9d261dbcf0d4",
                        "entry_id": "e2beb421-3f84-365c-95b3-b49d5191d7f1",
                        "glosses": [
                            "een vrouw die de taak heeft religieuze rituelen te verzorgen"
                        ],
                        "tags": [
                            "beroep"
                        ],
