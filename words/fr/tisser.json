                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan utilise un vieux métier en bois pour <w>tisser</w> une étoffe magnifique."
                        },
                        {
                            "text": "Elle passe des journées entières à <w>tisser</w> de la laine afin de fabriquer des couvertures chaudes."
                        }
                    ],
                    "synonyms": [
