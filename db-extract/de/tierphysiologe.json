                "senses": [
                    {
                        "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                        "entry_id": "9eb48766-7069-35bb-9b7e-f770c76f3125",
                        "glosses": [
                            "Wissenschaftler, der sich mit Fragen aus dem Gebiet der Tierphysiologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff0351b-7c54-41d8-b6eb-959234936b9e",
                                "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                                "text": "„Max Becker (* 8. Mai 1906 in Aschersleben; † 2. Juni 2000 in Stanggaß, Oberbayern) war ein deutscher Tierphysiologe und Hochschullehrer.“"
                            },
                            {
                                "example_id": "343e362f-25f4-4909-b207-666a7cb5f161",
                                "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                                "text": "„Er forscht seit 26 Jahren erfolgreich über den Stoffwechsel und Energiehaushalt von Tieren: Dafür erhält der Marburger Tierphysiologe Prof. Gerhard Heldmaier nun den Wissenschaftspreis der Deutschen Zoologischen Gesellschaft (DZG).“"
                            },
                            {
                                "example_id": "c52cb68c-b1a1-43d4-aaf5-684478810f9d",
                                "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                                "text": "„Der Marburger Tierphysiologe Professor Dr. Gerhard Heldmaier, Vizepräsident der Philipps-Universität, hält die Laurence Irving - Per Scholander Memorial Lecture 2009 an der University of Alaska.“"
                            },
                            {
                                "example_id": "27984dce-664d-492f-8431-ef19f6f40028",
                                "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                                "text": "„Viele Fische leben in Gefangenschaft stressfreier als in der Natur, sagt Tierphysiologe Stefan Karl Hetz.“"
                            },
                            {
                                "example_id": "166ca670-146d-46bd-b423-4c2240119450",
                                "sense_id": "b000a6c0-1143-35f3-9ab3-05f80e138b29",
                                "text": "„Frank Grün trainiert die Alpakas in der Kamp-Lintforter Tier- und Spieloase. Der 64-Jährige Pferdetherapeut und Tierphysiologe weiß die kleine Herde zu nehmen. Geduld und Vertrauen spielen eine große Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
