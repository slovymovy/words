                "senses": [
                    {
                        "sense_id": "fd780805-dc05-3185-aa03-d46e73c9f946",
                        "entry_id": "96f0faf3-dc6e-3968-be39-6595642e608b",
                        "glosses": [
                            "физ. физический процесс перехода вещества из газообразного состояния в твёрдое, минуя жидкое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9c9aec-3370-4e1c-ac91-d09776f81561",
                                "sense_id": "fd780805-dc05-3185-aa03-d46e73c9f946",
                                "text": "Десублимация обычно осуществляется на охлаждённые твёрдые поверхности или происходит в объёме газовой фазы с выделением твёрдого вещества в виде частиц аэрозоля."
                            },
                            {
                                "example_id": "d026ce2b-880e-4ec7-aa76-c072a399aa43",
                                "sense_id": "fd780805-dc05-3185-aa03-d46e73c9f946",
                                "text": "Десублимация в гетерогенной системе начинается с образования единичных элементов новой фазы — твёрдых зародышей (кластеров), которые после достижения критического размера имеют тенденцию к неограниченному росту."
                            }
                        ]
                    }
