{
    "word_family": [
        "checker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6b06fa5-352b-3c07-b77e-4de959ae10df",
                    "sense_definition": "Salutation amicale consistant à cogner légèrement son poing contre celui d'une autre personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour se dire bonjour, les deux amis se sont fait un <w>check</w> complice.",
                            "target_lang_translations": {
                                "en": "To say hello, the two friends exchanged a knowing <w>fist bump</w>.",
                                "ru": "Чтобы поздороваться, два друга сделали понимающий <w>удар кулаками</w>.",
                                "de": "Zur Begrüßung tauschten die beiden Freunde einen vertrauten <w>Faustgruß</w> aus.",
                                "es": "Para saludarse, los dos amigos se dieron un <w>choque de puños</w> lleno de complicidad.",
                                "zh": "两个朋友打招呼时，来了一个默契十足的<w>碰拳</w>。"
                            }
                        },
                        {
                            "text": "Il refuse de serrer la main et préfère donner un <w>check</w> rapide.",
                            "target_lang_translations": {
                                "en": "He refuses to shake hands and prefers to give a quick <w>fist bump</w>.",
                                "ru": "Он не жмёт руку и предпочитает быстрый <w>удар кулаками</w>.",
                                "de": "Er verzichtet aufs Händeschütteln und gibt lieber einen schnellen <w>Faustgruß</w>.",
                                "es": "Se niega a estrechar la mano y prefiere dar un <w>choque de puños</w> rápido.",
                                "zh": "他不愿握手，宁可快速地来个<w>碰拳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poing-à-poing"
                    ],
                    "common_phrases": [
                        "faire un check"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A casual greeting in which two people lightly knock their fists together.",
                        "ru": "Дружеское приветствие, при котором два человека легонько ударяют кулаком о кулак.",
                        "de": "Freundschaftliche Begrüßung, bei der sich zwei Personen leicht Faust gegen Faust stoßen.",
                        "es": "Saludo amistoso que consiste en chocar ligeramente el puño contra el de otra persona.",
                        "zh": "朋友之间用拳头轻轻相碰的一种友好问候方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fist bump",
                                "target_lang_sense_clarification": "casual greeting between friends"
                            },
                            {
                                "target_lang_word": "knuckle bump",
                                "target_lang_sense_clarification": "knocking knuckles together in greeting"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "удар кулаком",
                                "target_lang_sense_clarification": "дружеское приветствие кулаками"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Faustgruß",
                                "target_lang_sense_clarification": "freundschaftliche Begrüßung unter Freunden"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "choque de puños",
                                "target_lang_sense_clarification": "saludo entre amigos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰拳",
                                "target_lang_sense_clarification": "朋友间的随意问候"
                            },
                            {
                                "target_lang_word": "击拳",
                                "target_lang_sense_clarification": "轻拳相碰的问候动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a6bbe29-6af3-3481-ab86-bdf4d68ac3c2",
                    "sense_definition": "Examen attentif ou action de vérifier la conformité ou l'état de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'envoyer le document au client, j'aimerais faire un dernier <w>check</w>.",
                            "target_lang_translations": {
                                "en": "Before sending the document to the client, I'd like to do one last <w>check</w>.",
                                "ru": "Перед отправкой документа клиенту я хотел бы сделать последнюю <w>проверку</w>.",
                                "de": "Bevor ich das Dokument an den Kunden schicke, würde ich gern noch eine letzte <w>Kontrolle</w> machen.",
                                "es": "Antes de enviar el documento al cliente, me gustaría hacer una última <w>revisión</w>.",
                                "zh": "在把文件发给客户之前，我想再做最后一次<w>检查</w>。"
                            }
                        },
                        {
                            "text": "L'équipe technique a effectué un <w>check</w> complet des serveurs ce matin.",
                            "target_lang_translations": {
                                "en": "The technical team carried out a full <w>check</w> of the servers this morning.",
                                "ru": "Сегодня утром техническая команда провела полную <w>проверку</w> серверов.",
                                "de": "Das technische Team hat heute Morgen eine vollständige <w>Kontrolle</w> der Server durchgeführt.",
                                "es": "Esta mañana, el equipo técnico realizó una <w>revisión</w> completa de los servidores.",
                                "zh": "今天早上，技术团队对服务器做了一次全面<w>检查</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contrôle",
                        "vérification"
                    ],
                    "common_phrases": [
                        "faire un check"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A close examination, or the act of verifying that something conforms or is in good condition.",
                        "ru": "Тщательное изучение или действие, направленное на проверку соответствия либо исправности чего-либо.",
                        "de": "Genaue Prüfung oder Kontrolle, ob etwas richtig ist oder einwandfrei funktioniert.",
                        "es": "Examen atento o acción de comprobar que algo cumple las condiciones o está en buen estado.",
                        "zh": "对某物的状况、准确性或是否合格所进行的仔细查看或核实。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "routine verification of condition"
                            },
                            {
                                "target_lang_word": "inspection",
                                "target_lang_sense_clarification": "formal examination of condition"
                            },
                            {
                                "target_lang_word": "verification",
                                "target_lang_sense_clarification": "confirming accuracy or conformity"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проверка",
                                "target_lang_sense_clarification": "проверка состояния, исправности"
                            },
                            {
                                "target_lang_word": "осмотр",
                                "target_lang_sense_clarification": "тщательный осмотр, обследование"
                            },
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "контроль соответствия, качества"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kontrolle",
                                "target_lang_sense_clarification": "routinemäßige Prüfung des Zustands"
                            },
                            {
                                "target_lang_word": "Überprüfung",
                                "target_lang_sense_clarification": "Nachprüfung der Richtigkeit"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "comprobación rutinaria del estado"
                            },
                            {
                                "target_lang_word": "revisión",
                                "target_lang_sense_clarification": "examen detallado del funcionamiento"
                            },
                            {
                                "target_lang_word": "verificación",
                                "target_lang_sense_clarification": "confirmar exactitud o conformidad"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "查看状况或质量"
                            },
                            {
                                "target_lang_word": "核查",
                                "target_lang_sense_clarification": "核对准确性或合规性"
                            },
                            {
                                "target_lang_word": "检验",
                                "target_lang_sense_clarification": "专业测试或验收"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5a6e22da-9e64-356b-a4f2-7437a104762d",
                    "sense_definition": "S'emploie pour indiquer qu'une action est accomplie, vérifiée ou conforme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "validation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le rapport est envoyé et les réservations sont faites, <w>check</w> !",
                            "target_lang_translations": {
                                "en": "The report is sent and the bookings are made, <w>check</w>!",
                                "ru": "Отчёт отправлен, бронирования сделаны: <w>готово</w>!",
                                "de": "Der Bericht ist verschickt und die Reservierungen sind gemacht, <w>erledigt</w>!",
                                "es": "El informe está enviado y las reservas están hechas, ¡<w>listo</w>!",
                                "zh": "报告已经发出，预订也办好了，<w>搞定</w>！"
                            }
                        },
                        {
                            "text": "Les valises sont prêtes, les passeports sont rangés : <w>check</w> !",
                            "target_lang_translations": {
                                "en": "The suitcases are ready, the passports are put away: <w>check</w>!",
                                "ru": "Чемоданы собраны, паспорта убраны: <w>готово</w>!",
                                "de": "Die Koffer sind gepackt, die Pässe verstaut: <w>erledigt</w>!",
                                "es": "Las maletas están listas, los pasaportes están guardados: ¡<w>listo</w>!",
                                "zh": "行李箱已经准备妥当，护照也都放好了：<w>搞定</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "validé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to confirm that an action has been completed, verified, or is in order.",
                        "ru": "Употребляется для отметки о том, что действие выполнено, проверено или всё в порядке.",
                        "de": "Ausruf, mit dem bestätigt wird, dass eine Handlung erledigt, geprüft oder in Ordnung ist.",
                        "es": "Se usa para confirmar que una acción está completada, verificada o en orden.",
                        "zh": "用于表示某项操作已经完成、核实或一切妥当。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "confirming an item is done"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "готово",
                                "target_lang_sense_clarification": "отметка о выполненном пункте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erledigt",
                                "target_lang_sense_clarification": "Aufgabe abgeschlossen, fertig"
                            },
                            {
                                "target_lang_word": "abgehakt",
                                "target_lang_sense_clarification": "Punkt auf der Liste markiert"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "listo",
                                "target_lang_sense_clarification": "marca al completar una tarea"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞定",
                                "target_lang_sense_clarification": "事情办妥时的口语说法"
                            },
                            {
                                "target_lang_word": "好了",
                                "target_lang_sense_clarification": "确认事项已完成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b66cb7f5-1f02-34c2-97cd-51e297c70b68",
                    "sense_definition": "S'emploie pour inviter son interlocuteur à se saluer poing contre poing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Allez, viens là et <w>check</w>, mon pote !",
                            "target_lang_translations": {
                                "en": "Come here and <w>fist bump</w>, buddy!",
                                "ru": "Давай, подойди сюда и <w>дай кулак</w>, дружище!",
                                "de": "Komm her und <w>gib</w> mir die Faust, Kumpel!",
                                "es": "¡Venga, ven aquí y <w>choca</w> los puños, colega!",
                                "zh": "来，过来和我<w>碰拳</w>，哥们！"
                            }
                        },
                        {
                            "text": "Salut tout le monde, <w>check</w> !",
                            "target_lang_translations": {
                                "en": "Hi everyone, <w>fist bump</w>!",
                                "ru": "Всем привет, <w>дай кулак</w>!",
                                "de": "Hallo zusammen, <w>Faust</w> drauf!",
                                "es": "¡Hola a todos, <w>choquen</w> los puños!",
                                "zh": "大家好，来<w>碰拳</w>！"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to invite someone to greet with a fist bump.",
                        "ru": "Употребляется, чтобы предложить собеседнику поздороваться, ударив кулаком о кулак.",
                        "de": "Aufforderung an den Gesprächspartner, sich mit einem Faustgruß zu begrüßen.",
                        "es": "Se usa para invitar al interlocutor a saludarse chocando los puños.",
                        "zh": "用于邀请对方以拳头相碰的方式互相问候。"
                    },
                    "translations": {
