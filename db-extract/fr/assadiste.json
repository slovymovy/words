                    {
                        "sense_id": "1223bf3f-938f-338d-863b-c022ea6a4d7f",
                        "entry_id": "00559bf3-54a3-3ea6-aaeb-53027efcc49d",
                        "glosses": [
                            "Partisan ou soutien du régime de Hafez-el-Assad et Bachar el-Assad ou de l’assadisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f57970-0a1c-43df-8072-324ab40c7dcc",
                                "sense_id": "1223bf3f-938f-338d-863b-c022ea6a4d7f",
                                "text": "L’AfD entretient des liens particuliers avec Assad, par l’intermédiaire d’un certain Kevork Almassian, un Syrien qui, curieusement, a demandé l’asile en Allemagne bien qu’il soit un assadiste fou, et a obtenu un emploi dans le bureau de l’AfD."
                            },
                            {
                                "example_id": "a66119af-4013-42a6-a846-d3874487ba73",
                                "sense_id": "1223bf3f-938f-338d-863b-c022ea6a4d7f",
                                "text": "Je comprends pas la, nos assadistes nous disaient pendant des années que les syriens étaient amoureux de leur leader suprême.. Ils ont mentis en fait, c’est ça ? Un assadiste pour me répondre peut-être ?"
                            }
                        ]
                    }
