{
    "word_family": [
        "dimple"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1fb45ff9-20b5-3a54-bb49-7333019d9eff",
                    "sense_definition": "Having small natural indentations on the skin, especially on the cheeks or chin.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>dimpled</w> smile that makes everyone feel welcome.",
                            "target_lang_translations": {
                                "zh": "她有着一个<w>有酒窝的</w>微笑，让每个人都感到宾至如归。"
                            }
                        },
                        {
                            "text": "The baby had <w>dimpled</w> cheeks that looked very cute.",
                            "target_lang_translations": {
                                "zh": "那个婴儿有着<w>有酒窝的</w>脸颊，看起来非常可爱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dimpled cheeks",
                        "dimpled smile"
                    ],
                    "target_lang_definitions": {
                        "zh": "指皮肤上有天然的小凹陷，尤指脸颊或下巴上的酒窝。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有酒窝的",
                                "target_lang_sense_clarification": "形容人面部有酒窝的特征"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c264dc7-2d4c-3afa-8d4b-7edbea51f7c5",
                    "sense_definition": "Simple past and past participle of <w>dimple</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain <w>dimpled</w> the surface of the calm pond.",
                            "target_lang_translations": {
                                "zh": "大雨在平静的池塘表面<w>打出</w>了点点凹痕。"
                            }
                        },
                        {
                            "text": "Her cheeks <w>dimpled</w> whenever she laughed at a joke.",
                            "target_lang_translations": {
                                "zh": "每当她听到笑话大笑时，她的脸颊上就会<w>显出酒窝</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle of the verb dimple."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 dimple 的过去式和过去分词，意为使出现小凹陷或显出酒窝。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使出现凹陷",
                                "target_lang_sense_clarification": "指物体表面因受力而产生小坑"
                            },
                            {
                                "target_lang_word": "显出酒窝",
                                "target_lang_sense_clarification": "指人笑时脸颊出现酒窝"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}