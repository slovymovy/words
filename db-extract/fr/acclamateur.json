                        "glosses": [
                            "Celui qui concourt à des acclamations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68fe9570-f0a2-4b0d-849c-b0e028698fe0",
                                "sense_id": "d900ad8b-cd97-3e6c-8822-c21cff08afaf",
                                "text": "J'entendis rarement un acclamateur plus déchaîné."
                            },
                            {
                                "example_id": "11b71e27-35ed-4694-bf5c-c3ef1084c030",
                                "sense_id": "d900ad8b-cd97-3e6c-8822-c21cff08afaf",
                                "text": "Né sur le déclin d'une société et à l'aurore d'une autre, […]. Il a été l’embaumeur du catholicisme et l’acclamateur de la liberté."
                            },
                            {
                                "example_id": "79346b1f-46e4-4c61-b024-39e6a2bceac7",
                                "sense_id": "d900ad8b-cd97-3e6c-8822-c21cff08afaf",
                                "text": "— Voulez-vous, les acclamatrices, me raconter comment se passe la noce (de mariage) chez nous, à Fès ?"
                            }
                        ]
                    }
