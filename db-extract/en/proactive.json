                        "entry_id": "f27063d4-fefa-33cd-97de-604854a96631",
                        "glosses": [
                            "Acting in advance to deal with an expected change or difficulty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a67910-6b94-4a98-a21f-b9159cea24f0",
                                "sense_id": "a7475091-d6b8-3368-83d2-270394f06282",
                                "text": "We can deal with each problem as it pops up, or we can take a proactive stance and try to prevent future problems."
                            },
                            {
                                "example_id": "eadbb488-186d-4eca-b750-50fb00b9b061",
                                "sense_id": "a7475091-d6b8-3368-83d2-270394f06282",
                                "text": "Staff are also proactive in approaching any passengers looking as though they need assistance, rather than waiting to be approached."
                            }
                        ]
