                    },
                    {
                        "translation_id": "3b35752c-14c9-45aa-b8b7-33a987b3867e",
                        "source_entry_id": "74644816-df66-35c5-b375-c32e930addea",
                        "target_lang_word": "Liktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                                        "entry_id": "de8cdea7-c57d-3e23-a796-fe03d8f96ea3",
                                        "glosses": [
                                            "im römischen Reich Diener, Begleiter, Leibwächter hochgestellter Amtsträger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0d9767-8e03-4840-9758-e8008fa453bb",
                                                "sense_id": "3ec8e451-b5d3-3f1d-9b1d-c0582d24af5b",
                                                "text": "„Die Polizei des Altertums ist durch die Wachsfiguren eines Caesaren und zweier Liktoren und durch einige Fascesbündel dargestellt, was herzlich albern ist, wenn es nicht eine Huldigung für die modernen Faschisten bedeuten soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cea3c0aa-7d40-422b-aa7e-9be30fa0a11d",
                        "source_entry_id": "74644816-df66-35c5-b375-c32e930addea",
                        "target_lang_word": "lictor",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lictor",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "334d5784-572d-3de9-ab17-e7f79175e9ea",
                                        "entry_id": "d33425a8-cbc1-3b3e-8b3f-0f2b3e106171",
                                        "glosses": [
                                            "officiële lijfwacht die belangrijke Romeinse bestuurders in het openbaar vergezelde bij het uitoefenen van hun functie\\nHoeveel lictoren een bestuurder vergezelden hing af van hoe belangrijk zijn functie was. Arrestaties en straffen waar de bestuurder bevel toe gaf, werden door de lictoren uitgevoerd. Als teken van hun waardigheid droegen ze een bundel stokken of pijlen, de fasces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73cad86-c773-4e0b-8f42-10dc7b13d86e",
                                                "sense_id": "334d5784-572d-3de9-ab17-e7f79175e9ea",
                                                "text": "Zoals het hoort in een fascistisch land, werd het nieuwe landbouwgebied strikt hiërarchisch ingericht. (…) De top was de hoofdstad Littoria, genoemd naar de lictor, de gerechtsdienaar die in het oude Rome de magistraten vergezelde en de pijlenbundel (fasces) met bijl (securis), het symbool van gezag, droeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b357a76c-9a96-4607-ac77-3043e4dbcbc6",
                        "source_entry_id": "74644816-df66-35c5-b375-c32e930addea",
                        "target_lang_word": "liktor",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
