                "senses": [
                    {
                        "sense_id": "50e8cced-afc7-3dc0-a689-c22fc86d27a7",
                        "entry_id": "1751b67b-c26d-3466-a859-151b52add886",
                        "glosses": [
                            "to look (at)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b60fa6-665a-4f6a-a6e3-7398442796d9",
                                "sense_id": "50e8cced-afc7-3dc0-a689-c22fc86d27a7",
                                "text": "посма́тривать вре́мя от вре́мени",
                                "translation": "to look from time to time [now and then] (at)",
                                "english": "to look from time to time [now and then] (at)"
                            },
                            {
                                "example_id": "47c786c2-7735-48e4-98a4-7e645fb23a3c",
                                "sense_id": "50e8cced-afc7-3dc0-a689-c22fc86d27a7",
                                "text": "посма́тривать по сторона́м",
                                "translation": "to glance round from time to time",
                                "english": "to glance round from time to time"
                            },
                            {
                                "example_id": "61d9dafd-3c67-4807-8e06-f9825a70acc5",
                                "sense_id": "50e8cced-afc7-3dc0-a689-c22fc86d27a7",
                                "text": "Во́зле меня́ за забо́ром стоя́л како́й-то челове́к с ко́ротко остри́женными чёрными волоса́ми и ирони́чески посма́тривал на меня́.",
                                "translation": "Near me, the other side of the fence, stood a man with close-cropped black hair, looking ironically at me.",
                                "english": "Near me, the other side of the fence, stood a man with close-cropped black hair, looking ironically at me."
                            }
                        ]
                    }
                ],
