                ],
                "senses": [
                    {
                        "sense_id": "de2b528d-feb5-3876-8fe7-c927b3217f20",
                        "entry_id": "d4fab298-12c8-32a9-aa85-2ae14b267a4a",
                        "glosses": [
                            "Tourner comme un derviche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcb2d5ac-49f4-4d7c-9b68-dc1846b0cdbf",
                                "sense_id": "de2b528d-feb5-3876-8fe7-c927b3217f20",
                                "text": "Mais qui est-elle au juste, cette empêcheuse de \"dervicher en rond\" ?"
                            },
                            {
                                "example_id": "4971de41-ace8-4fe4-bf26-df005c5129f5",
                                "sense_id": "de2b528d-feb5-3876-8fe7-c927b3217f20",
                                "text": "Je peux dervicher!"
                            },
                            {
                                "example_id": "b5401d41-695e-4373-909b-caf90ebb92e3",
                                "sense_id": "de2b528d-feb5-3876-8fe7-c927b3217f20",
                                "text": "On pourrait même imaginer la vanité sarkozyenne que serait un crâne tapissé de Rolex dont les trotteuses dervicheraient sans fin."
                            }
                        ]
                    },
                    {
                        "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                        "entry_id": "d4fab298-12c8-32a9-aa85-2ae14b267a4a",
                        "glosses": [
                            "Changer d'avis sans cesse, être indécis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb075a42-573b-4eb8-ab4c-597f2d41e7ac",
                                "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                                "text": "Ma femme derviche, depuis ce matin c'est la huitième fois qu'elle change de chaussures."
                            },
                            {
                                "example_id": "a1962737-401e-4f07-b9f4-665b595e5305",
                                "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                                "text": "Question femmes, s'il ne dervichait pas tant, il serait marié depuis longtemps."
                            },
                            {
                                "example_id": "2aedbe2f-5e46-4e14-8a21-ed16dd839673",
                                "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                                "text": "Je derviche toujours quand j'entre dans une pâtisserie, il y a trop de choix."
                            },
                            {
                                "example_id": "4dd6728f-a7f0-4aae-8155-1ae5649f3892",
                                "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                                "text": "C'est la sixième fois qu'il met en vente sa voiture, il derviche comme une girouette."
                            },
                            {
                                "example_id": "3fd66bc1-3c13-4571-a577-44900fcd9aae",
                                "sense_id": "c43f44d2-ceae-3d8b-beca-7171ca97de03",
                                "text": "Il faut parfois arrêter de dervicher et laisser sa route s'ouvrir toute seule"
                            }
                        ]
                    }
                ],
