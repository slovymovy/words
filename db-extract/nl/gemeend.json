        "nl-extract.jsonl": [
            {
                "entry_id": "02067dd9-8b4b-3d19-a078-1ca03f3bbffc",
                "word": "gemeend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b6d2e77-3d4a-3fc2-8885-b27dc8352179",
                        "entry_id": "02067dd9-8b4b-3d19-a078-1ca03f3bbffc",
                        "glosses": [
                            "wat men echt denkt zonder te liegen of te overdrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1b0946-e4b2-4ac9-b97c-4362142ace63",
                                "sense_id": "2b6d2e77-3d4a-3fc2-8885-b27dc8352179",
                                "text": "Het is nu aan de diaconie om dit te doorbreken. Zodat mensen er weer voor elkaar zijn. „We willen bijvoorbeeld een project bedenken voor jong en oud waar mensen zichzelf kunnen zijn en de aandacht krijgen die ze verdienen. Oprecht gemeende aandacht,” aldus Doornbusch."
                            },
                            {
                                "example_id": "802b95d2-fb18-4ef5-a622-a35f6c5f0c72",
                                "sense_id": "2b6d2e77-3d4a-3fc2-8885-b27dc8352179",
                                "text": "John Cleese deed op 30 mei dit jaar Hasselt aan met zijn show The Last Time To See Me Before I Die. Gisteren sloot hij zijn Europese tournee van in totaal 35 voorstellingen af, waarna hij besloot een korte, al dan niet gemeende recensie van zijn publiek te twitteren."
                            },
                            {
                                "example_id": "17b755a8-0d19-478d-b84f-203c5039ea10",
                                "sense_id": "2b6d2e77-3d4a-3fc2-8885-b27dc8352179",
                                "text": "De bescheiden Vajda zorgde met haar act vol salto's, meervoudige draaien met het touwtje en allerhande acrobatische fratsen voor verbaasde blikken bij de vier juryleden. Door het publiek werd ze getrakteerd op een ovationeel applaus terwijl Simon Cowell, Heidi Klum, Howie Mandel en Mel B haar beloonden met vier gemeende ja's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2dcf855-406f-4ffb-ad21-4440ea3772c7",
                        "source_entry_id": "02067dd9-8b4b-3d19-a078-1ca03f3bbffc",
                        "source_sense_id": "2b6d2e77-3d4a-3fc2-8885-b27dc8352179",
                        "source_sense_description": "wat men echt denkt zonder te liegen of te overdrijven",
                        "target_lang_word": "sincere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sincere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "Genuine; meaning what one says or does; heartfelt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76219fc4-baa4-4577-bda1-da5f55e20a7c",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "I believe he is sincere in his offer to help."
                                            },
                                            {
                                                "example_id": "7230d0e2-a073-40c4-b732-efa97db4099b",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "Tumid blustering, with more or less of sincerity, which need not be entirely sincere, yet the sincerer the better, is like to go far."
                                            },
                                            {
                                                "example_id": "2aa27c6c-8f04-4e4d-9c5d-9a8219846561",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "My sincerest apologies to Brother Ron Smith in the December ish."
                                            },
                                            {
                                                "example_id": "58bfafab-c385-4d58-8ef0-8dc284705263",
                                                "sense_id": "4dc4a47c-5d93-37e1-bd60-710af48ee7ed",
                                                "text": "If you choose to pull the trigger, should your drama prove sincere\nDo it somewhere far away from here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "Meant truly or earnestly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef05df3d-1155-46e2-a7cc-72fddd31bddd",
                                                "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                                "text": "She gave it a sincere if misguided effort."
                                            },
                                            {
                                                "example_id": "ab86c110-3c8d-4bd9-90f7-144014e5cb17",
                                                "sense_id": "0c0ce853-3426-3340-8e71-273e2034431d",
                                                "text": "The message that through sincere teshuvah and resolution, light and gladness can be achieved by all, is most fitting for the opening of the Yom Kippur service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683b4beb-5d15-3c83-adb1-efbcda24269b",
                                        "entry_id": "0dd6ab62-2f30-319b-b856-00ecb8661db2",
                                        "glosses": [
                                            "clean; pure"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
