                                        "glosses": [
                                            "Région du nord de l’Europe comprenant le Danemark, la Norvège et la Suède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e43c9a-1147-4d91-bb7e-6c2d3d959846",
                                                "sense_id": "c0dd4b9b-b77f-38c2-aad6-b27e6bc886bf",
                                                "text": "— On se pèle le cul en Scandinavie, tu sais, ajouta Wilhelm. Les hivers de Weimar, c’est de la rigolade à côté des nôtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb730e9c-5d1d-33f8-9e4c-a3adfb3d6637",
                                        "entry_id": "b7d0f59f-00a8-3b5a-9ef6-3f54471bab86",
                                        "glosses": [
                                            "Région précédente incluant aussi la Finlande, l’Islande et les îles Féroé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd53add2-17ce-4f4a-8be1-1408730aabc0",
                                                "sense_id": "bb730e9c-5d1d-33f8-9e4c-a3adfb3d6637",
                                                "text": "La calotte glaciaire de l’Europe s’est réfugiée en Scandinavie avec son cortège de plantes boréales."
                                            }
                                        ]
                                    }
                                ]
                            }
