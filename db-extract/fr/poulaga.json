                    }
                ],
                "senses": [
                    {
                        "sense_id": "09999acd-33d7-33f0-aeef-186313c50ff4",
                        "entry_id": "fef65632-a1e8-35c7-ae0f-e2bda7cca745",
                        "glosses": [
                            "Policier."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "61693366-30ae-46dc-917e-5139674e717a",
                                "sense_id": "09999acd-33d7-33f0-aeef-186313c50ff4",
                                "text": "Je t’en foutrais moi du poulaga, madame la fliquette."
                            },
                            {
                                "example_id": "29553e51-1b30-42a9-a95b-eac3939a86b8",
                                "sense_id": "09999acd-33d7-33f0-aeef-186313c50ff4",
                                "text": "Deux poulagas l'ont cuisiné toute la journée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb17eef8-7b74-4bf7-a854-eef38aeec034",
                        "source_entry_id": "fef65632-a1e8-35c7-ae0f-e2bda7cca745",
                        "source_sense_id": "09999acd-33d7-33f0-aeef-186313c50ff4",
                        "target_lang_word": "Bulle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bulle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "571c19ec-cc37-35c7-9027-dc6b79ceeb42",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "männliches Hausrind, das geschlechtsreif ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fbc8f7-b955-4d4d-8a6b-7235822e2f5c",
                                                "sense_id": "571c19ec-cc37-35c7-9027-dc6b79ceeb42",
                                                "text": "Der Bulle stürmte schnaubend in die Arena."
                                            },
                                            {
                                                "example_id": "08efa48d-4ded-4b86-aa89-efdf18a020d2",
                                                "sense_id": "571c19ec-cc37-35c7-9027-dc6b79ceeb42",
                                                "text": "„Entstanden ist dieses Ritual im Mittelalter, als die Bullen für die Stierkämpfe vom Feld in die Stadt getrieben werden mussten, frühmorgens, wenn niemand auf der Straße war.“"
                                            },
                                            {
                                                "example_id": "6dc566d2-decb-478b-8c7c-5a961799806b",
                                                "sense_id": "571c19ec-cc37-35c7-9027-dc6b79ceeb42",
                                                "text": "„Bei der Stierhatz von Pamplona ist am Mittwoch ein Amerikaner von einem Bullen auf die Hörner genommen worden.“"
                                            },
                                            {
                                                "example_id": "3273f3b5-cd77-4453-8915-b0fda934f1f2",
                                                "sense_id": "571c19ec-cc37-35c7-9027-dc6b79ceeb42",
                                                "text": "„Die Verfügbarkeit geeigneter Tiere wird jedoch durch die industrielle Zucht erschwert; bei den Schwarzbunten Rindern (HF) stammen z.B. bereits ca. 80 % aller Bullen aus Embryotransfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "91558407-030a-3e53-a0de-eda1f03dec54",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "geschlechtsreifes Männchen verschiedener Arten des Großwilds, vor allem der Antilopen, Elche, Elefanten, Hirsche, Giraffen, Nashörner, Robben, Seekühe, Wale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ada244-bbe3-4125-91ed-e5c964f3629d",
                                                "sense_id": "91558407-030a-3e53-a0de-eda1f03dec54",
                                                "text": "„Der Echte Buntbock besitzt ein kräftiges, dunkelbraunes Fell, welches besonders bei ausgewachsenen Bullen einen purpurnen Glanz aufweist.“"
                                            },
                                            {
                                                "example_id": "fc3b8ff3-bd4a-4aed-9364-895d4422001d",
                                                "sense_id": "91558407-030a-3e53-a0de-eda1f03dec54",
                                                "text": "„Stosszähne kommen außerdem nicht bei allen asiatischen Bullen vor: Ihr Anteil variiert, je nach Region, von fünf Prozent aller Elefantenbullen auf Sri Lanka bis zu 90 Prozent in Südindien.“"
                                            },
                                            {
                                                "example_id": "54c07b09-00bd-440b-9bf1-6a34dec8df32",
                                                "sense_id": "91558407-030a-3e53-a0de-eda1f03dec54",
                                                "text": "„Wie Genanalysen gezeigt haben, paart sich eine Buckelwalkuh in jeder Saison mit anderen Bullen.“"
                                            },
                                            {
                                                "example_id": "912edc8b-9d07-4e7a-a7fc-16069fb7ccf6",
                                                "sense_id": "91558407-030a-3e53-a0de-eda1f03dec54",
                                                "text": "„Der Südliche See-Elefant (Mirounga leonina) hat seinen Namen von der rüsselartigen Erweiterung der Nase des erwachsenen Bullen, die sein Gebrüll verstärkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "4a3996f1-4906-38d4-a82f-30faeacd0d13",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "Mann, der eine hervorstechend kräftige, jedoch plump und ungeschlacht wirkende Statur besitzt"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15a5b41-f3fd-4b82-9d40-fa71174c83ed",
                                                "sense_id": "4a3996f1-4906-38d4-a82f-30faeacd0d13",
                                                "text": "„‚Wer in diesem Sport seinen Kopf nicht wegnimmt‘, so Schulz, ‚der muß n bißchen doof sein.‘ Oder ein kraftstrotzender Bulle mit Beißhemmung, so wie Axel, der Gehemmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fefae855-bc36-3c07-b7d1-4d0ba86162ae",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "Beamter der Polizei, insbesondere der Kriminalpolizei"
                                        ],
                                        "tags": [
                                            "Germany",
                                            "Swiss Standard German",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e191d7f9-8406-4071-ad36-46e08f22d4e6",
                                                "sense_id": "fefae855-bc36-3c07-b7d1-4d0ba86162ae",
                                                "text": "„Am 27. Juni 1993 um 15.15 Uhr in der Bahnhofsunterführung von Bad Kleinen hielt ein GSG-9-Beamter seine Pistole an Hogefelds Hinterkopf und warf die Terroristin zu Boden. ‚Dieser Bulle‘, erinnert sich Hogefeld, habe sie ‚ziemlich sofort angesprungen‘.“"
                                            },
                                            {
                                                "example_id": "c02df75b-2b8e-4b0a-b291-cff27e39a2dd",
                                                "sense_id": "fefae855-bc36-3c07-b7d1-4d0ba86162ae",
                                                "text": "„‚Wer Bulle ist, der kennt sich aus. Der weiß, wo er wen anrufen muss. Man spricht die gleiche Sprache‘, sagt ein Ermittler.“"
                                            },
                                            {
                                                "example_id": "429701e5-174f-4347-a7ec-fd8f5b636d75",
                                                "sense_id": "fefae855-bc36-3c07-b7d1-4d0ba86162ae",
                                                "text": "„Auf einmal kam so ein junger Bursche vorbei. Als der vorbei war, hörten wir seinen Funk und sahen seine Pistole. Da wusste wir, dass er ein Bulle ist.“"
                                            },
                                            {
                                                "example_id": "517cb34a-ab1d-4bcb-b9c8-2966b5657ddf",
                                                "sense_id": "fefae855-bc36-3c07-b7d1-4d0ba86162ae",
                                                "text": "„Sie konnte die Taschenpistole spüren, die sie dem Bullen geklaut hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "81046535-d43f-3436-af00-9ca60d21a001",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "Person, die einen einträglichen, führenden Posten innehat"
                                        ],
                                        "tags": [
                                            "casual",
                                            "slang"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e8df7737-e081-3963-9534-f247cdefe426",
                                        "entry_id": "9221f2b3-6784-35fa-8992-2fa3d55f069b",
                                        "glosses": [
                                            "Börsenspekulant, dessen Handeln, hinsichtlich der weiteren Marktentwicklung, durch die optimistische Annahme einer erwarteten Hausse gekennzeichnet ist"
                                        ],
                                        "tags": [
                                            "Jargon",
                                            "im",
                                            "Börsenwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b836148-073c-403b-bb4c-0dd83055f829",
                                                "sense_id": "e8df7737-e081-3963-9534-f247cdefe426",
                                                "text": "„Dagegen sind die Bullen jene, die bei steigenden Kursen, also in einer sogenannte Hausse das Sagen haben.“"
                                            },
                                            {
                                                "example_id": "2a29aecd-8edd-444d-b977-ff650d2a9119",
                                                "sense_id": "e8df7737-e081-3963-9534-f247cdefe426",
                                                "text": "„Doch unter Jelzins Nachfolger Wladimir Putin wuchsen Wirtschaft und Anlegervertrauen wieder, und lange bevor die Bärenstimmung an den westlichen Börsen abflaute, regierten am Moskauer Aktienmarkt wieder die Bullen.“"
                                            },
                                            {
                                                "example_id": "cb72c1c5-3abe-4608-bc38-ac72e21c5bc3",
                                                "sense_id": "e8df7737-e081-3963-9534-f247cdefe426",
                                                "text": "„Die Bären sind fort, die Bullen sind am Ruder. Sie schieben die Kurse nach oben: Der Dax hat wieder die Marke von 5700 Punkten übersprungen und nimmt das alte Jahreshoch in den Blick. Das lässt Optimisten, also die Bullen, jubeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bulle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "543458a2-0f0a-388a-ab73-f8f8e31fa4db",
                                        "entry_id": "e32cb19a-882a-3464-97c9-14661373663c",
                                        "glosses": [
                                            "besonders im Mittelalter gebräuchliches, kreisrundes metallenes Siegel oder Siegelkapsel (zumeist aus Blei, Gold, Silber)"
                                        ],
                                        "tags": [
                                            "Sphragistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e059216d-f688-4b6d-93b6-268cfdaa2f9c",
                                                "sense_id": "543458a2-0f0a-388a-ab73-f8f8e31fa4db",
                                                "text": "„Beide Platten sind durch ein stärkeres an zwei Zoll hohes Blech vom nämlichen Metall, oft auch wol nur stark vergoldet, so verbunden, daß die ganze Bulle einer Kapsel ähnlich stehet. Durch diese Einfassung läuft auch die Schnur, mit welcher die Bulle an die Urkunde befestigt ist.“"
                                            },
                                            {
                                                "example_id": "8d936436-3504-4c3f-9307-c35245ed9402",
                                                "sense_id": "543458a2-0f0a-388a-ab73-f8f8e31fa4db",
                                                "text": "„Zudem entspricht die Bulle, mit der Friedrich I. als König (I, Taf. 21, 3. 4) siegelte, im allgemeinen der Lothars III.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "747a0e37-c99d-360a-9f4d-49e4f9e3510f",
                                        "entry_id": "e32cb19a-882a-3464-97c9-14661373663c",
                                        "glosses": [
                                            "mittelalterliche Urkunde, die ein oder mehrere metallene Siegel besitzt"
                                        ],
                                        "tags": [
                                            "Diplomatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ef598f-e1a0-4641-a2d7-3ca91c8ba8f2",
                                                "sense_id": "747a0e37-c99d-360a-9f4d-49e4f9e3510f",
                                                "text": "„Ich erinnere mich nicht mehr an den Rest der Bulle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "7e863ff1-2ed1-3bf4-bb85-739c2b9c68e8",
                                        "entry_id": "e32cb19a-882a-3464-97c9-14661373663c",
                                        "glosses": [
                                            "mit einem an einer Schnur liegendem Bleisiegel versehener, auf Lateinisch abgefasster, weihevoller päpstlicher Erlass"
                                        ],
                                        "tags": [
                                            "Diplomatik",
                                            "christliche Religion",
                                            "katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a2905b2-fb8b-48ea-9ae2-dbf6b66ce9bb",
                                                "sense_id": "7e863ff1-2ed1-3bf4-bb85-739c2b9c68e8",
                                                "text": "„Da verfährt halt die Hlg. Wissenschaft radikaler in schlichter Einfachheit ihrer Bulle, daß alles, was ihr nicht paßt, nicht existiert.“"
                                            },
                                            {
                                                "example_id": "39449493-17aa-4267-9a99-608e28489605",
                                                "sense_id": "7e863ff1-2ed1-3bf4-bb85-739c2b9c68e8",
                                                "text": "„Eine 334 Jahre alte Bulle von Papst Innozenz XI. (1611-1689) ist bei Umbauarbeiten im Diözesanarchiv Bautzen entdeckt worden.“"
                                            },
                                            {
                                                "example_id": "77f961ef-3257-4fde-bcc1-917118a08c94",
                                                "sense_id": "7e863ff1-2ed1-3bf4-bb85-739c2b9c68e8",
                                                "text": "„Im Proömium dieser Bulle der Einberufung werden das theologische Urbild der Prophezeiung des Johannes, der feste Glaube an Christi Gegenwart in seiner Kirche und der auf den Evangelien beruhende Optimismus des Papstes ausgedrückt […]. Die Bulle trägt die Rota, die eigenhändige Unterschrift des Papstes […] und die Unterschrift von 62 Kardinälen, darunter diejenige Kardinal Montinis, des Nachfolgers Papst Johannes’ (ff. 6r-9v).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
                    },
