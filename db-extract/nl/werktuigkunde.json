                    {
                        "translation_id": "3edc281e-481f-4a9c-a988-b2987fb12f90",
                        "source_entry_id": "b24f248e-ced3-3d69-9cb7-48edf08bfea6",
                        "source_sense_id": "7400b1be-d4c3-3129-bbc0-7495019e2c65",
