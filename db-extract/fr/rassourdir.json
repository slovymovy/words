                "senses": [
                    {
                        "sense_id": "ec21c3a1-c98e-3e57-ad94-c706d5cfd8bf",
                        "entry_id": "f32c1f5b-c0c8-359c-aa26-aea404653ab3",
                        "glosses": [
                            "Assourdir de nouveau, ou, simplement, assourdir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07da0824-21fb-453c-a58c-d7c3a65058ba",
                                "sense_id": "ec21c3a1-c98e-3e57-ad94-c706d5cfd8bf",
                                "text": "Ha ! parlez doucement ; Vous me rassourdissez, la peste ! comme il crie !"
                            },
                            {
                                "example_id": "a55141ea-6f51-41c5-9808-050d58f222fc",
                                "sense_id": "ec21c3a1-c98e-3e57-ad94-c706d5cfd8bf",
                                "text": "Le bruit des mouches d’eau rassourdit les enclumes\nEt le repos selon la nature incolume\nEst un ordre du Tout pour que le Verbe soit."
                            }
                        ]
                    }
