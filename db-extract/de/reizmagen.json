                        "examples": [
                            {
                                "example_id": "aaa506d2-3e37-4c41-89b8-fba8a36fa9d7",
                                "sense_id": "c86e5a38-d19e-3fe5-8f7f-e0c87f3a5665",
                                "text": "„Und der andere weist immer wieder darauf hin, dass er in regelmäßigen Abständen essen müsse, weil er einen Reizmagen habe.“"
                            },
                            {
                                "example_id": "d83ec292-da86-447c-a133-66a7902e3c19",
                                "sense_id": "c86e5a38-d19e-3fe5-8f7f-e0c87f3a5665",
                                "text": "„Kurz vor dem Urlaub (wie auch an den Oster- und Weihnachtsfeiertagen) schikaniert der Papa die Mama regelmäßig mit seinem Mangel an weißen Blutkörperchen und seinem nervösen Reizmagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
