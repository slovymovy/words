                                        "sense_id": "1c613547-73c8-31c9-a6f6-0b9def9ec7b5",
                                        "entry_id": "c26dd40a-3010-3301-85a1-ee4409251d4a",
                                        "glosses": [
                                            "A neurotoxin, originally discovered in Tetraodontiformes, and found in pufferfish, blue-ringed octopus, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdf6c282-be2f-42ae-bb98-5c59553ebf71",
                                                "sense_id": "1c613547-73c8-31c9-a6f6-0b9def9ec7b5",
                                                "text": "Both creatures belong to a large pan-tropical order of fish, many of which have tetrodotoxin in their skin, liver, ovaries, and intestines."
                                            },
                                            {
                                                "example_id": "fe13d12f-387f-481d-aa97-21f10518c598",
                                                "sense_id": "1c613547-73c8-31c9-a6f6-0b9def9ec7b5",
                                                "text": "The blue-ringed octopus Hapalochlaena lunulata has tetrodotoxin, the deadly toxin it also releases in a bite, in their ink but the concentrations and effect in inking are not known."
                                            },
                                            {
                                                "example_id": "e3cebd0f-84b1-4992-b3dc-8e71300db12c",
                                                "sense_id": "1c613547-73c8-31c9-a6f6-0b9def9ec7b5",
                                                "text": "Among those who think of fugu as merely a distant delicacy, knowledge rarely goes beyond the fish’s infamous trait: In the most delicious species, the innards are suffused with the neurotoxin called tetrodotoxin (TTX)."
                                            }
                                        ]
                                    }
