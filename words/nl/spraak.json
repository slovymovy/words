                                "target_lang_sense_clarification": "способность говорить"
                            },
                            {
                                "target_lang_word": "речевая способность",
                                "target_lang_sense_clarification": "физиологическая возможность говорить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08f23b40-bafc-3696-99aa-771e549d590a",
                    "sense_definition": "de manier waarop iemand spreekt of de handeling van het spreken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>spraak</w> was duidelijk en goed verstaanbaar voor het hele publiek.",
                            "target_lang_translations": {
                                "en": "His <w>speech</w> was clear and easily understood by the entire audience.",
                                "ru": "Его <w>речь</w> была четкой и хорошо понятной всей аудитории."
                            }
                        },
                        {
                            "text": "Door zijn snelle <w>spraak</w> was het lastig om alle details te volgen.",
                            "target_lang_translations": {
                                "en": "Because of his rapid <w>speech</w>, it was difficult to follow all the details.",
                                "ru": "Из-за его быстрой <w>речи</w> было трудно уследить за всеми деталями."
                            }
                        }
                    ],
                    "synonyms": [
