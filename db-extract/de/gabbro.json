                    {
                        "form_id": "8e9bf863-e771-41b7-87de-aa171da319a4",
                        "entry_id": "0ef2a2c6-b9a3-32a5-82c9-fd0f3632427d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gabbros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                        "entry_id": "0ef2a2c6-b9a3-32a5-82c9-fd0f3632427d",
                        "glosses": [
                            "körniges magmatisches Tiefengestein von schwarzer bis schwarzgrüner Farbe, das sich hauptsächlich aus Plagioklas und Pyroxen zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf59b07-04ff-43fc-924f-f6a699751615",
                                "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                                "text": "Diese Gebirgsformation besteht hauptsächlich aus Gabbro."
                            },
                            {
                                "example_id": "ce8bccf0-bca4-43c9-9444-5ebcf930f036",
                                "sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                                "text": "„Der Stein in meiner Hand war noch eine Weile Hitze und Druck ausgesetzt, der Granit und Gabbro in die kleinsten Risse presste, jene Kristalle, hellroten Streifen und milchigen Einsprengsel in seinem monochromen Grau; aber er ragte weiter knapp über einen Ozean, in dem bereits das Leben entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b08494d2-d2e3-42b2-b35c-966821cd4581",
                        "source_entry_id": "0ef2a2c6-b9a3-32a5-82c9-fd0f3632427d",
                        "source_sense_id": "ec33e3ba-a60e-35bd-a1bf-fbacaf3c7543",
                        "target_lang_word": "輝長岩",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "輝長岩",
