                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buitenspeler wist de bal perfect <w>voortrekken</w> zodat de spits kon scoren.",
                            "target_lang_translations": {
