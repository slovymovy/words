        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                    "sense_definition": "Something that is owned, such as financial assets, stocks, bonds, or land.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "assets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor decided to sell some of his <w>holdings</w> in the technology sector.",
                            "target_lang_translations": {
                                "ru": "Инвестор решил продать часть своих <w>акти́вов</w> в технологическом секторе.",
                                "tr": "Yatırımcı, teknoloji sektöründeki bazı <w>varlıklarını</w> satmaya karar verdi."
                            }
                        },
                        {
                            "text": "The library has extensive <w>holdings</w> of ancient manuscripts and maps.",
                            "target_lang_translations": {
                                "ru": "Библиотека располагает обширными <w>фо́ндами</w> древних рукописей и карт.",
                                "tr": "Kütüphane, geniş bir antik el yazması ve harita <w>koleksiyonuna</w> sahiptir."
                            }
                        }
