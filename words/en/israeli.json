        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "34694121-82c7-3c28-951f-97105a9af22f",
                    "sense_definition": "The modern Hebrew language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Some linguists argue that we should call the language <w>Israeli</w> instead of Hebrew.",
                            "target_lang_translations": {
                                "ru": "Некоторые лингвисты утверждают, что этот язык следует называть <w>израильским</w>, а не ивритом.",
                                "zh": "一些语言学家认为我们应该把这种语言称为<w>现代希伯来语</w>，而不是希伯来语。",
                                "es": "Algunos lingüistas argumentan que deberíamos llamar al idioma <w>hebreo moderno</w> en lugar de hebreo."
                            }
                        },
                        {
                            "text": "He studies the grammatical differences between biblical Hebrew and <w>Israeli</w>.",
                            "target_lang_translations": {
                                "ru": "Он изучает грамматические различия между библейским ивритом и <w>израильским</w>.",
                                "zh": "他研究圣经希伯来语和<w>现代希伯来语</w>之间的语法差异。",
                                "es": "Él estudia las diferencias gramaticales entre el hebreo bíblico y el <w>hebreo moderno</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Modern Hebrew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Современный язык иврит.",
                        "zh": "现代希伯来语。",
                        "es": "El idioma hebreo moderno."
                    },
                    "translations": {
