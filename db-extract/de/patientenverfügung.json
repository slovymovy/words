                "senses": [
                    {
                        "sense_id": "641a6796-b644-37ae-9936-a431510fbbbd",
                        "entry_id": "252eb2c8-6c9e-3025-9b60-d5cf54f87b8d",
                        "glosses": [
                            "schriftliche Verfügung einer erwachsenen Person über gegebenenfalls zu ergreifende beziehungsweise zu unterlassende medizinische Maßnahmen, für den Fall, dass sie in die Lage gerät, ihren Willen nicht mehr (wirksam) selbst erklären zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2685a2-f906-4652-ace5-d9dc2f3d0158",
                                "sense_id": "641a6796-b644-37ae-9936-a431510fbbbd",
                                "text": "„Falls Sie eine beachtliche Patientenverfügung errichten wollen, sollten Sie dies mit einer Ärztin/einem Arzt besprechen, um klar beschreiben zu können, warum eine bestimmte medizinische Maßnahme abgelehnt wird.“"
                            },
                            {
                                "example_id": "91d7e346-0671-4de6-a283-58ad7858ccf5",
                                "sense_id": "641a6796-b644-37ae-9936-a431510fbbbd",
                                "text": "„Ich sollte, dachte ich, eine Patientenverfügung machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc24c2a3-32f6-4600-9140-fccbfa4fe2bd",
                        "source_entry_id": "252eb2c8-6c9e-3025-9b60-d5cf54f87b8d",
                        "source_sense_id": "641a6796-b644-37ae-9936-a431510fbbbd",
                        "target_lang_word": "advance directive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advance directive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0d4010-0f39-3351-a716-acd55dd2ea1a",
                                        "entry_id": "01c335c0-fd22-3741-b15f-7ba5fe48d853",
                                        "glosses": [
                                            "A legal document outlining a person's end-of-life medical and healthcare wishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e0fe9b-c4d6-4462-9b55-721bc2c47e5c",
                                                "sense_id": "ef0d4010-0f39-3351-a716-acd55dd2ea1a",
                                                "text": "The use of a generalized standard, as well as the frequent imprecision of advance directive terminology, underlines the importance of consultation between a declarant and those persons (including health-care agents and medical professionals) likely to be involved in administration of an advance directive."
                                            },
                                            {
                                                "example_id": "e57eb0e2-37fe-45e6-b6e0-ee06d1ceb24a",
                                                "sense_id": "ef0d4010-0f39-3351-a716-acd55dd2ea1a",
                                                "text": "Collapsology has been likened to the cultural equivalent of an advance directive in the medical world, whereby you specify what actions should be taken for your health if you are no longer able to make decisions[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
