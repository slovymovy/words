                        "sense_id": "7ef53d20-88bd-3fa8-a4b1-9f59c5e29833",
                        "entry_id": "517af341-73ba-374b-9690-bdf199dd0688",
                        "glosses": [
                            "Activité ludique, généralement dangereuse, qui consiste à sauter dans une piscine depuis un balcon ou de balcon en balcon."
                        ],
                        "tags": [
                            "Hispanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "76dad1e8-a0dc-4274-8264-ad90952776aa",
                                "sense_id": "7ef53d20-88bd-3fa8-a4b1-9f59c5e29833",
                                "text": "Depuis le début de l‘été, quatre personnes sont mortes en pratiquant le balconing. Ce petit jeu consiste à sauter de son balcon directement dans la piscine de l'hôtel."
                            },
                            {
                                "example_id": "004d3765-9621-47b1-8482-476f778ac659",
                                "sense_id": "7ef53d20-88bd-3fa8-a4b1-9f59c5e29833",
                                "text": "Plusieurs fois par semaine, des ambulances sont appelées pour secourir des jeunes ayant pratiqué le « balconing ». L’activité est souvent associée à une consommation d’alcool ou de drogue."
                            }
                        ]
                    }
                ],
