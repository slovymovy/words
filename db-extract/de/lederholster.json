                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8addeeb-50c7-43d8-b017-2b630415d8c5",
                                "sense_id": "c7f68d61-2ea5-3c60-b899-841157675abe",
                                "text": "„Neben einem Piloten mit Basecap und einer 45er, die in einem Lederholster neben dem Sitz steckte, erwarteten ihn zwei weitere Männer mit Kalaschnikows auf dem Schoß.“"
                            },
                            {
                                "example_id": "bf154d64-321e-4a76-a7f0-0d930b7eed65",
                                "sense_id": "c7f68d61-2ea5-3c60-b899-841157675abe",
                                "text": "„In einem schwarzen, hoch auf der Hüfte sitzenden Lederholster steckte ein kleiner Revolver.“"
                            },
                            {
                                "example_id": "a1626037-4758-4e55-9210-9452efe0a75e",
                                "sense_id": "c7f68d61-2ea5-3c60-b899-841157675abe",
                                "text": "„Er zog seine Dienstwaffe, die Z88, aus dem Lederholster an seinem Gürtel, stieg aus und trabte los, die Augen auf die Fenster des Hauses gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
