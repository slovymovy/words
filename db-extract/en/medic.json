                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b426387-7e03-3cbc-a410-731fc2df2752",
                        "entry_id": "20b86e42-047a-318d-9438-f9c87617bcfe",
                        "glosses": [
                            "Person, die im weiteren Sinne medizinisch tätig ist"
                        ],
                        "tags": [
                            "British",
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2273d000-3911-4993-bf42-1fbd9b152e58",
                        "source_entry_id": "20b86e42-047a-318d-9438-f9c87617bcfe",
                        "source_sense_id": "9b426387-7e03-3cbc-a410-731fc2df2752",
                        "source_sense_description": "Person, die im weiteren Sinne medizinisch tätig ist",
                        "target_lang_word": "Mediziner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mediziner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                        "entry_id": "c11898d1-a635-3aa5-a475-7faa2a581df1",
                                        "glosses": [
                                            "Person, die Medizin studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609c4497-b0d1-4599-a919-ab0c61ecc4eb",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "Der Mediziner verschreibt Tabletten gegen den Husten."
                                            },
                                            {
                                                "example_id": "35975a2d-5661-4fe9-a2d7-b12437ad0ea7",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "Der Mediziner behandelt einen Patienten."
                                            },
                                            {
                                                "example_id": "540d0783-4747-435f-b04d-9af528bb76c9",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„In Österreich führte das Verbot dazu, dass österreichische Mediziner die von ihnen mit herausgegebenen Zeitschriften mit einem Verlagsort im Deutschen Reich nicht mehr beziehen konnten.“"
                                            },
                                            {
                                                "example_id": "513fa2e6-984c-4aa2-866d-0da2764ed524",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Immer, wenn er zum Arzt muss, wird er von Ines begleitet, die sich alles Wichtige merkt, was der Mediziner gesagt hat.“"
                                            },
                                            {
                                                "example_id": "e1872e04-23b7-4f19-9ed2-80818e97c0e5",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Der Mediziner gab den Assistenten ein Zeichen, worauf sie die Kabine betraten und Hohensteins Körper drehten.“"
                                            },
                                            {
                                                "example_id": "8591a3dd-dda4-4afb-a640-d986aee4865a",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Und doch sind seine Fragestellungen in theoretischer und angewandter Hinsicht nicht nur für Linguisten, Psychologen und Pädagogen von Belang, sondern auch für Mediziner und für Verhaltens- und Kommunikationswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "c6b33e88-e83b-4d5b-a3e4-b2ad9f1b7200",
                                                "sense_id": "cd3b2e61-fcc2-371e-a204-cc8c3b429585",
                                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f45e846-fc35-4234-a597-0331081ff10e",
                        "source_entry_id": "20b86e42-047a-318d-9438-f9c87617bcfe",
                        "source_sense_id": "9b426387-7e03-3cbc-a410-731fc2df2752",
                        "source_sense_description": "Person, die im weiteren Sinne medizinisch tätig ist",
                        "target_lang_word": "medico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "a3926303-c3a7-3163-9bf3-693f2cdf87be",
                                        "entry_id": "8bf4d60c-fb52-3d7f-92a9-c2186a5f60a8",
                                        "glosses": [
                                            "attinente alla medicina, alle scienze curative riconosciute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d53eff8-5dea-4e00-974f-cef981885ddb",
                                                "sense_id": "a3926303-c3a7-3163-9bf3-693f2cdf87be",
                                                "text": "le conoscenze dell'anatomia, delle piante curative e di altre meraviglie della natura assieme sono a scopo medico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a40fe3c1-566f-3b19-ac3e-be039dd6a035",
                                        "entry_id": "8bf4d60c-fb52-3d7f-92a9-c2186a5f60a8",
                                        "glosses": [
                                            "che concerne il medico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf15145-2462-4185-808c-3b825c9bb229",
                                                "sense_id": "a40fe3c1-566f-3b19-ac3e-be039dd6a035",
                                                "text": "per giustificare la tua prolungata assenza mi servirebbe un certificato medico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96827f3d-38ea-3a0b-9574-cb1e4335acec",
                                        "entry_id": "8bf4d60c-fb52-3d7f-92a9-c2186a5f60a8",
                                        "glosses": [
                                            "turismo medico: per il migliore trattamento medico, per esempio anche in Italia, è lo spostamento volontario, effettuato da pazienti di loro iniziativa, da una città ad un'altra appunto per cure possibili ed una prospettiva di guarigione più ampia"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "936f2bfd-d6f8-3d15-a8a5-316da785ce93",
