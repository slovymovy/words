    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "619ccb23-06c6-356e-b771-17bc219872e1",
                    "sense_definition": "Petite course ou achat effectué pour répondre à un besoin quotidien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "course",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois descendre au supermarché pour faire une petite <w>commission</w> avant la fermeture."
                        },
                        {
                            "text": "Mon père est parti en ville pour une <w>commission</w> urgente ce matin."
                        }
                    ],
                    "common_phrases": [
                        "faire une commission",
                        "faire les commissions"
                    ]
                },
                {
                    "sense_id": "2fb620ce-1968-38c9-b022-821abb1157c7",
                    "sense_definition": "Rémunération ou pourcentage perçu par un intermédiaire lors d'une transaction commerciale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent immobilier a touché une belle <w>commission</w> après la vente de cet appartement."
                        },
                        {
                            "text": "La banque prélève une petite <w>commission</w> sur chaque transfert d'argent international."
                        }
                    ],
                    "common_phrases": [
                        "toucher une commission",
                        "prendre une commission"
                    ]
                },
                {
                    "sense_id": "945989f2-a3b4-3f3f-8605-e440d556d0a0",
                    "sense_definition": "Groupe de personnes désignées pour examiner un projet ou remplir une tâche déterminée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>commission</w> spéciale a été créée pour analyser les causes de cet accident."
                        },
                        {
                            "text": "Les députés ont débattu de cette nouvelle loi pendant toute la réunion de la <w>commission</w>."
                        }
                    ],
                    "common_phrases": [
                        "présider une commission",
                        "siéger à une commission"
                    ]
                },
                {
                    "sense_id": "3b8e1450-d47d-3ff9-a04c-4332b9b2ad63",
                    "sense_definition": "Charge ou mission ponctuelle confiée à une personne pour le compte d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mandat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur m'a confié une <w>commission</w> importante auprès du ministère."
                        },
                        {
                            "text": "Il a scrupuleusement rempli la <w>commission</w> que son responsable lui avait assignée."
                        }
                    ],
                    "synonyms": [
                        "mandat"
                    ],
                    "common_phrases": [
                        "remplir une commission",
                        "donner commission"
                    ]
                },
                {
                    "sense_id": "0349b122-36d3-39b1-99ee-0bb7055de211",
                    "sense_definition": "Action de commettre, d'accomplir une faute, un acte répréhensible ou une infraction pénale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a formellement nié la <w>commission</w> de ce délit financier devant les juges."
                        },
                        {
                            "text": "La police a réuni des preuves établissant la <w>commission</w> d'un vol avec effraction."
                        }
                    ],
                    "common_phrases": [
                        "commission d'une infraction",
                        "commission d'un délit"
                    ]
                },
                {
                    "sense_id": "56ba0e85-285a-39ab-b856-b32538ca84c8",
                    "sense_definition": "Action d'uriner ou de déféquer, employée notamment dans le langage familier ou enfantin.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La maman a accompagné son jeune fils aux toilettes pour faire sa <w>commission</w>."
                        },
                        {
                            "text": "Le chiot attend patiemment devant la porte pour aller faire sa <w>commission</w> dehors."
                        }
                    ],
                    "common_phrases": [
                        "faire sa commission"
                    ],
                    "traits": [
