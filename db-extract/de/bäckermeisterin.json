                "senses": [
                    {
                        "sense_id": "e81d162f-6c43-34c0-b880-47fb2c6c09ca",
                        "entry_id": "c996afaa-9fc2-3aa4-a637-3c6e38922dc0",
                        "glosses": [
                            "weibliche Person, die den Meistertitel im Bäckerhandwerk hat"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "3d1e7a2b-2816-4ea4-bb88-fb7878e58849",
                                "sense_id": "e81d162f-6c43-34c0-b880-47fb2c6c09ca",
                                "text": "Ihre Mutter ist Bäckermeisterin."
                            },
                            {
                                "example_id": "38587cf1-817a-4000-bd88-c6e038563c4a",
                                "sense_id": "e81d162f-6c43-34c0-b880-47fb2c6c09ca",
                                "text": "„Das Etikett heißt Brotmarke und hat seit vielen Jahren Tradition, sagt Bäckermeisterin Christa Lutum aus Berlin.“"
                            },
                            {
                                "example_id": "6a8a8af5-57ee-4d56-9592-dfe929ef2ed1",
                                "sense_id": "e81d162f-6c43-34c0-b880-47fb2c6c09ca",
                                "text": "„Ein Gewinn war eine Ausbildung zur Bäckermeisterin und Betriebswirtin des Handwerks an der Akademie des bayerischen Bäckerhandwerks in Lochham.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
