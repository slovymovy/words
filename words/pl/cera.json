    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b9b4ce2-f24b-3fe9-ac59-cacbd6aa24de",
                    "sense_definition": "wygląd skóry na twarzy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "skóra",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zdrowa <w>cera</w> wymaga odpowiedniej pielęgnacji każdego dnia.",
                            "target_lang_translations": {
                                "ru": "Здоровая <w>кожа лица</w> требует ежедневного правильного ухода."
                            }
                        },
                        {
                            "text": "Po długim urlopie na słońcu jej <w>cera</w> wyglądała na bardzo wypoczętą.",
                            "target_lang_translations": {
                                "ru": "После долгого отпуска на солнце её <w>кожа</w> выглядела очень отдохнувшей."
                            }
                        }
                    ],
                    "synonyms": [
                        "karnacja"
                    ],
                    "common_phrases": [
                        "tłusta cera",
                        "sucha cera",
                        "promienna cera"
                    ],
                    "target_lang_definitions": {
                        "ru": "внешний вид кожи лица"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожа лица",
                                "target_lang_sense_clarification": "общее состояние и внешний вид кожи"
                            },
                            {
                                "target_lang_word": "цвет лица",
                                "target_lang_sense_clarification": "оттенок и свежесть кожи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13dc80e8-e6dd-3927-8be4-0693ba04c080",
                    "sense_definition": "ścieg używany do naprawy dziur w tkaninie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "szycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Babcia wykonała staranną <w>cerę</w> na dziurawym swetrze.",
                            "target_lang_translations": {
                                "ru": "Бабушка сделала аккуратную <w>штопку</w> на дырявом свитере."
                            }
                        },
                        {
                            "text": "Dzięki umiejętnej <w>cerze</w> spodnie wyglądały jak nowe.",
                            "target_lang_translations": {
                                "ru": "Благодаря умелой <w>штопке</w> брюки выглядели как новые."
                            }
                        }
                    ],
                    "synonyms": [
                        "cerowanie"
                    ],
                    "common_phrases": [
                        "niewidoczna cera"
                    ],
                    "target_lang_definitions": {
                        "ru": "шов, используемый для починки дыр в ткани"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штопка",
                                "target_lang_sense_clarification": "процесс или результат починки ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f78e869-1f69-3ef7-a01c-fb91245d3dc3",
                    "sense_definition": "rodzaj ozdobnego haftu koronkowego",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "szycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary obrus zdobiła misterna <w>cera</w> wykonana ręcznie.",
                            "target_lang_translations": {
                                "ru": "Старую скатерть украшала искусная <w>кружевная вышивка</w>, выполненная вручную."
                            }
                        },
                        {
                            "text": "W muzeum można podziwiać dawną <w>cerę</w> na lnianych serwetach.",
                            "target_lang_translations": {
                                "ru": "В музее можно полюбоваться старинной <w>вышивкой</w> на льняных салфетках."
                            }
                        }
                    ],
                    "synonyms": [
                        "haft"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид декоративной кружевной вышивки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружевная вышивка",
                                "target_lang_sense_clarification": "декоративное украшение ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d1aea71-2dc3-32eb-ab41-cef9db5abbe4",
                    "sense_definition": "córka",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rodzina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To jest moja najmłodsza <w>cera</w>.",
                            "target_lang_translations": {
                                "ru": "Это моя младшая <w>дочь</w>."
                            }
                        },
                        {
                            "text": "Każda <w>cera</w> powinna szanować swoich rodziców.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>дочь</w> должна уважать своих родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "córka"
                    ],
                    "traits": [
