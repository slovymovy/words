    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6b95997-52b6-3b75-89bc-386ec8ebd90c",
                    "sense_definition": "Personne dont le métier consiste à transporter des fardeaux ou des bagages.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "metier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>porteur</w> a déposé nos valises directement dans le hall de la gare."
                        },
                        {
                            "text": "À son arrivée à l'hôtel, plusieurs <w>porteurs</w> sont venus l'aider avec ses bagages."
                        }
                    ],
                    "common_phrases": [
                        "porteur de valises",
                        "porteur de bagages"
                    ]
                },
                {
                    "sense_id": "342cfb5c-4247-3c66-8f7b-7dc8fb9699b9",
                    "sense_definition": "Personne qui apporte ou transmet un message, une nouvelle ou un pli officiel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'émissaire s'est présenté au château en tant que <w>porteur</w> d'un message urgent."
                        },
                        {
                            "text": "Le facteur est souvent considéré comme le <w>porteur</w> de bonnes nouvelles."
                        }
                    ],
                    "synonyms": [
                        "messager"
                    ],
                    "common_phrases": [
                        "porteur d'une lettre",
                        "porteur de mauvaises nouvelles"
                    ]
                },
                {
                    "sense_id": "7b03d22d-cc6c-317b-a0a4-c28261cb88fb",
                    "sense_definition": "Personne qui conçoit un projet, prend l'initiative et rassemble les moyens nécessaires à sa réalisation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "projet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>porteurs</w> de ce nouveau projet recherchent des financements auprès de plusieurs banques."
                        },
                        {
                            "text": "Chaque <w>porteuse</w> d'initiative citoyenne a pu exposer ses idées devant le jury."
                        }
                    ],
                    "synonyms": [
                        "promoteur"
                    ],
                    "common_phrases": [
                        "porteur de projet"
                    ]
                },
                {
                    "sense_id": "b4b7490b-4651-35bb-ad43-5c64bfe762c1",
                    "sense_definition": "Personne qui détient un titre financier, une action ou un effet de commerce payable à celui qui le présente.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chèque a été rédigé au bénéfice du <w>porteur</w> qui peut l'encaisser immédiatement."
                        },
                        {
                            "text": "Les <w>porteurs</w> d'obligations recevront leurs intérêts à la fin du trimestre."
                        }
                    ],
                    "synonyms": [
                        "détenteur"
                    ],
                    "common_phrases": [
                        "titre au porteur",
                        "payable au porteur"
                    ]
                },
                {
                    "sense_id": "cfb29a3f-632c-3062-9554-006ef2df97c0",
                    "sense_definition": "Engin forestier lourd conçu pour transporter le bois coupé hors de la zone de coupe par chargement complet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foresterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur manœuvre le <w>porteur</w> entre les arbres abattus pour charger les troncs."
                        },
                        {
                            "text": "Plusieurs <w>porteurs</w> forestiers sont intervenus pour dégager la parcelle après les intempéries."
                        }
                    ],
                    "antonyms": [
                        "débusqueur"
                    ],
                    "common_phrases": [
                        "porteur forestier"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technique forestière"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e26c2523-525b-3c79-82a2-2a135af8f1fc",
                    "sense_definition": "Qui soutient ou supporte le poids d'une structure ou d'une charge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est strictement interdit d'abattre ce mur <w>porteur</w> sans l'avis d'un ingénieur."
                        },
                        {
                            "text": "Les poutres <w>porteuses</w> garantissent la solidité de tout le bâtiment ancien."
                        }
                    ],
                    "common_phrases": [
                        "mur porteur",
                        "poutre porteuse"
                    ]
                },
                {
                    "sense_id": "57eda088-0030-36d8-905c-69aae61f32e1",
                    "sense_definition": "Qui offre de réelles perspectives de développement, d'expansion économique ou de réussite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "potentiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les énergies renouvelables constituent un secteur particulièrement <w>porteur</w> pour l'avenir."
                        },
                        {
                            "text": "Cette entreprise a choisi d'investir dans des filières <w>porteuses</w> pour stimuler sa croissance."
                        }
                    ],
                    "synonyms": [
                        "prometteur",
                        "florissant"
                    ],
                    "common_phrases": [
                        "marché porteur",
                        "secteur porteur",
                        "créneau porteur"
                    ]
                },
                {
                    "sense_id": "21e1877c-d605-3845-9ea0-20c3c4b14e3e",
                    "sense_definition": "Qui héberge un agent infectieux, un virus ou un gène spécifique, souvent sans en manifester les symptômes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains patients peuvent être <w>porteurs</w> du virus sans développer la moindre maladie."
                        },
                        {
                            "text": "Elle a découvert qu'elle était <w>porteuse</w> d'une anomalie génétique héréditaire lors d'un test médical."
                        }
                    ],
                    "common_phrases": [
                        "porteur sain"
                    ]
                }
            ]
        }
    ]
