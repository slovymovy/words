                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2673d49e-d265-33e4-9825-adda4c6d5e99",
                                        "entry_id": "7a24d7ea-7bad-34fb-bd66-70cc7e6eb140",
                                        "glosses": [
                                            "A shotgun whose barrel(s) has been shortened for ease of concealment and to give a larger spread, though with more limited range (often for illegal purposes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211be05f-091f-4717-bae1-529570579ab9",
                                                "sense_id": "2673d49e-d265-33e4-9825-adda4c6d5e99",
                                                "text": "I never really got there / I just pretended that I had / Words are blunt instruments / Words are sawn-off shotguns"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a80d4c0-b17c-4716-b8ac-f8c700ba6a38",
