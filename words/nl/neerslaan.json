{
    "word_family": [
        "neerslag",
        "neerslaan-actie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27c4ad15-23ab-3861-b230-f93baa1825f8",
                    "sense_definition": "Iemand met een harde klap of slag op de grond doen vallen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bokser <w>sloeg</w> zijn tegenstander direct in de eerste ronde <w>neer</w>.",
                            "target_lang_translations": {
                                "en": "The boxer <w>knocked</w> his opponent <w>down</w> right in the first round."
                            }
                        },
                        {
                            "text": "Hij verdedigde zichzelf en <w>sloeg</w> de inbreker <w>neer</w> met een zwaar voorwerp.",
                            "target_lang_translations": {
                                "en": "He defended himself and <w>knocked</w> the burglar <w>down</w> with a heavy object."
                            }
                        }
                    ],
                    "synonyms": [
                        "vellen",
                        "neervellen"
                    ],
                    "common_phrases": [
                        "iemand neerslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To knock someone to the ground with a hard blow or strike."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock down",
                                "target_lang_sense_clarification": "to strike someone to the ground"
                            },
                            {
                                "target_lang_word": "knock out",
                                "target_lang_sense_clarification": "to render unconscious by a blow"
                            },
                            {
                                "target_lang_word": "floor",
                                "target_lang_sense_clarification": "to knock to the floor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cda48b9-c4a5-36d0-a328-b57c9847ccd3",
                    "sense_definition": "Met geweld een opstand, protest of verzet beëindigen en onderdrukken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderdrukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leger werd ingezet om de gewelddadige opstand hardhandig <w>neer</w> te <w>slaan</w>.",
                            "target_lang_translations": {
                                "en": "The army was deployed to brutally <w>suppress</w> the violent uprising."
                            }
                        },
                        {
                            "text": "De politie <w>sloeg</w> het protest binnen enkele uren <w>neer</w>.",
                            "target_lang_translations": {
                                "en": "The police <w>quelled</w> the protest within a few hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderdrukken",
                        "smoren",
                        "bedwingen"
                    ],
                    "common_phrases": [
                        "een opstand neerslaan",
                        "protesten neerslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To end and suppress an uprising, protest, or resistance by force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suppress",
                                "target_lang_sense_clarification": "to put an end to an uprising by force"
                            },
                            {
                                "target_lang_word": "quell",
                                "target_lang_sense_clarification": "to subdue or put down a rebellion or protest"
                            },
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to forcefully suppress opposition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb380b7c-f079-30fe-bff7-cc1ace2ad49d",
                    "sense_definition": "Het vormen van een vaste stof die uit een vloeistof of oplossing naar de bodem zakt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de chemische reactie <w>sloeg</w> er een witte stof <w>neer</w> op de bodem van het glas.",
                            "target_lang_translations": {
                                "en": "Due to the chemical reaction, a white substance <w>precipitated</w> at the bottom of the glass."
                            }
                        },
                        {
                            "text": "Het zout <w>slaat</w> snel <w>neer</w> als de temperatuur van de vloeistof daalt.",
                            "target_lang_translations": {
                                "en": "The salt <w>precipitates</w> quickly when the temperature of the liquid drops."
                            }
                        }
                    ],
                    "synonyms": [
                        "precipiteren",
                        "bezinken"
                    ],
                    "antonyms": [
                        "oplossen"
                    ],
                    "common_phrases": [
                        "als vaste stof neerslaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The formation of a solid substance that settles to the bottom from a liquid or solution."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "precipitate",
                                "target_lang_sense_clarification": "to form a solid from a solution in chemistry"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to sink to the bottom of a liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0cd606-2df2-3fe5-a7ff-59739f0a1d39",
                    "sense_definition": "Het condenseren van damp of vocht op een oppervlak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "condensatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waterdamp <w>slaat</w> direct <w>neer</w> op de koude ruiten van de auto.",
                            "target_lang_translations": {
                                "en": "The water vapor <w>condenses</w> immediately on the cold windows of the car."
                            }
                        },
                        {
                            "text": "In de vroege ochtend <w>slaat</w> de mist als dauw <w>neer</w> op het gras.",
                            "target_lang_translations": {
                                "en": "In the early morning, the mist <w>settles</w> as dew on the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "condenseren"
                    ],
                    "antonyms": [
                        "verdampen"
                    ],
                    "common_phrases": [
                        "als condens neerslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "The condensation of vapor or moisture onto a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "condense",
                                "target_lang_sense_clarification": "to turn from vapor into liquid on a surface"
                            },
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "of mist or dew, to deposit onto a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}