                "senses": [
                    {
                        "sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                        "entry_id": "7d617021-4c6d-39b6-a9a6-97f47298210c",
                        "glosses": [
                            "literarische und künstlerische Bewegung, unter dem Einfluss der Geschehnisse einsetzend während des 1. Weltkrieges, die sich gegen die bürgerliche Kultur stellt, um einen neuen Anfang zu ermöglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89143e7f-e08e-4e8e-8701-921a8b1ada5b",
                                "sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                                "text": "„Dada wurde im Frühjahr 1916 von den Herren Hugo Ball, Tristan Tzara, Hans Arp, Marcel Janko und Richard Huelsenbeck in einer kleinen Kneipe, dem ‚Cabaret Voltaire‘, gegründet.“"
                            },
                            {
                                "example_id": "1c35aecd-42ac-40fb-b6dd-bfc88b3c80ac",
                                "sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                                "text": "„Dada war nicht eine Kunstbewegung im herkömmlichen Sinn, es war ein Gewitter, das über die Kunst jener Zeit hereinbrach wie der Krieg über die Völker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45a5531d-cd88-4285-b884-611270b70a77",
                        "source_entry_id": "7d617021-4c6d-39b6-a9a6-97f47298210c",
                        "source_sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                        "source_sense_description": "literarische und künstlerische Bewegung nach dem 1. Weltkrieg",
                        "target_lang_word": "Dada",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dada",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                                        "entry_id": "0cde378c-5f3b-36f4-972b-ad528124dccd",
                                        "glosses": [
                                            "A cultural movement that began in Zürich, Switzerland during and as a reaction to World War I and peaked from 1916 to 1920, which primarily involved visual arts, literature (mainly poetry), theatre, and graphic design, and was characterized by deliberate irrationality, disillusionment, cynicism, nihilism, randomness, and rejection of the prevailing standards in art."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f719e833-f89b-41f6-a5ea-5d44d804ff54",
                                                "sense_id": "63302d01-90c7-3ae4-9c70-5eca7f8415f8",
                                                "text": "Ironically enough, it was the anti-war stirrings of Dada that bore out its most immediate influence, first in Switzerland and then post-war Berlin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9de3807-b221-4e45-8219-2babea4b17b3",
