                        "examples": [
                            {
                                "example_id": "4dfdef46-b0d7-408e-8152-78f5eec76d7e",
                                "sense_id": "72939194-f8be-343e-a9ca-caf323735239",
                                "text": "Des estancieros, vendeurs de cuir et de laine, allaient de long en large dans le couloir où donnait la cabine de Marcelle."
                            },
                            {
                                "example_id": "645b5c36-dfc5-4a32-8278-3cc3778cf408",
                                "sense_id": "72939194-f8be-343e-a9ca-caf323735239",
                                "text": "Les connaisseurs, eux, y verront surtout une superbe exposition architecturale funéraire du XIXᵉ siècle tant les panthéons familiaux, les caveaux de la haute bourgeoisie et les anciens estancieros richissimes s’y côtoient."
                            }
                        ]
                    }
