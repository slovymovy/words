                                        "entry_id": "f762e8e1-9e95-3ebc-a59d-a0b299d395aa",
                                        "glosses": [
                                            "Limited enthusiasm or affection; coolness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                        "entry_id": "f762e8e1-9e95-3ebc-a59d-a0b299d395aa",
                                        "glosses": [
                                            "The reciprocal of absolute temperature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9281f2d-f8b3-4c52-9c7d-6e021f68f997",
                                                "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                                "text": "The coldness is the reciprocal of absolute temperature."
                                            },
                                            {
                                                "example_id": "045fb662-0432-4686-8b1b-c12d62b71eb0",
                                                "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                                "text": "(article title) The coldness, a universal function in thermoelastic bodies."
                                            },
                                            {
                                                "example_id": "c9587203-699a-4705-a8f1-fa0256d8df77",
                                                "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                                "text": "This function will be called the coldness, its equilibrium value will be the reciprocal of absolute temperature."
                                            },
                                            {
                                                "example_id": "0e4c31fd-906c-4574-8b23-0d065613f53f",
                                                "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                                "text": "(article title) Coldness and Temperature."
                                            },
                                            {
                                                "example_id": "988662f2-46d9-4d0d-a08a-4bf5b21c94a7",
                                                "sense_id": "7c71931c-123e-3177-aacf-c62f85e59962",
                                                "text": "α is called the affinity, β the inverse temperature or coldness, and γ the free expansion coefficient."
                                            }
                                        ]
