                    {
                        "form_id": "b4404169-9251-4c78-9d0e-be5f2809a413",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Fuchtel"
                    },
                    {
                        "form_id": "aecd4848-e54f-4658-988f-7e7338dfb908",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fuchteln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7f47c9b-64b5-3a3e-a23d-c94d7dc44e41",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "breiter Degen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f30f32f6-2ea3-45f1-86a2-d229e24a50b3",
                                "sense_id": "c7f47c9b-64b5-3a3e-a23d-c94d7dc44e41",
                                "text": "„Mutig und unerschrocken, wie er war, ergriff er seine Fuchtel und fing an, im Dunkel wütend um sich zu hauen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf6ac55c-5d7c-301f-b393-6153283e9486",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "Bevormundung, Herrschaft"
                        ],
                        "tags": [
                            "colloquial",
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "99b4fe7e-f20f-38dd-99bb-11bbc1a69ef3",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "Bevormundung, Herrschaft",
                            "von jemandem bevormundet werden (ohne sich dagegen zu wehren)"
                        ],
                        "tags": [
                            "colloquial",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4b536db8-e08f-4c66-bfbc-2722eeb3204c",
                                "sense_id": "99b4fe7e-f20f-38dd-99bb-11bbc1a69ef3",
                                "text": "„Der Draufgänger und Lebenskünstler wurde unter ihrer Fuchtel – und der ihrer Mutter – offenbar zum zahmen Pantoffelhelden.“"
                            },
                            {
                                "example_id": "5b3ccb4d-0133-4dab-9f34-4d9efdeed713",
                                "sense_id": "99b4fe7e-f20f-38dd-99bb-11bbc1a69ef3",
                                "text": "„Ich exerzierte unter der Fuchtel von Unteroffizieren, die schwach vor Hunger und Bauchschmerzen waren und nur daran dachten, sich Brotkarten zu besorgen.“"
                            }
                        ],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "3f493590-da48-36a5-a1ac-b810bb5963b9",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "Bevormundung, Herrschaft",
                            "jemanden streng beaufsichtigen, über jemanden herrschen"
                        ],
                        "tags": [
                            "colloquial",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "367f5537-8e43-4c63-bce3-fdf37af9fad8",
                                "sense_id": "3f493590-da48-36a5-a1ac-b810bb5963b9",
                                "text": "„Die drei Frauen könnten den schwachen Alten mühelos entwaffnen; aber er hat sie unter der Fuchtel wie eben ein Feldwebel seine Rekruten.“"
                            }
                        ],
                        "sense_index_json": "\"2b\""
                    },
                    {
                        "sense_id": "c57f4412-19d9-376b-b467-bdb5cfbd682d",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "zänkische Frau, herrschsüchtige Frau"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0ca02e23-3812-3282-a722-d7572e44fb6c",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
                        "glosses": [
                            "Fackel"
                        ],
                        "tags": [
                            "kärntnerisch"
                        ],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "6ca9ce29-4356-3c58-b465-f61f87ebdbd3",
                        "entry_id": "a7e229f7-d70d-3672-9cfb-2f0d84aee494",
