                "senses": [
                    {
                        "sense_id": "aaa29755-214c-3d88-9422-024aef4895e1",
                        "entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "glosses": [
                            "A small opening or space between objects, especially adjacent objects or objects set closely together, such as between cords in a rope, components of a multiconductor electrical cable or atoms in a crystal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0effd2c8-58f2-44f7-bea9-40b805efac2d",
                                "sense_id": "aaa29755-214c-3d88-9422-024aef4895e1",
                                "text": "1887, Osborne Reynolds, Experiments showing Dilatancy, in Notices of the Proceedings, Volume 11, Royal Institution of Great Britain, page 360,\nThe tide leaves the sand, though apparently dry on the surface, with all its interstices perfectly full of water which is kept up to the surface of the sand by capillary attraction; at the same time the water is percolating through the sand from the sands above where the capillary action is not sufficient to hold the water. When the foot falls on this water-saturated sand it tends to change its shape, but it cannot do this without enlarging the interstices—without drawing in more water. This is a work of time, so that the foot is gone again before the sand has yielded."
                            }
                        ]
                    },
                    {
                        "sense_id": "961840dd-bb73-332a-9aea-401357c893f4",
                        "entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "glosses": [
                            "A fragment of space."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4676f8-4ec1-4a35-94e2-50971eae538f",
                                "sense_id": "961840dd-bb73-332a-9aea-401357c893f4",
                                "text": "Relics of the British empire now mostly survive in the interstices of the global economy. They are the major winners from the fiscal haemorrhage that has resulted from financial globalisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7932ed4-83be-3706-89dc-aa538b609a47",
                        "entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "glosses": [
                            "An interval of time required by the Roman Catholic Church between the attainment of different degrees of an order."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dd275975-4c19-39ab-9ca7-7cf0b2f677ea",
                        "entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "glosses": [
                            "A small interval of time free to be spent on activities other than one's primary goal."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f66e0ff6-86e7-4d02-afec-20f22a8af9a9",
                        "source_entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "source_sense_description": "small opening or space",
                        "target_lang_word": "tussenruimte",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tussenruimte",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2296aa3c-f785-3467-befd-56b6e3b98df4",
                                        "entry_id": "838d419f-db1b-323a-ac21-1d53fbaa1e28",
                                        "glosses": [
                                            "de ruimte die tussen twee zaken aanwezig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df4d1c0-4fa7-41b3-a53c-0f8f42616c0c",
                                                "sense_id": "2296aa3c-f785-3467-befd-56b6e3b98df4",
                                                "text": "In de jaren zestig sprak filosoof Michel Foucault over de heterotopie. Dat is een tussenruimte die ‘anders’ is: privaat noch publiek. Je kunt er niet zomaar binnen. Denk aan rusthuizen, gevangenissen, maar ook musea of begraafplaatsen."
                                            },
                                            {
                                                "example_id": "cd214013-d90a-4470-8700-5a11aea3e525",
                                                "sense_id": "2296aa3c-f785-3467-befd-56b6e3b98df4",
                                                "text": "5D had de taak om na de bestorming de tussenruimte tussen twee coupés veilig te stellen. Hij schoot daarbij op de toiletdeur, denkt hij. Wat de anderen uit zijn aanvalsgroep deden, wist hij niet. Naar eigen zeggen liep hij na de actie pas een coupé in, maar herinnert hij zich er weinig meer van: ,,Het is veertig jaar geleden. Ik weet dat het bloederig was in de kop van de trein, maar verder heb ik weinig herinneringen aan wat ik aantrof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a70e68-6d07-4dfe-bb66-ebebb18aae06",
                        "source_entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "source_sense_description": "small opening or space",
                        "target_lang_word": "opening",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opening",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "97849355-1c21-3f30-9bbe-58694f980337",
                                        "entry_id": "fba1ec02-4f50-3075-9792-ee235541f028",
                                        "glosses": [
                                            "een plaats die toegang biedt tot iets dat is afgesloten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c86c725-5bd3-46e5-aa2c-9089bdc5ed99",
                                                "sense_id": "97849355-1c21-3f30-9bbe-58694f980337",
                                                "text": "Door die opening komt veel kou binnen."
                                            },
                                            {
                                                "example_id": "d0b05811-0141-4172-b886-3b8f29748af8",
                                                "sense_id": "97849355-1c21-3f30-9bbe-58694f980337",
                                                "text": "In de opening van de keukendeur draait Lysbeth zich om naar haar nieuwe werkgeefster."
                                            },
                                            {
                                                "example_id": "4e393730-c354-4568-b5de-3d6cda18bf3d",
                                                "sense_id": "97849355-1c21-3f30-9bbe-58694f980337",
                                                "text": "'Mezelf? Wat weten jullie nou eigenlijk van mij? Helemaal niks!' Ik zie geen gezichten, alleen drie schaduwen die voor de opening van de ruïne staan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ecf4e8d-7538-3c5d-98c7-de7090d362e1",
                                        "entry_id": "fba1ec02-4f50-3075-9792-ee235541f028",
                                        "glosses": [
                                            "het openstellen van iets wat nog niet toegankelijk of in functie was"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab5f470-5245-4227-a7bc-f8218e7b320e",
                                                "sense_id": "4ecf4e8d-7538-3c5d-98c7-de7090d362e1",
                                                "text": "De opening van de nieuwe brug werd verricht door het doorknippen van een lint."
                                            },
                                            {
                                                "example_id": "dac5da85-d291-4947-8383-6cd070a52900",
                                                "sense_id": "4ecf4e8d-7538-3c5d-98c7-de7090d362e1",
                                                "text": "Op woensdag was ze er nog niet, maar Pamela en ik hadden het zo druk met de voorbereidingen voor de opening van de tentoonstelling dat ik geen tijd had om bij haar langs te gaan."
                                            },
                                            {
                                                "example_id": "e4360d15-553a-450b-b468-16d5bcb5437a",
                                                "sense_id": "4ecf4e8d-7538-3c5d-98c7-de7090d362e1",
                                                "text": "Presentator Omid Djalili kon het niet laten daar kort naar te verwijzen. \"Wat fijn dat u ons verkozen heeft boven de opening van het parlementaire jaar.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2bf6232-fdb0-4d30-9dfa-451d4eb19faa",
                        "source_entry_id": "bb4ae53b-c398-3b9f-86a3-f14e47153b63",
                        "source_sense_description": "small opening or space",
                        "target_lang_word": "interstice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interstice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                        "entry_id": "a3d3edd6-6f86-367c-bfd3-16e808f696c0",
                                        "glosses": [
                                            "Très petit intervalle d’espace laissé entre les parties d’un ensemble, d’un assemblage, d’un matériau, d’une matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d40a4b75-fcd0-4c6b-8e59-a23e8af2c9d7",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Un granit roussâtre, friable, connu dans le pays sous le nom de pierre pourrie, remplit ces divers interstices."
                                            },
                                            {
                                                "example_id": "fa80c07b-ff3f-4c5f-842d-411e45f893c7",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Enfin, je vis les premiers rayons du jour se glisser dans ma chambre à travers les interstices des jalousies ; […]"
                                            },
                                            {
                                                "example_id": "a3a8e136-7f3e-47e9-95e1-39ce4c5bd6bd",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Nous nous dirigeons vers l’interstice qui sépare les deux montagnes coniques vaguement entrevues hier."
                                            },
                                            {
                                                "example_id": "1286bdd8-a273-46b4-9092-2de5a71a6921",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Il distingua alors qu’il se trouvait dans un étroit réduit, et qu’une lumière diffuse venait des interstices des tuiles du toit."
                                            },
                                            {
                                                "example_id": "ba93fb88-8e10-4b62-a09a-b039e3158501",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Figurez-vous que lorsqu’ils téléphonent, tenant l’IPhone quelque part entre l’oreille et la joue, ils se coincent les cheveux et les poils de barbe dans l’interstice entre la vitre et le socle en aluminium. Et quand on veut se libérer, ça fait mal […]"
                                            },
                                            {
                                                "example_id": "9a61e111-99fc-46da-ae65-3f652e354c22",
                                                "sense_id": "3c946ffa-1a54-39ea-a009-85dc044e2e00",
                                                "text": "Hergé avait génialement baptisé du nom de Bordurie un pays des marges slaves. Les Grecs antiques donnaient le nom d’Eschatiai à ces espaces relégués d’où émane une radiation magique. Les bergers y menaient les bêtes. Démons et esprits y tenaient leurs quartiers. Une rencontre n’y était pas rare. Un faune ? Un dieu ? J’appelais ces lieux l’« interstice »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa138d18-6924-3186-b106-1a223ebcbd8b",
                                        "entry_id": "a3d3edd6-6f86-367c-bfd3-16e808f696c0",
                                        "glosses": [
                                            "Intervalle de temps."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be19a957-4a58-3bb4-a474-5e56f46a7132",
                                        "entry_id": "a3d3edd6-6f86-367c-bfd3-16e808f696c0",
                                        "glosses": [
                                            "En droit canonique, l’intervalle de temps que l’Église fait observer entre la réception de deux ordres sacrés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17814c41-b326-46a8-ab45-ffd531fc9c52",
                                                "sense_id": "be19a957-4a58-3bb4-a474-5e56f46a7132",
                                                "text": "Garder les interstices."
                                            },
                                            {
                                                "example_id": "951cb4ef-ac4d-4092-97a9-239f6d1ab43c",
                                                "sense_id": "be19a957-4a58-3bb4-a474-5e56f46a7132",
                                                "text": "Les interstices sont ordinairement de trois mois."
                                            },
                                            {
                                                "example_id": "3d3e183f-4bae-4359-8b90-cc587ed58f7f",
                                                "sense_id": "be19a957-4a58-3bb4-a474-5e56f46a7132",
                                                "text": "Dispenser des interstices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
