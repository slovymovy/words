                "senses": [
                    {
                        "sense_id": "36907a08-da63-35c2-9e80-f5b8d0b985fc",
                        "entry_id": "253ea87b-d251-3bbc-aee0-34be45ea9270",
                        "glosses": [
                            "Engin de génie civil combinant un chargeur sur pneus et une pelleteuse."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "5ded3e1b-474d-4783-be9f-0fbfd10a1fb5",
                                "sense_id": "36907a08-da63-35c2-9e80-f5b8d0b985fc",
                                "text": "Un paysan du Larzac fit monter le futur président dans la benne de son tractopelle et l’éloigna de la foule."
                            },
                            {
                                "example_id": "31b635ad-50b2-4d55-a9c3-090683e07a30",
                                "sense_id": "36907a08-da63-35c2-9e80-f5b8d0b985fc",
                                "text": "La tractopelle a été fortement sollicité pour les déplacements de rails, essieux, berlines, châssis, etc."
                            },
                            {
                                "example_id": "f7727c15-dd93-4801-8219-43fded5cb3d8",
                                "sense_id": "36907a08-da63-35c2-9e80-f5b8d0b985fc",
                                "text": "Et un beau jour, les tractopelles et les engins de chantier étaient arrivés sur les friches léguées par Ettore."
                            }
                        ]
                    }
                ],
