{
    "word_family": [
        "brief",
        "brevity",
        "briefing"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                    "sense_definition": "For a short period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We met <w>briefly</w> for coffee before going to work.",
                            "target_lang_translations": {
                                "ru": "Мы <w>ненадолго</w> встретились выпить кофе перед работой.",
                                "zh": "上班前我们<w>短暂地</w>碰面喝了杯咖啡。"
                            }
                        },
                        {
                            "text": "The sun came out <w>briefly</w> in the afternoon, but then it started raining again.",
                            "target_lang_translations": {
                                "ru": "Днем <w>ненадолго</w> выглянуло солнце, но потом снова пошел дождь.",
                                "zh": "下午太阳<w>短暂地</w>露了下脸，但随后又开始下雨了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "temporarily",
                        "fleetingly",
                        "transiently",
                        "for a short time"
                    ],
                    "common_phrases": [
                        "met briefly",
                        "spoke briefly",
                        "stopped briefly"
                    ],
                    "target_lang_definitions": {
                        "ru": "На короткое время; недолго.",
                        "zh": "指持续时间很短。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недолго",
                                "target_lang_sense_clarification": "о продолжительности"
                            },
                            {
                                "target_lang_word": "ненадолго",
                                "target_lang_sense_clarification": "на короткое время"
                            },
                            {
                                "target_lang_word": "коротко",
                                "target_lang_sense_clarification": "быстро"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短暂地",
                                "target_lang_sense_clarification": "指时间持续很短"
                            },
                            {
                                "target_lang_word": "一会儿",
                                "target_lang_sense_clarification": "口语中表示时间短"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                    "sense_definition": "In a concise manner; using few words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please explain <w>briefly</w> why you think you are suitable for this job.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, объясните <w>кратко</w>, почему вы считаете, что подходите для этой работы.",
                                "zh": "请<w>简短地</w>解释一下你为什么认为自己适合这份工作。"
                            }
                        },
                        {
                            "text": "The author describes <w>briefly</w> the history of the ancient city in the first chapter.",
                            "target_lang_translations": {
                                "ru": "В первой главе автор <w>кратко</w> описывает историю древнего города.",
                                "zh": "作者在第一章中<w>简短地</w>描述了这座古城的历史。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concisely",
                        "summarily"
                    ],
                    "common_phrases": [
                        "describe briefly",
                        "explain briefly",
                        "stated briefly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжато, используя немного слов; лаконично.",
                        "zh": "指言简意赅，用词精炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кратко",
                                "target_lang_sense_clarification": "лаконично"
                            },
                            {
                                "target_lang_word": "вкратце",
                                "target_lang_sense_clarification": "в общих чертах"
                            },
                            {
                                "target_lang_word": "коротко",
                                "target_lang_sense_clarification": "немногословно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简短地",
                                "target_lang_sense_clarification": "指说话或写作简洁"
                            },
                            {
                                "target_lang_word": "概括地",
                                "target_lang_sense_clarification": "指总结性地说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                    "sense_definition": "Used to introduce a summary or a short explanation of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Briefly</w>, the plan is to reduce costs by optimizing our supply chain.",
                            "target_lang_translations": {
                                "ru": "<w>Короче говоря</w>, план состоит в том, чтобы сократить расходы за счет оптимизации нашей цепочки поставок.",
                                "zh": "<w>简而言之</w>，该计划旨在通过优化供应链来降低成本。"
                            }
                        },
                        {
                            "text": "To put it <w>briefly</w>, the project was a huge success despite the initial problems.",
                            "target_lang_translations": {
                                "ru": "Если говорить <w>кратко</w>, проект имел огромный успех, несмотря на первоначальные проблемы.",
                                "zh": "<w>简而言之</w>，尽管起初遇到了一些问题，但该项目还是取得了巨大的成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "in short",
                        "to sum up",
                        "in a word",
                        "in summarization"
                    ],
                    "common_phrases": [
                        "put briefly",
                        "stated briefly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения итога или краткого объяснения.",
                        "zh": "用于引出总结或简要说明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короче говоря",
                                "target_lang_sense_clarification": "вводная фраза"
                            },
                            {
                                "target_lang_word": "вкратце",
                                "target_lang_sense_clarification": "резюмируя"
                            },
                            {
                                "target_lang_word": "кратко",
                                "target_lang_sense_clarification": "одним словом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简而言之",
                                "target_lang_sense_clarification": "用于总结陈述"
                            },
                            {
                                "target_lang_word": "总之",
                                "target_lang_sense_clarification": "用于概括要点"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}