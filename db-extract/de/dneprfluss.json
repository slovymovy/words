                ],
                "senses": [
                    {
                        "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                        "entry_id": "2e3e0d5e-72e0-3862-b9a2-d47b620f97c0",
                        "glosses": [
                            "Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af191fe6-0d85-484d-8a65-99da06d2cf66",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„Die links (hier: östlich) der Fließrichtung des Dneprflusses gelegenen Gebiete des Wilden Felds fallen ab 1667/1686 dauerhaft an Russland.“"
                            },
                            {
                                "example_id": "fd58defc-8d4a-467a-9c69-9ab71f33a783",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„Nach Constantinos Porphyrogennetos hatten die Unternehmer der Handelsfahrten auf dem Dneprfluss und auf dem schwarzen Meer ihre Heimat ausserhalb des Fürstenthums Kiew, welches er als Russland im engeren Sinn bezeichnet, und zwar in Nowgorod, Smolensk, Lubetsch, Tschernigow, Wyschegrad; aber Kiew war der Sammelplatz der Flotte.“"
                            },
                            {
                                "example_id": "50e443c2-6c86-47d4-8f75-ce21532b5239",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„Denn es war den Tataren in ihren Steppen nicht wohl beizukommen, so lange man sich nicht der Mündungen des Don und des Dneprflusses bemächtigt hatte.“"
                            },
                            {
                                "example_id": "5b5f47a0-4f45-4873-87ff-d6ea771f8924",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„An dem Dneprfluss gab es sieben gefährliche Stromschnellen, die die Waräger überqueren mussten, um das byzantinische Kaiserreich zu erreichen.“"
                            },
                            {
                                "example_id": "98d738fd-7fbf-4806-9ec3-e584c0c7971b",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„Der Kiewer Großfürst Wladimir heiratete die Schwester des byzantinischen Kaisers Basileios II. und musste dafür nach byzantinischem Ritus christlich getauft werden. Er erklärte das Christentum zur Staatsreligion und es kam im Jahr 988 zur besagten Massentaufe im Dneprfluss.“"
                            },
                            {
                                "example_id": "17d1f82d-5b37-4a99-bb2c-c9bac169cfac",
                                "sense_id": "daab0cca-8fe4-3910-8783-a96c4a42412b",
                                "text": "„Von der Wolga westlich bis zum Dneprflusse breitete sich das Reich der Chasaren aus […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
