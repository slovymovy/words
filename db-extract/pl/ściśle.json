                        "translation_id": "93e7335e-7d5f-420b-b947-3b6a91e5dbb2",
                        "source_entry_id": "6beef00a-da97-3b60-a46a-de04b2ebccab",
                        "source_sense_id": "a6bb6676-fc9f-3e95-a529-f9bb7c22f81e",
                        "target_lang_word": "strictly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strictly",
