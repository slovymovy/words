                    {
                        "sense_id": "9d52bc1b-1fbb-3c0c-b801-559eb73d81af",
                        "entry_id": "e7189a02-e0f6-3d5c-a8b1-f738db5bcec2",
                        "glosses": [
                            "gebied waarin iets of iemand het voor het zeggen heeft (bijv. staatsdomein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a35c545-0e44-4695-a037-d102ad3f1708",
                                "sense_id": "9d52bc1b-1fbb-3c0c-b801-559eb73d81af",
                                "text": "Voor degenen die Aviceford Manor niet kennen: het is het kleinste van de drie landgoederen op de uitgestrekte domeinen van Ellis Abbey. Abdis Elfilda (inderdaad, de peettante van prinses Elfilda) had Emont Vis-de-Loup, de jongste zoon van lord Henry Vis-de-Loup, de vierde baron van Wilston, aangesteld als ambachtsheer van Aviceford."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d00fc19-95be-384d-a765-05bf44766901",
                        "entry_id": "e7189a02-e0f6-3d5c-a8b1-f738db5bcec2",
                        "glosses": [
                            "gebied waarin mensen gewoon zijn te vertoeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0db6a8a-ce31-4698-bc52-1c01b27d4d65",
                                "sense_id": "4d00fc19-95be-384d-a765-05bf44766901",
                                "text": "Twente is het domein van de Tukkers."
                            },
                            {
                                "example_id": "2efc3190-5533-4087-a32e-b543599e75d2",
                                "sense_id": "4d00fc19-95be-384d-a765-05bf44766901",
                                "text": "De tuin is zijn domein en hij is er vaak te vinden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff5335b6-54bd-3d0f-ad3d-3da478887ffa",
                        "entry_id": "e7189a02-e0f6-3d5c-a8b1-f738db5bcec2",
                        "glosses": [
                            "geestelijk gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3aac06-9ac5-48ad-8db5-b0cdf74b7526",
                                "sense_id": "ff5335b6-54bd-3d0f-ad3d-3da478887ffa",
                                "text": "In het domein van de discrete wiskunde is hij een kei, maar verder weet hij niet veel."
                            },
                            {
                                "example_id": "a0781d54-1a57-4244-8e16-093926d316a8",
                                "sense_id": "ff5335b6-54bd-3d0f-ad3d-3da478887ffa",
                                "text": "De stemmen waren er nog steeds, maar ergens onderweg van de slaapkamer naar de bank had haar geest enigszins houvast op haar eigen domein kunnen krijgen."
                            },
                            {
                                "example_id": "69d3a958-9a62-44e9-a64b-714feae6e3cd",
                                "sense_id": "ff5335b6-54bd-3d0f-ad3d-3da478887ffa",
                                "text": "Haar gebaren waren zeker, ze was vol zelfvertrouwen, want dit was haar domein waarin alles mogelijk was."
                            }
                        ]
                    },
                    {
                        "sense_id": "59c14c33-6965-3f39-a100-251b6e0ea8d4",
                        "entry_id": "e7189a02-e0f6-3d5c-a8b1-f738db5bcec2",
                        "glosses": [
