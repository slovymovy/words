                                        "glosses": [
                                            "zwei oder mehr Atome in einem abgeschlossenen Verband, die durch eine kovalente Bindung miteinander verknüpft sind"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
