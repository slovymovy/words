                    {
                        "translation_id": "2abae3ef-7be8-4bdf-811c-9eeecb4964e1",
                        "source_entry_id": "fc587ef3-67f3-3b18-8f9d-ad669aa44283",
                        "source_sense_id": "697e2782-5d7f-3e4d-9fe9-f54abf38271d",
