                                "target_senses": [
                                    {
                                        "sense_id": "c7411af4-7d5c-3296-b0fa-2b7f1fd4eb26",
                                        "entry_id": "bcd3cbc9-fe0c-3d1f-8bca-41f69a389716",
                                        "glosses": [
                                            "gleichartiges Gemisch; spezielle Zusammenstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c233e55d-ab51-4686-acbd-50d58b94d325",
                                                "sense_id": "c7411af4-7d5c-3296-b0fa-2b7f1fd4eb26",
                                                "text": "Zu Ostern ist der Osterteller ein Mix aus süßen und sauren Leckereien."
                                            },
                                            {
                                                "example_id": "b1e6a5dd-5b9b-456c-b916-6ba82d0bb8a2",
                                                "sense_id": "c7411af4-7d5c-3296-b0fa-2b7f1fd4eb26",
                                                "text": "„Auf dem Beistelltisch stehen bereits Kaffeetassen und Kuchenteller bereit, ein Mix aus geblümtem und rein weißem Geschirr.“"
                                            },
                                            {
                                                "example_id": "0dadb336-bd23-49fa-9cdc-a57c1b931073",
                                                "sense_id": "c7411af4-7d5c-3296-b0fa-2b7f1fd4eb26",
                                                "text": "„Die Texte, auf denen die Sammlung basierte, waren wohl ein Mix aus bereits gedruckten Stücken sowie Soufflierbüchern, Arbeitsentwürfen und Autorenmanuskripten, die heute alle verloren sind .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mix",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efdba910-b4c5-33f9-b1a2-21f509f2107e",
                                        "entry_id": "4b4b712c-bdf5-3f5c-b963-230ca3f99024",
                                        "glosses": [
