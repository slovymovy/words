                ],
                "senses": [
                    {
                        "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                        "entry_id": "f5156d7e-1182-34b0-a86f-06d1c37f4385",
                        "glosses": [
                            "vorderes Ende einer Eisenbahnfahreinheit"
                        ],
                        "tags": [
                            "Verkehr",
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5747b5-d129-4c9c-933b-36fe1ddb579c",
                                "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                                "text": "„In der Schweiz wird die Zugspitze mit einem Dreilichtsignal gekennzeichnet.“"
                            },
                            {
                                "example_id": "71dbaff1-82bc-4ce8-9549-2af7e6db7579",
                                "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                                "text": "„Diese Uhr zeigt genau 12 Uhr erst dann an, wenn die Zugspitze 50 Meter weiter ist.“"
                            },
                            {
                                "example_id": "3f0e3ba6-b71c-4ab0-a8af-659956f7bbe9",
                                "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                                "text": "„Beim Schieben eines Zuges muß sich ein Betriebsbediensteter an der Zugspitze befinden, der die Fahr- und Warnsignale geben und die Bremse bedienen kann; diese Signale können auch von einem außerhalb des Zuges an der Zugspitze befindlichen Bediensteten gegeben werden.“"
                            },
                            {
                                "example_id": "4bfeb28f-2a6c-4980-af1e-1f63ebf77a9e",
                                "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                                "text": "„An Zugspitze und Zugende gibt es bei den Fahrerkabinen für Rollstuhlfahrer gut zugängliche Mehrzweckbereiche.“"
                            },
                            {
                                "example_id": "5158d7f0-11bc-4e37-9869-edd66bcfc328",
                                "sense_id": "b472f37e-dfb4-3fd1-9453-b9add2eee9c0",
                                "text": "„Er hätte daher nur mit Schrittgeschwindigkeit bis zur Zugspitze vorfahren dürfen, um seinen nicht ausreichenden Sichtverhältnissen nach links Rechnung zu tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df4104ad-ae1f-434f-846d-1faab1be5cbd",
                        "source_entry_id": "f5156d7e-1182-34b0-a86f-06d1c37f4385",
