                "senses": [
                    {
                        "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                        "entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                        "glosses": [
                            "женск. к обманщик; женщина, которая обманула или обманывает кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa0c038-4510-46ed-b39e-9e2fd8f8db57",
                                "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                                "text": "Вспомнила и горько заплакала. ― Обманщица! Лгунья!"
                            },
                            {
                                "example_id": "b5c58063-3dc3-49f3-8f3f-66af58a6e973",
                                "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                                "text": "Хххххх, милая, здравствуй! Ну и обманщица же ты. Обещала позвонить и не позвонила."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "907b02ce-902a-430f-b7f1-51fd9de64b74",
                        "source_entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                        "source_sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                        "target_lang_word": "deceiver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e959e8c-d8b5-323a-9c02-6126ee4c43a7",
                                        "entry_id": "3997b093-20d4-3704-9ffb-1bdf619749af",
                                        "glosses": [
                                            "A person who lies or deceives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9101ee6-45b7-4675-91fe-7d4edf2fc17c",
                                                "sense_id": "8e959e8c-d8b5-323a-9c02-6126ee4c43a7",
                                                "text": "My memory my fond deceiver / Is turning all my past into pain / While I'm being raped by progress / Tomorrow's world is here to stay"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0717838-992f-394f-8191-e03e827be334",
                                        "entry_id": "3997b093-20d4-3704-9ffb-1bdf619749af",
                                        "glosses": [
                                            "Another name for Satan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e12162b-16d7-4243-894f-f4540733014b",
                        "source_entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                        "source_sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
