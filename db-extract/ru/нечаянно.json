                                                "example_id": "f389f050-27e2-4120-8bb5-8da69d3b9724",
                                                "sense_id": "488fbdc3-62b3-3999-b514-273f7d035d8b",
                                                "text": "Er hat versehentlich die Hupe betätigt."
                                            },
                                            {
                                                "example_id": "731825a2-f18a-4219-9eff-64f81a0ed3de",
                                                "sense_id": "488fbdc3-62b3-3999-b514-273f7d035d8b",
                                                "text": "„Dabei rammte er mir versehentlich seinen kleinen Finger ins rechte Auge, und ich konnte nichts mehr sehen, weil mir sofort die Tränen in die Augen schossen.“"
                                            },
                                            {
                                                "example_id": "711bd40d-0dbb-498f-9690-5b25ccf2b07d",
                                                "sense_id": "488fbdc3-62b3-3999-b514-273f7d035d8b",
                                                "text": "Ein versehentliches Löschen der Datei sollte eigentlich nicht möglich sein."
