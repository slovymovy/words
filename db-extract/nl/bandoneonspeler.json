                        "examples": [
                            {
                                "example_id": "8a0f394f-17a8-4ec0-ae8b-6fdf261beb0c",
                                "sense_id": "3f3c965c-4063-3679-9db8-298d41c76dbd",
                                "text": "Aansluitend vond de kerkelijke huwelijksinzegening plaats in de Nieuwe Kerk in Amsterdam. Wereldberoemd werden de beelden van de tranen van Máxima, toen bandoneonspeler Carel Kraayenhof de tango 'Adios Nonino' speelde."
                            },
                            {
                                "example_id": "8f91211e-9d55-427d-90b1-b70e8e847bd3",
                                "sense_id": "3f3c965c-4063-3679-9db8-298d41c76dbd",
                                "text": "Het fragment van de bruiloft van prins Willem-Alexander en Máxima dat iedereen zich kan herinneren, staat nu bekend als 'de traan'. Bandoneonspeler Carel Kraayenhof speelt tijdens de kerkelijke inzegening in de Nieuwe Kerk in Amsterdam zijn vertolking van Adiós Nonino, waarbij Máxima het niet droog kan houden."
                            }
                        ]
                    }
