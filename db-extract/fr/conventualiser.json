                        "glosses": [
                            "Donner un caractère conventuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4224ce29-7a91-47df-9358-9e4bb8b84e38",
                                "sense_id": "36d9bb60-988b-37b7-8a7b-ca040ca87473",
                                "text": "Pourtant l’évolution générale de l’ordre était déjà commencée depuis 1224, lorsque frère Élie, vicaire général de saint François, se mit résolument à le « cléricaliser » et à le « conventualiser » à l’instar des Prêcheurs."
                            },
                            {
                                "example_id": "620adb45-96de-446c-addf-1f5a82211d3d",
                                "sense_id": "36d9bb60-988b-37b7-8a7b-ca040ca87473",
                                "text": "Nous vous croyions encore à conventualiser, à monacaliser, par monts et par vauds."
                            }
                        ]
                    }
