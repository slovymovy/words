                                    {
                                        "sense_id": "f32a69c7-2338-3cc4-8a55-6dda0cb5560b",
                                        "entry_id": "3b16375d-e84b-3425-bd11-2282bc4e98f4",
                                        "glosses": [
                                            "Able to be treated; not incurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088e5de5-d5f9-468b-b036-721064b8a9e0",
                                                "sense_id": "f32a69c7-2338-3cc4-8a55-6dda0cb5560b",
                                                "text": "In the 1980s, AIDS was not a treatable disease, and as a consequence the mortality rate at that time was very high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ddad5c4-9ab9-3b14-97f5-3b3c61fc6f80",
