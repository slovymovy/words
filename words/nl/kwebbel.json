                        },
                        {
                            "text": "Hij kon zijn <w>kwebbel</w> niet houden en verklapte het geheim.",
                            "target_lang_translations": {
                                "en": "He couldn't keep his <w>yap</w> shut and blurted out the secret."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hou je kwebbel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and slightly rude"
                        }
                    ],
