                                        "sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                                        "entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                                        "glosses": [
                                            "freiwilliger Zusammenschluss von Arbeitern im zaristischen Russland"
