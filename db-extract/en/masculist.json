                            "comparative"
                        ],
                        "form": "more masculist"
                    },
                    {
                        "form_id": "f05a1a06-45d5-4dd4-8452-87c6c64b47ea",
                        "entry_id": "cf378ebc-d31a-3b20-a0b8-0351c9d4e320",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most masculist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f356981-7f6c-3db3-a5d3-755cde45ca6e",
                        "entry_id": "cf378ebc-d31a-3b20-a0b8-0351c9d4e320",
                        "glosses": [
                            "Of or relating to masculism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "571a92fe-d77d-45bd-97d4-98801cbed3e3",
                        "source_entry_id": "cf378ebc-d31a-3b20-a0b8-0351c9d4e320",
                        "source_sense_id": "7f356981-7f6c-3db3-a5d3-755cde45ca6e",
                        "source_sense_description": "masculist",
                        "target_lang_word": "masculiniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masculiniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d040abf-d7fa-300c-9efc-659cdd784dd8",
                                        "entry_id": "74941ffd-389e-3a79-a3ea-2ba612388673",
                                        "glosses": [
                                            "Partisan du retour du pouvoir pour les hommes, qui l’auraient perdu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770ed587-3228-489f-b707-0544948f3d4a",
                                                "sense_id": "0d040abf-d7fa-300c-9efc-659cdd784dd8",
                                                "text": "La féministe et le masculiniste se sont pourtant retrouvés du même côté de la table à défendre la pertinence d’appliquer la garde partagée systématiquement dans les cas de séparation."
                                            },
                                            {
                                                "example_id": "dbed21b0-d9c1-4e54-adcd-5831719d7681",
                                                "sense_id": "0d040abf-d7fa-300c-9efc-659cdd784dd8",
                                                "text": "Il est grand temps de relever la tête ! les masculinistes sont là pour réaffirmer la fierté d’être un homme, face aux harpies féministes. Lacroix a bien raison : ces viragos nous gâchent la vie."
                                            },
                                            {
                                                "example_id": "875d8cdb-04d0-442f-a3d6-886d57992e98",
                                                "sense_id": "0d040abf-d7fa-300c-9efc-659cdd784dd8",
                                                "text": "30 ans après la tuerie de l'École polytechnique de Montréal, les incels et masculinistes nord-américains continuent de mener des raids meurtriers qui visent particulièrement les femmes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "masculiniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b370f09c-882c-3099-a541-6e09be2bf030",
                                        "entry_id": "63dc3de1-d236-374e-83fb-6cd5c6d0c493",
                                        "glosses": [
                                            "Se dit de quelqu’un ou quelque chose partisan du masculinisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a8adb6-4049-4f76-82d3-50167ff692b3",
                                                "sense_id": "b370f09c-882c-3099-a541-6e09be2bf030",
                                                "text": "Dans un cycle vicieux, il développe une anthropologie théologique qui souligne la distance entre le masculin et le féminin afin de soutenir une christologie masculiniste et il fait appel à un langage symbolique où le féminin s’attache davantage à la Vierge Marie qu’à son fils."
                                            },
                                            {
                                                "example_id": "bf7eddd7-48fa-4373-ae4d-84edac1227e0",
                                                "sense_id": "b370f09c-882c-3099-a541-6e09be2bf030",
                                                "text": "Le discours masculiniste circule d’un pays à l’autre : plusieurs pages dénoncent le triomphe du féminisme radical, du multiculturalisme et de la féminisation de l’homme occidental dans le manifeste de l’assassin d’Oslo, Anders Behring Breivik […]."
                                            },
                                            {
                                                "example_id": "c219dd6c-cb6d-42f9-b3a2-5ae488698727",
                                                "sense_id": "b370f09c-882c-3099-a541-6e09be2bf030",
                                                "text": "Les performances des Hommen lors de la Manif pour tous avaient déjà mis en évidence la tension qui pouvait émerger de cette affirmation masculiniste chez des catholiques pris entre une masculinité domestiquée et une tentation viriliste, au risque de basculer vers un modèle populaire trop fondé sur le capital corporel brut, ou, en mettant en avant le culte du corps masculin, vers des modèles issus des subcultures gaies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
