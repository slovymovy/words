    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e655c58-639d-3b16-bc20-b2e92bcfa817",
                    "sense_definition": "Fait de progresser, développement ou état d'un projet, d'un travail ou d'une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "progres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a demandé un rapport complet sur l'<w>avancement</w> du projet."
                        },
                        {
                            "text": "L'<w>avancement</w> des travaux sur le pont a été ralenti par les intempéries."
                        }
                    ],
                    "common_phrases": [
                        "état d'avancement",
                        "degré d'avancement"
                    ]
                },
                {
                    "sense_id": "dcb72c91-4323-3c3d-b450-86f5ea58226d",
                    "sense_definition": "Progression dans une hiérarchie professionnelle, obtention d'un grade supérieur ou de meilleures fonctions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années d'efforts, elle a enfin obtenu un bel <w>avancement</w> au sein de l'entreprise."
                        },
                        {
                            "text": "Dans cette administration, l'<w>avancement</w> se fait principalement selon l'ancienneté."
                        }
                    ],
                    "synonyms": [
                        "promotion"
                    ],
                    "common_phrases": [
                        "obtenir un avancement",
                        "avancement à l'ancienneté"
                    ]
                },
                {
                    "sense_id": "8f18b6c2-c8c9-33c3-811e-ab3dc84c5424",
                    "sense_definition": "Partie d'une construction qui fait saillie ou s'étend vers l'avant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est abrité de la pluie battante sous l'<w>avancement</w> du toit."
                        },
                        {
                            "text": "L'<w>avancement</w> de la façade crée une zone d'ombre très appréciable en été."
                        }
                    ],
                    "common_phrases": [
                        "avancement du toit"
                    ]
                },
                {
                    "sense_id": "d35734c3-9cf8-3a47-ae8a-be6ab1ea9950",
                    "sense_definition": "Donation consentie à un héritier par anticipation sur sa part successorale future.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents lui ont fait donation d'un terrain en <w>avancement</w> de sa part d'héritage."
                        },
                        {
                            "text": "Ce don financier consenti de leur vivant a été enregistré comme un <w>avancement</w> d'hoirie lors de la succession."
                        }
                    ],
                    "common_phrases": [
                        "avancement d'hoirie",
                        "en avancement de part"
                    ]
                }
            ]
        }
    ]
