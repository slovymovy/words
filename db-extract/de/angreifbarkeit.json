                        ]
                    },
                    {
                        "translation_id": "47e85565-ba25-4d5f-9088-8eed853b23b6",
                        "source_entry_id": "a03504fe-7081-3a95-bae7-2e315c1d1081",
                        "source_sense_id": "8b3534a4-03d7-3315-9ddc-51f4939e06cf",
                        "source_sense_description": "Eigenschaft/Möglichkeit angegriffen werden zu können",
                        "target_lang_word": "vulnerability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulnerability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "The state of being vulnerable; susceptibility to attack or injury, either physical or emotional; the state or condition of being weak or poorly defended."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033a5f42-4db2-4b1b-bf8b-77d3021be624",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "The country recognized their defence vulnerability after an airplane landed in front of the central square without any consequences."
                                            },
                                            {
                                                "example_id": "57c4897e-ef3b-4500-96a6-1a1f33def1e2",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "Though scientists do not know how stress affects gestation, Fukuda theorizes that the vulnerability of Y-bearing sperm cells, male embryos and/or male fetuses to stress is why “subtle significant changes in sex ratios” occur."
                                            },
                                            {
                                                "example_id": "3312c718-2bde-4e94-a6dc-e1cce93d5b2b",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "Again, voice change is not easy and vulnerability plays a big part, but if choral teachers and adolescent singers approach it with the right mindframe, the experience can be empowering, enlightening, and restorative for all involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28c4723-1864-3b5b-9e94-b0082d6763c3",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "A specific weakness in the protections or defences surrounding someone or something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dca002a7-eddc-3b56-9bb8-87d7eae5378c",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "A weakness which allows an attacker to reduce a system's security."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e82f56-7929-4e88-9a21-b66f51de154b",
                                                "sense_id": "dca002a7-eddc-3b56-9bb8-87d7eae5378c",
                                                "text": "Experts told CNN it could take weeks to address the vulnerabilities and that suspected Chinese hackers are already attempting to exploit it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
