    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4468ab2d-ce91-34c4-ad6a-e628c4ffc8f6",
                    "sense_definition": "Parler à voix basse et de façon confuse, entre ses dents, rendant les paroles difficiles à comprendre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole_indistincte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est mis à <w>marmonner</w> entre ses dents sans que l'on comprenne un mot de sa réponse."
                        },
                        {
                            "text": "Le vieil homme marchait seul dans l'allée en continuant de <w>marmonner</w> une prière oubliée."
                        }
                    ],
                    "synonyms": [
                        "marmotter"
                    ],
                    "common_phrases": [
                        "marmonner entre ses dents",
                        "marmonner dans sa barbe",
                        "marmonner une réponse"
                    ]
                },
                {
                    "sense_id": "7b2e2c6a-195e-3768-bece-0ae067306312",
                    "sense_definition": "Murmurer sourdement pour exprimer sa mauvaise humeur, sa colère ou son mécontentement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole_indistincte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Furieux d'avoir perdu le match, il a commencé à <w>marmonner</w> des reproches contre l'arbitre."
                        },
                        {
                            "text": "L'adolescent quitta la pièce en colère tout en faisant mine de <w>marmonner</w> des insultes inaudibles."
                        }
                    ],
                    "synonyms": [
                        "grommeler"
                    ],
                    "common_phrases": [
                        "marmonner de colère",
                        "marmonner des reproches"
                    ]
                }
            ]
        }
    ]
