                        "cross_references": [
                            {
                                "target_word": "équilibré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd98de80-9f15-3af3-940a-72aab684d10e",
                                        "entry_id": "321a8802-d7a8-32bd-b5cb-8d41a0f64315",
                                        "glosses": [
                                            "Qualifie un esprit dont les facultés sont dans un juste rapport."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02725c2f-6ca3-33fd-91d3-833a3e9c83c1",
                                        "entry_id": "321a8802-d7a8-32bd-b5cb-8d41a0f64315",
                                        "glosses": [
                                            "Qui montre un équilibre entre ses différentes caractéristiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c4da63-78bd-45a6-8c56-ac28edfc50d2",
                                                "sense_id": "02725c2f-6ca3-33fd-91d3-833a3e9c83c1",
                                                "text": "Reste l’art et la manière d’en faire une merveille aérienne et équilibrée, ce que la pâtissier Michel Bartocetti, beau boss sucré d’une légende parisienne, le George V, ne rechigne pas à partager."
                                            },
                                            {
                                                "example_id": "535c7e3b-5a21-43f9-a669-2b53e034e896",
                                                "sense_id": "02725c2f-6ca3-33fd-91d3-833a3e9c83c1",
                                                "text": "Au cours des différents repas de la journée, je favorisais des assiettes équilibrées, variées et très colorées, avec un penchant pour les légumes verts qui sont super-riches en fibres, en vitamines, en fer…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "équilibré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da54cd43-54a7-302b-a4fc-0f56dced6707",
                                        "entry_id": "d4944005-02e1-31b5-84b3-490d11fdcf61",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe équilibrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8f567c7-8b6a-4d63-9216-6e700e76cd10",
                                                "sense_id": "da54cd43-54a7-302b-a4fc-0f56dced6707",
                                                "text": "Une pénalité de Hugo Reus a récompensé la bonne période française mais le match s’est équilibré et John Devine a redonné l’avantage aux siens avec un essai transformé par Sam Prendergast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5dcbd4a-af53-4138-a7ce-900320b1115a",
                        "source_entry_id": "3cbdb810-524f-35cc-bf6d-0d234e956326",
                        "source_sense_id": "6ce8ab0f-d172-3b30-ab8f-f69ccbfebfcb",
                        "source_sense_description": "even",
                        "target_lang_word": "сбалансированный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сбалансированный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e8420774-70c2-31a0-a18d-b61861ebbd4c",
                                        "entry_id": "4f1a703b-395e-3c88-8ef5-625493b30299",
                                        "glosses": [
                                            "страд. прич. прош. вр. от сбалансировать"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c9978e-dd66-4507-93fe-107e7f59fd47",
                                                "sense_id": "e8420774-70c2-31a0-a18d-b61861ebbd4c",
                                                "text": "Скутер так хорошо сбалансирован, что находится в воде в состоянии гидростатического равновесия, т. е. имеет нулевую плавучесть."
                                            },
                                            {
                                                "example_id": "16faefec-6dbe-4564-9ef7-f79fa68da96c",
                                                "sense_id": "e8420774-70c2-31a0-a18d-b61861ebbd4c",
                                                "text": "Прекрасная немецкая машина. Видите ― с противовесами, всё сбалансировано."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6dfdd35-19b3-3ecc-98c1-57efe0833670",
                                        "entry_id": "4f1a703b-395e-3c88-8ef5-625493b30299",
                                        "glosses": [
                                            "статив. книжн. с правильным соотношением между доходами и расходами (о бюджете)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d851e6f8-6297-4677-928a-5b7b9a44acbb",
                                                "sense_id": "c6dfdd35-19b3-3ecc-98c1-57efe0833670",
                                                "text": "Сбалансированный бюджет – один из основополагающих принципов формирования и исполнения бюджета, состоящий в количественном соответствии (равновесии) бюджетных расходов источникам их финансирования."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d132e509-5293-3eb9-ae9b-f5de5baa405d",
                                        "entry_id": "4f1a703b-395e-3c88-8ef5-625493b30299",
                                        "glosses": [
                                            "адъектив. книжн. с правильным соотношением частей, элементов чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c6aac9-9698-403b-a082-f04a23852369",
                                                "sense_id": "d132e509-5293-3eb9-ae9b-f5de5baa405d",
                                                "text": "В имении члена третьей Гос. Думы Фальц-Фейна «Дорибурге» произведены пробные полёты на аэроплане нового типа, выстроенном студентом петербургского политехникума Фальц-Фейном. Аппарат оказался хорошо сбалансированным с большой грузоподъемностью и с приспособлением к планирующим спускам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae25701d-c389-32b1-88be-1e7df76b9b73",
                                        "entry_id": "4f1a703b-395e-3c88-8ef5-625493b30299",
                                        "glosses": [
                                            "адъектив. книжн. уравновешенный, согласованный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d6b9f40-068f-4032-85c2-aad92c3ad6f9",
                                                "sense_id": "ae25701d-c389-32b1-88be-1e7df76b9b73",
                                                "text": "― Завидую вашему характеру. Мы в психологии называем это хорошо сбалансированной личностью."
                                            },
                                            {
                                                "example_id": "dab1af92-fb86-44d7-b5e2-a9c3aaf50aa1",
                                                "sense_id": "ae25701d-c389-32b1-88be-1e7df76b9b73",
                                                "text": "― Наша ближневосточная политика была, в общем-то, здоровой и сбалансированной."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сбалансированный",
                                "target_lang_code": "ru",
