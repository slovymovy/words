                "senses": [
                    {
                        "sense_id": "02bb723c-7176-326b-836e-b7003aba0dc2",
                        "entry_id": "83b1997a-068d-398c-8ddc-24d54df136f2",
                        "glosses": [
                            "Porte-voix à amplification électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9e7d76-6bb2-4c60-b5c9-cbc63eade440",
                                "sense_id": "02bb723c-7176-326b-836e-b7003aba0dc2",
                                "text": "L’appareil décrivait, à une vitesse de cinq kilomètres à l’heure, un large cercle, avec un bourdonnement sourd qui aurait complètement dominé la voix claironnante de M. Butteridge, s’il n’avait eu la précaution de se munir d’un mégaphone."
                            },
                            {
                                "example_id": "789ce5b5-2187-4887-b2ea-3f5eb7c2442c",
                                "sense_id": "02bb723c-7176-326b-836e-b7003aba0dc2",
                                "text": "Mais une grande voix venue d’un mégaphone\nDont le pavillon sortait\nDe je ne sais quel unanime poste de commandement\nLa voix du capitaine inconnu qui nous sauve toujours cria."
                            }
                        ]
                    },
                    {
                        "sense_id": "5159e993-2f17-38d4-9ee9-f5aa2bfd8a48",
                        "entry_id": "83b1997a-068d-398c-8ddc-24d54df136f2",
                        "glosses": [
                            "Moyen qui amplifie un message."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "940dd379-8ef5-40b2-8b49-3209606a0ae7",
                                "sense_id": "5159e993-2f17-38d4-9ee9-f5aa2bfd8a48",
                                "text": "Donald Trump se compliquerait en effet la tâche en se privant du puissant mégaphone que constitue la chaîne conservatrice auprès de l’électorat blanc, rural et plutôt âgé qui constitue sa base."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b11efe34-8c38-49ec-9d10-c91c6731d6b6",
                        "source_entry_id": "83b1997a-068d-398c-8ddc-24d54df136f2",
                        "target_lang_word": "Megafon",
