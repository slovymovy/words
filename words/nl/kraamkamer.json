            "senses": [
                {
                    "sense_id": "b8fdd987-ca6c-3b4a-907c-e1a77877dc43",
                    "sense_definition": "De kamer waarin een vrouw bevalt en haar kraamtijd doorbrengt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kersverse vader liep zenuwachtig heen en weer in de <w>kraamkamer</w>.",
                            "target_lang_translations": {
                                "en": "The brand-new father paced back and forth nervously in the <w>maternity room</w>."
                            }
                        },
                        {
                            "text": "In het ziekenhuis is de <w>kraamkamer</w> van alle moderne gemakken voorzien.",
                            "target_lang_translations": {
                                "en": "In the hospital, the <w>delivery room</w> is equipped with all modern conveniences."
                            }
                        }
                    ],
                    "synonyms": [
                        "verloskamer"
                    ],
                    "common_phrases": [
                        "in de kraamkamer"
                    ],
                    "target_lang_definitions": {
                        "en": "The room where a woman gives birth and spends her postpartum period."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maternity ward",
                                "target_lang_sense_clarification": "hospital department for childbirth"
                            },
                            {
                                "target_lang_word": "delivery room",
                                "target_lang_sense_clarification": "room where birth takes place"
                            },
                            {
                                "target_lang_word": "nursery",
                                "target_lang_sense_clarification": "room for newborns and mothers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24b6888c-e339-3fe9-b278-2e47f888fa47",
                    "sense_definition": "Een plaats waar iets nieuws ontstaat, zich ontwikkelt of waar dieren zich voortplanten; een broedplaats of bakermat.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waddenzee fungeert als de <w>kraamkamer</w> voor vele vissoorten in de Noordzee.",
                            "target_lang_translations": {
                                "en": "The Wadden Sea acts as the <w>nursery</w> for many fish species in the North Sea."
                            }
                        },
                        {
                            "text": "Deze universiteit staat bekend als de <w>kraamkamer</w> van innovatieve start-ups.",
                            "target_lang_translations": {
                                "en": "This university is known as the <w>cradle</w> of innovative start-ups."
                            }
                        }
                    ],
                    "synonyms": [
                        "broedplaats",
                        "bakermat",
                        "kweekvijver"
                    ],
                    "common_phrases": [
                        "kraamkamer van de archeologie",
                        "kraamkamer van de natuur"
                    ],
                    "target_lang_definitions": {
                        "en": "A place where something new originates, develops, or where animals reproduce; a breeding ground or cradle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "breeding ground",
                                "target_lang_sense_clarification": "for animals or ideas"
                            },
                            {
                                "target_lang_word": "cradle",
                                "target_lang_sense_clarification": "place of origin or early development"
                            },
                            {
                                "target_lang_word": "nursery",
                                "target_lang_sense_clarification": "ecological sense, e.g., for fish"
                            },
                            {
                                "target_lang_word": "hotbed",
                                "target_lang_sense_clarification": "place where a lot of activity or development happens"
                            }
                        ]
                    }
                }
