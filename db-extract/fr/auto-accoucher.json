                ],
                "senses": [
                    {
                        "sense_id": "6daa520b-1a8c-37b0-917e-423a19779d63",
                        "entry_id": "de3eec8d-b738-3079-800a-d1a06cfa446a",
                        "glosses": [
                            "S’accoucher soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48e46c1-14c8-4e63-95fa-3898fa8fe7d9",
                                "sense_id": "6daa520b-1a8c-37b0-917e-423a19779d63",
                                "text": "La quête de Huysmans était d'un lieu où habiter, celle de Louis-Combet, guère différente, celle d'une matrice où s'auto-accoucher sans fin."
                            },
                            {
                                "example_id": "69be4d3f-2f77-4450-ae1b-6cd2a20b7b06",
                                "sense_id": "6daa520b-1a8c-37b0-917e-423a19779d63",
                                "text": "Je vais \"auto-accoucher\" de mon nouveau moi."
                            },
                            {
                                "example_id": "f4ca9685-e65b-4b82-9090-e03201ced8f8",
                                "sense_id": "6daa520b-1a8c-37b0-917e-423a19779d63",
                                "text": "Le plus fascinant à contempler c'est son aptitude à s'auto-accoucher tous les matins."
                            }
                        ]
                    }
