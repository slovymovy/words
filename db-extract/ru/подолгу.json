                                        "sense_id": "4611b71f-5df5-3d15-b0ac-58dee89b36fa",
                                        "entry_id": "c76fa96e-6ee7-3507-852a-f8d977fa60b3",
                                        "glosses": [
                                            "mehrere Stunden dauernd; mehrere Stunden lang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bbbe608-b214-4362-9ef4-38c1cb6c3f41",
                                                "sense_id": "4611b71f-5df5-3d15-b0ac-58dee89b36fa",
                                                "text": "Wir haben dich stundenlang gesucht."
                                            },
                                            {
                                                "example_id": "d64cd017-03c9-4925-bf7f-c44d1a07e914",
                                                "sense_id": "4611b71f-5df5-3d15-b0ac-58dee89b36fa",
                                                "text": "„Stundenlang donnern die Wagen über Ebenen, auf denen scharfkantige Steine verstreut liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062517cc-e9d9-44fe-b0e9-5c1e33728d79",
                        "source_entry_id": "e2b15cf3-128e-3fbf-ba75-28b6c6c8b671",
                        "source_sense_id": "cbcfdbd2-db4a-377f-99f4-7082f8c52088",
                        "target_lang_word": "monatelang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monatelang",
