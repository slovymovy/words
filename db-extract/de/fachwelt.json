                ],
                "senses": [
                    {
                        "sense_id": "6b25c025-b6c7-38a2-b883-b52fd3398437",
                        "entry_id": "0c07c535-9ed8-3291-ab4a-0096a2ed56b8",
                        "glosses": [
                            "Gesamtheit der Fachleute eines bestimmten Fachgebietes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174c8133-ff15-49fe-b1c7-15ae983d074f",
                                "sense_id": "6b25c025-b6c7-38a2-b883-b52fd3398437",
                                "text": "Das Buch erhielt in der Fachwelt gute Kritiken."
                            },
                            {
                                "example_id": "fc9dce13-d824-4fee-9bba-3a579094ffdf",
                                "sense_id": "6b25c025-b6c7-38a2-b883-b52fd3398437",
                                "text": "„Immerhin erzählte er der akademischen Fachwelt, dass sie ein halbes Jahrhundert vergeudet habe, indem sie sich Chomskys Doktrin von der Universellen Grammatik anschloss.“"
                            },
                            {
                                "example_id": "b5ca9f2e-9466-489d-8eb0-5eb771f1f2c4",
                                "sense_id": "6b25c025-b6c7-38a2-b883-b52fd3398437",
                                "text": "„Vor hundertfünfzig Jahren war man sich in der Fachwelt einig, das größte Zukunftsproblem in Großstädten werde der Pferdemist sein.“"
                            },
                            {
                                "example_id": "daea8311-fb2e-4c7b-aa09-ef211d364474",
                                "sense_id": "6b25c025-b6c7-38a2-b883-b52fd3398437",
                                "text": "„Die Fachwelt ignorierte den Viehtreiber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
