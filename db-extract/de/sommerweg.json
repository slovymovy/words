                        "examples": [
                            {
                                "example_id": "0e15993f-aca5-48ce-950d-987de7bb0340",
                                "sense_id": "704fad90-34ee-3e54-b86f-87dcfc93397b",
                                "text": "„Das Türenschlagen, das Anspringen des Motors, die Abfahrt; über der Trockenheit des Sommerweges schwebt und entschwindet eine kleine Wolke aus Staub.“"
                            },
                            {
                                "example_id": "98fc2b88-950e-4c7a-9e32-4ce35c73487b",
                                "sense_id": "704fad90-34ee-3e54-b86f-87dcfc93397b",
                                "text": "„Gandras fuhr mit dem Dienstrad gemächlich den Sommerweg abwärts und verlangsamte das Tempo vor dem Haus des Aaron Eisenstein.“"
                            }
                        ],
