                        "glosses": [
                            "Ärztin, die für eine Station einer medizinischen Einrichtung zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d44c970-f4ce-449a-aa3d-8893b6c1f8a6",
                                "sense_id": "c2d39571-d6c9-3391-bb0d-cc42efadad5a",
                                "text": "Die Stationsärztin kommt heute zur Visite."
                            },
                            {
                                "example_id": "6be17014-cbe7-4131-bb60-1f013aa9d74a",
                                "sense_id": "c2d39571-d6c9-3391-bb0d-cc42efadad5a",
                                "text": "Die Stationsärztinnen tragen eine gewisse Verantwortung."
                            },
                            {
                                "example_id": "522644a4-34f7-4dd6-8d19-e7ca5188be3e",
                                "sense_id": "c2d39571-d6c9-3391-bb0d-cc42efadad5a",
                                "text": "Der Stationsärztin sollte man immer alles gut erklären und die Wahrheit erzählen."
                            }
