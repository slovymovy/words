            "pos": "verb",
            "senses": [
                {
                    "sense_id": "047dda9a-589c-34f3-b2e6-b79c9546103c",
                    "sense_definition": "die Konzentration einer Flüssigkeit verringern, meist durch Zugabe von Wasser oder einem anderen Lösungsmittel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "konzentration_verringern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du solltest den starken Fruchtsaft vor dem Trinken mit etwas Wasser <w>verdünnen</w>."
                        },
                        {
                            "text": "Der Koch <w>verdünnte</w> die dicke Soße mit etwas heißer Brühe, damit sie flüssiger wird."
                        }
                    ],
                    "synonyms": [
                        "strecken",
                        "verwässern"
                    ],
                    "antonyms": [
                        "verdicken"
                    ],
                    "common_phrases": [
                        "mit Wasser verdünnen"
                    ]
                },
                {
                    "sense_id": "1dce278e-e7e5-3b82-af6f-bcf1a072e368",
                    "sense_definition": "die Konzentration oder Dichte eines Gases beziehungsweise der Luft verringern",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "konzentration_verringern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In großen Höhen <w>verdünnt</w> sich die Luft, weshalb das Atmen spürbar schwerer fällt."
                        },
                        {
                            "text": "Die Forscher mussten das giftige Gas im Labor vorsichtig <w>verdünnen</w>, um die Reaktion zu kontrollieren."
                        }
                    ],
                    "antonyms": [
                        "verdicken"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8041ba89-f3c5-313e-95c0-aebb73b9efdd",
                    "sense_definition": "das Herabsetzen der Konzentration eines Stoffes; Substantivierung des Verbs <w>verdünnen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim <w>Verdünnen</w> der Säure muss man immer die Flüssigkeit vorsichtig ins Wasser gießen."
                        },
                        {
                            "text": "Durch das <w>Verdünnen</w> mit frischem Wasser verlor der Saft seinen künstlich süßen Geschmack."
                        }
                    ]
                }
