                        "examples": [
                            {
                                "example_id": "8dd3fdb1-9eeb-49e8-a3f1-3b0f13d63de2",
                                "sense_id": "f2ad0ee7-5c8e-342b-aeed-6a2edd131555",
                                "text": "„Zur Zeit des Angriffs auf Tel Chai besuchte er gerade Metulla; seine Rückkehr nach Russland stand kurz bevor.“"
                            },
                            {
                                "example_id": "a7036d12-fa60-4c19-a76b-712164887597",
                                "sense_id": "f2ad0ee7-5c8e-342b-aeed-6a2edd131555",
                                "text": "„Denn schon am 10. März schickte sie einen Todesfahrer los: Unweit des israelischen Grenzübergangs bei Metulla rammte er einen Militärlastwagen, der siebenundzwanzig Soldaten in den Libanon transportieren sollte.“"
                            }
                        ],
