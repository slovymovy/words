                ],
                "senses": [
                    {
                        "sense_id": "d06d9ba7-df4a-3925-b2e9-3864d3ba68d1",
                        "entry_id": "83fc4421-b408-3b29-8305-cdf938d2e17d",
                        "glosses": [
                            "Person, die die Sportart des Turmspringens ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad22f255-937d-4f73-be1f-087ea93af9a3",
                                "sense_id": "d06d9ba7-df4a-3925-b2e9-3864d3ba68d1",
                                "text": "„Auch für die Turmspringer ist es bitter, dass das Becken in der Stadthalle noch länger leer bleiben wird: Sie müssen in den kommenden Monaten im Ausland trainieren - was zigtausende Euro kostet.“"
                            },
                            {
                                "example_id": "6e6b4f76-bfd8-4166-9736-3e65682fd23e",
                                "sense_id": "d06d9ba7-df4a-3925-b2e9-3864d3ba68d1",
                                "text": "„Bei den Südostasien-Meisterschaften waren die zwei philippinischen Turmspringer John Elmerson Fabriga und John David Pahoyos die Lachnummer.“"
                            },
                            {
                                "example_id": "13ba15cd-13b1-4c2f-a8ed-ed32e6aa3ab6",
                                "sense_id": "d06d9ba7-df4a-3925-b2e9-3864d3ba68d1",
                                "text": "„Dass nicht mehr passiert ist, grenzt an ein Wunder: Der amerikanische Turmspringer Steven LoBue will aus 27,5 Metern in die Tiefe springen und schlägt mit dem Kopf gegen die Beton-Plattform.“"
                            },
                            {
                                "example_id": "4373a72c-e7fc-4a3a-8483-86f7b8e95ab2",
                                "sense_id": "d06d9ba7-df4a-3925-b2e9-3864d3ba68d1",
                                "text": "„Ich wollte es so gerne gut machen, ja, ich hätte ihr in diesem Moment wirklich gerne eine Freude bereitet und meine Arme in die Höhe gereckt wie ein Turmspringer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
