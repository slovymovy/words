                        "glosses": [
                            "Établissement correspondant à un café, dans les pays arabes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d28e32-1134-4502-8ec4-c9c21ea85fda",
                                "sense_id": "1eb7ac93-ea14-33b6-984c-85cd5684e7fa",
                                "text": "Mon amie, celui qui n'a pas bu le café dans les kaouadji des pays arabes ignore une des voies de l'au-delà qui sont le plus aisées aux démarches de l'âme."
