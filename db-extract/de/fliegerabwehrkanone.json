                    {
                        "sense_id": "86c79271-2f83-3a71-84be-494694b75278",
                        "entry_id": "a108f064-4c2c-3fe6-a536-8a8531a6367c",
                        "glosses": [
                            "ursprünglich im Ersten Weltkrieg entwickelte Waffe, die gegen Flugzeuge eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6f7a31-7b83-4f5c-bf06-85bbe0a6c1b9",
                                "sense_id": "86c79271-2f83-3a71-84be-494694b75278",
                                "text": "Durch das Abwehrfeuer der Fliegerabwehrkanonen wurden die feindlichen Flugzeuge zum Abdrehen gezwungen."
                            },
                            {
                                "example_id": "0dde346a-75d7-476a-89cd-874dac7b2ab4",
                                "sense_id": "86c79271-2f83-3a71-84be-494694b75278",
                                "text": "„Die Munition, die von Fliegerabwehrkanonen aus dem Zweiten Weltkrieg stammte, war am vergangenen Samstag entdeckt worden, wie die Gemeindeverwaltung mitteilte.“"
                            }
                        ],
