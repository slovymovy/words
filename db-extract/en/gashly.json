                        "glosses": [
                            "Ghastly, horrible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9624137-c9a5-48f2-9a26-d53445b5a48d",
                                "sense_id": "dec50c27-5bf1-3f84-80c8-8c1fd7dc5cd7",
                                "text": "My ladies' maid, who was troubled with nerves, declared she could never sleep alone in such a \"gashly, rummaging old building;\" and the footman, who was a kind-hearted young fellow, did all in his power to cheer her up."
                            },
                            {
                                "example_id": "84a98954-0a9d-481c-92da-5a748c0f6d63",
                                "sense_id": "dec50c27-5bf1-3f84-80c8-8c1fd7dc5cd7",
                                "text": "I have a great mind to break all your gashly images about the head of your fine Miss, in her silks and satins;’—mistaking his lay-figure for a living model of the highest sort."
                            },
                            {
                                "example_id": "8012d169-d8bd-4919-8caf-91feba535852",
                                "sense_id": "dec50c27-5bf1-3f84-80c8-8c1fd7dc5cd7",
                                "text": "\"It's a dead man. Yes, indeedy; naked, too. He's ben shot in de back. I reck'n he's ben dead two er three days. Come in, Huck, but doan' look at his face--it's too gashly.\""
                            },
                            {
                                "example_id": "afb81798-0f94-4aa3-8a62-c7828f1afe52",
                                "sense_id": "dec50c27-5bf1-3f84-80c8-8c1fd7dc5cd7",
                                "text": "Listen here, Swing, old-timer, I got a long and gashly tale of wickedness to pour into those lily-white mule ears of yores."
                            }
                        ]
                    }
