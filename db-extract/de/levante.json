                "senses": [
                    {
                        "sense_id": "97de6228-9fc1-3c6c-84ec-2705060c1327",
                        "entry_id": "3a114217-d955-3c24-b088-0156102ab84d",
                        "glosses": [
                            "Mittelmeerraum östlich von Italien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcec789f-5df4-41b7-8000-0c2efa0399c8",
                                "sense_id": "97de6228-9fc1-3c6c-84ec-2705060c1327",
                                "text": "Sie machten eine Reise in die Levante, um Handelskontakte zu knüpfen."
                            },
                            {
                                "example_id": "ea7c5b9d-9fb3-4005-a82d-20325761337e",
                                "sense_id": "97de6228-9fc1-3c6c-84ec-2705060c1327",
                                "text": "Auch Chris Stringer und Julia Galway-Witham vom Natural History Museum in London sind der Meinung, dass immer wieder einmal Frühmenschen Afrika verliessen und via die Levante weiterzogen."
                            },
                            {
                                "example_id": "2750fd16-58c4-42d7-9369-4ae7c54df154",
                                "sense_id": "97de6228-9fc1-3c6c-84ec-2705060c1327",
                                "text": "„Der Kriegsminister, den man in Venedig Savio alla Scrittura nennt, hatte sie anläßlich von Rangerhöhungen aus der Levante kommen lassen.“"
                            },
                            {
                                "example_id": "1e2a6521-e964-42a8-af02-67a524539528",
                                "sense_id": "97de6228-9fc1-3c6c-84ec-2705060c1327",
                                "text": "„Die längste Zeit seines Lebens lebte der gebürtige Thüringer an der Levante und in Italien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
