                        "sense_id": "accb91bc-b8b4-3242-9ca5-9e03046af281",
                        "entry_id": "ca07b6fa-add7-3a13-bf93-71363b8825e1",
                        "glosses": [
                            "Père attentionné et généreux avec ses enfants."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e85e54d1-9f73-4c0f-a24e-7cdab1b511c1",
                                "sense_id": "accb91bc-b8b4-3242-9ca5-9e03046af281",
                                "text": "Le style des affrontements politiques reflétera l’adoucissement exceptionnellement rapide des techniques éducatives au cours des dix dernières années. […]. Les papas-gâteaux d’aujourd'hui préparent à la France des lendemains qui chantent, plus sûrement que les constructeurs de systèmes abstraits."
                            }
                        ]
                    },
                    {
                        "sense_id": "43ed85a6-decc-395a-a8c4-1e6c273b076f",
                        "entry_id": "ca07b6fa-add7-3a13-bf93-71363b8825e1",
                        "glosses": [
                            "Homme mûr qui entretient une amante ou un amant beaucoup plus jeune que lui."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
