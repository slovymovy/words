                                "target_senses": [
                                    {
                                        "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                        "entry_id": "015fdca8-90c4-3778-a27b-faee62f78040",
                                        "glosses": [
                                            "The zone of the Earth's upper mantle, below the lithosphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4eb8d3-c7eb-47fc-8f96-1808ba449555",
                                                "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                                "text": "To say that the lithosphere floats on top of the asthenosphere suggests a degree of easy buoyancy that isn't quite right."
                                            },
                                            {
                                                "example_id": "0681ce27-f75e-4aab-aa4a-0b8dd128dd5f",
                                                "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                                "text": "The asthenosphere that underlies the surface plates is not liquid in any vernacular sense, although it is relatively plastic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
