        "fr-extract.jsonl": [
            {
                "entry_id": "20adea2e-2bc6-38bd-b165-18f75ca5e13d",
                "word": "peps",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef1c7ef9-756c-43b2-abe9-7146ac72f31f",
                        "entry_id": "20adea2e-2bc6-38bd-b165-18f75ca5e13d",
