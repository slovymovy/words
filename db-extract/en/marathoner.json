                                        "glosses": [
                                            "hardloper die meedoet aan een of meer wegraces over lange afstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b498e45-82d4-4430-8a8c-0393222b2432",
                                                "sense_id": "ef5b2c0b-5805-3d57-b39f-2411029f2503",
                                                "text": "De Nederlandse marathonloper Abdi Nageeye krijgt tijdens de sluiting de zilveren medaille die hij eerder deze zondag in Sapporo behaalde op de marathon."
                                            },
                                            {
                                                "example_id": "3b3030fe-6c10-4d9c-a8a1-72ee1946b97f",
                                                "sense_id": "ef5b2c0b-5805-3d57-b39f-2411029f2503",
                                                "text": "Marathonlopers zijn doorgaans vredelievende mensen. Ze geven elkaar onderweg, als het even kan, een bidon met water door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51735001-efa7-40b9-84da-67ff672219de",
                        "source_entry_id": "38874c2b-29c3-3add-8f7b-260bc5907c18",
                        "source_sense_id": "a58ddced-5b66-3920-9fe4-df3af73b141d",
