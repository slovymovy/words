                    "sense_id": "70273d8c-f481-36c0-a191-8affc772fa9e",
                    "sense_definition": "reagować na coś zmysłowo, doświadczać czegoś za pomocą zmysłów",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "odczuwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie lubię <w>odczuwać</w> głodu.",
                            "target_lang_translations": {
                                "en": "I don't like <w>feeling</w> hungry.",
                                "ru": "Я не люблю <w>испытывать</w> чувство голода.",
                                "nl": "Ik vind het niet fijn om honger te <w>voelen</w>.",
                                "de": "Ich mag es nicht, Hunger zu <w>spüren</w>.",
                                "fr": "Je n'aime pas <w>avoir</w> faim.",
                                "it": "Non mi piace <w>sentire</w> la fame.",
