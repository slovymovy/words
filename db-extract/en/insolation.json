                    {
                        "sense_id": "c4af40b2-3173-3edf-870a-0a845b1f86cb",
                        "entry_id": "a5536513-26ab-3190-b7a0-b2ea258c1857",
                        "glosses": [
                            "The incident radiant energy emitted by the sun which reaches a unit area over a period of time, typically measured over a horizontal area at the Earth's surface or at the top of Earth's atmosphere."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "43d4c90c-f169-4f52-b825-b31924ba3083",
                                "sense_id": "c4af40b2-3173-3edf-870a-0a845b1f86cb",
                                "text": "The difference in insolation between north-facing and south-facing slopes can affect microclimates as much as hundreds of miles of north-south distance on level ground."
                            }
                        ]
                    },
                    {
                        "sense_id": "e97da551-f9fe-3033-9f9e-fd15ff041597",
                        "entry_id": "a5536513-26ab-3190-b7a0-b2ea258c1857",
                        "glosses": [
                            "The rate of delivery of such radiation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5fab61b4-0ae5-3c2c-9f79-f06694f4382e",
                        "entry_id": "a5536513-26ab-3190-b7a0-b2ea258c1857",
                        "glosses": [
                            "The act or process of exposing to the rays of the sun, such as for the purpose of medical treatment, drying or maturing, as fruits, drugs, etc., or of rendering acid, as vinegar."
