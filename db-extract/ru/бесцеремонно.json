        "ru-extract.jsonl": [
            {
                "entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                "word": "бесцеремонно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                        "entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                        "glosses": [
                            "пренебрегая правилами приличия; развязно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a56063-6401-4f56-923c-8a4d1cd9d4a8",
                                "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                                "text": "Сам Пётр не привык сдерживать себя и однажды, когда его окружила непрошенная толпа, бесцеремонно ударил по щеке одного из зевак, которого голландцы в шутку прозвали после этого «рыцарем»."
                            },
                            {
                                "example_id": "e61d7e89-8b85-4dcd-8f7d-4f8353061a8b",
                                "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                                "text": "Он глядел бесцеремонно на Райского и засмеялся злым смехом."
                            },
                            {
                                "example_id": "d08cd6b7-844d-42b6-9189-3cc2b6b9f9c7",
                                "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                                "text": "Русая головища нагнулась, бесцеремонно подняла за локти красивую даму и подвела её к маркизе."
                            },
                            {
                                "example_id": "104cb77f-93f9-41b7-ab98-bffdff1b0ae4",
                                "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                                "text": "Посадил я её вчера на колени, да, должно быть, уж очень бесцеремонно, ― вся вспыхнула и слезинки брызнули, да выдать-то не хочет, сама вся горит."
                            },
                            {
                                "example_id": "2a6520e0-e3c8-42d7-a72e-26aa1a354050",
                                "sense_id": "978aa7f8-fd5b-3632-9933-acecb06beb55",
                                "text": "К тому же случилось нечто, глубоко поразившее его: однажды вечером Дронов бесцеремонно вошел в его комнату, устало сел и заговорил угрюмо: — Слушай-ка, Варавка хочет перевести меня на службу в Рязань, а это, брат, не годится мне."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0551fe9-175c-3f8f-a1c4-d130fab57e22",
                        "entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                        "glosses": [
                            "не стесняя себя соблюдением этикета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bd0a84-1684-4d9d-aabb-9d99bd64a73b",
                                "sense_id": "d0551fe9-175c-3f8f-a1c4-d130fab57e22",
                                "text": "Удостоверившись, что он настоящий, природный дворянин, и даже несколько удивившись тому, что он не князь, фрау Леноре приняла серьезный вид и ― «предупредила его заранее», что будет с ним совершенно бесцеремонно откровенна, потому что к этому принуждает ее священная обязанность матери!"
                            },
                            {
                                "example_id": "fc560bb4-34f3-487a-9043-3141a3c20064",
                                "sense_id": "d0551fe9-175c-3f8f-a1c4-d130fab57e22",
                                "text": "Она бесцеремонно села на скамейку рядом со мной."
                            },
                            {
                                "example_id": "be4b202d-57b6-461c-822c-e532eb9189c1",
                                "sense_id": "d0551fe9-175c-3f8f-a1c4-d130fab57e22",
                                "text": "Князь танцевал с ней котильон и бесцеремонно жал ей руку."
                            }
                        ]
                    },
                    {
                        "sense_id": "0753a1de-1405-386f-bfa0-391d5a25c606",
                        "entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                        "glosses": [
                            "выражая пренебрежение правилами приличия или свидетельствуя об этом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8063dc9-1fab-47ce-bce2-69930f2e5d01",
                                "sense_id": "0753a1de-1405-386f-bfa0-391d5a25c606",
                                "text": "Петр Степанович с самым фамильярным видом уселся подле него, бесцеремонно поджав под себя ноги, и занял на кушетке гораздо более места, чем сколько требовало уважение к отцу."
                            },
                            {
                                "example_id": "2c4b6107-19a1-4966-960a-f748b8b4bb57",
                                "sense_id": "0753a1de-1405-386f-bfa0-391d5a25c606",
                                "text": "Берия был груб, бесцеремонно и невежественно вмешивался в работу учёных, кричал на Капицу."
                            }
                        ]
                    },
                    {
                        "sense_id": "185152bb-5f70-3a5d-8e00-b550089d3172",
                        "entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                        "glosses": [
                            "предик. оценочная характеристика чьего-либо поведения, чьих-либо действий, поступков как выражающих пренебрежение правилами приличия или свидетельствующих об этом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a4a125-5692-4331-8f49-a869b8c653fb",
                                "sense_id": "185152bb-5f70-3a5d-8e00-b550089d3172",
                                "text": "Но хлопотать за Варвару Васильевну без её разрешения — это, по-моему, бесцеремонно прежде всего по отношению к ней же самой…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "835b1242-707b-4116-930a-bb58013ae09c",
                        "source_entry_id": "71694fbf-d32d-37ea-b9f1-ed6f0cad00fc",
                        "target_lang_word": "unceremonious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unceremonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e874d461-b053-3b1a-b3ee-4554f1e71734",
                                        "entry_id": "f7e93782-290b-3d30-aa77-c44a778ef8a1",
                                        "glosses": [
                                            "Not ceremonious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4495f3-be1b-4ed5-acdb-29962ee1718a",
                                                "sense_id": "e874d461-b053-3b1a-b3ee-4554f1e71734",
                                                "text": "Mrs. De Brooke replied, that she could have no objection to form the acquaintance of Mrs. Belmour, since it appeared she was so unceremonious and so conformable to the taste of her friends, in respect to her mode of visiting them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
