                        "examples": [
                            {
                                "example_id": "d8492f2f-70e7-4675-9e0f-5644c35dc864",
                                "sense_id": "d6bc1df2-ba6f-3605-907e-28960d763e69",
                                "text": "„Nun, wo er sich im Hauptgebäude befand un die Deckung zu schätzen lernte, die es ihnen bot, wurde ihm klar, dass auch die Tschetschenen bald auf den Gedanken kommen würden, diesen Lehmziegelbau als Zuflucht zu nutzen.“"
                            },
                            {
                                "example_id": "9ad3c3b7-9819-4632-9e9c-18a38dd1e705",
                                "sense_id": "d6bc1df2-ba6f-3605-907e-28960d763e69",
                                "text": "„In der als Dorf getarnten Al-Qaida-Bais am Wadi Bani im südlichen Jemen hallte das leise Klopfen an einer Holztür durch das Zimmer eines Lehmziegelbaus.“"
                            }
                        ],
