                "entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                "word": "nachgerade",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93b7c8ab-7c84-31e7-94c5-b4d1045072d6",
                        "entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "glosses": [
                            "endlich, letztlich"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "eabe76ec-77ff-4d3f-8a6a-5a7d9d12718d",
                                "sense_id": "93b7c8ab-7c84-31e7-94c5-b4d1045072d6",
                                "text": "Nachgerade blieb Klara und Jürgen nichts anderes übrig, als ihren Kinderwunsch aufzugeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
                        "entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "glosses": [
                            "geradezu, direkt"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "957d31dd-3a11-4a2b-99f1-7e9c8be422f6",
                                "sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
                                "text": "„Es wird nachgerade beschwerlich, immer die behutsame Sprache der Vernunft zu führen.“"
                            },
                            {
                                "example_id": "a97b16ca-c20c-4066-9267-095c7975fcc9",
                                "sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
                                "text": "„Deformierte Revolutionen wie die Oktoberrevolution in Russland unter Lenin oder abgebrochene Revolutionen wie die verschiedenen Erhebungen bei den europäischen Mittelmächten nach dem Ersten Weltkrieg können, wie wir heute wissen, Folgen haben, die in ihrem blanken Horror nachgerade beispiellos sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4bf137e4-8bcb-383c-89ba-1f1d8392834b",
                        "entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "glosses": [
                            "in allmählichem Verlauf/Prozess; allgemach, allmählich, nach und nach"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8e5ec2f9-840e-4dd6-8361-77ca8a88dd85",
                                "sense_id": "4bf137e4-8bcb-383c-89ba-1f1d8392834b",
                                "text": "Jetzt, da das milde Frühlingswetter kommt, wird es nachgerade aufwärts mit mir gehen."
                            },
                            {
                                "example_id": "8ab1f2d6-bfe6-4fe3-baa0-525605138988",
                                "sense_id": "4bf137e4-8bcb-383c-89ba-1f1d8392834b",
                                "text": "Im Gottesdienst wurde der Magd Else nachgerade die Zeit lang."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1fa5249-806d-4aa6-80e8-385aa18b991a",
                        "source_entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "source_sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
                        "source_sense_description": "geradezu, direkt",
                        "target_lang_word": "well-nigh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "well-nigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                        "entry_id": "e69fa365-317f-3153-89bf-3abfe46c632b",
                                        "glosses": [
                                            "Almost, nearly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea6736d-9ecb-4da4-b850-be35c83d42de",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "The ſame ſo ſore annoyed has the Knight, / That welnigh choked with the deadly ſtinke, / His forces faile, ne can no lenger fight."
                                            },
                                            {
                                                "example_id": "0e6c8402-94fd-4ed1-a241-79cd0836a428",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "The household cock had given his first summons, and the night was well nigh spent."
                                            },
                                            {
                                                "example_id": "1e194ce1-e1ae-4155-9644-01a3fb261424",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "[…] Sindbad the Seaman continued:—So when I escaped drowning and reached the island which afforded me fruit to eat and water to drink, I returned thanks to the Most High and glorified Him; after which I sat till nightfall, hearing no voice and seeing none inhabitant. Then I lay down, well-nigh dead for travail and trouble and terror, and slept without surcease till morning, […]"
                                            },
                                            {
                                                "example_id": "a69f3265-81be-4e65-baee-8d464fc09147",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "This is what makes off-hand testimony about the subjective identity of different sensations well-nigh worthless as a proof of the fact."
                                            },
                                            {
                                                "example_id": "d2fe00d9-1036-41ee-a05f-f6331808ce5d",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "Five years ago the officers determined to build a new mess. There was only one objection to the fulfilment of this wish: the regimental coffers were wellnigh empty."
                                            },
                                            {
                                                "example_id": "c86f3ee4-bd43-4051-bc97-f8b8f174a68b",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "From the third quarter of the 18th century, there has been a steady accession of English words into Bengali, and through an intimate knowledge of the English language and English culture among the educated classes—and 'educated' is now almost synonymous with 'educated in English'—an unending stream of English words is now being admitted into Bengali; and the process was never more active than at the present moment: so that it is well-nigh impossible now to estimate the English element in Bengali, alike in its extent and in its phonology."
                                            },
                                            {
                                                "example_id": "4c9a12f3-0e99-4575-b5f4-ca77bdb18e71",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "Derelict and well-nigh forgotten, Port Victoria now watches the great ships on the Medway—ships that might have berthed in its docks."
                                            },
                                            {
                                                "example_id": "71e590b4-d737-44db-9290-803f57534362",
                                                "sense_id": "cef04a21-5b67-393e-b914-0fc0a25e96a8",
                                                "text": "Directed by Christopher Gans[…] and scripted by Roger Avary, who shared an Oscar with Tarantino for the screenplay of Pulp Fiction, Silent Hill is a well-nigh incomprehensible horror movie made in Canada and set in a West Virginian ghost town."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e01c59-48e8-4de2-9051-931e7374104f",
                        "source_entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "source_sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
                        "source_sense_description": "geradezu, direkt",
                        "target_lang_word": "quasiment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quasiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                        "entry_id": "346532af-5d46-3258-a11b-59dce8cfa45e",
                                        "glosses": [
                                            "Quasi ; presque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "780b6570-255c-48d7-a685-fcafb2edb7c2",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "Les contes et poèmes de Jean de la Ville de Mirmont que nous publions ont déjà été publiés, mais dans une édition si limitée qu’ils sont quasiment inédits."
                                            },
                                            {
                                                "example_id": "cdd6fc3d-a98a-4236-ac94-9dba02d567d0",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "Le scrutin majoritaire à deux tours, le système de financement de la vie publique qui rend quasiment impossible l’émergence de nouvelles formations, la tentation du parti unique, à droite comme à gauche, ainsi que l’instauration du quinquennat, ont contribué à resserrer le cercle du pouvoir."
                                            },
                                            {
                                                "example_id": "02a88fa4-34b2-46ac-b0df-1b5a433b2202",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "[…] des communes qui bénéficient des rentrées de taxe professionnelle tellement importantes qu’elles pourront quasiment exonérer leurs citoyens d’impôts locaux ; […]"
                                            },
                                            {
                                                "example_id": "dc5a0e0a-10d8-4281-b61a-ed04f2d8f3ce",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "Les petits coups de freins de Chak et l’épais tapis de neige se conjuguèrent pour ralentir le camion, et ce fut quasiment au pas qu'il s'engagea dans l'ouverture."
                                            },
                                            {
                                                "example_id": "b7aaab09-d8a3-46f6-9e55-c655158c038b",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "Dans le camp adverse, les Munichois chassent très haut les Bianconeri, quasiment en marquage individuel."
                                            },
                                            {
                                                "example_id": "95eb1431-7994-4113-8fbd-8ea86d149983",
                                                "sense_id": "e885f9f7-d649-31b7-a105-ac32348a78f2",
                                                "text": "Soutenus dans le ciel par les avions de la coalition (qui, à partir de la fin septembre, avaient concentré quasiment tous leurs efforts sur Kobané), ultra-déterminés, ultra-organisés, renforcés par leurs bataillons féminins d’une redoutable efficacité, les YPG reconquirent, mètre après mètre, la moitié de la ville que les djihadistes leur avaient prise, avant de les en chasser complètement le 25 janvier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8c649d2-4d6b-4c2a-a0ed-95a0ab7e37a4",
                        "source_entry_id": "6f6a5da8-dff2-3d3a-b92e-c62e67ba177f",
                        "source_sense_id": "65dca9d3-5d62-385c-be5e-727934d7a1ad",
