                                        "examples": [
                                            {
                                                "example_id": "5cb1ffbf-e0ce-4df1-ac2f-8e268adbfc90",
                                                "sense_id": "1e5ad551-31e0-3f9f-a15d-7385faadbc72",
                                                "text": "I tried, but I never get anyone in the chan! I don't know how/where to advertise... maybe we should set up a meeting time or something?"
                                            },
                                            {
                                                "example_id": "8623a991-cd68-4ffc-a034-d14855cd0acb",
                                                "sense_id": "1e5ad551-31e0-3f9f-a15d-7385faadbc72",
                                                "text": "If you don't have your password set within a week I'll remove you from the userlist and I'll add you again next time I see you in the chan and make sure you set a pass."
                                            }
                                        ]
                                    }
