                    "sense_definition": "Faire éprouver une sensation de froid très vif et engourdissant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent du nord me <w>glace</w> les mains malgré mes gants épais."
                        },
                        {
                            "text": "Cette pluie fine a fini par <w>glacer</w> les randonneurs jusqu'aux os."
                        }
                    ],
                    "common_phrases": [
