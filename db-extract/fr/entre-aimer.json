                        "examples": [
                            {
                                "example_id": "8a982cfc-7a51-4a09-8812-8225bbcb9423",
                                "sense_id": "90dcd282-dc05-331b-b94d-b8cf1f512b36",
                                "text": "Comment l’homme et la femme doivent-ils s’entre-aimer sans blâme?"
                            },
                            {
                                "example_id": "d86ecd0c-22f6-4649-ad00-f6dd00eafe32",
                                "sense_id": "90dcd282-dc05-331b-b94d-b8cf1f512b36",
                                "text": "Pendant vingt siècles, ils ont été exhortés à s’entre-aimer, mais contraints à s’entre-haïr : ils ne pouvaient survivre qu’à ce prix."
                            },
                            {
                                "example_id": "e63eb868-18a8-4b88-ba4b-8af9f8e69f0c",
                                "sense_id": "90dcd282-dc05-331b-b94d-b8cf1f512b36",
                                "text": "S’entre-aimer pas assez rend le produit plus rare, et donc, bien plus cher ! Et s’entre-aimer pas du tout anéantit le marché."
                            }
                        ]
                    }
