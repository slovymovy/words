{
    "word_family": [
        "witheringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0820c591-8314-3459-906e-c6b986e400f5",
                    "sense_definition": "To shrivel, droop, or dry up, typically due to a lack of water or heat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flowers began to <w>wither</w> in the hot sun without enough water.",
                            "target_lang_translations": {
                                "tr": "Çiçekler yeterli su olmadan sıcak güneşin altında <w>solmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Without proper care, the crops will <w>wither</w> and fail to grow.",
                            "target_lang_translations": {
                                "tr": "Doğru bakım yapılmazsa ekinler <w>kuruyacak</w> ve büyümeyecektir."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrivel",
                        "droop",
                        "dry up"
                    ],
                    "antonyms": [
                        "bloom",
                        "flourish"
                    ],
                    "common_phrases": [
                        "wither away"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle su veya ısı eksikliği nedeniyle büzülmek, sarkmak veya kurumak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "solmak",
                                "target_lang_sense_clarification": "Tazeliğini, diriliğini veya parlaklığını yitirmek."
                            },
                            {
                                "target_lang_word": "kurumak",
                                "target_lang_sense_clarification": "Bitkiler için suyunun çekilip cansız duruma gelmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "628ca72f-b868-324e-a349-69228b01f8f1",
                    "sense_definition": "To lose vigor, power, or vitality; to gradually decline or fade away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The once-great empire began to <w>wither</w> as its influence faded.",
                            "target_lang_translations": {
                                "tr": "Bir zamanların büyük imparatorluğu, etkisi azaldıkça <w>zayıflamaya</w> başladı."
                            }
                        },
                        {
                            "text": "States thrive or <w>wither</w> as their economies change over time.",
                            "target_lang_translations": {
                                "tr": "Devletler, ekonomileri zamanla değiştikçe gelişir veya <w>sönerler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "languish",
                        "fade",
                        "decline"
                    ],
                    "antonyms": [
                        "thrive",
                        "prosper"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gücünü, etkisini veya canlılığını yitirmek; yavaş yavaş azalmak veya sönüp gitmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zayıflamak",
                                "target_lang_sense_clarification": "Gücünü veya etkisini kaybetmek."
                            },
                            {
                                "target_lang_word": "sönmek",
                                "target_lang_sense_clarification": "Canlılığını veya etkisini yitirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c14c4ae2-48c6-358c-b45e-3b496b311cb1",
                    "sense_definition": "To cause something to shrivel, dry up, or lose its vitality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat served to <w>wither</w> the delicate leaves of the plant.",
                            "target_lang_translations": {
                                "tr": "Şiddetli sıcak, bitkinin narin yapraklarını <w>soldurdu</w>."
                            }
                        },
                        {
                            "text": "Years of neglect had <w>withered</w> his once-strong spirit.",
                            "target_lang_translations": {
                                "tr": "Yıllarca süren ihmal, bir zamanlar güçlü olan ruhunu <w>soldurmuştu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrivel",
                        "dehydrate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin büzülmesine, kurumasına veya canlılığını yitirmesine neden olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "soldurmak",
                                "target_lang_sense_clarification": "Canlılığını veya tazeliğini kaybettirmek."
                            },
                            {
                                "target_lang_word": "kurutmak",
                                "target_lang_sense_clarification": "Suyu çekilip cansız duruma getirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b541c0-fe56-3d83-91b7-417edec19ee2",
                    "sense_definition": "To become emotionally overwhelmed or helpless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She seemed to <w>wither</w> under his harsh and critical gaze.",
                            "target_lang_translations": {
                                "tr": "Onun sert ve eleştirel bakışları altında <w>çökmüş</w> görünüyordu."
                            }
                        },
                        {
                            "text": "He began to <w>wither</w> from the sheer weight of his grief.",
                            "target_lang_translations": {
                                "tr": "Kederinin ağırlığı altında <w>çökmeye</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "collapse",
                        "crumble"
                    ],
                    "target_lang_definitions": {
                        "tr": "Duygusal olarak bunalmak veya çaresiz hissetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çökmek",
                                "target_lang_sense_clarification": "Duygusal olarak yıkılmak veya güçsüzleşmek."
                            },
                            {
                                "target_lang_word": "solmak",
                                "target_lang_sense_clarification": "Üzüntü veya baskı altında canlılığını yitirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "145f10d7-c2d2-391c-b6a2-39ea8946bf7b",
                    "sense_definition": "To make someone feel helpless or small through intense emotion or criticism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's cold stare <w>withered</w> the student into silence.",
                            "target_lang_translations": {
                                "tr": "Öğretmenin soğuk bakışları öğrenciyi <w>sindirerek</w> sessizliğe gömdü."
                            }
                        },
                        {
                            "text": "His sharp words <w>withered</w> her confidence instantly.",
                            "target_lang_translations": {
                                "tr": "Onun keskin sözleri, kadının özgüvenini anında <w>ezdi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crush",
                        "intimidate"
                    ],
                    "common_phrases": [
                        "wither with a look"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yoğun duygu veya eleştiri yoluyla birini çaresiz veya küçük hissettirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ezmek",
                                "target_lang_sense_clarification": "Eleştiri veya tavırla birinin özgüvenini kırmak."
                            },
                            {
                                "target_lang_word": "sindirmek",
                                "target_lang_sense_clarification": "Baskı yoluyla birini korkutmak veya sessizleştirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111877f5-6de3-368f-8f92-de5d767a447e",
                    "sense_definition": "To resist or oppose something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels refused to <w>wither</w> before the advancing army.",
                            "target_lang_translations": {
                                "tr": "İsyancılar, ilerleyen ordunun karşısında <w>direnmeye</w> devam ettiler."
                            }
                        },
                        {
                            "text": "They stood firm and did not <w>wither</w> in the face of opposition.",
                            "target_lang_translations": {
                                "tr": "Kararlı durdular ve muhalefet karşısında <w>boyun eğmediler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "resist",
                        "oppose"
                    ],
                    "antonyms": [
                        "submit",
                        "yield"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye karşı direnmek veya karşı koymak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "direnmek",
                                "target_lang_sense_clarification": "Karşı koymak, boyun eğmemek."
                            },
                            {
                                "target_lang_word": "karşı durmak",
                                "target_lang_sense_clarification": "Bir güce veya baskıya karşı boyun eğmemek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "722de2c6-c114-370e-943d-b6fae7b705d5",
                    "sense_definition": "The part of a horse's back located between the shoulder blades.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If a saddle tips too far forward, it may rest on the horse's <w>withers</w>.",
                            "target_lang_translations": {
                                "tr": "Eğer eyer çok fazla öne doğru kayarsa, atın <w>cidagosuna</w> baskı yapabilir."
                            }
                        },
                        {
                            "text": "There should be a gap between the <w>withers</w> and the saddle pommel.",
                            "target_lang_translations": {
                                "tr": "Atın <w>cidagosu</w> ile eyerin ön kaşı arasında bir boşluk olmalıdır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horse's withers"
                    ],
                    "target_lang_definitions": {
                        "tr": "Atın sırtında, kürek kemikleri arasında bulunan bölge."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cidago",
                                "target_lang_sense_clarification": "Atın kürek kemikleri arasındaki bölge."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c551c184-c7b1-35fc-ba2f-60e241ece669",
                    "sense_definition": "A common English surname.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The book was written by a man named <w>Withers</w>.",
                            "target_lang_translations": {
                                "tr": "Kitap <w>Withers</w> adında bir adam tarafından yazılmış."
                            }
                        },
                        {
                            "text": "Mr. <w>Withers</w> is our new neighbor.",
                            "target_lang_translations": {
                                "tr": "Bay <w>Withers</w> yeni komşumuz."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yaygın bir İngiliz soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Withers",
                                "target_lang_sense_clarification": "Özel isim (soyadı)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}