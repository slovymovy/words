                        "sense_id": "69ddaead-2edb-37f9-8a53-4dec736de5b9",
                        "entry_id": "b20a1773-24f5-30c5-aad4-af10b80d203a",
                        "glosses": [
                            "eine Dialekt der kurdischen Sprache, die von etwa zwei Dritteln der Kurden gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb16a66e-3d10-4190-ad16-94aecdcb58b0",
                                "sense_id": "69ddaead-2edb-37f9-8a53-4dec736de5b9",
                                "text": "„Kurmandschi wird seit den 1930er Jahren mit lateinischen Buchstaben geschrieben.“"
                            },
                            {
                                "example_id": "210e6528-a2ca-42ed-a1e7-3b239dc8e6a0",
                                "sense_id": "69ddaead-2edb-37f9-8a53-4dec736de5b9",
                                "text": "„Grammatikalisch gesehen sind die Unterschiede zwischen Kurmandschi und Sorani nicht geringer als etwa jene zwischen dem Deutschen und dem Holländischen; z.B. kennt Sorani im Gegensatz zum Kurmandschi kein grammatikalisches Geschlecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
