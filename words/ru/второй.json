                        {
                            "text": "Для него карьера всегда была на <втором> плане после семьи.",
                            "target_lang_translations": {
                                "en": "For him, career always took <second> place to family.",
                                "zh": "对他来说，事业总是排在家庭之后的<w>次要</w>位置。"
                            }
                        }
                    ],
                    "antonyms": [
                        "главный",
                        "основной"
                    ],
                    "common_phrases": [
