                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60eaca6c-5857-4c67-892b-456059fb7a82",
                                                "sense_id": "d0eb1825-9a0c-33f2-8051-a4c4639e9b4b",
                                                "text": "Государь и великий князь приехали только в церковь и на дому не были, но провожали гроб из церкви до могилы на новом кладбище и тут оставались до первой горсти земли, посыпанной на гроб."
                                            },
                                            {
                                                "example_id": "8ac3b95c-24e8-43d6-b14e-a7be7dd96d78",
                                                "sense_id": "d0eb1825-9a0c-33f2-8051-a4c4639e9b4b",
                                                "text": "На кладбище священник крестообразно посыпает землёй покрытое саваном тело покойного, совершается лития."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63892885-df6b-3497-a477-a5f9af816af6",
                                        "entry_id": "f04a151d-96d2-3608-91ee-37d2c1ab2712",
                                        "glosses": [
                                            "место массового залегания останков животных"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
