                            "past"
                        ],
                        "form": "согре́в"
                    },
                    {
                        "form_id": "c3190f72-93ff-42e7-bfc5-6554bcaadf5d",
                        "entry_id": "e2bec896-6809-3722-b5da-8d9b93fcf94c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "согре́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a0fd687-9acb-3f4a-af18-358023839a78",
                        "entry_id": "e2bec896-6809-3722-b5da-8d9b93fcf94c",
                        "glosses": [
                            "сделать тёплым или горячим; нагреть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3007011-c1c0-43c3-af16-6e1ebad65dd8",
                                "sense_id": "0a0fd687-9acb-3f4a-af18-358023839a78",
                                "text": "Растолкал я Иванова, на станцию вышли, велел я самовар согреть."
                            }
                        ]
                    },
                    {
                        "sense_id": "1235a236-cea2-38be-993c-ebaf8b2581a1",
                        "entry_id": "e2bec896-6809-3722-b5da-8d9b93fcf94c",
                        "glosses": [
                            "вернуть утраченное тепло озябшему телу, рукам, ногам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4889cc-747d-4be2-92b1-f11e0eefff46",
                                "sense_id": "1235a236-cea2-38be-993c-ebaf8b2581a1",
                                "text": "― Дайте ваши руки, ― сказала она, ― я их согрею."
                            }
                        ]
                    },
                    {
                        "sense_id": "721a744d-b199-3e95-9023-ef2fb1e6c288",
                        "entry_id": "e2bec896-6809-3722-b5da-8d9b93fcf94c",
                        "glosses": [
                            "перен. утешить, ободрить участливым, заботливым и т. п. отношением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328af484-5309-4cf7-9384-9b2f4aed22af",
                                "sense_id": "721a744d-b199-3e95-9023-ef2fb1e6c288",
                                "text": "Было бы сердце согрето жаром взаимной любви…"
                            },
                            {
                                "example_id": "f1c1da41-21c5-4c43-8c91-bba1054acac9",
                                "sense_id": "721a744d-b199-3e95-9023-ef2fb1e6c288",
                                "text": "Завёлся такой пошиб в жизни, отчего не стало на земле положений, где бы мог человек согреть душу огнём стыда; стыд подмок повсеместно и не горит."
                            },
                            {
                                "example_id": "ee6a4fda-4de1-4c51-bab8-f29c96cec8ff",
                                "sense_id": "721a744d-b199-3e95-9023-ef2fb1e6c288",
                                "text": "И он сейчас же увидел белую стену городского музея на самом берегу, старую рыжую пушку у входа на камнях, маленького человека с указкой в руке ― это вдруг на мгновение пришло к нему, согрело его, и он улыбнулся."
                            }
                        ]
                    }
                ],
                "translations": [],
