{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9142be1c-832e-3cc6-96e3-e8240edbbc99",
                    "sense_definition": "Up until the present time; used in negative sentences and questions to talk about something that has not happened but is expected to.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have not finished my homework <w>yet</w>.",
                            "target_lang_translations": {
                                "ru": "Я <w>ещё</w> не закончил свою домашнюю работу.",
                                "zh": "我<w>还</w>没写完作业。"
                            }
                        },
                        {
                            "text": "Have you decided what to wear to the party <w>yet</w>?",
                            "target_lang_translations": {
                                "ru": "Ты <w>уже</w> решил, что надеть на вечеринку?",
                                "zh": "你<w>已经</w>决定好聚会穿什么了吗？"
                            }
                        },
                        {
                            "text": "We do not <w>yet</w> know the results of the test.",
                            "target_lang_translations": {
                                "ru": "Мы <w>пока</w> не знаем результатов теста.",
                                "zh": "我们<w>还</w>不知道测试结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "so far",
                        "to date"
                    ],
                    "common_phrases": [
                        "not yet",
                        "as yet",
                        "just yet"
                    ],
                    "target_lang_definitions": {
                        "ru": "До настоящего времени; используется в отрицательных предложениях и вопросах для обозначения того, что ожидаемое событие еще не произошло.",
                        "zh": "指直到现在为止；常用于否定句或疑问句，表示某事尚未发生但预期会发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "в отрицательных предложениях"
                            },
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "на данный момент"
                            },
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "в вопросительных предложениях"
                            },
                            {
                                "target_lang_word": "до сих пор",
                                "target_lang_sense_clarification": "до настоящего момента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还",
                                "target_lang_sense_clarification": "用于否定句，表示尚未"
                            },
                            {
                                "target_lang_word": "已经",
                                "target_lang_sense_clarification": "用于疑问句，询问是否发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f35eafc1-7bd6-39dc-9159-206fdcc99496",
                    "sense_definition": "Used to say that something has not happened or been done by the time referenced, often implying that it should have or will happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have <w>yet</w> to receive a response from the company.",
                            "target_lang_translations": {
                                "ru": "Нам <w>ещё</w> предстоит получить ответ от компании.",
                                "zh": "我们<w>尚未</w>收到公司的回复。"
                            }
                        },
                        {
                            "text": "The best performance of the night is <w>yet</w> to come.",
                            "target_lang_translations": {
                                "ru": "Лучшее выступление вечера <w>ещё</w> впереди.",
                                "zh": "今晚最精彩的表演<w>还</w>在后面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have yet to",
                        "be yet to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что действие еще не совершено, но должно произойти в будущем.",
                        "zh": "指某事在特定时间点尚未发生或完成，通常暗示其应该发生或将来会发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "предстоит сделать"
                            },
                            {
                                "target_lang_word": "всё ещё",
                                "target_lang_sense_clarification": "до сих пор не"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尚未",
                                "target_lang_sense_clarification": "书面语，表示还没"
                            },
                            {
                                "target_lang_word": "还没",
                                "target_lang_sense_clarification": "口语，表示尚未"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a231d56-770e-3e5b-a6dc-01df7c44538d",
                    "sense_definition": "Used with comparative adjectives or adverbs to emphasize a greater degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation became <w>yet</w> worse when it started to rain.",
                            "target_lang_translations": {
                                "ru": "Ситуация стала <w>ещё</w> хуже, когда начался дождь.",
                                "zh": "下雨后情况变得<w>更</w>糟了。"
                            }
                        },
                        {
                            "text": "He spoke in a <w>yet</w> louder voice to be heard over the noise.",
                            "target_lang_translations": {
                                "ru": "Он заговорил <w>ещё</w> громче, чтобы его было слышно сквозь шум.",
                                "zh": "他用<w>更</w>大的声音说话，以便在嘈杂声中被听到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "still"
                    ],
                    "common_phrases": [
                        "yet more",
                        "yet higher",
                        "yet better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется со сравнительной степенью прилагательных или наречий для усиления значения.",
                        "zh": "与比较级形容词或副词连用，用于强调程度更深。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "со сравнительной степенью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更",
                                "target_lang_sense_clarification": "用于比较级"
                            },
                            {
                                "target_lang_word": "更加",
                                "target_lang_sense_clarification": "用于强调程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81e36581-6161-3367-9988-bb842917ac3e",
                    "sense_definition": "In addition; used to emphasize an increase in number or quantity, or a repetition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought <w>yet</w> another pair of shoes yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она купила <w>ещё</w> одну пару обуви.",
                                "zh": "她昨天<w>又</w>买了一双鞋。"
                            }
                        },
                        {
                            "text": "He made <w>yet</w> another mistake in his report.",
                            "target_lang_translations": {
                                "ru": "Он допустил <w>ещё</w> одну ошибку в своем отчете.",
                                "zh": "他在报告中<w>又</w>犯了一个错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "additionally",
                        "besides",
                        "further",
                        "moreover"
                    ],
                    "common_phrases": [
                        "yet another",
                        "yet again"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вдобавок; используется для подчеркивания увеличения количества или повторения действия.",
                        "zh": "此外；用于强调数量的增加或动作的重复。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "дополнительно"
                            },
                            {
                                "target_lang_word": "очередной",
                                "target_lang_sense_clarification": "ещё один"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "又",
                                "target_lang_sense_clarification": "表示重复或增加"
                            },
                            {
                                "target_lang_word": "再",
                                "target_lang_sense_clarification": "表示进一步增加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d7a6c60-ecc8-39d6-9eec-ae900b946ae3",
                    "sense_definition": "At some future time; eventually.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We may <w>yet</w> win this competition if we work hard.",
                            "target_lang_translations": {
                                "ru": "Мы <w>ещё</w> можем выиграть это соревнование, если будем усердно работать.",
                                "zh": "如果我们努力，我们<w>还是</w>有可能赢得这场比赛。"
                            }
                        },
                        {
                            "text": "The mystery of the missing painting will be solved <w>yet</w>.",
                            "target_lang_translations": {
                                "ru": "Тайна пропавшей картины <w>всё же</w> будет разгадана.",
                                "zh": "失踪画作的谜团<w>终究</w>会被解开。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eventually",
                        "in time",
                        "sooner or later",
                        "at last"
                    ],
                    "common_phrases": [
                        "may yet",
                        "will yet"
                    ],
                    "target_lang_definitions": {
                        "ru": "В будущем; в конечном счете; когда-нибудь.",
                        "zh": "在未来的某个时间；最终。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "в будущем"
                            },
                            {
                                "target_lang_word": "всё же",
                                "target_lang_sense_clarification": "в конечном счете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终究",
                                "target_lang_sense_clarification": "最终会发生"
                            },
                            {
                                "target_lang_word": "还是",
                                "target_lang_sense_clarification": "表示最终结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fae1acd-36bf-395a-9d4c-649a6543d387",
                    "sense_definition": "Continuously up to the present time; still.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While he was <w>yet</w> a young man, he became famous throughout the land.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>ещё</w> молодым человеком, он прославился на всю страну.",
                                "zh": "他<w>尚</w>在年轻时就已名扬全国。"
                            }
                        },
                        {
                            "text": "The ancient traditions are <w>yet</w> observed in this remote village.",
                            "target_lang_translations": {
                                "ru": "Древние традиции <w>до сих пор</w> соблюдаются в этой отдаленной деревне.",
                                "zh": "在这个偏远的村庄里，古老的传统<w>依然</w>被遵守着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "still",
                        "even now"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly literary or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывно до настоящего времени; всё ещё (устаревшее или книжное).",
                        "zh": "持续到目前为止；仍然（多用于文学或古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё ещё",
                                "target_lang_sense_clarification": "по-прежнему"
                            },
                            {
                                "target_lang_word": "до сих пор",
                                "target_lang_sense_clarification": "доныне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尚",
                                "target_lang_sense_clarification": "书面语，表示仍然"
                            },
                            {
                                "target_lang_word": "依然",
                                "target_lang_sense_clarification": "表示状态持续"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "bc9b53fb-c3ef-31dd-89de-5c536c79759a",
                    "sense_definition": "In spite of that; nevertheless; used to introduce a contrasting statement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a small car, <w>yet</w> it is surprisingly spacious inside.",
                            "target_lang_translations": {
                                "ru": "Это маленькая машина, <w>однако</w> внутри она удивительно просторная.",
                                "zh": "这车很小，<w>然而</w>内部空间却出奇地宽敞。"
                            }
                        },
                        {
                            "text": "He studied very hard, <w>yet</w> he failed the exam.",
                            "target_lang_translations": {
                                "ru": "Он очень усердно учился, <w>и всё же</w> провалил экзамен.",
                                "zh": "他学习非常刻苦，<w>但</w>还是没通过考试。"
                            }
                        },
                        {
                            "text": "The story was simple <w>yet</w> effective.",
                            "target_lang_translations": {
                                "ru": "История была простой, <w>но</w> эффективной.",
                                "zh": "这个故事简单<w>却</w>很有效。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nevertheless",
                        "even so",
                        "be that as it may",
                        "but",
                        "still"
                    ],
                    "common_phrases": [
                        "and yet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тем не менее; однако; используется для введения противопоставления.",
                        "zh": "尽管如此；然而；用于引出转折性的陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "однако",
                                "target_lang_sense_clarification": "противопоставление"
                            },
                            {
                                "target_lang_word": "но",
                                "target_lang_sense_clarification": "союз"
                            },
                            {
                                "target_lang_word": "тем не менее",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "всё же",
                                "target_lang_sense_clarification": "усиление противопоставления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然而",
                                "target_lang_sense_clarification": "表示转折"
                            },
                            {
                                "target_lang_word": "但是",
                                "target_lang_sense_clarification": "表示对比"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}