                "senses": [
                    {
                        "sense_id": "84fc41a5-a27a-3750-80d3-9e8b1885881b",
                        "entry_id": "6792728a-2aad-367a-9896-190666f65108",
                        "glosses": [
                            "transdisziplinär, fächerübergreifend"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7377e521-f30a-4702-8c1a-dff4b896f1d7",
                        "source_entry_id": "6792728a-2aad-367a-9896-190666f65108",
                        "source_sense_id": "84fc41a5-a27a-3750-80d3-9e8b1885881b",
                        "source_sense_description": "Wissenschaft: transdisziplinär, fächerübergreifend",
                        "target_lang_word": "transdisziplinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transdisziplinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                        "entry_id": "3c914d33-37d6-3642-8972-913176995f7f",
                                        "glosses": [
                                            "mehrere Fachbereiche betreffend; oder sogar zwischen den Fachbereichen ohne strenge Abgrenzung liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29d7c61-7f82-48cb-b5e9-06bd468e492b",
                                                "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                                "text": "„Ein interdisziplinäres Vorgehen wird ‚transdisziplinär‘ genannt, wenn es tatsächlich integrationsorientiert ist.“"
                                            },
                                            {
                                                "example_id": "9c425986-110b-4e43-b555-a5db4efab51d",
                                                "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                                "text": "„Nur auf diesem transdisziplinären Wege ist es möglich, die Linguistik und ihr Untersuchungsobjekt ‚Sprache‘ adäquat zu definieren.“"
                                            },
                                            {
                                                "example_id": "a863a030-9bcf-4a88-a278-0567dae95304",
                                                "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                                "text": "„Wie kann gewährleistet werden, dass nicht nur transdisziplinär gearbeitet, sondern auch das disziplinäre Fachwissen gepflegt wird, wenn keine disziplinären Module existieren?“"
                                            },
                                            {
                                                "example_id": "96d16bc1-9569-461e-82be-63574b608a25",
                                                "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                                "text": "„Da Medien sui generis disziplinen- und fächerübergreifend sind, […] muss auch die Medienökonomie in ihrem Kern transdisziplinär angelegt sein.“"
                                            },
                                            {
                                                "example_id": "d9389685-ab00-4fc2-bb31-052f0081f3ba",
                                                "sense_id": "d99a35d9-3a05-351c-9a03-f04e82532c23",
                                                "text": "„Als eine notwendige Bedingung dafür, um überhaupt transdisziplinär arbeiten zu können, sollte das Bewusstsein für die Grenzen der eigenen Disziplin vorhanden sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d29c313e-bdbf-31ff-9fe1-b8ada94d1be8",
                                        "entry_id": "3c914d33-37d6-3642-8972-913176995f7f",
                                        "glosses": [
                                            "mehrere Fachbereiche und ein Zusammenspiel zwischen Wissenschaft und Nichtwissenschaftlern (wie die Gesellschaft) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0507ca8e-c0ff-44e8-91d7-228931403341",
                                                "sense_id": "d29c313e-bdbf-31ff-9fe1-b8ada94d1be8",
                                                "text": "„Eine interdisziplinäre Kooperation, an der Anwenderinnen und Anwender substantiell beteiligt sind, überschreitet die Grenzen des Wissenschaftssystems und wird deshalb ‚transdisziplinär‘ genannt.“"
                                            },
                                            {
                                                "example_id": "6e3653c5-cbd3-41d0-a424-cc81783687a6",
                                                "sense_id": "d29c313e-bdbf-31ff-9fe1-b8ada94d1be8",
                                                "text": "„Innerhalb dieses Verständnisses geht transdisziplinäre Forschung von gesellschaftlichen Problemstellungen aus, jedoch nicht von Fragen, die ausschließlich wissenschaftsinternen Diskursen entspringen.“"
                                            },
                                            {
                                                "example_id": "d04f0cfd-177a-4b4a-aefe-1604099ee791",
                                                "sense_id": "d29c313e-bdbf-31ff-9fe1-b8ada94d1be8",
                                                "text": "„Charakteristisch für transdisziplinäre Projekte ist einerseits das Überschreiten von Disziplingrenzen, andererseits das Zusammenspiel von gesellschaftlich-politischen und wissenschaftlich-analytischen Entscheidungs- bzw. Problemlösungsprozessen.“"
                                            },
                                            {
                                                "example_id": "3942868f-8393-432f-ab4f-8ba955af7bdc",
                                                "sense_id": "d29c313e-bdbf-31ff-9fe1-b8ada94d1be8",
                                                "text": "„Transdisziplinär wird das Unterfangen erst, wenn diejenigen mitzumischen beginnen, die mit dem Problem als Nichtwissenschaftler zu tun haben (als unmittelbar und mittelbar Betroffene, als stakeholder).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2026abb-9de3-466f-96da-8522fd6c39c4",
                        "source_entry_id": "6792728a-2aad-367a-9896-190666f65108",
                        "source_sense_id": "84fc41a5-a27a-3750-80d3-9e8b1885881b",
                        "source_sense_description": "Wissenschaft: transdisziplinär, fächerübergreifend",
                        "target_lang_word": "fächerübergreifend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fächerübergreifend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                        "entry_id": "0b2191a8-818e-3af5-8490-b4d553b29085",
                                        "glosses": [
                                            "eine Reihe von Disziplinen betreffend/umfassend; Fachgrenzen übersteigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9de943-26e0-4853-8003-b77b8039ba76",
                                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                                "text": "„Lange Zeit haben fächerübergreifende Projekte den Sportunterricht eher selten einbezogen […].“"
                                            },
                                            {
                                                "example_id": "e777c600-61fa-46f5-ac5f-815009ae1bbe",
                                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                                "text": "„Fächerübergreifende Themenbereiche ergeben sich für den Unterricht am häufigsten dadurch, dass ein Fach sich bei einer Fragestellung in kritischer Selbsteinschätzung mit seinen methodischen Möglichkeiten bzw. in seiner Materialerfahrung überfordert sieht.“"
                                            },
                                            {
                                                "example_id": "089524c6-026f-4b4c-9a4a-5d79ee8f44ed",
                                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                                "text": "„Interdisziplinäres Lernen und fächerübergreifende Projekte dürften dazu fast besser geeignet sein als ein zusätzliches Schulfach.“"
                                            },
                                            {
                                                "example_id": "f03ae382-4066-4f8d-8c68-f69aa135a9fe",
                                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                                "text": "„Von den Natur-, Ingenieur-, Sozial- und Geisteswissenschaften bis zur Lehrerbildung setzt die Universität schon immer auf fächerübergreifende Zusammenarbeit.“"
                                            },
                                            {
                                                "example_id": "6fd4b58c-e455-41ee-b774-b20d3aec2cba",
                                                "sense_id": "cd921cc3-7107-3253-9a2f-0a7989138cee",
                                                "text": "„Fachübergreifende Themen wie Finanzkrise, Fachkräftemangel, Migration oder ethisches Handeln erfordern interdisziplinäre Kenntnisse, um umfassend erforscht werden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
