                "senses": [
                    {
                        "sense_id": "ed6d15d6-ca47-33c2-b3ee-20e1329d9e47",
                        "entry_id": "15c5b2c7-471d-3752-9876-538d8d2e9b80",
                        "glosses": [
                            "eine der auf den Sparren befestigten Holzlatten, die die Dachdeckung tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f977ea8a-34c8-48d5-8cf0-bdd387b74236",
                                "sense_id": "ed6d15d6-ca47-33c2-b3ee-20e1329d9e47",
                                "text": "So kostete etwa eine Dachlatte zu Beginn des Jahrhunderts [1700] für das Kornhaus in Brugg 1¾ Batzen."
                            },
                            {
                                "example_id": "fb11d07d-5b7a-4a64-b2f1-13cfa4086136",
                                "sense_id": "ed6d15d6-ca47-33c2-b3ee-20e1329d9e47",
                                "text": "Seit Wochen denke ich, du wartest sehnlich auf eine Gelegenheit, dass du mich endlich mal küssen kannst, und jetzt bettle ich geradezu um einen Kuss von dir, und du stehst so regungslos da wie eine Dachlatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6120ea-06e8-4b01-ad9c-6af07e51ffb1",
                        "source_entry_id": "15c5b2c7-471d-3752-9876-538d8d2e9b80",
                        "source_sense_id": "ed6d15d6-ca47-33c2-b3ee-20e1329d9e47",
                        "source_sense_description": "eine der auf den Sparren befestigten Holzlatten, die die Dachdeckung tragen",
                        "target_lang_word": "volige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                        "entry_id": "8cf54db5-3cd9-3f80-91fa-eaa15e665f6a",
                                        "glosses": [
                                            "Planche mince de bois de sapin ou d’autre bois blanc, sur laquelle les couvreurs fixent les matériaux de couverture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a24b3a-ee23-4f87-9e0a-0aa7a719b101",
                                                "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                                "text": "Ah ! çà, que voulez-vous donc, vous autres, pour femmes ?… des voliges !… cria la pauvre Esther."
                                            },
                                            {
                                                "example_id": "0ff15fe0-99ec-4c8c-be73-1bdc230e5baa",
                                                "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                                "text": "C’était là un coin charmant, une sorte de niche, sous la pointe du pignon, que fermaient des voliges, remplacées au commencement de ce siècle."
                                            },
                                            {
                                                "example_id": "34292ba8-6483-4c14-9a94-7b9606d267ab",
                                                "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                                "text": "Le bruit que fit la clef en tournant dans la serrure, une volige du parquet qui geignit sous le tapis lorsqu’elle traversa le vestibule, d’autres craquements familiers, ceux-là mêmes qui accompagnaient les retours de Michel, la nuit, lui annoncèrent clairement la déroute de son sang-froid."
                                            },
                                            {
                                                "example_id": "7f3f549a-69ea-48b7-a589-b42cae30005b",
                                                "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                                "text": "Sur une volige de pin, on a écrit au feutre noir un diminutif – CHRIS – et une date – 10/12/16. Trois ans déjà."
                                            },
                                            {
                                                "example_id": "141d1ae9-af10-4f98-90fc-8aceec3affb7",
                                                "sense_id": "8b0538c3-66e7-3e8e-9434-c6fe5250c8f4",
                                                "text": "Sans un mot, ils contemplent le bois brisé, repêchent quelques autres tasseaux et voliges."
                                            }
                                        ]
                                    }
                                ]
                            },
