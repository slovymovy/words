                "senses": [
                    {
                        "sense_id": "c1bdb018-a12a-3c4c-a6b9-0a6622a6e374",
                        "entry_id": "56e1ba59-c7ff-31d4-b252-b03278e32b48",
                        "glosses": [
                            "склонность проявлять заботу, то есть внимание, сочувствие, желание помочь."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f9c1ca-f49e-4370-b397-eee6b3a79a75",
                                "sense_id": "c1bdb018-a12a-3c4c-a6b9-0a6622a6e374",
                                "text": "Мельничиха стряхивает с меня пыль с несколько назойливой заботливостью и широко улыбается."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3b15b0d-0231-490f-a04a-2f48c49bd3ae",
                        "source_entry_id": "56e1ba59-c7ff-31d4-b252-b03278e32b48",
                        "source_sense_id": "c1bdb018-a12a-3c4c-a6b9-0a6622a6e374",
                        "target_lang_word": "Fürsorge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürsorge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "Einsatz/Bemühung zugunsten Hilfsbedürftiger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fa9372-60ce-4835-a3dd-8c6b80e7eb02",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Der Begriff Fürsorge wurde in den 60er Jahren durch die Begriffe Sozialarbeit/Sozialpädagogik und Soziale Arbeit abgelöst.“"
                                            },
                                            {
                                                "example_id": "7756679e-0fa9-4482-b858-15886926d88f",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Seine Ehrlichkeit und seine Fürsorge für die Gefangenen waren beispielhaft.“"
                                            },
                                            {
                                                "example_id": "f7217ff7-6a8a-4307-b5f0-1c13be73f273",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Alles ist neu und beseligend, Wärme und Stille und Bücher und Worte der Freunde, die Fürsorge der Wirtin, das heiße Bad, das Bett.“"
                                            },
                                            {
                                                "example_id": "e88bc4af-e511-450c-a724-734c9cd0200e",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Ebenso wie die übrigen hoffnungslos Verwundeten wurde auch Fürst Andrej dann der Fürsorge der Zivilbevölkerung überlassen.“"
                                            },
                                            {
                                                "example_id": "18285038-8d1d-46a2-bb7b-e5165fc8cbdd",
                                                "sense_id": "a0279cd5-8a0c-38d9-bf5f-006bd8ccdbc0",
                                                "text": "„Der Stiefbruder, die Schwägerin und Rotermund amüsierten sich über die Fürsorge der Mutter, die, wie die Schwägerin sagte, da ausgebreitet vor ihnen auf dem Tisch lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1ab0a1b-f515-3305-bdd7-9919685a7201",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "öffentliche Einrichtung zur Betreuung von Hilfsbedürftigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b74782-a3c8-4ca3-a69b-2428755c5d99",
                                                "sense_id": "e1ab0a1b-f515-3305-bdd7-9919685a7201",
                                                "text": "Wenn du den Jungen nicht in den Griff bekommst, müssen wir die Fürsorge einschalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b4fa902e-11cd-3cb1-9e0a-59a37ff5c898",
                                        "entry_id": "32db3673-bd51-3390-9fde-b67cc1cdd5e2",
                                        "glosses": [
                                            "finanzielle Unterstützung für Bedürftige durch das Sozialamt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02369190-0425-4080-89a0-e81ab90ba5d9",
                                                "sense_id": "b4fa902e-11cd-3cb1-9e0a-59a37ff5c898",
                                                "text": "Sehr vielen war es peinlich, von Fürsorge leben zu müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
