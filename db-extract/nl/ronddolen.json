        "nl-extract.jsonl": [
            {
                "entry_id": "353f8181-2fd9-30c8-b71f-d48efcbaa27d",
                "word": "ronddolen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f8a79fc-f481-3636-a35c-33cb30333e21",
                        "entry_id": "353f8181-2fd9-30c8-b71f-d48efcbaa27d",
                        "glosses": [
                            "zonder duidelijk doel of richting ergens bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83acc83c-4337-490f-b008-df3fdbf67dbd",
                                "sense_id": "8f8a79fc-f481-3636-a35c-33cb30333e21",
                                "text": "\"Het ronddolen in en het bestuderen van de natuur geeft kracht aan allen, die geestelijk en lichamelijk lijden.\""
                            },
                            {
                                "example_id": "9c662d7b-a9f9-4a0a-8f7d-866fcf7c2d26",
                                "sense_id": "8f8a79fc-f481-3636-a35c-33cb30333e21",
                                "text": "Zwangere vrouwen en moeders met jonge kinderen die ronddolen in een provisorisch kamp aan de Grieks-Macedonische grens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f11bb23-aa28-431f-a170-c747cb15bdb4",
                        "source_entry_id": "353f8181-2fd9-30c8-b71f-d48efcbaa27d",
                        "source_sense_id": "8f8a79fc-f481-3636-a35c-33cb30333e21",
                        "target_lang_word": "wander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To move without purpose or specified destination; often in search of livelihood."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50bef212-d917-40c7-9b41-1f3dcf5d0353",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "to wander over the fields"
                                            },
                                            {
                                                "example_id": "a34ad41c-a998-408b-b8e6-6fae4a483fa2",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "They wandered about in sheepskins and goatskins."
                                            },
                                            {
                                                "example_id": "d339462f-1e07-4d6f-a94f-702046e3bc8d",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            },
                                            {
                                                "example_id": "5109c281-d04c-48c0-acf3-039f56a0f7f1",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To stray; stray from one's course; err."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676aff6b-a901-4212-b7ac-fe927db6541d",
                                                "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                                "text": "A writer wanders from his subject."
                                            },
                                            {
                                                "example_id": "37612ef7-c5eb-4bc1-b4a2-0fb7490f11c6",
                                                "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                                "text": "O, let me not wander from thy commandments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1191d1-bd22-36d6-897d-6abca95ca5d9",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To commit adultery."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0a0449a-8a0d-3e71-96e9-d64aae5269f2",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To go somewhere indirectly or at varying speeds; to move in a curved path."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "132b2d13-cde1-3959-8821-99b01a5b7ca1",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "Of the mind, to lose focus or clarity of argument or attention."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3c3096-f526-3b2d-9d89-dce57ff0f5b7",
                                        "entry_id": "dc28301d-8916-3566-a093-c7f7d5b7445d",
                                        "glosses": [
                                            "An act or instance of wandering."
                                        ],
