                                                "sense_id": "59c1b114-c8c2-3a3b-b800-0b8a82fbf309",
                                                "text": "dean of the diplomatic corps - a country's most senior ambassador"
                                            },
                                            {
                                                "example_id": "10ce639a-35ba-468e-be83-c1e3b99e4498",
                                                "sense_id": "59c1b114-c8c2-3a3b-b800-0b8a82fbf309",
                                                "text": "dean of the House - the longest-serving member of a legislature"
                                            },
                                            {
