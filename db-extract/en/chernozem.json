                    },
                    {
                        "translation_id": "b6c0f817-afd1-4f8c-a1dc-7da40499f21f",
                        "source_entry_id": "7934fc49-cd43-3efd-970c-273594ff8cad",
                        "source_sense_id": "e87bb3c6-8c1d-3dcf-88e7-b96bf912b0e6",
                        "source_sense_description": "black-coloured soil containing a high percentage of humus",
