                "senses": [
                    {
                        "sense_id": "760284d0-2506-30e3-a49b-453bdb4a8fa9",
                        "entry_id": "84747d81-0e4d-3e4a-bab6-6d88c3d1433b",
                        "glosses": [
                            "Ansatz für eine Theorie der Quantengravitation, also einer Theorie zur Vereinigung der Quantenphysik mit der Allgemeinen Relativitätstheorie."
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "84da89af-e6a4-4d45-86e1-5c013cddbf53",
                                "sense_id": "760284d0-2506-30e3-a49b-453bdb4a8fa9",
                                "text": "„2006 wurde er Assistant Professor am Institut für Gravitation und Kosmologie (Institute for Gravitation and the Cosmos, IGC) der Pennsylvania State University bei Abhay Vasant Ashtekar, einem der Pioniere der Schleifen-Quantengravitation.“"
                            },
                            {
                                "example_id": "ad79f1d0-9bec-4125-9546-6fd72f036f73",
                                "sense_id": "760284d0-2506-30e3-a49b-453bdb4a8fa9",
                                "text": "„Die Schleifen-Quantengravitation wurde entwickelt, um Quantenphysik und die allgemeine Relativitätstheorie zu vereinigen - sie ist eine wichtige Alternative zur Stringtheorie.“"
                            },
                            {
                                "example_id": "036aec92-b80d-476b-a919-576c20e8f7f6",
                                "sense_id": "760284d0-2506-30e3-a49b-453bdb4a8fa9",
                                "text": "„Derzeit zanken zwei Denkschulen – die Stringtheorie und die Schleifen-Quantengravitation – um den richtigen Ansatz. Doch beiden mangelt es an Beweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
