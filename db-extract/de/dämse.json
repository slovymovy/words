                                        "entry_id": "a4c4bbf1-22b7-393a-b4d5-223ce360a47f",
                                        "glosses": [
                                            "The characteristic of being muggy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbc7aff-c29a-4a89-92c0-1ff4d9e0fb07",
                                                "sense_id": "a3d61869-819c-3e8f-8abd-1459a359c9b0",
                                                "text": "They found that their subjects started overheating dangerously at much lower “wet-bulb” temperatures—a measure that accounts for both heat and mugginess—than what they had expected based on previous theoretical estimates by climate scientists."
                                            }
                                        ]
                                    }
