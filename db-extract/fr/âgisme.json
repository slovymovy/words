                                        "entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                                        "glosses": [
                                            "The treating of a person or people, especially older people, differently from others based on assumptions, prejudices or/and stereotypes relating to their age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6bb0f25-e9ea-4706-8944-a68089029409",
                                                "sense_id": "ecaea233-230c-3e5c-8774-d6829cc2d6b2",
                                                "text": "But a half-hour into this third Democratic debate, many Democrats had to be wondering: Can he [Joe Biden] go three hours? It’s our own collective ageism."
                                            }
