                "senses": [
                    {
                        "sense_id": "511b689e-a699-3716-a79b-3d27da8485d2",
                        "entry_id": "de37c8ff-3d9f-33fa-8c3b-2f21295a4efb",
                        "glosses": [
                            "Se blâmer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674f486f-0d19-4676-905b-902ef8afb44e",
                                "sense_id": "511b689e-a699-3716-a79b-3d27da8485d2",
                                "text": "Comment pouvait-il logiquement, sans risquer de s’autoblâmer, condamner ces agissements ?"
                            },
                            {
                                "example_id": "a5b67a28-90bb-40cf-900f-4cc394fcad83",
                                "sense_id": "511b689e-a699-3716-a79b-3d27da8485d2",
                                "text": "Il s’agit d’une échelle de coping valide et fidèle qui permet d’évaluer trois types de stratégies de coping : le coping centré sur le problème (essyaer de résoudre le problème, suivre un plan d’action, trouver des solutions, etc.), le coping centré sur l’émotion (éviter, s’autoblâmer, se culpabiliser, avoir recours à la pensée magique, etc.) et la recherche de soutien social (rechercher de l’aide et/ou des informations, exprimer ses émotions, etc.)."
                            }
                        ]
                    }
