                ],
                "senses": [
                    {
                        "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                        "entry_id": "7e3e250d-797c-3666-adcd-9cbe1efa19cb",
                        "glosses": [
                            "The shape, outline, or boundary of a coast. (The term coastline is generally used to describe the approximate boundaries at relatively large spatial scales.)"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "312abb48-3403-4bad-9a80-85ccba2e84f2",
                                "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                                "text": "The sweep of the rocky Southern California coastline off Point Fermin."
                            },
                            {
                                "example_id": "5710e478-7dee-494f-918a-2443b13de4cd",
                                "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                                "text": "Tarbarrels and bonfires were lighted along the coastline of the four seas on the summits of the Hill of Howth, Three Rock Mountain, Sugarloaf, Bray Head, the mountains of Mourne, the Galtees, the Ox and Donegal and Sperrin peaks, the Nagles and the Bograghs, the Connemara hills, the reeks of M’ Gillicuddy, Slieve Aughty, Slieve Bernagh and Slieve Bloom."
                            },
                            {
                                "example_id": "a2eac488-1bc6-4006-9c54-a2e0c4eb180f",
                                "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                                "text": "With the sea below us grey and storm swept, and the coast line vague in the driving rain, we forged our way up the bank to breast the summit at 37 m.p.h."
                            },
                            {
                                "example_id": "7405e75a-cdf4-4194-b2bf-a42e8c2e7be9",
                                "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                                "text": "The journey is worth an article in itself, but all I can give is a flavour of a railway which traverses a bleak but dramatic coastline that's regularly battered by the elements - especially around Parton, where the line is constantly threatened by the sea."
                            },
                            {
                                "example_id": "8ecaea4c-bd66-4a58-ac83-92e9949797c6",
                                "sense_id": "69071d64-0429-34ff-90f2-8f5e8b70d76d",
                                "text": "The 71-year-old American, who relocated to the Indonesian destination in 2022, is a regular fixture on the sands of Sanur, which extends along the southeastern coastline of the tropical destination, known as the “Island of the Gods.”"
                            }
                        ]
                    }
                ],
