                ],
                "senses": [
                    {
                        "sense_id": "740df0ab-436f-38f6-8f42-62d39fa5d8e2",
                        "entry_id": "3f92fbe6-8bef-34ce-a957-91e08e405c13",
                        "glosses": [
                            "En état de nudité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cf3dd6-8164-4f22-a0f3-98a7ae434f97",
                                "sense_id": "740df0ab-436f-38f6-8f42-62d39fa5d8e2",
                                "text": "Les animaux ne pouvant ni se vêtir, ni s'abriter, ni faire usage de l'élément du feu pour se réchauffer, ils demeurent nûment exposés, et pleinement livrés à l'action de l'air et à toutes les intempéries du climat."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f9f9e5c-8dab-3183-8ae7-7924b6d0f98c",
                        "entry_id": "3f92fbe6-8bef-34ce-a957-91e08e405c13",
                        "glosses": [
                            "Simplement, crûment, franchement, sans déguisement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f02c2aa-f2a5-4f97-a4e8-1e92a152d2f8",
                                "sense_id": "2f9f9e5c-8dab-3183-8ae7-7924b6d0f98c",
                                "text": "Je vous dirai nûment la vérité. - Je vous conterai nûment le fait."
                            },
                            {
                                "example_id": "e806d13d-43d6-46e5-b2d0-3e4367fc1259",
                                "sense_id": "2f9f9e5c-8dab-3183-8ae7-7924b6d0f98c",
                                "text": "Au nom du ciel, après un peintre comme Monet, qui est tout bonnement un génie, n’allez pas nommer un vieux poncif sans talent comme Poussin. Je vous dirai tout nûment que je le trouve le plus barbifiant des raseurs. Qu’est-ce que vous voulez, je ne peux pourtant pas appeler cela de la peinture."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bcd1d0d-c328-318d-8806-e58637880c98",
                        "entry_id": "3f92fbe6-8bef-34ce-a957-91e08e405c13",
                        "glosses": [
                            "Immédiatement, sans intermédiaire, directement."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "af49845c-1420-4429-b008-facdd6861137",
                                "sense_id": "4bcd1d0d-c328-318d-8806-e58637880c98",
                                "text": "Ce domaine dépend nûment du comté."
                            }
                        ]
                    }
                ],
