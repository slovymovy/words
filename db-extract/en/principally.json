                "senses": [
                    {
                        "sense_id": "1d3c3dd2-ffaf-3b24-96d6-66e6d1b7fe6f",
                        "entry_id": "302092db-6ca8-30ce-bb00-5421f3491eb2",
                        "glosses": [
                            "In a primary manner; pertaining to the principal of a matter."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a438b285-8e02-4de8-9e9e-1a95ec6a127e",
                                "sense_id": "1d3c3dd2-ffaf-3b24-96d6-66e6d1b7fe6f",
                                "text": "The game principally consists in taking and carrying off the ball from the opposite party, after being hurled into the air midway between two high pillars, which are the goasl, and the party who bears off the ball to their pillar, wins the game[…]"
                            },
                            {
                                "example_id": "586f093a-4a08-4718-867d-09e33420c313",
                                "sense_id": "1d3c3dd2-ffaf-3b24-96d6-66e6d1b7fe6f",
                                "text": "Timber, hides, furs, and minerals from the north, and grain and other products from the south and the immediate vicinity of the town itself are brought, principally by river, to this point, where the railway cuts the great central waterway of Siberia."
                            },
                            {
                                "example_id": "c26eb127-3bbf-4279-8d3f-63938f7b64a6",
                                "sense_id": "1d3c3dd2-ffaf-3b24-96d6-66e6d1b7fe6f",
                                "text": "When asked to guess whether champagnes they were drinking was made principally from white or black grapes, most tasters including wine writers and journalists were unable to tell the difference."
                            },
                            {
                                "example_id": "e8bacc44-5936-4639-9840-ac198e0befcb",
                                "sense_id": "1d3c3dd2-ffaf-3b24-96d6-66e6d1b7fe6f",
                                "text": "Pollination by animals, principally insects and birds, is widespread among plants."
                            }
                        ]
                    }
