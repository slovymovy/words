                        "entry_id": "390896f1-e219-34f2-a7f0-24ef655434ba",
                        "glosses": [
                            "een houten of metalen stang voor een voertuig aan weerszijden waarvan trekdieren ingespannen kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1228cc99-90a7-4c2f-b886-075b6b09abf1",
                                "sense_id": "8144464f-468f-3705-bb24-0bd9f44f1f90",
                                "text": "Aan de dissel werden twee trekpaarden vastgemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "5edd246a-6cfb-3a53-96ae-6250d3689867",
                        "entry_id": "390896f1-e219-34f2-a7f0-24ef655434ba",
                        "glosses": [
                            "een stang of buis waarmee een aanhangwagen aan een auto of vrachtwagen bevestigd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e560eef4-9d3b-411b-add6-dcd68f0481f4",
                                "sense_id": "5edd246a-6cfb-3a53-96ae-6250d3689867",
                                "text": "Als de aanhangwagen slechts één as heeft is de dissel vast bevestigd aan de aanhanger."
                            }
                        ]
                    },
