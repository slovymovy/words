        "fr-extract.jsonl": [
            {
                "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                "word": "prélude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6be83368-00c0-4fb4-af3c-b0d419b8df71",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "tags": [
                            "plural"
                        ],
                        "form": "préludes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1767bcf-1b03-3b3c-acf8-8a4c9135f77c",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "glosses": [
                            "Ce qui précède quelque chose et qui lui sert comme d’entrée et de préparation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf3b6e13-f639-4502-9a5b-f7c610245e4b",
                                "sense_id": "c1767bcf-1b03-3b3c-acf8-8a4c9135f77c",
                                "text": "Pendant cette même journée du 10, qui était le prélude de la grande bataille du lendemain, l’ennemi avait continué ses attaques sur le 21ᵉ corps."
                            },
                            {
                                "example_id": "1f53818a-992f-4ba9-8a32-49f1553f4a06",
                                "sense_id": "c1767bcf-1b03-3b3c-acf8-8a4c9135f77c",
                                "text": "S’attendant à la paire de claques, prélude de la raclée, l’avant-bras déjà presque levé pour la parade habituelle, Camus en demeura un instant muet de stupéfaction."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bac55eb-292c-3d97-b569-f929e08730e7",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "glosses": [
                            "Ce qu’on improvise sur un instrument pour se mettre dans le ton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcde905-088b-48ac-9579-6ad7e5e672f9",
                                "sense_id": "5bac55eb-292c-3d97-b569-f929e08730e7",
                                "text": "Quelques mesures de prélude."
                            }
                        ]
                    },
                    {
                        "sense_id": "3041c797-eaea-3aa6-bd62-296f678c1718",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "glosses": [
                            "Certaines compositions musicales qui forment le début d’une œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f1959a-4c83-465f-9d9f-b1cfb08b6ad2",
                                "sense_id": "3041c797-eaea-3aa6-bd62-296f678c1718",
                                "text": "Vous entendez les hautbois ? Ils jouent le prélude de Lohengrin et se répondent d'une tour à l'autre de mon château."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d3d1aea-924a-3623-a2f5-eaad32bbbf2e",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "glosses": [
                            "Pièces qui constituent à elles seules un tout."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cd238f6c-4331-4df4-9b44-1f1de405ab77",
                                "sense_id": "7d3d1aea-924a-3623-a2f5-eaad32bbbf2e",
                                "text": "Les préludes de Chopin."
                            }
                        ]
                    },
                    {
                        "sense_id": "969fdc1e-027d-3e8e-8f7c-47e4036f61f7",
                        "entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "glosses": [
                            "Verrouillage de l'accès à une ressource critique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4168fb14-fd48-4435-91a9-ba41ad3788c4",
                                "sense_id": "969fdc1e-027d-3e8e-8f7c-47e4036f61f7",
                                "text": "Pour ce faire, la section critique est précédée par un prélude et est suivie par un postlude qui assurent cette propriété d'exclusion mutuelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b34cf4f-02c2-4143-94dd-347e2ae71ad8",
                        "source_entry_id": "20e3af55-65ce-33c0-bd12-dd4c2962423a",
                        "target_lang_word": "prelude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prelude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8945dbd-fe39-3c76-81bb-1cfa4e43667b",
                                        "entry_id": "5a175b20-b634-3fdc-b5e6-65dbd95de3e3",
                                        "glosses": [
                                            "An introductory or preliminary performance or event."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac8086f3-76e3-37f5-80ed-e31695e38dca",
                                        "entry_id": "5a175b20-b634-3fdc-b5e6-65dbd95de3e3",
                                        "glosses": [
                                            "A short, free-form piece of music, originally one serving as an introduction to a longer and more complex piece; later, starting with the Romantic period, generally a stand-alone piece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dca0288-b895-3363-8349-d1580034ea17",
                                        "entry_id": "5a175b20-b634-3fdc-b5e6-65dbd95de3e3",
                                        "glosses": [
                                            "A standard module or library of subroutines and functions to be imported, generally by default, into a program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13d554d6-a91d-48d5-bbf4-e2ddfe921aee",
                                                "sense_id": "2dca0288-b895-3363-8349-d1580034ea17",
                                                "text": "In the same way that Rust has a general prelude that brings certain types and functions into scope automatically, the std::io module has its own prelude of common types and functions you'll need when working with I/O."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78aa6ff-000a-3099-9ec3-068fc4a7ce47",
                                        "entry_id": "5a175b20-b634-3fdc-b5e6-65dbd95de3e3",
                                        "glosses": [
                                            "A forerunner to anything."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7662fa-d4db-4fc9-87af-89b54bc792bf",
                                                "sense_id": "e78aa6ff-000a-3099-9ec3-068fc4a7ce47",
                                                "text": "Swimmings of the head and intestinal pains seemed the prelude of dissolution."
                                            },
                                            {
                                                "example_id": "6ce3f73f-2fde-4d0b-9630-c7d8c9387ecd",
                                                "sense_id": "e78aa6ff-000a-3099-9ec3-068fc4a7ce47",
                                                "text": "On the other hand, the nationalitarian phenomenon is one in which the struggle against the imperialist powers of occupation has as its object, beyond the clearing of the national territory, the independence and sovereignty of the national State, uprooting in depth the positions of the ex-colonial power— the reconquest of the power of decision in all domains of national life, the prelude to that reconquest of identity which is at the heart of the renaissance undertaken on the basis of fundamental national demands, and ceaselessly contested, by every means available, on every level, and notably on the internal level'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prelude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "753fc8e2-49a5-3955-bf5c-d4d00ebf4c79",
                                        "entry_id": "8a266c20-700c-3086-b6cd-4cc8f9a6ed32",
                                        "glosses": [
                                            "To introduce something, as a prelude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25cfac1b-b970-38e0-b742-a27d48be937b",
                                        "entry_id": "8a266c20-700c-3086-b6cd-4cc8f9a6ed32",
                                        "glosses": [
                                            "To play an introduction or prelude; to give a prefatory performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc5088f9-03f3-42a6-88b5-1a8118591916",
                                                "sense_id": "25cfac1b-b970-38e0-b742-a27d48be937b",
                                                "text": "The musicians preluded on their instruments."
                                            },
                                            {
                                                "example_id": "c2121326-91f0-4cfc-8a79-13a91d84de37",
                                                "sense_id": "25cfac1b-b970-38e0-b742-a27d48be937b",
                                                "text": "We are preluding too largely, and must come at once to the point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
