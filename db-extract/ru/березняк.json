                    },
                    {
                        "translation_id": "8ccd0b6a-72bf-4362-9603-75e158d5f7d4",
                        "source_entry_id": "588851a8-d549-3e3e-8490-5bbfe9a0b9f0",
                        "source_sense_id": "06980043-202d-3b7f-893a-552cc7e4e701",
                        "target_lang_word": "Birkenwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birkenwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14bb92a1-89b2-39be-b268-664f3a324f93",
                                        "entry_id": "a693e7bf-9f46-3b06-ac56-35d3a629e274",
                                        "glosses": [
                                            "Wald, der überwiegend aus Birken besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91fea327-18d5-4e7c-a77a-598df982d978",
                                                "sense_id": "14bb92a1-89b2-39be-b268-664f3a324f93",
                                                "text": "„So kräftig wirken die Sonnenstrahlen auf den mit dünnem Birkenwald bewachsenen Fuß der Felsenseiten.“"
                                            },
                                            {
                                                "example_id": "88096e96-378f-4296-9907-3c061b81cff6",
                                                "sense_id": "14bb92a1-89b2-39be-b268-664f3a324f93",
                                                "text": "„Wir kehrten querfeldein zurück und sahen schon nach kurzer Zeit unseren Birkenwald.“"
                                            },
                                            {
                                                "example_id": "6968f123-114f-4928-98d1-140cdc8ef907",
                                                "sense_id": "14bb92a1-89b2-39be-b268-664f3a324f93",
                                                "text": "„Die Spur führte zwischen einer Böschung und einem Birkenwald den Hügel hinauf.“"
                                            },
                                            {
                                                "example_id": "920a4e90-76df-426c-8157-66543040675e",
                                                "sense_id": "14bb92a1-89b2-39be-b268-664f3a324f93",
                                                "text": "„Es ging durch mit Flechten behangene Birkenwälder, die aufgrund der Höhe und des Breitengrades kümmerlich und gekrümmt wuchsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
