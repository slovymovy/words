                "senses": [
                    {
                        "sense_id": "82e06d5f-7f47-3c4a-93d4-018eb2486a42",
                        "entry_id": "58f54ed1-7eb2-3b1d-854b-64025f23e073",
                        "glosses": [
                            "Person, der ein Garten gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0612f1d-8b3b-4aaf-8e8f-177dcecea807",
                                "sense_id": "82e06d5f-7f47-3c4a-93d4-018eb2486a42",
                                "text": "„Um einen Mähroboter zur Rasenpflege einzusetzen, muss der Gartenbesitzer in der Regel lediglich einen Begrenzungsdraht verlegen.“"
                            },
                            {
                                "example_id": "39baaa3a-8f13-4c06-ab1f-654dd5642f9e",
                                "sense_id": "82e06d5f-7f47-3c4a-93d4-018eb2486a42",
                                "text": "„In Deutschland gibt es spezielle Rechtlinien, die vorschreiben, dass Gartenbesitzer nur während gesetzlich vorgegebenen Zeiten ihre Hecke, Gehölze und Sträucher schneiden, oder den Rasen mähen dürfen.“"
                            },
                            {
                                "example_id": "2582b3e0-782d-4c7c-996d-44ddd00e3ff7",
                                "sense_id": "82e06d5f-7f47-3c4a-93d4-018eb2486a42",
                                "text": "„Je reicher Gartenbesitzer sind, desto größer ist die pflanzliche Vielfalt in ihren Gärten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
