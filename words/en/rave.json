{
    "word_family": [
        "raver",
        "raving",
        "ravingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                    "sense_definition": "To talk with excessive enthusiasm, passion, or excitement about something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The food was so delicious that my friends continued to <w>rave</w> about it for days.",
                            "target_lang_translations": {
                                "ru": "Еда была настолько вкусной, что мои друзья продолжали <w>восторгаться</w> ею несколько дней."
                            }
                        },
                        {
                            "text": "Critics often <w>rave</w> about her performance, calling it the best of the year.",
                            "target_lang_translations": {
                                "ru": "Критики часто <w>расхваливают</w> её игру, называя её лучшей в этом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rave about",
                        "rave on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить о чем-либо с чрезмерным энтузиазмом, страстью или волнением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть в восторге от",
                                "target_lang_sense_clarification": "выражать крайнее восхищение"
                            },
                            {
                                "target_lang_word": "расхваливать",
                                "target_lang_sense_clarification": "сильно хвалить, расточать похвалы"
                            },
                            {
                                "target_lang_word": "восторгаться",
                                "target_lang_sense_clarification": "говорить с большим воодушевлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20e21779-40c5-3908-b518-19f95a878676",
                    "sense_definition": "To attend an all-night dance party featuring electronic music.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rave_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire weekend <w>raving</w> in an old warehouse downtown.",
                            "target_lang_translations": {
                                "ru": "Они провели все выходные, <w>отрываясь на рейвах</w> в старом складском помещении в центре города."
                            }
                        },
                        {
                            "text": "He used to <w>rave</w> every weekend when he lived in London.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>ходил на рейвы</w> каждые выходные, когда жил в Лондоне."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in youth culture and music contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещать ночную танцевальную вечеринку с электронной музыкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрываться на рейвах",
                                "target_lang_sense_clarification": "посещать рейв-вечеринки"
                            },
                            {
                                "target_lang_word": "тусоваться",
                                "target_lang_sense_clarification": "в контексте электронной музыки и вечеринок"
                            }
                        ]
                    },
                    "synonyms": [
                        "dance party"
                    ]
                },
                {
                    "sense_id": "1a79f356-0c73-3452-9264-79133f788046",
                    "sense_definition": "To speak or write wildly, incoherently, or irrationally, often due to madness or fever.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "irrationality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>rave</w> incoherently as the high fever took hold.",
                            "target_lang_translations": {
                                "ru": "Пациент начал бессвязно <w>бредить</w>, когда поднялась высокая температура."
                            }
                        },
                        {
                            "text": "Stop <w>raving</w> like a madman and try to explain what happened clearly.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>разглагольствовать</w> как сумасшедший и попробуй внятно объяснить, что произошло."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать бессвязно, иррационально или неистово, часто из-за безумия или лихорадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бредить",
                                "target_lang_sense_clarification": "говорить бессвязно в состоянии болезни или безумия"
                            },
                            {
                                "target_lang_word": "заговариваться",
                                "target_lang_sense_clarification": "говорить нелепости, терять нить мысли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11e8730-8023-35e4-aba7-d09f86fba851",
                    "sense_definition": "To be wild, furious, or raging; to act with extreme violence or intensity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm continued to <w>rave</w> outside, shaking the windows of the small cabin.",
                            "target_lang_translations": {
                                "ru": "Шторм продолжал <w>бушевать</w> снаружи, сотрясая окна маленькой хижины."
                            }
                        },
                        {
                            "text": "He would <w>rave</w> and beat his breast in a fit of uncontrollable anger.",
                            "target_lang_translations": {
                                "ru": "Он <w>неистовствовал</w> и бил себя в грудь в приступе неконтролируемого гнева."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used for natural elements or intense emotional states"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть неистовым, яростным или бушующим; действовать с крайней силой или интенсивностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о стихии или сильном гневе"
                            },
                            {
                                "target_lang_word": "неистовствовать",
                                "target_lang_sense_clarification": "проявлять крайнюю ярость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0aec978-588f-39ae-881b-87320264f940",
                    "sense_definition": "To rush wildly or move with great force and noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The roaring billows <w>rave</w> against the rocks during the winter gales.",
                            "target_lang_translations": {
                                "ru": "Ревущие валы <w>бьются</w> о скалы во время зимних штормов."
                            }
                        },
                        {
                            "text": "The wind began to <w>rave</w> through the narrow mountain passes.",
                            "target_lang_translations": {
                                "ru": "Ветер начал <w>завывать</w> в узких горных проходах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily found in older literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С шумом и большой силой нестись или двигаться."
                    },
                    "translations": {
                        "ru": [
                            {
