                "translations": [
                    {
                        "translation_id": "63aa6709-cca8-4f57-ae49-2a2a891e8b6d",
                        "source_entry_id": "56495f67-5259-3a8f-a5f7-1bb7d190579c",
                        "source_sense_id": "656259ec-77aa-3391-b3bc-9bbe53f2cb14",
                        "source_sense_description": "Steuer, die auf das Einkommen natürlicher Personen erhoben wird",
                        "target_lang_word": "income tax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "income tax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc76511-7421-3512-a68b-79fc6feba220",
                                        "entry_id": "ab41a4d7-ab3a-3a70-abd9-c396872ec3ae",
                                        "glosses": [
                                            "A tax levied on earned and unearned income, net of allowed deductions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc85026-8918-4913-9197-e90571527c00",
                                                "sense_id": "3dc76511-7421-3512-a68b-79fc6feba220",
                                                "text": "The latest Tory budget continued the trend begun in 2000 by making further small cuts in family income taxes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ddb8262-5b3a-4fd2-9732-b88d7ce2be90",
                        "source_entry_id": "56495f67-5259-3a8f-a5f7-1bb7d190579c",
                        "source_sense_id": "656259ec-77aa-3391-b3bc-9bbe53f2cb14",
                        "source_sense_description": "Steuer, die auf das Einkommen natürlicher Personen erhoben wird",
                        "target_lang_word": "impôt sur le revenu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impôt sur le revenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                        "entry_id": "8f8b0118-be7c-3431-98e3-80fd1c6e89a8",
                                        "glosses": [
                                            "Impôt direct payé par les personnes physiques, et calculé selon le montant de leurs revenus annuels."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1e2506-0602-4049-9e9e-93ec014ee971",
                                                "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                                "text": "M. Thiers employa les premières semaines de janvier à lutter à la tribune contre l’impôt sur le revenu et pour l’impôt sur les matières premières ; sur ces questions il n’était point d’accord avec le sentiment public, […]"
                                            },
                                            {
                                                "example_id": "b07b6845-fe1d-40da-836a-782770d5fb02",
                                                "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                                "text": "Lancer l'idée de l’impôt sur le revenu est ici forfait bien plus grand qu'un simple vol à la tire ; « dégringoler un pante » est peccadille auprès de l'exhortation à la grève."
                                            },
                                            {
                                                "example_id": "418e3828-939e-46d9-b388-b7090995c0ae",
                                                "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                                "text": "Les gauches préconisaient l’impôt sur le revenu global et progressif tel que M. Doumer, ministre des finances dans le cabinet Léon Bourgeois (fin 1895 - commencement 1896), en avait tracé le dessin sommaire."
                                            },
                                            {
                                                "example_id": "4fbe97e1-ef22-48c4-8ffc-7e3fedf50a75",
                                                "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                                "text": "Il est établi un impôt annuel unique sur le revenu des personnes physiques désigné sous le nom d’impôt sur le revenu. Cet impôt frappe le revenu net global du contribuable déterminé conformément aux dispositions des articles 156 à 168."
                                            },
                                            {
                                                "example_id": "ad33eee2-d8ef-4b87-bdc2-075fc413c03d",
                                                "sense_id": "42c930e1-b8ee-3ef8-8726-50d5c1498aea",
                                                "text": "L'impôt sur le revenu doit être considéré comme un moyen de financer l'État et de réduire les inégalités, et non comme un outil pour punir les riches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
