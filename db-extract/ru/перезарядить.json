                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9edb0e19-8f2f-3fc2-b9fa-6b9c34c9d04d",
                        "entry_id": "94ac343c-5674-3241-ae40-6c9534f55778",
                        "glosses": [
                            "заново или ещё раз подготовить какой-либо аппарат к действию, работе путём помещения в него заряда"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "49cbbba3-54d6-3713-b36e-9c86301b96c6",
                        "entry_id": "94ac343c-5674-3241-ae40-6c9534f55778",
