                ],
                "senses": [
                    {
                        "sense_id": "467295cb-dabf-328e-bb1f-a528aca31f9e",
                        "entry_id": "cd954edf-ade6-3bc9-808f-a9ea2b1708fd",
                        "glosses": [
                            "Verband von Zellen, die annähernd gleich gebaut sind und dieselbe Funktion haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60acb2f-44c5-4bb8-83e5-1c64cee4c914",
                                "sense_id": "467295cb-dabf-328e-bb1f-a528aca31f9e",
                                "text": "„Denn nicht einmal auf Krebs spezialisierte Mediziner, von wenigen Ausnahmen abgesehen, können Entwarnung geben, ohne Pathologen zu bemühen – Spezialisten für krankhaft verändertes Körpergewebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce586051-408b-40af-8664-8a96f61851b5",
                        "source_entry_id": "cd954edf-ade6-3bc9-808f-a9ea2b1708fd",
                        "source_sense_id": "467295cb-dabf-328e-bb1f-a528aca31f9e",
                        "source_sense_description": "Biologie, Medizin: Verband von Zellen, die annähernd gleich gebaut sind und dieselbe Funktion haben",
                        "target_lang_word": "tissue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tissue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3efd99c9-e54c-318d-8b39-6a8d6f8f96b6",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "Thin, woven, gauze-like fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1ed2c7-fff2-44e4-bd65-6451de631a06",
                                                "sense_id": "3efd99c9-e54c-318d-8b39-6a8d6f8f96b6",
                                                "text": "Madame Legarde, the \"glass of fashion and the nurse of form,\" (alias the most fashionable of milliners,) has comfortably assured me, \"that my figure has great merit, and only requires cultivation:\" this is to be done by tissues, brocades, and laces, which are now scattered round me in charming confusion."
                                            },
                                            {
                                                "example_id": "4f074811-8c06-4a01-9a02-ac9713fa90cf",
                                                "sense_id": "3efd99c9-e54c-318d-8b39-6a8d6f8f96b6",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7dcec2-6885-38df-9dd0-a4321d49343e",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "A fine transparent silk material, used for veils, etc.; specifically, cloth interwoven with gold or silver threads, or embossed with figures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d10ceaf-51ce-45a6-b1ae-5905b2bb0107",
                                                "sense_id": "ec7dcec2-6885-38df-9dd0-a4321d49343e",
                                                "text": "A Robe of Tiſſue, ſtiff with golden Wire; / An upper Veſt, once Hellen’s rich Attire; [...]"
                                            },
                                            {
                                                "example_id": "1305e9d6-884f-4e8a-9510-95e0a053f76a",
                                                "sense_id": "ec7dcec2-6885-38df-9dd0-a4321d49343e",
                                                "text": "In their glittering tissues bear emblazed / Holy memorials."
                                            },
                                            {
                                                "example_id": "4c083688-9691-46cd-99da-f95d309322e6",
                                                "sense_id": "ec7dcec2-6885-38df-9dd0-a4321d49343e",
                                                "text": "Corinius went on the right, wearing a rich cloak of sky-blue tissue over his shining armour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843b003d-7403-3cbb-854a-c384772fd7cd",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "A sheet of absorbent paper, especially one that is made to be used as tissue paper, toilet paper or a handkerchief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b44bf8ef-306c-33a1-ab73-85f79139a886",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "Absorbent paper as material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd6818fe-1929-374a-836a-6adc5938dcb9",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "A group of cells (along with their extracellular matrix if any) that are similar in origin and function together to do a specific job."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e0f5d6-9ed1-4bde-a17a-a028ff764751",
                                                "sense_id": "dd6818fe-1929-374a-836a-6adc5938dcb9",
                                                "text": "What they lack is outermost brain tissue that, at least in humans, prompts awareness and interpretation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f695faa-c8a8-37f3-9a8c-fbeb407108ac",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "Web; texture; complicated fabrication; connected series."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af650ce-c4b2-4649-a744-29d4ad8f0b50",
                                                "sense_id": "9f695faa-c8a8-37f3-9a8c-fbeb407108ac",
                                                "text": "a tissue of forgeries, or of lies"
                                            },
                                            {
                                                "example_id": "7c8a83f9-b0c2-428c-ba7b-d5fde5281e88",
                                                "sense_id": "9f695faa-c8a8-37f3-9a8c-fbeb407108ac",
                                                "text": "unwilling to leave the dry bones of Agnosticism wholly unclothed with any living tissue of religious emotion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c3579a-f035-30b2-bc61-4c8bf584b774",
                                        "entry_id": "3d5ee1fb-3863-32d1-89d9-8a2a54ca5bdd",
                                        "glosses": [
                                            "The scratch sheet or racing form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ec8ca6-4699-4aa3-9aa2-fdff601889ba",
                                                "sense_id": "07c3579a-f035-30b2-bc61-4c8bf584b774",
                                                "text": "Pricing the first show is a matter of the bookmaker's individual judgment, relying upon advice from all quarters, particularly the tissue; but very soon in the betting exchanges it becomes clear that the sole criterion for the fixing of a horse's price is demand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tissue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "707dd490-3405-3e05-b5cc-33e0a519c2e6",
                                        "entry_id": "5a8ad2f8-0dd2-333e-ab8e-324b032bd6df",
                                        "glosses": [
                                            "To form tissue of; to interweave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e608fb-fe62-43cd-8e3c-ccd38418b627",
                                                "sense_id": "707dd490-3405-3e05-b5cc-33e0a519c2e6",
                                                "text": "The Chariot was couered with Cloth of Gold tiſſued vpon blew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ee0f7ff-58e5-4155-bf16-11f8cca66986",
                        "source_entry_id": "cd954edf-ade6-3bc9-808f-a9ea2b1708fd",
                        "source_sense_id": "467295cb-dabf-328e-bb1f-a528aca31f9e",
                        "source_sense_description": "Biologie, Medizin: Verband von Zellen, die annähernd gleich gebaut sind und dieselbe Funktion haben",
                        "target_lang_word": "tissu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tissu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b05b68-b3b3-3b00-b0db-8dc2a4ceda1c",
                                        "entry_id": "32f3abf3-f0cb-3ef4-9a6a-ec9ebf3219f1",
                                        "glosses": [
                                            "Matériau constitué de fils entrelacés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf6ea7b-e74e-4881-ae5d-2e6ec6848d26",
                                                "sense_id": "a8b05b68-b3b3-3b00-b0db-8dc2a4ceda1c",
                                                "text": "La plupart des vêtements sont fabriqués à partir de tissus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885ff891-3ee5-3bba-b9ae-6df372b268f2",
                                        "entry_id": "32f3abf3-f0cb-3ef4-9a6a-ec9ebf3219f1",
                                        "glosses": [
                                            "Enchevêtrement, fabrication."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39b6580c-0fec-4a8b-94cb-37a336c27f97",
                                                "sense_id": "885ff891-3ee5-3bba-b9ae-6df372b268f2",
                                                "text": "Ce qu’il dit est un tissu de mensonges."
                                            },
                                            {
                                                "example_id": "162c3c72-ee31-4d53-82e8-9b74e2f29c05",
                                                "sense_id": "885ff891-3ee5-3bba-b9ae-6df372b268f2",
                                                "text": "Je serais pourtant volontiers de ceux qui ne croient pas aux origines et qui ne conçoivent le monde que comme un tissu continu, sans commencement ni fin."
                                            },
                                            {
                                                "example_id": "6b91462b-e0c0-4bd5-b877-0072a1585db8",
                                                "sense_id": "885ff891-3ee5-3bba-b9ae-6df372b268f2",
                                                "text": "Il fait notamment la comparaison avec les projets réalisés dans d’autres pays d’Asie centrale, notamment l’Ouzbékistan et le Kazakhstan qui, depuis plusieurs années, cherchent à moderniser leurs tissus ferroviaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                        "entry_id": "32f3abf3-f0cb-3ef4-9a6a-ec9ebf3219f1",
                                        "glosses": [
                                            "Ensemble de cellules différenciées ayant une structure et des fonctions identiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fdb3e5e-7319-4215-954b-64a3faab908e",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Le corps humain se compose de muscles, d’os, de nerfs, de tissus et de fluides."
                                            },
                                            {
                                                "example_id": "5331781a-ea75-4907-8f8d-13a274f1750a",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "En coupe, la liane présente un pentagone ayant à son centre une lumière, et, entourant celle-ci, un tissu parenchymateux gorgé d’eau et traversé dans toute sa longueur par des fibres ligneuses."
                                            },
                                            {
                                                "example_id": "1cc485ee-b3f8-460c-aaf0-92b1e072eb26",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Les lésions de la fièvre typhoïde intéressent l'appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu'aux ganglions mésentériques et à la rate."
                                            },
                                            {
                                                "example_id": "da83108f-e29a-4719-9960-c0887cfd79c5",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Selon la conception jusqu’à présent classique, les néoplasmes primitifs du squelette proviennent toujours, et proviennent seulement, des cellules constitutives du tissu osseux normal; or, le tissu osseux comprend les cellules fibreuses de la moelle et du périoste, les médulocelles, les ostéoblastes de la moelle et du périoste, les myéloplaxes, les cellules endothéliales des vaisseaux sanguins et lymphatiques."
                                            },
                                            {
                                                "example_id": "433e88c6-33f4-4335-9bbc-7ec022b7b960",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Très controversés, ces pesticides sont principalement utilisés de manière préventive, en enrobage des semences : lorsque les plantes traitées poussent, tous leurs tissus (feuilles, tiges, pollen, nectar, etc.) s’imprègnent du toxique."
                                            },
                                            {
                                                "example_id": "549d28c2-3593-4bfd-9f85-6fb27d4d23a0",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Le froid -- suffisant pour empêcher la prolifération bactérienne et fongique, mais pas assez important pour endommager les tissus -- a permis d’incroyablement bien conserver l'animal qui gardait des plumes, des ongles, de la peau et des tissus mous intacts."
                                            },
                                            {
                                                "example_id": "92bf2b63-9443-4395-98b4-a51e8aabc633",
                                                "sense_id": "4d38a615-e6c1-393e-9864-a66ffbfc0a24",
                                                "text": "Dès lors, il est facile d’imaginer la suite : un humain ingère de la salive de chauve-souris en mordant dans un fruit qui en est couvert, ou, en tentant de chasser et de tuer cette visiteuse importune, s’expose aux microbes qui ont trouvé refuge dans ses tissus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c29dca4-c1f4-343b-abdc-ed1b75c3834b",
                                        "entry_id": "32f3abf3-f0cb-3ef4-9a6a-ec9ebf3219f1",
                                        "glosses": [
                                            "Tissu aérien."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696e8345-e0ba-47e2-887c-1a3a21f78b74",
                                                "sense_id": "3c29dca4-c1f4-343b-abdc-ed1b75c3834b",
                                                "text": "Lorsque je monte au tissu, je constate que la surcharge d’effort dans les membres supérieurs provoque une fatigue peu nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tissu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                        "entry_id": "f77ea8f8-ddee-3458-92f7-c0d88e3f2abc",
                                        "glosses": [
                                            "Tissé ; entrelacé."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e93d2e-7a07-45b7-a9c4-06abc57f8d6b",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "Une servante vient balayer tout l’ouvrage.\nAutre toile tissue, autre coup de balai.\nLe pauvre bestion tous les jours déménage."
                                            },
                                            {
                                                "example_id": "35aac978-2187-4a85-8a73-bcbf76457728",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "Lorsque la graine est encore tendre & verte dans le péricarpe, cette peau est très-peu adhérente. Cette épiderme est donc caduque. La seconde ou celle qui est immédiatement au-dessous, est une membrane plus fine qui forme plusieurs plis, & qui est tissue par des fibres très-fines, très-délicates & pleines de vaisseaux secrétoires, qui communiquent de la substance des cotylédons à l’extérieur, par les pores de la première peau."
                                            },
                                            {
                                                "example_id": "30b68f66-9103-4cae-94ba-1f321ce14f05",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "On emploie pour cette pêche les engins ordinaires, ceux que nous avons décrits ci-dessus, et des poches en chanvre diversement disposées et tissues, que le poisson remplit quelquefois entièrement."
                                            },
                                            {
                                                "example_id": "6416bf12-beca-4314-bc8e-b5faeeb2e3c3",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "il avait toujours le linge le plus fin, les draps les mieux tissus, les habits les plus souples, le cheval le plus robuste et le plus cher, les maîtresses les plus vulgaires, mais les plus belles et les plus jeunes."
                                            },
                                            {
                                                "example_id": "84d8d827-414b-41cb-83c0-6942c3e4e46a",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "Une femme de trente ans a d’irrésistibles attraits pour un jeune homme ; et rien de plus naturel, de plus fortement tissu, de mieux préétabli que les attachements profonds."
                                            },
                                            {
                                                "example_id": "ec4ff253-6b10-4f3c-8d99-674fc15fe6cc",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "De grands lambeaux de brumes tout déloquetés, de véritables haillons tissus d’air et d’eau, balayaient le sol."
                                            },
                                            {
                                                "example_id": "ba4da781-7760-4b78-b9bc-e4596d1c480d",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "Mais, par un raffinement d'une délicatesse délicieuse, la prairie sur laquelle se développaient ces ombres d'arbres, légères comme des âmes, était une prairie paradisiaque, non pas verte mais d'un blanc si éclatant à cause du clair de lune qui rayonnait sur la neige de jade, qu'on aurait dit que cette prairie était tissue seulement avec des pétales de poiriers en fleurs."
                                            },
                                            {
                                                "example_id": "71d5b2f0-b6ef-4d63-8f58-5504544d510f",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "Je maudis l’homme tout tissu aux choses qu’il a faites, je maudis sa complaisance et je maudis son consentement."
                                            },
                                            {
                                                "example_id": "bdf81654-f551-480a-8703-2eaae5c21ee5",
                                                "sense_id": "b5c2d87b-e06f-3582-830d-92f1b41cbde7",
                                                "text": "J'indique ces quelques faits pour montrer dès le début le réseau compliqué de noms, de sangs, et de biens fonciers, tissu par trois douzaines de familles sans cesse intermariées au cours de trois siècles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tissu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4132f61-751b-3f63-ac0d-01908e1a0f60",
                                        "entry_id": "d799a7c4-c160-36ce-881f-b172cbece28b",
                                        "glosses": [
                                            "Participe passé masculin singulier de tistre."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b9d4593-4188-4f9f-b010-2c37902f61e3",
                                                "sense_id": "e4132f61-751b-3f63-ac0d-01908e1a0f60",
                                                "text": "Déjà la main industrieuse de cette fille chérie avait tissu les vétemens sous lesquels son père acquit tant de gloire dans les villes Ibériennes, en exerçant les fonctions de préfecture et en dictant de sages lois, en qualité de chef. La partie supérieure de la trabée représentait les faits illustres concernant quelques époux de l’antiquité ; elle étalait aux yeux ce que la fable rapporte d’Ithaque, de Dulichium, puis montrait Pénélope défaisant, pendant la nuit, ce qu’elle avait tissu le jour."
                                            },
                                            {
                                                "example_id": "1a378f4e-ca3a-47b6-ba21-f62197ac6027",
                                                "sense_id": "e4132f61-751b-3f63-ac0d-01908e1a0f60",
                                                "text": "Entre plusieurs discours qu’elle luy tient pour luy représenter l’ardeur de sa passion, elle luy dit qu’elle a parfumé & orné sa chambre de belles tapisseries, qu’elle a tissu son lit de cordons: Intexui furibus lectulum meum ; […]."
                                            },
                                            {
                                                "example_id": "dde78f06-06c1-4896-8f76-88d352cf0fe1",
                                                "sense_id": "e4132f61-751b-3f63-ac0d-01908e1a0f60",
                                                "text": "Lorenzo. – Je suis au terme de ma peine, et sois certain, Philippe, que le buffle sauvage, quand le bouvier l’abat sur l’herbe, n’est pas entouré de plus de filets, de plus de nœuds coulants que je n’en ai tissu autour de mon bâtard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
