                        "examples": [
                            {
                                "example_id": "4ccba619-499b-4cd3-b010-36fa2959febd",
                                "sense_id": "5b882b46-d6ce-3a78-a9eb-c419e2c76e78",
                                "text": "Que les Yrus soient des Crésus , & riches du bien du Crucifix en moins de rien dans l’Église , qui n'estoient que des drilleux dans le monde , cherchants sur les Autels les hameçons , & les pieges pour en auoir."
                            },
                            {
                                "example_id": "d9fd8d84-6ada-4e67-8fa2-9236179bd376",
                                "sense_id": "5b882b46-d6ce-3a78-a9eb-c419e2c76e78",
                                "text": "En ville le porcher me conduira plus tard,\nSous les traits d’un drilleux à caduque dégaine."
                            }
                        ]
                    }
