                                                "text": "Bartenders usually know their regulars by name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80d89aac-4912-3b86-af81-d1d512fcb2f2",
                                        "entry_id": "9dee8e95-bd6b-3cec-bedb-ea30fa39688f",
                                        "glosses": [
                                            "A member of the armed forces or police force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58ae401d-7c3f-3ed7-a35a-ba6b581745ec",
                                        "entry_id": "9dee8e95-bd6b-3cec-bedb-ea30fa39688f",
                                        "glosses": [
                                            "A member of the armed forces or police force.",
                                            "Synonym of regular serviceman; a soldier in the Singapore Armed Forces who has chosen to work full-time beyond their required length of service in the army."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c1f480-8775-4727-bdcc-82a91d3563ba",
                                                "sense_id": "58ae401d-7c3f-3ed7-a35a-ba6b581745ec",
                                                "text": "Boss, this is the situation. They were regulars in the army. They’ve left the army and are taxi drivers now. He was a commando and he was a state boxer. They don’t earn much and there’s no end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb341a7a-79c8-3148-889a-32a8ae2b7368",
                                        "entry_id": "9dee8e95-bd6b-3cec-bedb-ea30fa39688f",
                                        "glosses": [
                                            "A frequent customer, client or business partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c875144-8f71-48d7-90b1-b6b00f26886b",
                                                "sense_id": "fb341a7a-79c8-3148-889a-32a8ae2b7368",
                                                "text": "This gentleman was one of the architect's regulars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a285f7-eca1-341e-805b-e6927a9bb1dd",
                                        "entry_id": "9dee8e95-bd6b-3cec-bedb-ea30fa39688f",
                                        "glosses": [
                                            "A coffee with one cream and one sugar."
                                        ],
