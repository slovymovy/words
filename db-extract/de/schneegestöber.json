                                                "example_id": "090ecdaa-9f93-4872-8651-67be1faa44b4",
                                                "sense_id": "3a156d85-0290-37c2-9b7d-23a128bac1fb",
                                                "text": "На улице начиналась самая настоящая уральская пурга, снег сыпал, ветер крепчал."
                                            }
                                        ]
                                    },
