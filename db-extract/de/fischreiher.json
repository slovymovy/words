                "senses": [
                    {
                        "sense_id": "460f67f0-b0dc-3933-b674-37e70fbb5895",
                        "entry_id": "9f860cb4-c13e-38a2-9756-97f1269adc21",
                        "glosses": [
                            "in Europa, Asien und Afrika vorkommender Vogel mit sehr schlankem Körper, einem langen Hals, einem langen, gelblichen Schnabel und langen Beinen, der in aller Regel an Stirn und Oberkopf weiß, am Hals grauweiß und auf dem Rücken aschgrau gefiedert ist (Ardea cinerea)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b61fb82-c056-47da-974f-832117d21fd3",
                                "sense_id": "460f67f0-b0dc-3933-b674-37e70fbb5895",
                                "text": "„Mit langsamen Flügelschlägen ruderte ein Fischreiher unter dem Himmel hin.“"
                            },
                            {
                                "example_id": "314e0e0d-e4e0-4835-b944-c0df61ec95cd",
                                "sense_id": "460f67f0-b0dc-3933-b674-37e70fbb5895",
                                "text": "„Am Graben steht unbewegt ein Fischreiher.“"
                            },
                            {
                                "example_id": "f0adc9bb-ef61-4d22-8973-2eb54e9114ae",
                                "sense_id": "460f67f0-b0dc-3933-b674-37e70fbb5895",
                                "text": "„Die Pegnitz hat einen reichen Fischbestand, den die Angler zu schätzen wissen und der auch den Fischreiher und den Kormoran anlockt.“"
                            },
                            {
                                "example_id": "56e36348-e177-4941-bd4a-b515cdd79718",
                                "sense_id": "460f67f0-b0dc-3933-b674-37e70fbb5895",
                                "text": "„Der Fischreiher ist ein Heron, zu welcher Vogelfamilie auch der Ibis gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
