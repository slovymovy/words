                    },
                    {
                        "translation_id": "8f04f63f-9d58-4229-83e5-3807e9e4f57c",
                        "source_entry_id": "d7f3db51-bd26-336f-81d2-710e2f2efffd",
                        "source_sense_id": "5a8f4c4e-c36e-3316-9ce4-20039f53e69d",
                        "target_lang_word": "кухмистер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кухмистер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c407d81-873c-39ea-892b-fec0a579ae1e",
                                        "entry_id": "40a0680c-c2dc-3b02-80a5-edf98ef778ab",
                                        "glosses": [
                                            "устар. содержатель кухмистерской"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91188a36-32eb-4baf-8c17-9ad0f427f9af",
                                                "sense_id": "5c407d81-873c-39ea-892b-fec0a579ae1e",
                                                "text": "Действие происходит в одной из зал кухмистера Андронова."
                                            },
                                            {
                                                "example_id": "7c9f1c9e-44ad-47d1-9d7d-8998af50d716",
                                                "sense_id": "5c407d81-873c-39ea-892b-fec0a579ae1e",
                                                "text": "В кухмистерской такой обед (только менее чисто приготовленный) стоит, по словам Веры Павловны, 40 коп. сер., — за 30 коп. гораздо хуже. Понятна эта разница: кухмистер, готовя обед на 20 человек или меньше, должен сам содержаться из этих денег, иметь квартиру, иметь прислугу."
                                            },
                                            {
                                                "example_id": "7c3545b7-103a-4fd7-ab76-f9a7d0878d23",
                                                "sense_id": "5c407d81-873c-39ea-892b-fec0a579ae1e",
                                                "text": "Вернувшись в Москву, он переменил квартиру, ― она оказалась сырой, и он побоялся, что опять будет кровохарканье, снял напротив прежней на той же Якиманке, квартира находилась под помещением, которое кухмистер сдавал под свадьбы и поминки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7e0298-928e-3a29-86d1-37f8cd055710",
                                        "entry_id": "40a0680c-c2dc-3b02-80a5-edf98ef778ab",
                                        "glosses": [
                                            "устар. повар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ec557d-f139-48ad-ae78-0ba3e99ecf61",
                                                "sense_id": "7d7e0298-928e-3a29-86d1-37f8cd055710",
                                                "text": "Главные служители двора были: поверенный, или пленипотент по тяжебным делам, которых по разным судам всегда было налицо две или три дюжины; комиссар, или главноуправляющий над всем имением; эконом, или приказчик; маршалек, заведывавший столом и комнатными служителями; конюший, управлявший конюхами и конюшнею; кухмистер, разумеется, начальствовавший над кастрюлями, поварами и поваренками; охмистрыня, ключница или кастелянша, управлявшая служанками, бельем и кладовою, которая в польских домах называется аптечкою и вмещает в себе все сладкое: варенье, конфеты, сахар, кофе и многочисленный разряд водок и наливок."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
