                ],
                "senses": [
                    {
                        "sense_id": "36c4a57a-68f1-374e-9c0e-f51ee8057943",
                        "entry_id": "a4f37d7c-e0a5-30a4-8fdb-fa199c7a8046",
                        "glosses": [
                            "een gebeurtenis waarbij iemand de dood vindt door te veel water in de longen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2c47c2-030a-48c7-98a2-c6248bbf758e",
                                "sense_id": "36c4a57a-68f1-374e-9c0e-f51ee8057943",
                                "text": "Er werd vastgesteld dat het een geval van verdrinking was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a273445d-a8d6-43e6-a61d-8ecbed1daac8",
                        "source_entry_id": "a4f37d7c-e0a5-30a4-8fdb-fa199c7a8046",
                        "source_sense_id": "36c4a57a-68f1-374e-9c0e-f51ee8057943",
                        "target_lang_word": "Ertrinken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ertrinken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                        "entry_id": "13107dbd-6943-3fbb-bbdc-c751219ed4e8",
                                        "glosses": [
                                            "Tod, bei dem Wasser oder eine andere Flüssigkeit in die Lunge gelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c918ad-454f-457d-b586-ef3b68550b2a",
                                                "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                                "text": "„Der Präfekt sagte, die Opfer seien durch Ertrinken und nicht durch Gewalteinwirkung der Einsatzkräfte zu Tode gekommen.“"
                                            },
                                            {
                                                "example_id": "b6a566ec-6acd-499a-924b-f8ed98ffdfc3",
                                                "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                                "text": "„Der Tod durch Ertrinken ist in den meisten Fällen eine lautlose Tragödie. Die Opfer verschwinden einfach unter der Wasseroberfläche und tauchen nicht mehr auf.“"
                                            },
                                            {
                                                "example_id": "13810cba-f5b9-41f1-b511-e50926c6a6d7",
                                                "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                                "text": "„Man hat gar keine Möglichkeiten mehr zu schreien. Man redet da auch von dem sogenannten stillen Ertrinken, das geht in der Tat ganz still und leise vor sich.“"
                                            },
                                            {
                                                "example_id": "0ddd68df-ee5c-4995-a135-5486dbb9dc34",
                                                "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                                "text": "„Ertrinken ist vor allem Männersache.“"
                                            },
                                            {
                                                "example_id": "df00bf43-d160-466d-9249-4a910ea9b02e",
                                                "sense_id": "02991770-e794-301a-bfa6-ce476144b8a3",
                                                "text": "[Hitze:] „Dann ohne Abkühlung in den kalten See oder Fluss zu springen, kann zu einem medizinischen Notfall im Wasser führen und zum Ertrinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9357acb-101a-4e25-b24b-cdbc1cd554c9",
