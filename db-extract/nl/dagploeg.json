                        ],
                        "examples": [
                            {
                                "example_id": "b48eb14a-2d3a-4547-aad5-ab4462e322d4",
                                "sense_id": "135dff3a-ac7c-3eca-bb09-2a1b81a0b55f",
                                "text": "De dagploeg begon 's ochtends om 7 uur met hun werkzaamheden.",
                                "translation": "The day shift team started their work at 7 o'clock in the morning.",
                                "english": "The day shift team started their work at 7 o'clock in the morning."
                            },
                            {
                                "example_id": "c2e5e01b-b79b-4ef4-a238-dbf3ae7e7e3e",
                                "sense_id": "135dff3a-ac7c-3eca-bb09-2a1b81a0b55f",
                                "text": "De productie wordt in drie ploegen uitgevoerd: de dagploeg, de nachtploeg en de avondploeg.",
                                "translation": "The production is carried out in three shifts: the day shift team, the night shift team, and the evening shift team.",
                                "english": "The production is carried out in three shifts: the day shift team, the night shift team, and the evening shift team."
                            },
                            {
                                "example_id": "33e8730b-7bbd-487e-ac7d-9d7744822d69",
                                "sense_id": "135dff3a-ac7c-3eca-bb09-2a1b81a0b55f",
                                "text": "De medewerkers van de dagploeg zorgen ervoor dat de fabriek overdag operationeel is.",
                                "translation": "The employees of the day shift team ensure that the factory is operational during the day.",
                                "english": "The employees of the day shift team ensure that the factory is operational during the day."
                            }
                        ]
                    }
