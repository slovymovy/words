                        "freiner brusquement"
                    ]
                },
                {
                    "sense_id": "cac6b43d-3a6f-3e25-9c3a-6e20bab66165",
                    "sense_definition": "Ralentir, entraver ou bloquer la progression ou le développement de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le manque de budget risque de <w>freiner</w> le développement de notre nouveau projet."
                        },
                        {
                            "text": "Le gouvernement applique des mesures strictes pour <w>freiner</w> la hausse des prix."
                        }
                    ],
                    "synonyms": [
                        "ralentir",
                        "entraver",
                        "bloquer"
                    ],
                    "antonyms": [
                        "accélérer",
                        "stimuler",
                        "favoriser"
                    ],
                    "common_phrases": [
