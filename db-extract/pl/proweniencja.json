                    {
                        "translation_id": "f07bd1c5-bc73-4677-8927-24fdd7ca83ff",
                        "source_entry_id": "fa821221-4fd4-3640-9548-7fb7272e7cc6",
                        "source_sense_id": "504d11bf-e735-3e68-80f6-34f57895fd4d",
                        "target_lang_word": "provenance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provenance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46731f45-02d4-3ada-bfe1-987f6c640b90",
                                        "entry_id": "6efb6f37-16f1-309f-bec0-1df85d247c0b",
                                        "glosses": [
                                            "Origine, endroit d’où provient une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96037217-cf1f-48a3-8f71-5e1c671ec142",
                                                "sense_id": "46731f45-02d4-3ada-bfe1-987f6c640b90",
                                                "text": "L’ampoule, qui éclairait cette dégringolade d’objets de toute provenance […] se balançait poussiéreuse, au bout de son fil, sous la voûte basse où le salpêtre faisait des croûtes."
                                            },
                                            {
                                                "example_id": "ede61b9f-d0d3-43c4-926d-23c91583ab83",
                                                "sense_id": "46731f45-02d4-3ada-bfe1-987f6c640b90",
                                                "text": "La variante sur le Hodna, baptisée Etincelle, visait à couper l'approvisionnement des katibas de Kabylie en provenance de Tunisie par le Hodna et les Aurès."
                                            },
                                            {
                                                "example_id": "05a3fbc5-566d-4cb9-bd62-b7d00aebdffd",
                                                "sense_id": "46731f45-02d4-3ada-bfe1-987f6c640b90",
                                                "text": "La dépression du trafic de juillet à septembre semble être la conséquence du chômage sur le canal du Centre qui a interrompu les expéditions en provenance du Bassin minier de Blanzy à destination de la vallée du Doubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acbd10f4-360f-3100-a855-27e70f4343b6",
                                        "entry_id": "6efb6f37-16f1-309f-bec0-1df85d247c0b",
                                        "glosses": [
                                            "(s’emploie surtout au pluriel) Tout ce qui provient d’un pays, tout ce qui est transporté d’un pays dans un autre."
                                        ],
                                        "tags": [
                                            "Commerce et douane"
                                        ],
                                        "examples": [
