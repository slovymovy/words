                "senses": [
                    {
                        "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                        "entry_id": "895f7c09-ff2b-33d0-b08d-b419c5c63d56",
                        "glosses": [
                            "Großunternehmen der Versicherungsbranche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981bf5a5-176c-45b3-8bf6-baf6f38cbab4",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Insgesamt 21 Jahre arbeitete er für den Versicherungskonzern und sanierte mehrere Auslandstöchter.“"
                            },
                            {
                                "example_id": "a8d148bd-4c60-452a-afa3-83ae7c84f162",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Viele Jahre arbeitete er als Jurist bei einem Schweizer Versicherungskonzern.“"
                            },
                            {
                                "example_id": "1a04bd3a-88e9-46f0-bee2-74464dc6d0f2",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Ein seit Monaten anhaltender Machtkampf unter den Generali-Aktionären um die Führung des italienischen Versicherungskonzerns fordert ein prominentes Opfer. Luciano Cirina, der das Geschäft in Österreich und Osteuropa führt, ist gestern suspendiert worden.“"
                            },
                            {
                                "example_id": "17256c3f-073f-4249-b8fc-cc1b623f9b02",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "[Weltweit hat] „das Bruttogeldvermögen der privaten Haushalte zum Vorjahr um 9,7 Prozent auf 192 Billionen Euro zugelegt, teilte der Versicherungskonzern am Mittwoch mit.“"
                            },
                            {
                                "example_id": "9df3afb6-7489-45d4-9fde-9862cf8ebfd7",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Sucht ist ein solides Geschäftsmodell. Und so legen Versicherungskonzerne viel Geld ihrer Kunden auch in Tabakaktien an.“"
                            },
                            {
                                "example_id": "5e652820-5100-4b1e-a55b-214c29cd9d2f",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Der Schweizer Versicherungskonzern hat im letzten Jahr 1.44 Milliarden US-Dollar Gewinn gemacht.“"
                            },
                            {
                                "example_id": "82dd3ea1-a650-4364-ad63-98999febb357",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Der Versicherungskonzern legt im vergangenen Jahr einen Gewinnsprung von 74 Prozent hin. Der Umsatz stagniert hingegen.“"
                            },
                            {
                                "example_id": "c82f075e-81bf-4804-9368-2c6432954b5d",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Größter Dividendenzahler ist nach den Angaben die Allianz: Der Versicherungskonzern zahlt seinen Aktionären 3,1 Milliarden Euro.“"
                            },
                            {
                                "example_id": "bc7c34ce-fde7-4951-8068-9ef0944f11ca",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Versicherungskonzerne im Pensionskassengeschäft jammern seit Jahren über mangelnde Renditen.“"
                            },
                            {
                                "example_id": "8669ec63-12f8-4e51-8ce7-b1ed2f2458fb",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Der vom Staat gerettete US-Versicherungskonzern AIG hat mit dem Verkauf einer Sparte genügend Geld eingenommen, um einen Hilfskredit der Federal Reserve Bank von New York zurückzahlen zu können.“"
                            },
                            {
                                "example_id": "87f760f4-2478-4aae-981b-b6cca7e7a28c",
                                "sense_id": "b4c494eb-9ea2-38a8-a4e2-7f891df875c0",
                                "text": "„Sechs Jahre liegt der Beginn der Finanzkrise, die weltweit eine noch immer andauernde Wirtschaftskrise ausgelöst hat, zurück - nun sollen neben den Banken auch die größten Versicherungskonzerne an die Kandare genommen werden, um einen neuerlichen finanziellen Super-GAU zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
