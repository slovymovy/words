                "senses": [
                    {
                        "sense_id": "ed8b880f-a55f-389a-ab8f-a320215d2bfe",
                        "entry_id": "c835dd57-cc05-339d-b83d-9026c2046d3a",
                        "glosses": [
                            "een fictieve toestand waarin een mens of ander wezen terechtkomt als hij/het is gestorven, maar teruggehaald is uit de dood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df29337-3215-450b-b496-97a330bf9a36",
                                "sense_id": "ed8b880f-a55f-389a-ab8f-a320215d2bfe",
                                "text": "In de beelden is te zien dat Link en Zelda een soort crypte verkennen, waar ze niet alleen hiërogliefen aantreffen, maar ook een ondood wezen."
                            },
                            {
                                "example_id": "5c01ca9f-8c4d-409a-a195-4e3161394cfc",
                                "sense_id": "ed8b880f-a55f-389a-ab8f-a320215d2bfe",
                                "text": "Het blijkt echter dat ze worden achtervolgd door een vampier, een verrezen dode die tijdens zijn zwerftochten bij mensen bloed uit de hals zuigt. Wanneer mensen driemaal door de vampier worden gebeten en sterven worden zij echter ”ondood”."
                            },
                            {
                                "example_id": "23c189ee-51ba-4003-b271-ece38282116f",
                                "sense_id": "ed8b880f-a55f-389a-ab8f-a320215d2bfe",
                                "text": "De ster mu Arae heet voortaan Cervantes naar de Spaanse schrijver. Zijn planeet heet Quijote, naar Cervantes’ beroemde figuur Don Quichot. De dode ster PSR 1257+12 heet voortaan Lich, naar een ondood mythisch figuur. Er omheen draait de planeet Poltergeist."
                            }
                        ]
                    },
