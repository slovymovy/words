                        "glosses": [
                            "Celui, celle qui est versé dans l’épigraphie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c1c7a5-3a46-475a-8a72-27b9adbd526e",
                                "sense_id": "9a13e2d6-36a8-360f-8346-6b4c3cd44f46",
                                "text": "Dans ce mémoire, le pauvre Marmet citait des textes latins et les citait tout de travers. Or, Schmoll est un latiniste de grande valeur et, après Mommsen, le premier épigraphiste du monde."
                            },
                            {
                                "example_id": "2107543e-e381-4c46-93d6-94f83a964da1",
                                "sense_id": "9a13e2d6-36a8-360f-8346-6b4c3cd44f46",
                                "text": "L’épigraphiste se sert bien des données que lui apporte la paléographie pour lire et si possible dater les inscriptions, mais il ne se cantonne pas dans ces limites."
                            }
                        ]
                    }
