                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b05f5d4-4b9c-4650-9bf7-7ca8b760bfee",
                                "sense_id": "cc125d56-2246-330a-ab23-6ccfb77e2356",
                                "text": "Water ran slap across the roadway from the hillsides and every few seconds the scene jumped into light and was gone again as the lightning zizzled through the clouds above."
                            },
                            {
                                "example_id": "f3ef205b-613a-4b59-b698-7c630ae9c59c",
                                "sense_id": "cc125d56-2246-330a-ab23-6ccfb77e2356",
                                "text": "The fuse was lit and zizzling away; champagne, skyrockets, pinwheels and finally The Great Whiz-Bang; my back arched, my hands twisted around her soft silken hair."
                            },
                            {
                                "example_id": "7c4a172d-1269-42ab-bf8e-1c62cbc077ca",
                                "sense_id": "cc125d56-2246-330a-ab23-6ccfb77e2356",
                                "text": "Billy and I joined forces to pick on my sweet younger sister Lisa—once we had her electrocute worms by putting them into a peashooter and sticking them into an open light socket, which zizzled and sparked as the poor worms were fried."
                            }
                        ]
                    }
