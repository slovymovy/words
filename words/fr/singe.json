                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers attendent que le <w>singe</w> quitte l'atelier pour faire une pause."
                        },
                        {
                            "text": "Il est allé demander une augmentation directement au <w>singe</w> ce matin."
                        }
                    ],
