                "senses": [
                    {
                        "sense_id": "a5d977c5-b978-3212-be2e-d1549d0dcaca",
                        "entry_id": "18cd90df-ee47-3678-9436-e7ec52b39386",
                        "glosses": [
                            "miejsce, w którym pierze się odzież"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639f2269-dcb1-4bce-858f-99a28a9306d7",
                                "sense_id": "a5d977c5-b978-3212-be2e-d1549d0dcaca",
                                "text": "Pralnia nie bierze odpowiedzialności za zniszczone ubrania."
                            },
                            {
                                "example_id": "697b79d5-393a-4a19-819c-ab8b4f1f68d4",
                                "sense_id": "a5d977c5-b978-3212-be2e-d1549d0dcaca",
                                "text": "Praczki zostały wyparte przez pralki i pralnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2beeeec8-c3bb-41ad-bd8d-07f5b532ff89",
                        "source_entry_id": "18cd90df-ee47-3678-9436-e7ec52b39386",
                        "source_sense_id": "a5d977c5-b978-3212-be2e-d1549d0dcaca",
                        "target_lang_word": "laundry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laundry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f4c584-9a85-338c-90cd-99be91e523b6",
                                        "entry_id": "ca23bdff-79a0-3aee-9223-81cdfffba245",
                                        "glosses": [
                                            "A laundering; a washing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bc8f273-c225-4e09-9874-b1ea98c109b3",
                                                "sense_id": "c5f4c584-9a85-338c-90cd-99be91e523b6",
                                                "text": "In our family of five, we have to do the laundry every other day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e1ea7e-39aa-3250-bffa-9176af6e6331",
                                        "entry_id": "ca23bdff-79a0-3aee-9223-81cdfffba245",
                                        "glosses": [
                                            "A place or room where laundering is done - including, by extension, other forms of laundering than clothes washing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80af052a-f2c1-43f6-952c-f63ef7aa99d6",
                                                "sense_id": "f6e1ea7e-39aa-3250-bffa-9176af6e6331",
                                                "text": "Old Faithful is sometimes degraded by being made a laundry. Garments placed in the crater during quiescence are ejected thoroughly washed when the eruption takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473a25be-c8ff-3d7a-af68-7f340b9085f6",
                                        "entry_id": "ca23bdff-79a0-3aee-9223-81cdfffba245",
                                        "glosses": [
                                            "That which needs to be, is being, or has been laundered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c25dac-60b6-4dc6-ab64-9a6b15c7fdd8",
                                                "sense_id": "473a25be-c8ff-3d7a-af68-7f340b9085f6",
                                                "text": "You've left your dirty laundry all over the house."
                                            },
                                            {
                                                "example_id": "5d0de6ca-6773-415b-8781-b81e0c3849bc",
                                                "sense_id": "473a25be-c8ff-3d7a-af68-7f340b9085f6",
                                                "text": "Q. Did you use to do the washing around your house, too? / The Court: She did all the work of the house, I suppose. / Mr. Feltenstein: That's what I want to find out. / A. I gave the laundry to the laundry. / Q. What? / A. I gave the wash to the laundry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07a7f20f-1868-3b06-bc82-92ee8a03b1b2",
                                        "entry_id": "ca23bdff-79a0-3aee-9223-81cdfffba245",
                                        "glosses": [
                                            "A penalty flag."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aeda15e-4daa-3cfa-89aa-51b54d50c8bb",
                                        "entry_id": "ca23bdff-79a0-3aee-9223-81cdfffba245",
                                        "glosses": [
                                            "A business whose primary purpose is to conceal the origins of money received illegally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
