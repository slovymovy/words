                ],
                "senses": [
                    {
                        "sense_id": "c90a7e59-9c05-35a1-98cd-a57ccb023a2b",
                        "entry_id": "03736751-e094-3f37-b2e5-fc71d228340b",
                        "glosses": [
                            "auf nicht korrekte Art und Weise schlau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ce6aec-1a05-4c09-ac66-49ce07604b6a",
                                "sense_id": "c90a7e59-9c05-35a1-98cd-a57ccb023a2b",
                                "text": "Der aberweise König war überall bekannt."
                            },
                            {
                                "example_id": "a661c843-83c9-4465-a16c-333037c50d4c",
                                "sense_id": "c90a7e59-9c05-35a1-98cd-a57ccb023a2b",
                                "text": "„Da ist Friedrich Nicolai als ein Vertreter des fridericianischen Berlinerthums, ein Achtung gebietender, behender Autodidakt, der in jüngeren Jahren wacker Schritt zu halten strebte, später jedoch seine Buchhandlung und Rezensiranstalt in den Dienst einer Aufklärung gab, welche, während Lessing den Horizont weitete, selbstgenügsam und aberweise mit allem im Reinen zu sein wähnte und zur Zeit der Genies, der Klassiker, der Romantik wie ein alter Uhu von den Vögeln des jungen Tages umschwärmt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
