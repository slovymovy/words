                    {
                        "sense_id": "a7b481b1-30f1-365d-b3c9-d835d2cda9dc",
                        "entry_id": "b99d5a61-1070-3de3-bc53-d7f4571ca405",
                        "glosses": [
                            "wereldwijd schandaal toen bleek dat Volkswagen software in dieselauto's had ingebouwd die milieutesten manipuleerde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c4d195-c31d-4f33-96a8-70c1bdf503da",
                                "sense_id": "a7b481b1-30f1-365d-b3c9-d835d2cda9dc",
                                "text": "In Detroit in de VS is de vroegere topman van Volkswagen Martin Winterkorn aangeklaagd vanwege zijn rol in het dieselschandaal. De Duitser wordt samen met vijf andere Volkswagen-bestuurders beschuldigd van samenzwering en het overtreden van milieuregels."
                            },
                            {
                                "example_id": "2c134ace-dcdf-44ba-ae70-9c5f99f978ca",
                                "sense_id": "a7b481b1-30f1-365d-b3c9-d835d2cda9dc",
                                "text": "Justitie in Duitsland heeft vanmorgen invallen gedaan bij Audi in het onderzoek naar het dieselschandaal. Het hoofdkantoor van de autofabrikant in Ingolstadt en een fabriek in Neckarsulm worden doorzocht. Ook is er een inval gedaan in een woning in Baden-Württemberg."
                            }
                        ]
                    }
