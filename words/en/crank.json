{
    "word_family": [
        "cranky",
        "crankiness",
        "crankshaft"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                    "sense_definition": "A person who is considered strange or odd by others, and may behave in unconventional ways.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eccentric_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "John is a <w>crank</w> because he talks to himself.",
                            "target_lang_translations": {
                                "it": "John è un <w>eccentrico</w> perché parla da solo."
                            }
                        },
                        {
                            "text": "The old <w>crank</w> wanted to actually make people.",
                            "target_lang_translations": {
                                "it": "Il vecchio <w>bisbetico</w> voleva davvero creare delle persone."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "oddball",
                        "weirdo",
                        "crackpot",
                        "kook"
                    ],
                    "target_lang_definitions": {
                        "it": "Una persona considerata strana o bizzarra, che può comportarsi in modi non convenzionali."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "eccentrico",
                                "target_lang_sense_clarification": "persona con comportamenti insoliti o fuori dal comune"
                            },
                            {
                                "target_lang_word": "strambo",
                                "target_lang_sense_clarification": "persona con modi di fare bizzarri o stravaganti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af7a3194-beca-3225-ac48-30b13e5ae1c6",
                    "sense_definition": "An ill-tempered or nasty person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ill_tempered_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Billy-Bob is a nasty old <w>crank</w>!",
                            "target_lang_translations": {
                                "it": "Billy-Bob è un vecchio <w>scontroso</w> e sgradevole!"
                            }
                        },
                        {
                            "text": "The neighborhood <w>crank</w> yelled at the children for playing on the sidewalk.",
                            "target_lang_translations": {
                                "it": "Il <w>bisbetico</w> del quartiere ha sgridato i bambini perché giocavano sul marciapiede."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Una persona scontrosa, irritabile o sgradevole."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scontroso",
                                "target_lang_sense_clarification": "persona dal carattere difficile e irritabile"
                            },
                            {
                                "target_lang_word": "bisbetico",
                                "target_lang_sense_clarification": "persona, spesso anziana, dal carattere difficile e irritabile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "403252cb-c401-3d26-8e73-973b2d694da3",
                    "sense_definition": "A bent piece of an axle or shaft used to impart rotation to a mechanical device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I grind my coffee by hand with a coffee grinder with a <w>crank</w> handle.",
                            "target_lang_translations": {
                                "it": "Macino il caffè a mano con un macinacaffè dotato di <w>manovella</w>."
                            }
                        },
                        {
                            "text": "The mechanic turned the <w>crank</w> to start the old engine.",
                            "target_lang_translations": {
                                "it": "Il meccanico ha girato la <w>manovella</w> per avviare il vecchio motore."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crank handle"
                    ],
                    "target_lang_definitions": {
                        "it": "Un pezzo piegato di un asse o di un albero utilizzato per trasmettere la rotazione a un dispositivo meccanico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "manovella",
                                "target_lang_sense_clarification": "dispositivo meccanico a forma di braccio per azionare una rotazione"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63df0f47-eafd-3349-a043-232393262b13",
                    "sense_definition": "To turn or operate something by means of a crank.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Motorists had to <w>crank</w> their engine by hand.",
                            "target_lang_translations": {
                                "it": "Gli automobilisti dovevano <w>azionare a manovella</w> il motore a mano."
                            }
                        },
                        {
                            "text": "You need to <w>crank</w> the handle to lift the heavy bucket.",
                            "target_lang_translations": {
                                "it": "Devi <w>girare la manovella</w> per sollevare il secchio pesante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crank up"
                    ],
                    "target_lang_definitions": {
                        "it": "Azionare o far girare qualcosa tramite una manovella."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "azionare a manovella",
                                "target_lang_sense_clarification": "mettere in funzione un meccanismo usando una manovella"
                            },
                            {
                                "target_lang_word": "girare la manovella",
                                "target_lang_sense_clarification": "l'atto fisico di ruotare una manovella"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b71f735e-edc1-34a1-8670-191f70bd2c44",
                    "sense_definition": "Strange, weird, or odd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eccentric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had some very <w>crank</w> ideas about how the world works.",
                            "target_lang_translations": {
                                "it": "Aveva delle idee molto <w>strampalate</w> su come funziona il mondo."
                            }
                        },
                        {
                            "text": "The professor's <w>crank</w> theories were ignored by his colleagues.",
                            "target_lang_translations": {
                                "it": "Le teorie <w>strampalate</w> del professore sono state ignorate dai suoi colleghi."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "weird",
                        "odd"
                    ],
                    "target_lang_definitions": {
                        "it": "Strano, bizzarro o insolito."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "strampalato",
                                "target_lang_sense_clarification": "riferito a idee o teorie bizzarre e poco sensate"
                            },
                            {
                                "target_lang_word": "eccentrico",
                                "target_lang_sense_clarification": "riferito a qualcosa che si discosta dalla norma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}