                "senses": [
                    {
                        "sense_id": "638d7b83-007f-3544-9897-62d46b6bf99b",
                        "entry_id": "e537601f-6b2a-3bc4-835f-d24366e314f6",
                        "glosses": [
                            "Beschreibung für die Anfertigung kleinerer Gegenstände (zumeist aus Papier, Pappe oder einem anderen Material); Erklärung, wie man etwas bastelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0180a66-10d7-4613-be4b-477b6d3d54fc",
                                "sense_id": "638d7b83-007f-3544-9897-62d46b6bf99b",
                                "text": "„Die Schüler/innen einer zweiten Klasse erhalten die Aufgabe, eine Bastelanleitung für eine Fingerpuppe für ihre Parallelklassen zu verfassen.“"
                            },
                            {
                                "example_id": "fd1147df-ea11-47b3-a476-368638179842",
                                "sense_id": "638d7b83-007f-3544-9897-62d46b6bf99b",
                                "text": "„Die illustrierte Bastelanleitung schlägt vor, dass der Schüler im Wesentlichen aus Pappe, einer Briefklammer und Gummiringen ein solches Modell herstellen soll.“"
                            },
                            {
                                "example_id": "0b59d778-d74b-4d64-9944-bc198b408888",
                                "sense_id": "638d7b83-007f-3544-9897-62d46b6bf99b",
                                "text": "„Die Kollegin teilte nicht nur das Material aus, sondern auch die Bastelanleitung, auf der die Form und die Maße der beiden Pappstücke zu sehen waren. Die Stellen, an denen die Gummis eingezogen werden müssen, waren markiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
