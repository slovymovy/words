                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2840a021-42a2-4afd-99f8-42a38f5af5b3",
                                "sense_id": "33f41a91-028f-3c3f-9928-c93050b03eda",
                                "text": "Miał na imię Olaf i pracował w urzędzie marszałkowskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "979bec5f-2471-41ac-93cc-93a506056a2a",
                        "source_entry_id": "c448de3d-1b81-32bb-956c-1c3121234a93",
                        "source_sense_id": "33f41a91-028f-3c3f-9928-c93050b03eda",
