            {
                "entry_id": "151fe9e2-6e79-3d03-8d63-8e8485141040",
                "word": "didactique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dba40627-e127-477b-a5c5-42bd9b82f6ee",
                        "entry_id": "151fe9e2-6e79-3d03-8d63-8e8485141040",
                        "tags": [
                            "plural"
                        ],
                        "form": "didactiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70a5d0a1-b1b7-3266-96d9-c79b928c6742",
                        "entry_id": "151fe9e2-6e79-3d03-8d63-8e8485141040",
                        "glosses": [
                            "Étude des questions posées par l’enseignement et l’acquisition des connaissances dans les différentes disciplines scolaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff12f444-e9bd-4f3a-ad2f-f088aa7d626b",
                                "sense_id": "70a5d0a1-b1b7-3266-96d9-c79b928c6742",
                                "text": "La didactique se différencie de la pédagogie par le rôle central des contenus disciplinaires et par sa dimension épistémologique (la nature des connaissances à enseigner)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0de7ab5-2950-41b2-829d-891b15338ac0",
                        "source_entry_id": "151fe9e2-6e79-3d03-8d63-8e8485141040",
                        "source_sense_id": "70a5d0a1-b1b7-3266-96d9-c79b928c6742",
                        "target_lang_word": "Didaktik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Didaktik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                        "entry_id": "4b17b19b-a5ae-3560-8614-b7befd0f807e",
                                        "glosses": [
                                            "Wissenschaft vom Lehren. Sie ergänzt sich mit der Didaktik zur Berufswissenschaft der Lehrer."
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d14221-6a25-44d8-b4cd-c5645866d810",
                                                "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                                "text": "Heute ist Didaktik eng mit der Mathetik verbunden, weil man nach modernem Verständnis nichts erfolgreich lehren kann, ohne sich gleichzeitig zu fragen: Wie lernen Schüler?"
                                            },
                                            {
                                                "example_id": "cf1b31a3-c644-4934-9704-23cb34ff7dd8",
                                                "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                                "text": "„Zur Didaktik der Spielerziehung gehört nicht nur die lernende Vermittlung der Spieltechnik und Spieltaktik und die Sicherung eines Spielrahmens, der dem Wesen des Spiels gerecht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b42df1a8-df68-363e-8930-d7a06a974eac",
