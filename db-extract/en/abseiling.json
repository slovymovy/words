                "senses": [
                    {
                        "sense_id": "c89ab5f6-cdc8-3f10-8523-a9fb82e60ad6",
                        "entry_id": "398458c7-556f-3450-87a9-28dfcb501b1f",
                        "glosses": [
                            "The process or act of abseiling."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f557a5d8-41f3-4d29-b88a-ce509b8c9995",
                                "sense_id": "c89ab5f6-cdc8-3f10-8523-a9fb82e60ad6",
                                "text": "He pictured the abseiling, literally a flight down the mountain on the doubled cord of his long rope, and he thought that those hours speeding down the cliffs would be the finest of his life."
                            },
                            {
                                "example_id": "f3064778-fc39-47c6-b845-632f9c00b787",
                                "sense_id": "c89ab5f6-cdc8-3f10-8523-a9fb82e60ad6",
                                "text": "Greenpeace offers its supporters the chance to fund brave and glamorous adventures (inflatables pitted against whalers; abseilings against smokestacks), and in exchange to wear something very like the medieval pilgrim's token: to put a rainbow sticker in their car windows."
                            },
                            {
                                "example_id": "fbcad410-f292-4dda-b25e-54bc97a5c974",
                                "sense_id": "c89ab5f6-cdc8-3f10-8523-a9fb82e60ad6",
                                "text": "Moderate ravines, with some drops requiring rope or prolonged swims, include Oscuros de Balce/s, Estrechos de Balce/s and Gorgoncho/n, all close to Bierge, while experts-only abysses above Rodellar include Gorgas Negras, Otin and Mascu/n Superior, all involving thirty-metre abseilings and strenuous clambering."
                            },
                            {
                                "example_id": "2378ef4c-43ed-4f15-912d-1958ead2ebd0",
                                "sense_id": "c89ab5f6-cdc8-3f10-8523-a9fb82e60ad6",
                                "text": "Between that and the abseiling, I think I left enough skin behind on those rocks to cover an entire second person."
                            }
                        ]
                    }
                ],
