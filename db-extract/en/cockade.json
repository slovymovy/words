                    {
                        "translation_id": "6f79e8e2-b484-4bd1-9d4b-3d104588556a",
                        "source_entry_id": "f7fd83cc-2c9f-3f78-aa0f-0622bb065729",
                        "source_sense_description": "a rosette worn in a hat as an office or party badge",
                        "target_lang_word": "cocarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c651244-0842-3a59-8654-41c41128f7fd",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Insigne en étoffe ou en métal qui était porté principalement à la coiffure et surtout par les soldats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66b85cc-9e4a-42fc-a029-516ebfced590",
                                                "sense_id": "4c651244-0842-3a59-8654-41c41128f7fd",
                                                "text": "— Je vous avouerai, monsieur, que c’est pour la première fois que je vois dans mon salon la cocarde que vous portez ; mais je vous prie de l’y ramener souvent."
                                            },
                                            {
                                                "example_id": "adfb57b4-9387-41c6-a80b-0b48b46720be",
                                                "sense_id": "4c651244-0842-3a59-8654-41c41128f7fd",
                                                "text": "Abraham Knupfer distingue son chapeau à trois cornes, ses aiguillettes de laine rouge, sa cocarde traversée d’une ganse, et sa queue nouée d’un ruban."
                                            },
                                            {
                                                "example_id": "c5beb77c-f8f1-463e-a4f5-e59171f1bf1d",
                                                "sense_id": "4c651244-0842-3a59-8654-41c41128f7fd",
                                                "text": "Il sortit dans la rue avec une énorme cocarde tricolore. « Je voudrais bien savoir, dit-il, qui est-ce qui va venir m’arracher cette cocarde. » On l’aimait dans le quartier. « Personne, capitaine, personne, » lui répondit-on, et on le ramena doucement par le bras à la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c50fa7-2e1c-3268-a2f5-5b47372ef948",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Ornement en ruban plissé dont on garnit les chapeaux de femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a5e6ed-b590-4ccc-93df-b5fdded2a253",
                                                "sense_id": "58c50fa7-2e1c-3268-a2f5-5b47372ef948",
                                                "text": "Le Valentin devait faire un cadeau à sa Valentine, qui lui en donnait, sous forme d'une cocarde en ruban, un reçu scellé d'un baiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16590253-ad00-3dbf-bc3d-a4e25268bca7",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Insigne de certaines livrées et de certains attelages."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c58d38ac-b8f9-3ddf-908d-2a6849de948e",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Boucle de tissu, située sur la tête d'un taureau, d'une vachette, que des joueurs tentent d'enlever."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef2e724-ee30-45be-aeab-c0be324d4363",
                                                "sense_id": "c58d38ac-b8f9-3ddf-908d-2a6849de948e",
                                                "text": "La vachette apparaissait aux portes du toril, elle fonçait au milieu de la piste, en marquant un temps d'arrêt, pour regarder ceux qui l'entouraient. Les razeteurs la contournaient, en sifflant, et d'une main ils essayaient de lui enlever la cocarde accrochée aux cornes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd2febc-645f-3baf-a2a2-a8c5d7d78f14",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Badge (pour s’identifier)."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acadfbb0-24db-3cbc-9252-4101bbf6ca50",
                                        "entry_id": "aee81b74-82e4-3090-ba8e-69cbcd7bb538",
                                        "glosses": [
                                            "Naïve, niaise, prétentieuse, débauchée."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
