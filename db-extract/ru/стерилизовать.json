                ],
                "translations": [
                    {
                        "translation_id": "4d00ca53-8dd1-4912-8328-6e4be5f995d7",
                        "source_entry_id": "5ceb0e25-55cb-3631-a4c4-b61ac9944c4a",
                        "target_lang_word": "sterilize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sterilize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80d3b363-05f0-3bfe-9e51-595d42398bb3",
                                        "entry_id": "457d2e93-7061-36e4-9727-dbac484a5f45",
                                        "glosses": [
                                            "To deprive of the ability to procreate."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a00dc1f-4037-431d-926b-4a496ba9b07e",
                                                "sense_id": "80d3b363-05f0-3bfe-9e51-595d42398bb3",
                                                "text": "If monogeny is determined exclusively by a cytoplasmic factor, then it is easy to see that the factor will either die out (if it causes arrhenogeny) or will become fixed and thereby sterilize the population (if it causes thelygeny)."
                                            },
                                            {
                                                "example_id": "55a69ad5-2f7b-4f19-a4b1-bba0e2e32b27",
                                                "sense_id": "80d3b363-05f0-3bfe-9e51-595d42398bb3",
                                                "text": "In China, the issue of forced abortions has resurfaced with the allegations by escaped activist Chen Guangcheng, but the outgoing premier Wen Jiabao has publicly called for a ban not only on forced abortion, but also of “fetus gender identification.” Nevertheless, many women who have abortions in China are also sterilized against their will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b634c66a-de1b-3028-b33b-1dc96c9042eb",
                                        "entry_id": "457d2e93-7061-36e4-9727-dbac484a5f45",
                                        "glosses": [
                                            "To make unable to produce; to make unprofitable."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c797fd7-18c1-3f08-a486-383717e0b48e",
                                        "entry_id": "457d2e93-7061-36e4-9727-dbac484a5f45",
                                        "glosses": [
                                            "To kill, deactivate (denature), or destroy (break apart) all living, viable microorganisms and spores on a surface, in a fluid, or contained in a compound, such as culture media or a medical product."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e75ca1-e214-4ef6-98c8-6d522de61568",
                                                "sense_id": "6c797fd7-18c1-3f08-a486-383717e0b48e",
                                                "text": "One machine in which Mr. Taylor takes special pride is a salmon canner, which engulfs a whole salmon, decapitates and decaudates it, skins it, blows out its viscera, cuts it into pieces, deposits them in the can, sterilizes them […]"
                                            },
                                            {
                                                "example_id": "1e93da3a-3229-4cb3-8f07-c4ffb7d39487",
                                                "sense_id": "6c797fd7-18c1-3f08-a486-383717e0b48e",
                                                "text": "The bottled juice must be heated to a temperature and for a time sufficient to attain a sterilizing temperature at the coolest point, usually the center of the bottle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a06159c2-fd37-3eb4-98a6-fe06759c679e",
                                        "entry_id": "457d2e93-7061-36e4-9727-dbac484a5f45",
                                        "glosses": [
                                            "To render a planet like Earth permanently uninhabitable to all life, including even microbes, causing their complete extinction."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee0a9029-fffb-3b35-a53c-17f133e94e27",
                                        "entry_id": "457d2e93-7061-36e4-9727-dbac484a5f45",
                                        "glosses": [
                                            "To redact (a document), removing classified or sensitive material."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a81bca-c83e-4d99-ae59-5c693931de55",
                                                "sense_id": "ee0a9029-fffb-3b35-a53c-17f133e94e27",
                                                "text": "[…] (minus, of course, any information that might identify the agent and other operational personnel), or he might code it or \"sterilize\" it, and reward the foreign station chief in some other way."
                                            },
                                            {
                                                "example_id": "faa630e9-d699-48d0-b935-45a10ba992a1",
                                                "sense_id": "ee0a9029-fffb-3b35-a53c-17f133e94e27",
                                                "text": "The same phenomenon is also detectable in the records of the meetings of NATO committees: the priority of avoiding any manifestation of internal disagreements led to the production of 'sterilized' records of discussions which evidently were significantly more lively than shown in the official papers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
