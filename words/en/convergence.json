                                "target_lang_sense_clarification": "рек"
                            },
                            {
                                "target_lang_word": "схождение",
                                "target_lang_sense_clarification": "дорог или путей"
                            },
                            {
                                "target_lang_word": "место встречи",
                                "target_lang_sense_clarification": "путей"
                            }
