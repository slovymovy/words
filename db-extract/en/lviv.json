                        "target_lang_word": "Lemberg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lemberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c883475f-3e03-3627-a69f-c7527b5a6c71",
                                        "entry_id": "f48b105f-9a28-3a8b-a6fd-f64695691e76",
                                        "glosses": [
                                            "Stadt in der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7738ba-2969-4a3e-abb8-9d76e20a1ff4",
                                                "sense_id": "c883475f-3e03-3627-a69f-c7527b5a6c71",
                                                "text": "Lemberg liegt in der Westukraine."
                                            },
                                            {
                                                "example_id": "28a7e95c-2bf0-454d-b67f-2d02586ef4da",
                                                "sense_id": "c883475f-3e03-3627-a69f-c7527b5a6c71",
                                                "text": "Lemberg besitzt eine schöne Altstadt."
                                            },
                                            {
                                                "example_id": "47df2f13-3e0e-4f04-89fd-b62c2681a6b3",
                                                "sense_id": "c883475f-3e03-3627-a69f-c7527b5a6c71",
                                                "text": "„Mit einigen zionistischen Freunden gelangt er über den Bug nach Lemberg, das die Deutschen nach dem Polenfeldzug den Sowjets überließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "712b4599-733c-47f5-b04a-5e96d6020620",
                        "source_entry_id": "eed7ef31-0257-34a5-8efe-936f4bbf1367",
                        "source_sense_description": "city in western Ukraine",
                        "target_lang_word": "Lwiw",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lwiw",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
                                        "entry_id": "51c008ec-7ad4-35c6-88e0-e6b9568459ec",
                                        "glosses": [
                                            "Großstadt im Westen der Ukraine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01f701c-8a38-48dc-9237-f3f617c0af98",
                                                "sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
                                                "text": "Er lebt seit zehn Jahren in Lwiw."
                                            },
                                            {
                                                "example_id": "696eb78e-8ec2-4941-b15a-0ecba548be5a",
                                                "sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
                                                "text": "„Die Fluchtrouten führten etwa nach Poltawa, nach Lwiw oder in benachbarte EU-Länder.“"
                                            },
                                            {
                                                "example_id": "ac0eea29-7b7a-42c5-9959-5631904bdd62",
                                                "sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
                                                "text": "„Russland sagt zu, neue Fluchtkorridore zu öffnen, und die westukrainische Stadt Lwiw bittet um Unterstützung bei der Unterbringung von Kriegsflüchtlingen.“"
                                            },
                                            {
                                                "example_id": "a8aecca3-1cdf-477e-9b8d-7412715c6f30",
                                                "sense_id": "471efe88-c71c-3fb1-8ecb-90fddb41edd6",
                                                "text": "„Jetzt organisiert er für einen befreundeten Arzt im Lwiw dringend benötigte Medikamente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
