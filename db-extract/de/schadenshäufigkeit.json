                "senses": [
                    {
                        "sense_id": "c4a2ca7c-4ef3-377e-80a5-3b9299131fce",
                        "entry_id": "93c7f913-11f5-384b-8e95-0896e761e0dc",
                        "glosses": [
                            "Kennzahl, welche die Häufigkeit des Auftretens von Schadensfällen wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97168f4a-7ff2-4270-a8f0-1dad5c4f06c6",
                                "sense_id": "c4a2ca7c-4ef3-377e-80a5-3b9299131fce",
                                "text": "„Euroherc habe sich in Österreich vor allem auf die Versicherungen von Fuhrparks (Taxis, Carsharing etc.) spezialisiert und Kunden mit Dumpingpreisen angelockt. Gerade in diesen Segmenten sei die Schadenshäufigkeit groß.“"
                            },
                            {
                                "example_id": "cf22cc22-b38e-4972-a5e9-af56e2b684de",
                                "sense_id": "c4a2ca7c-4ef3-377e-80a5-3b9299131fce",
                                "text": "„Endgültig geklärt ist nun auch, ob Frauen oder Männer sicherer fahren. Sie liegen bei der Schadenshäufigkeit nahezu gleichauf.“"
                            },
                            {
                                "example_id": "f630359d-bce6-4990-8278-ccb9a9b0aa8e",
                                "sense_id": "c4a2ca7c-4ef3-377e-80a5-3b9299131fce",
                                "text": "„Genau wie ein Versicherungsagent analysieren die Leasingunternehmen Fahrzeugflotte, Schadenshäufigkeit, Art der Schäden etc. und erstellen auf Grundlage der Analyseergebnisse ein individuelles Versicherungsangebot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
