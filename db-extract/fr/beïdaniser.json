                "senses": [
                    {
                        "sense_id": "4ce6e661-b546-3581-8e16-b3fbf64a7ecb",
                        "entry_id": "a29369d2-b352-3caa-a1f6-af47133ff20f",
                        "glosses": [
                            "Donner un caractère beidane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d469ff1-4f56-48dd-af5f-15c8903146c8",
                                "sense_id": "4ce6e661-b546-3581-8e16-b3fbf64a7ecb",
                                "text": "Les Français disaienï en riant que nous étions « complètement beïdanisées »."
                            },
                            {
                                "example_id": "2e60937a-fde9-4c13-80ae-464486e8e1a3",
                                "sense_id": "4ce6e661-b546-3581-8e16-b3fbf64a7ecb",
                                "text": "Au fond, il faut me « beïdaniser » l'âme."
                            },
                            {
                                "example_id": "44482a35-56ba-4ced-8036-086f76cc684e",
                                "sense_id": "4ce6e661-b546-3581-8e16-b3fbf64a7ecb",
                                "text": "Dans une autre vidéo, on voit le coordinateur expliquer pourquoi il pense que c’est une évidence que les hratines constituent une communauté à part entière qui devrait être mentionnée dans la constitution et pour bien montrer combien les hratines sont plus proches des négro-mauritaniens que des maures, il parle de traits de caractères négro-mauritaniens latents qui n’attendent que l’occasion pour s’exprimer prouvant que les hratines sont des négro-mauritaniens beïdanisés mais qui ont gardé des caractères culturels de leur origine négro-mauritanienne."
                            }
                        ]
                    }
