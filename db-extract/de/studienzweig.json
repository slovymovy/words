                            {
                                "example_id": "ee2ab2e1-0022-4186-98f1-5970f6b91c82",
                                "sense_id": "3e7b20d3-ce7a-3f7d-924e-430cb7b3d20c",
                                "text": "„Dort wird an einem neuen Studienzweig Religionspädagogik mit dem Schwerpunkt Gemeindepastoral gefeilt.“"
                            },
                            {
                                "example_id": "1b48b156-fc17-4a70-b420-faf062fb6eba",
                                "sense_id": "3e7b20d3-ce7a-3f7d-924e-430cb7b3d20c",
                                "text": "„An anderen Standorten, etwa der TU Graz oder TU Wien, könne die Statistik oft nur eingeschränkt als Studienzweig der Mathematik absolviert werden.“"
                            },
                            {
                                "example_id": "8c343fa0-256e-4229-93cc-0158cbab8c92",
                                "sense_id": "3e7b20d3-ce7a-3f7d-924e-430cb7b3d20c",
                                "text": "„An der Linzer Kunstuniversität wird es einen neuen Studienzweig geben.“"
                            },
                            {
                                "example_id": "2feebc41-81ba-4d7b-ba78-221d4265cab0",
                                "sense_id": "3e7b20d3-ce7a-3f7d-924e-430cb7b3d20c",
                                "text": "„Der Studienzweig Betriebswissenschaften (Wahlplan C) wurde zu einer eigenen Studienrichtung Wirtschaftsingenieurwesen-Maschinenbau aufgewertet, […]“"
                            }
