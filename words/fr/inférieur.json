            "senses": [
                {
                    "sense_id": "55b39aa0-9b50-3aac-99b1-a74082d3400d",
                    "sense_definition": "Qui est situé au-dessous ou plus bas dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La douleur se concentre principalement sur la partie <w>inférieure</w> du dos."
                        },
                        {
                            "text": "Le médecin a examiné attentivement les membres <w>inférieurs</w> de l'athlète blessé."
                        }
                    ],
                    "antonyms": [
