                                    },
                                    {
                                        "sense_id": "4dec66c7-aaa5-3610-b648-d1fb2a4e4076",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "Any of a number of flatfish of species:",
                                            "Lepidorhombus whiffiagonis (megrim), found in the North Atlantic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd641660-26a7-3585-9272-c9b8897b9994",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "Any of a number of flatfish of species:",
                                            "Arnoglossus scapha, found near New Zealand."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f7aabbb-9eb5-3f47-8a96-6353df4cfc73",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
