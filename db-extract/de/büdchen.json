                "senses": [
                    {
                        "sense_id": "aaee55b9-1bf1-3157-b448-bd2fbf66876a",
                        "entry_id": "890bdb95-cbd4-3c8d-a49b-d193d5a96d39",
                        "glosses": [
                            "kleine Bude, kleines Zimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17228fdb-628c-4fb6-8861-1c9b0388ff20",
                                "sense_id": "aaee55b9-1bf1-3157-b448-bd2fbf66876a",
                                "text": "Mehr als dieses Büdchen konnte er sich damals nicht leisten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07b3e734-384e-3938-9483-1f70da97d6e9",
                        "entry_id": "890bdb95-cbd4-3c8d-a49b-d193d5a96d39",
                        "glosses": [
                            "kleines Geschäft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639a0a8a-5d1b-4909-847f-a2cb945bee68",
                                "sense_id": "07b3e734-384e-3938-9483-1f70da97d6e9",
                                "text": "„Wir haben im letzten Jahrtausend Büdchen leer getrunken, wir haben den Aachener Weiher mit einem riesigen See und den Mond über Deutz mit einer Kölsch-Reklame verwechselt.“"
                            },
                            {
                                "example_id": "4f1080b5-5b7a-4d05-94bd-8326ecbaa452",
                                "sense_id": "07b3e734-384e-3938-9483-1f70da97d6e9",
                                "text": "„Das Büdchen war gleich gegenüber.“"
                            },
                            {
                                "example_id": "62c19855-3ff2-47f1-b45b-7addc26f264b",
                                "sense_id": "07b3e734-384e-3938-9483-1f70da97d6e9",
                                "text": "„In früheren Zeiten haben Bundschuh und Onkel Uli zusammen mit Müller sonntagsmorgens am Büdchen von Ketti Bier und Kurze getrunken und die Bild am Sonntag gekauft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
