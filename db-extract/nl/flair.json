                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70b83c23-0fde-3523-9834-9575ac00a4d8",
                        "entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "glosses": [
                            "aanleg, talent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcb9bbb9-27dc-424b-b8a3-153716f76bf2",
                                "sense_id": "70b83c23-0fde-3523-9834-9575ac00a4d8",
                                "text": "Hij had flair om te praten."
                            }
                        ]
                    },
                    {
                        "sense_id": "32492309-5229-3f4c-a662-267a081f8462",
                        "entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "glosses": [
                            "goede intuïtie, goed vermogen om iets te onderscheiden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "17abe28a-1409-3dc8-a551-37c3bb9f283f",
                        "entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "glosses": [
                            "goed ontwikkeld reukvermogen, fijne neus"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8151099b-269e-31c4-a66e-a824c4629616",
                        "entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "glosses": [
                            "positieve persoonlijke uitstraling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079117c7-9ace-46a2-b2b1-9b0e9c031c03",
                                "sense_id": "8151099b-269e-31c4-a66e-a824c4629616",
                                "text": "We gingen zitten op het terras van Caffè Lavena. We hadden ook Florian of Quadri kunnen kiezen om ons te laten afzetten in naam van de nostalgie. Ook daar zouden we er zeker van hebben kunnen zijn dat de toeristische exploitatie van een klinkende naam en een elegant verleden met flair en stijl zou worden uitgevoerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77583d6e-7e51-466b-a185-e5040aa4cc23",
                        "source_entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "source_sense_id": "70b83c23-0fde-3523-9834-9575ac00a4d8",
                        "source_sense_description": "Uitstraling",
                        "target_lang_word": "Flair",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flair",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70fb902f-0941-3fcb-882a-429957f7bb53",
                                        "entry_id": "62d4f7ed-1865-3b29-818e-ba89cd1162c2",
                                        "glosses": [
                                            "positive persönliche Atmosphäre (meist eines Ortes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abbf2da7-2a63-4f14-b7c2-72568e8d9abd",
                                                "sense_id": "70fb902f-0941-3fcb-882a-429957f7bb53",
                                                "text": "„Olympia bescherte Park City internationalen Ruhm, die Silberminen-Geschichte des Ortes sorgte für das besondere Flair.“"
                                            },
                                            {
                                                "example_id": "d2540c90-3ebf-4a27-a38d-8cf3d0bd486a",
                                                "sense_id": "70fb902f-0941-3fcb-882a-429957f7bb53",
                                                "text": "„Er verbreitete ein Flair von Anstand und Wohlstand bis hinunter zur stramm sitzenden, scharf gebügelten Hose, die sich elegant unter der Weste herauswölbte.“"
                                            },
                                            {
                                                "example_id": "4d95fc09-33b6-4dca-9276-45127ab128aa",
                                                "sense_id": "70fb902f-0941-3fcb-882a-429957f7bb53",
                                                "text": "„Die Redakteure hatten schon das britische Flair, redeten sich, nach britischem Muster, gleichzeitig mit Sie und Vornamen an.“"
                                            },
                                            {
                                                "example_id": "c6650108-f750-44bc-8bb3-ab48461298f4",
                                                "sense_id": "70fb902f-0941-3fcb-882a-429957f7bb53",
                                                "text": "„Es hatte eine gute Größe und machte durchaus etwas her, gleichzeitig hatte es Flair und wirkte gemütlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33034e7d-daad-4e31-b063-5add01f9bf59",
                        "source_entry_id": "b685118a-39cf-3474-8b27-d8825e5b3e7f",
                        "source_sense_id": "70b83c23-0fde-3523-9834-9575ac00a4d8",
                        "source_sense_description": "Uitstraling",
                        "target_lang_word": "flair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                                        "entry_id": "f6ffd73c-822f-33a4-bdc5-82cf4f3f9a62",
                                        "glosses": [
                                            "A natural or innate talent or aptitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37ca1fa-93d2-4116-803d-10d56c03e05e",
                                                "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                                                "text": "to have a flair for art"
                                            },
                                            {
                                                "example_id": "88e69d4c-45fe-4d26-abb7-e002daba5eb6",
                                                "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                                                "text": "Poirot was an extraordinary looking little man. [...] The neatness of his attire was almost incredible. I believe a speck of dust would have caused him more pain than a bullet wound. Yet this quaint dandified little man who, I was sorry to see, now limped badly, had been in his time one of the most celebrated members of the Belgian police. As a detective, his flair had been extraordinary, and he had achieved triumphs by unravelling some of the most baffling cases of the day."
                                            },
                                            {
                                                "example_id": "0e09290b-1e3b-4905-907f-8958f52fe94d",
                                                "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                                                "text": "For all his directorial flair, though, Jones may well be best remembered for creating such characters as Arthur “Two Sheds” Jackson, Cardinal Biggles of the Spanish Inquisition, the Scottish poet Ewan McTeagle and the monstrous musician rodent beater in the mouse organ sketch who hits specially tuned mice with mallets."
                                            },
                                            {
                                                "example_id": "74094f9f-8e74-4333-ab89-1f41711a2283",
                                                "sense_id": "6c43f50a-74dd-3f96-ad54-7e4da10edab9",
                                                "text": "The cafard. The cockroach. The French certainly had a flair for labeling their unhappiness. Long ago he had begun to visualize this nagging misery as the insect the word also named."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45f11bd5-996e-3d34-932f-b3e10d6dc96a",
                                        "entry_id": "f6ffd73c-822f-33a4-bdc5-82cf4f3f9a62",
                                        "glosses": [
                                            "Distinctive style or elegance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3dd0d4-c513-428a-9a0b-805c22e6d09c",
                                                "sense_id": "45f11bd5-996e-3d34-932f-b3e10d6dc96a",
                                                "text": "to dress with flair"
                                            },
                                            {
                                                "example_id": "d6c487b0-f856-4d73-b697-0a1ac9e71401",
                                                "sense_id": "45f11bd5-996e-3d34-932f-b3e10d6dc96a",
                                                "text": "Each writer offers a unique flair to readers."
                                            },
                                            {
                                                "example_id": "d7b26ca9-e193-41e9-a429-4973e14c7433",
                                                "sense_id": "45f11bd5-996e-3d34-932f-b3e10d6dc96a",
                                                "text": "You know what, Stan, if you want me to wear 37 pieces of flair, like your pretty boy over there, Brian, why don't you just make the minimum 37 pieces of flair?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79be947b-b49c-3cc6-a292-fe7196d5bd3e",
                                        "entry_id": "f6ffd73c-822f-33a4-bdc5-82cf4f3f9a62",
                                        "glosses": [
                                            "Smell; odor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
