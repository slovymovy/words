                            }
                        ]
                    },
                    {
                        "translation_id": "acdeb32e-2f3c-43b5-9c6a-a9e13e475f93",
                        "source_entry_id": "65072d2a-dc75-3766-bc28-943f507aaeeb",
                        "source_sense_description": "moving of objects in an artful manner",
