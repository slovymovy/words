                            {
                                "example_id": "34d801a7-d51f-49aa-9e26-b6c47dba6b8c",
                                "sense_id": "b43d1042-7f2e-3ca5-9185-f8dcf4735dd5",
                                "text": "Eight bills introduced in to Philadelphia City Council on Thursday would repeal laws that have become outdated and unenforced."
                            },
                            {
                                "example_id": "8a4a6f74-2105-4eab-a015-e2f5fd978955",
                                "sense_id": "b43d1042-7f2e-3ca5-9185-f8dcf4735dd5",
                                "text": "As the introduction to a 2016 paper from the New York University School of Law explains: “Unenforced laws are deemed problematic because non-compliance may undermine the rule of law. […]"
                            },
                            {
                                "example_id": "71733cfa-2b57-47fb-a315-9cc57a5645ae",
                                "sense_id": "b43d1042-7f2e-3ca5-9185-f8dcf4735dd5",
                                "text": "The decision upended state and national politics in a key swing state and brought new attention to so-called zombie laws — long-unenforced statutes that remain on the books."
                            }
                        ]
                    }
