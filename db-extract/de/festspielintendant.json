                "senses": [
                    {
                        "sense_id": "53c3ce53-f13b-300e-af70-dad3424260f6",
                        "entry_id": "2db8327a-bdeb-374f-898a-aaa5a16ab856",
                        "glosses": [
                            "(männliche^☆) Person, deren Aufgabe die (künstlerische) Leitung von Festspielen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65856ab-dfd3-45ec-9db9-ab24bcdd3c24",
                                "sense_id": "53c3ce53-f13b-300e-af70-dad3424260f6",
                                "text": "„Am Freitag feiert der geschasste Festspielintendant Kuhn anlässlich Haselsteiners 75. Geburtstags sein Comeback in Erl.“"
                            },
                            {
                                "example_id": "e2e2348e-e54b-4dbc-bf6e-87fea8a47ec9",
                                "sense_id": "53c3ce53-f13b-300e-af70-dad3424260f6",
                                "text": "„Joern Hinkel ist der Nachfolger von Dieter Wedel, der seinen Posten als Festspielintendant im vergangenen Jahr geräumt hat, nachdem ihm Schauspielerinnen zum Teil schwere sexuelle Übergriffe vorgeworfen hatten.“"
                            },
                            {
                                "example_id": "48d458c7-65a1-4b48-b459-4a7a3b54930b",
                                "sense_id": "53c3ce53-f13b-300e-af70-dad3424260f6",
                                "text": "„Dazu passt die Ouverture spirituelle, die Serie an geistlicher Musik als Einbegleitung der Festspiele, die bereits unter Alexander Pereira, Festspielintendant von 2012 bis 2014, eingeführt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
