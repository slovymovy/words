                            },
                            {
                                "target_word": "kies",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "96d9e145-e1e3-346e-9e9f-33a19795cef5",
                                        "entry_id": "c1a10ce7-d0bc-35a1-9df1-b69621f093cf",
                                        "glosses": [
                                            "van een nette smaak blijk gevend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a14620c4-aa31-4790-9452-a67f9e920be6",
                                                "sense_id": "96d9e145-e1e3-346e-9e9f-33a19795cef5",
                                                "text": "Ik vind dat niet erg kies."
                                            },
                                            {
                                                "example_id": "ce3a5c42-1d5f-4dee-b499-e032af5f409b",
                                                "sense_id": "96d9e145-e1e3-346e-9e9f-33a19795cef5",
                                                "text": "Ik vind het ook niet zo kies dat je ons dit hebt meegedeeld uitgerekend op de avond van papa's verjaardag."
                                            },
                                            {
                                                "example_id": "d366f5a2-cb72-44a4-83e9-126f56e399a0",
                                                "sense_id": "96d9e145-e1e3-346e-9e9f-33a19795cef5",
                                                "text": "Nella ziet dat Otto heel kies zijn mond dept."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kies",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "16df2e27-dc2c-308f-ada7-25c9bf7ec09e",
                                        "entry_id": "69bbd09a-3761-3a07-8cbc-3951e9416e35",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van kiezen"
