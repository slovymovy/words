                "senses": [
                    {
                        "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                        "entry_id": "460140a5-c6c1-3604-80cc-5721c3137d57",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ba5632-f364-40d4-8b08-05e05580b926",
                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                "text": "Mon cher Arthur, je t’avais donné le seul moyen que je connusse de garder Aurélie, et tu n’as pas voulu…"
                            },
                            {
                                "example_id": "1293f4b5-1ec2-4287-a3f3-c9325a988224",
                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                "text": "Une fois les voitures loin derrière, les deux chiennes d’Aurélie Thorel gambadent libres sur les sentiers de La Chapelle-des-Pots, plongeant même dans les cours d’eau."
                            },
                            {
                                "example_id": "bc93dbc9-690f-464f-84a8-b8958da926cc",
                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                "text": "Le programme est animé par le célèbre chef Norbert Tarayre, la journaliste Aurélie Chaigneau et le meilleur ouvrier de France Gilles Goujon."
                            }
                        ]
                    }
                ],
                "translations": [
