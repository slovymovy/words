        "fr-extract.jsonl": [
            {
                "entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                "word": "prologue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f068727e-ef4c-4d2a-96f2-2084e711ecbf",
                        "entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                        "tags": [
                            "plural"
                        ],
                        "form": "prologues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cc5f797-0c69-3dfc-af0a-3bf5dcff610e",
                        "entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                        "glosses": [
                            "Discours préliminaire, avant-propos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa03b9ec-e3dd-4ff1-8694-5074d21dcd9e",
                                "sense_id": "6cc5f797-0c69-3dfc-af0a-3bf5dcff610e",
                                "text": "Ce prologue le fatiguait, mais il ne pouvait l’écourter. L’éloquence fait partie de la fonction ; et il en avait trop complaisamment composé les périodes pour se priver de la satisfaction de s’entendre les phraser et de jouir de ces cadences étudiées."
                            }
                        ]
                    },
                    {
                        "sense_id": "7890b867-0c0e-3e28-b4c8-6c233876fc0f",
                        "entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                        "glosses": [
                            "Morceau qui sert de prélude à une pièce dramatique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9b78f7-084b-42b1-8189-c94e8010398a",
                                "sense_id": "7890b867-0c0e-3e28-b4c8-6c233876fc0f",
                                "text": "D’admirables prologues précèdent la plupart des tragédies grecques."
                            },
                            {
                                "example_id": "e8219711-4e52-4688-a467-cb281b211b04",
                                "sense_id": "7890b867-0c0e-3e28-b4c8-6c233876fc0f",
                                "text": "En France, on a longtemps mis des prologues au commencement des opéras."
                            },
                            {
                                "example_id": "1217928f-c4ec-4fc1-b10d-46d28c003a3b",
                                "sense_id": "7890b867-0c0e-3e28-b4c8-6c233876fc0f",
                                "text": "Ainsi, le drame auquel le dernier des Scaër se trouvait mêlé avait commencé en 1860 par un sanglant prologue; on était en 1870 et rien n'annonçait encore qu'il dût bientôt finir."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ad46ce1-d0df-31b1-80c1-cda43c709b8e",
                        "entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                        "glosses": [
                            "Course contre-la-montre au début d’une course à étapes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9777084c-d417-4a4a-9025-74cc9518ac95",
                                "sense_id": "4ad46ce1-d0df-31b1-80c1-cda43c709b8e",
                                "text": "Ce mardi 26 avril, le prologue de la 75ᵉ édition du Tour de Romandie a vu Ethan Hayter (Ineos-Grenadiers) s’imposer. Le Britannique de 23 ans a bouclé les 5,12 kilomètres en cinq minutes et cinquante-deux secondes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4198e3f-b509-4328-b5d7-d48aa5826cb2",
                        "source_entry_id": "f12fe065-38d5-3b47-bd86-8d273358a214",
                        "target_lang_word": "Prolog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prolog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7994fc98-f2f7-3711-b0a5-334cde7bd0b8",
                                        "entry_id": "d341972f-f8ab-36aa-90e7-5da906b71884",
                                        "glosses": [
                                            "Einführung zu einem Drama, zu einer Aufführung eines Dramas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2f139c-39c8-4e39-ad60-4d9386001fac",
                                                "sense_id": "7994fc98-f2f7-3711-b0a5-334cde7bd0b8",
                                                "text": "Vor Goethes Tragödie »Faust Erster Teil« steht der „Prolog im Himmel“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfd0f27b-9c36-3414-b761-e9570c1b0585",
                                        "entry_id": "d341972f-f8ab-36aa-90e7-5da906b71884",
                                        "glosses": [
                                            "Vorrede, Einführung zu einem folgenden Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71397b23-fbb2-4efc-9efd-e7aa6dc36677",
                                                "sense_id": "bfd0f27b-9c36-3414-b761-e9570c1b0585",
                                                "text": "„Das letzte Kapitel hat noch einmal gezeigt, wovon schon im Prolog die Rede war – die Welt des Jiddischen, die es ohnehin kaum noch gibt, ist im deutschen Sprachraum zur fernen Vergangenheit geworden.“"
                                            },
                                            {
                                                "example_id": "4144f42f-ed8c-415e-abe2-71de46d41d01",
                                                "sense_id": "bfd0f27b-9c36-3414-b761-e9570c1b0585",
                                                "text": "„Manchmal hebt die Erzählung mit einem Prolog oder, besser, einer Art sehr langsam einsetzenden Prologes an, in dem jedoch die Hauptelemente der Geschichte in Gestalt von Anspielungen konzentriert sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b99841d-be18-36bd-86a3-21217c0bcc7d",
                                        "entry_id": "d341972f-f8ab-36aa-90e7-5da906b71884",
                                        "glosses": [
                                            "eine logische Programmiersprache"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c82f871d-c6c7-3452-85cf-09fcf6e18cb8",
                                        "entry_id": "d341972f-f8ab-36aa-90e7-5da906b71884",
                                        "glosses": [
                                            "ein slawisches Heiligenverzeichnis"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "cbf4be39-8b1c-392b-9f17-eed18b3f2bd1",
                                        "entry_id": "d341972f-f8ab-36aa-90e7-5da906b71884",
                                        "glosses": [
                                            "Auftaktzeitfahren im Radrennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ab9669-d7a3-4456-9490-4ed419e518e6",
                                                "sense_id": "cbf4be39-8b1c-392b-9f17-eed18b3f2bd1",
                                                "text": "Den Prolog konnte der Vorjahressieger wieder gewinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5d593eb-c838-487a-b12e-01f16b48f9da",
