                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "327ef2f8-7cb7-3e35-852b-6b3720138c5d",
                        "entry_id": "6937e3f8-6c0d-39c6-bbe4-7e7912c4973d",
                        "glosses": [
                            "D'une manière édaphique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c7a1ee-cd7a-4e1b-8d6e-b1dc9b84bc59",
                                "sense_id": "327ef2f8-7cb7-3e35-852b-6b3720138c5d",
                                "text": "L’association à Scleranthus annuus se rapproche « écologiquement » et « édaphiquement » de l’association à Cicendia filiformis avec laquelle elle possède en commun un certain nombre d’espèces accessoires."
                            },
                            {
                                "example_id": "7f344c88-65cb-4e5e-8e23-4ace179cecd2",
                                "sense_id": "327ef2f8-7cb7-3e35-852b-6b3720138c5d",
                                "text": "Ainsi que l’ont fait remarquer en particulier MM. Allorge et De Litardière, des pelouses « édaphiquement comparables » et de même déclivité présentent des différences assez accusées pour une orientation différente, N. ou S."
                            },
                            {
                                "example_id": "bb18ff61-c25b-4ce1-a9ca-2fb621eeddc8",
                                "sense_id": "327ef2f8-7cb7-3e35-852b-6b3720138c5d",
                                "text": "Leur but est de démontrer l’homologie de la flore et de la faune dans trois stations édaphiquement et climatiquement proches, distantes d'une dizaine de kilomètres."
                            }
                        ]
                    }
                ],
