                },
                {
                    "sense_id": "79cf0f13-c311-37c3-b343-8564ac008d2a",
                    "sense_definition": "Excellent or very good.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music at the club last night was <w>fierce</w>.",
                            "target_lang_translations": {
                                "ru": "Музыка в клубе вчера вечером была просто <w>огонь</w>.",
                                "zh": "昨晚俱乐部里的音乐真是太<w>棒</w>了。"
                            }
                        },
                        {
                            "text": "When asked about the party, he simply replied that it was <w>fierce</w>.",
                            "target_lang_translations": {
                                "ru": "Когда его спросили о вечеринке, он просто ответил, что она была <w>классной</w>.",
                                "zh": "当被问及派对时，他只是简单地回答说那派对太<w>精彩</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incessive"
                    ],
                    "antonyms": [
                        "terrible",
                        "bad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный или очень хороший.",
                        "zh": "极好或非常棒。"
                    },
                    "translations": {
