                    }
                ],
                "senses": [
                    {
                        "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                        "entry_id": "62877484-e14c-390f-8214-149fb47bac21",
                        "glosses": [
                            "Mauvais conducteur, personne dont le comportement au volant est dangereux. Souvent utilisé de manière injurieuse."
                        ],
                        "tags": [
                            "offensive",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee6c030-6473-423c-9d7a-9dfad0bda6c7",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "Le chauffard qui a mortellement percuté une femme sur le parking d'un restaurant de Béziers (Hérault) dans la nuit de samedi à dimanche a été mis en examen pour assassinat et placé en détention provisoire"
                            },
                            {
                                "example_id": "96b7457b-b233-470e-abb8-ce6c2fdbe76a",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "Et puis il paraît qu’on a tous failli mourir à cause d’un chauffard."
                            },
                            {
                                "example_id": "0d0bd0f9-272c-4918-91cd-d777a9c75a65",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "C’est lui qui m’a permis de me redresser et de remarcher après qu’un chauffard m’a renversée à bicyclette quand j’avais 19 ans et laissée polytraumatisée, en miettes, quasi-amnésique, sur la chaussée."
                            },
                            {
                                "example_id": "e536f881-3af9-4678-8d2f-dffe806f3505",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "Les chauffards vinrent rapidement à leur hauteur, les prirent en tenaille en les fracassant sur les côtés tandis que le troisième véhicule les bloquait par l'avant. Il n'y avait plus d'échappatoire possible […]."
                            },
                            {
                                "example_id": "9a41da51-dc30-4887-9d04-95862fd16af8",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "«Peut-on permettre à un chauffard comme vous de conduire sur route ! On devrait vous pendre ! »"
                            },
                            {
                                "example_id": "f75e0679-4003-4500-8ff3-78529153cf7a",
                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                "text": "Un bilan positif donnerait suffisamment de poids pour changer la réglementation et imposer aux vélos électriques les mêmes dispositifs anti-chauffard que sur les voitures."
                            }
                        ]
                    }
                ],
