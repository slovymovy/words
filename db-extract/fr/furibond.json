        "fr-extract.jsonl": [
            {
                "entry_id": "ebfaa50c-33e0-3703-8ba2-b85c6f04a76a",
                "word": "furibond",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "17ff464d-7a70-45ab-9ab2-818a301dde06",
                        "entry_id": "ebfaa50c-33e0-3703-8ba2-b85c6f04a76a",
                        "tags": [
