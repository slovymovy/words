                ],
                "translations": [
                    {
                        "translation_id": "5f101266-96ef-415a-9de9-5fe0c3a0715d",
                        "source_entry_id": "96e95a2b-eaae-3e75-95cc-e3d21f75f3f7",
                        "source_sense_description": "bottle of wine",
                        "target_lang_word": "jéroboam",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jéroboam",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc891760-4572-32a1-8293-7f1f4098eb1b",
                                        "entry_id": "60ea8494-f655-3a40-aaa8-1e56e9869d1c",
                                        "glosses": [
                                            "Grosse bouteille d’une contenance de quatre bouteilles de 75 cl (soit 3 litres)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc6f19c-51d3-4a79-bfeb-5c0cb062f6e4",
                                                "sense_id": "dc891760-4572-32a1-8293-7f1f4098eb1b",
                                                "text": "J’y avais fait ajouter un jéroboam de champagne brut pour nous deux et une bouteille de chartreuse verte pour Lucie."
                                            },
                                            {
                                                "example_id": "309b6468-bff9-4c5d-aa71-63a94ddb6d41",
                                                "sense_id": "dc891760-4572-32a1-8293-7f1f4098eb1b",
                                                "text": "Vêtus de la chemise blanche brodée traditionnelle et portant des gants, des Mexicains discrets circulaient entre les invités avec des plateaux de canapés, foie gras sur toast, caviar sur craquelins, saumon fumé, brochettes de pétoncles miniatures, débarrassant certaines personnes des flûtes vides alors que d'autres serveurs avançaient avec, dans chaque main, des jéroboams de Cordon-Rouge."
                                            },
                                            {
                                                "example_id": "e04c02ff-31be-42a0-b2d4-7cc15ad535ea",
                                                "sense_id": "dc891760-4572-32a1-8293-7f1f4098eb1b",
                                                "text": "Et un plein jéroboam de champagne, que j’eus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cf32c6-6e37-3431-bd55-bc84ab730f0f",
                                        "entry_id": "60ea8494-f655-3a40-aaa8-1e56e9869d1c",
                                        "glosses": [
                                            "Six bouteilles 2/3, soit 5 litres."
                                        ],
                                        "tags": [
                                            "Bordelais"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da8b6915-d085-3b77-b1a3-534f40140896",
                                        "entry_id": "60ea8494-f655-3a40-aaa8-1e56e9869d1c",
                                        "glosses": [
                                            "Contenant de liquide à boire de très grande taille."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703717ed-7062-4ab2-8ff5-929c38ebaa32",
                                                "sense_id": "da8b6915-d085-3b77-b1a3-534f40140896",
                                                "text": "Jéroboam de café en main, j'ai gagné ma classe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
