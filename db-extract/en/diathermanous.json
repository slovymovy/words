                        "glosses": [
                            "Having the property of transmitting radiant heat; diathermal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832e080f-12c5-4058-9237-5fe0af64b225",
                                "sense_id": "dea2a9d1-6526-344a-acd8-03549370ccf6",
                                "text": "Substances which admit of radiation taking place through them are called Diathermanous. Those which do not allow heat to pass through them without becoming themselves hot are called Athermanous. ...If the body is not perfectly diathermanous it stops more or less of the radiation, and becomes heated... instead of transmitting the whole radiation to bodies beyond it."
                            }
