                ],
                "senses": [
                    {
                        "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                        "entry_id": "8e6dc69e-7b92-38e6-8bef-1d26a2ce307c",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ec494b-2f6f-4026-a3f9-924c6fcd1f73",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Xander kommt und geht."
                            },
                            {
                                "example_id": "101b6d19-5502-482d-be0a-b1f2f8130712",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Xanders kamen, sahen und siegten."
                            },
                            {
                                "example_id": "2a4826a8-9aba-4184-88bb-279512862bad",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Frau Xander ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f716f437-f2b5-412d-b00e-b1c1ad80af87",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Herr Xander wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "13d0375c-b97a-4839-b456-cf988ba0987a",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Die Xanders fliegen heute nach Rom."
                            },
                            {
                                "example_id": "c49a1345-4bd8-4c82-8f8b-7f1226555923",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Der Xander trägt nie die Pullover, die die Xander ihm strickt."
                            },
                            {
                                "example_id": "3f46b3da-aabd-456c-97ab-5e44a1b99e52",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Xander kommt, geht der Herr Xander.“"
                            },
                            {
                                "example_id": "b0752393-df93-4c99-b348-a24d5a6cb4d5",
                                "sense_id": "6a59c510-9f0e-3d48-b21e-b5b67e4004ee",
                                "text": "„Die Heylstraße in Berlin – „hier habe ich die schönste Zeit meines Lebens verbracht“, sagte der Fernsehstar zu Familie Xander, als sie 1999 Meysels alte Wohnung kaufte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
