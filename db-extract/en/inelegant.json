                "senses": [
                    {
                        "sense_id": "dca48790-64b5-333d-953c-e812812eb2e0",
                        "entry_id": "f135cc5f-674f-3936-b54f-85afa1c4e498",
                        "glosses": [
                            "Not elegant; not exhibiting neatness, refinement, or precision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a6c322-2109-4524-ba0a-a4f922b5e41a",
                                "sense_id": "dca48790-64b5-333d-953c-e812812eb2e0",
                                "text": "There was still time amid the drama for Ashley Cole to almost mark his 97th cap with a goal but the erratic Pyatov made a fine recovery save after another inelegant attempt to deal with a cross."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa6f633e-6eb8-4975-b5de-2eaceeed2d3e",
                        "source_entry_id": "f135cc5f-674f-3936-b54f-85afa1c4e498",
                        "source_sense_id": "dca48790-64b5-333d-953c-e812812eb2e0",
                        "source_sense_description": "not elegant",
                        "target_lang_word": "neelegantní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
