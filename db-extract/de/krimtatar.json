                "senses": [
                    {
                        "sense_id": "f93fbfed-a98f-3435-8df8-b462b156db68",
                        "entry_id": "db70977d-1ef7-3e5e-81fc-7751bcfb25fd",
                        "glosses": [
                            "Angehöriger seit langer Zeit und teilweise heute noch/wieder auf der Krim ansässigen Tataren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edb0276-9788-4a1a-98d4-57870fedcac8",
                                "sense_id": "f93fbfed-a98f-3435-8df8-b462b156db68",
                                "text": "„Ein Teil der Krimtataren floh in die Türkei, die Verbliebenen erhielten ihren Landbesitz garantiert.“"
                            },
                            {
                                "example_id": "25205422-0ca1-4836-ae68-ea8e73cc9c1b",
                                "sense_id": "f93fbfed-a98f-3435-8df8-b462b156db68",
                                "text": "„Auf der Krim diente fast jeder zehnte Krimtatar in einer bewaffneten Kollaborateurseinheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
