                    },
                    {
                        "translation_id": "65b69a80-289a-419e-bcac-30ff3081bfe2",
                        "source_entry_id": "09938d70-c087-3016-9c50-9d8727120a67",
                        "source_sense_id": "834a0f62-ba0f-3211-a213-0b4c0bfb1dc6",
                        "target_lang_word": "rapporteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f16484-b386-3e90-b162-b4975c1c3bd4",
                                        "entry_id": "b6b656d5-cd86-3bd0-b042-0d3a76dd5d67",
                                        "glosses": [
                                            "Qui rapporte, dénonce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b96de8b5-0841-4472-af64-ec70e4d9084e",
                                                "sense_id": "a3f16484-b386-3e90-b162-b4975c1c3bd4",
                                                "text": "Il est très rapporteur."
                                            },
                                            {
                                                "example_id": "bc07a32f-d676-4184-a0ae-13415a9926af",
                                                "sense_id": "a3f16484-b386-3e90-b162-b4975c1c3bd4",
                                                "text": "Encouragées par les mères et l’école, elles étaient rapporteuses, « je vais le dire ! » constituait leur menace favorite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa1e940-0daf-3e8b-ad0a-048f2b8bb970",
                                        "entry_id": "b6b656d5-cd86-3bd0-b042-0d3a76dd5d67",
                                        "glosses": [
                                            "Qui prépare ou présente un rapport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d082a5c8-17fb-4aed-a321-e4a00dee723e",
                                                "sense_id": "aaa1e940-0daf-3e8b-ad0a-048f2b8bb970",
                                                "text": "Seuls ont la qualité de ministres rapporteurs les ministres principalement chargés d’élaborer la politique que le texte met en œuvre. Tous les ministres intéressés par le contenu du texte ou appelés à le contresigner ne sont pas rapporteurs. Normalement, un seul ministre suffit : celui qui a effectivement piloté la préparation du texte. Il n’est jamais justifié de mentionner plus de trois ministres rapporteurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rapporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee1f299-4930-3202-86f9-0a3193541f9a",
                                        "entry_id": "a5c1bc95-0a4d-3101-9df8-1753e3c73045",
                                        "glosses": [
                                            "Celui qui, par légèreté ou par malice, a coutume d’accuser ou de rapporter ce qu’il a vu, entendu ou encore ce qu’on lui a fait."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8476f8f-f111-4c1a-bbca-42764e6cf9fa",
                                                "sense_id": "6ee1f299-4930-3202-86f9-0a3193541f9a",
                                                "text": "Les enfants sont de petits rapporteurs qui disent tout ce qu’ils voient ou qu’ils entendent."
                                            },
                                            {
                                                "example_id": "6ceae98a-c0c2-4f04-946c-f718ff3232ec",
                                                "sense_id": "6ee1f299-4930-3202-86f9-0a3193541f9a",
                                                "text": "Méfiez-vous de lui, c’est un rapporteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f200b2-af8a-3d87-b605-e5f5617abd97",
                                        "entry_id": "a5c1bc95-0a4d-3101-9df8-1753e3c73045",
                                        "glosses": [
                                            "Celui qui fait le rapport d’un procès, d’une affaire."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71ae8c2-080e-4b5b-95f1-72e5935fb2f7",
                                                "sense_id": "64f200b2-af8a-3d87-b605-e5f5617abd97",
                                                "text": "Le président lui a donné un rapporteur, a nommé un rapporteur."
                                            },
                                            {
                                                "example_id": "963f4d1a-d560-4d01-8c82-adef0fede14d",
                                                "sense_id": "64f200b2-af8a-3d87-b605-e5f5617abd97",
                                                "text": "Instruire son rapporteur de son affaire."
                                            },
                                            {
                                                "example_id": "b1977522-9542-40b0-972b-44cea945912f",
                                                "sense_id": "64f200b2-af8a-3d87-b605-e5f5617abd97",
                                                "text": "Récuser un rapporteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "444b2212-0c9f-3be5-a3d6-26822ce728d9",
                                        "entry_id": "a5c1bc95-0a4d-3101-9df8-1753e3c73045",
                                        "glosses": [
                                            "Celui qu’une organisation a chargé d’exposer ou de suivre une affaire, une question, et qui peut être amené à faire connaître l’avis de ladite organisation."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61cbdd79-edef-4b58-9c45-71bdfb98cf6f",
                                                "sense_id": "444b2212-0c9f-3be5-a3d6-26822ce728d9",
                                                "text": "Le vice-président est assisté d’un rapporteur général et de deux rapporteurs généraux adjoints, qui suivent plus particulièrement les travaux des rapporteurs particuliers."
                                            },
                                            {
                                                "example_id": "84ff3bb4-ab21-4d9c-b6ac-0ad928344b4e",
                                                "sense_id": "444b2212-0c9f-3be5-a3d6-26822ce728d9",
                                                "text": "Les rapporteurs et co-rapporteurs, délégués du CSP, assurent l’évaluation scientifique des produits lors de la demande initiale puis au cours de leur vie post-AMM, y compris les aspects de pharmacovigilance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "995db429-5b9a-3566-b15f-da081b033894",
                                        "entry_id": "a5c1bc95-0a4d-3101-9df8-1753e3c73045",
                                        "glosses": [
                                            "Parlementaire chargé de l’analyse d’un projet de loi ou d’une proposition de loi."
                                        ],
                                        "tags": [
                                            "Législation",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e7497c-8659-4350-b88f-7f9a223b0685",
                                                "sense_id": "995db429-5b9a-3566-b15f-da081b033894",
                                                "text": "L’auteur de la proposition de résolution, également rapporteur de cette proposition de loi, a eu l’occasion de s’exprimer sur ce texte, entre temps renommé par l’Assemblée nationale « lutte contre la manipulation de l’information »."
                                            },
                                            {
                                                "example_id": "d477641e-749b-4921-8728-d6d819602bae",
                                                "sense_id": "995db429-5b9a-3566-b15f-da081b033894",
                                                "text": "Lors de l’examen du projet de loi d’orientation sur l’énergie, les députés ont voté en première lecture un amendement du rapporteur Serge Poignant (UMP), co-signé par Patrick Ollier (UMP), affirmant que la procédure actuelle de délivrance des permis est “lourde et est perçue comme entravante”."
                                            },
                                            {
                                                "example_id": "91f871d2-720c-4dde-9c49-7731680ca286",
                                                "sense_id": "995db429-5b9a-3566-b15f-da081b033894",
                                                "text": "Chaque commission est maîtresse de l’organisation de ses travaux. Elle désigne un ou plusieurs rapporteurs sur le projet de loi dont elle est saisie, sur le rapport desquels elle se prononce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b52a071-8054-3c17-ba02-05e8cae59210",
                                        "entry_id": "a5c1bc95-0a4d-3101-9df8-1753e3c73045",
                                        "glosses": [
                                            "Instrument, le plus souvent en forme de demi-cercle gradué, servant à mesure les angles tracés sur le papier, ou avec lequel on rapporte sur le papier les angles mesurés sur le terrain avec un goniomètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9e5919-8217-44d9-800e-82093472bca4",
                                                "sense_id": "2b52a071-8054-3c17-ba02-05e8cae59210",
                                                "text": "Demain, nous étudierons les angles, apportez votre rapporteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "766301ae-e758-4606-b21a-7f6e19eab1bc",
                        "source_entry_id": "09938d70-c087-3016-9c50-9d8727120a67",
                        "source_sense_id": "834a0f62-ba0f-3211-a213-0b4c0bfb1dc6",
                        "target_lang_word": "доносительский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "доносительский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df67fec2-17f0-3dd9-aa18-a6cd73c74054",
                                        "entry_id": "e5b124e2-97a8-3f65-9ac9-ee69ca3b3652",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительными доноситель, доносительство; свойственный, характерный для них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18bca2ff-8d72-4b5e-8ef8-04d7e1910900",
                                                "sense_id": "df67fec2-17f0-3dd9-aa18-a6cd73c74054",
                                                "text": "В нём доносительским тоном повествовалось об особенно вредном влиянии начётчика Гаврилова, в районе деятельности которого среди сектантов появились новые веяния: проповедь против богатства и богачей осложнилась какими-то толками о том, что наступит время, когда денег не будет вовсе, а община будет вести хозяйство сообща, как единая семья, что не будет ни солдат, ни полиции, ни тюрем, ни начальников, а одни «доверенные люди» у общего имущества."
                                            },
                                            {
                                                "example_id": "e87f18a9-ad45-44f8-80cc-bb793a18e462",
                                                "sense_id": "df67fec2-17f0-3dd9-aa18-a6cd73c74054",
                                                "text": "Доносительская деятельность вдовы Кудрявцевой (писала в Госкомитет печати, чтобы мне запретили выступать о её муже), подлое предательство ею человека, обнажившего шпагу за честь Лемешева, тоже не украсили Сергея Яковлевича."
                                            },
                                            {
                                                "example_id": "c7b9c986-25b7-41ef-b57a-4d82cb622c70",
                                                "sense_id": "df67fec2-17f0-3dd9-aa18-a6cd73c74054",
                                                "text": "И тот давний выпад против чьих-то грязных — и доносительского характера — предположений о Камероновой галерее стал звучать по-другому."
                                            },
                                            {
                                                "example_id": "c1582f3c-ce03-499e-8141-032edca4c3e6",
                                                "sense_id": "df67fec2-17f0-3dd9-aa18-a6cd73c74054",
                                                "text": "Ещё не развернулись в своём доносительском марше госкиновские доброхоты, ещё режиссёрский сценарий — по сути, окончательный проект фильма — не лёг в своей неотвратимости на письменные столы руководителей Гостелерадио."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
