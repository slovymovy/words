                        "entry_id": "a2d34317-52a7-3b0b-92c7-3a4f4270be7a",
                        "glosses": [
                            "An extensive, continent-wide chain of mountains, especially one in the Americas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7306a90e-1425-4781-91bb-c6a17e40d604",
                                "sense_id": "52684a73-e507-3904-9ccb-d97307489d1a",
