                "senses": [
                    {
                        "sense_id": "6652df04-e8af-3e0a-ae42-f862a6af557b",
                        "entry_id": "047fac8e-6bc6-39fd-8426-6ec60d923b06",
                        "glosses": [
                            "einfacher Dienstgrad beim Militär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120a80eb-2f9a-4fc2-9e1e-03840a5e0e32",
                                "sense_id": "6652df04-e8af-3e0a-ae42-f862a6af557b",
                                "text": "„Auch Wachtmeisterin Anna F. wünscht sich, dass das typische Verhalten gegenüber Frauen eingestellt wird.“"
                            },
                            {
                                "example_id": "5fdb4e6f-b009-4248-a3e6-da10a6aff00d",
                                "sense_id": "6652df04-e8af-3e0a-ae42-f862a6af557b",
                                "text": "„Und seit Anfang Jahr wohnt sie bei ihrer Tante in Rafz ZH und leistet in Airolo bei den Sanitätstruppen Militärdienst. Zu Beginn als Rekrutin, inzwischen ist sie Wachtmeisterin und bildet selbst Neuankömmlinge im Wundenverbinden und Infusionenlegen aus.“"
                            },
                            {
                                "example_id": "cfea969f-117d-4ee4-a14f-12004a454476",
                                "sense_id": "6652df04-e8af-3e0a-ae42-f862a6af557b",
                                "text": "„Als Heeresmeister 2016 konnten sich Major Siegfried Putz von der Flieger- und Fliegerabwehrtruppenschule in der Allgemeinen Klasse, Vizeleutnant Jürgen Höllerich von der Luftraumüberwachung in der Seniorenklasse, Wachtmeisterin Rebecca Dörner vom Stabsbataillon 6 in der Damenklasse und Major Rico Förster von der Gebirgsjägerbrigade 23 aus Bad Reichenhall/Deutschland in der Gästeklasse gegen die Konkurrenten durchsetzen und als Sieger feiern lassen.“"
                            },
                            {
                                "example_id": "4b7b06a9-6afa-4404-a281-9e32d9387852",
                                "sense_id": "6652df04-e8af-3e0a-ae42-f862a6af557b",
                                "text": "„Theresa Neubauer aus Deutschlandsberg stellt in der Kaserne Straß ihren Mann und ist Wachtmeisterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5016e1c9-4bea-3446-a5a6-d967a118a1f9",
                        "entry_id": "047fac8e-6bc6-39fd-8426-6ec60d923b06",
                        "glosses": [
                            "einfacher Dienstgrad bei der Polizei"
                        ],
                        "tags": [
                            "Polizei"
                        ],
                        "examples": [
                            {
                                "example_id": "3f42076e-0651-41d8-b515-94e797f3c6c4",
                                "sense_id": "5016e1c9-4bea-3446-a5a6-d967a118a1f9",
                                "text": "„Er stand vor dem Schreibtisch der Wachtmeisterin, Hände hinterm Rücken, musterte sie und fragte: ›Warum trägst du keine Pistole?‹“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
