                    {
                        "translation_id": "094639f7-54f6-42fd-b65b-135cdda1ea29",
                        "source_entry_id": "3e0794b4-75f5-311e-9f53-d42b8ab2ec5c",
                        "source_sense_description": "geology: pieces of rock broken off",
                        "target_lang_word": "Geröll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geröll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                        "entry_id": "045fb55a-7c8b-3ab1-9f3d-4b32e9c889f3",
                                        "glosses": [
                                            "Gesteinssediment mit einer Korngröße oberhalb der von Sand, oft grenzt man nach oben zu Blockgrößen ab. Die Grenzwerte für den Durchmesser sind in Fachwissenschaften oft präzise, aber uneinheitlich festgelegt. Oft wird zudem die Bezeichnung auf leidlich gerundetes Sediment beschränkt. Allgemeinsprachlich wird das Wort oft noch vager verstanden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcbbad1-6683-4216-9616-f71791788164",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "Durch Wind und Wasser abgetragenes Gestein sammelt sich oft als Geröll in Mulden am Fuße der Berge."
                                            },
                                            {
                                                "example_id": "4b5221ab-8e1b-4949-a7e1-60589f7b94a1",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Die Stirnlampe beleuchtet einen Ausschnitt, der kaum mehr als ein paar Beine und etwas Geröll erfasst.“"
                                            },
                                            {
                                                "example_id": "43611977-34c0-4a46-a3d3-ac3d6029f22a",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Ludwig war der erste, der von der Fuhlsbütteler Straße über den Wall von Geröll und Schutt in die Düsternstraße fand.“"
                                            },
                                            {
                                                "example_id": "47b667e2-7357-4ef8-8635-b1a5282c42b5",
                                                "sense_id": "5478e9cf-c1ec-348e-962b-e10d7bfa5b6d",
                                                "text": "„Und dort blieb der Mercedes stehen, weil die Fahrbahn zertrümmert und voller Schutt und Geröll war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
