                        "glosses": [
                            "Person, die Klebstoff inhaliert, um sich in einen Rausch zu versetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0018157-4d51-49bc-b55b-242f766dbd40",
                                "sense_id": "cefe7faa-46fc-3e5c-b0c9-f9f2a2051e94",
                                "text": "„Klebstoffschnüffler werden unter den Bänken am Parkrand und aus den Nischen des für Kinder errichteten Forts hervorkriechen und benebelt von Chemikalien ihren Tag beginnen.“"
                            },
                            {
                                "example_id": "2a4881ca-2332-4a43-bc38-7a00240c7e2c",
                                "sense_id": "cefe7faa-46fc-3e5c-b0c9-f9f2a2051e94",
                                "text": "„Er kannte Klebstoffschnüffler mit einem besseren Kurzzeitgedächtnis als diese Frau.“"
                            }
