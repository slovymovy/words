                ],
                "senses": [
                    {
                        "sense_id": "bbaf78c7-f91c-3784-b1ac-daa9e1be9617",
                        "entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
                        "glosses": [
                            "Art d’essayer en petit les minerais, pour connaître la qualité et la quantité des métaux qu’ils contiennent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b46edac-6a12-3f9f-a542-ed2b620ed1fd",
                        "entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
                        "glosses": [
                            "Analyse quantitative, méthode ayant pour but de séparer les parties constituantes d’un corps et de déterminer leurs proportions relatives."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5895620c-2c06-3e1c-a4a7-d3aaa72172f9",
                        "entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
                        "glosses": [
                            "Ensemble des examens et analyses auxquels sont soumis les divers organes d’un mort, pour déterminer les causes du décès."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8463b7ae-a004-3e83-bcb7-2308a9ed7b99",
                        "entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
                        "glosses": [
                            "Ensemble des épreuves auxquelles on soumet l’appareil respiratoire d’un fœtus pour savoir s’il a respiré avant de mourir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d76d0fc-c624-428c-b028-7b90a2a973a7",
                                "sense_id": "8463b7ae-a004-3e83-bcb7-2308a9ed7b99",
                                "text": "Docimasie pulmonaire, ensemble des épreuves auxquelles on soumet les poumons d'un fétus, à l'effet de constater s'il a respiré, et par conséquent, s'il est sorti vivant du sein de la mère."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6e94703-decb-3be6-a08f-99e8b9d998ef",
                        "entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
                        "glosses": [
                            "Examen auquel étaient soumis, à Athènes, tous les fonctionnaires pour mesurer leur piétée et leur civisme"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "3817e90a-8805-4bc4-8ea5-323159b5ea2f",
                                "sense_id": "a6e94703-decb-3be6-a08f-99e8b9d998ef",
                                "text": "On n’entrait pas en charge sans subir au préalable, devant une section du jury, une sorte d’examen, la docimasie, qui portait sur toute la vie antérieure du candidat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ff8d37d-8e6a-4eab-81ad-ee177fdb8f14",
                        "source_entry_id": "a3752032-ce98-34a8-96e3-74d82da52e6c",
