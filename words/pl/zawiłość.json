                    "semantic_group_id": "zawiłość_cecha",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sędzia zwrócił uwagę na niezwykłą <w>zawiłość</w> tej sprawy kryminalnej.",
                            "target_lang_translations": {
                                "ru": "Судья обратил внимание на необычайную <w>запутанность</w> этого уголовного дела."
                            }
                        },
                        {
                            "text": "Duża <w>zawiłość</w> przepisów podatkowych sprawia kłopoty wielu drobnym przedsiębiorcom.",
                            "target_lang_translations": {
                                "ru": "Большая <w>сложность</w> налогового законодательства создаёт проблемы многим мелким предпринимателям."
                            }
