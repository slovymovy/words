                                                "sense_id": "7113ea0a-33a5-3951-930d-15e750f2ff95",
                                                "text": "Bundaberg is one of my favourite rums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e177422-30a7-30bf-9c53-9b84a0e8cb05",
