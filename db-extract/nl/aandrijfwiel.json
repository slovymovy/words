                    }
                ],
                "senses": [
                    {
                        "sense_id": "696f3438-6e0f-30ea-b496-9aadb34cc75c",
                        "entry_id": "07e0b0ad-754c-3d59-8aa2-4a8f1c32cae3",
                        "glosses": [
                            "wiel dat een toestel in beweging brengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f32d032b-ec51-495a-bc70-a141b936c618",
                                "sense_id": "696f3438-6e0f-30ea-b496-9aadb34cc75c",
                                "text": "\"Het is opmerkelijk hoe snel het verval plaatsvindt\", zegt Schreuder. \"Het begon met schorsingen en blessures, maar dat was slechts een aandrijfwiel. Dat een jonge speler als Donyell Malen ontbreekt, kan niet de enige oorzaak zijn.\""
                            },
                            {
                                "example_id": "e941a8ea-c439-4223-9cf9-677454309973",
                                "sense_id": "696f3438-6e0f-30ea-b496-9aadb34cc75c",
                                "text": "De vinder, Wesley Klonen, vertelt aan 1Limburg dat hij de mijn met een metaaldetector in een bos bij Schinnen gevonden heeft en eerst dacht dat het om een aandrijfwiel van een voertuig ging. Eenmaal thuis zag hij dat er ’iets anders op stond’, waarop hij het roestige apparaat in een handdoek wikkelde en in een plastic tas op zijn scooter meenam naar het politiebureau. Daar werd hem verteld dat het om een Amerikaanse antitankmijn ging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8586492-d4a5-4208-8d40-ae48afc705d2",
                        "source_entry_id": "07e0b0ad-754c-3d59-8aa2-4a8f1c32cae3",
                        "source_sense_id": "696f3438-6e0f-30ea-b496-9aadb34cc75c",
                        "source_sense_description": "wiel dat een toestel in beweging brengt",
                        "target_lang_word": "driving wheel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "driving wheel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3eddc5f-d478-3db8-b212-d994147b5c91",
                                        "entry_id": "46d31ba3-fce5-305d-817b-05c5d88bbe6f",
                                        "glosses": [
                                            "On a steam locomotive, a powered wheel driven by the locomotive's pistons or turbine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bed1b6b-82f5-4924-b313-428fe73b9364",
                                                "sense_id": "c3eddc5f-d478-3db8-b212-d994147b5c91",
                                                "text": "Just after leaving Milford the axle of the driving wheel of the locomotive broke, and before the train could be checked the trucks of the tender were thrown from the track; […]"
                                            },
                                            {
                                                "example_id": "16a3be59-f517-4d2d-b7f5-bc312fee154e",
                                                "sense_id": "c3eddc5f-d478-3db8-b212-d994147b5c91",
                                                "text": "Though of the same width as smaller engines, the ten giants are longer and higher, with immense driving wheels that make the wheels of most other freight locomotives look like toy hoops."
                                            },
                                            {
                                                "example_id": "5bd8e775-d5f6-41e1-b4c1-22931e477a34",
                                                "sense_id": "c3eddc5f-d478-3db8-b212-d994147b5c91",
                                                "text": "A wild roar of steam and driving wheels, the wail of its hoarse whistle at the crossing, and then, looming black against the night sky, it smashes past, and in the swing of drivers and connecting rods I think of a greyhound, or a racehorse thundering the final stretch."
                                            },
                                            {
                                                "example_id": "e12d6e6a-945c-4b73-a0ef-cdec36021770",
                                                "sense_id": "c3eddc5f-d478-3db8-b212-d994147b5c91",
                                                "text": "While not, perhaps, the handsomest of 4-4-2 tanks, as they had a rather large proportion of their driving wheels exposed, they proved very useful locomotives, doing yeoman work on suburban trains around London and Birmingham, and later on numerous rural routes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                        "entry_id": "46d31ba3-fce5-305d-817b-05c5d88bbe6f",
                                        "glosses": [
                                            "Synonym of steering wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107c0859-9f15-4f00-abbc-76f2ae80808a",
                                                "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                                "text": "My mother would be smoking, ashes falling in her lap, she would be sitting on a cushion so she could see over the driving wheel. […] She would drive slowly so she could look at the houses carefully."
                                            },
                                            {
                                                "example_id": "bde7268d-0db0-45f4-b8fa-a3e1729890a1",
                                                "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                                "text": "Thanks in part to traffic school, I realize that one of the most dangerous activities I will be letting my children engage in is driving a car. As a parent, I will do my best to teach them the incredible responsibility they have when they put their hands on the driving wheel."
                                            },
                                            {
                                                "example_id": "bde3ba7a-adde-42d6-9632-d87091738704",
                                                "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                                "text": "So, despite some MPs’ concerns about safety statistics, leading insurers believe that older hands on the driving wheel are likely to be wiser and safer hands."
                                            },
                                            {
                                                "example_id": "6ab38ed4-19ba-42ef-af38-8fcb728f5f8a",
                                                "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                                "text": "“You should have both hands on the driving wheel, so you can drive defensively and you’re prepared for anything that may happen,” [Michael] Reaves said."
                                            },
                                            {
                                                "example_id": "51ac38c8-876a-45d7-8e1f-17ac404f5635",
                                                "sense_id": "43e67de9-37bf-3c5d-82a4-ae8ad23897bc",
                                                "text": "Every Xbox One accessory you may have purchased over the past seven years (with the notable exception of the Kinect) will work with the Xbox Series X and Series S. Every first- and third-party controller, every fight stick, every driving wheel, every media remote, and every already formatted storage device will be compatible with the new consoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8411e02-36fd-30c0-b5dd-079297fc3f6a",
                                        "entry_id": "46d31ba3-fce5-305d-817b-05c5d88bbe6f",
                                        "glosses": [
                                            "A wheel that transmits motion to other wheels or machinery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe39b94a-b8d0-4950-a1a6-e4d97a930028",
                                                "sense_id": "a8411e02-36fd-30c0-b5dd-079297fc3f6a",
                                                "text": "[W]hilſt this driving Wheel revolves once, the upright Wheel, or that which hath 8 Pinions, will revolve 5.625 Times; […]"
                                            },
                                            {
                                                "example_id": "2c22948b-2fdd-4c40-952e-1601a953bedb",
                                                "sense_id": "a8411e02-36fd-30c0-b5dd-079297fc3f6a",
                                                "text": "The driving wheel on this machine is admitted to be the simplest, easiest running and most convenient of any."
                                            },
                                            {
                                                "example_id": "7f810c8d-7df0-4266-8616-33100387f470",
                                                "sense_id": "a8411e02-36fd-30c0-b5dd-079297fc3f6a",
                                                "text": "The dog is made to rotate a central shaft carrying a large gear wheel which meshes with a small bevel gear carried on the sewing machine driving wheel."
                                            },
                                            {
                                                "example_id": "ba0e466a-5f25-4acc-a258-d1c8fe43563b",
                                                "sense_id": "a8411e02-36fd-30c0-b5dd-079297fc3f6a",
                                                "text": "SEWING Machine, treadles, driving wheel and cabinets; quotation required, drop head type."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
