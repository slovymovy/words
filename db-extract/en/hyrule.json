                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455af3e5-2934-4fcd-bb2a-745e2a670031",
                                "sense_id": "5629d511-7b36-3ae2-a271-2df3e4846626",
                                "text": "... Hyrule was ruled by Princess Zelda, who used the magic of her Triforce triangles to help her people."
                            },
                            {
                                "example_id": "9c462950-5189-4747-a933-7973ab9835d8",
                                "sense_id": "5629d511-7b36-3ae2-a271-2df3e4846626",
                                "text": "The scenery of Hyrule includes roads, water, mountains, plains, deserts, graveyards, forests, swamps, bridges, caves, towns, and, of course, the Palaces."
                            },
                            {
                                "example_id": "581e8d11-6518-44e7-b9cf-cda07c5542f0",
                                "sense_id": "5629d511-7b36-3ae2-a271-2df3e4846626",
                                "text": "Also included is a fold-out map that shows the layout of the land of Hyrule, describes some of the creatures you'll meet and the weapons you can obtain, and offers still more playing tips."
                            },
                            {
                                "example_id": "e169e611-81e9-4f39-91c4-fa5679f4dcc4",
                                "sense_id": "5629d511-7b36-3ae2-a271-2df3e4846626",
                                "text": "Hyrule's large bodies of water have several whirlpools."
