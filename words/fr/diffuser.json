    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c52f66fc-ae9d-3609-b658-df238861026e",
                    "sense_definition": "Transmettre au public un programme, un son ou une vidéo par la télévision, la radio ou Internet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chaîne de télévision va <w>diffuser</w> le match de football en direct ce soir.",
                            "target_lang_translations": {
                                "en": "This TV channel will <w>broadcast</w> the football match live tonight.",
                                "ru": "Этот телеканал сегодня вечером будет <w>транслировать</w> футбольный матч в прямом эфире.",
                                "de": "Dieser Fernsehsender wird das Fußballspiel heute Abend live <w>übertragen</w>.",
                                "es": "Este canal de televisión va a <w>transmitir</w> el partido de fútbol en directo esta noche.",
                                "zh": "这家电视台今晚将现场<w>转播</w>这场足球比赛。"
                            }
                        },
                        {
                            "text": "La radio a <w>diffusé</w> une interview passionnante d'un jeune chercheur ce matin.",
                            "target_lang_translations": {
                                "en": "The radio station <w>broadcast</w> a fascinating interview with a young researcher this morning.",
                                "ru": "Сегодня утром радиостанция <w>передала</w> увлекательное интервью с молодым исследователем.",
                                "de": "Heute Morgen hat der Radiosender ein spannendes Interview mit einem jungen Forscher <w>gesendet</w>.",
                                "es": "Esta mañana la radio <w>emitió</w> una entrevista apasionante a un joven investigador.",
                                "zh": "今天早上，电台<w>播出</w>了一段对一位年轻研究员的精彩采访。"
                            }
                        }
                    ],
                    "synonyms": [
                        "émettre",
                        "retransmettre"
                    ],
                    "common_phrases": [
                        "diffuser en direct",
                        "diffuser une émission",
                        "diffuser un film",
                        "diffuser un reportage"
                    ],
                    "target_lang_definitions": {
                        "en": "To send a programme, sound or video out to the public by television, radio or the internet.",
                        "ru": "Передавать программы, звук или видео широкой аудитории по телевидению, радио или через интернет.",
                        "de": "Ein Programm, einen Ton oder ein Video über Fernsehen, Radio oder das Internet an die Öffentlichkeit senden.",
                        "es": "Transmitir al público un programa, un sonido o un vídeo por televisión, radio o internet.",
                        "zh": "通过电视、广播或互联网向公众播送节目、声音或视频。"
                    },
