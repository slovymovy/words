                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dde5eb81-d83e-3e1c-8e40-431213be4e3f",
                        "entry_id": "3e8785d9-683c-337a-b960-50d821510c0a",
                        "glosses": [
                            "Pays d’Afrique, entouré par l’Afrique du Sud, la Namibie, la Zambie et le Zimbabwe. Sa capitale est Gaborone."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "b9cf9b8d-ef59-4ec9-9d4b-7bca6edd7594",
                                "sense_id": "dde5eb81-d83e-3e1c-8e40-431213be4e3f",
                                "text": "Plusieurs États, tels que le Botswana, qui maintiennent la peine de mort, évoquent les garanties constitutionnelles relatives au droit à la vie."
                            },
                            {
                                "example_id": "bb113aef-4bcb-4194-86c7-222153d2a6cd",
                                "sense_id": "dde5eb81-d83e-3e1c-8e40-431213be4e3f",
                                "text": "Le classement permet aussi de désigner le \"pays le moins heureux de la planète\" : l'Afghanistan, avec une note de 2,52, devant le Zimbabwe, le Rwanda, le Botswana et le Lesotho."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e71a4c5-dc73-4d5e-ba9e-5e477421c749",
                        "source_entry_id": "3e8785d9-683c-337a-b960-50d821510c0a",
                        "source_sense_id": "dde5eb81-d83e-3e1c-8e40-431213be4e3f",
                        "target_lang_word": "Botsuana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Botsuana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8015f325-bd94-32b6-9e43-43c6d577d0e1",
                                        "entry_id": "e2af8713-723c-3b63-bad6-8e1fd3e2d903",
                                        "glosses": [
                                            "Staat im südlichen Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f466ee-48e8-4fd7-a30e-5cf10d482d48",
                                                "sense_id": "8015f325-bd94-32b6-9e43-43c6d577d0e1",
                                                "text": "Botsuana ist das Land mit der höchsten HIV-Infizierungsrate."
                                            },
                                            {
                                                "example_id": "dddb31b6-23a3-4e05-9054-f1ab6c2e136e",
                                                "sense_id": "8015f325-bd94-32b6-9e43-43c6d577d0e1",
                                                "text": "Gaborone ist die Hauptstadt von Botsuana."
                                            },
                                            {
                                                "example_id": "5b77962a-42f0-4f99-86bf-36053038660b",
                                                "sense_id": "8015f325-bd94-32b6-9e43-43c6d577d0e1",
                                                "text": "„Auf den Schienen Botsuanas wird fast ausschließlich Güterverkehr betrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
