                ],
                "senses": [
                    {
                        "sense_id": "e9d9eb93-7233-3af3-95f3-6dd13e0eb7a7",
                        "entry_id": "fdd43ba0-f629-3e55-b656-aa5116355288",
                        "glosses": [
                            "Alternative form of cronel (“lance-part”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "c9e97104-6929-411a-a159-2b4f087d7b91",
                                "sense_id": "e9d9eb93-7233-3af3-95f3-6dd13e0eb7a7",
                                "text": "By Mr. Neville's kindness an accurate drawing of this relic has been obtained, and, considering the circumstances of its discovery, it has been conjectured that it may have been the coronal of a tilting lance."
                            },
                            {
                                "example_id": "66797ed0-e810-4ccc-9692-3df95e3f411a",
                                "sense_id": "e9d9eb93-7233-3af3-95f3-6dd13e0eb7a7",
                                "text": "[…] the proper stroke was to knock off the salade, or bear it off in triumph on the three-pronged coronal of the lance."
                            },
                            {
                                "example_id": "0cbe02e6-c8eb-4a6b-bd2e-5de9395c6350",
                                "sense_id": "e9d9eb93-7233-3af3-95f3-6dd13e0eb7a7",
                                "text": "The tilting lance differed from a war lance in that it possessed a coronal instead of a point. The coronal consisted of[…]"
                            }
                        ]
                    }
