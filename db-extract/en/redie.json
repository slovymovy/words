                        "examples": [
                            {
                                "example_id": "ed6c6219-069b-4dcf-bbd8-1c4fde716ee1",
                                "sense_id": "aa0a2c7f-8fa1-3a56-b4f5-feb56577562d",
                                "text": "[…] until Athene had scalped, rebodied, and revived her — whereupon her first request was to redie at once if she was Gorgon still. An odd thing was that, once brought back, she could recall all her dead head's doings […]"
                            },
                            {
                                "example_id": "131a332b-3e6d-4f7b-a2e1-7dc95fa55306",
                                "sense_id": "aa0a2c7f-8fa1-3a56-b4f5-feb56577562d",
                                "text": "[…] with such company as Gilgamesh, who though mortal was part human and part divine; the Japanese deity Ninigi, who though originally divine became mortal; Sumerian Dumuzi, who though divine was required repeatedly to redie; […]"
                            }
