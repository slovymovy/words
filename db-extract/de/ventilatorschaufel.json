                "senses": [
                    {
                        "sense_id": "6c2f3d21-e715-38fe-b31a-8b2e4b79f472",
                        "entry_id": "b94df05d-f4e8-325f-8811-cc574ab17e24",
                        "glosses": [
                            "strömungstechnisch besonders geformtes, schaufelartiges Blatt, das Strömungskräfte aufnehmen kann; Arbeitsmaschine"
                        ],
                        "tags": [
                            "Strömungsmaschine"
                        ],
                        "examples": [
                            {
                                "example_id": "3e047480-73f8-4020-8945-13f8ebea2791",
                                "sense_id": "6c2f3d21-e715-38fe-b31a-8b2e4b79f472",
                                "text": "„Auf die optimale Form kommt es an, ob bei Axial- oder Radialventilatoren, Radialgebläsen, Kompaktlüftern oder Querstromventilatoren. Deshalb gestalten wir Ventilatorschaufeln, Lüfterräder und Luftführungsgehäuse stets im jeweiligen anwendungsspezifischen Umfeld.“"
                            },
                            {
                                "example_id": "f55c11ce-a6f9-4709-9df1-6e8677160e56",
                                "sense_id": "6c2f3d21-e715-38fe-b31a-8b2e4b79f472",
                                "text": "„In der vorliegenden Arbeit wird das breitbandige Ventilatorgeräusch aufgrund des Geräuschmechanismus „Interaktion der Ventilatorschaufeln mit der Zuströmturbulenz“ experimentell untersucht.“"
                            },
                            {
                                "example_id": "bee27dbc-a1c4-488c-8dea-e598430188d3",
                                "sense_id": "6c2f3d21-e715-38fe-b31a-8b2e4b79f472",
                                "text": "„Dafür sorgen neueste EC-Motorentechnologie und neuartige Ventilatorschaufeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
