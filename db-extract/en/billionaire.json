    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                "word": "billionaire",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8c07ae73-9534-4b83-bab7-91314a323ae9",
                        "entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                        "tags": [
                            "plural"
                        ],
                        "form": "billionaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                        "entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                        "glosses": [
                            "Somebody whose wealth is at least one billion (10⁹) currency units."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ee5f6f-528b-4192-bc24-751af5934d80",
                                "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                            },
                            {
                                "example_id": "2b82d6a5-281a-498d-bb5d-94ebb0235fb8",
                                "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                                "text": "The ranks of the billionaire class last year grew by just over 200 to nearly 2,770 people. Their wealth skyrocketed by $2.1 trillion — three times faster than the year before — to a total of $15 trillion. In the United States alone, where 816 billionaires reside, the net worth of this group soared by $1.4 trillion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db72efd6-5634-4de3-bffe-407db30531d1",
                        "source_entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                        "source_sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                        "source_sense_description": "wealth exceeding one billion (109)",
                        "target_lang_word": "miliardář",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miliardář",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0ca713-6b13-3dd1-956e-89c2161f16b2",
                                        "entry_id": "ef4f2022-8249-3240-acaf-9d22e7d5272e",
                                        "glosses": [
                                            "osoba, jejíž majetek přesahuje svou hodnotou miliardu měnových jednotek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35610ab0-9feb-4851-8178-575824c8acf5",
                                                "sense_id": "4a0ca713-6b13-3dd1-956e-89c2161f16b2",
                                                "text": "Podle časopisu Forbes je Spiegel nejmladším miliardářem světa, jeho jmění odhaduje na čtyři miliardy dolarů."
                                            },
                                            {
                                                "example_id": "05fa645a-104d-4648-a24c-5eba0e69ca7d",
                                                "sense_id": "4a0ca713-6b13-3dd1-956e-89c2161f16b2",
                                                "text": "Korunové dluhopisy byla cesta, kterou využil miliardář A. Babiš k tomu, aby důkladně ojebal český stát."
                                            },
                                            {
                                                "example_id": "262537c9-00f7-4796-bfe6-b9cd8352851f",
                                                "sense_id": "4a0ca713-6b13-3dd1-956e-89c2161f16b2",
                                                "text": "Absurdita: komunisté chtějí podpořit vládu oligarchy, miliardáře, megakapitalisty, a zároveň stále dál vzdychají po socialismu a brojí proti kapitalismu. V takových paradoxech tu žijeme, nic neplatí, máloco má logiku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea8c0c52-e99e-4376-847f-2a7b485fb810",
                        "source_entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                        "source_sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                        "source_sense_description": "wealth exceeding one billion (109)",
