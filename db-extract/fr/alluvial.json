                ],
                "senses": [
                    {
                        "sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
                        "entry_id": "c44b546c-f26a-324c-80c3-59f042bc4018",
                        "glosses": [
                            "Relatif à, ou constitué par, des alluvions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62f8636-1cc1-4c2a-818e-4cd1e7e83561",
                                "sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
                                "text": "Y sont particulièrement choyées, car rares, ses pelouses calcaires, ses mares temporaires de type méditerranéen, ainsi que ses aulnaies et frênaies alluviales."
                            },
                            {
                                "example_id": "33cecfb9-ce6d-4c4b-aff8-3c6b182e8050",
                                "sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
                                "text": "Aux latitudes tempérées de l'hémisphère nord, les milieux alluviaux sont significativement plus riches en lianes arborescentes que dans les forêts non alluviales, à dynamisme sylvigénétique plus lent."
                            },
                            {
                                "example_id": "7c8e6d0b-79bc-427c-884d-b23f68683f20",
                                "sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
                                "text": "De Franchevelle à Ormoiches, la Lanterne coule du S.-E. au N.-W. à travers une vaste plaine alluviale limitée au S. par une ligne de collines de 320 mètres d'altitude moyenne, […]."
                            },
                            {
                                "example_id": "b766e9ab-c27c-4563-85c2-fbafea8313c2",
                                "sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
                                "text": "Par là il entendait la plaine alluviale d’Attigny aussi bien que le grenier à blé situé entre Vouziers et le pied des Monts de Champagne, du côté de Grivy-Loisy qui ravitaillait en grains le marché de Charleville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9596cca-4285-420d-a387-b591c11e16b8",
                        "source_entry_id": "c44b546c-f26a-324c-80c3-59f042bc4018",
                        "source_sense_id": "13fa7afd-bddb-3244-a39f-6d37cbf009db",
