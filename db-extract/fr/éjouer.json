                        "examples": [
                            {
                                "example_id": "537a6d08-8420-4bda-a1ba-4a43002be600",
                                "sense_id": "6b2ec7a7-f9b0-32ac-80c2-5c462953fb69",
                                "text": "Épicure. — Oui, je suis fier de voir le caractère d’Épicure d’une façon peut-être différente de celle de tout le monde, et de jouir de l’antiquité, commed’un bonheur d’après-midi, chaque fois que je lis ou entends quelque chose de lui ; — je vois son œil errer sur de vastes mers blanchâtres, sur des falaises où repose le soleil, tandis que de grands et de petits animaux s’éjouent sous ses rayons, sûrs et tranquilles comme cette clarté et ces yeux mêmes."
                            },
                            {
                                "example_id": "765b92e3-ebec-49e5-a6c7-9285285d6fcc",
                                "sense_id": "6b2ec7a7-f9b0-32ac-80c2-5c462953fb69",
                                "text": "Un Veau, ſaute, bondit, & s’éjoue. Emblème de ces mêmes Armées qui trotent ça & là & ſemblent en effet s’éjouer."
                            }
                        ]
                    }
