                                        "sense_id": "d7ce22ab-369b-30f0-b03c-22f03c424f19",
                                        "entry_id": "166cebfe-41a5-37b5-be3c-44b474fea552",
                                        "glosses": [
                                            "een dierenpassage, met name over wegen en andere kunstmatige obstakels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e33799e-a369-42dc-9a23-5957c3b908bb",
                                                "sense_id": "d7ce22ab-369b-30f0-b03c-22f03c424f19",
                                                "text": "Het nieuwe ecoduct wordt vandaag feestelijk geopend."
                                            }
