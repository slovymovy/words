                "senses": [
                    {
                        "sense_id": "c84d7e20-3dfc-3054-9fe8-7c2c805f4b7b",
                        "entry_id": "9ff07d1a-bed7-3ca8-8d7f-35037bc87491",
                        "glosses": [
                            "Basis, von der aus militärische Operationen durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e662c7-befe-4a1f-a19c-97395132c75e",
                                "sense_id": "c84d7e20-3dfc-3054-9fe8-7c2c805f4b7b",
                                "text": "„Ihr Oberbefehlshaber Samora Machael wurde der erste Präsident des unabhängigen Landes und öffnete es als Operationsbasis für die simbabwischen Unabhängigkeitsbewegungen, wovon zunächst eine neue militärische Formation Gebrauch machte.“"
                            },
                            {
                                "example_id": "7d7f8f28-25a5-439a-afa5-39244798d942",
                                "sense_id": "c84d7e20-3dfc-3054-9fe8-7c2c805f4b7b",
                                "text": "„›Das Lager hier dient uns als Operationsbasis, wenn die Endzeit anbricht.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
