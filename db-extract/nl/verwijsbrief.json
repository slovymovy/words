                        "entry_id": "2b1a3e9c-59e6-33f2-8ae0-afe4f047bf23",
                        "glosses": [
                            "Überweisung vom Hausarzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee57a55-a3b2-42d9-812c-14143666b07b",
                                "sense_id": "26e22a15-b6fe-3761-a9f8-2f7f5b83331c",
                                "text": "Voor specialistische zorg heeft u een verwijsbrief nodig.",
                                "translation": "Für eine fachärztliche Behandlung brauchen Sie eine Überweisung."
                            }
                        ],
                        "sense_index_json": "\"1\""
