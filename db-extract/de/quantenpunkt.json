                        "cross_references": [
                            {
                                "target_word": "quantum dot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ca5225-eebf-320f-a283-48b9bb837e6e",
                                        "entry_id": "98582fc6-5253-3db3-ad73-5efa72c5bf96",
                                        "glosses": [
                                            "A fluorescent nanoparticle of semiconducting material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94271abc-ca72-4335-96cc-796297aa096b",
                                                "sense_id": "93ca5225-eebf-320f-a283-48b9bb837e6e",
                                                "text": "A quantum dot is a semiconductor crystal a few nanometres (billionths of a metre) across – about 50 atoms wide, in other words."
                                            },
                                            {
                                                "example_id": "ce7d70a9-f0c8-42b2-b771-e5c36045fe5e",
                                                "sense_id": "93ca5225-eebf-320f-a283-48b9bb837e6e",
                                                "text": "There was talk that Apple would release an iMac with a quantum dot screen last year. But then the company switched course, declaring that the existing process for making these little crystals was too toxic to the environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
