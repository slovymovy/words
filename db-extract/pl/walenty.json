                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56eb6dcd-4c4e-4cf9-9291-28d1707f586a",
                                "sense_id": "baf5517f-d774-351f-acca-dc14376821c9",
                                "text": "Nasz stary zakrystian ma na imię Walenty."
                            },
                            {
                                "example_id": "44c4f9ef-9ace-4b25-b3a8-9359897b8c98",
                                "sense_id": "baf5517f-d774-351f-acca-dc14376821c9",
                                "text": "Walentowie dzień swego patrona, czyli imieniny, obchodzą 14 lutego."
                            },
                            {
                                "example_id": "70ef9c5b-95cf-4933-9911-3822b2f0dc6a",
                                "sense_id": "baf5517f-d774-351f-acca-dc14376821c9",
                                "text": "7 czerwca 1952 r. przyjął święcenia kapłańskie z rąk abpa Walentego Dymka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
