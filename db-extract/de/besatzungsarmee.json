                ],
                "senses": [
                    {
                        "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                        "entry_id": "7302dfc6-b5d9-32cd-83ab-c364182f9b72",
                        "glosses": [
                            "Armee, die ein fremdes Gebiet besetzt hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e993861-bbf7-4d6d-9d54-57d949fb3acf",
                                "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                                "text": "„Und die Bevölkerung der meisten westeuropäischen Länder fand sich bald mit der Präsenz einer Besatzungsarmee ab, die allenthalben für ihr korrektes, ja höfliches Verhalten gepriesen wurde.“"
                            },
                            {
                                "example_id": "9a4848ea-6025-4219-88be-4e14e3e431ec",
                                "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                                "text": "„Ende August landeten die ersten Einheiten der amerikanischen Besatzungsarmee in Japan.“"
                            },
                            {
                                "example_id": "2bee5664-ee89-4570-ab41-313a44cb1dd7",
                                "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                                "text": "„Deutschland ist heute in vier Zonen geteilt und innerhalb jeder Zone in zwei Welten: eine Besatzungsarmee und ein besiegtes Volk.“"
                            },
                            {
                                "example_id": "ce16a81f-e8c2-4c8f-978b-a8ce48479662",
                                "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                                "text": "„Die IPKF wuchs schließlich zu einer großen Besatzungsarmee heran, die ihre Aufgabe, die tamilischen Rebellen zu entwaffnen, dennoch nicht erfüllen konnte.“"
                            },
                            {
                                "example_id": "65990f46-b758-4f0f-b5e6-c396a5616943",
                                "sense_id": "d3e25c98-b670-36d0-b61d-b56bddb94a2e",
                                "text": "„Die Brigade verhielt sich wie eine Besatzungsarmee, innerhalb der ersten sechs Wochen wurden mehr als 2000 Menschen ermordet, Zehntausende misshandelt und viele Häuser niedergebrannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
