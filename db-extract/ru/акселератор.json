                                        ]
                                    },
                                    {
                                        "sense_id": "d3cfa899-98b3-3e62-b378-1d6c4cb68f0b",
                                        "entry_id": "387ed505-5252-3026-9810-be98d3ae0a9e",
                                        "glosses": [
                                            "Instrument qui permet d'amener des particules électriquement chargées à des vitesses élevées."
