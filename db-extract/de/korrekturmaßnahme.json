                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5a8abb-3b07-4dbe-a03a-258e6c4368ad",
                                "sense_id": "54b1cf0e-c8e9-3b51-ae32-9b10cfd77efe",
                                "text": "Vorschläge zu Korrekturmaßnahmen sind häufig das Resultat von Qualitätssicherungsverfahren."
                            },
                            {
                                "example_id": "fa668eee-e8c3-47d0-8f74-4ce9a3172efe",
                                "sense_id": "54b1cf0e-c8e9-3b51-ae32-9b10cfd77efe",
                                "text": "„Auf Grundlage des Check-Ergebnisses werden gegebenenfalls Korrekturmaßnahmen eingeleitet.“"
                            },
                            {
                                "example_id": "93ef2379-1134-4e43-84e0-167ce1643c05",
                                "sense_id": "54b1cf0e-c8e9-3b51-ae32-9b10cfd77efe",
                                "text": "„Die Arbeitsmarktpolitik ist von vornherein als staatliche Korrekturmaßnahme konzipiert, wenn Marktlage und »soziale« Gerechtigkeit kollidieren. Vorrangiges Ziel ist es, arbeitsplatzerhaltend zu retten, was am Markt nicht mehr zu retten ist.“"
                            }
