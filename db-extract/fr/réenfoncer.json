                        "glosses": [
                            "Enfoncer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7acdc495-3222-48f5-b17e-ec9e7c38cc64",
                                "sense_id": "4db3aec7-dc26-3d8c-8037-5d8302bd4ffa",
                                "text": "Tournant sur le tronc, il fit tout de même demi-tour en reposant le pied libre ; mais pendant qu’il dépêtrait l’autre, le premier se réenfonçait de nouveau, de sorte qu’il déployait de surhumains efforts à patauger sur place […]"
                            },
                            {
                                "example_id": "25bdf8b6-c1e9-49ab-a105-a6a9721907c9",
                                "sense_id": "4db3aec7-dc26-3d8c-8037-5d8302bd4ffa",
                                "text": "Comme ça tout le monde pense à la première (ce qui permet de réenfoncer le clou) sans avoir besoin de montrer Paris Hilton."
                            }
                        ]
                    }
