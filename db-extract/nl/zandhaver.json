                                        "entry_id": "3f705608-bb35-3f40-9526-c5259ce68786",
                                        "glosses": [
                                            "Plante de la famille de la famille des Poaceae, qui pousse sur les dunes près de la mer, de nom scientifique Leymus arenarius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485fd9ca-400e-40a8-b7aa-8fb1cd7782a4",
                                                "sense_id": "943580ac-ea5e-33f8-91c7-df072c9d7daf",
                                                "text": "Une jolie déambulation sur un ruban de goudron rectiligne mangé par le sable des dunes, dans un biotope préservé planté d’oyats, de seigle de mer et d’arbousiers, où trouvent refuge les gravelots à collier."
                                            },
                                            {
                                                "example_id": "6833f74e-a9c2-4f2c-8e67-e9d60b7dd698",
                                                "sense_id": "943580ac-ea5e-33f8-91c7-df072c9d7daf",
                                                "text": "Ici, les sentolines se mêlent aux stipas, aux phormiums et aux seigles de mer."
                                            },
                                            {
                                                "example_id": "a7a7b94e-46df-4a59-817d-fbe5cf86e8f7",
                                                "sense_id": "943580ac-ea5e-33f8-91c7-df072c9d7daf",
                                                "text": "L’élyme des sables, parfois aussi appelée seigle de mer ou grand oyat, partage avec lui le même habitat."
                                            }
                                        ]
                                    }
                                ]
                            }
