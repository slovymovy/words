                        ],
                        "examples": [
                            {
                                "example_id": "2f9e5021-e943-4230-8b20-84138296e4aa",
                                "sense_id": "38559161-13a5-3610-8861-ea9ce5f0bff0",
                                "text": "Идя́ на рабо́ту в оте́ль, я написа́л в анке́те вся́кие глу́пости о свое́й про́шлой жи́зни, что я, мол, всегда́ рабо́тал официа́нтом в ха́рьковских и моско́вских рестора́нах.",
                                "translation": "When I came to work at the hotel I put down all sorts of foolishness about my past on the application, said I had always worked as a waiter in Kharkov and Moscow restaurants.",
                                "english": "When I came to work at the hotel I put down all sorts of foolishness about my past on the application, said I had always worked as a waiter in Kharkov and Moscow restaurants."
                            }
                        ]
                    }
