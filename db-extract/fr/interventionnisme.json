                "entry_id": "5f7ab549-9427-36d1-af7d-8e7475c58f82",
                "word": "interventionnisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0fa4f9c-f838-410b-9c4a-b1e36ff1d0f7",
                        "entry_id": "5f7ab549-9427-36d1-af7d-8e7475c58f82",
                        "tags": [
