                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7ca7df-4635-4058-8c97-1a663ddf296f",
                                "sense_id": "1ee39ffd-b174-3af0-bbfc-ed2691be2fd8",
                                "text": "Les promeneurs des boulevards s’arrêtaient pour considérer le défilé empanaché des traîneaux ; bientôt des échoppes et des traiteurs, les dîneurs ; des perruqueries et des merceries, les marchands sortaient sur le pas des portes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b075fcd-19b7-3bab-a8cf-dc19304958c0",
