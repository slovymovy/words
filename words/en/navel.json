                {
                    "sense_id": "23ed63da-89a6-32b1-ab03-fa39ff16bc82",
                    "sense_definition": "An eye or loop on the underside of a carronade used to secure it to a carriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors secured the heavy cannon by fastening the rope through its <w>navel</w>.",
                            "target_lang_translations": {
                                "tr": "Denizciler ağır topu, halatı <w>bağlantı halkasından</w> geçirip sabitlediler.",
                                "ru": "Моряки закрепили тяжёлую пушку, пропустив канат через её <w>проушину</w>."
                            }
                        },
                        {
                            "text": "An inspection showed damage to the <w>navel</w> of the old ship's carronade.",
                            "target_lang_translations": {
                                "tr": "Yapılan inceleme, eski geminin karonat topunun <w>bağlantı halkasında</w> hasar olduğunu gösterdi.",
                                "ru": "Осмотр выявил повреждение <w>крепёжного ушка</w> карронады старого корабля."
                            }
