                    "sense_id": "059ee929-34f5-3173-81ed-d6d9f2770297",
                    "sense_definition": "Participe présent de <w>tomber</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est blessé au genou en <w>tombant</w> dans l'escalier.",
                            "target_lang_translations": {
                                "en": "He hurt his knee <w>falling</w> down the stairs.",
                                "ru": "Он повредил колено, <w>упав</w> с лестницы.",
                                "de": "Er hat sich das Knie verletzt, als er die Treppe <w>hinunterfiel</w>.",
                                "es": "Se lastimó la rodilla <w>cayendo</w> por la escalera.",
                                "zh": "他下楼梯时<w>摔倒</w>，伤了膝盖。"
                            }
                        },
                        {
                            "text": "Les feuilles dorées virevoltent dans le vent en <w>tombant</w> des arbres.",
                            "target_lang_translations": {
                                "en": "The golden leaves flutter in the wind, <w>falling</w> from the trees.",
                                "ru": "Золотистые листья кружатся на ветру, <w>падая</w> с деревьев.",
                                "de": "Die goldenen Blätter wirbeln im Wind umher, während sie von den Bäumen <w>fallen</w>.",
                                "es": "Las hojas doradas revolotean con el viento, <w>cayendo</w> de los árboles.",
                                "zh": "金黄的树叶在风中翻飞，从树上<w>落下</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
