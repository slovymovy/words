                ],
                "senses": [
                    {
                        "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                        "entry_id": "92deaa86-5434-30d3-8f67-f8bc4b7e4979",
                        "glosses": [
                            "Areal, auf dem etwas hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e983638c-c351-4f35-9878-5b770e8c6d57",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Zur Gewinnung landwirtschaftlicher Produktionsflächen werden z.B. durch Brandrodung große Mengen des Treibhausgases CO₂ freigesetzt.“"
                            },
                            {
                                "example_id": "78bbf704-20a3-4d2a-b58c-558646205916",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Zudem löst die gesteigerte Nachfrage [Anmerkung: nach Bioenergie] eine Ausweitung der landwirtschaftlichen Produktionsfläche aus, die zu einem Verlust wertvoller Ökosysteme, wie Wälder, artenreiches Grünland oder Moore, führen kann.“"
                            },
                            {
                                "example_id": "40d71fb2-4883-4758-baf3-18d5abd3eacf",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Die Produktionsfläche betrug zunächst 7000 m², wurde aber bereits 1972 auf 17.000 m² und 1974 weiter auf 24.000 m² erweitert.“"
                            },
                            {
                                "example_id": "c8646022-61a0-404d-8040-67934946bdaf",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„1976 entstand in Verl-Kaunitz ein weiteres Werk mit 8000 m² Produktionsfläche zur Herstellung von Wohnmöbeln.“"
                            },
                            {
                                "example_id": "ce86da51-02a2-41ab-99b9-dde7365b0fa5",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„1992 wurde die Produktionsfläche um 6.300 m² erweitert.“"
                            },
                            {
                                "example_id": "d2c94503-b896-4cf9-b7be-ccf998371330",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Mittlerweile ist die Produktionsfläche des zweiten Werkes auf 140.000 m² angestiegen.“"
                            },
                            {
                                "example_id": "466e6451-7531-41d9-9037-7cbf5141b6fc",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Doch reichte die vorhandene Produktionsfläche nicht mehr aus.“"
                            },
                            {
                                "example_id": "398be1c9-e571-4ba0-ab92-533d0f2fc5d4",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Weit mehr als die Hälfte der Produktionsfläche ist inzwischen verpachtet.“"
                            },
                            {
                                "example_id": "1bfdde0c-9648-445f-85df-6c48f76710bb",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Der Neubau mit Büro- und Produktionsflächen von insgesamt 13'000 Quadratmetern soll vorerst gut 200, später bei Bedarf bis zu 400 Mitarbeiterinnen und Mitarbeitern Platz bieten.“"
                            },
                            {
                                "example_id": "fb1efb56-9f54-4967-93a5-614ea9b40fda",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„In der Kritik stand auch die Agrarpolitik der Europäischen Union. Anstelle von Produktionsfläche und Ertrag sollten sich Subventionen in Zukunft viel mehr an Tier- und Klimaschutzkriterien orientieren, forderte Rollmann.“"
                            },
                            {
                                "example_id": "85bafcf4-af74-4a47-95d8-700b4588fd80",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„In Folge des Klimawandels kommt es in den nächsten Jahrzehnten zu einer verstärkten Bodenerosion, heißt es seitens des DBU. Das bedeute einerseits Verlust von Lebensraum, andererseits auch von landwirtschaftlicher Produktionsfläche.“"
                            },
                            {
                                "example_id": "7a3e3df8-f8f3-4784-9b66-72be08aa2ee1",
                                "sense_id": "8a809d2e-523d-397e-a125-615f26d3fa83",
                                "text": "„Der bernische Bauernverband Lobag will dem Verlust an landwirtschaftlichen Produktionsflächen nicht mehr tatenlos zusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
