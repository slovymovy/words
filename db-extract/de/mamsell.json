                "senses": [
                    {
                        "sense_id": "6bd82ec1-003a-35ec-9bb8-7d446a45abca",
                        "entry_id": "0fa80124-2793-344a-a5b9-9ea9f87e1f7e",
                        "glosses": [
                            "weibliche Angestellte in der Gastronomie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3519e23a-07bf-4249-894b-49d6ebb6966a",
                                "sense_id": "6bd82ec1-003a-35ec-9bb8-7d446a45abca",
