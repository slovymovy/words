                        {
                            "text": "Ik zal je <w>tuurlijk</w> helpen met verhuizen als je dat wilt.",
                            "target_lang_translations": {
                                "en": "I will <w>of course</w> help you move if you want.",
                                "ru": "Я, <w>конечно</w>, помогу тебе с переездом, если ты хочешь.",
                                "pl": "Jeśli chcesz, to <w>oczywiście</w> pomogę ci przy przeprowadzce.",
                                "de": "Ich werde dir <w>natürlich</w> beim Umzug helfen, wenn du das möchtest.",
                                "fr": "Je vais <w>bien sûr</w> t'aider à déménager si tu le souhaites.",
                                "it": "Ti aiuterò <w>certo</w> a traslocare se vuoi.",
                                "cs": "S <w>samozřejmostí</w> ti pomůžu se stěhováním, pokud budeš chtít.",
                                "tr": "İstersen taşınmana <w>elbette</w> yardım ederim.",
                                "es": "Te ayudaré <w>por supuesto</w> con la mudanza si quieres.",
                                "zh": "如果你需要，我<w>当然</w>会帮你搬家。"
                            }
                        },
                        {
                            "text": "Dat is <w>tuurlijk</w> geen enkel probleem voor mij.",
                            "target_lang_translations": {
                                "en": "That is <w>obviously</w> no problem at all for me.",
                                "ru": "Это, <w>разумеется</w>, для меня совсем не проблема.",
                                "pl": "To dla mnie <w>oczywiście</w> żaden problem.",
                                "de": "Das ist für mich <w>natürlich</w> überhaupt kein Problem.",
                                "fr": "Ce n'est <w>évidemment</w> aucun problème pour moi.",
                                "it": "Per me non è <w>ovviamente</w> alcun problema.",
                                "cs": "To pro mě <w>samozřejmě</w> není vůbec žádný problém.",
                                "tr": "Bu benim için <w>tabii ki</w> hiç sorun değil.",
                                "es": "Eso <w>claro</w> que no es ningún problema para mí.",
                                "zh": "这对我来说<w>当然</w>完全没问题。"
                            }
                        }
