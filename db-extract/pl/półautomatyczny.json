                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c789cbb-13c1-3b67-87ea-b8e62f333b01",
                                        "entry_id": "9be446eb-3fe0-3f64-8d6e-073002c39e32",
                                        "glosses": [
                                            "Of a firearm that automatically ejects a shell and loads the next one, but requires the trigger to be squeezed for each shot; autoloading."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c315aa-4c4c-4d15-a831-114ec6df1406",
                                                "sense_id": "8c789cbb-13c1-3b67-87ea-b8e62f333b01",
                                                "text": "The pro-gun majority in the House of Representatives moved Wednesday to compel the nation's capital to broaden the rights of its residents to buy and own firearms, including semi-automatic weapons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semi-automatic",
                                "target_lang_code": "en",
                                "target_senses": [
