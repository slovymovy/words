{
    "word_family": [
        "formula",
        "formulate",
        "formulator",
        "formulative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e84a243d-cf90-3668-ab6e-ac49d11c30c5",
                    "sense_definition": "The act, process, or result of creating, preparing, or expressing something systematically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team spent months working on the <w>formulation</w> of a new strategy.",
                            "target_lang_translations": {
                                "tr": "Ekip, yeni bir stratejinin <w>oluşturulması</w> üzerinde aylarca çalıştı.",
                                "zh": "团队花了数月时间致力于新策略的<w>制定</w>。"
                            }
                        },
                        {
                            "text": "Clear policy <w>formulation</w> is essential for the success of any company project.",
                            "target_lang_translations": {
                                "tr": "Net politika <w>oluşturma</w>, herhangi bir şirket projesinin başarısı için elzemdir.",
                                "zh": "明确的政策<w>制定</w>对任何公司项目的成功都至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "development",
                        "preparation",
                        "creation"
                    ],
                    "common_phrases": [
                        "policy formulation",
                        "strategy formulation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi sistematik bir şekilde oluşturma, hazırlama veya ifade etme eylemi, süreci veya sonucu.",
                        "zh": "系统地制定、构想或规划某事物的行为、过程或结果。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "formüle etme",
                                "target_lang_sense_clarification": "süreç veya eylem"
                            },
                            {
                                "target_lang_word": "oluşturma",
                                "target_lang_sense_clarification": "plan veya strateji"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制定",
                                "target_lang_sense_clarification": "政策、战略或计划的拟定过程"
                            },
                            {
                                "target_lang_word": "构想",
                                "target_lang_sense_clarification": "系统性思考与形成"
                            },
                            {
                                "target_lang_word": "规划",
                                "target_lang_sense_clarification": "统筹安排与确立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff15ba77-fe47-3ce6-a655-57406087674a",
                    "sense_definition": "A specific arrangement of words or a particular linguistic phrase used to express an idea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His choice of precise <w>formulation</w> helped avoid any possible misunderstanding.",
                            "target_lang_translations": {
                                "tr": "Hassas <w>ifade biçimi</w> seçimi olası bir yanlış anlaşılmayı önlemeye yardımcı oldu.",
                                "zh": "他选用精确的<w>措辞</w>有助于避免任何可能的误解。"
                            }
                        },
                        {
                            "text": "The committee rejected the vague <w>formulation</w> of the clause and asked for clearer wording.",
                            "target_lang_translations": {
                                "tr": "Komite, maddenin muğlak <w>ifade edilişini</w> reddetti ve daha açık bir dil istedi.",
                                "zh": "委员会否决了该条款含糊不清的<w>表述</w>，并要求使用更明确的措辞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wording",
                        "phrasing",
                        "expression"
                    ],
                    "common_phrases": [
                        "precise formulation",
                        "careful formulation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir düşünceyi ifade etmek için kullanılan belirli bir sözcük dizilimi veya dilbilimsel ifade şekli.",
                        "zh": "用来表达某种想法的具体措辞、表述方式或词语排列。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ifade ediş",
                                "target_lang_sense_clarification": "sözlü veya yazılı anlatım biçimi"
                            },
                            {
                                "target_lang_word": "üslup",
                                "target_lang_sense_clarification": "kelime seçimi ve anlatım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "说话或写作时的词句选用"
                            },
                            {
                                "target_lang_word": "表述",
                                "target_lang_sense_clarification": "思想或条款的表达方式"
                            },
                            {
                                "target_lang_word": "说法",
                                "target_lang_sense_clarification": "具体的语言表达形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9feff3f-3e53-3b4b-84ea-c958a22c69c1",
                    "sense_definition": "A specific mixture or product prepared according to a particular formula, especially in medicine or chemistry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you liked our old shampoo, you will love the new kinder, gentler <w>formulation</w>.",
                            "target_lang_translations": {
                                "tr": "Eski şampuanımızı beğendiyseniz, yeni ve daha hassas <w>formüle</w> bayılacaksınız.",
                                "zh": "如果您喜欢我们的旧款洗发水，您一定会爱上这款性质更温和的新<w>配方</w>。"
                            }
                        },
                        {
                            "text": "The lab developed an improved chemical <w>formulation</w> that increases the product's effectiveness.",
                            "target_lang_translations": {
                                "tr": "Laboratuvar, ürünün etki gücünü artıran geliştirilmiş bir kimyasal <w>formül</w> geliştirdi.",
                                "zh": "实验室研发出一种改良的化学<w>配方</w>，提高了该产品的功效。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixture",
                        "preparation",
                        "composition"
                    ],
                    "common_phrases": [
                        "chemical formulation",
                        "new formulation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle tıp veya kimyada belirli bir formüle göre hazırlanmış özel bir karışım veya ürün.",
                        "zh": "按特定配方制成的混合物或制剂，尤指在医药或化学工业中。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "formül",
                                "target_lang_sense_clarification": "ürün veya bileşim"
                            },
                            {
                                "target_lang_word": "formülasyon",
                                "target_lang_sense_clarification": "kimyasal/ilaç bileşimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配方",
                                "target_lang_sense_clarification": "药剂、化妆品或化学制品的成分组合"
                            },
                            {
                                "target_lang_word": "制剂",
                                "target_lang_sense_clarification": "按配方制成的药物或化学产品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
