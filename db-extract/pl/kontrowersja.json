                                    {
                                        "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                        "entry_id": "27d361fe-9f70-34ae-a105-8c42eeb1b591",
                                        "glosses": [
                                            "länger anhaltender Disput, heftiger Streit (aufgrund unterschiedlicher oder gegensätzlicher Beurteilungen, Einschätzungen, Meinungen bezüglich eines bestimmten Sachthemas)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324245ae-19cc-49c5-860a-ce72510f6893",
                                                "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                                "text": "Es gab eine heftige Kontroverse."
                                            },
                                            {
                                                "example_id": "c6fb5c86-e963-4ebb-a803-e13db27b8cc8",
                                                "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                                "text": "„Nichts machte das deutlicher als die Kontroverse zwischen Gabriel und der Juso-Vorsitzenden Johanna Ueckermann.“"
                                            },
                                            {
                                                "example_id": "f737e0b0-7db5-4f09-a2e8-5abb44720267",
                                                "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                                "text": "„Ganz egal, welcher Seite der Kontroverse die Leute angehörten oder wie gut sie ihn persönlich kannten, ihr automatisches Lächeln in seiner Gegenwart verströmte eine gewisse ... nun ja, verhuschte Ehrfurcht.“"
                                            },
                                            {
                                                "example_id": "a1022e68-6b8e-41d1-b9cd-492e56a093a2",
                                                "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                                "text": "„Eine andere Kontroverse entzündet sich an der amerikanischen Absicht, Italien in die Vereinten Nationen aufzunehmen.“"
                                            },
                                            {
                                                "example_id": "e08c8671-4497-4a2c-949e-406b5fe4f657",
                                                "sense_id": "732528cc-c45c-38a9-8710-d5905fbc6aed",
                                                "text": "„Wieland zeigt in seinen Dialogen, dass man eine Kontroverse mit Achtung vor dem, der anderer Meinung ist, austragen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af8ecbf-32f2-46a9-bcb7-a3d54d1adbf4",
                        "source_entry_id": "2911b154-61f6-3f36-85f0-093bc6d00269",
                        "source_sense_id": "f7cd0974-031a-31e6-b6ee-e32a32e5340f",
                        "target_lang_word": "Meinungsverschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinungsverschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "unterschiedliche Beurteilung, Einschätzung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2145cd9e-7287-4880-ad99-15519fc2ad8f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                                            },
                                            {
                                                "example_id": "420da42d-1914-484a-81fa-3eb616401c62",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Am Ende erwiesen sich die alliierten Meinungsverschiedenheiten in der Reparationsfrage als unüberbrückbar.“"
                                            },
                                            {
                                                "example_id": "23279758-86e2-44d5-ab89-71ec04931b71",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Während er zu irgendeinem Gegenstand geführt wurde, merkte er, dass unter seinen Führern Meinungsverschiedenheiten und eine gewisse Verwirrung entstanden waren.“"
                                            },
                                            {
                                                "example_id": "38ef3c91-4edf-448b-acb2-a8d2a4fea93f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "verbale Auseinandersetzung, Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad229162-e4f1-4d42-8624-ee5b91e2b449",
                                                "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                                "text": "Nach dieser Meinungsverschiedenheit war die Stimmung vorübergehend etwas getrübt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e128ec-931e-4c6e-b1ee-fd1e2244b03c",
                        "source_entry_id": "2911b154-61f6-3f36-85f0-093bc6d00269",
