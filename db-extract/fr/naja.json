                                ]
                            },
                            {
                                "target_word": "naja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "586aa3b3-0ee9-3eb7-8452-39155e561f29",
                                        "entry_id": "f350d205-3fa9-312a-b748-a581eae43062",
                                        "glosses": [
                                            "A necklace or pendant made in the shape of the traditional Navajo symbol of a crescent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b2c13d-6b2a-4ba4-af39-863defb03f05",
                                                "sense_id": "586aa3b3-0ee9-3eb7-8452-39155e561f29",
                                                "text": "Carter has several illustrations of English horse amulets that clearly resemble early Navajo najas."
                                            },
                                            {
                                                "example_id": "672d54c3-904e-4fbe-abfd-60631b31afd5",
                                                "sense_id": "586aa3b3-0ee9-3eb7-8452-39155e561f29",
                                                "text": "Belle came out of her dark place to show Sam her necklace. It was beautiful. In the center was a naja."
                                            },
                                            {
                                                "example_id": "e69d4caf-e61b-447b-995e-92f54c3458ee",
                                                "sense_id": "586aa3b3-0ee9-3eb7-8452-39155e561f29",
                                                "text": "In Los Angeles, the designers Jacquie Aiche and Irene Neuwirth both said they had been seduced by Native American style. In April, Ms. Aiche debuted a limited collection of leather bolo ties anchored by a crescent-shaped pendant not unlike the traditional Navajo naja symbol, while Ms. Neuwirth showed a long rainbow-colored strand of gemstones whose silhouette recalls a luxe version of the naja, or squash blossom necklace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
