{
    "word_family": [
        "bawler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac7b141b-635e-328d-9fcb-82b063e31787",
                    "sense_definition": "To shout or speak in a very loud and intense manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shouting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry coach started to <w>bawl</w> instructions at the players from the sidelines.",
                            "target_lang_translations": {
                                "ru": "Разгневанный тренер начал <w>орать</w> указания игрокам с боковой линии."
                            }
                        },
                        {
                            "text": "He had to <w>bawl</w> to be heard over the loud music at the party.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>кричать</w>, чтобы его услышали из-за громкой музыки на вечеринке."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell",
                        "bellow"
                    ],
                    "antonyms": [
                        "whisper"
                    ],
                    "common_phrases": [
                        "bawl out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко и интенсивно кричать или говорить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ора́ть",
                                "target_lang_sense_clarification": "разговорное, часто используется для обозначения очень громкого крика или ругани"
                            },
                            {
                                "target_lang_word": "крича́ть",
                                "target_lang_sense_clarification": "общеупотребительное слово для обозначения громкого голоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923cc1e0-ed75-3c7c-ae9d-fa9de438f4e9",
                    "sense_definition": "To cry out loudly or blare, often used for animals or children.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shouting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry calf began to <w>bawl</w> for its mother in the field.",
                            "target_lang_translations": {
                                "ru": "Голодный теленок начал <w>реветь</w>, зовя мать в поле."
                            }
                        },
                        {
                            "text": "I could hear the baby <w>bawl</w> throughout the entire flight.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как ребенок <w>ревел</w> весь полет."
                            }
                        }
                    ],
                    "synonyms": [
                        "wail",
                        "cry",
                        "bellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко кричать или реветь, часто используется применительно к животным или детям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реве́ть",
                                "target_lang_sense_clarification": "издавать протяжный громкий крик (о животных или плачущих детях)"
                            },
                            {
                                "target_lang_word": "вопи́ть",
                                "target_lang_sense_clarification": "издавать неистовые, громкие крики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12949f99-7114-3b66-b3f2-f05d5150d38e",
                    "sense_definition": "To weep or cry in an uncontrolled and noisy way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler started to <w>bawl</w> after dropping his ice cream cone on the ground.",
                            "target_lang_translations": {
                                "ru": "Малыш начал <w>реветь</w> после того, как уронил рожок мороженого на землю."
                            }
                        },
                        {
                            "text": "She sat on the sofa and began to <w>bawl</w> after hearing the sad news.",
                            "target_lang_translations": {
                                "ru": "Она села на диван и начала <w>рыдать</w>, услышав печальные новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "sob",
                        "weep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безудержно и шумно плакать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реве́ть",
                                "target_lang_sense_clarification": "разговорное, означает громко и сильно плакать"
                            },
                            {
                                "target_lang_word": "рыда́ть",
                                "target_lang_sense_clarification": "плакать навзрыд, с громкими всхлипами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b0c8cb3-2d6c-3309-8bad-0bcf09bad6fe",
                    "sense_definition": "A loud, intense shout or a noisy cry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shouting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>bawl</w> from the crowd startled everyone in the quiet room.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>крик</w> толпы напугал всех в тихой комнате."
                            }
                        },
                        {
                            "text": "He let out a sharp <w>bawl</w> of frustration when he lost the game.",
                            "target_lang_translations": {
                                "ru": "Он издал резкий <w>крик</w> разочарования, когда проиграл игру."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell",
                        "wail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, интенсивный крик или шумный плач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "общее название для громкого звука, издаваемого человеком"
                            },
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "громкий, протяжный крик или плач"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}