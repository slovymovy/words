                                            {
                                                "example_id": "c9d93250-8791-4936-a67e-368630e411d2",
                                                "sense_id": "bbdc918f-23c4-3f6f-9568-fc8e730c84c8",
                                                "text": "An interesting development has been the analysis of the image of a pendent drop by a video digitizer."
