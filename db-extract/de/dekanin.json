                                "sense_id": "d2426650-b786-3e85-9c1f-e7f8d5db3826",
                                "text": "„Randa Abu Bakr heißt die neue Dekanin der Fakultät für Geisteswissenschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
