                        "sense_id": "11e89d2b-1c7c-30da-8d0a-39e9995f3ad2",
                        "entry_id": "cd3065e7-e097-326c-900e-deba0a5fd7fc",
                        "glosses": [
                            "Qui est digne de Satan. Il ne s’emploie qu’en manière d’injure ou de plaisanterie familière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa5b227-3ef0-436b-a9ed-e4521daa3f15",
                                "sense_id": "11e89d2b-1c7c-30da-8d0a-39e9995f3ad2",
                                "text": "Et cette satanée calculatrice Casio !"
                            },
                            {
                                "example_id": "3e2626a6-6b1a-437e-829e-568445324c65",
                                "sense_id": "11e89d2b-1c7c-30da-8d0a-39e9995f3ad2",
                                "text": "« J’y étais ! J’y étais presque ! Sans ce satané Spider-Man, je serais un dieu maintenant !\n— Tu vas la fermer, oui ? »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2182072-7a2d-458e-85ce-400e4232ef9d",
                        "source_entry_id": "cd3065e7-e097-326c-900e-deba0a5fd7fc",
                        "source_sense_id": "11e89d2b-1c7c-30da-8d0a-39e9995f3ad2",
                        "target_lang_word": "devilish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "devilish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e164089-1844-3009-949d-fcb7933835a4",
                                        "entry_id": "5f4f6df4-5109-3f81-8799-11946979e6e9",
                                        "glosses": [
                                            "Resembling a devil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de905371-4090-4af7-ad8c-2d8f088dc455",
                                                "sense_id": "6e164089-1844-3009-949d-fcb7933835a4",
                                                "text": "Let vs put on our meet incountering mindes, / And in deteſting ſuch a diueliſh Thiefe, / In loue of honor and defence of right / Be arm’d againſt the hate of ſuch a foe, / Whether from earth, or hell, or heauen he grow."
                                            },
                                            {
                                                "example_id": "eddf58b3-2e7d-4bd2-ac6e-660bc7c1faeb",
                                                "sense_id": "6e164089-1844-3009-949d-fcb7933835a4",
                                                "text": "[…] currently incarcerated Stinc Team members Ketchy the Great, SaySoTheMac, and Bambino; the devilish and gravelly Almighty Suspect; red-clad Inglewooder and headband connoisseur FreeAckrite; baby-faced Martin Luther King Park loiterer Johnny Rose; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37479e71-521a-3620-8aa2-c5e89c1ffa85",
                                        "entry_id": "5f4f6df4-5109-3f81-8799-11946979e6e9",
                                        "glosses": [
                                            "Wicked, evil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40655c1f-da27-46d7-a5d7-16f11abcaeff",
                                                "sense_id": "37479e71-521a-3620-8aa2-c5e89c1ffa85",
                                                "text": "[S]ome turne agayne by grace frõ their deadly hereſies into yͤ life of faith, ⁊ ſome be ſo ſore nowſeled in the falſe hereſies, ⁊ in their obſtinate frowardneſſe take ſuch a deueliſhe delight, yͭ finally thei die therin as did Baifield, Bainã, ⁊ Tewkeſbury."
                                            },
                                            {
                                                "example_id": "b9c6a9e0-ef8d-448f-af72-14e9344778ad",
                                                "sense_id": "37479e71-521a-3620-8aa2-c5e89c1ffa85",
                                                "text": "[...] devilish cruelty - for devilish cruelty it was, as three or four drivers armed with whips, lingered up and down the slowly-staggering file of Indians, and avenged every moment's lagging, even every stumble, by a blow of the cruel [whips]."
                                            },
                                            {
                                                "example_id": "55c92a58-aeef-4cc6-b660-54d2b9f5545f",
                                                "sense_id": "37479e71-521a-3620-8aa2-c5e89c1ffa85",
                                                "text": "[...] the devilish destructiveness of modern conventional weapons and the need for future Saddam-busters to control their spread. (Think of the damage that a Saddam with longer-range missiles, cleverer warheads and better defences [could do]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95249c1c-6c00-30eb-be4e-d706d02d7108",
                                        "entry_id": "5f4f6df4-5109-3f81-8799-11946979e6e9",
                                        "glosses": [
                                            "Roguish or mischievous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4951be7-9fc0-4806-a3c4-9839e84d411e",
                                                "sense_id": "95249c1c-6c00-30eb-be4e-d706d02d7108",
                                                "text": "a devilish grin"
                                            },
                                            {
                                                "example_id": "1c7d116e-c11c-4629-9218-d3c59e6a063f",
                                                "sense_id": "95249c1c-6c00-30eb-be4e-d706d02d7108",
                                                "text": "\"[…]\" remarked Bernadette, as I looked at her, and she gave me that lovely devilish smile that said : I like liberty, and not necessarily accountability. And evidently, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a2e2cf-f0aa-3f7d-b36d-010aea7c9fc1",
                                        "entry_id": "5f4f6df4-5109-3f81-8799-11946979e6e9",
                                        "glosses": [
                                            "Extreme, excessive."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2f3f8dc-197d-4abd-a2f4-3499ab87a978",
                                                "sense_id": "b4a2e2cf-f0aa-3f7d-b36d-010aea7c9fc1",
                                                "text": "A devilish effort yielded a devilish success."
                                            },
                                            {
                                                "example_id": "4cfa3724-b308-4108-a96d-4b354e77820c",
                                                "sense_id": "b4a2e2cf-f0aa-3f7d-b36d-010aea7c9fc1",
                                                "text": "I had a devilish time moving the wardrobe downstairs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "devilish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cf49117-4e6e-34bb-8ff2-c2464cc44e40",
