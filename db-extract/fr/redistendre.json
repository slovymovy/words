                ],
                "senses": [
                    {
                        "sense_id": "fe5883f8-90a2-38ce-9ab0-77c407329b71",
                        "entry_id": "50c5c4ff-b3b4-3deb-8a2e-5852858d6ec7",
                        "glosses": [
                            "Augmenter de nouveau le volume d’un organe sous l’effet de la tension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1898858d-4b6c-4a2b-b66f-63818207416e",
                                "sense_id": "fe5883f8-90a2-38ce-9ab0-77c407329b71",
                                "text": "Il ne faut pas trop manger aux repas pour ne pas redistendre l’estomac à chaque fois."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2d5ab9d-93d3-39c3-ad01-85e9d413f8e8",
                        "entry_id": "50c5c4ff-b3b4-3deb-8a2e-5852858d6ec7",
                        "glosses": [
                            "Reséparer deux choses que l’on avait rapprochées l’une de l’autre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5d9937e0-4e4e-3de3-8399-3a9a39e052d8",
                        "entry_id": "50c5c4ff-b3b4-3deb-8a2e-5852858d6ec7",
                        "glosses": [
                            "Subir une nouvelle augmentation de volume sous l’effet de la tension."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b077fb41-2553-466b-b59b-89f18db286b6",
                                "sense_id": "5d9937e0-4e4e-3de3-8399-3a9a39e052d8",
                                "text": "Une grossesse ultérieure n’est pas interdite mais l’opération n’empêchera pas l’abdomen de se redistendre et il faudrait réopérer ensuite."
                            },
                            {
                                "example_id": "a072ddde-e80a-4cf7-8758-fe7d17039aaf",
                                "sense_id": "5d9937e0-4e4e-3de3-8399-3a9a39e052d8",
                                "text": "Par ailleurs, la peau à une capacité particulière à se redistendre assez rapidement après l’intervention."
                            }
                        ]
                    }
                ],
