                        "examples": [
                            {
                                "example_id": "c796ce0d-0375-4626-9662-8d4f56cb4a23",
                                "sense_id": "091b13cb-8e50-3465-baab-4df108164eac",
                                "text": "Po wykluciu się z jaj małe krokodylki biegną do wody."
