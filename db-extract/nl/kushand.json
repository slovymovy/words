                    {
                        "sense_id": "a5f85d4b-35ed-38c3-ba8c-c1a1f4375564",
                        "entry_id": "b7f62c46-9c66-3de5-ba98-768754028943",
                        "glosses": [
                            "kus op je eigen hand die je met een wuif gebaar naar iemand anders stuurt, kusgebaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "996dd236-71fe-4ae4-89bb-d96f0064296c",
                                "sense_id": "a5f85d4b-35ed-38c3-ba8c-c1a1f4375564",
                                "text": "Luc begon naar me toe te rennen. Ik kende die film en ook ik begon te rennen. We vlogen in elkaars armen. Ik herinner me het applaus van de omstanders. En toen we gearmd het perron afliepen gingen de agenten opzij. Ze lachten naar ons en de blonde agent gaf ons een kushandje."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb710a54-4863-3659-8b1a-4709c892dcbb",
                        "entry_id": "b7f62c46-9c66-3de5-ba98-768754028943",
                        "glosses": [
                            "kus op de hand van iemand anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f2d586-4e18-48bd-be11-e4c13cf402a3",
                                "sense_id": "eb710a54-4863-3659-8b1a-4709c892dcbb",
                                "text": "Voor de serie The king of Solana Beach trok Antin, met ferme snor en baard en in zwarte cape, hoed en laarzen door haar Californische woonplaats en zelfverklaard koninkrijk. Praatjes slaan met ‘zijn’ onderdanen, in perfect hoofse stijl een kushand geven aan een oudere dame."
                            },
                            {
                                "example_id": "dd6a5170-68b9-445f-b04b-579712c05f88",
                                "sense_id": "eb710a54-4863-3659-8b1a-4709c892dcbb",
                                "text": "Met een galante kushand voor koningin Máxima van de Portugese president Marcelo Rebelo de Sousa is het koningspaar begonnen aan het staatsbezoek aan Portugal."
                            }
                        ]
                    }
