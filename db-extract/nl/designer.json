                    {
                        "translation_id": "6dab7eda-321f-44f4-b3b9-6619437cf8c4",
                        "source_entry_id": "0b9bd85b-fd20-3bbd-8bdc-709bf6123f7b",
                        "source_sense_id": "6158890a-092e-3272-86aa-2ec3a2afc7fb",
                        "target_lang_word": "Designer",
