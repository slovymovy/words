                ],
                "senses": [
                    {
                        "sense_id": "a2b19532-0e8f-37a6-800a-53d8774eef42",
                        "entry_id": "26c733af-598d-3a1a-aba1-a5a201f3ca0a",
                        "glosses": [
                            "Staatsbürger von Weißrussland (Belarus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0911cc98-0db6-4c8d-9bb4-c213526ab99f",
                                "sense_id": "a2b19532-0e8f-37a6-800a-53d8774eef42",
                                "text": "„Und zum Zeitpunkt der Präsidentschaftswahlen, d.h. im Juli 1994. verdiente ein Belarusse im Durchschnitt 87.219 belarussische Rubel (22 US-Dollar).“"
                            },
                            {
                                "example_id": "9455865b-79f0-41ff-bc81-00341d71c6aa",
                                "sense_id": "a2b19532-0e8f-37a6-800a-53d8774eef42",
                                "text": "„Ich erfuhr, dass dies die Heimat des Dichters Adam Mickiewicz war, der in Polen als Nationaldichter verehrt wird, der aber auch von Litauern und Belarussen als einer der ihren beansprucht wird.“"
                            },
                            {
                                "example_id": "cb8ce715-f61e-440b-b887-f755cd1ce746",
                                "sense_id": "a2b19532-0e8f-37a6-800a-53d8774eef42",
                                "text": "Sein Vater ist Belarusse, seine Mutter ist Russin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "667a981d-6e82-3c9b-a191-be25c069aa47",
