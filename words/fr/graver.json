{
    "word_family": [
        "gravure",
        "graveur",
        "graveuse",
        "regraver",
        "gravage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a391b72-4e83-3278-ad27-960b21dd4972",
                    "sense_definition": "Tracer des lettres, des motifs ou des dessins en creux ou en relief sur une matière dure comme la pierre, le bois ou le métal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sculpture_artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan utilise un burin pour <w>graver</w> délicatement les initiales des mariés sur l'anneau en argent."
                        },
                        {
                            "text": "Avant d'installer la plaque commémorative, le marbrier <w>grave</w> chaque lettre avec une grande précision."
                        }
                    ],
                    "synonyms": [
                        "ciseler",
                        "inciser",
                        "sculpter"
                    ],
                    "common_phrases": [
                        "graver dans la pierre"
                    ]
                },
                {
                    "sense_id": "9158700f-da2c-34fa-9f4b-5195941a2288",
                    "sense_definition": "Fixer profondément et durablement un souvenir, une image ou une idée dans l'esprit ou le cœur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce voyage extraordinaire a suffi à <w>graver</w> dans sa mémoire des paysages inoubliables."
                        },
                        {
                            "text": "Les paroles bienveillantes de son grand-père se <w>gravent</w> pour toujours dans son esprit d'enfant."
                        }
                    ],
                    "synonyms": [
                        "ancrer",
                        "imprimer",
                        "inscrire"
                    ],
                    "antonyms": [
                        "effacer",
                        "oublier"
                    ],
                    "common_phrases": [
                        "graver dans la mémoire",
                        "rester gravé dans les esprits",
                        "graver dans son cœur"
                    ]
                },
                {
                    "sense_id": "b736a271-ea1d-3202-b746-9148b2e03a3c",
                    "sense_definition": "Enregistrer des données numériques ou des fichiers multimédias sur un disque optique tel qu'un CD ou un DVD.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en vacances, elle a voulu <w>graver</w> un CD avec ses chansons préférées pour la route."
                        },
                        {
                            "text": "Le technicien <w>grave</w> toutes les photos de famille sur un disque optique afin de les sauvegarder."
                        }
                    ],
                    "synonyms": [
                        "enregistrer"
                    ],
                    "common_phrases": [
                        "graver un CD",
                        "graver un disque",
                        "graver des fichiers"
                    ]
                },
                {
                    "sense_id": "955aa834-0107-3c39-b34b-2bb953a0680d",
                    "sense_definition": "Reproduire un dessin ou une image sur une plaque de métal ou de bois destinée à l'impression d'estampes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'illustrateur passe des heures à <w>graver</w> sur bois les estampes de son prochain livre d'art."
                        },
                        {
                            "text": "Cette artiste réputée <w>grave</w> à l'eau-forte pour obtenir des contrastes d'une grande finesse."
                        }
                    ],
                    "common_phrases": [
                        "graver à l'eau-forte",
                        "graver sur cuivre",
                        "graver sur bois"
                    ]
                }
            ]
        }
    ]
}