                "senses": [
                    {
                        "sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "glosses": [
                            "мед. тонкая материя обычно в виде узкой полоски или ленты с нанесённой на неё клейкой массой, употребляемая для покрытия небольших повреждений кожи, удержания хирургических повязок и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56201409-75c4-4f97-8737-1b4f87490f13",
                                "sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                                "text": "Сделали мне последний раз перевязку, и сестра опять покрыла гноящуюся ранку куском марли, поверх которой налепила несколько слоев лейкопластыря."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f96c1cfc-7ea7-4053-96a9-b716b9a69851",
                        "source_entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "source_sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "target_lang_word": "adhesive bandage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cd41a34e-485d-41dd-9e06-60efe357e154",
                        "source_entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "source_sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "target_lang_word": "band-aid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "band-aid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f89287-0cfa-3804-a224-cc15996477a6",
                                        "entry_id": "330bd6b6-b41d-38ed-aea5-9a607054986d",
                                        "glosses": [
                                            "An adhesive bandage, a small piece of fabric or plastic that may be stuck to the skin in order to temporarily cover a small wound."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b841945c-9fdf-32f7-b2f3-19e14f87cf4b",
                                        "entry_id": "330bd6b6-b41d-38ed-aea5-9a607054986d",
                                        "glosses": [
                                            "A temporary or makeshift solution to a problem, created ad hoc and often with a lack of foresight."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90bcf377-de1e-4b1a-bcf9-588efc447d73",
                                                "sense_id": "b841945c-9fdf-32f7-b2f3-19e14f87cf4b",
                                                "text": "It was another of those political band-aids patted over a minor sore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "band-aid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8fe129-bdd4-3278-baf3-ea14636ebd9d",
                                        "entry_id": "8b0f480b-1637-39f4-9a35-c170b37f6290",
                                        "glosses": [
                                            "To apply an adhesive bandage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beed0899-84e1-4477-a88f-9522d9bd9971",
                                                "sense_id": "8d8fe129-bdd4-3278-baf3-ea14636ebd9d",
                                                "text": "As a school nurse, Pat was used to bandaiding lots of scraped knees and elbows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7140932b-d392-36bd-9611-5d77c0748989",
                                        "entry_id": "8b0f480b-1637-39f4-9a35-c170b37f6290",
                                        "glosses": [
                                            "To apply a makeshift fix; to jury-rig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e7774a-e032-4bb4-b7da-6c9c8d5f9763",
                                                "sense_id": "7140932b-d392-36bd-9611-5d77c0748989",
                                                "text": "Rather than fix the code, we just band-aided the problem by hiding the error message."
                                            },
                                            {
                                                "example_id": "29ee986f-decc-47a9-99b8-1968b18daead",
                                                "sense_id": "7140932b-d392-36bd-9611-5d77c0748989",
                                                "text": "This is where the addictions theorists and therapists fail (perhaps for lack of nerve): they never strongly suggest that their critique should become the basis for concerted, collective therapy as well as individual therapy. They can't. To do so would mean risking their own dependency upon the system and upon the rewards they receive for band-aiding it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83c1bf97-71b6-43e9-aac6-fb96bb15847f",
                        "source_entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "source_sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "target_lang_word": "Leukoplast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leukoplast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30f75827-05d0-3a4f-b3ac-c7c6aa4e218a",
                                        "entry_id": "61309d0a-ba2f-3711-81d4-94375e11ea42",
                                        "glosses": [
                                            "medizinisches Heftpflaster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d75383-5560-4efd-809d-a1e404961f75",
                                                "sense_id": "30f75827-05d0-3a4f-b3ac-c7c6aa4e218a",
                                                "text": "„Darunter war ein Gummirohr an den blockierenden Metallverschluß angeschlossen, und um die Gelenkstellen war Leukoplast gewickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbcf7aef-8fd7-4c34-8ecb-2ce40ffe7183",
                        "source_entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "source_sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "target_lang_word": "Heftpflaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heftpflaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                        "entry_id": "2dba0404-aa19-3d67-b797-d489ada07b8b",
                                        "glosses": [
                                            "klebender Textil- oder Plastikstreifen zum Befestigen eines Verbandes oder, dann mit einer Auflage aus Mull, direkt zum Bedecken von Wunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce4fb42-ee22-4f1e-86e2-64f0b3204543",
                                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                                "text": "Das selbstklebende Heftpflaster wurde 1882 von Beiersdorf erfunden."
                                            },
                                            {
                                                "example_id": "f465f22a-dea2-4e40-b057-613def10b67c",
                                                "sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                                                "text": "„Der einfachste Verband ist das Heftpflaster, eine kleine sterile Wundauflage, die mit einem Pflaster fest verbunden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5727f602-7695-48a0-a8b5-0953e5eabcb6",
                        "source_entry_id": "91e6b502-6ffd-3c44-ba28-43b75de00009",
                        "source_sense_id": "759d61c8-ba82-37ca-b9da-cd230284c2a1",
                        "target_lang_word": "sparadrap",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sparadrap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                                        "glosses": [
                                            "Tissu recouvert d’une sorte d’emplâtre agglutinatif."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ce6afb-59c9-41c8-8c6c-3ab9f3a5bbd4",
                                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                                "text": "Le taffetas d’Angleterre est un sparadrap."
                                            },
                                            {
                                                "example_id": "2596869f-66b2-430b-8a72-354c6966a773",
                                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                                "text": "Le sparadrap, collé sur sa joue, en tirait obliquement la peau tendue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                                        "glosses": [
                                            "Bandage plus ou moins poreux, élastique, adhésif, qui s'applique sur la peau par simple pression et sert à maintenir un pansement ou sert de pansement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b794597-63fd-4090-83f8-60d1a779d6ba",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Les pansements étaient compliqués et difficiles, la fixation des appareils et des linges par le sparadrap n’ayant pas encore été imaginée à cette époque."
                                            },
                                            {
                                                "example_id": "4a1e8ff9-9018-4474-b4c2-6c7589cccb83",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "[Corte] est en train de téléphoner. Il n'a plus de bandages, mais seulement un pansement de sparadrap."
                                            },
                                            {
                                                "example_id": "9b1b5768-3531-4958-9af2-5e7ea3f7b6f0",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Papa n'avait plus son bandeau sur la tête, mais, pour ne pas exhiber son sparadrap et son crâne passé à la tondeuse, il avait mis sa grande viscope d'ouvrier sellier."
                                            },
                                            {
                                                "example_id": "9895847a-e13a-407c-8735-cf1469a25c8b",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Henri enleva son pansement, le remplaça par un carré de sparadrap."
                                            },
                                            {
                                                "example_id": "93494abf-d847-47be-ab37-99a2eb49cdfa",
