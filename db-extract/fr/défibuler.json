                "senses": [
                    {
                        "sense_id": "74c88c1d-8a94-3327-84bd-1feef9de5bd9",
                        "entry_id": "87498f59-efb1-373d-a9f2-46dd88a3def7",
                        "glosses": [
                            "Pratiquer l’opération inverse de l’infibulation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1dca5163-1ddc-4544-a579-e474318b07af",
                                "sense_id": "74c88c1d-8a94-3327-84bd-1feef9de5bd9",
                                "text": "Les dames romaines tenaient à défibuler elles-mêmes les acteurs, dans l'espoir de recueillir les bénéfices supposés d'une continence longue et forcée."
                            },
                            {
                                "example_id": "76e3b245-123f-486c-bda5-7d0800652e8e",
                                "sense_id": "74c88c1d-8a94-3327-84bd-1feef9de5bd9",
                                "text": "Une femme peut aussi se défibuler, avoir des rapports sexuels en l'absence de son mari et ensuite s'infibuler."
                            }
                        ]
                    }
