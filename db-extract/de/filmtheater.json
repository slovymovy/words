                                                "text": "Restructuration du cinéma-théâtre Les 3 Pierrots"
                                            },
                                            {
                                                "example_id": "d31581d2-51a5-40c2-a5ac-9036c3e4aae0",
                                                "sense_id": "823eb5a4-97fe-3b28-ae42-c7368ca185e3",
                                                "text": "La Municipalité veut faire du Beaumont Palace un cinéma-théâtre."
                                            },
                                            {
                                                "example_id": "149df071-8f76-43e6-807a-1aace8cda566",
                                                "sense_id": "823eb5a4-97fe-3b28-ae42-c7368ca185e3",
                                                "text": "Un cinéma-théâtre \"à l’italienne\" qui attire de nombreux visiteurs étrangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66069e51-c85e-428b-be4b-acd7ccda9f05",
                        "source_entry_id": "a3dcc954-6724-3b89-af6c-1c759c23daf6",
                        "source_sense_id": "1de06e64-45d8-3dfe-a3a9-4ab793f5c72a",
