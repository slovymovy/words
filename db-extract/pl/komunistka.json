                        ]
                    },
                    {
                        "translation_id": "5f5ed9cd-f403-4e8e-91ca-36bc2391a5a2",
                        "source_entry_id": "24ac5ebf-c29c-38f7-a703-a9c4deef33e8",
                        "source_sense_id": "5a4e980b-26d7-3c10-affb-7e86be6e6ec0",
                        "target_lang_word": "communiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                        "entry_id": "3dbd8423-8531-364b-be1e-474a6e5afb06",
                                        "glosses": [
                                            "Relatif au communisme, propre au communisme."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da42db9-c0ca-4236-98a3-09f2f48d672f",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Les lambeaux d’idées communistes qu’il avait pris le matin dans les journaux devenaient grotesques et monstrueux en passant par sa bouche."
                                            },
                                            {
                                                "example_id": "20b99181-74e3-45c4-aa34-877f60052849",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Quelle diversité dans mes journées ! La classe de Louis-le-Grand, les palabres de l’œuf à la coque, ma cellule communiste du quai de Javel, le tennis d’Auteuil, le salon de Tante Reine, la bibliothèque de l’Oncle…"
                                            },
                                            {
                                                "example_id": "28991b28-0eaf-4fba-92f4-bcfca363838b",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Communiste ! Ce mot est pareil à un boulet de fonte qui pèserait sur lui. Juste au creux de l’estomac. Pour l’écraser lentement.\nPaul lui a expliqué dix fois ce qu’est le communisme. Alors, il le voit très bien. Dès que les Allemands seront battus, tous les communistes vont revenir. Avec leurs armes. Ils seront les maîtres. Ils entreront chez lui."
                                            },
                                            {
                                                "example_id": "12d35db7-7aa9-4e18-953d-5e799d1316fa",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Pendant que dans l'économie communiste le Gosplan était substitué à la « main invisible » du marché, le keynésianisme tempéré, combinant le rôle de l'État et celui du marché, inspirait la pensée des démocrates américains et des sociaux-démocrates européens."
                                            },
                                            {
                                                "example_id": "d5dc448f-499f-4648-bb5e-162fd37b37a8",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "On s’amuse beaucoup, malgré quelques longueurs, face à des personnages aussi délirants qu’un Russe capitaliste, un Américain communiste (Woody Harrelson, irrésistible) et un couple de vieux Anglais à la bonhomie trompeuse."
                                            },
                                            {
                                                "example_id": "564ee2a5-3b11-4fbf-b19a-3e86a9590081",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Sans doute cela ne prouve pas que vous ne soyez pas sincère dans vos convictions d’aujours’hui. Mais de là à être républicain et communiste, comme on dit que vous l’êtes il y a loin ; et quand on a subi de telles variations, on devrait savoir assez de prudence pour ne pas se rendre l’instrument de calomnies odieuses autant qu’absurde."
                                            },
                                            {
                                                "example_id": "479de177-0a52-440c-882c-94d7f41a502f",
                                                "sense_id": "cde59a63-928d-31c4-a1ed-d8b90106bada",
                                                "text": "Le régime communiste est le seul à pouvoir garantir une égalité entre les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dad5b8d-d939-33ff-b02a-4b24a6a68ed4",
                                        "entry_id": "3dbd8423-8531-364b-be1e-474a6e5afb06",
                                        "glosses": [
                                            "Qui appartient à un parti communiste."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3fb9fce-9cdb-4dad-89c6-f0db62492ae9",
                                                "sense_id": "7dad5b8d-d939-33ff-b02a-4b24a6a68ed4",
                                                "text": "Il a été condamné pour ses opinions communistes. Il a été libéré après l’arrivée des communistes au pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8652f72f-3f05-300f-92ef-4f410824bea0",
                                        "entry_id": "3dbd8423-8531-364b-be1e-474a6e5afb06",
                                        "glosses": [
                                            "Qui appartient à un parti communiste.",
                                            "Qui appartient au Parti communiste français."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d963d5ac-18cc-4eb7-bde3-b886a1cfc138",
                                                "sense_id": "8652f72f-3f05-300f-92ef-4f410824bea0",
                                                "text": "Le chef de file des députés communistes, André Chassaigne, va quitter ses fonctions cette année. Elu depuis 2002, il était passé tout près de la présidence de l’Assemblée nationale, en juillet 2024."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "communiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e01c1d-218a-31e2-8ad0-91189b121784",
                                        "entry_id": "39de8a25-9115-35cf-a66e-804697f2d9ab",
                                        "glosses": [
                                            "Celui ou celle qui possède un bien avec un ou plusieurs autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad50b21-1cf9-4112-b85f-b44cf6fd22a8",
                                                "sense_id": "15e01c1d-218a-31e2-8ad0-91189b121784",
                                                "text": "Les constructions ou améliorations faite sur un immeuble possédé en commun par deux individus sont présumées de droit, et jusqu’à preuve contraire, appartenir aux deux communistes. — Par suite, si l'un des deux communistes vend à l’autre sa part de l’immeuble, le droit de mutation doit être perçu en prenant pour base la valeur de l’immeuble, y compris celle des constructions ou améliorations, […]."
                                            },
                                            {
                                                "example_id": "eab98569-1717-4840-b17f-760ff8356793",
                                                "sense_id": "15e01c1d-218a-31e2-8ad0-91189b121784",
                                                "text": "- En conséquence, un tel acte ne fait pas obstacle à ce que l’hypothèque consentie par un communiste sur les immeubles indivis subsiste même sur ceux de ces immeubles qui ont été cédés ou adjugés aux autres communistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f825f21c-1f87-3183-8795-f74e611222a0",
                                        "entry_id": "39de8a25-9115-35cf-a66e-804697f2d9ab",
                                        "glosses": [
                                            "Partisan du communisme."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9accc7e-80ad-4572-816a-6b2639eb6d91",
                                                "sense_id": "f825f21c-1f87-3183-8795-f74e611222a0",
                                                "text": "Je dois murmurer à voix très basse :\n— Esprit-Saint, aidez-moi !\nL’idéal serait de faire en même temps le signe de croix. A l’église, pas de problème. En classe, dans la rue, impossible d’implorer le secours de l’Esprit-Saint : les communistes se moqueraient de moi."
                                            },
                                            {
                                                "example_id": "8a659d2f-87f3-486b-89d5-ab3f6cccecb6",
                                                "sense_id": "f825f21c-1f87-3183-8795-f74e611222a0",
                                                "text": "Un fer à cheval porte-bonheur, cloué sur la muraille, indiquait la demeure d’Honoré Demasure, le communiste."
                                            },
                                            {
                                                "example_id": "f2ec5f8f-2277-468a-b973-1d1ffa88e63d",
                                                "sense_id": "f825f21c-1f87-3183-8795-f74e611222a0",
                                                "text": "Ce fut le rôle historique de Charles de Gaulle, qui avait déjà, de façon assez analogue, rendu acceptable à la bourgeoisie française l’entrée dans la coalition anti-hitlérienne aux côtés de Staline et des communistes français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3834738b-f449-3db6-a4d3-8a5220830724",
                                        "entry_id": "39de8a25-9115-35cf-a66e-804697f2d9ab",
                                        "glosses": [
                                            "Personne partisane ou membre du Parti communiste français."
                                        ],
                                        "tags": [
                                            "Communisme",
                                            "France"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
