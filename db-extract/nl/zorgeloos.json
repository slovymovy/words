                "senses": [
                    {
                        "sense_id": "791d8a72-65c8-38e4-8f40-4e563804800c",
                        "entry_id": "8bed7090-e188-3a3d-8b69-c40740fabc64",
                        "glosses": [
                            "onbekommerd, zonder zorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d85c178-495b-4c87-8d0a-5d4ae837e3d2",
                                "sense_id": "791d8a72-65c8-38e4-8f40-4e563804800c",
                                "text": "Ons werd direct een zorgeloze vakantie aangeboden."
                            },
                            {
                                "example_id": "6651d65c-702e-42f3-95ad-2a42cda08836",
                                "sense_id": "791d8a72-65c8-38e4-8f40-4e563804800c",
                                "text": "Veel mensen denken dat kinderen een zorgeloos leven hebben. Die mensen zijn niet goed bij hun hoofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb3d4d73-4baa-4c9b-bc98-290baa5cee89",
                        "source_entry_id": "8bed7090-e188-3a3d-8b69-c40740fabc64",
                        "source_sense_id": "791d8a72-65c8-38e4-8f40-4e563804800c",
                        "source_sense_description": "onbekommerd, zonder zorgen",
                        "target_lang_word": "carefree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "964ea089-fb48-36cd-88c1-fc3affe2d7a3",
                                        "entry_id": "0108228c-bd3f-3ac8-a07d-4d948518becd",
                                        "glosses": [
                                            "Without cares or worries; free of concern or worries; without difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8482dc63-c013-48bc-a6bb-f352bead7999",
                                                "sense_id": "964ea089-fb48-36cd-88c1-fc3affe2d7a3",
                                                "text": "He left his cell phone behind and enjoyed a carefree summer day at the beach."
                                            },
                                            {
                                                "example_id": "ed9e61ec-7f8a-4bef-b0d1-67f2b3fdf3f7",
                                                "sense_id": "964ea089-fb48-36cd-88c1-fc3affe2d7a3",
                                                "text": "You know: sometimes, baby, I'm so carefree / With a joy that's hard to hide"
                                            },
                                            {
                                                "example_id": "822fdaf7-c773-495e-8ef1-887cec34fc72",
                                                "sense_id": "964ea089-fb48-36cd-88c1-fc3affe2d7a3",
                                                "text": "Many of these parks still honor the lazy, carefree tradition of floating down a slow-moving stream in an inflated inner tube."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4f5d8f0-25a5-4ebf-a7f9-c906fa15a6dd",
                        "source_entry_id": "8bed7090-e188-3a3d-8b69-c40740fabc64",
                        "source_sense_id": "791d8a72-65c8-38e4-8f40-4e563804800c",
                        "source_sense_description": "onbekommerd, zonder zorgen",
                        "target_lang_word": "insoucieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insoucieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                        "entry_id": "080468b2-d92d-3c8e-bc89-2bbc7050c573",
                                        "glosses": [
                                            "Qui ne se soucie pas d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60fc422b-130b-4106-baf1-da83167b4f37",
                                                "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                                "text": "Indolente, insoucieuse des premières notions de la propreté, insoucieuse d’ailleurs de la mort tout autant, elle accepte le mal que lui envoie le Grand-Être et ne se défend point."
                                            },
                                            {
                                                "example_id": "2820fb07-a279-46f4-9101-5bc7cd07494d",
                                                "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                                "text": "J’étais insoucieux de tous les équipages,\nPorteur de blés flamands ou de cotons anglais."
                                            },
                                            {
                                                "example_id": "45ad4694-a327-477b-8048-d51b2c314048",
                                                "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                                "text": "Car, insoucieux en effet du temps, ivre de vin et de discussions métaphysiques, le Mousse avait visité une à une toutes les fermes du plateau, […]."
                                            },
                                            {
                                                "example_id": "e2802659-1f0d-467a-9fc3-36f25f1046d3",
                                                "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                                "text": "Elle était l’un des plus riches partis de la ville, et fort insoucieuse d’un père qu’elle avait à peine entrevu."
                                            },
                                            {
                                                "example_id": "b6d40997-4885-47cf-8dfc-d1b9981b49fb",
                                                "sense_id": "ce7854dd-321e-3e70-908b-5fdc6512852a",
                                                "text": "C’est toujours un moment grave que celui où un jeune esprit jusque-là insoucieux de politique découvre soudain que l’injustice et l’intérêt mal entendu passent et repassent devant lui dans les rues d’une ville avec des effets de cape et d’uniforme, ou s’attablent au café sous l’aspect de bons bourgeois qui ne prennent pas parti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "368ba3e4-729c-3f1e-a51c-93f3d3f6f055",
                                        "entry_id": "080468b2-d92d-3c8e-bc89-2bbc7050c573",
                                        "glosses": [
                                            "Qui ne se fait aucun souci."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070dedea-51dc-4dd5-a60c-6f89b46351ca",
                                                "sense_id": "368ba3e4-729c-3f1e-a51c-93f3d3f6f055",
                                                "text": "Où l’insoucieux financier\nEntretient des nymphes jolies,\nQui, pour s’en faire mieux payer,\nLui font par jour cent perfidies; …"
                                            },
                                            {
                                                "example_id": "cf1bd358-389b-44bd-874c-272d4038abca",
                                                "sense_id": "368ba3e4-729c-3f1e-a51c-93f3d3f6f055",
                                                "text": "Son faux-col engloutit son oreille. Ses yeux\nDans un rêve sans fin flottent insoucieux,\nEt le printemps en fleur sur ses pantoufles brille."
                                            },
                                            {
                                                "example_id": "4a7cb79d-783f-4879-be32-e2e2ce467065",
                                                "sense_id": "368ba3e4-729c-3f1e-a51c-93f3d3f6f055",
                                                "text": "Et toi, Musette, reine insoucieuse et folle,\nQui n’a cherché tes yeux, qui n’a redit ton nom ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4690620e-692c-3403-8d0b-e3cd30b36493",
                                        "entry_id": "080468b2-d92d-3c8e-bc89-2bbc7050c573",
                                        "glosses": [
                                            "Qui fait preuve d’une insouciance coupable."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05a5eda3-1afc-480d-953e-9002c4c64f33",
                                                "sense_id": "4690620e-692c-3403-8d0b-e3cd30b36493",
                                                "text": "Car un Gouvernement insoucieux ou n’ayant que de mauvais desseins, loin de penser à l’instruction des sujets, écartera plutôt ce qui pourroit les rendre attentifs à la manière dont on les conduit, à l’idée d'une Patrie ; les distraira par des spectacles & des plaisirs ; vuadta les rendre enfin semblables à lui-même."
                                            },
                                            {
                                                "example_id": "1b282eaa-64ae-452e-950c-9d9dea21699d",
                                                "sense_id": "4690620e-692c-3403-8d0b-e3cd30b36493",
                                                "text": "Puis on crie, on intrigue, on calomnie le commerce, on entoure & on circonvient les ministres ; & les ministres inexperts, insoucieux, partiaux, négligent toute information, & jugent & écrivent, & lancent des arrêts, & blessent à tort & à travers, soufflés par des partis intéressés & ennemis..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ceb048a-fcb6-3c62-976d-6e99b6402a63",
                                        "entry_id": "080468b2-d92d-3c8e-bc89-2bbc7050c573",
                                        "glosses": [
                                            "Qui traduit, manifeste l’insouciance d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d52a72-d852-4df2-b30c-da79659d87a3",
                                                "sense_id": "4ceb048a-fcb6-3c62-976d-6e99b6402a63",
                                                "text": "Peu en revinrent : partis en riant et en devisant sur leurs dames, ils étourdirent de leur jactance et de leurs insoucieux propos les guerriers hongrois, qui ne trouvaient guère à plaisanter là, car il y allait de leur vie et de leur indépendance nationale,…."
                                            },
                                            {
                                                "example_id": "71cbf69e-e28f-445c-aff3-3db3f7deb044",
                                                "sense_id": "4ceb048a-fcb6-3c62-976d-6e99b6402a63",
                                                "text": "Clémence tressaillit légèrement et changea d’autorité l’expression de sa physionomie. Elle prit un beau petit air insoucieux et répéta en se dirigeant vers la charmille : -Psttt! psttt!..."
                                            },
                                            {
                                                "example_id": "b1aadc19-b2f5-485b-8a48-a6f6d0e4d36e",
                                                "sense_id": "4ceb048a-fcb6-3c62-976d-6e99b6402a63",
                                                "text": "Et, brusquement, sa gaieté coquette, son insoucieuse légèreté revinrent, au milieu d’un invincible rire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "320d9a10-2ad8-43f7-b39d-9427437aa50a",
                        "source_entry_id": "8bed7090-e188-3a3d-8b69-c40740fabc64",
