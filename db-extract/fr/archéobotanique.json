                "senses": [
                    {
                        "sense_id": "8d22c678-e787-32fe-b1b6-ca45e1962b17",
                        "entry_id": "e9624423-43cd-3b4f-a00d-2c7a03b82b58",
                        "glosses": [
                            "Ensemble de disciplines scientifiques qui s’intéressent aux vestiges d’origine végétale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60a75fb-a76b-4f96-b7cf-7e2bc680d434",
                                "sense_id": "8d22c678-e787-32fe-b1b6-ca45e1962b17",
                                "text": "Au sein des études dites paléoenvironnementales, et à côté de l’archéozoologie et de la géoarchéologie, l’archéobotanique rassemble elle-même plusieurs disciplines. Elles ont en commun d’étudier les vestiges d’origine végétale, et de se situer au croisement de la botanique, de l’archéologie et de l’ethnologie."
                            },
                            {
                                "example_id": "6d206026-2e3f-48df-ae75-8be50f3bfad5",
                                "sense_id": "8d22c678-e787-32fe-b1b6-ca45e1962b17",
                                "text": "Ces changements, tout autant que les changements environnementaux, sont l’objet des études de l’archéobotanique."
                            }
                        ]
                    }
                ],
