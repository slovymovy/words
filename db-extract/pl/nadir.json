                                        "glosses": [
                                            "der tiefste Punkt des Himmelsgewölbes senkrecht unter dem Betrachter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243cbe21-56b2-45a8-8bca-b04cfc690439",
                                                "sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                                                "text": "Der Blick auf den Nadir ist für einen Beobachter auf der Erde durch den Erdkörper stets verwehrt."
                                            },
                                            {
                                                "example_id": "0aae24f1-806b-4c01-a3d7-4c33f287e58c",
                                                "sense_id": "5d2be470-d9ca-3575-bca9-501b0303e15e",
                                                "text": "„Vom Zenit bis zum Nadir erstreckte sich ein unübersehbarer Ring von Sternenstaub, jene Milchstraße, in deren Mitte unsere Sonne nur als Stern vierter Größe gilt.“"
                                            }
                                        ],
