                                        "glosses": [
                                            "Canard sauvage commun, canard de surface à tête verte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae0cf3f-d00e-4386-817f-a65f1f3fbd06",
                                                "sense_id": "85b48d4a-baf7-312e-a1f4-d8fd8e42c2f9",
                                                "text": "Les colverts sont des oiseaux migrateurs."
                                            },
                                            {
                                                "example_id": "fb62fcc8-3510-4296-8f8a-6090e9ef3e36",
                                                "sense_id": "85b48d4a-baf7-312e-a1f4-d8fd8e42c2f9",
                                                "text": "Le colvert est la seule espèce de canards « qu’en langage cynégétique on appelle « le canard sauvage »."
                                            },
                                            {
                                                "example_id": "b5735b38-5231-4a98-a93c-5d8d9c237a97",
                                                "sense_id": "85b48d4a-baf7-312e-a1f4-d8fd8e42c2f9",
                                                "text": "Mais savais-tu qu'il est assez courant que les gens aient une collection de colverts en bois et pas des moindres, en exposition ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
