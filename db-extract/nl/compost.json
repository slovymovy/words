                    {
                        "sense_id": "769370f7-d5e0-3f10-89a1-ddb567e69b03",
                        "entry_id": "131748b9-2083-33ad-a72b-7d89c538e895",
                        "glosses": [
                            "residu dat ontstaat na ontbinding van organisch materiaal (d.w.z. van plantaardige of dierlijke oorsprong)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d986ec-e6fc-409e-b965-5def9f029474",
                                "sense_id": "769370f7-d5e0-3f10-89a1-ddb567e69b03",
                                "text": "Men maakt van gft-afval compost"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0115a160-3ddb-4ccf-9a2c-0f258f800410",
                        "source_entry_id": "131748b9-2083-33ad-a72b-7d89c538e895",
                        "source_sense_id": "769370f7-d5e0-3f10-89a1-ddb567e69b03",
                        "source_sense_description": "is het residu dat ontstaat na ontbinding van organisch materiaal (d.w.z. van plantaardige of dierlijke oorsprong)",
                        "target_lang_word": "Kompost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                        "entry_id": "89135e62-311d-302d-8d5d-d2616609b588",
                                        "glosses": [
                                            "organische Stoffe im Endstadium der Rotte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc7b8a5-9308-48f0-8730-7dbc3e6b2433",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "Zur Herstellung eines guten Kompostes benötigt man viele Regenwürmer."
                                            },
                                            {
                                                "example_id": "9e502539-b3ad-4ca8-835a-658a4c79c214",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Das Camp war auch umweltfreundlich, produzierte Solarstrom und verarbeitete alle Küchenabfälle zu Kompost, mit dem der ausgedehnte Gemüsegarten gedüngt wurde.“"
                                            },
                                            {
                                                "example_id": "a722b6f4-cba2-4211-80da-b436c529cb2b",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Ich brachte die Schalen auf den Kompost, und die Mutter setzte die Kartoffeln auf.“"
                                            },
                                            {
                                                "example_id": "5ba66804-8fba-4e62-9b7b-87dbec01e0fe",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Mein Blick fiel auf die Elster, die auf dem Kompost zwischen den riesigen Kürbisblättern herumhüpfte.“"
                                            },
                                            {
                                                "example_id": "8bfcf7d2-d5f8-49a6-bde2-ee77a807d2d9",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Nachdem die Pflanzlöcher gegraben waren, schnitten sie das äußerste Ende sämtlicher Wurzeln ab, der guten wie der schlechten, und setzten sie in Kompost ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8f715eb-3212-4ba2-bff1-8a5c8afa2541",
                        "source_entry_id": "131748b9-2083-33ad-a72b-7d89c538e895",
                        "source_sense_id": "769370f7-d5e0-3f10-89a1-ddb567e69b03",
                        "source_sense_description": "is het residu dat ontstaat na ontbinding van organisch materiaal (d.w.z. van plantaardige of dierlijke oorsprong)",
                        "target_lang_word": "compost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4833ff-69c6-3c86-a566-878f301dbadb",
                                        "entry_id": "fd0aac08-ea06-3b72-8dc3-d12569e62e87",
                                        "glosses": [
                                            "The decayed remains of organic matter that has rotted into a natural fertilizer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7668ef1a-5bd8-47c3-8116-63f1fdba73bc",
                                                "sense_id": "8f4833ff-69c6-3c86-a566-878f301dbadb",
                                                "text": "Dig plenty of compost into clay or sandy soil to improve its structure."
                                            },
                                            {
                                                "example_id": "ab7cf2a3-e4d9-40a9-8405-5c3900a26e19",
                                                "sense_id": "8f4833ff-69c6-3c86-a566-878f301dbadb",
                                                "text": "And do not spread the compost on the weeds / To make them ranker."
                                            },
                                            {
                                                "example_id": "c6afd9c4-1cc4-40d2-83d5-7600fff120f1",
                                                "sense_id": "8f4833ff-69c6-3c86-a566-878f301dbadb",
                                                "text": "[T]he very wet winter will have washed much of the goodness out of the soil. Homemade compost and the load of manure we get from a friendly farmer may not be enough to compensate for what has leached from the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764c7d57-e8e9-35c5-82cb-06ad3cf6af02",
                                        "entry_id": "fd0aac08-ea06-3b72-8dc3-d12569e62e87",
                                        "glosses": [
                                            "A medium in which one can cultivate plants."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c74d26a-b5eb-476e-b8ec-78a32ab86194",
                                                "sense_id": "764c7d57-e8e9-35c5-82cb-06ad3cf6af02",
                                                "text": "Once the seed tray is filled with compost, insert the seeds spaced 3 cm apart from one another."
                                            },
                                            {
                                                "example_id": "56b55e1f-00b0-4194-8aea-c3cbc43c3a58",
                                                "sense_id": "764c7d57-e8e9-35c5-82cb-06ad3cf6af02",
                                                "text": "[T]he term 'compost' is commonly used to mean the material used to fill pots, seed trays and containers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645e01fe-8d0a-3da2-b0c5-1ea27dfdbf8c",
                                        "entry_id": "fd0aac08-ea06-3b72-8dc3-d12569e62e87",
                                        "glosses": [
                                            "A mixture; a compound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c64ad5-be2a-4ed0-81f3-6e3603e42c02",
                                                "sense_id": "645e01fe-8d0a-3da2-b0c5-1ea27dfdbf8c",
                                                "text": "A sad compost of more bitter than sweet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f415b8d8-b79f-39db-b251-1d9fe57da2be",
                                        "entry_id": "86cd7ec0-daa0-3db2-b7d2-42749b2ce1ce",
                                        "glosses": [
                                            "To produce compost, let organic matter decay into fertilizer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb9cc1f-4cf7-40cd-96ee-720653553fd7",
                                                "sense_id": "f415b8d8-b79f-39db-b251-1d9fe57da2be",
                                                "text": "If you compost your grass clippings, you can improve your soil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ac02ce-92a2-4a1c-abdc-bcfdd449eb8c",
                        "source_entry_id": "131748b9-2083-33ad-a72b-7d89c538e895",
                        "source_sense_id": "769370f7-d5e0-3f10-89a1-ddb567e69b03",
                        "source_sense_description": "is het residu dat ontstaat na ontbinding van organisch materiaal (d.w.z. van plantaardige of dierlijke oorsprong)",
                        "target_lang_word": "compost",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compost",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                        "entry_id": "0fea6805-9ef7-3b53-9c95-53cf2541c87d",
                                        "glosses": [
                                            "Mélange de matières organiques que l’on rassemble en silo, en tas ou dans un fût à composter afin qu'elles subissent une décomposition aérobique pour former un humus stable de bonne qualité qui servira ensuite comme amendement ou couverture de sol."
                                        ],
                                        "tags": [
                                            "Déchets",
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf4d184-bdfb-484d-a6c2-19f41f16d46d",
                                                "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                                "text": "Dans une ferme bien tenue, le cultivateur ne doit laisser rien perdre des résidus de toute sorte d'origine animale ou végétale : il doit même chercher à se procurer dans les environs le plus de substances fertilisantes possibles à bon marché pour en faire des composts, […]."
                                            },
                                            {
                                                "example_id": "c4b32adc-2f88-4d59-aff0-ef621740754e",
                                                "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                                "text": "La production de compost à partir des restes de marchés pourrait être mieux exploitée dans certaines villes."
                                            },
                                            {
                                                "example_id": "24b8e34c-6218-4cd1-afc9-b5b5b075f607",
                                                "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                                "text": "Puis leurs déchets seraient recyclés au maximum, via des efforts individuels mais aussi des composts collectifs, afin de servir d’engrais à leurs futurs légumes."
                                            },
                                            {
                                                "example_id": "32a9a129-1018-4cb1-b067-f5b148341cf1",
                                                "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                                "text": "D'après les estimations des professionnels, environ 3 millions de tonnes de composts contenant du déchet vert sont produites annuellement en France pour servir d'amendements organiques en espaces verts, dans les jardins et en agriculture."
                                            },
                                            {
                                                "example_id": "8a585630-e94a-4d0a-9446-081262597ce0",
                                                "sense_id": "2c08fbb1-23d7-31b1-9628-8dd7f4e0ef81",
                                                "text": "Les termites, attirés par le compost, creusent des galeries permettant de retenir et répartir l’eau à l’arrivée des pluies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
