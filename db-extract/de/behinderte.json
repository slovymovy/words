                                "sense_id": "70ec5ac4-cacf-3032-886a-05f5c745eace",
                                "text": "Die Behinderte schlurfte die Straße entlang."
                            },
                            {
                                "example_id": "dc062b92-1952-4402-8c89-cbc5028f23bc",
                                "sense_id": "70ec5ac4-cacf-3032-886a-05f5c745eace",
                                "text": "Einige Behinderte stellen in speziellen Werkstätten handgemachte Besen und andere Gebrauchsgegenstände her."
                            }
