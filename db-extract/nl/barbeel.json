                                        "glosses": [
                                            "schlanker Flussfisch mit auffallenden Barteln (Gattung Barbus im engeren Sinne, speziell die Flussbarbe B. barbus)"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
