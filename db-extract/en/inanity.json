                        "entry_id": "83cf4084-96df-303a-88ee-19d4b835ce46",
                        "glosses": [
                            "The property of being inane, of lacking material of interest or satisfaction, emptiness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b109bab5-c3b1-360a-8274-c34e6d91cb46",
                        "entry_id": "83cf4084-96df-303a-88ee-19d4b835ce46",
                        "glosses": [
                            "Something that is inane."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1ae0ffc-28d1-4c74-89d9-34ac706b54b3",
                                "sense_id": "b109bab5-c3b1-360a-8274-c34e6d91cb46",
                                "text": "Working in any bureaucracy means being bedeviled by inanities daily."
                            },
                            {
                                "example_id": "d400f592-ae8f-438a-a7a2-ffca522bb6e5",
                                "sense_id": "b109bab5-c3b1-360a-8274-c34e6d91cb46",
                                "text": "It was incessant matter for amazement how these Olympians would talk over our heads - during meals, for instance - of this or the other social or political inanity, under the delusion that these pale phantasms of reality were among the importances of life."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "956ce971-707e-4ee4-a7f9-75ea7ed8eabc",
