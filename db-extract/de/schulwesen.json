                ],
                "senses": [
                    {
                        "sense_id": "31a8b257-f0ff-3221-b8c6-87018673e412",
                        "entry_id": "f6ae99a8-569b-3c84-9607-c3fbeef53b32",
                        "glosses": [
                            "Gesamtheit aller Umstände (Voraussetzungen und Maßnahmen), die bei der Organisation und Durchführung von Schule eine Rolle spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28650e31-d340-4e3c-9fdb-6bfbeb5d6764",
                                "sense_id": "31a8b257-f0ff-3221-b8c6-87018673e412",
                                "text": "„Doch selbst ein so ausgebautes lateinisches Schulwesen hätte jene Aufgabe nicht übernehmen können, die den führenden Geistern der Reformation als eine noch dringlichere vor Augen trat: nämlich die evangelische Unterweisung der ganzen Jugend.“"
                            },
                            {
                                "example_id": "243ce8a5-19d8-40ff-b762-b34181291e73",
                                "sense_id": "31a8b257-f0ff-3221-b8c6-87018673e412",
                                "text": "„Sie sorgten für ein Schulwesen und schufen ein System der Verwaltung.“"
                            },
                            {
                                "example_id": "73cb4505-76fd-4630-8228-819e6cfde825",
                                "sense_id": "31a8b257-f0ff-3221-b8c6-87018673e412",
                                "text": "„Die Regierung finanzierte ein jiddischsprachiges Schulwesen, einschließlich weiterführender Schulen, Berufsschulen und einer akademischen Lehrerbildung.“"
                            },
                            {
                                "example_id": "17b1f411-02e3-4a72-bf76-b01a3b0af805",
                                "sense_id": "31a8b257-f0ff-3221-b8c6-87018673e412",
                                "text": "„Eine der ersten umfänglichen Arbeiten für den Magistrat ist ein Gutachten zur Reform des Schulwesens, das durch bürokratische Misswirtschaft zerrüttet sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
