                {
                    "sense_id": "ac71f8c9-7ff4-38b6-952b-4a637b92e3cf",
                    "sense_definition": "w przeszłości, dawniej (często w kontekście minionych czasów)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To, co zdarzyło się <w>wczoraj</w>, nie powinno wpływać na twoją przyszłość.",
                            "target_lang_translations": {
                                "ru": "То, что случилось <w>вчера</w>, не должно влиять на твоё будущее.",
                                "en": "What happened <w>yesterday</w> should not affect your future.",
                                "nl": "Wat er <w>gisteren</w> gebeurde, zou je toekomst niet moeten beïnvloeden.",
                                "de": "Was <w>gestern</w> geschah, sollte deine Zukunft nicht beeinflussen.",
                                "fr": "Ce qui s'est passé <w>hier</w> ne devrait pas influencer ton avenir.",
                                "it": "Ciò che è successo <w>ieri</w> non dovrebbe influenzare il tuo futuro.",
                                "cs": "To, co se stalo <w>včera</w>, by nemělo ovlivňovat tvou budoucnost.",
                                "tr": "<w>Dün</w> yaşananlar geleceğini etkilememeli.",
                                "es": "Lo que ocurrió <w>ayer</w> no debería afectar a tu futuro.",
                                "zh": "<w>过去</w>发生的事情不应该影响你的未来。"
                            }
                        },
                        {
                            "text": "Żyjemy tak, jakby <w>wczoraj</w> nigdy nie istniało.",
                            "target_lang_translations": {
                                "ru": "Мы живём так, как будто <w>вчера</w> никогда не существовало.",
                                "en": "We live as if <w>yesterday</w> never existed.",
                                "nl": "We leven alsof <w>gisteren</w> nooit heeft bestaan.",
                                "de": "Wir leben so, als hätte es das <w>Gestern</w> nie gegeben.",
                                "fr": "Nous vivons comme si <w>hier</w> n'avait jamais existé.",
                                "it": "Viviamo come se <w>ieri</w> non fosse mai esistito.",
                                "cs": "Žijeme tak, jako by <w>včerejšek</w> nikdy neexistoval.",
                                "tr": "Sanki <w>dün</w> hiç yaşanmamış gibi yaşıyoruz.",
                                "es": "Vivimos como si el <w>ayer</w> nunca hubiera existido.",
                                "zh": "我们生活得好像<w>过去</w>从未存在过一样。"
                            }
                        }
