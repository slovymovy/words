{
    "word_family": [
        "сбор",
        "собрание",
        "собиратель",
        "сборный",
        "собирательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17ece8b4-c72e-3a33-ac1c-8d6e3489c1b7",
                    "sense_definition": "Сходиться, съезжаться или сосредоточиваться в одном месте.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Люди <w>собираются</w> на главной площади города для праздника.",
                            "target_lang_translations": {
                                "en": "People are <w>gathering</w> in the main city square for the celebration."
                            }
                        },
                        {
                            "text": "Гости <w>собираются</w> к вечеру, чтобы отметить день рождения.",
                            "target_lang_translations": {
                                "en": "Guests are <w>gathering</w> by the evening to celebrate the birthday."
                            }
                        }
                    ],
                    "antonyms": [
                        "расходиться",
                        "разъезжаться"
                    ],
                    "common_phrases": [
                        "собираться вместе"
                    ],
                    "target_lang_definitions": {
                        "en": "To come together, meet, or congregate in one place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "to congregate or assemble in a group"
                            },
                            {
                                "target_lang_word": "assemble",
                                "target_lang_sense_clarification": "to come together as a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9fd4dc2-a451-30c7-9c09-b282455435c5",
                    "sense_definition": "Намереваться или приготавливаться отправиться куда-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>собираюсь</w> в банк, чтобы оплатить счета.",
                            "target_lang_translations": {
                                "en": "I am <w>getting ready</w> to go to the bank to pay the bills."
                            }
                        },
                        {
                            "text": "Она <w>собирается</w> в отпуск на море в следующем месяце.",
                            "target_lang_translations": {
                                "en": "She is <w>preparing</w> for a vacation by the sea next month."
                            }
                        }
                    ],
                    "synonyms": [
                        "идти́",
                        "е́хать"
                    ],
                    "common_phrases": [
                        "собираться в дорогу"
                    ],
                    "target_lang_definitions": {
                        "en": "To intend or prepare to go somewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prepare",
                                "target_lang_sense_clarification": "to make oneself ready for a future action"
                            },
                            {
                                "target_lang_word": "get ready",
                                "target_lang_sense_clarification": "to prepare for departure or an activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7371a091-20e5-3a71-bc7c-a6cf5bfcfbfe",
                    "sense_definition": "Иметь намерение или быть готовым совершить какое-либо действие.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>собираюсь</w> встретиться с ним завтра утром.",
                            "target_lang_translations": {
                                "en": "I <w>intend</w> to meet him tomorrow morning."
                            }
                        },
                        {
                            "text": "Он <w>собирается</w> начать новую жизнь с понедельника.",
                            "target_lang_translations": {
                                "en": "He <w>plans</w> to start a new life on Monday."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have the intention or be prepared to perform an action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intend",
                                "target_lang_sense_clarification": "to have a plan or purpose to do something"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "to have the intention to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2456273f-be0e-3391-bbb0-2be0073ecd99",
                    "sense_definition": "Надвигаться, готовясь разразиться (обычно о природных явлениях).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На небе <w>собирается</w> гроза, нужно быстрее идти домой.",
                            "target_lang_translations": {
                                "en": "A storm is <w>gathering</w> in the sky; we need to go home quickly."
                            }
                        },
                        {
                            "text": "Весь день <w>собирался</w> дождь, но так и не пошел.",
                            "target_lang_translations": {
                                "en": "It looked like rain was <w>gathering</w> all day, but it never actually started."
                            }
                        }
                    ],
                    "common_phrases": [
                        "собирается дождь"
                    ],
                    "target_lang_definitions": {
                        "en": "To approach or build up, preparing to break out (usually referring to weather phenomena)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "to accumulate or build up, as in clouds or a storm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}