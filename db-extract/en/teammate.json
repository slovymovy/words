                        "target_lang_word": "coéquipier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coéquipier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                        "entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                                        "glosses": [
                                            "Celui qui est de la même équipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5460cc0-9c2b-4b49-b369-fe7ebd141d68",
                                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                                "text": "On remet à chaque coéquipier une partie seulement de l’information ou du matériel nécessaire pour effectuer une tâche."
                                            },
                                            {
                                                "example_id": "c0fd9633-b5cc-488d-bdf4-cf8ba6eb695b",
                                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                                "text": "C’est ce que m’ont conseillé Erwan Tabarly et Julien Pulvé, mes coéquipiers de la saison, explique-t-elle dans un communiqué."
                                            },
                                            {
                                                "example_id": "a238a382-e45b-4996-b532-9987e4605d95",
                                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                                "text": "Il compte trois sélections en équipe de Belgique, où il a notamment côtoyé son nouveau coéquipier Jérémy Doku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d02dc17-9e68-41a5-8ece-c786c840dcc3",
                        "source_entry_id": "59108b46-b45e-3f37-a0ba-2ddc7c5dce5e",
                        "source_sense_id": "974e6868-dbde-3bf4-b02b-fcfd49dce604",
                        "source_sense_description": "one who is on the same team",
                        "target_lang_word": "coéquipière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coéquipière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                        "entry_id": "beea8b70-6a61-3f0c-b0be-90bbcdad634a",
                                        "glosses": [
                                            "Celle qui est de la même équipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd20ea8-e2cf-4c9d-b9b5-d359b7d3ce6a",
                                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                                "text": "Il ne parvenait pas à accepter la réalité de la mort d’Agathe, la silhouette du tueur, le visage défiguré de sa coéquipière l’assaillaient…"
                                            },
                                            {
                                                "example_id": "51335229-3f7b-4777-970f-ee55f767276a",
                                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                                "text": "Elle avait été touchée à ce même genou lors de l’entraînement de veille de match, après un choc avec une coéquipière."
                                            },
                                            {
                                                "example_id": "c6367ac6-02a2-4da0-85d6-b57288a21d38",
                                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                                "text": "Sa coéquipière au PSG, Aminata Diallo, considérée par les enquêteurs comme la commanditaire des violences, a été mise en examen et placée sous contrôle judiciaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3f489d7-1912-4058-a4b5-9555a0b419fc",
                        "source_entry_id": "59108b46-b45e-3f37-a0ba-2ddc7c5dce5e",
