                "senses": [
                    {
                        "sense_id": "bf7fb0df-1392-3a95-a494-e0a8e2744751",
                        "entry_id": "a72058f9-04fd-3497-a650-bb9c5b42bdfb",
                        "glosses": [
                            "vrouw die journalist is"
                        ],
                        "tags": [
                            "beroep",
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "335cb629-0b32-4934-a4d5-c9b6773ede23",
                                "sense_id": "bf7fb0df-1392-3a95-a494-e0a8e2744751",
                                "text": "Een journalist of journaliste is een beroepsbeoefenaar die nieuwsfeiten verzamelt over recente gebeurtenissen van algemeen belang, die deze feiten onderzoekt of analyseert en daarover publiceert in een actueel (nieuws)medium."
                            },
                            {
                                "example_id": "c8f0bc8f-2f78-4bd4-9281-a64d50224834",
                                "sense_id": "bf7fb0df-1392-3a95-a494-e0a8e2744751",
                                "text": "Fluisterend vertelt ze dat ze de dokter het liefst om \"een spuitje\" had gevraagd. De journaliste naast haar bed schrikt en vraagt of er dan helemaal niets is waar ze de vrouw een plezier mee kan doen. \"Een mango\", antwoordt Coolen tot ieders verrassing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4737839a-0fde-498f-91b0-1f2bbd6f0f98",
                        "source_entry_id": "a72058f9-04fd-3497-a650-bb9c5b42bdfb",
                        "source_sense_id": "bf7fb0df-1392-3a95-a494-e0a8e2744751",
                        "target_lang_word": "female journalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d2b634d6-e023-4305-b870-521421ce25b7",
                        "source_entry_id": "a72058f9-04fd-3497-a650-bb9c5b42bdfb",
                        "source_sense_id": "bf7fb0df-1392-3a95-a494-e0a8e2744751",
                        "target_lang_word": "journalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e3ec57-cbb7-323d-a76b-9fc06b8be575",
                                        "entry_id": "abdaa706-943d-35bc-9a8c-31e5000def8d",
                                        "glosses": [
                                            "The keeper of a personal journal, who writes in it regularly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b4ff522-11ef-37f0-9ea8-c3b3be58d314",
                                        "entry_id": "abdaa706-943d-35bc-9a8c-31e5000def8d",
                                        "glosses": [
                                            "One whose occupation is journalism, originally only writing in the printed press."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c767b62-55a2-4dba-aa14-1230c95cbdf3",
                                                "sense_id": "6b4ff522-11ef-37f0-9ea8-c3b3be58d314",
                                                "text": "“There’s this terrible business to start with. Scotland Yard men in and out of the house like a jack-in-the-box! Never know where they won’t turn up next. Screaming headlines in every paper in the country—damn all journalists, I say!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ceacc2b-093d-3f74-9e4b-2d5fbf8d07e6",
                                        "entry_id": "abdaa706-943d-35bc-9a8c-31e5000def8d",
                                        "glosses": [
                                            "A reporter, someone who professionally reports on news and current events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef3624b-86a0-47a2-b7b6-3d6b7943b860",
                                                "sense_id": "8ceacc2b-093d-3f74-9e4b-2d5fbf8d07e6",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            },
                                            {
                                                "example_id": "444fff44-ed80-4a6a-ae7a-8a9c64988dd2",
                                                "sense_id": "8ceacc2b-093d-3f74-9e4b-2d5fbf8d07e6",
                                                "text": "A staff member of the Kuchar County Judiciary told RFA that he did not have the authority “to answer political questions of this magnitude,” when asked whether 150 people had died in No. 1 Camp, and whether the number included any government officials or other employees.\n“We have a county-wide directive—firstly, to never provide answers to pretend journalists, and secondly, to never take phone calls of unknown origin,” he said."
                                            },
                                            {
                                                "example_id": "b7c03b3a-8b3f-47b7-830c-c19b2962e942",
                                                "sense_id": "8ceacc2b-093d-3f74-9e4b-2d5fbf8d07e6",
                                                "text": "In 2017, Katherine Maher, then the CEO of the WMF, re-imagined the nonprofit’s mission as “top-down social justice activism and advocacy,” as journalist Ashley Rindsberg described it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
