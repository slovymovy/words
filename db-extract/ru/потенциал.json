                                        "entry_id": "f2c5c00d-c7cd-3171-a08e-19a47aacda1a",
                                        "glosses": [
                                            "Entwicklungsmöglichkeit, Gesamtheit der noch nicht ausgeschöpften Möglichkeiten, Mittel, Energie, Fähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e03798-efea-4855-bf3c-e9bd4381849e",
                                                "sense_id": "521866c3-3445-327a-bbc3-f1424af52e4a",
                                                "text": "Im Schwimmen hat er noch großes Potenzial."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd4883c8-23df-3425-a46c-9d7fe7a780cf",
                                        "entry_id": "f2c5c00d-c7cd-3171-a08e-19a47aacda1a",
                                        "glosses": [
                                            "Fähigkeit eines Kraftfelds, eine Arbeit zu verrichten, unabhängig von den beteiligten Körpern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095e7910-48da-4e44-b594-011eb3ce57fe",
                                                "sense_id": "dd4883c8-23df-3425-a46c-9d7fe7a780cf",
                                                "text": "Das durch eine Punktladung bewirkte elektrische Potenzial ist proportional zu 1/r."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2a177fa8-99ea-3879-b7c4-7c7214df796f",
                                        "entry_id": "f2c5c00d-c7cd-3171-a08e-19a47aacda1a",
