                            {
                                "example_id": "df50cf75-7bbc-4444-9041-2c909959e01a",
                                "sense_id": "1c42ff40-cd8d-3168-bfa3-89bac3ccf972",
                                "text": "Halinka ma już dość tego ciągłego niedowierzania w prawdziwość jej uczuć."
