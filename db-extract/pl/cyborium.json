                    {
                        "sense_id": "4ffddf00-e703-3e76-bdb8-1e162ead14c7",
                        "entry_id": "721088cc-cf09-3f2f-bbbf-6806b034af40",
                        "glosses": [
                            "puszka, naczynie do przechowywania hostii oraz komunikantów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae5dfa1-8fb2-454a-a4dc-a591fde8a693",
                                "sense_id": "4ffddf00-e703-3e76-bdb8-1e162ead14c7",
                                "text": "Neoprezbiter podarował rodzinnej parafii cyborium przywiezione z pielgrzymki do Lourdes."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7cb91375-367d-3fa4-a000-43a3c5a92fac",
                        "entry_id": "721088cc-cf09-3f2f-bbbf-6806b034af40",
                        "glosses": [
                            "niewielkie naczynie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd64f95-88ad-4e41-9d11-8a5db266cb02",
                                "sense_id": "7cb91375-367d-3fa4-a000-43a3c5a92fac",
                                "text": "Muzeum nabyło w zeszłym roku trzy cyboria z kości słoniowej pochodzące z wykopalisk pod Palmyrą."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2153f903-c4db-35ee-8150-586fc63b2db7",
                        "entry_id": "721088cc-cf09-3f2f-bbbf-6806b034af40",
                        "glosses": [
                            "obudowa ołtarza w kształcie baldachimu opartego na czterech kolumnach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cc42fc7-3904-486c-8e40-82337cf879a9",
                                "sense_id": "2153f903-c4db-35ee-8150-586fc63b2db7",
                                "text": "W jednym z medalionów zdobiących cyborium nad ołtarzem na Lateranie umieszczono obraz Chrystusa karmiącego owce ziarnem."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
