                                "sense_id": "8a8d4e6f-aee8-3244-934f-7dc333a0556e",
                                "text": "La dégauchisseuse est utilisée avant la raboteuse."
                            },
                            {
                                "example_id": "d4a6d8b7-fc5c-42c4-b224-77f214140a05",
                                "sense_id": "8a8d4e6f-aee8-3244-934f-7dc333a0556e",
                                "text": "Il tient à la main une planche de bois qu’il vient de passer à sa dégauchisseuse, une dégauchisseuse des années 1930 très bruyante qui faisait trembler tout le quartier."
                            }
                        ]
                    }
