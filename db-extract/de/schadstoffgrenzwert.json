                "senses": [
                    {
                        "sense_id": "a2600be8-5cd1-33f4-9514-6eaa8a065c84",
                        "entry_id": "9b582d7e-d800-37ea-8daf-e1099aec03df",
                        "glosses": [
                            "äußerster Wert für den Gehalt an Schadstoffen, der keinesfalls überschritten werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01688784-1469-4015-917f-b91b5f56573d",
                                "sense_id": "a2600be8-5cd1-33f4-9514-6eaa8a065c84",
                                "text": "„Bis zum Wochenende blieben die Verantwortlichen aber bei ihrer Behauptung, dass der zulässige Schadstoffgrenzwert dabei nicht überschritten wurde.“"
                            },
                            {
                                "example_id": "3e74b2bf-b7c6-4b32-9919-d2e134a42195",
                                "sense_id": "a2600be8-5cd1-33f4-9514-6eaa8a065c84",
                                "text": "„Eine gute Nachricht gibt es für alle Städte, die nur noch knapp über dem Schadstoffgrenzwert von 40 Mikrogramm Stickoxide pro Kubikmeter Luft liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
