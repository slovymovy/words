            {
                "entry_id": "1e52b10d-1277-34b4-9cad-898ff5592027",
                "word": "Demotic",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b244ca4-a59a-3921-b5e9-80ed09023340",
                        "entry_id": "1e52b10d-1277-34b4-9cad-898ff5592027",
                        "glosses": [
                            "The demotic Egyptian script, used from c. 650 BCE to 452 CE."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798eabd8-c895-45eb-93a8-c2209b25ad43",
                                "sense_id": "6b244ca4-a59a-3921-b5e9-80ed09023340",
                                "text": "Regarding the ranges of these palaeographic areas, the terms mentioned might again be misleading to a nonadept, who, for example, has to know that the Delta is mostly uncharted territory in regard to Demotic palaeography (due to the lack of sources from this area)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dd9151d-035a-325a-a361-c75e863a7323",
