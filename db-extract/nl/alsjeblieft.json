                                                "sense_id": "8f4908f0-b930-3475-8da5-f76628ec0629",
                                                "text": "\"Kann ich hereinkommen?\" Bitte. oder Bitte. Tritt doch herein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "aec0e66f-2e3f-3529-a5f1-4533664d713d",
                                        "entry_id": "5d125fe8-c482-302c-a76e-91fc5e9f4ff1",
                                        "glosses": [
                                            "der Wunsch nach Wiederholung von etwas bereits Gesagtem oder nicht richtig Verstandenem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d59019f-6b68-43c3-9af5-cbc78a12f03b",
                                                "sense_id": "aec0e66f-2e3f-3529-a5f1-4533664d713d",
                                                "text": "Wie (war das, was sie sagten), bitte?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6fd0292e-31fe-3bcc-a7c2-a7599837c05a",
                                        "entry_id": "5d125fe8-c482-302c-a76e-91fc5e9f4ff1",
                                        "glosses": [
                                            "eine mündliche Bestätigung von etwas Vorhersehbarem, Geahntem, Offensichtlichem"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3594b8-3c50-44d0-a6cc-bd5ffbab2655",
                                                "sense_id": "6fd0292e-31fe-3bcc-a7c2-a7599837c05a",
                                                "text": "Ja, bitte!. Jetzt ist es passiert."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
