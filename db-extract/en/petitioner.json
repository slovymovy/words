                        "glosses": [
                            "Someone who presents a petition to a court."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5470b593-cc3f-3b0c-aabd-709a7df556e8",
                        "entry_id": "6d4823c8-91f1-3e3f-a22e-69c1b3e29201",
                        "glosses": [
                            "Someone who presents a petition to some person in authority."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d60d32c-ab2e-410b-a9c2-604a181b0d64",
                                "sense_id": "5470b593-cc3f-3b0c-aabd-709a7df556e8",
                                "text": "Ethel was in mourning: they had judged it the most fitting habit for a petitioner; it was certainly one most becoming to the wearer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d7f7090-0ab7-4dc4-a064-d024b0e92ef8",
                        "source_entry_id": "6d4823c8-91f1-3e3f-a22e-69c1b3e29201",
                        "source_sense_description": "someone who presents a petition to a court",
                        "target_lang_word": "pétitionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétitionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dbe4268-aef6-3285-8eb0-aae8eb6da509",
                                        "entry_id": "7aeb7309-28cb-377a-a326-458f01a9808d",
                                        "glosses": [
                                            "Celui ou celle qui fait, qui présente une pétition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41267dca-47cf-4e77-b4da-1253c7b460ca",
                                                "sense_id": "8dbe4268-aef6-3285-8eb0-aae8eb6da509",
                                                "text": "Ces lettres, qui agaçaient particulièrement Marino, allaient l’une après l’autre au panier, et l’accueil fait aux pétitionnaires les plus audacieux n’était pas tendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f530ae13-909c-3f7d-9281-c08dc67e8092",
                                        "entry_id": "7aeb7309-28cb-377a-a326-458f01a9808d",
                                        "glosses": [
                                            "Celui ou celle qui fait, qui présente une demande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fe9b36-430d-452c-8d5b-d485cdac278f",
                                                "sense_id": "f530ae13-909c-3f7d-9281-c08dc67e8092",
                                                "text": "Il confère en effet au pétitionnaire la possibilité de faire évoluer son projet sans perdre le bénéfice des droits attachés à l’autorisation qui lui a été initialement délivrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65cc5352-fa40-4b17-b073-c8efa7f36c9a",
                        "source_entry_id": "6d4823c8-91f1-3e3f-a22e-69c1b3e29201",
                        "source_sense_description": "someone who presents a petition to a court",
                        "target_lang_word": "Petent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                        "entry_id": "55e3c178-0817-3dd8-ba8f-33070127dae3",
                                        "glosses": [
                                            "(männliche^☆) Person, die bei amtlichen Stellen eine Eingabe (= Petition) macht, einen Antrag stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537ad4ac-57f7-4064-81d8-f52c293c7776",
                                                "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                                "text": "Es gibt hin und wieder Petenten, die uns ständig mit ihren aussichtslosen Eingaben beschäftigen."
                                            },
                                            {
                                                "example_id": "04f3b8bf-ba71-4beb-8a0d-92751fd04616",
                                                "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                                "text": "„Der starke Mann im Weißen Haus, der seine humanitäre Einstellung einer religiösen Erziehung als Quäker verdankte, hatte ein Einsehen und gab dem Anliegen der Petenten statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
