                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                "text": "A dog with homophobia in its eyes ✨✨"
                            },
                            {
                                "example_id": "2b82e62b-661a-4f31-a163-e9f352a0c66b",
                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
