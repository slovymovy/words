                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9efa3144-53ac-4459-9188-44fe5170cbd8",
                        "source_entry_id": "42c36b16-7b85-36d9-9b5b-416aeca6a868",
