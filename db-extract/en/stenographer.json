                        "cross_references": [
                            {
                                "target_word": "Stenograf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                        "entry_id": "5e6e5d88-49fd-3831-9e5e-676dd6564331",
                                        "glosses": [
                                            "Person, die die Stenografie, die Kurzschrift beherrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53427f5c-12d5-40c6-998f-e4d2cd3512be",
                                                "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                                "text": "„Randbegebenheiten wie die des Stenografen Vinzenz Koppert illustrieren, wie aberwitzig der Sprung der Deutschen aus der Nazidiktatur ins demokratische Deutschland anmutet. Koppert hatte 1944 den Prozess gegen die Mitglieder des Widerstands protokolliert, mitsamt der Todesurteile. Vier Jahre später wurde er Chef-Stenograf im Parlamentarischen Rat – und protokollierte die Abschaffung der Todesstrafe.“"
                                            },
                                            {
                                                "example_id": "2808f3f7-4fa1-4483-8247-5f2bd1e5c0b1",
                                                "sense_id": "f97e4c46-da89-36da-8e67-e0b79f6c6522",
                                                "text": "„Ausgehend von der Zahl der in Statistiken erfassten Lehrgangsteilnehmer kann geschätzt werden, dass sich an der Wende zum 20. Jahrhundert etwa vier Millionen systemkundige Stenografen der Gabelsbergerschen Kurzschrift bedienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b5eb48b-4b42-458a-8842-d8c6da937e83",
                        "source_entry_id": "571e81be-8579-3944-9dd8-103b41d5e8db",
                        "source_sense_description": "someone skilled in the transcription of speech",
                        "target_lang_word": "Stenografin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stenografin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b774d0e4-f276-3426-b32e-18eee8ee72c9",
                                        "entry_id": "8e1bb5ca-0cff-36e2-a70f-7d0e81e2c93f",
                                        "glosses": [
                                            "weiblicher Stenograf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e81794-f045-4a98-a378-34157a64230e",
                                                "sense_id": "b774d0e4-f276-3426-b32e-18eee8ee72c9",
                                                "text": "„Zu meinem Erstaunen war ich mit dem Richter allein im Amtszimmer, weil es Freitag war und die Stenografin frei hatte.“"
                                            },
                                            {
                                                "example_id": "2587ec03-5c80-4aee-9641-5338e9d83e0a",
                                                "sense_id": "b774d0e4-f276-3426-b32e-18eee8ee72c9",
                                                "text": "„Der Syndikus wird entlassen und erhält von der Stenografin eine Kassenanweisung für seine Zeugengebühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
