                },
                {
                    "sense_id": "e9546051-c44c-3374-9dfc-2aab204792c8",
                    "sense_definition": "An advocate of realism; one who believes that matter and objects have real existence beyond our perception of them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The debate between the nominalist and the <w>realist</w> has shaped much of Western metaphysical thought."
                        },
                        {
                            "text": "Every <w>realist</w> argues that the external world exists independently of the human mind."
                        }
                    ],
                    "antonyms": [
                        "idealist"
                    ]
                },
                {
                    "sense_id": "eebffac6-7bec-3be4-a73d-10a89764e202",
                    "sense_definition": "An artist who seeks to portray everyday life accurately.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter was a dedicated <w>realist</w> who captured the harsh conditions of the working class."
                        },
                        {
                            "text": "Many critics consider him a <w>realist</w> because his novels depict society exactly as it is."
                        }
                    ]
                }
            ]
