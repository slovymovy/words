{
    "word_family": [
        "lopen",
        "voorlopen",
        "doorlopen",
        "meelopen",
        "hardlopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21a6c1d1-d704-30ac-8a20-320bfd041433",
                    "sense_definition": "een tijd aangeven die vroeger is dan de werkelijke tijd, meestal gezegd van een klok of horloge",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijdsaanduiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn horloge <w>loopt achter</w>, dus ik moet de tijd even aanpassen.",
                            "target_lang_translations": {
                                "en": "My watch <w>is slow</w>, so I need to adjust the time."
                            }
                        },
                        {
                            "text": "De stationsklok <w>liep achter</w>, waardoor we dachten dat we de trein nog konden halen.",
                            "target_lang_translations": {
                                "en": "The station clock <w>was running slow</w>, which made us think we could still catch the train."
                            }
                        }
                    ],
                    "antonyms": [
                        "voorlopen"
                    ],
                    "common_phrases": [
                        "vijf minuten achterlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To indicate a time that is earlier than the actual time, usually said of a clock or watch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run slow",
                                "target_lang_sense_clarification": "of a clock or watch"
                            },
                            {
                                "target_lang_word": "lose time",
                                "target_lang_sense_clarification": "to not keep accurate time"
                            },
                            {
                                "target_lang_word": "be slow",
                                "target_lang_sense_clarification": "showing an earlier time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b96a93c-de1c-3c58-8310-caeb4a768802",
                    "sense_definition": "minder ver gevorderd zijn dan anderen of dan de planning; een achterstand hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voortgang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de ziekte van de leraar <w>loopt</w> de klas nu <w>achter</w> op het schema.",
                            "target_lang_translations": {
                                "en": "Due to the teacher's illness, the class <w>is</w> now <w>behind</w> schedule."
                            }
                        },
                        {
                            "text": "We moeten harder werken omdat we met dit project flink <w>achterlopen</w>.",
                            "target_lang_translations": {
                                "en": "We have to work harder because we <w>are</w> significantly <w>behind</w> with this project."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterblijven"
                    ],
                    "antonyms": [
                        "voorlopen"
                    ],
                    "common_phrases": [
                        "op schema achterlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be less advanced than others or than planned; to have a backlog or be behind schedule."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be behind",
                                "target_lang_sense_clarification": "in progress or schedule"
                            },
                            {
                                "target_lang_word": "fall behind",
                                "target_lang_sense_clarification": "to lose pace with others"
                            },
                            {
                                "target_lang_word": "be lagging",
                                "target_lang_sense_clarification": "failing to keep up"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "922559b4-996f-3cf8-8ed0-306e4e956c21",
                    "sense_definition": "iets proberen te ontdekken of informatie over iets proberen te verkrijgen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onderzoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechercheur probeert de waarheid over de verdwijning <w>achter te lopen</w>.",
                            "target_lang_translations": {
                                "en": "The detective is trying to <w>find out</w> the truth about the disappearance."
                            }
                        },
                        {
                            "text": "Het is lastig om de precieze oorzaak van de storing <w>achter te lopen</w>.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>trace</w> the exact cause of the malfunction."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterhalen",
                        "uitzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "To try to discover something or to try to obtain information about something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find out",
                                "target_lang_sense_clarification": "to discover information"
                            },
                            {
                                "target_lang_word": "trace",
                                "target_lang_sense_clarification": "to find the origin or truth"
                            },
                            {
                                "target_lang_word": "ascertain",
                                "target_lang_sense_clarification": "to find out for certain"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}