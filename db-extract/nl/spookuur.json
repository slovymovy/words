                                ]
                            },
                            {
                                "target_word": "midnight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d796100a-211a-3186-80ab-6ba179f2ab1d",
                                        "entry_id": "8c109b6b-b05e-3b56-9d86-8608148ecdd9",
                                        "glosses": [
                                            "The middle of the night: the sixth temporal hour, equidistant between sunset and sunrise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb2844f-1c7f-4ed2-977b-4d9982f5a061",
                                                "sense_id": "d796100a-211a-3186-80ab-6ba179f2ab1d",
                                                "text": "Thanks to its sonar, the narwhal can remain active even at midnight, unhindered by the darkness."
                                            },
                                            {
                                                "example_id": "528e1a23-b5ac-498c-aca6-d6cc53714163",
                                                "sense_id": "d796100a-211a-3186-80ab-6ba179f2ab1d",
                                                "text": "And vpon the first day of the weeke, when the disciples came together to breake bread, Paul preached vnto them, ready to depart on the morrow, and continued his speach vntill midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c11585-3ec8-3fab-b47e-a3c0686b0638",
                                        "entry_id": "8c109b6b-b05e-3b56-9d86-8608148ecdd9",
                                        "glosses": [
                                            "Twelve o'clock at night exactly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "166166b5-6c23-4a07-901d-03ac659bab57",
                                                "sense_id": "10c11585-3ec8-3fab-b47e-a3c0686b0638",
                                                "text": "She twisted her hands behind her; but all the knots held good! / She writhed her hands till her fingers were wet with sweat or blood! / They stretched and strained in the darkness, and the hours crawled by like years, / Till, now, on the stroke of midnight, / Cold, on the stroke of midnight, / The tip of one finger touched it! The trigger at least was hers!"
                                            },
                                            {
                                                "example_id": "57399d25-97b8-45ca-90d9-a1ffac604b35",
                                                "sense_id": "10c11585-3ec8-3fab-b47e-a3c0686b0638",
                                                "text": "The police report said that officers, who told CNN they are not currently pursuing criminal charges, arrived to the scene just after midnight and found Gillum and a second person, Aldo Mejias, in the hotel room."
                                            }
                                        ]
                                    },
