            {
                "entry_id": "6dec141b-ec42-3be7-9e13-682a014c3083",
                "word": "Axel",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                        "entry_id": "6dec141b-ec42-3be7-9e13-682a014c3083",
                        "glosses": [
                            "Nom donné par la marque automobile Citroën à un modèle de petite berline importé de Roumanie de 1984 à 1988."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "80dacba9-ffe4-479c-9876-dbea10253d4a",
                                "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                                "text": "Puis, plus tard, sous l’aile protectrice du grand frère Peugeot qui s’est offert la marque en 1974, sortiront quelques ratés et avortons consanguins qui ont pour noms LN ou Axel et qu’il vaut mieux oublier."
                            },
                            {
                                "example_id": "7c880672-f348-42f1-8eed-0b321e6af43e",
                                "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                                "text": "Elle a surtout construit en Roumanie une usine de montage pour les Axel, des dérivées du prototype Y refusé par Peugeot en 1974."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
