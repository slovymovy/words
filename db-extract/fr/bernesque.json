                "senses": [
                    {
                        "sense_id": "c357403f-f563-332a-9a5a-4fdc9455c376",
                        "entry_id": "7c74e3f8-c4ca-3a4f-a146-121152172287",
                        "glosses": [
                            "Style similaire à celui de Francesco Berni."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f7eeb0-a81d-43f6-a7bb-6a216312d0c4",
                                "sense_id": "c357403f-f563-332a-9a5a-4fdc9455c376",
                                "text": "Proche du bernesque dans ses débuts - citons à titre d'exemple Le Cidre ou Le Cantal - et lié au style burlesque, le caprice continue à tendre à la parodie outrée qui s'apparente à la satire."
                            },
                            {
                                "example_id": "b66e482b-af3c-4159-8643-806d9cb9f34e",
                                "sense_id": "c357403f-f563-332a-9a5a-4fdc9455c376",
                                "text": "Et c'est à Rome que Francesco Berni, un jeune poète arrivé de Toscane en 1517 au service du cardinal Bibbiena ―[…]―, achèvera de perfectionner le genre, faisant durablement école dans la péninsule, où, jusqu'au XVIIIe siècle, nombre de poètes burlesques se targueront de composer à la bernesque."
                            }
                        ]
                    }
