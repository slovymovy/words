                                        "entry_id": "aa2e43dc-9d9c-3e3b-805b-f9cbcff1c0ae",
                                        "glosses": [
                                            "Ellipsis of modern pentathlon, a discipline with five events based on late-19th century basic military skills."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
