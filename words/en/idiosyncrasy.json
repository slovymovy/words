                        "system idiosyncrasy"
                    ]
                },
                {
                    "sense_id": "369c24da-5f4f-324e-85d9-9bd21e3b1c88",
                    "sense_definition": "An abnormal or peculiar physical reaction by an individual to a drug or chemical.",
