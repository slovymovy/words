                "forms": [],
                "senses": [
                    {
                        "sense_id": "da77860a-09ee-3ff3-a16e-a6b4b9a5ed06",
                        "entry_id": "1a95f575-8c47-3839-acb4-56555725b3c9",
                        "glosses": [
                            "op een kleinerende wijze spottend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8923e5-f666-4d58-92db-32cc2954929c",
                                "sense_id": "da77860a-09ee-3ff3-a16e-a6b4b9a5ed06",
                                "text": "Owens speelde in de jaren 80 schoonzoon Elvin in de hitserie. Alhoewel hij in de jaren daarna geregeld kleine gastrolletjes had in televisieseries, bleef het grote werk uit voor de inmiddels 57-jarige. Hij ging daardoor werken buiten de entertainmentindustrie, en werd afgelopen week door een klant gefotografeerd in de supermarkt waar hij een baan heeft. De foto kwam online te staan, waar veel mensen honend reageerden."
                            },
                            {
                                "example_id": "3713c642-9b0a-467d-beec-da37ac5ddd5f",
                                "sense_id": "da77860a-09ee-3ff3-a16e-a6b4b9a5ed06",
                                "text": "Het bezoek van Kanye West, ook wel bekend als Ye, aan het Witte Huis wordt hem in Hollywoodkringen niet in dank afgenomen. Verschillende sterren hebben honend gereageerd op de actie van de rapper, die een tien minuten durende speech hield in de Oval Office."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdac3b83-86cc-445b-9591-a747bd109aad",
                        "source_entry_id": "1a95f575-8c47-3839-acb4-56555725b3c9",
                        "source_sense_id": "da77860a-09ee-3ff3-a16e-a6b4b9a5ed06",
                        "source_sense_description": "spottend",
                        "target_lang_word": "disdainful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disdainful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                                        "entry_id": "003bb275-8222-36c8-8e43-1ee33706bbde",
                                        "glosses": [
                                            "Showing contempt or scorn; having a pronounced lack of concern for others viewed as unworthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6fcf04-7342-42d1-a9e1-93f211daf6cc",
                                                "sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                                                "text": "He was disdainful of those he thought of as the little people. He openly sneered at them. They mocked him behind his back."
                                            },
                                            {
                                                "example_id": "1e10a6ff-8b7e-4f70-87a4-243df1c7d3c7",
                                                "sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                                                "text": "She glimpsed at the people whom she had left behind, and smirked in the most disdainful manner towards them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7cccf47-d26c-4c12-b0c1-83d20ec27409",
                        "source_entry_id": "1a95f575-8c47-3839-acb4-56555725b3c9",
