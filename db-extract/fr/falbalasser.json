                        "glosses": [
                            "Garnir de falbalas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4f9061-a62d-449a-958d-fb658e53ac0e",
                                "sense_id": "633cb416-d42a-3cd7-8eaf-6c519e92af19",
                                "text": "Une robe bien falbalassée."
                            },
                            {
                                "example_id": "b4cfdf4b-d0bf-4e32-bbf5-8b25144602b2",
                                "sense_id": "633cb416-d42a-3cd7-8eaf-6c519e92af19",
                                "text": "Qu’étaient devenues les robes traînantes, les jupes falbalassées, les corsets de soie noire, tout ce factice qu’il adorait ?"
                            },
                            {
                                "example_id": "84fc2abe-0ae4-411d-a361-11345b612d23",
                                "sense_id": "633cb416-d42a-3cd7-8eaf-6c519e92af19",
                                "text": "Désormais elle s’habille en amazone et peste contre l’incommodité des jupes falbalassées dont la mode s’étend."
                            }
                        ]
                    }
