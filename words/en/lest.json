{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7db2f0cb-7bca-356a-aeff-da41b42375f8",
                    "sense_definition": "For fear that; in order to prevent something undesirable from happening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke in a gentle whisper, <w>lest</w> she wake the sleeping infant.",
                            "target_lang_translations": {
                                "ru": "Она говорила тихим шепотом, <w>чтобы не</w> разбудить спящего младенца."
                            }
                        },
                        {
                            "text": "Take careful notes during the meeting <w>lest</w> we forget any crucial details.",
                            "target_lang_translations": {
                                "ru": "Делайте подробные записи во время встречи, <w>иначе</w> мы можем забыть важные детали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lest we forget"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Из опасения, что; чтобы не допустить чего-либо нежелательного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чтобы не",
                                "target_lang_sense_clarification": "с целью предотвратить нежелательное действие"
                            },
                            {
                                "target_lang_word": "как бы не",
                                "target_lang_sense_clarification": "из опасения нежелательного исхода"
                            },
                            {
                                "target_lang_word": "иначе",
                                "target_lang_sense_clarification": "в противном случае"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaf77f4b-52ce-3ca6-8730-ef1881ba2773",
                    "sense_definition": "That, used to introduce the cause or object of fear, apprehension, or anxiety.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was seized with dread <w>lest</w> his troops should be surrounded.",
                            "target_lang_translations": {
                                "ru": "Генерала охватил ужас, <w>как бы</w> его войска не оказались в окружении."
                            }
                        },
                        {
                            "text": "She was deeply anxious <w>lest</w> the secret of their escape become known.",
                            "target_lang_translations": {
                                "ru": "Она сильно тревожилась, <w>как бы</w> тайна их побега не раскрылась."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "chiefly archaic or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Присоединяет придаточное предложение, указывающее на объект или причину страха, опасения или тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как бы не",
                                "target_lang_sense_clarification": "после выражений страха или беспокойства"
                            },
                            {
                                "target_lang_word": "чтобы не",
                                "target_lang_sense_clarification": "выражает предмет тревоги или страха"
                            },
                            {
                                "target_lang_word": "что",
                                "target_lang_sense_clarification": "при выражении тревоги или опасения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}