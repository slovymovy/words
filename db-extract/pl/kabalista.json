                    {
                        "translation_id": "846df0f6-63d2-47c3-8974-f48733fe10dc",
                        "source_entry_id": "acc592c7-0fbf-3e9f-add8-c13a080dbf1b",
                        "source_sense_id": "63dec3ad-b014-3726-816a-910167f0a0fe",
                        "target_lang_word": "каббалист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "каббалист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8c12ff-5223-3ec2-84f3-71edef565b90",
                                        "entry_id": "047af8c1-7aeb-3db0-8c18-2a1b48d4d70b",
                                        "glosses": [
                                            "приверженец каббалы — средневекового религиозно-мистическое учения, получившее особое распространение в иудаизме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea35692c-2c67-452f-95eb-a748c325645e",
                                                "sense_id": "ad8c12ff-5223-3ec2-84f3-71edef565b90",
                                                "text": "Каббалисты хвалились древними преданиями, будто бы дошедшими до них от Моисея; многие уверяли даже, что имеют книгу, полученную Адамом от Бога, и главный источник Соломоновой мудрости; что они знают все тайны природы, могут изъяснить сновидения, угадывать будущее, повелевать духами; что сею наукою Моисей восторжествовал над египетскими волхвами, Илия повелевал огнём небесным, Даниил смыкал челюсти львам; что Ветхий Завет исполнен хитрых иносказаний, объясняемых кабалою; что она творит чудеса посредством некоторых слов Библии, и проч."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0223fb81-d3ff-3841-92ab-ab0412e90836",
                                        "entry_id": "047af8c1-7aeb-3db0-8c18-2a1b48d4d70b",
                                        "glosses": [
                                            "перен. тот, кто толкует сокровенное значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afa3b5d-35be-45fa-a1f2-6a9a55c2a162",
                                                "sense_id": "0223fb81-d3ff-3841-92ab-ab0412e90836",
                                                "text": "Что до меня, почтенный Маликульмульк, то я мог бы утвердительно сказать, что иудейская каббалистика пред всеми другими науками имеет преимущество. Но в нынешнем свете почти нет ни одного человека, который не был бы каббалистом в суждении о своём ближнем. Ныне почти каждый, располагая по собственному своему пристрастию, о всяком делает утвердительные решения, и хотя дела его и поступки совершенно ему неизвестны, однако ж он всех уверяет, что говорит самую истину."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
