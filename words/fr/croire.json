    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f7547f7-8d74-3f3e-bfe1-62d5c458184f",
                    "sense_definition": "Penser, estimer ou juger quelque chose probable ou vrai sans certitude absolue.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>crois</w> qu'il va pleuvoir cet après-midi car le ciel devient très sombre."
                        },
                        {
                            "text": "Nous <w>croyons</w> que cette solution est la plus adaptée à notre situation."
                        }
                    ],
                    "synonyms": [
                        "penser",
                        "estimer",
                        "juger"
                    ],
                    "antonyms": [
                        "savoir",
                        "douter"
                    ],
                    "common_phrases": [
                        "croire savoir",
                        "croire comprendre",
                        "laisser croire"
                    ]
                },
                {
                    "sense_id": "0f7b8956-2079-348c-b2bb-069db26988b2",
                    "sense_definition": "Tenir pour véridiques les propos, les affirmations ou les explications de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "confiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux lui faire confiance et le <w>croire</w> sur parole sans hésiter."
                        },
                        {
                            "text": "Mes amis ne voulaient pas me <w>croire</w> quand j'ai raconté cette mésaventure."
                        }
                    ],
                    "synonyms": [
                        "ajouter foi"
                    ],
                    "antonyms": [
                        "contester",
                        "démentir"
                    ],
                    "common_phrases": [
                        "croire sur parole",
                        "en croire ses yeux"
                    ]
                },
                {
                    "sense_id": "92d65e8b-4f7d-3022-8375-93b123393034",
                    "sense_definition": "Avoir la foi, être persuadé de l'existence de quelque chose ou accorder sa confiance totale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "foi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les nombreuses difficultés, elle continue de <w>croire</w> en ses rêves."
                        },
                        {
                            "text": "Il n'a jamais voulu <w>croire</w> aux fantômes ou aux légendes locales."
                        }
                    ],
                    "synonyms": [
                        "se fier"
                    ],
                    "antonyms": [
                        "renier"
                    ],
                    "common_phrases": [
                        "croire en Dieu",
                        "croire en soi"
                    ]
                },
                {
                    "sense_id": "d9fc57a2-fbc4-37c1-99be-545f316f0b1a",
                    "sense_definition": "Se considérer comme étant d'une certaine façon, ou s'imaginer dans une situation donnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception_de_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a gagné cette course, il se <w>croit</w> invincible et supérieur à tous."
                        },
                        {
                            "text": "Avec ce beau temps ensoleillé, on se <w>croirait</w> au milieu du mois de juillet."
                        }
                    ],
                    "synonyms": [
                        "se juger",
                        "se prétendre"
                    ],
                    "common_phrases": [
                        "se croire tout permis",
                        "se croire malin"
                    ]
                },
                {
                    "sense_id": "cd23c852-66c8-3ca8-981b-fba03b8a78d7",
                    "sense_definition": "Faire preuve d'une naïveté excessive en s'illusionnant sur ce qui est permis ou possible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a trop <w>cru</w> que j'allais nettoyer tout le salon à sa place."
                        },
                        {
                            "text": "Tu as vraiment <w>cru</w> pouvoir entrer dans cette salle sans aucune invitation ?"
                        }
                    ],
                    "synonyms": [
                        "s'illusionner",
                        "rêver"
                    ],
                    "common_phrases": [
                        "avoir trop cru"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier, souvent employé ironiquement"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "132d41f4-8827-39ae-b124-57e0c3907124",
                    "sense_definition": "Fait d'accorder sa croyance ou son adhésion, en particulier dans le domaine spirituel ou philosophique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre analyse l'évolution du <w>croire</w> dans une société de plus en plus sécularisée."
                        },
                        {
                            "text": "Le philosophe interroge la nature même du <w>croire</w> face aux exigences de la rationalité scientifique."
                        }
                    ],
                    "synonyms": [
                        "croyance",
                        "foi"
                    ],
                    "antonyms": [
                        "incroyance"
                    ]
                }
            ]
        }
    ]
