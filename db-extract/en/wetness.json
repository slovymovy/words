                                        "sense_id": "a8822b4c-463e-3f75-bb78-b2b78b6f4f91",
                                        "entry_id": "86f5612b-1168-30ff-8e2c-d0fffda1623a",
                                        "glosses": [
                                            "nasse Beschaffenheit (der Umgebung), starke Feuchtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5420d9-222c-4ae2-bbb3-7b720b95e0e2",
                                                "sense_id": "a8822b4c-463e-3f75-bb78-b2b78b6f4f91",
                                                "text": "Bei Nässe ist hier Vorsicht geboten."
                                            },
                                            {
                                                "example_id": "0b060f95-acc8-43fa-b9df-faab116ff709",
                                                "sense_id": "a8822b4c-463e-3f75-bb78-b2b78b6f4f91",
                                                "text": "„Einmal hat sie zwei Tage lang im Moor gegraben, weil sie herausfinden wollte, wie weit die Nässe in den Boden reicht und wie sich die Farbe des Erdreichs mit zunehmender Tiefe ändert!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4238a0b8-d5cb-4dba-bdbf-9956d14bfe42",
