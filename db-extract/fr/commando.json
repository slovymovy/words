        "fr-extract.jsonl": [
            {
                "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                "word": "commando",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eac57e8a-a1d6-42b6-876c-12ada293baab",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "tags": [
                            "plural"
                        ],
                        "form": "commandos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3111d429-846e-3f10-96c4-db0d7e361bf7",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Unité spéciale entraînée pour exécuter des missions dangereuses sur des objectifs déterminés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81e7b61-a0d8-4c28-bf3a-37d9730fa158",
                                "sense_id": "3111d429-846e-3f10-96c4-db0d7e361bf7",
                                "text": "Les commandos marine ont été créés durant la dernière guerre mondiale en Grande-Bretagne, sur le modèle des Royal Marines Commandos ou forces spéciales de la Royal Navy à partir d’éléments des fusiliers marins français regroupés au Royaume-Uni."
                            }
                        ]
                    },
                    {
                        "sense_id": "85807924-e2a3-342b-b5ac-af8bb2c8fd1c",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Groupe de combat employé pour les opérations rapides, isolées ou spéciales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270b2f0d-f5b4-4dbe-8ac0-eaec64efb899",
                                "sense_id": "85807924-e2a3-342b-b5ac-af8bb2c8fd1c",
                                "text": "Commando de parachutistes, de terroristes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e34ccbf5-df97-33cc-a821-fc0651a19ccf",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Soldat de ces forces spéciales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ad4f33-cb54-4c5d-8df4-5ec72afef05d",
                                "sense_id": "e34ccbf5-df97-33cc-a821-fc0651a19ccf",
                                "text": "En octobre 2007, une équipe de France 24 a suivi des commandos de montagne du contingent français qui aident l’armée afghane à combattre les talibans."
                            },
                            {
                                "example_id": "a3ca81e9-b263-4da7-aaf1-b23692c1208a",
                                "sense_id": "e34ccbf5-df97-33cc-a821-fc0651a19ccf",
                                "text": "Avec un mécanicien nous sortons à quelques mètres des hélicos, un genou à terre, pointant nos armes vers les lisières et attendons les commandos qui doivent sortir de leur planque avec les personnels de l'ambassade."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9a31004-2876-3407-8011-782c961f0a5b",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Groupe militant menant une action musclée."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "79d2c657-6065-43d1-b08a-695cfa70adfa",
                                "sense_id": "d9a31004-2876-3407-8011-782c961f0a5b",
                                "text": "Le commando était composé d’une vingtaine d’agriculteurs : huit d’entre eux s’installèrent à l’arrière de leurs pick-up, braquant leurs armes sur les automobilistes […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "afdede71-9072-3157-88ff-e962c2bd085e",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Attaque rapide et coordonnée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1b7b0d60-d339-4a1c-99e0-df48a59ef322",
                                "sense_id": "afdede71-9072-3157-88ff-e962c2bd085e",
                                "text": "Il s’agit d’une organisation activiste, qui multiplie les opérations spectaculaires : commandos contre des fast-food halals, « apéros saucisson-pinard », ou manifestations musclées."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e0fa795-a297-3148-b55d-b80fe266bccf",
                        "entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "glosses": [
                            "Groupe de combattants volontaires durant les guerres des Boers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68e2b71-03d8-4b62-b671-3e735f3ecdb1",
                                "sense_id": "9e0fa795-a297-3148-b55d-b80fe266bccf",
                                "text": "Le chef des abaQulusi, Sikhobobo Sibiya, mena donc son impi aux côtés de celui de Ndabuko, un oncle de Dinizulu. Encadrés par une colonne de soldats britanniques, ils menèrent des attaques contre les commandos boers et capturèrent un nombre important de têtes de bétail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f5527cb-7dd5-4497-83b1-57fc123365f7",
                        "source_entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "target_lang_word": "Kommando",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommando",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                                        "entry_id": "1526d688-cd08-317a-bc02-b57a95149b80",
                                        "glosses": [
                                            "Befehlsgewalt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7738300-554a-424d-9704-2e93fde96ab1",
                                                "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                                                "text": "Wer hat hier das Kommando?"
                                            },
                                            {
                                                "example_id": "f82288ff-44a0-456f-a325-81396122e1d5",
                                                "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                                                "text": "„Jetzt, im August 1572, stehen die weißen Soldaten unter dem Kommando von Francisco Barreto, eines Generals der königlichen Galeeren und früheren Gouverneurs von Portugiesisch-Indien, vor der ersten Schlacht ihres Feldzugs.“"
                                            },
                                            {
                                                "example_id": "3c705b43-7e46-4911-bd6e-65c12d6cdd5f",
                                                "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                                                "text": "„Beim ersten Anti-Terror-Einsatz unter seinem Kommando war der neue Präsident nicht etwa im Situation Room.“"
                                            },
                                            {
                                                "example_id": "bfc21d4d-f9c3-4a7c-acaa-dad2e5186832",
                                                "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                                                "text": "„Der König betraut ihn mit dem Kommando über sämtliche Streitkräfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5da96cd2-1801-3806-a22e-914cf6de8898",
                                        "entry_id": "1526d688-cd08-317a-bc02-b57a95149b80",
                                        "glosses": [
                                            "kleine Gruppe von (speziell ausgebildeten) Soldaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390faa6b-8584-419f-b8fa-3438f0c7c1ba",
                                                "sense_id": "5da96cd2-1801-3806-a22e-914cf6de8898",
                                                "text": "Dieses Kommando hier wird die geheime Operation durchführen."
                                            },
                                            {
                                                "example_id": "05b1d5bf-d2d0-487d-b6ef-e9343097b86c",
                                                "sense_id": "5da96cd2-1801-3806-a22e-914cf6de8898",
                                                "text": "„Schließlich befehligte er Kommandos, um gegen Kpe oder Abo den deutschen Herrschaftsanspruch durchzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "55f2bcb3-606c-356b-9d0d-e1c72e825fa8",
                                        "entry_id": "1526d688-cd08-317a-bc02-b57a95149b80",
                                        "glosses": [
                                            "Befehl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c3b984-5239-4e96-8e71-b5c40b3c559e",
                                                "sense_id": "55f2bcb3-606c-356b-9d0d-e1c72e825fa8",
                                                "text": "Der Schiedsrichter gibt das Kommando zum Starten."
                                            },
                                            {
                                                "example_id": "efe1e974-a72d-4367-bfbf-19b450d32bf4",
                                                "sense_id": "55f2bcb3-606c-356b-9d0d-e1c72e825fa8",
                                                "text": "„Alle sahen auf den Feind und auf den Schwadronchef, von dem sie ein Kommando erwarteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8b76bee5-5ac7-3335-a184-47d598609e4c",
                                        "entry_id": "1526d688-cd08-317a-bc02-b57a95149b80",
                                        "glosses": [
                                            "Befehl",
                                            "Anweisung zur Programmausführung"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "b6d0122e-f34c-30b9-9405-436cc792a10c",
                                        "entry_id": "1526d688-cd08-317a-bc02-b57a95149b80",
                                        "glosses": [
                                            "Dienststelle ab Brigadeebene, die nachgeordnete Truppen führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03e955e-ad13-45ce-abc4-1f6d2f4bbf5a",
                                                "sense_id": "b6d0122e-f34c-30b9-9405-436cc792a10c",
                                                "text": "Dieses Kommando ist die höchste Dienststelle der Armee."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f7fbc19-8304-4a15-b278-d6acced24553",
                        "source_entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "target_lang_word": "commando",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commando",
