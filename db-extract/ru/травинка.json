                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                        "entry_id": "d78a4f27-dd8a-3367-84a9-617398a7003d",
                        "glosses": [
                            "стебелёк, побег травы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b049d3d-cce6-4099-8b8e-1b970e6c7a1b",
                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                "text": "Несколько травинок, муравей, ползущий с одной из них вниз головою, какие-то кусочки сора от прошлогодней травы — вот весь мой мир."
                            },
                            {
                                "example_id": "8a8896eb-7769-4430-aa75-0747f3a11611",
                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                "text": "Молча шёл он впереди, покусывая сорванную травинку〈…〉"
                            },
                            {
                                "example_id": "3574aa06-512f-442a-9ebf-58a386547e1a",
                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                "text": "Петя с длинною клюкою и сумочкой за плечами шёл впереди. Хватая на бегу травинки, за ним толклись овцы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "953258c1-10dc-4074-9998-5285dfa003ce",
                        "source_entry_id": "d78a4f27-dd8a-3367-84a9-617398a7003d",
                        "source_sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                        "target_lang_word": "blade of grass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blade of grass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44f05978-9680-3424-9885-08f821bab86d",
                                        "entry_id": "d00029b7-8512-34e0-99db-adee83b5e08f",
                                        "glosses": [
                                            "A single long, narrow leaf of a plant described by the mass noun grass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20de3c79-549f-3ce3-9d68-9ab0801f082c",
                                        "entry_id": "d00029b7-8512-34e0-99db-adee83b5e08f",
                                        "glosses": [
                                            "A very small amount of something."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00131cc-a296-43aa-8c9c-df076eef9e0b",
                                                "sense_id": "20de3c79-549f-3ce3-9d68-9ab0801f082c",
                                                "text": "\"By the time I had walked much of the route of the Dartmoor Line with Christian, Matt and other Devon council staff, we knew what we wanted to achieve and the date we wanted to reopen the railway. There was not a blade of grass between us,\" says Davis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91bb4449-78d7-4de6-88de-3471ecbbb191",
                        "source_entry_id": "d78a4f27-dd8a-3367-84a9-617398a7003d",
                        "source_sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                        "target_lang_word": "Grashalm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grashalm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                                        "entry_id": "f67cd30d-cc85-3757-8fb1-9bcaae6e3b4b",
                                        "glosses": [
                                            "Halm von Gras"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cada411b-e8f1-4eca-ba7b-48d925b1e5f5",
                                                "sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                                                "text": "„Tausend Tautropfen glitzerten auf den Grashalmen.“"
                                            },
                                            {
                                                "example_id": "304ba298-e09d-492b-a924-8e80a01d778e",
                                                "sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                                                "text": "„Der andere kaute auf einem Grashalm und verbeugte sich leicht.“"
                                            },
                                            {
                                                "example_id": "b65f8018-ac12-409f-a18d-39e1e4f853cc",
                                                "sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                                                "text": "„Während ich noch ein paar Grashalme zwischen den Grabsteinen ausrupfte, war Bertram schon weiter, Richtung Leichenhalle.“"
                                            },
                                            {
                                                "example_id": "a89b81a4-bab8-449d-bcc1-541b289f87cf",
                                                "sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                                                "text": "„Er rupft einen Grashalm aus, preist ihn als Wunder der Schöpfung und steckt ihn in den Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
