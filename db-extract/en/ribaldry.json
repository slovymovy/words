                                        "sense_id": "157766ca-4ff9-372c-9cfd-f7344d0f7fbd",
                                        "entry_id": "e3f3c839-37e3-3b24-b7a8-200b537fd6bb",
                                        "glosses": [
                                            "Action de ribaud, divertissement licencieux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d399e9c9-1410-471e-9d9e-8cfb7233a57f",
                                                "sense_id": "157766ca-4ff9-372c-9cfd-f7344d0f7fbd",
                                                "text": "Il a donné dans toutes sortes de ribauderies."
                                            },
                                            {
                                                "example_id": "4d0ab8d6-6e09-4640-947d-60233406db0b",
                                                "sense_id": "157766ca-4ff9-372c-9cfd-f7344d0f7fbd",
                                                "text": "Elle semblait disposer d’un grand ascendant à la fois sur ses consœurs en ribauderie et les habitués du Marguerites des marins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de6c647a-0932-4e25-91d1-9ab0c2970c8b",
                        "source_entry_id": "8050eb49-0a0d-3dcf-8b61-9193b9542031",
                        "source_sense_id": "5bd85ef0-3331-3035-9a42-6a4b57d61a53",
                        "source_sense_description": "humorous language or behaviour",
                        "target_lang_word": "Possenspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Possenspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13cd6714-77c5-3667-969b-66933ea4c98c",
                                        "entry_id": "4ac27239-cf15-34ce-a305-d9f66bdb5271",
                                        "glosses": [
                                            "durch derbe Komik sich hervorhebendes Bühnenspiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898c8d4a-7114-41b6-aba1-46b84923bc75",
                                                "sense_id": "13cd6714-77c5-3667-969b-66933ea4c98c",
                                                "text": "Die beiden machten daraus ein herrlich anzusehendes Possenspiel."
                                            },
                                            {
                                                "example_id": "ea447dbf-588e-4c40-9d3b-ec3b5ab10d36",
                                                "sense_id": "13cd6714-77c5-3667-969b-66933ea4c98c",
                                                "text": "„Ich verabschiedete mich vom Grafen, von der Contessa und vom Marchese, die mir für das hübsche Possenspiel dankten, das ich ihnen verschafft hatte; dann legte ich mich zu Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc43f1ff-8199-467b-97aa-f0947c662106",
                        "source_entry_id": "8050eb49-0a0d-3dcf-8b61-9193b9542031",
                        "source_sense_id": "5bd85ef0-3331-3035-9a42-6a4b57d61a53",
                        "source_sense_description": "humorous language or behaviour",
                        "target_lang_word": "Zote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                        "entry_id": "15aa4701-5764-3ad8-b507-2c01d95abb0a",
                                        "glosses": [
                                            "derber, obszöner Witz, der als gegen den guten Geschmack verstoßend empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ed33bb-fd9a-4723-8927-bee0b1986a9a",
                                                "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                                "text": "Bei dem Grillabend gab er etliche Zoten zum Besten."
                                            },
                                            {
                                                "example_id": "fb7a944b-f515-431f-a4cc-2c1e175154c4",
                                                "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                                "text": "„Die Zote ist daneben auch noch die Begleiterin der pubertären Nöte.“"
                                            },
                                            {
                                                "example_id": "72bfd028-5dd0-4c51-aed5-265756c279d4",
                                                "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                                "text": "„Auf dieser primitiven, unverblümten Stufe aber bleibe sie immer nur eine Zote.“"
                                            },
                                            {
                                                "example_id": "f18e29ac-ef10-469f-92ee-0bc9fde89aba",
                                                "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                                "text": "„Der Junge beteiligte sich nie an den Zoten seiner Altersgenossen, und wenn er liebte, beobachtete er sich wie ein Arzt den Patienten, auch lehnte er ab, zu den Huren zu gehen, denn ihm war bei einem ersten Versuch unwohl gewesen dabei.“"
                                            },
                                            {
                                                "example_id": "f2a17461-53a4-4131-94a4-ccf94c05b418",
                                                "sense_id": "5d094285-b809-3c3b-9752-479f0fea14ef",
                                                "text": "„Da er nicht bigott sein wollte, war er anstößig; um seine Zuhörer zum Lachen zu bringen, erzählte er die unflätigsten Zoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
