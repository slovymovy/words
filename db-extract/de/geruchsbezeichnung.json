                "senses": [
                    {
                        "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                        "entry_id": "2f30ea55-ed73-3121-b0e2-35b50bceae24",
                        "glosses": [
                            "Name für etwas, das einen markanten, wiedererkennbaren Geruch abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a97c9312-33aa-4800-b2c6-90b57936a110",
                                "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                                "text": "„Als Beispiel sei das bereits bekannte Substantiv Akkord genannt, das primär dem auditiven Bereich entstammt und nur mittels eines intellektuellen Umwegs als Geruchsbezeichnung des Parfumjargons identifiziert werden kann.“"
                            },
                            {
                                "example_id": "805fc4d7-e68f-4532-9091-1cb0de67526c",
                                "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                                "text": "„Durch Kratzen wird der jeweilige Duft freigesetzt und muss anhand von vier Geruchsbezeichnungen identifiziert werden (4).“"
                            },
                            {
                                "example_id": "596d5dd5-f550-48d2-b0ee-d555c26db5a0",
                                "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                                "text": "„Es ist warm hier und riecht nach… da habe ich länger drüber nachgedacht… erst hätte ich gesagt nach „Denken“, aber diese Geruchsbezeichnung ist leider in meinem Bekanntenkreis nur unwesentlich positiv behaftet.“"
                            },
                            {
                                "example_id": "df8d3346-4d0c-4ae8-9efd-a1e3ffdc74a0",
                                "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                                "text": "„Die Benotung der Antworten erfolgt bei Nestlé nach einem Punktesystem, in der DIN gibt es einen Formularvordruck, auf dem die Kandidaten die Geruchsbezeichnungen, welche von ihnen erkannt werden, zuordnen sollen.“"
                            },
                            {
                                "example_id": "41b1a55b-5554-4fd9-9a1a-14f8643cc4bf",
                                "sense_id": "b3df12a0-9d2c-313b-86f9-e82db641a33d",
                                "text": "„Die oberdeutsche \"Saaltochter\" etwa ist selbst im Ursprungsland Schweiz zur Sprachrarität geworden, so wie \"Crayon\" als Synonym für Bleistift oder der \"Pfingstmaien\" als Geruchsbezeichnung eines Birkenharzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
