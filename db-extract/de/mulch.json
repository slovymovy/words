                "senses": [
                    {
                        "sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                        "entry_id": "c79d2c7d-560b-3790-85ca-fd9c76b52ed9",
                        "glosses": [
                            "Bodenbedeckung aus zerkleinerten Pflanzenteilen"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "4c876214-1c2a-4ce2-9e7b-7c8684aca4e6",
                                "sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                                "text": "Die Bedeckung des Bodens mit Mulch führt zu besserem Wachstum der Pflanzen und unterdrückt Unkräuter."
                            },
                            {
                                "example_id": "38966a8a-2dce-49ab-891d-c9f8724bf63b",
                                "sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                                "text": "„Mulch schützt den Boden vor Austrocknung und Frost.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "746db6f4-994b-461a-a2c3-34b97eeaac06",
                        "source_entry_id": "c79d2c7d-560b-3790-85ca-fd9c76b52ed9",
                        "source_sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                        "source_sense_description": "Gartenbau: Bodenbedeckung aus zerkleinerten Pflanzenteilen",
                        "target_lang_word": "mulch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mulch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "138c529f-8b7d-381c-9b46-e32cc96d7798",
                                        "entry_id": "30b6f722-307c-390d-b1eb-bd3e382f5942",
                                        "glosses": [
                                            "Any material used to cover the top layer of soil to protect, insulate, or decorate it, or to discourage weeds or retain moisture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bb38676-05d0-47bf-8ee1-072ae5cd943e",
                                                "sense_id": "138c529f-8b7d-381c-9b46-e32cc96d7798",
                                                "text": "An organic mulch is a mulch made of natural substances such as leaves or grass clippings."
                                            },
                                            {
                                                "example_id": "2ca278bb-ed0f-4bfa-9ded-d0bdb26ba1c2",
                                                "sense_id": "138c529f-8b7d-381c-9b46-e32cc96d7798",
                                                "text": "An interim report by investigators from the Rail Accident Investigation Branch found extensive evidence of crushed leaf mulch on the railhead at many sites on the approach to Salisbury Tunnel Junction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mulch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c590ab81-4586-3e85-8272-cc3045c3de9e",
                                        "entry_id": "eda0e2df-9398-3e42-8fcd-7de8479245e2",
                                        "glosses": [
                                            "To apply mulch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3149db53-d405-41e1-90b0-080e5b9d93d0",
                                                "sense_id": "c590ab81-4586-3e85-8272-cc3045c3de9e",
                                                "text": "Mulch your vegetable garden to retain moisture and keep weeds down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dee9d0e-15b0-3381-aaff-f3c45d6b206f",
                                        "entry_id": "eda0e2df-9398-3e42-8fcd-7de8479245e2",
                                        "glosses": [
                                            "To turn into mulch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1129845-2010-4b3f-97be-9b0362ba9a7c",
                                                "sense_id": "4dee9d0e-15b0-3381-aaff-f3c45d6b206f",
                                                "text": "I decided to mulch the grass clippings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a0c4c4a-fa12-4273-93d7-53984eb26814",
                        "source_entry_id": "c79d2c7d-560b-3790-85ca-fd9c76b52ed9",
                        "source_sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                        "source_sense_description": "Gartenbau: Bodenbedeckung aus zerkleinerten Pflanzenteilen",
                        "target_lang_word": "paillis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paillis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6600fcac-ea7e-3e79-80b7-dee2294ba870",
                                        "entry_id": "c09f5f4c-ea4d-3172-9613-473d2950f5c7",
                                        "glosses": [
                                            "Matériau qui, épandu à la surface du sol, conserve l’humidité et limite l’érosion ainsi que le développement des espèces végétales concurrentes. Il peut être organique, naturel (feuilles, écorce et sciure de bois, paille, résidus d’exploitation… broyés) ou synthétique (plastique), rarement minéral (laine de verre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0887c89-dc25-4dbf-afd5-f235042a9fba",
                                                "sense_id": "6600fcac-ea7e-3e79-80b7-dee2294ba870",
                                                "text": "La couverture de terreau, de paillis, de débris végétaux, […], dont les maraîchers et les jardiniers ont coutume de revêtir le sol du printemps à l’automne, a pour objet: […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd68d86-c254-31f4-a5a7-8e416d6e9c58",
                                        "entry_id": "c09f5f4c-ea4d-3172-9613-473d2950f5c7",
                                        "glosses": [
                                            "Matériau à base de paille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df665a74-f22c-4074-a778-02fc37a418f0",
                                                "sense_id": "9dd68d86-c254-31f4-a5a7-8e416d6e9c58",
                                                "text": "Bien comptées, une soixantaine de maisons, […], coiffées d’un capricieux toit dont le faîtage déborde les murs de pisé, la façade vers le jardin, un grenier à lucarne pour étage, une grange délabrée pour annexe, une étable toute de guingois, couverte en paillis, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b8fcd60-620c-4aad-8e1e-ce2cbed3da5a",
                        "source_entry_id": "c79d2c7d-560b-3790-85ca-fd9c76b52ed9",
                        "source_sense_id": "fa4c7acb-37f0-3cbc-aa59-0eebe85d9c05",
                        "source_sense_description": "Gartenbau: Bodenbedeckung aus zerkleinerten Pflanzenteilen",
                        "target_lang_word": "mulch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mulch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20d9bbd5-9cc7-388e-a86e-be5d036330c8",
                                        "entry_id": "70968660-ea19-340f-adae-44d7328e7278",
                                        "glosses": [
                                            "Technique agricole consistant à recouvrir le sol pour le garder meuble, limiter l’évaporation et l’érosion ; paillage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb983766-0f72-4808-8e79-8712172ce5e6",
                                                "sense_id": "20d9bbd5-9cc7-388e-a86e-be5d036330c8",
                                                "text": "Le mulch est fondamental dans une agriculture écologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d7035f-af9a-3435-a81d-b3e776400ea8",
                                        "entry_id": "70968660-ea19-340f-adae-44d7328e7278",
                                        "glosses": [
                                            "Matériau utilisé pour cette technique, déchets organiques, compost, paillis, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab3ba7e-4cdd-4269-9666-5aa9f0398e0f",
                                                "sense_id": "a5d7035f-af9a-3435-a81d-b3e776400ea8",
                                                "text": "Récemment, les flux de volatilisation du S-métolachlore et de son phytoprotecteur le bénoxacor ont été suivis durant 3 jours avec des tunnels de ventilation disposés au champ, l’un sur sol nu, l’autre sur un sol recouvert d’un mulch."
                                            },
                                            {
                                                "example_id": "37909480-a209-48f4-9b3a-90d1fcb87f13",
                                                "sense_id": "a5d7035f-af9a-3435-a81d-b3e776400ea8",
                                                "text": "Nos services font un mélange moitié feuilles mortes moitié copeaux de bois. Cela fait un excellent mulch (ou paillis), naturel, proche et économique pour nos plantes pérennes."
                                            }
                                        ]
                                    }
                                ]
