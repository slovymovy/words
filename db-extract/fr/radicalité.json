                                    {
                                        "sense_id": "56c45c94-3e8a-3b0f-afdd-435e805ccde7",
                                        "entry_id": "a78f71d9-758a-3d2f-bc63-50cf4058c54f",
                                        "glosses": [
                                            "The quality of being radical; radicalness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a97597-379d-43db-8540-d540f730876a",
                                                "sense_id": "56c45c94-3e8a-3b0f-afdd-435e805ccde7",
                                                "text": "However, the radicality of political praxis and the radicality of Theory might not be of the same order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9c6021-a0ac-304f-bae6-d2cd9a14a9b9",
                                        "entry_id": "a78f71d9-758a-3d2f-bc63-50cf4058c54f",
                                        "glosses": [
                                            "Germinal principle; source; origination."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2aef29e-e4b0-49d9-a5d2-acc75036f42e",
                                                "sense_id": "1b9c6021-a0ac-304f-bae6-d2cd9a14a9b9",
                                                "text": "there may be equivocal seeds and hermaphroditical principles, which contain the radicality and power of different forms"
                                            }
                                        ]
                                    },
