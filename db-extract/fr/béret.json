                                                "example_id": "28adcec4-7034-4ae2-b383-965f374acc40",
                                                "sense_id": "ddc586f3-2200-36ca-a7b8-4d266355bb72",
                                                "text": "„Die Richter […] haben zur Urteilsverkündung und zur Eidesabnahme das Haupt mit dem Barett zu bedecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
