                "senses": [
                    {
                        "sense_id": "03e3a1bf-0bf5-3a8c-b60b-82bc01b367c3",
                        "entry_id": "c901b528-855d-369f-9a83-44ad5b95039f",
                        "glosses": [
                            "Krokodil mit einem langen Schwanz und einer langen, schmalen Schnauze, das bis zu sechs Metern lang werden kann und das vorwiegend in den Flüssen Indiens und Myanmars vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5cd79b-3c70-4a00-8e0c-fc1be8a108b6",
                                "sense_id": "03e3a1bf-0bf5-3a8c-b60b-82bc01b367c3",
                                "text": "„Besonders am Herzen liegen dem Südfranzosen die spitzmäuligen Gangeskrokodile, die Gaviale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81ec161b-15e3-459b-a430-1c63252e38e6",
                        "source_entry_id": "c901b528-855d-369f-9a83-44ad5b95039f",
                        "source_sense_id": "03e3a1bf-0bf5-3a8c-b60b-82bc01b367c3",
                        "target_lang_word": "gavial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gavial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e857b65-f3d4-3022-80e2-c46afcf32915",
                                        "entry_id": "d7e8e2e3-6ac8-3495-91cf-eb9d5cd2a918",
                                        "glosses": [
                                            "Alternative form of gharial."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2a473ad-8eab-42f5-89aa-4c83624ce90b",
                                                "sense_id": "4e857b65-f3d4-3022-80e2-c46afcf32915",
                                                "text": "Cuvier had begun studying the fossils of crocodiles found near Caen and Honfleur in France. (They were, in fact, gavials, fine-jawed crocodiles that are nowadays found in India)."
                                            },
                                            {
                                                "example_id": "bda17260-620a-42a1-b931-023b044a41eb",
                                                "sense_id": "4e857b65-f3d4-3022-80e2-c46afcf32915",
                                                "text": "Although human remains and jewelry have been found in their stomachs, gavials are not as fierce as many alligators and crocodiles."
                                            },
                                            {
                                                "example_id": "9d8bd9cc-7664-4d5e-b4a1-3f4de72c9703",
                                                "sense_id": "4e857b65-f3d4-3022-80e2-c46afcf32915",
                                                "text": "Gavials (or gharials) are found only on the northern Indian subcontinent, where most are riverine, being best adapted to calmer areas in deep fast-flowing rivers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c873c73-857b-4918-91e5-81aafcfad6ba",
                        "source_entry_id": "c901b528-855d-369f-9a83-44ad5b95039f",
                        "source_sense_id": "03e3a1bf-0bf5-3a8c-b60b-82bc01b367c3",
                        "target_lang_word": "gharial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gharial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                        "entry_id": "ca569450-2898-3ef2-a1af-c86445ab8eb7",
                                        "glosses": [
                                            "A crocodilian of species Gavialis gangeticus, of the family Gavialidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f3371c-bf0a-49b3-91e0-34e7ae1098de",
                                                "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                                "text": "We crossed the Rapti at Bijlipur, three miles from Balrampur, over a pontoon bridge, from where we would often see marsh crocodile and gharial lying on the sandbanks with their mouths open, absorbing the solar heat."
                                            },
                                            {
                                                "example_id": "b37e62bf-354f-41bf-93f4-88bd2a910425",
                                                "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                                "text": "Placed in a family by itself, the Gavialidae, the gharial has long been separated from the rest of the crocodilian stock, with the possible exception of Tomistoma (Densmore 1983)."
                                            },
                                            {
                                                "example_id": "f0716900-5159-428d-8d9c-463f17c0fa14",
                                                "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                                "text": "1996, M. V. Subba Rao, Nesting Behaviour of the Indian Crocodiles, Gavialis gangeticus, Crocodylus plaustris and Crocodylus porosus (Reptilia: Crocodylidae), Geethabali R. Ramamurthi, Readings in Behaviour, page 213,\nGharials, Gavialis gangeticus are the inhabitants of deep, fast flowing rivers."
                                            },
                                            {
                                                "example_id": "2e932d8a-dfc1-462b-b8e6-41e56613a311",
                                                "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                                "text": "The gharial breathes air into its lungs, like caimans, alligators, and crocodiles. It can hold its breath and stay underwater for a long time—more than half an hour. Gharials can also hunt underwater. They even eat their food there."
                                            },
                                            {
                                                "example_id": "e7b5e79a-5b6e-4be8-aade-5ca2767c3df4",
                                                "sense_id": "528b07da-230f-305c-a5c2-907c6dc29799",
                                                "text": "One of the goals of our river expedition was to locate gharial. Gharial help crocodilians lay claim to being the ugliest reptiles, and perhaps the most ancient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "325e447a-9500-4379-af53-19954863ae04",
                        "source_entry_id": "c901b528-855d-369f-9a83-44ad5b95039f",
