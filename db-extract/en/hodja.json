                    },
                    {
                        "translation_id": "9de16c66-8484-4500-a036-efe127969a2e",
                        "source_entry_id": "1b14a9ec-e740-39ab-bc27-f19a47bf8897",
                        "source_sense_id": "088cde62-04ae-39b0-a62b-b6754449aa66",
