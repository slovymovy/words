                ],
                "translations": [
                    {
                        "translation_id": "0dd4d7b4-1eee-43ad-95b6-46d51c31c4b0",
                        "source_entry_id": "f3bb4ca2-01c1-3fca-997e-cbe8fb9288af",
                        "source_sense_description": "bladder",
                        "target_lang_word": "vessie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vessie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "271785c0-38be-3edf-b1e8-9d3c699dab83",
                                        "entry_id": "49baaba2-ad46-3f62-ac3e-2faf34201644",
                                        "glosses": [
                                            "Organe constitué d’un réservoir membraneux recevant et contenant l’urine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110f02bd-6047-459c-8401-2576c145e9c9",
                                                "sense_id": "271785c0-38be-3edf-b1e8-9d3c699dab83",
                                                "text": "La vessie est située dans le bassin, entre le rectum et l’os pubis."
                                            },
                                            {
                                                "example_id": "61d38653-f32c-4429-9314-32c3096b8d8b",
                                                "sense_id": "271785c0-38be-3edf-b1e8-9d3c699dab83",
                                                "text": "L’urine passe des reins dans la vessie par les uretères et sort de la vessie par l’urètre."
                                            },
                                            {
                                                "example_id": "7ab80e53-8f85-48a2-b9b4-c8d4027883ae",
                                                "sense_id": "271785c0-38be-3edf-b1e8-9d3c699dab83",
                                                "text": "Au préalable, il me faut confesser que j’ai une petite vessie. Comment expliquer sinon que la moindre tasse de thé m’envoie sans délai au petit coin et qu’une théière me fasse réitérer la chose à la mesure de sa contenance ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5d6457-ad29-3dfb-8c1c-19ffb3454505",
                                        "entry_id": "49baaba2-ad46-3f62-ac3e-2faf34201644",
                                        "glosses": [
                                            "Cet organe tiré du corps de l’animal et desséché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbded06-ef40-4925-86b2-61eb323e2e28",
                                                "sense_id": "3d5d6457-ad29-3dfb-8c1c-19ffb3454505",
                                                "text": "Gonfler une vessie de porc."
                                            },
                                            {
                                                "example_id": "7647ca42-56fa-4ab1-bd00-d0ccc9171841",
                                                "sense_id": "3d5d6457-ad29-3dfb-8c1c-19ffb3454505",
                                                "text": "Chacun tirait de sa poche sa pipe et la vessie de porc pleine de feuilles de tabac hachées à la main et commençait à fumer d’un air de contentement, après une heure et demie de contrainte."
                                            },
                                            {
                                                "example_id": "fea5c482-1ba8-4e41-9eeb-67a2d66a588e",
                                                "sense_id": "3d5d6457-ad29-3dfb-8c1c-19ffb3454505",
                                                "text": "L’homme sortit de sa poche une vessie de porc et, après avoir bourré une grosse pipe courte, il dit :\n— Non. C’est pas possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664504c2-93f3-3120-a689-60ea9f51b630",
                                        "entry_id": "49baaba2-ad46-3f62-ac3e-2faf34201644",
                                        "glosses": [
                                            "Sorte d’ampoule, de cloque sur la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bb5819-7d80-4411-a59a-e32ee3fc7387",
                                                "sense_id": "664504c2-93f3-3120-a689-60ea9f51b630",
                                                "text": "La vessie est une proéminence de l’épiderme, présentant une grande circonférence, ayant une base irrégulière, contenant un fluide séreux et transparent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b73ce9-3018-3ad3-a28e-a5c3d8968b3f",
                                        "entry_id": "49baaba2-ad46-3f62-ac3e-2faf34201644",
                                        "glosses": [
                                            "Poche de caoutchouc dans laquelle on introduit de la glace et qu’on pose sur un malade, à des fins thérapeutiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b12fae4a-d810-49e9-9999-e08c181252d5",
                                                "sense_id": "f0b73ce9-3018-3ad3-a28e-a5c3d8968b3f",
                                                "text": "– On va l’opérer ?\n– Je n’en sais rien, on verra, il y a des chances… S’il y avait de la glace au bistrot, en bas, il faudrait lui en mettre sur le ventre, sans attendre, jusqu’à ce que l’ambulance arrive. Je te préviens qu’elles se font attendre, on a le temps de crever… Cours à la pharmacie chercher une vessie…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e76e056-55ba-342c-9aec-5e44c3a8d7a1",
                                        "entry_id": "49baaba2-ad46-3f62-ac3e-2faf34201644",
                                        "glosses": [
                                            "Poche emplie d'air ou d'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb65e968-71e5-4a4a-852e-7a3fdda28cde",
                                                "sense_id": "6e76e056-55ba-342c-9aec-5e44c3a8d7a1",
                                                "text": "Les Utriculaires, plantes qui vivent sous l'eau, sont munies de petites vessies habituellement submergées. Au moment de la floraison, ces outres se remplissent d'air, se font légères, viennent flotter à la surface où elles soutiennent les fleurs, puis de nouveau s'enfoncent et nagent entre deux eaux."
                                            },
                                            {
                                                "example_id": "ce9bd0d5-d84f-4444-87e2-b70cb9b5313f",
                                                "sense_id": "6e76e056-55ba-342c-9aec-5e44c3a8d7a1",
                                                "text": "La vieille Mme de Morlaine, qui poussait en cris perçants ses mots d’esprit, vive, éperdue, agitant ses formes monstrueuses comme une nageuse entourée de vessies."
                                            },
                                            {
                                                "example_id": "44e303f9-cf42-482e-8e9f-6b59146948f1",
                                                "sense_id": "6e76e056-55ba-342c-9aec-5e44c3a8d7a1",
                                                "text": "Et il vit tout à la fois : l’étalon, délivré de sa charge, stimulé par la fraîcheur du soir, l’appel de l’écurie… son arrivée… la selle vide… l’étonnement, l’inquiétude… Toursène prévenu… les secours… les torches, les lampes tempête… et enfin, dans leurs faisceaux, un vaniteux dont sa monture avait fait justice, un tchopendoz incapable de tenir sur un cheval, un infirme de qui tout l’orgueil, toute la gloire n’étaient plus que vessies crevées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
