                                        "glosses": [
                                            "schwarz-gelbes, stachelbewehrtes Insekt der Faltenwespen mit längsgefalteten Vorderflügeln und starken Oberkiefern"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883521e6-baa8-414e-96f0-fa8d0954b494",
                                                "sense_id": "04b1f243-2034-3cae-a645-df99fb080f56",
                                                "text": "In der Konditorei schwirrten die Wespen über dem Pflaumenkuchen."
                                            },
                                            {
                                                "example_id": "32c5fcb9-5e9c-4d9d-bd73-f8ed0ecd0953",
                                                "sense_id": "04b1f243-2034-3cae-a645-df99fb080f56",
                                                "text": "Der Stich der Wespe tut weh."
                                            },
                                            {
                                                "example_id": "30cbb1e2-ee8b-40b5-9b5b-fd28ee71dbd0",
                                                "sense_id": "04b1f243-2034-3cae-a645-df99fb080f56",
                                                "text": "„Der flegelhafte Tonsurträger wirkte auf mich wie eine Wespe, die ich zerquetschen mußte.“"
                                            },
                                            {
                                                "example_id": "b09fc695-2610-4b38-8b4a-f503baa80253",
                                                "sense_id": "04b1f243-2034-3cae-a645-df99fb080f56",
                                                "text": "„Rosenthal zuckte zurück, als hätte er eine Wespe unter dem Kragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f0bafa0-961d-3333-9e4f-64ae4a5a48cb",
                                        "entry_id": "33a9d0f3-4397-3147-9fd5-47ee2b565ecf",
                                        "glosses": [
                                            "wespenartig aussehender Vertreter von diversen Familien der Hautflügler"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195b0b91-4c6c-4f4c-be07-79e8b85a4405",
                                                "sense_id": "8f0bafa0-961d-3333-9e4f-64ae4a5a48cb",
                                                "text": "Guck mal! Ne Wespe mit Wespentaille!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
