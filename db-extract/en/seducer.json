                    {
                        "translation_id": "8d58a327-0881-4ed3-ae23-df73befb4298",
                        "source_entry_id": "142d0942-14f1-3e64-b72b-361e3e281598",
                        "source_sense_id": "61860484-8de5-39dc-85d0-8162f65753a0",
