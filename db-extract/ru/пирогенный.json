                        ]
                    },
                    {
                        "translation_id": "242accb0-6656-458f-a59e-0e2ae829027e",
                        "source_entry_id": "e88d21ef-d628-3edb-ac9f-7375d42342fd",
                        "target_lang_word": "pyrogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2288156c-35b3-3bf3-b4e6-4ed3da3c46c1",
                                        "entry_id": "35514340-199b-3c30-af48-22cfd76e67f8",
                                        "glosses": [
                                            "eine Erhöhung der Körpertemperatur hervorrufend"
                                        ],
                                        "tags": [
                                            "von parenteral zugeführten Substanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6573dd-a8ad-440f-a3be-0714b5398566",
                                                "sense_id": "2288156c-35b3-3bf3-b4e6-4ed3da3c46c1",
                                                "text": "„Schüttelfrost und Fieber sind auf eine Verstellung des Sollwertes zurückzuführen. Diese Veränderung kann durch Krankheitserreger durch die Ausschüttung pyrogener (Fieber erzeugender) Stoffe verursacht werden oder durch den Körper selbst, um die Reaktionen der Immunantwort zu beschleunigen.“"
                                            },
                                            {
                                                "example_id": "2860899f-dba0-4531-9890-e9a4d80e0369",
                                                "sense_id": "2288156c-35b3-3bf3-b4e6-4ed3da3c46c1",
                                                "text": "Daneben können verschiedene exogen zugeführte Stoffe (Blutderivate, Medikamente, Drogen, Gifte) akut pyrogen wirken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cc21560-a2c8-32cd-92f8-62485df1d4d2",
                                        "entry_id": "35514340-199b-3c30-af48-22cfd76e67f8",
                                        "glosses": [
                                            "aus feurigem Magma entstanden"
                                        ],
                                        "tags": [
                                            "Mineral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afaf9d8b-6b50-4b21-ad01-26d2e61d38e7",
                                                "sense_id": "8cc21560-a2c8-32cd-92f8-62485df1d4d2",
                                                "text": "Wenn auch solche Flächen an pyrogenen Quarzen bisher wohl niemals beobachtet sind, steht doch nichts im Wege anzunehmen, daß sie dort und namentlich auch an Bergkristallen oberhalb 575° gebildet werden könnten."
                                            },
                                            {
                                                "example_id": "3067ac39-6a43-452e-976c-0af12378623e",
                                                "sense_id": "8cc21560-a2c8-32cd-92f8-62485df1d4d2",
                                                "text": "Alle pyrogenen wie neptunischen Gesteins-Bildungen, einige quartäre ausgenommen, befanden sich ursprünglich auf oder nahe an der niedrigsten Oxydations-Stufe, nie auf dem Maximum."
                                            },
                                            {
                                                "example_id": "8d31a127-22b2-466c-9515-4f09ed3b4dfc",
                                                "sense_id": "8cc21560-a2c8-32cd-92f8-62485df1d4d2",
                                                "text": "Eine besondere Form von Füllstoffen stellen pyrogene Kieselsäuren dar. … Pyrogene Kieselsäure wird synthetisch durch Flammenhydrolyse hergestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68408c30-530d-4adb-9477-519dd740a579",
                        "source_entry_id": "e88d21ef-d628-3edb-ac9f-7375d42342fd",
                        "target_lang_word": "pyrogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ef370f7-80f2-3bc4-b8a9-b25ac7905101",
                                        "entry_id": "49ed30e0-0bf6-3788-9a65-35b2d8d845d9",
                                        "glosses": [
                                            "Qualifiait une roche formée par la fusion ignée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6dabc1-c930-406f-b0fd-fe139a03eecf",
                                                "sense_id": "4ef370f7-80f2-3bc4-b8a9-b25ac7905101",
                                                "text": "Cette Roche pyrogène, très abondante dans la nature , a commencé à paraître avec les terrains de la période phylladienne, et a continué jusqu'à la fin du terrain houiller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e53b76f-1661-38b3-87c4-952cf96b48d6",
                                        "entry_id": "49ed30e0-0bf6-3788-9a65-35b2d8d845d9",
                                        "glosses": [
                                            "Qui contient ou qui est enrobé d'une substance apte à s'enflammer facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa04fe76-9472-4879-b915-c15853e07656",
                                                "sense_id": "3e53b76f-1661-38b3-87c4-952cf96b48d6",
                                                "text": "Allumettes pyrogènes."
                                            },
                                            {
                                                "example_id": "19dd418f-22ec-4770-a55d-37f3ac02ef28",
                                                "sense_id": "3e53b76f-1661-38b3-87c4-952cf96b48d6",
                                                "text": "Quand l'allumette s'enflamme , ce qui n'arrive pas toujours , vous allumez la boule pyrogène de monsieur; avec celle boule, vous allumez à son tour la pomme de pin de ce troisième monsieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d153917c-45e4-35c8-8b81-e640df607f35",
                                        "entry_id": "49ed30e0-0bf6-3788-9a65-35b2d8d845d9",
                                        "glosses": [
                                            "Qui provoque la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064d11d5-6e3a-401a-8b7b-9c8f32cfc379",
                                                "sense_id": "d153917c-45e4-35c8-8b81-e640df607f35",
                                                "text": "Substance, produit pyrogène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyrogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc05d87-0711-39e4-8e3e-edb321c48d74",
                                        "entry_id": "5cd72c15-aefa-3784-aca8-cf337a7e5740",
                                        "glosses": [
                                            "Godet de forme et de décoration variées contenant des allumettes et muni d'un frottoir."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "550b2810-a508-44d5-91c1-c00c47b17638",
                                                "sense_id": "6bc05d87-0711-39e4-8e3e-edb321c48d74",
                                                "text": "[Mariette] n’aspirait qu’à la tranquillité d’une entreprise honnête et régulière, limitée par le gain quotidien et la paisible satisfaction de trôner à la caisse, entre la tirelire du garçon, les pyrogènes, la coupe à sucre et l’inévitable pot de plantes stérilisées."
                                            },
                                            {
                                                "example_id": "a903154c-88de-45f5-91a7-7f3856204719",
                                                "sense_id": "6bc05d87-0711-39e4-8e3e-edb321c48d74",
                                                "text": "Elle s’est cognée. Madame ne lui a pas donné de pyrogène."
                                            },
                                            {
                                                "example_id": "d81f4740-6bc7-4619-bfe8-b50e712ce346",
                                                "sense_id": "6bc05d87-0711-39e4-8e3e-edb321c48d74",
                                                "text": "Accessoires indispensables pour « donner le feu » dans les bistrots depuis le milieu du XIXᵉ siècle et jusque dans les années 1930, le pyrogènes les plus courants sont en céramique et renferment dans leur partie centrale des allumettes au phosphore que l’on frotte sur la partie la plus externe rendue rugueuse par l’application d’une poudre particulière."
                                            }
                                        ]
                                    }
