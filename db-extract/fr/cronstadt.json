                    {
                        "sense_id": "80521875-b9a1-360e-b9dd-1df93d64d093",
                        "entry_id": "4dc83992-ec06-3e8c-bdbb-f9f4083484c2",
                        "glosses": [
                            "Ville portuaire de Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4fa0369-e3e1-4135-b24c-7591aa868a64",
                                "sense_id": "80521875-b9a1-360e-b9dd-1df93d64d093",
                                "text": "L’amiral Napier offre de mettre Cronstadt en brindezingues, si on lui permet de perdre quinze vaisseaux, soit dix mille hommes et trente ou quarante millions. On trouve que c'est un peu cher."
                            },
                            {
                                "example_id": "cb88bb91-6e2d-4a9c-bcf0-278b80995934",
                                "sense_id": "80521875-b9a1-360e-b9dd-1df93d64d093",
                                "text": "Quelques mois plus tard, en 1921, les marins de Cronstadt se sont soulevés contre la « dictature du parti », la « commissariocratie », une réglementation économique dont le pays mourait."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bf93e19-b17e-369d-a8be-67ce552f5478",
                        "entry_id": "4dc83992-ec06-3e8c-bdbb-f9f4083484c2",
                        "glosses": [
                            "Variante française de Kronstadt, ancien nom de Brașov, ville de Roumanie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3e4f433e-863c-47d7-8561-48b2d390f952",
                                "sense_id": "8bf93e19-b17e-369d-a8be-67ce552f5478",
                                "text": "« Entre Hermanstadt et Cronstadt sont plusieurs villages habités par une race magnifique, et enrichis par une industrie fort active et habilement dirigée. »"
                            }
                        ]
                    }
                ],
