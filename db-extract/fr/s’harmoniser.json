                        "cross_references": [
                            {
                                "target_word": "harmonieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4f342b-5daf-3449-8cb0-f37e92e2a2c3",
                                        "entry_id": "0806d656-9d33-3387-a991-d9b23ccbabc7",
                                        "glosses": [
                                            "gut zusammenpassen, weil Eigenschaften wie Farbe, Form oder besonders auch Klang zueinanderpassen"
                                        ],
                                        "tags": [
                                            "Dinge"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b588f930-0fcf-4be9-b9e7-1a8a6de11c7d",
                                                "sense_id": "2c4f342b-5daf-3449-8cb0-f37e92e2a2c3",
                                                "text": "„Weil, wie gesagt, die Klangfarbe der Rt. etwa zwischen der Kleinen und der Großen Trommel liegt, harmoniert sie mit beiden sehr überzeugend.“"
                                            },
                                            {
                                                "example_id": "6766ca60-ee94-40c6-ba82-ace9acf6bcd7",
                                                "sense_id": "2c4f342b-5daf-3449-8cb0-f37e92e2a2c3",
                                                "text": "„Der Komponist verwendet Prozeduren der klassischen Harmonie und bevorzugt Akkordbegleitungen, meistens plakatiert; er harmoniert mit Chromatismen und verwegenen Modulationen, die er mit viel Mut an vielen Stellen verwendet und bringt damit oft nur einen Reichtum von Harmonien ein.“"
                                            },
                                            {
                                                "example_id": "52d84249-a438-4f69-8073-d919addd8bcc",
                                                "sense_id": "2c4f342b-5daf-3449-8cb0-f37e92e2a2c3",
                                                "text": "Die Farbe der Bluse harmoniert wirklich wunderbar mit der Inneneinrichtung, das wird ein tolles Foto!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57850c48-e1e4-36f2-ab60-11b5eb5f082f",
                                        "entry_id": "0806d656-9d33-3387-a991-d9b23ccbabc7",
                                        "glosses": [
                                            "gut miteinander auskommen, in Harmonie miteinander umgehen"
                                        ],
                                        "tags": [
                                            "Lebewesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a96b27-319f-4d38-a566-c103773d41c2",
                                                "sense_id": "57850c48-e1e4-36f2-ab60-11b5eb5f082f",
                                                "text": "Vater und Sohn harmonieren auch geschäftlich ganz gut miteinander."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
