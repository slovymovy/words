                "forms": [],
                "senses": [
                    {
                        "sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
                        "entry_id": "eb9bf658-1185-358a-bc6f-8de344351398",
                        "glosses": [
                            "D’une façon extemporanée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048a2efe-81d8-4ac0-8c84-5816f40e680e",
                                "sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
                                "text": "Le mot merguez désigne les saucisses de mouton et de bœuf. Il en est qui se préparent extemporanément pour être grillées et consommées le jour même. D'autres sont de conserve."
                            },
                            {
                                "example_id": "238c1b97-9108-44d5-b9b1-b0d586459ea1",
                                "sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
                                "text": "Vitrimix, LP Mix et Médianut sont des mélanges préparés extemporanément à l'aide d'un set de transfert, à partir d'un flacon d'acides aminés et d'un flacon de lipides […]."
                            },
                            {
                                "example_id": "5f331f79-4d15-4ef1-b4b9-f051f33aa5a6",
                                "sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
                                "text": "Le diiode permettant d’étalonner la solution de thiosulfate peut être aussi préparé extemporanément par oxydation des iodures par le dichromate de potassium en milieu acide selon la réaction : Cr₂O₇²⁻ + 6 I⁻ + 14 H⁺ → 2 Cr₃⁺ + 3 I₂ + 7 H₂O"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a67574e2-fd62-49c4-ace2-3cb9b5359374",
                        "source_entry_id": "eb9bf658-1185-358a-bc6f-8de344351398",
                        "source_sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
                        "target_lang_word": "extemporaneously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extemporaneously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f364f42-255a-3694-8e58-53c4abe414a0",
                                        "entry_id": "a2438cb2-8d14-3672-9a0e-6af1e40e2eb2",
                                        "glosses": [
                                            "In an extemporaneous manner; without prior preparation or planning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8c2474-f42c-448d-aef0-5ca0377d07da",
                                                "sense_id": "8f364f42-255a-3694-8e58-53c4abe414a0",
                                                "text": "Considering that he was speaking extemporaneously, he covered the subject pretty well."
                                            },
                                            {
                                                "example_id": "abd80e3b-cb85-45ac-ab18-9751e3ae3100",
                                                "sense_id": "8f364f42-255a-3694-8e58-53c4abe414a0",
                                                "text": "She recounted that while speaking extemporaneously during a livestream, she mentioned her twice-weekly housekeeper who “cleans the toilets.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe32c303-5dec-4c6d-9940-ca81aed970db",
                        "source_entry_id": "eb9bf658-1185-358a-bc6f-8de344351398",
                        "source_sense_id": "85d0b6b4-dc81-36fa-a1a5-e7d0d4aebc2e",
