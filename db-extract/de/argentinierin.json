                                        "sense_id": "e6858af7-b66f-33c1-b2b8-6322699f82e9",
                                        "entry_id": "d2b282b0-8d4f-3367-9a00-a9d3a18b37af",
                                        "glosses": [
                                            "A citizen or descendant abroad of Argentina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc749377-66bf-4554-a6d5-e992ce578af6",
                                                "sense_id": "e6858af7-b66f-33c1-b2b8-6322699f82e9",
                                                "text": "\"Rich as an Argentine\" was a phrase my Brooklyn grandfather often repeated to my bewilderment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b32f8b5-934d-3ec3-86c8-0aba38922ecc",
