                        "entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "glosses": [
                            "een gelegenheid waar in een luxe omgeving gegokt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2263f3e4-a178-4d69-8510-f0b9cc908542",
                                "sense_id": "ff6f2ad3-e949-3983-9e8a-6b2ee5026fb8",
                                "text": "James Bond bezoekt vaak een casino en wint daar meestal veel geld."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc2e46e-c7d5-36f0-94fb-cb601656016c",
                        "entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "glosses": [
                            "zaken die gekenmerkt worden door de (te) grote risico's die er een rol bij spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00204e74-4d55-4aed-b547-05422a0ea625",
                                "sense_id": "6bc2e46e-c7d5-36f0-94fb-cb601656016c",
                                "text": "Op zichzelf zijn de voorgestelde hervormingen inhoudelijk niet onredelijk, maar ze moeten gepaard gaan met investeringen die een vrije armoedeval voorkomen. Het Griekse casino is failliet, maar dat was goed beschouwd een filiaal van de Europese kredietfabriek waaraan door tal van Europese bedrijven is verdiend. Ook dat maakt de afwikkeling van het faillissement een gemeenschappelijke Europese verantwoordelijkheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c797919-5f93-34a9-b94e-64265ac1af9b",
                        "entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "glosses": [
                            "casinobrood"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4082722b-84bd-4b97-a378-fb8cb4cfc98b",
                        "source_entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "source_sense_id": "ff6f2ad3-e949-3983-9e8a-6b2ee5026fb8",
                        "source_sense_description": "een gelegenheid waar in een luxe omgeving gegokt wordt",
                        "target_lang_word": "Kasino",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kasino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                                        "glosses": [
                                            "Ort oder Haus für Zusammenkünfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af007d9c-2c4a-4c33-b6ff-de8a0d1dc811",
                                                "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                                                "text": "Wenn ihr die Kantine Kasino nennt, dürft ihr das Doppelte verlangen."
                                            },
                                            {
                                                "example_id": "f2bb4ab8-f4fe-4cb4-a231-36108414ba9c",
                                                "sense_id": "c949de59-d091-30e3-b3a3-2bcef35285e4",
                                                "text": "„[…] Ich brauchte daher denn auch nicht lange zu suchen, um ein Kasino zu finden, wie ich es wünschte. Es war das schönste in ganz Venedig und dessen Umgebung; dafür war es natürlich auch das teuerste. Es hatte dem englischen Gesandten gehört, der es seinem Koch um billigen Preis überlassen hatte, als er von Venedig fortging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02c8b7d1-af79-3f3a-b794-30281f031c54",
                                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                                        "glosses": [
                                            "Kantine für Offiziere oder in Firmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d156811-b038-416a-85ea-0648efbd941d",
                                                "sense_id": "02c8b7d1-af79-3f3a-b794-30281f031c54",
                                                "text": "Gibt es für die Offizierinnen eigentlich getrennte Kasinos?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                                        "entry_id": "1008b45a-fdab-3763-ae74-8e7323088eae",
                                        "glosses": [
                                            "Glücksspielmöglichkeit im Rahmen eines Restaurations- und Variétébetriebs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392ebda0-7ff0-4c2d-a8e3-07467a304253",
                                                "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                                                "text": "Im Kasino wirst du dein Geld schneller los als deinen Durst."
                                            },
                                            {
                                                "example_id": "e7365c6d-04e5-4f6e-806b-77d6b3cc1a8e",
                                                "sense_id": "88343fe8-2b09-32b1-97aa-7cfbddb64a22",
                                                "text": "„Es gehörte beinahe zum guten Ton unter jungen Wissenschaftlern, die eigenen mathematischen Fähigkeiten in Kasinos auszuspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "282bfed4-dbde-4d2e-ad25-e440ff5683bc",
                        "source_entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "source_sense_id": "ff6f2ad3-e949-3983-9e8a-6b2ee5026fb8",
                        "source_sense_description": "een gelegenheid waar in een luxe omgeving gegokt wordt",
                        "target_lang_word": "casino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A public building or room for gambling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64af84-aa6f-4a12-ac93-1c3b4caf68f2",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "He went to the casino every night till 1:00 am."
                                            },
                                            {
                                                "example_id": "3d0712a6-c9dc-4c1d-86af-cb68f9876dae",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "A bid by Donald Trump to build Sydney’s first casino was rejected 30 years ago after police expressed concerns about his links to the mafia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A small house; a pleasure house or holiday home, especially in Italy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5131f7-55fb-4da7-9328-f7448eba1132",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "Quirini [was] knowing in the belles Lettres, & highly skilled in making his Casino comfortable to all the Wits & Blues as we now call them in London."
                                            },
                                            {
                                                "example_id": "498446dc-833c-43a9-9d09-c8bd957e0cb4",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "I felt it strange, and regretted it, that so amiable a man should have contracted such dissolute habits, and at this very time, instead of living respectably with his charming Countess, had Baccelli, the superannuated dancing courtesan, in a casino in the neighbourhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72f7f3dd-5ceb-3764-bbdb-bc3b29f45f2c",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A certain Italian card game for two to four players."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f9c9d79-956d-3782-a7c3-9bd8da0c0d70",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "Any of certain cards with special meanings in this game."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "774bbb1a-d98b-4bb7-89fd-19f512d9aa1f",
                        "source_entry_id": "d5a24a98-d144-3070-a94a-02b81c77dd71",
                        "source_sense_id": "ff6f2ad3-e949-3983-9e8a-6b2ee5026fb8",
                        "source_sense_description": "een gelegenheid waar in een luxe omgeving gegokt wordt",
                        "target_lang_word": "casino",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
