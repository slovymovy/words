                        "examples": [
                            {
                                "example_id": "517a93e4-1a13-4835-bc90-d23519ae7773",
                                "sense_id": "b9eb72ee-7a66-39b2-934b-65e08172da25",
                                "text": "Chaque lobe du cerveau se divise en une multitude de lobules."
                            },
                            {
                                "example_id": "26b6a704-8b2d-497f-a767-0b85c1fca86d",
                                "sense_id": "b9eb72ee-7a66-39b2-934b-65e08172da25",
                                "text": "Les lobes du foie sont divisés en lobules hépatiques."
                            },
                            {
                                "example_id": "49221b91-8764-4efa-964b-061648f2d6c9",
                                "sense_id": "b9eb72ee-7a66-39b2-934b-65e08172da25",
                                "text": "Une bonne compréhension de l’imagerie du thorax repose sur une bonne connaissance de l’unité anatomique du poumon constituée par le lobule pulmonaire secondaire de Miller."
                            }
                        ]
                    }
