                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "453f6870-9dfe-3d59-aaf5-deef278cccfb",
                                        "entry_id": "eebfbaa5-b56a-3004-bfbb-88ebdffa3005",
                                        "glosses": [
                                            "A social system in which the state takes overall responsibility for the welfare of its citizens, providing health care, education, unemployment benefits and social security."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d65043-5f2c-4176-9422-272d80692004",
                                                "sense_id": "453f6870-9dfe-3d59-aaf5-deef278cccfb",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. Essential public services are cut so that the rich may pay less tax. […]"
                                            },
                                            {
                                                "example_id": "f18bff43-11ce-4e4d-a668-e05c2466bfb0",
                                                "sense_id": "453f6870-9dfe-3d59-aaf5-deef278cccfb",
                                                "text": "Wagenknecht […] argues further that a policy of high migration enforces a minimal welfare state that is ‘cheaper for the upper and upper middle classes in comparison to a real welfare state, but it is not an attractive project for the middle and lower middle groups. Thus, if one wants to remove support for social provisions, this is exactly the way to do it’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab0e353-451e-36ec-b085-93da38ca39d8",
                                        "entry_id": "eebfbaa5-b56a-3004-bfbb-88ebdffa3005",
                                        "glosses": [
                                            "A country in which such a system operates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
