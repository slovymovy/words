                        "examples": [
                            {
                                "example_id": "637ea316-2ac7-4310-a16d-d3f668aa9969",
                                "sense_id": "4e719395-a7d3-3325-8c69-c77b6973e0b1",
                                "text": "усёк?",
                                "translation": "got it?",
                                "english": "got it?"
                            },
                            {
                                "example_id": "35c4e792-e3d6-42a3-a1ce-0177f749aac5",
                                "sense_id": "4e719395-a7d3-3325-8c69-c77b6973e0b1",
                                "text": "Крестья́нского ро́ду па́рни по им изве́стным приме́там усекли́ — среди́ ле́са не песо́к, а грязь оттого́, что бы́ли здесь пре́жде огоро́ды, мо́жет, и па́шни.",
                                "translation": "Viktor Astafyev",
                                "english": "Viktor Astafyev"
                            }
                        ]
                    }
