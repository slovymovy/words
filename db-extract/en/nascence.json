                        "entry_id": "2c406f2f-ca00-3e7a-9f21-251a1e95d276",
                        "glosses": [
                            "Coming into being; inception, beginning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ea70a9d6-ce42-4525-a48d-8b4b1a4d27a4",
                                "sense_id": "a852a443-6dfa-376d-a64e-5ead2f7051cc",
                                "text": "Careful examination of Romaine's prophecy reveals the operative nature of the Kongolese religious habitus in the nascence of Haitian Vodou, a religion that truly began to crystallize during the Revolution."
                            }
                        ]
