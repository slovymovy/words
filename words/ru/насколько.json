{
    "word_family": [
        "сколько",
        "несколько",
        "нисколько",
        "поскольку"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e6141191-4edb-3f31-bc7f-1284b1e286cb",
                    "sense_definition": "В какой степени, в какой мере; используется для вопроса о величине, силе или интенсивности признака или действия.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Насколько</w> вы уверены в удаче эксперимента?",
                            "target_lang_translations": {
                                "en": "<w>How</w> confident are you in the success of the experiment?",
                                "zh": "你对实验的成功有<w>多</w>大把握？"
                            }
                        },
                        {
                            "text": "<w>Насколько</w> это утверждение верно?",
                            "target_lang_translations": {
                                "en": "<w>To what extent</w> is this statement true?",
                                "zh": "这个说法<w>到什么程度</w>是正确的？"
                            }
                        }
                    ],
                    "synonyms": [
                        "в какой мере",
                        "в какой степени",
                        "до какой степени",
                        "как",
                        "сколь"
                    ],
                    "common_phrases": [
                        "насколько это возможно",
                        "насколько сильно",
                        "насколько быстро"
                    ],
                    "target_lang_definitions": {
                        "en": "To what degree or extent; used to ask about the magnitude, strength, or intensity of a quality or action.",
                        "zh": "用于询问程度、范围或强度，表示“到什么程度”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "used with adjectives or adverbs to ask about degree"
                            },
                            {
                                "target_lang_word": "to what extent",
                                "target_lang_sense_clarification": "formal phrase asking about degree or scope"
                            },
                            {
                                "target_lang_word": "how much",
                                "target_lang_sense_clarification": "used with verbs to ask about intensity or quantity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多",
                                "target_lang_sense_clarification": "用于形容词或副词前询问程度"
                            },
                            {
                                "target_lang_word": "到什么程度",
                                "target_lang_sense_clarification": "询问范围或程度的正式表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1c28b7b-aea2-3c3d-b25a-af572207b928",
                    "sense_definition": "В той мере, в какой; употребляется для ограничения высказывания пределами известного или возможного.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Насколько</w> мне известно, мы этого в школе не проходили.",
                            "target_lang_translations": {
                                "en": "<w>As far as</w> I know, we didn't cover this in school.",
                                "zh": "<w>据我所知</w>，我们在学校里没学过这个。"
                            }
                        },
                        {
                            "text": "<w>Насколько</w> я понимаю, решение ещё не принято.",
                            "target_lang_translations": {
                                "en": "<w>As far as</w> I understand, the decision hasn't been made yet.",
                                "zh": "<w>就我的理解</w>而言，决定还没有做出。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "насколько я знаю",
                        "насколько мне известно",
                        "насколько я понимаю",
                        "насколько я помню"
                    ],
                    "target_lang_definitions": {
                        "en": "To the extent that; used to limit a statement to the bounds of what is known or possible.",
                        "zh": "用于限定陈述的范围，表示“就……而言”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as far as",
                                "target_lang_sense_clarification": "used in phrases limiting the validity of a statement"
                            },
                            {
                                "target_lang_word": "so far as",
                                "target_lang_sense_clarification": "variant of 'as far as'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "据……所知",
                                "target_lang_sense_clarification": "用于限定已知信息的范围"
                            },
                            {
                                "target_lang_word": "就……而言",
                                "target_lang_sense_clarification": "用于限定陈述的有效范围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}