                        "sense_id": "5324ea4b-4912-3700-84e0-5685d5f637ce",
                        "entry_id": "615b792e-eff7-3212-8cf5-64723c2dc2d8",
                        "glosses": [
                            "Langue construite, successeur du loglan, créé par James Cooke Brown à la fin des années 1950."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b951dc0-2a74-4bd6-8fcf-d24276c7192b",
                                "sense_id": "5324ea4b-4912-3700-84e0-5685d5f637ce",
                                "text": "Le lojban possède un vocabulaire culturellement neutre et une grammaire conçue sur un modèle logique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b899b377-e80e-4ee4-b202-c6877c858c87",
