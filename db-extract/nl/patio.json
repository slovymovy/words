                "senses": [
                    {
                        "sense_id": "e38a403c-c205-3407-a7e6-f2667e878755",
                        "entry_id": "affc41d2-21d5-3789-aceb-818b5c2d0ead",
                        "glosses": [
                            "een al dan niet omheinde binnenplaats bij een huis of ander pand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b6e141-019c-4df4-baa0-1c757c1a8b20",
                                "sense_id": "e38a403c-c205-3407-a7e6-f2667e878755",
                                "text": "De patio is de speelplek waar je lekker buiten kan spelen, als het van de dokter mag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "724e3d4d-68ee-4e15-87fe-ce7df1010e8f",
                        "source_entry_id": "affc41d2-21d5-3789-aceb-818b5c2d0ead",
                        "source_sense_id": "e38a403c-c205-3407-a7e6-f2667e878755",
                        "source_sense_description": "een al dan niet omheinde binnenplaats bij een huis of ander pand",
                        "target_lang_word": "Patio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                        "entry_id": "283c5500-357b-3ed8-bdcf-216a24216464",
                                        "glosses": [
                                            "geschlossener Innenhof eines Gebäudes, meist mit Umgängen, besonders in der spanischen und lateinamerikanischen Architektur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e65dcb3-016e-495e-80a8-42587a3280cc",
                                                "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                                "text": "Miss Curnow führt vor, daß Gunnar Möller knapp 40 Minuten später durch die Tür zum Zimmer seiner Frau brach, daß er sie in den Patio des Hauses S.128 verfolgte, in den sie über die Feuerleiter zu entkommen suchte, und daß er sie dort mit dem Bein eines Schemels tötete, nachdem er sie gewürgt hatte."
                                            },
                                            {
                                                "example_id": "83e2e74a-69c5-4146-9cde-95f3fb11352e",
                                                "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                                "text": "Trotz der idyllischen Atmosphäre im Patio fühlen sich viele Gäste unwohl. Sie klagen über Kopfschmerzen, Appetitlosigkeit und Übelkeit."
                                            },
                                            {
                                                "example_id": "19dc2a29-0be3-4485-9c00-26b22b6bd311",
                                                "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                                "text": "„Und über die zahlreichen Springbrunnen in privaten Patios gehen riesige Wassermengen durch Verdunstung verloren.“"
                                            },
                                            {
                                                "example_id": "5202623d-6bf5-429b-9a64-ca12881e8826",
                                                "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                                "text": "„Rochelle und das Dienstmädchen hatten jeden Samstag im Patio die Wäsche gebügelt, während er und Arturo Billard spielten.“"
                                            },
                                            {
                                                "example_id": "3f4e1786-3dd4-4329-b714-6a106ca0f598",
                                                "sense_id": "885c736e-e6ed-307f-aba4-b6de82e167fc",
                                                "text": "„Das Licht im Patio war sorgfältig arrangiert, damit es den Damen schmeichelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92241778-dce2-4c12-9895-97886ea34d29",
                        "source_entry_id": "affc41d2-21d5-3789-aceb-818b5c2d0ead",
                        "source_sense_id": "e38a403c-c205-3407-a7e6-f2667e878755",
                        "source_sense_description": "een al dan niet omheinde binnenplaats bij een huis of ander pand",
                        "target_lang_word": "Terrasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                        "entry_id": "1d04a3f1-0f55-3cf3-9e59-84ee951d221e",
                                        "glosses": [
                                            "größere, ebene Fläche vor, bei oder auf einem Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff804c87-959a-44e5-b355-0baad0b4ef80",
                                                "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                                "text": "Sie saßen auf der Terrasse und genossen die Sonne."
                                            },
                                            {
                                                "example_id": "e184a94b-03a6-436d-ab40-89216680ac47",
                                                "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                                "text": "„Sie erhielt ein Gästezimmer mit eigener Terrasse und einem breiten eisernen Bett.“"
                                            },
                                            {
                                                "example_id": "0e39e9f3-f57d-432f-a8ae-37f90147fb3c",
                                                "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                                "text": "„Claire sah Nikolai im Mondlicht den Weg zur Terrasse entlangkommen, gefolgt von einem scharf umrissenen Schatten.“."
                                            },
                                            {
                                                "example_id": "f3b09760-dfe4-4e4b-a47a-367ae9b8bf94",
                                                "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                                "text": "„Die Terrasse reicht bis zum Seeufer.“"
                                            },
                                            {
                                                "example_id": "8290c98f-159a-4434-9f25-db5dabc779c5",
                                                "sense_id": "c0093772-aceb-3919-9649-c704e14b7713",
                                                "text": "„Die Terrasse war menschenvoll; selbst am Spätnachmittag noch der typische Kaffee-Rummel, mit klirrenden Gläsern und Tassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45ec8633-bb68-3814-a933-d40181c799fa",
                                        "entry_id": "1d04a3f1-0f55-3cf3-9e59-84ee951d221e",
                                        "glosses": [
                                            "Abstufung im Gelände, die entweder künstlich angelegt wurde oder auf natürliche Weise entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4e1244-13ae-413c-a243-cc4127be8674",
                                                "sense_id": "45ec8633-bb68-3814-a933-d40181c799fa",
                                                "text": "Die Mauern, die die Terrassen des Weinbergs stützten, mussten dringend erneuert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c10a94a8-c056-4833-b3cd-e00aa22699ea",
                        "source_entry_id": "affc41d2-21d5-3789-aceb-818b5c2d0ead",
                        "source_sense_id": "e38a403c-c205-3407-a7e6-f2667e878755",
                        "source_sense_description": "een al dan niet omheinde binnenplaats bij een huis of ander pand",
                        "target_lang_word": "Veranda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veranda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                        "entry_id": "eae5b624-d9d3-3c40-90af-7fafa39679f9",
                                        "glosses": [
                                            "ein offener Hausan- oder Aufbau, auch mit Überdachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5511ce7-7619-4806-9a46-8d9f60e0fc7f",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Lass uns bei dem schönen Wetter raus auf die Veranda gehen."
                                            },
                                            {
                                                "example_id": "7198627a-7a1a-4865-96c4-70ca76fa86a4",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Um der Zugluft nicht ausgesetzt zu sein, wird die Veranda zwischen Gebäudeflügeln eingerückt oder an den Schmalseiten durch Holz- oder Glaswände geschlossen.\""
                                            },
                                            {
                                                "example_id": "76e735cb-4a21-404f-ad67-c92661ea078b",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Jack saß auf der Veranda und schrieb einen Brief an seine Frau.“"
                                            },
                                            {
                                                "example_id": "aa4e343b-931c-4dee-ab15-8ccdb2bbe512",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Als ich nach dem Mittagessen allein auf der Veranda saß und rauchte, kam der Offizier auch heraus und direkt auf mich zu.“"
                                            },
                                            {
                                                "example_id": "dac699f3-d3c1-4b78-8340-1c2f3960d157",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Die Veranda war leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
