                                "target_senses": [
                                    {
                                        "sense_id": "c11995ea-c143-3571-995e-4751030eeaff",
                                        "entry_id": "c53daa1e-ec87-3eed-b130-169abd6ae928",
                                        "glosses": [
                                            "Personne qui est légalement adoptée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93433856-7fe7-4502-975c-4991a8ac812f",
                                                "sense_id": "c11995ea-c143-3571-995e-4751030eeaff",
                                                "text": "L’adoption exige en outre une différence d’âge suffisante entre l’adoptant et l’adopté pour que ce dernier puisse apparaître comme issu du premier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adopté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "548e8417-43f4-38bd-91b7-7449f669bad8",
                                        "entry_id": "409a32c3-4b73-376d-be70-99a0abe79a8e",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe adopter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "899b0e5e-fb6d-4f20-a274-c438b902a7eb",
                                                "sense_id": "548e8417-43f4-38bd-91b7-7449f669bad8",
                                                "text": "C’est durant ce séjour en province que je décidai de céder à la mode de la barbe, attribut massivement adopté par les artistes parisiens."
                                            },
                                            {
                                                "example_id": "62d79d43-99cf-4b84-8a8b-f7c9810ac72b",
                                                "sense_id": "548e8417-43f4-38bd-91b7-7449f669bad8",
                                                "text": "Héritiers d’un passé multiséculaire et d’une expérience de métissages dont le swahili, à la fois langue et culture, est l’expression, les Comoriens ont adopté l’islam avant de connaître la colonisation française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57c8ed0e-e29d-4e2e-9f66-aa58cac3cde2",
                        "source_entry_id": "ce00030e-38b7-3ee1-9adc-b6547f0aacef",
                        "source_sense_description": "adopted son or daughter",
                        "target_lang_word": "adoptée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adoptée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fdf8d02-1b61-3722-a5e0-6cdba2686c3a",
                                        "entry_id": "f7890be3-8449-334f-abe5-4b8a8f856fcb",
                                        "glosses": [
                                            "Femme adoptée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6777b23-4ed7-4d21-9ae4-b55b26cb01fa",
                                                "sense_id": "2fdf8d02-1b61-3722-a5e0-6cdba2686c3a",
                                                "text": "Cette façon de procéder permet de maintenir à la fois le nom d’origine de l’adoptée et de respecter la loi en ce qu’elle attribue impérativement le nom de l’adoptant à l’adoptée."
                                            }
                                        ]
                                    }
                                ]
                            },
