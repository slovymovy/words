                "senses": [
                    {
                        "sense_id": "7d777e4a-edc8-3e69-8b19-f7adc869f9cd",
                        "entry_id": "750caa73-c333-37ad-801e-efcce67f2b27",
                        "glosses": [
                            "Chauffer au bain-marie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ec8800-0bce-4b9f-8180-a44ce543faa1",
                                "sense_id": "7d777e4a-edc8-3e69-8b19-f7adc869f9cd",
                                "text": "Organisées en chapitres (cuisiner la veille, cuisiner au quotidien, avec les enfants, ou pour recevoir), chaque recette met l'eau à la bouche et donne des envies de « civeter », « bain-mariser », « ragougnasser », comme disait Michel Audiard."
                            },
                            {
                                "example_id": "29e428ce-f955-435b-b6d6-67e1ea72ad89",
                                "sense_id": "7d777e4a-edc8-3e69-8b19-f7adc869f9cd",
                                "text": "Je vois, on civette, on bain-marise, on ragougnasse."
                            },
                            {
                                "example_id": "bb24b68d-8648-470b-89c7-3fb49c4c67fd",
                                "sense_id": "7d777e4a-edc8-3e69-8b19-f7adc869f9cd",
                                "text": "je n'ai pas encore bain-marisé tout ça."
                            },
                            {
                                "example_id": "e8e9ac60-4ffd-4b0a-ab69-f5b7828bc857",
                                "sense_id": "7d777e4a-edc8-3e69-8b19-f7adc869f9cd",
                                "text": "Je bain-marise en râlant, je passe la pâte du bain-marie à la mijoteuse, gentiment prêté par Sealeha, je repasse au bain-marie bien décidé à ne pas tout jeter !!!!."
                            }
                        ]
                    }
