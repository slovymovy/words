        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                "word": "zigoto",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1eecc3d9-363c-4939-935d-1c780afe8f3a",
                        "entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "tags": [
                            "plural"
                        ],
                        "form": "zigotos"
                    },
                    {
                        "form_id": "c1965ccb-3a66-43ec-9b05-3e24c0a07e73",
                        "entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "tags": [],
                        "form": "zigoteau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                        "entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "glosses": [
                            "Individu qui se fait remarquer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5b77cf27-acb4-4d34-9679-35f26032eece",
                                "sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                                "text": "— Faites pas trop les zigotos, disait Billotet. Vous n’êtes pas encore chez vous, vous savez. Jusqu’au départ du train il peut y avoir de l’imprévu. Je vous avertis…"
                            },
                            {
                                "example_id": "0bc5db71-b86e-4b82-b494-1045787a51a9",
                                "sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                                "text": "– Qu’est-ce que vous foutez là ? Débarrassez-nous le plancher ! Qu’est-ce que c’est que ces zigotos ?… furent quelques-unes des expressions employées à notre encontre par des individus de passage."
                            },
                            {
                                "example_id": "634105e2-e04e-48a6-a149-3e64cdbb619e",
                                "sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                                "text": "Les deux zigotos étaient les pistonnés de ce casting et Olivier Kader était le réalisateur en personne de ce spot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9af63a4-a4f2-4894-8c18-9cd50063fc06",
                        "source_entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "source_sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                        "target_lang_word": "vent",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                        "entry_id": "55e7ce03-8c29-31a1-9007-fc842ecfd73a",
                                        "glosses": [
                                            "kerel, man (wordt zowel positieve als in negatieve zin gebruikt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b986a4c-83cc-45fc-a2d6-00cf4b77c13b",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Een toffe gozer, een jofele vent."
                                            },
                                            {
                                                "example_id": "ffb7ae01-9e82-486e-a617-11b79227a808",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Nee, die man van mij, dat is een eitje, een vent van niks!"
                                            },
                                            {
                                                "example_id": "ff6ec868-e1fb-4747-816a-f4bdcaa63723",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Ik dacht bij mezelf dat je naar die vent was teruggegaan."
                                            },
                                            {
                                                "example_id": "21e41708-8e2e-479a-8275-653c0174f37e",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "'Vertel me eens over die vent met wie je op de bruiloft stond te praten?' vervolgde ze met een sluwe blik in haar ogen."
                                            },
                                            {
                                                "example_id": "cf43c7cd-2f77-420f-8333-0606e0e1f72c",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Het was een lange slanke vent van in de veertig, en in tegenstelling tot alle andere hikers was hij glad geschoren met een verzorgde, gezonde uitstraling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b657c214-8dfd-34c8-a0fc-3dfcb2816a72",
                                        "entry_id": "55e7ce03-8c29-31a1-9007-fc842ecfd73a",
                                        "glosses": [
                                            "gecastreerde ezel"
                                        ],
                                        "tags": [
                                            "regionaal in Vlaanderen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a3f239-6cbb-4081-aa92-086cc361b4ca",
                                                "sense_id": "b657c214-8dfd-34c8-a0fc-3dfcb2816a72",
                                                "text": "Maar ze vergeten ondertussen wel dat “vent” oorspronkelijk “gecastreerde ezel” betekent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "baa3e8d3-5602-37c6-946e-fcff6988559f",
                                        "entry_id": "a9d53993-dff4-3583-a81a-05acefb58105",
                                        "glosses": [
                                            "opening waardoor lucht een afgesloten ruimte in of uit kan stromen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9ebc7a-2b2f-4ab8-8da1-1f6d9723540f",
                                                "sense_id": "baa3e8d3-5602-37c6-946e-fcff6988559f",
                                                "text": "In de periode van 23 tot en met 27 augustus 2007 waren er verhoogde acrylonitril (AN)-metingen rond de trein (fabriek) 4 en 5 bij het SNP tankenpark bij Dow in Terneuzen142. Dit bleek te wijten aan een lekkende ERV-pakking van voedingstank 2TV-417 en een defecte N₂ PCV van de 4VE430-tank van trein 4 die continue N₂ aan het suppleren was met als gevolg dat niet alle vents naar de fornuizen gingen, maar dat een deel ook naar buiten ontluchtte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed488560-3083-3bbc-8ddf-80efdf12bb1d",
                                        "entry_id": "9f285a0e-16cd-39c7-addd-aa686a486a78",
                                        "glosses": [
                                            "enkelvoud tegenwoordige tijd van venten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea103e9d-845f-39b9-8b7a-33550cf8846b",
                                        "entry_id": "9f285a0e-16cd-39c7-addd-aa686a486a78",
                                        "glosses": [
                                            "gebiedende wijs van venten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d268d986-7b08-4518-b12b-5ff2d33d75e4",
                                                "sense_id": "ea103e9d-845f-39b9-8b7a-33550cf8846b",
                                                "text": "Nee, ik vent niet meer, ik sta nu op de markt, minder gesjouw weet je ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1f95dc3-d5ac-4838-9219-de942a00fa6d",
                        "source_entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "source_sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                        "target_lang_word": "kerel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cfff3179-1b09-3086-8da6-6683b97202c7",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "vrije man van lage geboorte"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "forse, stevige man (een echte vent)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad8cb33-fdc2-47e3-bc5b-4db9c3fd9b78",
                                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                                "text": "Een brede kerel kwam het pad oplopen met twee grote emmers water in zijn handen."
                                            },
                                            {
                                                "example_id": "655e8ac3-9a3b-460a-a909-1e9e703d7e9e",
                                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                                "text": "Ze waren de onbetwiste heerseressen van de barakken en hielden zonder problemen een twintigtal kerels onder de duim, hoe naar liefde snakkend die zich ook konden gedragen na meerdere maanden in de bergen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ef95a8-cf66-34d3-b640-8abeb6c201d5",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "man, echtgenoot"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "mannelijk persoon"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191e2312-d3b0-4977-bbca-5c297e279ef2",
                                                "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                                                "text": "Hier was duidelijk het verschil in leeftijd te zien: jonge kerels willen alles uitproberen, hoe gevaarlijker hoe beter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b3c8ae0-073a-4ace-aa9d-0bcdc7444f5e",
                        "source_entry_id": "d005a1a5-d35f-3e6e-a410-b5b08dd89061",
                        "source_sense_id": "f76df046-0c5d-33fd-9b58-fddf1c54a17b",
                        "target_lang_word": "rare",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rare",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c823df99-b373-39ba-81ed-4e5e9803eb9e",
                                        "entry_id": "9a6eb347-8c56-3e3d-80d7-7dc73672de7e",
                                        "glosses": [
                                            "verbogen vorm van de stellende trap van raar"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc779e25-c61b-4936-ae17-3b3226245698",
                                                "sense_id": "c823df99-b373-39ba-81ed-4e5e9803eb9e",
                                                "text": "Toen ook de kinderen mijn rare plan accepteerden stonden alle lichten ineens op groen."
                                            },
                                            {
                                                "example_id": "0dc3d35a-2619-458a-90be-2fd70976f6bb",
                                                "sense_id": "c823df99-b373-39ba-81ed-4e5e9803eb9e",
                                                "text": "Het rare was dat het zwevende meisje, hoewel ze geen lichaam had, helemaal niet dood leek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rare",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                                        "entry_id": "075957ed-209e-30e3-9778-ca4fb4f97ca5",
                                        "glosses": [
                                            "licht iemand die vreemd gedrag vertoont"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06482555-dff9-43ad-82da-bf8d9bc96e25",
                                                "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                                                "text": "De tijd dat mensen die er anders uitzagen of anders tegen de wereld aankeken door de goegemeente beschouwd werden als outcasts of ‘die rare’, is voorgoed voorbij."
                                            },
                                            {
                                                "example_id": "481b4d6b-d422-45c4-bb3e-8f957535a926",
                                                "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                                                "text": "'Jullie zijn een stelletje raren geworden hier op IJsland ... iedereen heeft het maar over “onrechtvaardigheid” en “maatschappij”. Het zou geen kwaad kunnen als je uitlegt wat je bedoeld."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rare",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3db23272-b66e-3c5f-8d0a-822863e75da3",
                                        "entry_id": "f8103815-9cd4-3c17-a446-fc31d6589ec6",
                                        "glosses": [
                                            "licht gebakken, zodat het van binnen nog bloedrood is"
                                        ],
                                        "tags": [
                                            "van vlees, in het bijzonder biefstuk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c091e5a3-2126-49c5-a4ea-717a158ce908",
                                                "sense_id": "3db23272-b66e-3c5f-8d0a-822863e75da3",
                                                "text": "Ga jij voor doorbakken of rosé? Door te voelen aan het vlees kan je bepalen of jouw biefstukje de juiste gaarheid heeft. Zet je duim en wijsvinger op elkaar en voel aan de muis van je hand. Dit veert nu net zoveel als een biefstuk die rare is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
