        "nl-extract.jsonl": [
            {
                "entry_id": "2a0f547f-70d5-3abc-b959-578c61e1263e",
                "word": "wakend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5e26587-734b-36be-bfdc-3844fc1bf9dd",
                        "entry_id": "2a0f547f-70d5-3abc-b959-578c61e1263e",
                        "glosses": [
                            "wakker zijnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83579420-dab8-4bd8-8f3b-a361b2bd5d3d",
                                "sense_id": "a5e26587-734b-36be-bfdc-3844fc1bf9dd",
                                "text": "Dit deed ze in drie condities: terwijl de patiënten klaarwakker waren, terwijl ze in een lichte roes verkeerden en nog eens tijdens een diepe slaap. Gondek ontdekte dat in wakende toestand andere gebieden reageren dan tijdens het slapen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e70d7d2-a649-38ab-928f-26a01d8fea24",
                        "entry_id": "2a0f547f-70d5-3abc-b959-578c61e1263e",
                        "glosses": [
                            "de wacht houdend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17e1c19-4de2-4b73-9d46-05af5868a4c6",
                                "sense_id": "4e70d7d2-a649-38ab-928f-26a01d8fea24",
                                "text": "In overleg met de politie en het openbaar ministerie heeft de gemeente Borne besloten het cameratoezicht bij het NS-station nog met drie jaar te verlengen. Pas daarna wordt geëvalueerd en beslist of de wakende ogen zin hebben gehad in verband met het terugdringen van misdrijven in deze omgeving."
                            },
                            {
                                "example_id": "225e8783-b55e-4e2d-83f2-4b6862fa0ca3",
                                "sense_id": "4e70d7d2-a649-38ab-928f-26a01d8fea24",
                                "text": "Na zijn aanhouding moest de verdachte docent 17.500 euro borg betalen. Hij zat thuis met een enkelband, onder wakend oog van vijf ‘toezichthouders’. Hij mocht in die tijd geen contact onderhouden met kinderen."
                            }
                        ]
                    }
