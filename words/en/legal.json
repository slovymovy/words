                    "sense_id": "e84e847b-1fc3-3ea1-8555-3fe5cc724efe",
                    "sense_definition": "Permitted, required, or established by law.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lawfulness",
                    "name_type": "no",
                    "examples": [
