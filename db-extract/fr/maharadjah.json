                        ],
                        "examples": [
                            {
                                "example_id": "e6c0d43b-68d8-48ec-9068-c2d7f8c17ca8",
                                "sense_id": "80e12193-1e87-3dae-a857-e24d52138f94",
                                "text": "Embarrassé, Wood haussa les épaules, puis désigna le jeune maharadjah à l’autre bout de la table."
                            },
                            {
                                "example_id": "8819f303-2d1d-4cb4-afb7-b223e0ab6a5c",
                                "sense_id": "80e12193-1e87-3dae-a857-e24d52138f94",
                                "text": "Quant à moi, je me contentai d’un nouveau feutre gris, pour mes rares sorties aux alentours immédiats du terrain vague où nous étions enclos, et je laissai la gestion de la bourse aux bons soins de Barnie, qui, comme à son habitude, l’administrait avec parcimonie, tout en nous faisant croire que nous avions autant d’argent qu'un Maharadjah."
                            }
                        ]
                    }
