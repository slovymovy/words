                        "entry_id": "8a86a86e-790e-3682-a757-98482ae63b51",
                        "glosses": [
                            "A measuring rod that is one foot long."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b12870-b1ba-4184-a1fe-f0efca753554",
                                "sense_id": "a5ca6215-2adb-3ce9-8e5f-55c377c2e55a",
                                "text": "Every time, the bricklayers have to use their footstick to check whether the right height has been reached."
                            }
                        ]
                    },
                    {
                        "sense_id": "d11a310d-445b-35c7-a38c-39e0ea420801",
                        "entry_id": "8a86a86e-790e-3682-a757-98482ae63b51",
                        "glosses": [
                            "A piece of wood serving as a simple bridge over water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ddf106-68ea-4c43-a530-b3687f015bfa",
                                "sense_id": "d11a310d-445b-35c7-a38c-39e0ea420801",
                                "text": "The wee man crossed the footstick to where Johnny was and took him back over to his side."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a4ed1a4-4518-35dd-bb24-4cad25672cb1",
                        "entry_id": "8a86a86e-790e-3682-a757-98482ae63b51",
                        "glosses": [
                            "A sloped or beveled piece of wood or metal placed against the foot of a page that is being typeset, and locked in place by quoins."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b2b2b372-e090-43a7-9394-d4904319a68c",
                                "sense_id": "9a4ed1a4-4518-35dd-bb24-4cad25672cb1",
                                "text": "The footsticks may be a trifle shorter than the width of two pages and the gutter; for as there should always be a line of quadrats, or a reglet cut to measure, at the foot of each page, the footstick may be a pica shorter without danger, on this account, of any thing falling out, when the form is lifted and it thus prevents the side and foot sticks from binding when locked up."
                            },
                            {
                                "example_id": "e4e69a8f-3860-433b-9714-7f246af6ba18",
                                "sense_id": "9a4ed1a4-4518-35dd-bb24-4cad25672cb1",
                                "text": "Neither the sidestick nor the footstick should project beyond the other, as it will prevent the quoins from passing, and in unlocking will give a great deal of trouble."
                            },
                            {
                                "example_id": "307ae266-ea66-4d2b-adb5-0400cca683a1",
                                "sense_id": "9a4ed1a4-4518-35dd-bb24-4cad25672cb1",
                                "text": "In using common footsticks and sidesticks, however, the broad part of the sidestick would be at the top left-hand corner of the left side section of the forme, and the broad part of the footstick at the lower right-hand corner."
                            }
                        ]
                    }
