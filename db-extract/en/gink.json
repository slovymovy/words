                ],
                "senses": [
                    {
                        "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                        "entry_id": "a00fcca4-cac9-35b9-a90e-6e8aa981994e",
                        "glosses": [
                            "A guy, a fellow, especially (derogatory) a foolish, unworldly, or socially inept man; a goof."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a53c5da-a304-48ba-bb62-76d96c39759a",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "You know, I've always thought that the best man in the world is hardly good enough for any woman. But when it comes to the best girl in all the universe caring for an ordinary gink like me, well, you'll have to let me get used to it."
                            },
                            {
                                "example_id": "d57ba007-2dc9-488c-978e-04e1e175b1d0",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "[…]so if any of you ginks are me frien's yeh better keep outen here so's yeh won't get hurted[…]"
                            },
                            {
                                "example_id": "f04384c4-9410-4bd6-9ff0-87f49d4c23c8",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "Don't see a movie in it myself, but those Hollywood ginks will take anything."
                            },
                            {
                                "example_id": "4e6e1da3-0b55-409b-9948-8b2fcb37dd06",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "[Asian sage:] You have a great, great fear of Officer Pupp. Ain't you, mouse? / [Ignatz:] Yes. / [Asian sage:] I can tell you how to overcome it. / [Ignatz:] Tell me. / [Asian sage:] Gimme dime, I tell. / [Ignatz:] Here it is. / [Asian sage, walking away from an aghast Ignatz:] Don't be afraid of the big gink. / [Officer Pupp, incoming:] Gink? What gink?"
                            },
                            {
                                "example_id": "fc621dcb-df50-4df2-a8fc-7ece1be024e2",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "No wonder the country's on its bloody knees! You ginks are a bloody disgrace to the human race!"
                            },
                            {
                                "example_id": "3139e60f-9aa7-4d6f-87cf-1c449d4e3708",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "This stuff ain't going to help me in August. The summer ginks come down here in June."
                            },
                            {
                                "example_id": "27222e02-0685-41a8-aa45-dea6778bc579",
                                "sense_id": "ac60b0da-802b-3aef-bc92-bac165020ff2",
                                "text": "Adrian felt that it was he who had brought Tom into notice and popularity, that Tom was his own special creation. The silent spotty gink of the first year had been transformed into someone admired and imitated and Adrian wasn't sure how much he liked it."
                            }
                        ]
                    }
