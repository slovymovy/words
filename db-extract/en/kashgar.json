                                            {
                                                "example_id": "61c7e1d0-456b-40ad-a1fb-f4d46ddef078",
                                                "sense_id": "5594b127-ee37-38a7-97f9-797b28b9488e",
                                                "text": "N’ayant pas trouvé proie à ses griffes, Nasr Khan saisit à pleines mains ses robes d’apparat, les ôte l’une après l’autre, les projette, rageur, sur le sol, les foule aux pieds en hurlant, sonores dans son dialecte turco-mongol de Kashgar, des chapelets d’injures."
                                            }
