                "senses": [
                    {
                        "sense_id": "759999b0-beb9-3ed3-b4f3-4c2dd8869d44",
                        "entry_id": "d75f0707-cdc6-38df-9e75-9da679e78d93",
                        "glosses": [
                            "Se reconnaître soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecfbf2ef-185a-41f5-8314-fdd85d15c271",
                                "sense_id": "759999b0-beb9-3ed3-b4f3-4c2dd8869d44",
                                "text": "Elle va donc apprendre à s'auto-aimer, s'auto-reconnaître, étape incontournable pour construire une bonne estime de soi, pour se construire."
                            },
                            {
                                "example_id": "a7684cf2-4405-489e-bf68-27028afe0d6c",
                                "sense_id": "759999b0-beb9-3ed3-b4f3-4c2dd8869d44",
                                "text": "Il aide aussi le patient à s'auto-reconnaître et à prendre conscience de lui-même."
                            },
                            {
                                "example_id": "46c3f85e-e7ae-440d-8358-6494da9950ba",
                                "sense_id": "759999b0-beb9-3ed3-b4f3-4c2dd8869d44",
                                "text": "On admire en fait la capacité de l'autre à s'auto-reconnaître, c'est quelqu'un qui a de la \"personnalité\"."
                            }
                        ]
                    }
