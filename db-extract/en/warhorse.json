                                "target_senses": [
                                    {
                                        "sense_id": "e32efeff-2b34-3281-befe-cfefb1dd176a",
                                        "entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                                        "glosses": [
                                            "im 17. Jahrhundert benutzter Degen mit zwei Schneiden zum Hauen und Schlagen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                        "entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                                        "glosses": [
                                            "übertragen von der Waffe: Soldat mit Kampferfahrungen, der sich durch seine verwegene und draufgängerische Art auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a7ecae-3067-4ab8-aebf-e15c45fc3e84",
                                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                                "text": "Mein Großvater war ein alter Haudegen."
                                            },
                                            {
                                                "example_id": "0bab1cbf-90af-4863-aba6-d388782f99c6",
                                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                                "text": "„Als ich dem Burschen den Brief zeigte und ihm seine Lüge vorwarf, erklärte er mir, er wäre so gern in das Heer eingetreten und habe geglaubt, er müsse sich dann als Haudegen aufspielen; ich möge ihm doch verzeihen, auch wegen des Märchens, daß ihm seine Mutter Geld schicken werde.“"
                                            },
                                            {
                                                "example_id": "7eded791-4bc3-4b18-b118-9b51a48b3079",
                                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                                "text": "„Nach der Machtübertragung setzte Hitler den Haudegen als Reichskommissar in Bayern ein, kurz darauf als Reichsleiter des Kolonialpolitischen Amtes der NSDAP.“"
                                            },
                                            {
                                                "example_id": "038080e0-9ea2-4a95-af22-08300b3a54c4",
                                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                                "text": "„Interessant, dass der vermeintliche Repräsentant des Rokoko den Ton des hexenverlassnen und von Prophezeiungen genarrten Haudegens, der in der Poesie der Stelle aufbewahrt ist, trifft, der Romantiker dem Gescheiterten, der Zuflucht in poetischer Kaltschnäuzigkeit sucht, ein Wortkleid überstreift, das wunderschön ist, aber doch weiter vom englischen Original.“"
                                            },
                                            {
                                                "example_id": "e3cb0345-e2a0-4991-9534-648cf58e9efe",
                                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                                "text": "„Aber der Prophet fühlte sich in der festen Burg seines Gottes und in der Wartburg des sächsischen Kurfürsten sicherer als im Gemäuer eines ritterlichen Haudegens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
