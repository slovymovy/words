                        ],
                        "examples": [
                            {
                                "example_id": "624d64f0-2fe7-495f-9bad-144377a23f9c",
                                "sense_id": "3b772f57-4a90-340a-9c76-b7d7e6bba809",
                                "text": "For, in the morning one of the Hottentots found at some distance from our station, the remains of a kaama or hartebeest, which had been devoured by a lion [...]."
                            },
                            {
                                "example_id": "5334de84-1a23-485a-9e72-904eeb126916",
                                "sense_id": "3b772f57-4a90-340a-9c76-b7d7e6bba809",
                                "text": "Very great numbers of the large game, buffaloes, zebras, giraffes, tsessébes, kamas or hartebeests, kokongs or gnus, pallahs, rhinoceroses, etc., congregated at some fountains near Kolobeng, and the trap called ‘hopo’ was constructed, in the lands adjacent, for their destruction."
                            }
                        ]
