                ],
                "senses": [
                    {
                        "sense_id": "2e0568e8-1f13-3bdb-b176-6a1b45ffffdb",
                        "entry_id": "8682715a-a2e9-3373-a339-238f7470da58",
                        "glosses": [
                            "een hoeveelheid vuur die als een hoge kolom de lucht in schiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9843f18f-7809-4a8a-9016-b4167685dd46",
                                "sense_id": "2e0568e8-1f13-3bdb-b176-6a1b45ffffdb",
                                "text": "Opeens schiet er een vuurzuil uit de grond omhoog, gevolgd door een regen van stof en puin."
                            },
                            {
                                "example_id": "b4b19ef0-0b04-4666-bc67-65a2f0d00030",
                                "sense_id": "2e0568e8-1f13-3bdb-b176-6a1b45ffffdb",
                                "text": "De beelden van het vreugdevuur op het Scheveningse strand worden plotseling angstaanjagend. Een oranje slurf kringelt omhoog uit de reusachtige vuurzuil, maakt zich los van de brandstapel en begint te zweven boven het zand. Dan komt er nog zo’n vuurslurf, en dan weer een, en allemaal bewegen ze in de richting van de duinen."
                            },
                            {
                                "example_id": "6642cf7d-63cd-468a-9deb-bb791d38ea9f",
                                "sense_id": "2e0568e8-1f13-3bdb-b176-6a1b45ffffdb",
                                "text": "De vuurzuil kleurde de lucht boven de tribunes een paar seconden oranje. Een magisch moment. Sommige tegenstanders werden bang en raakten de kluts kwijt, terwijl wij dachten: hiervoor doen we het allemaal, hier horen wij bij.’"
                            }
                        ]
                    }
                ],
