                                                "sense_id": "6e843003-4e11-3002-8526-e7b654745e79",
                                                "text": "„Wir hängten uns an den Geleitzug wieder an und schössen am nächsten Tage aus ihm einen weiteren großen Burschen heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fe94a5d8-7cf4-345f-b9cc-6e0c104c0360",
                                        "entry_id": "47538c45-272e-3150-aa5c-925c666edcc2",
