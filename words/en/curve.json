{
    "word_family": [
        "curved",
        "curvy",
        "curvature",
        "curvaceous",
        "recurver",
        "incurvate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93767882-1c7f-38ba-9063-894a1b345f9c",
                    "sense_definition": "A gentle bend or turn, especially in a road or path.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should slow down when approaching a sharp <w>curve</w> in the road.",
                            "target_lang_translations": {
                                "ru": "Вам следует притормозить при приближении к крутому <w>изгибу</w> дороги."
                            }
                        },
                        {
                            "text": "The car followed the <w>curve</w> of the river as we drove through the valley.",
                            "target_lang_translations": {
                                "ru": "Машина следовала за <w>изгибом</w> реки, пока мы ехали через долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "turn",
                        "arc"
                    ],
                    "antonyms": [
                        "straightaway"
                    ],
                    "common_phrases": [
                        "sharp curve",
                        "gentle curve",
                        "road curve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавный изгиб или поворот, особенно на дороге или тропинке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изги́б",
                                "target_lang_sense_clarification": "плавное искривление"
                            },
                            {
                                "target_lang_word": "поворо́т",
                                "target_lang_sense_clarification": "место изменения направления дороги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0cc5df-7c32-372c-919b-e565687c0b8d",
                    "sense_definition": "A line or surface that bends continuously without any straight parts or angles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully drew a smooth <w>curve</w> on the paper to represent the hill.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно нарисовала на бумаге плавную <w>кривую</w>, чтобы изобразить холм."
                            }
                        },
                        {
                            "text": "The architect designed the building with a beautiful <w>curve</w> along the roof.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал здание с красивым <w>изгибом</w> вдоль крыши."
                            }
                        }
                    ],
                    "synonyms": [
                        "arc",
                        "contour"
                    ],
                    "antonyms": [
                        "straight line"
                    ],
                    "common_phrases": [
                        "smooth curve",
                        "closed curve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия или поверхность, которая непрерывно изгибается без прямых участков или углов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крива́я",
                                "target_lang_sense_clarification": "геометрическая линия"
                            },
                            {
                                "target_lang_word": "дуга́",
                                "target_lang_sense_clarification": "часть окружности или кривой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd42f05-4f18-35bd-9004-38a7e0321ec2",
                    "sense_definition": "The rounded and attractive shape of a person's body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress was designed to highlight every <w>curve</w> of her figure.",
                            "target_lang_translations": {
                                "ru": "Платье было создано так, чтобы подчеркнуть каждый <w>изгиб</w> её фигуры."
                            }
                        },
                        {
                            "text": "She felt confident and proud of her natural <w>curves</w>.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя уверенно и гордилась своими естественными <w>формами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "contours",
                        "outline"
                    ],
                    "common_phrases": [
                        "natural curves",
                        "feminine curves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Округлые и привлекательные очертания человеческого тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изги́б",
                                "target_lang_sense_clarification": "очертания фигуры"
                            },
                            {
                                "target_lang_word": "фо́рмы",
                                "target_lang_sense_clarification": "женственные очертания тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c742ee13-80c3-3da6-8c41-59564e923bbf",
                    "sense_definition": "A system of grading where student scores are adjusted based on the overall performance of the group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor decided to grade the final exam on a <w>curve</w> because it was so difficult.",
                            "target_lang_translations": {
                                "ru": "Профессор решил выставлять оценки за экзамен по <w>кривой</w>, потому что он был очень сложным."
                            }
                        },
                        {
                            "text": "If you grade on a <w>curve</w>, the highest score in the class becomes the new top mark.",
                            "target_lang_translations": {
                                "ru": "Если вы оцениваете по <w>кривой</w>, самый высокий балл в классе становится новой высшей оценкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "bell curve"
                    ],
                    "common_phrases": [
                        "grade on a curve"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система оценивания, при которой баллы студентов корректируются в зависимости от общей успеваемости группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крива́я",
                                "target_lang_sense_clarification": "в контексте распределения оценок"
                            },
                            {
                                "target_lang_word": "систе́ма относи́тельных оце́нок",
                                "target_lang_sense_clarification": "метод оценивания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69d720c6-c906-3bf9-9307-700eb2c0a943",
                    "sense_definition": "A mathematical graph representing a continuous map or a polynomial relation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student plotted the algebraic <w>curve</w> using the coordinates provided in the textbook.",
                            "target_lang_translations": {
                                "ru": "Студент построил алгебраическую <w>кривую</w>, используя координаты из учебника."
                            }
                        },
                        {
                            "text": "We analyzed the growth <w>curve</w> to determine the rate of change over time.",
                            "target_lang_translations": {
                                "ru": "Мы проанализировали <w>кривую</w> роста, чтобы определить скорость изменений во времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "graph",
                        "plot"
                    ],
                    "common_phrases": [
                        "learning curve",
                        "growth curve",
                        "algebraic curve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический график, представляющий непрерывное отображение или полиномиальное отношение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крива́я",
                                "target_lang_sense_clarification": "математический график"
                            },
                            {
                                "target_lang_word": "гра́фик",
                                "target_lang_sense_clarification": "визуальное представление функции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d28bcc2b-c15f-3c91-affb-298b0142e3fd",
                    "sense_definition": "To move or extend in a shape that is not straight; to bend gradually.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow road <w>curves</w> to the right just after the old bridge.",
                            "target_lang_translations": {
                                "ru": "Узкая дорога <w>изгибается</w> вправо сразу за старым мостом."
                            }
                        },
                        {
                            "text": "The shoreline <w>curves</w> gently around the bay, creating a natural harbor.",
                            "target_lang_translations": {
                                "ru": "Береговая линия плавно <w>изгибается</w> вокруг залива, образуя естественную гавань."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "turn",
                        "arc",
                        "wind"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "curve to the right",
                        "curve around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или тянуться по траектории, которая не является прямой; постепенно изгибаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгиба́ться",
                                "target_lang_sense_clarification": "принимать форму дуги"
                            },
                            {
                                "target_lang_word": "петля́ть",
                                "target_lang_sense_clarification": "о дороге или реке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "497f98ac-3a52-349b-9154-8f83936c12aa",
                    "sense_definition": "To cause something to bend or take a curved shape.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used his hands to <w>curve</w> the wire into the shape of a bird.",
                            "target_lang_translations": {
                                "ru": "Художник руками <w>изогнул</w> проволоку, придав ей форму птицы."
                            }
                        },
                        {
                            "text": "You need to <w>curve</w> the pipe carefully so that it doesn't break.",
                            "target_lang_translations": {
                                "ru": "Нужно осторожно <w>согнуть</w> трубу, чтобы она не сломалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "arch",
                        "flex"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "curve a line",
                        "curve a pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо согнуться или принять изогнутую форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгиба́ть",
                                "target_lang_sense_clarification": "придавать дугообразную форму"
                            },
                            {
                                "target_lang_word": "гнуть",
                                "target_lang_sense_clarification": "деформировать, придавая кривизну"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96418a82-8d8c-3c7c-b453-de0a819b2cb6",
                    "sense_definition": "To cause a moving object, like a ball, to deviate from a straight path.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher managed to <w>curve</w> the ball so much that the batter missed it completely.",
                            "target_lang_translations": {
                                "ru": "Питчеру удалось так сильно <w>закрутить</w> мяч, что бьющий полностью промахнулся."
                            }
                        },
                        {
                            "text": "He learned how to <w>curve</w> the ball in pitching it during summer camp.",
                            "target_lang_translations": {
                                "ru": "В летнем лагере он научился <w>подкручивать</w> мяч при подаче."
                            }
                        }
                    ],
                    "synonyms": [
                        "swerve",
                        "deviate",
                        "arc"
                    ],
                    "common_phrases": [
                        "curve a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять движущийся объект, например мяч, отклоняться от прямой траектории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закру́чивать",
                                "target_lang_sense_clarification": "придавать мячу вращение и кривизну"
                            },
                            {
                                "target_lang_word": "подкру́чивать",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4b01a76-5e03-3b81-b81e-b29c56117cb1",
                    "sense_definition": "To reject or turn down someone's romantic advances or interest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to ask her out, but she totally <w>curved</w> him.",
                            "target_lang_translations": {
                                "ru": "Он пытался пригласить её на свидание, но она его полностью <w>отшила</w>."
                            }
                        },
                        {
                            "text": "I was once <w>curved</w> three times by the same woman before I took the hint.",
                            "target_lang_translations": {
                                "ru": "Одна и та же женщина трижды меня <w>прокатывала</w>, прежде чем я понял намек."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "snub",
                        "rebuff"
                    ],
                    "antonyms": [
                        "accept"
                    ],
                    "common_phrases": [
                        "get curved"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal social context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отвергать или отклонять чьи-либо романтические ухаживания или интерес."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отшива́ть",
                                "target_lang_sense_clarification": "грубо отказывать в знакомстве"
                            },
                            {
                                "target_lang_word": "прока́тывать",
                                "target_lang_sense_clarification": "оставлять без внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3da0aabd-80b7-3109-9a3a-3cfa02457f58",
                    "sense_definition": "Having a shape that is bent or rounded; not straight.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer preferred a <w>curve</w> line over a straight one for the logo.",
                            "target_lang_translations": {
                                "ru": "Дизайнер предпочел <w>изогнутую</w> линию прямой для логотипа."
                            }
                        },
                        {
                            "text": "The light reflected off the <w>curve</w> surface of the polished metal bowl.",
                            "target_lang_translations": {
                                "ru": "Свет отражался от <w>изогнутой</w> поверхности полированной металлической чаши."
                            }
                        }
                    ],
                    "synonyms": [
                        "curved",
                        "bent",
                        "rounded"
                    ],
                    "antonyms": [
                        "straight",
                        "angular"
                    ],
                    "common_phrases": [
                        "curve line",
                        "curve surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий изогнутую или округлую форму; не прямой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изо́гнутый",
                                "target_lang_sense_clarification": "имеющий форму дуги"
                            },
                            {
                                "target_lang_word": "криво́й",
                                "target_lang_sense_clarification": "не прямой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}