                "senses": [
                    {
                        "sense_id": "8a0045b6-b245-3db4-b331-1bae195bef68",
                        "entry_id": "d4cd9a62-f3a7-3c41-b27e-7a681f5f0a34",
                        "glosses": [
                            "durch Erhitzen (Schmelzen) in zwei Teile zerfallen, zerstört werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58d36028-809f-4609-b294-9ccdf8b1e2dc",
                                "sense_id": "8a0045b6-b245-3db4-b331-1bae195bef68",
                                "text": "Die Hauptsicherung beziehungsweise ein Sicherungskabel schmilzt durch, wodurch ein Fahrzeugbrand verhindert wird."
                            },
                            {
                                "example_id": "4ab48841-1446-4ef7-ac12-6526490e6fcc",
                                "sense_id": "8a0045b6-b245-3db4-b331-1bae195bef68",
                                "text": "„Die befürchtete Kernschmelze trat ein, die Brennstäbe verflüssigten sich, und die Betonplatte des Reaktorbodens schmolz durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
