                "senses": [
                    {
                        "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                        "entry_id": "b657e07f-7613-3331-a179-8db553f372d9",
                        "glosses": [
                            "(vor Gott geleistetes) Versprechen, auf sexuelle Beziehungen zu verzichten und nicht zu heiraten"
                        ],
                        "tags": [
                            "bes.",
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "95d64f5b-ac26-4380-bf01-93a32b60bbd3",
                                "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                                "text": "Nonnen und Mönche leisten ein Zölibatsgelübde."
                            },
                            {
                                "example_id": "951f3917-9e61-4474-b32b-5a1d538e8c3b",
                                "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                                "text": "„So wie das Zölibatsgelübde einen Mann nicht daran hindert, Kinder zu zeugen, so halten Soutane und Kruzifix ihn nicht davon ab, in der Schlacht erfolgreich zu sein.“"
                            },
                            {
                                "example_id": "44b80a24-3f4c-4bf4-939c-ed8a12b4f3f1",
                                "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                                "text": "„Als besondere Herausforderung empfand der niedere Klerus die Anordnung aus Rom, künftig am Gründonnerstag alljährlich die Gehorsams- und Zölibatsgelübde erneuern zu lassen; […]“"
                            },
                            {
                                "example_id": "749a6a72-a74d-4aae-8ae7-629f439bbe64",
                                "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                                "text": "„Das sexuelle Verlangen wird als allgemein menschliche Schwachheit und Nötigung angesehen, der ein biblischer Ehe-Befehl korrespondiert, durch den das Zölibatsgelübde hinfällig wird.“"
                            },
                            {
                                "example_id": "6895f4ad-8615-4171-b7be-2e033fac30ef",
                                "sense_id": "277461ac-d168-3ade-b0fe-232399a136fd",
                                "text": "„‚Die allgemein akzeptierte Offenheit in Fragen der Sexualität stellt die Verleugnung der Sexualität in Frage, die für viele Zölibatäre notwendig ist, um ihr Zölibatsgelübde einhalten zu können.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
