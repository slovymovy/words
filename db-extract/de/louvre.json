                "senses": [
                    {
                        "sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                        "entry_id": "8fd05f8f-89c6-3598-9023-bf17480b06fc",
                        "glosses": [
                            "ehemaliger Palast in Paris, heute größtenteils ein Museum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611e5e9a-1f5a-4a41-a362-7d8131bcf2d4",
                                "sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                                "text": "„Zur Betonung ihres Anspruchs hat die Stadt an der Amstel beim Umbau des Rijksmuseums der Nachtwache eine spektakuläre Bühne geschaffen. Damit beabsichtigt sie nichts anderes als der Pariser Louvre mit seiner Mona Lisa, nämlich Besucher anzulocken wie ein Zwetschgendatschi die Wespen.“"
                            },
                            {
                                "example_id": "55a6747b-365b-4549-86a6-840070099093",
                                "sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                                "text": "„Das ist der Louvre von Toledo, der große königliche Palast, in dem der Maurenkönig wphnte.“"
                            },
                            {
                                "example_id": "2e7eaa22-ee99-4b45-aaa9-d2ba5766ba9e",
                                "sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                                "text": "„Clerfayt fuhr am Louvre entlang, an der Conciergerie vorbei und über die Brücke des Boulvard St.-Michel.“"
                            },
                            {
                                "example_id": "4514765b-af63-4d28-b61b-7b38593f623d",
                                "sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                                "text": "„\"Zünd den Louvre an\", sagt der Mechaniker, \"und wisch dir den Arsch mit der Mona Lisa ab. Auf diese Weise kennt Gott wenigstens unsere Namen.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a20c402-e4b8-4b7f-850b-5217fab05009",
                        "source_entry_id": "8fd05f8f-89c6-3598-9023-bf17480b06fc",
                        "source_sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                        "source_sense_description": "ehemaliger Palast in Paris, heute größtenteils ein Museum",
                        "target_lang_word": "Louvre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Louvre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                        "entry_id": "89f8c30a-1bd6-3f4d-bc9c-91c06c974330",
                                        "glosses": [
                                            "A famous art museum and former royal palace in Paris, France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc17b8e-56e4-45e9-86e2-318a17f705fb",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "God above, this man was as chiseled as the statues she'd spied in the Louvre."
                                            },
                                            {
                                                "example_id": "020e3a9c-699d-4a8b-b3f3-97b633eb9f26",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "I don't care if your split, power or squat position looks like it should be in the Louvre, you won't jerk a thing."
                                            },
                                            {
                                                "example_id": "9225fa1b-5c06-48bb-96e8-f484a06e7814",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "I preferred the Dutch apple pie, and my waitress for those few years had legs that belonged in the Louvre."
                                            },
                                            {
                                                "example_id": "ebac682f-ec4f-4be3-980c-4e38d533f651",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "IF YOU ARE a young Joe DiMaggio or Mickey Mantle with a swing that belongs in the Louvre, somebody might get the idea you could win a batting title, even if it was only your second year with the New York Yankees."
                                            },
                                            {
                                                "example_id": "d76812ed-1431-46da-8571-5c64c89f7f78",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "For purposes of illustrating a lecture on calisthenics, a stick figure is a better picture of a squatting man than something from the Louvre."
                                            },
                                            {
                                                "example_id": "b3ada29e-8b8b-46ed-9999-aa10556eaa1a",
                                                "sense_id": "5edf095f-2284-33ec-b902-f3bfbe02f57a",
                                                "text": "They are cries which show that every one has his own place, and should stay in it, — M. de Guise in the streets, and you in the Louvre. Go to the Louvre, Sire; go to the Louvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f756acf-5498-41bc-89b5-8ce98f79847e",
                        "source_entry_id": "8fd05f8f-89c6-3598-9023-bf17480b06fc",
                        "source_sense_id": "2db99cb5-ba14-31a6-a30e-e4f70af849dd",
                        "source_sense_description": "ehemaliger Palast in Paris, heute größtenteils ein Museum",
                        "target_lang_word": "Louvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Louvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                        "entry_id": "24fa7d43-4c77-3b6e-adb4-ef3122f39213",
                                        "glosses": [
                                            "Palais royal de Paris, devenu musée national."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf14318-d87a-4db4-a77e-46ccd735b623",
                                                "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                                "text": "Le lundi, dix-huitième jour du mois d’août 1572, il y avait grande fête au Louvre.\nLes fenêtres de la vieille demeure royale, ordinairement si sombres, étaient ardemment éclairées."
                                            },
                                            {
                                                "example_id": "1ced47d8-7c9e-47cb-bf68-1acee007aeaa",
                                                "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                                "text": "Après tout, vous avez raison, pourquoi n’irait-on pas au Louvre, surtout par les jours froids, comme il en fait un aujourd’hui ? Les salles y sont spacieuses, chauffées. Et puis il y a les gens qu’on y rencontre. De belles Londoniennes, d’abord, en étoffes bourrues, avec des gants amples, des souliers ronds — flanquées de leurs tristes époux. Et des Allemandes vêtues… ah vêtues comme les dames d’Hildburghausen ; sans omettre ces singuliers maris à lunettes, coiffés de vert, qu’elles ont. — Quelques Parisiens, aussi, rares comme la véritable amitié. Pour ne rien dire de ces provinciaux ahuris, dont parla jadis M. Élémir Bourges, et qui cherchent en vain, à travers les salles du Louvre, les magasins du même nom. Mais ce qu’il n’y a jamais, à moins de l’amener comme je fais aujourd’hui, c’est une Parigote un peu pelucheuse, caressante à l’œil, et qui glisse sans bruit sur les parquets ou les vastes dalles."
                                            },
                                            {
                                                "example_id": "9361a8b5-eacc-491a-9e3d-9c9945f7c2cc",
                                                "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                                "text": "Notre Louvre n’est qu’un fouillis, par rapport aux musées de Bruxelles, d’Amsterdam et d’Harlem. J’en dirai autant de la National Gallery de Londres."
                                            },
                                            {
                                                "example_id": "f398d34e-5c59-4390-bc86-e7f321a88d74",
                                                "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                                "text": "— Qui a eu l’idée de collectionner tout ça ? demanda Hedwige.\n— La Renaissance, la Convention et le second Empire, répondit Pierre. Le Louvre leur doit tout. Ce sont les mauvaises époques qui font les bonnes collections."
                                            },
                                            {
                                                "example_id": "94a705ca-fe68-48ad-9fcd-e2770d3c8aa6",
                                                "sense_id": "e65ae8a7-c9c9-3900-ad32-0f1aef19b557",
                                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b835509e-e9e8-37ef-b270-eca54cb28e93",
                                        "entry_id": "24fa7d43-4c77-3b6e-adb4-ef3122f39213",
                                        "glosses": [
                                            "Premier arrondissement de Paris."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745e5ab9-32b6-4b0c-9b08-ad1c95fa6885",
                                                "sense_id": "b835509e-e9e8-37ef-b270-eca54cb28e93",
                                                "text": "Dans le groupe du centre l'immigration l'emporte avec un excédent de plus de 32.000 unités (près de 3%) ; il n'y a excédent d'émigration que dans les IIIᵉ, VIᵉ et IXᵉ arrondissements (Bourse, Luxembourg et Opéra). L'immigration est insignifiante dans le VIIᵉ (Palais-Bourbon), légère encore dans le IIIᵉ (le Temple), mais plus sensible déjà dans certains arrondissements purement centraux, le IVᵉ (Hôtel-de-Ville) et le Iᵉʳ (Louvre). Le maximum est donné par le Vᵉ (Panthéon) sur la rive gauche et le XIᵉ (Popincourt) sur la rive droite, avec un taux de plus de 9 % : tous deux confinent du reste aux limites de l'ancien Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbef7c4-5fe8-3727-877c-c85e22144d7f",
                                        "entry_id": "24fa7d43-4c77-3b6e-adb4-ef3122f39213",
                                        "glosses": [
                                            "Quelque grande exposition de peintures."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6014d2-a953-42cc-ac73-ec0492920a32",
                                                "sense_id": "abbef7c4-5fe8-3727-877c-c85e22144d7f",
                                                "text": "[…] : trois mille ans plus tôt, le préhistorien nous a fait assister à la formation du fossé du Pas-de-Calais ; il nous a fait visiter la caverne de Lascaux, ce Louvre de l’Âge de pierre remontant à vingt mille ans ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c127ef3e-c0c0-4d41-b331-c83604e21bae",
                        "source_entry_id": "8fd05f8f-89c6-3598-9023-bf17480b06fc",
