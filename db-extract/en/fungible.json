                                "target_senses": [
                                    {
                                        "sense_id": "d467a832-019b-3167-b80d-46e96728c2f3",
                                        "entry_id": "6c063496-17b9-3314-b785-59a13e078363",
                                        "glosses": [
                                            "einsetzbar, verfügbar"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b23312-c8f1-4535-a933-6bb2ec1eb781",
                                                "sense_id": "d467a832-019b-3167-b80d-46e96728c2f3",
                                                "text": "Die Bücher, die Sie gewünscht haben, sind nicht fungibel und müssen bestellt werden."
                                            },
                                            {
                                                "example_id": "38145b3e-77a8-4a6f-a9be-fd7f992d35f1",
                                                "sense_id": "d467a832-019b-3167-b80d-46e96728c2f3",
                                                "text": "„Mit der Umwandlung in eine Forderung ist das Aktivum fungibler geworden, es kann beliehen, verpfändet, abgetreten oder bei Akzeptleistung des Kunden diskontiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a738210f-8cee-34fc-aaba-b1758122bfa7",
                                        "entry_id": "6c063496-17b9-3314-b785-59a13e078363",
                                        "glosses": [
                                            "vertretbar"
                                        ],
                                        "tags": [],
