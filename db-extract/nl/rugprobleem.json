                        "examples": [
                            {
                                "example_id": "4b3d500e-cc39-4090-9e4f-fa6d3c9334be",
                                "sense_id": "785afb50-6c23-3b97-88bc-1325d8fd2b15",
                                "text": "Grootste zorgen zijn vooral of de Brit fysiek wel in orde is. Froome had dit seizoen al last van een virus, rugproblemen en viel in de Dauphiné."
                            },
                            {
                                "example_id": "1a658b61-0c5c-4eaf-9bdc-a3b8048c20be",
                                "sense_id": "785afb50-6c23-3b97-88bc-1325d8fd2b15",
                                "text": "Janoekovitsj zei maandag echter dat er een speciale wet moet worden aangenomen die Timosjenko in staat stelt om in Duitsland aan haar rugproblemen te worden behandeld. 'Een dergelijke wet wordt nu door de Oekraïense politiek overwogen en wordt in de nabije toekomst voorgelegd aan het parlement', aldus Janoekovitsj."
                            }
                        ]
