{
    "word_family": [
        "dishonesty",
        "dishonestly",
        "honesty",
        "honest"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de8583ed-c2fa-3126-9b0f-77dbd8c5e1dd",
                    "sense_definition": "Not honest; tending to lie, cheat, or deceive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>dishonest</w> of him to hide the truth from his family.",
                            "target_lang_translations": {
                                "ru": "С его стороны было <w>нечестно</w> скрывать правду от своей семьи."
                            }
                        },
                        {
                            "text": "The <w>dishonest</w> salesman tried to sell a broken car to the customer.",
                            "target_lang_translations": {
                                "ru": "<w>Нечестный</w> продавец пытался продать покупателю сломанную машину."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceitful",
                        "untruthful",
                        "insincere"
                    ],
                    "antonyms": [
                        "honest"
                    ],
                    "common_phrases": [
                        "dishonest behavior",
                        "dishonest person",
                        "dishonest answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный; склонный ко лжи, обману или мошенничеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечестный",
                                "target_lang_sense_clarification": "склонный ко лжи или обману"
                            },
                            {
                                "target_lang_word": "лживый",
                                "target_lang_sense_clarification": "говорящий неправду"
                            },
                            {
                                "target_lang_word": "неискренний",
                                "target_lang_sense_clarification": "скрывающий свои истинные чувства или намерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3582e6d-89b7-3296-8a88-33f6f7531aee",
                    "sense_definition": "Characterized by or involving fraud or lack of integrity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was investigated for <w>dishonest</w> business practices.",
                            "target_lang_translations": {
                                "ru": "В отношении компании было проведено расследование по факту <w>мошеннических</w> методов ведения бизнеса."
                            }
                        },
                        {
                            "text": "He gained his wealth through <w>dishonest</w> means and illegal schemes.",
                            "target_lang_translations": {
                                "ru": "Он нажил свое состояние <w>бесчестным</w> путем и с помощью незаконных схем."
                            }
                        }
                    ],
                    "synonyms": [
                        "fraudulent",
                        "corrupt",
                        "crooked"
                    ],
                    "antonyms": [
                        "honest"
                    ],
                    "common_phrases": [
                        "dishonest practices",
                        "dishonest means",
                        "dishonest scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся мошенничеством или отсутствием порядочности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесчестный",
                                "target_lang_sense_clarification": "нарушающий правила чести или морали"
                            },
                            {
                                "target_lang_word": "мошеннический",
                                "target_lang_sense_clarification": "связанный с финансовым обманом"
                            },
                            {
                                "target_lang_word": "коррумпированный",
                                "target_lang_sense_clarification": "использующий служебное положение в корыстных целях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c83964a-5a9c-3536-960c-0938bc4dda02",
                    "sense_definition": "Bringing shame or disgrace; morally reprehensible or indecent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disgrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier returned home with <w>dishonest</w> scars from a battle he should not have fought.",
                            "target_lang_translations": {
                                "ru": "Солдат вернулся домой с <w>позорными</w> шрамами после битвы, в которой ему не следовало участвовать."
                            }
                        },
                        {
                            "text": "She refused to speak a <w>dishonest</w> word that might tarnish her reputation.",
                            "target_lang_translations": {
                                "ru": "Она отказалась произнести хоть одно <w>лживое</w> слово, которое могло бы запятнать ее репутацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "dishonorable",
                        "shameful",
                        "ignoble"
                    ],
                    "antonyms": [
                        "honest"
                    ],
                    "common_phrases": [
                        "dishonest word",
                        "dishonest scars"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literary contexts to mean shameful or unchaste"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий позор или бесчестье; морально предосудительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позорный",
                                "target_lang_sense_clarification": "вызывающий чувство стыда"
                            },
                            {
                                "target_lang_word": "бесчестный",
                                "target_lang_sense_clarification": "порочащий репутацию"
                            },
                            {
                                "target_lang_word": "неблагородный",
                                "target_lang_sense_clarification": "лишенный высоких моральных качеств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89abcbae-8f0c-3965-8957-d2cfeed62160",
                    "sense_definition": "Physically disfigured or marred in a way that causes disgrace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disgrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue was left <w>dishonest</w> and broken after the city was sacked.",
                            "target_lang_translations": {
                                "ru": "Статуя осталась <w>изуродованной</w> и разбитой после того, как город был разграблен."
                            }
                        },
                        {
                            "text": "<w>Dishonest</w> with lopped arms, the youth appeared before the king in shame.",
                            "target_lang_translations": {
                                "ru": "<w>Обезображенный</w>, с отрубленными руками, юноша предстал перед королем в позоре."
                            }
                        }
                    ],
                    "synonyms": [
                        "disfigured",
                        "mutilated"
                    ],
                    "antonyms": [
                        "honest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specifically referring to physical disfigurement as a mark of disgrace"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически обезображенный или изуродованный таким образом, что это вызывает позор (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезображенный",
                                "target_lang_sense_clarification": "имеющий физические увечья, вызывающие стыд"
                            },
                            {
                                "target_lang_word": "изувеченный",
                                "target_lang_sense_clarification": "сильно поврежденный физически"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}