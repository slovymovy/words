                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bec29c-0adb-4019-b5ea-0b861c88d135",
                                "sense_id": "1d45a925-9637-3794-9cce-f161bc0e63ce",
                                "text": "Procuratory action against George Scot, Gilbert Makkeppet and Thomas McKeine for spoliation of four oxen, price 30 s. apiece, from the lands of Drumganis within the provostry of Linclowdane."
                            },
                            {
                                "example_id": "b75c7e9f-1160-4024-8e8d-0050f8dc237b",
                                "sense_id": "1d45a925-9637-3794-9cce-f161bc0e63ce",
                                "text": "He told the deputies that the procuratory work had been improved during the past year, but as a whole was still a weak branch of the state legal system."
                            },
                            {
                                "example_id": "5d502ea2-6c06-4f70-8ccb-6890e95c1ee4",
                                "sense_id": "1d45a925-9637-3794-9cce-f161bc0e63ce",
                                "text": "After this is the procuratory order, which we read mentioned in the book of Job: “If the angel will speak for him, he will pray to the Lord and He will be pleased.”"
                            }
                        ]
                    }
                ],
