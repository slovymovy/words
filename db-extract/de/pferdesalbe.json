                    {
                        "sense_id": "bb95c7eb-d8cf-362f-8c10-2c5b99f1f538",
                        "entry_id": "74b684f6-e346-3842-aba6-ffbffad35071",
                        "glosses": [
                            "kosmetisches Pflegemittel zur Linderung von Schmerzen an Unterschenkeln und Füßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f3902a-3063-4e3c-89c7-1b390f13401f",
                                "sense_id": "bb95c7eb-d8cf-362f-8c10-2c5b99f1f538",
                                "text": "„Ein penetranter Eukalyptusgeruch stieg Sebi in die Nase, der ihn an die Pferdesalbe erinnerte, mit der Tante Hilde immer ihre Beine eingerieben hatte.“"
                            },
                            {
                                "example_id": "33337600-b648-436c-9ac5-961245c9c64e",
                                "sense_id": "bb95c7eb-d8cf-362f-8c10-2c5b99f1f538",
                                "text": "„Nachdem meine Freundin mir Pferdesalbe auf den schmerzenden Punkt geschmiert hat, wird es etwas besser.“"
                            },
                            {
                                "example_id": "cd06b6c7-f367-4833-8c54-0cf23370a2c3",
                                "sense_id": "bb95c7eb-d8cf-362f-8c10-2c5b99f1f538",
                                "text": "„Diese suchten sie seit zwei Jahren immer wieder heim und plagten sie jeweils ein paar Tage – kürzer, wenn sie ein Ibuprofen schluckte oder den Rücken mit Pferdesalbe einrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
