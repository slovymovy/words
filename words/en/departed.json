                                "target_lang_sense_clarification": "покинул место"
                            },
                            {
                                "target_lang_word": "отошел",
                                "target_lang_sense_clarification": "о поезде или транспорте"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odjechał",
                                "target_lang_sense_clarification": "o pociągu lub innym środku transportu"
                            },
                            {
                                "target_lang_word": "wyruszył",
                                "target_lang_sense_clarification": "rozpoczął podróż"
                            },
                            {
                                "target_lang_word": "odleciał",
                                "target_lang_sense_clarification": "o samolocie"
                            }
