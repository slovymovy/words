                "translations": [
                    {
                        "translation_id": "2cf8060f-5d3a-44ae-8589-9a89f601d7ff",
                        "source_entry_id": "a9e7d266-eb10-3e81-8297-17e0a5870371",
                        "source_sense_id": "a7935897-51dd-3ff9-8b83-aab4ddfdcae6",
                        "source_sense_description": "een rilling als gevolg van afschuw of koude",
                        "target_lang_word": "Schauder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f77e5083-d70b-3386-b09f-a04f65e76b43",
                                        "entry_id": "7e234672-d00b-30bf-acf2-715286c53372",
                                        "glosses": [
                                            "plötzliches Gespür von Kälte"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                        "entry_id": "7e234672-d00b-30bf-acf2-715286c53372",
                                        "glosses": [
                                            "plötzliches Gefühl des Abscheus, der Angst, des Entsetzens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa0c595-1613-4966-ba95-4ae1c61cada3",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Ein Schauder kroch mir über die Kopfhaut.“"
                                            },
                                            {
                                                "example_id": "4aa205c2-dad4-48c9-8061-9254718c4c2e",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Kaum noch verhüllt mischt sich da in den Schauder ein Stolz aufs Geleistete ein.“"
                                            },
                                            {
                                                "example_id": "9fca4241-b7d7-4782-aace-8b119e602c07",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„In diesem Augenblick empfanden alle Anwesenden etwas wie einen Schauder.“"
                                            },
                                            {
                                                "example_id": "6dce8c44-3b12-4981-9d1a-930f98733106",
                                                "sense_id": "0513a2be-b222-3f6e-aab4-6eca16030136",
                                                "text": "„Die anderen Gäste betrachteten sie mit Schauder und Abscheu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44f6554d-32dd-44e6-b55f-51ac87168249",
                        "source_entry_id": "a9e7d266-eb10-3e81-8297-17e0a5870371",
