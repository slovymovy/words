                            {
                                "example_id": "3ae2e0f1-b181-4270-b6ba-53e98c0fdb57",
                                "sense_id": "76bcd763-0624-3c78-9540-d59e68178a55",
                                "text": "Je suis sûre que ma physionomie fut changée pour toujours et je continuai à manipuler les élèves arrivants avec l’aise forcée d’une personne qui a subi une atteinte subjuguante."
                            },
                            {
                                "example_id": "ccb512a1-4b9e-46b9-8f86-11eb82d03a72",
                                "sense_id": "76bcd763-0624-3c78-9540-d59e68178a55",
                                "text": "– Tony n’a pas son pareil pour faire plier tout le monde, soupirait Campas, à qui, d’évidence, cette faculté subjuguante avait été refusée. Il faut dire que ça l’excite…"
                            }
                        ]
