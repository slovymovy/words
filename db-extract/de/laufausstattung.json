                "senses": [
                    {
                        "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                        "entry_id": "dac8183c-c820-3ba8-bbbf-2d00b70e4c94",
                        "glosses": [
                            "Alles, was man beim Laufen verwendet oder mitführt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "91d867f9-6d78-4a8a-8da0-0cb55a2a86f8",
                                "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                                "text": "„Kopfhörer sind – genauso wie Smartphones und Apps – heute ein fixer Bestandteil der modernen Laufausstattung.“"
                            },
                            {
                                "example_id": "027a01ed-3d99-404b-977e-315eebe6d56c",
                                "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                                "text": "„Von den Trainerinnen Svenja und Jessica erhaltet ihr wertvolle Tipps zu Lauf- und Atemtechniken, Laufausstattung u.v.m.!“"
                            },
                            {
                                "example_id": "ac57b6ba-eccb-49a8-99b9-ed5e485f732a",
                                "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                                "text": "„Der Vorteil vom Zwiebelprinzip ist übrigens auch, dass du nicht viele verschiedene Laufausstattungen für viele Temperaturen brauchst, sondern die vorhandenen Klamotten eben gut kombinieren kannst.“"
                            },
                            {
                                "example_id": "30f25408-c0d6-4d1b-90c5-f37d045c45b1",
                                "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                                "text": "„Gesunde Bewegungsabläufe, Bewegungsfreiheit und optimales Training, all das ermöglicht die richtige Laufausstattung.“"
                            },
                            {
                                "example_id": "3c98c590-83f9-403a-9ed6-065fc180f848",
                                "sense_id": "3d0b460c-c6fe-3917-9c63-1a03d2062478",
                                "text": "„Und das Weltmeistertempo läuft man immer, denn es ist das eigene Weltmeistertempo das hier zählt und auch das Schwitzen verursacht, das Heldengefühl und das Verliebtsein in Laufausstattungen hervorruft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
