                    {
                        "translation_id": "0e2456e8-9b77-4096-8298-c54b44cce606",
                        "source_entry_id": "87f1b65e-84ff-3903-bb61-b01b2fb7b577",
                        "source_sense_id": "0d21b8f6-2e64-32b9-becb-20a9c7010f53",
                        "target_lang_word": "Steg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "eine kleine Brücke"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97d196d-0ae3-4d32-844d-3300608105b5",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Diesen schmalen Steg müssen wir überschreiten."
                                            },
                                            {
                                                "example_id": "98b2eff3-e3ea-42dd-a9e0-365976a22f12",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Weit und breit verursachten unsere Füße auf dem knarrenden Steg das einzige Geräusch.“"
                                            },
                                            {
                                                "example_id": "1b7d0d8d-692c-4341-b6fc-f6144c56a12a",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "„Die Bretter des Stegs hatten geknarrt, und das Wasser des Flusses war so dunkel und durchsichtig gewesen wie immer.“"
                                            },
                                            {
                                                "example_id": "bba2adaf-ea7a-46a2-a9d2-d745bf88bfe0",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Köln, Rheinauhafen. Im Schatten der architektonisch durchaus gewagten drei Kranhäuser dümpeln gut vertäut Schiffe an den Stegen."
                                            },
                                            {
                                                "example_id": "2aa8c37b-67f7-40f5-963a-fa5f488ef1d3",
                                                "sense_id": "b00f2d12-dd93-3a33-88e8-204343c8c367",
                                                "text": "Am Steg baumelt ein Thermometer im Wasser. Neun Grad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "bei Streichinstrumenten auf dem Resonanzboden aufstehendes kleines Querbrett, über das die Saiten laufen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2302b2-8479-4fec-aac0-d8277c1ebc64",
                                                "sense_id": "347ae8b4-d71e-31f8-8635-5f747d30120b",
                                                "text": "Ein virtuoser Geiger muss den perfekten Treffpunkt des Bogens auf der Saite zwischen Steg und Griffbrett finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "unter dem Schuh oder unter dem Fuß durchlaufender Riemen, um die Kleidung straff zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4efd06b-5206-45fb-8e88-751188b9e6d6",
                                                "sense_id": "a3f20325-6510-35ba-a289-d51a9c22f9b0",
                                                "text": "Der Steg unter meinem rechten Schuh ist schon durchgetreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "die leere Außenfläche einer bedruckten Buchseite"
                                        ],
                                        "tags": [
                                            "Druckerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9af13e-aeaa-4d96-b51b-bd2d83d84eb0",
                                                "sense_id": "dbb98190-58ba-382f-94b1-b7a113c8553e",
                                                "text": "Der Steg dieser Buchseite ist mit Notizen beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "das die beiden Gurte (im Stahlbau auch Flansche genannten) verbindende Konstruktionselement eines doppel-T-förmigen Trägers"
                                        ],
                                        "tags": [
                                            "Stahlbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16fa22d-4f60-43f9-87b8-1c5b8ff07f92",
                                                "sense_id": "8274703b-c041-3b8c-9e18-15b0924ef4ac",
                                                "text": "Der Steg eines Doppel-T-Trägers verbindet die beiden Flansche."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e655164a-cc0b-3da0-9f77-7b175a361851",
                                        "entry_id": "73431443-5806-3c75-b733-0bdb340cfe65",
                                        "glosses": [
                                            "generell verbindendes Konstruktionselement wie zum Beispiel der Brillensteg"
                                        ],
                                        "tags": [
                                            "Konstruktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4f15288-a057-4f0a-8408-5d9f1ac821e6",
                                                "sense_id": "e655164a-cc0b-3da0-9f77-7b175a361851",
                                                "text": "Der Optiker konnte den gebrochenen Steg an meiner Brille sofort reparieren."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07624845-999b-4a7f-97f4-dd2ded4293f5",
                        "source_entry_id": "87f1b65e-84ff-3903-bb61-b01b2fb7b577",
                        "source_sense_id": "0d21b8f6-2e64-32b9-becb-20a9c7010f53",
                        "target_lang_word": "marge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a61afc02-4d22-3ca4-8abd-fd1fc9c220a2",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Lisière ; bord ; périphérie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592f54b4-24f9-4d3a-a11c-96bbdd6d900a",
                                                "sense_id": "a61afc02-4d22-3ca4-8abd-fd1fc9c220a2",
                                                "text": "Je voyais en marge de mon champ visuel et à quelque distance une grande ombre en mouvement."
                                            },
                                            {
                                                "example_id": "5a864507-fcb2-43d3-b97d-3cb15546d7e9",
                                                "sense_id": "a61afc02-4d22-3ca4-8abd-fd1fc9c220a2",
                                                "text": "Les adolescents […] s’étalant sur les nappes de verdure, aux marges ombragées des clairières."
                                            },
                                            {
                                                "example_id": "1cf02437-c0ca-4c6d-9d46-c67268cf948e",
                                                "sense_id": "a61afc02-4d22-3ca4-8abd-fd1fc9c220a2",
                                                "text": "[…] l’association à Limnanthemum ne saurait être étroitement délimitée car elle présente des intrications avec les groupements ripicoles sur sa marge externe et, sur sa marge interne, avec des associations flottantes […]"
                                            },
                                            {
                                                "example_id": "8cd74c34-6b52-4120-810e-f2bae760d581",
                                                "sense_id": "a61afc02-4d22-3ca4-8abd-fd1fc9c220a2",
                                                "text": "Hergé avait génialement baptisé du nom de Bordurie un pays des marges slaves. Les Grecs antiques donnaient le nom d’Eschatiai à ces espaces relégués d’où émane une radiation magique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d222a161-b762-3a7d-926f-17d44e3c7c60",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Bord vierge qui est autour d’une page imprimée ou écrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1da371-7e9b-480d-9c50-70794f3724d9",
                                                "sense_id": "d222a161-b762-3a7d-926f-17d44e3c7c60",
                                                "text": "Un gardien dont le rôle était de donner aux croque-morts décharge, sur un registre, des cercueils qu’il avait comptés et vu inhumer, signa le livre et apposa son timbre en marge."
                                            },
                                            {
                                                "example_id": "f419aead-7c09-4912-abee-36b842ffc0dc",
                                                "sense_id": "d222a161-b762-3a7d-926f-17d44e3c7c60",
                                                "text": "Les marges de ce livre sont chargées d’annotations."
                                            },
                                            {
                                                "example_id": "7cd5492f-2f7d-44ac-b621-3991912879d3",
                                                "sense_id": "d222a161-b762-3a7d-926f-17d44e3c7c60",
                                                "text": "C’est un superbe Montaigne à grandes marges. Les variantes sont en italiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd9a279-f81f-3fcc-8fa6-81b336a10841",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Ce bord virtuel, avant que la page ne soit imprimée ou écrite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea71cf52-b211-3fba-b437-1d21122a8b6d",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Espace libre, temps disponible, aise."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1278862c-2173-4d76-9113-876b5acf3a51",
                                                "sense_id": "ea71cf52-b211-3fba-b437-1d21122a8b6d",
                                                "text": "Avoir de la marge, Avoir plus de temps ou plus de moyens qu’il n’en faut pour exécuter quelque chose."
                                            },
                                            {
                                                "example_id": "8c72d695-85d4-443e-81b0-a299e6f0bdb3",
                                                "sense_id": "ea71cf52-b211-3fba-b437-1d21122a8b6d",
                                                "text": "Bien sûr, on ne peut pas être à soixante-dix ans ce qu’on a été à vingt ans, mais de là à s’effondrer comme une femmelette, il y a tout de même de la marge."
                                            },
                                            {
                                                "example_id": "3ef26abd-18f5-488c-abee-859ab39a9768",
                                                "sense_id": "ea71cf52-b211-3fba-b437-1d21122a8b6d",
                                                "text": "Fallait-il que je me sente heureuse et forte et assurée pour me lancer dans pareille aventure, que j’aie le sentiment d’avoir de la marge, pour mettre ainsi à l’épreuve, comme si besoin en était, ma capacité de résistance."
                                            },
                                            {
                                                "example_id": "5b364d85-b348-4362-9ec1-9613d1b122af",
                                                "sense_id": "ea71cf52-b211-3fba-b437-1d21122a8b6d",
                                                "text": "Donner, laisser de la marge à quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d17271f-08bd-322b-bd9b-bf3ef7e6d29e",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Profit, différence entre produits et charges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b897b86-2545-4e59-a1bd-f351b55ae226",
                                                "sense_id": "3d17271f-08bd-322b-bd9b-bf3ef7e6d29e",
                                                "text": "Mais les entreprises industrielles capables de générer près de 30% de marge nette et 80% d’Ebitda sont suffisamment rares pour que cela mérite de décrypter leur modèle de développement. Seules les marques de luxe dégagent de telles marges, et encore…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9d95102-ab62-3001-8cc6-b065835e14dd",
                                        "entry_id": "a5e0daed-6b65-3519-b0c0-8c445cd9c3fb",
                                        "glosses": [
                                            "Partie du support imprimé extérieure à la surface cartographiée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
