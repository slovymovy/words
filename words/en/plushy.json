                    "sense_id": "4ed2d1ea-70c4-3687-830a-8f806c7a10df",
                    "sense_definition": "having a soft, thick, and shaggy texture similar to plush fabric",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
