                ],
                "senses": [
                    {
                        "sense_id": "b930670e-c8f8-311f-a6b2-f0ebbba9953f",
                        "entry_id": "b3368267-f517-3265-bc45-399145487d09",
                        "glosses": [
                            "Block mit Papierblättern, der zum Zeichnen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61b51f8c-a732-4ec4-8238-79ac73b4d879",
                                "sense_id": "b930670e-c8f8-311f-a6b2-f0ebbba9953f",
                                "text": "„Sie dimmte die Nachttischlampe, holte ihren Zeichenblock und versuchte, diesen Ausdruck auf dem Papier so festzuhalten, wie er sich im Gesicht ihres Liebsten festhielt.“"
                            },
                            {
                                "example_id": "a92f6055-26a9-4e7f-a031-ecc7bb903d1d",
                                "sense_id": "b930670e-c8f8-311f-a6b2-f0ebbba9953f",
                                "text": "„Der Zeichenblock war immer dabei.“"
                            },
                            {
                                "example_id": "eb6e4e79-47e3-44b4-afac-788b042cfa05",
                                "sense_id": "b930670e-c8f8-311f-a6b2-f0ebbba9953f",
                                "text": "„Er setzte sich und holte seinen Zeichenblock hervor.“"
                            },
                            {
                                "example_id": "503bc3e6-4895-43d2-8944-6e8e1bbb771d",
                                "sense_id": "b930670e-c8f8-311f-a6b2-f0ebbba9953f",
                                "text": "„Ich zeige auf meine Stirn und gehe ins Büro, um mir einen Zeichenblock und einen Klappsessel zu holen und für Frau Niebuhr ein Mausoleum zu entwerfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
