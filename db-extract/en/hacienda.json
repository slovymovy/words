                                    },
                                    {
                                        "sense_id": "715cef84-7aaf-3146-950b-6c3f59bd40bb",
                                        "entry_id": "04021b81-7091-3f25-99d3-d90e377c450a",
                                        "glosses": [
                                            "Cosa cualquiera de la que hay que ocuparse."
                                        ],
