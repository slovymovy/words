                    {
                        "sense_id": "da6dcbd9-1218-380e-9088-8145d82ff1da",
                        "entry_id": "0c488f81-e520-3900-bf16-724c9b4e2a6d",
                        "glosses": [
                            "een kortdurend, fel licht (dat men gebruikt bij het maken van foto's)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8ec753-3079-44c9-82af-6b29b8d38209",
                                "sense_id": "da6dcbd9-1218-380e-9088-8145d82ff1da",
                                "text": "En het stroboscopische flitslicht, het anti-collision light: een witte flits die in een vast ritme uit de vleugelpunten schiet en dan de vleugel en de omgeving telkens een halve seconde verlicht."
                            },
                            {
                                "example_id": "f53aec8d-ee1b-48d9-b11a-edbef2732054",
                                "sense_id": "da6dcbd9-1218-380e-9088-8145d82ff1da",
                                "text": "Volgens entertainmentblad Variety keken de aanwezigen in de bioscoopzaal ook uit naar het paar. \"Toen ze opdoken, gingen er kreten door het publiek en een zee van flitslichten van mobieltjes. Deze première was een van de hoogtepunten van het festival.\""
                            }
                        ]
                    }
                ],
                "translations": [
