                                        "sense_id": "41fd4691-b39f-3eed-97c4-51ac0b9eb98c",
                                        "entry_id": "516d847f-c7f0-3cf2-82c2-d5ff505dda8d",
                                        "glosses": [
                                            "Any of the trees that bear limes, especially Key lime, Citrus aurantiifolia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "160d0312-4017-3c3a-a842-9089ba2b76aa",
                                        "entry_id": "516d847f-c7f0-3cf2-82c2-d5ff505dda8d",
                                        "glosses": [
                                            "Any of several brilliant, sometimes yellowish, green colours associated with the fruits of a lime tree."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd44dbe0-a719-3d19-8df7-19077ea57fad",
                                        "entry_id": "516d847f-c7f0-3cf2-82c2-d5ff505dda8d",
                                        "glosses": [
                                            "Any of several brilliant, sometimes yellowish, green colours associated with the fruits of a lime tree.",
                                            "A particular one of those colours that has been standardized under this name, at least in some organizations' standards."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c458d76-1e7a-32ff-a423-8d99b40c5809",
                                        "entry_id": "516d847f-c7f0-3cf2-82c2-d5ff505dda8d",
                                        "glosses": [
                                            "A fan fiction story which contains sexual references, but stops short of full, explicit descriptions of sexual activity (coined by analogy with lemon)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7401940-1402-4111-825f-8e8040592dfd",
                                                "sense_id": "2c458d76-1e7a-32ff-a423-8d99b40c5809",
                                                "text": "WARNING: This is a lime. While it does not show explicit sex, as a lemon would, references to sexual situations abound."
                                            },
                                            {
                                                "example_id": "f476b703-4bb9-4fd0-ac58-d02213e7ef7a",
                                                "sense_id": "2c458d76-1e7a-32ff-a423-8d99b40c5809",
                                                "text": "Even with all the sex in Garden of EVA, I still think the main stories are better for just being the lemon-scented limes that they are."
                                            },
                                            {
                                                "example_id": "168db4e8-35b8-4179-b241-f66d95bcd340",
                                                "sense_id": "2c458d76-1e7a-32ff-a423-8d99b40c5809",
                                                "text": "I have no intention of writing any lemon scenes, limes are possibilities but unlikely and if they occur they will be few in number."
                                            }
                                        ]
                                    }
                                ]
                            },
