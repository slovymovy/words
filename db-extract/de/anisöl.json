                "senses": [
                    {
                        "sense_id": "bb5a1c77-73a1-3b6a-a691-746519f20ed8",
                        "entry_id": "7c18b108-5fe9-3045-b562-6e52fbc14bf0",
                        "glosses": [
                            "ätherisches Öl, das aus Anissamen gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3188a98f-d30b-4b85-a314-d452fca230f6",
                                "sense_id": "bb5a1c77-73a1-3b6a-a691-746519f20ed8",
                                "text": "„Anisöl erfrischt und desinfiziert, weshalb es auch in Mundwässern verwendet wird.“"
                            },
                            {
                                "example_id": "4b136a1e-71d9-4012-8c48-7ef18e9eefbd",
                                "sense_id": "bb5a1c77-73a1-3b6a-a691-746519f20ed8",
                                "text": "„Früher gewannen Anisölbrenner auch in Deutschland Anisöl durch Destillation mit Wasserdampf aus den Früchten der Pflanze.“"
                            },
                            {
                                "example_id": "83a9804e-d0c3-4ab4-b2fd-67321dd2c53b",
                                "sense_id": "bb5a1c77-73a1-3b6a-a691-746519f20ed8",
                                "text": "„Ein Wachsrand ist bei Anwendung des Anisöls nicht zulässig, da derselbe bereits nach wenigen Tagen von dem Anisöl angegriffen und in einen Brei verwandelt wird.“"
                            }
                        ],
