                    {
                        "translation_id": "5258ada3-d7fc-4f9e-ab97-cd750bd112e3",
                        "source_entry_id": "e809d093-5abd-3cc1-a5ea-c8306e84c52c",
                        "source_sense_id": "99143d45-8232-350f-800e-2c828106d9ea",
                        "target_lang_word": "вулканология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вулканология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                        "entry_id": "67e2bebe-f891-3cf2-858c-13d7885e8838",
                                        "glosses": [
                                            "наука, изучающая процессы и причины образования вулканов, их развитие, строение и состав продуктов извержения, изменение характера их деятельности, а также закономерности размещения вулканов на поверхности Земли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd716de9-f981-43b7-a42d-adfb2a8884f0",
                                                "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                                "text": "В 18-й комнате Аньюдинской школы шёл урок географии. ❬…❭ Речь шла о науке вулканологии, о вулканах вообще и непокорённых вулканах в частности."
                                            },
                                            {
                                                "example_id": "fc4ac232-0e2c-44a6-8437-065eb965443f",
                                                "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                                "text": "В вулканологии — науке о вулканических процессах — известно правило, полученное на основании наблюдений за многими десятками вулканов: при своём пробуждении вулкан должен проявить мощь, пропорциональную длительности предшествовавшей стадии покоя."
                                            },
                                            {
                                                "example_id": "0bbf2733-a5cf-4ddd-bff2-d1344581dce5",
                                                "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                                "text": "Позднее вулканами стали называть все огнедышащие горы. Отсюда же и вулканология — так назвали науку об этих огнедышащих горах. ❬…❭ .. вулканология — действительно наука «со стажем». Но подлинный её расцвет приходится, конечно, на наше время. Ныне она занимает в системе наук о Земле очень важное место."
                                            },
                                            {
                                                "example_id": "10bf87cf-a9cd-4111-9299-243b737ecad4",
                                                "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                                "text": "Перу Павла Ивановича принадлежит первая в отечественной вулканологии монография «Извержения и сейсмический режим вулканов Ключевской группы» (1966 г.), которая вывела автора в число ведущих в своей области специалистов."
                                            },
                                            {
                                                "example_id": "63df0ab5-1aa2-43a0-89bc-d42ef2ab920d",
                                                "sense_id": "0566c76b-bef4-3fe6-91d1-48b11d227c19",
                                                "text": "Когда погаснет последний вулкан, не превратится ли вулканология как наука из земной в науку о других планетах, в космическую?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
