                "senses": [
                    {
                        "sense_id": "4f890f0f-2beb-31fb-b555-81205b892a49",
                        "entry_id": "9940be90-3c51-3339-ad4f-a9842a11d8b6",
                        "glosses": [
                            "Laden, der Handel mit Waffen betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "194ab10d-9a2a-4086-8c72-e83608e8c865",
                                "sense_id": "4f890f0f-2beb-31fb-b555-81205b892a49",
                                "text": "„Ein Mann fragt in einem Waffengeschäft nach einem Revolver.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e8df205-e811-3557-87fe-d76851090493",
                        "entry_id": "9940be90-3c51-3339-ad4f-a9842a11d8b6",
                        "glosses": [
                            "Handel mit Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c9121a-fb35-4ce8-b6e3-f143da187879",
                                "sense_id": "0e8df205-e811-3557-87fe-d76851090493",
                                "text": "„Die Enthüllung illegaler Waffengeschäfte der US-Regierung unter Präsident Ronald Reagan mit dem Iran führt zur Entlassung des Sicherheitsberaters John Poindexter und Oberstleutnants Oliver North.“"
                            },
                            {
                                "example_id": "2a60f64d-ae31-4793-8516-61aa839e4283",
                                "sense_id": "0e8df205-e811-3557-87fe-d76851090493",
                                "text": "„Wegen illegaler Waffengeschäfte verurteilt das Landgericht den einstigen DDR-Devisenbeschaffer Alexander Schalck-Golodkowski zu einem Jahr Haft auf Bewährung.“"
                            },
                            {
                                "example_id": "fe64304b-e317-4d16-b00d-a2530fb9d73b",
                                "sense_id": "0e8df205-e811-3557-87fe-d76851090493",
                                "text": "„In seiner nachträglich gehaltenen Rede zur Verleihung des Friedensnobelpreises 1988 an die Friedenstruppen der Vereinten Nationen schlägt UN-Generalsekretär Javier Pérez de Cuellar die Einführung einer Abgabe auf alle internationalen Waffengeschäfte vor, aus der Blauhelmeinsätze mitfinanziert werden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
