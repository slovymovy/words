                                        "entry_id": "698801fb-2948-3441-8616-c1a3eb3333b8",
                                        "glosses": [
                                            "die Zeit vor dem Erdzeitalter des Kambriums und damit eine zusammenfassende Bezeichnung für die erdgeschichtlichen Äonen Hadaikum, Archaikum und Proterozoikum (von circa 4600 bis etwa 542 Millionen Jahren vor heute)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7094110e-29eb-405f-83ad-5cd98b00cb3e",
                                                "sense_id": "c5955d9d-db0b-336f-8321-d8b5f949279b",
                                                "text": "„Das Präkambrium umfasst eine Zeitdauer von rund 4 Milliarden Jahren …, vom Zeitpunkt der Entstehung der Erde vor ca. 4,55 Milliarden Jahren … bis zum Beginn des Kambriums vor ca. 542 Millionen Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
