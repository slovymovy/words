                ],
                "senses": [
                    {
                        "sense_id": "cd1b2765-4bc7-378b-8bf8-6ac598412680",
                        "entry_id": "0ba25c2c-eda3-3259-8a11-e0ad5a36ae93",
                        "glosses": [
                            "истор. учение софистов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d93ae4a4-5a9c-329c-bc61-ab8210a27e80",
                        "entry_id": "0ba25c2c-eda3-3259-8a11-e0ad5a36ae93",
                        "glosses": [
                            "перен. рассуждения, основанные на софизмах; сознательное применение в споре или в доказательствах неправильных, ложных доводов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed7ce90-8460-4461-8851-f28b8810a46a",
                                "sense_id": "d93ae4a4-5a9c-329c-bc61-ab8210a27e80",
                                "text": "Темные глубины бессознательного более не могут отрицаться невежеством и софистикой - бедной маскировкой всеобщей боязни - и не могут быть объяснены с помощью псевдонаучных рационализации."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "282cfa34-587b-49ee-8c04-c00ef263878d",
                        "source_entry_id": "0ba25c2c-eda3-3259-8a11-e0ad5a36ae93",
                        "target_lang_word": "sophistry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sophistry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4757e69-9b91-39e6-93c4-91e88226f897",
                                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                                        "glosses": [
                                            "The actions or arguments of a sophist."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff8f596-de9e-4556-b7ce-9cc8013a9c6e",
                                                "sense_id": "b4757e69-9b91-39e6-93c4-91e88226f897",
                                                "text": "Such conduct is at any rate not sophistical, if Aristotle be right in describing sophistry as the art of making money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8a90cd-f396-308f-981c-f997f881bdc4",
                                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                                        "glosses": [
                                            "Plausible yet fallacious argumentations or reasoning."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "305330d2-e228-38b1-b3ce-309ba4952eb5",
                                        "entry_id": "b0559346-9b63-3f16-a22b-50e3bbf156bf",
                                        "glosses": [
                                            "An argument that seems plausible, but is fallacious or misleading, especially one devised deliberately to be so; a sophism."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088720ef-daef-4b6b-ba7f-829bb4ea98df",
                                                "sense_id": "305330d2-e228-38b1-b3ce-309ba4952eb5",
                                                "text": "And so he reasoned until the first generous impulse to proclaim the truth and relinquish his titles and his estates to their rightful owner was forgotten beneath the mass of sophistries which self-interest had advanced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "575ddfb1-d035-477e-9b4d-22fb1a6032c3",
                        "source_entry_id": "0ba25c2c-eda3-3259-8a11-e0ad5a36ae93",
                        "target_lang_word": "sofistyka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "596fc341-8aff-46fd-b604-741ce0ea6cd8",
                        "source_entry_id": "0ba25c2c-eda3-3259-8a11-e0ad5a36ae93",
                        "target_lang_word": "sophistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sophistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c570de8-7b15-35c8-a173-b3e7d103625e",
                                        "entry_id": "d21fc0e8-75a8-34df-9ade-a8b435dbffff",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de sophistiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4368f7cc-3f17-38d8-a650-6a16acbf5ebf",
                                        "entry_id": "d21fc0e8-75a8-34df-9ade-a8b435dbffff",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de sophistiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a8cacb-950b-401b-971b-f1ed56edad75",
                                                "sense_id": "4368f7cc-3f17-38d8-a650-6a16acbf5ebf",
                                                "text": "Sans doute, disent-ils, de nos jours, on fignole, on raffine, on sophistique mais on ne fait jamais que talmudiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080bd01d-40c0-3554-b0ee-c5dc7f5f3b96",
                                        "entry_id": "d21fc0e8-75a8-34df-9ade-a8b435dbffff",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de sophistiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad57000c-1bd1-3299-8889-bc9f57b105ae",
                                        "entry_id": "d21fc0e8-75a8-34df-9ade-a8b435dbffff",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de sophistiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce085d9-ff6d-3a32-8903-27ce7501a1c8",
                                        "entry_id": "d21fc0e8-75a8-34df-9ade-a8b435dbffff",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de sophistiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sophistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f3d019-ffdd-306e-af9d-977363157a31",
                                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                                        "glosses": [
                                            "Qui concerne les sophistes antiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e4d1f8-8726-46f5-b069-a992d2bfcaff",
                                                "sense_id": "d2f3d019-ffdd-306e-af9d-977363157a31",
                                                "text": "Philosophie sophistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                                        "glosses": [
                                            "Qui est de la nature du sophisme, qui contient des sophismes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d045a626-11fa-478e-a581-b3e2c90a197d",
                                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                                "text": "Je ne donne jamais au mot \"philosophie\", dans le cours de cet ouvrage, le sens que ses détracteurs ont voulu lui donner de nos jours, soit en opposant la philosophie aux idées religieuses, soit en appelant \"philosophiques\" des systèmes purement sophistiques."
                                            },
                                            {
                                                "example_id": "c75a17bc-07a3-499d-9e49-66a18e191f77",
                                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                                "text": "Je vis à sa honte et à sa tristesse qu’il était bien inutile de rétorquer les arguments sophistiques de son désordre."
                                            },
                                            {
                                                "example_id": "c436977b-8129-46f0-8c78-ee852d19d999",
                                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                                "text": "Sous l’impression des sentiments qu’il éprouvait en ce moment, Ulric s’épouvanta lui-même en voyant dégagé de tout raisonnement sophistique, le monstrueux égoïsme qui lui servait de mobile."
                                            },
                                            {
                                                "example_id": "5ca82155-df30-41a8-b51e-e4c6a6625fad",
                                                "sense_id": "8d1e8215-5eda-3935-9493-611219ca480d",
                                                "text": "On arrivera toujours à un cas où l’induction repose sur une telle probabilité, que la raison ne conserve pas le moindre doute, en dépit de toute objection sophistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                        "entry_id": "493a44fe-bd04-3338-91df-5699cccf8080",
                                        "glosses": [
                                            "Qui fait usage du sophisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81625c4a-c48e-4597-a4ed-62df9e6a84d7",
                                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                                "text": "Un esprit sophistique."
                                            },
                                            {
                                                "example_id": "03781540-5c46-40b6-9644-0793d13a05d0",
                                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                                "text": "Un écrivain sophistique."
                                            },
                                            {
                                                "example_id": "612b93b4-743a-41a1-868d-c24c0075ae41",
                                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                                "text": "Une éloquence sophistique."
                                            },
                                            {
                                                "example_id": "322eb72b-c328-4e10-80d0-b313b7a873d8",
                                                "sense_id": "e7e50c57-60ce-3703-9d00-214a8dcf4847",
                                                "text": "Le caractère sophistique de tous ces empereurs philosophes et rhéteurs tient à leurs liaisons avec la Gaule, au moins autant qu’à leur prédilection pour la Grèce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sophistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0adf2f89-fd88-3d9c-ab00-12140345c46c",
                                        "entry_id": "10dce94d-e7dc-30d0-a772-2fc24f53b41f",
                                        "glosses": [
                                            "L’art des sophistes antiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc254fd-7918-4afc-9801-a1c7c4002f2a",
                                                "sense_id": "0adf2f89-fd88-3d9c-ab00-12140345c46c",
                                                "text": "Une histoire de la sophistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb90591a-1eee-365f-82bd-e2d74179381a",
                                        "entry_id": "10dce94d-e7dc-30d0-a772-2fc24f53b41f",
                                        "glosses": [
                                            "Argumentation basée sur des sophismes ; argument de sophiste."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa88094-3571-40e4-a48b-52a4142b9f6d",
                                                "sense_id": "bb90591a-1eee-365f-82bd-e2d74179381a",
                                                "text": "Les propagateurs de réformes sociales, les utopistes et les démocrates avaient fait un tel abus de la Justice qu’on était en droit de regarder toute dissertation sur un tel sujet comme un exercice de rhétorique ou comme une sophistique destinée à égarer les personnes qui s’occupaient du mouvement ouvrier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
