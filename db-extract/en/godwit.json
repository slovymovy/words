                    {
                        "translation_id": "0e80c5dc-b170-4331-a3a7-ffcabe6817a4",
                        "source_entry_id": "095ade44-7de9-32a8-ab98-a427f5ab85fa",
                        "source_sense_id": "1c3d9bec-afc8-364a-8a9b-def103daaad7",
                        "source_sense_description": "Long-billed wading bird",
                        "target_lang_word": "Schnepfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnepfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d1d7df-1cc7-3c58-beb1-c21049c71929",
                                        "entry_id": "6ba436ba-f542-324d-87d3-a3206c46e9cd",
                                        "glosses": [
                                            "Sammelbezeichnung für die Familie der Schnepfenvögel"
                                        ],
                                        "tags": [
                                            "Scolopacidae"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3d1c06-91f1-49a1-b0f0-1fd3b979bd78",
                                                "sense_id": "66d1d7df-1cc7-3c58-beb1-c21049c71929",
                                                "text": "Allen Schnepfen gemeinsam ist der lange, spitze Schnabel."
                                            },
                                            {
                                                "example_id": "0e21c5ae-ab17-469a-a95f-04b29db487ab",
                                                "sense_id": "66d1d7df-1cc7-3c58-beb1-c21049c71929",
                                                "text": "„Eine der wenigen Begebenheiten, die den beschaulichen Inselalltag aus dem Rhythmus brachten, war der Zug der Stare, Drosseln und Schnepfen, die im Frühjahr und Herbst auf der Insel zwischenlandeten.“"
                                            },
                                            {
                                                "example_id": "0cc9b800-2908-4acb-b354-461acfd73dd5",
                                                "sense_id": "66d1d7df-1cc7-3c58-beb1-c21049c71929",
                                                "text": "„Ich aß nur saftigen Hammelbraten und Schnepfen, wie ich sie erst zwanzig Jahre später in St. Petersburg in gleicher Güte wieder fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f4da9be-927a-3dfe-8968-b7421758a223",
                                        "entry_id": "6ba436ba-f542-324d-87d3-a3206c46e9cd",
                                        "glosses": [
                                            "landläufige Bezeichnung für Waldschnepfe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420f561a-871b-478e-a1f6-31ad59b55c2a",
                                                "sense_id": "8f4da9be-927a-3dfe-8968-b7421758a223",
                                                "text": "In der Jägersprache wird die Waldschnepfe einfach Schnepfe genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96e5db9c-5b05-3d8a-a340-b9b16f1e9d38",
                                        "entry_id": "6ba436ba-f542-324d-87d3-a3206c46e9cd",
                                        "glosses": [
                                            "Bezeichnung für eine Prostituierte"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "017aaae9-279e-4777-ab79-fb91e36125d3",
                                                "sense_id": "96e5db9c-5b05-3d8a-a340-b9b16f1e9d38",
                                                "text": "Der Schnepfe sieht man gleich an, dass sie auf den Strich geht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c469dd3f-90dc-36fe-a5cf-6e7bd6df828e",
                                        "entry_id": "6ba436ba-f542-324d-87d3-a3206c46e9cd",
                                        "glosses": [
                                            "wenig geschätzte weibliche Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c064faeb-611e-4bc7-a6f5-3fccee20ae22",
                                                "sense_id": "c469dd3f-90dc-36fe-a5cf-6e7bd6df828e",
                                                "text": "Was kommt denn da für eine Schnepfe?"
                                            },
                                            {
                                                "example_id": "3f6bc8a5-54f2-4999-aa6b-b535b9e591d5",
                                                "sense_id": "c469dd3f-90dc-36fe-a5cf-6e7bd6df828e",
                                                "text": "„Es reicht ihm nicht, dass er den einen Vater in diesem großen, weiten Land hat, der dem, was er tut, seinen Segen gibt und vielleicht sogar eine Verbindung mit einer anderen Schnepfe und ihrer wunderbaren Familie in Florida einfädelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
