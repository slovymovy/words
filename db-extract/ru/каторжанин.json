                                                "sense_id": "28be5efe-7066-3c6b-81b1-1ad2ca6164de",
                                                "text": "Un desvío forzado de aeronaves civiles en vuelo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ec8c2309-3343-39b6-94aa-d235d60576b9",
                                        "entry_id": "98cfddd4-c7c8-34e9-a5cf-8d0f57eb3c66",
                                        "glosses": [
