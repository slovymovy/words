                        "glosses": [
                            "Affected by depression, depressed; dispirited; melancholic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4d614c7-ccfd-34dd-b163-9eb859733621",
                        "entry_id": "bb6fd92a-36fa-3d03-a7d2-679921dbb810",
                        "glosses": [
                            "Relating to or characteristic of depression."
