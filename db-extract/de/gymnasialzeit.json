                    {
                        "sense_id": "87472571-a5f4-385c-8042-c5280d86e60c",
                        "entry_id": "7c91acaf-a717-3b10-a5bb-92702afdbc29",
                        "glosses": [
                            "Zeitraum, den jemand im Gymnasium verbringt"
