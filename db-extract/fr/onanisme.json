        "fr-extract.jsonl": [
            {
                "entry_id": "d8da3bf9-11d7-3c44-8682-2472073b2a7e",
                "word": "onanisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "01be4af9-b77d-442f-bf38-ba7d66273009",
                        "entry_id": "d8da3bf9-11d7-3c44-8682-2472073b2a7e",
                        "tags": [
                            "plural"
                        ],
