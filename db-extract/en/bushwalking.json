                                "sense_id": "ab968ab2-888c-367d-8768-01ae347de0a2",
                                "text": "Victoria has some great bushwalking."
                            },
                            {
                                "example_id": "04746209-ca47-43fb-b621-fb55352ecc71",
                                "sense_id": "ab968ab2-888c-367d-8768-01ae347de0a2",
                                "text": "Kakadu is excellent but tough bushwalking country."
                            },
                            {
                                "example_id": "fedb2060-8af5-4b8f-bff9-861de3f8665c",
                                "sense_id": "ab968ab2-888c-367d-8768-01ae347de0a2",
                                "text": "This significant chunk of wilderness, just 7.2 mi/12 km north of Sydney, provides excellent bushwalking within a few minutes of the Manly Beach coastline."
                            },
                            {
                                "example_id": "3f03c041-8f30-451b-bbde-2eda5080df18",
                                "sense_id": "ab968ab2-888c-367d-8768-01ae347de0a2",
                                "text": "Phillip Island also offers nice beaches, good bushwalking, fishing, and Seal Rocks."
