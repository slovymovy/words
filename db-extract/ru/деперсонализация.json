                    },
                    {
                        "translation_id": "164ec66a-8a16-461b-b285-3cd5d899d812",
                        "source_entry_id": "ecef20eb-bd9d-30bb-ae0b-a7b31b3f63de",
                        "source_sense_id": "dfd6eab4-22a2-3276-a137-b578434b5740",
                        "target_lang_word": "dépersonnalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépersonnalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0f30a0-9427-3c80-8aa6-91078625c595",
                                        "entry_id": "3ac86c5c-5679-360a-86b0-a6c2cb855de4",
                                        "glosses": [
                                            "Action et résultat de l’action de dépersonnaliser, d’enlever ce qui constitue la personnalité de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1daf522f-aa3c-479b-9555-191925623ece",
                                                "sense_id": "9a0f30a0-9427-3c80-8aa6-91078625c595",
                                                "text": "Il ne s’agissait pas non plus d’un de des phénomènes d’autoscopie où des malades mentaux se voient parfois eux-mêmes à distance, je ne percevais aucune dépersonnalisation, étant au contraire vraiment présent en ces instants qui semblèrent s’étirer."
                                            },
                                            {
                                                "example_id": "3d92446c-5b01-4d4a-ac44-f03f9ea3f98b",
                                                "sense_id": "9a0f30a0-9427-3c80-8aa6-91078625c595",
                                                "text": "Le milieu économique contemporain, qui présente un modèle de dépersonnalisation idéale, offre à l’artiste un de ces terrains d’expérimentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ce7c06-dd2e-358b-9776-5ffd8e0a3563",
                                        "entry_id": "3ac86c5c-5679-360a-86b0-a6c2cb855de4",
                                        "glosses": [
                                            "Action et résultat de l’action de dépersonnaliser, de supprimer le lien à la personne physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a985a6-9d2e-49c8-bebe-5717cbcf12ed",
                                                "sense_id": "72ce7c06-dd2e-358b-9776-5ffd8e0a3563",
                                                "text": "La raison en tient probablement à une dépersonnalisation certaine de la maîtrise d’ouvrage publique. Le maître d’œuvre doit plus souvent dialoguer dorénavant avec des services plus ou moins spécialisés dans tel aspect de l’opération et non plus avec une ou quelques personnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3696514e-40c8-32f3-92e2-1ee51924302c",
                                        "entry_id": "3ac86c5c-5679-360a-86b0-a6c2cb855de4",
                                        "glosses": [
                                            "Sensation, tant sur le plan physique que psychique, de perte de la réalité et de l’intégrité corporelle, donnant l’impression d’être étranger et extérieur à soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750905f2-ce6a-4faf-8de2-ec261cd002cd",
                                                "sense_id": "3696514e-40c8-32f3-92e2-1ee51924302c",
                                                "text": "Cette dépersonnalisation protège du collapsus topique : elle permet au sujet de séparer, de « décollaber », l’événement et le fantasme « collabés »."
                                            },
                                            {
                                                "example_id": "90a06fca-fcfa-4997-a6bd-d6a94b25ceb0",
                                                "sense_id": "3696514e-40c8-32f3-92e2-1ee51924302c",
                                                "text": "La victime traumatisée ressent en permanence des sentiments de honte et de culpabilité, des sensations d’étrangeté, d’anesthésie émotionnelle, de dépersonnalisation et de confusion, qui sont à l’origine d’une très mauvaise estime de soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
