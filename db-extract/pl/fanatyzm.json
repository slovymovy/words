                                "target_senses": [
                                    {
                                        "sense_id": "f7ddfd80-ca6a-3885-8d3f-2d9c0e5bd3f7",
                                        "entry_id": "af112e2d-79fb-32ff-a69b-6caf1e6d4426",
                                        "glosses": [
                                            "al te felle hartstochtelijke ijver voor iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f08d58e-6a6d-459d-95f4-1878e0ad317f",
                                                "sense_id": "f7ddfd80-ca6a-3885-8d3f-2d9c0e5bd3f7",
                                                "text": "Wordt de 21e eeuw de eeuw van het religieus fanatisme?"
                                            }
                                        ]
