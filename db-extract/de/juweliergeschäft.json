                "senses": [
                    {
                        "sense_id": "46c13627-fc96-32c9-87df-5c0ca05ad82a",
                        "entry_id": "db86f475-da1c-3551-aa2b-77497c704f08",
                        "glosses": [
                            "Geschäft eines Juweliers, in dem hauptsächlich Schmuck angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8eea98-22ba-48d6-82ba-ae50f1b0f57a",
                                "sense_id": "46c13627-fc96-32c9-87df-5c0ca05ad82a",
                                "text": "„Wir stiegen wieder in unser Fun Car und fuhren vorbei an eleganten Boutiquen, Juweliergeschäften, die schwarze Perlen feilboten, und umzäunten Hotelanlagen.“"
                            },
                            {
                                "example_id": "c8714f1d-86c2-4b37-b1a5-674a384fb77c",
                                "sense_id": "46c13627-fc96-32c9-87df-5c0ca05ad82a",
                                "text": "„Am 14. Januar 1941, gegen die elfte Vormittagsstunde, betrat ein Herr von etwa fünfundvierzig Jahren das Juweliergeschäft von Marius Pissoladière.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
