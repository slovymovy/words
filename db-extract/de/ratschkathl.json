                                        "entry_id": "b66ff328-4d3a-3c5c-be97-02ed8510be82",
                                        "glosses": [
                                            "One who talks very quickly or incessantly; a chatty or loquacious person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bed044d-a854-4e61-9347-93d92e2d53b8",
                                                "sense_id": "a17c5522-6d41-3f61-ab22-37c2a44a9151",
                                                "text": "He's such a motormouth that I can never get a word in."
                                            },
                                            {
                                                "example_id": "944e3c6a-bd6b-41fc-ba11-edb27785b6c0",
                                                "sense_id": "a17c5522-6d41-3f61-ab22-37c2a44a9151",
                                                "text": "Blimey, Brand is checking a word with me. This is nothing like the motor-mouth on the telly, laughing in the face of everything."
                                            }
                                        ]
                                    }
                                ]
                            },
