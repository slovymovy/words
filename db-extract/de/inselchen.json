                        "form": "das Inselchen"
                    },
                    {
                        "form_id": "af9b1685-5eb1-4748-8f5e-eaa2d684a90d",
                        "entry_id": "6a9cf629-c893-3c4e-820a-2fc929ed1445",
                        "tags": [
                            "accusative",
