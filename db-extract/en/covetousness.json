                    {
                        "translation_id": "f6fea3e1-9a44-41e8-adb1-fbd8f424d9c5",
                        "source_entry_id": "ff4c7187-3bb1-3bf6-8373-7822b1020ec2",
                        "source_sense_id": "3ad39934-2e34-37b7-9c62-6ac9dc1a3cf0",
