                                                "sense_id": "40d1d161-1044-3b09-84aa-96f3d8892a91",
                                                "text": "This is no place for shopping list of my likes/dislikes/accomplishments, but if you're really special, & unattached, let's meet."
                                            },
                                            {
                                                "example_id": "383ecfca-93e3-43c3-8432-357a6e5d6321",
