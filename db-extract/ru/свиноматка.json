                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                        "entry_id": "8e73ed8f-9a06-3123-a509-fbc14b42e495",
                                        "glosses": [
                                            "weibliches Schwein ab dem ersten Ferkeln"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0ce1cc-5dbe-4ce0-8da5-d3d640ab08e2",
                                                "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                                "text": "Wir müssen noch den Eber zur Sau führen."
                                            },
                                            {
                                                "example_id": "5ecdfcad-85d3-4a59-8917-6f0b39bbec44",
                                                "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                                "text": "Der Magen einer Sau, die Gedanken einer Frau und der Inhalt einer Worscht bleiben ewig unerforscht."
                                            },
                                            {
                                                "example_id": "fefe6b57-45be-4c44-8253-9c4070f150cb",
                                                "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                                "text": "„Er lag auf einer Pritsche auf einer kleinen Erhöhung des Fußbodens, und die Tiere lagen dicht neben ihm auf der anderen Seite des Lattenzauns, ein Eber, für sich in einem Koben, im zweiten eine Sau mit zwölf Ferkeln, und einige größer junge Schweine im dritten Koben.“"
                                            },
                                            {
                                                "example_id": "b1e3ebbc-715c-4f99-8f00-89094c998dee",
                                                "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                                "text": "„Als Höhepunkt wird eine Sau geschlachtet.“"
                                            },
                                            {
                                                "example_id": "b8873863-77de-4724-9895-80ba7f4643ad",
                                                "sense_id": "8c81bb63-ee04-334e-8649-efdf351bc7f7",
                                                "text": "„Die Bären im Torgauer Gehege waren Luther wohl egal, im Unterschied zu den frei laufenden Säuen in Wittenberg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ffca132-1b4c-3653-9389-a7e875f0e063",
                                        "entry_id": "8e73ed8f-9a06-3123-a509-fbc14b42e495",
                                        "glosses": [
                                            "Schwein allgemein"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40bfb1d6-b442-4c59-a580-8ab90c1dd7a2",
                                                "sense_id": "5ffca132-1b4c-3653-9389-a7e875f0e063",
                                                "text": "„Die Bären im Torgauer Gehege waren Luther wohl egal, im Unterschied zu den frei laufenden Säuen in Wittenberg.“"
                                            },
                                            {
                                                "example_id": "8de52eea-a1e2-4c02-96c7-b9aa3a682d6d",
                                                "sense_id": "5ffca132-1b4c-3653-9389-a7e875f0e063",
                                                "text": "Hast du die Säue schon gefüttert?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4a693dab-ad0e-34bc-a23e-2bd0a9933e41",
