                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "55269144-7817-49d3-8534-48d8c9bd8205",
                        "entry_id": "b3b1cd7c-8b44-35f9-9fed-a8183e5e7c56",
