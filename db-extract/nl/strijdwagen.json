                    {
                        "sense_id": "35508d5c-996a-3cdf-a1d1-d8af9aa27a44",
                        "entry_id": "9cf0bb1c-1839-386c-9928-ac9a8af50e9c",
                        "glosses": [
                            "oorlogswagen getrokken door paarden of andere dieren (uit de oudheid)"
