                ],
                "senses": [
                    {
                        "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                        "entry_id": "e4813a10-80a7-372f-864f-7dc03924dfeb",
                        "glosses": [
                            "Menge übereinanderliegender Bücher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7a4b69-b3e1-4bb4-ba50-e22f694fd3d3",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "Der Bücherstapel ist so hoch, dass er droht umzufallen."
                            },
                            {
                                "example_id": "601d5a48-8d91-46dc-9f68-d2e7d2491288",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "Sie suchte ein bestimmtes Buch und fand es in einem der vielen Bücherstapel auf dem Schreibtisch."
                            },
                            {
                                "example_id": "5476f02b-ac4c-429c-80cb-721306928563",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "Nach dem Umzug lagen zig Bücherstapel auf dem Fußboden."
                            },
                            {
                                "example_id": "7d13fc51-0e93-4023-9cbb-e47fb9f626d3",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„In ihrem Zimmer saß Mara zwischen Bücherstapeln und strahlte.“"
                            },
                            {
                                "example_id": "57744ad3-77d4-46c4-b9eb-c5d872474036",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Der Bücherstapel wächst und wir kommen mit dem Lesen nicht hinterher“ […]."
                            },
                            {
                                "example_id": "0c2c5a57-3443-4329-a226-d48140212a11",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Unzufrieden stellte ich die beiden Bücherstapel wieder zurück ins Regal.“"
                            },
                            {
                                "example_id": "2154fe4c-1db8-46b7-a80d-7c6182e2cbe3",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Über zweieinhalb Millionen deutschsprachige Bücher gibt es. Da sind viele Schätze dabei, die es nicht in die Bestsellerlisten und Bücherstapel in den Buchhandlungen schaffen.“"
                            },
                            {
                                "example_id": "d1e7f88f-d617-409b-8ebd-212b239861fd",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Vor dem Bücherstapel neben meinem Bett brennt abends ein Teelicht, das dritte Buch von oben ist „Little fires everywhere“ von Celeste Ng.“"
                            },
                            {
                                "example_id": "c42ab274-9dc8-4eb3-be1d-5b80dc3d0fcb",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Wie gelingt es, dass der Bücherstapel auf dem Nachttisch schrumpft, statt in die Höhe zu wachsen? Wie schafft man es, mehr Bücher zu lesen, als sich neue zu kaufen? Eine Angewohnheit, für die das Japanische sogar einen eigenen Begriff kennt: tsundoku.“"
                            },
                            {
                                "example_id": "52f9b186-c6d2-4cd8-9004-db7f7be7489a",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Wenn man nur wenig Zeit hat, sich durch die enormen Bücherstapel mit französischsprachigen Neuerscheinungen des Jahres 2017 zu lesen, dann sollte dieses Buch auf jeden Fall ganz, ganz oben auf der Lektüreliste stehen.“"
                            },
                            {
                                "example_id": "f95e6821-67ba-4318-83e7-736b54df3fe4",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Ebenfalls auf meinem Bücherstapel liegt \"The Diary of a Murderer and Other Stories\" des südkoreanischen Autors Kim Young-ha, eine Sammlung von Kurzgeschichten.“"
                            },
                            {
                                "example_id": "77357b88-ad0e-4a4c-9ee9-bdb06c0a4ac0",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Zusammengekauert sitzt ein kleiner Junge im untersten Fach eines Bücherregals und liest. Obwohl er sich ganz schön klein machen muss, lächelt er und ruht mit dem Arm bequem auf einem Bücherstapel.“"
                            },
                            {
                                "example_id": "7b4b2f74-8a77-46de-b1ad-246ec9e6f4d7",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„»Nach wie vor regt mich ein Blick auf den Bücherstapel vor mir so an, dass ich ihn am liebsten gleich in Angriff nehmen würde«, sagt sie.“"
                            },
                            {
                                "example_id": "52be2393-c002-414f-a436-d31649663ff2",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "[Coronapandemie 2020:] „Überlegen Sie mal: Was wollen Sie seit Ewigkeiten erledigen, kommen aber nie dazu? Gartenarbeit, kochen, backen, puzzeln, basteln, nähen, meditieren, Möbel bauen oder den Bücherstapel neben dem Bett lesen? Jetzt ist die perfekte Zeit, wenigstens ein paar dieser Dinge zu tun.“"
                            },
                            {
                                "example_id": "804e9ea9-b051-43c3-92b8-000d09636871",
                                "sense_id": "0a4c5dba-cd5b-32e4-ac31-f7ad9eb0b1f8",
                                "text": "„Der 53-Jährige telefoniert mit einem Festnetztelefon, seine Antworten nimmt er gleichzeitig mit einem Smartphone auf, das vor ihm auf einem Bücherstapel liegt – so werden zu Coronazeiten Radio-Interviews geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
