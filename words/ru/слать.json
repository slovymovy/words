                    ]
                },
                {
                    "sense_id": "191da340-1150-3fbd-b1f0-d6cf7ebbeba3",
                    "sense_definition": "Передавать пожелания или выражать эмоции.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "передача эмоций",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>шлю</w> тебе самые теплые поздравления с днем рождения."
                        },
                        {
                            "text": "Они <w>шлют</w> нам свои искренние пожелания удачи."
