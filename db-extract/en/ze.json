            {
                "entry_id": "3a68b269-6b17-3cab-b8a4-55ee2cdd02ca",
                "word": "ze",
                "pos": "pron",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                        "entry_id": "3a68b269-6b17-3cab-b8a4-55ee2cdd02ca",
                        "glosses": [
                            "a gender-neutral third-person singular subject pronoun, equivalent to singular they, and coordinate with gendered pronouns he and she."
                        ],
                        "tags": [
                            "nonstandard",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e22e9102-1f96-4958-8c12-9b068d00978e",
                                "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                                "text": "Ze takes my right hand in hirs and folds it into a fist."
                            },
                            {
                                "example_id": "f08149f8-5b41-4b78-bca7-4169719ee583",
                                "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                                "text": "But I do know what sex ze is. It used to influence me. But now I talk to hir like a normal person. I mean, without thinking about what ze is."
                            },
                            {
                                "example_id": "22d3b845-52dd-4bc5-8c13-a5696cab7f40",
                                "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                                "text": "A case in point is Tula, a transgendered woman who for years lived well as a model and actress until ze was outed in both national and international media."
                            },
                            {
                                "example_id": "82fb543f-fa56-4cfd-93f6-48f6089892cb",
                                "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                                "text": "Ze changed hir name to one of those New Testament names, and re-fashioned hirself into a soft, puffy, half-finished hermaphrodite nicknamed, The Pop n' Fresh Doe."
                            },
                            {
                                "example_id": "4b540f61-c8b8-4f97-84db-11c516b5e492",
                                "sense_id": "9360ee0b-c296-39e6-8f73-beebc2466e29",
                                "text": "Hir face was implacable, but ze dashed away in tears."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
