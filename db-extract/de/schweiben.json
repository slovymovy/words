                            {
                                "example_id": "cedc154c-89d5-42a0-ad7a-857fe4480b2b",
                                "sense_id": "0b2e71b3-57f3-36ac-a74f-d22b015366a3",
                                "text": "Den ganzn Dreck hat der Regn vo da Straßn gschwoabt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc473c83-ac93-3667-9a1f-e85007d1ff38",
