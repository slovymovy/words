                "senses": [
                    {
                        "sense_id": "165631a4-b1ed-3ccf-b695-778ee8a7388c",
                        "entry_id": "2b55b40b-8cd3-34e6-8afc-d25598f042d7",
                        "glosses": [
                            "Qui nanise une plante (lui donne une taille naine), en parlant d’un porte-greffe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc431ee8-3e8e-429e-87a9-96587351f32b",
                                "sense_id": "165631a4-b1ed-3ccf-b695-778ee8a7388c",
                                "text": "Aussi l’objectif primordial est la recherche d’un effet nanisant du porte-greffe de façon à accélérer la mise à fruit, réduire le volume des arbres et faciliter la récolte, mais aussi augmenter la densité de plantation."
                            },
                            {
                                "example_id": "9a0179a8-efa6-4370-a4d4-a783ff66f92a",
                                "sense_id": "165631a4-b1ed-3ccf-b695-778ee8a7388c",
                                "text": "La vigueur de la partie aérienne et la productivité sont également tributaires du choix du porte-greffe. Ainsi, dans certaines régions, les sélectionneurs recherchent des porte-greffe nanisants afin de réaliser des plantations à haute densité."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b2fac11-d277-35d4-8f8d-af2d85cc14fd",
                        "entry_id": "2b55b40b-8cd3-34e6-8afc-d25598f042d7",
                        "glosses": [
                            "Qualifie certaines maladies qui limitent anormalement la croissance d’une plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec348597-379a-4e87-9533-6263c06a16c9",
                                "sense_id": "6b2fac11-d277-35d4-8f8d-af2d85cc14fd",
                                "text": "La jaunisse nanisante de l’orge."
                            }
                        ]
                    }
