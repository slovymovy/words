{
    "word_family": [
        "touch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "381c9ced-f325-3344-a82e-41ce15055234",
                    "sense_definition": "Easily offended or oversensitive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He can be very <w>touchy</w> when you talk about his cat, so be as tactful as possible.",
                            "target_lang_translations": {
                                "fr": "Il peut être très <w>susceptible</w> quand on parle de son chat, alors sois aussi diplomate que possible."
                            }
                        },
                        {
                            "text": "Why are you so <w>touchy</w> about such a small mistake?",
                            "target_lang_translations": {
                                "fr": "Pourquoi es-tu si <w>susceptible</w> pour une si petite erreur ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "irritable",
                        "irascible",
                        "cranky",
                        "tetchy"
                    ],
                    "common_phrases": [
                        "get touchy"
                    ],
                    "target_lang_definitions": {
                        "fr": "Facilement offensé, prompt à se vexer ou hypersensible."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "susceptible",
                                "target_lang_sense_clarification": "qui se vexe facilement"
                            },
                            {
                                "target_lang_word": "chatouilleux",
                                "target_lang_sense_clarification": "au sens figuré, ombrageux sur un sujet"
                            },
                            {
                                "target_lang_word": "irascible",
                                "target_lang_sense_clarification": "prompt à s'énerver"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f87eb70f-9df5-32da-b6ef-fddc95cc13ee",
                    "sense_definition": "Requiring caution or tactfulness because a situation is volatile or unstable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is an extremely <w>touchy</w> situation, with everybody's patience wearing thin.",
                            "target_lang_translations": {
                                "fr": "C'est une situation extrêmement <w>délicate</w>, la patience de chacun commençant à s'épuiser."
                            }
                        },
                        {
                            "text": "The manager avoided the <w>touchy</w> subject of budget cuts during the meeting.",
                            "target_lang_translations": {
                                "fr": "Le responsable a évité le sujet <w>épineux</w> des réductions budgétaires pendant la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "delicate"
                    ],
                    "common_phrases": [
                        "touchy subject",
                        "touchy situation"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui exige de la prudence ou du tact car la situation est délicate ou explosive."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "délicat",
                                "target_lang_sense_clarification": "nécessitant de la précaution"
                            },
                            {
                                "target_lang_word": "épineux",
                                "target_lang_sense_clarification": "complexe et source de conflit"
                            },
                            {
                                "target_lang_word": "sensible",
                                "target_lang_sense_clarification": "qui peut facilement provoquer des réactions vives"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd9762ff-0de2-3123-93a4-cb2df2669b86",
                    "sense_definition": "Inclined to engage in physical touch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a very <w>touchy</w> person who always puts his hand on your shoulder.",
                            "target_lang_translations": {
                                "fr": "C'est une personne très <w>tactile</w> qui vous met toujours la main sur l'épaule."
                            }
                        },
                        {
                            "text": "Some people are naturally <w>touchy</w> while others prefer to keep their distance.",
                            "target_lang_translations": {
                                "fr": "Certaines personnes sont naturellement <w>tactiles</w>, tandis que d'autres préfèrent garder leurs distances."
                            }
                        }
                    ],
                    "synonyms": [
                        "handsy",
                        "touchy-feely"
                    ],
                    "antonyms": [
                        "untouchy"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui a tendance à toucher physiquement les gens lorsqu'il communique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tactile",
                                "target_lang_sense_clarification": "qui aime le contact physique"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}