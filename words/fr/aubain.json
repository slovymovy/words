                {
                    "sense_id": "63ec7e25-a27b-3020-aa33-9f637e241dd9",
                    "sense_definition": "Sous l'Ancien Régime, étranger non naturalisé qui était privé de la capacité de tester et de transmettre ses biens par succession.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "étranger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, les biens d'un <w>aubain</w> revenaient automatiquement à la couronne après son décès."
                        },
                        {
                            "text": "Ce marchand flamand avait le statut d'<w>aubain</w> et ne pouvait pas léguer ses possessions à ses enfants."
                        }
                    ],
                    "synonyms": [
                        "étranger"
                    ],
                    "antonyms": [
                        "régnicole",
                        "sujet"
                    ],
                    "common_phrases": [
