{
    "word_family": [
        "judgment",
        "judiciary",
        "judicial",
        "judicious",
        "judgmental",
        "adjudge",
        "misjudge",
        "prejudge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bd119f8-e5aa-3f5d-8777-091570564530",
                    "sense_definition": "A public official whose duty it is to administer the law, especially by presiding over trials and rendering judgments.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>judge</w> listened carefully to both sides before making a final decision.",
                            "target_lang_translations": {
                                "ru": "<w>Судья</w> внимательно выслушал обе стороны, прежде чем принять окончательное решение."
                            }
                        },
                        {
                            "text": "A high-court <w>judge</w> presided over the complex legal case.",
                            "target_lang_translations": {
                                "ru": "<w>Судья</w> верховного суда председательствовал на этом сложном процессе."
                            }
                        }
                    ],
                    "synonyms": [
                        "justice",
                        "magistrate"
                    ],
                    "common_phrases": [
                        "high-court judge",
                        "presiding judge",
                        "federal judge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо, наделённое судебной властью, которое ведёт судебные процессы и выносит решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "в юридическом смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30b2a982-440b-39e6-b0c4-de043d8dd55f",
                    "sense_definition": "A person who evaluates something or forms an opinion based on their expertise or perception.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a good <w>judge</w> of wine and can identify the region easily.",
                            "target_lang_translations": {
                                "ru": "Она хороший <w>знаток</w> вин и может легко определить регион."
                            }
                        },
                        {
                            "text": "They say he is a poor <w>judge</w> of character considering all the unreliable friends he has.",
                            "target_lang_translations": {
                                "ru": "Говорят, что он плохо <w>разбирается</w> в людях, учитывая, сколько у него ненадежных друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "deemer"
                    ],
                    "common_phrases": [
                        "good judge",
                        "poor judge",
                        "judge of character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который оценивает что-либо или формирует мнение на основе своего опыта или восприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "ценитель или знаток"
                            },
                            {
                                "target_lang_word": "знато́к",
                                "target_lang_sense_clarification": "человек с обширными знаниями"
                            },
                            {
                                "target_lang_word": "цени́тель",
                                "target_lang_sense_clarification": "тот, кто умеет признавать ценность"
                            },
                            {
                                "target_lang_word": "экспе́рт",
                                "target_lang_sense_clarification": "высококлассный специалист"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f17b53-76ea-34d3-8a65-6dc8c388c41e",
                    "sense_definition": "A person officiating at a sports event, a contest, or a competition to determine the winner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At a boxing match, the decision of the <w>judges</w> is final.",
                            "target_lang_translations": {
                                "ru": "В боксерском поединке решение <w>судей</w> является окончательным."
                            }
                        },
                        {
                            "text": "The panel of <w>judges</w> awarded the gymnast a perfect score.",
                            "target_lang_translations": {
                                "ru": "Коллегия <w>судей</w> поставила гимнасту высший балл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "panel of judges",
                        "competition judge",
                        "line judge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, следящее за соблюдением правил и определяющее победителя в спортивных состязаниях или конкурсах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "в спорте или конкурсе"
                            },
                            {
                                "target_lang_word": "арби́тр",
                                "target_lang_sense_clarification": "спортивный судья"
                            },
                            {
                                "target_lang_word": "ре́фери́",
                                "target_lang_sense_clarification": "судья в некоторых видах спорта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c9badb-d374-3c88-a526-704ffb91a542",
                    "sense_definition": "A person who decides the fate of someone or something that has been called into question.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this situation, you are the only <w>judge</w> of your own future.",
                            "target_lang_translations": {
                                "ru": "В этой ситуации только вы сами <w>вершитель</w> своего будущего."
                            }
                        },
                        {
                            "text": "History will be the ultimate <w>judge</w> of the politician's controversial actions.",
                            "target_lang_translations": {
                                "ru": "История станет окончательным <w>судьёй</w> противоречивых действий этого политика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ultimate judge",
                        "sole judge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто определяет судьбу кого-либо или чего-либо в спорной или важной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "верши́тель",
                                "target_lang_sense_clarification": "тот, кто решает судьбу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a00dfff6-0941-3054-a20c-525245af4a47",
                    "sense_definition": "A temporary leader or ruler appointed in times of crisis in ancient Israel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biblical book describes how each <w>judge</w> led the people during wartime.",
                            "target_lang_translations": {
                                "ru": "Библейская книга описывает, как каждый <w>судья</w> вел народ во время войны."
                            }
                        },
                        {
                            "text": "Gideon was a famous <w>judge</w> who delivered his people from their enemies.",
                            "target_lang_translations": {
                                "ru": "Гедеон был знаменитым <w>судьёй</w>, который избавил свой народ от врагов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временный вождь или правитель в древнем Израиле, назначаемый в периоды кризиса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья́",
                                "target_lang_sense_clarification": "библейский правитель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e649817-0b5e-3e2f-bc25-2ffca8f96699",
                    "sense_definition": "To form an opinion on or appraise someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>judge</w> a book by its cover before reading it.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>судить</w> о книге по обложке, не прочитав её."
                            }
                        },
                        {
                            "text": "I <w>judge</w> a man's character by how he treats his subordinates.",
                            "target_lang_translations": {
                                "ru": "Я <w>сужу</w> о характере человека по тому, как он относится к своим подчиненным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge by appearance",
                        "judge a book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составлять мнение о ком-либо или оценивать чьи-либо качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "составлять мнение"
                            },
                            {
                                "target_lang_word": "оце́нивать",
                                "target_lang_sense_clarification": "определять достоинства или характер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8a5afcd-6e1f-3f87-b4ee-b336e16ba8ed",
                    "sense_definition": "To have as an opinion; to consider or suppose something to be true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>judge</w> it safe to leave the house once the storm has passed.",
                            "target_lang_translations": {
                                "ru": "Я <w>считаю</w>, что выходить из дома безопасно, как только шторм утихнет."
                            }
                        },
                        {
                            "text": "The doctor <w>judged</w> the patient well enough to be discharged from the hospital.",
                            "target_lang_translations": {
                                "ru": "Врач <w>сочел</w>, что состояние пациента позволяет выписать его из больницы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge it safe",
                        "judge it necessary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать или полагать что-либо верным; иметь определенное мнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счита́ть",
                                "target_lang_sense_clarification": "иметь мнение"
                            },
                            {
                                "target_lang_word": "полага́ть",
                                "target_lang_sense_clarification": "предполагать"
                            },
                            {
                                "target_lang_word": "сче́сть",
                                "target_lang_sense_clarification": "расценить каким-либо образом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4fff2a2-e75e-3d66-a605-58b6e27b36ba",
                    "sense_definition": "To form an opinion or reach a conclusion by inferring from evidence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>judge</w> from the sky that it might rain later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Судя по небу, я <w>полагаю</w>, что сегодня днем может пойти дождь."
                            }
                        },
                        {
                            "text": "Based on the evidence, we can <w>judge</w> that the experiment was a success.",
                            "target_lang_translations": {
                                "ru": "Основываясь на доказательствах, мы можем <w>заключить</w>, что эксперимент прошел успешно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge from evidence",
                        "judge from results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать выводы или приходить к заключению на основе имеющихся фактов или улик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "делать вывод по признакам"
                            },
                            {
                                "target_lang_word": "заключа́ть",
                                "target_lang_sense_clarification": "делать логический вывод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8be32e9c-a22d-3b0c-b6d8-edf283da1433",
                    "sense_definition": "To criticize or be judgmental toward another person, often unfairly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please don't <w>judge</w> me for the mistakes I made when I was younger.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>осуждайте</w> меня за ошибки, которые я совершил в молодости."
                            }
                        },
                        {
                            "text": "It is easy to <w>judge</w> others when you do not know their full story.",
                            "target_lang_translations": {
                                "ru": "Легко <w>судить</w> других, когда не знаешь их историю целиком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "don't judge me",
                        "judge others"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать или проявлять предвзятость по отношению к другому человеку, часто несправедливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осужда́ть",
                                "target_lang_sense_clarification": "порицать, высказывать неодобрение"
                            },
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "давать строгую оценку"
                            },
                            {
                                "target_lang_word": "критикова́ть",
                                "target_lang_sense_clarification": "указывать на недостатки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d915e51a-0b29-3631-a396-e339d5597d05",
                    "sense_definition": "To sit in judgment on or pass a formal sentence on a person in a legal context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court will <w>judge</w> the defendant based on the testimony provided.",
                            "target_lang_translations": {
                                "ru": "Суд будет <w>судить</w> подсудимого на основании представленных показаний."
                            }
                        },
                        {
                            "text": "A higher power will <w>judge</w> you for your actions after you are dead.",
                            "target_lang_translations": {
                                "ru": "Высшая сила будет <w>судить</w> тебя за твои поступки после смерти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge a case",
                        "judge the defendant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать дело в суде или выносить официальный приговор подсудимому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "рассматривать дело в суде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a8d7863-c86e-3a53-8647-5b074b9020bb",
                    "sense_definition": "To arbitrate or pass an opinion to settle a dispute between parties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot both be right; you must <w>judge</w> between us to settle this.",
                            "target_lang_translations": {
                                "ru": "Мы оба не можем быть правы; ты должен <w>рассудить</w> нас, чтобы уладить это."
                            }
                        },
                        {
                            "text": "The committee was asked to <w>judge</w> the dispute between the two neighbors.",
                            "target_lang_translations": {
                                "ru": "Комитет попросили <w>рассудить</w> спор между двумя соседями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge between",
                        "judge a dispute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать посредником или высказывать мнение для разрешения спора между сторонами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассуди́ть",
                                "target_lang_sense_clarification": "разрешить спор"
                            },
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "выступать арбитром"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "984008fa-a84e-31d4-a72f-cf629f89fe3a",
                    "sense_definition": "To act as a judge or perform the functions of a judge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Justices in this country <w>judge</w> without appeal in certain specific cases.",
                            "target_lang_translations": {
                                "ru": "Судьи в этой стране <w>выносят решения</w> без права апелляции в определенных случаях."
                            }
                        },
                        {
                            "text": "He has been invited to <w>judge</w> at the international film festival this year.",
                            "target_lang_translations": {
                                "ru": "В этом году его пригласили <w>судить</w> на международном кинофестивале."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judge without appeal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять функции судьи или действовать в качестве арбитра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суди́ть",
                                "target_lang_sense_clarification": "выполнять работу судьи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15790db7-0743-3d22-9a10-b0d1230de83f",
                    "sense_definition": "To sentence to punishment or to judicially condemn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>judged</w> to die for his crimes against the state.",
                            "target_lang_translations": {
                                "ru": "Он был <w>приговорен</w> к смерти за преступления против государства."
                            }
                        },
                        {
                            "text": "The prisoner was <w>judged</w> to serve ten years in a high-security facility.",
                            "target_lang_translations": {
                                "ru": "Заключенного <w>осудили</w> на десять лет в колонии строгого режима."
                            }
                        }
                    ],
                    "common_phrases": [
                        "judged to die",
                        "judged to serve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приговаривать к наказанию или официально осуждать в судебном порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуди́ть",
                                "target_lang_sense_clarification": "вынести обвинительный приговор"
                            },
                            {
                                "target_lang_word": "приговори́ть",
                                "target_lang_sense_clarification": "назначить меру наказания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da847002-c8d7-39c3-b8f4-ea025f8095bd",
                    "sense_definition": "To govern as a biblical judge or shophet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "And after him arose Jair a Gileadite, and <w>judged</w> Israel twenty and two years.",
                            "target_lang_translations": {
                                "ru": "После него восстал Иаир Галаадитянин и <w>был судьёй</w> Израиля двадцать два года."
                            }
                        },
                        {
                            "text": "The ancient text records that he <w>judged</w> the tribes for a decade.",
                            "target_lang_translations": {
                                "ru": "Древний текст гласит, что он <w>правил</w> племенами в течение десятилетия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять народом в качестве библейского судьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть судьёй",
                                "target_lang_sense_clarification": "править в библейском контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "69b3bf0e-5691-332e-8ec9-b477d1c762ce",
                    "sense_definition": "The formal title used for a judge, often capitalized.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "I am saddened and disappointed in the way <w>Judge</w> Ehrlich behaved on the video.",
                            "target_lang_translations": {
