                "senses": [
                    {
                        "sense_id": "41dd0c73-600f-3762-b587-29b17ea16040",
                        "entry_id": "de4c3c6b-f1d3-31b9-a7eb-b57c04abacda",
                        "glosses": [
                            "schriftliche Anweisungen mit Platzregeln und speziellen Bahninformationen zum Erspielen eines besseren Ergebnisses"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "1e9100b6-edc9-43c0-986c-8bd67ba92989",
                                "sense_id": "41dd0c73-600f-3762-b587-29b17ea16040",
                                "text": "„Ein Birdiebook, wie es in manchen Clubs zu haben ist, bietet die Platzregeln und die Bahninformationen sozusagen zum Mitnehmen auf die Runde an. Diese kleinen Broschüren können mitunter sehr hilfreich sein, […]“"
                            },
                            {
                                "example_id": "207c95fb-79d5-4696-b32a-26b3cfd39415",
                                "sense_id": "41dd0c73-600f-3762-b587-29b17ea16040",
                                "text": "„Von geringerer Bedeutung ist dagegen, ob Sie den Platz, auf dem das Turnier stattfindet, schon kennen. Im Pro-Shop des betreffenden Clubs gibt es ein so genanntes Birdiebook, das Bilder und Zeichnungen mit den entsprechenden Entfernungsangaben enthält.“"
                            },
                            {
                                "example_id": "7d11daea-727d-4322-9ef0-6b401bbdb8c2",
                                "sense_id": "41dd0c73-600f-3762-b587-29b17ea16040",
                                "text": "Vor dem Turnier habe ich mir vom Platz ein Birdiebook besorgt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
