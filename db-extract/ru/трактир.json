                    {
                        "translation_id": "5ccb746f-fefd-4ea1-a63c-d3b602cb9bf5",
                        "source_entry_id": "9f233ff3-8f19-3f9e-b22b-d465c2296cf4",
                        "source_sense_description": "ресторан низшего разряда",
                        "target_lang_word": "Wirtshaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirtshaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                        "entry_id": "afca0b1f-7be8-3ce6-8552-288b707504e3",
                                        "glosses": [
                                            "Haus, in dem Gäste mit Speis und Trank bewirtet werden, oft auch mit Gästezimmern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ae754b-9907-4886-90a3-a78ea68c5b18",
                                                "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                                "text": "Sie kehrten in ein Wirtshaus ein."
                                            },
                                            {
                                                "example_id": "98190859-8794-4626-8a22-444280637d93",
                                                "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                                "text": "„Ein Prinzip der familiären Abhängigkeit, zu dem die Wirtsleute notgedrungen gezwungen waren, denn ihre Wirtshäuser konnten nur überleben, weil sich sämtliche Familienmitglieder widerspruchslos unterordneten.“"
                                            },
                                            {
                                                "example_id": "20b1902c-939f-4ee1-850a-e3ee0060ce2c",
                                                "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                                "text": "„Er muß sich in diesem Augenblick daran erinnert haben, daß er, bei den Redereien über Hainstock in den Wirtshäusern von Eigelscheid oder Habscheid, die ihn eines Tages veranlaßt haben, den Mann in seinem Steinbruch aufzusuchen, auch einmal von einer Freundin Hainstocks hat läuten hören.“"
                                            },
                                            {
                                                "example_id": "b9bf75c9-63d4-48d4-84a0-2acc27d16d49",
                                                "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                                "text": "„Im Wirtshaus sitzt ein Rothaariger einem Glatzkopf gegenüber.“"
                                            },
                                            {
                                                "example_id": "92df9ab9-f3ab-4e73-92d2-220b790803ef",
                                                "sense_id": "bd542be7-860b-35ab-85e0-1aaaa2bfffb5",
                                                "text": "„Wir fanden schließlich in einem Wirtshaus einen Bauer, der jenseits der Grenze ein Stück Land hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
