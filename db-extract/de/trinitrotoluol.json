                                "sense_id": "1464289c-0e53-3556-91d3-9f161a21b4c1",
                                "text": "Trinitrotoluol ist der bekannteste chemisch homogene Explosivstoff."
                            },
                            {
                                "example_id": "9ab91881-760c-404f-9646-21b2473cd3fe",
                                "sense_id": "1464289c-0e53-3556-91d3-9f161a21b4c1",
                                "text": "Die Sprengwirkung von Trinitrotoluol dient als Maß für die Wirkung von Kernwaffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
