                                        "entry_id": "9a68d40b-4b34-35ac-a2ca-460aee24bd43",
                                        "glosses": [
                                            "(Wild, besonders Schwarzwild) durch Verteilung von Futter in Form von Körnern (zum Beispiel Maiskörner) anlocken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fcad967-d2f1-4222-af0a-18b824f0d5cb",
                                                "sense_id": "b0699b21-d64e-3581-97cd-c41334e6a08d",
                                                "text": "„Sauen werden in besonderen Saufängen, zu welchen sie vorher sorgfältig angekörnt, d. h. durch ausgestreute Äsung gelockt sind, gefangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
