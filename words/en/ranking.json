                    "sense_id": "1e86234c-46de-3d5a-86a2-8dbcf18dc0d1",
                    "sense_definition": "Superior in rank, position, or authority; holding the highest status in a group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the <w>ranking</w> officer at the scene, she took immediate command of the operation.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>старшим</w> офицером на месте происшествия, она немедленно взяла на себя руководство операцией.",
                                "de": "Als <w>ranghöchste</w> Offizierin vor Ort übernahm sie sofort das Kommando über den Einsatz.",
                                "pl": "Jako <w>najstarsza</w> rangą oficer na miejscu zdarzenia, natychmiast przejęła dowodzenie nad operacją.",
                                "tr": "Olay yerindeki <w>en yüksek rütbeli</w> subay olarak operasyonun komutasını derhal devraldı."
                            }
                        },
                        {
                            "text": "He is the <w>ranking</w> member of the committee and leads all the discussions.",
                            "target_lang_translations": {
                                "ru": "Он является <w>высокопоставленным</w> членом комитета и ведет все дискуссии.",
                                "de": "Er ist das <w>dienstälteste</w> Mitglied des Ausschusses und leitet alle Diskussionen.",
                                "pl": "Jest on <w>najwyższym</w> rangą członkiem komisji i prowadzi wszystkie dyskusje.",
                                "tr": "Komitenin <w>en kıdemli</w> üyesidir ve tüm tartışmaları o yönetir."
                            }
                        }
