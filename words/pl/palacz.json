                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Palacz</w> przyszedł dzisiaj punktualnie na umówione spotkanie rekrutacyjne.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Паляч</w> пришёл сегодня вовремя на назначенное собеседование."
                            }
                        },
                        {
                            "text": "Wczorajszy wykład o historii regionu poprowadził profesor Jan <w>Palacz</w>.",
                            "target_lang_translations": {
                                "ru": "Вчерашнюю лекцию по истории региона провёл профессор Ян <w>Паляч</w>."
                            }
                        }
                    ],
                    "traits": [
