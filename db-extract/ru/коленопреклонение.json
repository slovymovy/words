                "senses": [
                    {
                        "sense_id": "b2cba3d6-b15a-37da-9ef0-f43e43306d1f",
                        "entry_id": "45093b36-3878-3a6a-b19e-8e7cf20061e0",
                        "glosses": [
                            "высок. стояние на коленях во время молитвы, богослужения, либо в знак преклонения или мольбы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a3bc27-b56d-4aa7-a229-dbb2ee73c853",
                                "sense_id": "b2cba3d6-b15a-37da-9ef0-f43e43306d1f",
                                "text": "Запрещение коленопреклонений и поста в воскресные дни является общим в христианской литературе, начиная с III века."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fa9d37b-784e-4528-b6e8-af0123102764",
                        "source_entry_id": "45093b36-3878-3a6a-b19e-8e7cf20061e0",
                        "source_sense_id": "b2cba3d6-b15a-37da-9ef0-f43e43306d1f",
                        "target_lang_word": "genuflection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genuflection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                                        "entry_id": "fd81e5ea-ad3d-3d7f-a487-e856ffaaffc9",
                                        "glosses": [
                                            "The act of genuflecting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e31e21a-5981-42af-b5b5-2387fccc8760",
                                                "sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                                                "text": "Those impious Pigs,\nWho, by frequent squeaks, have dared impugn\nThe settled Swellfoot system, or to make\nIrreverent mockery of the genuflexions\nInculcated by the arch-priest, have been whipt\nInto a loyal and an orthodox whine."
                                            },
                                            {
                                                "example_id": "ecfd584c-18b9-499c-a2b9-099bdabc04ff",
                                                "sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                                                "text": "Certain business titans have made Mar-A-Lago a scene of such flagrant self-abnegation, ring-kissing, and genuflection that it would embarrass a medieval Pope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2231dd-3ae3-46ee-9250-eeba69509704",
