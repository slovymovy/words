                                "sense_id": "e26cefb0-8f2a-3b04-98b7-0bd4845aadc4",
                                "text": "Die Hose kneift am Säckel"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7f1339cd-8987-3844-b1a6-013cf73629d2",
                        "entry_id": "6c581217-30bf-3a0b-b9ff-d0ecc08aaede",
                        "glosses": [
                            "Schimpfwort für eine dumme, unerfahrene oder noch nicht erwachsene männliche Person"
                        ],
