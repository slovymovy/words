                ],
                "senses": [
                    {
                        "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                        "entry_id": "bf9a6c92-5c59-367b-ba86-64d17ef24506",
                        "glosses": [
                            "ein wasserlösliches Vitamin B"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "3bc5d8e2-8662-4068-8aa5-f89143db4070",
                                "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                                "text": "Die empfohlene tägliche Dosierung von Niacin liegt zwischen 2 und 12 mg für Kinder, bei 14 mg für Frauen, 16 mg für Männer und 18 mg pro Tag für Schwangere und stillende Mütter."
                            },
                            {
                                "example_id": "a0a5a877-8eed-4d3b-b666-f1edfc5ce4a5",
                                "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                                "text": "Natürliche Lieferanten von Niacin sind Fleisch, Fisch, Nüsse, Gemüse, Bierhefe, Geflügel, Wild, Pilze, […], Obst, Milchprodukte, Eier, Leber, Kaffee und Vollkornprodukte."
                            },
                            {
                                "example_id": "28710089-c39b-4dbd-80f7-5df4d4c89ef9",
                                "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                                "text": "Verursacher [der Pellagra] war der Mangel am lebenswichtigen Vitamin Niacin; die Polenta aus Mais reichte eben allein nicht zur Ernährung aus."
                            },
                            {
                                "example_id": "1a0d0e7a-7896-45cb-ba93-d616c43cc033",
                                "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                                "text": "Die Kanadier lösten Erröten künstlich aus, indem sie Versuchspersonen Prostaglandine einspritzten oder 50 bis 100 Milligramm des Vitamins Niacin einnehmen ließen."
                            },
                            {
                                "example_id": "a9d77257-fc5d-4895-a1c3-2f22e097ab8b",
                                "sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                                "text": "Das B-Vitamin Niacin könnte helfen, die Langzeitfolgen von Multipler Sklerose zu vermindern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d33d89d6-824e-474a-976b-cf96f36604d7",
                        "source_entry_id": "bf9a6c92-5c59-367b-ba86-64d17ef24506",
                        "source_sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                        "source_sense_description": "Biochemie: ein wasserlösliches Vitamin B",
                        "target_lang_word": "niacin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niacin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f032588c-d4b1-3821-b833-dfa2fbed732a",
                                        "entry_id": "6fb3343e-64e7-3bc0-b065-7ef0cbde2d30",
                                        "glosses": [
                                            "A water-soluble vitamin, a component of vitamin B complex, found in meat, yeast, and dairy products; it is essential to metabolism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e0917d-b018-4ef0-b18c-329f888884fa",
                                                "sense_id": "f032588c-d4b1-3821-b833-dfa2fbed732a",
                                                "text": "Mixing the alkali into the recipe in the right way chemically releases the otherwise unavailable niacin in the corn, which stops pellagra in its tracks, and allowed corn-based agricultural populations to grow and spread."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51c2212e-e3f6-4708-b644-d6fd63630d98",
                        "source_entry_id": "bf9a6c92-5c59-367b-ba86-64d17ef24506",
                        "source_sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                        "source_sense_description": "Biochemie: ein wasserlösliches Vitamin B",
                        "target_lang_word": "niacine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niacine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4e1bde-bdf0-3ca2-82d4-36c58496b624",
                                        "entry_id": "607503c2-085d-333d-b095-e2d80f822485",
                                        "glosses": [
                                            "L’une des deux formes de la vitamine B₃."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0581c376-8423-4aaa-b147-3ba7fa325038",
                                                "sense_id": "fa4e1bde-bdf0-3ca2-82d4-36c58496b624",
                                                "text": "Les chamans tenaient le kumis pour un agent énergétique sans équivalent et l’utilisaient dans de nombreux rituels. De récentes études en ont confirmé les bienfaits sur la santé. Elles ont révélé notamment que le lait fermenté issu de la traite de juin – période où le festival battait son plein – fournissaient des niveaux particulièrement élevés de vitamine E, de niacine, et d’acide déshydroascorbique chargé en vitamine C."
                                            },
                                            {
                                                "example_id": "8fe3a8c6-c26d-4d75-bef9-7abf2949d559",
                                                "sense_id": "fa4e1bde-bdf0-3ca2-82d4-36c58496b624",
                                                "text": "De la même façon que l’histoire de la thiamine est liée au béribéri, celle de la niacine est liée à la pellagre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "899cfa2e-6347-4826-99fe-4f8b5e533ecf",
                        "source_entry_id": "bf9a6c92-5c59-367b-ba86-64d17ef24506",
                        "source_sense_id": "0ce00f47-82b7-381f-9c1e-3a31ebc97100",
                        "source_sense_description": "Biochemie: ein wasserlösliches Vitamin B",
                        "target_lang_word": "acide nicotinique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide nicotinique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df1cbf58-b1e3-3acf-b9c8-42fd03a1fb9f",
                                        "entry_id": "73dc545d-dc7c-3ac4-bbb6-3fb3b2b116e3",
                                        "glosses": [
                                            "Autre nom de la niacine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acfd74c-e413-4e57-98c6-2e69fcee383b",
                                                "sense_id": "df1cbf58-b1e3-3acf-b9c8-42fd03a1fb9f",
                                                "text": "Il comporte deux additifs chimiques : de l’acide nicotinique (E375) et des tocophérols (E306), des antioxydants censés empêcher les matières grasses de rancir mais dont l’origine est incertaine. — (« Céréales : Coût de corn », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 20)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
