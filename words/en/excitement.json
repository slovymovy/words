    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7a9b9e3-1485-3687-9b1f-e818ff8a54cc",
                    "sense_definition": "The state of feeling very happy, enthusiastic, or eager.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children jumped up and down with <w>excitement</w> when they saw the presents.",
                            "target_lang_translations": {
                                "ru": "Дети запрыгали от <w>восторга</w>, когда увидели подарки.",
                                "de": "Die Kinder sprangen vor <w>Aufregung</w> auf und ab, als sie die Geschenke sahen.",
                                "zh": "孩子们看到礼物时，<w>兴奋</w>得跳了起来。"
                            }
                        },
                        {
                            "text": "There was a lot of <w>excitement</w> in the crowd before the concert started.",
                            "target_lang_translations": {
                                "ru": "Перед началом концерта в толпе царило сильное <w>волнение</w>.",
                                "de": "Vor Beginn des Konzerts herrschte in der Menge große <w>Aufregung</w>.",
                                "zh": "音乐会开始前，人群中充满了<w>激动</w>的情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enthusiasm",
                        "exhilaration",
                        "thrill",
                        "eagerness",
                        "anticipation"
                    ],
                    "antonyms": [
                        "boredom",
                        "calm",
                        "indifference"
                    ],
                    "common_phrases": [
                        "excitement about",
                        "with excitement",
                        "in excitement",
                        "cause excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильной радости, энтузиазма или нетерпения",
                        "de": "Der Zustand, sich sehr glücklich, enthusiastisch oder erwartungsvoll zu fühlen.",
                        "zh": "感到非常快乐、热情或急切的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "эмоциональное возбуждение, переживание"
                            },
                            {
                                "target_lang_word": "восторг",
                                "target_lang_sense_clarification": "сильная радость, восхищение"
                            },
                            {
                                "target_lang_word": "азарт",
                                "target_lang_sense_clarification": "страстная увлечённость, запальчивость"
                            },
                            {
                                "target_lang_word": "воодушевление",
                                "target_lang_sense_clarification": "душевный подъём, энтузиазм"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aufregung",
                                "target_lang_sense_clarification": "Gefühl der Anspannung oder Unruhe, oft bei freudigen Ereignissen"
                            },
                            {
                                "target_lang_word": "Begeisterung",
                                "target_lang_sense_clarification": "überschwängliche Freude und starkes Interesse"
                            },
                            {
                                "target_lang_word": "Vorfreude",
                                "target_lang_sense_clarification": "die freudige Erwartung auf ein kommendes Ereignis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兴奋",
                                "target_lang_sense_clarification": "情绪高涨，精神振奋"
                            },
                            {
                                "target_lang_word": "激动",
                                "target_lang_sense_clarification": "由于受到刺激而情绪冲动"
                            },
                            {
                                "target_lang_word": "热情",
                                "target_lang_sense_clarification": "热烈的感情或积极的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14863e11-33fe-3272-b855-5e1919e24775",
                    "sense_definition": "Something that causes a feeling of enthusiasm or eagerness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exciting_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He missed the <w>excitements</w> of living in a big city after moving to the country.",
                            "target_lang_translations": {
                                "ru": "После переезда в деревню он скучал по <w>развлечениям</w> жизни в большом городе.",
                                "de": "Nach dem Umzug aufs Land vermisste er die <w>Abwechslung</w> des Lebens in einer Großstadt.",
                                "zh": "搬到乡下后，他怀念在大城市生活的那些<w>乐趣</w>。"
                            }
                        },
                        {
                            "text": "The job offers plenty of challenges and <w>excitements</w> for a young professional.",
                            "target_lang_translations": {
                                "ru": "Эта работа предлагает множество вызовов и <w>ярких впечатлений</w> для молодого специалиста.",
                                "de": "Der Job bietet einem jungen Berufstätigen viele Herausforderungen und <w>spannende Erlebnisse</w>.",
                                "zh": "这份工作为年轻的专业人士提供了许多挑战和<w>刺激</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrill",
                        "adventure"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "seek excitement",
                        "look for excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что вызывает чувство энтузиазма или интереса; захватывающее событие",
                        "de": "Etwas, das ein Gefühl von Begeisterung oder Eifer hervorruft; ein spannendes Ereignis.",
                        "zh": "引起热情或急切感的事物；令人兴奋的事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "интересное или веселое занятие"
                            },
                            {
                                "target_lang_word": "острые ощущения",
                                "target_lang_sense_clarification": "сильные, захватывающие эмоции"
                            },
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "приятное событие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Abwechslung",
                                "target_lang_sense_clarification": "etwas, das den Alltag interessanter macht"
                            },
                            {
                                "target_lang_word": "Nervenkitzel",
                                "target_lang_sense_clarification": "das Gefühl von Spannung und Abenteuer"
                            },
                            {
                                "target_lang_word": "Highlight",
                                "target_lang_sense_clarification": "ein besonders spannendes oder erfreuliches Ereignis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺激",
                                "target_lang_sense_clarification": "令人感到兴奋或新鲜的事物"
                            },
                            {
                                "target_lang_word": "乐趣",
                                "target_lang_sense_clarification": "使人感到快乐的活动或事物"
                            }
                        ]
                    }
                }
            ]
        }
