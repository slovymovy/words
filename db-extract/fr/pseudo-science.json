                        "source_sense_id": "309fa5b1-b526-3d45-91dc-6555bd3510ac",
                        "target_lang_word": "псевдонаука",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "псевдонаука",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d92f41-2e5f-353b-808a-70084e18db67",
                                        "entry_id": "c17a2981-5169-3646-92bd-583133ed1887",
                                        "glosses": [
                                            "то, что не является наукой, но выдаётся за неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a25286-391b-4be1-b794-1a402eb73f45",
                                                "sense_id": "c9d92f41-2e5f-353b-808a-70084e18db67",
                                                "text": "Наука допускает самые фантастические предположения, но безжалостно отбрасывает их, если опыт им противоречит. Псевдонаука сохраняет их ценой новых допущений, для оправдания которых придумывается следующий этаж гипотез, и так далее. Наука строго ограничивает себя ― стремится не вводить сущностей сверх необходимого, псевдонаука для своего оправдания использует длинные «сосульки» поддерживающих друг друга гипотез."
                                            },
                                            {
                                                "example_id": "755d24f4-6ab2-4506-8828-ca5e7d3f48e0",
                                                "sense_id": "c9d92f41-2e5f-353b-808a-70084e18db67",
                                                "text": "Впрочем, в это время американские ученые уже принялись разоблачать евгенику как псевдонауку."
                                            },
                                            {
                                                "example_id": "684ca75d-bfdc-45fc-bf73-0f73d4bb16e7",
                                                "sense_id": "c9d92f41-2e5f-353b-808a-70084e18db67",
                                                "text": "Когда-то наш великий физик Ландау острил на заседании Академии Наук ещё в советское время, что науки бывают естественные, не естественные и противоестественные, но он имел в виду разные виды псевдонауки, которые в это время процветали."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
