                    {
                        "sense_id": "ae450fdb-ccc4-3e6f-a01f-a6cc053a2a75",
                        "entry_id": "05c8449d-8c6b-3f9b-8281-12d1608b68d9",
                        "glosses": [
                            "Adaptation d’un récit sous forme écrite."
                        ],
                        "tags": [],
