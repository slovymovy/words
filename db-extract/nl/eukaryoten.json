                "entry_id": "708f7d94-ef7d-3100-85fa-06c1e357e756",
                "word": "eukaryoten",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5aabd872-89a7-3712-aedc-5e7aef34aba6",
                        "entry_id": "708f7d94-ef7d-3100-85fa-06c1e357e756",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord eukaryoot"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5fe2b2a6-69b5-42de-b26b-27fc95673222",
                                "sense_id": "5aabd872-89a7-3712-aedc-5e7aef34aba6",
                                "text": "In de periode van 1 tot 2 miljard jaar geleden bestonden er eencellige eukaryoten, maar er zijn weinig fossielen van."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5f35c29-e588-3228-9230-8905bfb60d80",
                        "entry_id": "708f7d94-ef7d-3100-85fa-06c1e357e756",
                        "glosses": [
                            "een van de drie taxonomische domeinen, Eukaryota"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming"
                        ],
                        "examples": [
                            {
                                "example_id": "51c44bed-3ab4-47b0-b2c5-301c0f2e268b",
                                "sense_id": "c5f35c29-e588-3228-9230-8905bfb60d80",
                                "text": "De meeste meercellige organismen behoren tot de eukaryoten."
                            },
                            {
                                "example_id": "38c1d00d-9113-4d8a-89c4-2fa84076657f",
                                "sense_id": "c5f35c29-e588-3228-9230-8905bfb60d80",
                                "text": "Woese concludeerde na genetisch onderzoek dat bacteriën en archaea twee verschillende domeinen van leven vormen, naast het derde domein, van cellen met complexe celculturen: de eukaryoten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41d3df64-cf9a-4966-b5e6-77a0752b5de0",
