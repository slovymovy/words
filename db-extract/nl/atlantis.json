                                        "glosses": [
                                            "ein von Platon beschriebenes Inselreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b11ee8e-218d-43af-8c8c-b5bf4cb1df34",
                                                "sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                                                "text": "Platon beschreibt Atlantis in zwei Werken."
                                            },
                                            {
                                                "example_id": "698c9d59-051c-44da-8fc7-2098f9c8bf9e",
                                                "sense_id": "43df2de4-3315-3a86-843b-2af1927961b7",
                                                "text": "„Nach einem gescheiterten Angriff auf Athen sei Atlantis schließlich um 9600 v. Chr. in Folge einer Naturkatastrophe innerhalb „eines einzigen Tages und einer unglückseligen Nacht“ untergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd7580d1-5e64-33b9-972e-f0ebe9307ed8",
                                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                                        "glosses": [
                                            "ein hypothetischer Brückenkontinent im Atlantischen Ozean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f119fbaf-0c1f-4075-871b-df0340c60632",
                                                "sense_id": "dd7580d1-5e64-33b9-972e-f0ebe9307ed8",
                                                "text": "Die Annahme des Brückenkontinents Atlantis zwischen Europa und Afrika auf der einen und Amerika auf der anderen Seite ist zur Erklärung der biologischen Verwandtschaft von Floren- und Faunenelementen der Alten und der Neuen Welt nach Einführung der Theorien zur Kontinentaldrift und der Plattentektonik nicht mehr notwendig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0cd4da26-5dff-33f6-818f-8be6d7f0d834",
                                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                                        "glosses": [
                                            "unerwartet und plötzlich untergegangene, reiche Stadt, Kultur oder Zivilisation"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318df2ac-a450-4478-a518-ac82de93eaeb",
                                                "sense_id": "0cd4da26-5dff-33f6-818f-8be6d7f0d834",
                                                "text": "Ubar ist das „Atlantis der Wüste“ (T. E. Lawrence)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0ffb286d-83cc-341e-b506-b97448d8e0d1",
                                        "entry_id": "6cdd724e-246d-3294-9ca2-e0ff4421ee36",
                                        "glosses": [
                                            "Stadtteil von Kapstadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454619cd-7bc6-494d-85df-bbb9a168bd64",
                                                "sense_id": "0ffb286d-83cc-341e-b506-b97448d8e0d1",
                                                "text": "„In seiner Wut wechselte Fransman Dekker vom weißen Afrikaans in den Dialekt und den Rhythmus des Townships Atlantis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7db8073e-f8fa-429a-9210-c63c636e09f0",
                        "source_entry_id": "bb52a08c-e220-3a76-bc10-b7ada82623d1",
