                                        "entry_id": "628a86ff-c087-3802-abcf-836aa303e43b",
                                        "glosses": [
                                            "A fictional Japanese monster (kaiju) from a series of science-fiction films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b1c58d4-b084-4a4a-94d2-5d589db13f1e",
                                                "sense_id": "8090b7ea-21a4-3b8e-b33c-169a9d89f571",
                                                "text": "What other television show would feature a gorgeously designed sequence where a horrifically mutated Pierre and Marie Curie, their bodies swollen to Godzilla-like proportions from prolonged exposure to the radiation that would eventually kill them, destroy an Asian city with their bare hands like vengeance-crazed monster-Gods?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Godzilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5593b9fc-1ade-31f9-8d8c-ff62bea651e9",
                                        "entry_id": "c353cb3e-bc23-3ada-afe1-035027741fd9",
                                        "glosses": [
                                            "Anything that is an extremely large or dramatic example of its type."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8b95ce-a1d5-4a8c-b5d5-6dc8bae6d752",
                                                "sense_id": "5593b9fc-1ade-31f9-8d8c-ff62bea651e9",
                                                "text": "a Godzilla of a tower building"
                                            },
                                            {
                                                "example_id": "ec1416f9-ebd1-4e78-8efc-3b828295f0e5",
                                                "sense_id": "5593b9fc-1ade-31f9-8d8c-ff62bea651e9",
                                                "text": "Aren't we supposed to be a big, terrifying country, a Godzilla of capitalism wrecking the globe?"
                                            }
                                        ]
