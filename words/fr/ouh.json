                    "frequency": "Middle",
                    "semantic_group_id": "désapprobation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants criaient « <w>ouh</w> la menteuse ! » dans la cour de récréation hier matin."
                        },
                        {
                            "text": "La foule a crié « <w>ouh</w> ! » pour huer l'arbitre après cette mauvaise décision."
                        }
                    ],
                    "synonyms": [
                        "bouh",
                        "hou"
                    ],
