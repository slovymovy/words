        "fr-extract.jsonl": [
            {
                "entry_id": "e31a7595-acbd-37bf-be91-785e755b9bf7",
                "word": "amarre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3bb5fa1a-068d-4cc1-94be-b0fec737f013",
                        "entry_id": "e31a7595-acbd-37bf-be91-785e755b9bf7",
