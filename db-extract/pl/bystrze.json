                    },
                    {
                        "translation_id": "37bfbc92-6382-4375-a519-5b1cf95425e0",
                        "source_entry_id": "06beb04a-8e33-325e-ba90-fd042c86c1bd",
                        "source_sense_id": "51b8fbd4-9a7d-3078-9abe-6ce2469c83fa",
                        "target_lang_word": "Stromschnelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stromschnelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f2d627e-a4dc-34b8-8276-7aea88bafa3a",
                                        "entry_id": "1d75b22a-6b7d-36fd-af0b-3e3386cf6559",
                                        "glosses": [
                                            "Stelle in einem größeren Gewässer mit besonders hoher Fließgeschwindigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910a1b9c-3d26-420e-a1c3-a67010687a80",
                                                "sense_id": "1f2d627e-a4dc-34b8-8276-7aea88bafa3a",
                                                "text": "„Sie gelangten jetzt an Stromschnellen, die so mit Felsen durchsetzt und reißend waren, daß sie unüberwindbar schienen.“"
                                            },
                                            {
                                                "example_id": "630a04de-a3a4-4b7f-8dfd-cdd88ece8dc7",
                                                "sense_id": "1f2d627e-a4dc-34b8-8276-7aea88bafa3a",
                                                "text": "„Fest steht nur: Rafn kommt an dieser Stromschnelle um.“"
                                            },
                                            {
                                                "example_id": "9dfe41f8-86f6-429d-a4dd-cd7f7f156893",
                                                "sense_id": "1f2d627e-a4dc-34b8-8276-7aea88bafa3a",
                                                "text": "„Ich ließ die Fenster herunter und schaute auf die Stromschnellen links neben mir.“"
                                            },
                                            {
                                                "example_id": "fa494091-a942-4503-b824-0f68e48d6ad4",
                                                "sense_id": "1f2d627e-a4dc-34b8-8276-7aea88bafa3a",
                                                "text": "„Am Ende der Stromschnellen erwartete uns eine neue Wachmannschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
