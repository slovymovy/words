                "translations": [
                    {
                        "translation_id": "f885502e-34a0-4253-a772-5fe6ffb0e51d",
                        "source_entry_id": "aa00ac0f-bc82-3129-a23a-a0ed21112cfd",
                        "source_sense_id": "d60a8bfd-be48-3045-8894-dc3c5bd3c0f7",
