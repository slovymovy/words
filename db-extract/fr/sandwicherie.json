                        "sense_id": "99df5045-1466-3312-90ab-d98a5b7fe39b",
                        "entry_id": "1ee0bbbc-0a0e-3c00-afe5-f8facd10af5a",
                        "glosses": [
                            "Établissement spécialisé dans la vente de sandwichs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637559cb-3723-4572-a23d-6bb54a5c5534",
                                "sense_id": "99df5045-1466-3312-90ab-d98a5b7fe39b",
                                "text": "C’est vraiment minable, imaginez le Flore réduit à quatre tables, le reste du lieu étant aménagé en sandwicherie grecque."
                            },
                            {
                                "example_id": "267f0aa7-7c20-4f6a-adfd-3667d236f485",
                                "sense_id": "99df5045-1466-3312-90ab-d98a5b7fe39b",
                                "text": "« Elles devaient faire du quartier une sorte de Défense madrilène » , raconte César Lopez, qui, il y a deux ans, a ouvert une sandwicherie bio au pied des édifices."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d54ff5f-dc2b-3ae5-9ee8-91b7245b139a",
                        "entry_id": "1ee0bbbc-0a0e-3c00-afe5-f8facd10af5a",
                        "glosses": [
                            "Secteur économique lié à la production de sandwichs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb214adb-5244-4268-b591-6f973a9a1217",
                                "sense_id": "7d54ff5f-dc2b-3ae5-9ee8-91b7245b139a",
                                "text": "Détenteur de plus de 500 restaurants en concession dans les aéroports et les monuments, le groupe revendique, par ailleurs, la première place dans la sandwicherie, avec les enseignes Pomme de pain, Aubépain et Station Sandwich."
                            }
                        ]
