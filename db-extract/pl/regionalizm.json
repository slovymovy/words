                    {
                        "translation_id": "f7eddd65-0686-496e-a763-129d9644f789",
                        "source_entry_id": "5ba29302-dbbb-3193-9abc-24eea9fc6f75",
                        "source_sense_id": "b965843f-a4fb-30e6-92df-fffb267cf7e3",
