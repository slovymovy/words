                        "glosses": [
                            "A hybrid cross of a yak (Bos grunniens) and an American bison (Bison bison)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876d708a-fe6c-4824-8386-f5ab613f5760",
                                "sense_id": "1d96671e-c9af-3fee-a391-55f5cda5f122",
                                "text": "“Yakalos” breed true to type, are sturdy and able to forage for themselves, he said."
                            },
                            {
                                "example_id": "089951cc-173e-40f4-9d23-644a22f72c1a",
                                "sense_id": "1d96671e-c9af-3fee-a391-55f5cda5f122",
                                "text": "The meat of yakalos is said to be almost identical with beef aside from being finer-grained."
                            },
                            {
                                "example_id": "7c6e76e7-0f68-4553-a4b9-7c8adf078473",
                                "sense_id": "1d96671e-c9af-3fee-a391-55f5cda5f122",
                                "text": "Instead of beefalo, he would have yakalo."
                            }
                        ]
                    }
