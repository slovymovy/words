                "senses": [
                    {
                        "sense_id": "428f9e49-1a7d-3c15-afc9-11a6c56658cb",
                        "entry_id": "fcfd9f0f-ebf5-3766-aa7d-a6b3924c10ec",
                        "glosses": [
                            "Syndrome psychique observé chez les victimes d’accident du travail ou de la circulation, caractérisée par une inhibition de la bonne volonté et du désir de récupération. Elle traduit une sorte de psychose revendicatrice en vue d'obtenir l’indemnité la plus élevée possible."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "edf9c8b4-98d2-3d08-9270-124df324acc1",
                        "entry_id": "fcfd9f0f-ebf5-3766-aa7d-a6b3924c10ec",
                        "glosses": [
                            "État dépressif, pessimisme diffus."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7812c2ee-5fb2-4173-b60d-d69ec22c207a",
                                "sense_id": "edf9c8b4-98d2-3d08-9270-124df324acc1",
                                "text": "... on avait affaire ni aux profs ni aux flics, et on oubliait un peu la sinistrose..."
                            },
                            {
                                "example_id": "e52547ca-26db-431a-b450-035a0639bc87",
                                "sense_id": "edf9c8b4-98d2-3d08-9270-124df324acc1",
                                "text": "L’ambiance à la caserne tournait à la sinistrose."
                            },
                            {
                                "example_id": "fa2fb257-6824-48fa-8761-28111f81f137",
                                "sense_id": "edf9c8b4-98d2-3d08-9270-124df324acc1",
                                "text": "Depuis quelques décennies d’ailleurs, un courant a combattu la sinistrose hivernale en valorisant la « nordicité », vocable dû au regretté géographe Louis-Edmond Hamelin."
                            },
                            {
                                "example_id": "21e979a7-85f8-4372-8330-8ca3d6898213",
                                "sense_id": "edf9c8b4-98d2-3d08-9270-124df324acc1",
                                "text": "Il faut lutter contre la sinistrose et valoriser la positive attitude !"
                            }
                        ]
                    }
                ],
