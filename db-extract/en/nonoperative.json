                    {
                        "sense_id": "83ff652c-8358-3e6f-8a51-4fc7ddbc8668",
                        "entry_id": "797325c6-cbb2-3120-8bbf-c304cd36806c",
                        "glosses": [
                            "Not operative, not operational; inoperative."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8eec79de-97f5-4b5e-b7a7-329238b48a7d",
                                "sense_id": "83ff652c-8358-3e6f-8a51-4fc7ddbc8668",
                                "text": "... occurring on or after the ninety-first day after adjournment of the 1951 Regular Session of the Legislature, at which time they shall become nonoperative unless extended by further act of the Legislature …"
                            },
                            {
                                "example_id": "a509259f-129a-4088-bf03-93e360079e2f",
                                "sense_id": "83ff652c-8358-3e6f-8a51-4fc7ddbc8668",
                                "text": "The guide arms can rock forward into an operative position of their own or back into a nonoperative position. In the operative position a guide arm will contact lugs, but if either lugs or guide arms are nonoperative no contact will take place."
                            },
                            {
                                "example_id": "70264329-e782-4f66-b5ec-5d9f0016b574",
                                "sense_id": "83ff652c-8358-3e6f-8a51-4fc7ddbc8668",
                                "text": "Near-synonyms: nonfunctional, nonfunctioning"
                            },
                            {
                                "example_id": "61927430-05a1-454c-9562-3aeb531e2354",
                                "sense_id": "83ff652c-8358-3e6f-8a51-4fc7ddbc8668",
                                "text": "The historical cost of the property which was estimated to become nonoperative was set forth by the Commission's engineers, in Application No. 4440, as $36,278."
                            }
                        ]
                    }
