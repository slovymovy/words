                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5969b637-2f9b-4f82-ae97-ebb3017502eb",
                                                "sense_id": "9ebbf419-9d2c-32c2-9b59-c14461ec7aa9",
                                                "text": "Мы сидели у него в гостиной, попивали пивцо из холодильника, закусывали сыром."
                                            }
                                        ]
