                {
                    "sense_id": "2299c35c-212f-31a3-96d5-c0fb7d4993c7",
                    "sense_definition": "Acte juridique ou démarche par laquelle une personne ou un couple prend pour enfant une personne qui ne l'est pas biologiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "filiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'attente, leur dossier d'<w>adoption</w> a enfin été accepté par les autorités."
                        },
                        {
                            "text": "Le jeune homme a découvert sur le tard qu'il était lié à cette famille par <w>adoption</w>."
                        }
                    ],
                    "common_phrases": [
                        "demande d'adoption",
                        "dossier d'adoption",
                        "adoption plénière",
                        "adoption simple"
