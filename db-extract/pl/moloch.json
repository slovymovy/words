                "senses": [
                    {
                        "sense_id": "bb0625dc-99c9-3732-b4ac-fb0299821c1f",
                        "entry_id": "dd26db2c-95ae-3b23-8b75-a8f6ac53a223",
                        "glosses": [
                            "istota demoniczna, potężny podmiot albo przemożne, nienasycone zjawisko, wyrządzające ogrom zła i pochłaniające wiele ofiar"
                        ],
                        "tags": [
                            "Biblical",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "c8fb794a-223d-471a-ba11-3a7846aa9b4d",
                                "sense_id": "bb0625dc-99c9-3732-b4ac-fb0299821c1f",
                                "text": "W miarę jak rosły ceny, podnosiła się wysokość łapówek, zwykli ludzie skarżyli się, że coraz większą część zarobków muszą przeznaczać na karmienie molocha korupcji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3f0baf9d-06ba-3182-bd7d-6d9cce16ca3a",
                        "entry_id": "dd26db2c-95ae-3b23-8b75-a8f6ac53a223",
                        "glosses": [
                            "duża, przerośnięta, niesprawna i nieprzyjazna ludziom instytucja"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "50ff6724-eb18-4a10-94de-452afc4a909a",
                                "sense_id": "3f0baf9d-06ba-3182-bd7d-6d9cce16ca3a",
                                "text": "Reformatorzy naszej gospodarki polikwidowali już w kraju produkcyjne molochy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5f06fc44-f1dd-3797-b17d-b383dcd40160",
                        "entry_id": "dd26db2c-95ae-3b23-8b75-a8f6ac53a223",
                        "glosses": [
                            "Moloch horridus – gatunek niewielkiej pustynnej jaszczurki australijskiej o ciele pokrytym kolcami"
                        ],
