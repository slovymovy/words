                },
                {
                    "sense_id": "20c8a9c8-a4e9-3967-ac0b-301eabc47516",
                    "sense_definition": "The female genitalia; vagina.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He uttered a vulgar joke referring crudely to a woman's <w>kipper</w>.",
                            "target_lang_translations": {
                                "ru": "Он отпустил пошлую шутку, грубо упомянув женскую <w>пизду</w>."
                            }
