                    "sense_definition": "in kracht of intensiteit afnemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzwakking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naarmate de storm voorbijtrok, begon de harde wind eindelijk te <w>verslappen</w>.",
                            "target_lang_translations": {
