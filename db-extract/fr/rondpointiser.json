                ],
                "senses": [
                    {
                        "sense_id": "b8202942-3d8d-381e-b7d5-3f72e9d20ca7",
                        "entry_id": "5381e220-05b4-3ebb-ae05-1300716814ca",
                        "glosses": [
                            "Doter de ronds-points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd39fc4d-a6c2-4706-9f37-2a55912d35fa",
                                "sense_id": "b8202942-3d8d-381e-b7d5-3f72e9d20ca7",
                                "text": "Il a fallu d’abord goudronner, puis sans cesse améliorer, élargir, puis ensuite « rondpointiser » ces voies de communication."
                            },
                            {
                                "example_id": "f6915c21-9ca5-4433-9d12-1a9b924b05fa",
                                "sense_id": "b8202942-3d8d-381e-b7d5-3f72e9d20ca7",
                                "text": "On “rondpointise” gaiement"
                            },
                            {
                                "example_id": "8ad999f3-45a4-49f2-bf9f-5c14c7b2a28c",
                                "sense_id": "b8202942-3d8d-381e-b7d5-3f72e9d20ca7",
                                "text": "Rouler dans un véhicule insonorisé, équipé, électronisé, connecté, sur des goudrons lisses, carrefourisés, rondpointisés, signalisés, camératisés, radarisés... ça étonne!"
                            },
                            {
                                "example_id": "e58aadd3-94b0-42d0-9d75-cadd16f7ce6f",
                                "sense_id": "b8202942-3d8d-381e-b7d5-3f72e9d20ca7",
                                "text": "Les campagnes ne sont pas du tout désertifiées, elle sont poubellisées, artificialisées, ravagées, retournées, banleugalisées, rondpointisées, abandonnées par les services publics, éoliennisées, aménagées, productivisées, zonardisées, disneylandisées, déspiritualisées."
                            }
                        ]
                    },
                    {
                        "sense_id": "39e7b17b-e56e-36e4-8de8-77f3a2529bb4",
                        "entry_id": "5381e220-05b4-3ebb-ae05-1300716814ca",
                        "glosses": [
                            "Transformer en rond-point."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aef1d084-222d-3365-bc42-731f9e3317e4",
                        "entry_id": "5381e220-05b4-3ebb-ae05-1300716814ca",
                        "glosses": [
                            "Occuper des ronds-points dans un but revendicatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfc443b-fca6-41b7-8380-aec7e59cdb6a",
                                "sense_id": "aef1d084-222d-3365-bc42-731f9e3317e4",
                                "text": "Giletjauner, c'est marcher, chanter, rondpointiser, et aussi débattre pour, in fine, décider collectivement."
                            }
                        ]
                    }
                ],
