                    {
                        "sense_id": "4aa7f437-5919-3754-b10b-b45bef3b8745",
                        "entry_id": "1c2db288-45ba-3d52-b29d-a25aaeb2ed3b",
                        "glosses": [
                            "полный неожиданных перемен, случайностей; непостоянный, неустойчивый"
