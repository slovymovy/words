                "senses": [
                    {
                        "sense_id": "bdd46033-56ca-36b1-9f63-c7af3d4ec9f5",
                        "entry_id": "62ee9cbe-62fa-3a88-a7fa-566fcd0cd8e4",
                        "glosses": [
                            "Herrschaft/Regime der Nationalsozialisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910af109-40f9-46e9-a81f-c41aa4fac781",
                                "sense_id": "bdd46033-56ca-36b1-9f63-c7af3d4ec9f5",
                                "text": "„Die Zeugen Jehovas standen dem NS-Regime von Anfang an ablehnend gegenüber.“"
                            },
                            {
                                "example_id": "600e3196-c828-4770-9e8b-1c54c95a56a4",
                                "sense_id": "bdd46033-56ca-36b1-9f63-c7af3d4ec9f5",
                                "text": "„Doch mit dem Sieg der Alliierten über das NS-Regime zeigt sich, dass die Weißen ihre Kolonien keinesfalls freiwillig aufgeben wollen.“"
                            },
                            {
                                "example_id": "69f5eb08-b040-4929-af1c-11d1c924e721",
                                "sense_id": "bdd46033-56ca-36b1-9f63-c7af3d4ec9f5",
                                "text": "„Martha, von Beruf Journalistin, organisiert das gsellschaftliche Leben der Botschaft und lernt dabei viele ausländische Diplomaten, aber auch viele Vertreter des NS-Regimes kennen.“"
                            },
                            {
                                "example_id": "dce3b3c6-ac98-4539-8bbe-00837ef0525c",
                                "sense_id": "bdd46033-56ca-36b1-9f63-c7af3d4ec9f5",
                                "text": "„Sie streuen gezielt Zweifel an den Taten des NS-Regimes, um Deutschland wieder zu der von ihnen erhofften nationalen Größe zu führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
