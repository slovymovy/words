                        "glosses": [
                            "Relatif aux Omeyyades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d0e8cbc-00d0-4499-bf8e-d644409d0042",
                                "sense_id": "dd5d5c69-42de-307e-9468-4335120190af",
                                "text": "Avant que le califat omeyyade de Damas n'eût cédé la place aux Abbassides de Bagdad, en 750, les conquêtes arabes avaient unifié politiquement une grande partie du monde, de l'Espagne à l'Inde."
                            },
                            {
                                "example_id": "1e0488a6-b2ac-4544-bd40-83f823ea51d8",
                                "sense_id": "dd5d5c69-42de-307e-9468-4335120190af",
                                "text": "Gilles Léothaud rapporte qu’un calife omeyyade du VIIIᵉ siècle, déchira ses vêtements d’exaltation sous l’effet de la musique d’un grand chanteur de son temps."
                            }
                        ]
                    }
