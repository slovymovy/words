                        "examples": [
                            {
                                "example_id": "775fee63-d17e-4861-81fd-9afe2a960820",
                                "sense_id": "fa7f07dd-073d-3cad-889c-f6adba98d4ab",
                                "text": "„Sie verfügten über einen zuverlässigen Kontaktmann, der ihm in den Stammesgebieten helfen sollte, und einen brillanten Ex-CIA-Agenten, der von Peshawar aus dafür sorgte, dass er heil aus dem Gebiet rauskam, sobald der Job erledigt war.“"
                            },
                            {
                                "example_id": "799381fd-0059-4c80-a465-69082cdb31e2",
                                "sense_id": "fa7f07dd-073d-3cad-889c-f6adba98d4ab",
                                "text": "„Oliver North ist besser bekannt als Colonel Oliver North, ehemaliger Militärberater des Nationalen Sicherheitsrates und Ex-CIA-Agent.“"
                            },
                            {
                                "example_id": "4b5c8b67-3b66-43e9-b002-db4e59999e05",
                                "sense_id": "fa7f07dd-073d-3cad-889c-f6adba98d4ab",
                                "text": "„Der junge Robin gerät in die Fänge einer Behörde, die ihn zur Killermaschine umfunktionieren will, doch sein Papa, der Ex-CIA-Agent Peter Johanson, will ihn retten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
