    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                "word": "blusterous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fa4e95d1-f9cf-4802-a35c-500be87cd64b",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more blusterous"
                    },
                    {
                        "form_id": "6c4b842b-5a04-4207-8424-b0ba0c5a859d",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most blusterous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07d60929-1d57-3315-b6b8-34b4589ee19b",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "glosses": [
                            "Tending to bluster.",
                            "Blowing in loud and abrupt bursts."
                        ],
                        "tags": [
                            "of wind"
                        ],
                        "examples": [
                            {
                                "example_id": "15e126a5-d790-4573-9da6-b9c71626837b",
                                "sense_id": "07d60929-1d57-3315-b6b8-34b4589ee19b",
                                "text": "[…] wee see a strong and sturdie Oke to stande stiffe and immo∣uable against the blustrous blastes of fierce windes […]"
                            },
                            {
                                "example_id": "f94d460f-9558-476f-a765-b9ffd9b53b12",
                                "sense_id": "07d60929-1d57-3315-b6b8-34b4589ee19b",
                                "text": "These Sunday-morning hair-cuttings were performed by Fairway; the victim sitting on a chopping-block in front of the house […]. Summer and winter the scene was the same, unless the wind were more than usually blusterous, when the stool was shifted a few feet round the corner."
                            },
                            {
                                "example_id": "d8f867e0-2e5e-4b33-bedf-20ede7ac9aa8",
                                "sense_id": "07d60929-1d57-3315-b6b8-34b4589ee19b",
                                "text": "They had had an afternoon of blusterous tramontana, continually changing direction and force, and exploding the light snowfalls with mischievous gusts."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dae3a90-ba65-3972-a966-c2ca4f5fe2f3",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "glosses": [
                            "Tending to bluster.",
                            "Accompanied by strong wind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e9f46d-919a-4053-af50-d3193463ceb7",
                                "sense_id": "4dae3a90-ba65-3972-a966-c2ca4f5fe2f3",
                                "text": "[I]t seemed entirely right and fitting that the wind sang and sobbed in the poplar tops, and in the lulls of it, sudden spirts of rain spattered the already dusty roads, on that blusterous March day when Edward and I awaited, on the station platform, the arrival of the new tutor."
                            },
                            {
                                "example_id": "5452cd9b-2b95-40c7-badc-c7cd701c6930",
                                "sense_id": "4dae3a90-ba65-3972-a966-c2ca4f5fe2f3",
                                "text": "For lo! the wind was blusterous / And flattened out his favourite tree; / And things looked bad for him and we— […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0288c28-226f-3bb1-a6cf-893a611debf5",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "glosses": [
                            "Tending to bluster.",
                            "Pompous or arrogant, especially in one's speech; given to outbursts."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "0cfb52db-4cef-4976-9e5b-8bd9f065e1a2",
                                "sense_id": "a0288c28-226f-3bb1-a6cf-893a611debf5",
                                "text": "The antient Heroes were illustrious / For being benigne, and not blustrous, / Against a vanquisht foe: […]"
                            },
                            {
                                "example_id": "bb8fdb4d-2772-494f-bfca-f1c252ee81c1",
                                "sense_id": "a0288c28-226f-3bb1-a6cf-893a611debf5",
                                "text": "The blustrous Bounderby crimsoned and swelled to such an extent on hearing these words, that he seemed to be, and probably was, on the brink of a fit."
                            },
                            {
                                "example_id": "32a92328-d1de-49e0-b90c-3ebf85d4b8b9",
                                "sense_id": "a0288c28-226f-3bb1-a6cf-893a611debf5",
                                "text": "Thomas Batchgrew’s blusterous voice frankly showed acute irritation."
                            }
                        ]
                    },
                    {
                        "sense_id": "4375235c-a856-3fbf-9de1-9bead4eb1794",
                        "entry_id": "b091d246-2fa7-33d2-a6d5-513e053d2263",
                        "glosses": [
                            "Tending to bluster.",
                            "Characterized by strong or violent emotion; not calm, stable or orderly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478ec561-2f91-41b6-9966-243956fe7bec",
                                "sense_id": "4375235c-a856-3fbf-9de1-9bead4eb1794",
                                "text": "Now, mild may be thy life! / For a more blustrous birth had never babe: / Quiet and gentle thy conditions! for / Thou art the rudeliest welcome to this world / That ever was prince's child. Happy what follows!"
                            },
                            {
                                "example_id": "fcedf653-895e-4d85-b97e-3823fab185b1",
                                "sense_id": "4375235c-a856-3fbf-9de1-9bead4eb1794",
                                "text": "1906, Evelyn Beatrice Hall (as S. G. Tallentyre), The Friends of Voltaire, London: John Murray, Chapter 4, p. 98,\nVictor had already plunged into that blusterous, incontinent life which was to bring ruin to his own family […]"
                            }
                        ]
                    }
                ],
