                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "127ba983-8b80-4eed-897b-54e036afbbbe",
                                "sense_id": "3c240be0-5c92-3945-9a48-86f3dcda110c",
                                "text": "Zet zij, na dijenkletsers met de geur die het midden houdt tussen spruitjes en Hollandse gezelligheid, een uilenbrilletje op om de strenge schooljuf uit te hangen met lastige vraagjes, kijken er wéér miljoenen mensen."
                            },
                            {
                                "example_id": "1c002ed9-5da6-4503-aa9e-347723214e59",
                                "sense_id": "3c240be0-5c92-3945-9a48-86f3dcda110c",
                                "text": "Let op mijn woorden, over tien jaar is zwarte Piet vintage. Dan treffen we hem in een pop-up store op een moeilijke fiets met een uilenbril op zijn gelaat. Drinkt 'ie er een ‘cold- brew’ kopje koffie bij."
                            }
                        ]
                    }
