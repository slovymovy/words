                        "glosses": [
                            "A latticework used to shape or train the branches of a tree or shrub into a two-dimensional ornamental or useful design, as along a wall or fence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b7e2ca-fb6c-4768-9df8-34b93a57092c",
                                "sense_id": "413a2b6c-a00d-362a-912c-5ee2d31171a2",
                                "text": "The garment stalls carried the traditional blue vine-dressers' outfits, sunhats, and the great willow pitchforks grown in espalier at villages like Sauve."
                            }
                        ]
                    },
                    {
                        "sense_id": "e138d05b-3860-3a92-a6d0-952b391e29eb",
                        "entry_id": "48b3f3c9-42e4-3936-9db8-a9821eae90bc",
                        "glosses": [
                            "A plant that has been shaped in this manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
