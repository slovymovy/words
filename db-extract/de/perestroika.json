                                "target_senses": [
                                    {
                                        "sense_id": "8ca6cfe4-9cae-3dcb-986e-581f5f7166aa",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "A program of political and economic reform carried out in the Soviet Union in the 1980s and early 1990s under the leadership of Mikhail Gorbachev."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8b784f-89ce-4d6a-a8ad-8e89237594be",
                                                "sense_id": "8ca6cfe4-9cae-3dcb-986e-581f5f7166aa",
                                                "text": "Gorbachev would introduce glasnost (openness and freedom) and perestroika (economic restructuring) to Russia under his tenure, ultimately freeing thousands of political prisoners and dissidents and trying to address the shortages in food and goods that had become the hallmarks of the failing Soviet economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd0c80a-3ea5-3a84-ac70-63b663b4a4b9",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "The period of time in the Soviet Union during which these reforms were carried out and in effect."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acdf5798-d5b6-3f81-8867-fe63e87af340",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "A situation where a small variation of parameters leads to a sudden change in properties."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ca05bfc-21f0-4da5-913d-e9b5cd94cb54",
                        "source_entry_id": "f12dbfab-f55e-31fd-aa7a-fe169a9d995b",
