                                    {
                                        "sense_id": "d7a11ae0-3f76-383b-9f8a-397f88f830af",
                                        "entry_id": "f287f29f-0cb4-3caf-8406-d7d695910ae7",
                                        "glosses": [
                                            "Genre de grands arbres à feuilles caduques, simples, doublement dentées, et aux fruits en samares."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10196be-8bf1-4108-8a0b-e70a827d3be1",
                                                "sense_id": "d7a11ae0-3f76-383b-9f8a-397f88f830af",
                                                "text": "Les ormes servent ordinairement à border des routes, des avenues."
                                            },
                                            {
                                                "example_id": "0c52996c-93c2-4064-8f00-6860329de5bf",
                                                "sense_id": "d7a11ae0-3f76-383b-9f8a-397f88f830af",
                                                "text": "On arrive à cet imposant et noble édifice par une immense allée de quatre rangs d’ormes séculaires, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
