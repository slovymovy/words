                "senses": [
                    {
                        "sense_id": "d911e028-5e8e-34ce-ad6d-657de9054914",
                        "entry_id": "67a4a6c1-2b41-3410-9bb8-bb03c2595d01",
                        "glosses": [
                            "Enlever la butte de terre au pied d'une plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07b8309-8372-4c0e-b433-c2d4937b19c8",
                                "sense_id": "d911e028-5e8e-34ce-ad6d-657de9054914",
                                "text": "Les traitements sont faits avec le pulvérisateur, dès que les asperges montent en branche; pour faciliter l'aspersion des tiges, on doit les débutter;"
                            },
                            {
                                "example_id": "2e90061c-72c0-4efd-ac58-f324b8e18b8f",
                                "sense_id": "d911e028-5e8e-34ce-ad6d-657de9054914",
                                "text": "On a soin de débutter les plantes atteintes, ainsi que les voisines, et on les désinfecte en versant le liquide avec un arrosoir à pomme très fine;"
                            },
                            {
                                "example_id": "6ef6e2fd-7b1f-4c26-b698-4579d2a89a97",
                                "sense_id": "d911e028-5e8e-34ce-ad6d-657de9054914",
                                "text": "Le soir, débutter les artichauts."
                            }
                        ]
                    }
