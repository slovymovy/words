                ],
                "senses": [
                    {
                        "sense_id": "3ed97de4-1aca-37fa-9ac1-ce8d7741ae2e",
                        "entry_id": "3fc8a901-a432-378f-bf21-0a5df2aa505a",
                        "glosses": [
                            "Se mettre en colère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf7d1d7-8dd6-47ea-80b8-e0256a617657",
                                "sense_id": "3ed97de4-1aca-37fa-9ac1-ce8d7741ae2e",
                                "text": "Il est dans le caractère français de s’enthousiasmer, de se colérer, de se passionner pour le météore du moment, pour les bâtons flottants de l’actualité."
                            },
                            {
                                "example_id": "d29d6991-4baf-44f1-875b-793db824f3bd",
                                "sense_id": "3ed97de4-1aca-37fa-9ac1-ce8d7741ae2e",
                                "text": "Mais une tracasserie ne suffisait pas, elle cherchait un sujet de reproche, et elle se colérait intérieurement de n’en pas trouver."
                            },
                            {
                                "example_id": "e5ac95da-51af-454b-9151-83e50121370f",
                                "sense_id": "3ed97de4-1aca-37fa-9ac1-ce8d7741ae2e",
                                "text": "Certaines qui ne croient qu’en la science et ses vertus cartésiennes colèrent contre ces gris-gris, un wagon de morphine ferait mieux l’affaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b65924f-6839-484c-ae87-fe51fff5b186",
                        "source_entry_id": "3fc8a901-a432-378f-bf21-0a5df2aa505a",
                        "source_sense_id": "3ed97de4-1aca-37fa-9ac1-ce8d7741ae2e",
                        "target_lang_word": "ärgern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ärgern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63a53c2a-aba0-3720-a639-bed9b99a8c0e",
                                        "entry_id": "065e8a5a-93bc-38c9-8fdb-e4b9fbb1cb79",
                                        "glosses": [
                                            "(jemanden) necken, Ärger verursachen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21064c1e-62f2-467e-ae62-6e28ce18d85f",
                                                "sense_id": "63a53c2a-aba0-3720-a639-bed9b99a8c0e",
                                                "text": "Ich ärgerte ihn ein bisschen."
                                            },
                                            {
                                                "example_id": "caf93571-b8ec-4bfa-8434-fcd1f84a5b8f",
                                                "sense_id": "63a53c2a-aba0-3720-a639-bed9b99a8c0e",
                                                "text": "Sein Vater ärgerte ihn so sehr, dass der sofort in den Wald spazieren ging und erst nach drei Stunden wieder zurückkam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed14f303-089a-3cee-9ce9-e440dc2da53a",
                                        "entry_id": "065e8a5a-93bc-38c9-8fdb-e4b9fbb1cb79",
                                        "glosses": [
                                            "sich ärgern: durch etwas gestört sein"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b9f629f-17c6-48d5-8092-10f8ce9cf597",
                                                "sense_id": "ed14f303-089a-3cee-9ce9-e440dc2da53a",
                                                "text": "Ich ärgerte mich über sein Verhalten."
                                            },
                                            {
                                                "example_id": "31b74b04-f6e5-4096-83f2-e8c33d2cbd63",
                                                "sense_id": "ed14f303-089a-3cee-9ce9-e440dc2da53a",
                                                "text": "Wir ärgerten uns über den Regen und wurden nass."
                                            },
                                            {
                                                "example_id": "3387f9e1-dad4-4e68-9376-381623fbae5a",
                                                "sense_id": "ed14f303-089a-3cee-9ce9-e440dc2da53a",
                                                "text": "„‚Ärgert Euch nicht — warum sollt Ihr Euch ärgern über Sachen, die Euch nicht angehören. Ich ärgere mich, wenn ich mich ungeschickt benehme; benimmt sich aber nur ein anderer schlecht, dann freue ich mich. Also ärgert Euch nicht, wenn ich sage, daß es der Zweck meines Lebens ist, von den Leuten angeschaut zu werden.‘“"
                                            },
                                            {
                                                "example_id": "25691f0e-5a33-4036-8a22-aab8adec45bd",
                                                "sense_id": "ed14f303-089a-3cee-9ce9-e440dc2da53a",
                                                "text": "„Man kann vieles über einen Menschen lernen, wenn man weiß, was ihn am meisten ärgert. Proust, zum Beispiel, ärgerte sich maßlos über die Ausdrucksweise mancher Leute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
