                "senses": [
                    {
                        "sense_id": "bb88e1db-46c9-36bf-acd9-2b0881b75fb3",
                        "entry_id": "698b87b3-f0a2-3886-9ad4-ea5f7bbbbfb9",
                        "glosses": [
                            "Celui qui redit, répète les mêmes choses, radoteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f8e0f7e-0624-4bad-bb1e-89a0487fa5e2",
                                "sense_id": "bb88e1db-46c9-36bf-acd9-2b0881b75fb3",
                                "text": "Vous m'avertissez quelquefois de ne dire certaines choses qu'aux échos ; vraiment je me garderai bien de leur confier la moindre chose : nous en avons un dans cette place, Coulanges, qui est comme celui de la Trousse, et qui est petit rediseur mot à mot jusque dans l’oreille."
                            },
                            {
                                "example_id": "90b2358c-fc3f-4b90-b196-87859d32d491",
                                "sense_id": "bb88e1db-46c9-36bf-acd9-2b0881b75fb3",
                                "text": "Bientôt mille jaseurs\nAdoptent son avis comme loi souveraine,\nEt ce torrent de rediseurs\nGrossit si fort qu’il nous entraîne."
                            }
                        ]
                    },
                    {
                        "sense_id": "052468cf-e98b-3592-8a5d-e5e4c83cd6c4",
                        "entry_id": "698b87b3-f0a2-3886-9ad4-ea5f7bbbbfb9",
                        "glosses": [
                            "Celui qui répète par indiscrétion ou par malignité, jaseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "830663be-4e34-463b-85cf-4c19c417d96d",
                                "sense_id": "052468cf-e98b-3592-8a5d-e5e4c83cd6c4",
                                "text": "Rediseurs, espions, gens à l’air gracieux."
                            },
                            {
                                "example_id": "60d3ea0e-2410-4248-85d1-b34948073056",
                                "sense_id": "052468cf-e98b-3592-8a5d-e5e4c83cd6c4",
                                "text": "Si vous prenez le parti de vous éclaircir avec l’archevêque [d’Aix]… vous viderez bien des affaires en peu de temps, ou vous ferez taire les rediseurs."
                            }
                        ]
                    }
                ],
