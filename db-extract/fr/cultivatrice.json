                "senses": [
                    {
                        "sense_id": "5ef134f7-402c-300c-89c8-fbe1fed3511b",
                        "entry_id": "942ce5b4-ffdb-34b1-b057-4ba0ebd4f808",
                        "glosses": [
                            "Celle qui cultive."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "be3d9fb0-94c0-424f-b292-f1af74d99c9f",
                                "sense_id": "5ef134f7-402c-300c-89c8-fbe1fed3511b",
                                "text": "Elle alla trouver la cultivatrice, dont la mère tenait une petite épicerie depuis qu’elle lui avait laissé l’exploitation, à la mort de son mari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76f4f35c-7ca3-42e7-b1dd-7749657fbb73",
                        "source_entry_id": "942ce5b4-ffdb-34b1-b057-4ba0ebd4f808",
                        "source_sense_id": "5ef134f7-402c-300c-89c8-fbe1fed3511b",
                        "target_lang_word": "grower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c80d3d48-cebb-36b0-b5a3-6a1b27c2ef6a",
                                        "entry_id": "284f42d1-6cb9-3889-af98-05904284dcdb",
                                        "glosses": [
                                            "A farmer; one who grows things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3caf6d8e-dc45-44d1-87f8-e93f7e428e53",
                                                "sense_id": "c80d3d48-cebb-36b0-b5a3-6a1b27c2ef6a",
                                                "text": "He was an orange grower from Florida."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f9cc58-d869-3f8c-950b-fad53f818f75",
                                        "entry_id": "284f42d1-6cb9-3889-af98-05904284dcdb",
                                        "glosses": [
                                            "Something that grows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398a0517-442b-498a-abd9-d16711177a32",
                                                "sense_id": "07f9cc58-d869-3f8c-950b-fad53f818f75",
                                                "text": "These flowers are fast growers"
                                            },
                                            {
                                                "example_id": "712da35c-fa8b-4d79-bcd8-c0a6f7d9d166",
                                                "sense_id": "07f9cc58-d869-3f8c-950b-fad53f818f75",
                                                "text": "'The Bride' [a snowdrop variety], found in the early Seventies at Foxcote Farm near Cheltenham, was his first discovery. It's a poculiform (cup-shaped) G. elwesii with six pure white petals of the same length. Like many poculiforms […] it's not a strong grower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2fd4b4a-7163-3d50-9c39-0ab52cab700a",
                                        "entry_id": "284f42d1-6cb9-3889-af98-05904284dcdb",
                                        "glosses": [
                                            "Someone or something, especially music, that becomes more likeable over time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fcb7e3-fc34-49f8-8bd3-6c9ee1fa3f48",
                                                "sense_id": "a2fd4b4a-7163-3d50-9c39-0ab52cab700a",
                                                "text": "I didn't like the song at first, but it is a real grower."
                                            },
                                            {
                                                "example_id": "288a10fb-c552-4079-a042-93f8788e58ed",
                                                "sense_id": "a2fd4b4a-7163-3d50-9c39-0ab52cab700a",
                                                "text": "Sanctury^([sic]) - the least obvious single but what a grower. When I first heard this track I thought it was rather average. After playing the album several times, this was the one that kept coming into my head throughout the day."
                                            },
                                            {
                                                "example_id": "f557bf8c-b450-4951-b1ae-280d5e5865b5",
                                                "sense_id": "a2fd4b4a-7163-3d50-9c39-0ab52cab700a",
                                                "text": "[…]assimilating some vaguely psych, folk-rock, and other influences into their own twang without losing sense of style and taste: a grower, not a shower (that's show-er, not shower)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37450bce-1b6f-3f98-af46-dd8ef67ade68",
                                        "entry_id": "284f42d1-6cb9-3889-af98-05904284dcdb",
                                        "glosses": [
                                            "A man whose penis increases in size significantly when erect."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17aa6093-c097-4880-ba41-80dc10be4242",
                                                "sense_id": "37450bce-1b6f-3f98-af46-dd8ef67ade68",
                                                "text": "As a man who can best be described as a \"grower not a shower\", I helped Brent realize that many people in the gay community are concerned in a very adolescent way with their dick size, including me."
                                            },
                                            {
                                                "example_id": "de594f44-24b5-4289-9aaf-d1cc74a2ecab",
                                                "sense_id": "37450bce-1b6f-3f98-af46-dd8ef67ade68",
                                                "text": "\"Growers\" are guys whose penises tend to contract a lot lengthwise when flaccid, while \"show-ers\" are guys whose penises could be said to merely \"deflate\" without contracting much in length."
                                            },
                                            {
                                                "example_id": "8875aa62-cc93-4778-b9d9-d476f52e327e",
                                                "sense_id": "37450bce-1b6f-3f98-af46-dd8ef67ade68",
                                                "text": "His dick, if I remember correctly, is more of a shower than a grower[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
