                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue est un homme <w>méthodique</w> qui organise soigneusement toutes ses tâches quotidiennes."
                        },
                        {
                            "text": "Il possède un esprit <w>méthodique</w> capable de résoudre les problèmes les plus ardus."
                        }
                    ],
                    "synonyms": [
