            "senses": [
                {
                    "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                    "sense_definition": "Person oder Institution, die für die Veröffentlichung eines Buches, Sammelbandes oder wissenschaftlichen Werkes verantwortlich ist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "publikation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Herausgeber</w> hat für dieses Sammelwerk Beiträge von verschiedenen Fachleuten zusammengestellt."
                        },
                        {
                            "text": "Auf der ersten Seite des Buches wird der Name des <w>Herausgebers</w> deutlich genannt."
                        }
                    ],
                    "synonyms": [
                        "Editor",
                        "Verleger"
                    ],
                    "antonyms": [
                        "Autor",
                        "Urheber",
                        "Buchhändler",
                        "Hersteller"
                    ],
                    "common_phrases": [
                        "als Herausgeber fungieren",
                        "Herausgeber des Sammelbandes"
                    ]
                },
                {
                    "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                    "sense_definition": "Person, die die journalistische und inhaltliche Ausrichtung einer Zeitung oder Zeitschrift festlegt und leitet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "publikation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Herausgeber</w> der bekannten Tageszeitung äußerte sich in einem Leitartikel zur aktuellen Krise."
                        },
                        {
                            "text": "Im Impressum des Magazins sind der <w>Herausgeber</w> und die gesamte Redaktion aufgeführt."
                        }
                    ],
                    "antonyms": [
                        "Medienmitarbeiter",
                        "Medieninhaber",
                        "Kolporteur"
                    ],
                    "common_phrases": [
                        "Herausgeber einer Tageszeitung",
                        "Herausgeber des Magazins"
                    ]
                },
                {
                    "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                    "sense_definition": "Institution oder Person, die Wertpapiere wie Anleihen auf den Kapitalmarkt ausgibt",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Herausgeber</w> der Anleihe sichert den Anlegern eine feste Verzinsung zu."
                        },
                        {
                            "text": "Bei einer Zahlungsunfähigkeit kann der <w>Herausgeber</w> das investierte Kapital nicht zurückzahlen."
                        }
                    ],
                    "synonyms": [
                        "Emittent",
                        "Ausgeber"
                    ],
                    "antonyms": [
                        "Anleiheninhaber",
                        "Anleihennehmer",
                        "Sparer",
                        "Finanzberater"
                    ],
                    "common_phrases": [
                        "Herausgeber einer Anleihe",
                        "Verpflichtung des Herausgebers"
                    ]
                }
            ]
        }
