{
    "word_family": [
        "bereavement",
        "bereft"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d0c58f6-0160-3cb0-900d-f1bc16dd1029",
                    "sense_definition": "To deprive someone of a close relation or friend, especially through death.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden illness was going to <w>bereave</w> the family of their beloved father. \n",
                            "target_lang_translations": {
                                "de": "Die plötzliche Krankheit sollte die Familie ihres geliebten Vaters <w>berauben</w>."
                            }
                        },
                        {
                            "text": "A tragic accident came to <w>bereave</w> the close-knit community of its young leader.",
                            "target_lang_translations": {
                                "de": "Ein tragischer Unfall <w>entriss</w> der engen Gemeinschaft ihren jungen Anführer."
                            }
                        }
                    ],
                    "synonyms": [
                        "deprive"
                    ],
                    "common_phrases": [
                        "bereave of a loved one",
                        "bereave of hope"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem einen nahestehenden Angehörigen oder Freund rauben, besonders durch den Tod."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "berauben",
                                "target_lang_sense_clarification": "jemandem einen Angehörigen nehmen"
                            },
                            {
                                "target_lang_word": "entreißen",
                                "target_lang_sense_clarification": "durch den Tod gewaltsam nehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd25f290-5a19-3d18-be07-8d2e773d9359",
                    "sense_definition": "To forcibly deprive or strip someone of a possession, quality, or hope.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel war threatened to <w>bereave</w> the citizens of all their basic human rights.",
                            "target_lang_translations": {
                                "de": "Der grausame Krieg drohte die Bürger all ihrer grundlegenden Menschenrechte zu <w>berauben</w>."
                            }
                        },
                        {
                            "text": "Misfortune seemed to <w>bereave</w> him of his remaining reason.",
                            "target_lang_translations": {
                                "de": "Das Unglück schien ihn seines verbliebenen Verstandes zu <w>berauben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strip",
                        "rob",
                        "deprive"
                    ],
                    "common_phrases": [
                        "bereave of words",
                        "bereave of life"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem gewaltsam Besitz, Eigenschaften oder Hoffnung nehmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "berauben",
                                "target_lang_sense_clarification": "von Rechten, Hoffnung oder Verstand"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}