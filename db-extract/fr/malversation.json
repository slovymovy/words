                ],
                "senses": [
                    {
                        "sense_id": "55078fc0-59d5-32ff-8b1a-0d7b1ea6673f",
                        "entry_id": "50dd67f2-3a87-3855-9167-ca1379485504",
                        "glosses": [
                            "Faute grave commise par cupidité, dans l’exercice d’une charge, d’un emploi, dans l’exécution d’un mandat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff66de03-ccbb-466f-ba67-0e8c76e6b9a7",
                                "sense_id": "55078fc0-59d5-32ff-8b1a-0d7b1ea6673f",
                                "text": "Mais malgré les malversations des fonctionnaires et l’absence de tout contrôle, les finances publiques étaient prospères."
                            },
                            {
                                "example_id": "cfcfd16d-f99e-41e5-ae38-8c7115189380",
                                "sense_id": "55078fc0-59d5-32ff-8b1a-0d7b1ea6673f",
                                "text": "«Je n’ai pas manqué de jugement parce que dans toutes les situations où M. Laperrière a été impliqué, quatre situations, il n’y a eu aucune malversation, a-t-il dit."
                            },
                            {
                                "example_id": "d5641d5f-e8cf-4cf0-b41b-46308622a8d0",
                                "sense_id": "55078fc0-59d5-32ff-8b1a-0d7b1ea6673f",
                                "text": "Nombreux sont les Américains qui veulent que Trump ait à répondre de ses malversations devant la justice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e690de64-b071-4a6c-a464-072f950ac749",
                        "source_entry_id": "50dd67f2-3a87-3855-9167-ca1379485504",
                        "source_sense_id": "55078fc0-59d5-32ff-8b1a-0d7b1ea6673f",
                        "source_sense_description": "Faute grave commise par cupidité",
                        "target_lang_word": "Veruntreuung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veruntreuung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                        "entry_id": "a54ab8de-7c69-328e-8b8b-88f93e7765e2",
                                        "glosses": [
                                            "rechtswidrige Aneignung fremden Eigentums, das sich bereits im eigenen Besitz befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d9174c-9d16-45ac-8168-52adcc888390",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Die Veruntreuung wurde im Rahmen der seit Herbst verstärkten Kontrollen festgestellt.“"
                                            },
                                            {
                                                "example_id": "5aebfca2-89aa-44e0-9af1-253bb88d0496",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Eigenmächtige und vertragswidrige Ausdehnung der Mietdauer allein begründet nicht Veruntreuung eines Mietwagens.“"
                                            },
                                            {
                                                "example_id": "43eac837-bda0-426e-baf7-f2f1e5f58ed0",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Der Verdacht lautet auf Betrug, ungetreue Geschäftsbesorgung, Geldwäscherei und Veruntreuung.“"
                                            },
                                            {
                                                "example_id": "b6d7d8b5-5085-4cd6-a2bf-5f6312ca6413",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„So lese ich gerade, dass Middelhoff zu drei Jahren Haft wegen Veruntreuung verurteilt worden ist, wegen umgerechnet 750.000 Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff4332d-07ce-4e32-9279-d98e3890087d",
                        "source_entry_id": "50dd67f2-3a87-3855-9167-ca1379485504",
