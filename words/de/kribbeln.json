            "senses": [
                {
                    "sense_id": "3d37cafb-3e8f-3c32-b3dc-f7c4448c78dd",
                    "sense_definition": "ein leichtes, stechendes oder kitzelndes Gefühl auf der Haut oder an einem Körperteil verursachen oder verspüren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koerpergefuehl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein eingeschlafener Fuß fängt langsam wieder an zu <w>kribbeln</w>."
                        },
                        {
                            "text": "Plötzlich spürte er, wie es in seiner Nase heftig zu <w>kribbeln</w> begann."
                        }
                    ],
                    "synonyms": [
                        "kitzeln",
                        "prickeln"
                    ],
                    "common_phrases": [
                        "in der Nase kribbeln"
                    ]
                },
                {
                    "sense_id": "e7de4f8d-efdb-391b-8692-94b991f18271",
                    "sense_definition": "eine freudige Aufregung, nervöse Spannung oder Ungeduld innerlich spüren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem großen Auftritt <w>kribbelte</w> es bei der Schauspielerin im ganzen Bauch vor Aufregung."
                        },
                        {
                            "text": "Es <w>kribbelte</w> ihm schon die ganze Zeit in den Fingern, seine Meinung dazu zu sagen."
                        }
                    ],
                    "synonyms": [
                        "prickeln"
                    ],
                    "common_phrases": [
                        "im Bauch kribbeln",
                        "in den Fingern kribbeln"
                    ]
                },
                {
                    "sense_id": "0808df24-69de-3789-8b80-08cd00bbb74f",
                    "sense_definition": "sich als kleine Lebewesen durcheinander und kreuz und quer bewegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Regenschauer <w>kribbelten</w> unzählige kleine Ameisen über den Steinweg."
                        },
                        {
                            "text": "Auf dem feuchten Waldboden <w>kribbeln</w> viele winzige Käfer durch das Moos."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "landschaftlich für krabbeln oder wimmeln"
                        }
                    ],
                    "synonyms": [
