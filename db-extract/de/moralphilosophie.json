                                    {
                                        "sense_id": "2516bcb9-9004-3ebb-aede-aaf080e265ee",
                                        "entry_id": "c8483869-99d1-37cb-b250-e20e9ea624fd",
                                        "glosses": [
                                            "Ethics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd71cfd3-9e1e-46b8-9752-ad55f3bca847",
                                                "sense_id": "2516bcb9-9004-3ebb-aede-aaf080e265ee",
                                                "text": "The maxims of common life were arranged in some methodical order, and connected together by a few common principles, in the same manner as they had attempted to arrange and connect the phenomena of nature. The science which pretends to investigate and explain those connecting principles, is what is properly called moral philosophy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
