                        "entry_id": "0354d98e-b764-3ee0-bb12-5886cde6a0db",
                        "glosses": [
                            "Zustand, in dem man vollkommen in eine Tätigkeit versunken ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
