{
    "word_family": [
        "verwijt",
        "verwijtend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11d64933-a8ec-3071-a589-14955de7a68c",
                    "sense_definition": "iemand verantwoordelijk stellen voor een fout of een tekortkoming",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beschuldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>verwijt</w> je me dat terwijl ik er helemaal niets aan kon doen?",
                            "target_lang_translations": {
                                "en": "Why do you <w>blame</w> me for that when I couldn't do anything about it at all?",
                                "fr": "Pourquoi me <w>reproches</w>-tu cela alors que je n'y pouvais absolument rien ?"
                            }
                        },
                        {
                            "text": "Ik <w>verwijt</w> de regering dat ze nog steeds niets onderneemt tegen de woningnood.",
                            "target_lang_translations": {
                                "en": "I <w>reproach</w> the government for still not taking action against the housing shortage.",
                                "fr": "Je <w>reproche</w> au gouvernement de ne toujours rien faire contre la crise du logement."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwalijk nemen"
                    ],
                    "antonyms": [
                        "prijzen",
                        "waarderen"
                    ],
                    "common_phrases": [
                        "iemand iets verwijten",
                        "zichzelf iets verwijten"
                    ],
                    "target_lang_definitions": {
                        "en": "to hold someone responsible for a mistake or shortcoming",
                        "fr": "tenir quelqu'un pour responsable d'une faute ou d'un manque"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "to hold responsible for something bad"
                            },
                            {
                                "target_lang_word": "reproach",
                                "target_lang_sense_clarification": "to express disapproval or disappointment"
                            },
                            {
                                "target_lang_word": "accuse",
                                "target_lang_sense_clarification": "to claim someone has done something wrong"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "reprocher",
                                "target_lang_sense_clarification": "blâmer quelqu'un pour une faute ou un acte"
                            },
                            {
                                "target_lang_word": "imputer",
                                "target_lang_sense_clarification": "attribuer la responsabilité d'une faute"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d91e307-cdd1-39f6-8781-9b9fe6091d78",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>verwijt</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ongeluk kreeg de chauffeur veel harde <w>verwijten</w> van de omstanders.",
                            "target_lang_translations": {
                                "en": "After the accident, the driver received many harsh <w>reproaches</w> from the bystanders.",
                                "fr": "Après l'accident, le conducteur a reçu de nombreux <w>reproches</w> durs de la part des passants."
                            }
                        },
                        {
                            "text": "Zij negeerde al zijn <w>verwijten</w> en liep rustig de kamer uit.",
                            "target_lang_translations": {
                                "en": "She ignored all his <w>accusations</w> and calmly walked out of the room.",
                                "fr": "Elle a ignoré tous ses <w>reproches</w> et est sortie calmement de la pièce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "valse verwijten"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'reproach' or 'accusation'",
                        "fr": "pluriel du nom « reproche » ou « accusation »"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reproaches",
                                "target_lang_sense_clarification": "expressions of disapproval or disappointment"
                            },
                            {
                                "target_lang_word": "accusations",
                                "target_lang_sense_clarification": "charges of wrongdoing"
                            },
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "responsibility for a fault or wrong"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "reproches",
                                "target_lang_sense_clarification": "paroles adressées à quelqu'un pour lui exprimer un blâme"
                            },
                            {
                                "target_lang_word": "accusations",
                                "target_lang_sense_clarification": "griefs portés contre quelqu'un"
                            }
                        ]
                    }
                }
            ]
        }
    ]
