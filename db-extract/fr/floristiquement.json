                "entry_id": "1fe43178-f14a-3a42-aae1-f63770cf61d9",
                "word": "floristiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e305db1d-2c61-3ec7-bb88-afae9ad5136f",
                        "entry_id": "1fe43178-f14a-3a42-aae1-f63770cf61d9",
                        "glosses": [
                            "En matière de flore ; d'une façon floristique."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "0d3626c6-b850-4a6a-9ce4-624756aeb9ea",
                                "sense_id": "e305db1d-2c61-3ec7-bb88-afae9ad5136f",
                                "text": "La flore se trouve ainsi formée d'une superposition de flores diverses, c'est la plus importante qui est choisie pour caractériser floristiquement le territoire considéré."
                            },
                            {
                                "example_id": "c65c38d3-4f97-4457-a7ea-bdcebce25331",
                                "sense_id": "e305db1d-2c61-3ec7-bb88-afae9ad5136f",
                                "text": "Les savanes de cet étage bien qu'ayant la même physionomie que les formations de l'étage précédent s'en distinguent floristiquement."
                            },
                            {
                                "example_id": "812f6742-66cc-4d1e-af2b-e666a9c3f06f",
                                "sense_id": "e305db1d-2c61-3ec7-bb88-afae9ad5136f",
                                "text": "Les trouées étant des moteurs sylvigénétiques, quand elles n'assurent plus le renouvellement des unités forestières, celles-ci régressent, s'effondrent, s'appauvrissent éco-systémiquement et floristiquement."
                            },
                            {
                                "example_id": "5fb78ebc-9055-45fb-8836-b45c39c9cb01",
                                "sense_id": "e305db1d-2c61-3ec7-bb88-afae9ad5136f",
                                "text": "Les espèces plus haut citées se retrouvent encore sur des aires réduites qui, sans être rocheuses, présentent une très faible couverture de terre végétale formant autant de petites unités topographiquement et floristiquement bien définies."
                            }
                        ]
                    }
                ],
