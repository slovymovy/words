                "senses": [
                    {
                        "sense_id": "a8790022-02d2-379b-88d3-68f32176741d",
                        "entry_id": "73633585-57c2-322e-9460-4554688fe1c4",
                        "glosses": [
                            "The characteristic or quality of being illegible; the quality of being difficult or impossible to read."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3218a072-caa8-4424-a223-54946a33838f",
                                "sense_id": "a8790022-02d2-379b-88d3-68f32176741d",
                                "text": "The illegibility of his handwriting made it unclear which answer he wrote."
                            },
                            {
                                "example_id": "555a2b2d-ca3d-4c10-961e-4c94ae8e1cb1",
                                "sense_id": "a8790022-02d2-379b-88d3-68f32176741d",
                                "text": "“Poor thing! poor thing!” says Briggs (who was thinking of twenty-four years back, and that hectic young writing-master whose lock of yellow hair, and whose letters, beautiful in their illegibility, she cherished in her old desk upstairs)."
                            },
                            {
                                "example_id": "14b67911-f2df-4a80-9346-27a6e285ff8e",
                                "sense_id": "a8790022-02d2-379b-88d3-68f32176741d",
                                "text": "I passed the time by adding to the illegibilities in my diary."
                            },
                            {
                                "example_id": "14ba5be2-864d-431d-be8b-a37484a59002",
                                "sense_id": "a8790022-02d2-379b-88d3-68f32176741d",
                                "text": "And on the back endpaper of the Collins Clear-Type Shakespeare, a work of fatiguing illegibility, he wrote the names in large letters, as though his succession had already been settled."
                            }
                        ]
                    }
                ],
