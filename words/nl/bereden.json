                            {
                                "target_lang_word": "geritten",
                                "target_lang_sense_clarification": "Partizip Perfekt von reiten"
                            },
                            {
                                "target_lang_word": "zugeritten",
                                "target_lang_sense_clarification": "ein Pferd ausgebildet/eingeritten"
                            },
                            {
                                "target_lang_word": "befahren",
                                "target_lang_sense_clarification": "auf Wegen/Straßen (auch bereist)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cc74972-3c6e-3bb3-a413-ef52bdf9c277",
                    "sense_definition": "verleden tijd meervoud van <w>berijden</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "berijden_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De agenten <w>bereden</w> hun paarden tijdens de feestelijke intocht in de stad.",
                            "target_lang_translations": {
                                "de": "Die Polizisten <w>ritten</w> ihre Pferde während des feierlichen Einzugs in die Stadt."
                            }
                        },
                        {
                            "text": "Vroeger <w>bereden</w> zij dagelijks de paden langs de grens om die te controleren.",
                            "target_lang_translations": {
