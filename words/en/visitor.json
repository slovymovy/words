{
    "word_family": [
        "visit",
        "visitation",
        "visitorial",
        "revisit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5b85df7-18e7-3126-ad4a-432c742492d4",
                    "sense_definition": "Someone who pays a visit to a specific place or event; a sightseer or tourist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_visiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum attracts a <w>visitor</w> from every corner of the globe each year.",
                            "target_lang_translations": {
                                "ru": "Ежегодно музей привлекает <w>посетителей</w> со всех уголков земного шара."
                            }
                        },
                        {
                            "text": "A <w>frequent</w> <w>visitor</w> to the gallery will notice that the exhibits change every month.",
                            "target_lang_translations": {
                                "ru": "Частый <w>посетитель</w> галереи заметит, что экспонаты меняются каждый месяц."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frequent visitor",
                        "welcome visitor",
                        "foreign visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто посещает определенное место или мероприятие; экскурсант или турист."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посетитель",
                                "target_lang_sense_clarification": "человек, посещающий место или мероприятие"
                            },
                            {
                                "target_lang_word": "турист",
                                "target_lang_sense_clarification": "человек, путешествующий для осмотра достопримечательностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b784b340-8e3b-33d8-b094-25bdbbc5bb34",
                    "sense_definition": "Someone who visits someone else; someone staying as a guest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_visiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are expecting a <w>visitor</w> for dinner tonight, so please tidy up the living room.",
                            "target_lang_translations": {
                                "ru": "Сегодня к ужину мы ждем <w>гостя</w>, поэтому, пожалуйста, приберись в гостиной."
                            }
                        },
                        {
                            "text": "The <w>unexpected</w> <w>visitor</w> arrived at the front door just as we were sitting down to eat.",
                            "target_lang_translations": {
                                "ru": "Нежданный <w>гость</w> появился у двери как раз в тот момент, когда мы садились есть."
                            }
                        }
                    ],
                    "synonyms": [
                        "visitant"
                    ],
                    "antonyms": [
                        "host"
                    ],
                    "common_phrases": [
                        "unexpected visitor",
                        "house visitor",
                        "regular visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто наносит визит другому человеку; гость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гость",
                                "target_lang_sense_clarification": "человек, пришедший навестить кого-либо"
                            },
                            {
                                "target_lang_word": "визитёр",
                                "target_lang_sense_clarification": "лицо, совершающее визит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4e55a95-aa24-301a-8e9f-049f7e079c7b",
                    "sense_definition": "Someone, or a team, that is playing away from home.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>visitor</w> scored a goal in the final minutes to win the match.",
                            "target_lang_translations": {
                                "ru": "<w>Гости</w> забили гол на последних минутах и выиграли матч."
                            }
                        },
                        {
                            "text": "The home team struggled to defend their lead against the determined <w>visitor</w>.",
                            "target_lang_translations": {
                                "ru": "Хозяевам поля было трудно удержать преимущество перед лицом решительно настроенных <w>гостей</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "host"
                    ],
                    "common_phrases": [
                        "the visitors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или команда, играющая на выезде (не на своем поле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гости",
                                "target_lang_sense_clarification": "команда, играющая на чужом поле"
                            },
                            {
                                "target_lang_word": "приезжая команда",
                                "target_lang_sense_clarification": "соперник, выступающий в гостях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3121924c-a58c-3e45-8d20-26fa068d20c0",
                    "sense_definition": "An extraterrestrial being on Earth.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "extraterrestrial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie tells the story of a <w>visitor</w> from another planet who wants to learn about humans.",
                            "target_lang_translations": {
                                "ru": "Фильм рассказывает историю <w>пришельца</w> с другой планеты, который хочет узнать о людях."
                            }
                        },
                        {
                            "text": "Scientists are searching for any sign of an <w>extraterrestrial</w> <w>visitor</w> in our solar system.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут любые признаки внеземного <w>гостя</w> в нашей солнечной системе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extraterrestrial visitor",
                        "alien visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внеземное существо, прибывшее на Землю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пришелец",
                                "target_lang_sense_clarification": "инопланетное существо"
                            },
                            {
                                "target_lang_word": "гость",
                                "target_lang_sense_clarification": "в контексте инопланетного визита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78572705-8dc3-3513-9353-f253edf86137",
                    "sense_definition": "An object which lands or passes by Earth or its orbit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comet is a <w>celestial</w> <w>visitor</w> that only appears in our sky once every century.",
                            "target_lang_translations": {
                                "ru": "Комета — это небесный <w>гость</w>, который появляется в нашем небе лишь раз в столетие."
                            }
                        },
                        {
                            "text": "Astronomers tracked the <w>visitor</w> as it passed safely between the Earth and the Moon.",
                            "target_lang_translations": {
                                "ru": "Астрономы отслеживали этот <w>объект</w>, когда он благополучно пролетал между Землей и Луной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "celestial visitor",
                        "interstellar visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, который приземляется на Землю или проходит мимо нее по орбите."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небесное тело",
                                "target_lang_sense_clarification": "комета или астероид, пролетающий мимо"
                            },
                            {
                                "target_lang_word": "гость",
                                "target_lang_sense_clarification": "метафорически о комете или астероиде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7418cea-d6bc-335f-88f4-b31d67afd49e",
                    "sense_definition": "A person authorized to visit an institution to see that it is being managed properly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "official_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>official</w> <w>visitor</w> conducted a thorough inspection of the prison facilities last week.",
                            "target_lang_translations": {
                                "ru": "Официальный <w>инспектор</w> провел тщательную проверку тюремных помещений на прошлой неделе."
                            }
                        },
                        {
                            "text": "As an appointed <w>visitor</w>, her role is to ensure the charity follows all legal regulations.",
                            "target_lang_translations": {
                                "ru": "В качестве назначенного <w>контролёра</w> её роль заключается в обеспечении соблюдения благотворительной организацией всех правовых норм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "official visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, уполномоченное посещать учреждение для проверки правильности его управления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инспектор",
                                "target_lang_sense_clarification": "проверяющее лицо"
                            },
                            {
                                "target_lang_word": "ревизор",
                                "target_lang_sense_clarification": "лицо, осуществляющее надзор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a90285e-e872-366c-85cb-0b44db87074f",
                    "sense_definition": "A head or overseer of an institution such as a college or cathedral who resolves disputes and gives ceremonial speeches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Bishop serves as the <w>visitor</w> of the cathedral, overseeing its spiritual and administrative health.",
                            "target_lang_translations": {
                                "ru": "Епископ выступает в качестве <w>визитатора</w> собора, надзирая за его духовным и административным состоянием."
                            }
                        },
                        {
                            "text": "In his capacity as <w>visitor</w>, he was called upon to mediate the dispute between the college fellows.",
                            "target_lang_translations": {
                                "ru": "В качестве <w>попечителя</w> его призвали выступить посредником в споре между членами совета колледжа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководитель или попечитель учреждения (например, колледжа), разрешающий споры и выступающий с речами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визитатор",
                                "target_lang_sense_clarification": "официальный инспектор или попечитель"
                            },
                            {
                                "target_lang_word": "попечитель",
                                "target_lang_sense_clarification": "лицо, осуществляющее надзор за учреждением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a6fcc9-4de4-354f-85f1-e665edef737f",
                    "sense_definition": "The object in the visitor pattern that performs an operation on the elements of a structure one by one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>visitor</w> pattern allows you to define a new operation without changing the classes of the elements.",
                            "target_lang_translations": {
                                "ru": "Паттерн <w>посетитель</w> позволяет определять новую операцию без изменения классов элементов."
                            }
                        },
                        {
                            "text": "Each element in the list accepts the <w>visitor</w> and allows it to perform its specific task.",
                            "target_lang_translations": {
                                "ru": "Каждый элемент в списке принимает <w>посетителя</w> и позволяет ему выполнить свою специфическую задачу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "visitor pattern"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект в шаблоне проектирования «Посетитель», выполняющий операцию над элементами структуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посетитель",
                                "target_lang_sense_clarification": "название паттерна программирования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}