                                        "sense_id": "4ad76cbe-2150-3bfc-84b9-2a75af559901",
                                        "entry_id": "6106b11a-ddea-34a2-9aa5-75977b84cb80",
                                        "glosses": [
                                            "aus einem Gefäß schütten (gießen) und dann entweder weggießen oder etwas anderes befüllen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c248fd-c4c8-439d-b731-d9a70ae6883c",
                                                "sense_id": "4ad76cbe-2150-3bfc-84b9-2a75af559901",
                                                "text": "„Falls der Pilz für den Verzehr zubereitet wird, sollte das Kochwasser vor dem Essen abgegossen werden.“"
                                            },
                                            {
                                                "example_id": "6166ced1-f42f-4ad4-b6f2-81895679580d",
                                                "sense_id": "4ad76cbe-2150-3bfc-84b9-2a75af559901",
                                                "text": "„Wenn der flüssige Stahl die gewünschte Qualität hat, wird er in Metallformen abgegossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "426dea3a-f045-4223-a3f9-3290f97d7503",
                        "source_entry_id": "4a81b27e-70cf-39ba-8a3c-14fdfa16c4e7",
