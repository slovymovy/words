            {
                "entry_id": "b8100814-f688-3c70-b200-2ed49ed52017",
                "word": "Dasher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c0a7986e-a3d1-4c25-8d01-6d1fb46cfef4",
                        "entry_id": "b8100814-f688-3c70-b200-2ed49ed52017",
                        "tags": [
                            "plural"
                        ],
                        "form": "Dashers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55afb093-f3a2-3b62-85f5-72e558146e84",
                        "entry_id": "b8100814-f688-3c70-b200-2ed49ed52017",
                        "glosses": [
                            "An employee of DoorDash, a San Francisco–based company that operates an online food ordering and food delivery platform."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f461c3bf-78d5-41a1-bb1c-b0dea3a9bb3c",
                                "sense_id": "55afb093-f3a2-3b62-85f5-72e558146e84",
                                "text": "DoorDash carries a commercial auto insurance policy that covers up to $1 million in bodily injury and/or property damage of its Dashers, who are considered third parties. Any accident that occurs while on an active delivery (in possession of goods to be delivered) qualifies the Dasher for coverage."
                            },
                            {
                                "example_id": "b9698aef-953d-4e92-a696-710e0ca9e04c",
                                "sense_id": "55afb093-f3a2-3b62-85f5-72e558146e84",
                                "text": "In January 2021, for example, grocery chains Vons, Pavilions, and Albertsons came to an agreement with DoorDash to fire their delivery staff—which had previously worked full-time with benefits—and replace them with an army of subcontracted “Dashers.”"
                            },
                            {
                                "example_id": "12f1c0e5-e7d5-410d-9a2f-cc89ec07534f",
                                "sense_id": "55afb093-f3a2-3b62-85f5-72e558146e84",
                                "text": "Formulate a linear programming model to minimize the sum of the times of assignments made such that no Dasher is assigned to more than one order and each order must be assigned to exactly one Dasher."
                            },
                            {
                                "example_id": "422dfd1b-87ee-472e-9ea7-ae7bc3bfad28",
                                "sense_id": "55afb093-f3a2-3b62-85f5-72e558146e84",
                                "text": "In it, the company found 18% of Dashers said they have “a disability or other chronic condition”—which, DoorDash said, is four times greater than the mainstream workforce."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
