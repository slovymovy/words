                        "tags": [
                            "plural"
                        ],
                        "form": "commémorations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1334eae-dbf0-3524-90d8-dd4be3300c37",
                        "entry_id": "bdbe3ed3-67a2-38d8-9e95-4440cfa0ecfa",
                        "glosses": [
                            "Cérémonie du souvenir établie par l’église."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "6608ee87-f7be-46c1-bfe6-757ff3036b2a",
                                "sense_id": "c1334eae-dbf0-3524-90d8-dd4be3300c37",
                                "text": "La commémoration des morts, La fête que l’église célèbre le jour des morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d0ed67c-821f-3e65-bab7-13020b3e2145",
                        "entry_id": "bdbe3ed3-67a2-38d8-9e95-4440cfa0ecfa",
                        "glosses": [
                            "Mention que le prêtre fait des trépassés, à l’endroit du canon de la messe appelé Mémento des morts."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "376389be-c890-3caa-854f-4e21e33d8fef",
                        "entry_id": "bdbe3ed3-67a2-38d8-9e95-4440cfa0ecfa",
                        "glosses": [
                            "Célébration d'anniversaire d'un événement particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a60eeaf4-36b1-4add-b30c-1dee331876c8",
                                "sense_id": "376389be-c890-3caa-854f-4e21e33d8fef",
                                "text": "En commémoration de, en témoignage du souvenir qu’on a gardé d’une personne ou d’un fait."
                            },
                            {
                                "example_id": "77af2d04-cbbc-4248-ab64-7d081e3137ba",
                                "sense_id": "376389be-c890-3caa-854f-4e21e33d8fef",
                                "text": "Verdun est conforté dans son statut de lieu phare et de lieu de culte où se confrontent histoire et légende, commémorations et shows, recueillement et folklore, avec les risques de dérive mémorielle que cela comporte."
                            },
                            {
                                "example_id": "64b60b2e-a1fa-419f-9bde-357c8a0ed39a",
                                "sense_id": "376389be-c890-3caa-854f-4e21e33d8fef",
                                "text": "La création d'un sentier de mémoire … et le rappel des commémorations organisées chaque dernier dimanche d'août à la suite des batailles qui se sont déroulées du 25 août au 11 septembre 1914 figurent parmi les projets labellisés par la Mission du Centenaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb90f5b3-4298-4de1-a18c-189b91591149",
                        "source_entry_id": "bdbe3ed3-67a2-38d8-9e95-4440cfa0ecfa",
                        "target_lang_word": "Andenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "ein kleiner Gegenstand, der Erinnerungen an ein bestimmtes Ereignis oder eine bestimmte Person hervorrufen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff907e83-48f5-4214-86b8-1e259a116dcb",
                                                "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                                "text": "Wenn du nach Japan fährst, bringe viele Andenken mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "bewusstes Erinnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62535b8c-c084-4114-87c1-b038136387de",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "Im Andenken an die Verstorbenen treffen wir uns einmal im Jahr."
                                            },
                                            {
                                                "example_id": "2d620c2e-2bf2-4c96-8d5f-a8916d1ed196",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "„In der Abteilung »Neuzeit« ist von der Ansbacher Polizei ein Zimmer dem Andenken des armen Findlings Kaspar Hauser geweiht; man sieht seine Uhr, seine Kleider und Wäsche mit den Stichmarken des Mordinstrumentes und die ganze Literatur über diesen geheimnisvollen Unbekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
