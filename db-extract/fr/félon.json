            {
                "entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                "word": "félon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c479a894-9988-4310-86fa-6c9fc3708c1b",
                        "entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                        "tags": [
