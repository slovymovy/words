                "senses": [
                    {
                        "sense_id": "4c42e925-f7b6-3ab2-b20b-9e1471e5a4fa",
                        "entry_id": "be6fa98e-8df3-308f-b6bc-a99d8de6274b",
                        "glosses": [
                            "Qui vit en eau douce, dans des lacs ou des rivières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff81e7b-0311-4c90-92e9-a42fa78d89fd",
                                "sense_id": "4c42e925-f7b6-3ab2-b20b-9e1471e5a4fa",
                                "text": "Les milieux mixtes, constitués par les réservoirs de peu de profondeur dans lequel le renouvellement de l’eau est constant, montrent un mélange de Diatomées potamophiles, de Chlorophycées et de Protococcoidées limnophiles."
                            },
                            {
                                "example_id": "b83e3537-d08e-46af-94bd-c48c63fb3c4c",
                                "sense_id": "4c42e925-f7b6-3ab2-b20b-9e1471e5a4fa",
                                "text": "Entre 1919 et 1942, cette espèce plutôt potamophile a été trouvée au stade imago uniquement de long du Rhône et de l’Arve (collections du Muséum d’Histoire naturelle de Genève)."
                            },
                            {
                                "example_id": "2d8ba8f0-4335-4ffd-a4bb-f9ad29f18374",
                                "sense_id": "4c42e925-f7b6-3ab2-b20b-9e1471e5a4fa",
                                "text": "Les anthracothères, gros mammifères potamophiles, sont inconnus en Afrique orientale à ce moment là."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "407796c3-d5ee-4ca6-94be-f733ca1dee0e",
