                "senses": [
                    {
                        "sense_id": "7b991cbe-79ee-3a5c-940e-34582fc13812",
                        "entry_id": "a8a1e8a8-78df-3336-926d-52d76e5c58a1",
                        "glosses": [
                            "Gebäude, das zu einer Fabrik gehört/in dem sich eine Fabrik befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2259d40a-eee4-4a44-a030-53bcb81e0e72",
                                "sense_id": "7b991cbe-79ee-3a5c-940e-34582fc13812",
                                "text": "„Im Gänsemarsch kamen sie aus dem Lagerhaus heraus, marschierten am Fabrikgebäude vorbei und verschwanden im Dschungel.“"
                            },
                            {
                                "example_id": "4e49dae0-ed72-4354-9db7-2222889e8cd1",
                                "sense_id": "7b991cbe-79ee-3a5c-940e-34582fc13812",
                                "text": "„Jede Einzelheit der Bilder und Ereignisse, die Robert bei seinem ausgedehnten Gang durch die Fabrikgebäude der Stadt wahrgenommen hatte, verschmolz in seinem Innern bald zu einem unentwirrbaren Ganzen, das sich in einer quälenden Vorstellung auswirkte.“"
                            },
                            {
                                "example_id": "5a8bc262-e9b7-41cf-a673-301967a7c789",
                                "sense_id": "7b991cbe-79ee-3a5c-940e-34582fc13812",
                                "text": "„Beim Näherkommen stellte sich das vermeintliche Fabrikgebäude als die Tate Modern Art Gallery heraus, die wir jedoch ignorierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
