{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d0c9fa0-7377-373a-8870-ef97f57ce68b",
                    "sense_definition": "A long, narrow container used for feeding or watering animals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer filled the <w>trough</w> with fresh water for the thirsty horses.",
                            "target_lang_translations": {
                                "ru": "Фермер наполнил <w>корыто</w> свежей водой для изнывающих от жажды лошадей."
                            }
                        },
                        {
                            "text": "The pigs gathered around the <w>trough</w> to eat their morning meal.",
                            "target_lang_translations": {
                                "ru": "Свиньи собрались вокруг <w>корыта</w>, чтобы съесть свой утренний корм."
                            }
                        }
                    ],
                    "synonyms": [
                        "manger"
                    ],
                    "common_phrases": [
                        "feeding trough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая ёмкость для кормления или поения животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корыто",
                                "target_lang_sense_clarification": "открытая продолговатая ёмкость для корма скота"
                            },
                            {
                                "target_lang_word": "кормушка",
                                "target_lang_sense_clarification": "оборудование для подачи корма животным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c2004ac-34ac-3928-b695-7f9a3f7a9709",
                    "sense_definition": "A gutter under the eaves of a building that collects rainwater.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trough</w> was clogged with dead leaves and needed to be cleaned out.",
                            "target_lang_translations": {
                                "ru": "<w>Водосточный жёлоб</w> был забит сухими листьями, и его нужно было прочистить."
                            }
                        },
                        {
                            "text": "Water overflowed from the <w>trough</w> during the heavy rainstorm.",
                            "target_lang_translations": {
                                "ru": "Во время сильного ливня вода переливалась через край <w>жёлоба</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eaves trough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёлоб под краем крыши здания для сбора дождевой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосточный жёлоб",
                                "target_lang_sense_clarification": "приспособление для стока воды с крыши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60f8fa8a-e69f-3afd-89af-d5c510e577b1",
                    "sense_definition": "The low point between two waves or ridges.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "low_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat dipped into the <w>trough</w> between two large ocean waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка погрузилась во <w>впадину</w> между двумя большими океанскими волнами."
                            }
                        },
                        {
                            "text": "The ship rose to the crest and then fell into the <w>trough</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль поднялся на гребень, а затем упал во <w>впадину</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкая точка между двумя волнами или гребнями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "углубление между волнами"
                            },
                            {
                                "target_lang_word": "ложбина",
                                "target_lang_sense_clarification": "понижение между гребнями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41f3ec2f-c193-3fbb-a143-7e8a3e277b40",
                    "sense_definition": "A low point or minimum level in a business or economic cycle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "low_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy reached a <w>trough</w> before finally starting to recover.",
                            "target_lang_translations": {
                                "ru": "Экономика достигла <w>дна</w>, прежде чем наконец начала восстанавливаться."
                            }
                        },
                        {
                            "text": "Investors are waiting for the market to hit its <w>trough</w> before buying.",
                            "target_lang_translations": {
                                "ru": "Инвесторы ждут, когда рынок достигнет своего <w>минимума</w>, прежде чем покупать."
                            }
                        }
                    ],
                    "antonyms": [
                        "peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низшая точка или минимальный уровень в деловом или экономическом цикле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "самая низкая точка экономического спада"
                            },
                            {
                                "target_lang_word": "минимум",
                                "target_lang_sense_clarification": "низшая точка цикла"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1ff1842-745b-3ba2-96a5-b9a3ab46a660",
                    "sense_definition": "To eat in a greedy or vulgar manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>troughed</w> his dinner as if he had not eaten for days.",
                            "target_lang_translations": {
                                "ru": "Он <w>лопал</w> свой обед так, будто не ел несколько дней."
                            }
                        },
                        {
                            "text": "The guests <w>troughed</w> through the buffet table without any manners.",
                            "target_lang_translations": {
                                "ru": "Гости <w>жрали</w> за шведским столом, совершенно не соблюдая манер."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to imply gluttony."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть жадно или невоспитанно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопать",
                                "target_lang_sense_clarification": "разговорное, есть много и жадно"
                            },
                            {
                                "target_lang_word": "жрать",
                                "target_lang_sense_clarification": "грубое, есть очень жадно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}