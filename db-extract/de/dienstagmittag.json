                "senses": [
                    {
                        "sense_id": "873e892f-365f-353c-8f76-638250c43f0e",
                        "entry_id": "c90d34cf-5a25-3526-80d1-beab22dd395f",
                        "glosses": [
                            "der Mittag eines Dienstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553cebe6-e79f-4e76-9a0c-7018674c25ab",
                                "sense_id": "873e892f-365f-353c-8f76-638250c43f0e",
                                "text": "Dienstagmittag kam es zu einem schweren Unfall in der Innenstadt."
                            },
                            {
                                "example_id": "95a164f2-5b83-4825-948a-df2998df51ac",
                                "sense_id": "873e892f-365f-353c-8f76-638250c43f0e",
                                "text": "An Dienstagmittagen muss ich immer Telefondienst machen."
                            },
                            {
                                "example_id": "5fc9722f-4f5c-4a7f-8c27-0b33c1df8ea9",
                                "sense_id": "873e892f-365f-353c-8f76-638250c43f0e",
                                "text": "„Nachdem zunächst der Suchbereich laufend ausgedehnt wurde, nahmen die Trupps ab Dienstagmittag wieder den Nahbereich der Fischteiche, wo Franca zuletzt von ihrem Großvater gesehen wurde, in den Fokus, besonders die Strecke bis zum rund zwei Kilometer entfernten Wohnhaus des Kindes.“"
                            },
                            {
                                "example_id": "89a313f3-fa65-4af7-93d0-1b4b590b590d",
                                "sense_id": "873e892f-365f-353c-8f76-638250c43f0e",
                                "text": "„Am Dienstagmittag gab ich ihm einen Piaster und sagte, er solle den letzten Karnevalstag verbringen, wo er wolle; es genüge, wenn er am nächsten Mittag zurückkäme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
