                    {
                        "translation_id": "40d69b72-cc97-49f7-8eee-970d3da03fe4",
                        "source_entry_id": "d1c43021-336a-3f81-af30-ac116aeeff7a",
                        "source_sense_id": "7ac58907-f0d4-30ac-8d17-b08800afbe10",
