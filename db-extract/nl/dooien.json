                                        "entry_id": "0ec6e7b4-fb24-39cd-88a0-20ca58e16c11",
                                        "glosses": [
                                            "a period of weather warm enough to melt that which is frozen"
                                        ],
                                        "tags": [],
                                        "examples": [
