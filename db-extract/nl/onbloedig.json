                        "cross_references": [
                            {
                                "target_word": "bloodless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                                        "glosses": [
                                            "Lacking blood; ashen, anaemic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334a993b-cbe4-42b3-9c3b-d1546dc307a7",
                                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                                "text": "My bloodleſſe bodie waxeth chill and colde,\nAnd with my blood my life ſlides through my wound,\nMy ſoule begins to take her flight to hell,\nAnd ſummones all my ſences to depart: […]"
                                            },
                                            {
                                                "example_id": "8f8e0272-4018-4b37-bdbb-652d5179b2e5",
                                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                                "text": "Thou dost not slumber: see, thy two sons’ heads,\nThy warlike hand, thy mangled daughter here:\nThy other banish’d son, with this dear sight\nStruck pale and bloodless; and thy brother, I,\nEven like a stony image, cold and numb."
                                            },
                                            {
                                                "example_id": "5eaf6041-0c98-4a50-bae0-4941a27606c8",
                                                "sense_id": "a0189b4f-d853-3b0c-98da-32351b28194a",
                                                "text": "The face was white and thoroughly bloodless with some kind of foundation cream; it stank of powder and a gardenia-like perfume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                                        "glosses": [
                                            "Taking place without loss of blood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c0ea6b-10b6-4ed5-98cd-b30a806bbde5",
                                                "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                                                "text": "a bloodless conquest; a bloodless coup d'état; a bloodless revolution; a bloodless victory"
                                            },
                                            {
                                                "example_id": "00d089de-e563-414d-9ef8-81dd2f0039ca",
                                                "sense_id": "5db9e638-d478-30b4-a5d0-32b6c59ab4bd",
                                                "text": "Now and then a gaudy peacock would run from his shelter in the lauhala trees, but no wild boars came out, so we returned from our raid bloodless and spoilless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                        "entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                                        "glosses": [
                                            "Lacking emotion, passion or vivacity."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe98337-4166-4bda-ae09-58783b2f52df",
                                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                                "text": "Those Philharmonic subscribers who considered Guest Conductor Igor Stravinsky too bloodless and ascetic […] last week found his successor, Georges Enesco, more to their taste."
                                            },
                                            {
                                                "example_id": "64725b35-e17b-4077-9aee-1748c662ebc7",
                                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                                "text": "Many of them are leaving us — the words. Gone into hiding […] Now they lurk, uncaged, behind other words, behind trending, brittle, bloodless little wokeisms […]"
                                            },
                                            {
                                                "example_id": "aa6fe84a-d783-4bda-8c55-2f3b5dfc3970",
                                                "sense_id": "1954bcb9-3d0e-36be-b983-3b450535ee50",
                                                "text": "There is plenty of commentary, even among users of other platforms, about how Threads is bloodless (and owned by Mark Zuckerberg), Mastodon is inscrutable, and Bluesky is humorless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
