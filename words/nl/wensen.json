                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directie <w>wenst</w> niet gestoord te worden tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The management does not <w>wish</w> to be disturbed during the meeting.",
                                "ru": "Руководство <w>желает</w>, чтобы его не беспокоили во время собрания.",
                                "pl": "Dyrekcja nie <w>życzy sobie</w>, aby jej przeszkadzano podczas spotkania.",
                                "de": "Die Geschäftsleitung <w>wünscht</w> während der Sitzung nicht gestört zu werden.",
                                "fr": "La direction ne <w>souhaite</w> pas être dérangée pendant la réunion.",
                                "it": "La direzione non <w>desidera</w> essere disturbata durante la riunione.",
                                "cs": "Vedení si <w>nepřeje</w> být během schůze rušeno.",
                                "tr": "Yönetim, toplantı sırasında rahatsız edilmeyi <w>istemiyor</w>.",
                                "es": "La dirección no <w>desea</w> ser interrumpida durante la reunión.",
                                "zh": "管理层不<w>希望</w>在会议期间被打扰。"
                            }
                        },
                        {
                            "text": "De kwaliteit van het eten liet helaas te <w>wensen</w> over.",
                            "target_lang_translations": {
                                "en": "Unfortunately, the quality of the food left something to be <w>desired</w>.",
                                "ru": "Качество еды, к сожалению, оставляло <w>желать</w> лучшего.",
                                "pl": "Jakość jedzenia pozostawiała niestety wiele do <w>życzenia</w>.",
                                "de": "Die Qualität des Essens ließ leider zu <w>wünschen</w> übrig.",
                                "fr": "La qualité de la nourriture laissait malheureusement à <w>désirer</w>.",
                                "it": "La qualità del cibo purtroppo lasciava molto a <w>desiderare</w>.",
                                "cs": "Kvalita jídla bohužel <w>zanechávala mnoho k přání</w>.",
                                "tr": "Yemeğin kalitesi maalesef daha iyi olmayı <w>diletiyordu</w> (daha iyi olabilirdi).",
                                "es": "La calidad de la comida, lamentablemente, dejaba mucho que <w>desear</w>.",
                                "zh": "遗憾的是，食物的质量还有待<w>改进</w>。"
                            }
                        }
