                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e7cef1-c2d2-4b68-8bda-9bdb96d08039",
                                "sense_id": "23c59324-f803-302e-b066-bbf8bd2541f2",
                                "text": "„Darüber hinaus hat es die Behörde verabsäumt, die am Pkw der Berufungswerberin (tatsächlich bereits vor dem Vorfallszeitpunkt) vorhandenen Beschädigungen zu konkretisieren bzw auszuführen, ob das Schadenbild am Pkw der Berufungswerberin mit dem am Pkw der H. B. –A. aus kfz-technischer Sicht in Einklang zu bringen ist.“"
                            },
                            {
                                "example_id": "0f76c20f-cb8a-4f1b-847a-5f642b309d5c",
                                "sense_id": "23c59324-f803-302e-b066-bbf8bd2541f2",
                                "text": "„Eine Überprüfung ergab, dass das dortige Schadenbild mit dem Schadensbild am Fahrzeug übereinstimmt.“"
                            },
                            {
                                "example_id": "6b9d410f-ac07-491b-99a9-aee1caee7cae",
                                "sense_id": "23c59324-f803-302e-b066-bbf8bd2541f2",
                                "text": "„Das Schadenbild in den Bauwerken ist nahezu einheitlich: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
