                        "examples": [
                            {
                                "example_id": "c9bc4440-9028-4649-b5cd-ee9f3ad5c076",
                                "sense_id": "da73bb11-d896-35e2-99ff-e89545e9491f",
                                "text": "Тебе, живя здесь, нельзя не иметь подмосковной."
                            },
                            {
                                "example_id": "ebb376e6-99dd-4a70-8b57-af67e33e8ae4",
                                "sense_id": "da73bb11-d896-35e2-99ff-e89545e9491f",
                                "text": "Дворник мне сказывал, что Иван Иванович уехал на два дня к кому-то в подмосковную и вряд ли будет назад прежде завтрашнего утра."
                            }
                        ]
                    }
