                        "glosses": [
                            "Ancienne compagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79a1667-800b-4a32-989d-19fd115248f6",
                                "sense_id": "26ba9908-f7bd-37a0-8522-14bc7ef59a11",
                                "text": "Hormis une de mes ex-compagnes, qui est décédée, j'ai gardé les neuf autres dans ma vie."
                            },
                            {
                                "example_id": "8911ea7f-9e82-43e9-bf16-3cda21665ef4",
                                "sense_id": "26ba9908-f7bd-37a0-8522-14bc7ef59a11",
                                "text": "En 2020, Hakim Belaroussi et son ex-compagne créent l’institut Capeline, un projet né de la volonté d’une famille durement touchée par le cancer d’offrir aux autres patients ce qu’elle n’a pas pu trouver à l’époque."
                            },
                            {
                                "example_id": "0a2f5d34-f2bb-4310-bd67-10be55a83620",
                                "sense_id": "26ba9908-f7bd-37a0-8522-14bc7ef59a11",
                                "text": "Même situation pour Tommy Lee, batteur de Mötley Crüe, condamné en 1998 pour violences conjugales envers son ex-compagne, Pamela Anderson, ou pour Tim Lambesis, membre fondateur d’As I Lay Dying, condamné, en 2014, pour avoir tenté de faire assassiner son épouse."
                            }
                        ]
                    }
