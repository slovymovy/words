                ],
                "senses": [
                    {
                        "sense_id": "9c81e906-c942-3e13-a066-080115003a0d",
                        "entry_id": "13aed578-af38-332a-ade2-a2d2caae82dc",
                        "glosses": [
                            "een oorlogsvliegtuig dat is ontworpen voor het werpen van bommen op gronddoelen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728cf838-671d-4ae8-a59f-ffc6a9839873",
                                "sense_id": "9c81e906-c942-3e13-a066-080115003a0d",
                                "text": "Door B-2 bommenwerpers werden tientallen geleide bommen afgevuurd."
                            },
                            {
                                "example_id": "297c366b-abe0-4440-8618-a6189843ac63",
                                "sense_id": "9c81e906-c942-3e13-a066-080115003a0d",
                                "text": "En omgekeerd zouden onze ouders als escorte en bescherming fungeren wanneer de Amerikaanse bommenwerpers opstegen vanaf het vliegveld Gardermoen in Noorwegen op weg naar verschillende doelen in de Sovjet-Unie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ec95d79-680f-4ddf-9d67-733fae3b3544",
                        "source_entry_id": "13aed578-af38-332a-ade2-a2d2caae82dc",
                        "source_sense_id": "9c81e906-c942-3e13-a066-080115003a0d",
                        "source_sense_description": "een militair vliegtuig dat is ontworpen voor het werpen van bommen op gronddoelen",
                        "target_lang_word": "Bomber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bomber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                        "entry_id": "ba8c6fab-cd20-3752-bc45-89f57adc7f8b",
                                        "glosses": [
                                            "Flugzeug zur Bekämpfung von Boden- oder Seezielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd62bea-06f9-42c3-aafe-3130128882bc",
                                                "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                                "text": "Im Zweiten Weltkrieg wurden Bomber erstmals vornehmlich gegen die Zivilbevölkerung eingesetzt."
                                            },
                                            {
                                                "example_id": "9b36bd32-09af-4f78-94d1-09d8718131f9",
                                                "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                                "text": "„Öfter schon waren Bomber in der Dunkelheit über sie hinweggeflogen, aber neuerdings kamen sie dichter, das Summen war stärker und dauerte länger vom ersten bis zum letzten Ton.“"
                                            },
                                            {
                                                "example_id": "41a26721-642d-46e4-be0a-239156fc9ab7",
                                                "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                                "text": "„Da die feindlichen Bomber meist den kürzesten Weg nahmen, von Fliegerhorsten auf der französischen Seite der Vogesenfront direkt nach Osten Richtung Freiburg, funktionierte die Vorwarnung recht gut: …“"
                                            },
                                            {
                                                "example_id": "2782f6e0-f419-4c0a-8222-076f9fd83b21",
                                                "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                                "text": "„Die britischen Bomber kamen fast täglich, meistens mitten in der Nacht.“"
                                            },
                                            {
                                                "example_id": "bb425736-5cd5-46f3-a6aa-cc2a7175f0c3",
                                                "sense_id": "be4b8cbe-280e-353e-819a-053f00510bd6",
                                                "text": "„Gegen Abend setzte der Bomber zur Landung in seinem Heimathafen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9316afc-373f-323c-89db-6d01dd02e7c4",
                                        "entry_id": "ba8c6fab-cd20-3752-bc45-89f57adc7f8b",
                                        "glosses": [
                                            "jemand, der eine Bombe platziert"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "614b2458-a0d1-4220-9294-1ad3187402c8",
                                                "sense_id": "f9316afc-373f-323c-89db-6d01dd02e7c4",
                                                "text": "Vor wenigen Jahren versetzte ein Bomber die Hauptstadt in Angst und Schrecken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "32a2723d-339f-3c51-9c0f-1e282359982d",
                                        "entry_id": "ba8c6fab-cd20-3752-bc45-89f57adc7f8b",
                                        "glosses": [
                                            "Spieler, der eine besonders gute Schusskraft besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445506ea-314a-4233-9ca8-f5cbf8ac8189",
                                                "sense_id": "32a2723d-339f-3c51-9c0f-1e282359982d",
                                                "text": "Damals im Jugendsportverein war mein Vater im Sturm ein Bomber."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62502105-f871-4d62-8da0-148dc72194bb",
                        "source_entry_id": "13aed578-af38-332a-ade2-a2d2caae82dc",
                        "source_sense_id": "9c81e906-c942-3e13-a066-080115003a0d",
                        "source_sense_description": "een militair vliegtuig dat is ontworpen voor het werpen van bommen op gronddoelen",
                        "target_lang_word": "bomber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bomber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da8054a-3b85-3c92-a086-dbff0eafa385",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "A military aircraft designed to carry and drop bombs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0c4873-59d0-4ce7-b97b-f6574739c7d7",
                                                "sense_id": "0da8054a-3b85-3c92-a086-dbff0eafa385",
                                                "text": "As many as 100,000 Japanese people were killed and another million injured, most of them civilians, when more than 300 American B-29 bombers dropped 1,500 tons of firebombs on the Japanese capital that night."
                                            },
                                            {
                                                "example_id": "e31740fb-08ba-47bd-8c38-7ead330d16d7",
                                                "sense_id": "0da8054a-3b85-3c92-a086-dbff0eafa385",
                                                "text": "B-2 bombers are the only plane capable of carrying the Massive Ordinance Penetrator, which experts have highlighted as the only type of bomb potentially capable of destroying Iran’s underground Fordow nuclear facility. Each B-2 bomber is able to carry two of these “bunker buster” bombs, which weigh an impressive 30,000 pounds each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd87613-1b8d-3fca-b272-09c68c168ad2",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "A person who sets bombs, especially as an act of terrorism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de8e50a-8ef6-4cf9-99d4-4debb8e62d9e",
                                                "sense_id": "6dd87613-1b8d-3fca-b272-09c68c168ad2",
                                                "text": "The nail bomber who killed three people and injured dozens of others in a terrifying campaign last spring told police he was a homophobic Nazi, and that he hoped the explosions would \"set fire to the country and stir up a racial war\", the Old Bailey heard yesterday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe2eb0c-1dd1-3f9e-9779-e13084a23806",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "Ellipsis of bomber jacket."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7afceec-feb0-4e04-82b8-12f53a32290a",
                                                "sense_id": "2fe2eb0c-1dd1-3f9e-9779-e13084a23806",
                                                "text": "A few years ago, the leather bomber was a gold mine for retailers and a gravy train for vendors. Consumers were crazy for them."
                                            },
                                            {
                                                "example_id": "1962995f-5a48-4f09-ad56-eea216145fe7",
                                                "sense_id": "2fe2eb0c-1dd1-3f9e-9779-e13084a23806",
                                                "text": "First singer and guitarist Marcus Mumford, wearing a black suit, then bassist Ted Dwane, in leather bomber and T-shirt.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fc28da7-9c12-3445-bdb8-0e4f61008628",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "A 22-ounce beer bottle."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa41125b-908a-31d3-a5fd-2460ac9ee74a",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "Ellipsis of graffiti bomber."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c81c2db8-4b89-4d58-bf26-1a9cbff7c512",
                                                "sense_id": "aa41125b-908a-31d3-a5fd-2460ac9ee74a",
                                                "text": "To bomb the system is to saturate MTA subway cars with one's signatures. ln the 1980s, certain writers were identified as bombers because they had mastered all disciplines of the form: insides, throw-ups, window-downs, top-to-bottoms, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ca85e6-f67c-3042-9dd4-b3759e1e8d72",
                                        "entry_id": "13dd3c1a-e32d-3e46-a384-50377adfa16f",
                                        "glosses": [
                                            "A large cannabis cigarette."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51aa6c4b-e6f8-457f-a6b4-4aa8193cf396",
                                                "sense_id": "55ca85e6-f67c-3042-9dd4-b3759e1e8d72",
                                                "text": "In Canada, marihuana cigarettes rarely contain any tobacco, and may vary in size from a few hundred milligrams up to a several gram \"bomber.\""
                                            },
                                            {
                                                "example_id": "c98e6612-5484-48ad-ad03-036a147caaee",
                                                "sense_id": "55ca85e6-f67c-3042-9dd4-b3759e1e8d72",
                                                "text": "That night, I swallowed the last of my pain pills, smoked a bomber, and let the drugs carry me away."
                                            }
                                        ]
                                    }
                                ]
                            },
