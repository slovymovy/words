                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77f2541-cb41-374d-b1ae-b7e22ae0a41a",
                                        "entry_id": "88d2eeec-b8b1-3e42-9bec-6f38243aa40a",
                                        "glosses": [
                                            "Genetically modified."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71213cdd-7b17-40fe-8b31-793ec8d2a261",
                                                "sense_id": "f77f2541-cb41-374d-b1ae-b7e22ae0a41a",
                                                "text": "About 93 percent of the soybeans grown in the United States are GMO."
                                            },
                                            {
                                                "example_id": "3407ffe9-7e74-481e-a247-7f096d548d9d",
                                                "sense_id": "f77f2541-cb41-374d-b1ae-b7e22ae0a41a",
                                                "text": "Since 85 to 95% of these crops are GMO, it is safe to assume – unless provided proper certification – that “normal” dairy products contain GMO ingredients in one form or another."
                                            },
                                            {
                                                "example_id": "26641aab-7cd0-4370-9aa6-e88ba6d49aad",
                                                "sense_id": "f77f2541-cb41-374d-b1ae-b7e22ae0a41a",
                                                "text": "Contains at least 70% organic ingredients and the rest of the product cannot be GMO, irradiated, or grown with sewage sludge"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04a5fe8f-3508-454d-9170-5c385ef20b08",
                        "source_entry_id": "6f276e9c-0820-3862-872c-c147cca65793",
                        "source_sense_id": "d9a5dda8-dca6-3104-add1-8813f607f810",
                        "target_lang_word": "OGM",
