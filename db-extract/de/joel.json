                    },
                    {
                        "translation_id": "cf7ac4d0-56ba-4bb1-beca-5a46803786eb",
                        "source_entry_id": "60cb33c5-6aae-351a-b601-c06643594e9e",
                        "source_sense_id": "c4e61585-1d5e-3d18-8156-ea819f2e48c1",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Joël",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joël",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21d535ac-f7e8-394c-9ed2-e7c2a47c4491",
                                        "entry_id": "687a749e-a32c-33f0-9d54-eff88fdf2c7f",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4187c42e-e175-4db8-a3d1-877fc5d41f86",
                                                "sense_id": "21d535ac-f7e8-394c-9ed2-e7c2a47c4491",
                                                "text": "Pour l’événement, l’équipe de l’animateur Joël Le Bigot se déplace dans la salle de recherche de Bibliothèque et Archives nationales du Québec (BAnQ) Vieux-Montréal.."
                                            },
                                            {
                                                "example_id": "f3789a82-a72f-49a6-bb62-2a5864142de8",
                                                "sense_id": "21d535ac-f7e8-394c-9ed2-e7c2a47c4491",
                                                "text": "\"On a rapporté au moins trois accidents qui auraient pu être tragiques pour les passagers en forçant les gens à conduire la nuit, en les empêchant de dormir ou se reposer pendant la nuit en route pour les Îles-de-la-Madeleine. C’est une longue route\", déplore Joël Arseneau."
                                            },
                                            {
                                                "example_id": "b8740831-6cac-4c95-bc63-9b11287ceae6",
                                                "sense_id": "21d535ac-f7e8-394c-9ed2-e7c2a47c4491",
                                                "text": "« Les bénéfices records, fièrement affichés par les entreprises, ont été vécus comme un véritable provocation », atteste Joël Sohier, maître de conférences à l’université de Reims et auteur de l’ouvrage Le Syndicalisme en France (éd. Vuibert, 2010)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Joël",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68f9b234-dade-30e4-bc55-c5ceca1d7c87",
                                        "entry_id": "d3c388e5-42ac-326b-9cc2-30145d92fe9e",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06d6093d-cbdd-4478-bbcd-715731ecfb6b",
                                                "sense_id": "68f9b234-dade-30e4-bc55-c5ceca1d7c87",
                                                "text": "Fondée en 1988 par Henriette Joël, qui en fut la première présidente, et aujourd’hui présidée par Geneviève Escoffier, l’association des Amis du Musée de Saint-Cloud s’est donné pour objet d’aider le musée à enrichir ses collections (acquisitions d’œuvres) et à développer ses actions et son rayonnement auprès du public."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Joël",
                                "target_lang_code": "fr",
                                "target_senses": [
