                ],
                "translations": [
                    {
                        "translation_id": "1ebdac2e-cb87-4e44-aa91-5989f252ab5e",
                        "source_entry_id": "c6914061-4d6e-3d66-9d21-d77b8da74f5f",
                        "source_sense_description": "pertaining to the heart",
                        "target_lang_word": "srdeční",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "srdeční",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0d7acbd9-d888-33bd-9c9b-138554659678",
                                        "entry_id": "2b25095b-9cc8-35a5-8a2b-d68953d27e07",
                                        "glosses": [
                                            "související se srdcem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cef2b36-019c-4ead-bdc1-b818ac39d91a",
                                                "sense_id": "0d7acbd9-d888-33bd-9c9b-138554659678",
                                                "text": "Jsou na jisto lidé, kteří každé zakašlání za projev souchotin považují — každé zrychlení tepny srdeční vadou si vykládají, každého zavanutí větru smrtelně se obávají, před každým jídlem úzkostlivě se tážou, zdali jim neuškodí a podobně."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "srdeční",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "efc607e0-f498-3eff-a12c-4dc5f7287a65",
                                        "entry_id": "974635fe-1200-37f3-b3af-63af9fb42a57",
                                        "glosses": [
                                            "nominativ množného čísla mužského životného rodu přídavného jména srdečný"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68ce1da-0f61-46f1-bb9d-3c3d39704ad9",
                                                "sense_id": "efc607e0-f498-3eff-a12c-4dc5f7287a65",
                                                "text": "V lavicích usedli známí návštěvníci tohoto chrámu, lidé prostí a srdeční, nejvíce úsměvných kmetův a stařenek, jež skláněly se nad velikými, tlustými modlitbami."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49b21a3-bca4-3433-9f40-cb4ee16768f0",
                                        "entry_id": "974635fe-1200-37f3-b3af-63af9fb42a57",
                                        "glosses": [
                                            "vokativ množného čísla mužského životného rodu přídavného jména srdečný"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2c36644-ad0e-4ac8-8a99-462279595e9a",
                        "source_entry_id": "c6914061-4d6e-3d66-9d21-d77b8da74f5f",
                        "source_sense_description": "pertaining to the heart",
                        "target_lang_word": "cardiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                                        "glosses": [
                                            "Relatif au cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5351abab-7148-4238-b4ee-071e6611bbfe",
                                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                                            },
                                            {
                                                "example_id": "3d8c14a2-e88c-43e6-a9dd-74abb4bab419",
                                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                                "text": "Bien que souffrant d’une néphrite chronique avec complications cardiaques, il ne voulut pas consentir à prendre le moindre repos, […]."
                                            },
                                            {
                                                "example_id": "b37e9336-d349-4903-a7d2-3b3be8b584da",
                                                "sense_id": "c534f9c4-9279-33e7-9487-9d9221105a44",
                                                "text": "Le phosphure de zinc employé comme rodenticide puissant produit en général des lésions nécrotiques ou rénales et entraîne la mort par défaillance cardiaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                                        "glosses": [
                                            "Ce qui appartient au cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04b92b7-6066-438f-9673-c2063ad836c0",
                                                "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                                                "text": "On admet généralement que le nerf vague agit, non pas sur le muscle cardiaque, mais sur les ganglions intracardiaques, parce que le cœur arrêté par tétanisation du nerf vague se contracte encore si on l'excite directement."
                                            },
                                            {
                                                "example_id": "822ae884-5197-4c7f-a69d-58a90b0b250e",
                                                "sense_id": "62537306-40d4-3daf-b88b-429b9c4daade",
                                                "text": "Artères, veines cardiaques. Nerfs cardiaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ea17b9-21a9-3cf5-b4b6-261abe6aeb5c",
                                        "entry_id": "dbed9fe4-41d5-3212-9a8a-cb45ce4dabe0",
                                        "glosses": [
                                            "Qui soigne le cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13fd9ca-6915-44df-b4ad-1a4a90a5444b",
                                                "sense_id": "94ea17b9-21a9-3cf5-b4b6-261abe6aeb5c",
                                                "text": "remède cardiaque, médicament tonique ou stimulant dont l’action se porte sur le cœur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cardiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95df94b3-d84c-3348-8908-2578018cb5a0",
                                        "entry_id": "089adf9e-13f9-3faf-95b0-2ca2c9547960",
                                        "glosses": [
                                            "Celui ou celle qui a une maladie du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8522f714-e27f-4a66-9bec-10c43fad2451",
                                                "sense_id": "95df94b3-d84c-3348-8908-2578018cb5a0",
                                                "text": "Les cardiaques sont des gens dont le cœur souffre de diverses lésions organiques ou d’irrégularités dans le rythme."
                                            },
                                            {
                                                "example_id": "6a0ff858-6e23-42ec-bd90-03e7994d4ec7",
                                                "sense_id": "95df94b3-d84c-3348-8908-2578018cb5a0",
                                                "text": "En aucune manière, elle n’entrerait dans la catégorie des cardiaques : elle prenait grand soin de sa santé et n’avait rien à voir avec ce ramassis de sédentaires amateurs de charcuterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5268c829-86d1-317b-8650-27ae7fa9517a",
                                        "entry_id": "089adf9e-13f9-3faf-95b0-2ca2c9547960",
                                        "glosses": [
                                            "Remède pour le cœur."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8761b082-4550-4936-9de1-94e4c60ee85d",
                                                "sense_id": "5268c829-86d1-317b-8650-27ae7fa9517a",
                                                "text": "un bon cardiaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
