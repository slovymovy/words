                "senses": [
                    {
                        "sense_id": "511f7e41-d98d-3685-897c-3552b68e593b",
                        "entry_id": "ed8e807c-6e93-34ed-8e16-806f81273284",
                        "glosses": [
                            "Donner un caractère triomphal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76948b24-b681-4ae1-a1ef-07c0067083d0",
                                "sense_id": "511f7e41-d98d-3685-897c-3552b68e593b",
                                "text": "La volonté de triomphaliser cette représentation de 1’Annonciation, symbole de l’Incarnation, est ici clairement affirmée dans le respect des préceptes du concile de Trente et pour réagir contre la familiarité de l’art religieux du XVe siècle."
                            },
                            {
                                "example_id": "e5196ba7-ed83-4526-9937-9cfa3b3100b0",
                                "sense_id": "511f7e41-d98d-3685-897c-3552b68e593b",
                                "text": "Elles taisent les triomphes disparus pour triomphaliser Vadventus, elles décrivent l’adoration et explicitent sa fonction en omettant d’indiquer son origine."
                            }
                        ]
                    },
                    {
                        "sense_id": "15008a80-1649-35ff-83d4-dd0b17122d9d",
                        "entry_id": "ed8e807c-6e93-34ed-8e16-806f81273284",
                        "glosses": [
                            "Triompher."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "af1bfba5-0e99-43c2-ad24-4dfad282a08e",
                                "sense_id": "15008a80-1649-35ff-83d4-dd0b17122d9d",
                                "text": "Le Mfm Pety Rakotoniaina a gagné haut la main sa revanche à Fianarantsoa mais Monsieur le maire devra éviter de triomphaliser trop tôt."
                            }
                        ]
                    }
                ],
