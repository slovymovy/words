                                                "example_id": "e053166d-bcc8-476f-8852-624fc5bd331a",
                                                "sense_id": "b9323597-57af-351e-a598-5e74ca9118aa",
                                                "text": "Bedeckter Boden fördert das Wachstum der Pflanzen."
                                            },
                                            {
                                                "example_id": "7ad340e1-f8fb-4ae7-a1a5-b1959c2b762e",
                                                "sense_id": "b9323597-57af-351e-a598-5e74ca9118aa",
                                                "text": "Beim Bambus beträgt das Wachstum bis zu zehn Zentimeter pro Tag."
                                            },
                                            {
                                                "example_id": "361df20a-5467-4a94-a92c-bfdf73109b5d",
                                                "sense_id": "b9323597-57af-351e-a598-5e74ca9118aa",
                                                "text": "„In diesem lebendigen Kosmos des organischen Wachstums erscheinen das aschene Schwarz und somit die mächtigen Linien in Klees Spätwerk zunächst als Auslöschung alles Vitalen.“"
                                            }
                                        ],
