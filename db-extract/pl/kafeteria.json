                    {
                        "translation_id": "8861aaf8-a099-475d-b8a4-e5731cdecf20",
                        "source_entry_id": "1e3c3dfe-6d5f-3707-9d09-55266e5ad617",
                        "source_sense_id": "6d9ceea6-4b3f-3238-90f4-b39c104e8eda",
                        "target_lang_word": "cafétéria",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafétéria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d34a67a9-0e0d-3952-bfbc-584d915f886e",
                                        "entry_id": "cb117fac-e13b-3ca1-9039-960b16acfcbe",
                                        "glosses": [
                                            "Établissement ouvert au public ayant pour principale vocation la consommation de café et autres boissons ou prendre un repas léger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4d59de-c784-4247-96a8-2c13ac230589",
                                                "sense_id": "d34a67a9-0e0d-3952-bfbc-584d915f886e",
                                                "text": "On les croise dans les cafétérias, on les voit errer dans les bâtiments, fréquenter assidument la moindre réunion, tout heureux de trouver un siège où se poser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e4b1140-15c2-300b-ad8b-dd90d98c830a",
                                        "entry_id": "cb117fac-e13b-3ca1-9039-960b16acfcbe",
                                        "glosses": [
                                            "Grand local d’un établissement d’enseignement ou autre où on peut manger son propre repas ou des repas servis sur place à un comptoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39444b7-4754-4e96-9e66-ed822772eb5d",
                                                "sense_id": "2e4b1140-15c2-300b-ad8b-dd90d98c830a",
                                                "text": "La cafétéria était bruyante et animée. Je me suis mis en file pour le café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e309f47-152b-4d39-9936-7617200af5a6",
                        "source_entry_id": "1e3c3dfe-6d5f-3707-9d09-55266e5ad617",
                        "source_sense_id": "6d9ceea6-4b3f-3238-90f4-b39c104e8eda",
                        "target_lang_word": "Cafeteria",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cafeteria",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                        "entry_id": "fe488db7-c046-345e-99a2-b709414b0e7f",
                                        "glosses": [
                                            "Café mit Selbstbedienung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f23f963d-cb31-4fee-8275-0597cf60bf64",
                                                "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                                "text": "Nach der Vorlesung treffen sich alle Studenten zum Kaffeetrinken in der Cafeteria."
                                            },
                                            {
                                                "example_id": "81d254b5-790d-4414-8ddb-a05920d23875",
                                                "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                                "text": "„Ein Pfeil wies eine Treppe hinauf, die in einer kleinen Cafeteria mit Häkeldeckchen und gemusterten Gardinen endete.“"
                                            },
                                            {
                                                "example_id": "94c9e456-aa3a-4932-924c-b792c264bd6b",
                                                "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                                "text": "„Der Speisesaal wirkte eher wie eine Cafeteria.“"
                                            },
                                            {
                                                "example_id": "71f1500a-eca8-455c-be4e-1d35eb64d35a",
                                                "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                                "text": "„Die Cafeteria erinnert an den Ausschank eines Kleinstadtbahnhofs.“"
                                            },
                                            {
                                                "example_id": "8e38737f-b8c5-469d-a3f4-38c1072d1f40",
                                                "sense_id": "8c9916ba-9dc4-306b-8fa9-68190d7aaabf",
                                                "text": "„Tom und Fabiola hatten sich am Spätnachmittag in der Cafeteria des Instituts für eine kurze Pause verabredet, was trotz des enormen Arbeitspensums völlig legitim war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
