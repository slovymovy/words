                "senses": [
                    {
                        "sense_id": "2e5946d5-5c33-3fb8-9ec6-0e641d36ca6c",
                        "entry_id": "6585221f-aa0b-3f9e-b810-9183e1db7c3c",
                        "glosses": [
                            "Modell, das am weitesten verbreitet ist, um etwas zu beschreiben oder möglichst zu erklären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad8a9f0-1ec9-42a0-ad67-9f102f7a029d",
                                "sense_id": "2e5946d5-5c33-3fb8-9ec6-0e641d36ca6c",
                                "text": "„Der Ort hatte nur wenig mit meiner romantischen Vorstellung einer historischen Handelsstätte zu tun, sondern war ein weiteres Standardmodell afrikanischer Armut.“"
                            },
                            {
                                "example_id": "7732ee27-17aa-4b66-84b8-9f37b4440258",
                                "sense_id": "2e5946d5-5c33-3fb8-9ec6-0e641d36ca6c",
                                "text": "„Das Standardmodell der Kosmologie beschreibt ein Universum, das aus dem Nichts mit dem Urknall entstand und seitdem expandiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
