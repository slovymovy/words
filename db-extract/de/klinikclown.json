                "senses": [
                    {
                        "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                        "entry_id": "12ebb430-3a0b-3052-8757-1a07c13e4a75",
                        "glosses": [
                            "in einer Klinik oder einem Klinikum beschäftigter therapeutischer Clown"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a00614-5c3d-40fa-8964-e4d2b8d2b722",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Sein Klinikum, das von nun an als Zentrum der europäischen Klinikclowns gilt, bietet schon seit 1993 ‚Theater im Flur‘, läßt den ‚Chor der Stimmlosen‘ erklingen, bringt ‚Mozart ans Krankenbett‘ und die Clowns in die Kinderambulanz.“"
                            },
                            {
                                "example_id": "d063e5ba-4f61-4995-a596-218140d333e0",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Dann sagt die Schwester: Frau Hebertseder, der Klinikclown ist da.“"
                            },
                            {
                                "example_id": "f74fef0a-3474-4648-b8dc-09fa8e443848",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Pionier der Lachtherapie ist P. Adams (USA), der selbst als Klinikclown auf seiner pädiatrischen Station auftrat.“"
                            },
                            {
                                "example_id": "6e481a36-9210-496f-8bb1-cb0a54082bb0",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Der Betrag geht nach dem Willen der Schüler an krebskranke Kinder, dabei soll besonders die Arbeit der Klinikclowns gefördert werden.“"
                            },
                            {
                                "example_id": "d1f4b4ea-a980-40b3-ac28-b088edfb3f1a",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Ein Klinikclown winkte mir mit seiner übergroßen grünen Plastikhand zu.“"
                            },
                            {
                                "example_id": "e6a2a3e0-62b5-46f7-bd43-1b8c16c4ff6a",
                                "sense_id": "b45e4fa8-e6da-30d2-8259-c1b7436f169b",
                                "text": "„Eisel konnte dort durch eine Improvisation erfahren, wie sich ihre Clownsfigur verändert, wenn der Tod mit im Raum ist. Eine Situation, der sich die Klinikclowns durchaus stellen müssen. Die ungekürzte, unkommentierte Szene macht schnell klar: Hier geht es nicht darum, Faxen zur Ablenkung der Patienten zu machen. Es geht darum, das komödiantische Spiel der Situation angemessen einzusetzen. Erst dann entfalten die Klinikclowns ihre positive Wirkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
