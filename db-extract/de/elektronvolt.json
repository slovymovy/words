                        "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                        "entry_id": "152cbc67-d296-31fb-b6d9-3b2a563c75ae",
                        "glosses": [
                            "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "70a4604a-628a-4a18-a6ca-e5280550a1db",
                                "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                                "text": "„Ein Elektronvolt ist die Energie, die eine Elementarladung (z. B. ein Elektron) beim Durchlaufen einer Beschleunigungsspannung von 1 Volt erhält.“"
                            },
                            {
                                "example_id": "0702e054-7200-4516-8739-20f855811e7d",
                                "sense_id": "682c7ed9-5262-3123-aa55-222d5476a366",
                                "text": "„So ist das Elektronvolt gleichzeitig auch die Einheit der Masse; dadurch wird die Äquivalenz von Masse und Energie besonders deutlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
