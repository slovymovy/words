                ],
                "senses": [
                    {
                        "sense_id": "812b8002-219b-3940-8225-634ebf0a1091",
                        "entry_id": "33400f18-1599-3b57-a932-8c11af4682e1",
                        "glosses": [
                            "op de toekomst voorbereid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9eab05-99f5-4d2c-a5eb-f8648fddf7d5",
                                "sense_id": "812b8002-219b-3940-8225-634ebf0a1091",
                                "text": "Om NPO toekomstbestendig te maken moeten we zoeken naar nieuwe vormen: lineair, on line en on demand. Dit proces is nog niet definitief afgerond, maar daarbij is het helaas onvermijdelijk dat omroepen en programmamakers teleurgesteld worden.’’"
                            },
                            {
                                "example_id": "0efbc777-769f-4c88-9e62-0e30fa2c3bc3",
                                "sense_id": "812b8002-219b-3940-8225-634ebf0a1091",
                                "text": "Directeur Eddy Dusseldorp noemt de overname 'zeer belangrijk om ons bedrijf toekomstbestendig te houden en een belangrijke ontwikkelingsstap, waarvan zowel onze klanten als medewerkers profiteren'."
                            },
                            {
                                "example_id": "3eb1c4f1-88ad-4323-b642-8d4a24d9e0c7",
                                "sense_id": "812b8002-219b-3940-8225-634ebf0a1091",
                                "text": ",,Er is gekozen voor duurzame en onderhoudsvriendelijke materialen”, licht Ewald Steggink van Aannemersbedrijf Steggink toe. ,,Bovendien worden de woningen toekomstbestendig gebouwd. Dit houdt in dat de appartementen eenvoudig om te bouwen zijn tot eengezinswoningen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bb25068-b82f-498b-b9bf-8096fc8c3111",
                        "source_entry_id": "33400f18-1599-3b57-a932-8c11af4682e1",
                        "source_sense_id": "812b8002-219b-3940-8225-634ebf0a1091",
                        "target_lang_word": "future-proof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "future-proof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96176e69-649b-3443-bdfe-0ae0299084f4",
                                        "entry_id": "947c7b05-999e-3a79-bb98-893151d4e4e3",
                                        "glosses": [
                                            "Capable of surviving changes made in the future; not liable to become outdated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab56434-3dfe-4231-993f-d7fd5ae8867d",
                                                "sense_id": "96176e69-649b-3443-bdfe-0ae0299084f4",
                                                "text": "Videos recorded at a higher resolution are more future-proof since they can be viewed with more detail on higher resolution screens that one might own in future."
                                            },
                                            {
                                                "example_id": "40c8dbdd-4cd6-4e19-893c-3c7a90d20a91",
                                                "sense_id": "96176e69-649b-3443-bdfe-0ae0299084f4",
                                                "text": "It’s not easy to buy a future-proof laptop because the industry is moving in the opposite direction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "future-proof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                        "entry_id": "407343e2-9296-3547-a804-5d62558dfefe",
                                        "glosses": [
                                            "To make ready to meet potential future requirements, or make use of potential future opportunities."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9577bf1-1237-4b72-835b-38fca72cd478",
                                                "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                                "text": "While today’s most common image type, JPEG, had a few defenders, many believe it’s not a good candidate for future-proofing images because it is a “lossy” format."
                                            },
                                            {
                                                "example_id": "a5ddb979-ccbf-459b-97d3-1279ddcbc4a3",
                                                "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                                "text": "It is written to support you as you develop your own point of view about the future—and your own path to creating a future-proofed working life."
                                            },
                                            {
                                                "example_id": "a1793c8a-d125-4cc4-a85b-afcb8d98673f",
                                                "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                                "text": "A clear national strategy is \"urgently needed\" to help future-proof coastal areas from rising sea levels and extreme weather, according to a report published by the National Trust on Friday."
                                            },
                                            {
                                                "example_id": "948002bd-e1b6-4db8-9d06-70b078b80af1",
                                                "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                                "text": "Marie Leblanc, the CEO of the label, said the changes were necessary to “future-proof” the brand, which has yet to turn a profit despite being one of the most high-profile names in British fashion for the past decade."
                                            },
                                            {
                                                "example_id": "363bbafd-6275-4db6-a5b3-d101b68fd580",
                                                "sense_id": "931baf57-b5ac-3b3d-bc65-682170ed042e",
                                                "text": "Beeching is more disparaging about suburban services beyond the capital, and I think here lies one of the most critical shortcomings in his analysis. By not considering the potential for these cities to grow, both on their own merits and in response to London's limitations, he failed to future-proof these types of service, limiting them in favour of long-distance services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
