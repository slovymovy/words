    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f497c489-39bc-3b3d-ac96-3526face0882",
                "word": "handicraftsman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "083d928a-55ee-4d8b-8ddc-cc901b7fa2fa",
                        "entry_id": "f497c489-39bc-3b3d-ac96-3526face0882",
                        "tags": [
                            "plural"
                        ],
                        "form": "handicraftsmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                        "entry_id": "f497c489-39bc-3b3d-ac96-3526face0882",
                        "glosses": [
                            "A practitioner of a handicraft, usually male."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38df3ca2-7013-40e3-b79c-e0d03f12ee08",
                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                "text": "I knowe, that a handie-crafts-man [translating artisan] will ſcarcely looke of his worke, to gaze vpon an ordinarie man: Whereas to ſee a notable great perſon come into a towne, he will leave both worke and ſhop."
                            },
                            {
                                "example_id": "04c5c75a-038f-404e-99f2-fe370a9c0ee8",
                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                "text": "Handy-Crafts-Men, of Strong, & Manly Arts, as Smiths, Maſons, Carpenters, &c"
                            },
                            {
                                "example_id": "a84832bb-7d0e-46f6-8f41-73295bd02363",
                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                "text": "He may, among the drunkards, be a hearty fellow, and, among sober handicraftsmen, a free-spoken gentleman; but he must have some better distinction, before he is a patriot."
                            },
                            {
                                "example_id": "96285f1f-118a-4bfb-98b7-aa4d53112790",
                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                "text": "Like all native handicraftsmen he sits down at his work."
                            },
                            {
                                "example_id": "e1d46958-561c-4602-8e53-fa3effa2da95",
                                "sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                                "text": "I know that a good honest handicraftsman, Erik, the glove-maker, has been your suitor; he is a widower without children, he is well off; think whether you cannot be content with him."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "276f9973-e1ab-4d10-8a28-202edb0879ed",
                        "source_entry_id": "f497c489-39bc-3b3d-ac96-3526face0882",
                        "source_sense_id": "d08528d2-f479-3ff8-b346-1d01f6b51209",
                        "source_sense_description": "practitioner of a handicraft",
                        "target_lang_word": "ambachtsman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambachtsman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f3163749-a237-3a73-bf0e-4272222bfe98",
                                        "entry_id": "db83e557-38c8-3307-a518-ead3421eed0a",
                                        "glosses": [
                                            "iemand die met een ambacht zijn brood verdient"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad84c55d-bfb0-4a35-bb67-fd66469adfc4",
                                                "sense_id": "f3163749-a237-3a73-bf0e-4272222bfe98",
                                                "text": "Een figuratieve ambachtsman die flirtte met pop-art, die niks moet hebben van het minimalisme van grote rode vlakken of barbaarse abstracte kunst, maar portretten maakt en reusachtige kleurrijke natuurschilderingen. Een vrolijke, innemende snuiter bovendien."
                                            },
                                            {
                                                "example_id": "133278e3-74ec-40fd-8d6a-e5ebe3b3717f",
                                                "sense_id": "f3163749-a237-3a73-bf0e-4272222bfe98",
                                                "text": "Binnen een paar dagen had de ambachtsman een schitterende luit gemaakt, en toen de jongeman hem aanpakte, was het alsof hij zijn handen in een paar perfect passende handschoenen stak."
                                            },
                                            {
                                                "example_id": "024fe511-df53-457f-9a02-cee9111979cf",
                                                "sense_id": "f3163749-a237-3a73-bf0e-4272222bfe98",
                                                "text": "'Ik doe mijn best een goed ambachtsman te worden, daar kunt u op rekenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
