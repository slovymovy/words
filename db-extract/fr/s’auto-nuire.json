                ],
                "senses": [
                    {
                        "sense_id": "98c096af-cf6f-3faa-8bde-91b853665ba0",
                        "entry_id": "9d6c3e00-43d0-38cb-bba0-2904abe5acc6",
                        "glosses": [
                            "Se nuire à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9ce3ed-8bf6-439c-985e-143195a6762d",
                                "sense_id": "98c096af-cf6f-3faa-8bde-91b853665ba0",
                                "text": "Qui ne sait souffrir ne saura percevoir les délices de la sagesse, c’est dire se plaire à s’auto-nuire."
                            },
                            {
                                "example_id": "2fbe96e3-d5a3-410d-86bb-19b6e281fc4d",
                                "sense_id": "98c096af-cf6f-3faa-8bde-91b853665ba0",
                                "text": "En somme ils ont le droit de choisir de s'auto-nuire?"
                            },
                            {
                                "example_id": "2a35858d-de6e-410e-a73f-b1ce5b2f446c",
                                "sense_id": "98c096af-cf6f-3faa-8bde-91b853665ba0",
                                "text": "Une espèce très particulière car elle est la seule sur terre à s'auto-détruire, à s'auto-nuire, à s'auto-exploiter."
                            }
                        ]
                    }
