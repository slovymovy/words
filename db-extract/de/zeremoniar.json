                ],
                "senses": [
                    {
                        "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                        "entry_id": "6e6f46d3-f3d9-34e5-ab2c-73844db57a62",
                        "glosses": [
                            "in der Liturgie des römischen Ritus für die Koordination und den reibungslosen Ablauf eines Gottesdienstes zuständiger Geistlicher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adcc33d-ef74-4851-97eb-d68ea2ad93cb",
                                "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                                "text": "„Darüber hinaus ernannte er mich zu seinem Zeremoniar sowie zum Bischöflichen Referenten für kirchenrechtliche Fragen.“"
                            },
                            {
                                "example_id": "63de8b8d-38c2-4b0e-888e-562b4dca62e0",
                                "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                                "text": "„Von den Staatsbehörden wurde ihm jedoch nur ermöglicht, als Zeremoniar und Aktuar zu arbeiten, was er 21 Jahre lang tat.“"
                            },
                            {
                                "example_id": "34f0c283-b352-48f0-b5e5-4bd529edd2aa",
                                "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                                "text": "„Eine weitere Verschärfung in die Choraldiskussion, vor allem um die Frage der Autorschaft Palestrinas, brachte der päpstliche Zeremoniar Carlo Respighi.“"
                            },
                            {
                                "example_id": "7e00a3c5-7037-4bf7-b194-2ff2c945e17d",
                                "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                                "text": "„Der Zeremoniar nannte dem Kellermeister immer den Ritter – Großmeister eines Bundes, Fähnleinführer –, dem der Kelch zu reichen war.“"
                            },
                            {
                                "example_id": "b350d3b1-6d9d-4995-8b72-e97c25b287f6",
                                "sense_id": "4cab4d1c-1dbe-37ee-b4b1-f2cdc59e867d",
                                "text": "„Frater Cyrillus setzte sich in Bewegung, zusammen mit Abt Adelgot und dessen beiden Assistenten, dem Zeremoniar und dem zweiten Cappellanus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
