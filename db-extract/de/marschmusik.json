                "senses": [
                    {
                        "sense_id": "8c9f47cd-186e-347d-873a-a03c5d69280f",
                        "entry_id": "3e9bcc66-d559-3d8b-b436-f96bd9de062e",
                        "glosses": [
                            "für die Begleitung von Märschen komponierte Musik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d2f800-bd9c-42db-861b-80a5f6fd8e49",
                                "sense_id": "8c9f47cd-186e-347d-873a-a03c5d69280f",
                                "text": "„Quellen des Jazz waren verschiedene Arten afroamerikanischer Musik wie Blues, Gospel und Spiritual sowie die weiße Marschmusik (Marching Band, Cakewalk).“"
                            },
                            {
                                "example_id": "56d44ec6-3c0e-49c0-b378-3a5594b74439",
                                "sense_id": "8c9f47cd-186e-347d-873a-a03c5d69280f",
                                "text": "„Marschmusik dröhnte in mein Kinderzimmer.“"
                            },
                            {
                                "example_id": "e464b097-5474-4622-96fd-3b0157ce8781",
                                "sense_id": "8c9f47cd-186e-347d-873a-a03c5d69280f",
                                "text": "„Die Regimentskapellen, die seit Wilna nur selten einen Ton von sich gegeben hatten, spielten pausenlos Marschmusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
