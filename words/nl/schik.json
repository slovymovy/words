    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca2b3fb4-7ef1-37b0-bc51-a704df52cb89",
                    "sense_definition": "een gevoel van plezier of vermaak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plezier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen hadden veel <w>schik</w> tijdens het spelen in de modder.",
                            "target_lang_translations": {
                                "en": "The children had a lot of <w>fun</w> while playing in the mud."
                            }
                        },
                        {
                            "text": "Hij had grote <w>schik</w> in die ondeugd van een kleinzoon.",
                            "target_lang_translations": {
                                "en": "He took great <w>pleasure</w> in that rascal of a grandson."
                            }
                        }
                    ],
                    "synonyms": [
                        "pret"
                    ],
                    "common_phrases": [
                        "grote schik hebben",
                        "schik in iets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the expression 'schik hebben'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a feeling of pleasure, fun, or amusement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fun",
                                "target_lang_sense_clarification": "enjoyment or pleasure"
                            },
                            {
                                "target_lang_word": "amusement",
                                "target_lang_sense_clarification": "the state of being entertained"
                            },
                            {
                                "target_lang_word": "pleasure",
                                "target_lang_sense_clarification": "a feeling of happy satisfaction"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8302a510-aaba-3443-b0e0-f1b17129ad5c",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>schikken</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schik</w> de bloemen in de vaas tot ze er mooi uitzien.",
                            "target_lang_translations": {
                                "en": "I <w>arrange</w> the flowers in the vase until they look beautiful."
                            }
                        },
                        {
                            "text": "Als ik de boeken <w>schik</w> op de plank, ziet de kamer er netter uit.",
                            "target_lang_translations": {
                                "en": "When I <w>arrange</w> the books on the shelf, the room looks tidier."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'schikken' (to arrange, to suit)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrange",
                                "target_lang_sense_clarification": "to put things in a neat or required order"
                            },
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "to be convenient or acceptable for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f68884f-6bd1-3023-b22b-324ab46b43de",
                    "sense_definition": "gebiedende wijs van <w>schikken</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schik</w> de stoelen in een cirkel voor de vergadering van morgen.",
                            "target_lang_translations": {
                                "en": "<w>Arrange</w> the chairs in a circle for tomorrow's meeting."
                            }
                        },
                        {
                            "text": "<w>Schik</w> je naar de regels van het huis als je hier blijft.",
                            "target_lang_translations": {
                                "en": "<w>Adapt</w> to the house rules if you are staying here."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'schikken' (to arrange, to adapt)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrange",
                                "target_lang_sense_clarification": "command to organize or position items"
                            },
                            {
                                "target_lang_word": "adapt",
                                "target_lang_sense_clarification": "command to adjust oneself to rules or conditions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
