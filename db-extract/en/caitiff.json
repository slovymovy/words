    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "87311240-ace5-3277-9542-3bbca38f8474",
                "word": "caitiff",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8f57c898-11a2-4e4c-bd7a-a44ed427f894",
                        "entry_id": "87311240-ace5-3277-9542-3bbca38f8474",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more caitiff"
                    },
                    {
                        "form_id": "00cb4c9f-cafe-4aaa-8af1-5fe23ef39f27",
                        "entry_id": "87311240-ace5-3277-9542-3bbca38f8474",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most caitiff"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d0d43b7-e42b-3a09-a558-a1678a5b6cef",
                        "entry_id": "87311240-ace5-3277-9542-3bbca38f8474",
                        "glosses": [
                            "Especially despicable; cowardly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8377eb26-aee2-4542-9421-3cc87e2ad455",
                                "sense_id": "3d0d43b7-e42b-3a09-a558-a1678a5b6cef",
                                "text": "Beshrew those caitiff scouts that conspired to sully his honest name by such an imputation!"
                            },
                            {
                                "example_id": "fb516bc8-654b-45ac-be35-6883cbf90f35",
                                "sense_id": "3d0d43b7-e42b-3a09-a558-a1678a5b6cef",
                                "text": "Commingled are they with that caitiff choir\nOf Angels, who have not rebellious been,\nNor faithful were to God, but were for self."
                            },
                            {
                                "example_id": "69c3dd04-3003-4dd7-98f3-aa8a84e3ab0f",
                                "sense_id": "3d0d43b7-e42b-3a09-a558-a1678a5b6cef",
                                "text": "Is Honor gone into his grave?\nHath Faith become a caitiff knave\nAnd Selfhood turned into a slave\n To work in Mammon’s cave,\n Fair Lady?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8eebb01f-1c6f-3efc-a5d4-7803dd7ece3a",
                "word": "caitiff",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "144d9034-f8ff-42ed-83c4-55632a9013d1",
                        "entry_id": "8eebb01f-1c6f-3efc-a5d4-7803dd7ece3a",
                        "tags": [
                            "plural"
                        ],
                        "form": "caitiffs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "106677c1-3d93-349a-8aef-22effa02ae8d",
                        "entry_id": "8eebb01f-1c6f-3efc-a5d4-7803dd7ece3a",
                        "glosses": [
                            "A base or despicable person; a wretch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42e2e07-88a8-4282-b9c4-ee90a4146c87",
                                "sense_id": "106677c1-3d93-349a-8aef-22effa02ae8d",
                                "text": "‘There are plenty of Huns who have defected to the Romans, seeking gold and a quiet life. One of my first tasks as paramount chief is to bring those caitiffs back and crucify them.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "1d05b875-7de3-3d3b-bdf8-77590342a34d",
                        "entry_id": "8eebb01f-1c6f-3efc-a5d4-7803dd7ece3a",
                        "glosses": [
                            "A captive or prisoner, particularly a galley slave."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2a631bc2-ffeb-471b-988e-6782f1e8d066",
                                "sense_id": "1d05b875-7de3-3d3b-bdf8-77590342a34d",
                                "text": "\"How now, you scullions and cullions: bring hither a pair of cow's hooves to out face this contumelious caitiff.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b45cf734-d800-3d08-978e-23185ef2b105",
                        "entry_id": "8eebb01f-1c6f-3efc-a5d4-7803dd7ece3a",
                        "glosses": [
                            "A villain, a coward or wretch."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3f482c2e-c8a3-4a2e-ba9d-05434d9e688c",
                                "sense_id": "b45cf734-d800-3d08-978e-23185ef2b105",
                                "text": "(Aaron Burr and Andrew Jackson ride together in Tennessee; Burr narrates): Jackson shouted at me his view of the duel. \"Never read such a damned lot of nonsense as the press has been writing! All that hypocritical caterwauling for that Creole bastard (referring to Alexander Hamilton) who fought you of his own free will, just like a gentleman which he wasn't, if you'll forgive me, Colonel! I know you couldn't have met him unless you thought he was one, but he was not, Sir. He was the worst man in this union, as you, Sir, are the best. The best, and that goes for that pusillanimous spotted caitiff of a president (referring to Thomas Jefferson) we got."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
