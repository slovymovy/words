                "senses": [
                    {
                        "sense_id": "eb4c0ec9-d7de-34c3-aaed-b75cb8331b5b",
                        "entry_id": "e492222f-2fe7-336e-99a7-0a40803caca1",
                        "glosses": [
                            "Alternative form of re-earn.",
                            "To earn back something one has lost."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf80a485-9c25-4fd3-aa32-064779f7d267",
                                "sense_id": "eb4c0ec9-d7de-34c3-aaed-b75cb8331b5b",
                                "text": "The pattern was first to isolate the child physically and emotionally when he experienced parental disapproval; second, to allow the child to reearn parental love by insisting that he comply unconditionally to the parents' will."
                            },
                            {
                                "example_id": "72cdb020-d6cb-4a90-b9f1-cbf521bd579a",
                                "sense_id": "eb4c0ec9-d7de-34c3-aaed-b75cb8331b5b",
                                "text": "Well done! You have reearnt my respect!"
                            },
                            {
                                "example_id": "549a37e9-72ee-4c9a-bf6c-14128fd753f5",
                                "sense_id": "eb4c0ec9-d7de-34c3-aaed-b75cb8331b5b",
                                "text": "Carl commented on the need he and Ginny had to reearn one another's trust through a series of successes."
                            },
                            {
                                "example_id": "3c3460b3-8ce1-4afa-bb60-737a4bc90ba1",
                                "sense_id": "eb4c0ec9-d7de-34c3-aaed-b75cb8331b5b",
                                "text": "When they paused to rest the wind immediately drove them backward, and they had to reearn the distance."
                            }
                        ]
                    },
                    {
                        "sense_id": "7582c80c-67b0-3d96-8d12-519eedb6aa7d",
                        "entry_id": "e492222f-2fe7-336e-99a7-0a40803caca1",
                        "glosses": [
                            "Alternative form of re-earn.",
                            "To repeat the process of earning; to renew one's status as deserving."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903086ba-012a-4a5f-a029-56e7427e6c7a",
                                "sense_id": "7582c80c-67b0-3d96-8d12-519eedb6aa7d",
                                "text": "One consequence is the need for those in positions of authority to recognize the necessity to earn, reearn, and reearn the trust of their constituency."
                            },
                            {
                                "example_id": "bf1973b1-3aaf-4b9c-804c-81db7cb0559c",
                                "sense_id": "7582c80c-67b0-3d96-8d12-519eedb6aa7d",
                                "text": "Few, if any, companies will have to reearn a certificate from scratch."
                            },
                            {
                                "example_id": "38557f37-e621-4a3d-aec7-ecd8fa1ed7ba",
                                "sense_id": "7582c80c-67b0-3d96-8d12-519eedb6aa7d",
                                "text": "Third, this example demonstrates that earning activism at one time is insufficient for sustaining progressive social change against the forces of rhetorical decay; progressives, that is, must not merely earn activism but also continually reearn it."
                            }
                        ]
                    }
                ],
