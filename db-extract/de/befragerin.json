                        "examples": [
                            {
                                "example_id": "c17d6b1b-9649-4a50-96da-d67126e1787b",
                                "sense_id": "c3a1a52d-1c6a-3340-970b-4c78b054d2a0",
                                "text": "Die Befragerin fragte nach den Gründen der Berufswahl."
                            },
                            {
                                "example_id": "2c6eff0c-bf42-4e40-8111-022712d80736",
                                "sense_id": "c3a1a52d-1c6a-3340-970b-4c78b054d2a0",
                                "text": "„Der neuen Befragerin dürfte es gelungen sein, präzisere Aussagen von den beiden zu erhalten als davor der Polizei.“"
                            }
                        ],
