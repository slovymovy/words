                "senses": [
                    {
                        "sense_id": "a7b787a4-0a28-32bb-9fc3-df1afeb30902",
                        "entry_id": "db8d937c-84d0-3f82-8d13-7e7e806d9f8e",
                        "glosses": [
                            "wetenschapper die een taal bestudeert"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3653c4-c527-4968-9439-f943fb7764c6",
                                "sense_id": "a7b787a4-0a28-32bb-9fc3-df1afeb30902",
                                "text": "Het standbeeld is een ode aan de Duitse taalgeleerden Jacob en Wilhelm Grimm die in de 19e eeuw sprookjes verzamelden en schreven. Hun bekendste sprookjes zijn Sneeuwwitje, Hans en Grietje en Klein Duimpje."
                            },
                            {
                                "example_id": "e96c18d8-9a74-498d-a1a5-07b682c80589",
                                "sense_id": "a7b787a4-0a28-32bb-9fc3-df1afeb30902",
                                "text": "De taalgeleerde vond dat er wel belangrijkere spellingsproblemen waren. Beide heren kennen blijkbaar de problematiek van de dyslectie, letterlijk vertaald ’woordblindheid’ niet. Iemand die woordblind is zoek zijn houvast (of hauvast) in de klank en omdat hij geen beeld van het woord heeft spelt hij willekeurig met au of ou."
                            }
                        ]
                    }
