                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysoka chemiczna <w>obojętność</w> gazów szlachetnych wynika z ich stabilnej konfiguracji elektronowej.",
                            "target_lang_translations": {
                                "ru": "Высокая химическая <w>инертность</w> благородных газов обусловлена их стабильной электронной конфигурацией."
                            }
