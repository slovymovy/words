                        "form": "die Exfoliation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                        "entry_id": "22a511a7-2f9a-3f39-bc96-f082f56667e3",
                        "glosses": [
                            "oberflächige, großflächige Abblätterung, Abstoßung abgestorbener Teile der Haut oder Schleimhaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7aef2da-db63-4f34-aa78-4db7de93f1e2",
                                "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                                "text": "Bläschenbildung und Exfoliation des Epithels am harten Gaumen waren häufig zu konstatieren."
                            },
                            {
                                "example_id": "03e13fb5-995f-49f7-81ef-1599cddf37f2",
                                "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                                "text": "Durch Exfoliation beziehungsweise Peeling wird die Hauttönung gleichmäßiger, weil überschüssige Hautschüppchen von der Oberfläche entfernt werden."
                            },
                            {
                                "example_id": "6fc9c4cd-849f-41cb-8ef5-619601450994",
                                "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                                "text": "Ist das Cranium entblößt, so soll man es mit einem pfriemenförmigen Instrumente oder dem Perforativtrepan siebartig bis zur Diploe durchbohren, um einerseits die Exfoliation zu verhüten, anderseits im Wege der aus den Löchern sprossenden Gefäße die Neuformation des Pericraniums anzuregen."
                            },
                            {
                                "example_id": "3e002b1c-5b0e-4aa6-9f43-c18967fd3681",
                                "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                                "text": "An Fingern und Händen bestanden starke Exfoliation und Fissuren, Bläschenbildung war nicht vorhanden, die Fingernägel waren normal."
                            },
                            {
                                "example_id": "03e6bfd6-0698-4dc7-99ab-fcccffdf7f6e",
                                "sense_id": "c32e4f55-d88d-32f4-8375-cba6e3145c9f",
                                "text": "Klinisch wird die Entwicklung einer Exfoliation beobachtet, die sich zu schweren Ulzerationen und sogar Karzinombildung steigern kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                        "entry_id": "22a511a7-2f9a-3f39-bc96-f082f56667e3",
                        "glosses": [
                            "Ablösung großer, ebener oder gebogener Gesteinsplatten von der darunter befindlichen Gesteinsmasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dcb1018-e4f1-4c87-97a4-75904300af4b",
                                "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                                "text": "Bei der Entstehung dieser \"Andesit-Rose\" wirkte einerseits der Prozess der Exfoliation, der plattige Absonderung aufgrund von Druckentlastung entstehen ließ."
                            },
                            {
                                "example_id": "41f2c7b9-77d0-4a5d-a7c0-c7f42dfd3b9b",
                                "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                                "text": "Exfoliation ist besonders häufig in Graniten entwickelt, wo sie zu rundlichen und domartigen Oberflächenstrukturen führt."
                            },
                            {
                                "example_id": "62d0c554-3180-4ee8-90a0-422b09de1eb1",
                                "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                                "text": "Druckentlastung: Frei liegende Magmatite brechen infolge von Druckentlastung – auch Abschalung oder Exfoliation genannt – auseinander."
                            },
                            {
                                "example_id": "44c250b7-92f3-4ba1-be37-64ff5641a48e",
                                "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                                "text": "Die Exfoliation ist für Wärmeküsten charakteristisch sowie auch für andere Gebiete mit starken täglichen Temperaturschwankungen."
                            },
                            {
                                "example_id": "0724a1f3-4e28-46e2-ba64-ce6d15479c29",
                                "sense_id": "336721b7-a0d0-3da9-a85f-dbe8e979e016",
                                "text": "Des Weiteren unterschied man zwischen physikalischer (mechanischer) Exfoliation durch Insolation und spheroidaler Verwitterung durch chemische Prozesse wie Hydration."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
