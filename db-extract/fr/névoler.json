                "senses": [
                    {
                        "sense_id": "ee9914af-1388-3bb0-8d70-5d2b216f0b2f",
                        "entry_id": "bfd78da8-b00a-3fa4-9803-62290cf84cf5",
                        "glosses": [
                            "Neigeoter."
                        ],
                        "tags": [
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "3e15af26-f0e6-4358-9e8e-31419985033a",
                                "sense_id": "ee9914af-1388-3bb0-8d70-5d2b216f0b2f",
                                "text": "Enfin, la première partie de la matinée est faite, je vais pouvoir aller me réchauffer et « casser la croûte », mais avant, il faut prendre une « fascine », et un « goiryon » de « fayard » dans le « gabion » en prévision pour demain…….car il continue « à névoler », « charogne » de temps, « bongla de bongla », c’est pas « d’main » qu’on verra des « coucous » !"
                            },
                            {
                                "example_id": "c7f053b1-b340-465d-9930-1b1dd82ed557",
                                "sense_id": "ee9914af-1388-3bb0-8d70-5d2b216f0b2f",
                                "text": "Ah voici qu'il se met à floconner, à pelucher, à névoler, selon qu'on soit lorrain, lyonnais ou savoyard."
                            }
                        ]
                    }
