                "senses": [
                    {
                        "sense_id": "87b8855c-15d5-39a2-aca5-3e65b8b391c5",
                        "entry_id": "2f0cc1aa-2b38-3139-93b8-de607004697b",
                        "glosses": [
                            "een apparaat waarin een vloeistof geheel of gedeeltelijk verdampt, middels toevoer van warmte of door het verminderen van de druk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e38117-afd6-4b93-b908-d91545d83c5e",
                                "sense_id": "87b8855c-15d5-39a2-aca5-3e65b8b391c5",
                                "text": "Een airconditioner zuigt warme lucht naar binnen en leidt deze over een koude verdamper. Hierop condenseert de warme lucht en daarna wordt koelere en drogere lucht de ruimte in geblazen."
                            },
                            {
                                "example_id": "5a17eb48-3dea-48af-b7f3-26db550ddf3e",
                                "sense_id": "87b8855c-15d5-39a2-aca5-3e65b8b391c5",
                                "text": "Het kwaad geschiedt op de verdamper, waar het koel, vochtig en donker is en zodoende een prima verblijfplaats voor bacteriën en schimmels. Door de airco vijf tot tien minuten voor het verlaten van de auto uit te zetten, droogt de verdamper door de rijwind en verdwijnt de condens uit het systeem."
                            },
                            {
                                "example_id": "97454f69-941d-4bdf-a490-81b3ab361879",
                                "sense_id": "87b8855c-15d5-39a2-aca5-3e65b8b391c5",
                                "text": "Het grote probleem is de dosis die vrijkomt in het toestelletje. Dat gebeurt met een verdamper die wordt aangestuurd door een elektronisch circuit, dat zo is ontworpen dat het aantal inhalaties wordt beperkt. ‘Als het systeempje niet goed functioneert, kan een foute dosis vrijkomen', waarschuwt Eeckhout."
                            }
                        ]
                    }
                ],
