{
    "word_family": [
        "slovenly",
        "slobber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b48918ef-56dd-35ad-8bd6-9af0313a8fa3",
                    "sense_definition": "A person who is lazy, untidy, or careless in their personal appearance and habits.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lazy_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>slob</w> that he never cleans his apartment or does his laundry.",
                            "target_lang_translations": {
                                "pl": "To taki <w>bałaganiarz</w>, że nigdy nie sprząta mieszkania ani nie robi prania."
                            }
                        },
                        {
                            "text": "Stop acting like a <w>slob</w> and put on some clean clothes for the dinner party.",
                            "target_lang_translations": {
                                "pl": "Przestań zachowywać się jak <w>flejtuch</w> i załóż czyste ubranie na przyjęcie."
                            }
                        }
                    ],
                    "synonyms": [
                        "slacker",
                        "mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and often derogatory term."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba leniwa, niechlujna lub niedbała w swoim wyglądzie i nawykach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bałaganiarz",
                                "target_lang_sense_clarification": "osoba (zazwyczaj mężczyzna) robiąca bałagan, niechlujna"
                            },
                            {
                                "target_lang_word": "bałaganiara",
                                "target_lang_sense_clarification": "osoba (zazwyczaj kobieta) robiąca bałagan, niechlujna"
                            },
                            {
                                "target_lang_word": "flejtuch",
                                "target_lang_sense_clarification": "osoba bardzo niechlujna, zaniedbana"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dcaf584-0492-3ee3-9088-08da8dddf9d8",
                    "sense_definition": "To behave in a lazy, idle, or untidy manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lazy_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the entire weekend <w>slobbing</w> on the couch watching old movies.",
                            "target_lang_translations": {
                                "pl": "Cały weekend <w>obijałem się</w> na kanapie, oglądając stare filmy."
                            }
                        },
                        {
                            "text": "After working hard all week, he just wanted to <w>slob</w> around the house on Sunday.",
                            "target_lang_translations": {
                                "pl": "Po ciężkim tygodniu pracy chciał w niedzielę po prostu <w>leniuchować</w> w domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "lounge",
                        "loaf"
                    ],
                    "common_phrases": [
                        "slob around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zachowywać się w sposób leniwy, próżniaczy lub niechlujny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obijać się",
                                "target_lang_sense_clarification": "leniuchować, nic nie robić"
                            },
                            {
                                "target_lang_word": "leniuchować",
                                "target_lang_sense_clarification": "spędzać czas na lenistwie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5c926c-cda8-328f-949a-c3d38f53f4a2",
                    "sense_definition": "To drool or let saliva flow from the mouth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>slobbing</w> all over the floor while waiting for his food.",
                            "target_lang_translations": {
                                "pl": "Pies <w>ślinił się</w> na całą podłogę, czekając na jedzenie."
                            }
                        },
                        {
                            "text": "The baby was <w>slobbing</w> on his toy as he started to teeth.",
                            "target_lang_translations": {
                                "pl": "Dziecko <w>śliniło</w> swoją zabawkę, bo zaczęło ząbkować."
                            }
                        }
                    ],
                    "synonyms": [
                        "drool",
                        "slobber"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ślinić się lub pozwalać ślinie wypływać z ust."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ślinić się",
                                "target_lang_sense_clarification": "wydzielać ślinę z ust"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17fa324e-d38e-3ce2-b37c-0476d061bb2a",
                    "sense_definition": "To move in a slow, heavy, or awkward way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hiker <w>slobbed</w> along the trail, barely lifting his heavy boots.",
                            "target_lang_translations": {
                                "pl": "Zmęczony wędrowiec <w>wlekł się</w> szlakiem, ledwo podnosząc ciężkie buty."
                            }
                        },
                        {
                            "text": "He <w>slobbed</w> down the hallway, clearly exhausted after the long shift.",
                            "target_lang_translations": {
                                "pl": "Szedł <w>wlekąc się</w> korytarzem, wyraźnie wyczerpany po długiej zmianie."
                            }
                        }
                    ],
                    "synonyms": [
                        "trudge",
                        "lumber"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszać się w powolny, ciężki lub niezgrabny sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wlec się",
                                "target_lang_sense_clarification": "iść powoli, z trudem"
                            },
                            {
                                "target_lang_word": "tupotać",
                                "target_lang_sense_clarification": "iść ciężko, stawiając głośne kroki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfe01e0c-d15f-301d-bc21-9eb74e729045",
                    "sense_definition": "To spill or splatter a liquid or messy substance onto something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>slob</w> paint on the new carpet while you work.",
                            "target_lang_translations": {
                                "pl": "Uważaj, żeby nie <w>zachlapać</w> farbą nowego dywanu podczas pracy."
                            }
                        },
                        {
                            "text": "He accidentally <w>slobbed</w> mud all over his clean shirt while walking outside.",
                            "target_lang_translations": {
                                "pl": "Przypadkowo <w>zachlapał</w> błotem całą czystą koszulę, spacerując na zewnątrz."
                            }
                        }
                    ],
                    "synonyms": [
                        "spatter",
                        "splatter"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozlać lub zachlapać coś płynem lub brudną substancją."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zachlapać",
                                "target_lang_sense_clarification": "pokryć coś plamami płynu"
                            },
                            {
                                "target_lang_word": "pobrudzić",
                                "target_lang_sense_clarification": "uczynić coś brudnym przez rozlanie substancji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}