                "senses": [
                    {
                        "sense_id": "010af3fb-92a1-3fa6-b0c0-61bce2cfbdbf",
                        "entry_id": "fa12076d-a005-3d3c-9201-77fe24902ab8",
                        "glosses": [
                            "выделяемый оболочкой, выстилающей внутренние полости тела (брюшины, плевры и т.п.), для увлажнения этих частей тела"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd97a062-41dc-4b87-9efc-c10b827869d1",
                                "sense_id": "010af3fb-92a1-3fa6-b0c0-61bce2cfbdbf",
                                "text": "Серозные полости (грудная, брюшная)."
                            },
                            {
                                "example_id": "5500248c-76fa-4c5c-8cad-95e2219855e8",
                                "sense_id": "010af3fb-92a1-3fa6-b0c0-61bce2cfbdbf",
                                "text": "Серозные оболочки (покрывающие внутреннюю поверхность серозных полостей)."
                            },
                            {
                                "example_id": "a5179fef-91a7-4553-93b4-22fc2468cac8",
                                "sense_id": "010af3fb-92a1-3fa6-b0c0-61bce2cfbdbf",
                                "text": "Серозные железы - некоторые железы в полости рта и др. частях организма."
                            }
                        ]
                    },
                    {
                        "sense_id": "74a46505-3c23-3e2d-a878-1dfd98a98f0b",
