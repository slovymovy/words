                    {
                        "sense_id": "8c2c9911-4874-34ff-b3a8-b9ed6f54cbac",
                        "entry_id": "c69ea79b-8c42-3222-b5c8-61e72cbc47d4",
                        "glosses": [
                            "Tournage d'un film."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c564ab-f4b0-488b-b786-a3d117170de3",
                                "sense_id": "8c2c9911-4874-34ff-b3a8-b9ed6f54cbac",
                                "text": "Après ce début laborieux, le filmage se passe facilement et j’obtiens rapidement deux ou trois belles prises musicales, émouvantes."
                            },
                            {
                                "example_id": "44fa852d-8e3e-49cc-b97f-6ec6dae97465",
                                "sense_id": "8c2c9911-4874-34ff-b3a8-b9ed6f54cbac",
                                "text": "C’est dans ce contexte inquiétant que Barracuda a débusqué ce Donald Trump: The Chosen de Wilfredo Torres Jr sorti un mois avant l’élection. Production semi-amateure mais qui se prend très au sérieux, au concept millénariste aussi dément que son filmage est catastrophique et ses moyens indigents."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec5975e7-6ce3-3857-8dba-d66f830c447f",
                        "entry_id": "c69ea79b-8c42-3222-b5c8-61e72cbc47d4",
                        "glosses": [
                            "Action de filmer, de couvrir d’un film."
                        ],
                        "tags": [
                            "Logistique"
                        ],
                        "examples": [
                            {
                                "example_id": "691a3d7a-3716-461a-be82-0ec234441dda",
                                "sense_id": "ec5975e7-6ce3-3857-8dba-d66f830c447f",
                                "text": "L’absence d’équipement approprié pour le filmage manuel de palettes provoque une mise en danger, un manque d’hygiène."
                            }
                        ]
                    }
                ],
