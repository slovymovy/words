                "senses": [
                    {
                        "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                        "entry_id": "bfdcf439-0163-3c20-a642-7fc21b5df454",
                        "glosses": [
                            "Qui dilapide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39ed7816-d4a3-4412-ab7d-579d7c817e1d",
                                "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                                "text": "Ministre dilapidateur des fonds publics."
                            },
                            {
                                "example_id": "a78b47dc-6d80-455c-b214-e4ab1d30a62b",
                                "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                                "text": "Plus d’époux incommode et dilapidateur, plus de scènes, plus de retours à l’improviste, de départs qui ressemblaient à des fuites, de dépêches suspectes, d’interlocutrices invisibles qu’au téléphone on nomme « mon vieux » ou « cher monsieur »…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a7969fc3-9a77-39f0-a1b7-af5c3ca80ebf",
                "word": "dilapidateur",
