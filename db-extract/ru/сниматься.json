                        ],
                        "form": "снима́ясь"
                    },
                    {
                        "form_id": "d63f8581-788c-4955-86cc-5c65875009f0",
                        "entry_id": "d37eeb75-277d-3a76-9c49-5c8dbab53066",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "снима́вшись"
                    },
                    {
                        "form_id": "6f487662-4fe9-4dad-8a04-422f8764609f",
                        "entry_id": "d37eeb75-277d-3a76-9c49-5c8dbab53066",
