                                        "sense_id": "cc45d5b9-7186-39b6-abdc-8db018f885d6",
                                        "entry_id": "e5a99577-9885-3048-83ad-74a937ea183d",
                                        "glosses": [
                                            "A person employed to drive a private motor car or a hired car of executive or luxury class (like a limousine)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6f5e77-a0d5-4e34-becc-c02d7d331b58",
                                                "sense_id": "cc45d5b9-7186-39b6-abdc-8db018f885d6",
                                                "text": "He fell into a reverie, a most dangerous state of mind for a chauffeur, since a fall into reverie on the part of a driver may mean a fall into a ravine on the part of the machine."
                                            },
                                            {
                                                "example_id": "ec74dcff-05d7-4049-bf1a-39e6db4070de",
                                                "sense_id": "cc45d5b9-7186-39b6-abdc-8db018f885d6",
                                                "text": "Super Nintendo, Sega Genesis\nWhen I was dead broke, man, I couldn't picture this\n50-inch screen, money-green leather sofa\nGot two rides, a limousine with a chauffeur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed77c577-010f-3f8a-8b01-b5cf99e67be3",
                                        "entry_id": "e5a99577-9885-3048-83ad-74a937ea183d",
                                        "glosses": [
                                            "The driver of a fire truck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
