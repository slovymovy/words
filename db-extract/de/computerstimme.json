                "senses": [
                    {
                        "sense_id": "29773e16-17ea-399e-899c-43bff3a5bce3",
                        "entry_id": "94314265-1f69-393c-a5dc-67b70499829e",
                        "glosses": [
                            "von einem Computer erzeugte Stimme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3819be73-9524-4f51-9145-93d839743b8e",
                                "sense_id": "29773e16-17ea-399e-899c-43bff3a5bce3",
                                "text": "„Eine Computerstimme sagt ihr, dass sie etwas in Griffith Park abholen und Reverend Waynes Franchise Pearly Gates in Van Nuys zustellen soll.“"
                            },
                            {
                                "example_id": "9646bffa-4560-402c-9cc4-ab1e12d209df",
                                "sense_id": "29773e16-17ea-399e-899c-43bff3a5bce3",
                                "text": "„Die Computerstimme verriet ihm, dass sein Zimmer vorbereitet war, und nannte ihm die genaue Adresse.“"
                            },
                            {
                                "example_id": "6795aae9-f87b-47f1-8305-fbd62664bb01",
                                "sense_id": "29773e16-17ea-399e-899c-43bff3a5bce3",
                                "text": "„Sie vermutete, dass wahrscheinlich ein Sensor mit Luckys Kehlkopf verbunden war; er nahm die Lautäußerungen des Drachen auf, glich sie mit Ben Patricks Datenbank der bekannten Drachenlaute ab und schickte die Übersetzung dann in Form einer Computerstimme an CJs Headset.“"
                            }
                        ],
