                        "sense_id": "e20c690c-a3e0-3a13-b35f-043181b20707",
                        "entry_id": "5ecfab8d-dd7d-3076-8a12-d50c52fd0704",
                        "glosses": [
                            "Discordance of sounds; dissonance."
