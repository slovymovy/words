                        "glosses": [
                            "berittene Flurprozession in Erinnerung an den Heiligen Georg, bei der die Pferde gesegnet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71b3b68-9cda-445b-9794-94add94b8588",
                                "sense_id": "c75140b8-2a3c-3338-83b6-9d846313d4a6",
                                "text": "„Die Hauptsache ist der „Georgiritt“. Ohne Sattel und Bügel schwingen sich die jungen Burschen auf ihre besten Pferde und sprengen in vollem Laufe, feierlich jauchzend dreimal um die Kapelle.“"
                            }
                        ],
