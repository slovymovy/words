{
    "word_family": [
        "academy",
        "academia",
        "academically",
        "academician"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "75c3e834-3395-3273-abcc-789fa27eede6",
                    "sense_definition": "Relating to schools, colleges, and universities, or connected with studying and thinking rather than practical skills.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "education_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>academic</w> year usually begins in late August or early September.",
                            "target_lang_translations": {
                                "ru": "<w>Учебный</w> год обычно начинается в конце августа или начале сентября.",
                                "zh": "<w>学年</w>通常在八月下旬或九月初开始。"
                            }
                        },
                        {
                            "text": "She has achieved great <w>academic</w> success during her time at the university.",
                            "target_lang_translations": {
                                "ru": "Она добилась больших <w>академических</w> успехов за время учебы в университете.",
                                "zh": "她在大学期间取得了巨大的<w>学术</w>成就。"
                            }
                        }
                    ],
                    "synonyms": [
                        "educational",
                        "scholarly",
                        "collegiate",
                        "pedagogical",
                        "scholastic"
                    ],
                    "antonyms": [
                        "vocational",
                        "practical",
                        "technical"
                    ],
                    "common_phrases": [
                        "academic year",
                        "academic achievement",
                        "academic performance",
                        "academic career",
                        "academic standards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к учебным заведениям (школам, университетам) или к процессу обучения, в отличие от практических навыков.",
                        "zh": "与学校、学院和大学有关的，或与学习和思考而非实际技能相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учебный",
                                "target_lang_sense_clarification": "относящийся к процессу обучения"
                            },
                            {
                                "target_lang_word": "академический",
                                "target_lang_sense_clarification": "относящийся к академии или университету"
                            },
                            {
                                "target_lang_word": "университетский",
                                "target_lang_sense_clarification": "связанный с университетом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学术的",
                                "target_lang_sense_clarification": "指与学术研究或高等教育相关的"
                            },
                            {
                                "target_lang_word": "学校的",
                                "target_lang_sense_clarification": "指与学校教育相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b0818ae-6b18-36a3-996b-b0af46d859c2",
                    "sense_definition": "Good at studying and getting high grades in school; having an aptitude for learning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aptitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is not very <w>academic</w>, but he is extremely talented at art and design.",
                            "target_lang_translations": {
                                "ru": "Он не очень <w>склонен к наукам</w>, но чрезвычайно талантлив в искусстве и дизайне.",
                                "zh": "他不太<w>擅长学习</w>，但在艺术和设计方面极具天赋。"
                            }
                        },
                        {
                            "text": "The school looks for students with high <w>academic</w> ability and a desire to learn.",
                            "target_lang_translations": {
                                "ru": "Школа ищет учеников с высокими <w>академическими</w> способностями и желанием учиться.",
                                "zh": "学校寻找具有高<w>学术</w>能力和学习欲望的学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "studious",
                        "intellectual",
                        "bookish"
                    ],
                    "antonyms": [
                        "unacademic"
                    ],
                    "common_phrases": [
                        "academic ability",
                        "academic potential",
                        "highly academic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный к учебе, легко усваивающий знания и получающий высокие оценки.",
                        "zh": "擅长学习并在学校取得高分；有学习天赋的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способный к учебе",
                                "target_lang_sense_clarification": "об ученике или студенте"
                            },
                            {
                                "target_lang_word": "склонный к наукам",
                                "target_lang_sense_clarification": "имеющий интерес к академическим дисциплинам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有学术天赋的",
                                "target_lang_sense_clarification": "指在学习方面有潜力的"
                            },
                            {
                                "target_lang_word": "擅长学习的",
                                "target_lang_sense_clarification": "指学习成绩优异的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e9ccb46-31cc-3a04-91ee-34bb64656f99",
                    "sense_definition": "Theoretical and not related to practical effects in real life; having no practical importance or relevance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "theoretical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The question of who would win the match is purely <w>academic</w> since it has been cancelled.",
                            "target_lang_translations": {
                                "ru": "Вопрос о том, кто выиграет матч, чисто <w>теоретический</w>, так как он был отменен.",
                                "zh": "关于谁会赢得比赛的问题纯属<w>理论上的</w>，因为比赛已经被取消了。"
                            }
                        },
                        {
                            "text": "His interest in the legal argument was strictly <w>academic</w> rather than personal.",
                            "target_lang_translations": {
                                "ru": "Его интерес к юридическому спору был сугубо <w>теоретическим</w>, а не личным.",
                                "zh": "他对这一法律论点的兴趣纯粹是<w>学术上的</w>，而非个人兴趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "theoretical",
                        "hypothetical",
                        "speculative",
                        "abstract"
                    ],
                    "antonyms": [
                        "practical",
                        "realistic",
                        "pragmatic"
                    ],
                    "common_phrases": [
                        "purely academic",
                        "academic question",
                        "academic interest",
                        "academic exercise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теоретический, не имеющий практического применения или значения в реальной жизни.",
                        "zh": "理论上的，与现实生活中的实际效果无关；没有实际重要性或关联。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теоретический",
                                "target_lang_sense_clarification": "оторванный от практики"
                            },
                            {
                                "target_lang_word": "умозрительный",
                                "target_lang_sense_clarification": "абстрактный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理论上的",
                                "target_lang_sense_clarification": "指仅存在于理论中，无实际意义"
                            },
                            {
                                "target_lang_word": "空谈的",
                                "target_lang_sense_clarification": "指脱离实际的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad5836ec-7e8c-3816-bd5a-7bf0b9e0d0ab",
                    "sense_definition": "A teacher or scholar in a college or university.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>academics</w> spend their summers conducting research and writing papers.",
                            "target_lang_translations": {
                                "ru": "Многие <w>преподаватели вузов</w> проводят лето, занимаясь исследованиями и написанием статей.",
                                "zh": "许多<w>学者</w>利用暑假进行研究和撰写论文。"
                            }
                        },
                        {
                            "text": "She is a leading <w>academic</w> in the field of marine biology.",
                            "target_lang_translations": {
                                "ru": "Она ведущий <w>ученый</w> в области морской биологии.",
                                "zh": "她是海洋生物学领域的顶尖<w>学者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scholar",
                        "lecturer",
                        "professor",
                        "educator",
                        "researcher"
                    ],
                    "common_phrases": [
                        "leading academic",
                        "senior academic",
                        "visiting academic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преподаватель или ученый, работающий в университете или колледже.",
                        "zh": "大学或学院的教师或学者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преподаватель вуза",
                                "target_lang_sense_clarification": "сотрудник университета"
                            },
                            {
                                "target_lang_word": "ученый",
                                "target_lang_sense_clarification": "занимающийся научной деятельностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学者",
                                "target_lang_sense_clarification": "指从事学术研究的人"
                            },
                            {
                                "target_lang_word": "大学教师",
                                "target_lang_sense_clarification": "指在高校任教的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d357651d-0cb7-395f-9530-53c23e5a65cb",
                    "sense_definition": "The subjects studied at a school or college, or the work done by students.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "studies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs to focus on his <w>academics</w> if he wants to get into a good university.",
                            "target_lang_translations": {
                                "ru": "Ему нужно сосредоточиться на <w>учебе</w>, если он хочет поступить в хороший университет.",
                                "zh": "如果他想进入一所好大学，就需要专注于自己的<w>学业</w>。"
                            }
                        },
                        {
                            "text": "The athlete struggled to balance sports and <w>academics</w> during the busy season.",
                            "target_lang_translations": {
                                "ru": "Спортсмену было трудно совмещать спорт и <w>учебу</w> в разгар сезона.",
                                "zh": "这名运动员在繁忙的赛季中很难平衡体育运动和<w>学业</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "studies",
                        "coursework",
                        "schoolwork"
                    ],
                    "common_phrases": [
                        "focus on academics",
                        "struggle with academics"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учебные предметы, изучаемые в учебном заведении, или учебная деятельность студентов.",
                        "zh": "在学校或学院学习的科目，或学生所做的学习工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учеба",
                                "target_lang_sense_clarification": "процесс обучения"
                            },
                            {
                                "target_lang_word": "занятия",
                                "target_lang_sense_clarification": "учебные дисциплины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学业",
                                "target_lang_sense_clarification": "指学习任务或课程"
                            },
                            {
                                "target_lang_word": "学习",
                                "target_lang_sense_clarification": "指学生的课业活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}