                "forms": [],
                "senses": [
                    {
                        "sense_id": "87079134-a7d3-333e-9ffc-54f43cb11ba1",
                        "entry_id": "e5717223-b6d8-31e0-b09e-f2d31a392deb",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fcf001-29a6-4287-b8e7-2247e2ac0096",
                                "sense_id": "87079134-a7d3-333e-9ffc-54f43cb11ba1",
                                "text": "Une partie des dons est confiée à d’autres associations ou recyclée par TriEthic, précise Emmanuelle Julot, qui gère la boutique, accueille et aide les visiteurs à trouver la perle rare."
                            }
                        ]
                    },
                    {
                        "sense_id": "38cd650a-6779-32a4-893b-cc37fad0c307",
                        "entry_id": "e5717223-b6d8-31e0-b09e-f2d31a392deb",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d304da2c-9520-4584-98a3-05855b59568d",
                                "sense_id": "38cd650a-6779-32a4-893b-cc37fad0c307",
                                "text": "Elle avait pour aides immédiats Julot, natif de Miremont, qui commençait à se former au service, et Anille, jolie fillette de l’Isle-Adam, qui regardait Paris de loin comme les Hébreux rêvaient la terre promise."
                            }
                        ]
                    }
                ],
