                    {
                        "sense_id": "53a1a2a4-8432-3347-9523-4e89aea03f88",
                        "entry_id": "77bfcb88-fcb9-3fb1-9edc-abcf5866eab8",
                        "glosses": [
                            "Any of a group of wheel-shaped viruses, of the genus Rotavirus, that causes gastroenteritis and diarrhea in children and animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b29087-9ffb-4296-a71e-e3a5e8e6caa9",
                                "sense_id": "53a1a2a4-8432-3347-9523-4e89aea03f88",
                                "text": "We propose therefore that these reovirus-like or orbivirus-like enteritis viruses of calves and children are in a group separate from both orbiviruses and reoviruses, and we suggest that the term “rotavirus” (from the Latin rota, a wheel) should be used for them."
                            }
                        ]
                    }
                ],
