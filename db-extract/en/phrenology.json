    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a23a4bbd-d151-377b-96b2-9df3b1688714",
                "word": "phrenology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6619afda-399a-49ce-8be5-bc8fb38f1233",
                        "entry_id": "a23a4bbd-d151-377b-96b2-9df3b1688714",
                        "tags": [
                            "plural"
                        ],
                        "form": "phrenologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "297e810e-e3a7-39b9-b81f-5218b570b531",
                        "entry_id": "a23a4bbd-d151-377b-96b2-9df3b1688714",
                        "glosses": [
                            "The pseudoscience which studies the relationships between a person's character and the morphology (structure) of the skull."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7af84658-00e0-476c-86f3-118e517092e4",
                                "sense_id": "297e810e-e3a7-39b9-b81f-5218b570b531",
                                "text": "Phrenology was the practice of correlating bumps on a skull with mental powers and attributes of character."
                            },
                            {
                                "example_id": "706f437f-2703-4f5b-9b26-34bd7014fbb7",
                                "sense_id": "297e810e-e3a7-39b9-b81f-5218b570b531",
                                "text": "Phrenology involves feeling the bumps in the skull to determine an individual's psychological attributes."
                            },
                            {
                                "example_id": "dfc49dcc-aedd-4d91-bd72-414b88bc9f7d",
                                "sense_id": "297e810e-e3a7-39b9-b81f-5218b570b531",
                                "text": "MR. BURNS: Who could forget such a monstrous visage? She has the sloping brow and cranial bumpage of the career criminal.\n MR. SMITHERS: Uh, sir, phrenology was dismissed as quackery 160 years ago."
                            },
                            {
                                "example_id": "97ef1259-c301-4ca1-baa8-6f16340751c3",
                                "sense_id": "297e810e-e3a7-39b9-b81f-5218b570b531",
                                "text": "One significance weakness of phrenology in the eyes of most anatomists, as Anne Harrington has shown, was that the brain comprised two structurally identical cerebral hemispheres, separated by a longitudinal fissure, whereas phrenologists held that the material sub-stratum of various mental faculties was located in only one hemisphere, and not its twin."
                            }
                        ]
                    }
                ],
