                "senses": [
                    {
                        "sense_id": "5dc7c3f1-5a0d-32ee-8c25-3ce84a5ee839",
                        "entry_id": "7ad475b2-d76f-36b6-a6d9-63ddea6b4fce",
                        "glosses": [
                            "Enlever la chevelure de quelqu’un (en tant que châtiment)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a5dd741-9086-452c-aa6f-33b571839ebf",
                                "sense_id": "5dc7c3f1-5a0d-32ee-8c25-3ce84a5ee839",
                                "text": "La même loi montre également que les propriétaires wisigoths étaient parfois surpris à décalver les esclaves de leurs voisins, ce qui n’entraînait généralement qu’une sanction financière."
                            },
                            {
                                "example_id": "bcd66caf-4508-4d43-94fa-199de0033ac6",
                                "sense_id": "5dc7c3f1-5a0d-32ee-8c25-3ce84a5ee839",
                                "text": "Mais si cela se répète, il sera une seconde fois décalvé, recevra encore 100 coups, ses biens seront confisqués, et il sera enfermé pour toujours."
                            }
                        ]
                    }
