                        "examples": [
                            {
                                "example_id": "d6a25bbd-6278-41ee-99e6-b3e10540ccc8",
                                "sense_id": "00a47e71-ad2e-3956-b194-4e8e57f6261a",
                                "text": "L’orge : présentant un index glycémique particulièrement bas pour une céréale, l’orge mondé (c’est-à-dire l’orge « complet », par opposition à l’orge perlé qui désigne l’orge raffiné) donne une farine intéressante pour les personnes diabétiques ou surveillant leur poids."
                            }
                        ]
                    }
