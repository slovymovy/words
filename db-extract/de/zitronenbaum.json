                ],
                "translations": [
                    {
                        "translation_id": "cde74506-3f75-49fd-9806-a1e4988fc011",
                        "source_entry_id": "7db900f7-1421-3df8-9009-5b2b548f9aae",
                        "source_sense_id": "2efba1cb-e152-338d-804b-42d9085be38c",
                        "source_sense_description": "Botanik: halbtropischer, immergrüner Baum (Wissenschaftlicher Name: Citrus limon)",
                        "target_lang_word": "lemon tree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3f6127ba-a263-4b93-88a3-0eab1b81540e",
                        "source_entry_id": "7db900f7-1421-3df8-9009-5b2b548f9aae",
                        "source_sense_id": "2efba1cb-e152-338d-804b-42d9085be38c",
                        "source_sense_description": "Botanik: halbtropischer, immergrüner Baum (Wissenschaftlicher Name: Citrus limon)",
                        "target_lang_word": "citronnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citronnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                        "entry_id": "286d8f98-4ce1-3af7-ae08-326454b5bc0f",
                                        "glosses": [
                                            "Petit arbre originaire du nord de l’Inde, à feuilles persistantes, qui fleurit et donne des fruits pendant toute l’année, et qui est cultivé pour son fruit, le citron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe8055f-cb89-4183-b818-6df0897141a6",
                                                "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                                "text": "Il est bon de noter que les orangistes greffent plus d’orangers sur citronnier que sur bigaradier, parce que le citronnier pousse plus vite et grandit davantage dans sa jeunesse; mais le bigaradier le dépasse à son tour quelques années après, et pour toujours ; il fait un arbre plus solide, plus fort, et, comme sujet, mérite la préférence sur le citronnier, qui, d’ailleurs, est sujet à une maladie mortelle à l'âge de cinq à dix ans."
                                            },
                                            {
                                                "example_id": "86005f2f-e677-4cee-adbd-86cea0bb382d",
                                                "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                                "text": "Aux côtés des fiers palmiers se dévoilent quantités de parfums : bouquets d’agrumes, géraniums flamboyants, senteurs de pain d’épices et de miel de l’héliotrope, effluves d’ananas et de sauge, odeurs de fleurs d’oranger, de citronnier, de mandarinier, de verveine citronnée."
                                            },
                                            {
                                                "example_id": "62e70b5e-682f-4084-8183-54d85382a8eb",
                                                "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                                "text": "Le citronnier, d’origine indienne, est introduit par les Arabes dans le monde méditerranéen vers le IXᵉ siècle de notre ère et l’oranger doux beaucoup plus tard, vers le XIVᵉ ou le XVᵉ siècle."
                                            },
                                            {
                                                "example_id": "19501b26-1f9f-4d33-bad0-c77ae6628eb7",
                                                "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                                "text": "Appartenant à la famille des rutacées, le genre citrus, né en Sud-Est asiatique, est à l’origine des quatre espèces (mandariniers, pamplemoussiers, cédratiers et un papeda) les plus courantes sur nos étals : orangers, citronniers, limettiers et pomelos."
                                            },
                                            {
                                                "example_id": "c731db9e-4170-4df1-a9c5-c1c13ad854d0",
                                                "sense_id": "d0c7a906-6e43-3483-960f-85c3836eac91",
                                                "text": "Les fleurs des myrtes et des citronniers peuvent donner des rêves bien sombres…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd8b20d-422c-3e0b-bce6-d7e113d1648a",
                                        "entry_id": "286d8f98-4ce1-3af7-ae08-326454b5bc0f",
                                        "glosses": [
                                            "Bois de cet arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f67743-b728-45f1-b541-62d7a035e6c9",
                                                "sense_id": "5dd8b20d-422c-3e0b-bce6-d7e113d1648a",
                                                "text": "MM. Leuwen trouvèrent Son Excellence fort occupée à mettre en ordre, sur un bureau de citronnier chargé de ciselures de mauvais goût, trois ou quatre cents lettres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e1959a9-b8a4-427d-a3ed-f40c2b20299f",
                        "source_entry_id": "7db900f7-1421-3df8-9009-5b2b548f9aae",
                        "source_sense_id": "2efba1cb-e152-338d-804b-42d9085be38c",
                        "source_sense_description": "Botanik: halbtropischer, immergrüner Baum (Wissenschaftlicher Name: Citrus limon)",
                        "target_lang_word": "лимон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лимон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a633ba52-fe6b-3cbe-b363-ddddbf9b12b0",
                                        "entry_id": "f38d35c4-438b-333b-8544-6045c5aa3e69",
                                        "glosses": [
                                            "ботан. гибридное окультуренное субтропическое вечнозелёное цитрусовое дерево семейства рутовых с жёлтыми, кислого вкуса плодами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a31d6b-fdf7-49a5-8125-80cffbb41579",
                                                "sense_id": "a633ba52-fe6b-3cbe-b363-ddddbf9b12b0",
                                                "text": ".. И благовонная катилася роса // На мирту, на лимон, на всяки древеса .."
                                            },
                                            {
                                                "example_id": "37ae8c79-268e-4e31-9b13-51b145f2d4c1",
                                                "sense_id": "a633ba52-fe6b-3cbe-b363-ddddbf9b12b0",
                                                "text": "Кипарисы, лавры, лимоны, кофе, дикий виноград, азалия, смоковница пестрели то темно-зелеными и гладкими, словно полированными листами, то нежной перистой зеленью ласкали глаз."
                                            },
                                            {
                                                "example_id": "75e0629c-7e6d-4b32-a824-0052f584a40b",
                                                "sense_id": "a633ba52-fe6b-3cbe-b363-ddddbf9b12b0",
                                                "text": "И чувство томящей печали охватило меня, когда я сходил вдоль малахитовых перил дворца Разумовских в сплошной аллее лимонов и лавров, наполняющих воздух своими крепкими и сладостными искурениями, но словно замыкающих блистанье и круженье празднества в глубокий траур своей темной листвы."
                                            },
                                            {
                                                "example_id": "fc1bc35c-d821-4413-b6a6-d74d727003ed",
                                                "sense_id": "a633ba52-fe6b-3cbe-b363-ddddbf9b12b0",
                                                "text": "Цитрусовые растения, особенно лимоны, плохо переносят холод."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac807fa-64d3-3a57-929b-6215e325cefe",
                                        "entry_id": "f38d35c4-438b-333b-8544-6045c5aa3e69",
                                        "glosses": [
                                            "ботан. плод такого дерева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11510e9c-f55a-4602-b11c-2f0c89be335c",
                                                "sense_id": "aac807fa-64d3-3a57-929b-6215e325cefe",
                                                "text": ".. зреет персик и лимон // На берегу Гвадалкивира .."
                                            },
                                            {
                                                "example_id": "34deb499-9d80-4a7f-b202-b54aeb31dc0c",
                                                "sense_id": "aac807fa-64d3-3a57-929b-6215e325cefe",
                                                "text": ".. Матвей сидел в буфете, пил чай с лимоном .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d64e4d-04d2-3752-903e-9f909753fd4f",
                                        "entry_id": "f38d35c4-438b-333b-8544-6045c5aa3e69",
                                        "glosses": [
                                            "древесина такого дерева"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
