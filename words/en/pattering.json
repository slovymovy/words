{
    "word_family": [
        "patter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "872a68eb-400f-3eb3-b4ab-e3a3fc43f0ed",
                    "sense_definition": "The present participle and gerund of <w>patter</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain was <w>pattering</w> against the windowpane all through the night.",
                            "target_lang_translations": {
                                "ru": "Дождь всю ночь <w>барабанил</w> по оконному стеклу."
                            }
                        },
                        {
                            "text": "I could hear the <w>pattering</w> of small feet running down the hallway.",
                            "target_lang_translations": {
                                "ru": "Я слышал <w>топот</w> маленьких ножек, бегущих по коридору."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pattering of rain",
                        "pattering of feet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb patter."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола «patter», означающего издавать частые легкие звуки (стук, топот)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабанящий",
                                "target_lang_sense_clarification": "о звуке дождя или ударах по поверхности"
                            },
                            {
                                "target_lang_word": "топающий",
                                "target_lang_sense_clarification": "о звуке быстрых легких шагов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb44a0ec-de05-347b-92af-17692236942a",
                    "sense_definition": "A series of quick, light tapping sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pattering</w> on the roof grew louder as the storm intensified.",
                            "target_lang_translations": {
                                "ru": "<w>Стук</w> по крыше усиливался по мере того, как разгоралась буря."
                            }
                        },
                        {
                            "text": "She listened to the soft <w>pattering</w> of rain against the glass.",
                            "target_lang_translations": {
                                "ru": "Она прислушивалась к тихому <w>барабану</w> дождя по стеклу."
                            }
                        }
                    ],
                    "synonyms": [
                        "tapping",
                        "drumming",
                        "pitter-patter"
                    ],
                    "common_phrases": [
                        "constant pattering",
                        "soft pattering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия быстрых, легких, отрывистых звуков, напоминающих постукивание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабанная дробь",
                                "target_lang_sense_clarification": "о звуке дождя по крыше"
                            },
                            {
                                "target_lang_word": "топот",
                                "target_lang_sense_clarification": "о звуке быстрых легких шагов"
                            },
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "общий термин для легких повторяющихся звуков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}