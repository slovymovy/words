                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir fait entendre le dernier témoin, l'avocat de la défense a formellement clos sa <w>preuve</w>."
