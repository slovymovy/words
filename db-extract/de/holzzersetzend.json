                ],
                "senses": [
                    {
                        "sense_id": "c25d9b6f-bad7-3016-81ee-c4f6a48847b8",
                        "entry_id": "9b590425-6d85-3738-a566-11f2b202e85a",
                        "glosses": [
                            "Struktur von aus Zellulose und Lignin bestehendem Material (Holz) nach und nach zerstörend/auflösend"
                        ],
                        "tags": [
                            "Holzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "fd82a838-5eee-456c-823d-63074d649bab",
                                "sense_id": "c25d9b6f-bad7-3016-81ee-c4f6a48847b8",
                                "text": "„[Der Kohlenstoff] ist für die Dauer zwischen der Photosynthese und der Oxidation des Holzes durch Verbrennen oder Abbau (Veratmung) durch holzzersetzende Organismen gespeichert.“"
                            },
                            {
                                "example_id": "78aabccb-6162-4892-8984-961c653f4b5e",
                                "sense_id": "c25d9b6f-bad7-3016-81ee-c4f6a48847b8",
                                "text": "„Holzzersetzende Pilze benötigen zur enzymatischen Zersetzung der Zellwand Holzfeuchten zwischen 30-60% […]“"
                            },
                            {
                                "example_id": "1bf7d5d4-b2f5-49d9-92b1-e305aab78f5d",
                                "sense_id": "c25d9b6f-bad7-3016-81ee-c4f6a48847b8",
                                "text": "„Im unmittelbaren Bereich einer Verletzung des Holzkörpers, in dem die Zellen der Holzstrahlen absterben, kommt es so gut wie immer zu einer Besiedlung durch holzzersetzende Mikroorganismen, die meist an der Verfärbung des Holzes zu erkennen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
