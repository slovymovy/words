                                                "example_id": "77233d90-4a8d-49fa-89ee-b20d08e36a81",
                                                "sense_id": "3585db9f-8eb7-30f4-a4d1-50c0c3bd405b",
                                                "text": "Ces deux choses sont dépendantes l’une de l’autre."
                                            }
