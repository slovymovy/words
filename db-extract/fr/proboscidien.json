                        "source_sense_id": "6e11db90-c27d-31bb-8fec-0a26a49f9555",
                        "target_lang_word": "Rüsseltier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rüsseltier",
