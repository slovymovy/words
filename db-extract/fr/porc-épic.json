        "fr-extract.jsonl": [
            {
                "entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                "word": "porc-épic",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4bbae3f4-abe5-4e3a-bf07-f62f8112f0cc",
                        "entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                        "tags": [
                            "plural"
                        ],
                        "form": "porcs-épics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c341dd26-5229-37a0-a0f2-41ad57734824",
                        "entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                        "glosses": [
                            "Quadrupède rongeur des deux familles Hystridae et Erethizontidae, dont le corps est armé de piquants, qu’il dresse pour se défendre."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5db0b74b-fd06-4585-9788-6f62d28f33eb",
                                "sense_id": "c341dd26-5229-37a0-a0f2-41ad57734824",
                                "text": "Plus au sud, les chasseurs du fort poursuivaient avec succès les bisons, les élans et certains porcs-épics du Canada, dont la chair est excellente."
                            },
                            {
                                "example_id": "c3ae0eaa-ce9f-4c52-9a3a-eb6fd480a35c",
                                "sense_id": "c341dd26-5229-37a0-a0f2-41ad57734824",
                                "text": "Le porc-épic creuse de préférence son terrier dans les parois abruptes et boisées des vallées solitaires. Les indigènes le chassent principalement pour sa chair […]."
                            },
                            {
                                "example_id": "887e8e0c-b664-4fc1-968e-6ac4b938e426",
                                "sense_id": "c341dd26-5229-37a0-a0f2-41ad57734824",
                                "text": "Sa première intervention est d’ailleurs l’exposé d’une parabole déprimante empruntée à Schopenhauer. Les porcs-épics, explique le philosophe, se réchauffent en se serrant mais, à trop s’étreindre, ils se piquent. Le ton est donné : personne ne sauve personne en ce bas monde. Sauf à y laisser sa peau."
                            }
                        ]
                    },
                    {
                        "sense_id": "747c8ace-3572-3118-b392-7677a419d296",
                        "entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                        "glosses": [
                            "Meuble représentant l’animal du même nom dans les armoiries. Il est généralement représenté passant, haut sur pattes avec de longues épines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0421c4f7-ac2c-4af6-bdde-a0b811d11874",
                                "sense_id": "747c8ace-3572-3118-b392-7677a419d296",
                                "text": "D’argent au porc-épic de sable, au chef d’azur chargé de trois étoiles d’or, qui est d’Ableiges du Val-d’Oise"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a65ef743-1a4d-4988-9141-f30345469789",
                        "source_entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                        "source_sense_description": "Rongeur",
                        "target_lang_word": "Stachelschwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stachelschwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4463a25c-7f74-3af4-8bc8-401bec6e811b",
                                        "entry_id": "81256839-c136-3c04-bf69-352c5836fbf9",
                                        "glosses": [
                                            "großes Nagetier mit langen Stacheln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56354168-3e54-4c5c-83c8-1bdd446c9304",
                                                "sense_id": "4463a25c-7f74-3af4-8bc8-401bec6e811b",
                                                "text": "Seine Abwehrinstrumente richtet das Stachelschwein ab und zu auch auf, ohne dass ein Grund ersichtlich ist."
                                            },
                                            {
                                                "example_id": "d005a98d-bf74-4cd8-80aa-4988c4f3fbf4",
                                                "sense_id": "4463a25c-7f74-3af4-8bc8-401bec6e811b",
                                                "text": "„Top hatte ein Stachelschwein aufgespürt, das zwar keine Delikatesse war, mit dessen Stacheln die Pfeile aber scharfgemacht werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ab56ff2-8946-45ab-b6a9-55e007d2429f",
                        "source_entry_id": "e5f67a01-241d-3a18-8758-56a556281344",
                        "source_sense_description": "Rongeur",
                        "target_lang_word": "porcupine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcupine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21249bdf-adf4-3aff-986d-d28b6c063a6a",
                                        "entry_id": "a71098e9-3bea-3f94-9f10-7dbefa9ae090",
                                        "glosses": [
                                            "Any of several rodents of either of the taxonomic families Hystricidae (Old World porcupines) or Erethizontidae (New World porcupines), both from the infraorder Hystricognathi, noted for their sharp spines or quills, which are raised when the animal is attacked or surprised."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5303233-5c8b-4ece-a93e-92e4abe8d1da",
                                                "sense_id": "21249bdf-adf4-3aff-986d-d28b6c063a6a",
                                                "text": "In particular, porcupines, hyenas, and leopards are known in Africa to transport bones to particular places."
                                            },
                                            {
                                                "example_id": "756c1ee0-fd49-4558-b2c7-c3ea7af8486e",
                                                "sense_id": "21249bdf-adf4-3aff-986d-d28b6c063a6a",
                                                "text": "I have no evidence of grizzlies killing porcupines or vice versa. However, occasionally there is contact and sometimes a grizzly is injured or a porcupine killed, but the latter is rare."
                                            },
                                            {
                                                "example_id": "263e5757-e2c7-4f26-9ad4-87d2a3dfa544",
                                                "sense_id": "21249bdf-adf4-3aff-986d-d28b6c063a6a",
                                                "text": "Old World porcupines (Hystricidae) have quills embedded in clusters, whereas in New World porcupines (Erethizontidae) single quills are interspersed with bristles, underfur, and hair. No porcupine can throw its quills, but they detach easily and will remain embedded in an attacker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
