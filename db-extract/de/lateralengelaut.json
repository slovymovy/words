                "senses": [
                    {
                        "sense_id": "3c7bc56e-38dd-3c90-b2c5-ec9093b253da",
                        "entry_id": "4bf463dd-36ff-33ff-a394-a22cd9e9fc84",
                        "glosses": [
                            "Laut, bei dem die Luft seitlich an der Zunge entweicht"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "c23e7c37-46d2-44d0-bf27-62d370b56122",
                                "sense_id": "3c7bc56e-38dd-3c90-b2c5-ec9093b253da",
                                "text": "„Relativ gesehen ist der Lateralengelaut am häufigsten von Elisionen betroffen.“"
                            },
                            {
                                "example_id": "c69a77ef-36d4-45e0-ad50-4c35697a4361",
                                "sense_id": "3c7bc56e-38dd-3c90-b2c5-ec9093b253da",
                                "text": "„Der Lateralengelaut L nimmt eine Sonderstellung ein, da der Zungenrücken tiefer als bei den anderen Zahn-Zungen-Lauten liegt.“"
                            },
                            {
                                "example_id": "9bc22233-d4e9-4a2d-adc9-5bd8d8173580",
                                "sense_id": "3c7bc56e-38dd-3c90-b2c5-ec9093b253da",
                                "text": "„Der Lateralengelaut ‚l‘ entsteht durch das Anlegen der Zungenränder an den Gaumen.“"
                            },
                            {
                                "example_id": "6e7f14d7-155f-4c24-b8f9-1935d820e23a",
                                "sense_id": "3c7bc56e-38dd-3c90-b2c5-ec9093b253da",
                                "text": "„In einer nächsten Phase folgen die Sibilanten [s, z, ʃ] und der Lateralengelaut [l].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
