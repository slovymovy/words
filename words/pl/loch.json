    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00dfe3b7-506e-3033-951a-e1bc66331415",
                    "sense_definition": "podziemne pomieszczenie pod budowlą, często wykorzystywane jako więzienie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pomieszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym zamku odkryto mroczny <w>loch</w> pełen tajemniczych przedmiotów.",
                            "target_lang_translations": {
                                "ru": "В старом замке обнаружили мрачное <w>подземелье</w>, полное таинственных предметов."
                            }
                        },
                        {
                            "text": "Więźniowie spędzili wiele lat w ciemnym <w>lochu</w> bez dostępu do światła.",
                            "target_lang_translations": {
                                "ru": "Заключенные провели много лет в темной <w>темнице</w> без доступа к свету."
                            }
                        }
                    ],
                    "synonyms": [
                        "podziemie"
                    ],
                    "common_phrases": [
                        "ciemny loch"
                    ],
                    "target_lang_definitions": {
                        "ru": "подземное помещение под зданием, часто используемое в качестве тюрьмы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темница",
                                "target_lang_sense_clarification": "подземная тюрьма, часто в замке"
                            },
                            {
                                "target_lang_word": "подземелье",
                                "target_lang_sense_clarification": "общее название для подземных помещений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b367639b-a683-34ea-8790-caa0862631b4",
                    "sense_definition": "piwnica lub pomieszczenie gospodarcze pod ziemią",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pomieszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W chłodnym <w>lochu</w> przechowywano zapasy żywności na całą zimę.",
                            "target_lang_translations": {
                                "ru": "В холодном <w>погребе</w> хранили запасы продовольствия на всю зиму."
                            }
                        },
                        {
                            "text": "Stary <w>loch</w> pod domem służył kiedyś jako spiżarnia.",
                            "target_lang_translations": {
                                "ru": "Старый <w>подвал</w> под домом когда-то служил кладовой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "подвал или хозяйственное помещение под землей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погреб",
                                "target_lang_sense_clarification": "помещение для хранения продуктов"
                            },
                            {
                                "target_lang_word": "подвал",
                                "target_lang_sense_clarification": "нижний этаж здания"
                            }
                        ]
                    },
                    "synonyms": [
                        "piwnica"
                    ]
                },
                {
                    "sense_id": "847b1236-e2c5-35c1-8efb-9560e6c7c800",
                    "sense_definition": "forma dopełniacza liczby mnogiej słowa <w>locha</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lesie zauważono stado <w>loch</w> prowadzących swoje młode.",
                            "target_lang_translations": {
                                "ru": "В лесу заметили стадо <w>свиноматок</w>, ведущих своих детенышей."
                            }
                        },
                        {
                            "text": "Hodowca dba o odpowiednie warunki dla wszystkich <w>loch</w> w gospodarstwie.",
                            "target_lang_translations": {
                                "ru": "Фермер заботится о надлежащих условиях для всех <w>свиноматок</w> в хозяйстве."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма родительного падежа множественного числа слова «свиноматка»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свиноматок",
                                "target_lang_sense_clarification": "родительный падеж множественного числа от слова свиноматка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}