                                            {
                                                "example_id": "86c75104-0a63-4134-81c6-e1c7d1e65a2e",
                                                "sense_id": "a89a86f7-4c8c-3d11-bb3a-1063443413a9",
                                                "text": "De jongen zei tegen de dokter dat de pijn in zijn onderbuik zat."
                                            }
                                        ]
