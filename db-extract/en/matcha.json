    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ba058e00-d7aa-3897-8dc8-2eba115fcc47",
                "word": "matcha",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fa247f23-fcef-465d-921e-cbeec6b2ade8",
                        "entry_id": "ba058e00-d7aa-3897-8dc8-2eba115fcc47",
                        "tags": [
                            "plural"
                        ],
                        "form": "matchas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5cd6473-890b-3d33-a8a5-a93105dcd95f",
                        "entry_id": "ba058e00-d7aa-3897-8dc8-2eba115fcc47",
                        "glosses": [
                            "A type of powdered green tea, traditionally used in Japanese tea ceremonies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82fec324-19a4-467c-a31c-cbc180b1c435",
                                "sense_id": "a5cd6473-890b-3d33-a8a5-a93105dcd95f",
                                "text": "And that’s not all – EGCG in matcha can help improve insulin sensitivity, which aids in blood sugar control, and may help to reduce inflammation related to Alzheimer’s disease."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a9b5289-162d-413b-8d3c-099df5155465",
                        "source_entry_id": "ba058e00-d7aa-3897-8dc8-2eba115fcc47",
                        "source_sense_id": "a5cd6473-890b-3d33-a8a5-a93105dcd95f",
                        "source_sense_description": "powdered green tea for ceremonies",
                        "target_lang_word": "matcha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83f55d0f-9f88-3b60-b9ac-8ddf63c77027",
                                        "entry_id": "4e63e532-3ae7-34fc-b8fa-68be9b6c2259",
                                        "glosses": [
                                            "Poudre fine de thé vert battue et dégustée dans l’eau chaude lors de la cérémonie du thé au Japon ou comme un ingrédient alimentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6015386d-e694-4174-b95a-49dd944c0b38",
                                                "sense_id": "83f55d0f-9f88-3b60-b9ac-8ddf63c77027",
                                                "text": "L’endroit où l’on consomme principalement le matcha est le temple zen, où le visiteur reçoit généralement cette boisson."
                                            },
                                            {
                                                "example_id": "f2c0b3b1-f9d1-4034-aee3-302229387436",
                                                "sense_id": "83f55d0f-9f88-3b60-b9ac-8ddf63c77027",
                                                "text": "Le thé chic à Londres, aujourd’hui, vient du Japon, et le préféré est le matcha."
                                            },
                                            {
                                                "example_id": "84ffae01-7315-47e4-93d5-c60dbe2c3b5d",
                                                "sense_id": "83f55d0f-9f88-3b60-b9ac-8ddf63c77027",
                                                "text": "Mélangez l’huile, l’extrait de vanille et le lait, puis ajoutez la farine, le matcha tamisé, le sel et la levure et mélangez bien."
                                            },
                                            {
                                                "example_id": "2f97fbf4-a210-43c7-ac31-546195b87a80",
                                                "sense_id": "83f55d0f-9f88-3b60-b9ac-8ddf63c77027",
                                                "text": "Je suggère le kori au matcha. Nous recevons deux gigantesques ramequins remplis de granité imbibé de thé de cérémonie, sucré pour la circonstance. […]. Le vert si particulier du matcha nous envoûte pendant que nous croquons des cuillerées de glace pilée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9640dc5-0817-357c-939c-ca3558289a0e",
                                        "entry_id": "4e63e532-3ae7-34fc-b8fa-68be9b6c2259",
                                        "glosses": [
                                            "Cette couleur verte, qui tire vers le jaune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "matcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd42d78-1b92-3f13-86be-eef6c4726372",
                                        "entry_id": "509e10a2-2d04-398d-b0e5-a6d883783bdd",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de matcher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
