                                    {
                                        "sense_id": "69c4703b-7dd2-3dc7-9748-c6b58b5083dd",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A dry measure, containing four pecks, eight gallons, or thirty-two quarts; equivalent in volume to approximately 0.0364 cubic meters (imperial bushel) or 0.0352 cubic meters (U.S. bushel)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4f9110-a5b0-4fe6-bb07-5ead1d6a8433",
                                                "sense_id": "69c4703b-7dd2-3dc7-9748-c6b58b5083dd",
                                                "text": "The quarter, bushel, and peck are nearly universal measures of corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0766cbac-6b22-33c8-bec4-3388863e32da",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A vessel of the capacity of a bushel, used in measuring; a bushel measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe216258-8ce2-4abc-a7c7-3fece32edc81",
                                                "sense_id": "0766cbac-6b22-33c8-bec4-3388863e32da",
                                                "text": "And he sayde unto them: is the candle lighted, to be put under a busshell, or under the borde: ys it not therfore lighted that it shulde be put on a candelsticke?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ee93e0-17c1-3daf-b312-27aa62a2cf09",
                                        "entry_id": "c3c8076e-51fb-35e1-9af2-8e4e9b3caf2a",
                                        "glosses": [
                                            "A quantity that fills a bushel measure."
                                        ],
