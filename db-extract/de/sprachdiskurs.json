                "senses": [
                    {
                        "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                        "entry_id": "206826a5-38a0-30b6-bc7e-ae0d30bb9a70",
                        "glosses": [
                            "Auseinandersetzung über Sprache, Erörterung der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8438e7-8357-496b-87af-086f99cd619c",
                                "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                                "text": "„Für ein Argumentieren im öffentlichen Sprachdiskurs ist es immer ein Gewinn, wenn man zeigen kann, dass das Gegenwartsdeutsche in dieser oder jener Hinsicht keinen Sonderfall darstellt, sondern sich ähnlich verhält wie das Deutsche seit Jahrhunderten oder wie andere Sprachen auch.“"
                            },
                            {
                                "example_id": "099a90e0-978a-482f-9fe9-8e6dd31e6ec3",
                                "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                                "text": "„Daraus entstehende Sprachdiskurse können Ausdruck der Ablehnung des Anschlusses sein oder ihn oder seine (vielleicht unerwünschten) Folgen rechtfertigen.“"
                            },
                            {
                                "example_id": "64353340-fb83-4095-ada7-0cd681945ef8",
                                "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                                "text": "„Das empirische Datenmaterial ist zugleich der Punkt, an dem der wissenschaftliche Sprachdiskurs und der Laiendiskurs ineinander greifen.“"
                            },
                            {
                                "example_id": "dad2ac81-9ae5-4068-b0be-40041ef5b238",
                                "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                                "text": "„Das Projekt konzentrierte sich unter wissens- und kulturanthropologischer Perspektive auf für das 16. Jahrhundert fraglos bedeutsame und für Fischart wie Rabelais zentrale Diskurse: In der ersten Antragsphase wurden vorrangig Affekttheorien, Humanismus und Sprachdiskurse untersucht.“"
                            },
                            {
                                "example_id": "28405960-c105-4f88-9d03-a2666d375d71",
                                "sense_id": "3decb87c-a13a-3e97-8a11-8b4b0a6f462a",
                                "text": "„Der Beitrag illustriert, wie der gescheiterte Zentralismus, die historische Mehrsprachigkeit und die daraus entstandenen Sprachdiskurse in Spanien den Begriff des Dialekts politisiert haben und so die Entstehung von Dialektliteraturen eher behindern als begünstigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
