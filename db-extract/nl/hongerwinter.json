                        "glosses": [
                            "de winter van 1944-45 in het westen van Nederland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c97b8b-463f-448c-b5e9-ca53c3ad4f6c",
                                "sense_id": "53457bf0-26cd-3ef6-8ea1-4b95f608d506",
                                "text": "20.000 Nederlanders kwamen in de Hongerwinter om door honger en kou."
                            },
                            {
                                "example_id": "5e5a16bf-d19b-4404-868f-cf392e32339b",
                                "sense_id": "53457bf0-26cd-3ef6-8ea1-4b95f608d506",
                                "text": "In een groot deel van Nederland ging de oorlog nog een paar maanden door. Het waren uiterst moeilijke wintermaanden. Het was heel koud en er was bijna geen eten. Daarom heet deze winter van 1944 'de Hongerwinter'. Maar op 5 mei 1945 was de rest van Nederland ook bevrijd. Soldaten uit Canada, Amerika, Groot-Brittannië en Polen hebben Nederland bevrijd."
                            }
                        ]
                    }
