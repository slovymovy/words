                                "example_id": "46961eff-7862-4651-a8ee-07925f84eb4d",
                                "sense_id": "21ecc208-ac99-3e5e-b93a-0374dd36ca84",
                                "text": "„1834 erregte es Aufsehen, dass ein nicht ‚Hausgesessener‘, nämlich Johann Gschwandtner, eine Buschenschank eröffnete. […] Der Buschenschank unterliegt nicht der Gewerbeordnung, wird jedoch in den einzelnen Bundesländern unterschiedlich gehandhabt (Buschenschankgesetz).“"
                            },
                            {
                                "example_id": "c92a3db3-26a9-4020-ac44-6e3400e8d70b",
                                "sense_id": "21ecc208-ac99-3e5e-b93a-0374dd36ca84",
                                "text": "„Den Buschenschank dürfen nur die im § 1 genannten Personen ausüben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
