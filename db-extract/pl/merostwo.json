                ],
                "translations": [
                    {
                        "translation_id": "d42cb73b-9a0f-4615-b574-e89fb831d62a",
                        "source_entry_id": "a3b150e4-5fc8-35e6-b1a7-458d37fffe0f",
                        "source_sense_id": "f5a52a76-cb33-3cd8-abc1-7f4255482a90",
                        "target_lang_word": "mairie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mairie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc24fd32-8ddc-316a-b4ca-e61804055bfd",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "Charge, dignité de maire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4b9958-66f3-4bd2-9939-7bc06f777ea9",
                                                "sense_id": "fc24fd32-8ddc-316a-b4ca-e61804055bfd",
                                                "text": "Être élu à la mairie de Bordeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ecaf33d-41ca-3429-9313-099a203d0df6",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "Bâtiment, ensemble de bâtiments où se tient l’administration municipale (dans certaines villes, on dit aussi hôtel de ville ou maison commune)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8fe22c6-025b-4f3e-8ca4-f53395d941e5",
                                                "sense_id": "9ecaf33d-41ca-3429-9313-099a203d0df6",
                                                "text": "Aller à la mairie pour demander une pièce, un acte, un certificat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e1ad49-017e-3e40-b8e1-e05464d060c4",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "Administration et territoire sous l’autorité du maire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34805c73-55a7-43b8-86a7-c1207f2604d6",
                                                "sense_id": "30e1ad49-017e-3e40-b8e1-e05464d060c4",
                                                "text": "Ancien directeur de cabinet de Chirac à la mairie de Paris, gendarme et « ex » des services secrets, Roussin est à l'origine un chiraquien pur beurre, formé à la mode Foccart."
                                            },
                                            {
                                                "example_id": "e791a408-5d34-4733-a776-dccae4a4efda",
                                                "sense_id": "30e1ad49-017e-3e40-b8e1-e05464d060c4",
                                                "text": "Que disions-nous, déjà ? La mairie de Paris, c'est ça. Et bien, la mairie de Paris se contenta de m'indiquer les coordonnées d'une société de dépigeonnage et me raccrocha au nez sans autre forme de procès. Cavalière, cette attitude, vous en conviendrez."
                                            },
                                            {
                                                "example_id": "ac121b03-0b52-477d-9cdb-523dce788952",
                                                "sense_id": "30e1ad49-017e-3e40-b8e1-e05464d060c4",
                                                "text": "« L’été, la population est multipliée par huit », calcule la mairie de Saint-Briac-sur-Mer (35)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae19f082-2eab-3a4e-a8d0-f40898cfd06f",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "ou Temps durant lequel on exerce la fonction de maire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71716914-3bb4-47e1-af34-03e5f03f0a0c",
                                                "sense_id": "ae19f082-2eab-3a4e-a8d0-f40898cfd06f",
                                                "text": "1317. Sire Jehan de Mauleon, il décéda durant sa mairie,"
                                            },
                                            {
                                                "example_id": "31dcdcca-52f3-4ec2-89c5-4c8720c0734c",
                                                "sense_id": "ae19f082-2eab-3a4e-a8d0-f40898cfd06f",
                                                "text": "[…] : Montaigne se tint à Libourne, en bon air. Il joua un certain rôle pendant les troubles, d’abord pour préserver la ville de Bordeaux pendant les quatre années de sa mairie, mais aussi dans la politique générale comme négociateur, intermédiaire et confident : […]."
                                            },
                                            {
                                                "example_id": "97223289-937f-4dca-8385-ae1840fcc5eb",
                                                "sense_id": "ae19f082-2eab-3a4e-a8d0-f40898cfd06f",
                                                "text": "« […]. Je vous prie de me pardonner et à mes administrés les fautes que j'ai pu commettre et leur avoir fait commettre pendant le temps de ma mairie de laquelle je vous prie d'accepter ma démission »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a36ca642-7c7a-33a4-b1c7-95bff15b16ea",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "Mairie du palais : charge de maire du palais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61d0960b-b9b0-3219-96da-82359006dbe1",
                                        "entry_id": "fe83494c-3a67-3c99-be87-9f8977ef5e46",
                                        "glosses": [
                                            "Conseil municipal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
