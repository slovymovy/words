                "senses": [
                    {
                        "sense_id": "f2f74e16-f5d9-3011-8c1d-9b707daf20b3",
                        "entry_id": "3f27e5c1-ba03-3c0d-a08a-fed5bf608fa1",
                        "glosses": [
                            "разг., неодобр. поступки или поведение пижона; пустая франтоватость, тщеславное стремление показать себя богаче или роскошнее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904d63b9-d646-4b5f-a45f-20919e01e053",
                                "sense_id": "f2f74e16-f5d9-3011-8c1d-9b707daf20b3",
                                "text": "Верхом пижонства для любителя чая является заказ в кафе или ресторане кофе, и следующая за недоуменной реакцией спутников фраза: «Чай здесь всё равно хорошо не заварят»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e80c8aa1-696d-4806-add6-628061131877",
                        "source_entry_id": "3f27e5c1-ba03-3c0d-a08a-fed5bf608fa1",
                        "source_sense_id": "f2f74e16-f5d9-3011-8c1d-9b707daf20b3",
                        "target_lang_word": "Firlefanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Firlefanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1437f6e-65ab-3237-a6e6-00082d2b7d04",
                                        "entry_id": "f62f49d6-325e-38dd-ae3f-b24ee877d0c5",
                                        "glosses": [
                                            "überflüssiges, unnützes Zeug"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecbc5096-7851-4646-b1c0-4ee95b5d970e",
                                                "sense_id": "d1437f6e-65ab-3237-a6e6-00082d2b7d04",
                                                "text": "Diesen Firlefanz sollten wir mal endlich entsorgen."
                                            },
                                            {
                                                "example_id": "ecacadcf-d626-4788-81eb-cea3a56d189d",
                                                "sense_id": "d1437f6e-65ab-3237-a6e6-00082d2b7d04",
                                                "text": "„Die blonde Sekretärin, die normalerweise ihr Gehalt für Firlefanz ausgibt, spendet plötzlich all ihr Geld Greenpeace.“"
                                            },
                                            {
                                                "example_id": "c481228f-5a6c-40fa-a18d-634a312320b5",
                                                "sense_id": "d1437f6e-65ab-3237-a6e6-00082d2b7d04",
                                                "text": "„Wie Oscar Wilde ärgerte er sich über Ofenburgen, gepreßte Stoffe, imitierte Renaissancetüren und versnobten Firlefanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a55f82d-610e-3efe-a5fa-cae22a2d79ee",
                                        "entry_id": "f62f49d6-325e-38dd-ae3f-b24ee877d0c5",
                                        "glosses": [
                                            "gedanklicher Unsinn, Spinnerei"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee14e9c-b644-4c42-bef6-6caa499126e0",
                                                "sense_id": "5a55f82d-610e-3efe-a5fa-cae22a2d79ee",
                                                "text": "Was er da vorgetragen hat, war alles nur Firlefanz."
                                            },
                                            {
                                                "example_id": "45a16747-60dc-4962-8e76-214a1c8ca81b",
                                                "sense_id": "5a55f82d-610e-3efe-a5fa-cae22a2d79ee",
                                                "text": "So einen Firlefanz mache ich aber nicht mit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "27f589b9-4cb7-39a0-b5b8-c4940a43fc7f",
                                        "entry_id": "f62f49d6-325e-38dd-ae3f-b24ee877d0c5",
                                        "glosses": [
                                            "Person, die Streiche, Unfug und Torheiten plant und umsetzt"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f45e6144-f06e-42c9-8131-b8411cc19daf",
                                                "sense_id": "27f589b9-4cb7-39a0-b5b8-c4940a43fc7f",
                                                "text": "Wer exemplarische Firlefanze sucht, sollte an Max und Moritz von Wilhelm Busch denken."
                                            },
                                            {
                                                "example_id": "eafb85f8-6cc8-449f-a4ff-b41639279ca3",
                                                "sense_id": "27f589b9-4cb7-39a0-b5b8-c4940a43fc7f",
                                                "text": "„Der hat nur Firlefanz im Kopf.“"
                                            },
                                            {
                                                "example_id": "63edf4bc-b50b-4024-a0e5-e8547b5637b4",
                                                "sense_id": "27f589b9-4cb7-39a0-b5b8-c4940a43fc7f",
                                                "text": "„Die Männer der Sonntagsschule haben sie in einem Sommer in gemeinsamer Arbeit gegossen, und die Formen, die sie benutzten, waren kein Firlefanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
