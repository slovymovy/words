                    {
                        "sense_id": "40c33cd4-308f-37c1-a934-ba9766a88796",
                        "entry_id": "6a96c393-f839-3e92-beed-aa23e1989c3d",
                        "glosses": [
                            "członek fundamentalistycznego ugrupowania islamskiego, które powstało w 1994 w Afganistanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94eef98-81fa-4970-aa64-081d2d9f4b3a",
                                "sense_id": "40c33cd4-308f-37c1-a934-ba9766a88796",
                                "text": "Talibowie poinformowali, że zniszczyli już ponad połowę wszystkich figur Buddy w Afganistanie. Ich zdaniem, są one aktem bluźnierstwa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b1b86b0f-6591-38e7-ad0b-b5fd4625c44d",
                        "entry_id": "6a96c393-f839-3e92-beed-aa23e1989c3d",
                        "glosses": [
                            "fundamentalista, radykał, fanatyk, osoba zagorzała i nieuznająca żadnych ustępstw w jakiejś dziedzinie"
                        ],
