                        ],
                        "examples": [
                            {
                                "example_id": "600f8bab-0f28-431e-ae56-c789df2c6b04",
                                "sense_id": "bb1274de-a1b9-3cf4-b330-0736e42e9585",
                                "text": "Autoétirer les fléchisseurs et les extenseurs du poignet."
                            }
