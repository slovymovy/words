                "senses": [
                    {
                        "sense_id": "ddfde3b1-868d-3b0d-9dff-3b709427613b",
                        "entry_id": "6df8ee68-6318-3122-b079-e9fdf63e771b",
                        "glosses": [
                            "de schoonheid en de pracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e513363b-6ea7-495c-a3e6-ad923a6276c4",
                                "sense_id": "ddfde3b1-868d-3b0d-9dff-3b709427613b",
                                "text": "3. Kantine: Die is flink gedateerd, de inrichting stamt nog uit de jaren tachtig. Meubilair is wel eens vervangen, maar het schreeuwt om een make-over. Functioneel gaat hier vooralsnog voor fraaiheid, al heeft de club moderniseringsplannen."
                            },
                            {
                                "example_id": "e3bf584b-c371-4fdd-903d-057b881e2cbc",
                                "sense_id": "ddfde3b1-868d-3b0d-9dff-3b709427613b",
                                "text": "Het enige houvast dat ze daarbij hebben, is de passie van de mens. Ruysch, en ook Bregtje, wordt totaal gefascineerd door de fraaiheid van de anatomie en later raakt Ben bevangen door diezelfde passie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54078128-9a20-467f-ab96-1aca29dc1189",
                        "source_entry_id": "6df8ee68-6318-3122-b079-e9fdf63e771b",
                        "source_sense_id": "ddfde3b1-868d-3b0d-9dff-3b709427613b",
                        "target_lang_word": "beauty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beauty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "The quality of being (especially visually) attractive, pleasing, fine or good-looking; comeliness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26723a0f-70b3-4d4b-80b5-6b7548ab4fb5",
                                                "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                                "text": "A thing of beauty is a joy for ever: / Its loveliness increases; it will never / Pass into nothingness; but still will keep / A bower quiet for us, and a sleep / Full of sweet dreams, and health, and quiet breathing."
                                            },
                                            {
                                                "example_id": "976604fd-1d8c-4ba1-9f28-a0771ce26bea",
                                                "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                                "text": "‘Say, hast thou seen enough!’ ‘I have looked on beauty, and I am blinded,’ I said hoarsely, lifting my hand to cover up my eyes."
                                            },
                                            {
                                                "example_id": "81f00f85-fd2d-4867-8ee3-5f07bafd3bfc",
                                                "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                                "text": "Warwick's first glance had revealed the fact that the young woman was strikingly handsome, with a stately beauty seldom encountered."
                                            },
                                            {
                                                "example_id": "f9a07934-58db-417f-ba29-81c735d5e709",
                                                "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                                "text": "\"The aviators didn't get him,\" Denham replied slowly. \"What?\" \"It was Beauty. As always Beauty killed the Beast.\""
                                            },
                                            {
                                                "example_id": "190c9184-7c02-46dc-8565-658b11c19683",
                                                "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                                                "text": "1988, \"… beauty and recollection, like danger, glamour, greed, hunger- everything but disappointment and desire- were concepts belonging to other people.” -Second Son, Robert Ferro"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf73de1-3444-3485-8a92-485b3ecca602",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "Someone who is beautiful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "252fc586-232e-4849-b675-0e64e445427d",
                                                "sense_id": "3bf73de1-3444-3485-8a92-485b3ecca602",
                                                "text": "Brigitte Bardot was a renowned beauty."
                                            },
                                            {
                                                "example_id": "d4155a0c-9155-49f3-ae9d-2267266be0ec",
                                                "sense_id": "3bf73de1-3444-3485-8a92-485b3ecca602",
                                                "text": "The website calls a vote for Alyona a vote against \"beauties who do not look natural and who cannot be distinguished from each other\" and rails against the \"imposed standards\" of 90-60-90 vital statistics, and \"cigarettes with out nicotine and coffee without caffeine\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff30d2ec-5e4e-3203-83dc-629cc47df33c",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "Those aspects or elements that make someone or something beautiful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1665a4f-3fa4-4d4c-88a6-296f7ee397f4",
                                                "sense_id": "ff30d2ec-5e4e-3203-83dc-629cc47df33c",
                                                "text": "There the roſy-finger'd Spring, by the liquid mirror of a cryſtalline pool, was attiring her fair daughters in ſeven-fold ornaments, while the love-whiſpering breezes ſtole kiſſes as they paſſed, and fanned their glowing beauties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccab40e0-e985-36e8-ba2a-8a34e634d226",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "Something that is particularly good or pleasing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee622384-7996-4adc-b63b-3f0f81d5c4f3",
                                                "sense_id": "ccab40e0-e985-36e8-ba2a-8a34e634d226",
                                                "text": "What a goal! That was a real beauty!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d6541e-8343-3cea-a803-6a6547a27a7a",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "An excellent or egregious example of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b6e8e4-4039-4b33-b2e2-6c88f3563f16",
                                                "sense_id": "17d6541e-8343-3cea-a803-6a6547a27a7a",
                                                "text": "He got into a fight and ended up with two black eyes – two real beauties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d01d254-0cfa-3692-b41b-714bfcd3fb71",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
                                        "glosses": [
                                            "The excellence or genius of a scheme or decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4cbaf8-6e1c-483b-989f-1667a16dfc51",
                                                "sense_id": "5d01d254-0cfa-3692-b41b-714bfcd3fb71",
                                                "text": "The beauty of the deal is it costs nothing!"
