                        "form": "ле́тнике"
                    },
                    {
                        "form_id": "5e410ed1-4600-4066-be05-140bcc571bff",
                        "entry_id": "5c44835a-2b9e-3123-8427-ebdffda61544",
                        "tags": [
                            "plural",
