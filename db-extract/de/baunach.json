                ],
                "senses": [
                    {
                        "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                        "entry_id": "20b5f59f-b159-3d65-97ee-d781c8ce7b7c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c051b13f-09ce-4ec9-b1f4-849771eee8c6",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Frau Baunach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "aa863f52-5f1d-4e43-86a0-1c40f502ec81",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Herr Baunach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "45b9d072-9838-4b84-a8a3-c4a30edb51fd",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Die Baunachs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "c9f74a86-63ea-40bb-9eab-b5fe24835a48",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Der Baunach trägt nie die Pullover, die die Baunach ihm strickt."
                            },
                            {
                                "example_id": "287e7d35-1c7c-4212-b1d4-626c5eaa3f60",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baunach kommt, geht der Herr Baunach.“"
                            },
                            {
                                "example_id": "a13e3540-841d-4fa4-b8f1-0956f6e6bdbe",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Baunach kommt und geht."
                            },
                            {
                                "example_id": "f605e66c-5507-48e9-8872-1692f6ce3616",
                                "sense_id": "080d290d-e0ee-37c0-80ad-753c3c11a0a1",
                                "text": "Baunachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
