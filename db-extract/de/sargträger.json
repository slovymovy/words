                        "entry_id": "3cbb27c5-157d-3f46-ba11-295ec51937cc",
                        "glosses": [
                            "Person, die zusammen mit weiteren den Sarg von der Trauerfeier oder dem Friedhofseingang bis zur ausgehobenen Grabstätte bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2cb841-ba30-44d5-bb24-662884e449a7",
                                "sense_id": "ab75f575-0073-323d-9013-d98a048d7442",
                                "text": "„Früher waren die Totengräber (Bauarbeiter auf dem Friedhof) parallel als Sargträger tätig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
