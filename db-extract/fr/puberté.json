                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc9c20c7-ade3-462c-a6c6-e8c39a6be4d7",
                        "source_entry_id": "a49b4136-3ac5-312d-a4b1-c360a2815993",
                        "source_sense_id": "8ba9f03b-e29d-30c7-99e2-a3c25011ef1e",
                        "source_sense_description": "Adoleszenz, Reifezeit, Jugendzeit",
                        "target_lang_word": "Adoleszenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adoleszenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                        "entry_id": "39267463-d480-3838-a9a2-99bfd750dcd1",
                                        "glosses": [
                                            "Entwicklungszeit des Menschen zwischen dem Kindesalter und dem Erwachsensein; etwa zwischen 13. und 22. Lebensjahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4536dab1-f164-4757-9c93-d91046239f73",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "In den Vereinigten Staaten wird die Adoleszenz im Allgemeinen bereits bei Pubertätsbeginn angesiedelt: beginnend im Alter von 13 Jahren bis zum 24. Lebensjahr."
                                            },
                                            {
                                                "example_id": "171d6c55-8e97-4026-a934-e53effe67822",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "„Ihm schien, als habe er vor ein paar Wochen ein halbes Mädchen, ein leicht schlaksiges, nicht ganz ausgewachsenes Etwas verlassen und plötzlich jemand wiedergefunden, der die mystische Grenze der Adoleszenz gerade passiert und noch ihren Reiz, aber schon die magische Sicherheit einer sehr schönen, jungen Frau hatte.“"
                                            },
                                            {
                                                "example_id": "a083d73a-316d-42bf-9169-7889ae462c49",
                                                "sense_id": "b3832d5d-0423-36f9-bed9-35fc0c5d3c62",
                                                "text": "„Die Adoleszenz übertreibt es, und dann wächst es sich hoffentlich aus (mit Goethe, der dann später gemeinsames wildes Schlittenfahren und Peitschenknallen liebte und überhaupt Unfug, konnte er das dann postadoleszent ausleben).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5242dc5-b65b-4c72-a4c7-c10d7342abe1",
                        "source_entry_id": "a49b4136-3ac5-312d-a4b1-c360a2815993",
                        "source_sense_id": "8ba9f03b-e29d-30c7-99e2-a3c25011ef1e",
                        "source_sense_description": "Adoleszenz, Reifezeit, Jugendzeit",
                        "target_lang_word": "Reifezeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reifezeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b90505c-5069-3d09-93bd-9ebbc3b04f25",
                                        "entry_id": "78099e75-6004-394f-97c7-c36d368b2de4",
                                        "glosses": [
                                            "Zeitfenster, das benötigt wird, damit etwas reif wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3311507b-e40e-41f4-8b2c-96dbd858ca09",
                                                "sense_id": "4b90505c-5069-3d09-93bd-9ebbc3b04f25",
                                                "text": "„Während der Reifezeit [von Milch zum Käse] wird Eiweiß durch sortentypische Bakterien abgebaut, wodurch der charakteristische Geschmack entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0105e971-779a-321d-acbf-09b2f6628255",
                                        "entry_id": "78099e75-6004-394f-97c7-c36d368b2de4",
                                        "glosses": [
                                            "anderes Wort für die pubertäre Phase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3adfee9d-90fa-403e-ab49-adfe9a092234",
                                                "sense_id": "0105e971-779a-321d-acbf-09b2f6628255",
                                                "text": "Während der Reifezeit verändert sich der Mensch sehr stark."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c81d5c1d-cdb8-4187-8373-1488ed24f722",
                        "source_entry_id": "a49b4136-3ac5-312d-a4b1-c360a2815993",
                        "source_sense_id": "8ba9f03b-e29d-30c7-99e2-a3c25011ef1e",
                        "source_sense_description": "Adoleszenz, Reifezeit, Jugendzeit",
                        "target_lang_word": "Jugendzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jugendzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3be19abe-0bcf-3d8d-8639-cfddb1686d8e",
                                        "entry_id": "067005ac-2777-3b48-a25c-7b4a0d2027c6",
                                        "glosses": [
                                            "Lebensphase zwischen Kindheit und Erwachsensein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65df3809-8ba0-4783-92ac-4acef920a20b",
                                                "sense_id": "3be19abe-0bcf-3d8d-8639-cfddb1686d8e",
                                                "text": "„Als der Zugverkehr auf dieser unrentablen Strecke im September 1968 eingestellt wurde, fiel das fast auf den Tag genau mit dem Ende unserer Jugendzeit zusammen, denn nur wenige Monate später gingen wir, in alle Winde verstreut, jeder für sich seinen Weg.“"
                                            },
                                            {
                                                "example_id": "685acacb-f951-4da5-9b4e-6bfc7bc85291",
                                                "sense_id": "3be19abe-0bcf-3d8d-8639-cfddb1686d8e",
                                                "text": "„In meiner Jugendzeit, in der Ära der Swingmusik, konnte man sich nur mit Alkohol in Stimmung bringen.“"
                                            },
                                            {
                                                "example_id": "552b8bd8-f02d-4369-9a7b-fe3c5baf8939",
                                                "sense_id": "3be19abe-0bcf-3d8d-8639-cfddb1686d8e",
                                                "text": "„Elias fühlt sich in dieser Jugendzeit so sehr an die Mutter gebunden, dass sie für ihn im Konfliktfall die einzige Orientierungsinstanz bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
