                        ],
                        "form": "die Zeitzeugen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                        "entry_id": "7def7fb2-c1db-3e51-97bb-0e686b1b7135",
                        "glosses": [
                            "Person, welche an einem bestimmten (meist historischen) Ereignis persönlich teilgenommen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e455c2fc-b337-4a72-af7e-c89300dfec9c",
                                "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                                "text": "Berichte von Zeitzeugen sind wichtige historische Quellen."
                            },
                            {
                                "example_id": "0dc50e6c-008e-4168-adad-ddec2e777464",
                                "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                                "text": "„Diese Pendelei erzeugt aber nicht nur das Gefühl, ständig Zeitzeuge des Wandels dieser Stadt zu sein, sondern auch einen elenden Entscheidungsdruck.“"
                            },
                            {
                                "example_id": "106244b1-b916-49e2-869f-8a9fd5438954",
                                "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                                "text": "„Das Konkubinat hatte sich in den Kolonien derart etabliert, dass viele Zeitzeugen die betreffenden Frauen - besonders diejenigen, welche höheren Offizieren zugeteilt worden waren - als »Gattinnen« bezeichneten.“"
                            },
                            {
                                "example_id": "f065b616-ddc9-4557-97d7-872ef2a8e984",
                                "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                                "text": "„Dabei werden als Zeitzeugen auch die Kinder des Zweiten Weltkriegs sichtbar, wohl deshalb, weil kaum noch ältere am Leben sind.“"
                            },
                            {
                                "example_id": "4d46a47f-ccdd-4660-9dbd-3be06139b58e",
                                "sense_id": "f3afff67-dec3-3ac6-a351-6904bb693241",
                                "text": "„Diesen Eindrücken und Beschreibungen, erfasst für den internen Dienstgebrauch, stehen die Aussagen von damaligen Zeitzeugen gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
