                        "glosses": [
                            "A timekeeper; someone or something that timekeeps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4722a4d0-b0f2-4d89-b3b6-175d16d35da3",
                                "sense_id": "2021be6b-c14e-3bd4-81e1-f7f8ac742107",
                                "text": "A timekeep gave us our cards and our badges and told us where to punch in and then let out a yell for Johnson, our straw boss."
                            },
                            {
                                "example_id": "a2dac28c-f373-4c54-9990-67ec5e3d2651",
                                "sense_id": "2021be6b-c14e-3bd4-81e1-f7f8ac742107",
                                "text": "Round little timekeeps set with crystal eye."
                            },
                            {
                                "example_id": "f2dc3615-30bd-47c4-9b34-8653189c9f60",
                                "sense_id": "2021be6b-c14e-3bd4-81e1-f7f8ac742107",
                                "text": "Now to my point, I just arranged my clocks and other timekeeps in my display casement when the explosion struck."
                            }
                        ]
                    }
