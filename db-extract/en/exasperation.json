                                "target_senses": [
                                    {
                                        "sense_id": "92c292c3-2b23-3aa9-aa54-5620901d0667",
                                        "entry_id": "1c2acdca-1098-3bef-a20e-53f6fda0fb4c",
                                        "glosses": [
                                            "Aktion, jemanden zu verbittern"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db7a726d-0974-3ba6-a5f7-91cb338fd3d3",
                                        "entry_id": "1c2acdca-1098-3bef-a20e-53f6fda0fb4c",
                                        "glosses": [
                                            "Gefühlslage großer Enttäuschung und Ablehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2290e54d-323b-4a1e-8e18-46d29c7622be",
                                                "sense_id": "db7a726d-0974-3ba6-a5f7-91cb338fd3d3",
                                                "text": "„Für Verbitterung sorge, kritisierte von Jagow am 22. August 1914, dass auch staatliche und sogar Militärbetriebe lieber ihre festen Mitarbeiter Überstunden machen ließen, als Arbeitssuchende einzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "add207cf-d6e6-4281-a988-f33dca759911",
                        "source_entry_id": "7a35f122-f942-3af6-b2f2-a59508f270b4",
                        "source_sense_description": "the act of exasperating",
                        "target_lang_word": "Frust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                        "entry_id": "a014fd49-670c-3e93-bf20-7302275bb32c",
                                        "glosses": [
                                            "Gefühl der Enttäuschung, das sich bei wiederkehrendem Misserfolg einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e386f72-6c4b-4223-8095-a46f4755daf9",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "Aus Frust fing ich an, tafelweise Schokolade zu essen."
                                            },
                                            {
                                                "example_id": "890791d4-3888-4e04-9270-09b4ef8088ef",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "Ich werde mich nicht dem Frust hingeben, sondern es weiterhin versuchen."
                                            },
                                            {
                                                "example_id": "3f07b49b-bb75-4f6e-ab29-60054e549221",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "Du musst deinen Frust überwinden!"
                                            },
                                            {
                                                "example_id": "47a54e5f-562d-41ce-b2db-ed38fae9dabd",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "„Der Frust wuchs, auf beiden Seiten.“"
                                            },
                                            {
                                                "example_id": "391d0f8b-2ac3-4023-bdb9-f2762423210d",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "„Sein Frust war offensichtlich und manifestierte sich alleine schon durch die deutliche Rötung seines runden Kopfes.“"
                                            },
                                            {
                                                "example_id": "e34701c5-17ef-41d3-869e-9c6d3a4eadae",
                                                "sense_id": "954c20bb-f3fd-3b2a-babd-111d65261b58",
                                                "text": "„Erst verschwand Bolzen, und der Chef musste sich im Nachhinein eingestehen, dass er seinen Frust zum Teil an Humpen und Caracas ausgelassen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdeb5edf-9750-4509-854b-818cb83ffb6e",
                        "source_entry_id": "7a35f122-f942-3af6-b2f2-a59508f270b4",
                        "source_sense_description": "the act of exasperating",
                        "target_lang_word": "Frustration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frustration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "616db114-ea76-33d3-b46e-b4c824372b51",
                                        "entry_id": "3faf7e7f-0f6b-3d81-9d42-ceab38f88d93",
                                        "glosses": [
                                            "schwerwiegende Enttäuschung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ec1668-ce7b-4981-83a9-c54bd2575839",
                                                "sense_id": "616db114-ea76-33d3-b46e-b4c824372b51",
                                                "text": "Wenn man sich immer wieder vergeblich bewirbt, kann das zu Frustration führen."
                                            },
                                            {
                                                "example_id": "77962e12-01bc-474d-9d85-e9f98fc85038",
                                                "sense_id": "616db114-ea76-33d3-b46e-b4c824372b51",
                                                "text": "„Und das erste Mal seit Langem spürte ich die alte Frustration in mir aufsteigen, denn ich hätte so gern verstanden, was genau seine Augen sagten, ich hatte doch schon solche Fortschritte gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "675b9bf1-d7d5-48b5-9637-77d2b466b6ac",
                        "source_entry_id": "7a35f122-f942-3af6-b2f2-a59508f270b4",
                        "source_sense_description": "the act of exasperating",
                        "target_lang_word": "Verdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                        "entry_id": "e7222bd5-b9fe-3de4-ac0a-49ee3c79a21d",
                                        "glosses": [
                                            "(andauernder) Ärger"
                                        ],
                                        "tags": [
                                            "literary",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf747d9-4005-4ba7-a5af-3ef88eaa4a3a",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Sein Verdruss war groß, als er auch diesmal nicht gewählt wurde."
                                            },
                                            {
                                                "example_id": "ea8d7cf2-5f80-4683-bceb-9cf78dd48be3",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Er ließ keinen Verdruss erkennen."
                                            },
                                            {
                                                "example_id": "f6209935-d665-495b-95e6-ee803ec0db09",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Es ist eine Kultur des Verdrusses, die sich über das Land gelegt hat, findet der Prediger.“"
                                            },
                                            {
                                                "example_id": "cc97100c-d752-4130-8385-bd22ef5e1298",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Vor allem die nach dem Börsenkrach vom Herbst 1873 einsetzende, lang anhaltende Wirtschaftsflaute sorgte für Verdruss.“"
                                            },
                                            {
                                                "example_id": "286ca306-2942-4d4c-bee2-d45dbcb2715d",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Offenbar gibt es nach elf Jahren Merkel doch einen stärkeren Verdruss an der Kanzlerin als angenommen und von den Umfragen suggeriert.“"
                                            },
                                            {
                                                "example_id": "cfaab7b3-12cb-4fec-97a9-2c0930cbef3e",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Er fühlte ihm den Puls und nahm zu seiner Verwunderung und zu seinem Verdruss wahr, dass der Puls ruhiger war.“"
                                            },
                                            {
                                                "example_id": "aa214dbd-38b8-469a-a8f3-ae01b1d59d19",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Ledermüller kam nun nach Nürnberg zurück, wurde aber zu Hause mit so harten Vorwürfen und Verdrussen gequält, daß er fortlief, und sich zu einem Freund nach Römhild begab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60cec17f-1346-4f9e-9ba3-d36e6de625c5",
                        "source_entry_id": "7a35f122-f942-3af6-b2f2-a59508f270b4",
                        "source_sense_description": "the act of exasperating",
                        "target_lang_word": "Entrüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entrüstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                        "entry_id": "df5d4cd4-df02-3036-8c85-916d983a16ce",
                                        "glosses": [
                                            "Gefühl der Beleidigung in seinem sittlichen Empfinden"
                                        ],
                                        "tags": [
                                            "Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5878b502-7332-43d7-b11c-14a086626ca7",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Vor Entrüstung über die freche Antwort fehlten dem Lehrer die Worte."
                                            },
                                            {
                                                "example_id": "2451b3de-0311-4fd5-991b-693d10f6670e",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Ein britischer Fernsehsender hat eine Weihnachtsansprache des iranischen Präsidenten Mahmud Ahmadinedschad ausgestrahlt und damit einen Sturm der Entrüstung ausgelöst."
                                            },
                                            {
                                                "example_id": "28dc0e80-1429-4b47-aea9-243cf021e0d5",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Mit Entrüstung reagieren die Telekom-Konkurrenten auf die Pläne des Ex-Monopolisten, die Miete für die Teilnehmeranschlussleitung zu erhöhen."
                                            },
                                            {
                                                "example_id": "807c5147-1cd8-4656-a9bd-99207b21ef8e",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "„Meine Entrüstung ist ungebrochen.“"
                                            },
                                            {
                                                "example_id": "3cacb0dd-95b8-4eb3-bba4-1d58b482d651",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "„Ein Sturm der Entrüstung bricht los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
