                ],
                "senses": [
                    {
                        "sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                        "entry_id": "1b6ece77-9c38-3477-a015-e3c32d93135d",
                        "glosses": [
                            "религ. православный церковный или народный календарь с указанием дней памяти святых и круга церковных праздников; святцы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586e1713-ec13-42a5-81ae-6aaa884304ac",
                                "sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                                "text": "Одною из характеристических особенностей тогдашней литературы были календари или месяцесловы, в которых, кроме астрономических сведений, были известные астрологические бредни, которым в те времена верили."
                            },
                            {
                                "example_id": "016134d6-bafb-427a-8fd2-c38d8d517216",
                                "sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                                "text": "На стенах храма фрески расположены в девять ярусов, из которых пять нижних занимает месяцеслов, изображающий последовательно по месяцам и дням святых и праздники."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3041181-cdac-4ab3-bb30-027345d12ea3",
                        "source_entry_id": "1b6ece77-9c38-3477-a015-e3c32d93135d",
                        "source_sense_id": "054e17a3-dd6f-37bc-a8ae-f43323ca1f39",
                        "target_lang_word": "menologium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menologium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eab1de8d-a27b-3209-ad06-775afedfe5f4",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e26db501-803e-41f9-9afd-fada82331f63",
                                                "sense_id": "eab1de8d-a27b-3209-ad06-775afedfe5f4",
                                                "text": "The elder Pliny advises the sowing of certain crops between the Saturnalia (fixed at 17 December) and the Compitalia, which the roughly contemporary menologia indefinitely set in January."
                                            },
                                            {
                                                "example_id": "fa54ac3c-2769-4c43-87ab-19e389403c55",
                                                "sense_id": "eab1de8d-a27b-3209-ad06-775afedfe5f4",
                                                "text": "The Roman farming menologia show the astrological information and religious festivals for each month along with their matching agricultural activities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d92500d-9f02-37a0-b565-ce6101b09d22",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and",
                                            "Synonym of menaion, a book detailing the propers and hagiographic canons for the fixed dates of the liturgical year."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0f3b1db-2fb2-39a6-9367-046ea99a21dd",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and",
                                            "Synonym of synaxarium, a hagiography covering similar material equivalent to a Catholic martyrology."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bdea394-ad13-3072-b3de-6ea865f62994",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and",
                                            "Synonym of kalendar, any monthly list of saints' days or liturgical readings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4444a5a-4144-3df4-8792-6fe733e73e31",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and",
                                            "A work providing biographies of uncanonized members of a religious order in similar style to a martyrology, frequently read within the order but forbidden for use with the liturgy itself."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0a31231-2439-3498-a86b-37e676ef0bc5",
                                        "entry_id": "87bdb208-6382-3153-b8fe-ac8937f73bb1",
                                        "glosses": [
                                            "A calendar of the days of the month or of all the days of the year divided by month, particularly as a table of information divided in this way and",
                                            "Synonym of martyrology, a hagiography of Catholic saints."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often",
