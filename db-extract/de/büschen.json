                "senses": [
                    {
                        "sense_id": "9e0ab74c-fa37-320f-a9e1-a590eae818e4",
                        "entry_id": "2b545e7d-2613-3812-8ecc-ce5a479e30bf",
                        "glosses": [
                            "bisschen"
                        ],
