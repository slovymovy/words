    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a93097d7-c68f-3d15-9d70-96022d883344",
                    "sense_definition": "Heavy and hard to lift or carry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_size_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to lift the <w>hefty</w> backpack onto her shoulders.",
                            "target_lang_translations": {
                                "es": "Le costó levantarse la <w>pesada</w> mochila a los hombros."
                            }
                        },
                        {
                            "text": "We need someone strong to move this <w>hefty</w> piece of furniture.",
                            "target_lang_translations": {
                                "es": "Necesitamos a alguien fuerte para mover este mueble tan <w>pesado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "heavy",
                        "weighty"
                    ],
                    "antonyms": [
                        "light"
                    ],
                    "common_phrases": [
                        "hefty box",
                        "hefty bag"
                    ],
                    "target_lang_definitions": {
                        "es": "Pesado y difícil de levantar o transportar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pesado",
                                "target_lang_sense_clarification": "de gran peso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10fbebd7-8fd8-39c5-a655-a9e703d8b56b",
                    "sense_definition": "Considerably large in amount, size, or extent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "amount_or_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced a <w>hefty</w> fine for violating safety regulations.",
                            "target_lang_translations": {
                                "es": "La empresa se enfrentó a una <w>cuantiosa</w> multa por incumplir las normas de seguridad."
                            }
                        },
                        {
                            "text": "He managed to save a <w>hefty</w> sum of money after working overtime for months.",
                            "target_lang_translations": {
                                "es": "Logró ahorrar una <w>considerable</w> suma de dinero después de hacer horas extra durante meses."
                            }
                        }
                    ],
                    "synonyms": [
                        "substantial",
                        "sizeable",
                        "considerable"
                    ],
                    "antonyms": [
                        "paltry",
                        "meager"
                    ],
                    "common_phrases": [
                        "hefty fine",
                        "hefty sum",
                        "hefty price",
                        "hefty discount"
                    ],
                    "target_lang_definitions": {
                        "es": "Considerablemente grande en cantidad, tamaño o magnitud."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cuantioso",
                                "target_lang_sense_clarification": "de gran cantidad, especialmente referido a dinero o multas"
                            },
                            {
                                "target_lang_word": "considerable",
                                "target_lang_sense_clarification": "grande en tamaño o suma"
                            },
                            {
                                "target_lang_word": "importante",
                                "target_lang_sense_clarification": "notable en cantidad o repercusión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0939d336-76b5-3e2d-822c-24e2ec9698c7",
                    "sense_definition": "Large, powerfully built, and heavy in appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_size_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two <w>hefty</w> guards stood at the entrance to block unwanted visitors.",
                            "target_lang_translations": {
                                "es": "Dos guardias <w>corpulentos</w> estaban en la entrada para bloquear el paso a visitantes no deseados."
                            }
                        },
                        {
                            "text": "He was a <w>hefty</w> man who had spent years working in construction.",
                            "target_lang_translations": {
                                "es": "Era un hombre <w>robusto</w> que había pasado años trabajando en la construcción."
                            }
                        }
                    ],
                    "synonyms": [
                        "burly",
                        "strapping",
                        "brawny"
                    ],
                    "antonyms": [
                        "slight",
                        "skinny"
                    ],
                    "common_phrases": [
                        "hefty man",
                        "hefty frame"
                    ],
                    "target_lang_definitions": {
                        "es": "Grande, corpulento y de complexión fuerte o pesada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "robusto",
                                "target_lang_sense_clarification": "de cuerpo fuerte y firme"
                            },
                            {
                                "target_lang_word": "corpulento",
                                "target_lang_sense_clarification": "de gran tamaño y volumen corporal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                    "sense_definition": "Delivered with great force or physical power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "amount_or_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer threw a <w>hefty</w> punch that knocked his opponent down.",
                            "target_lang_translations": {
                                "es": "El boxeador lanzó un golpe <w>potente</w> que derribó a su oponente."
                            }
                        },
                        {
                            "text": "With one <w>hefty</w> blow, he managed to crack the wooden door open.",
                            "target_lang_translations": {
                                "es": "De un <w>fuerte</w> golpe, logró abrir la puerta de madera."
                            }
                        }
                    ],
                    "synonyms": [
                        "forceful",
                        "powerful",
                        "mighty"
                    ],
                    "antonyms": [
                        "weak",
                        "feeble"
                    ],
                    "common_phrases": [
                        "hefty punch",
                        "hefty blow"
                    ],
                    "target_lang_definitions": {
                        "es": "Asestado con gran fuerza física o potencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fuerte",
                                "target_lang_sense_clarification": "dicho de un golpe, con gran impacto"
                            },
                            {
                                "target_lang_word": "potente",
                                "target_lang_sense_clarification": "con mucha fuerza"
                            },
                            {
                                "target_lang_word": "contundente",
                                "target_lang_sense_clarification": "que golpea con gran peso o fuerza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b69662b3-048d-30c8-bb6c-4a655edfe5c8",
                    "sense_definition": "Bulky, robust, and sturdy in structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_size_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers used <w>hefty</w> steel bolts to secure the bridge support.",
                            "target_lang_translations": {
                                "es": "Los ingenieros usaron unos <w>gruesos</w> pernos de acero para fijar el soporte del puente."
                            }
                        },
                        {
                            "text": "A <w>hefty</w> wooden beam supported the ceiling of the old farmhouse.",
                            "target_lang_translations": {
                                "es": "Una viga de madera <w>robusta</w> sostenía el techo de la antigua casa de campo."
                            }
                        }
                    ],
                    "synonyms": [
                        "sturdy",
                        "bulky",
                        "solid"
                    ],
                    "antonyms": [
                        "flimsy",
                        "fragile"
                    ],
                    "common_phrases": [
                        "hefty bolts"
                    ],
                    "target_lang_definitions": {
