                "senses": [
                    {
                        "sense_id": "789a30d4-a039-31f1-92fc-4a263e18e7f2",
                        "entry_id": "ef595f3f-2e6f-397b-9cc1-0d9bd212f47b",
                        "glosses": [
                            "специалист по звероводству; тот, кто разводит ценных пушных зверей в неволе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e1e80bb-8f77-4241-8492-8eba27a5685c",
                                "sense_id": "789a30d4-a039-31f1-92fc-4a263e18e7f2",
                                "text": "Зверовод во все глаза следит: почему не доел, почему заскучал, почему не играют ребята."
                            },
                            {
                                "example_id": "73de085a-0701-41b3-8dc5-10ca99dd1489",
                                "sense_id": "789a30d4-a039-31f1-92fc-4a263e18e7f2",
                                "text": "Наши звероводы привезли с Севера голубых песцов, пустили на остров, и дорогие звери прижились."
                            }
                        ]
                    }
                ],
