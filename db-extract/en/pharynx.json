                                            {
                                                "example_id": "28449831-f3ac-42f4-b747-b89df5c53dc1",
                                                "sense_id": "5d9bff62-a836-3fa8-8e30-993176232ecf",
                                                "text": "Ich habe eine Entzündung im Pharynx."
                                            },
                                            {
                                                "example_id": "eb9d1935-9860-4594-995f-a87bdc8c914d",
                                                "sense_id": "5d9bff62-a836-3fa8-8e30-993176232ecf",
                                                "text": "Mundhöhle und Pharynx bilden funktionell eine Einheit, in der sich Luft- und Speisewege kreuzen."
