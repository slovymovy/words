                    {
                        "translation_id": "45db4855-8f50-4d02-afe2-7beb570437c1",
                        "source_entry_id": "77f62bae-3456-3020-93b9-c338340f829a",
                        "source_sense_description": "ball of meat which has been fried or barbecued",
