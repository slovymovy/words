                                        "examples": [
                                            {
                                                "example_id": "cd79ef5b-ceb2-433e-8d8a-2ebdacb7d09d",
                                                "sense_id": "59f582f9-8c5a-39a4-a747-364882077e20",
                                                "text": "The oat stalks made good straw."
                                            },
                                            {
                                                "example_id": "82cf570b-d80e-492e-b5e0-aece09fd232e",
                                                "sense_id": "59f582f9-8c5a-39a4-a747-364882077e20",
                                                "text": "The main forms of oat are meal and bran."
                                            },
                                            {
                                                "example_id": "36ef6efd-91bd-4ae4-b9a7-b60d5d133607",
                                                "sense_id": "59f582f9-8c5a-39a4-a747-364882077e20",
                                                "text": "World trade in oat is increasing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2fb58c-ce3c-3df0-a737-2f9bfda7b287",
                                        "entry_id": "0f267537-c59e-38e6-9047-3cab02d983bf",
                                        "glosses": [
                                            "Any of the numerous species, varieties, or cultivars of any of several similar grain plants in genus Avena."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb00683-9b42-4457-88e7-746d035f911f",
                                                "sense_id": "fc2fb58c-ce3c-3df0-a737-2f9bfda7b287",
                                                "text": "The wild red oat is thought to be the ancestor of modern food oats."
                                            }
