                    "target_lang_definitions": {
                        "ru": "Похожий или одинаковый по своей природе.",
                        "tr": "Yapı veya nitelik bakımından benzeyen.",
                        "zh": "性质相似或相同的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схожий",
                                "target_lang_sense_clarification": "подобный"
