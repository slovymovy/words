                                        "glosses": [
                                            "Synonym of vaccinate (“to treat (a person or an animal) with a vaccine to produce immunity against a disease”)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32234c6f-7afd-474e-8ea7-191b0b96f54a",
                                                "sense_id": "b84a4b4e-2005-3e44-9e27-2d6a34558b81",
                                                "text": "[S]ince you have decided that the boy shall be vaccined, let us send directly for the surgeon and have it done, and then he will be safe."
