                ],
                "senses": [
                    {
                        "sense_id": "631e62f2-3ee4-39da-94e1-d02dbde47e4e",
                        "entry_id": "6651ed12-b8c0-3b83-98bd-6dc3a00a2cb6",
                        "glosses": [
                            "to submit (to), to resign oneself to"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d383d2a-929d-4674-b60b-620f0296a860",
                                "sense_id": "631e62f2-3ee4-39da-94e1-d02dbde47e4e",
                                "text": "Я не люблю́ рабо́тать. К чему́ себя́ обма́нывать? Но, е́сли ну́жно рабо́тать, я покорю́сь, коне́чно, без ро́пота. Так же покорю́сь и бо́ли, и сме́рти.",
                                "translation": "I don't like to work. Why should I deceive myself? But if it's necessary to work, I will submit, of course, without grumbling. Just as I submit to pain, and to death.",
                                "english": "I don't like to work. Why should I deceive myself? But if it's necessary to work, I will submit, of course, without grumbling. Just as I submit to pain, and to death."
                            }
                        ]
                    },
