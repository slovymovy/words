        "fr-extract.jsonl": [
            {
                "entry_id": "0371cee4-8b6e-3208-80c5-3008bc7b5a09",
                "word": "aménorrhée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db51e925-aae3-4bb9-b73c-69f45b5aec3f",
                        "entry_id": "0371cee4-8b6e-3208-80c5-3008bc7b5a09",
                        "tags": [
                            "plural"
                        ],
                        "form": "aménorrhées"
