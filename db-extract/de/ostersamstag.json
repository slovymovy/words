                "senses": [
                    {
                        "sense_id": "5c55e129-889d-38e5-9fed-333ba3556d11",
                        "entry_id": "0900314c-a736-38a5-ae11-400887b6ed84",
                        "glosses": [
                            "Samstag (sechs Tage) nach dem Ostersonntag und Vortag des Weißen Sonntags"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e724677-23b8-4521-8890-318e7084935e",
                                "sense_id": "5c55e129-889d-38e5-9fed-333ba3556d11",
                                "text": "Der Ostersamstag fiel im Jahre 2013 auf den 6. April."
                            },
                            {
                                "example_id": "add01f22-1df2-44ea-879b-be388eb9ae0b",
                                "sense_id": "5c55e129-889d-38e5-9fed-333ba3556d11",
                                "text": "Am Ostersamstag können wir uns zu einem Osterspaziergang treffen."
                            },
                            {
                                "example_id": "b9ecb1f9-02e6-4d1b-a221-b981fa875529",
                                "sense_id": "5c55e129-889d-38e5-9fed-333ba3556d11",
                                "text": "„Am Ostersamstag hatten die Siedler ihr Töpferwerk vollbracht und zogen mit den neuen Schätzen in die Kamine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54a7ce3f-9a2f-3c75-afcf-7ae43fcb4a55",
                        "entry_id": "0900314c-a736-38a5-ae11-400887b6ed84",
                        "glosses": [
                            "Karsamstag in der Karwoche, also der Tag vor Ostersonntag"
                        ],
                        "tags": [
                            "South-German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "30dba191-02a6-409e-a3ca-5450023d0d38",
