                "senses": [
                    {
                        "sense_id": "8934e76a-4582-34e0-9076-0af080b702e9",
                        "entry_id": "f8819572-6e6d-3f44-a858-ed39e98fa79d",
                        "glosses": [
                            "разг. загораться слабым пламенем (о лампаде, свече и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dec2ea6d-447d-4d39-8a0b-45891fdd69de",
                                "sense_id": "8934e76a-4582-34e0-9076-0af080b702e9",
                                "text": "Снова затепливались лампады, зажигались свечи перед образами; домочадцы и прислуга собирались на моленье."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0527a30-61f2-39f5-b3f8-14db6e4eb7c4",
                        "entry_id": "f8819572-6e6d-3f44-a858-ed39e98fa79d",
                        "glosses": [
                            "перен. возникнуть, появиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1d4c5f-5553-4f54-aee6-b092977cfb05",
                                "sense_id": "b0527a30-61f2-39f5-b3f8-14db6e4eb7c4",
                                "text": "…и опять в темной глубине моей души затепливается луч благодатной надежды…"
                            },
                            {
                                "example_id": "9f88f4bc-a6f5-49d3-a800-ecf98b42a84e",
                                "sense_id": "b0527a30-61f2-39f5-b3f8-14db6e4eb7c4",
                                "text": "В руках каждого зажигается свеча, и в душе тоже затепливается праздничный огонек; все светлее разгорается он под пение крестного хода и ярко вспыхивает при чудных звуках «Христос Воскресе!»"
                            }
                        ]
                    },
