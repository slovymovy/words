                                "target_senses": [
                                    {
                                        "sense_id": "84673e81-554a-3457-8c08-23d2793939cb",
                                        "entry_id": "f8d39e3f-b987-36dd-98b8-4b05e67f0a85",
                                        "glosses": [
                                            "diamanten waarvan de opbrengst wordt gebruikt om wapens te kopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff3f686-6509-4349-bc0d-ca0cd2a17394",
                                                "sense_id": "84673e81-554a-3457-8c08-23d2793939cb",
                                                "text": "Dit zei ze donderdagochtend in Leidschendam tijdens een getuigenis in het proces tegen Charles Taylor. De aanklagers van het Sierra Leone-tribunaal wilden weten of Campbell een zogenoemde 'bloeddiamant' heeft gekregen van de ex-president van Liberia."
                                            },
                                            {
                                                "example_id": "95c85366-fd4e-4bd0-8fec-34d0802db6cc",
                                                "sense_id": "84673e81-554a-3457-8c08-23d2793939cb",
                                                "text": "Taylor steunde deze RUF-rebellen met wapens en kreeg in ruil diamanten terug. Deze zogeheten 'bloeddiamanten' speelden een belangrijke rol tijdens het proces. De aanklager riep vorig jaar topmodel Naomi Campbell op als getuige, omdat zij ooit een bloeddiamant van Taylor zou hebben gekregen."
                                            }
