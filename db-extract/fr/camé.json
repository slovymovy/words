                        "sense_id": "19501f38-e59e-3824-9646-d031f1985f1b",
                        "entry_id": "7da3b3c8-d1f7-3b34-bb7a-2add7c7b697e",
                        "glosses": [
                            "Celui qui se came."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "30c072aa-a787-43a6-a753-1bc9a93acd7a",
                                "sense_id": "19501f38-e59e-3824-9646-d031f1985f1b",
                                "text": "Le Noir avançait en dansotant, comme le camé qu’il était peut-être."
                            },
                            {
                                "example_id": "89717484-66c7-4402-88ea-69a35b2382a5",
                                "sense_id": "19501f38-e59e-3824-9646-d031f1985f1b",
                                "text": "Je retrouve devant l'entrée de mon immeuble la petite agitation nocturne habituelle : bicraves et camés graves qui se fixent dans la tasse Decaux dont ils ont bricolé le mécanisme ouvrant la porte coulissante."
                            },
                            {
                                "example_id": "e1ff4747-4b52-426b-8305-1f6e420ba51c",
                                "sense_id": "19501f38-e59e-3824-9646-d031f1985f1b",
                                "text": "Je ne voudrais pas te créer des ennuis, mais on dirait qu'un camé s'est servi ici."
                            }
                        ]
                    }
                ],
