                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catolicismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d254d4-944a-32ab-9d3a-c4f2c589dfd4",
                                        "entry_id": "32140641-5fde-31b2-8dc8-c4c9b2fc31be",
                                        "glosses": [
                                            "Religión cristiana que está en plena comunión con el papa₂."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "542a1c3f-a8b8-401c-89df-aa48269d89fe",
                        "source_entry_id": "0876249b-9b7d-3306-a3b0-fa6172ad34e9",
                        "source_sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
                        "target_lang_word": "Katholizismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katholizismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0057f272-f6cd-3cc1-a7f9-4831af7ba1d9",
                                        "entry_id": "b1c5a773-a211-3f1e-a4f0-aa767e8bc697",
                                        "glosses": [
                                            "Gesamtheit römisch-katholischer Anschauungen, Organisationsformen und Bräuche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee700c4a-e4a0-4630-b7c3-a1c15bf1ac52",
                                                "sense_id": "0057f272-f6cd-3cc1-a7f9-4831af7ba1d9",
                                                "text": "„Ein großer Teil lebt noch in den Formen des Katholizismus, ohne leider den großen Geist dieser Formen und ihren jetzigen Übergang zum Weltgeschichtlichen zu ahnen;“"
                                            },
                                            {
                                                "example_id": "2ca5b5a4-6235-4735-97f2-7c605160434e",
                                                "sense_id": "0057f272-f6cd-3cc1-a7f9-4831af7ba1d9",
                                                "text": "„Wer den Katholizismus in Warschau sucht, könnte auch die Formel 1 in Karlsruhe suchen, er ist einfach im falschen Film.“"
                                            },
                                            {
                                                "example_id": "ab55434c-7980-48c9-a9b9-8c4c9cf4a4e2",
                                                "sense_id": "0057f272-f6cd-3cc1-a7f9-4831af7ba1d9",
                                                "text": "„Im Katholizismus suchte sie Trost, denn sie fühlte sich unglücklich in ihrem Leben.“"
                                            },
                                            {
                                                "example_id": "c3acdbde-8391-4d0d-8dca-c5255c514dd5",
                                                "sense_id": "0057f272-f6cd-3cc1-a7f9-4831af7ba1d9",
                                                "text": "„Es bereitet sich in jenen Jahren eine stetige Hinwendung zum Glauben vor, sichtbar am intensiven Bibelstudium und der immer wieder aufgenmmenen Beschäftigung mit dem 73. Psalm; Jüngers Religiosität wird 1996 in der Konversion zum Katholizismus ihren konsequenten Ausdruck finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d664d12a-8526-43fc-a75a-9c39c1d75a19",
                        "source_entry_id": "0876249b-9b7d-3306-a3b0-fa6172ad34e9",
                        "source_sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
                        "target_lang_word": "католицизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "католицизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "060f4a84-6d68-31aa-bece-9d89787af637",
                                        "entry_id": "eea6d26a-732e-3e73-9026-0acb4c0543ec",
                                        "glosses": [
                                            "крупнейшая по численности приверженцев ветвь христианства, сформировалась в I тысячелетии н. э. на территории Западной Римской империи, во главе которой стоит Папа Римский"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d4f56e-527e-41d2-be77-9036a0d306c5",
                                                "sense_id": "060f4a84-6d68-31aa-bece-9d89787af637",
                                                "text": "В Сантьяго католицизм оказался живой и весёлый, и только ради этого знания стоило проехать по дороге пилигримов."
                                            },
                                            {
                                                "example_id": "929acb28-9e52-4c47-953b-fbd19aa9e499",
                                                "sense_id": "060f4a84-6d68-31aa-bece-9d89787af637",
                                                "text": "Почти все верующие поляки и литовцы в России часть немцев исповедуют католицизм."
                                            },
                                            {
                                                "example_id": "85a6a7ff-3a34-44d6-be08-1f2e45284309",
                                                "sense_id": "060f4a84-6d68-31aa-bece-9d89787af637",
                                                "text": "В XVI веке на территории Белоруссии официальной религией стал католицизм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
