                    {
                        "translation_id": "a8cd6f32-2558-4fa8-b982-eb40cba3c080",
                        "source_entry_id": "c11f5320-906f-3792-8a4f-fb2518e29fab",
                        "source_sense_description": "fait avec une grande ardeur",
                        "target_lang_word": "frantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebed27fe-f20e-358b-ba96-82b578969c47",
                                        "entry_id": "0cedcf7a-5e62-3a70-8e04-ed94ed334017",
                                        "glosses": [
                                            "Insane, mentally unstable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e6a431-21dd-465c-8bd1-c786212b0c37",
                                                "sense_id": "ebed27fe-f20e-358b-ba96-82b578969c47",
                                                "text": "Master have mercy on my sonne, for he is franticke: and ys sore vexed."
                                            },
                                            {
                                                "example_id": "8f885d4a-ad0c-43f2-bfbb-3a981022d0c4",
                                                "sense_id": "ebed27fe-f20e-358b-ba96-82b578969c47",
                                                "text": "If with myself I hold intelligence,\nOr have acquaintance with mine own desires;\nIf that I do not dream, or be not frantic—\nAs I do trust I am not—then, dear uncle,\nNever so much as in a thought unborn\nDid I offend your Highness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370d73ff-c750-367a-8879-321759fa9d61",
                                        "entry_id": "0cedcf7a-5e62-3a70-8e04-ed94ed334017",
                                        "glosses": [
                                            "In a state of panic, worry, frenzy, or rush."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f053e3-11d0-44d8-9ef5-cc6e051b6edf",
                                                "sense_id": "370d73ff-c750-367a-8879-321759fa9d61",
                                                "text": "They returned the missing child to his frantic mother."
                                            },
                                            {
                                                "example_id": "cfc09b05-c111-43fc-9950-d2bb999510f0",
                                                "sense_id": "370d73ff-c750-367a-8879-321759fa9d61",
                                                "text": "Sir George bore the annoyances of the night as a very vain man does totally unaccustomed to mortification. He was frantic with passion; he longed to kill somebody, but he did not know who."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8990a069-84f8-3754-a6ad-5cdf4ad51300",
                                        "entry_id": "0cedcf7a-5e62-3a70-8e04-ed94ed334017",
                                        "glosses": [
                                            "Extremely energetic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c0175c-06a7-4e27-afc9-82e3cb9b96ca",
                                                "sense_id": "8990a069-84f8-3754-a6ad-5cdf4ad51300",
                                                "text": "frantic music"
                                            },
                                            {
                                                "example_id": "e3eb0bc3-8948-45c2-a151-63198139d085",
                                                "sense_id": "8990a069-84f8-3754-a6ad-5cdf4ad51300",
                                                "text": "At the end of a frantic first 45 minutes, there was still time for Charlie Adam to strike the bar from 20 yards before referee Atkinson departed to a deafening chorus of jeering from Everton's fans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "441682ca-ef44-30ac-889d-aa80ddb9e33d",
                                        "entry_id": "aaf95130-72bc-311b-8563-bbe50f815b1c",
                                        "glosses": [
                                            "A person who is insane or mentally unstable, madman."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cf4213-b3dc-4d54-8f79-437a1271b90f",
                                                "sense_id": "441682ca-ef44-30ac-889d-aa80ddb9e33d",
                                                "text": "1595, George Peele, The Old Wives’ Tale, The Malone Society Reprints, 1908, lines 3-5,\nHow nowe fellowe Franticke, what all a mort? Doth this sadnes become thy madnes?"
                                            },
                                            {
                                                "example_id": "ce91cfec-5779-4247-b642-44fefc025f2a",
                                                "sense_id": "441682ca-ef44-30ac-889d-aa80ddb9e33d",
                                                "text": "[…] who but senseless Franticks would have thoughts so poor? My Reason forsakes the government of this weak Frame, and I am fall’n into disorder […]"
                                            },
                                            {
                                                "example_id": "066701b9-afc1-42e0-bc6c-c0cafdf72f94",
                                                "sense_id": "441682ca-ef44-30ac-889d-aa80ddb9e33d",
                                                "text": "1721, Cotton Mather, diary entry for 16 July, 1721 in Diary of Cotton Mather, 1709-1724, Massachusetts Historical Society Collections, Seventh Series, Volume VIII, Boston: 1912, p. 632,\nThe Destroyer, being enraged at the Proposal of any Thing, that may rescue the Lives of our poor People from him, has taken a strange Possession of the People on this Occasion. They rave, they rail, they blaspheme; they talk not only like Ideots but also like Franticks, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
