                        "glosses": [
                            "Multiplier (une matrice A) par une autre en mettant A en premier dans la multiplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbf60ca-0e55-4a82-820a-6a0b75ca4b93",
                                "sense_id": "18280025-2529-326d-9008-0b880de8156c",
                                "text": "Post–multiplier une matrice X = [xᵢⱼ] par une matrice D_J diagonale c’est multiplier chaque colonne de X par le nombre dⱼ ;"
                            },
                            {
                                "example_id": "f3256422-768c-4c29-b542-2c62471348f4",
                                "sense_id": "18280025-2529-326d-9008-0b880de8156c",
                                "text": "Les multiplications successives, en ligne et en colonne, reviennent à pré- et à post-multiplier la matrice de départ, A, par des matrices diagonales R et S, d’où le nom de « méthode RAS » donné au procédé."
                            }
