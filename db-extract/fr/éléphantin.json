                "senses": [
                    {
                        "sense_id": "fb354edf-ca0a-3fdd-8fd5-883ff7f3dc60",
                        "entry_id": "b3e9ac9f-3efc-3d46-86b4-b7417c10c7b3",
                        "glosses": [
                            "Relatif aux éléphants, éléphantesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ad7b63-9c50-47bc-ab7f-9faa26157c64",
                                "sense_id": "fb354edf-ca0a-3fdd-8fd5-883ff7f3dc60",
                                "text": "Elle rebondit comme balle sur le dernier palier ; elle déboucha, éléphantine, dans le corridor dont tremblèrent les maigres cloisons."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea19c346-1843-304c-b46e-85eda4e83863",
                        "entry_id": "b3e9ac9f-3efc-3d46-86b4-b7417c10c7b3",
                        "glosses": [
                            "Relatif à la ville d’Éléphantine, en Égypte antique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0edb4968-58df-3d28-8179-b81d13686b8a",
                        "entry_id": "b3e9ac9f-3efc-3d46-86b4-b7417c10c7b3",
                        "glosses": [
                            "Se dit des rois égyptiens qui ont régné à Éléphantine."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf0bc5e9-f893-4059-a07d-58df320e7022",
                        "source_entry_id": "b3e9ac9f-3efc-3d46-86b4-b7417c10c7b3",
                        "source_sense_id": "fb354edf-ca0a-3fdd-8fd5-883ff7f3dc60",
                        "source_sense_description": "Éléphantesque",
                        "target_lang_word": "elephantine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elephantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f1c8de4-d780-3a43-a921-903974e52d0e",
                                        "entry_id": "3460e760-b915-3e1d-9e15-a11b28e0ba48",
                                        "glosses": [
                                            "Of, relating to, resembling, or characteristic of elephants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa397a7c-f6b6-454d-93bd-c05037f8df38",
                                                "sense_id": "6f1c8de4-d780-3a43-a921-903974e52d0e",
                                                "text": "The scene around them was currently plunged into gloom. Dark mists swirled round them and elephantine shapes lurked indistinctly in the shadows."
                                            },
                                            {
                                                "example_id": "e5bdc218-07fd-43a0-81e1-2d334bdc71d8",
                                                "sense_id": "6f1c8de4-d780-3a43-a921-903974e52d0e",
                                                "text": "This last summer Hanecki had captured Lenin’s imagination with his plans to found a trading company of his own in Europe, or take a partnership in some existing firm and make guaranteed monthly remittances to the Party out of his profits. This was not a Russian pipe dream: every move had been worked out with impressive precision. Kuba hadn’t thought of it himself, it was the brainchild of the elephantine genius Parvus, who had been writing to him from Constantinople. Parvus, once as poor as any other Social Democrat, had gone to Turkey to organize strikes, and now wrote frankly that he had all the money he needed (if rumor was right, he was fabulously wealthy) and that the time had come for the Party too to get rich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341f26a2-1995-3a42-8a21-c476e5139b42",
                                        "entry_id": "3460e760-b915-3e1d-9e15-a11b28e0ba48",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1413538-1183-4ca7-9253-4187fc5127df",
                                                "sense_id": "341f26a2-1995-3a42-8a21-c476e5139b42",
                                                "text": "He comes into Brewer from the south, seeing it in the smoky shadow before dawn as a gradual multiplication of houses among the trees beside the road and then as a treeless waste of industry, shoe factories and bottling plants and company parking lots and knitting mills converted to electronics parts and elephantine gas tanks lifting above trash-filled swampland yet lower than the blue edge of the mountain from whose crest Brewer was a warm carpet woven around a single shade of brick."
                                            },
                                            {
                                                "example_id": "05114eb5-0df0-40ed-9af8-fddb49d1a943",
                                                "sense_id": "341f26a2-1995-3a42-8a21-c476e5139b42",
                                                "text": "Ugly, clumsy and far from silent, with elephantine point mechanisms at the car sheds, it nevertheless works and has been brought up to date electrically for further public service."
                                            },
                                            {
                                                "example_id": "ba05a0c1-b266-4339-b771-8a9a4144e469",
                                                "sense_id": "341f26a2-1995-3a42-8a21-c476e5139b42",
                                                "text": "At one level, that may mean tailoring services to demand and introducing vehicles that are genuinely lighter in weight. At another, calculating the energy and emissions of track renewal - whether steel rail, concrete sleepers or mining ballast, crushing, shipping using dirty fuel, and re-handling it before finally placing and maintaining with diesel equipment. And then shortening its life though the wear and tear of tamping to counter the effect of elephantine passenger vehicles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elephantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72e7c2dd-c68b-32f4-a472-63622ebfd470",
                                        "entry_id": "7cb54a66-3340-386a-9777-9739ff057f1b",
                                        "glosses": [
                                            "Any member of the subfamily Elephantinae of elephants and their extinct close relatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "441f4c9c-abb3-4cbc-bbaa-9ab2ac4a934b",
