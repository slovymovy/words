                "senses": [
                    {
                        "sense_id": "a173b028-f063-3f0d-a479-cdb9d75fe3fd",
                        "entry_id": "a6de904e-e749-3123-ba6a-cecff0115277",
                        "glosses": [
                            "kleiner Stecken, kleiner Stock"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "30f8dee3-d9b7-49f5-86d0-23a23c96c96e",
                                "sense_id": "a173b028-f063-3f0d-a479-cdb9d75fe3fd",
                                "text": "„‚Die würd ich ja nicht mal mit nem dreckigen Steckerl anfassen, die hat doch gar keine Titten.‘“ ‚Du musst es ja wissen. Kennst dich ja aus mit Titten.‘“"
                            },
                            {
                                "example_id": "0ed49bfb-61c1-47d1-8ffc-b414ee8f11e7",
                                "sense_id": "a173b028-f063-3f0d-a479-cdb9d75fe3fd",
                                "text": "„Im Türkenschanz-Park sitzen dann die Minister, auf die man mal hinhauen wollte, weil sie so gesund und so fürchterlich waren. Die sitzen da mit einem Steckerl, vom Schlag getroffen, sitzen dann da am Bankerl und unterhalten sich mit einem kleinen Spatzen, der geschwächt ist im Föhnwetter.“"
                            },
                            {
                                "example_id": "8934ba85-2c8c-4304-8a2e-ece51c10477b",
                                "sense_id": "a173b028-f063-3f0d-a479-cdb9d75fe3fd",
                                "text": "„Nach getaner Arbeit organisierte der TuS Hohenburg eine Brotzeit am Kartoffelfeuer auf dem Acker. Die gespendeten Würstel am Steckerl schmeckten mit den frisch im Feuer gebratenen Kartoffeln besonders gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
