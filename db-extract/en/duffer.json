                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tocard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21a3c876-77bc-3f21-b82b-4212d4346d8a",
                                        "entry_id": "445a4d69-494f-3685-9955-7f3b47d55823",
                                        "glosses": [
                                            "Qui possède une grosse tête, quand on parle d'un arbre c'est qu'il s'agit d’un arbre taillé en têtard."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80411def-8d85-4926-8c7d-b4877bd3357d",
                                                "sense_id": "21a3c876-77bc-3f21-b82b-4212d4346d8a",
                                                "text": "[…] avait soigneusement retiré les ornements du coffre où il les avait remisés et les avait dissimulés dans le creux d’un vieux chêne « tocard », qu’on montrait encore aux curieux."
                                            },
                                            {
                                                "example_id": "c02efda3-8b7e-42ef-8662-239fed276273",
                                                "sense_id": "21a3c876-77bc-3f21-b82b-4212d4346d8a",
                                                "text": "\"Fr. estoc m., souche, tronc d'arbre... (Rich 1680-Trév 1752...)\"..., \"SeudreS, arbre têtard...\", \"couper une forêt à blanc estoc, sans laisser de baliveaux... 1741\", \"Provins tocard, arbre étêté, Esternay toquard, arbre coupé à 2 ou 3 m su sol...\", \"Aubertin toquard m., arbre formant une touffe au sommet...\", etc"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9407bac0-6e61-3c30-81dc-8f14f54dd9e9",
                                        "entry_id": "445a4d69-494f-3685-9955-7f3b47d55823",
                                        "glosses": [
                                            "Qui donne des coup de tête."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tocard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                        "entry_id": "a40f769e-90db-361e-b932-fd6808090c00",
                                        "glosses": [
                                            "Personne incapable, sans valeur."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2312c77-473b-494f-9247-0278c7014b1f",
                                                "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                                "text": "Car tu étais mineure, enceinte d’un tocard schizophrène qui se faisait interner tous les quinze jours à Sainte-Anne, t’as oublié ?"
                                            },
                                            {
                                                "example_id": "c64d2658-641f-4f9b-a992-e5d785d12afb",
                                                "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                                "text": "Moi, c’est les tocards à petite bite du coin qui se sentent obligés de me défier, pour montrer à leurs copains comment ils ont osé venir me remettre à ma place."
                                            },
                                            {
                                                "example_id": "04c712e5-3975-4ce9-875c-38f383f36958",
                                                "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                                "text": "Plus tocard que toi, je ne vois pas…"
                                            },
                                            {
                                                "example_id": "49f2e357-2119-4a1e-8fc1-9faecf63855e",
                                                "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                                "text": "Reste qu’en entendant, hier soir, Jadot appeler aux dons pour sauver le mouvement, je n’ai pu m'empêcher de m’effleurer un “fallait y penser avant, tocard !”, dont je ne suis pas spécialement fier"
                                            },
                                            {
                                                "example_id": "717ab296-9b34-4c8a-9170-096f9ce0bcf0",
                                                "sense_id": "c69aa6c3-d145-3c3e-a09d-2bd28479597b",
                                                "text": "Se réjouir de la défaite ce n’est pas être “dégénéré” les tocards, c’est faire preuve de bon sens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b07f1bd-f1e8-34f3-8d7e-41ced423d00f",
                                        "entry_id": "a40f769e-90db-361e-b932-fd6808090c00",
                                        "glosses": [
                                            "Cheval de course sans aucune chance de victoire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11f8746-b928-4c2d-8595-a4abf0e3dc18",
                                                "sense_id": "5b07f1bd-f1e8-34f3-8d7e-41ced423d00f",
                                                "text": "Sur un champ de courses, il était plus fréquent de perdre que de gagner. Cette douce philosophie parut le remonter un peu. — Je vais essayer de me refaire sur Café de Flore dit-il. — C’est aussi un tuyau sûr ? — Non, il paraît que c’est un tocard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb0aa261-d9d9-35d5-9552-c0dad6bca64a",
                                        "entry_id": "a40f769e-90db-361e-b932-fd6808090c00",
                                        "glosses": [
                                            "Rival médiocre et incapable, loser."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e65f5f1f-4c4c-4e88-afe1-9ef0f8b63161",
                                                "sense_id": "cb0aa261-d9d9-35d5-9552-c0dad6bca64a",
                                                "text": "Cependant, il serait absurde d’imaginer qu’une thérapeutique miraculeuse puisse faire gravir les marches du podium à un athlète de second plan ou qu’un médecin ou un médicament puisse transformer un tocard en champion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e06906-d5a8-3f58-a9a4-2411a17eaf4d",
                                        "entry_id": "a40f769e-90db-361e-b932-fd6808090c00",
                                        "glosses": [
                                            "Digitale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deb39932-697c-418a-8a83-49e3e4f6b45a",
                        "source_entry_id": "6071d2ae-bf64-3d8f-adb6-840be3f16eb0",
