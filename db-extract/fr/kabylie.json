                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7297d671-cc35-4c23-b826-2261f353e3ed",
                                                "sense_id": "bb1c9e02-c519-3be1-b495-cc71cf1910fa",
                                                "text": "In Kabylia, men never set out to find a wife. Finding a wife is the most important and essential phase."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
