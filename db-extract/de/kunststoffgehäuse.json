                ],
                "senses": [
                    {
                        "sense_id": "d198845b-de42-3736-9df1-e1e5f1c3dc1b",
                        "entry_id": "03e2083d-8426-3a09-b5cd-a30ce4e30e5b",
                        "glosses": [
                            "aus Plastik/Kunststoff bestehende Hülle zum Schutz von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7aabf4f-bd96-4293-962c-edafd86ab898",
                                "sense_id": "d198845b-de42-3736-9df1-e1e5f1c3dc1b",
                                "text": "„Das Kunststoffgehäuse war verbrannt, man sah nur noch das vom Feuer geschwärzte Gerippe aus versengtem Metall und geschmolzenen Kabeln.“"
                            },
                            {
                                "example_id": "d9c8138a-401a-4e3d-85c3-f5b40fd076ec",
                                "sense_id": "d198845b-de42-3736-9df1-e1e5f1c3dc1b",
                                "text": "„Die Platinen und viele Stromkabel sowie die Kunststoffgehäuse sind oft schwerentflammbar oder entsprechend imprägniert, damit sie bei übermäßiger Erwärmung nicht so schnell brennen.“"
                            },
                            {
                                "example_id": "5565194e-bb86-4c72-9b39-e5b7cbb6d87b",
                                "sense_id": "d198845b-de42-3736-9df1-e1e5f1c3dc1b",
                                "text": "„Sein Telefon, ein Modell aus den späten sechziger Jahren, mit Wählscheibe und grauem Kunststoffgehäuse, stand auf dem Kaminsims des Arbeitszimmers, gegenüber dem vergoldeten Spiegel.“"
                            },
                            {
                                "example_id": "47823da8-3f4a-4755-bdc3-7f50e9e0ec43",
                                "sense_id": "d198845b-de42-3736-9df1-e1e5f1c3dc1b",
                                "text": "„Dann schiebe ich die Hand in meine rechte Tasche, berühre das Kunststoffgehäuse meines Handys und schalte es stumm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
