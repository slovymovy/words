                    "frequency": "Middle",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les menaces de ses adversaires, le journaliste refuse catégoriquement de <w>reculer</w>."
                        },
                        {
                            "text": "Cette équipe courageuse ne <w>recule</w> jamais devant les défis les plus difficiles."
                        }
                    ],
                    "common_phrases": [
                        "reculer devant l'obstacle"
                    ]
                },
                {
                    "sense_id": "a630fac3-375c-3c22-9a04-69b75c8cf717",
                    "sense_definition": "Diminuer, régresser ou perdre du terrain dans un domaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouvelles mesures économiques ont permis de faire <w>reculer</w> le chômage dans tout le pays."
                        },
                        {
                            "text": "Dans cette compétition féroce, cesser de progresser revient à <w>reculer</w> face aux concurrents."
                        }
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "faire reculer la pauvreté"
                    ]
                },
                {
                    "sense_id": "a622661b-cc63-3acf-8766-3e67fddf1e33",
                    "sense_definition": "Retarder, différer ou reporter dans le temps.",
