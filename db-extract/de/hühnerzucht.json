                        "examples": [
                            {
                                "example_id": "2d76eff7-0156-44d6-add8-a2d690a76347",
                                "sense_id": "8e3c825a-fef5-386c-81bc-6056377236b0",
                                "text": "Als im 19. Jahrhundert die Hühnerzucht einen Aufschwung erfuhr und die schweren Hühnerrassen der Asiaten und Rassezüchtungen anderer Länder nach Deutschland kamen, wurde die Zucht neuer Rassen angestrebt.",
                                "translation": "Когда в XIX веке куроводство испытало подъём и тяжёлые породы кур азиатов и селекции из других стран попали в Германию, удалось вывести новые породы."
                            }
                        ]
                    }
