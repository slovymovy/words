                "senses": [
                    {
                        "sense_id": "fb869e72-fcab-31f9-9f83-e9a7a2962297",
                        "entry_id": "ac021add-47fd-3fe3-b5e6-f39d1781540f",
                        "glosses": [
                            "koele ruimte onder een gebouw waarin men voedsel kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ed3549-fa8e-4687-8b13-29573acdd9e9",
                                "sense_id": "fb869e72-fcab-31f9-9f83-e9a7a2962297",
                                "text": "Na aftrek van wat we hadden geleend en aan de Mikoelitsyns hebben teruggegeven, hebben we wel zo'n twintig zakken, die allemaal in de grootste opslagruimte van de provisiekelder liggen met daarboven, op de vloer, een laag hooi en oude gescheurde dekens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46c43196-1015-489a-bae9-8d390a102715",
                        "source_entry_id": "ac021add-47fd-3fe3-b5e6-f39d1781540f",
                        "source_sense_id": "fb869e72-fcab-31f9-9f83-e9a7a2962297",
                        "source_sense_description": "koele ruimte onder een gebouw waarin men voedsel kan bewaren",
                        "target_lang_word": "cave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ddf951-d092-36a6-9132-71e501a44bdf",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A large, naturally-occurring cavity formed underground or in the face of a cliff or a hillside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce524120-12b2-4709-b8ee-14ddab1fa4d8",
                                                "sense_id": "d5ddf951-d092-36a6-9132-71e501a44bdf",
                                                "text": "We found a cave on the mountainside where we could take shelter."
                                            },
                                            {
                                                "example_id": "fd277633-e4d5-440b-ab23-95d267fe78c1",
                                                "sense_id": "d5ddf951-d092-36a6-9132-71e501a44bdf",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515cfe6-ec24-3dd9-b408-6c3f54d1216e",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A hole, depression, or gap in earth or rock, whether natural or man-made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907f1856-2ea3-446c-80a2-1b23c3f7f9f2",
                                                "sense_id": "a515cfe6-ec24-3dd9-b408-6c3f54d1216e",
                                                "text": "Every boy at one time or another has dug a cave; I suppose because ages and ages ago his ancestors had to live in caves, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d97a07c-3977-3e82-94b6-03a66779ad15",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A storage cellar, especially for wine or cheese."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810d417d-67ad-4be5-982e-4f055f06c1e5",
                                                "sense_id": "0d97a07c-3977-3e82-94b6-03a66779ad15",
                                                "text": "This wine has been aged in our cave for thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1644731b-4fbb-3642-8e45-6935a6f39f3d",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A place of retreat, such as a man cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ae1cf1-7313-4a94-bd0f-73fc105355f4",
                                                "sense_id": "1644731b-4fbb-3642-8e45-6935a6f39f3d",
                                                "text": "My room was a cozy cave where I could escape from my family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46bfde91-0679-3822-86f5-aec6e6f73527",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A naturally-occurring cavity in bedrock which is large enough to be entered by an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc70d0e6-e4a0-4cc4-87eb-4a57d13162e6",
                                                "sense_id": "46bfde91-0679-3822-86f5-aec6e6f73527",
                                                "text": "It was not strictly a cave, but a narrow fissure in the rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5617cda1-9dd8-3d42-a83d-abb8bfbca72a",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A shielded area where nuclear experiments can be carried out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04dce17a-3b8c-406a-b630-2c640339011f",
                                                "sense_id": "5617cda1-9dd8-3d42-a83d-abb8bfbca72a",
                                                "text": "These potential radiation fields or radioactive material levels may be the result of normal operations (ie, radiation in a target cave) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb0cb7ee-adc4-3fa7-84c3-78807a86bdd8",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "Debris, particularly broken rock, which falls into a drill hole and interferes with drilling."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79db81c-16a0-42ab-a9f6-49a616cdf900",
                                                "sense_id": "cb0cb7ee-adc4-3fa7-84c3-78807a86bdd8",
                                                "text": "[…] the casing can then be placed in the hole without encountering any cave and core drilling in rock can begin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3828e9e7-29c4-318b-b6dc-62d8808c53dd",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A collapse or cave-in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a471ab98-7e75-4ca0-a3eb-528d7567f964",
                                                "sense_id": "3828e9e7-29c4-318b-b6dc-62d8808c53dd",
                                                "text": "The \"breasts\" of marble which unite the opposite lateral walls have been left standing in order to prevent a possible cave of the wall on either side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1a97bb-3e01-3b95-9fd7-39f858406745",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "The vagina."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad915c45-2c00-4ac3-8859-f6b02419423c",
                                                "sense_id": "2e1a97bb-3e01-3b95-9fd7-39f858406745",
                                                "text": "Then without a word she lay on her back in the bed, her dark blond pubic hair rising about her dark wet cave like dried brush about a hidden spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50cc4368-14ef-34a8-be91-822f36784afe",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A group that breaks from a larger political party or faction on a particular issue."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3253ba-8035-40f8-a8e4-7feb5ef9a565",
                                                "sense_id": "50cc4368-14ef-34a8-be91-822f36784afe",
                                                "text": "Without joining the cave, Hyde had abstained both in December 1956 and May 1957."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed87bbce-24c3-37d1-b75f-d719622e7367",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "Any hollow place, or part; a cavity."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7137fa8-0fdc-40cc-a863-d1cbbba39b20",
                                                "sense_id": "ed87bbce-24c3-37d1-b75f-d719622e7367",
                                                "text": "the cave of the ear"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb542ed3-12f7-331c-a796-5cda960467ab",
                                        "entry_id": "2000cd9d-46ad-3c28-be92-c6eac5088d48",
                                        "glosses": [
                                            "A code cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f353b9-3dee-4e12-97ee-1419c1ec3145",
                                                "sense_id": "cb542ed3-12f7-331c-a796-5cda960467ab",
                                                "text": "Once a code cave is created, you can execute it using either thread injection or thread hijacking. […] Additionally, you'd need to make sure that the cave properly cleans the stack."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2e3ee17-bfc9-326f-b217-be760efb00f1",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To surrender."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a115e96-f3f1-445d-ab08-cc7d02d059b7",
                                                "sense_id": "e2e3ee17-bfc9-326f-b217-be760efb00f1",
                                                "text": "He caved under pressure."
                                            },
                                            {
                                                "example_id": "1670efc3-9c15-4907-aede-fadcd684b59f",
                                                "sense_id": "e2e3ee17-bfc9-326f-b217-be760efb00f1",
                                                "text": "Eventually the NUR overplayed its hands with an all-out strike. And when Peter Parker, the then-chairman of BR, who was well regarded among his staff, called their bluff by threatening to close down the entire network, they caved in."
                                            },
                                            {
                                                "example_id": "f8fc4d66-ed0b-49ec-ba4d-8baaeb7fb4df",
                                                "sense_id": "e2e3ee17-bfc9-326f-b217-be760efb00f1",
                                                "text": "On Friday morning, Salvador Illa, the former health minister of Spain who now leads the Catalan branch of the PSOE, said the socialists would be happy to fight another general election rather than cave to Junts and the ERC’s demands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc63216-1d22-3676-ac18-0b642885fed4",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To collapse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1a2c1b-4127-4481-a689-272a03165378",
                                                "sense_id": "bfc63216-1d22-3676-ac18-0b642885fed4",
                                                "text": "First the braces buckled, then the roof began to cave, then we ran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5110341-448a-3b51-bbbb-af6d7c240e07",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To hollow out or undermine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "853b03c7-9696-42a4-aa5d-7c98002e8344",
                                                "sense_id": "b5110341-448a-3b51-bbbb-af6d7c240e07",
                                                "text": "The levee has been severely caved by the river current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc5b2ec3-b816-3109-b02c-b47b10c4d4c5",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To engage in the recreational exploration of caves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10536ecf-7a38-4448-a693-0e8f754cd8be",
                                                "sense_id": "dc5b2ec3-b816-3109-b02c-b47b10c4d4c5",
                                                "text": "Pam has been caving for 25 years. She and her husband Tim are among the top cavers in the country. They are passionate about the world hidden beneath our feet and they were to be my instructors and guides on my first ever foray below ground that didn't involve getting on the tube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f692a6-c797-3fad-a442-9c45a8f1f501",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "In room-and-pillar mining, to extract a deposit of rock by breaking down a pillar which had been holding it in place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f45707-8285-4c3d-9bec-1fa96575a744",
                                                "sense_id": "a7f692a6-c797-3fad-a442-9c45a8f1f501",
                                                "text": "The deposit is caved by knocking out the posts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f2c5ac-3e2c-37bb-aedb-66bfb99dabb9",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To work over tailings to dress small pieces of marketable ore."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40260100-38cd-4e9e-be14-a73ef1e45a5d",
                                                "sense_id": "d5f2c5ac-3e2c-37bb-aedb-66bfb99dabb9",
                                                "text": "As an indication of the miners' desperation in these years, the free miners of Wensley lowered themselves to caving for scraps of ore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c04791-3423-3843-8f44-f167e8bc0493",
                                        "entry_id": "c7379586-abac-3cac-94fb-c90d3ef376bb",
                                        "glosses": [
                                            "To dwell in a cave."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816b8b34-01ca-4716-9078-a710130d86d5",
                                                "sense_id": "e5c04791-3423-3843-8f44-f167e8bc0493",
                                                "text": "although perhaps / It may be heard at court that such as we / Cave here, hunt here, are outlaws, and in time / May make some stronger head"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c0223a9-8f48-3297-b7a9-6330de4e9a32",
                                        "entry_id": "bb96756f-af27-34bf-8280-03f01590b6e6",
                                        "glosses": [
                                            "look out!; beware!"
                                        ],
                                        "tags": [
                                            "British"
                                        ],
