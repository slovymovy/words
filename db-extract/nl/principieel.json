                "senses": [
                    {
                        "sense_id": "4fda5017-0666-3d8c-8428-0f0b53b9892a",
                        "entry_id": "920b454e-dc59-325f-b353-d014abf652b3",
                        "glosses": [
                            "betrekking hebbend op een principe (grondslag, grondidee, stelling, overtuiging)"
                        ],
                        "tags": [],
