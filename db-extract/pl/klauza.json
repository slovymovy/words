                    {
                        "translation_id": "08381100-e984-4333-a36d-57eaed364bea",
                        "source_entry_id": "b35cb3e3-5d31-3228-bb66-6a17b9ab6167",
                        "source_sense_id": "1195ab00-39a6-39dd-974a-c3419c982520",
                        "target_lang_word": "Klause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47a53d1e-7765-3847-b990-a0a4310f0d38",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "Behausung eines Einsiedlers, Einsiedelei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3733d56-3178-4b5f-890d-855f0372526f",
                                                "sense_id": "47a53d1e-7765-3847-b990-a0a4310f0d38",
                                                "text": "Er zog sich in eine Klause zurück."
                                            },
                                            {
                                                "example_id": "8a12c372-4626-438c-b356-569ba4ce545e",
                                                "sense_id": "47a53d1e-7765-3847-b990-a0a4310f0d38",
                                                "text": "„Zehn Jahre später entstand neben seiner Klause das unscheinbare »Capellgen Hagen«.“"
                                            },
                                            {
                                                "example_id": "8c20b5b7-27df-4453-905c-20adc2bbe80a",
                                                "sense_id": "47a53d1e-7765-3847-b990-a0a4310f0d38",
                                                "text": "„Endlich erblickte ich in der Ferne eine gotische Kapelle mit einer Hütte, die die Klause eines Eremiten zu sein schien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59785168-4115-3ffa-88f7-384ec4c21d69",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "kleine Wohnung, kleines Zimmer, in dem man ungestört ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1340d6c8-aeca-4dd7-882d-6b960e093771",
                                                "sense_id": "59785168-4115-3ffa-88f7-384ec4c21d69",
                                                "text": "Ich habe mir eine gemütliche Klause eingerichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f8cb267-ff7f-3cca-b35f-e9559e0f5c41",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "Schlucht, Talenge, Engpass (besonders in den Alpen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ab2951-dc11-4a0b-8243-c03171801b17",
                                                "sense_id": "4f8cb267-ff7f-3cca-b35f-e9559e0f5c41",
                                                "text": "Nun müssen wir nur noch die Klause überqueren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f36b7d9b-14db-328c-a099-864a117d1905",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "Klosterzelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c5819f-c3fb-48ba-903e-347f5bd9ce2a",
                                                "sense_id": "f36b7d9b-14db-328c-a099-864a117d1905",
                                                "text": "Die Nonne saß in ihrer Klause."
                                            },
                                            {
                                                "example_id": "73977286-cce1-4643-8c1a-18eaca5c6711",
                                                "sense_id": "f36b7d9b-14db-328c-a099-864a117d1905",
                                                "text": "„Neu war der große Kreuzgang, der die einzelnen Klausen untereinander und diese wiederum mit der Kirche und anderen gemeinsamen Einrichtungen verbindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b514b41a-4fdf-39f5-96be-f0d2f3f8614f",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "Teilfrucht von Raublattgewächsen und anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63dbaa03-115a-4353-8bcd-497061a942da",
                                                "sense_id": "b514b41a-4fdf-39f5-96be-f0d2f3f8614f",
                                                "text": "Ein Rauhblattgewächs entwickelt einsamige Klausen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a367113b-f3ba-3b41-a17c-37b80690f04f",
                                        "entry_id": "a5f70665-0847-3ae4-8387-61558d70f7b2",
                                        "glosses": [
                                            "Wehr, das ein Gewässer aufstaut"
                                        ],
                                        "tags": [
                                            "Flößerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c97826-4c47-4ea0-8187-d94a11171415",
                                                "sense_id": "a367113b-f3ba-3b41-a17c-37b80690f04f",
                                                "text": "Die Klause kann man mittels eines Verschlusses öffnen und schließen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
