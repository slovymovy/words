                "senses": [
                    {
                        "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                        "entry_id": "bed31ea3-f080-3685-8c91-981aabd11743",
                        "glosses": [
                            "Unterbrechung einer Tätigkeit am Vormittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae23387d-7c21-45df-ba58-59d66b6a1f8a",
                                "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                                "text": "„In der Vormittagspause hing ich gerade am Klettergerüst, als ich Del zum Ahornbaum am Rand des Schulhofs gehen sah.“"
                            },
                            {
                                "example_id": "2177d70b-2562-4e22-b2ec-80fa3be16fd1",
                                "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                                "text": "„Am Freitag gibt es aufgrund des Arbeitsschlusses um 12 Uhr nur die Vormittagspause.“"
                            },
                            {
                                "example_id": "60364437-56d7-441b-8133-d8e58d218738",
                                "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                                "text": "„Trinken Sie etwas zum Frühstück und den Rest in der Vormittagspause.“"
                            },
                            {
                                "example_id": "098f1aef-63e2-4261-a542-0ea4ee2f3880",
                                "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                                "text": "„In der Früh war es noch warm, aber als ich jetzt, während der recht langweiligen Geschichtsstunde aus dem Fenster blicke, scheint die Sonne von der kurzen Vormittagspause nicht zurückgekommen zu sein.“"
                            },
                            {
                                "example_id": "f3bf1a9d-a222-4ed8-b81b-06deae573b87",
                                "sense_id": "e7949284-0629-380c-9e16-1a4f8619c6e4",
                                "text": "„Beide, die Zeitschrift wie die Post, waren besondere Freuden, die sie sich für ihre Vormittagspause aufsparte, aber jetzt hielt Annie kurz inne, um ausgiebig an den Rosen zu schnuppern, die sie im Garten geschnitten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
