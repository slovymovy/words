                                "target_senses": [
                                    {
                                        "sense_id": "11fa1ba2-db63-3ac7-9c05-60229a8c0739",
                                        "entry_id": "56dd02f2-6338-3c78-972b-d37a165acd36",
                                        "glosses": [
                                            "A man who deals in scrap metal and recycled junk (originally including rags and bones, in earlier centuries)."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e13c92a-a7ec-4c8c-98e2-36339b33c468",
                                                "sense_id": "11fa1ba2-db63-3ac7-9c05-60229a8c0739",
                                                "text": "Horses and carts are never seen now and the rag and bone man is no more. In the fifties there were still those who made a living from old clothes, especially those made from natural fibres and suitable for felting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
