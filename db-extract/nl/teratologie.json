                            {
                                "example_id": "2a2d94e5-474a-4e72-ac91-3d24771f45bb",
                                "sense_id": "a5c8a162-8916-3f90-a254-6599e78caba7",
                                "text": "De enige acceptabele bescherming bestond uit de oprichting van een studiecentrum, het TIS (Teratologie Informatie Service). Dat centrum gaat in de wetenschappelijke literatuur na wat de schadelijke gevolgen zijn voor het kind nadat de moeder een bepaald geneesmiddel heeft ingenomen tijdens de zwangerschap."
                            }
                        ]
                    }
                ],
