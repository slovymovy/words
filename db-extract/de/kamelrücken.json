                        "examples": [
                            {
                                "example_id": "a0e2abc2-5cc9-4508-9b96-51c5c432c855",
                                "sense_id": "e3e68ee0-85c0-3f70-8b04-f0f3c3c9d7b6",
                                "text": "„Ein paar der Führer, die dabei sind, gehen hinterdrein, andere reiten hoch, hoch oben auf dem Kamelrücken.“"
                            },
                            {
                                "example_id": "73ddc35a-363e-4c25-9aa1-0e305dd66a10",
                                "sense_id": "e3e68ee0-85c0-3f70-8b04-f0f3c3c9d7b6",
                                "text": "„Sazan ist knapp sechs Quadratkilometer groß und sieht vom Wasser betrachtet aus wie ein brauner Kamelrücken, dessen Buckel über 300 Meter aus dem Meer emporragen.“"
                            }
                        ],
