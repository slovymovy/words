                                "sense_id": "eec347ac-a8b1-3ceb-94d2-b41df183de47",
                                "text": "Э́то ниско́лько не тру́дно.",
                                "translation": "It's not difficult at all.",
                                "english": "It's not difficult at all."
                            },
                            {
                                "example_id": "84f39be6-8279-46b6-8c2b-9c7e33a6ddcf",
                                "sense_id": "eec347ac-a8b1-3ceb-94d2-b41df183de47",
                                "text": "— Ско́лько э́то тебе́ сто́ило? — Ниско́лько.",
                                "translation": "“How much did it cost you?” “Nothing.”",
                                "english": "“How much did it cost you?” “Nothing.”"
                            }
                        ]
