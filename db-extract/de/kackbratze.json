                ],
                "senses": [
                    {
                        "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                        "entry_id": "6b3c80c9-0e7a-3012-bb54-c607e5919c6f",
                        "glosses": [
                            "eine unattraktive Person, meist eine Frau, beschreibt aber auch ein Kind oder einen Mann"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "fad982dd-de34-4a3e-9814-ec7141b4be89",
                                "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                                "text": "„Krömer prägte den Begriff der \"Kackbratze\" für besonders niederträchtige Zeitgenossen.“"
                            },
                            {
                                "example_id": "1f1b08c4-c3e1-44ec-8e9a-ccf634087079",
                                "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                                "text": "„In der letzten Sendung küsste Tessa eine Kakerlake. Fiona: „Als ich das sah, dachte ich, da haben sich zwei gefunden: Kakerlake trifft Kackbratze.“"
                            },
                            {
                                "example_id": "9e190f09-0962-472f-98fd-33361f6e344c",
                                "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                                "text": "„Wenn ich die alte Kackbratze, also diesmal Barth, schon morgens im Radio höre, ist der Tag schon gelaufen!“"
                            },
                            {
                                "example_id": "083ecd42-b8fe-4739-bc34-3247a0ff1443",
                                "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                                "text": "„Ich hab weder Bart noch Brille und ich bin keine hässliche Kackbratze!“"
                            },
                            {
                                "example_id": "f6a5b255-87ff-418d-81cb-22c1ecb83412",
                                "sense_id": "37e8c204-7e53-3158-89b4-418f1d6091bf",
                                "text": "„Und erst Scheitel, dieser Wichser. Da stülpt man der alten Kackbratze einmal den Drömel ins Klo und schon folgt der Rachefeldzug des Rosettenknutschers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
