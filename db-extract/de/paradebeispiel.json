                "senses": [
                    {
                        "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                        "entry_id": "65e7acaa-fc26-3870-b7b5-2096488df41d",
                        "glosses": [
                            "Beispiel, mit dem etwas eindeutig belegt werden kann; Beispiel, das perfekt passt"
                        ],
                        "tags": [
                            "etwas ist ein Paradebeispiel für etwas"
                        ],
                        "examples": [
                            {
                                "example_id": "6c50224c-2816-4dae-b4df-571d8060f364",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Starallüren sind der Sägebrecht [Anmerkung: der Schauspielerin Marianne Sägebrecht] fremd. Sie ist das Paradebeispiel für Bodenständigkeit und Erfolg.“"
                            },
                            {
                                "example_id": "cd24584e-eeb2-4511-85e0-747236924bdc",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Kanada ist kein Paradebeispiel in Sachen Umweltpolitik. Vor vier Jahren stieg das Land aus dem Kyoto-Protokoll aus.“"
                            },
                            {
                                "example_id": "03b6e806-61c1-4a79-a695-b298d88504b1",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Paradebeispiele für eine vorausschauende Planung [Anmerkung: bei der Endlagerung von Atommüll] hingegen sind Länder wie Schweden und Finnland.“"
                            },
                            {
                                "example_id": "8a023d03-b5a8-4e44-9855-7956425a3e03",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Von oben sieht man überall große Jauchegruben, rotbraun schimmern sie in der Sonne. Was Rick Dove aus dem Flugzeug zeigt, ist ein Paradebeispiel für hochindustrielle Landwirtschaft.“"
                            },
                            {
                                "example_id": "a8965d55-d0c0-49bf-ba2a-ef8dc0bedaa5",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "Die Primzahlen 11 und 5 sind das Paradebeispiel für zwei nebeneinanderliegende \"sexy Primzahlen\" (deren Abstand sechs ergeben muss). Es gilt: 11 - 5 = 6."
                            },
                            {
                                "example_id": "56bf3d57-d0d8-4bf8-81cd-f6aeba9bda3f",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„»Ich glaube, der Brexit ist ein Paradebeispiel dafür, dass populistische Versprechungen oft nicht der Realität entsprechen.«“"
                            },
                            {
                                "example_id": "692a16a7-77b1-43ce-ae8b-84f73224ccc9",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Als Paradebeispiel dafür, wie eine Distribution bereits während der frühen Entwicklung Gesprächsstoff bieten kann, ist die unermüdliche und sehr persönliche Präsentation von Solus durch Entwickler Ikey Doherty auf Google Plus.“"
                            },
                            {
                                "example_id": "f1f02e6a-af95-473e-bb21-4f3b7b1e89aa",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Der österreichische Nationaldichter Franz Grillparzer ist ein Paradebeispiel für die problematische Instrumentalisierung eines Werks und seines Verfassers durch nationale Interessen.“"
                            },
                            {
                                "example_id": "a2d3e3ff-d131-410c-8c86-c6fbf192831a",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "„Das Handspiel von Marc Cucurella im Viertelfinale der EM 2024 zwischen Spanien und Deutschland ist ein Paradebeispiel für einen offensichtlichen Verstoss gegen die Handspielregelung.“"
                            },
                            {
                                "example_id": "41238a47-a1f8-4316-9887-fc0d5166ef22",
                                "sense_id": "76647de8-d38d-3be6-a7a5-0626d727b069",
                                "text": "[19. Februar 1945: Die Schlacht um die Insel Iwojima] „gilt heute als Paradebeispiel einer klassischen amphibischen Landeoperation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
