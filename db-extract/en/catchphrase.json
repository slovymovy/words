                    {
                        "translation_id": "b193ea79-2db6-4cdb-a1c8-1058b1a27b13",
                        "source_entry_id": "95ea19ca-2484-3d14-a6a5-b15f68ebf8c4",
                        "source_sense_description": "a repeated expression",
                        "target_lang_word": "Ausspruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausspruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e595ab2-8fa0-368f-b89c-709c335c77fa",
                                        "entry_id": "e9fcc42a-bdbe-3f91-83dc-070317cca283",
                                        "glosses": [
                                            "eine kurze, wichtige Aussage, oft von berühmten Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1ed25e-06cd-4c69-8ed0-6b17e39275f1",
                                                "sense_id": "2e595ab2-8fa0-368f-b89c-709c335c77fa",
                                                "text": "„Diese Ansicht gegen die Romantik gipfelte in Goethes Ausspruch ‚Klassisch ist das Gesunde, romantisch das Kranke.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21fdc866-2626-3e6d-81da-619d6dd49ff9",
                                        "entry_id": "e9fcc42a-bdbe-3f91-83dc-070317cca283",
                                        "glosses": [
                                            "Mitteilung, Entscheidung einer juristischen Instanz oder juristisch relevante (Willens-)Erklärung einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3213817c-e6a5-4f95-a0d7-fe68c8db4391",
                                                "sense_id": "21fdc866-2626-3e6d-81da-619d6dd49ff9",
                                                "text": "„Allein der schriftlich dem Täter zur Kenntnis gegebene gerichtliche Ausspruch reicht aus, um ihn zum Befolgen der getroffenen Anordnungen zu veranlassen.“"
                                            },
                                            {
                                                "example_id": "07f4c3f1-c8cb-477c-8cc1-22661f211bff",
                                                "sense_id": "21fdc866-2626-3e6d-81da-619d6dd49ff9",
                                                "text": "„Das Risiko des Arbeitgebers, dass ihm bei dem Ausspruch der Kündigung Fehler unterlaufen und die Kündigung […] von den Arbeitsgerichten als unwirksam bewertet wird, ist erheblich.“"
                                            },
                                            {
                                                "example_id": "d81509f8-5214-44e6-88ea-ecd2c109e2b4",
                                                "sense_id": "21fdc866-2626-3e6d-81da-619d6dd49ff9",
                                                "text": "„Das Eigentum überhaupt kann durch den Willen des Eigentümers; durch das Gesetz, und durch richterlichen Ausspruch verloren gehen.“"
                                            },
                                            {
                                                "example_id": "271a2f3b-39e8-4197-98ad-a7878abaf87d",
                                                "sense_id": "21fdc866-2626-3e6d-81da-619d6dd49ff9",
                                                "text": "„Der Antrag kann bis zum Ausspruch der Annahme formlos zurückgenommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
