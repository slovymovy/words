                                        "examples": [
                                            {
                                                "example_id": "6626d31f-40cb-40f2-8e3f-5fda85e220a1",
                                                "sense_id": "71292fde-2764-314b-a7a1-3a59a229d82c",
                                                "text": "Une expédition autrichienne, participant aux observations circumpolaires de 1882-1883, établit une station d’hivernage à Jan-Mayen."
                                            },
                                            {
                                                "example_id": "c21f06a1-f652-42e9-9f57-01af11aad134",
                                                "sense_id": "71292fde-2764-314b-a7a1-3a59a229d82c",
                                                "text": "Le courant circumpolaire antarctique est un courant marin faisant le tour de l’Antarctique, d’ouest en est."
