                    },
                    {
                        "sense_id": "1d9fdc88-f5a2-35d9-acf7-785f9df7195f",
                        "entry_id": "f51027e4-3a96-3459-a15d-694d4543c43e",
                        "glosses": [
                            "demonstracja (protest uliczny)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08e54e8e-fc3e-47b2-a58f-c4279d30d9c8",
                        "source_entry_id": "f51027e4-3a96-3459-a15d-694d4543c43e",
                        "source_sense_id": "fbb89e3b-4945-35d7-8175-bc04a322a03f",
                        "target_lang_word": "demo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2678e61d-bec6-30ec-b724-8cf15749aad3",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A demonstration or visual explanation."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d81b56d-028c-4521-a432-8579180a9b8e",
                                                "sense_id": "2678e61d-bec6-30ec-b724-8cf15749aad3",
                                                "text": "The professor prepared a demo to help her class understand the topic."
                                            },
                                            {
                                                "example_id": "2e99b032-11fd-4b63-bc40-a0030c1680aa",
                                                "sense_id": "2678e61d-bec6-30ec-b724-8cf15749aad3",
                                                "text": "ER received the first of its own HSTs on September 7 1977, with a handover taking place at York. It then worked a demo run to Darlington with power cars 43057 and 43056."
                                            },
                                            {
                                                "example_id": "6b7c7c5b-a1d5-4f87-93a1-56b30baffcf9",
                                                "sense_id": "2678e61d-bec6-30ec-b724-8cf15749aad3",
                                                "text": "But she added that “public demos like this are important for building truly robust conversational AI systems and bridging the clear gap that exists today before such systems can be productionized.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ed0d3de-ae80-3aee-9351-b06cfbe79abc",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A recording of a song meant to demonstrate its overall sound for the purpose of getting it published or recorded more fully."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d439b2cc-4c04-4caf-a4c4-0931371bc0d0",
                                                "sense_id": "6ed0d3de-ae80-3aee-9351-b06cfbe79abc",
                                                "text": "After hearing the demo the record label approved funding to record the song with a full band."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76453c6d-afac-3acd-999d-f5e6faf406aa",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "An example of a product used for demonstration and then sold at a discount."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a10650ed-2b88-37cd-81d6-70d26bb1f935",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A march or gathering to make a political protest."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c7f7a0-b317-44fe-abbc-3e43eeeb186e",
                                                "sense_id": "a10650ed-2b88-37cd-81d6-70d26bb1f935",
                                                "text": "Elli standing there, takes a sip of her tea, fixes hostile eyes on Somraj and says, ‘Well, what are you waiting for? You signed the petition against yourself, will you now join our demo against you?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32cf07a3-05a3-33d3-b65d-8c16f80e8135",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "An edition of limited functionality to give the user an example of how the program works."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3963cbae-7a33-417b-8374-7ae6fc5f3649",
                                                "sense_id": "32cf07a3-05a3-33d3-b65d-8c16f80e8135",
                                                "text": "The game's developers released a demo version to the public 3 months before the full release."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A non-interactive audiovisual computer program developed by enthusiasts to demonstrate the capabilities of the machine. See demoscene."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd3eb5d-809f-4120-b5f9-b2b42d28ea7f",
                                                "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                                                "text": "Effect 6: Gouraud spacecut - Probably the worst effect in the demo - has been done miles better before!"
                                            },
                                            {
                                                "example_id": "335c318d-fe27-4122-b67b-f6065b8e9845",
                                                "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                                                "text": "This party will have it all for the Amiga scener: demos, competitions, dealers, and huge projection screen and sound system to entertain you."
                                            },
                                            {
                                                "example_id": "d5353462-e4cf-421b-beaa-fe8d33b64d86",
                                                "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                                                "text": "Though the idea of procedural textures has been around for years, they have primarily been exploited by the demo scene, made famous by impressive demos like kkrieger, and haven't hit it big in the game industry yet[…]"
                                            },
                                            {
                                                "example_id": "c97199e4-152f-46b3-86e2-b4e4958b834d",
                                                "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                                                "text": "A very successful PC demo from 1993, Second Reality from Future Crew[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b388c5-5455-3c96-bd20-0966ef7b069b",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A democrat."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3926b196-4cde-3745-a0a9-ca8ef2f705bb",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "A demographic group."
                                        ],
                                        "tags": [
                                            "collective",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5475f688-86d1-43ab-af31-341b9a36137e",
                                                "sense_id": "3926b196-4cde-3745-a0a9-ca8ef2f705bb",
                                                "text": "No more ‘is it good?’ or even ‘is it original?’, only ‘does it work in the demo?’ – ‘demo’ as in ‘demographics’, not to be confused with ‘democracy’, much less ‘demonstration’."
                                            },
                                            {
                                                "example_id": "8d9ce93a-a37a-40f2-a39c-2f5052dd0810",
                                                "sense_id": "3926b196-4cde-3745-a0a9-ca8ef2f705bb",
                                                "text": "Our target demo is sports-minded families, and a good part of our clientele is moms who are with dad and the kids."
                                            },
                                            {
                                                "example_id": "ed610d8c-4893-4d68-9641-365c0f0399bc",
                                                "sense_id": "3926b196-4cde-3745-a0a9-ca8ef2f705bb",
                                                "text": "Where taste communities and Nielsen demos differ is in the way they’re used. Demo ratings are how linear networks measure success; taste communities are the tool Netflix relies on to drive viewers to new material it estimates they might want to watch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90183966-2cbf-3d11-9579-670cb78d8bbf",
                                        "entry_id": "bc5c2243-015a-3ad4-9105-7539b369c133",
                                        "glosses": [
                                            "Demolition."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ef36c9-8886-4b28-b699-f56b1e6ac9f3",
                                                "sense_id": "90183966-2cbf-3d11-9579-670cb78d8bbf",
                                                "text": "The demo portion of the reno project is the relatively fast and inexpensive part. The rebuilding takes more time and money."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76eebc39-007c-33eb-90a6-4db6d63a689d",
                                        "entry_id": "7ed1a509-da93-38fb-b00c-011860002051",
                                        "glosses": [
                                            "designed to test consumers' interest in a retail item prior to purchasing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ffd0f6-52a6-44da-a49d-3464ed4b119c",
                                                "sense_id": "76eebc39-007c-33eb-90a6-4db6d63a689d",
                                                "text": "This Nutty Kid leavin' 'Crazy Face Selfies' On Demo Products..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "340eb10f-f07a-3815-8662-2ba99e29f4bc",
                                        "entry_id": "dfa75ac7-aa2e-3ded-973f-e8e53ad19ac4",
                                        "glosses": [
                                            "To record a demo version of a song, usually not intended for commercial release."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd7d8e3c-afd0-4b9e-936c-daf522c2bae0",
                                                "sense_id": "340eb10f-f07a-3815-8662-2ba99e29f4bc",
                                                "text": "The band demoed thirty songs. Their manager thought that ten of the songs would make a good record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b584c9ba-809a-3044-96bc-80a309fa746c",
                                        "entry_id": "dfa75ac7-aa2e-3ded-973f-e8e53ad19ac4",
                                        "glosses": [
                                            "To demonstrate."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "demo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc68acc9-9dba-337d-a1ee-d7cafd9dc2fa",
                                        "entry_id": "151a0384-9a9e-342a-8dac-d593dc56431c",
                                        "glosses": [
                                            "To demolish (especially a house or fixture)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710a2aca-4a08-455d-a153-2c2461311960",
                                                "sense_id": "fc68acc9-9dba-337d-a1ee-d7cafd9dc2fa",
                                                "text": "This means we are going to demo the house to the dirt, or hopefully leave one wall standing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3e0ec06-99cd-452f-bc9b-add4d6422381",
                        "source_entry_id": "f51027e4-3a96-3459-a15d-694d4543c43e",
