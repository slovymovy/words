                ],
                "senses": [
                    {
                        "sense_id": "18fddef4-e61f-36f5-a628-ebfe9dfd98b8",
                        "entry_id": "70cdbad4-7384-351c-be10-db6f3ae65f75",
                        "glosses": [
                            "указывать на кого-либо, что-либо в подтверждение или в оправдание чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cffa973-52c2-4b71-9703-e04436c50892",
                                "sense_id": "18fddef4-e61f-36f5-a628-ebfe9dfd98b8",
                                "text": "Он не ссылается никогда на сложности, которыми оправдывают своё безделье нерадивые чиновники."
                            },
                            {
                                "example_id": "20a523c4-6967-47e9-9aee-e5389b1e2f81",
                                "sense_id": "18fddef4-e61f-36f5-a628-ebfe9dfd98b8",
                                "text": "Они любят ссылаться на древнюю историю и мифологию."
                            }
                        ]
                    },
                    {
                        "sense_id": "88a9ee6f-b5ec-3f66-9af8-2a6a0298aa48",
                        "entry_id": "70cdbad4-7384-351c-be10-db6f3ae65f75",
                        "glosses": [
                            "страд. к ссылать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25c162d-e151-4971-8e1a-3f91d0b9b0f5",
                                "sense_id": "88a9ee6f-b5ec-3f66-9af8-2a6a0298aa48",
                                "text": "Как видно из истории, не одни опальные царедворцы и воеводы ссылались в свои деревни; но и другие, послужив Богу и царю, удалялись на отдохновение в свои родовые или жалованные имения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33225bbc-ff1c-4777-9562-505a6b15606c",
                        "source_entry_id": "70cdbad4-7384-351c-be10-db6f3ae65f75",
                        "source_sense_description": "указывать на кого-либо, что-либо в подтверждение или в оправдание чего-либо",
                        "target_lang_word": "invoquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invoquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                                        "entry_id": "3327584b-2ddd-3c18-9cf9-1b5b83458dfb",
                                        "glosses": [
                                            "Appeler à son secours, à son aide, par une prière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d7f9951-360e-46aa-b383-4f3e26195c0a",
                                                "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                                                "text": "Répétez avec la Vénérable Jeanne de Matel :\n« Vierge sainte, l’abîme d’iniquité et de bassesse invoque l’abîme de force et de splendeur, pour parler de votre suréminente gloire. » Hein, est-ce assez bien tourné ? notre ami."
                                            },
                                            {
                                                "example_id": "b55fd0a4-d70c-4354-a80d-8aa3e41e45c8",
                                                "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                                                "text": "Il serait bon encore d'invoquer la protection du grand thaumaturge vers qui des milliers et des milliers de pèlerins venaient de toutes les provinces, de toutes les nations."
                                            },
                                            {
                                                "example_id": "ed92edcf-ebc0-41e1-a7d6-171285970f24",
                                                "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                                                "text": "Les poètes invoquent souvent Apollon, les muses et les autres divinités de la Fable."
                                            },
                                            {
                                                "example_id": "f1228907-d0b5-490f-860d-7a52c3dce904",
                                                "sense_id": "9a5a42bd-fdd4-3aca-a4f1-361f2ef70959",
                                                "text": "Invoquer le secours, l’aide, la clémence, de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "409ae0c2-43ff-3aa9-8050-f3d0b6dcaf00",
                                        "entry_id": "3327584b-2ddd-3c18-9cf9-1b5b83458dfb",
                                        "glosses": [
                                            "Citer en sa faveur ; en appeler à."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc62847e-3d4d-4147-af74-9723c047fa80",
                                                "sense_id": "409ae0c2-43ff-3aa9-8050-f3d0b6dcaf00",
                                                "text": "Invoquer une loi, un témoignage, une autorité, le droit commun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d4f1b10-9ac1-33f4-813a-a4c41b21e29b",
                                        "entry_id": "3327584b-2ddd-3c18-9cf9-1b5b83458dfb",
                                        "glosses": [
                                            "Mettre en avant pour expliquer un insuccès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3473e439-d351-43e7-90b1-6918802e98b7",
                                                "sense_id": "1d4f1b10-9ac1-33f4-813a-a4c41b21e29b",
                                                "text": "Si la réussite d'un pétanquiste chevronné est imputable à sa capacité technique, il en va autrement de l'échec. Celui-ci est attribué à des causes extérieures au joueur, qui pour l'expliquer invoque la « déveine »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
