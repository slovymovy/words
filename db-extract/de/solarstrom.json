                "senses": [
                    {
                        "sense_id": "5b7d149b-5f74-3dc9-81bf-db99423fe475",
                        "entry_id": "0dab3d7f-2af0-3833-a526-a8943208b057",
                        "glosses": [
                            "elektrische Energie, die mit einer Photovoltaikanlage aus der Sonnenstrahlung gewonnen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6bbe14f1-a8a2-43d9-a34a-d9f7942c3f8c",
                                "sense_id": "5b7d149b-5f74-3dc9-81bf-db99423fe475",
                                "text": "„Während das klassische Modell batteriebetrieben ist (Laufzeit: sechs Monate) und seine Oberfläche ein großer durchsichtiger Kristall ziert, lässt sich die zweite Version – die einen violetten Kristall bietet – mit Solarstrom betreiben.“"
                            },
                            {
                                "example_id": "f647d3f6-6444-4830-b56f-94f481dbe027",
                                "sense_id": "5b7d149b-5f74-3dc9-81bf-db99423fe475",
                                "text": "„Deutschlands Industrie hat eine neue große Vision: Solarstrom aus afrikanischen Wüstengebieten soll Europa mit Energie versorgen.“"
                            },
                            {
                                "example_id": "573157dc-4a82-4b75-b014-c2f4ad3fc12f",
                                "sense_id": "5b7d149b-5f74-3dc9-81bf-db99423fe475",
                                "text": "„Das Camp war auch umweltfreundlich, produzierte Solarstrom und verarbeitete alle Küchenabfälle zu Kompost, mit dem der ausgedehnte Gemüsegarten gedüngt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
