                        "glosses": [
                            "Photographier selon les principes de la lomographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36491cb7-d58a-49dc-985c-1ea4e1ee2982",
                                "sense_id": "b8e6dbf4-60c8-3c68-be3b-58f00b3ada41",
                                "text": "Charlotte Poupon présente le Lomo, ses petits copains et quelques astuces lomographiques pour lomographier au quotidien avec beaucoup d'illustrations"
                            },
                            {
                                "example_id": "4d073e72-791d-4230-9dcf-3e13d875671a",
                                "sense_id": "b8e6dbf4-60c8-3c68-be3b-58f00b3ada41",
                                "text": "Sinon j'ai découvert ce service qui permet de « lomographier » n'importe laquelle de vos photos (à uploader, en ligne, ou via Flickr) : Dumpr."
                            },
                            {
                                "example_id": "f30a5e86-7b0a-4337-b5ef-e9463c709ca0",
                                "sense_id": "b8e6dbf4-60c8-3c68-be3b-58f00b3ada41",
                                "text": "Je vous laisse, je vais Lomographier la photo de ma fille !"
                            }
                        ]
