{
    "word_family": [
        "funicular",
        "funicle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "455e8992-1669-33a9-a439-2e5d34783f94",
                    "sense_definition": "Any of several cordlike anatomical structures, especially the umbilical cord or a major bundle of nerve fibers in the spinal cord.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The posterior <w>funiculus</w> of the spinal cord transmits sensory information toward the brain.",
                            "target_lang_translations": {
                                "ru": "Задний <w>канатик</w> спинного мозга передает сенсорную информацию к головному мозгу."
                            }
                        },
                        {
                            "text": "Damage to the lateral <w>funiculus</w> can severely impair motor control below the level of the injury.",
                            "target_lang_translations": {
                                "ru": "Повреждение бокового <w>канатика</w> может серьезно нарушить двигательный контроль ниже уровня травмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "umbilical cord"
                    ],
                    "common_phrases": [
                        "lateral funiculus",
                        "posterior funiculus",
                        "anterior funiculus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из нескольких анатомических структур канатиковидной формы, особенно пуповина или крупный пучок нервных волокон в спинном мозге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канатик",
                                "target_lang_sense_clarification": "анатомия, спинной мозг"
                            },
                            {
                                "target_lang_word": "пуповина",
                                "target_lang_sense_clarification": "пупочный канатик"
                            },
                            {
                                "target_lang_word": "пучок нервных волокон",
                                "target_lang_sense_clarification": "неврология"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fda0bb05-e669-38d3-a124-7af092641e2c",
                    "sense_definition": "The stalk that attaches an ovule or a seed to the placenta within a plant's ovary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elaiosome emerges from the <w>funiculus</w> to attract foraging ants.",
                            "target_lang_translations": {
                                "ru": "Элайосома формируется из <w>семяножки</w>, чтобы привлекать муравьев-фуражиров."
                            }
                        },
                        {
                            "text": "Nutrients travel through the <w>funiculus</w> to support the developing seed.",
                            "target_lang_translations": {
                                "ru": "Питательные вещества поступают через <w>семяножку</w>, обеспечивая развитие семени."
                            }
                        }
                    ],
                    "synonyms": [
                        "funicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стебелек, прикрепляющий семязачаток или семя к плаценте внутри завязи растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семяножка",
                                "target_lang_sense_clarification": "ботаника"
                            },
                            {
                                "target_lang_word": "фуникулюс",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}