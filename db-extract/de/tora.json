                "senses": [
                    {
                        "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                        "entry_id": "bbdb550e-0961-3047-a504-3db560581649",
                        "glosses": [
                            "jüdische Religion: alternative Schreibweise von Thora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e846a6-0fd5-4833-9263-b66ae1161202",
                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                "text": "„Im Kanon der Juden hat die Tora bei weitem den 1. Rang gegenüber den Propheten und \"Schriften\", die nur als Ergänzung zu ihr verstanden wurden und ihre Autorität aus der Übereinstimmung mit ihr empfingen.“"
                            },
                            {
                                "example_id": "de15a78c-d8ab-4dd9-9ee2-f2c292640d1b",
                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                "text": "„Die wichtigsten Gebote der Tora sind in dieser rabbinischen ebenso wie in der urchristlichen Tradition die Zehn Gebote und das Gebot der Nächstenliebe.“"
                            },
                            {
                                "example_id": "9a9a5c30-6311-4686-8240-06eb3c97050a",
                                "sense_id": "7f989f08-9e15-3e2a-850b-2de5728a472a",
                                "text": "„Bei einem anderen Paket beschrieb Helena ihn mit Bart, Schläfenlocken, einer Kippa auf dem Kopf und mit großen, braunen Augen, klug, jemand, der die Tora kannte und ihre Gebote erfüllte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
