                                "target_senses": [
                                    {
                                        "sense_id": "127b449d-23c0-3637-81ff-9c9339e65068",
                                        "entry_id": "19555969-bfb6-3d35-85fa-8a95fb2aa484",
                                        "glosses": [
                                            "Persona que se dedica a prestar dinero, bienes o servicios cobrando una cuota alta o intereses excesivos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0b195a-d0f8-4fa7-9167-821aa5e784fe",
                                                "sense_id": "127b449d-23c0-3637-81ff-9c9339e65068",
                                                "text": "Mi hermana recibía amenazas de parte de un usurero porque le debía"
                                            }
                                        ],
