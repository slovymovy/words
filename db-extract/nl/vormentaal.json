                        "examples": [
                            {
                                "example_id": "176ef6d2-1a09-41df-8746-64f20e3acaf1",
                                "sense_id": "7f7e3e58-17c7-3fa2-accf-2e579124e41e",
                                "text": "De modernisten daagden de oude vormentaal van de kunst uit door figuratieve kunst, gebaseerd op een waarneming van de werkelijkheid, niet meer als uitgangspunt te nemen."
                            },
                            {
                                "example_id": "b54ded46-f5f3-4bec-adad-317c2fd2ffb4",
                                "sense_id": "7f7e3e58-17c7-3fa2-accf-2e579124e41e",
                                "text": "Botero maakte in zijn kenmerkende vormentaal ook mollige versies van klassieke meesterwerken als de Mona Lisa. Zelfs in zijn stillevens en landschappen barsten de onderwerpen als volgeblazen ballonnen uit hun contouren."
                            },
                            {
                                "example_id": "948dfecb-b94c-4720-855a-1424bacc8350",
                                "sense_id": "7f7e3e58-17c7-3fa2-accf-2e579124e41e",
                                "text": "Typisch voor dit verschijnsel is Joan Bosca die naar de taal van het nieuwe overwicht overstapt en als Juan Boscán in de Castiliaanse literatuur de nieuwe Italiaanse, metrische vormentaal invoert waarvan dan onder meer Garcilaso gebruik zal maken."
                            }
                        ]
                    }
