                "senses": [
                    {
                        "sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                        "entry_id": "3e8e028f-a57b-3339-bda2-f540864442fe",
                        "glosses": [
                            "Télésurveillance par caméra interposée."
                        ],
                        "tags": [
                            "Sécurité"
                        ],
                        "examples": [
                            {
                                "example_id": "c96f80b7-04d1-4bb9-a945-00de53a0ed91",
                                "sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                                "text": "Dans l’affaire Alves, les employés de la discothèque ont empêché l’accès aux toilettes VIP, lieu présumé de l’agression, et ils ont remis les bandes de vidéosurveillance à la police."
                            },
                            {
                                "example_id": "23d693ac-f312-4e5f-ab74-1cfb52246a58",
                                "sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                                "text": "La vidéosurveillance a capté, le 10 décembre au soir, le drôle de manège du Touran et une masse sombre non identifiée dans l'habitacle."
                            },
                            {
                                "example_id": "c8c5b7de-1cac-447e-9596-2571ce637df6",
                                "sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                                "text": "La Cour des comptes réclame depuis plus d’une dizaine d’années une évaluation sérieuse de la vidéosurveillance. Il y a eu une étude d'un chercheur qui montrait que dans les résolutions d’enquêtes, la vidéosurveillance avait été utile, mais dans un nombre infime. Il y a une distorsion de plus en plus grande entre les discours sécuritaires et les outils de surveillance."
                            },
                            {
                                "example_id": "b73581f7-a25c-4d06-af43-11946297066e",
                                "sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                                "text": "On ne peut pas vivre sans AliPay. Nous avons la reconnaissance faciale; la vidéosurveillance est partout. Ça ne me fait pas de tort pour le moment, jusqu’ici ça ne m’a pas fait de mal réel, donc je ne suis pas si inquiet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f4d1f17-8126-4ac6-adde-8c27ac705c12",
                        "source_entry_id": "3e8e028f-a57b-3339-bda2-f540864442fe",
                        "source_sense_id": "9d9c40cb-1dba-3299-8b25-98f95955667d",
                        "target_lang_word": "Videoüberwachung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Videoüberwachung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c64383a-7d2f-3676-b73c-fa5b12047597",
                                        "entry_id": "81132efc-974a-3955-88c8-bda9b9bd7b96",
                                        "glosses": [
                                            "visuelle Überwachung von Räumen, Plätzen, Anlagen mittels Überwachungskamera"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d842ee4-656c-4b70-925a-75d949e89623",
                                                "sense_id": "6c64383a-7d2f-3676-b73c-fa5b12047597",
                                                "text": "„Die Videoüberwachung an Bahnhöfen, in Zügen und auf öffentlichen Plätzen soll ausgebaut werden.“"
                                            },
                                            {
                                                "example_id": "0d412957-dac9-4ec4-ba9f-8711836abf2e",
                                                "sense_id": "6c64383a-7d2f-3676-b73c-fa5b12047597",
                                                "text": "„Die technischen Möglichkeiten der Videoüberwachung haben sich in den vergangenen Jahren dramatisch verfeinert.“"
                                            },
                                            {
                                                "example_id": "4c8e2add-49c5-46d1-ad7e-87899ca06109",
                                                "sense_id": "6c64383a-7d2f-3676-b73c-fa5b12047597",
                                                "text": "„Geplant ist zudem eine bessere Videoüberwachung an Bahnhöfen, in Zügen und auf öffentlichen Plätzen.“"
                                            },
                                            {
                                                "example_id": "f6b6163f-2796-4cee-ad11-08427f39f621",
                                                "sense_id": "6c64383a-7d2f-3676-b73c-fa5b12047597",
                                                "text": "„Mit mehr Videoüberwachung will die Bahn ihr Personal künftig vor gewalttätigen Angriffen schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
