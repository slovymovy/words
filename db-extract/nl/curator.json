                "senses": [
                    {
                        "sense_id": "c3305b67-1e3b-36c9-a639-124de3d066f3",
                        "entry_id": "6d64cb36-4d97-32d8-b4f7-f312f62e3804",
                        "glosses": [
                            "iemand die door de rechter is aangewezen om het beheer te voeren over de bezittingen van een natuurlijk persoon of van een rechtspersoon (curatele, faillissement)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "31a9e7d9-dff3-4a12-9d20-c83b2723820f",
                                "sense_id": "c3305b67-1e3b-36c9-a639-124de3d066f3",
                                "text": "De curator regelde snel een vlotte doorstart van het bedrijf."
                            },
                            {
                                "example_id": "778d2e5a-9f8f-4584-a0a7-6cf13c324dfb",
                                "sense_id": "c3305b67-1e3b-36c9-a639-124de3d066f3",
                                "text": "De vader van Britney Spears stapt op als haar toezichthouder. Dat meldt entertainmentwebsite TMZ op basis van nieuwe juridische documenten. Het is een grote overwinning voor Spears, die dertien jaar geleden onder curatele werd gesteld. Haar vader Jamie bepaalt sindsdien wat ze met haar geld en bezittingen kan doen. Spears wil haar vader kwijt als curator omdat hij volgens haar in die rol een negatieve invloed uitoefent op haar zakelijke en privéleven."
                            },
                            {
                                "example_id": "53705a8c-d902-4ade-875e-a8536a74c63c",
                                "sense_id": "c3305b67-1e3b-36c9-a639-124de3d066f3",
                                "text": "Twee weken na de aanvraag had hij ineens een telefoontje gekregen: ‘Uw bedrijf is failliet verklaard, ik ben uw curator.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "d74ffbb6-aca5-365c-beca-86ec87cf7dde",
                        "entry_id": "6d64cb36-4d97-32d8-b4f7-f312f62e3804",
                        "glosses": [
                            "lid van de raad van toezicht over een instelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ca1981-b599-4f63-892f-e45cb9786ee9",
                                "sense_id": "d74ffbb6-aca5-365c-beca-86ec87cf7dde",
                                "text": "Hij was eerder curator van het wetenschappelijk bureau van de VVD, en tweemaal Europees lijstduwer van de Partij voor de Dieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "e716a060-da9d-38e5-a51b-a2566fc41020",
                        "entry_id": "6d64cb36-4d97-32d8-b4f7-f312f62e3804",
                        "glosses": [
                            "iemand die verantwoordelijkheid draagt voor het samenstellen van een collectie of tentoonstelling"
                        ],
                        "tags": [
                            "beroep",
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "5b2d4c33-4b60-4b47-955c-d3dca7463fae",
                                "sense_id": "e716a060-da9d-38e5-a51b-a2566fc41020",
                                "text": "Op de tweede, in de Bibliothèque nationale de France, maken vijf curatoren, onder wie Annie Leibovitz en regisseur Wim Wenders, een persoonlijke keuze uit de zogenaamde Master Collection, de verzameling foto’s die Cartier-Bresson begin jaren zeventig samenstelde, nadat hij had verkondigd dat hij zichzelf niet langer als fotograaf beschouwde."
                            }
                        ]
                    }
                ],
