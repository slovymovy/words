                                "example_id": "35918f78-7b9c-4e92-b7c1-4dec9b52f90c",
                                "sense_id": "59fdfc59-132f-313d-be2e-6893158873fd",
                                "text": "[…] son gros nez saillant étrangement, diapré de bubelettes nacarat, boutonné d’améthystes troubles."
                            },
                            {
                                "example_id": "c921e299-3569-43db-b93d-a871551cce68",
                                "sense_id": "59fdfc59-132f-313d-be2e-6893158873fd",
                                "text": "Les bubelettes vermillonnes d'un pleurnichage chronique."
