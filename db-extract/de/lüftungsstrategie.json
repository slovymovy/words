                ],
                "senses": [
                    {
                        "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                        "entry_id": "4a9d0890-9399-3aeb-809d-cf490e13ef89",
                        "glosses": [
                            "Plan zur Durchführung der Lüftung in einem Raum oder Gebäude bei Verhinderung von Verlusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28cb71ee-640e-4fef-952a-60adddd036ab",
                                "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                                "text": "„In Vorhaben der Energieforschung wurden daher verschiedene Lüftungsstrategien erprobt: die angeleitete Fensterlüftung, Lüftungsanlagen mit und ohne Wärmerückgewinnung sowie zentrale und dezentrale Konzepte.“"
                            },
                            {
                                "example_id": "dcee5e96-661c-4c6e-a58d-a972431bbfde",
                                "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                                "text": "„Um die Wirksamkeit einer Lüftungsstrategie zu beurteilen, reicht der Luftwechsel als Kennwert nicht aus!“"
                            },
                            {
                                "example_id": "818ad85b-be59-4198-b4ea-a43eb46e9df8",
                                "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                                "text": "„Die Forschung hat Grundlagen für sinnvolle Lüftungsstrategien erarbeitet, um zu hohe Werte für Luftfeuchtigkeit und Kohlendioxid (CO2) zu vermeiden.“"
                            },
                            {
                                "example_id": "3edcf57d-e47e-4335-81c3-6f27ef670174",
                                "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                                "text": "„Für dieses Klima, speziell in den heißen Sommermonaten, ist die Lüftungsstrategie eines der wichtigsten Konzepte, um den thermischen Komfort im Gebäude sicherzustellen.“"
                            },
                            {
                                "example_id": "f02837c1-e5af-4b07-aca6-8a402b9983cd",
                                "sense_id": "6bc25e9c-7ca3-3ec8-b5b1-a210ae401f46",
                                "text": "„Die BINE-Themeninfo \"Lüften in Schulen\" gibt auf 20 Seiten einen Überblick über die bauphysikalischen Anforderungen an Lüftungsstrategien und Lüftungssystemen in Schulen, mögliche Techniken, sowie deren optimale Auslegungen und Energiebilanzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
