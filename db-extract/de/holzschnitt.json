                    },
                    {
                        "form_id": "6b743ebd-6ed1-4e78-9767-481ec12fc696",
                        "entry_id": "dff46b61-f114-3a87-8e5e-8b608cb2a9e0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Holzschnitte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d4e8775-ccf6-3be4-aaf0-0e879c7a8b00",
                        "entry_id": "dff46b61-f114-3a87-8e5e-8b608cb2a9e0",
                        "glosses": [
                            "Hochdruckverfahren, bei dem mit verschiedenen Werkzeugen – etwa Grabstichel, Geißfuß, Konturenmesser und Hohleisen – aus einer entlang der Fasern geschnittenen Holzplatte die nicht druckenden Teile entfernt werden, um dann die erhabenen Bereiche einzufärben und abzudrucken"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c2af6a44-4772-459d-85c4-a5eae0be6e5f",
                                "sense_id": "7d4e8775-ccf6-3be4-aaf0-0e879c7a8b00",
                                "text": "Der Künstler, dessen Werke in der örtlichen Galerie ausgestellt werden, wendet bei seiner Arbeit überwiegend den Holzschnitt an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea63b485-efb5-3885-9e0d-834ebde53a97",
                        "entry_id": "dff46b61-f114-3a87-8e5e-8b608cb2a9e0",
                        "glosses": [
                            "mittels der unter [1] beschriebenen Technik angefertigtes bedrucktes Blatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5744fc19-4161-4b7f-9e95-94a866d68d42",
                                "sense_id": "ea63b485-efb5-3885-9e0d-834ebde53a97",
                                "text": "Im Museum kann man zahlreiche jahrhundertealte Holzschnitte bestaunen."
                            },
                            {
                                "example_id": "11fde7ad-799d-47e5-9a0c-8a83b4eab745",
                                "sense_id": "ea63b485-efb5-3885-9e0d-834ebde53a97",
                                "text": "„Mein Vater hat später, 1958, ein Buch mit Rudolphs Holzschnitten herausgebracht.“"
                            },
                            {
                                "example_id": "b7af7c2d-9789-4ec5-a9b8-a62e62892442",
                                "sense_id": "ea63b485-efb5-3885-9e0d-834ebde53a97",
                                "text": "„Das zum großen Teil von Hartmann Schedel kompilierte und mit Hunderten von kolorierten Holzschnitten verzierte Werk verließ 1493 die Pressen des Druckers Anton Koberger, wenige Monate nachdem im Vorjahr Rodrigo de Triana Amerika entdeckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c1a9aac-160e-4639-bf10-2012347a78de",
                        "source_entry_id": "dff46b61-f114-3a87-8e5e-8b608cb2a9e0",
                        "source_sense_id": "7d4e8775-ccf6-3be4-aaf0-0e879c7a8b00",
                        "target_lang_word": "xylographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xylographie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a9062b1-f721-3326-98d6-fafc91dd48be",
                                        "entry_id": "35708e46-8662-3ac7-8d1b-3c94e988793e",
                                        "glosses": [
                                            "Art d’imprimer avec des caractères de bois, ou avec des planchettes de bois dans lesquelles sont taillées les lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ca9f25-f844-47b4-9990-7105c3caf979",
                                                "sense_id": "8a9062b1-f721-3326-98d6-fafc91dd48be",
                                                "text": "La xylographie, qui a précédé l’imprimerie typographique, a surtout été en usage au quinzième siècle et au seizième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c9905c-6898-3d9f-94ec-43d541aa8b86",
                                        "entry_id": "35708e46-8662-3ac7-8d1b-3c94e988793e",
                                        "glosses": [
                                            "Épreuve de gravure sur bois, estampe xylographique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21d7d718-58a4-4e97-8664-4380727610e2",
                                                "sense_id": "06c9905c-6898-3d9f-94ec-43d541aa8b86",
                                                "text": "Laboureur a donné, dès 1892, de robustes xylographies, d'une grande hardiesse pour l'époque."
                                            }
                                        ]
                                    }
                                ]
                            },
