                    }
                ],
                "senses": [
                    {
                        "sense_id": "820df5c4-258c-3f08-bb21-12a262e87f69",
                        "entry_id": "747f4a0c-4fa9-3f4e-acd9-423a94de3464",
                        "glosses": [
                            "taki, który odnosi się do zdarzeń potencjalnych lub nierzeczywistych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42cd96a-d0f5-4ac8-9102-925f3331b046",
                                "sense_id": "820df5c4-258c-3f08-bb21-12a262e87f69",
                                "text": "W przypadku intensji sekundarnych wartość logiczną lub odniesienie sądu / pojęcia ustalamy przyjmując nasz aktualny świat jako kontekst wypowiedzenia oraz dany świat kontrfaktyczny jako okoliczności wartościowania"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "587adf99-41e6-45a7-af72-5492cf8beaee",
                        "source_entry_id": "747f4a0c-4fa9-3f4e-acd9-423a94de3464",
                        "source_sense_id": "820df5c4-258c-3f08-bb21-12a262e87f69",
                        "target_lang_word": "counterfactual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterfactual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                                        "glosses": [
                                            "Contrary to known or agreed facts; untrue."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3eb29f6-5ddf-4a1e-8c1b-c651fec60c84",
                                                "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                                                "text": "a leaderless disinformation campaign, with claims leaping from conspiracy theorists to state propagandists to alternative-media outlets and back—an ecosystem I call the Counterfactual Community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                                        "glosses": [
                                            "Of or in comparison to a hypothetical state of the world."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424f94e2-6dfe-4eeb-8aea-cceae51db38c",
                                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                                "text": "What would have happened if those great Chinese voyages [by Zheng He] had continued? It's one of those questions in counter-factual history about which it is impossible to be sure."
                                            },
                                            {
                                                "example_id": "afe35f51-6dbf-4011-936f-f470c4376359",
                                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                                "text": "The counterfactual 1982 of the novel plays variations on our historical record and contains clear allusions to the present."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterfactual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7ce859-0b01-36b8-8bb0-1e0708b447c3",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A claim, hypothesis, or other belief that is contrary to the facts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A hypothetical state of the world, used to assess the impact of an action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b15335-687d-426a-aa5f-a3cb48ea9152",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Just as counterfactuals employ too much imagination to qualify as historical works, alternate history often labors under too great a load of artificial \"facts\" to take flight as fiction."
                                            },
                                            {
                                                "example_id": "a6a1a524-283d-4ffa-a587-46f6d7fc6e28",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "We can spin out complicated counterfactuals that justify the Iraq invasion, and complicated counterfactuals that make it look even worse."
                                            },
                                            {
                                                "example_id": "5474e981-9caa-40bf-ae08-26eb2ca88768",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "The implicit counterfactual — that these members would support gun control if not for the $1,000 they received from the NRA — seems unlikely to me."
                                            },
                                            {
                                                "example_id": "f106c7bc-df6d-4b06-8904-72cfe5466725",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Roese also says counterfactuals can serve emotional purposes. You can think about how things could have been worse, and so feel better about yourself, and grateful for where you are."
                                            },
                                            {
                                                "example_id": "4d894ed4-b8de-41b6-91a3-af947e18ba20",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Imagine a counterfactual in which we started relaxing restrictions at an even earlier time, just as the cases began to trend downward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca73719-8451-3c31-b84d-2da33c101a9f",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A conditional statement in which the conditional clause is false."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "351b179a-4afd-448f-9fa4-a446a074e17f",
                        "source_entry_id": "747f4a0c-4fa9-3f4e-acd9-423a94de3464",
