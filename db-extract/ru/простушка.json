                "senses": [
                    {
                        "sense_id": "0da3e42c-02f3-38f0-a85a-369cf6727646",
                        "entry_id": "c0669af6-b2d0-3322-a8b6-50c78d1a577a",
                        "glosses": [
                            "разг. женск. к простак; бесхитростная, простодушная или простая в обращении женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab54015-fc8e-410e-b22a-59a280d5ff81",
                                "sense_id": "0da3e42c-02f3-38f0-a85a-369cf6727646",
                                "text": "Зачем вы ― такая простушка, зачем вы ― не такая, как все…"
                            },
                            {
                                "example_id": "bd275ce6-7808-4235-8ad2-df0f512b8139",
                                "sense_id": "0da3e42c-02f3-38f0-a85a-369cf6727646",
                                "text": "Все в доме любили Верочку и считали её простушкой и кисейной барышней."
                            },
                            {
                                "example_id": "b3e2253c-a078-4498-aa0c-41e1585a2f7a",
                                "sense_id": "0da3e42c-02f3-38f0-a85a-369cf6727646",
                                "text": "[Аполлон Евгеньич Окоемов:] А вы правду говорили. Она совсем невоспитанна, такая простушка. Это немножко странно на первый взгляд; но ничего, пожалуй даже мило."
                            }
                        ]
                    }
