                },
                {
                    "sense_id": "18a9a351-0d09-3f93-b117-cd144fbf4537",
                    "sense_definition": "Social conduct or rules of polite behavior.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered bad <w>manners</w> to speak with your mouth full.",
                            "target_lang_translations": {
                                "ru": "Считается дурными <w>манерами</w> говорить с набитым ртом.",
                                "tr": "Ağzın doluyken konuşmak kötü <w>görgü kuralı</w> eksikliği sayılır."
                            }
                        },
                        {
                            "text": "His parents taught him good <w>manners</w> from a young age.",
                            "target_lang_translations": {
                                "ru": "Родители с раннего возраста учили его хорошим <w>манерам</w>.",
                                "tr": "Ailesi ona küçük yaştan itibaren iyi <w>terbiye</w> verdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good manners",
                        "bad manners",
                        "table manners"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
