                        "sense_id": "65d44a52-8212-3d01-807c-208a2d2a18d3",
                        "entry_id": "4fc898ea-6034-3a1e-aec0-0054a2eb40e0",
                        "glosses": [
                            "ausgediente elektrische und elektronische Geräte oder Teile davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b33d2e-ea71-44db-9735-def2dfceca2f",
                                "sense_id": "65d44a52-8212-3d01-807c-208a2d2a18d3",
                                "text": "Beim Recycling von Elektroschrott können wertvolle Metalle zurückgewonnen werden."
                            },
                            {
                                "example_id": "83128a93-6b04-4365-b74a-89c576e3161a",
                                "sense_id": "65d44a52-8212-3d01-807c-208a2d2a18d3",
                                "text": "Immer noch werden große Mengen Elektroschrott illegal in Entwicklungsländer exportiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
