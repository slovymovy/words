                ],
                "senses": [
                    {
                        "sense_id": "b46391b8-a3f3-3c99-8a08-4e171b9a1636",
                        "entry_id": "471e5e75-6700-3001-9395-9979415682bf",
                        "glosses": [
                            "senkrecht aufsteigendes Rohr, in das erfasstes Niederschlagswasser von einer höheren Fläche zu einer niedrigeren Fläche über das Regenfallrohr in die Grundleitung (Kanalisation) abgeleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325ca0aa-224a-495a-8b7c-d0eeb9af3a24",
                                "sense_id": "b46391b8-a3f3-3c99-8a08-4e171b9a1636",
                                "text": "„Durch die Verwendung von metallenen Regenfallrohren und gusseisernen Regenstandrohren parallel zur Ableitung wird der Blitzstrom weiter aufgeteilt.“"
                            },
                            {
                                "example_id": "5a33628b-0ee4-41df-89d9-318005588b4a",
                                "sense_id": "b46391b8-a3f3-3c99-8a08-4e171b9a1636",
                                "text": "„Um das Regenfallrohr und das Regenstandrohr vor Verstopfungen durch Laub zu schützen, kann für die Reinigung gut zugänglich über dem Standrohr ein Laubsammler eingebaut werden.“"
                            },
                            {
                                "example_id": "f8edf563-52f6-43f1-b24f-f38820146c35",
                                "sense_id": "b46391b8-a3f3-3c99-8a08-4e171b9a1636",
                                "text": "„Wieder einmal haben triste Regenfall- und Regenstandrohre aus Blech oder Kunststoff das Gesamtbild beeinträchtigt und für einen Stilbruch gesorgt.“"
                            },
                            {
                                "example_id": "53bdf8dd-3a6e-4d88-80d1-abbd8a94665c",
                                "sense_id": "b46391b8-a3f3-3c99-8a08-4e171b9a1636",
                                "text": "„In moderner Fassadenarchitektur werden LORO Regenstand- und Regenfallrohre als Konstruktionselemente einbezogen. LORO-Regenstand- und Regenfallrohre erfüllen die besonderen Anforderungen an die Fassadengestaltung durch ein reichhaltiges Rohr- und Formstückprogramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
