                    "sense_id": "fd1df360-23d8-3539-8c31-034017393441",
                    "sense_definition": "Feeling confused, puzzled, or unable to think clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confused",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood in the middle of the busy street with a <w>bewildered</w> look on his face.",
                            "target_lang_translations": {
                                "es": "Se quedó parado en medio de la calle concurrida con una mirada <w>desconcertada</w> en su rostro."
                            }
                        },
                        {
                            "text": "The students were <w>bewildered</w> by the complex instructions given by the professor.",
                            "target_lang_translations": {
                                "es": "Los estudiantes estaban <w>perplejos</w> por las complejas instrucciones dadas por el profesor."
                            }
                        }
                    ],
                    "synonyms": [
                        "confounded",
                        "confused",
                        "puzzled",
                        "baffled"
                    ],
                    "common_phrases": [
                        "look bewildered",
                        "feel bewildered"
                    ],
                    "target_lang_definitions": {
