                                        "entry_id": "753e013e-2011-3a5b-8a6c-29b41b0b1ff1",
                                        "glosses": [
                                            "The soft skin on each side of the face, below the eyes; the outer surface of the sides of the oral cavity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0ebb58-a9fe-4a51-bb21-771236757c72",
                                                "sense_id": "656f46c2-6da8-37c6-9b4d-8834e6767fde",
                                                "text": "There are some shrewd contents in yon same paper, / That steals the colours from Bassanio's cheek: / Some dear friend dead; else nothing in the world / Could turn so much the constitution / Of any constant man. What, worse and worse!— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf9c014-b417-3db9-ad8c-eddbb3ca0947",
                                        "entry_id": "753e013e-2011-3a5b-8a6c-29b41b0b1ff1",
                                        "glosses": [
                                            "The lower part of the buttocks that is often exposed beneath very brief underwear, swimwear, or extremely short shorts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29f14f4f-b6f1-3747-a15c-4a7997bce5aa",
                                        "entry_id": "753e013e-2011-3a5b-8a6c-29b41b0b1ff1",
                                        "glosses": [
                                            "Impudence."
                                        ],
                                        "tags": [
