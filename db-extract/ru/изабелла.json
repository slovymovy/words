                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a219fbf-8dad-4698-bb36-e4b85b763487",
                                "sense_id": "55cff4d0-51ff-3a84-a24d-192275b1f9ac",
                                "text": "Меня зовут Изабелла"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de65fedc-164c-4cb7-8778-16903f908393",
                        "source_entry_id": "9fd473d5-79f2-3025-8abf-0bda32c15cca",
                        "source_sense_id": "55cff4d0-51ff-3a84-a24d-192275b1f9ac",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Isabella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isabella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34300a31-b0c7-3e6a-adaf-652f360eeeff",
                                        "entry_id": "6015cce2-8018-35a8-be5b-fb3b8fa443e7",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceaef11-75ea-4be9-b01d-35911174900f",
                                                "sense_id": "34300a31-b0c7-3e6a-adaf-652f360eeeff",
                                                "text": "[C]an you ſo ſteed me, / As bring me to the ſight of Iſabella, / A Nouice of this place, and the faire Siſter / To her vnhappie brother Claudio?"
                                            },
                                            {
                                                "example_id": "274498ed-ab3f-4473-8c1f-87beb7f08778",
                                                "sense_id": "34300a31-b0c7-3e6a-adaf-652f360eeeff",
                                                "text": "A contemporary, and usually very accurate chronicler, Bartholomew of Norwich, tells us that the queen called her infant by the barbarous name of Walkiniana; others again call her Isabella; but, in the wardrobe accounts, and all other state records, she is invariably designated Elizabeth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Isabella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2bb4d5-59d3-3b28-b1c7-5bbaecd032cd",
                                        "entry_id": "6f462ab8-aa9a-3adb-ad4e-cd23552b3c63",
                                        "glosses": [
                                            "A grape cultivar popular in the former USSR derived from the grape species Vitis labrusca."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d67c7e45-b361-35a1-badf-8cbbafb425b9",
                                        "entry_id": "6f462ab8-aa9a-3adb-ad4e-cd23552b3c63",
                                        "glosses": [
                                            "Obsolete form of isabella."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98dd2004-f7ec-4da3-9459-dead909c8839",
                                                "sense_id": "d67c7e45-b361-35a1-badf-8cbbafb425b9",
                                                "text": "If it be exposed to heat as soon as it is moderately warm, its dark olive colour changes almost suddenly to an Isabella colour, it becomes cloudy, and an abundant precipitate falls[…]"
                                            },
                                            {
                                                "example_id": "7a21c34b-f93f-4105-97a3-96f3aa127e1c",
                                                "sense_id": "d67c7e45-b361-35a1-badf-8cbbafb425b9",
                                                "text": "The late Queen Victoria drove behind horses of a peculiar shade which nothing but Isabella color would describe. Now it is to appear in furs for the élite."
                                            },
                                            {
                                                "example_id": "0a9eda4a-2844-4742-b7d2-3a6ed4e77d2a",
                                                "sense_id": "d67c7e45-b361-35a1-badf-8cbbafb425b9",
                                                "text": "Mr. and Mrs. Moes left after the reception for New York and other places, the bride wearing Burgundy cloth with a chic grey hat and veil and Isabella fox furs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
