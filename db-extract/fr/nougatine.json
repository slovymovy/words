        "fr-extract.jsonl": [
            {
                "entry_id": "8f7f235c-b023-3559-a2cb-f1d8a576bb41",
                "word": "nougatine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45dbb9df-3f41-4f55-a5f6-89b95a701253",
                        "entry_id": "8f7f235c-b023-3559-a2cb-f1d8a576bb41",
                        "tags": [
                            "plural"
                        ],
                        "form": "nougatines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                        "entry_id": "8f7f235c-b023-3559-a2cb-f1d8a576bb41",
                        "glosses": [
                            "Confiserie faite de sucre caramélisé et de menus morceaux d’amandes ou de noix, souvent utilisée en pâtisserie."
                        ],
                        "tags": [
                            "Confiserie"
                        ],
                        "examples": [
                            {
                                "example_id": "d4907837-ee85-4d0c-a775-a4101fbc7a80",
                                "sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                                "text": "La nougatine est une spécialité pâtissière inventée à Nevers vers 1850."
                            },
                            {
                                "example_id": "6a7b8d9b-e494-442c-8b8a-813ca9c41b78",
                                "sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                                "text": "On regardait ensemble la devanture du libraire de la place des Belges, parfois elle proposait « veux-tu que je t’en achète un ? ». Pareil qu’à la pâtisserie, devant les meringues et les nougatines, le même appétit, le même impression aussi que c’était pas très raisonnable. « Dis, ça te ferait plaisir ? » C’est le libraire forcément qui conseillait, choisissait, la seule différence avec les gâteaux, à part Delly et Daphné du Maurier, elle n’était pas calée."
                            },
                            {
                                "example_id": "abce3008-5a76-4677-a55d-9f611d07cb59",
                                "sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                                "text": "De fait, elle ne mange pas que la garniture, mais aussi les épais copeaux de nougatine, qu’elle croque à belles dents tout en poursuivant la discussion, quand elle parvient à capter un mot sur lequel elle rebondit longuement, comme un écureuil qui ne s’arrête qu’au bout d’une branche."
                            },
                            {
                                "example_id": "f0ea6491-2824-4f7c-b1e4-2906e33853e3",
                                "sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                                "text": "Dès lors, rien d’étonnant à ce que, cet après-midi-là, tandis qu’il fumait à la chaîne des américaines dénichées à prix d’or qu’il tirait d’un paquet tout froissé, les feuillets s’empilassent comme les brioches à la nougatine au sortir d’un four."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4b7d4be-e4ff-4ce1-abfb-bef55c3fc8fb",
                        "source_entry_id": "8f7f235c-b023-3559-a2cb-f1d8a576bb41",
                        "source_sense_id": "c6317fe7-952d-3a16-a877-a68b4095f24b",
                        "target_lang_word": "Krokant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krokant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                        "entry_id": "fe0510ec-214a-338b-b8ad-52f04b53dbc2",
                                        "glosses": [
                                            "knusprige, aus Mandeln, Nüssen und Zucker hergestellte Masse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe9fb49-03d0-4aab-bc10-7ea1b1f258bc",
                                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                                "text": "„Den Krokant jetzt auf das Blech gießen und mit einer Winkelpalette oder einem Silikon-Teigschaber verstreichen.“"
                                            },
                                            {
                                                "example_id": "0248a762-c52a-4cbb-9693-adc8f3b6de5e",
                                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                                "text": "„Die gehackten Haselnüsse unterheben, Topf vom Herd nehmen und den Krokant abkühlen lassen.“"
                                            },
                                            {
                                                "example_id": "ed30e69c-893b-409a-9a29-78b32a1c8695",
                                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                                "text": "„Für den Krokant die gehackten Haselnüsse in einer beschichteten Pfanne goldbraun rösten.“"
                                            },
                                            {
                                                "example_id": "2126f30b-ef22-4084-8e4f-13d40c6ec159",
                                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                                "text": "„Creme in die Schälchen verteilen, mit dem restlichen Krokant bestreuen.“"
                                            },
                                            {
                                                "example_id": "a647c982-97bb-4020-9a05-46cc78fb5322",
                                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                                "text": "„Wenn ich verlockend süße Schokolade erwarte, will ich auch verlockend süße Schokolade kriegen, gerne mit dazu passenden Ingredienzien wie Nüssen, Karamell, Krokant oder Marzipan, aber doch bitte nicht mit bitterem Schnaps.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
