                    },
                    {
                        "form_id": "357c8956-c648-448b-8362-9a3497f241a9",
                        "entry_id": "2874ad22-9af0-3809-8fd0-dad5001a36c4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rohöle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                        "entry_id": "2874ad22-9af0-3809-8fd0-dad5001a36c4",
                        "glosses": [
                            "unbearbeitetes Öl aus der Lagerstätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1ac250-25da-4b42-96ff-6d1217d45e8e",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "[Benzinpreis:] „Zwar sind die Kosten für Rohöl gestiegen, doch dadurch allein lässt sich das aktuelle Preisniveau nicht erklären.“"
                            },
                            {
                                "example_id": "5fe32338-b9db-4c6d-982c-02b2605affea",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Das Rohöl muss erst in einer Raffinerie gereinigt und in die Bestandteile zerlegt werden."
                            },
                            {
                                "example_id": "0642eabd-84d3-41eb-809b-0775ebfd5e6e",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Rohöl wird meist in Dollar bezahlt."
                            },
                            {
                                "example_id": "3b2c6224-ba21-43a2-8b2a-b3bb48886129",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Der Preis für Rohöl wird in den nächsten Jahren wohl steigen."
                            },
                            {
                                "example_id": "18badc63-113a-4dd7-844b-3f82ec483a23",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Zurzeit übersteigt die Nachfrage nach Rohöl das Angebot."
                            },
                            {
                                "example_id": "6e2dd5b9-292b-4a22-aa52-52ecfd33f425",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Saudi-Arabien fördert am meisten Rohöl."
                            },
                            {
                                "example_id": "9aa458ca-e156-40a1-9ebe-bac2128568ad",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Bei der Ölkatastrophe der Bohrplattform Deepwater Horizon trat über mehrere Monate Rohöl aus, insgesamt über 500.000 Tonnen."
                            },
                            {
                                "example_id": "1b8a4e02-d694-46e1-bc6c-7d0fd664a0ff",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "Monatlich importiert Deutschland etwa sieben Millionen Barrel Rohöl."
                            },
                            {
                                "example_id": "d46a5717-6834-44d9-9573-286dbd094533",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "„Seit Jahren liegt der verwahrloste Tanker \"Safer\" im Roten Meer - mit 1,1 Millionen Barrel Rohöl an Bord.“"
                            },
                            {
                                "example_id": "fe4b8516-68e3-4d59-9858-72264aa3a10a",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "[Im brandenburgischen Schwedt] „wird russisches Rohöl laut den Betreibern zu knapp 20 unterschiedlichen Kraftstoffen weiterverarbeitet.“"
                            },
                            {
                                "example_id": "14341b4d-afdd-48b4-9652-65f629aaf5f2",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "„Jetzt, da russisches Rohöl von vielen westlichen Ländern gemieden wird, sind indische Raffinerien nur zu gerne bereit, es zu stark reduzierten Preisen zu kaufen.“"
                            },
                            {
                                "example_id": "f1ff8d7a-a0c8-4bc8-adad-39f8a6e3d373",
                                "sense_id": "c4d4eba4-a7e4-3f84-aebf-1ce966558519",
                                "text": "„Wegen des engen Fahrwassers gilt von Bornholm bis zum Großen Belt eine dringende Lotsenempfehlung. Allein hier werden jährlich 40 Millionen Tonnen russisches Rohöl transportiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
