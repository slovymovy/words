                "senses": [
                    {
                        "sense_id": "dc42296d-5ef3-3b16-9502-952a847ebafb",
                        "entry_id": "1f26753e-a7cf-3135-809b-a24defe1f953",
                        "glosses": [
                            "Silbenmaß, Versmaß"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "179a08b4-c8e6-428a-831c-6b724b7733bf",
                                "sense_id": "dc42296d-5ef3-3b16-9502-952a847ebafb",
                                "text": "Das Metrum kann sehr unterschiedlich gestaltet werden und prägt die Form von Gedichten."
                            },
                            {
                                "example_id": "67bafd57-cacf-4e9e-a798-14cddc54675c",
                                "sense_id": "dc42296d-5ef3-3b16-9502-952a847ebafb",
                                "text": "„Über drei weitere Strophen zieht sich diese liebe Betrachtung im selben Metrum und treibt uns weiter.“"
                            },
                            {
                                "example_id": "415856f7-aab6-4391-832b-2ea1f91f6ad0",
                                "sense_id": "dc42296d-5ef3-3b16-9502-952a847ebafb",
                                "text": "„Der Autor setzt Wörter aus allen Komponenten des Jiddischen ebenso wie eine Reihe Italianismen mit viel Sinn für Metrum und Konnotationen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
