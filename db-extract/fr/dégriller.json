                        "glosses": [
                            "Ôter les grilles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "50cb679d-a5a2-3172-a06f-49e0bdd5035b",
                        "entry_id": "bcd3075a-396e-382a-a3f7-5aa45537eb52",
                        "glosses": [
                            "Faire sortir du couvent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1e400305-606c-4c8b-980c-ca2da0f67872",
                                "sense_id": "50cb679d-a5a2-3172-a06f-49e0bdd5035b",
                                "text": "La mort du comte de Verne dégrilla sa femme, qu’il tenait dans un couvent."
                            }
                        ]
                    },
                    {
                        "sense_id": "736b8b8e-99c3-3160-ae1c-aebb739b9644",
                        "entry_id": "bcd3075a-396e-382a-a3f7-5aa45537eb52",
                        "glosses": [
                            "Enlever ce qui bouche une grille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aab780e-2aef-406e-80cf-e54684f84329",
                                "sense_id": "736b8b8e-99c3-3160-ae1c-aebb739b9644",
                                "text": "On dégrille avec un râteau à manche souple en jeune frêne, on le passe contre la grille vers le haut, on racle le long des barres, ou l’on soulève la grille avec une ficelle et on la secoue pour faire passer ce qui bouche, feuilles et petit poisson qui ne résiste pas au courant."
                            }
                        ]
                    }
