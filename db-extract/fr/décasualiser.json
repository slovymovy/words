                "senses": [
                    {
                        "sense_id": "beebafa9-4b32-3fc3-b3e9-03ae639476c4",
                        "entry_id": "ef6c3b75-0bec-3e72-80b9-8312d7703321",
                        "glosses": [
                            "Ôter à quelque chose ce qu’il a de casuel, de fortuit ou d’accidentel."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "2c755cdb-842b-400a-903a-4217246698ad",
                                "sense_id": "beebafa9-4b32-3fc3-b3e9-03ae639476c4",
                                "text": "Il faut « décasualiser » le travail, c’est-à-dire transformer le travail occasionnel en travail permanent, et organiser le marché du travail par les bureaux de placement."
                            },
                            {
                                "example_id": "2f5c1d3d-794e-4d23-9a42-2eca110903fc",
                                "sense_id": "beebafa9-4b32-3fc3-b3e9-03ae639476c4",
                                "text": "[…] : on verra comment un régime d’assurance qui fait contribuer l’industrie aux charges, peut concourir par là même à stabiliser ou décasualiser le travail."
                            }
                        ]
                    }
                ],
