                        "entry_id": "ec74d530-7caa-315e-98a9-0b466499c97a",
                        "glosses": [
                            "Loterie dans laquelle on gagne un lot en nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55402643-c122-45ca-aa6b-b4c45b6fc3e6",
                                "sense_id": "4a0f9506-9398-3474-816e-f753c25a5231",
                                "text": "Un mâle pis une femelle. C'est le gamin qui les a gagnés une tombola, mais on a pas la place de les garder, alors qu'il y a de la friche en pagaïe autour de chez vous."
                            },
                            {
                                "example_id": "9eb4a080-e880-4a74-97ce-22158b69f16f",
                                "sense_id": "4a0f9506-9398-3474-816e-f753c25a5231",
                                "text": "Dans cette soirée on tira une tombola."
                            },
                            {
                                "example_id": "7e2bd5a1-23d2-42af-a118-284688e9cb06",
                                "sense_id": "4a0f9506-9398-3474-816e-f753c25a5231",
                                "text": "Une tombola de charité."
                            }
                        ]
                    }
                ],
