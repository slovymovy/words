                        "examples": [
                            {
                                "example_id": "508219f6-86fc-411e-aa73-cf7055bf9168",
                                "sense_id": "41ebdca4-6b99-3023-92e9-0ed55a1ebd1d",
                                "text": "„Ein Grund dafür wird auch in der Tatsache vermutet, dass Frauen einfach viel weniger Zeit für ehrenamtliche Gschaftln haben als Männer, weil sie trotz Berufstätigkeit den größten Teil von Erziehungs- und Haushaltsarbeit leisten.“"
                            },
                            {
                                "example_id": "353f6225-55ad-4582-8c37-9b3b24017c64",
                                "sense_id": "41ebdca4-6b99-3023-92e9-0ed55a1ebd1d",
                                "text": "„‚Kaum jemand nutzt seinen Status so aus wie Pirker. Er ist die Inkarnation des österreichischen Durcheinanders mit seinen Gschaftln.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
