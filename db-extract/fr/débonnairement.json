                "senses": [
                    {
                        "sense_id": "92a61c4b-d09d-363d-956b-18d72ff46538",
                        "entry_id": "20283adb-135f-3904-b98a-6976fd94e605",
                        "glosses": [
                            "D’une manière débonnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd8ed0a-c505-408b-b538-b9608a26936e",
                                "sense_id": "92a61c4b-d09d-363d-956b-18d72ff46538",
                                "text": "Sa gaieté, quand il m’avait vu lui donnant débonnairement une somme si énorme, me parut alors être la joie des valets de théâtre attrapant quelque Géronte."
                            },
                            {
                                "example_id": "3dd53307-68fe-4902-91ed-6a29023dfa17",
                                "sense_id": "92a61c4b-d09d-363d-956b-18d72ff46538",
                                "text": "Ces braves gens devaient être merveilleusement incorporés à la glèbe, et notre ancienne noblesse n’éprouvait assurément que liesse et contentement à tailler et mortailler une nature aussi débonnairement serve."
                            }
                        ]
                    }
                ],
