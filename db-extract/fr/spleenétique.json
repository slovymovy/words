        "fr-extract.jsonl": [
            {
                "entry_id": "91c84564-ceca-3325-930b-53c003d0ec07",
                "word": "spleenétique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "584cbaf2-1a81-4e69-95a8-dd1fb0dce86f",
                        "entry_id": "91c84564-ceca-3325-930b-53c003d0ec07",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "spleenétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7cf9251-fe99-3c0c-8653-3cc8e4c8d592",
                        "entry_id": "91c84564-ceca-3325-930b-53c003d0ec07",
                        "glosses": [
                            "Qui inspire le spleen."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "a87b141b-907e-48cc-b901-2f5c97b40176",
                                "sense_id": "e7cf9251-fe99-3c0c-8653-3cc8e4c8d592",
                                "text": "Pourtant, je le sens bien, dans la spleenétique grisaille des brumes hiémales et la turpidité des pensées écrasées de soleil durant mes longs vagabondages, […]."
                            },
                            {
                                "example_id": "e4c482be-cfae-4914-b766-94243a8f50da",
                                "sense_id": "e7cf9251-fe99-3c0c-8653-3cc8e4c8d592",
                                "text": "Pour s’y rendre, après avoir quitté l’autoroute A1, il faut zigzaguer, dans un cadre spleenétique, entre les champs de betteraves et les cimetières, beaucoup de cimetières, américains, britanniques, russes, allemands…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7c33b1cc-6468-3d33-bb3a-94603f866c1f",
                        "entry_id": "91c84564-ceca-3325-930b-53c003d0ec07",
                        "glosses": [
                            "Qui manifeste le spleen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e28a25-60fa-4ece-9dac-5f88a4f10e79",
                                "sense_id": "7c33b1cc-6468-3d33-bb3a-94603f866c1f",
                                "text": "C’était un enfant spleenétique, de dix-huit à vingt ans, chargé d’une longue pipe turque qu’il était certainement incapable de fumer tout entière sans devenir phthisique au dernier degré."
                            },
                            {
                                "example_id": "e3efb116-057f-4948-a2f0-9cb5538ff4fb",
                                "sense_id": "7c33b1cc-6468-3d33-bb3a-94603f866c1f",
                                "text": "On ne pouvait pas l’accuser d’afficher un romantisme théâtral, ni de préparer avec emphase une fin de star spleenétique."
                            },
                            {
                                "example_id": "1ac50991-fb96-472e-8f18-340ee37b2dc1",
                                "sense_id": "7c33b1cc-6468-3d33-bb3a-94603f866c1f",
                                "text": "Alain lui-même en avait aussitôt imposé au collectionneur qui avait vu en lui un dandy spleenétique de la parenté de messieurs Chateaubriand et de Constant, en même temps qu’un exemplaire à voir enfin de près de cette mystérieuse jeunesse contemporaine."
                            },
                            {
                                "example_id": "ded54128-cc13-427e-8a72-7721b6ed6f21",
                                "sense_id": "7c33b1cc-6468-3d33-bb3a-94603f866c1f",
                                "text": "À une extraordinaire indifférence pour la vie qui va mordre à l’hameçon correspond chez lui le danger de sombrer dans une activité toute spleenétique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
