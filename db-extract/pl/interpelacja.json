                                        "glosses": [
                                            "Frage an jemanden, mit der eine Antwort erwartet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d50a5a5-338a-4d6a-a983-ebe28ffa8351",
                                                "sense_id": "54848faa-a199-3816-981d-1230691b564b",
                                                "text": "„Es ist eine weit wichtigere Anfrage, die ich an Sie, gnädiges Fräulein, habe.“ (Hermann Essig, Taifun/4)"
                                            },
                                            {
                                                "example_id": "fc45e424-42f9-477b-b6ae-2b63101c5305",
                                                "sense_id": "54848faa-a199-3816-981d-1230691b564b",
                                                "text": "„Das zuständige Bundesfinanzministerium teilt auf Anfrage mit, eine Reform der Gewerbesteuer sei nicht geplant.“"
                                            }
