                "senses": [
                    {
                        "sense_id": "1ffaf47a-a4cf-3977-b94b-def9bf5f09ac",
                        "entry_id": "358e319b-e282-3a9b-9834-5ddae8d5d3b1",
                        "glosses": [
                            "Flosse, die sich am Bauch eines Fisches befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90569212-a246-4731-b223-6ad06e0edf22",
                                "sense_id": "1ffaf47a-a4cf-3977-b94b-def9bf5f09ac",
                                "text": "„Der im Amazonas vorkommende Fisch bewegt sich mit Hilfe einer Bauchflosse fort, die seinen ganzen Körper entlangläuft.“"
                            },
                            {
                                "example_id": "41bd4a8a-92f1-4282-a7d9-7feff58f3e3a",
                                "sense_id": "1ffaf47a-a4cf-3977-b94b-def9bf5f09ac",
                                "text": "„Der Verlust eines Gens ist noch für eine weitere Besonderheit bei den Seepferdchen verantwortlich: für den Wegfall der Bauchflossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
