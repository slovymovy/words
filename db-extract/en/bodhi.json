                "senses": [
                    {
                        "sense_id": "c85eda07-6d53-3f81-9a1b-ef9e8daf8a21",
                        "entry_id": "71dc5c38-2da9-3fdb-b083-7fc2883eb743",
                        "glosses": [
                            "A male given name from Sanskrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb9ada8-0187-4f5f-8480-90978dae6639",
                                "sense_id": "c85eda07-6d53-3f81-9a1b-ef9e8daf8a21",
                                "text": "\"I grew up in San Diego. My mother died of cancer when I was ten years old. She was a good and loving woman from what I remember, and she encouraged me to read a lot since she was a history teacher. She also had a great interest in eastern philosophy such as Buddhism. When I was born she named me Bodhi from the Buddhist idea of the Bodhisattva – a wise and compassionate being who delays his entrance into buddahood for the benefit of enlightenment for all.” “ She must have seen something very special in you, Bodhi,” said Erica."
                            }
                        ]
                    }
                ],
