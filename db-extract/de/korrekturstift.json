                            {
                                "example_id": "69a9130d-2e6a-4cb4-8307-e9ab73fe6a4b",
                                "sense_id": "f33c7a83-4ec7-3328-aabe-fa8fcb5b224e",
                                "text": "„Bevor du verzweifelst und die Seite neu beginnst, kannst du hierfür einfach einen Korrekturstift verwenden, um den Fehler auszubessern.“"
                            },
                            {
                                "example_id": "ed8c7d4e-6e00-4d8d-b6da-7c9cd769fcd1",
                                "sense_id": "f33c7a83-4ec7-3328-aabe-fa8fcb5b224e",
                                "text": "„Jedenfalls nahm ich einen Korrekturstift zur Hand und änderte sämtliche Klauseln im Vertrag, die mir nicht passten.“"
                            }
                        ],
