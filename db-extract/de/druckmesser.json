                "senses": [
                    {
                        "sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                        "entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
                        "glosses": [
                            "Messgerät, das den Druck in Flüssigkeiten oder Gasen misst"
                        ],
                        "tags": [
                            "Messtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "a93b41d9-55d0-4a8c-974d-9963987bba5e",
                                "sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                                "text": "„Laut Air France hatte es bei A330- und A340-Maschinen seit Mai 2008 Zwischenfälle mit den Druckmessern gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00301215-7842-4644-b209-acd26718e468",
                        "source_entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
                        "source_sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                        "source_sense_description": "Messtechnik: Messgerät, das den Druck in Flüssigkeiten oder Gasen misst",
                        "target_lang_word": "manometer, pressure-gauge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "623392e3-f622-44a0-9e2b-4cd9d407d7a3",
                        "source_entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
                        "source_sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                        "source_sense_description": "Messtechnik: Messgerät, das den Druck in Flüssigkeiten oder Gasen misst",
                        "target_lang_word": "drukmeter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drukmeter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "483b4f60-2987-3136-9f24-607d73c443d6",
                                        "entry_id": "4af03fbe-5d7a-3ffb-ab6a-714ee63732bb",
                                        "glosses": [
                                            "meetinstrument waarmee men de druk van een vloeistof of gas kan bepalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65ce11d-24ee-4371-be2a-6c0a80aa2f89",
                                                "sense_id": "483b4f60-2987-3136-9f24-607d73c443d6",
                                                "text": "Ze zag de drukmeter bij de flessenhals - een oude analoge meter met een wijzer die nu in de groene zone stond."
                                            },
                                            {
                                                "example_id": "ded7eccb-5c0d-4f78-bc01-0df075f44991",
                                                "sense_id": "483b4f60-2987-3136-9f24-607d73c443d6",
                                                "text": "Met een hele batterij experimenten testte Burke zijn hypothese. Daarbij gebruikte hij zichzelf als proefpersoon. Burke stak een drukmeter in zijn mondholte, waarmee hij de binnensmondse drukveranderingen tijdens de nies vastlegde. Daaruit bleek dat een typische nies de druk binnen 0,1 seconde met 0,18 atmosfeer doet stijgen, waarna binnen enkele seconden zo’n 0,1 tot 0,2 milliliter extra snot wordt geproduceerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc0ad1c-dd10-41b4-b72d-84aa319d6882",
                        "source_entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
                        "source_sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                        "source_sense_description": "Messtechnik: Messgerät, das den Druck in Flüssigkeiten oder Gasen misst",
                        "target_lang_word": "manometer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manometer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10f673f1-96a2-3d51-96fc-f36380beca81",
                                        "entry_id": "5a977da7-c36c-3e7f-805e-45fc5c3af80d",
                                        "glosses": [
                                            "een meetinstrument waarmee druk wordt gemeten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b67329-6917-42fd-980e-058ec2abea64",
                                                "sense_id": "10f673f1-96a2-3d51-96fc-f36380beca81",
                                                "text": "Een duiker heeft een manometer als onderdeel van zijn duikuitrusting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de5af008-895a-45ce-86cd-8c7c7358eda7",
                        "source_entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
                        "source_sense_id": "17b4760a-5470-3ada-815e-759ebfa21e79",
                        "source_sense_description": "Messtechnik: Messgerät, das den Druck in Flüssigkeiten oder Gasen misst",
                        "target_lang_word": "манометр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "манометр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "892d6853-f4d8-39bb-a671-8141bceb4bbb",
                                        "entry_id": "60b38a6e-5de5-3024-b93e-98aa895dbb20",
                                        "glosses": [
                                            "техн. средство измерения давления жидкости или газа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188ce3a1-b04c-4ac9-b9bc-d176756cc135",
                                                "sense_id": "892d6853-f4d8-39bb-a671-8141bceb4bbb",
                                                "text": "Манометров при метеорологических наблюдениях по сие время физики не употребляли, хотя они великую пользу подать могут, что в догматической физике видно."
                                            },
                                            {
                                                "example_id": "82dc1739-47e8-479e-9a3a-f78a62ab7278",
                                                "sense_id": "892d6853-f4d8-39bb-a671-8141bceb4bbb",
                                                "text": "Давление измеряется высотою ртутного столба, которая представляет разницу между одним и другим коленами манометра."
                                            },
                                            {
                                                "example_id": "c976af93-e421-47b6-b7db-a481d8a4c950",
                                                "sense_id": "892d6853-f4d8-39bb-a671-8141bceb4bbb",
                                                "text": "Цилиндр и баллоны были снабжены кранами, манометрами, термометрами и неизвестными Лоран приборами."
                                            },
                                            {
                                                "example_id": "11f9f7bc-57a6-4a74-8904-2de0824c64d2",
                                                "sense_id": "892d6853-f4d8-39bb-a671-8141bceb4bbb",
                                                "text": "Азот ушёл из баллона, но баллон не совсем опустел. На это указывал манометр — прибор, которым измеряют давление газа на стенки сосуда."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b544c1a7-0e1f-40c3-8119-5fa951409bce",
                        "source_entry_id": "aa318957-a290-36dc-a949-149fda668fe5",
