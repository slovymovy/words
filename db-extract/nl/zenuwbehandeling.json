                        "entry_id": "260ba8d3-fe7f-3da0-92a2-5331b452dc02",
                        "glosses": [
                            "een tandheelkundige bewerking, waarbij de pulpa van het wortelkanaal van een tand of kies verwijderd wordt en de ontstane ruimte wordt opgevuld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d21c96-9f5e-4f43-8407-201e091d988b",
                                "sense_id": "597254eb-f8b8-3810-950d-4a3bf361563f",
                                "text": "Er blijkt eerst een zenuwbehandeling nodig, waarna de afgebroken tand wordt geplakt."
                            },
                            {
                                "example_id": "234d5465-2478-42f0-8169-98c08a3273b4",
                                "sense_id": "597254eb-f8b8-3810-950d-4a3bf361563f",
                                "text": "Parvin Alahbaksi -Iraanse en vierdejaarsstudente tandheelkunde- buigt zich geconcentreerd over haar patiënt. Ze is met een zenuwbehandeling bezig. Een ingrijpende klus. Met een pincet prikt ze kleine stokjes in de uitgeboorde kies. Af en toe werpt haar docent een blik in de geopende mond."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d4fe044-21f3-321b-befb-353784a99841",
                        "entry_id": "260ba8d3-fe7f-3da0-92a2-5331b452dc02",
                        "glosses": [
                            "behandeling gericht op zenuwbanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d42af5-1bf8-4b87-904b-94bca834a71e",
                                "sense_id": "0d4fe044-21f3-321b-befb-353784a99841",
                                "text": "Sommige patiënten kunnen sinds kort ook aanspraak maken op vergoeding voor een nieuwe behandeling voor erfelijke borstkanker en een zenuwbehandeling bij darmverstopping."
                            }
                        ]
                    }
