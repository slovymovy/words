                                "target_senses": [
                                    {
                                        "sense_id": "2bb06470-f5b3-33d0-b4fa-0a788ac6e77e",
                                        "entry_id": "aa3cb674-5ac0-3a39-b97b-a63ac9cca2d3",
                                        "glosses": [
                                            "juristischer Laie, der ehrenamtlich an der Urteilsfindung im Rahmen von Strafverfahren neben einem oder mehreren Berufsrichtern beteiligt ist"
                                        ],
                                        "tags": [
                                            "deutsches Strafverfahrensrecht",
                                            "§ 45a DRiG"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa838fd7-e2e4-4d99-b39e-048858af2512",
                                                "sense_id": "2bb06470-f5b3-33d0-b4fa-0a788ac6e77e",
                                                "text": "Ein Schöffe ist ehrenamtlich tätig und erhält lediglich eine Aufwandsentschädigung."
                                            },
                                            {
                                                "example_id": "896bb5fb-56c8-4216-af5a-3e4356ed7ed4",
                                                "sense_id": "2bb06470-f5b3-33d0-b4fa-0a788ac6e77e",
                                                "text": "Claudia kann es kaum erwarten, dass jemand aus ihrem Bekanntenkreis zum Schöffen berufen wird."
                                            },
                                            {
                                                "example_id": "46cb7b03-6d1d-4453-b091-e8cf1bebba23",
                                                "sense_id": "2bb06470-f5b3-33d0-b4fa-0a788ac6e77e",
                                                "text": "Zu Beginn seiner ersten Sitzung muss jeder Schöffe einen Eid schwören."
                                            },
                                            {
                                                "example_id": "50dd35c9-3467-472f-b154-7f459556f6b3",
                                                "sense_id": "2bb06470-f5b3-33d0-b4fa-0a788ac6e77e",
                                                "text": "„Die beiden Schöffen mit ihrer gleichwerten Stimme bei der Urteilsfindung sind in Sonntagskleidern, cremefarben und geblümt, und sitzen aufrecht und unbeweglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3742bba5-9f72-3d3b-b892-fbcd542dd068",
                                        "entry_id": "aa3cb674-5ac0-3a39-b97b-a63ac9cca2d3",
                                        "glosses": [
                                            "Beigeordneter des Bürgermeisters, Stadtbeamter"
                                        ],
                                        "tags": [
                                            "in Belgien und Luxemburg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541499f7-098f-498e-be88-45d46e55091a",
                                                "sense_id": "3742bba5-9f72-3d3b-b892-fbcd542dd068",
                                                "text": "„Die Schöffen werden unter den Ratsmitgliedern ausgewählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7aed530b-9744-31b1-8da2-848eb28b640b",
                                        "entry_id": "aa3cb674-5ac0-3a39-b97b-a63ac9cca2d3",
                                        "glosses": [
                                            "Person, die zur Erfüllung verschiedener Aufgaben bei Gericht und in der Verwaltung verpflichtet war"
                                        ],
                                        "tags": [
                                            "während des Hoch- und Spätmittelalters sowie der Frühen Neuzeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c358ec6-21db-484c-9f95-df32c494a3c2",
                                                "sense_id": "7aed530b-9744-31b1-8da2-848eb28b640b",
                                                "text": "„Diese Gerichtsbeisitzer wurden als Schöffen bezeichnet.“"
                                            },
                                            {
                                                "example_id": "e36928e2-d6d4-4634-9b7f-1cc1607b0a69",
                                                "sense_id": "7aed530b-9744-31b1-8da2-848eb28b640b",
                                                "text": "„Die zusammengetretenen Schöffen wiesen das Gewohnheitsrecht der Wildnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schöffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e6698c-8736-39aa-a98c-3deb69a3817a",
