{
    "word_family": [
        "slope",
        "slopy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08fff200-ef6a-3526-b488-65c52284693b",
                    "sense_definition": "Having an incline or slant; not level.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house has a <w>sloping</w> roof to help snow slide off easily.",
                            "target_lang_translations": {
                                "zh": "这栋房子有一个<w>倾斜的</w>屋顶，以便积雪容易滑落。"
                            }
                        },
                        {
                            "text": "We walked down the <w>sloping</w> hill toward the river.",
                            "target_lang_translations": {
                                "zh": "我们沿着<w>倾斜的</w>山坡向河边走去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inclined",
                        "slanting",
                        "tilted"
                    ],
                    "antonyms": [
                        "level",
                        "flat"
                    ],
                    "common_phrases": [
                        "sloping roof",
                        "sloping ground"
                    ],
                    "target_lang_definitions": {
                        "zh": "指表面或物体具有倾斜度，不平坦。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "倾斜的",
                                "target_lang_sense_clarification": "形容物体或表面处于斜坡状态。"
                            },
                            {
                                "target_lang_word": "斜的",
                                "target_lang_sense_clarification": "描述不平直、有角度的形状。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50bb7ddd-6ebf-3277-894e-1cc8772c6177",
                    "sense_definition": "Present participle and gerund of <w>slope</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path is <w>sloping</w> downwards toward the valley.",
                            "target_lang_translations": {
                                "zh": "这条小路正向着山谷方向<w>倾斜</w>。"
                            }
                        },
                        {
                            "text": "He is <w>sloping</w> the garden to improve drainage.",
                            "target_lang_translations": {
                                "zh": "他正在把花园<w>弄斜</w>以改善排水。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体呈现出倾斜的状态，或使某物倾斜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "指物体本身处于斜坡状态或动作。"
                            },
                            {
                                "target_lang_word": "使倾斜",
                                "target_lang_sense_clarification": "指人为地改变地势或物体角度。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e3d2421-7127-3bcd-8b59-4e8bcb89d98e",
                    "sense_definition": "The act or state of having an incline.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sloping</w> of the terrain made construction difficult.",
                            "target_lang_translations": {
                                "zh": "地形的<w>倾斜度</w>使得施工变得困难。"
                            }
                        },
                        {
                            "text": "Engineers measured the <w>sloping</w> of the embankment.",
                            "target_lang_translations": {
                                "zh": "工程师测量了堤岸的<w>坡度</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inclination",
                        "slant"
                    ],
                    "target_lang_definitions": {
                        "zh": "指地形或物体倾斜的状态或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "倾斜度",
                                "target_lang_sense_clarification": "指倾斜的程度或状态。"
                            },
                            {
                                "target_lang_word": "坡度",
                                "target_lang_sense_clarification": "特指地面或斜坡的倾斜程度。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}