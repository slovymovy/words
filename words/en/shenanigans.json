    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73bc8800-eab2-38f0-b362-bbc5a4bf84eb",
                    "sense_definition": "Mischievous or playful behavior, especially by children or in a lighthearted context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mischief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were up to their usual <w>shenanigans</w> in the backyard, hiding all the garden tools.",
                            "target_lang_translations": {
                                "ru": "Дети во дворе занимались своими обычными <w>проделками</w>, пряча все садовые инструменты."
                            }
                        },
                        {
                            "text": "After a long day of work, the team enjoyed some harmless <w>shenanigans</w> at the office party.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня команда позволила себе безобидное <w>озорство</w> на офисной вечеринке."
                            }
                        }
                    ],
                    "synonyms": [
                        "high jinks",
                        "hijinks"
                    ],
                    "common_phrases": [
                        "up to their usual shenanigans"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe playful or annoying but not necessarily malicious behavior"
                        }
                    ],
                    "target_lang_definitions": {
