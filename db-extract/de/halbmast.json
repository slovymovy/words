                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea064c36-b45a-36da-8abc-dd77121126ac",
                        "entry_id": "77331666-76bf-372d-aa6b-b3b04e44d896",
                        "glosses": [
                            "zum Zeichen offizieller Trauer: nur auf die halbe Höhe des Mastes aufgezogene Fahne/Flagge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc102972-6dd8-492e-a84c-d1ae4f9e285a",
                                "sense_id": "ea064c36-b45a-36da-8abc-dd77121126ac",
                                "text": "Nach dem Tod des Staatspräsidenten wurden die Fahnen an den öffentlichen Gebäuden auf halbmast gesetzt."
                            },
                            {
                                "example_id": "26eec4ef-4124-4422-9c2a-e7dca7e422d3",
                                "sense_id": "ea064c36-b45a-36da-8abc-dd77121126ac",
                                "text": "„Nach uns lief ein großer Japaner ein, die Flagge auf halbmast. Dieser hatte die ganzen Decksbauten verloren und acht Mann der Besatzung waren einer schweren Sturzsee zum Opfer gefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9d32c37-1aaa-360a-9b46-695be0e6afa1",
                        "entry_id": "77331666-76bf-372d-aa6b-b3b04e44d896",
                        "glosses": [
                            "übertragen zu [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf366f90-e809-45b5-acff-cabc11291f4a",
                                "sense_id": "e9d32c37-1aaa-360a-9b46-695be0e6afa1",
                                "text": "\"Der junge Mann auf der Bühne - blonde, strubbelige Haare, Hose auf Halbmast, knallblaues Muskelshirt - hat Angst.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e670d26a-f2a5-4ec9-b262-b44f6bc175c4",
                        "source_entry_id": "77331666-76bf-372d-aa6b-b3b04e44d896",
                        "source_sense_id": "ea064c36-b45a-36da-8abc-dd77121126ac",
                        "source_sense_description": "zum Zeichen offizieller Trauer: nur auf die halbe Höhe des Mastes aufgezogene Fahne/Flagge",
                        "target_lang_word": "half-mast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-mast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46e68ba6-d0e5-30e3-b21e-e600cda40225",
                                        "entry_id": "844a0220-c4ee-34c2-a33d-f0e87fd6ea0a",
                                        "glosses": [
                                            "The lowered position, half the height of a mast, at which a flag is flown when mourning, especially expressing respect for the deceased."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053471ad-aa2f-48f8-8f73-e30c3715f0cf",
                                                "sense_id": "46e68ba6-d0e5-30e3-b21e-e600cda40225",
                                                "text": "Any other UK national flags flown alongside the Union Flag when it is at half-mast should also be at half-mast."
                                            },
                                            {
                                                "example_id": "65a1a524-06c8-4a90-b5f1-7c0909bba647",
                                                "sense_id": "46e68ba6-d0e5-30e3-b21e-e600cda40225",
                                                "text": "He is to be cremated later Thursday at a ceremony likely to be attended by the country's top leadership.\nFlags were seen flying at half-mast in Beijing's Tiananmen Square. China's state news agency Xinhua reported that flags would be lowered at government buildings across mainland China, semi-autonomous regions of Hong Kong and Macau, and in consulates abroad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecaa297c-325e-3e4f-89bd-50ddd3929895",
                                        "entry_id": "844a0220-c4ee-34c2-a33d-f0e87fd6ea0a",
                                        "glosses": [
                                            "The lowered position of anything."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f40db01d-9216-3091-8837-b6bfeba16176",
                                        "entry_id": "844a0220-c4ee-34c2-a33d-f0e87fd6ea0a",
                                        "glosses": [
                                            "An unfashionably short length of a pair of trousers."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280e5d3d-ce3b-4c85-9e68-46412339ec24",
                                                "sense_id": "f40db01d-9216-3091-8837-b6bfeba16176",
                                                "text": "I looked around. Ari in a green jacket with four inches of fore arm showing and trousers at half mast, Penny and I in mismatched padded jackets and ski trousers which were way too long; and all wearing the silver moon boots that had been the rage in the early eighties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26d7467-24b8-3be2-bde4-277e4a55f0a2",
                                        "entry_id": "844a0220-c4ee-34c2-a33d-f0e87fd6ea0a",
                                        "glosses": [
                                            "The state of having a partially erect penis."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1b56160-5a9f-40b7-9f70-8ab76fded2a1",
                                                "sense_id": "f26d7467-24b8-3be2-bde4-277e4a55f0a2",
                                                "text": "Finally, he was at half-mast, hanging out over the toilet seat, barely erect."
                                            }
                                        ]
                                    }
                                ]
                            },
