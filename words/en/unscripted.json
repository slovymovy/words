{
    "word_family": [
        "script",
        "scripted"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4d13e9b-19ae-30f2-a397-9865f6a35d4a",
                    "sense_definition": "Produced or performed without a prepared written script, especially in broadcasting or theatre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_and_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host surprised the audience by giving an entirely <w>unscripted</w> response to the interviewer.",
                            "target_lang_translations": {
                                "nl": "De presentator verraste het publiek door een geheel <w>ongescript</w> antwoord te geven aan de interviewer."
                            }
                        },
                        {
                            "text": "Many viewers prefer <w>unscripted</w> television shows because the emotional reactions seem more genuine.",
                            "target_lang_translations": {
                                "nl": "Veel kijkers geven de voorkeur aan <w>ongescripte</w> televisieprogramma's omdat de emotionele reacties echter lijken."
                            }
                        }
                    ],
                    "synonyms": [
                        "ad-lib",
                        "improvised",
                        "extemporaneous"
                    ],
                    "antonyms": [
                        "scripted"
                    ],
                    "common_phrases": [
                        "unscripted television",
                        "unscripted drama",
                        "completely unscripted"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gemaakt of uitgevoerd zonder een van tevoren geschreven script, vooral in omroep of theater."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongescript",
                                "target_lang_sense_clarification": "zonder uitgeschreven script, met name in media"
                            },
                            {
                                "target_lang_word": "geïmproviseerd",
                                "target_lang_sense_clarification": "zonder voorbereiding ter plekke bedacht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49686041-fa6c-34ae-bae8-f103c818d7a4",
                    "sense_definition": "Occurring spontaneously or unexpectedly rather than according to a predetermined plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spontaneous_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Security guards worked quickly to prevent any <w>unscripted</w> moments during the minister's public speech.",
                            "target_lang_translations": {
                                "nl": "Beveiligers traden snel op om <w>ongeplande</w> momenten tijdens de openbare toespraak van de minister te voorkomen."
                            }
                        },
                        {
                            "text": "An <w>unscripted</w> interruption from a protester disrupted the ceremony.",
                            "target_lang_translations": {
                                "nl": "Een <w>ongeplande</w> onderbreking door een demonstrant verstoorde de ceremonie."
                            }
                        }
                    ],
                    "synonyms": [
                        "spontaneous",
                        "unplanned",
                        "impromptu"
                    ],
                    "antonyms": [
                        "planned",
                        "rehearsed"
                    ],
                    "common_phrases": [
                        "unscripted moment",
                        "unscripted event"
                    ],
                    "target_lang_definitions": {
                        "nl": "Spontaan of onverwacht plaatsvindend, in plaats van volgens een vooraf bepaald plan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongepland",
                                "target_lang_sense_clarification": "niet van tevoren gepland"
                            },
                            {
                                "target_lang_word": "spontaan",
                                "target_lang_sense_clarification": "uit een opwelling voortkomend"
                            },
                            {
                                "target_lang_word": "onvoorzien",
                                "target_lang_sense_clarification": "niet van tevoren verwacht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}