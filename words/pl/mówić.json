    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66c0cadb-64b2-373e-b89e-fd7d5a5462b8",
                    "sense_definition": "wypowiadać słowa, przekazywać coś za pomocą mowy",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On <w>mówi</w> bardzo szybko i trudno go zrozumieć.",
                            "target_lang_translations": {
                                "ru": "Он <w>говорит</w> очень быстро, и его трудно понять.",
                                "en": "He <w>speaks</w> very fast and it's hard to understand him."
                            }
                        },
                        {
                            "text": "Proszę <w>mówić</w> głośniej, bo słabo słyszę.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>говорите</w> громче, так как я плохо слышу.",
                                "en": "Please <w>speak</w> louder because I can't hear well."
                            }
                        }
                    ],
                    "synonyms": [
                        "powiadać",
                        "prawić",
                        "rzec",
                        "gadać"
                    ],
                    "antonyms": [
                        "milczeć"
                    ],
                    "common_phrases": [
                        "mówić głośno",
                        "mówić prawdę"
                    ],
                    "target_lang_definitions": {
                        "ru": "произносить слова, выражать мысли устно",
                        "en": "To utter words, to communicate something through speech."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "произносить слова, вести речь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to use one's voice to say words"
                            },
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to communicate using spoken words"
                            },
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "to pronounce or utter words"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fd889b7-7852-3dd4-b743-e7df46c2a624",
                    "sense_definition": "posługiwać się określonym językiem",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jezyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy <w>mówisz</w> po angielsku?",
                            "target_lang_translations": {
                                "ru": "Ты <w>говоришь</w> по-английски?",
                                "en": "Do you <w>speak</w> English?"
                            }
                        },
                        {
                            "text": "Moja siostra płynnie <w>mówi</w> po francusku.",
                            "target_lang_translations": {
                                "ru": "Моя сестра свободно <w>говорит</w> по-французски.",
                                "en": "My sister <w>speaks</w> French fluently."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mówić po angielsku",
                        "mówić po polsku"
                    ],
                    "target_lang_definitions": {
                        "ru": "владеть или пользоваться каким-либо языком",
                        "en": "To be able to communicate in a specific language."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "владеть иностранным языком"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to be able to communicate in a language"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0812051d-fbfd-3a99-af49-663d7fda4b4e",
                    "sense_definition": "prowadzić z kimś rozmowę, konwersować",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rozmowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym <w>mówić</w> z dyrektorem szkoły.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>поговорить</w> с директором школы.",
                                "en": "I would like to <w>speak</w> with the school principal."
                            }
                        },
                        {
                            "text": "Oni <w>mówią</w> ze sobą od godziny o nowym projekcie.",
                            "target_lang_translations": {
                                "ru": "Они <w>разговаривают</w> друг с другом уже час о новом проекте.",
                                "en": "They have been <w>talking</w> to each other for an hour about the new project."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozmawiać",
                        "gadać"
                    ],
                    "antonyms": [
                        "milczeć"
                    ],
                    "common_phrases": [
                        "mówić z kimś"
                    ],
                    "target_lang_definitions": {
                        "ru": "вести беседу, общаться с кем-либо",
                        "en": "To have a conversation with someone, to converse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "беседовать с кем-либо"
                            },
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "общаться, вести диалог"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to have a conversation with someone"
                            },
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to converse or have a discussion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bb7c57d-06c9-3604-bb32-9d8d5bc0d25c",
                    "sense_definition": "nazywać kogoś w określony sposób, zwracać się do kogoś jakimś imieniem lub tytułem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nazewnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy <w>mówią</w> na niego Tomek, chociaż ma na imię Tomasz.",
                            "target_lang_translations": {
                                "ru": "Все <w>называют</w> его Томек, хотя его зовут Томаш.",
                                "en": "Everyone <w>calls</w> him Tomek, although his name is Tomasz."
                            }
                        },
                        {
                            "text": "Możesz mi <w>mówić</w> po imieniu.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>называть</w> меня по имени.",
                                "en": "You can <w>call</w> me by my first name."
                            }
                        }
                    ],
                    "synonyms": [
                        "nazywać"
                    ],
                    "common_phrases": [
                        "mówić po imieniu",
                        "mówić na ty"
                    ],
                    "target_lang_definitions": {
                        "ru": "называть кого-либо определенным образом, обращаться по имени или титулу",
                        "en": "To call someone by a specific name or title, or to address them in a certain way."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "давать имя, звать"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "называть определенным образом"
                            },
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "в выражениях вроде 'говорить на ты'"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to refer to someone by a name or title"
                            },
                            {
                                "target_lang_word": "address",
                                "target_lang_sense_clarification": "to speak to someone using a specific name or title"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "153c1f0d-0844-3d5d-9006-a5d22d79b8c6",
                    "sense_definition": "o tekstach, książkach lub autorach: zawierać lub przekazywać określone informacje",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta legenda <w>mówi</w> o powstaniu naszego miasta.",
                            "target_lang_translations": {
                                "ru": "Эта легенда <w>рассказывает</w> о возникновении нашего города.",
                                "en": "This legend <w>tells</w> of the origin of our city."
                            }
                        },
                        {
                            "text": "Artykuł w gazecie <w>mówi</w> o zmianach w prawie.",
                            "target_lang_translations": {
                                "ru": "Статья в газете <w>говорит</w> об изменениях в законе.",
                                "en": "The newspaper article <w>talks</w> about changes in the law."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legenda mówi",
                        "autor mówi"
                    ],
                    "target_lang_definitions": {
                        "ru": "содержать или передавать информацию (о текстах, книгах)",
                        "en": "Of texts, books, or authors: to contain, express, or convey specific information."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "сообщать, свидетельствовать в тексте"
                            },
                            {
                                "target_lang_word": "рассказывать",
                                "target_lang_sense_clarification": "повествовать о чем-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "of a text or sign, to express or indicate something"
                            },
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to tell or write about a topic"
                            },
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to discuss or be about a subject"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0638d3f5-a990-39af-87be-fc0e781720f5",
                    "sense_definition": "o rzeczach lub zjawiskach: być oznaką, dowodem lub świadectwem czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "znaczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego zachowanie jasno <w>mówi</w>, że nie jest zadowolony.",
                            "target_lang_translations": {
                                "ru": "Его поведение ясно <w>говорит</w> о том, что он недоволен.",
                                "en": "His behavior clearly <w>shows</w> that he is not satisfied."
                            }
                        },
                        {
                            "text": "Czyste buty wiele <w>mówią</w> o człowieku.",
                            "target_lang_translations": {
                                "ru": "Чистая обувь многое <w>говорит</w> о человеке.",
                                "en": "Clean shoes <w>say</w> a lot about a person."
                            }
                        }
                    ],
                    "antonyms": [
                        "znaczyć",
                        "oznaczać",
                        "świadczyć"
                    ],
                    "common_phrases": [
                        "wiele mówić"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть признаком, доказательством или свидетельством чего-либо",
                        "en": "Of things or phenomena: to be a sign, proof, or testimony of something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить",
                                "target_lang_sense_clarification": "свидетельствовать о чем-либо"
                            },
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "служить признаком"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to indicate or show a fact or feeling clearly"
                            },
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "to indicate or convey a meaning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}