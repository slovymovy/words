                        "examples": [
                            {
                                "example_id": "ea7670f7-65a6-4ea5-8310-3a95220200d5",
                                "sense_id": "56f6f2d1-9a8b-3602-8bc9-6506d3beafd3",
                                "text": "[…] he taught the uncovered head to dare the winter's snow; the unshoed foot to brave the biting ice […]"
                            },
                            {
                                "example_id": "da8d30b8-02d8-44e6-a749-4980a18dfcf0",
                                "sense_id": "56f6f2d1-9a8b-3602-8bc9-6506d3beafd3",
                                "text": "Curled underneath the beading table with the unshoed feet of women, you hear things you'd never want to know."
                            },
                            {
                                "example_id": "deb931c7-daf1-460c-b6e2-5e69896cd3d9",
                                "sense_id": "56f6f2d1-9a8b-3602-8bc9-6506d3beafd3",
                                "text": "Rowena, with one ungainly unshoed foot\nShoves the pail against the plastered wall"
                            }
                        ]
                    }
