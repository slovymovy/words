                                            {
                                                "example_id": "97734bb5-2b64-4136-9543-8e0613e773cd",
                                                "sense_id": "dfc52e31-db0c-3eff-afcd-bfc762e5a5d7",
                                                "text": "Zajmowali się teorią dezinformacji w zastosowaniach wojskowo-politycznych."
