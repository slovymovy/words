                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "a5553b12-d634-4c67-b017-6490ea2541fe",
                                "sense_id": "981de4c5-22cd-3ba2-bcc9-487a319e4093",
                                "text": "„Dort heißt es, die Regelungen im Abgeordnetengesetz sollen ‚deutlich verschärft‘ werden, ‚bezahlte Interessenvertretung‘ von Bundestagsabgeordneten solle verboten, die Bestechung von Parlamentariern zum Verbrechen hochgestuft werden.“"
                            },
                            {
                                "example_id": "214c8755-7465-4417-93b0-e3e8158f6cc5",
                                "sense_id": "981de4c5-22cd-3ba2-bcc9-487a319e4093",
                                "text": "„Am Freitag berieten Mitglieder beider Fraktionen über Änderungen im Strafrecht und im Abgeordnetengesetz.“"
                            }
