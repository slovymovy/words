                        ],
                        "form": "die Geschicklichkeit"
                    },
                    {
                        "form_id": "b90da4fc-0107-44f5-9553-82583c7e4a95",
                        "entry_id": "42a5585e-4bdf-3fa7-a9ca-6c076e50d92e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Geschicklichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                        "entry_id": "42a5585e-4bdf-3fa7-a9ca-6c076e50d92e",
                        "glosses": [
                            "die Fähigkeit, eine Sache schnell und ohne großen Aufwand zu erledigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b5ce98-19fb-42e7-82d3-8e9bba12791f",
                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                "text": "Ständig den Hammer fallen zu lassen, zeugt nicht von hoher Geschicklichkeit."
                            },
                            {
                                "example_id": "c18ca3f7-1469-432d-805c-bd6a560a272b",
                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                "text": "„Eines Tages sah Mr. Marchinton mich fast ganz oben am Flaggenknopf des Großmastes, und nachdem er mir befohlen hatte, herunterzukommen, erhielt ich für meine Geschicklichkeit und Unternehmungslust eine ordentliche Tracht Prügel.“"
                            },
                            {
                                "example_id": "426c0ad9-d23e-4545-a242-3402c97a0e66",
                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                "text": "„Der Gleitschirmflieger benötigt Geschicklichkeit für das Aufziehen seines Segels, Sensibilität für das Schirmverhalten im Fluge und die Auf- und Abwindströmungen.“"
                            },
                            {
                                "example_id": "4a00de79-14a1-4d1f-b7a2-cc0156ceac43",
                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                "text": "„Von diesem Tage an war Natascha unentwegt um den verwundeten Bolkonskij, während der ganzen weiteren Fahrt der Rostows, immer, wenn halt gemacht oder ein Nachtquartier bezogen wurde, und der Arzt musste zugeben, dass er nie von einem jungen Mädchen so viel Energie und so viel Geschicklichkeit in der Krankenpflege erwartet hätte.“"
                            },
                            {
                                "example_id": "38c8f3bd-331b-476e-b811-a1362a781b58",
                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                "text": "„Er wollte dabei seine Geschicklichkeit proben und und die Zeit mit guter Manier hinter sich bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04cf347d-ebac-4557-ade0-dda41b980ac5",
                        "source_entry_id": "42a5585e-4bdf-3fa7-a9ca-6c076e50d92e",
                        "source_sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                        "source_sense_description": "die Fähigkeit, eine Sache schnell und ohne großen Aufwand zu erledigen",
                        "target_lang_word": "dexterity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dexterity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a83ce08-fce7-3b1e-9c2e-51383576b020",
                                        "entry_id": "ddbe2136-f61e-33e1-80c4-4fabec2991b4",
                                        "glosses": [
                                            "Skill in performing tasks, especially with the hands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a00adef-f758-494d-b011-d38e642f9be7",
                                                "sense_id": "3a83ce08-fce7-3b1e-9c2e-51383576b020",
                                                "text": "Playing computer games can improve your manual dexterity."
                                            },
                                            {
                                                "example_id": "f0d705a2-6ed5-4976-9f2a-172e5ffc2d12",
                                                "sense_id": "3a83ce08-fce7-3b1e-9c2e-51383576b020",
                                                "text": "She twirled the pencil through her fingers with impressive dexterity."
                                            },
                                            {
                                                "example_id": "34adb347-b9c4-4798-a74a-03ff30cc53db",
                                                "sense_id": "3a83ce08-fce7-3b1e-9c2e-51383576b020",
                                                "text": "With mutual toil, and intuitive dexterity, we built our commodious habitation in the hollow of a mango tree, that the fruit, which was then in bloſſom, might ſubſiſt our young."
                                            },
                                            {
                                                "example_id": "d16d21bc-7078-495e-81a7-c02b27dacf93",
                                                "sense_id": "3a83ce08-fce7-3b1e-9c2e-51383576b020",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination. The elder woman returned with dressings and a sponge, which she placed on a chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8167caf6-6abb-4fd0-8237-70a16cf30d5b",
                        "source_entry_id": "42a5585e-4bdf-3fa7-a9ca-6c076e50d92e",
                        "source_sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                        "source_sense_description": "die Fähigkeit, eine Sache schnell und ohne großen Aufwand zu erledigen",
                        "target_lang_word": "habileté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habileté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00b0567e-93ca-3f31-b61c-50ed5ee53177",
                                        "entry_id": "4e86c545-7c80-3c0f-892f-eb1dfb64723b",
                                        "glosses": [
                                            "Facilité, disposition, qualité qui rend propre à faire certaines choses, à réussir dans certaines actions, en particulier en utilisant ses mains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437efa06-837d-44f4-a21d-309e9930c4b8",
                                                "sense_id": "00b0567e-93ca-3f31-b61c-50ed5ee53177",
                                                "text": "Il accordait à son frère une grande habileté. Selon lui, ce gros garçon endormi ne sommeillait jamais que d’un œil, comme les chats à l’affût devant un trou de souris."
                                            },
                                            {
                                                "example_id": "799e20cd-9b1c-488d-9407-d01d43476c57",
                                                "sense_id": "00b0567e-93ca-3f31-b61c-50ed5ee53177",
                                                "text": "[…] Marguerite, d’une aiguille d’or à la pointe arrondie, sondait les plaies avec toute la délicatesse et l’habileté que maître Ambroise Paré eût pu déployer en pareille circonstance."
                                            },
                                            {
                                                "example_id": "e0d9ce8d-01a2-4f10-95ae-5b7de77f0b01",
                                                "sense_id": "00b0567e-93ca-3f31-b61c-50ed5ee53177",
                                                "text": "Dès que les gerbes rejoignirent le hameau, Gustave et Le Balkanais entreprirent de constituer les gerbiers de blé et d'avoine. C'était un art ! Leur habileté à les construire était reconnue au-delà de la commune […]."
                                            },
                                            {
                                                "example_id": "aecac9ea-864e-4d35-aff3-05133aa53185",
                                                "sense_id": "00b0567e-93ca-3f31-b61c-50ed5ee53177",
                                                "text": "Je ne suis pas un grand croyant de l'école des habiletés, habiletés et encore habiletés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71f15b0-ef1f-3674-9aba-5496ee66691a",
                                        "entry_id": "4e86c545-7c80-3c0f-892f-eb1dfb64723b",
                                        "glosses": [
                                            "Tour d'adresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23432fba-6dc8-4d07-9f4a-c73a6ae2bfda",
                                                "sense_id": "d71f15b0-ef1f-3674-9aba-5496ee66691a",
                                                "text": "Il y a des crimes qui deviennent innocents et presque glorieux par leur éclat, leur nombre et leurs excès : de là vient que les voleries publiques sont des habiletés et que prendre des provinces injustement s'appelle faire des conquêtes (Voltaire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65c4df2-33fa-3e00-9615-eabcfc5dac56",
