    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50adfc61-f0af-3a9c-92a8-f8ae73836f7d",
                    "sense_definition": "zadbać o należyte wykonanie lub właściwy przebieg czegoś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nadzór",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę osobiście <w>dopilnować</w> wszystkich formalności przed podpisaniem umowy z nowym klientem.",
                            "target_lang_translations": {
                                "ru": "Я должен лично <w>проследить за</w> всеми формальностями перед подписанием договора с новым клиентом."
                            }
                        },
                        {
                            "text": "Kierownik obiecał, że <w>dopilnuje</w> wysłania paczki przed końcem tygodnia.",
                            "target_lang_translations": {
                                "ru": "Руководитель пообещал, что <w>проконтролирует</w> отправку посылки до конца недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "dopatrzyć"
                    ],
                    "common_phrases": [
                        "dopilnować formalności",
                        "dopilnować terminu",
                        "dopilnować szczegółów"
                    ],
                    "target_lang_definitions": {
                        "ru": "позаботиться о надлежащем исполнении или правильном ходе чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проследить",
                                "target_lang_sense_clarification": "за выполнением дела или сроков"
                            },
                            {
                                "target_lang_word": "проконтролировать",
                                "target_lang_sense_clarification": "процесс, результат"
                            },
                            {
                                "target_lang_word": "позаботиться",
                                "target_lang_sense_clarification": "о соблюдении формальностей, деталей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ccc151-b346-391a-94d2-b46351e728e5",
                    "sense_definition": "roztoczyć nad kimś opiekę lub nadzór, pilnując, by zrobił to, co należy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nadzór",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama poprosiła mnie, abym <w>dopilnował</w> młodszego brata przy odrabianiu lekcji.",
                            "target_lang_translations": {
                                "ru": "Мама попросила меня <w>присмотреть за</w> младшим братом, пока он делает уроки."
                            }
                        },
                        {
                            "text": "Nauczyciel uważnie <w>dopilnował</w> uczniów w trakcie trwania egzaminu pisemnego.",
                            "target_lang_translations": {
                                "ru": "Учитель внимательно <w>следил за</w> учениками во время письменного экзамена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dopilnować dziecka"
                    ],
                    "target_lang_definitions": {
                        "ru": "присмотреть за кем-либо, проконтролировать чьи-то действия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присмотреть",
                                "target_lang_sense_clarification": "за кем-то, оказать надзор"
                            },
                            {
                                "target_lang_word": "проследить",
                                "target_lang_sense_clarification": "чтобы кто-то сделал порученное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e60fb9f-46d8-398f-a5ee-406955336495",
                    "sense_definition": "wzajemnie sprawować nad sobą opiekę lub nadzór",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nadzór",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas niebezpiecznej wycieczki turyści musieli <w>dopilnować</w> się nawzajem na szlaku.",
                            "target_lang_translations": {
                                "ru": "Во время опасного похода туристам пришлось <w>присматривать друг за другом</w> на тропе."
                            }
                        },
                        {
                            "text": "Pracownicy powinni <w>dopilnować</w> się w zespole, aby nikt nie popełnił błędu.",
                            "target_lang_translations": {
                                "ru": "Сотрудникам следует <w>контролировать друг друга</w> в команде, чтобы никто не допустил ошибки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dopilnować się nawzajem"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно присмотреть друг за другом, проконтролировать друг друга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присмотреть друг за другом",
                                "target_lang_sense_clarification": "взаимно"
                            },
                            {
                                "target_lang_word": "проконтролировать друг друга",
                                "target_lang_sense_clarification": "в работе или задаче"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e5a2727-f87c-3939-aaf4-b50b206180b7",
                    "sense_definition": "zostać załatwionym, doprowadzonym do właściwego porządku",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nadzór",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taka ważna sprawa nie może <w>dopilnować</w> się sama bez naszej ingerencji.",
                            "target_lang_translations": {
                                "ru": "Такое важное дело не может <w>уладиться</w> само собой без нашего вмешательства."
                            }
                        },
                        {
                            "text": "Projekt musiał <w>dopilnować</w> się na czas dzięki zaangażowaniu zespołu.",
                            "target_lang_translations": {
                                "ru": "Проект должен был <w>завершиться должным образом</w> в срок благодаря вовлечённости команды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "решиться, уладиться, быть доведенным до конца (о деле)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уладиться",
                                "target_lang_sense_clarification": "само собой о деле"
                            },
                            {
                                "target_lang_word": "решиться",
                                "target_lang_sense_clarification": "выполниться без сбоев"
                            }
                        ]
                    }
                }
            ]
        }
    ]
