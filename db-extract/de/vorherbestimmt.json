                "senses": [
                    {
                        "sense_id": "817e8bf8-34e3-37a7-8b42-6eec60f9a876",
                        "entry_id": "d07e7c5f-3c8b-3650-8d82-30d17f218dc0",
                        "glosses": [
                            "bereits im Vorwege festgelegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f602c15-31b7-4ce6-8645-ff64e5caeb1f",
                                "sense_id": "817e8bf8-34e3-37a7-8b42-6eec60f9a876",
                                "text": "„Wie man es dreht und wendet, die Vertreibung aus dem Paradies im Zuge des Sündenfalls war ein unvermeidliches und vorherbestimmtes Ereignis.“"
                            },
                            {
                                "example_id": "aa3d1a88-c28f-4fef-9aed-d978f1f9b6ef",
                                "sense_id": "817e8bf8-34e3-37a7-8b42-6eec60f9a876",
                                "text": "„So wird das heterosexuelle als ein ‚konservatives', eingeengtes und vorherbestimmtes Leben im Alter gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
