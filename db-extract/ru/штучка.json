                ],
                "senses": [
                    {
                        "sense_id": "d1fa503c-cdc9-3036-8df6-41ff333d5198",
                        "entry_id": "022137f3-dfc0-37bf-b848-28721d8e0bb4",
                        "glosses": [
                            "разг. уменьш.-ласк. к штука"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3baa3bbe-9cba-4552-856b-746eab96a4ef",
                                "sense_id": "d1fa503c-cdc9-3036-8df6-41ff333d5198",
                                "text": "Какое тонкое обращение! Сейчас можно увидеть столичную штучку."
                            },
                            {
                                "example_id": "65c4e0c3-e23a-417c-bc03-cfcef349088c",
                                "sense_id": "d1fa503c-cdc9-3036-8df6-41ff333d5198",
                                "text": "Я бы вот хотел... узнать, как вы думаете, и вообще, что вы за штучка."
                            },
                            {
                                "example_id": "a5385363-f906-42c2-aab6-e23cf5b9c91e",
                                "sense_id": "d1fa503c-cdc9-3036-8df6-41ff333d5198",
                                "text": "Дайте одну штучку."
                            },
                            {
                                "example_id": "0b871e13-0ca1-4974-b3a3-2cf82529f997",
                                "sense_id": "d1fa503c-cdc9-3036-8df6-41ff333d5198",
                                "text": "Соломин дал и мужу и жене проделать над ним все ихние штучки."
                            }
                        ]
                    },
                    {
                        "sense_id": "007d8502-736a-3ddd-a6e1-93d435fa2718",
                        "entry_id": "022137f3-dfc0-37bf-b848-28721d8e0bb4",
                        "glosses": [
