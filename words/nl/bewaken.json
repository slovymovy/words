{
    "word_family": [
        "bewaker",
        "bewaking",
        "onbewaakt",
        "waken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14b240a5-a4a7-31bf-b54f-425a8840b960",
                    "sense_definition": "toezicht houden op de veiligheid van iets of iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieagenten <w>bewaken</w> de ingang van het paleis de hele dag.",
                            "target_lang_translations": {
                                "en": "The police officers <w>guard</w> the entrance to the palace all day."
                            }
                        },
                        {
                            "text": "De president wordt 24/7 door zijn eigen team <w>bewaakt</w>.",
                            "target_lang_translations": {
                                "en": "The president is <w>guarded</w> 24/7 by his own team."
                            }
                        }
                    ],
                    "synonyms": [
                        "behoeden",
                        "beveiligen",
                        "passen op"
                    ],
                    "common_phrases": [
                        "de ingang bewaken",
                        "dag en nacht bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to supervise the safety of something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to protect from danger or attack"
                            },
                            {
                                "target_lang_word": "watch over",
                                "target_lang_sense_clarification": "to keep an eye on for safety"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02742679-b6bf-3927-8473-178edaf1029e",
                    "sense_definition": "ervoor zorgen dat iemand niet ontsnapt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangenen worden constant <w>bewaakt</w> door gewapende bewakers.",
                            "target_lang_translations": {
                                "en": "The prisoners are constantly <w>guarded</w> by armed guards."
                            }
                        },
                        {
                            "text": "Het is de taak van de cipier om de verdachte goed te <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "It is the jailer's job to <w>guard</w> the suspect well."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een gevangene bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that someone does not escape"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to keep watch over a prisoner"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to keep under surveillance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5293dc01-635b-3f70-ac85-dea832a1e6a4",
                    "sense_definition": "iets nauwlettend in het oog houden of controleren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toezicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige moet de hartslag van de patiënt voortdurend <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "The nurse must constantly <w>monitor</w> the patient's heart rate."
                            }
                        },
                        {
                            "text": "Het is essentieel om de grenzen van het project goed te <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "It is essential to <w>safeguard</w> the boundaries of the project properly."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewaren"
                    ],
                    "common_phrases": [
                        "het budget bewaken",
                        "de kwaliteit bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to closely monitor or control something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monitor",
                                "target_lang_sense_clarification": "to observe and check the progress of something"
                            },
                            {
                                "target_lang_word": "safeguard",
                                "target_lang_sense_clarification": "to protect or maintain standards or interests"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to keep a close eye on a process or value"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eff2c4a-1788-3c4d-b71d-fb394a2f0a52",
                    "sense_definition": "zorgen dat een tegenstander in een sportwedstrijd niet kan scoren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevaarlijke spits werd continu <w>bewaakt</w> via mandekking.",
                            "target_lang_translations": {
                                "en": "The dangerous striker was continuously <w>marked</w> via man-to-man defense."
                            }
                        },
                        {
                            "text": "Onze verdediger moest de beste speler van de tegenstander strak <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "Our defender had to <w>guard</w> the opponent's best player closely."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een speler bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to prevent an opponent in a sports match from scoring"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "to stay close to an opponent in sports"
                            },
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to defend against a specific player"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}