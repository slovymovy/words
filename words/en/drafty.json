    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90e558d7-8bf9-362c-864a-07a9d7c9ddda",
                    "sense_definition": "Allowing cold air to enter through gaps or poor seals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old windows are very <w>drafty</w> during the winter months.",
                            "target_lang_translations": {
                                "cs": "Stará okna jsou během zimních měsíců velmi <w>táhnoucí</w>."
                            }
                        },
                        {
                            "text": "We need to fix the <w>drafty</w> door to keep the house warm.",
                            "target_lang_translations": {
                                "cs": "Musíme opravit <w>táhnoucí</w> dveře, aby v domě bylo teplo."
                            }
                        }
                    ],
                    "synonyms": [
                        "breezy"
                    ],
                    "antonyms": [
                        "airtight"
                    ],
                    "common_phrases": [
                        "drafty room",
                        "drafty house",
                        "drafty window"
                    ],
                    "target_lang_definitions": {
                        "cs": "Propouštějící studený vzduch skrze škvíry nebo špatné těsnění."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "průvanový",
                                "target_lang_sense_clarification": "vztahující se k místu, kde táhne"
                            },
                            {
                                "target_lang_word": "táhnoucí",
                                "target_lang_sense_clarification": "popisující okno nebo dveře, kterými proudí vzduch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d248835-113a-305d-8756-fd4144ff547c",
                    "sense_definition": "Exposed to currents of cold air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sitting near the door makes this corner feel quite <w>drafty</w>.",
                            "target_lang_translations": {
                                "cs": "Sezení u dveří způsobuje, že je v tomto rohu cítit <w>průvan</w>."
                            }
                        },
                        {
                            "text": "The hallway is always <w>drafty</w> when the wind blows outside.",
                            "target_lang_translations": {
                                "cs": "Na chodbě je vždy <w>průvan</w>, když venku fouká vítr."
                            }
                        }
                    ],
                    "synonyms": [
                        "windy"
                    ],
                    "common_phrases": [
                        "feel drafty"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vystavený proudění studeného vzduchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "v průvanu",
                                "target_lang_sense_clarification": "stav, kdy je člověk nebo místo vystaveno průvanu"
                            },
                            {
                                "target_lang_word": "profouklý",
                                "target_lang_sense_clarification": "místo, kde je cítit proudění vzduchu"
                            }
                        ]
                    }
                }
            ]
        }
