                ],
                "senses": [
                    {
                        "sense_id": "35acec93-22c2-3b41-9740-2229fccc5559",
                        "entry_id": "2d9389cc-4f3a-337c-878b-62cd55a56479",
                        "glosses": [
                            "Retirer (ce qui avait été appliqué)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0b0e79-a991-48a5-8bd9-d764fefbe3cf",
                                "sense_id": "35acec93-22c2-3b41-9740-2229fccc5559",
                                "text": "Pour désappliquer l’instrument, j’ai fait pratiquer un robinet x à la tubulure ; il sert à laisser pénétrer l’air par la partie supérieure pour désappliquer l’instrument sans douleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1b287a-27dd-3394-b079-254039fc3572",
                        "entry_id": "2d9389cc-4f3a-337c-878b-62cd55a56479",
                        "glosses": [
                            "Ne plus appliquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eec9005-906c-4e19-a239-3a1b01e16296",
                                "sense_id": "8d1b287a-27dd-3394-b079-254039fc3572",
                                "text": "En particulier, le juge italien demandait si cette disposition imposait aux juges nationaux de désappliquer les normes internes contraires au droit de la C.E.D.H."
                            }
                        ]
                    },
                    {
                        "sense_id": "8be023f2-80be-3f17-b6bf-ada42b9eefa6",
                        "entry_id": "2d9389cc-4f3a-337c-878b-62cd55a56479",
                        "glosses": [
                            "Ne plus s’appliquer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "d75c723c-10aa-42b8-891e-10ee4a50ba1f",
                                "sense_id": "8be023f2-80be-3f17-b6bf-ada42b9eefa6",
                                "text": "On argumente par l’étymologie, quand on dit, par exemple, que plusieurs personnes du monde ne se divertissent jamais, à proprement parler; parce que se divertir, c’est se désappliquer des occupations sérieuses, et qu’elles ne s’occupent jamais sérieusement."
                            }
                        ]
                    }
