                "senses": [
                    {
                        "sense_id": "00df423b-860d-321e-a8be-602fdf1b6109",
                        "entry_id": "bf569258-8a50-334b-8870-9f0d67cdd4c7",
                        "glosses": [
                            "Consacrer un sujet à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f589469-ff76-4e4c-bdbd-b74dbf7ca3a6",
                                "sense_id": "00df423b-860d-321e-a8be-602fdf1b6109",
                                "text": "Tout en se multipliant, les utopies se «topicisent» de plus en plus : l’effet de réalisme augmente en proportion à mesure d’une foi qui voit dans le XIX^(ème) siècle les premiers essais de fonder, surtout dans le nouveau continent, de véritables communautés utopiques dans le monde réel."
                            },
                            {
                                "example_id": "64729de5-6d9a-42a5-b5d2-0c1bdf09e016",
                                "sense_id": "00df423b-860d-321e-a8be-602fdf1b6109",
                                "text": "Je vais le topiciser de ce pas."
                            },
                            {
                                "example_id": "9de7e4ba-5c23-46e5-a3d5-32c0db617fe9",
                                "sense_id": "00df423b-860d-321e-a8be-602fdf1b6109",
                                "text": "Merci Logan d'avoir topicisé mes pensées"
                            },
                            {
                                "example_id": "2807982a-ade6-41fc-978a-366e01007046",
                                "sense_id": "00df423b-860d-321e-a8be-602fdf1b6109",
                                "text": "d'ailleurs, y a-t-il un topic qui n'ait été topicisé dans ce bistrot floodesque ???"
                            }
                        ]
                    }
