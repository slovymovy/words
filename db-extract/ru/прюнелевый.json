                                        "entry_id": "77d755f7-d32a-34c7-9073-d92d33693e7a",
                                        "glosses": [
                                            "A smooth worsted or silk fabric, generally black, formerly used for making shoes and clergymen's gowns."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1238563a-3e14-4e53-90af-2821ac890e59",
                                                "sense_id": "a5dd8619-ddf9-329f-a492-abac5405dd44",
                                                "text": "When Edna knocked at Mademoiselle Reisz's front room door and entered, she discovered that person standing beside the window, engaged in mending or patching an old prunella gaiter."
                                            }
                                        ]
                                    }
                                ]
