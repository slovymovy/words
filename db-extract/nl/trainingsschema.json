                        "examples": [
                            {
                                "example_id": "57ae97ff-78cd-4ee3-ad1e-0f4a049db86f",
                                "sense_id": "2c1ee76f-9150-33e8-b8f4-47c08dee8862",
                                "text": "Olympisch succes leek niettemin plots ver weg toen Head in maart bij een duikeling van haar fiets een rib brak. Het duo hield het hoofd echter koel en liep in hoog tempo de achterstand op het geplande trainingsschema in. Dat leidde in mei alweer tot de Europese titel en in juni tot een wereldrecord, geroeid tijdens de wereldbekerstrijd in het Poolse Poznan."
                            },
                            {
                                "example_id": "b20b3fdb-1899-4164-8886-3142a570e35f",
                                "sense_id": "2c1ee76f-9150-33e8-b8f4-47c08dee8862",
                                "text": "Paulis en Head hadden tweeënhalve week geleden al hun vorm getoond door in Brandenburg de Europese titel in de wacht te slepen. Dat betekende een flinke opsteker voor het duo dat de olympische missie bijna in duigen had zien vallen toen Head bij een duikeling van haar fiets een rib brak. De achterstand op het geplande trainingsschema is echter bijtijds ingelopen."
                            }
                        ]
                    }
