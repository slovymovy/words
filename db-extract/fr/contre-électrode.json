                "senses": [
                    {
                        "sense_id": "05ba38cb-8a52-333d-b3ca-df473d5903eb",
                        "entry_id": "ba26c0ba-275d-3170-a562-02f34d98be31",
                        "glosses": [
                            "Dans une solution électrolytique, électrode qui n’est pas l’électrode de travail (celle à laquelle on s’intéresse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25ad666d-5df9-4abc-80ad-6a57d837db13",
                                "sense_id": "05ba38cb-8a52-333d-b3ca-df473d5903eb",
                                "text": "Dans sa version originale, le montage se compose d’un capillaire en verre contenant la solution à électronébuliser dans lequel est inséré un fil métallique jouant le rôle d’électrode. La contre-électrode est constituée par la masse du circuit électrique."
                            },
                            {
                                "example_id": "9eef9fb3-18be-4f86-88c5-fd7174649e37",
                                "sense_id": "05ba38cb-8a52-333d-b3ca-df473d5903eb",
                                "text": "Concentriquement aux électrodes principales, on a disposé d’autres électrodes dites contre-électrodes, lesquelles sont mises à la terre soit directement, soit par l’intermédiaire de la paroi de la chaudière."
                            },
                            {
                                "example_id": "50452b96-5b59-4c5d-b3c0-f2f90ba3bfa7",
                                "sense_id": "05ba38cb-8a52-333d-b3ca-df473d5903eb",
                                "text": "Les contre-électrodes en carbone ou en platine fermant le circuit électrique sont situées au fond de la cellule d’essai en PVC."
                            }
                        ]
                    }
