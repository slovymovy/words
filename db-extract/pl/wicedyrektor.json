                                    },
                                    {
                                        "sense_id": "4850f449-ce5c-35e4-a646-e0ecf7bbc41f",
                                        "entry_id": "42b0a622-a1e2-384a-b54c-698fde08980a",
                                        "glosses": [
                                            "A grip or grasp."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf34c601-ea4a-4172-b9ce-b0da4e58d269",
                                                "sense_id": "4850f449-ce5c-35e4-a646-e0ecf7bbc41f",
                                                "text": "Fang. If I but fiſt him once: if he come but within my Vice."
                                            }
                                        ]
