                "senses": [
                    {
                        "sense_id": "10610b5b-95cf-3d7d-bd44-da094ac152f9",
                        "entry_id": "082a6540-5f5a-3cff-84d0-6fa54f8f11fe",
                        "glosses": [
                            "finanzwirtschaftlicher Vertrag, dessen Wert sich von einer marktbezogenen Referenzgröße ableitet"
                        ],
                        "tags": [
                            "Finanzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7516f7aa-d4ba-4f9a-a6fe-1ea93f3d9dc0",
                                "sense_id": "10610b5b-95cf-3d7d-bd44-da094ac152f9",
                                "text": "„Unter einem Finanzderivat oder einem derivativen Finanzinstrument versteht man daher eine Anlageform, die von einfachen direkten Finanzanlagen abgeleitet worden ist. Der Wert des Derivats hängt dabei vom Wert des zugrunde liegenden Instruments (Underlying oder Basiswert) ab. Im Grunde genommen geht der Anleger eine Finanzwette ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
