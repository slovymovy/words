                    },
                    {
                        "translation_id": "206763b4-6d1b-40af-90a8-ce268a2e4394",
                        "source_entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "source_sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                        "target_lang_word": "magnetar",
