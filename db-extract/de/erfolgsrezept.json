                "senses": [
                    {
                        "sense_id": "7f57f480-3d36-3d40-9f30-cccdc0202355",
                        "entry_id": "e1acd95c-cfb4-3db6-92dd-2b83dc7e1e69",
                        "glosses": [
                            "optimales Konzept, um einen Erfolg zu erzielen/ein Ziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9695626d-1eb9-4acb-93e3-3052fcb469a7",
                                "sense_id": "7f57f480-3d36-3d40-9f30-cccdc0202355",
                                "text": "Dank seines Erfolgsrezepts schaffte er das Lernen für den Test in einer Viertelstunde."
                            },
                            {
                                "example_id": "f0d379dc-ada1-4072-90da-1bcd5114bceb",
                                "sense_id": "7f57f480-3d36-3d40-9f30-cccdc0202355",
                                "text": "„Das eigentliche Geheimnis geheimer Erfolgsrezepte an der Börse ist daher, dass es keine gibt.“"
                            },
                            {
                                "example_id": "4118e373-748b-4345-a760-31846841432f",
                                "sense_id": "7f57f480-3d36-3d40-9f30-cccdc0202355",
                                "text": "„Sein Erfolgsrezept war einfach: Er setzte sich als radikaler Exponent an die Spitze der ghanaischen Bewegung und schlug durch seine Forderungen nach sofortiger Unabhängigkeit alle Konkurrenten aus dem Feld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
