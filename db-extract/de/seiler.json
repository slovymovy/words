                ],
                "senses": [
                    {
                        "sense_id": "c708bc23-2e96-34a9-a9da-392181c78eb9",
                        "entry_id": "508d90a4-07ec-31ce-b830-3e25c78577b6",
                        "glosses": [
                            "Handwerker, der Seile herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee2d122-40a4-4e1e-904f-8de822eff86f",
                                "sense_id": "c708bc23-2e96-34a9-a9da-392181c78eb9",
                                "text": "Der Seiler betreibt sein Handwerk mit großer Sorgfalt."
                            },
                            {
                                "example_id": "90124d02-0f99-43e9-a8fc-2be7ecd114c8",
                                "sense_id": "c708bc23-2e96-34a9-a9da-392181c78eb9",
                                "text": "„Er nickte den Seilern zu, die ihre Drittelmeilen abschritten und dabei unermüdlich Hanf- und Leinenstränge, die schon mindestens einmal zusammengedreht worden waren, zu Kabeln, Trossen oder Seilen zusammendrehten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc1160a7-eebb-4ee9-ae84-d8fa2877641c",
                        "source_entry_id": "508d90a4-07ec-31ce-b830-3e25c78577b6",
                        "source_sense_id": "c708bc23-2e96-34a9-a9da-392181c78eb9",
                        "source_sense_description": "Handwerker, der Seile herstellt",
                        "target_lang_word": "rope maker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d8723b3-1450-4427-8551-6dfea8aff68a",
                        "source_entry_id": "508d90a4-07ec-31ce-b830-3e25c78577b6",
                        "source_sense_id": "c708bc23-2e96-34a9-a9da-392181c78eb9",
                        "source_sense_description": "Handwerker, der Seile herstellt",
                        "target_lang_word": "cordier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b530a539-5d3b-3e62-84f9-9fe0046e4da9",
                                        "entry_id": "64503a6c-dca6-3f64-a47a-f2edaae20693",
                                        "glosses": [
                                            "Relatif à la fabrication ou au commerce de cordes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84a72e6e-53a7-3c39-80c8-7ac0080c9546",
                                        "entry_id": "64503a6c-dca6-3f64-a47a-f2edaae20693",
                                        "glosses": [
                                            "Qualifie une vache grasse propre à la consommation humaine."
                                        ],
                                        "tags": [
                                            "Au féminin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cordier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7f6568-d4c5-308f-85cd-236a789019d4",
                                        "entry_id": "7b77e6f7-286c-3239-a750-54660020228b",
                                        "glosses": [
                                            "Celui qui fabrique ou vend des cordes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f89588c-2cd9-4686-abff-1cd724e775d2",
                                                "sense_id": "1b7f6568-d4c5-308f-85cd-236a789019d4",
                                                "text": "Les deux groupes s’étirèrent en deux files et les files se mirent à monter les degrés, se rapprochant peu à peu comme les torons d’une même corde qu’assemble le cordier."
                                            },
                                            {
                                                "example_id": "dc44bb24-2a34-4f34-8d6c-f09e7b1baa8f",
                                                "sense_id": "1b7f6568-d4c5-308f-85cd-236a789019d4",
                                                "text": "Les cordiers constituent une profession peu estimée dans de nombreuses villes : c’est un ancien métier de lépreux, il est surveillé dans les ports de mer comme Nantes puisque de la solidité des cordages dépend la survie des matelots."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cordier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02147e6c-dc2e-3d3e-83cd-98e891702e18",
                                        "entry_id": "99b7b78e-367e-3402-ad6d-e46575f4f3e1",
                                        "glosses": [
                                            "Bateau de pêche utilisant de très longs cordages munis d’hameçons."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40420cc2-fd12-4cbe-b476-5930182d688b",
                                                "sense_id": "02147e6c-dc2e-3d3e-83cd-98e891702e18",
                                                "text": "Un bateau partait à la pêche, un cordier, dont les paniers étaient rangés sur le pont."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cordier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f84c2997-2398-3778-aabe-6eb1b9efff8e",
                                        "entry_id": "ba1b0048-34e7-3ce2-8bcd-b3de97c12822",
                                        "glosses": [
                                            "Dispositif situé au bas de la table d’un luth, ou d’un violon, et où sont attachées les cordes de l’instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c334822-5ec5-4f67-8193-a7410e5584a6",
                                                "sense_id": "f84c2997-2398-3778-aabe-6eb1b9efff8e",
                                                "text": "Le cordier du violon retient les quatre cordes à leur base ; celui de la guitare comporte six, ou douze encoches."
                                            },
                                            {
                                                "example_id": "3bc3612f-6122-4744-b6da-92079e036277",
                                                "sense_id": "f84c2997-2398-3778-aabe-6eb1b9efff8e",
                                                "text": "Le cordier, qui se remarque sur les rebecs et sur les vielles, n’existe plus sur la viole angevine, où les cordes sont attachées à la table comme pour la guitare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
