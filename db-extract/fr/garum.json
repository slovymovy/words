                    {
                        "sense_id": "ee87ad3d-1db7-3fcf-9614-e5f46c81c3da",
                        "entry_id": "cb2e1d63-58ed-3723-bca2-01338fb24937",
                        "glosses": [
                            "Sorte de saumure que faisaient les Romains en recueillant les liquides qui s’écoulaient de petits poissons salés et qu’ils aromatisaient fortement."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5ccc76-ba3b-44a7-8860-f02eb5703e46",
                                "sense_id": "ee87ad3d-1db7-3fcf-9614-e5f46c81c3da",
                                "text": "Palmyre importait aussi le garum qui n’est autre que le nuoc-mâm : du poisson macéré dans du sel, condiment obligé de la cuisine antique."
                            },
                            {
                                "example_id": "3d9360dd-5b3f-4080-bf8e-4d8ab84b08f9",
                                "sense_id": "ee87ad3d-1db7-3fcf-9614-e5f46c81c3da",
                                "text": "À l’opposé du lard dur, il y a ce qu’on pourrait appeler une anticonserve, le garum qui, lui aussi, appartient à l’univers du banquet."
                            }
                        ]
                    }
                ],
