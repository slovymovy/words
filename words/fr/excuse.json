                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah, <w>excuse</w>, je ne voulais pas te bousculer dans le couloir étroit."
