                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "358fe488-5533-3e6b-8412-1b5e4a7b5d83",
                                        "entry_id": "3cc343bb-ae87-3a04-8bc8-658b2ad61d75",
                                        "glosses": [
                                            "Arbeiterbewegung in den romanischen Ländern, die auf gewerkschaftlicher Grundlage nach einer staaten- und klassenlosen Gesellschaft strebte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afbb3cbf-d35f-4548-964a-27bcde120eb1",
                                                "sense_id": "358fe488-5533-3e6b-8412-1b5e4a7b5d83",
                                                "text": "„Ideengeschichtlich stellt der Anarchosyndikalismus eine Ergänzung des Anarchismus um den revolutionären Syndikalismus dar.“"
                                            },
                                            {
                                                "example_id": "ecc7b7f8-cd52-49b3-9107-88397b34a89e",
                                                "sense_id": "358fe488-5533-3e6b-8412-1b5e4a7b5d83",
                                                "text": "„Einen gewissen Einfluß hatte der A. im 19. Jahrhundert vor allem in Rußland und - bis in die Gegenwart fortwirkend - in den romanischen Ländern, im 20. Jahrhundert insbesondere in Form des sich auf den von revolutionären Gewerkschaften geführten wirtschaftlichen Kampf orientierenden Anarchosyndikalismus […].“"
                                            },
                                            {
                                                "example_id": "0e509c96-2a39-468a-a29b-f32c4d5ce720",
                                                "sense_id": "358fe488-5533-3e6b-8412-1b5e4a7b5d83",
                                                "text": "„Am Mittwoch, 2. Mai hält Dieter Nelles ein Referat über die \"Theorie und Praxis des Anarchosyndikalismus in Deutschland\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c640296-eb5c-4ae3-b4d8-e8e99eb120c1",
                        "source_entry_id": "716b9e11-e094-38d2-8f0e-6b2a09ced750",
