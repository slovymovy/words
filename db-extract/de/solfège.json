                ],
                "senses": [
                    {
                        "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                        "entry_id": "c8ac81de-7726-316e-bd1b-66215c9f227d",
                        "glosses": [
                            "Gesangübung mit den Silben der Tonleiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be86d8b8-947a-4828-8b57-0670ce69c2a5",
                                "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                                "text": "„Das hat mich an die Klangstäbe meiner Kindheit erinnert, als ich am Konservatorium das Solfège lernte, und ich war glücklich, überzeugt, dass ich hier gute Arbeit leisten würde.“"
                            },
                            {
                                "example_id": "12eba1bb-c386-42b6-a515-5c76ed94b30f",
                                "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                                "text": "„Dazu dient das Solfège, besonders eine z. B. an der Wiener Musikakademie eingeführte moderne Art desselben, die auch tonal schwer erfaßbare Tonfolgen und komplizierte Rhythmen einbezieht.“"
                            },
                            {
                                "example_id": "19f17b83-eac0-4c45-82f3-b37c023a9fe0",
                                "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                                "text": "„Der Maestro, als furchterregender Schulmeister dargestellt, der die kleinen Chorsänger mit der Peitsche bedroht, wenn sie nicht ihre Solfègen lernen (vielleicht ein Selbstporträt), betritt die Szene, nachdem die Sänger eben festgestellt haben, daß der zum Weihnachtsfest zu singende Villancico wie gewöhnlich nicht geübt worden ist.“"
                            },
                            {
                                "example_id": "20f15643-c3bc-49c2-bcea-ef792e8fe01d",
                                "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                                "text": "„Klingende Konsonanten werden, dynamisch differenziert, lange ausgehalten; ‚textlose Solfègen‘ werden eingestreut.“"
                            },
                            {
                                "example_id": "f166da6e-1d51-4708-8a50-b9d0fda94276",
                                "sense_id": "93012be7-86de-3ac6-af9d-f04832e24ec0",
                                "text": "„Aber auch die beim Unterricht der Solfègen angewandten Mittel erfordern eine gänzliche Reform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
