                ],
                "senses": [
                    {
                        "sense_id": "91dbf4c9-08a1-348c-8fbf-049ccb019f5e",
                        "entry_id": "159a402a-e96e-33cc-a992-fb498548551e",
                        "glosses": [
                            "морск. капитан коммерческого судна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df30827e-7091-4cff-8b06-4763350aeb03",
                                "sense_id": "91dbf4c9-08a1-348c-8fbf-049ccb019f5e",
                                "text": "В XVI веке первые голландские корабли пришли в Колу. Шкипера записали в своих судовых журналах: «Место убогое и холодное»."
                            }
                        ]
                    },
                    {
                        "sense_id": "34ec0402-56a5-3de2-a86c-e8fb50647565",
                        "entry_id": "159a402a-e96e-33cc-a992-fb498548551e",
                        "glosses": [
                            "спец. командир речного судна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b315f5ed-724b-4a04-ac9f-378905912ac4",
                                "sense_id": "34ec0402-56a5-3de2-a86c-e8fb50647565",
                                "text": "Всю жизнь они проплавали по Амуру (работали шкиперами), им хотелось хоть на старость лет быть поближе к Валерке и внукам."
                            }
                        ]
                    },
                    {
                        "sense_id": "50b771c6-96b2-3fba-a166-fe77e755c3bf",
                        "entry_id": "159a402a-e96e-33cc-a992-fb498548551e",
                        "glosses": [
                            "спец. лицо, ответственное за палубное имущество на морских судах [ССРЛЯ]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c248ae6a-5baa-418f-bc6d-b3493c954eff",
                                "sense_id": "50b771c6-96b2-3fba-a166-fe77e755c3bf",
                                "text": "От Вас обратно я ехал всё на том же «Георгии». Рожи его капитана и шкиперов вертятся у меня перед глазами."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d65e06e-12a2-3cc2-9295-61ffc32e264c",
                        "entry_id": "159a402a-e96e-33cc-a992-fb498548551e",
                        "glosses": [
                            "рег. (Воронеж.) таксист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f201a08-4e7c-4e93-b2cb-823fd96ad54a",
                                "sense_id": "8d65e06e-12a2-3cc2-9295-61ffc32e264c",
                                "text": "Шкипер завёз нас в какие-то тигули"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f720140-397e-48cf-b55e-b545b588d02b",
                        "source_entry_id": "159a402a-e96e-33cc-a992-fb498548551e",
                        "target_lang_word": "skipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "897dcd06-f316-3ee6-90aa-978f252aa59e",
                                        "entry_id": "03082de0-5589-3eab-90e0-ebee73838a6a",
                                        "glosses": [
                                            "The master of a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53165579-d2f2-4bc0-946a-be9182fe2833",
                                                "sense_id": "897dcd06-f316-3ee6-90aa-978f252aa59e",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d716c05e-7c55-37a1-9a50-61ce87e6ac98",
                                        "entry_id": "03082de0-5589-3eab-90e0-ebee73838a6a",
                                        "glosses": [
                                            "A coach, director, or other leader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "161bb167-f73c-375b-9867-7cbff3194484",
                                        "entry_id": "03082de0-5589-3eab-90e0-ebee73838a6a",
                                        "glosses": [
                                            "The captain of a sports team such as football, cricket, rugby or curling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21398ce0-e7d0-4e38-b113-75efe8e8a65f",
                                                "sense_id": "161bb167-f73c-375b-9867-7cbff3194484",
                                                "text": "But even the return of skipper Steven Gerrard from a six-week injury layoff could not inspire Liverpool"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21003ab9-5ed6-360f-879b-44a55605a7fc",
                                        "entry_id": "823469d5-148b-390f-a5dc-ce6896bba3d9",
                                        "glosses": [
                                            "To captain a ship or a sports team."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
