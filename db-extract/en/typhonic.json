            {
                "entry_id": "c957867b-dda8-340e-a536-5143b24011fd",
                "word": "Typhonic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f1400480-1f23-4119-8ae3-397fa47df00d",
