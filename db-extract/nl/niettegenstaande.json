                ],
                "translations": [
                    {
                        "translation_id": "dc8f74c2-d3f2-4b02-9058-f38fa2824048",
                        "source_entry_id": "c8772e66-eac4-3c69-97c2-f6631289cd43",
                        "source_sense_id": "c1e7dea0-44c4-3574-ae34-4b50b820c539",
                        "target_lang_word": "notwithstanding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
