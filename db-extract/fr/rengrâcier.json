                ],
                "senses": [
                    {
                        "sense_id": "f9c1661b-0818-398d-8bf5-b359187da48b",
                        "entry_id": "fb1a954a-5e5e-354f-99f4-b0bc606046c9",
                        "glosses": [
                            "Variante orthographique de rengracier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb347941-1f2e-44ec-8451-f4f673f36602",
                                "sense_id": "f9c1661b-0818-398d-8bf5-b359187da48b",
                                "text": "L’autre pouvait faire semblant de rengrâcier et le servir méchamment à l’improviste."
                            },
                            {
                                "example_id": "1ca5d1d5-c94f-4a6d-9ac3-e79d3a079bc8",
                                "sense_id": "f9c1661b-0818-398d-8bf5-b359187da48b",
                                "text": "Même à ce moment-là, en vérité, il était incapable de rengrâcier, son visage grimaçait cyniquement, ses mains tremblaient d’irritation contenue."
                            },
                            {
                                "example_id": "01458be3-2da8-4ee1-9c97-07fd0621bbe6",
                                "sense_id": "f9c1661b-0818-398d-8bf5-b359187da48b",
                                "text": "Profitant de l’indignation légitime provoquée par les magouilles du père pour installer son freluquet de fils à la tête de l'Epad, Hortefeux qui, suite à ses propos racistes, doit rengrâcier essaie de placer deux fichiers certainement très respectueux des personnes."
                            }
                        ]
                    }
                ],
