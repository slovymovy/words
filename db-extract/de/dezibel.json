                "senses": [
                    {
                        "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                        "entry_id": "ec674dd0-8ad8-3c7c-b22b-c1ac2243f41e",
                        "glosses": [
                            "logarithmische Hilfsmaßeinheit zur Unterscheidung von Pegeln und Maßen in der Technik, insbesondere in der Akustik"
                        ],
                        "tags": [
                            "zehnter Teil eines Bels"
                        ],
                        "examples": [
                            {
                                "example_id": "a85588e1-3a43-4f35-a66b-c76e44df3c0f",
                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                "text": "Ein Dauerbombardement des Trommelfells mit 120 Dezibel ist nicht selten – so laut ist ein knapp über den Kopf hinwegfliegender Kampfjet."
                            },
                            {
                                "example_id": "6b4c03d9-85ac-4ac8-8006-eda4bbe6aae7",
                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                "text": "Die üblicherweise in Dezibel (dB) gemessene Angabe beschreibt, in welchem Verhältnis die am Ausgang noch verbliebene Störspannung zum ursprünglichen Wert am Eingang steht."
                            },
                            {
                                "example_id": "09eefd7f-2a99-4b8c-a13e-0d2e136db1da",
                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                "text": "„Als Kriegsgeschädigte durfte keine laute Musik in ihrer Nähe gespielt werden, denn alles über 90 Dezibel könnte bei ihnen zu traumatischen Psychosen führen, wie ein mafianaher Psychiater bestätigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9ede4c5-ed92-47bd-a18c-be72725a86f1",
                        "source_entry_id": "ec674dd0-8ad8-3c7c-b22b-c1ac2243f41e",
                        "source_sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                        "source_sense_description": "logarithmische Hilfsmaßeinheit zur Unterscheidung von Pegeln und Maßen insbesondere in der Akustik",
                        "target_lang_word": "decibel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decibel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fccadc94-0d02-34a7-aa2f-907bd181ca60",
                                        "entry_id": "0482a71e-79e1-349b-aa5a-cd84535a9fd5",
                                        "glosses": [
                                            "A common measure of intensity ratio (e.g. for sound) that is one tenth of a bel on the logarithmic intensity scale. It is defined as dB = 10 log₁₀(P₁ / P₂), where P₁ and P₂ are the relative intensities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08d935be-b422-4935-889d-2fcccf49315b",
                        "source_entry_id": "ec674dd0-8ad8-3c7c-b22b-c1ac2243f41e",
                        "source_sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                        "source_sense_description": "logarithmische Hilfsmaßeinheit zur Unterscheidung von Pegeln und Maßen insbesondere in der Akustik",
                        "target_lang_word": "décibel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décibel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d17ac0-b600-3226-8d2e-05ef67d2021f",
                                        "entry_id": "7792aa7d-fdec-3497-a560-37b1ee185415",
                                        "glosses": [
                                            "Unité de mesure de grandeurs logarithmiques du Système international (SI), valant 10⁻¹ bel, et dont le symbole est dB."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13b5aa9d-e346-4160-8509-20b12e40f393",
                                                "sense_id": "f7d17ac0-b600-3226-8d2e-05ef67d2021f",
                                                "text": "Le décibel exprime les rapports entre grandeurs de même espèce : 10 décibels signifient un rapport dont le logarithme décimal est l’unité (10¹ dB → 10:1) ; un décibel signifie un rapport dont le logarithme décimal vaut 10⁻¹ (1 dB → 10^(0,1):1 ≈ 1,259:1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f6a54af-5531-3a4e-bc0d-99b1568ec038",
                                        "entry_id": "7792aa7d-fdec-3497-a560-37b1ee185415",
                                        "glosses": [
                                            "Unité de mesure de grandeurs logarithmiques du Système international (SI), valant 10⁻¹ bel, et dont le symbole est dB.",
                                            "En particulier pour des volmes sonores"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d82f946-a9cf-4ee6-b7f0-5358409a51e6",
                                                "sense_id": "4f6a54af-5531-3a4e-bc0d-99b1568ec038",
                                                "text": "Soyez attentifs aux décibels (dB) indiqués sur votre appareil. À titre indicatif, une climatisation dite « silencieuse » affiche un volume sonore moyen entre 20 et 30 dB."
                                            },
                                            {
                                                "example_id": "d9941e7c-6442-4ae8-be9e-c18447a8f58d",
                                                "sense_id": "4f6a54af-5531-3a4e-bc0d-99b1568ec038",
                                                "text": "Depuis, les quelque 550 000 riverains de l’autoroute urbaine ont connu une “réduction des nuisances sonores, notamment la nuit : un peu plus d’un décibel en moins la nuit, et 0,5 décibel le jour”, fait valoir l’adjoint à la Transformation de l’espace public. “Il aurait fallu enlever 25% du trafic la nuit” pour arriver à un résultat “équivalent” sans abaissement de la vitesse, calcule l’élu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
