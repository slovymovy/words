                },
                {
                    "sense_id": "14fe41b4-39a4-3491-9952-9f9b228bb9e4",
                    "sense_definition": "Opération consistant à ramener dans leur patrie des contingents militaires, des prisonniers ou du matériel après une mission extérieure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retour_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a enfin annoncé la fin de l'intervention et le <w>rapatriement</w> complet de toutes les troupes déployées."
                        },
                        {
                            "text": "Les négociations ont permis d'accélérer le <w>rapatriement</w> des prisonniers de guerre après la signature du traité de paix."
