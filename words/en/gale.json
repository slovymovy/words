                            },
                            {
                                "target_lang_word": "мирт боло́тный",
                                "target_lang_sense_clarification": "народное название растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc05d77d-c3e8-3c6d-9886-085fc8b12283",
                    "sense_definition": "A periodic payment, such as is made of a rent or annuity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenant was prepared to pay his next <w>gale</w> of rent on Friday.",
                            "target_lang_translations": {
                                "ru": "Арендатор был готов внести свой следующий <w>платеж</w> за аренду в пятницу."
                            }
                        },
                        {
                            "text": "They marked the upcoming <w>gale</w> day on their calendar to avoid late fees.",
                            "target_lang_translations": {
                                "ru": "Они отметили предстоящий день <w>оплаты</w> в своем календаре, чтобы избежать штрафов за просрочку."
                            }
                        }
                    ],
                    "synonyms": [
                        "instalment",
                        "payment"
                    ],
                    "common_phrases": [
                        "gale day"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Irish and dialectal"
                        }
