        "ru-extract.jsonl": [
            {
                "entry_id": "056d4a1a-aaad-3836-b01f-aa77aefeab32",
                "word": "искони",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3fc5eb3-a11b-377c-8661-bd0b8882a9e1",
                        "entry_id": "056d4a1a-aaad-3836-b01f-aa77aefeab32",
                        "glosses": [
                            "высок., устар. с давних, незапамятных пор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e73113-cc53-403c-ad06-8fb64126cd1d",
                                "sense_id": "a3fc5eb3-a11b-377c-8661-bd0b8882a9e1",
                                "text": "Мир искони делился на две части — Восток и Запад."
                            },
                            {
                                "example_id": "cf83d405-9d4c-4d34-885f-5174a2dc3c2e",
                                "sense_id": "a3fc5eb3-a11b-377c-8661-bd0b8882a9e1",
                                "text": "Похоже на то, что наша интеллигенция есть особая нация внутри нации, то-то она искони в оппозиции окопалась и ей всё в России не по душе."
                            }
                        ]
                    }
                ],
