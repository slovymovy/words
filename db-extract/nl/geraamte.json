                            },
                            {
                                "target_word": "skeleton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adcdb8ca-29b8-3c29-b91c-db5a3f1e2c7a",
                                        "entry_id": "f499239a-1f58-36db-a893-5ea6f9c53537",
                                        "glosses": [
                                            "A type of tobogganing in which competitors lie face down, and descend head first."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d0cd0a7-5a49-4395-88a3-2e4ef44522ac",
                                                "sense_id": "adcdb8ca-29b8-3c29-b91c-db5a3f1e2c7a",
                                                "text": "Lugers, who slide feet first and reach the highest speeds, experience some of the same forces, but seem to suffer far fewer concussion-like symptoms than bobsled and skeleton athletes do, probably because a support strap often prevents their heads from banging into the ice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aca6f15b-f44e-48be-95f7-e5503fdfed82",
                        "source_entry_id": "3dc3d2a7-d722-3a1a-8e80-9a4abe8ed00b",
                        "source_sense_id": "23507ae5-cd18-3d26-8204-8d4e5f3b3b36",
                        "target_lang_word": "esqueleto",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esqueleto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0bbc8d73-dbec-303b-85de-9612093ee129",
                                        "entry_id": "059ae76b-a283-3349-9bda-2498f3d7473f",
                                        "glosses": [
                                            "Sistema biológico que proporciona soporte y apoyo a los tejidos blandos y músculos en los organismos vivos vertebrados."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab380e0b-7773-4cfa-b91c-c9c87bb56dae",
                                                "sense_id": "0bbc8d73-dbec-303b-85de-9612093ee129",
                                                "text": "«Desde las estructuras naturales, como los paneles de abejas o nuestro propio esqueleto hasta las estructuras que han creado las personas, todas son un conjunto de elementos que adoptan una cierta disposición, que se relacionan, sustentan a un conjunto y le dan consistencia»."
                                            },
                                            {
                                                "example_id": "70939ad8-a780-4bff-bb86-e18d07244969",
                                                "sense_id": "0bbc8d73-dbec-303b-85de-9612093ee129",
                                                "text": "«Basándose en este principio, fue como pudo prever la presencia de los huesos epipubis en el esqueleto de un mamífero, que por otros caracteres de su esqueleto y de su dentición, comprendió que debía pertenecer a un marsupial (fig. 1), a pesar de que estos mamíferos no se encuentran actualmente en las faunas de Europa»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5374e135-d727-3a99-a9ee-3069120c2613",
                                        "entry_id": "059ae76b-a283-3349-9bda-2498f3d7473f",
                                        "glosses": [
                                            "Por extensión estructura similar que proporciona soporte a construcciones, maquinaria, etc."
                                        ],
