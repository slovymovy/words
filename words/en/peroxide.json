{
    "word_family": [
        "hydroperoxide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e78cae4f-f074-3ee5-8821-4ece084ff4d1",
                    "sense_definition": "Hydrogen peroxide, especially when used in an aqueous solution as a bleach or disinfectant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to dye her hair at home using a bottle of <w>peroxide</w>.",
                            "target_lang_translations": {
                                "zh": "她决定在家用一瓶<w>双氧水</w>染发。"
                            }
                        },
                        {
                            "text": "Be careful when handling <w>peroxide</w> bleach, as it can irritate your skin.",
                            "target_lang_translations": {
                                "zh": "使用<w>双氧水</w>漂白剂时要小心，因为它会刺激皮肤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hydrogen peroxide"
                    ],
                    "common_phrases": [
                        "peroxide bleach"
                    ],
                    "target_lang_definitions": {
                        "zh": "过氧化氢，通常指用作漂白剂或消毒剂的水溶液。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "双氧水",
                                "target_lang_sense_clarification": "指过氧化氢的水溶液，常用于漂白或消毒。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d69f989a-fadd-36bc-b138-bde651d37c95",
                    "sense_definition": "Any chemical compound containing an oxygen–oxygen single bond.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Organic chemistry students studied the stability of benzoyl <w>peroxide</w>.",
                            "target_lang_translations": {
                                "zh": "有机化学专业的学生研究了过氧化苯甲酰的稳定性，这是一种<w>过氧化物</w>。"
                            }
                        },
                        {
                            "text": "The formation of an organic <w>peroxide</w> can create an explosive hazard in solvents.",
                            "target_lang_translations": {
                                "zh": "溶剂中形成的有机<w>过氧化物</w>可能会造成爆炸危险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "organic peroxide",
                        "benzoyl peroxide"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "含有氧-氧单键的任何化学化合物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过氧化物",
                                "target_lang_sense_clarification": "化学术语，指含有过氧基团的化合物。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88adfaac-62e2-3859-badf-38e7ee63713f",
                    "sense_definition": "To bleach hair or treat a material using hydrogen peroxide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accidentally <w>peroxided</w> her hair until it turned bright yellow.",
                            "target_lang_translations": {
                                "zh": "她不小心把头发<w>漂白</w>得变成了亮黄色。"
                            }
                        },
                        {
                            "text": "Many people choose to <w>peroxide</w> hair to achieve a lighter shade.",
                            "target_lang_translations": {
                                "zh": "许多人选择<w>漂白</w>头发以获得更浅的颜色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bleach"
                    ],
                    "common_phrases": [
                        "peroxide hair"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用过氧化氢漂白头发或处理材料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漂白",
                                "target_lang_sense_clarification": "指使用化学物质使头发或材料褪色。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}