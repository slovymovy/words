                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à sang froid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2621438-ff97-3fff-b45e-cba5d39f265d",
                                        "entry_id": "96d03e8a-9c3d-3fd9-bde3-e9fd04c3c562",
                                        "glosses": [
                                            "Dont la température interne est proche de celle de l’environnement. Note d’usage : Les zoologistes n’utilisent plus ce terme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c9da1c3-bcc1-408c-ae1b-cba2654260d5",
                                                "sense_id": "c2621438-ff97-3fff-b45e-cba5d39f265d",
                                                "text": "Les animaux à sang froid sont les seuls qui aient du venin. — (Arthur Schopenhauer, Pensées et fragments)'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3421de02-e5c3-42b4-a55d-279fb5ccbe0a",
                        "source_entry_id": "f2baeb79-eea2-3bdf-9428-3f46098e4ff0",
                        "source_sense_id": "24c19d01-e358-3b04-9bff-d8e3d29fefb6",
                        "source_sense_description": "of or relating to ectotherm; having an unregulated body temperature — see also endothermic",
                        "target_lang_word": "wechselwarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wechselwarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                        "entry_id": "614fe4a1-e7c0-3267-9181-1c3ccbc6571d",
                                        "glosses": [
                                            "die Körpertemperatur mit der Temperatur der Umgebung ändernd, die Körpertemperatur nicht aktiv beeinflussen könnend (beispielsweise durch Muskelzittern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0906d86-010c-4da4-99a3-4a20b15a09cc",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "Schlangen und Echsen sind wechselwarme Tiere."
                                            },
                                            {
                                                "example_id": "6ece4a49-b9d3-4038-8171-19ea851f1014",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Insekten sind wechselwarme Tiere. Der Klimawandel ermöglicht ihnen, sich nach Norden auszubreiten.“"
                                            },
                                            {
                                                "example_id": "ec8ef340-78e3-46db-a814-e9b6e0747b18",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "[…] „bei Kälte müssen wechselwarme Tiere darauf warten, dass sie von der Sonne aufgewärmt werden.“"
                                            },
                                            {
                                                "example_id": "2ffd9c20-eca0-4f12-a834-c2f7f4d43b3c",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Als wechselwarme Tiere sind Reptilien vor allem von der Temperatur und der Sonne abhängig.“"
                                            },
                                            {
                                                "example_id": "009df3a8-8c01-449c-84dc-4bb4e6a1da06",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Wie alle Reptilien sind Echsen wechselwarm. Ihre Körpertemperatur hängt von der Temperatur der Umgebung ab.“"
                                            },
                                            {
                                                "example_id": "7ebc059d-783f-43a6-b2ef-a74534094c46",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Skorpione sind wie alle Gliederfüßer wechselwarme Tiere. Sie können sich nur über die Umgebungstemperatur aufheizen.“"
                                            },
                                            {
                                                "example_id": "bebc79a2-424a-4891-a72c-fd64cd751a09",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "[Heuschrecken:] „Bei den kälteren Nachttemperaturen sind die wechselwarmen Tiere flugunfähig.“"
                                            },
                                            {
                                                "example_id": "c32bfc55-fbdd-4c0b-b3d6-3a20a60fe06b",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Bei Fröschen und ihren Kaulquappen übernimmt das Mikrobiom eine andere, unerwartete Rolle: Die Mikroben arbeiten aktiv daran mit, wie die wechselwarmen Tiere Hitze und Kälte überstehen.“"
                                            },
                                            {
                                                "example_id": "8b8411ff-1fe0-44fa-a7cd-cb7721920bca",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Waren die Saurier gleich- oder wechselwarm?“"
                                            },
                                            {
                                                "example_id": "a678b3d1-0d9d-47fb-8241-40f9c40687a3",
                                                "sense_id": "bcd7ab58-bc52-3b19-a897-aef374658fff",
                                                "text": "„Constantin Urban, Mikrobiologe in Umea: »Ja, das ist natürlich eine schöne Theorie, aber es verdichten sich ja auch die Kennzeichen, dass Dinosaurier nicht wechselwarm waren, sondern eben auch warmblütig.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
