                        "glosses": [
                            "Of, pertaining to, or characteristic of an actor or theatrical acting; like an actor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc546cc2-31fb-4bc4-a9ae-44e17078ea02",
                                "sense_id": "7243f637-d15f-35a4-8501-ec9fd2b22da7",
                                "text": "His flamboyance was more actorish than anything else."
                            },
                            {
                                "example_id": "bf59a3f3-611a-4497-aa2d-785996e6e97f",
                                "sense_id": "7243f637-d15f-35a4-8501-ec9fd2b22da7",
                                "text": "It seemed to me that Rockcliffe Fellows, as Randolph, was altogether too actorish. I should have preferred John Bowers, the altogether natural mild villain, in this part."
                            },
                            {
                                "example_id": "6ba29c0d-0b81-4a28-a6dd-7a04252b4980",
                                "sense_id": "7243f637-d15f-35a4-8501-ec9fd2b22da7",
                                "text": "Do not be too frightened of making your characters perform exaggerated, actorish gestures."
                            }
                        ]
                    }
