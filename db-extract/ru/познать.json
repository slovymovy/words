                        ],
                        "form": "позна́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfadc13a-7c5f-3cf9-8976-d4cfeb5c968d",
                        "entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "glosses": [
                            "приобрести знание, получить истинное представление о ком-либо, чём-либо; постичь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d806e3f7-8168-4726-aff1-28107a385215",
                                "sense_id": "bfadc13a-7c5f-3cf9-8976-d4cfeb5c968d",
                                "text": "Познать сущность явлений."
                            },
                            {
                                "example_id": "8a802246-1670-4979-8837-a439917b8e4d",
                                "sense_id": "bfadc13a-7c5f-3cf9-8976-d4cfeb5c968d",
                                "text": "Познать законы развития природы и общества."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4b2afe4-e573-3bce-9491-741a42eae233",
                        "entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "glosses": [
                            "хорошо узнать, понять чей-либо характер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f9732b-db73-4ced-8031-ca5bc1d3775f",
                                "sense_id": "c4b2afe4-e573-3bce-9491-741a42eae233",
                                "text": "— Познав вас, почувствовал к вам привязанность."
                            },
                            {
                                "example_id": "998cd908-2096-437f-b445-58fa5c4cd0de",
                                "sense_id": "c4b2afe4-e573-3bce-9491-741a42eae233",
                                "text": "В войне я познал и полюбил глубоко свой народ."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3abbd57-8f98-3142-a083-6311e6838a44",
                        "entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "glosses": [
                            "испытать, пережить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0548e6e5-0a28-46e2-a0d9-a98d0a0fe0a0",
                                "sense_id": "c3abbd57-8f98-3142-a083-6311e6838a44",
                                "text": "С младенчества дух песен в нас горел, // И дивное волненье мы познали."
                            },
                            {
                                "example_id": "41d006e1-c236-48a1-baf0-a27f70c696d2",
                                "sense_id": "c3abbd57-8f98-3142-a083-6311e6838a44",
                                "text": "Дважды выбивался он со своим полком из окружения, познал горечь отступления."
                            }
                        ]
                    },
                    {
                        "sense_id": "b306ebef-7a75-3b80-9dcc-f94aacb45308",
                        "entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "glosses": [
                            "устар., эвф. стать в близкие отношения, вступить в половую связь с кем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8131fb9f-a28d-4420-a8c1-ccd2a69e6e47",
                                "sense_id": "b306ebef-7a75-3b80-9dcc-f94aacb45308",
                                "text": "Впервые познать женщину."
                            },
                            {
                                "example_id": "9d71ad57-3c9f-4b8e-8f41-1cb158480e07",
                                "sense_id": "b306ebef-7a75-3b80-9dcc-f94aacb45308",
                                "text": "Адам познал Еву, жену свою; и она зачала, и родила Каина, и сказала: приобрела я человека от Господа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5362ee3-8996-4d51-803f-461a0cf339e5",
                        "source_entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "target_lang_word": "recognise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recognise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                        "entry_id": "ad929cc2-7b36-3f1e-9919-2c6b595d43cd",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of recognize."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0295a463-d27c-447c-a40f-b23734636d2b",
                                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                                "text": "“[…] That woman is stark mad, Lord Stranleigh. Her own father recognised it when he bereft her of all power in the great business he founded. […]”"
                                            },
                                            {
                                                "example_id": "24be033e-9095-4b1c-82ca-4ea07464ec7c",
                                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, and so we entered stage three – what therapists call \"bargaining\". A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul."
                                            },
                                            {
                                                "example_id": "f37cac61-e4e3-4a51-8070-98405b4bed95",
                                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                                "text": "\"When you think about it, who wants to drive 300 tonnes of steel at 125mph in the pitch black at four o'clock in the morning?\" Whelan says this with a wry smile, however, recognising that these are exactly the sort of things that train drivers love about their jobs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6056627-e48d-4860-a290-c65fc13997db",
                        "source_entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "target_lang_word": "realise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                        "entry_id": "e286b38c-11a0-3b77-9593-b71d78897f7b",
                                        "glosses": [
                                            "Non-Oxford British standard spelling of realize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15b1e17-c191-448a-a0bb-1da52deb5e28",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "[F]aith realiſeth the ſufferings of Chriſt; it looks upon Chriſt as the common treaſury of all grace, as the principle of life, and root of holineſs."
                                            },
                                            {
                                                "example_id": "a7e90ce7-9442-449e-9854-f49691cea105",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "All joy or ſorrovv for the happineſs or calamities of others, is produced by an act of the imagination, that realiſes the event hovvever fictitious, or approximates it hovvever remote, by placing us for a time in the condition of him vvhoſe fortune vve comtemplate; […]"
                                            },
                                            {
                                                "example_id": "998420d8-d438-430d-bfcb-ab3b6aabc66e",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "Have faith in God! He shall dispose thy lot, / Nor weep for woe thou realisest not: / They shall precede thee to the better land, / And meet and greet thee on its joyful strand."
                                            },
                                            {
                                                "example_id": "69de9e8e-5f1c-4a7f-aa8a-1c7da7a40db9",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "A lucky purchase which he had made of shares in a copper-mine added very considerably to his wealth, and he realised with great prudence while this mine was still at its full vogue."
                                            },
                                            {
                                                "example_id": "6a2e3dac-77a9-46c7-9124-a57778d1fd53",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "Utterly helpleſs, thou wert ſinking for ever, and realiſedſt not the fearfulneſs of thy poſition, for thus wert thou born and nurtured."
                                            },
                                            {
                                                "example_id": "fe346979-1d97-468f-8778-accaec0cfbd0",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "SHE wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realising that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            },
                                            {
                                                "example_id": "e33c2107-54f4-4612-a961-149fac390448",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "And for the first time she realised what it was to escape from the smallish perfection of England, into the grander imperfection of a great continent."
                                            },
                                            {
                                                "example_id": "5cbfa615-251e-4d2f-b056-86ee76b8f8d6",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "[…] Uxbridge thought it could safely ignore the railway[…]. Like many other towns which adopted similar tactics, Uxbridge soon realised its mistake."
                                            },
                                            {
                                                "example_id": "c9c72c27-0b1f-4dae-93ef-5f3c98552a3f",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "Do you reckon Hissing Sid realises what a shagnasty that Mary is?"
                                            },
                                            {
                                                "example_id": "0d31620a-db6d-4b3c-bbdf-e52f2f041867",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            },
                                            {
                                                "example_id": "37bae8a6-50e2-4581-9596-72671d7e4bf1",
                                                "sense_id": "03b69b0f-756c-332b-aa94-f27f62862e08",
                                                "text": "As the 1857 to Manchester Piccadilly rolls in, I scan the windows and realise there are plenty of spare seats, so I hop aboard. The train is a '221'+'220' combo to allow for social distancing – a luxury on an XC train as normally you're playing sardines, so I make the most of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4e0a2f0-30a5-423a-805a-7bc2446e36ac",
                        "source_entry_id": "f46a8040-70f9-3eaf-968d-5f5632b95e0a",
                        "target_lang_word": "erkennen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erkennen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e79881d-292c-38f4-bf05-bcc650f9ad17",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "etwas oder jemanden so deutlich wahrnehmen, dass man weiß, was oder wer es ist (im Sinne von etwas wiedererkennen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f581d20-5794-4245-8317-196db21d4f82",
                                                "sense_id": "3e79881d-292c-38f4-bf05-bcc650f9ad17",
                                                "text": "Sie erkannte Peter erst, als er direkt vor ihr stand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "265f5c6b-febf-3752-a202-d3315cb04bde",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "identifizieren; auf Grund bestimmter Anzeichen feststellen, um was oder um wen es sich handelt; mit geschultem, sachverständigen Blick erfassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066a4b5d-35eb-4ed2-951e-16bb071aded5",
                                                "sense_id": "265f5c6b-febf-3752-a202-d3315cb04bde",
                                                "text": "Der Antiquitätenhändler erkannte, dass es sich um einen echten Rembrandt handelte."
                                            },
                                            {
                                                "example_id": "59acd47c-8c85-4cdb-901a-42daab319395",
                                                "sense_id": "265f5c6b-febf-3752-a202-d3315cb04bde",
                                                "text": "Das Problem konnte erkannt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "44983749-7f6a-3477-896c-d4421dc856ac",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "jemanden durchschauen, richtig beurteilen, einschätzen, Klarheit gewinnen über jemanden, bezogen auf praktische, ethische Fragen oder Umgangsformen; etwas voll, in seiner eigentlichen Bedeutung begreifen; oft im Gegensatz zum sinnlichen Wahrnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e54914-fab4-4912-a68b-42189e5702ad",
                                                "sense_id": "44983749-7f6a-3477-896c-d4421dc856ac",
                                                "text": "Er erkannte an meiner Reaktion, dass ich die volle Bedeutung seiner Worte erfasst hatte."
                                            },
                                            {
                                                "example_id": "f37ca524-3470-42d7-a948-40329e7b0027",
                                                "sense_id": "44983749-7f6a-3477-896c-d4421dc856ac",
                                                "text": "Mit seinem Sinn fürs Praktische erkannte er schnell, was die Wirkung dieses eigentlich schönen Gartens beeinträchtigte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5c01b807-5450-3693-96e9-956f5849893a",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "etwas umfassend, durch philosophische Systeme, Theorien begreifen; der Mensch erfasst die Realität auf empirische (John Locke), transzendentale (Immanuel Kant) oder sensualistische (Étienne Bonnot de Condillac) Weise; ferner wird erkennen auch als \\\"wiedererkennen\\\" von Erlebtem interpretiert (Moritz Schlick)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27858c3e-c1d6-46ba-abf7-c0cff2d3ff9d",
                                                "sense_id": "5c01b807-5450-3693-96e9-956f5849893a",
                                                "text": "Der Mensch erkennt die Natur nur nach bestimmten Formen und Fähigkeiten seines Geistes."
                                            },
                                            {
                                                "example_id": "14665b71-7e2b-41a0-aa59-4860d0bf4821",
                                                "sense_id": "5c01b807-5450-3693-96e9-956f5849893a",
                                                "text": "Was Menschen erkennen, stammt aus ihrem Empfinden. »Le principal objet de cet ouvrage est de faire voir comment toutes nos connaissances et toutes nos facultés viennent des sens, ou, pour parler plus exactement, des sensations« (Condillac: Trait. d. sens., Extr. rais. p. 31)."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6094bae7-d427-3636-af2f-c48d01b68508",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "im Rahmen eines Urteils ein benanntes Verbrechen bestätigen"
                                        ],
                                        "tags": [
                                            "law"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249a294a-c71f-4556-91bd-4fa4985a5828",
                                                "sense_id": "6094bae7-d427-3636-af2f-c48d01b68508",
                                                "text": "Der Richter erkannte auf Totschlag."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "10640f89-9c7a-3664-8449-ffb21f20a693",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "begatten, Geschlechtsverkehr haben"
                                        ],
                                        "tags": [
                                            "biblischer und literarischer Sprachgebrauch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c3a000-4cb5-4f75-914d-ee58b35a6a61",
                                                "sense_id": "10640f89-9c7a-3664-8449-ffb21f20a693",
                                                "text": "„Und Adam erkannte seine Frau Eva, und sie ward schwanger und gebar den Kain und sprach: Ich habe einen Mann gewonnen mit Hilfe des HERRN.“"
                                            },
                                            {
                                                "example_id": "b4f84204-1d6a-4d2c-98ed-d17595d67848",
                                                "sense_id": "10640f89-9c7a-3664-8449-ffb21f20a693",
                                                "text": "\"auch sein mutter Agrippinam sol er in unkeusch haben erkennt.\" (Hans Sachs)"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "b85aba51-4a6c-3465-8e7e-b4dd6b6d2273",
                                        "entry_id": "1cfc71b1-5e1b-3fdb-896d-478ec5c70729",
                                        "glosses": [
                                            "gutschreiben"
                                        ],
                                        "tags": [
                                            "Buchhaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fae7391-b9b8-4c74-a35e-7c749e89d9d9",
                                                "sense_id": "b85aba51-4a6c-3465-8e7e-b4dd6b6d2273",
                                                "text": "„Links buchen nennt der Buchhalter 'belasten'; und für rechts buchen hat er gleich zwei Ausdrücke: 'gutschreiben' und erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
