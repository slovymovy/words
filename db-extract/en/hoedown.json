                        "sense_id": "bf4f6f9c-2859-3d33-9503-643a129e412d",
                        "entry_id": "be5ee04f-f9fe-3016-ae64-6857fd363731",
                        "glosses": [
                            "A type of American folk or square dance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1001b55f-4d85-4a2b-aa8c-cd37e8b4b1a7",
                                "sense_id": "bf4f6f9c-2859-3d33-9503-643a129e412d",
                                "text": "John and Susie went to the square dance and did the hoedown."
                            },
                            {
                                "example_id": "eec43100-5de2-4ecb-88af-3f0d078d6b3f",
                                "sense_id": "bf4f6f9c-2859-3d33-9503-643a129e412d",
                                "text": "Soon Marshall is doing an elaborate foot-to-foot jig, and then they're all bounding around. Shoulder dips. Yee-ha faces. It's an impromptu hoedown."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae0d600e-f96a-380c-bdbd-fb9b2dfa1714",
                        "entry_id": "be5ee04f-f9fe-3016-ae64-6857fd363731",
                        "glosses": [
                            "The type of music typically played for such a dance"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0afcf78a-f760-309a-bcb6-cddd1aa3513f",
                        "entry_id": "be5ee04f-f9fe-3016-ae64-6857fd363731",
                        "glosses": [
                            "A gathering at which such dances take place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016b0409-8f42-4e90-94c0-64186b9fe711",
                                "sense_id": "0afcf78a-f760-309a-bcb6-cddd1aa3513f",
                                "text": "We have to get to the hoedown before noon, or we'll be late."
                            }
                        ]
                    }
                ],
