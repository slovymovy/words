                "senses": [
                    {
                        "sense_id": "50fbcc72-347b-3fb1-adcd-c7031f29228b",
                        "entry_id": "4483ba06-d5a9-38ba-ad31-bfae0ab6549a",
                        "glosses": [
                            "położony u podnóża Alp, typowy, właściwy tym okolicom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab7592c-3c73-4d99-9998-1fc1aed2015f",
                                "sense_id": "50fbcc72-347b-3fb1-adcd-c7031f29228b",
                                "text": "W obu typach jezior, podalpejskim i bałtyckim, muł po wysuszeniu przybiera barwę szarą"
                            },
                            {
                                "example_id": "0ee678c4-1849-4b9f-a22a-77f2d8994883",
                                "sense_id": "50fbcc72-347b-3fb1-adcd-c7031f29228b",
                                "text": "Zasiej tam, zasadź bluszcze, rozchodniki, / Stulistne róże, podwójne goździki, / Niezapominajki i nieśmiertelniki, / Italskie mirty, podalpejskie dalie, / I borów naszych pamiątkę — konwalie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
