                "senses": [
                    {
                        "sense_id": "b97bf079-47e9-37ea-9163-f924ed784298",
                        "entry_id": "f378d9f6-151a-35dc-be91-5922bb237745",
                        "glosses": [
                            "Person, die Land besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3b707c-c9c4-41a6-bae1-10c72a747c37",
                                "sense_id": "b97bf079-47e9-37ea-9163-f924ed784298",
                                "text": "„Da die Wege auf Privatland verlaufen, wird ein Teil der Teilnahmegebühren an die Landbesitzer abgeführt.“"
                            },
                            {
                                "example_id": "b6bba6dc-e2b1-472b-8e73-9b536fc8413e",
                                "sense_id": "b97bf079-47e9-37ea-9163-f924ed784298",
                                "text": "„D'Annunzio wurde 1873 als Sohn eines reichen Landbesitzers in Pescara an der italienischen Adria geboren.“"
                            },
                            {
                                "example_id": "32f36861-ddf0-4b4e-a15b-1f1f91c03184",
                                "sense_id": "b97bf079-47e9-37ea-9163-f924ed784298",
                                "text": "„Die drückende Steuerlast zwang jedoch viele Landbesitzer (zamindars), sich zu verschulden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
