                "senses": [
                    {
                        "sense_id": "3d7cd341-d628-3460-8f6a-a5f79d77477a",
                        "entry_id": "da32187a-35b7-363f-944a-d7c55cf6cf14",
                        "glosses": [
                            "Donner un caractère apocalyptique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02668bf4-9bb1-4127-b5fb-efce92130f49",
                                "sense_id": "3d7cd341-d628-3460-8f6a-a5f79d77477a",
                                "text": "Loin de nous l'idée de dramaturger, d'apocalyptiser ou de vous faire peur en vous montrant les flammes de l'enfer."
                            },
                            {
                                "example_id": "494b7459-da0e-4c46-adfe-8a218619a566",
                                "sense_id": "3d7cd341-d628-3460-8f6a-a5f79d77477a",
                                "text": "L’application du critère de plausibilité en aval nous fait buter sur un curieux phénomène : la théologie des premiers chrétiens affiche aussi bien une tendance à « apocalyptiser » la tradition de Jésus qu’un penchant à exploiter ses tendances sapientiales."
                            },
                            {
                                "example_id": "9e133430-a2dc-48e7-99ce-c4ff2bd1dc39",
                                "sense_id": "3d7cd341-d628-3460-8f6a-a5f79d77477a",
                                "text": "Il ne faut certes pas «apocalyptiser les nouvelles technologies», dira aussi l'animateur des Etats généraux de la Culture."
                            }
                        ]
                    }
                ],
