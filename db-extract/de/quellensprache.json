                        "glosses": [
                            "die Sprache, aus der ein Wort oder eine sonstige sprachliche Einheit in eine andere übernommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b354ba39-68eb-4d33-aad6-1683965e47c9",
                                "sense_id": "bfe1f473-d0f4-315a-a97a-51a72bed0954",
                                "text": "„Sprechern, die die betreffende Quellensprache nicht beherrschen, sind auch deren graphemisch-phonemische Korrespondenzregeln (GPK-Regeln) nicht bekannt, so daß sie keine andere Wahl haben, als Fremdwörter, die sie in geschriebener Form vorfinden, gemäß der GPK-Regeln ihrer eigenen Sprache auszusprechen und sie so, durch die Schrift vermittelt, deren morpho-phonologischen Regeln zu unterwerfen.“"
                            }
                        ],
