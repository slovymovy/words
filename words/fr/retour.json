                },
                {
                    "sense_id": "4dddf8a9-deb8-3642-908d-6c88fd309955",
                    "sense_definition": "Réciprocité de ce que l'on donne : sentiment, service ou attention que l'on rend en échange.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a beaucoup aidé ses voisins sans rien demander en <w>retour</w>."
                        },
                        {
                            "text": "L'amitié demande du <w>retour</w> : on ne peut pas toujours donner sans recevoir."
