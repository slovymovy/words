    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1c8d9331-d009-3312-8910-edac76d7084a",
                "word": "summat",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdfc71b5-55e3-3a21-9bea-3b6871e01f8c",
                        "entry_id": "1c8d9331-d009-3312-8910-edac76d7084a",
                        "glosses": [
                            "Something (“to a degree”); somewhat."
                        ],
                        "tags": [
                            "England",
                            "Yorkshire",
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "de686653-0e95-481e-95c0-a9eb244f130a",
                                "sense_id": "fdfc71b5-55e3-3a21-9bea-3b6871e01f8c",
                                "text": "It's summat-like to see such a man as that i' the desk of a Sunday!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e8e31a44-19ab-3d16-baa7-5e58fa5c4685",
                "word": "summat",
                "pos": "pron",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                        "entry_id": "e8e31a44-19ab-3d16-baa7-5e58fa5c4685",
                        "glosses": [
                            "Something."
                        ],
                        "tags": [
                            "England",
                            "Yorkshire",
                            "indefinite",
                            "informal",
                            "pronoun"
                        ],
                        "examples": [
                            {
                                "example_id": "ae41c66f-076c-42d1-b150-e02d742238b8",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "...every gentleman tips us summat, we looks for it as natural as possible."
                            },
                            {
                                "example_id": "e4faf20b-1b27-478b-b60b-968cdc732e9f",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "They require the atmosphere of a cigar and the amalgam of a sum'mat comfortable."
                            },
                            {
                                "example_id": "106d9fb8-40d6-41b7-bd65-53cb12efc94d",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "A man must learn summat beside Gospel to make them things."
                            },
                            {
                                "example_id": "82e49fe0-8198-4439-b7c2-e998b683fbb4",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "He were a-going to gie I summat for’n, but like enough it’ll be worth more to a gent like yourself."
                            },
                            {
                                "example_id": "42dde62f-add5-47a2-ae96-ba2bba6dc0ba",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "Does he think I’ve been soaping up to the Governor or summat?"
                            },
                            {
                                "example_id": "a0e5d002-f044-4a08-9c69-8bf2c941dbfe",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "Got summat fer yeh here – I mighta sat on it at some point, but it’ll taste all right."
                            },
                            {
                                "example_id": "a1d82ee4-9e3c-4235-89dc-c3cc22d4f727",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "Why go all the way to find summat that ain’t there?"
                            },
                            {
                                "example_id": "66cdb495-c3f4-4898-9027-2def1ecff046",
                                "sense_id": "5d16462f-f640-3231-8a3b-414452a96a15",
                                "text": "Do you ever get that fear that you can't shift the type / That sticks around like summat in your teeth?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [
            {
                "entry_id": "bfb1c565-cfd1-32d2-a3cf-d8ff39e7e4bb",
                "word": "summat",
                "pos": "pron",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ca4105b-2527-3748-89cd-bb7e5658e628",
                        "entry_id": "bfb1c565-cfd1-32d2-a3cf-d8ff39e7e4bb",
                        "glosses": [
                            "йоркш., разг. то же, что something; что-то, что-нибудь, кое-что, нечто"
                        ],
                        "tags": [
                            "ланкаш."
                        ],
                        "examples": [
                            {
                                "example_id": "fd05cf32-612c-4828-b689-b392ca34fa57",
                                "sense_id": "8ca4105b-2527-3748-89cd-bb7e5658e628",
                                "text": "And there’s such a thing as being oversperitial; we must have something beside Gospel i’ this world. Look at the canals, an’ th’ aqueduc’s, an’ th’ coal-pit engines, and Arkwright’s mills there at Cromford; a man must learn summat beside Gospel to make them things, I reckon.",
                                "translation": "Но, с другой стороны, можно быть уж чересчур набожным; на этом свете мы должны заботиться ещё о многом, кроме Евангелия. Посмотри на каналы, на водопроводы, на орудия, употребляемые в каменноугольных копях, на аркрейтовы мельницы в Кромфорде. Человек, по моему мнению, должен, кроме Евангелия, знать ещё что-нибудь для того, чтоб уметь строить все эти предметы."
                            }
                        ]
                    }
                ],
