                                        "sense_id": "725d8180-1982-33b7-b6e8-b19891b375ed",
                                        "entry_id": "7531db46-eff2-34a3-81ee-d72e958be0a3",
                                        "glosses": [
                                            "Composed of people from all over the world."
                                        ],
