                "senses": [
                    {
                        "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                        "entry_id": "bc57b803-3513-38ed-9391-236a2bf4c550",
                        "glosses": [
                            "Wasser aus atmosphärischem Niederschlag, das nicht durch Gebrauch verunreinigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1c3840-2064-4563-a4fb-c75dc212eece",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Die Versickerung von Niederschlagswasser stellt nach § 4 des Niedersächsischen Wassergesetzes (NWG) eine \"Benutzung\" des Grundwassers dar.“"
                            },
                            {
                                "example_id": "503f7eef-16c8-4b13-8887-8c6891a7e3e2",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Die Niederschlagswassergebühr bemisst sich grundsätzlich nach der bebauten und befestigten Grundstücksfläche, von der Niederschlagswasser in die öffentliche Abwasseranlage gelangt.“"
                            },
                            {
                                "example_id": "2c86b91c-53dc-4a1f-b47a-8fc02d647707",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Auf den befestigten Grundstücksflächen (Dach, Wege-, Hof- und Terrassenflächen) fällt Niederschlagswasser an, das ebenfalls umweltverträglich beseitigt werden muss.“"
                            },
                            {
                                "example_id": "c2bd4d5d-6635-4c2c-979b-85d7f87f021e",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Anfang der 90er Jahre fand ein Umdenken der bisher gängigen Vorgehensweise, Niederschlagswasser zusammen mit behandlungsbedürftigem Schmutzwasser in sogenannten Mischwassersystemen abzuleiten, statt.“"
                            },
                            {
                                "example_id": "f2ddaf47-2484-437f-881a-8530b5abffc5",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Der Widmungszweck von Straße und Grünfläche sowie baugestalterische Erwägungen lassen es vertretbar oder gar zweckmäßig erscheinen, dass Niederschlagswasser in diesen Fällen frei ablaufen darf.“"
                            },
                            {
                                "example_id": "67ade21d-d806-4147-9e60-f4f3a6f81dde",
                                "sense_id": "9b33b1e2-726e-30c4-9113-5fa3ebc91f26",
                                "text": "„Auf den befestigten oder verdichteten Flächen ihres Grundstückes (Dach, Stellplatz, Wege usw.) kann das Niederschlagswasser nicht mehr versickern und muss mittels der Entwässerungsanlagen (Kanäle, Rückhaltebecken) abgeleitet werden, um es schadlos (keine Gebäudevernässung und Überflutung) zu entsorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
