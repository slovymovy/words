    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                "word": "measured",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f3583ef9-9b66-4f72-bdaf-581bd4d2ab57",
                        "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more measured"
                    },
                    {
                        "form_id": "e4b068e4-45ac-41f9-b733-41080031773d",
                        "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most measured"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb03cb07-931d-3f59-9715-dddc01c283ab",
                        "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "glosses": [
                            "That has been determined by measurement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c351af4-a3d4-4c38-9359-d2ee91b9e0fb",
                                "sense_id": "eb03cb07-931d-3f59-9715-dddc01c283ab",
                                "text": "He ran over a measured mile."
                            },
                            {
                                "example_id": "4e957c65-27ae-4b23-8b07-f7c1361d9d5a",
                                "sense_id": "eb03cb07-931d-3f59-9715-dddc01c283ab",
                                "text": "Athelstan Arundel walked home all the way, foaming and raging. No omnibus, cab, or conveyance ever built could contain a young man in such a rage. His mother lived at Pembridge Square, which is four good measured miles from Lincoln's Inn."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e751c19-ad7f-3fc4-8d01-b3354fcc6566",
                        "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "glosses": [
                            "Deliberate but restrained."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99aa65ee-b59e-40a4-ac24-d54acb339f9a",
                                "sense_id": "1e751c19-ad7f-3fc4-8d01-b3354fcc6566",
                                "text": "He argued in measured tones."
                            },
                            {
                                "example_id": "fcce919e-a10b-455f-a655-8c3fb571dcae",
                                "sense_id": "1e751c19-ad7f-3fc4-8d01-b3354fcc6566",
                                "text": "But, for the unquiet heart and brain,\n⁠A use in measured language lies;\n⁠The sad mechanic exercise,\nLike dull narcotics, numbing pain."
                            },
                            {
                                "example_id": "58cab59e-e7ca-4d5f-bc6e-1c987b68983a",
                                "sense_id": "1e751c19-ad7f-3fc4-8d01-b3354fcc6566",
                                "text": "This procedure was very tedious for me. Although she was definitely in a somnambulistic state, her answers were coming very slowly with carefully measured caution."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c1df462-e33a-31ff-9c65-af2fe6fe3154",
                        "entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "glosses": [
                            "Rhythmically written in meter; metrical."
                        ],
                        "tags": [
                            "of poetry etc."
                        ],
                        "examples": [
                            {
                                "example_id": "8c410cde-c63f-4863-97a7-dba72ed48423",
                                "sense_id": "5c1df462-e33a-31ff-9c65-af2fe6fe3154",
                                "text": "As we stood waiting for the departure time with the setting sun twinkling on the great brass dome of our 2-4-0, the sound of church bells was the only one apart from the measured tread of the guard slowly pacing towards his van, and, standing at an open window, I more than once heard the fireman's \"Right away!\" to his mate in acknowledgement of a desultory wave of the unfurled green flag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2837e21-5d00-4a4d-959c-d95e26244aaf",
                        "source_entry_id": "53424665-ddc4-35ae-ad44-2a9dd42a5926",
                        "source_sense_description": "deliberate but restrained",
                        "target_lang_word": "afgemeten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
