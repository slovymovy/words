                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83ad2eb7-b621-4de6-a982-1a8271eb160a",
                        "source_entry_id": "8a0ce49d-1a36-3a37-9d22-4424c5bae2cb",
                        "source_sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                        "source_sense_description": "Herrschaftssymbol in Form einer Kugel mit aufgesetztem Kreuz",
                        "target_lang_word": "orbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e159219d-6c44-3bc3-9bde-37d145892101",
                                        "entry_id": "155d71a9-d99e-3c9d-a7d7-dadd575e22f3",
                                        "glosses": [
                                            "Cercle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b7c205c-8e30-44c2-9ff8-c930217467b1",
                                                "sense_id": "e159219d-6c44-3bc3-9bde-37d145892101",
                                                "text": "Le vieux militaire comprit ; il compta jusqu’à sept sur ses doigts, se mit à renifler fortement et à tourner son bras avec une grande vitesse. Ensuite, il compta jusqu’à neuf, lança quelques fut ! fut ! moins accentués, traça quelques orbes plus rares, s’arrêtant à diverses reprises et prenant une expression nonchalante."
                                            },
                                            {
                                                "example_id": "273612a7-3ed0-4b0f-a651-83493ba20717",
                                                "sense_id": "e159219d-6c44-3bc3-9bde-37d145892101",
                                                "text": "Quelques maigres sapins croissaient au milieu des quartiers de rocs, sur le flanc déchiré du précipice ; ils s’engagèrent dans l’orbe d’une de nos roues et arrêtèrent ainsi les bonds de la calèche, qui resta suspendue au- dessus de l’abîme."
                                            },
                                            {
                                                "example_id": "f6e78d23-9a0f-4c69-8822-b0f185cdc372",
                                                "sense_id": "e159219d-6c44-3bc3-9bde-37d145892101",
                                                "text": "Il abaissa ses mains pour mieux se regarder dans la glace où il se pencha comme dans l’orbe d’un puits."
                                            },
                                            {
                                                "example_id": "b5b08b82-c563-470f-bf71-82affbe71db2",
                                                "sense_id": "e159219d-6c44-3bc3-9bde-37d145892101",
                                                "text": "Énorme oiseau de proie, mon avion, désormais hélas ! en pleine lumière, décrit lentement des orbes sournois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                        "entry_id": "155d71a9-d99e-3c9d-a7d7-dadd575e22f3",
                                        "glosses": [
                                            "Orbite ; espace circonscrit par l'orbite d'un corps céleste."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "le mot désigne à la fois la surface et la circonférence de l'orbite elle-même",
                                        "examples": [
                                            {
                                                "example_id": "02aaaefd-04e9-48f0-bc84-b7fba52c8491",
                                                "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                                "text": "Le grand orbe de la terre, le chemin que la terre fait tous les ans autour du soleil."
                                            },
                                            {
                                                "example_id": "c56d97a0-04ee-4aa0-98ab-65be69645800",
                                                "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                                "text": "La terre est un globe dont le rayon n'est pas de sept millions de mètres : le soleil est, comme on l’a vu, incomparablement plus gros : si son centre coïncidoit avec celui de la terre, son volume embrasseroit l’orbe de la lune, et s’étendroit une fois plus loin, d’où l’on peut juger de son immense grandeur ; il est d’ailleurs, éloigné de nous, d’environ vingt-trois mille rayons terrestres."
                                            },
                                            {
                                                "example_id": "ef3977de-004f-4899-91f7-88a7193da961",
                                                "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                                "text": "Le soleil semblait suspendu au sommet de son orbe jusqu’à la fin des mondes."
                                            },
                                            {
                                                "example_id": "05ff6822-0069-4181-984c-59d08ed1ac62",
                                                "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                                "text": "1943, C’est à lui que nous sommes redevables du noyau de l’histoire. Tout gravite autour de lui en orbes tumultueuses et redoutables."
                                            },
                                            {
                                                "example_id": "d6354636-81c6-499c-a815-40864516d9a1",
                                                "sense_id": "8b426c70-49fb-369f-a556-db024299f176",
                                                "text": "En Angleterre, Thomas Digges (1546–1595), que défend les idées de Copernic, propose une idée radicalement nouvelle : il y aurait une infinité d’étoiles dispersées dans un espace infini qui s’étend au-delà des orbes planétaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                        "entry_id": "155d71a9-d99e-3c9d-a7d7-dadd575e22f3",
                                        "glosses": [
                                            "Globe, corps céleste, voûte du ciel et, par extension, tout corps circulaire ou tout mouvement circulaire."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c10b57-3b8c-4865-866e-76d4f7aee887",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "J’ai lu que, pour franchir des routes difficiles,\n Un Automédon pétulant\nEnlevait les écrous des quatre orbes agiles\nQui roulaient sous son char brillant. ."
                                            },
                                            {
                                                "example_id": "53089a4c-5971-40a0-a692-10677715c99c",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "Les souvenirs de l’amour dans le cœur d’un vieillard sont les feux du jour réfléchis par l’orbe paisible de la lune, lorsque le soleil est couché et que le silence plane sur les huttes des Sauvages."
                                            },
                                            {
                                                "example_id": "1ba24393-4ad0-4433-bb9c-c062ab7a0c59",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "Rêve ! On croit voir planer un morceau d’une cime ;\nLe haut d’une montagne a, sous l’orbe étoilé,\nPris des ailes et s’est tout à coup envolé"
                                            },
                                            {
                                                "example_id": "cef3130c-eef4-4eb4-abde-dc7174404cdf",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "En effet, le disque lunaire glissait sur celui du soleil sans l'avoir masqué tout entier! Les deux tiers seulement de l'orbe solaire avaient été recouverts!"
                                            },
                                            {
                                                "example_id": "2c0cb6dc-bfda-4c05-9f86-d99da5691e62",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "Je la regardai comme elle était, liée à moi, sur le canapé bleu, épiant le moment où ses yeux, disparus sous ses larges paupières, me remontreraient leurs beaux orbes de velours noir et de feu."
                                            },
                                            {
                                                "example_id": "5c7afd85-1416-48b5-a89a-c3b0ef0ac06a",
                                                "sense_id": "fe8d27a5-a3cb-3e63-806b-efee9eb590fd",
                                                "text": "Voici donc l'homme qui a tenté le premier pas pour quitter l'orbe terrestre, qui a osé affronter l'espace interplanétaire, murmura-t-il avec une admiration mêlée d'effroi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5ef942-2b98-30e4-a0c6-6b32141e6d13",
                                        "entry_id": "155d71a9-d99e-3c9d-a7d7-dadd575e22f3",
                                        "glosses": [
                                            "Globe de commandement, qui est une des marques de la royauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c871d8-70ab-43f8-89d1-906a1a34281a",
                                                "sense_id": "9f5ef942-2b98-30e4-a0c6-6b32141e6d13",
                                                "text": "Bien que la lance ait été infiniment plus modeste que la couronne, le sceptre, l’orbe et les glaives royaux, cet objet avait, paraît-il, excité son imagination : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b96e86-6087-37ef-8949-abc73e42a409",
                                        "entry_id": "155d71a9-d99e-3c9d-a7d7-dadd575e22f3",
                                        "glosses": [
                                            "Zone d’influence ; sphère d’influence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5285a7-1058-44c6-a73e-9c740be5c64e",
                                                "sense_id": "25b96e86-6087-37ef-8949-abc73e42a409",
                                                "text": "Copeau a toujours trouvé parfaitement naturel que, toutes affaires cessantes, ses amis entrent dans son orbe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
