                "senses": [
                    {
                        "sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                        "entry_id": "2fe69d3e-1ca5-355f-a6d2-7965e67ca4e0",
                        "glosses": [
                            "jemand, der Randale macht (randaliert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95139f36-e7d0-42db-bca5-63efcf304b2a",
                                "sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                                "text": "Mehrere Randalierer wurden festgenommen."
                            },
                            {
                                "example_id": "f1d761f0-df51-469c-a1cf-fc3a8ea6b04d",
                                "sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                                "text": "„Hooligan stammt aus dem Englischen und bedeutet übersetzt Randalierer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c816f7d7-c5bc-474f-bc03-fbfd9eedffa2",
                        "source_entry_id": "2fe69d3e-1ca5-355f-a6d2-7965e67ca4e0",
                        "source_sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                        "source_sense_description": "jemand, der Randale macht (randaliert)",
                        "target_lang_word": "rioter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rioter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                        "entry_id": "48fc6f37-c03f-340e-8857-0c799e7aeaca",
                                        "glosses": [
                                            "One who riots; part of the unruly violent crowd causing a riot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e493421-048a-45ff-a042-ec93233d5c53",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "The rioters had erected a makeshift barricade and were pelting the police with rocks from behind it."
                                            },
                                            {
                                                "example_id": "e5f5b4b7-f561-4d50-9698-3cf2f19b4b02",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "The rioters overshadowed the message of peaceful protesters on prior days: They had called for justice for Gray, a 25-year-old African-American man who died from spinal injuries after police arrested him this month."
                                            },
                                            {
                                                "example_id": "c73e6cab-b5ad-4607-a916-e8f53719a9d7",
                                                "sense_id": "b917d19b-c37b-3bc4-aa99-9185b1ee00ff",
                                                "text": "High-profile January 6 rioter Guy Reffitt showed up in Washington, DC, on Wednesday to celebrate with his wife and supporters who’d been hoping for his release from federal detention for months."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9774e29d-562b-4a2c-afdf-52cb7209817c",
                        "source_entry_id": "2fe69d3e-1ca5-355f-a6d2-7965e67ca4e0",
                        "source_sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                        "source_sense_description": "jemand, der Randale macht (randaliert)",
                        "target_lang_word": "émeutier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émeutier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3f265a-3aa7-3daf-99a6-78fe1c4749ba",
                                        "entry_id": "1f9e5afa-97cc-3adf-b9f9-b53b751e3ef1",
                                        "glosses": [
                                            "Celui qui incite à l’émeute ou qui y prend part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eddc668c-8bd4-438f-89cd-f1fbbf222b14",
                                                "sense_id": "7e3f265a-3aa7-3daf-99a6-78fe1c4749ba",
                                                "text": "Enfin, c’était une terrible, une vivante image de ce compromis antisociaux que font les trop faibles représentants du pouvoir avec de sauvages émeutiers."
                                            },
                                            {
                                                "example_id": "ca3faa6e-7ada-4e05-b465-2b7a444744ce",
                                                "sense_id": "7e3f265a-3aa7-3daf-99a6-78fe1c4749ba",
                                                "text": "L’émeutier en somme est un insurgé en devenir."
                                            },
                                            {
                                                "example_id": "3e95b03d-5ccb-4963-a4ad-d761c6144b27",
                                                "sense_id": "7e3f265a-3aa7-3daf-99a6-78fe1c4749ba",
                                                "text": "En examinant la construction de ces sources du point de vue du genre, il est possible de mettre en évidence les processus d’occultation de la violence des émeutières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "émeutier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b08928b7-e0e9-399a-a62d-46f1d60f8085",
                                        "entry_id": "e3b35b16-202c-3e31-a970-e46d299c974d",
                                        "glosses": [
                                            "Qui a rapport avec l’émeute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109208cd-770e-418e-8331-1954214e6a1f",
                                                "sense_id": "b08928b7-e0e9-399a-a62d-46f1d60f8085",
                                                "text": "Inspiré entre autres par Benjamin, Agamben, voire des Tiqqun, l’ouvrage coédité par Sabotart (Montréal) et Entremonde (Genève) met en lumière le processus de « substruction » (subversion et construction) qui s’est opéré durant la grève et qui est réclamé tout au long de ses pages : « Sa résolution émeutière [culminant durant les émeutes du Plan Nord et de Victoriaville], sa charge créative [une analyse timide, mais clairvoyante, des réseaux sociaux] et son imprévisibilité plébéienne [le début des casseroles, et leur mise à mort du mouvement de grève]. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "191346b9-0d5b-4d54-8004-4aaf36036976",
                        "source_entry_id": "2fe69d3e-1ca5-355f-a6d2-7965e67ca4e0",
                        "source_sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                        "source_sense_description": "jemand, der Randale macht (randaliert)",
                        "target_lang_word": "буян",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буян",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "852ec76b-cb3a-3bd5-bbcb-c2ac089c239e",
                                        "entry_id": "5b8dcd76-44ee-3b15-a0c4-636dfd5e5779",
                                        "glosses": [
                                            "тот, кто ведёт себя буйно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e4e0a5-d7ce-4491-a5fb-1aabde0d32a5",
                                                "sense_id": "852ec76b-cb3a-3bd5-bbcb-c2ac089c239e",
                                                "text": "Танцор и буян, но хороший кавалерист."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "буян",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb08ad37-31b1-39d3-9e74-b1c9ca10bb7b",
                                        "entry_id": "6691cd4b-b908-38db-9831-68318c278327",
                                        "glosses": [
                                            "устар. речная пристань, где выгружались товары с судов"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a06353bf-fb5e-362b-9c7a-196df38426f8",
                                        "entry_id": "6691cd4b-b908-38db-9831-68318c278327",
                                        "glosses": [
                                            "устар. место, где располагались торговые амбары"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb854b79-bccd-4784-b91b-3324ca12d1ed",
                                                "sense_id": "a06353bf-fb5e-362b-9c7a-196df38426f8",
                                                "text": "Вход на территорию порта и на буяны был довольно свободный, а потому в местах разгрузки судов собирались и посторонние, бродяжки, мальчишки, которые норовили что-нибудь стащить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db43f358-b2a9-4732-a0ac-0f93965410c7",
                        "source_entry_id": "2fe69d3e-1ca5-355f-a6d2-7965e67ca4e0",
                        "source_sense_id": "2729bd31-61ff-3c2f-bb9c-2073512e8b22",
                        "source_sense_description": "jemand, der Randale macht (randaliert)",
                        "target_lang_word": "хулиган",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хулиган",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                        "entry_id": "a10fad7d-3c34-3457-bb77-a72a59272e87",
                                        "glosses": [
                                            "человек, грубо нарушающий общественный порядок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8f50eb-83ae-41ee-8235-fc6eb604d18e",
                                                "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                                "text": "— Кажется, у вас хулиган вырвал сумочку, — тихо сказала Лиза, — развелось их теперь, никого не боятся."
                                            },
                                            {
                                                "example_id": "b3e2e021-1f9c-45fe-bb74-587e17fbccb8",
                                                "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                                "text": "Одного слабого человека, одетого в старосолдатскую шинель, торговка булками загнала в мочевую лужу около отхожего места и стегала его по лицу тряпкой; на помощь торговке сразу появился кочующий хулиган и сразу разбил в кровь лицо ослабевшего человека, свалившегося под отхожий забор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae79bc4a-b9db-3bc6-9d75-af0ab23ad47a",
                                        "entry_id": "a10fad7d-3c34-3457-bb77-a72a59272e87",
                                        "glosses": [
                                            "разг. перен. ребёнок, не нарушающий общественный порядок, но доставляющий своим родителям неудобства своим поведением"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "хулиган",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                        "entry_id": "99ea08a7-303f-3781-a5bf-bcefa6c76c86",
                                        "glosses": [
                                            "спец. пожарный и спасательный ручной лом для вскрытия дверей и разборки конструкций, с одной стороны заканчивающийся вилкой-гвоздодёром, а с другой — головкой с теслом и шипом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e9d234e-7b4f-4c29-9a91-1c6281a4ccdd",
                                                "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                                "text": "В руках Михаила Тихонова (слева) пожарный «хулиган» — это, по сути, лом, которым можно вскрывать замки, если на пожаре заблокировало двери."
                                            },
                                            {
                                                "example_id": "289bcd35-19cc-40e3-a6f3-7af5a64a9ba6",
                                                "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                                "text": "Бак тестомешалки удалось отжать не сразу. Как пояснили в сахалинском региональном отделении «Россоюзспаса», он поддался ручному аварийно-спасательному инструменту, так называемому хулигану."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
