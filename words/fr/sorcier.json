                    ]
                },
                {
                    "sense_id": "c58b2824-fd04-3dff-b84e-8df6011b4b19",
                    "sense_definition": "Personne malveillante, méchante ou désagréable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieil homme aigri se conduit comme un véritable <w>sorcier</w> avec tous ses voisins."
                        },
                        {
                            "text": "Méfie-toi de cet individu, c'est un vrai <w>sorcier</w> qui cherche toujours à nuire aux autres."
