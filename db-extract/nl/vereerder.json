        "nl-extract.jsonl": [
            {
                "entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                "word": "vereerder",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "612bec28-9bfb-43c6-884f-27d462db6317",
                        "entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "vereerders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                        "entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                        "glosses": [
                            "iemand die iets of iemand heel erg hoogacht en bewondert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52290bc-4d79-4682-aafa-8cea44d473f3",
                                "sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                                "text": "Buiten werd de 10 jaar oude bank door een nieuwe vervangen. Het hout van de tafel en de zitbanken waren helemaal verrot. Met toestemming van de provincie Overijssel is een nieuwe bank geplaatst. Het daarvoor benodigde tropische hardhout was een geschenk van een Maria-vereerder uit Westerhaar; Jan Wilbers uit Agelo timmerde er een fraaie tafel en twee stevige zitbanken van."
                            },
                            {
                                "example_id": "d10aa809-7d0d-47b7-b5ba-5cf96afa176f",
                                "sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                                "text": "Volgens Fransman zal het programma Holleeder niet per se in een gunstig daglicht plaatsen: „Je kunt zeggen: de NTR zet hem op een podium. Je kunt ook zeggen dat het een schavot is. Bij een live of semi-live programma neem je altijd een risico.” Het legt wel een zware hypotheek op Huys, stelt Fransman: „Mag blijken dat Huys zich in de uitzending als vereerder opstelt, die liquidaties als collateral damage ziet, dan zal hij zijn langste tijd bij de NTR wel hebben gehad.”"
                            },
                            {
                                "example_id": "a6c7c6fd-756c-42d7-88ca-2ab3d39b2df3",
                                "sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                                "text": "Er was een man aan het hof die geen profeet was, maar wel een onvoorwaardelijke vereerder van de god van Israël."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dafba0e-523b-4ead-bb8e-7e541529d9de",
                        "source_entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                        "source_sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                        "target_lang_word": "worshipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worshipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                        "entry_id": "c48dbc76-8e74-35c6-9f53-369eaaabd767",
                                        "glosses": [
                                            "A person who worships, especially at a place of assembly for religious services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec27be60-a66e-4dd1-8775-85bcc558f6d8",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "The temple was filled with worshippers."
                                            },
                                            {
                                                "example_id": "1271803b-7ea8-489d-8e34-a929d12b3f2c",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "Sadly, the ever-eager Reverend Judith had not been able to conjure up many worshippers, even though it was Father’s Day. There was just one old dear sitting halfway back, her faulty hearing aid letting off a high-pitched whistle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "564d4e04-ba5d-4d32-8bd0-ef9663b08b65",
                        "source_entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                        "source_sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                        "target_lang_word": "adorer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adorer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                        "entry_id": "5751aa61-8f07-3129-8b39-9fa6f528b2d1",
                                        "glosses": [
                                            "Someone who adores.",
                                            "Someone who worships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef78134-be2e-4fdf-bba7-b03bb829b77c",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "1582, Gregory Martin (translator), The New Testament of Jesus Christ, Translated Faithfully into English, Reims: John Fogny, John 4.23, p. 226,\nBut the houre commeth, and now it is, when the true adorers shal adore the Father in spirit and veritie."
                                            },
                                            {
                                                "example_id": "432e7344-67e5-46da-aead-a6cc45cdf17a",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "[…] I in one Night freed / From servitude inglorious welnigh half / Th’ Angelic Name, and thinner left the throng / Of his adorers […]"
                                            },
                                            {
                                                "example_id": "f3fbab3a-32c6-4e0b-a1ed-3918c002d553",
                                                "sense_id": "317c0b3a-88ca-3ce9-a0b2-d51116e09b9f",
                                                "text": "All men in the outset of the religion they profess are adorers of a God, and friends of man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                        "entry_id": "5751aa61-8f07-3129-8b39-9fa6f528b2d1",
                                        "glosses": [
                                            "Someone who adores.",
                                            "Someone who has a deep admiration, fondness or love (of someone or something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c0319d-7b31-4adc-894a-e7d8e81a6ccf",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "[…] I profess myself her adorer, not her friend."
                                            },
                                            {
                                                "example_id": "05bae697-295e-446d-92bd-f27d69e2a30a",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "I vvho profeſs my ſelf an Admirer, an Adorer of Reaſon, am obliged to ovvn, that in ſome Caſes the Sharpneſs of Ridicule can do more than the Strength of Argument."
                                            },
                                            {
                                                "example_id": "75ee864a-46fe-4722-94f2-716bcf957242",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "When rival adorers come courting a maid, / There’s something or other may often be said, / Why he should be pitched upon rather than him. / This wasn’t the case with Old Paul and Old Tim."
                                            },
                                            {
                                                "example_id": "a135d703-e54f-47a4-8d40-56d44325e832",
                                                "sense_id": "269549fc-e6da-345f-ba9e-6ae6ecb7a348",
                                                "text": "The funny thing was that all the envelopes were addressed in the same hand, in green or sometimes purple capitals. It was like one crazed adorer laying siege to Leo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5aa6b2fd-41c5-4607-86b9-515fccbc4780",
                        "source_entry_id": "9f7a49af-a80d-30e5-8cbb-49c3d2f518a2",
                        "source_sense_id": "c262e86e-e30c-3b52-9198-2b8b386eeda5",
                        "target_lang_word": "admirer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admirer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "741e140d-6781-32c2-89c1-46f801b599f5",
                                        "entry_id": "df0cbe09-47b8-3ef1-a43a-e340eceeb1c3",
                                        "glosses": [
                                            "One who admires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e3504aa-5686-4b56-93c7-b9b60c70df70",
                                                "sense_id": "741e140d-6781-32c2-89c1-46f801b599f5",
                                                "text": "Deven is an enthusiastic admirer of The Beatles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea03d86-cdd4-3f84-a27b-7da48bd8e45e",
                                        "entry_id": "df0cbe09-47b8-3ef1-a43a-e340eceeb1c3",
                                        "glosses": [
                                            "One who is romantically attracted to someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a982faea-81cb-42ff-aebc-780cdb071fa1",
                                                "sense_id": "1ea03d86-cdd4-3f84-a27b-7da48bd8e45e",
                                                "text": "Although he has a number of admirers, he prefers to remain single."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
