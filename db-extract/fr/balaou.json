                "senses": [
                    {
                        "sense_id": "126a9687-0c7e-3777-976f-b990343b38e2",
                        "entry_id": "e3f2c7c5-c96d-344c-902c-3336e4e0fd36",
                        "glosses": [
                            "Poisson osseux de la famille des Scomberésocidés, ressemblant à une orphie, au corps très allongé, à l’avant de la tête fin et pointu en bec, qui a une rangée de pinnules derrière les nageoires dorsale et anale, vivant dans les mers tropicales et tempérées, et dont il existe plusieurs espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212143ed-d7ea-47eb-bd4c-32319201f974",
                                "sense_id": "126a9687-0c7e-3777-976f-b990343b38e2",
                                "text": "Le corps allongé et fusiforme du balaou se prolonge en un long bec typique des Béloniformes."
                            },
                            {
                                "example_id": "14f77d91-733e-4804-9864-8e2769d67358",
                                "sense_id": "126a9687-0c7e-3777-976f-b990343b38e2",
                                "text": "Il savait, maintenant, écailler un poisson, le mettre à tremper dans un coui-calebasse et préparer un bon blaff. Il connaissait la saison des daurades, des balaous et des thons."
                            }
                        ]
                    }
                ],
