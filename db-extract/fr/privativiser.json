                "senses": [
                    {
                        "sense_id": "1b858348-217b-3c26-893b-b3244859d588",
                        "entry_id": "e24038bf-7bd4-3e7e-b33a-d4ddca5f2904",
                        "glosses": [
                            "Donner un caractère privatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef0838f-9222-4c28-8df0-692b059ddb46",
                                "sense_id": "1b858348-217b-3c26-893b-b3244859d588",
                                "text": "L'objectif est clair : continuer à casser le Service Public, à nier le Bien Commun, à tout privativiser, privatidiviser, pour sur-régner."
                            },
                            {
                                "example_id": "dd6fcc94-55a6-429e-93c0-0e3c51560c23",
                                "sense_id": "1b858348-217b-3c26-893b-b3244859d588",
                                "text": "Néanmoins, ils cherchent à sensibiliser le lecteur au fait que l’orientation généralement plus individualiste de la culture sociale américaine, d’une part, et la plus grande réceptivité des canadiens à l’intervention des pouvoirs publics, d’autre part, ont logiquement tendance à façonner une vie urbaine collectiviste au Canada et plus privativisée aux États-Unis."
                            },
                            {
                                "example_id": "d2b2d2d6-d02a-48e6-b36b-4ad8c9e71972",
                                "sense_id": "1b858348-217b-3c26-893b-b3244859d588",
                                "text": "Bon hôtel avec service agréable. Placé en bord de route. A 6 km de l'océan. Appartement privativisé."
                            }
                        ]
                    }
                ],
