                    "frequency": "VeryLow",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved <w>swimmingly</w> across the stage with a grace that captivated the entire audience.",
                            "target_lang_translations": {
                                "ru": "Танцовщица <w>плавно</w> двигалась по сцене с грацией, пленившей всех зрителей."
                            }
                        },
                        {
                            "text": "The silk fabric flowed <w>swimmingly</w> through the air as she twirled around.",
                            "target_lang_translations": {
                                "ru": "Шёлковая ткань <w>текуче</w> струилась по воздуху, когда она кружилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "smoothly",
                        "like clockwork"
                    ],
                    "traits": [
