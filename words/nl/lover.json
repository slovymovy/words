            "senses": [
                {
                    "sense_id": "7af5e666-3994-3c4d-b7d5-198cce37b7ab",
                    "sense_definition": "Iemand met wie men een liefdesrelatie of intieme relatie heeft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft haar nieuwe <w>lover</w> aan haar ouders voorgesteld.",
                            "target_lang_translations": {
                                "en": "She introduced her new <w>lover</w> to her parents."
                            }
                        },
                        {
                            "text": "De twee geheime <w>lovers</w> ontmoetten elkaar in het park.",
                            "target_lang_translations": {
                                "en": "The two secret <w>lovers</w> met in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "minnaar",
                        "minnares"
                    ],
                    "common_phrases": [
                        "een nieuwe lover"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone with whom one has a romantic or intimate relationship."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lover",
                                "target_lang_sense_clarification": "romantic partner"
                            },
                            {
                                "target_lang_word": "boyfriend",
                                "target_lang_sense_clarification": "male romantic partner"
                            },
                            {
                                "target_lang_word": "girlfriend",
                                "target_lang_sense_clarification": "female romantic partner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03236245-ab3d-3660-b2b9-6694c81800a4",
                    "sense_definition": "Iemand die een grote bewonderaar of liefhebber is van iets of iemand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liefhebber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als echte <w>lover</w> van klassieke muziek bezoekt hij wekelijks concerten.",
                            "target_lang_translations": {
                                "en": "As a true <w>lover</w> of classical music, he attends concerts weekly."
                            }
                        },
                        {
                            "text": "Zij is een bekende <w>lover</w> van moderne kunst.",
                            "target_lang_translations": {
                                "en": "She is a well-known <w>lover</w> of modern art."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een echte lover"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Ontleend aan het Engels"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who is a great admirer or enthusiast of something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lover",
                                "target_lang_sense_clarification": "enthusiast or fan of something"
                            },
                            {
                                "target_lang_word": "enthusiast",
                                "target_lang_sense_clarification": "person filled with enthusiasm for a pursuit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5660cff8-5fa2-3a3e-9cfb-5f9fc2ec36ca",
                    "sense_definition": "Het geheel van de bladeren aan bomen of struiken.",
