                "senses": [
                    {
                        "sense_id": "fb5d1c0f-da0d-3ef6-89f4-f9417019f025",
                        "entry_id": "999e5037-b5fd-3196-a2a2-798f8ef30e79",
                        "glosses": [
                            "einem anderen Autofahrer einen Vogel zeigen, also mit dem Finger an die Stirn tippen, um deutlich zu machen, dass man dessen Fahrweise als unangemessen/verrückt einschätzt"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "be5bfecd-41ac-4cfe-ad9b-7df3c0ff2f43",
                                "sense_id": "fb5d1c0f-da0d-3ef6-89f4-f9417019f025",
                                "text": "„Der Zeigefinger leistet gute Dienste im Straßenverkehr, wo man ihn an die Stirn tippen kann. Diese Geste heißt hierzulande Autofahrergruß.“"
                            },
                            {
                                "example_id": "2caaaf4d-ad14-4a43-8c68-2005a809afd7",
                                "sense_id": "fb5d1c0f-da0d-3ef6-89f4-f9417019f025",
                                "text": "„Der ausgestreckte Mittelfinger als obszöner Autofahrergruß wird von Gerichten mit einer Strafe von bis zu 2.200 Mark geahndet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
