                    "sense_definition": "Taki, który działa, jest sprawny technicznie i znajduje się w użyciu (o urządzeniach, instalacjach, szlakach).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "functional_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stara studnia na podwórku jest nadal <w>czynna</w> i ma czystą wodę.",
                            "target_lang_translations": {
                                "ru": "Старый колодец во дворе всё ещё <w>действующий</w> и в нём чистая вода.",
                                "en": "The old well in the yard is still <w>working</w> and has clean water."
                            }
                        },
                        {
                            "text": "To jedyny <w>czynny</w> telefon w całym budynku, reszta jest zepsuta.",
                            "target_lang_translations": {
