                    },
                    {
                        "translation_id": "c8595bf5-e47a-4d74-a838-1ad297bba392",
                        "source_entry_id": "2078e150-c600-304d-9206-bd1f84c54313",
                        "source_sense_description": "to convert (a situation, thing, etc.) into something better",
                        "target_lang_word": "ausbauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausbauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63c329a0-86f7-34ab-9d06-ffc5c25cf021",
                                        "entry_id": "e2cd4d73-415e-368e-81ad-7c6045d3394d",
                                        "glosses": [
                                            "ein Teil aus einer Maschine, einer technischen Anlage herausnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6338c947-0e32-4835-a680-2255d2641d06",
                                                "sense_id": "63c329a0-86f7-34ab-9d06-ffc5c25cf021",
                                                "text": "Mein Computer bereitet Probleme, ich werde morgen den Arbeitsspeicher ausbauen und durch anderen ersetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5920f962-7607-3eaa-a14a-4aa7b0c534db",
                                        "entry_id": "e2cd4d73-415e-368e-81ad-7c6045d3394d",
                                        "glosses": [
                                            "etwas planmäßig vergrößern, erweitern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a91a6b8-3edf-40fb-92c7-d285bac5d3a0",
                                                "sense_id": "5920f962-7607-3eaa-a14a-4aa7b0c534db",
                                                "text": "Jede Weinsorte braucht ein spezielles Glas. Quatsch. [..] Ich müsste ja mein Haus ausbauen, um all die Gläser aufzustellen."
                                            },
                                            {
                                                "example_id": "40d87a91-9387-47bd-9260-0afb71904560",
                                                "sense_id": "5920f962-7607-3eaa-a14a-4aa7b0c534db",
                                                "text": "Der US-Flugzeugbauer Boeing will im laufenden Jahr die Produktion von zivilen Verkehrsflugzeugen weiter ausbauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "26f3e6bd-f527-33e3-928f-2500ff92c092",
                                        "entry_id": "e2cd4d73-415e-368e-81ad-7c6045d3394d",
                                        "glosses": [
                                            "etwas vergrößern oder verbessern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e2603c-d45b-4b19-b0cd-fbae13efe58d",
                                                "sense_id": "26f3e6bd-f527-33e3-928f-2500ff92c092",
                                                "text": "Wir sollten versuchen, die Beziehung zu unseren Nachbarn auszubauen."
                                            },
                                            {
                                                "example_id": "34f5538f-0bbc-4215-90d5-498dab655b1b",
                                                "sense_id": "26f3e6bd-f527-33e3-928f-2500ff92c092",
                                                "text": "Er [Noam Chomski] attestiert den USA eine Politik der systematischen Entmündigung und Enteignung, die es versteht, den Eliten ihre Privilegien auszubauen."
                                            },
                                            {
                                                "example_id": "e5719426-95d3-4ddb-aa84-e449b1b579e7",
                                                "sense_id": "26f3e6bd-f527-33e3-928f-2500ff92c092",
                                                "text": "„Dass das Wochenende nicht genutzt wurde, um den Vorsprung auf den Tabellenzweiten auszubauen, wurde im Verein mit Groll registriert.“"
                                            },
                                            {
                                                "example_id": "de427125-a5a3-4bdc-a2bb-13b8a3c6de81",
                                                "sense_id": "26f3e6bd-f527-33e3-928f-2500ff92c092",
                                                "text": "„Selbst als die Germanen etwa ab dem 3. Jahrhundert die Römerstädte bedrängten, geschah das nicht mit der Absicht, römische Verwaltungseinrichtungen oder Machtbasen zu übernehmen, sondern lediglich mit der Zielsetzung, germanische Handelszentren auszubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
