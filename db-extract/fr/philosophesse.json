                                "target_senses": [
                                    {
                                        "sense_id": "dcaf9c7d-bb82-398f-b6e3-3552e9463a94",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A lover of wisdom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "310b7afb-a173-35b0-9713-213ffc49e810",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A student of philosophy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b91244a1-f7ee-35d3-a3ed-bbb93ccc6c49",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A scholar or expert engaged in or contributing to philosophical inquiry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a49476-8143-475f-9bc3-9d67b02fa985",
                                                "sense_id": "b91244a1-f7ee-35d3-a3ed-bbb93ccc6c49",
                                                "text": "Their playwrights knew better. Scandal, murder, hair-rending and railing against the gods sold tickets. King is not a philosopher. He knows how to sell tickets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A person who applies the principles of philosophy to the conduct of their life, as by acting calmly and rationally in the face of inevitable change."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5266ec96-b98b-4282-b665-6214a24534d4",
                                                "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                                "text": "Then certaine Philosophers of the Epicureans, and of the Stoikes, encountred him"
                                            },
                                            {
                                                "example_id": "9a5cfb3a-e7e7-4ec8-ab99-00d24b2160d7",
                                                "sense_id": "c51b3215-74b8-39d5-95ed-084b419cc65d",
                                                "text": "This is not the sort of happiness which a man would in general wish to owe to his wife; but where other powers of entertainment are wanting, the true philosopher will derive benefit from such as are given."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56247ef-3b10-3f29-80be-59afa3721d48",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "A student, scholar, or expert in any branch of knowledge, especially those branches studied prior to being considered part of pure science."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                        "entry_id": "d1500181-4ccc-3a95-913f-5fd8219ac268",
                                        "glosses": [
                                            "An alchemist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395de0f2-d087-4bcc-811c-75bf294c038d",
                                                "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                                "text": "Then thus conclude I, since that God of heaven\nWill not that these philosophers neven\nHow that a man shall come unto this stone,\nI rede as for the best to let it gon."
                                            },
                                            {
                                                "example_id": "6a429d0a-aaee-4d1f-85d6-605406600ae6",
                                                "sense_id": "93e29504-ebd6-313c-bd01-b13e05abefd3",
                                                "text": "No further progress was made in this science until the Mohammedan alchemists embarked upon their search for the philosopher's stone, the elixir of life, and a method of transmuting base metals into gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
