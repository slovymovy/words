                                "target_senses": [
                                    {
                                        "sense_id": "eb92b4d4-4361-37e8-8c7c-a167a673ffd2",
                                        "entry_id": "efe64258-d7a7-3310-8764-b1b20a0c7621",
                                        "glosses": [
                                            "в сторону, противоположную направлению взгляда или основного движения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7715489-45ce-4994-9835-15ce17b9e2dd",
                                                "sense_id": "eb92b4d4-4361-37e8-8c7c-a167a673ffd2",
                                                "text": "Оглянуться назад."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c85246d-1f73-391b-8e07-23871fc3f7c8",
                                        "entry_id": "efe64258-d7a7-3310-8764-b1b20a0c7621",
                                        "glosses": [
                                            "на прежнее место, туда, где было прежде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a561ac8a-66b5-4206-8669-0b7325a4c768",
                                                "sense_id": "4c85246d-1f73-391b-8e07-23871fc3f7c8",
                                                "text": "Положить взятую вещь назад."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "назад",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40194835-e431-3fd6-9852-1d559c097dc8",
                                        "entry_id": "b2ddce34-9bfd-398e-96b8-eff37d213e18",
                                        "glosses": [
                                            "прежде, ранее, раньше"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7577ea06-2177-426e-8bcd-ac669a55c422",
                                                "sense_id": "40194835-e431-3fd6-9852-1d559c097dc8",
                                                "text": "Десять лет (тому) назад."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e8fe122-3eb6-4df7-a6eb-6f80ff7096f3",
                        "source_entry_id": "476079ae-732c-39c2-9609-be9aab6c8814",
                        "source_sense_id": "c59b064e-b045-39da-9bb5-21ea6f207d22",
                        "target_lang_word": "раньше",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раньше",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1186f16b-385c-3f38-bf67-8f8791616ed6",
                                        "entry_id": "9f34d391-4fd3-37e0-afb4-0394f49f76c6",
                                        "glosses": [
                                            "сравн. ст. к нареч. рано"
                                        ],
                                        "tags": [
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "991c6f01-18d5-486c-bc80-af7afc9de796",
                                                "sense_id": "1186f16b-385c-3f38-bf67-8f8791616ed6",
                                                "text": "Бывало, приду в церковь раньше всех, встану на колени перед образом Троицы и лью слёзы, легко и покорно, без дум и без молитвы: нечего было просить мне у бога, бескорыстно поклонялся я ему."
                                            },
                                            {
                                                "example_id": "bea62781-29d0-4ab2-bf3d-395cd106e6ae",
                                                "sense_id": "1186f16b-385c-3f38-bf67-8f8791616ed6",
                                                "text": "Она всегда и всё знает раньше других."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3476189-eb7c-3a1a-b52b-ab09ff0fce1c",
                                        "entry_id": "9f34d391-4fd3-37e0-afb4-0394f49f76c6",
                                        "glosses": [
                                            "в прежнее время, прежде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dae11cf-6206-47f6-a5ed-6b620a23bab5",
                                                "sense_id": "a3476189-eb7c-3a1a-b52b-ab09ff0fce1c",
                                                "text": "― Не умел раньше, а как пришлось, так и выучился, ― с улыбкой ответил Санин, догадавшись о том, что чувствовала Лида."
                                            },
                                            {
                                                "example_id": "69b6e67f-4bc2-4eb2-8b07-47b582bd5c6e",
                                                "sense_id": "a3476189-eb7c-3a1a-b52b-ab09ff0fce1c",
                                                "text": "― Вы говорите, ― удивленно произнес Тинг, ― что вы тоже узнали меня. Но я, кажется, вас не видал раньше."
                                            },
                                            {
                                                "example_id": "7dbafc45-6e20-4c48-8b85-76ad05139432",
                                                "sense_id": "a3476189-eb7c-3a1a-b52b-ab09ff0fce1c",
                                                "text": "Раньше здесь было много пиратов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d59a5cf-0047-3a99-a151-ad96d1a5b0a4",
                                        "entry_id": "9f34d391-4fd3-37e0-afb4-0394f49f76c6",
                                        "glosses": [
                                            "перен. разг. сначала, в первую очередь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a38039-4473-434b-bc33-e936e3d5aa9f",
                                                "sense_id": "1d59a5cf-0047-3a99-a151-ad96d1a5b0a4",
                                                "text": "Своя только бедность и такая безысходная, лет на сто вперед, что руки опускаются, не знаешь, за что раньше хвататься, всё ветшает, обваливается, линяет, все труды уходят в песок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db9d679-3af0-3793-9786-fbf7240caf05",
                                        "entry_id": "9f34d391-4fd3-37e0-afb4-0394f49f76c6",
                                        "glosses": [
                                            "разг. за некоторое время до чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f512732-f0a8-4137-9ba0-dee3ebab2ea1",
                                                "sense_id": "8db9d679-3af0-3793-9786-fbf7240caf05",
                                                "text": "― А скажите, какой у нас сегодня месяц? ― Декабрь, ― не сразу ответил я, несколько изумленный этим вопросом. ― А раньше какой был? ― Ноябрь… ― А раньше?"
                                            },
                                            {
                                                "example_id": "28f5243c-052a-4e67-9112-be38dd9ae043",
                                                "sense_id": "8db9d679-3af0-3793-9786-fbf7240caf05",
                                                "text": "― Что же вы этого раньше не сказали, коллега?"
                                            },
                                            {
                                                "example_id": "bdbf2639-f214-4bac-95e8-a52fae8f10e4",
                                                "sense_id": "8db9d679-3af0-3793-9786-fbf7240caf05",
                                                "text": "[Ганимед] (кланяясь). Благодарим. Мы в срок? [Тибурций]. О, даже раньше срока."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
