                                "target_senses": [
                                    {
                                        "sense_id": "22b44826-8ade-3a90-a278-e31ffc0f3779",
                                        "entry_id": "200886e7-38f5-3c28-8983-25ffe36ea24e",
                                        "glosses": [
                                            "ein Geschäft in dem Wein verkauft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a1ccc6-38d8-4d7e-abdb-58d9facbaf1e",
                                                "sense_id": "22b44826-8ade-3a90-a278-e31ffc0f3779",
                                                "text": "Diese Weinhandlung bietet erstklassige Rotweine zu einem sehr günstigen Preis-Leistungs-Verhältnis an."
                                            },
                                            {
                                                "example_id": "7b060785-bf0a-4bb2-b8ae-395e2d60bc80",
                                                "sense_id": "22b44826-8ade-3a90-a278-e31ffc0f3779",
                                                "text": "„In einer Weinhandlung, die einem Winzer aus Bacharach gehört, hatten wir nach der »Hitlerhöhe« gefragt, die erst vor ein paar Jahren in »Heinrich-Heine-Blick« umbenannt wurde.“"
                                            },
                                            {
                                                "example_id": "5fc6ad3f-391c-4d4b-a32f-9edb6e4af507",
                                                "sense_id": "22b44826-8ade-3a90-a278-e31ffc0f3779",
                                                "text": "„Neben ihren Hause beginnt der Garten der Weinhandlung Holzmann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02165ee8-a9e4-471e-995f-72a5600dac2e",
