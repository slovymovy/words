                ],
                "translations": [
                    {
                        "translation_id": "dab3e453-34e7-4f5a-b846-3ef393b19378",
                        "source_entry_id": "b0891179-eb7b-3a07-a13a-aca25bf135ad",
                        "source_sense_id": "406e50ca-d7dd-3dc4-85db-a76e63349286",
                        "source_sense_description": "Nichterscheinen, um seine Pflichten nicht erfüllen zu müssen",
                        "target_lang_word": "häufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "häufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                        "entry_id": "7162ef87-de9f-3bc3-9ced-da391ceccb3a",
                                        "glosses": [
                                            "vielfach vorkommend, viele Male, immer wieder auftretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639581b7-c52b-45fe-96f0-8e3bc46446e8",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "„Verbrennungen gehören zu den häufigen Unfällen im Haushalt.“"
                                            },
                                            {
                                                "example_id": "065f7931-16a4-48f9-873b-2109cbf31eba",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "Diese häufige Betonung von wirtschaftlichen Interessen in der Entwicklungspolitik verärgert viele Nichtregierungsorganisationen."
                                            },
                                            {
                                                "example_id": "bd5d0653-aa65-4299-b2cc-f34050fe7cbc",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "Der häufigste Lernfehler bei Nachprüfungen laut den Psychologen: Die ganzen Ferien verstreichen lassen und erst in den letzten Wochen Tag und Nacht strebern."
                                            },
                                            {
                                                "example_id": "6233cde3-2d7b-4098-bd9c-864c8b6856c0",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "Häufig ändern auch Spaßvögel hier Texte."
                                            },
                                            {
                                                "example_id": "62da9916-ec0d-447c-9021-232a37f4207b",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "Schlechte Noten, eine nicht geschaffte Hausarbeit, aber auch Kränkungen durch Dozenten verbergen sich häufig hinter den Problemen."
                                            },
                                            {
                                                "example_id": "eb6268ef-8e63-4331-ab39-8c414a919fae",
                                                "sense_id": "3eca69a3-80d1-3183-8269-1e0500d6320d",
                                                "text": "„Du umarmtest mich häufiger, seitdem wir erfahren hatten, dass ein Kind in mir heranwuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
