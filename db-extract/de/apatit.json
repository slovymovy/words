                        ]
                    },
                    {
                        "translation_id": "49d7e438-e1f0-4829-af49-34de38f3d98b",
                        "source_entry_id": "32d75374-48cc-3409-8f89-23875c461519",
                        "source_sense_id": "dfa699f0-0313-3cfc-9d48-83c41b9883e0",
                        "source_sense_description": "graugrün oder bräunliches Mineral, das für die Herstellung von Düngemitteln verwendet wird",
                        "target_lang_word": "апатит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "апатит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                                        "entry_id": "1bded655-259c-35e2-ac92-0298122aad2e",
                                        "glosses": [
                                            "минер. минерал, фосфат кальция, обычно используемый для производства фосфорных удобрений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb6cd2e-7191-4376-9805-7709f62228b8",
                                                "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                                                "text": "Лишь в порту лебёдок визг обычный, // Новый деррик над углём кряхтит – // В трюмы пароходов заграничных // Грузят лес и камень-апатит."
                                            },
                                            {
                                                "example_id": "06e71600-9707-4628-bae1-71228ef63f74",
                                                "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                                                "text": "Наиболее распространёнными и почти постоянно присутствующими в них минералами являются рудные — магнетит, ильменит, лейкоксен, пирит и лимонит и минералы — циркон, гранат, апатит, турмалин и рутил."
                                            }
                                        ]
                                    }
                                ]
