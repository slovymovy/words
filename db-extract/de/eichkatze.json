                        "sense_id": "27218b4b-3912-35a3-ad61-020a2c77318f",
                        "entry_id": "b6f0c78a-e0fa-35ba-a3cf-dfa111619807",
                        "glosses": [
                            "squirrel"
                        ],
                        "tags": [
                            "Austria",
