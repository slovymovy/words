                ],
                "senses": [
                    {
                        "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                        "entry_id": "0b428312-d93b-3bae-989b-b4e62bdc7a4b",
                        "glosses": [
                            "(durch seine/ihre herausragenden Laufleistungen) berühmter Läufer/berühmte Läuferin"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8398f8af-2712-47bc-a3dc-b1ed4f5e12a9",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„Echte Laufgrössen, wie Haile Gebrselassie, Tadessi Abraham oder bei den Frauen Cynthia Kosgei, sind hier schon gestartet.“"
                            },
                            {
                                "example_id": "a2f000a7-8b5e-45b4-ba15-88d15ef36af5",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„[…] Man braucht sich ja nur ansehen, welche Laufgrößen nun hinter mir liegen‚‘ schwärmte der 33-Jährige, der 2019 beim Berlin Marathon als bester Europäer und beim London Marathon 2020 als drittbester Europäer und bei beiden Gelegenheiten als Gesamt-Zwölfter über die Ziellinie lief.“"
                            },
                            {
                                "example_id": "a8af4c22-dd75-4872-97be-4285d0fed3de",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„Zusätzlich werden die jeweiligen Zeiten über bekannte Wettkampf-Distanzen angegeben und können mit der Tierwelt und bekannten Laufgrössen verglichen werden.“"
                            },
                            {
                                "example_id": "b3ee736a-c7fc-46c5-b6bf-d73bd15beecc",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„Kern verfolgte in diesem starken Feld von nationalen und internationalen Laufgrössen eine vordere Platzierung in den Top 10 – und die Verteidigung seines dritten Zwischenranges im Post-Cup.“"
                            },
                            {
                                "example_id": "92af587d-1208-4799-818d-b600ccb07d4c",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„Mit der Startlinie im Blick lausche ich dem Moderator, der aktuell die lokale Laufgröße Haftom Weldaj vorstellt.“"
                            },
                            {
                                "example_id": "2799ce9d-de44-48fc-b689-64db8500c586",
                                "sense_id": "ea743acd-a5d6-37fe-89d1-4b8011bcdb76",
                                "text": "„Trotz der Goldmedaille durch Donavan Brazier über 800m war die USA bei vergangenen globalen Events schon näher an den beiden ostafrikanischen Laufgrößen dran, insbesondere bei den Olympischen Spielen von Rio.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
