                    ],
                    "common_phrases": [
                        "esprit méthodique"
                    ]
                },
                {
                    "sense_id": "85b7b157-7866-335a-a7f0-303b2e16051f",
                    "sense_definition": "Qui est exécuté selon des règles précises ou un plan bien structuré.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "processus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ont procédé à une recherche <w>méthodique</w> de tous les indices matériels."
                        },
                        {
                            "text": "Un ordre <w>méthodique</w> doit être suivi pour classer correctement ces archives anciennes."
                        }
                    ],
                    "synonyms": [
                        "systématique",
                        "structuré"
                    ],
                    "common_phrases": [
