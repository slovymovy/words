                "senses": [
                    {
                        "sense_id": "0d7fa415-b0ec-3e25-bdea-88a01ba24f90",
                        "entry_id": "60cdf5e6-3ed4-38dd-afd9-8ca3a904a38a",
                        "glosses": [
                            "Nacht im August"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1fc029-c17d-4338-8262-9b39738418c9",
                                "sense_id": "0d7fa415-b0ec-3e25-bdea-88a01ba24f90",
                                "text": "„Zwei rauchende Laternen erhellten nur spärlich dieses Feldlager von todkranken Frauen. Der Geruch war entsetzlich trotz der zwei halb offenen Fenster, durch die die schwüle Hitze der Augustnacht hereinzog.“"
                            },
                            {
                                "example_id": "f3b7e9cc-f1cd-46c7-b7b6-b19815f38e5b",
                                "sense_id": "0d7fa415-b0ec-3e25-bdea-88a01ba24f90",
                                "text": "„Und dann steht er vor etwa drei Jahren auf einmal mit zwei Koffern auf dem Hofplatz von Oddi, und keiner empfängt ihn, außer der Augustnacht und einem einäugigen Kater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
