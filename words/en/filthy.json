        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7eda6241-fdbd-34c5-b259-f0a96ec0bc85",
                    "sense_definition": "To make very dirty; to saturate something with dirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy smoke <w>filthied</w> the white curtains over many years.",
                            "target_lang_translations": {
                                "ru": "Густой дым за многие годы <w>загрязнил</w> белые занавески.",
                                "zh": "多年来，浓烟把白色的窗帘都<w>弄脏</w>了。",
                                "es": "El humo denso <w>ensució</w> las cortinas blancas a lo largo de muchos años."
                            }
                        },
                        {
                            "text": "Be careful not to <w>filthy</w> your new shirt while playing in the garden.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>испачкай</w> свою новую рубашку, играя в саду.",
                                "zh": "在花园里玩的时候小心点，别把你的新衬衫<w>弄脏</w>了。",
                                "es": "Ten cuidado de no <w>ensuciar</w> tu camisa nueva mientras juegas en el jardín."
                            }
