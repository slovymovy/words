                ],
                "senses": [
                    {
                        "sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                        "entry_id": "bf3946b8-4376-3a40-bc16-26e195f7c4eb",
                        "glosses": [
                            "Unsicherheit darüber, was man selbst tut, kann oder will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff556963-6cf8-48e6-a01e-1ff1597df76e",
                                "sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                                "text": "„Beide, die PR-Beraterin wie die Journalistin, haben in den vergangenen Jahren viele Erfahrungen mit vom Selbstzweifel zernagten Gestalten machen dürfen.“"
                            },
                            {
                                "example_id": "bc50fa1e-2720-47fb-a927-039b07efb7b4",
                                "sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                                "text": "„Sie quält sich mit Selbstzweifeln.“"
                            },
                            {
                                "example_id": "688a3773-9746-466c-8670-e1dd35793839",
                                "sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                                "text": "„Ich bekam Selbstzweifel und wünschte mir den Tod.“"
                            },
                            {
                                "example_id": "5a10498c-1cfd-4224-82e7-877e29b39586",
                                "sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                                "text": "„Der Erfolg hat seine Selbstzweifel nicht besiegen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbc8ceef-efd6-4aef-a5b6-14efee9b4d9f",
                        "source_entry_id": "bf3946b8-4376-3a40-bc16-26e195f7c4eb",
                        "source_sense_id": "c388408c-3b27-3a8a-85e7-0b26bf4e165c",
                        "source_sense_description": "Unsicherheit darüber, was man selbst tut, kann oder will",
                        "target_lang_word": "self-doubt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-doubt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "138738ae-d942-34ab-ad5b-1cf3fa96fd5c",
                                        "entry_id": "34f56550-c5ec-340b-8bcf-cd505eb4ea86",
                                        "glosses": [
                                            "The doubting of one's own abilities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70934b1c-b3b9-41d6-af41-e3ec65988a2b",
                                                "sense_id": "138738ae-d942-34ab-ad5b-1cf3fa96fd5c",
                                                "text": "Yet in spite of these yearnings for a fallen leader, in spite of some bitterness, in spite of apprehensions, I knew it was imperative that I grasp the reins of power and do so without delay. Any hesitation or wavering, any false step, any sign of self-doubt, could have been disastrous. The nation was in a state of shock and grief. The times cried out for leadership."
                                            },
                                            {
                                                "example_id": "b264dca8-01a1-4c91-bb03-40e3e63d482c",
                                                "sense_id": "138738ae-d942-34ab-ad5b-1cf3fa96fd5c",
                                                "text": "None of the three feel they have encountered any resistance from colleagues in pursuing their chosen industry paths, although Rachel recalls how self-doubt initially hindered her progress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
