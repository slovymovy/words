                        "glosses": [
                            "Donner un caractère de gentleman à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1035f942-ca14-4d4f-ad85-87e278ffaa5c",
                                "sense_id": "dd0deafb-2148-3d6c-84c2-9f3ec37b1dad",
                                "text": "On va le gentlemaniser en deux tours de bras : avec le golf, tennis, équitation, yoga, sauna, yachting..."
                            },
                            {
                                "example_id": "e47c634b-b6ba-4598-a1e2-6de729e47c77",
                                "sense_id": "dd0deafb-2148-3d6c-84c2-9f3ec37b1dad",
                                "text": "Dans ce pays où l’ouvrier imite le petit bourgeois qui copie le grand bourgeois qui prend modèle sur l’aristocrate qui règle sa conduite sur celle du souverain qui serre la main de l’ouvrier — tout le monde aspire à se gentlemaniser."
                            }
                        ]
                    }
