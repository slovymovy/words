                        "examples": [
                            {
                                "example_id": "63728b55-8da0-419e-a6ff-cb37813dc475",
                                "sense_id": "e77be76a-9a62-36da-892d-dabb3dbd5904",
                                "text": "Let the songs be loud and cheerful, and not chirpings or pulings."
                            },
                            {
                                "example_id": "f9bb277b-0d4b-42a1-8441-09bff4795417",
                                "sense_id": "e77be76a-9a62-36da-892d-dabb3dbd5904",
                                "text": "We heard the peculiar note of the woodcock, which resembles the repeated croaking of the frog, followed by a sharp hissing sound, somewhat like the noisy chirping of the wagtail[.]"
                            },
                            {
                                "example_id": "a88b46d0-c973-4a29-85e0-8fb60efce72d",
                                "sense_id": "e77be76a-9a62-36da-892d-dabb3dbd5904",
                                "text": "Adler's prose seeks to catch the whispers and chirpings of insanity rather than the lamentations of suffering."
                            }
                        ]
                    }
