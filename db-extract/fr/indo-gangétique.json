                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d46e653-8cfc-410a-8f61-f1d5864a0889",
                                "sense_id": "e37908bf-a194-340c-a856-a1d471aff255",
                                "text": "Son errance dans toute l’Inde du Nord, de la grande plaine indogangétique à l’Himalaya, nous enchante plus qu’elle ne nous éclaire."
                            },
                            {
                                "example_id": "598584d9-cae8-4945-8dd8-da5c050e98cb",
                                "sense_id": "e37908bf-a194-340c-a856-a1d471aff255",
                                "text": "Notre puanteur incommodait les visiteuses : Saoudiennes coûteusement vêtues, vacancières indo-gangétiques portant leur tikka sur leur front et Shanghaïennes en doudoune, fort impressionnées par le balancement de la cabine."
                            }
                        ]
