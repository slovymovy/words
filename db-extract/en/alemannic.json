                                        "sense_id": "2999336a-ab42-30f3-aa61-ccc2cec75159",
                                        "entry_id": "e734390f-c82e-370d-9450-dd2cfad0fed9",
                                        "glosses": [
                                            "Verband einer Reihe von oberdeutschen Großdialekten beziehungsweise Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c474f8fa-6ca6-4b74-9a0f-8d9e3c1ed9ee",
                                                "sense_id": "2999336a-ab42-30f3-aa61-ccc2cec75159",
                                                "text": "Das Wort „fallen“ heißt auf Alemannisch „kaie“, oder auch „gheie“, ausgesprochen mit starken k (ch) oder gh."
                                            },
                                            {
                                                "example_id": "b3082e89-d4bd-4b24-a72d-70b241a2ee3f",
                                                "sense_id": "2999336a-ab42-30f3-aa61-ccc2cec75159",
                                                "text": "Auch die Deutschschweiz (einschließlich der Walsergebiete), ebenso Vorarlberg, gehören zum Sprachraum des Alemannischen."
                                            },
