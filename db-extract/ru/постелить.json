                        "examples": [
                            {
                                "example_id": "990a6724-e6d1-4018-96ae-773fd4bf84cf",
                                "sense_id": "50db505d-c718-3057-ab26-72e2a8ad017e",
                                "text": "Ма́ма посте́лет мне посте́ль.",
                                "translation": "Mum is going to make a bed for me.",
                                "english": "Mum is going to make a bed for me."
                            },
                            {
                                "example_id": "25978883-5799-452f-966b-f6c285efd383",
                                "sense_id": "50db505d-c718-3057-ab26-72e2a8ad017e",
                                "text": "Когда́ посте́лем лино́леум?",
                                "translation": "When shall we put linoleum on?",
