                                "target_lang_sense_clarification": "деталь кузова над колесом"
                            },
                            {
                                "target_lang_word": "брызговик",
                                "target_lang_sense_clarification": "защитный элемент за колесом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768fedfd-9fa5-385f-a674-25a0c40d432b",
                    "sense_definition": "the part of a sword hilt that protects the hand",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ornate <w>guard</w> of the rapier was decorated with gold leaf.",
                            "target_lang_translations": {
                                "ru": "Изящная <w>гарда</w> рапиры была украшена сусальным золотом."
                            }
                        },
                        {
                            "text": "A sturdy <w>guard</w> is essential for protecting the fingers during a duel.",
                            "target_lang_translations": {
                                "ru": "Прочная <w>гарда</w> необходима для защиты пальцев во время дуэли."
                            }
                        }
                    ],
                    "synonyms": [
                        "crossguard",
                        "quillon"
                    ],
                    "common_phrases": [
                        "sword guard"
                    ],
                    "target_lang_definitions": {
                        "ru": "часть эфеса меча, защищающая руку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарда",
                                "target_lang_sense_clarification": "защитная часть холодного оружия"
                            }
                        ]
                    }
                }
            ]
        },
        {
