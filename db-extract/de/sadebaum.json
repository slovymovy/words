                "translations": [
                    {
                        "translation_id": "9be45f08-da45-48f7-9e84-21a392e5a3c2",
                        "source_entry_id": "a277e135-10d0-31cb-8709-310921556df0",
                        "source_sense_id": "db35275a-565c-32f8-9bf6-3cb792b58dd9",
                        "source_sense_description": "Botanik: kleiner Strauch der Gattung Wacholder (Juniperus)",
                        "target_lang_word": "jałowiec sabiński",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "301835fd-c161-4fbd-ad79-1571f12c4f6b",
                        "source_entry_id": "a277e135-10d0-31cb-8709-310921556df0",
                        "source_sense_id": "db35275a-565c-32f8-9bf6-3cb792b58dd9",
                        "source_sense_description": "Botanik: kleiner Strauch der Gattung Wacholder (Juniperus)",
                        "target_lang_word": "можжевельник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "можжевельник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8bbea5fb-b7ae-35f9-a7fe-c08e8411c948",
                                        "entry_id": "81e607b8-b6d8-35d7-b62c-4b3abcf2210f",
                                        "glosses": [
                                            "ботан. вечнозелёное хвойное растение, дерево или кустарник семейства кипарисовых (Juniperus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c426f9-6a27-4100-8763-0146253ac795",
                                                "sense_id": "8bbea5fb-b7ae-35f9-a7fe-c08e8411c948",
                                                "text": "Уныло жёлтые цветы // Да можжевельника кусты // Забыты ветрами растут // В тени сырой."
                                            },
                                            {
                                                "example_id": "66603d7d-8d2a-487e-af91-c6591edd87d6",
                                                "sense_id": "8bbea5fb-b7ae-35f9-a7fe-c08e8411c948",
                                                "text": "Всё ближе слышится голос. Вот он уже здесь, рядом, за раскидистыми кедрами, за тёмной зеленью можжевельника."
                                            },
                                            {
                                                "example_id": "2cda679e-803b-41e2-828e-96fae9a95026",
                                                "sense_id": "8bbea5fb-b7ae-35f9-a7fe-c08e8411c948",
                                                "text": "Только ближе к XVIII веку англичане решили сами делать крепкое спиртное с добавлением плодов можжевельника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8756f40a-19fa-3c46-b3ea-1d156e9ec1cb",
                                        "entry_id": "81e607b8-b6d8-35d7-b62c-4b3abcf2210f",
                                        "glosses": [
                                            "собир. можжевеловый лес, стланик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "568d8031-60a0-46e6-8f66-d32b83b56496",
                                                "sense_id": "8756f40a-19fa-3c46-b3ea-1d156e9ec1cb",
                                                "text": "С ветки на ветку, с ельника на можжевельник подобралась мутная нежить, ― животы в космах да в шишках, на хвостах репей, на голове шерсть колтуном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732f6d44-e0b7-3878-9a07-fa220a277606",
                                        "entry_id": "81e607b8-b6d8-35d7-b62c-4b3abcf2210f",
                                        "glosses": [
                                            "собир. можжевеловые ветки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1dfb5fe-7716-46ce-841e-a987a3061d39",
                                                "sense_id": "732f6d44-e0b7-3878-9a07-fa220a277606",
                                                "text": "Крикнут ли на дворе, зашумит ли кто на лестнице ― вся кровь у неё вспыхнет, как на огне можжевельник, и сердце запрыгает от ожидания… вскочит, бывало, бедняжка и побежит к окну или дверям ― и, в двадцатый раз обманутая, потупя очи, тихо пойдёт за рукоделье, которое впервые показалось ей скучно и бесконечно."
                                            },
                                            {
                                                "example_id": "8ceab32c-619a-460e-8d5d-e9bc5900f750",
                                                "sense_id": "732f6d44-e0b7-3878-9a07-fa220a277606",
                                                "text": "К ночи кругом гроба горели свечи, на гробу был покров, на полу был посыпан можжевельник, под мёртвую ссохшуюся голову была положена печатная молитва, а в углу сидел дьячок, читая псалтырь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c74b26b1-b94c-307f-8713-1bde4b586106",
                                        "entry_id": "81e607b8-b6d8-35d7-b62c-4b3abcf2210f",
                                        "glosses": [
                                            "собир. ягоды можжевельника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f0ca73-a3de-4eb8-be77-719ed647d4f0",
                                                "sense_id": "c74b26b1-b94c-307f-8713-1bde4b586106",
                                                "text": ".. пили водку, настоянную на можжевельнике .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
