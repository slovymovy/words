                "senses": [
                    {
                        "sense_id": "34b45cbe-89a7-3f87-a211-e5203162b6dc",
                        "entry_id": "87a7f97d-c511-3cc1-b484-5d3ce3504663",
                        "glosses": [
                            "Text, dessen hauptsächliche Textfunktion darin besteht, dass von einem bestimmten Zeitpunkt an etwas Neues gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c3a388-ad98-4470-8010-88c9aa73f238",
                                "sense_id": "34b45cbe-89a7-3f87-a211-e5203162b6dc",
                                "text": "Urteile sind Deklarationstexte, da ihre Hauptfunktion darin besteht, dass für einen Beklagten eine neue Wirklichkeit gilt: er ist entweder freigesprochen oder verurteilt."
                            },
                            {
                                "example_id": "ec90b8b3-21d4-4e39-ba8c-e61a0083db59",
                                "sense_id": "34b45cbe-89a7-3f87-a211-e5203162b6dc",
                                "text": "„Seine Anwendung führt zur Unterscheidung der folgenden fünf Textklassen: …- Deklarationstexte (Testament, Ernennungsurkunde…)...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
