                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "channel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio system is <w>trunked</w> to improve efficiency.",
                            "target_lang_translations": {
