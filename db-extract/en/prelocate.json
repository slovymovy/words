                        ],
                        "examples": [
                            {
                                "example_id": "c4653e48-083f-40d8-a5e3-9dfc027963e3",
                                "sense_id": "c3315881-7e77-3d74-9721-f8d4ed7b9722",
                                "text": "Manufactured strain gage rosettes are now being used to prelocate the gages with respect to the proposed hole center."
                            },
                            {
                                "example_id": "c9c4d1db-30b7-4b04-b815-57b841faefac",
                                "sense_id": "c3315881-7e77-3d74-9721-f8d4ed7b9722",
                                "text": "Where sections are more than about 500 feet (152.5 m) apart, prelocate all cross sections on aerial photographs."
                            },
                            {
                                "example_id": "8760e904-638d-42b4-bda1-a59a9a40ffa7",
                                "sense_id": "c3315881-7e77-3d74-9721-f8d4ed7b9722",
                                "text": "In addition, the green ventilation ducts which emerge at two points in the wall had to be cut into the mosaic, as it had not been possible to prelocate them."
                            }
                        ]
                    }
