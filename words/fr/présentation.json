            "senses": [
                {
                    "sense_id": "0d6901f3-c745-3a64-941a-717ea953785c",
                    "sense_definition": "Action de présenter une personne à une autre pour qu'elles fassent connaissance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relation_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme vous ne vous connaissez pas encore, je vais faire les <w>présentations</w>."
                        },
                        {
                            "text": "Après les <w>présentations</w> d'usage, nous avons commencé à discuter du projet."
                        }
                    ],
                    "common_phrases": [
                        "faire les présentations"
                    ]
                },
                {
                    "sense_id": "67b51e22-752f-34bd-a12e-3d05135e2bd9",
                    "sense_definition": "Exposé oral structuré destiné à faire découvrir ou expliquer un sujet devant un public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
