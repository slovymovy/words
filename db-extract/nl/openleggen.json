                                        "sense_id": "99472bda-466f-3b1d-84ca-22b70d724a1a",
                                        "entry_id": "062db1c1-9d74-3076-bc1f-bf581fbe02e9",
                                        "glosses": [
                                            "To show openly; to disclose; to reveal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f8c7be-e69b-4f8f-b54a-8e1f0bfff081",
                                                "sense_id": "99472bda-466f-3b1d-84ca-22b70d724a1a",
                                                "text": "To uncover his perjury to the oath of his coronation."
                                            },
                                            {
                                                "example_id": "961bde4b-a816-41f3-84f9-48dc09edd175",
                                                "sense_id": "99472bda-466f-3b1d-84ca-22b70d724a1a",
                                                "text": "But Levinson said in an interview that the stalemate uncovers a flaw in the US system."
                                            },
                                            {
                                                "example_id": "94e30896-b1f9-457e-b8eb-c593cf1974a1",
                                                "sense_id": "99472bda-466f-3b1d-84ca-22b70d724a1a",
                                                "text": "New insights into bee movements and life cycles have been uncovered after researchers tracked the insects using tiny QR codes glued onto their backs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea64653e-dd2c-3e7c-852d-dfcba9c1ebab",
                                        "entry_id": "062db1c1-9d74-3076-bc1f-bf581fbe02e9",
                                        "glosses": [
                                            "To remove one's hat or cap as a mark of respect."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c0c1bb-8a07-4788-9b68-6b039b554dab",
                                                "sense_id": "ea64653e-dd2c-3e7c-852d-dfcba9c1ebab",
                                                "text": "Alfred, surprised to meet his father, whom he thought absent from home, […] stood, holding his firelock in one hand, and his hat in the other, having uncovered himself as soon as he perceived his father."
                                            },
                                            {
                                                "example_id": "5a1841f7-0e2c-4b12-b76f-2bd8f386ebeb",
                                                "sense_id": "ea64653e-dd2c-3e7c-852d-dfcba9c1ebab",
                                                "text": "The English soldiers were directed in general orders to salute and uncover before the Host as it passed, and here in the wilderness the old religion held firm sway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfb78b7-60fa-3399-af04-ea6b06dab44d",
                                        "entry_id": "062db1c1-9d74-3076-bc1f-bf581fbe02e9",
                                        "glosses": [
                                            "To expose the genitalia."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6bf688-88d3-4a94-8e02-2a8b6342f67f",
                                                "sense_id": "3cfb78b7-60fa-3399-af04-ea6b06dab44d",
                                                "text": "The phallus had power to subdue the attacks of demons and the Evil Eye; and the female organs were potent over elemental disturbances, thus a woman uncovering herself could quell a storm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae60bbc4-0b72-3f58-9646-8a3c1b0e31bf",
                                        "entry_id": "062db1c1-9d74-3076-bc1f-bf581fbe02e9",
