                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2d9899-7f31-4774-b7e8-6c3353ecbc79",
                                "sense_id": "e079fc19-ae9b-3d24-b943-b702dee4bff4",
                                "text": "Wybieramy się na tygodniową wycieczkę naszym kamperem."
