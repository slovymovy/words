{
    "word_family": [
        "take"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b40760d0-fdfb-3062-b64a-448c9c66f325",
                    "sense_definition": "The ability to understand or comprehend something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a bit slow on the <w>uptake</w> when it came to learning the new software.",
                            "target_lang_translations": {
                                "zh": "他在学习新软件时，<w>领悟力</w>稍微慢了一些。"
                            }
                        },
                        {
                            "text": "She is very quick on the <w>uptake</w> and understood the complex instructions immediately.",
                            "target_lang_translations": {
                                "zh": "她<w>领悟力</w>很强，立刻就理解了那些复杂的指令。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehension",
                        "understanding"
                    ],
                    "common_phrases": [
                        "quick on the uptake",
                        "slow on the uptake"
                    ],
                    "target_lang_definitions": {
                        "zh": "指理解或领会某事的能力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "领悟力",
                                "target_lang_sense_clarification": "指人理解事物的速度和能力。"
                            },
                            {
                                "target_lang_word": "理解力",
                                "target_lang_sense_clarification": "指对事物本质的认知能力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4075b375-53c6-3284-be95-293fbaea4267",
                    "sense_definition": "The process of absorbing substances like nutrients or drugs into an organism.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>uptake</w> of glucose by the cells is essential for energy production.",
                            "target_lang_translations": {
                                "zh": "细胞对葡萄糖的<w>吸收</w>对于能量产生至关重要。"
                            }
                        },
                        {
                            "text": "Certain medications can interfere with the <w>uptake</w> of vitamins in the body.",
                            "target_lang_translations": {
                                "zh": "某些药物会干扰人体对维生素的<w>吸收</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorption"
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物体吸收营养物质或药物的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸收",
                                "target_lang_sense_clarification": "指机体摄取物质的过程。"
                            },
                            {
                                "target_lang_word": "摄取",
                                "target_lang_sense_clarification": "指生物体主动获取营养的过程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23d007e6-58ca-3425-a7c3-956afc5140b4",
                    "sense_definition": "The act of lifting or taking something up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lifting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanical <w>uptake</w> of the heavy materials was completed by the crane.",
                            "target_lang_translations": {
                                "zh": "重物的机械<w>起吊</w>工作由起重机完成了。"
                            }
                        },
                        {
                            "text": "The system allows for the efficient <w>uptake</w> of cargo from the lower deck.",
                            "target_lang_translations": {
                                "zh": "该系统允许从下层甲板高效地<w>提升</w>货物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lifting"
                    ],
                    "target_lang_definitions": {
                        "zh": "指向上提起或搬运某物的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "指将物体向上移动。"
                            },
                            {
                                "target_lang_word": "起吊",
                                "target_lang_sense_clarification": "指使用机械装置向上搬运。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1d41780-82cb-38af-ad32-87ff0c1209d9",
                    "sense_definition": "A structure such as a chimney or pipe that carries smoke or air away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smoke is vented through a large <w>uptake</w> located on the roof.",
                            "target_lang_translations": {
                                "zh": "烟雾通过位于屋顶的一个大型<w>排烟道</w>排出。"
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>uptake</w> to ensure proper airflow for the boiler.",
                            "target_lang_translations": {
                                "zh": "工程师检查了<w>排烟道</w>，以确保锅炉有良好的空气流通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chimney",
                        "vent"
                    ],
                    "target_lang_definitions": {
                        "zh": "指用于排出烟雾或气体的管道或烟囱结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "排烟道",
                                "target_lang_sense_clarification": "专门用于排放烟气的通道。"
                            },
                            {
                                "target_lang_word": "通风管",
                                "target_lang_sense_clarification": "用于空气流通的管道。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e99b0396-312b-3d02-ad9d-372b0c604853",
                    "sense_definition": "A pipe that directs smoke from a boiler towards a chimney.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ventilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam engine's <w>uptake</w> was clogged with soot.",
                            "target_lang_translations": {
                                "zh": "蒸汽机的<w>烟道</w>被煤烟堵塞了。"
                            }
                        },
                        {
                            "text": "Maintenance workers cleaned the <w>uptake</w> to improve the boiler's efficiency.",
                            "target_lang_translations": {
                                "zh": "维修工清理了<w>烟道</w>以提高锅炉的效率。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指将锅炉烟气导向烟囱的连接管道。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烟道",
                                "target_lang_sense_clarification": "锅炉系统中连接炉膛与烟囱的管道。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "603f96dd-7ba9-3daf-851b-cd93e7dccd08",
                    "sense_definition": "To accept and begin using a new practice or service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many companies are starting to <w>uptake</w> new digital technologies to improve efficiency.",
                            "target_lang_translations": {
                                "zh": "许多公司正开始<w>采用</w>新的数字技术来提高效率。"
                            }
                        },
                        {
                            "text": "The government hopes that more citizens will <w>uptake</w> the new health program.",
                            "target_lang_translations": {
                                "zh": "政府希望更多的公民能够<w>接受</w>这项新的健康计划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adopt",
                        "accept"
                    ],
                    "target_lang_definitions": {
                        "zh": "指接受并开始使用新的做法或服务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "采用",
                                "target_lang_sense_clarification": "指采纳并应用新技术或新方法。"
                            },
                            {
                                "target_lang_word": "接受",
                                "target_lang_sense_clarification": "指同意并开始使用某项服务。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be82d320-8a2d-3da6-b126-974640500473",
                    "sense_definition": "To absorb a substance like food or a drug into an organism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plants <w>uptake</w> minerals from the soil through their roots.",
                            "target_lang_translations": {
                                "zh": "植物通过根部从土壤中<w>吸收</w>矿物质。"
                            }
                        },
                        {
                            "text": "The body will <w>uptake</w> the medication more effectively if taken with water.",
                            "target_lang_translations": {
                                "zh": "如果用水送服，身体会更有效地<w>吸收</w>药物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorb"
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物体吸收食物或药物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸收",
                                "target_lang_sense_clarification": "指生物体摄入并同化物质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7203eaf5-aa61-351c-9b08-782e20413929",
                    "sense_definition": "To lift something up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lifting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paused to <w>uptake</w> the fallen book from the floor.",
                            "target_lang_translations": {
                                "zh": "他停下来，从地板上<w>拾起</w>了掉落的书。"
                            }
                        },
                        {
                            "text": "She reached down to <w>uptake</w> the heavy box.",
                            "target_lang_translations": {
                                "zh": "她弯下腰去<w>提起</w>那个沉重的箱子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "raise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指将某物向上提起。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拾起",
                                "target_lang_sense_clarification": "指从地上捡起某物。"
                            },
                            {
                                "target_lang_word": "提起",
                                "target_lang_sense_clarification": "指将物体向上举起。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}