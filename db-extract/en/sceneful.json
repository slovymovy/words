                        "entry_id": "fe09896c-8659-39b2-a4b0-5dd1c7ef339a",
                        "glosses": [
                            "A quantity contained in a scene."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc58f6c5-7975-48a6-85c6-d799beb59d6d",
                                "sense_id": "6e12b17f-ea37-30d3-acea-6bdb8d13916f",
                                "text": "Not even the heart of one of the delectable slim-legged ponlettes who high-heel in swarms wherever the celluloid Napoleons decree a sceneful of \"extras, female\"; no, nothing but a downy, cuddly chick that eventually grows up into a cackling, flowerbed-scratching Biddy, with no ambition beyond inspiring omelets and eventually herself becoming casserole filling."
                            },
                            {
                                "example_id": "2593bac3-8a18-4da5-a9f0-19e1939e432d",
                                "sense_id": "6e12b17f-ea37-30d3-acea-6bdb8d13916f",
                                "text": "She cannot resist a sceneful of scathing remarks for one final humiliation of her husband before she leaves."
                            },
                            {
                                "example_id": "50f127f3-f05e-475f-9178-3b04bc06ee74",
                                "sense_id": "6e12b17f-ea37-30d3-acea-6bdb8d13916f",
                                "text": "I only get a sceneful of sorrow."
                            }
                        ]
                    }
