                                        "sense_id": "152be5e3-b90f-30c4-828d-eb7832d17801",
                                        "entry_id": "0d7f92fd-1689-3fac-bd2b-3d4f0b9bc980",
                                        "glosses": [
                                            "zweimal so oft oder so viel"
                                        ],
                                        "tags": [
                                            "Vervielfältigungszahlwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08140d2f-8a3a-4571-acf2-ed6b409004e9",
                                                "sense_id": "152be5e3-b90f-30c4-828d-eb7832d17801",
                                                "text": "Nachdem das Medikament bei Herbert nur schlecht wirkte, verschrieb ihm sein Arzt die zweifache Dosis."
                                            },
                                            {
                                                "example_id": "e3afef53-c0bb-4dc2-b136-8bd3c6a9e977",
                                                "sense_id": "152be5e3-b90f-30c4-828d-eb7832d17801",
                                                "text": "Jedes hergestellte Produkt wird von uns zweifach kontrolliert."
                                            },
                                            {
                                                "example_id": "065dae25-269f-4697-947f-32bf01ffe01b",
                                                "sense_id": "152be5e3-b90f-30c4-828d-eb7832d17801",
                                                "text": "„Bei den Expeditionen kommen die Einheimischen auf zweifache Weise mit Meyer in Berührung: als seine Bediensteten (Träger, Diener und Führer) oder als Eigentümer von Nahrungsmitteln beziehungsweise von Land, das ihm für die Dauer seines Aufenthalts teilweise überlassen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
