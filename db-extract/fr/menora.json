                                                "sense_id": "c77d80f4-9ad0-373a-ac9f-b1b7ad83a281",
                                                "text": "W herbie Izraela widnieje biała menora na niebieskim tle."
                                            },
                                            {
                                                "example_id": "27762cb7-fd10-4ebd-b938-cb29b756f3df",
                                                "sense_id": "c77d80f4-9ad0-373a-ac9f-b1b7ad83a281",
                                                "text": "Wikary pokazał dzieciom menorę przywiezioną z Jerozolimy."
                                            },
                                            {
                                                "example_id": "64542ee3-f5e1-4042-8f95-8865fb1edc3f",
                                                "sense_id": "c77d80f4-9ad0-373a-ac9f-b1b7ad83a281",
                                                "text": "Jedna z najstarszych menor w Europie znajduje się w Kołobrzegu."
                                            }
