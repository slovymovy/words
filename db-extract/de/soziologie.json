                "senses": [
                    {
                        "sense_id": "07fba735-1c91-38c1-a096-1a94466f44b2",
                        "entry_id": "46dbaad8-01af-30b8-89bf-c80328ebf4f2",
                        "glosses": [
                            "Wissenschaft, die sich systematisch und kritisch mit dem Zusammenleben der Menschen in einer Gesellschaft befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e943139-d3d5-4c22-bcdd-02b901ed2892",
                                "sense_id": "07fba735-1c91-38c1-a096-1a94466f44b2",
                                "text": "„Die Wissenschaft der Soziologie entstand aus dem Bedürfnis und dem Bemühen der Menschen, ihre Gesellschaft zu verstehen und zu verändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3f02662-0c73-4a39-9666-09ba69664f0a",
                        "source_entry_id": "46dbaad8-01af-30b8-89bf-c80328ebf4f2",
                        "source_sense_id": "07fba735-1c91-38c1-a096-1a94466f44b2",
                        "source_sense_description": "Wissenschaft, die sich mit dem Zusammenleben der Menschen in einer Gesellschaft befasst",
                        "target_lang_word": "sociology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb5f2b1c-d73a-305d-b391-34d27373526b",
                                        "entry_id": "92d18079-04bb-34e4-9bbe-3b681e0d77ae",
                                        "glosses": [
                                            "A social science that studies society, human social interaction, patterns of social relationships, and the interactions of culture. Through both theory and applied research, it engages subject matters across a range of microanalysis, mesoanalysis, and macroanalysis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd14cae-d558-41f5-abda-551b6b518016",
                                                "sense_id": "fb5f2b1c-d73a-305d-b391-34d27373526b",
                                                "text": "Maisie says that Danny entered the manosphere through the realm of self-help, which Cynthia Miller-Idriss, a sociology professor at American University who specializes in extremism, says is “a great example of how radicalization works.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b40eb2c8-68bb-4b2d-93ad-f86f55791b79",
                        "source_entry_id": "46dbaad8-01af-30b8-89bf-c80328ebf4f2",
                        "source_sense_id": "07fba735-1c91-38c1-a096-1a94466f44b2",
                        "source_sense_description": "Wissenschaft, die sich mit dem Zusammenleben der Menschen in einer Gesellschaft befasst",
                        "target_lang_word": "sociologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb812c8-5293-3e10-a2f6-b49d9c604e56",
                                        "entry_id": "4d9ad22a-5f9b-35aa-9ce7-931dd3dcf4df",
                                        "glosses": [
                                            "Science, étude des phénomènes sociaux, des relations humaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09d3d15-29b0-4da9-90cf-b869c07ff099",
                                                "sense_id": "6bb812c8-5293-3e10-a2f6-b49d9c604e56",
                                                "text": "À la Sorbonne, personne ne suivait les cours de sociologie, ni ceux de psychologie, tant ils nous semblaient insipides."
                                            },
                                            {
                                                "example_id": "6227b146-b303-4367-8b68-b7dbbd265fa3",
                                                "sense_id": "6bb812c8-5293-3e10-a2f6-b49d9c604e56",
                                                "text": "La sociologie américaine nous vient d'un monde où les jeunes, avant même l'invention de la pilule, avaient le droit de s'envoyer en l’air sur les banquettes arrière des voitures. Ils ne le faisaient cependant qu'en vitesse et avec un appel immodéré à la fellation. Sans être tout à fait puceaux, ils arrivaient pour l'essentiel vierges au mariage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
