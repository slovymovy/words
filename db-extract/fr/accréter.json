                "senses": [
                    {
                        "sense_id": "3c4aa88d-80b7-36c3-b6c2-920dcb919701",
                        "entry_id": "740d1eb4-aba4-332a-86df-33f49422764a",
                        "glosses": [
                            "(pour un astre) Capter et agglomérer de la matière sous l'effet de la gravitation."
                        ],
                        "tags": [
                            "Planétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c6c28f3c-4839-4911-b6ba-71017391bb67",
                                "sense_id": "3c4aa88d-80b7-36c3-b6c2-920dcb919701",
                                "text": "Les quasars sont des trous noirs supermassifs accrétant de la matière qui chauffe en formant un disque d'accrétion émettant notamment des rayons ultraviolets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f97dc0f-bf60-433f-99ad-4d5c4fedfb9c",
                        "source_entry_id": "740d1eb4-aba4-332a-86df-33f49422764a",
                        "source_sense_id": "3c4aa88d-80b7-36c3-b6c2-920dcb919701",
                        "target_lang_word": "accrete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accrete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5833907-3a95-358d-b042-7a3b37db3695",
                                        "entry_id": "8d0cb24d-6bdf-3946-9c1c-7f1a6c6b4a0d",
                                        "glosses": [
                                            "To grow together, combine; to fuse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b0740c6-950b-4768-b535-3d25821fd9b6",
                                                "sense_id": "b5833907-3a95-358d-b042-7a3b37db3695",
                                                "text": "Astronomers believe the Earth began to accrete more than 4.6 billion years ago."
                                            },
                                            {
                                                "example_id": "51fa1609-eb80-466c-8573-6fb48a64caa6",
                                                "sense_id": "b5833907-3a95-358d-b042-7a3b37db3695",
                                                "text": "According to the reigning hypothesis, about 4.5 billion years ago, shortly after Earth had accreted down into a sphere from its little slub of circumsolar material, another newborn planet [Theia], still shaky on its feet, slammed obliquely into Earth with terrifying force."
                                            },
                                            {
                                                "example_id": "85cc80bd-0597-4583-8fec-e242ff322820",
                                                "sense_id": "b5833907-3a95-358d-b042-7a3b37db3695",
                                                "text": "Chris Ormel, an astronomer at the University of Amsterdam, and his colleagues recently calculated that protoplanets began to form at the snow line around the star, then grew quickly by accreting pebbles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "057e8312-077e-3e06-a45f-5a462a20bbb5",
                                        "entry_id": "8d0cb24d-6bdf-3946-9c1c-7f1a6c6b4a0d",
                                        "glosses": [
                                            "To adhere; to grow or to be added to gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5a1940f-d7d3-327a-9a26-5f306a6eed1e",
                                        "entry_id": "8d0cb24d-6bdf-3946-9c1c-7f1a6c6b4a0d",
                                        "glosses": [
                                            "To make adhere; to add; to make larger or more, as by growing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ad1ac9-515b-4dcf-9e88-7c7bb3b65945",
                                                "sense_id": "e5a1940f-d7d3-327a-9a26-5f306a6eed1e",
                                                "text": "the reader has not only mastered this distinction , but that he has so thoroughly accreted it and assimilated it to his habits of mind"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accrete",
