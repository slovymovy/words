                    {
                        "sense_id": "018c856c-2f3a-34f1-9c7b-3a1960860656",
                        "entry_id": "68bd6040-6a5c-3ca1-bab6-0d99f80b1271",
                        "glosses": [
                            "a slap in the face, usually a painfully hard blow"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d5d3c700-7c8d-4ccc-8382-25d2946aa021",
                                "sense_id": "018c856c-2f3a-34f1-9c7b-3a1960860656",
                                "text": "Hij gaf hem een muilpeer na het horen van het beledigende commentaar.",
                                "translation": "He gave him a slap in the face after hearing the insulting comment.",
                                "english": "He gave him a slap in the face after hearing the insulting comment."
                            },
                            {
                                "example_id": "63e280db-867e-4144-898e-9e4d78100fa7",
                                "sense_id": "018c856c-2f3a-34f1-9c7b-3a1960860656",
                                "text": "De muilpeer was zo hard dat ze even haar evenwicht verloor.",
                                "translation": "The blow was so hard that she momentarily lost her balance.",
                                "english": "The blow was so hard that she momentarily lost her balance."
                            },
                            {
                                "example_id": "2d885f41-8555-41ee-ba49-dd432a129da5",
                                "sense_id": "018c856c-2f3a-34f1-9c7b-3a1960860656",
                                "text": "Hij ontving een onverwachte muilpeer tijdens het argument.",
                                "translation": "He received an unexpected slap in the face during the argument.",
                                "english": "He received an unexpected slap in the face during the argument."
                            }
                        ]
                    }
                ],
