                "translations": [
                    {
                        "translation_id": "d7442cdf-4577-4c2e-b776-28419f5c08ab",
                        "source_entry_id": "dca0dac1-0ca6-3465-b5b9-1f058b57d4c3",
                        "source_sense_id": "0fac803a-8043-3340-9d1c-2316f6f5d15c",
                        "source_sense_description": "Medizin: Muskel, der die Öffnung eines Hohlorgans verschließt",
                        "target_lang_word": "sphincter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphincter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                        "entry_id": "062b1aed-92e3-359a-b8fd-f187cf0bb439",
                                        "glosses": [
                                            "A ringlike band of muscle that surrounds a bodily opening (such as the anus or the openings of the stomach), constricting and relaxing as required for normal physiological functioning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56c0908-71f0-4ffb-ac6c-969a955222fa",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "The ink sac feeds into the rectum, controlled by a sphincter and in some inking events mucus from another organ, the funnel organ is ejected with water and ink through the anus and the siphon to create a cloud of ink."
                                            },
                                            {
                                                "example_id": "0f09bb99-33fb-4b06-9d1a-0c0e0bf95c57",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "the sphincter of the bladder"
                                            },
                                            {
                                                "example_id": "c53edf31-9916-4e8a-8450-4127502ba77e",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "the iris sphincter in the eye"
                                            },
                                            {
                                                "example_id": "f3093804-e72c-4d6f-af2d-481c45f90db4",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "She decided that she would force him to climax first by the sheer strength of her young animal control, the strength of her sphincters […]"
                                            },
                                            {
                                                "example_id": "4a9724ea-4800-4787-9811-2df54c9e4159",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "Polygraph operators place their subjects on a pad that can sense the clenching of their sphincters, a device known by those who’ve sat on them as the “whoopee cushion.” Maguire took his seat, his sphincter already tight enough to crush walnuts."
                                            },
                                            {
                                                "example_id": "a5d41735-a4b0-4c18-a990-f5aed7aecbf3",
                                                "sense_id": "9b9350a8-727d-311e-b74e-963d5a57a090",
                                                "text": "Go ahead, use your eye sphincters and watch the roof opening and closing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f74bbf-40f3-431c-94c6-eb12791bae3f",
                        "source_entry_id": "dca0dac1-0ca6-3465-b5b9-1f058b57d4c3",
                        "source_sense_id": "0fac803a-8043-3340-9d1c-2316f6f5d15c",
                        "source_sense_description": "Medizin: Muskel, der die Öffnung eines Hohlorgans verschließt",
                        "target_lang_word": "sphincter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphincter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                        "entry_id": "214b528f-094a-3557-bc2e-d55de06111f5",
                                        "glosses": [
                                            "Muscle annulaire qui a la faculté de se contracter et qui sert à rétrécir ou à fermer certains orifices naturels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797d7650-8ff8-4b2c-8923-56ca64e49c86",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "Les sphincters de l’anus."
                                            },
                                            {
                                                "example_id": "b41e75cc-21ca-4db7-a4a1-655417e33dd7",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "Le sphincter de la vessie."
                                            },
                                            {
                                                "example_id": "ce7a687c-14b6-40f7-8265-9554440be244",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "Le cardia est le sphincter d’entrée de l’estomac."
                                            },
                                            {
                                                "example_id": "3e763e90-ed55-42ed-b9d0-3278c9f973cf",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "M. Dufour communique l’observation d’un cas remarquable de triplopie monoculaire, qu’il eut l’occasion d’analyser et de traiter dans la clinique du professeur de Græfe.\nUn jeune homme reçoit, à l’âge de 12 ans, un coup de poing sur l’œil gauche. À partir de cet instant il voit triple de cet œil, et cet état persiste sans changement jusqu’au moment de l’observation où le sujet est âgé de 20 ans. Cornée plus grande qu’à l’ordinaire, pupille et cristallin de dimensions normales, mais décentrés en dedans. L’iris est tout strié de fentes de direction radiaire, et l’une de ces fentes, cédant sans doute à l’action traumatique, s’est élargie, forme un hiatus séparé de la pupille par le sphincter, allant jusqu’à l’insertion de l’iris, et laissant passer la lumière au travers du bord du cristallin et au travers de la zonule de Zinn, en dehors de ce bord."
                                            },
                                            {
                                                "example_id": "052d0c74-91e2-489c-b77d-8a845b1fbb15",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "Je t’étonne si je te dis que la bouffe est prise en charge par les muscles de l’œsophage – prononcer « ésophage », ne me demande pas pourquoi, prononce et ferme ta gueule – puis ceux – hyperpuissants de l’estomac, puis ceux de l’intestin, les « péristaltiques », puis enfin ceux, formidables, du trou du cul, qui sont un sphincter, retiens bien ce mot, on ne sait pas ce que l’avenir nous réserve."
                                            },
                                            {
                                                "example_id": "0f1a0e32-e392-4b8e-8a6c-e6f1a59a6154",
                                                "sense_id": "9f50b64c-3583-305f-9d49-342d3c84c1b0",
                                                "text": "... mon regard halluciné se fixait sur ce sphincter buccal qui ne cessait de s'ouvrir et de se refermer..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de17f5d8-378f-3421-84fa-2dbef88877a0",
                                        "entry_id": "214b528f-094a-3557-bc2e-d55de06111f5",
                                        "glosses": [
                                            "Anus."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66670acc-0896-4aa9-8a4e-1b097e26f277",
                                                "sense_id": "de17f5d8-378f-3421-84fa-2dbef88877a0",
                                                "text": "J’voudrais qu’tu m’mettes la misère\nJ’vais t’éclater le sphincter"
                                            },
                                            {
                                                "example_id": "32e3835e-434c-4221-aaf9-83dd5ccccb72",
                                                "sense_id": "de17f5d8-378f-3421-84fa-2dbef88877a0",
                                                "text": "Il considérait ce qui lui restait de semaines à vivre comme un sphincter puant dont il serait bientôt expulsé. La logeuse tirerait la chasse d’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
