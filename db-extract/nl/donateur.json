                                        "sense_id": "01ca231f-0e18-33cb-a255-28c42fd50fa8",
                                        "entry_id": "94a5c539-986e-3f39-8e50-8d3eb76dee7f",
                                        "glosses": [
                                            "Person/Organisation, die Mittel zur Unterstützung für jemand/etwas zur Verfügung stellt"
                                        ],
