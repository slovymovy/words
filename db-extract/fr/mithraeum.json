                "senses": [
                    {
                        "sense_id": "92c49fbc-693a-3fcc-aff0-86754d78c1c4",
                        "entry_id": "ce812757-55d7-3234-acde-66fdca34f1c9",
                        "glosses": [
                            "Sanctuaire, temple généralement souterrain, consacré au culte de Mithra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b27299c9-2a36-4f1c-a728-84c50dd57857",
                                "sense_id": "92c49fbc-693a-3fcc-aff0-86754d78c1c4",
                                "text": "Le sol, les murs, la voûte étaient formés de ce même cailloutis d’où suintait, par temps humide, un peu d’eau rougeâtre, ferrugineuse sans doute, comme j’en ai vu suinter sur les parois de petits mithraeums creusés par les soldats romains au nord de l’Angleterre, et souvent remblayés aussitôt que découverts par un archéologue local, si rien de précieux n’y avait été trouvé."
                            },
                            {
                                "example_id": "2d5a5960-a642-47c5-8d52-80da24ec97d0",
                                "sense_id": "92c49fbc-693a-3fcc-aff0-86754d78c1c4",
                                "text": "L’autre joyau de l’antique cité, c’est le mithraeum souterrain."
                            },
                            {
                                "example_id": "54da8730-72e3-49d2-b308-83d0bb873dff",
                                "sense_id": "92c49fbc-693a-3fcc-aff0-86754d78c1c4",
                                "text": "Cette découverte ouvre de nouvelles perspectives pour l’histoire d’Angers et le début de la christianisation au IVe siècle. Après Bordeaux, Strasbourg, Biesheim, Septeuil, Tirlmont (Belgique), Martigny (Suisse), Rome et Ostie, Angers s’inscrit désormais dans l’inventaire restreint des mithraea connus en Europe occidentale."
                            }
                        ]
                    }
