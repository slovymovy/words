                                "target_senses": [
                                    {
                                        "sense_id": "0cb67536-fecd-3b74-a49e-2ac66c896500",
                                        "entry_id": "1d18a496-b3b2-309d-bc0c-376079e8cba2",
                                        "glosses": [
                                            "Having a pleasing shape, pleasant to look at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f548b6a-38a9-49b3-920d-3abc963b98b8",
                                                "sense_id": "0cb67536-fecd-3b74-a49e-2ac66c896500",
                                                "text": "The more solicitous of the two was Nurse Cramer, a shapely, pretty, sexless girl with a wholesome unattractive face."
                                            },
                                            {
                                                "example_id": "4db7bb99-3009-4cd7-a669-c60fe5ed9021",
                                                "sense_id": "0cb67536-fecd-3b74-a49e-2ac66c896500",
                                                "text": "It used to be, whenever Frank passed a rival butcher’s window (and later the curved glass of a supermarket meat counter), he would peer in unjealously, looking for the subtleties that spoke of talent with a knife. Were their fillets shapely?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
