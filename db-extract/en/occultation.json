                                                "sense_id": "8213d481-28b4-300d-a44a-48214fd35ab1",
                                                "text": "Die Bedeckung letztes Jahr hat unsre Bestände verdoppelt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
