                        "source_sense_id": "92b69d71-5354-3228-bc78-2632a4acb033",
                        "target_lang_word": "малодушие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "малодушие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb159fc-823f-3f4d-a7ff-22fe33cf9064",
                                        "entry_id": "643a3b28-afe1-3cca-a171-f7391a19426e",
                                        "glosses": [
                                            "книжн. недостаток мужества, твёрдости духа, веры и решительности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ade66c-ab93-4d12-8b46-a97c685d27d1",
                                                "sense_id": "2cb159fc-823f-3f4d-a7ff-22fe33cf9064",
                                                "text": "Только теперь вижу ясно всю нелепость моего малодушия, теперь, как уж решился идти на этот ненужный стыд!"
                                            },
                                            {
                                                "example_id": "03fc61ba-0191-4d50-adad-7c722fb6dd18",
                                                "sense_id": "2cb159fc-823f-3f4d-a7ff-22fe33cf9064",
                                                "text": "Он говорил прекрасно, горячо, убедительно — о позоре малодушия и лени, о необходимости делать дело."
                                            },
                                            {
                                                "example_id": "378fa9df-2cce-40ef-b3e5-6096f0cd6580",
                                                "sense_id": "2cb159fc-823f-3f4d-a7ff-22fe33cf9064",
                                                "text": "Это даже уж не загадка, а какое-то колдовство, которое я назвал бы историческим, если б не боялся, чтоб этот эпитет не послужил прикрытием для всякого рода малодуший."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4d33b33-d3c7-4c33-a580-7a7032896260",
                        "source_entry_id": "57b09f38-08f1-3a0e-a23e-928934c509cb",
