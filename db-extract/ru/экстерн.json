                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c76f6142-7dd9-3a6a-b1c8-cf08a48c0afb",
                                        "entry_id": "0bf45988-029d-3896-9e5d-babc8d4e5b2c",
                                        "glosses": [
                                            "Écolier de collège ou de lycée qui n’est pas en pension et qui vient de dehors assister aux cours, aux leçons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62c6966-e19d-4b33-974e-1788090172f7",
                                                "sense_id": "c76f6142-7dd9-3a6a-b1c8-cf08a48c0afb",
                                                "text": "Quand il suivit un peu plus tard comme externe les classes du collège d'Arbois, il appartint tout d'abord à la catégorie des élèves que l'on pourrait appeler bons-ordinaires."
                                            },
                                            {
                                                "example_id": "e154bad2-c648-4b1b-85d5-be6aafb0ce34",
                                                "sense_id": "c76f6142-7dd9-3a6a-b1c8-cf08a48c0afb",
                                                "text": "La population scolaire n’était pas homogène. Il y avait les pensionnaires, les demi-pensionnaires, et les externes, qui constituaient vraiment une espèce très différente de la nôtre.\nLorsque Paul me demanda comment étaient ces externes, je lui répondis simplement :\n« Ce sont des élèves qui mettent tous les jours un costume du dimanche ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6353f17-f561-32bd-95f9-989c2f7fffa5",
                                        "entry_id": "0bf45988-029d-3896-9e5d-babc8d4e5b2c",
                                        "glosses": [
                                            "Élève d'une école d'enseignement supérieur qui n’est pas en pension et qui vient de dehors assister aux cours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497c7c9e-18ae-42ae-a904-e7607a4db0f9",
                                                "sense_id": "c6353f17-f561-32bd-95f9-989c2f7fffa5",
                                                "text": "Un peu plus jeune que moi, il était depuis un an à Normale, comme externe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "202d9529-f255-3e61-95fb-e42186e2c459",
