                        "glosses": [
                            "Que l’on peut déplacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e9be3d-67f1-4206-8c30-fd97adcb9458",
                                "sense_id": "4f64dc28-c01c-3e83-8a92-ba425bf3f060",
                                "text": "C’est une unité syntagmatique déplaçable et pouvant apparaître dans divers points de l’énoncé sans que cette mobilité ne modifie son rôle ou son acception."
                            },
                            {
                                "example_id": "84f48a51-5468-4657-8aa3-eb0e60c639f3",
                                "sense_id": "4f64dc28-c01c-3e83-8a92-ba425bf3f060",
                                "text": "Pour être déplaçable, la tiny house répond à des contraintes précises de taille et de poids, elle peut quand même avoir une ou deux mezzanines. Il faut que la maison puisse tenir sur une remorque et ne dépasse pas les 3,5 tonnes tout compris."
                            },
                            {
                                "example_id": "1b911fea-f4a4-4829-94f6-a7c606f2a526",
                                "sense_id": "4f64dc28-c01c-3e83-8a92-ba425bf3f060",
                                "text": "Faite d’aluminium et séparée en plusieurs morceaux, la structure du LAB/Mobile est facilement déplaçable afin de servir un maximum de jeunes Lavalloises et Lavallois, peu importe où ils habitent sur le territoire."
                            }
                        ]
                    }
