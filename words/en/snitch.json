{
    "word_family": [
        "snitch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35ed5a1b-b5ba-309d-974f-bc0b2250cde8",
                    "sense_definition": "A person who informs on others or betrays their group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang members did not trust him because they thought he was a <w>snitch</w>.",
                            "target_lang_translations": {
                                "fr": "Les membres du gang ne lui faisaient pas confiance car ils pensaient que c'était une <w>balance</w>."
                            }
                        },
                        {
                            "text": "Nobody likes a <w>snitch</w> who tells the teacher about every little mistake.",
                            "target_lang_translations": {
                                "fr": "Personne n'aime une <w>balance</w> qui rapporte chaque petite erreur au professeur."
                            }
                        }
                    ],
                    "synonyms": [
                        "grass",
                        "mole",
                        "quisling",
                        "rat",
                        "stool pigeon"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and derogatory term."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui dénonce les autres ou trahit son groupe."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "balance",
                                "target_lang_sense_clarification": "Terme familier et péjoratif pour désigner un dénonciateur."
                            },
                            {
                                "target_lang_word": "mouchard",
                                "target_lang_sense_clarification": "Terme familier pour une personne qui espionne ou dénonce."
                            },
                            {
                                "target_lang_word": "indic",
                                "target_lang_sense_clarification": "Abréviation familière pour un informateur de police."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb3b086-81e7-36e0-a76d-fcaba85913e7",
                    "sense_definition": "A person who steals things.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "thief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>snitch</w> was caught taking items from the shop.",
                            "target_lang_translations": {
                                "fr": "Le <w>voleur</w> du quartier a été pris en train de prendre des articles dans le magasin."
                            }
                        },
                        {
                            "text": "He was known as a petty <w>snitch</w> in the neighborhood.",
                            "target_lang_translations": {
                                "fr": "Il était connu comme un petit <w>voleur</w> dans le voisinage."
                            }
                        }
                    ],
                    "synonyms": [
                        "filcher",
                        "pincher"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for a thief."
                        }
