                "senses": [
                    {
                        "sense_id": "9868d4b7-9ce1-33b6-a171-0d4f3a2eca5b",
                        "entry_id": "edba5156-0d31-320a-88f3-0a3d5d3568f2",
                        "glosses": [
                            "de baas, chef, eigenaar, leermeester met name van bedrijven in de horeca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "275a0674-59e1-426f-9746-b77a89815478",
                                "sense_id": "9868d4b7-9ce1-33b6-a171-0d4f3a2eca5b",
                                "text": "De naam van Het Koetshuis werd gevestigd door maître Fred Bohnke, die er jarenlang de scepter zwaaide. De laatste jaren werd de zaak gerund door chef kok John Spruit en zijn echtgenote Wendy."
                            },
                            {
                                "example_id": "278617aa-da96-4f0d-8831-a95ee963b924",
                                "sense_id": "9868d4b7-9ce1-33b6-a171-0d4f3a2eca5b",
                                "text": "Restaurant Carelshaven stelt Debbie Küpers vanaf 1 januari aan als nieuwe maître-sommelier. Küpers verruilt na tien jaar Landhuishotel & Restaurant De Bloemenbeek in De Lutte voor het Deldense restaurant."
                            },
                            {
                                "example_id": "4879b746-78f7-49d7-9a19-f531c2c33386",
                                "sense_id": "9868d4b7-9ce1-33b6-a171-0d4f3a2eca5b",
                                "text": "Presentatrice Bridget Maasland en voormalig televisiepresentator Willibrord Frequin zijn als laatste geëindigd. Verder deden SP-fractievoorzitter Lilian Marijnissen, First Dates-maître Sergio Vyent en schrijfster Heleen van Royen mee."
                            }
                        ]
                    }
