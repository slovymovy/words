{
    "word_family": [
        "engagement",
        "engaging",
        "disengage",
        "re-engage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0f30955-0cc3-3b86-a111-337b1e597738",
                    "sense_definition": "To participate or become involved in a conversation or social interaction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>engage</w> him in conversation when he is focused on his work.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>вовлечь</w> его в разговор, когда он сосредоточен на работе.",
                                "zh": "当他专注于工作时，通常很难让他<w>参与</w>对话。"
                            }
                        },
                        {
                            "text": "The politician refused to <w>engage</w> with the protesters regarding the new policy.",
                            "target_lang_translations": {
                                "ru": "Политик отказался <w>вступать в диалог</w> с протестующими по поводу новой политики.",
                                "zh": "那位政客拒绝就新政策与抗议者<w>对话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interact",
                        "participate",
                        "converse"
                    ],
                    "common_phrases": [
                        "engage in conversation",
                        "engage with someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать или вовлекаться в разговор или социальное взаимодействие.",
                        "zh": "参与或卷入对话或社交互动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовлекать",
                                "target_lang_sense_clarification": "в разговор или деятельность"
                            },
                            {
                                "target_lang_word": "вступать",
                                "target_lang_sense_clarification": "в диалог или контакт"
                            },
                            {
                                "target_lang_word": "взаимодействовать",
                                "target_lang_sense_clarification": "с кем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参与",
                                "target_lang_sense_clarification": "加入对话或活动"
                            },
                            {
                                "target_lang_word": "交谈",
                                "target_lang_sense_clarification": "与某人进行对话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d3fac60-5cb5-3185-a08e-8197e8346afd",
                    "sense_definition": "To attract and hold someone's attention or interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher tried to <w>engage</w> the students with a hands-on science experiment.",
                            "target_lang_translations": {
                                "ru": "Учитель старался <w>заинтересовать</w> учеников практическим научным экспериментом.",
                                "zh": "老师试图通过实践科学实验来<w>吸引</w>学生。"
                            }
                        },
                        {
                            "text": "A good book should <w>engage</w> the reader from the very first page.",
                            "target_lang_translations": {
                                "ru": "Хорошая книга должна <w>увлекать</w> читателя с самой первой страницы.",
                                "zh": "一本好书应该从第一页起就<w>吸引</w>读者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "engross",
                        "captivate",
                        "interest",
                        "occupy"
                    ],
                    "common_phrases": [
                        "engage the audience",
                        "engage the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать и удерживать чье-либо внимание или интерес.",
                        "zh": "吸引并保持某人的注意力或兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заинтересовывать",
                                "target_lang_sense_clarification": "привлекать внимание"
                            },
                            {
                                "target_lang_word": "увлекать",
                                "target_lang_sense_clarification": "занимать чье-то внимание"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "ум или время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "引起兴趣"
                            },
                            {
                                "target_lang_word": "使……着迷",
                                "target_lang_sense_clarification": "保持注意力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e31938ff-0afb-3b37-ae7d-f89a944f70c8",
                    "sense_definition": "To promise to marry someone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to get <w>engaged</w> after dating for three years.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обручиться</w> после трех лет отношений.",
                                "zh": "他们约会三年后决定<w>订婚</w>。"
                            }
                        },
                        {
                            "text": "He asked her to marry him and they became <w>engaged</w> on Christmas Eve.",
                            "target_lang_translations": {
                                "ru": "Он попросил её выйти за него замуж, и в канун Рождества они <w>помолвились</w>.",
                                "zh": "他向她求婚，他们在平安夜<w>订婚</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "betroth",
                        "affiance"
                    ],
                    "common_phrases": [
                        "get engaged",
                        "become engaged"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in passive or as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обещать вступить в брак с кем-либо.",
                        "zh": "承诺与某人结婚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обручиться",
                                "target_lang_sense_clarification": "договориться о свадьбе"
                            },
                            {
                                "target_lang_word": "помолвиться",
                                "target_lang_sense_clarification": "стать женихом и невестой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "订婚",
                                "target_lang_sense_clarification": "约定结婚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26bb4e60-b84e-3bc5-a151-00f28b8d50e9",
                    "sense_definition": "To arrange to employ someone or use a service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>engage</w> a consultant to help with the restructuring.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>нанять</w> консультанта, чтобы помочь с реструктуризацией.",
                                "zh": "公司决定<w>聘请</w>一位顾问来协助重组。"
                            }
                        },
                        {
                            "text": "We need to <w>engage</w> the services of a lawyer before signing the contract.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>воспользоваться</w> услугами адвоката перед подписанием контракта.",
                                "zh": "在签署合同之前，我们需要<w>聘请</w>一位律师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hire",
                        "employ",
                        "retain"
                    ],
                    "common_phrases": [
                        "engage the services",
                        "engage a lawyer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Договориться о найме кого-либо или использовании услуги.",
                        "zh": "安排雇佣某人或使用某项服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нанимать",
                                "target_lang_sense_clarification": "сотрудника или специалиста"
                            },
                            {
                                "target_lang_word": "привлекать",
                                "target_lang_sense_clarification": "к работе или услугам"
                            },
                            {
                                "target_lang_word": "задействовать",
                                "target_lang_sense_clarification": "службы или ресурсы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聘请",
                                "target_lang_sense_clarification": "雇佣专业人员"
                            },
                            {
                                "target_lang_word": "使用",
                                "target_lang_sense_clarification": "雇佣服务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d506cf5b-8c57-3a70-8707-eca4fc97f7b0",
                    "sense_definition": "To cause parts of a machine to fit together and move together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>engage</w> the clutch slowly to avoid stalling the engine.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>включать</w> сцепление медленно, чтобы двигатель не заглох.",
                                "zh": "你必须缓慢地<w>接合</w>离合器，以免发动机熄火。"
                            }
                        },
                        {
                            "text": "The gears will <w>engage</w> once you move the lever to the forward position.",
                            "target_lang_translations": {
                                "ru": "Шестерни <w>войдут в зацепление</w>, как только вы переведете рычаг в переднее положение.",
                                "zh": "一旦你将操纵杆移到前进位置，齿轮就会<w>接合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mesh",
                        "interlock",
                        "connect"
                    ],
                    "antonyms": [
                        "disengage"
                    ],
                    "common_phrases": [
                        "engage the clutch",
                        "engage the gears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить части механизма в зацепление для совместного движения.",
                        "zh": "使机器部件啮合在一起并共同运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "сцепление или механизм"
                            },
                            {
                                "target_lang_word": "входить в зацепление",
                                "target_lang_sense_clarification": "о шестернях"
                            },
                            {
                                "target_lang_word": "зацеплять",
                                "target_lang_sense_clarification": "механически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接合",
                                "target_lang_sense_clarification": "使机械部件连接"
                            },
                            {
                                "target_lang_word": "挂上",
                                "target_lang_sense_clarification": "指档位或离合器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c53833c0-001e-32d4-b998-3611f89d1670",
                    "sense_definition": "To enter into a fight or battle with an enemy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naval fleet was ordered to <w>engage</w> the enemy at dawn.",
                            "target_lang_translations": {
                                "ru": "Флоту был дан приказ <w>вступить в бой</w> с противником на рассвете.",
                                "zh": "海军舰队奉命在黎明时分与敌人<w>交战</w>。"
                            }
                        },
                        {
                            "text": "The soldiers were told not to <w>engage</w> unless they were fired upon first.",
                            "target_lang_translations": {
                                "ru": "Солдатам велели не <w>вступать в сражение</w>, если по ним не откроют огонь первыми.",
                                "zh": "士兵们被告知，除非先遭到射击，否则不要<w>交战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "combat",
                        "confront"
                    ],
                    "common_phrases": [
                        "engage the enemy",
                        "engage in battle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в бой или сражение с противником.",
                        "zh": "与敌人进行战斗或交战。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступать в бой",
                                "target_lang_sense_clarification": "с противником"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "вступать в сражение"
                            },
                            {
                                "target_lang_word": "завязывать бой",
                                "target_lang_sense_clarification": "начинать сражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交战",
                                "target_lang_sense_clarification": "与敌方战斗"
                            },
                            {
                                "target_lang_word": "开战",
                                "target_lang_sense_clarification": "开始战斗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b014a1-f8dc-3892-9581-4a8616c38b4c",
                    "sense_definition": "To formally promise or guarantee to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor will <w>engage</w> to complete the project by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Подрядчик <w>обязуется</w> завершить проект до конца года.",
                                "zh": "承包商<w>承诺</w>在年底前完成该项目。"
                            }
                        },
                        {
                            "text": "He would not <w>engage</w> himself to any specific timeline without further data.",
                            "target_lang_translations": {
                                "ru": "Он не стал <w>связывать себя обязательствами</w> по конкретным срокам без дополнительных данных.",
                                "zh": "在没有更多数据的情况下，他不会<w>承诺</w>任何具体的时间表。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promise",
                        "undertake",
                        "guarantee",
                        "pledge"
                    ],
                    "common_phrases": [
                        "engage to do"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально обещать или гарантировать выполнение чего-либо.",
                        "zh": "正式承诺或保证做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязываться",
                                "target_lang_sense_clarification": "взять на себя обязательство"
                            },
                            {
                                "target_lang_word": "гарантировать",
                                "target_lang_sense_clarification": "выполнение работ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承诺",
                                "target_lang_sense_clarification": "正式保证"
                            },
                            {
                                "target_lang_word": "承担",
                                "target_lang_sense_clarification": "承担义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27bb2e34-ce82-3b5f-98a6-b530ca93c59f",
                    "sense_definition": "To pledge or pawn property as security for a debt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In desperate times, he had to <w>engage</w> his family lands to pay off the debt.",
                            "target_lang_translations": {
                                "ru": "В отчаянные времена ему пришлось <w>заложить</w> семейные земли, чтобы выплатить долг.",
                                "zh": "在绝望的时候，他不得不<w>抵押</w>家里的土地来偿还债务。"
                            }
                        },
                        {
                            "text": "The merchant was forced to <w>engage</w> his remaining stock to secure the loan.",
                            "target_lang_translations": {
                                "ru": "Купец был вынужден <w>отдать в залог</w> оставшийся товар, чтобы обеспечить кредит.",
                                "zh": "商人被迫<w>抵押</w>他剩余的库存以获得贷款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pawn",
                        "mortgage",
                        "pledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заложить имущество в качестве обеспечения долга.",
                        "zh": "将财产作为债务担保进行抵押。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "имущество под залог"
                            },
                            {
                                "target_lang_word": "отдавать в залог",
                                "target_lang_sense_clarification": "для обеспечения кредита"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵押",
                                "target_lang_sense_clarification": "以财产作担保"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}