                    {
                        "translation_id": "52e0a472-661f-4533-b38f-d0b5284933c1",
                        "source_entry_id": "2404547e-2a7c-3c48-8257-efd7e1669827",
                        "source_sense_id": "d499510e-6e03-31f1-9f6e-298176dd631d",
                        "source_sense_description": "care of women during and after pregnancy",
