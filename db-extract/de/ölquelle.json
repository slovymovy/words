                        "examples": [
                            {
                                "example_id": "3da5b5b2-0806-419c-9c69-41b9d2c0e16a",
                                "sense_id": "2c2a15ca-4827-3492-b3ab-ff46c990965d",
                                "text": "In der in Alaska entdeckten Ölquelle warten 300 Millionen Barrel Erdöl darauf, gefördert zu werden."
                            },
                            {
                                "example_id": "dde1c606-a5fc-4d76-958a-9d8161c5b48c",
                                "sense_id": "2c2a15ca-4827-3492-b3ab-ff46c990965d",
                                "text": "Nachdem die Ölquelle versiegte, stieg die Arbeitslosigkeit in dem Dorf auf das Doppelte."
                            }
                        ],
