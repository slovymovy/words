                "senses": [
                    {
                        "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                        "entry_id": "b6032a47-f26c-3afe-b7d7-b892cbe398c8",
                        "glosses": [
                            "großer Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ded0bda-951c-4b2e-a89c-796d1cedd34a",
                                "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                                "text": "„Denn über den starken Dneprstrom zu schwimmen, das wäre, glaube ich, für die meisten Soldaten Selbstmord gewesen.“"
                            },
                            {
                                "example_id": "36fc39ce-7fa8-4b29-b123-1382bc8a5deb",
                                "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                                "text": "„In einem Kloster, unweit der Hauptstadt Kiew am Dneprstrom, beginnt eine wundersame Erdhöhle.“"
                            },
                            {
                                "example_id": "7ce8926e-c119-4dab-90dc-1f9b18bcc7a0",
                                "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                                "text": "„Gegen Westen erblickt man ein Stück von Polen und Litthauen, und den die Gränze bestimmten Dneprstrom.“"
                            },
                            {
                                "example_id": "f95be396-2e04-4b20-a410-21dc8076dfff",
                                "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                                "text": "„Das sind die Saporoger Kosaken, die ungebärdigen, unbesiegbaren Grenzreiter, die als Freie auf dem Hohen Ufer am Dneprstrom angesiedelt sind, dem Setsch.“"
                            },
                            {
                                "example_id": "1e300194-e24f-4bec-9202-570dbdb5db59",
                                "sense_id": "1bd8427d-5196-35d0-90d0-cf96cc398877",
                                "text": "„Der Erste ging bis Oleschki (Gouvern. Taurien) der Letzte wahrscheinlich den Dneprstrom hinab bis zu den Mündungen des Dnestr und der Donau und hatte seinen Namen daher, daß er sich durch das schilfige Mündungsland dieser beiden Flüsse hinzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
