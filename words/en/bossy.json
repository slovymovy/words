{
    "word_family": [
        "boss",
        "bossiness",
        "bossily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cb1bf239-a63a-3548-9916-115bdececa9e",
                    "sense_definition": "Tending to give orders to others or tell people what to do; domineering.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "domineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody liked working with him because he was always so <w>bossy</w> and impatient.",
                            "target_lang_translations": {
                                "es": "A nadie le gustaba trabajar con él porque siempre era muy <w>mandón</w> e impaciente."
                            }
                        },
                        {
                            "text": "Stop being so <w>bossy</w> and let someone else make a decision for once.",
                            "target_lang_translations": {
                                "es": "Deja de ser tan <w>mandón</w> y permite que otra persona tome una decisión por una vez."
                            }
                        }
                    ],
                    "synonyms": [
                        "controlling",
                        "domineering",
                        "overbearing"
                    ],
                    "antonyms": [
                        "humble",
                        "servile"
                    ],
                    "common_phrases": [
                        "bossy boots",
                        "too bossy"
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiende a dar órdenes a los demás o a decirles qué hacer; autoritario o dominante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mandón",
                                "target_lang_sense_clarification": "persona que le gusta dar órdenes"
                            },
                            {
                                "target_lang_word": "autoritario",
                                "target_lang_sense_clarification": "que impone su autoridad"
                            },
                            {
                                "target_lang_word": "dominante",
                                "target_lang_sense_clarification": "que busca controlar a los demás"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "685e5598-3e22-3fd2-ad8b-ec61671a94fb",
                    "sense_definition": "Ornamented with raised decorative studs or knobs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "studded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warrior carried a large, <w>bossy</w> shield reinforced with heavy iron knobs.",
                            "target_lang_translations": {
                                "es": "El guerrero llevaba un gran escudo <w>tachonado</w>, reforzado con pesados remaches de hierro."
                            }
                        },
                        {
                            "text": "Antique chests were often decorated with <w>bossy</w> patterns of hammered metal.",
                            "target_lang_translations": {
                                "es": "Los baúles antiguos a menudo se decoraban con patrones <w>en relieve</w> de metal martillado."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Ornamentado con tachones, relieves o protuberancias decorativas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tachonado",
                                "target_lang_sense_clarification": "adornado con clavos o tachones"
                            },
                            {
                                "target_lang_word": "repujado",
                                "target_lang_sense_clarification": "con relieves decorativos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5f361f8-b9d5-34ec-8079-ffd7d3cd6f3d",
                    "sense_definition": "A cow or a calf, especially when addressed affectionately.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer called the little <w>bossy</w> back into the barn before sunset.",
                            "target_lang_translations": {
                                "es": "El granjero llamó a la pequeña <w>vaquita</w> para que regresara al establo antes del atardecer."
                            }
                        },
                        {
                            "text": "He offered fresh hay to the gentle <w>bossy</w> resting in the pasture.",
                            "target_lang_translations": {
                                "es": "Le ofreció heno fresco a la dócil <w>vaca</w> que descansaba en el pasto."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used chiefly in rural or informal dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Vaca o ternero, especialmente cuando se le llama de forma cariñosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vaquita",
                                "target_lang_sense_clarification": "apelativo cariñoso para una vaca"
                            },
                            {
                                "target_lang_word": "ternerito",
                                "target_lang_sense_clarification": "cría de la vaca usada afectuosamente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}