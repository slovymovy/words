                "senses": [
                    {
                        "sense_id": "9d789de8-2d99-3461-b28d-023b02da6cdb",
                        "entry_id": "27157bf1-250b-31f7-bb01-86ad1fe8cbd8",
                        "glosses": [
                            "Débarrasser des charançons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9004c1-dfc4-4549-9a63-19d3d07c3798",
                                "sense_id": "9d789de8-2d99-3461-b28d-023b02da6cdb",
                                "text": "Les expériences de G. Bertrand, pour décharançonner de grands stocks de blé, ont été concluantes."
                            },
                            {
                                "example_id": "2ade0501-0c59-41da-8959-82cb6cdef726",
                                "sense_id": "9d789de8-2d99-3461-b28d-023b02da6cdb",
                                "text": "Les chances du malheureux demeuraient entières — ou presque nulles, s'il refusait, une dernière fois, de se décharançonner l'âme."
                            },
                            {
                                "example_id": "7cfb36b2-88f5-46f3-a5ab-d79a27731d6b",
                                "sense_id": "9d789de8-2d99-3461-b28d-023b02da6cdb",
                                "text": "Il arrivait aussi qu’assemblées à plusieurs pour décharançonner les haricots ou tricoter les grands bas de laine noire, elles priaient à haute voix en alternant les répons, cela faisait un doux ronron qui les reposait."
                            }
                        ]
                    }
