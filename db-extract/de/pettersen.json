                ],
                "senses": [
                    {
                        "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                        "entry_id": "723d7723-e6a2-37bf-b03b-7c8d3f1b2342",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045aebbb-c3df-4286-bfcd-a0ac8280dd6a",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Frau Pettersen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5597a054-e556-4982-b300-548f7c35bfd2",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Herr Pettersen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "60849969-e082-4652-a160-2e70ae44e626",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Die Pettersens kommen heute aus Kiel."
                            },
                            {
                                "example_id": "1315b6e9-e04a-4904-b6df-795d934cca7f",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Der Pettersen trägt nie die Schals, die die Pettersen ihm strickt."
                            },
                            {
                                "example_id": "fcfe95bd-3899-446e-8978-4b0b0ac4fa3d",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pettersen kommt, geht der Herr Pettersen.“"
                            },
                            {
                                "example_id": "ec7ca11f-3a4e-4601-9ee1-75a8f75acb31",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Pettersen kommt und geht."
                            },
                            {
                                "example_id": "9b732b8e-069e-4d7b-ad46-41c374bf9934",
                                "sense_id": "e1912d65-2a9d-3aa9-ae1e-8594b13fd26e",
                                "text": "Pettersens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
