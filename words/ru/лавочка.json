                                "target_lang_sense_clarification": "siège de jardin ou de rue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c293ed5e-5e3e-3c7a-95f1-8888cefb94d0",
                    "sense_definition": "Небольшой торговый магазин или киоск.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой сувенирной <w>лавочке</w> продаются очень красивые открытки и подарки ручной работы.",
                            "target_lang_translations": {
                                "en": "This souvenir <w>shop</w> sells very beautiful postcards and handmade gifts.",
                                "es": "En esta <w>tiendecita</w> de recuerdos se venden tarjetas postales muy bonitas y regalos hechos a mano.",
                                "fr": "Dans cette <w>boutique</w> de souvenirs, on vend de très belles cartes postales et des cadeaux faits main."
                            }
                        },
                        {
                            "text": "Мы зашли в маленькую продуктовую <w>лавочку</w>, чтобы купить свежего хлеба и молока к завтраку.",
                            "target_lang_translations": {
                                "en": "We went into a small grocery <w>store</w> to buy fresh bread and milk for breakfast.",
                                "es": "Entramos en una pequeña <w>tiendita</w> de comestibles para comprar pan fresco y leche para el desayuno.",
                                "fr": "Nous sommes entrés dans une petite <w>échoppe</w> d'alimentation pour acheter du pain frais et du lait pour le petit-déjeuner."
                            }
                        }
                    ],
                    "synonyms": [
                        "магазинчик"
                    ],
                    "common_phrases": [
                        "сувенирная лавочка",
                        "продуктовая лавочка"
                    ],
                    "traits": [
