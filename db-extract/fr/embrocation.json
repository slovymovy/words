        "fr-extract.jsonl": [
            {
                "entry_id": "0bb5daa3-5b8b-311e-bf24-8f25c9fb690b",
                "word": "embrocation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9de96b68-9fc9-4fdd-bcf9-ca737cb3f4ec",
                        "entry_id": "0bb5daa3-5b8b-311e-bf24-8f25c9fb690b",
                        "tags": [
                            "plural"
                        ],
                        "form": "embrocations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5597b8a4-89a1-32bc-ab8d-79a194478852",
                        "entry_id": "0bb5daa3-5b8b-311e-bf24-8f25c9fb690b",
                        "glosses": [
                            "Fomentation faite, sur une partie malade avec un liquide gras, huileux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafb868a-bc19-4bfc-8dff-2afd56d301a0",
                                "sense_id": "5597b8a4-89a1-32bc-ab8d-79a194478852",
                                "text": "On nous juchait au-dessus de la voiture, mon frère et moi et nous revenions ainsi au village. À l’odeur du foin se mêlait celle de l’embrocation phéniquée dont on avait frotté le cheval."
                            },
                            {
                                "example_id": "9402e96e-5789-4998-b2ab-df2b5427505d",
                                "sense_id": "5597b8a4-89a1-32bc-ab8d-79a194478852",
                                "text": "Ils étaient plus de vingt, assis sur des bancs de bois blanc, dans la grande salle carrelée, remplie des odeurs fortes de terre, d’embrocations et de chaleur animale."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c05eba7-53eb-38dd-96f2-3ae7d6ed4c03",
                        "entry_id": "0bb5daa3-5b8b-311e-bf24-8f25c9fb690b",
                        "glosses": [
                            "Liquide lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d43ebf-be74-4f43-a35e-f409dd4568e4",
                                "sense_id": "2c05eba7-53eb-38dd-96f2-3ae7d6ed4c03",
                                "text": "Pas du tout le remugle de sueur et d’embrocation qui imprègne la sciure du gymnase, et commence singulièrement à le débecter."
                            },
                            {
                                "example_id": "4c9b24c9-c93e-4baf-bab1-522c4bbf020b",
                                "sense_id": "2c05eba7-53eb-38dd-96f2-3ae7d6ed4c03",
                                "text": "Cela sentait la fauverie, l’embrocation et la caoutchouc chaud."
                            },
                            {
                                "example_id": "f10447f9-72e4-418b-afe9-6ce719bff0fb",
                                "sense_id": "2c05eba7-53eb-38dd-96f2-3ae7d6ed4c03",
                                "text": "Elle lui a monté une bouteille d’embrocation de sa fabrication."
                            }
                        ]
                    }
                ],
