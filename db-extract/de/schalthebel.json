                    }
                ],
                "senses": [
                    {
                        "sense_id": "fee2e5ef-438a-3343-8fa4-1079efd82d8e",
                        "entry_id": "28542c39-1c91-39cc-a42d-82d00513a7cc",
                        "glosses": [
                            "stangenförmiges Gerät, mit dem eine Schaltung bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6679d17-5fae-42dc-a916-54ac1ae4982a",
                                "sense_id": "fee2e5ef-438a-3343-8fa4-1079efd82d8e",
                                "text": "Um die Maschine zu starten, muss man nur den Schalthebel umlegen."
                            },
                            {
                                "example_id": "0862420e-cbdf-492c-bad0-0b2fcb27dfa8",
                                "sense_id": "fee2e5ef-438a-3343-8fa4-1079efd82d8e",
                                "text": "„Die wenigen Frauen und Mädchen hantierten unter der Aufsicht des Saalmeisters an den Schalthebeln, durch die der Gang der verschiedenen Walzmaschinen und Trichtermühlen ferngesteuert und das Tempo besonders geregelt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10d41dd9-ad40-3b13-9e1f-9edd61b8aa54",
                        "entry_id": "28542c39-1c91-39cc-a42d-82d00513a7cc",
                        "glosses": [
                            "stangenförmiges Gerät, mit dem eine Gangschaltung an einem Fahrzeug bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a175188d-b909-4810-b4e5-7ca3aff5284d",
                                "sense_id": "10d41dd9-ad40-3b13-9e1f-9edd61b8aa54",
                                "text": "„Aus der Mitte der Fahrerkabine schraubte sich der silberfarbene Schalthebel wie ein gebogener Schwanenhals in die Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ef47bab4-0dac-3335-b857-17114f0bd9cf",
                        "entry_id": "28542c39-1c91-39cc-a42d-82d00513a7cc",
                        "glosses": [
                            "Stelle, an der Entscheidungen gefällt werden"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "22e5ad06-758c-4223-a08f-07759cc8a876",
                                "sense_id": "ef47bab4-0dac-3335-b857-17114f0bd9cf",
                                "text": "Er sitzt seit seiner Wahl an den Schalthebeln der Macht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
