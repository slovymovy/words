{
    "word_family": [
        "aggress",
        "aggressive",
        "aggressively",
        "aggressiveness",
        "aggressor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd8fbe4c-0c63-353b-a5b4-7849ffb02804",
                    "sense_definition": "Hostile or destructive behavior or actions, often reflecting a person's feelings of anger or a desire to dominate.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was penalized for showing unnecessary <w>aggression</w> toward his opponent during the match.",
                            "target_lang_translations": {
                                "ru": "Спортсмен был наказан за проявление излишней <w>агрессии</w> по отношению к сопернику во время матча."
                            }
                        },
                        {
                            "text": "Parents are often concerned when they notice signs of unprovoked <w>aggression</w> in their young children.",
                            "target_lang_translations": {
                                "ru": "Родители часто беспокоятся, когда замечают признаки неспровоцированной <w>агрессии</w> у своих маленьких детей."
                            }
                        }
                    ],
                    "synonyms": [
                        "hostility",
                        "belligerence"
                    ],
                    "common_phrases": [
                        "unprovoked aggression",
                        "show aggression",
                        "physical aggression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебное или деструктивное поведение или действия, часто отражающие гнев или желание доминировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агрессия",
                                "target_lang_sense_clarification": "враждебное поведение или вспышки гнева"
                            },
                            {
                                "target_lang_word": "агрессивность",
                                "target_lang_sense_clarification": "черта характера или склонность к нападению"
                            },
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "неприязненное отношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deda7de9-01fc-382f-a196-1da95163a623",
                    "sense_definition": "The act of initiating hostilities, invasion, or an unprovoked attack by one country against another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community condemned the military <w>aggression</w> against the neighboring sovereign state.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество осудило военную <w>агрессию</w> против соседнего суверенного государства."
                            }
                        },
                        {
                            "text": "The treaty was designed to protect smaller nations from an act of <w>aggression</w> by larger powers.",
                            "target_lang_translations": {
                                "ru": "Договор был призван защитить малые народы от акта <w>агрессии</w> со стороны крупных держав."
                            }
                        }
                    ],
                    "synonyms": [
                        "invasion",
                        "assault",
                        "offense"
                    ],
                    "antonyms": [
                        "nonaggression"
                    ],
                    "common_phrases": [
                        "act of aggression",
                        "military aggression",
                        "foreign aggression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт начала военных действий, вторжения или неспровоцированного нападения одного государства на другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агрессия",
                                "target_lang_sense_clarification": "вооруженное нападение государства"
                            },
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "силовое действие против кого-либо"
                            },
                            {
                                "target_lang_word": "вторжение",
                                "target_lang_sense_clarification": "вступление войск на чужую территорию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}