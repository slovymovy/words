                        ]
                    },
                    {
                        "translation_id": "dc443862-b191-45e4-b620-40b71c6ea245",
                        "source_entry_id": "716e019c-72de-3e89-843c-93e56ae9f485",
                        "target_lang_word": "chartreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chartreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfe1933-abcf-3c8b-92d0-b861ef6ee15e",
                                        "entry_id": "069c2c70-73cf-3593-ba4c-9bf1d51c90ab",
                                        "glosses": [
                                            "Religieux de l’ordre de Saint-Bruno."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a90600aa-47d0-443b-947a-8cd9924dec0c",
                                                "sense_id": "1cfe1933-abcf-3c8b-92d0-b861ef6ee15e",
                                                "text": "Le cimetière est ombragé par deux ou trois grands cyprès, comme il y a dans les cimetières turcs : cet enclos funèbre contient quatre cent dix-neuf chartreux morts depuis la construction du couvent ; une herbe épaisse et touffue couvre ce terrain, où l’on ne voit ni tombe, ni croix, ni inscription ; ils gisent là confusément, humbles dans la mort comme ils l’ont été dans la vie."
                                            },
                                            {
                                                "example_id": "9c4d5863-70ac-4728-8905-1f2fa7943026",
                                                "sense_id": "1cfe1933-abcf-3c8b-92d0-b861ef6ee15e",
                                                "text": "— Vous travaillez donc toujours ? reprit-elle… Du reste, on m’a dit que vous viviez en vrai chartreux… Le fait est qu’on ne vous aperçoit nulle part, monsieur Mintié."
                                            },
                                            {
                                                "example_id": "6ceaf4a1-9c5e-4056-9efe-585c085fd8d4",
                                                "sense_id": "1cfe1933-abcf-3c8b-92d0-b861ef6ee15e",
                                                "text": "Monsieur de C. de M. préside presque toujours au dîner. Pour autant qu’on y parle, on y parle donc français. Mais un silence de chartreux règne d’ordinaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chartreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfaa4a95-f92c-3575-8aa5-9c9e80993874",
                                        "entry_id": "2f18240a-4998-3ff1-ba1f-d9b68c3c3e34",
                                        "glosses": [
                                            "Race de chat, à queue moyenne, à poil court à mi-long, à robe gris-bleu, et aux yeux de cuivre ou orangé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738ad323-0c2c-426a-a9cf-da85648d51ca",
                                                "sense_id": "cfaa4a95-f92c-3575-8aa5-9c9e80993874",
                                                "text": "Le chartreux serait originaire de Turquie et d’Iran et aurait été ramené en France au temps des croisades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chartreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20dee3b1-6ac6-3cf1-af6f-e35e2727ce4f",
                                        "entry_id": "baa6d72d-04c1-3d85-81b1-f1aff422105b",
                                        "glosses": [
                                            "D’un gris avec des reflets bleus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5829cf-b3f3-4f3f-bad0-608200496d07",
                                                "sense_id": "20dee3b1-6ac6-3cf1-af6f-e35e2727ce4f",
                                                "text": "Quand on aura voilé de drap tous les miroirs, tes roses dans l’éclatement du soir mettront des trous de pourpre et des arrachements de giclure mauve à la lumière du ciel. Les camions, les autos, les flancs et les toits des caravanes s’effaceront à leur tour sous la teinture chartreuse et les vapeurs dorées que transpirent ces terrains en friches, frappés de mesures d’expulsions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chartreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b1fb7b0-9847-3be0-946c-0c5344656cd4",
                                        "entry_id": "65ab6495-d6ed-3d8c-9b54-e6ef4120323e",
                                        "glosses": [
                                            "Qui concerne l’ordre des Chartreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b6b9b6-72d0-4d79-8f8e-8aec851528cd",
                                                "sense_id": "0b1fb7b0-9847-3be0-946c-0c5344656cd4",
                                                "text": "On peut citer encore la fondation d’une autre fraternité, au cours de cette même période des années 1970 : la famille monastique de Bethléem et de l’Assomption de la Vierge, directement inspirée de la tradition chartreuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e2ea645-e8e0-4d03-a0a1-4835e386181a",
                        "source_entry_id": "716e019c-72de-3e89-843c-93e56ae9f485",
                        "target_lang_word": "kartuizer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kartuizer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                                        "glosses": [
                                            "kloosterling van de strenge contemplatieve orde van Sint-Bruno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0e9423-5dd3-4b92-ae11-3612468932ba",
                                                "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                                                "text": "Eenzaamheid en rust tekenen de kloosterorde van de kartuizers."
                                            },
                                            {
                                                "example_id": "7b6ec5e5-ccf4-4112-8022-3d8e3741f2b2",
                                                "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                                                "text": "Het resultaat is een documentaire die volgens de publiciteitscampagne „een meditatie over het leven” is. We hoeven niet te weten wie kartuizers zijn. We moeten ons gedurende die drie uur zelf een beetje kartuizer gaan voelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feb9e223-5d28-363e-b13c-2d572c5b1edf",
                                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                                        "glosses": [
                                            "ras van mollige huiskatten met een kortharige, blauwgrijze vacht, felle, oranjegele ogen en een vrij grote ronde kop met kleine oren\\nKartuizers zijn goede muizenvangers en prettige gezelschapsdieren."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d288778c-068c-4b65-888b-8662b7000c84",
                                                "sense_id": "feb9e223-5d28-363e-b13c-2d572c5b1edf",
                                                "text": "Snel wijdde hij enkele rituele lofzangen aan haar, passend bij de karakteristieke gratie en deugden van een kat van het ras der kartuizers, klein en volmaakt. “Mijn beertje met dikke wangetjes... Fijn-fijn-fijn poesje... Mijn blauw duifje... Parelkleurig duiveltje.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "654640a9-3b2f-39be-b62d-c171bf15d7ba",
                                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                                        "glosses": [
                                            "ras van dressuurpaarden uit Andalusië"
                                        ],
                                        "tags": [
                                            "paardrijden"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c0d89a0-bf75-39bc-a1ec-71406ed52b64",
                                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                                        "glosses": [
                                            "korte benaming voor Dianthus carthusianorum"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kartuizer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd16538-8a12-393d-913e-e3bd61b414a0",
                                        "entry_id": "2b5846cf-8ceb-3aeb-99e4-18f41112ed5b",
                                        "glosses": [
                                            "van de kartuizers"
                                        ],
