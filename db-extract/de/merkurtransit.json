                "senses": [
                    {
                        "sense_id": "17df3907-9b6c-3146-94f8-f2c61f0d7df7",
                        "entry_id": "83531bcb-368b-3680-9858-2823d2627ba0",
                        "glosses": [
                            "Durchgang des Planeten Merkur vor der Sonnenscheibe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a2f911-dffb-4402-923b-8458f154d121",
                                "sense_id": "17df3907-9b6c-3146-94f8-f2c61f0d7df7",
                                "text": "„1629 gelang es Johannes Kepler, mithilfe von Beobachtungsdaten seines Vorgängers Tycho Brahe, erstmals einen sogenannten Merkurtransit für den 7. November 1631 (auf etwa einen halben Tag genau) vorherzusagen.“"
                            },
                            {
                                "example_id": "7a4bc655-f085-4af6-9466-d5b527594367",
                                "sense_id": "17df3907-9b6c-3146-94f8-f2c61f0d7df7",
                                "text": "„Zum ersten Mal seit 1973 kann am Morgen des 7. Mai 2003 von ganz Deutschland aus wieder ein Merkurtransit in seiner vollen Länge beobachtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
