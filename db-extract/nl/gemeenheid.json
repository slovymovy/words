                "senses": [
                    {
                        "sense_id": "a51a14a9-b527-30f8-919c-3a5a25498889",
                        "entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "glosses": [
                            "het vervelend, gemeen of achterbaks doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63080100-d018-40b6-a33e-4f138a5d9843",
                                "sense_id": "a51a14a9-b527-30f8-919c-3a5a25498889",
                                "text": "Hoog bezoek gisteren voor de Amerikaanse Harvard University: zangeres Lady Gaga kwam haar nieuwe stichting presenteren en had daarvoor tv-ster Oprah Winfrey en motivatiegoeroe Deepak Chopra meegebracht. Lady Gaga sprak ruim 1100 gasten toe en daagde de jonge aanwezigen uit mee te helpen aan het afrekenen met 'gemeenheid en wreedheid'."
                            }
                        ]
                    },
                    {
                        "sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                        "entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "glosses": [
                            "een vervelende, gemene of achterbakse handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8952d22-fb3b-40a5-984b-513a51cd01ec",
                                "sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                                "text": "Het paleis van Lodewijk XIV in Versailles is een symbool van nationale trots voor de Fransen. Daarom zou het haringcadeau door Hollande dan ook als 'gemeenheid' kunnen worden ervaren, aldus Der Spiegel. Het weekblad heeft op basis van tv-beelden van Hollandes bezoek aan Voor-Pommeren geconstateerd dat de Franse president het vaatje Bismarck-haring snel doorgeeft aan een medewerker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d8b8de0-1c05-4128-bb2b-c18108ddaf76",
                        "source_entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "source_sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                        "source_sense_description": "een vervelende, gemene of achterbakse handeling",
                        "target_lang_word": "crookedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crookedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceef99eb-a9cc-3eca-a85c-5c7e8913ba2d",
                                        "entry_id": "75e391f4-3440-3e16-a127-3638e5a1e630",
                                        "glosses": [
                                            "The state of being crooked"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba8a073-5d9d-4f42-a2ef-a74ea3419201",
                                                "sense_id": "ceef99eb-a9cc-3eca-a85c-5c7e8913ba2d",
                                                "text": "The river was full of logs—long, slender, barkless pine logs—and we leaned on the rails of the bridge, and watched the men put them together into rafts. These rafts were of a shape and construction to suit the crookedness and extreme narrowness of the Neckar."
                                            },
                                            {
                                                "example_id": "7f9a6442-57a1-4597-82ee-4aab20406025",
                                                "sense_id": "ceef99eb-a9cc-3eca-a85c-5c7e8913ba2d",
                                                "text": "But are sailors […] without vices? No; but less often than with landsmen do their vices, so called, partake of crookedness of heart, seeming less to proceed from viciousness than exuberance of vitality after long constraint; frank manifestations in accordance with natural law."
                                            },
                                            {
                                                "example_id": "ea12485e-ea72-4042-a508-4b202e657d7d",
                                                "sense_id": "ceef99eb-a9cc-3eca-a85c-5c7e8913ba2d",
                                                "text": "She had cost me two tenants and no end of sleep, had heated my temper to boiling, yet, somehow I could not hate that baby. The meanest thing about her was the way she could make you feel yourself. One has to make a living and one must sleep. It is one of the crookednesses of life when a little yellow-haired baby can cause you so much trouble and yet won't even let you hate her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b63e2fbe-4e16-4d06-83e3-f13c204bd0b6",
                        "source_entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "source_sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                        "source_sense_description": "een vervelende, gemene of achterbakse handeling",
                        "target_lang_word": "nastiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nastiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Lack of cleanliness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dab62daa-862e-49de-ba78-5a783b440af0",
                                                "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                                "text": "They neither comb their Head, nor wash their Face, / But think their virtuous Nastiness a grace."
                                            },
                                            {
                                                "example_id": "c4a0039c-942e-4edb-9159-937268670014",
                                                "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                                "text": "Erasmus ascribes the frequent plagues in England to the nastiness and dirt and slovenly habits among the people. “The floors,” says he, “are commonly of clay, strewed with rushes, under which lies unmolested an ancient collection of beer, grease, fragments, bones, spittle, excrements of dogs and cats, and every thing that is nasty.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846e45a0-573f-38cd-9333-a0f4386f8468",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Dirt, filth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b262b9ed-f383-4ccb-be2e-cd6663d7c738",
                                                "sense_id": "846e45a0-573f-38cd-9333-a0f4386f8468",
                                                "text": "[T]he helliſh Noiſe, the Roaring, Svvearing, and Clamour, the Stench and Naſtineſs, and all the dreadful croud of Afflicting things that I ſavv there; joyn'd together to make the Place ſeem an Emblem of Hell itſelf, and a kind of an Entrance into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Indecency; corruption; unkindness, meanness, spite, harshness, cruelty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231fdaec-6b93-43ec-85d6-ebd1bb54ddc8",
                                                "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                                "text": "Among current novelists, Martin Amis lacks intellectual force but is well supplied with nastiness, which occasionally resembles humor."
                                            },
                                            {
                                                "example_id": "892690a1-5b56-4d75-9864-1f46eb69f26e",
                                                "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                                "text": "Despite efforts to curb hate speech, eradicate bullying and extend tolerance, a culture of nastiness has metastasized in which meanness is routinely rewarded, and common decency and civility are brushed aside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Unpleasantness, disagreeableness (to the senses)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c04fb53-7d0c-4ca0-a94d-f0b3bcc3b83a",
                                                "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                                "text": "Some medical beast had revived Tar-water in those days as a fine medicine, and Mrs. Joe always kept a supply of it in the cupboard; having a belief in its virtues correspondent to its nastiness."
                                            },
                                            {
                                                "example_id": "d23f8e46-4a27-4996-a012-c3912152cb8f",
                                                "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                                "text": "During the day, the surrounding blocks are no better, full of cheesy bars, tacky shops and brash, neon nastiness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "A nasty action, object, quality, etc. (all senses of nasty)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b624912-f7e0-4f51-9d3f-ea83c9c5c82f",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "If we, who are educated, habitually submit to have copper in our preserves, red-lead in our cayenne, alum in our bread, pigments in our tea, and ineffable nastinesses in our fish-sauce, what can we expect of the poor?"
                                            },
                                            {
                                                "example_id": "cb618bda-d3a0-4e3b-84ba-20bbb335d9a4",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "[…] imagine the delights of bathing when the Baths were open to public view, the said public delighting to throw dead cats, offal, and all manner of nastinesses among the bathers!"
                                            },
                                            {
                                                "example_id": "e773b3a3-4abc-4258-876d-962271e3516e",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "He’s too thoughtful to pretend he’s speaking for humankind on what passes for a Dan Bern protest song—“Tape” folds in a conversational outreach to a girl (“Baby did you get the tape I sent?”) along with a rundown of various societal nastinesses, including the prescient, “We might get to see World War III by Thanksgiving Day.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f83e418-a5bf-463f-a751-25f0e0475f34",
                        "source_entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "source_sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                        "source_sense_description": "een vervelende, gemene of achterbakse handeling",
                        "target_lang_word": "malice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8cf7024-04db-3c3a-a1b1-a02b39ae5801",
                                        "entry_id": "626ca380-dc29-391e-b118-136a6bfe5739",
                                        "glosses": [
                                            "Intention to harm or deprive in an illegal or immoral way. Desire to take pleasure in another's misfortune."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfca1cb-cc37-40ff-979f-db4a882526dc",
                                                "sense_id": "f8cf7024-04db-3c3a-a1b1-a02b39ae5801",
                                                "text": "[…] not only was there no gratitude (which he could psychologically handle) but downright malice showed itself instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b99fe4-9c98-35d6-a8b2-d6733f6e3a82",
                                        "entry_id": "626ca380-dc29-391e-b118-136a6bfe5739",
                                        "glosses": [
                                            "An intention to do injury to another party, which in many jurisdictions is a distinguishing factor between the crimes of murder and manslaughter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832589bd-86f9-4fe7-9be0-1e71de3753da",
                                                "sense_id": "65b99fe4-9c98-35d6-a8b2-d6733f6e3a82",
                                                "text": "The question that would have been before the jury was whether Fox committed “actual malice” in airing the claims. That required Dominion to show whether key decision makers were aware the claims were false or acted with reckless disregard for the truth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                        "entry_id": "6c5afdf9-2a23-3b99-a5d6-76d7804cac80",
                                        "glosses": [
                                            "To intend to cause harm; to bear malice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc78074-4dc0-4d57-befe-3cd7908a2cb4",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "Thou blinded God (quod I) forgive me this offence, / Unwittingly I went about, to malice thy pretence."
                                            },
                                            {
                                                "example_id": "41a8b155-1b38-44cc-a587-3501197efd99",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "Who on the other ſide did ſeeme ſo farre / From malicing, or grudging his good houre, / That, all he could, he graced him with her, / Ne euer ſhewed ſigne of rancour or of iarre."
                                            },
                                            {
                                                "example_id": "35946c2c-2602-45e6-b16b-34b3a29a4070",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "His paines, his pouertie, his ſharpe aſſayes, / Through which he paſt his miſerable dayes, / Offending none, and doing good to all, / Yet being maliſt both of great and ſmall."
                                            },
                                            {
                                                "example_id": "949a80af-142c-44f7-94ce-a708a41dbce8",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "I am so far from malicing their states, / That I begin to pity 'em."
                                            },
                                            {
                                                "example_id": "2267964e-6ad0-463e-b2cd-9319a4b38898",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "A feeble spirited king that governed, / Who ill could guide the sceptre he did use; / His enemies, that his worth maliced, / Who both the land and him did much abuse: / The peoples love; and his apparent right, May seem sufficient motives to incite."
                                            },
                                            {
                                                "example_id": "5e897286-fba3-4e14-aeb5-6ec3acd985f0",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "Here's a list of side effects / Practice tested / Covering every maliced angle / For example: / You will sleep forever / You will never sleep again"
                                            },
                                            {
                                                "example_id": "05c3f4c2-4104-40f2-821f-7d6c521780a7",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "Robert Truswell may have been a belligerent and malicing man, a jury heard this morning during the trial of George Kieran Daunt."
                                            },
                                            {
                                                "example_id": "213c9902-5369-4273-a3da-c96418a91857",
                                                "sense_id": "76f81848-5566-3cfe-ac62-f98115c7c274",
                                                "text": "I haven't maliced anybody, definitely not. I never used to have friends like that. I had a few who I thought were friends. Even if you have friends, things happen and friendship break up, but you move on. But I still talk to everybody."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1495734-b367-4d2b-a9c7-5419d8b40a5c",
                        "source_entry_id": "22a554c2-84ed-36f1-987c-7366fe6ea17a",
                        "source_sense_id": "051e10c0-69e3-3b35-af7c-0ae2bb315e5e",
                        "source_sense_description": "een vervelende, gemene of achterbakse handeling",
                        "target_lang_word": "vacherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Étable à vaches."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07107246-51e3-43cc-aab3-2017e6104557",
                                                "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                                "text": "Sous le ciel pâlissant, les bâtiments de la Borderie sommeillaient encore, à demi sombres, trois longs bâtiments aux trois bords de la vaste cour carrée, la bergerie au fond, les granges à droite, la vacherie, l’écurie et la maison d’habitation à gauche."
                                            },
                                            {
                                                "example_id": "e0608888-a772-4035-b4b8-a170de4c5c0f",
                                                "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                                "text": "Tous les jours, actuellement, l’étable fournit 250 à 300 litres de lait. Recueilli dans de vastes « berthes » brillantes il est remis au service de la stérilisation qui occupe la partie droite de la vacherie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Méchanceté, trahison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1651037f-39ee-45c4-af7e-7baedc3c6166",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "Et c’est encore ce maudit esprit de soumission qui ferme le bec aux esclaves et les empêche de gueuler aux quatre coins de Paris les vacheries qu’elles endurent."
                                            },
                                            {
                                                "example_id": "f140bc69-074c-4b63-86c6-4a3eb4887696",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "« En plus de toutes les vacheries que tu nous as fait endurer, à moi et à ta mère, tu me bafoues, comme un salaud que tu es, et tu as obligé le facteur à se payer de ma gueule ! »"
                                            },
                                            {
                                                "example_id": "f88d62ea-92ca-4adc-a0e5-9ea28fd1288d",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "Je savais qu’il préparait un truc en catimini, mais jamais, l’idée d’une telle vacherie ne m’a effleuré.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd5e12d1-68f7-39d9-a2d9-087898c2ffcf",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Événement pénible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed51064d-1e4f-4468-83f3-50ea34459013",
                                                "sense_id": "bd5e12d1-68f7-39d9-a2d9-087898c2ffcf",
                                                "text": "Vacherie de vie ! dit le premier. On était si bien ici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
