                        "glosses": [
                            "Genre de la famille des Fabacées, arbres ou arbustes aux feuilles caduques finement découpées en petites folioles, et aux petites fleurs en pompon et qui ont des étamines plus longues que les pétales. → voir Albizia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01295ad-3ca7-4827-af93-8de60126d159",
                                "sense_id": "ab988ffb-c7cd-3e83-9ce7-a881293a19ac",
                                "text": "Certaines espèces d’albizias sont considérées comme envahissantes."
                            },
                            {
                                "example_id": "75eb47e8-a3ea-461c-8975-840d9d2c31d0",
                                "sense_id": "ab988ffb-c7cd-3e83-9ce7-a881293a19ac",
                                "text": "À Praslin, les 950 ha exploitables, où prédomine l’albizia, enserrent le joyau que forme la forêt de la vallée de Mai."
                            }
                        ]
                    }
