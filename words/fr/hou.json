{
    "word_family": [
        "huée",
        "huer"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c2a039ae-287c-3cd7-8e16-1aacb01cd3b1",
                    "sense_definition": "Exclamation poussée pour effrayer quelqu'un ou pour imiter un fantôme.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "effroi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garçon s'est caché derrière la porte pour crier <w>hou</w> à sa sœur."
                        },
                        {
                            "text": "Déguisé sous un grand drap blanc, il criait <w>hou</w> pour faire semblant d'être un fantôme."
                        }
                    ],
                    "common_phrases": [
                        "crier hou"
                    ]
                },
                {
                    "sense_id": "de06a747-c5bf-3241-ac89-1f3a51c55fa1",
                    "sense_definition": "Onomatopée imitant le cri ou le hululement du hibou et de la chouette.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le calme de la nuit, le hibou fait entendre son <w>hou</w> mystérieux."
                        },
                        {
                            "text": "L'enfant s'amuse à faire <w>hou</w> pour imiter la chouette perchée dans l'arbre."
                        }
                    ],
                    "common_phrases": [
                        "faire hou hou"
                    ]
                },
                {
                    "sense_id": "97ba2416-a3ac-3194-9915-ef721449e622",
                    "sense_definition": "Exclamation servant à huer, marquer la désapprobation ou se moquer de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "reprobation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La foule en colère a crié <w>hou</w> dès l'arrivée des ministres sur l'estrade."
                        },
                        {
                            "text": "Les spectateurs déçus faisaient entendre des <w>hou</w> sonores à la fin de la pièce."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "4a6f0c65-96c0-38c0-861e-c2db4c9e21ee",
                    "sense_definition": "Exclamation familière soulignant l'emphase, l'étonnement ou une grande distance dans le temps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux souvenir remonte à très longtemps, <w>hou</w>, au moins quarante ans en arrière."
                        },
                        {
                            "text": "Il a regardé la facture puis a lâché un <w>hou</w> de surprise devant le montant total."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "4c0aa8cb-ffe0-3b4a-8953-9f24cd8f09bf",
                    "sense_definition": "Son répété produit par une personne qui chantonne sans articuler les paroles.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chantonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Assis sur son banc, le vieil homme rythmait la chanson en faisant <w>hou</w> doucement."
                        },
                        {
                            "text": "Elle marchait joyeusement dans les couloirs en laissant échapper un <w>hou</w> mélodieux."
                        }
                    ]
                },
                {
                    "sense_id": "e2b62b7b-9cee-3e91-827a-ae7f72bd99a9",
                    "sense_definition": "Onomatopée mimant le cri attribué au caribou.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le jeu d'imitation, l'animateur faisait <w>hou</w> avec les mains sur la tête comme un caribou."
                        },
                        {
                            "text": "Le guide québécois montrait aux touristes comment faire <w>hou</w> pour reproduire l'appel du caribou."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        }
                    ]
                }
            ]
        }
    ]
