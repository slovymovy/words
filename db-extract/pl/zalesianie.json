                    {
                        "translation_id": "dfa47739-d6ae-4454-97e8-ce70507b8383",
                        "source_entry_id": "4c3042e3-4f83-38aa-b9da-fce9e266ebeb",
                        "source_sense_id": "4a3dfc83-deff-3147-846c-a5d253d830e4",
                        "target_lang_word": "afforestation",
