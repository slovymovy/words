                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "An dieser Stelle ist das Baden verboten."
                                            },
                                            {
                                                "example_id": "7317d2d1-23e7-4f80-926b-e9d5e278d7a7",
                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "„In den christlichen Ländern gewann dagegen die Lehrrichtung der Askese zunehmend an Bedeutung, die das Baden als Verweichlichung und Luxus ablehnte.“"
                                            },
                                            {
                                                "example_id": "d58c49b9-e1b1-48c3-a6e7-8ea7c2878ae3",
                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "„Jede dialektische Theorie des Badens, Schwimmens, Planschens sowie Tauchens und Taufens beginnt kalt und klar mit Heraklits Grundsatz: »Man kann nicht zweimal in denselben Fluss steigen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
