                                    {
                                        "sense_id": "3c0c05f2-0ddd-3950-bb2d-8ae16d8e0f7c",
                                        "entry_id": "da7de412-8f1d-3343-a979-b486f3bc24b6",
                                        "glosses": [
                                            "Cualquier cosa, generalmente dinero, que se deja como garantía del cumplimiento de una obligación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcebc68e-beaa-43e2-8dc2-9f28886b187b",
                                                "sense_id": "3c0c05f2-0ddd-3950-bb2d-8ae16d8e0f7c",
                                                "text": "Cuando alquilamos el piso, tuvimos que dejar una fianza que luego nos devolvieron."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44799112-acd4-3ec6-8b22-3bffddd83f78",
                                        "entry_id": "da7de412-8f1d-3343-a979-b486f3bc24b6",
                                        "glosses": [
                                            "Dinero que se paga por la libertad de una persona pendiente de juicio o sentencia firme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96e1334-d32d-471d-855b-ed7a8c51c61b",
                                                "sense_id": "44799112-acd4-3ec6-8b22-3bffddd83f78",
                                                "text": "Llamó a su madre desde la comisaría para que pagara la fianza."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a6c3367-4367-3561-a93e-eadc061e2b3f",
                                        "entry_id": "da7de412-8f1d-3343-a979-b486f3bc24b6",
                                        "glosses": [
                                            "Persona que fía a otra o responde por ella."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "94fffd8a-0ee1-3dca-87fd-25eb188f5ed3",
                                        "entry_id": "da7de412-8f1d-3343-a979-b486f3bc24b6",
                                        "glosses": [
                                            "Compromiso que una persona contrae cuando se compromete a responder por otra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fef0c65-e457-444e-a240-b843396e93b4",
                                                "sense_id": "94fffd8a-0ee1-3dca-87fd-25eb188f5ed3",
                                                "text": "Tu palabra me servirá como fianza."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "40d7e7b9-a67b-35cd-83b7-005450ba1754",
                                        "entry_id": "da7de412-8f1d-3343-a979-b486f3bc24b6",
                                        "glosses": [
                                            "Propiedad inmueble en la ciudad o en el campo."
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f991a673-505f-42ea-9679-4ebb3c6306df",
                                                "sense_id": "40d7e7b9-a67b-35cd-83b7-005450ba1754",
                                                "text": "Se ha comprado una finca en el campo."
                                            }
                                        ],
