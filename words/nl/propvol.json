{
    "word_family": [
        "proppen",
        "vol"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11cacdb3-c25b-3fbe-ab2d-adac74d52d7b",
                    "sense_definition": "Heel erg vol, vaak in de zin van te vol.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "volheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zich <w>propvol</w> gegeten, er kan niets meer bij.",
                            "target_lang_translations": {
                                "en": "He ate himself <w>stuffed</w>, nothing more can fit."
                            }
                        },
                        {
                            "text": "De bus was <w>propvol</w> met scholieren en forensen.",
                            "target_lang_translations": {
                                "en": "The bus was <w>packed</w> with students and commuters."
                            }
                        }
                    ],
                    "synonyms": [
                        "bomvol",
                        "eivol",
                        "tjokvol"
                    ],
                    "antonyms": [
                        "leeg",
                        "leeggehaald"
                    ],
                    "common_phrases": [
                        "een propvolle bus",
                        "propvol met mensen"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely full, often to the point of being overfilled or crowded."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "packed",
                                "target_lang_sense_clarification": "of a vehicle, room, or space, filled to capacity"
                            },
                            {
                                "target_lang_word": "stuffed",
                                "target_lang_sense_clarification": "of a person, having eaten too much food"
                            },
                            {
                                "target_lang_word": "crowded",
                                "target_lang_sense_clarification": "full of people"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b396a83-2613-3293-bfff-a48ec6a2313b",
                    "sense_definition": "Helemaal gevuld tot aan de rand; overvol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn agenda zit deze week echt <w>propvol</w> met afspraken.",
                            "target_lang_translations": {
                                "en": "My schedule is really <w>jam-packed</w> with appointments this week."
                            }
                        },
                        {
                            "text": "De doos zat <w>propvol</w> oude brieven en foto's.",
                            "target_lang_translations": {
                                "en": "The box was <w>chock-full</w> of old letters and photos."
                            }
                        }
                    ],
                    "synonyms": [
                        "bomvol",
                        "eivol",
                        "tjokvol"
                    ],
                    "antonyms": [
                        "leeg"
                    ],
                    "common_phrases": [
                        "een propvolle agenda"
                    ],
                    "target_lang_definitions": {
                        "en": "Completely filled to the brim; overflowing or jam-packed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jam-packed",
                                "target_lang_sense_clarification": "extremely full of things, people, or scheduled events"
                            },
                            {
                                "target_lang_word": "chock-full",
                                "target_lang_sense_clarification": "filled to absolute capacity with objects"
                            },
                            {
                                "target_lang_word": "crammed",
                                "target_lang_sense_clarification": "stuffed full of items"
                            }
                        ]
                    }
                }
            ]
        }
    ]
