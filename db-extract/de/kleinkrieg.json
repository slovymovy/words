                        "target_lang_word": "petite guerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petite guerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b58c041-ce66-3658-aabc-18a160781e91",
                                        "entry_id": "a8869eb4-26ee-3da8-94e6-5d75b4c23185",
                                        "glosses": [
                                            "Manœuvres militaires, simulacre de guerre, dans lequel des corps d’une même armée manœuvrent et feignent de combattre les uns contre les autres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9509a6d4-8f9f-3393-91a9-c19f04821a93",
                                        "entry_id": "a8869eb4-26ee-3da8-94e6-5d75b4c23185",
                                        "glosses": [
                                            "Guérilla, conflit qui se fait par détachements ou par partis, dans le dessein d’observer les démarches de l’ennemi, de l’incommoder, de le harceler."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
