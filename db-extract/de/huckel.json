                                "example_id": "bb00fa35-2c3c-4ac8-b9ce-4f83c1eae04b",
                                "sense_id": "67730112-a7df-3992-9583-29adff1c503b",
                                "text": "Er startete und steuerte den Wagen behutsam über alle Huckel und Löcher der zerkraterten Erde hinweg.",
                                "translation": "He started and carefully steered the car across all the bumps and potholes of the crater-scarred ground.",
                                "english": "He started and carefully steered the car across all the bumps and potholes of the crater-scarred ground."
                            },
                            {
                                "example_id": "38efd740-5cff-41ea-9060-7f0c465f7ed2",
                                "sense_id": "67730112-a7df-3992-9583-29adff1c503b",
                                "text": "Das Grundschulkind sagt: „Ich mag diese Rutsche nicht, die hat so komische Huckel.“",
                                "translation": "The primary school student says: \"I don't like this slide, it's got these weird bumps.\"",
                                "english": "The primary school student says: \"I don't like this slide, it's got these weird bumps.\""
                            }
                        ]
