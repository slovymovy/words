                        "examples": [
                            {
                                "example_id": "501a6206-17af-497a-a93f-fc85092b9e61",
                                "sense_id": "20277d39-c5d0-3ce7-91ad-f1b1811ad612",
                                "text": "Aan iemand heelt hij (de jongste) verteld hoe verleden zomer een in het nauw gedreven fluwijn hem in de wang gebeten had (…)"
                            },
                            {
                                "example_id": "87d24404-52f0-4e47-81a6-5e7bbed612c6",
                                "sense_id": "20277d39-c5d0-3ce7-91ad-f1b1811ad612",
                                "text": "Het fluwijn had ons bij de opvuller te Boom een aardige stuiver opgebracht, die we onder ons drieën opgesnoept hadden."
                            }
                        ]
                    }
