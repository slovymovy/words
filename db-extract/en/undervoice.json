                "senses": [
                    {
                        "sense_id": "c7d80d8e-a45d-3c1b-84a0-b7a1ca026a9e",
                        "entry_id": "3e0395e2-a6e6-35e3-9d9a-5ed8a5323b38",
                        "glosses": [
                            "To voice too weakly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9c902284-0f4a-4a9e-9a43-2d12d6ddc2da",
                                "sense_id": "c7d80d8e-a45d-3c1b-84a0-b7a1ca026a9e",
                                "text": "Consequently, the danger for Dutch learners of English is undervoicing the English lenis fricatives rather than the reverse."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7d7678f-5d80-3600-a0af-929e911b7153",
                        "entry_id": "3e0395e2-a6e6-35e3-9d9a-5ed8a5323b38",
                        "glosses": [
                            "To make a quieter or background sound beneath."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3773c87e-2396-4cb1-9e19-f9210224adff",
                                "sense_id": "c7d7678f-5d80-3600-a0af-929e911b7153",
                                "text": "Undervoicing the flame, there was the popping of hollow weed stalks, the tinkle of woody stems crisping and falling in coals."
                            }
                        ]
                    }
