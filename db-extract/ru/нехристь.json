                    },
                    {
                        "translation_id": "ae21195f-6844-491e-ab4f-6f5dd194be46",
                        "source_entry_id": "57a4d07a-33ed-34ef-9d7e-d4f43093e3d8",
                        "source_sense_description": "человек, который не верит в Иисуса, не придерживается христианской веры",
                        "target_lang_word": "infidel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infidel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bca4846e-976e-303f-aa4f-b23188f8a06e",
                                        "entry_id": "6d24fa35-2798-3430-ab33-586604a8eb13",
                                        "glosses": [
                                            "Rejecting a specific religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d094b74b-de3c-333e-bc73-6d3fe39f5fa1",
                                        "entry_id": "6d24fa35-2798-3430-ab33-586604a8eb13",
                                        "glosses": [
                                            "Of, characteristic of, or relating to unbelievers or unbelief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66c68fa-d1fc-47e9-bde1-d818372295b2",
                                                "sense_id": "d094b74b-de3c-333e-bc73-6d3fe39f5fa1",
                                                "text": "(...) how it is that to his name who yesterday departed for the other world, we prefix so significant and infidel a word, and yet do not thus entitle him, if he but embarks for the remotest Indies of this living earth;(...)"
                                            },
                                            {
                                                "example_id": "86686afa-6511-48e2-bfba-92595333f8b0",
                                                "sense_id": "d094b74b-de3c-333e-bc73-6d3fe39f5fa1",
                                                "text": "But not only have the priests tried to make the very term Atheism odious, as if it would destroy all of good and beautiful in nature, but some of the reformers, not having the moral courage to avow their own sentiments, wishing to be popular, fearing lest their reforms would be considered Infidel, (as all reforms assuredly are), shield themselves from the stigma, by joining in the tirade against Atheism, and associate it with everything that is vile, with the crime of slavery, the corrup­tions of the Church, and all the vices imaginable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infidel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc69857-e1f8-3cdb-8ebb-a419e50bea5b",
                                        "entry_id": "4e0e8361-a443-3448-ab5f-db6641a65dfd",
                                        "glosses": [
                                            "One who does not believe in a certain religion."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b8544d5-e4a0-4c2d-8291-9dbabd3ebd5b",
                                                "sense_id": "ddc69857-e1f8-3cdb-8ebb-a419e50bea5b",
                                                "text": "The infidel writer is a greater enemy to society."
                                            },
                                            {
                                                "example_id": "0cadafe0-5cb7-4739-8217-20ceaaaa5750",
                                                "sense_id": "ddc69857-e1f8-3cdb-8ebb-a419e50bea5b",
                                                "text": "Some Muslims are taught that non-Muslims are infidels and are to be shunned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a64dfa-83e2-3cb6-9204-ca52c27baed1",
                                        "entry_id": "4e0e8361-a443-3448-ab5f-db6641a65dfd",
                                        "glosses": [
                                            "One who does not believe in a certain principle."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17a29cad-0476-3879-8de7-6cac5b74bcbf",
                                        "entry_id": "4e0e8361-a443-3448-ab5f-db6641a65dfd",
                                        "glosses": [
                                            "One with no religious beliefs."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
