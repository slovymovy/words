                                "example_id": "364c1d83-9d0b-45fc-8466-14c7b43b3fe4",
                                "sense_id": "d5f83a04-0d91-33e0-b8bf-e3bec62c4b24",
                                "text": "„Er befand sich in einem runden Raum mit einem Kuppeldach, durch das ein blassblaues Licht herabschien.“"
                            },
                            {
                                "example_id": "88fc2b36-2d09-48a7-8ed7-c8ea7508bce5",
                                "sense_id": "d5f83a04-0d91-33e0-b8bf-e3bec62c4b24",
                                "text": "„Dort schien zwar das Tageslicht durch eine Spalte im Kuppeldach herein, aber sie lag in unerreichbarer Höhe.“"
                            }
                        ],
