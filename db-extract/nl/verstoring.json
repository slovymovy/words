                                    {
                                        "sense_id": "eede226f-649e-3433-9f27-31268fdaf727",
                                        "entry_id": "64cca525-5803-3458-9fee-6c11b4284002",
                                        "glosses": [
                                            "An interruption to the regular flow or sequence of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c51e207-4fae-4a95-8220-fd3429355e97",
                                                "sense_id": "eede226f-649e-3433-9f27-31268fdaf727",
                                                "text": "The network created a disruption in the show when they broke in with a newscast."
                                            },
                                            {
                                                "example_id": "5dc54197-9855-46e3-bd0a-cedc18bdd92a",
                                                "sense_id": "eede226f-649e-3433-9f27-31268fdaf727",
                                                "text": "In the May 12 memo, Meta said it had previously allowed open discussion of abortion at work but later recognized that it had led to “significant disruptions in the workplace given unique legal complexities and the number of people affected by the issue.”"
                                            },
                                            {
                                                "example_id": "f02ca4d5-4049-4804-a622-b8c6f1f30955",
                                                "sense_id": "eede226f-649e-3433-9f27-31268fdaf727",
                                                "text": "Much more disruption, we are told, lies ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207a5b59-762c-3d4a-94fd-beb58e64a53b",
                                        "entry_id": "64cca525-5803-3458-9fee-6c11b4284002",
                                        "glosses": [
                                            "A continuing act of disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e7dd38-3678-49b1-bfb8-9694c8064077",
                                                "sense_id": "207a5b59-762c-3d4a-94fd-beb58e64a53b",
                                                "text": "There was great disruption in the classroom when the teacher left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbe05f0-ed63-3cf0-ba3d-e991080bd585",
                                        "entry_id": "64cca525-5803-3458-9fee-6c11b4284002",
                                        "glosses": [
                                            "A breaking or bursting apart; a breach."
                                        ],
