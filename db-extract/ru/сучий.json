                "senses": [
                    {
                        "sense_id": "3ce81a56-f648-31f0-a273-0aa1cdf5e001",
                        "entry_id": "fd2e1c58-a3af-3bac-8a70-443537350f97",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным сука"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f20f2d7d-e7c4-4204-8ea9-492b693a0c8e",
                                "sense_id": "3ce81a56-f648-31f0-a273-0aa1cdf5e001",
                                "text": "Бог не понимает, и сделал женщину из сучьего хвостика — оттого все бабы так злы на свете, а кухарки много добрее."
                            },
                            {
                                "example_id": "4a37a1ed-dc00-4cb3-8dd2-d79e64df56b1",
                                "sense_id": "3ce81a56-f648-31f0-a273-0aa1cdf5e001",
                                "text": "Давно промокшее платье издавало особенный сырой сучий запах."
                            }
                        ]
                    },
                    {
                        "sense_id": "df9470ab-2798-365e-8eb7-7c2d0a5de994",
                        "entry_id": "fd2e1c58-a3af-3bac-8a70-443537350f97",
                        "glosses": [
                            "свойственный суке, характерный для неё"
                        ],
