                        "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                        "entry_id": "83b6c39e-3697-33b6-a62e-b816b8af9a87",
                        "glosses": [
                            "Aérostat de type dirigeable rigide fabriqué par Zeppelin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd308b1-c6fd-4f3c-a61c-7a59dfca617c",
                                "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                                "text": "Les zeppelins ont lancé sans discontinuer des bombes destructives sur Londres et sur toute l’Angleterre; chaque jour les U-boote criminels, envoyaient sans merci tous les navires au fond de la mer."
                            },
                            {
                                "example_id": "c306f718-6770-4d20-8f36-13d1169a638f",
                                "sense_id": "cb4cece6-9720-3c4c-9c5d-5f232325265e",
                                "text": "Le bruit de la ligne Dauphine-Nation, pareil à une plainte de zeppelin, accompagne le voyageur jusqu’à ces quartiers cernés de cheminées d’usines, lacs de zinc où la rue d’Aubervilliers se jette comme une rivière de vernis."
                            }
                        ]
                    },
