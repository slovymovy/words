                        "cross_references": [
                            {
                                "target_word": "abends",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                        "entry_id": "0b3732f4-ca75-3532-9bed-e8cc10dfa495",
                                        "glosses": [
                                            "am Abend, während des Abends"
                                        ],
                                        "tags": [
                                            "Zeitangabe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae8c0d3-1f16-44a0-8b20-ec97a17d350e",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Am Wochenende dürfen die Kinder abends länger aufbleiben."
                                            },
                                            {
                                                "example_id": "698826d2-b84c-434b-aad8-89900f9a3c99",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Er ist immer von morgens bis abends unterwegs."
                                            },
                                            {
                                                "example_id": "d78ffcad-77a7-419f-927e-75f0f75d063c",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Abends um acht schauen wir die Nachrichten."
                                            },
                                            {
                                                "example_id": "ccd73640-7420-4fe1-b9e7-b1220b195653",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Sie kam abends erst spät nach Hause."
                                            },
                                            {
                                                "example_id": "5eaacb68-cf69-4d45-99d6-511e19beceec",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Mittwochs abends spielen sie immer zusammen Poker."
                                            },
                                            {
                                                "example_id": "57746f9f-0e56-4722-9695-0289bcdd03dd",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "Wollen wir uns abends noch treffen?"
                                            },
                                            {
                                                "example_id": "a827fade-1b66-46e6-a3a8-e4e7d2a7455e",
                                                "sense_id": "8d1f865d-8d6b-35ca-97fe-765e9f9b5d10",
                                                "text": "„Die Krise bewältigen und nebenbei Wahlen gewinnen, das ist der gemeinsame Konflikt von Union und Sozialdemokraten, sie müssen tags regieren und abends in den Hallen der Republik Schattenboxen üben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
