                        "entry_id": "e414e2ca-f9ba-359d-9a47-13dbab2b48c3",
                        "glosses": [
                            "a protrusion or stud of any kind, but especially one designed for some function (in devices, fasteners, packaging, etc.)"
                        ],
                        "tags": [
                            "colloquial",
