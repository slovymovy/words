                "senses": [
                    {
                        "sense_id": "a0e78d1e-0c1e-3750-878c-fea0cce1b1e1",
                        "entry_id": "87fafb2e-e81f-34fd-8e54-8078d594f2b8",
                        "glosses": [
                            "Klosett mit Wasserspülung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9326dfa-f28b-4275-9d0d-02a366ec34c4",
                                "sense_id": "a0e78d1e-0c1e-3750-878c-fea0cce1b1e1",
                                "text": "„Das erste Wasserklosett hält feierlich Einzug.“"
                            },
                            {
                                "example_id": "2459e3a6-d860-4853-af88-ede72d503e19",
                                "sense_id": "a0e78d1e-0c1e-3750-878c-fea0cce1b1e1",
                                "text": "„Die Innenausstattung war aus Oslo bestellt worden: Stabparkett für die Wohnzimmer, Strohtapete für die Bibliothek, Wasserhähne aus Messing und das erste Wasserklosett im Dorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3078a4ca-968c-4194-aaae-ffe425c2e28f",
                        "source_entry_id": "87fafb2e-e81f-34fd-8e54-8078d594f2b8",
                        "source_sense_id": "a0e78d1e-0c1e-3750-878c-fea0cce1b1e1",
                        "source_sense_description": "Klosett mit Wasserspülung",
                        "target_lang_word": "toilettes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toilettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                        "entry_id": "5f9fc3d4-bb23-3442-ad52-42b4790c483b",
                                        "glosses": [
                                            "Petit espace clos utilisé pour se soulager des déjections corporelles, telles que l’urine, les selles et les vomissures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5c64bf-921f-407f-985c-bc40cf1ac8fc",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "– Où sont les toilettes ? me pose problème. C’est une requête froide, qui sent son restaurant de province."
                                            },
                                            {
                                                "example_id": "f54fcbab-f35c-4f8d-8453-d93368b7adb4",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Il n'y a pas un moment, ni un endroit, où nous puissions avoir du répit : aux États-Unis, 75 % des possesseurs de smartphones l'utilisent aux toilettes !"
                                            },
                                            {
                                                "example_id": "50c4717a-22e2-4928-8f9f-a5368b4d13f6",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Une enquête de Moore et al. auprès de 528 femmes a révélé que 85 % d'entre elles s'accroupissent sur les toilettes publiques, 12 % s'assoient en tapissant la cuvette de papier et seulement 2 % s'assoient directement sur le siège."
                                            },
                                            {
                                                "example_id": "1085d7b5-ea57-40c7-89cc-82ada5c0d839",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Dans tous les cas, ce sont des toilettes qui n'utilisent pas d'eau.\nOn peut distinguer deux types de toilettes sèches :\n• les toilettes où les selles et l'urine sont mélangées;\n• les toilettes où elles sont séparées."
                                            },
                                            {
                                                "example_id": "8fc49d52-4b28-4ccb-9434-f7a1cd97781c",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Il est assuré que personne ne remarque rien, de même que les drogués peuvent aller dix fois par jour se faire leur fix aux toilettes sans prendre en compte que ça nuit à leur secret tant qu'on ne le leur a pas fait explicitement remarquer, […]."
                                            },
                                            {
                                                "example_id": "5d3b396a-4136-4c0b-96ed-c8718e8248b4",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "Mais la petite maison de bois se réchauffe rapidement – hormis les toilettes qui demeurent glaciales, car elles se trouvent à l’extérieur."
                                            },
                                            {
                                                "example_id": "3b2f60f6-8b43-4863-91ad-653edc6c2d7d",
                                                "sense_id": "813617ed-20f8-309b-b135-1ce9b1a28ccb",
                                                "text": "La procureure a souligné que les deux derniers cas étaient liés à « de la contamination secondaire, par les mains. C’est-à-dire qu’une personne contaminée a dû (…) sortir des toilettes sans bien se laver les mains, et tenir les mains d’une autre personne qui du coup va être contaminée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888e6abd-429b-3fa1-ba87-72e190a0d468",
                                        "entry_id": "5f9fc3d4-bb23-3442-ad52-42b4790c483b",
                                        "glosses": [
                                            "Appareil sanitaire servant à recueillir et à évacuer les besoins naturels."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "300df3f2-eb4b-4c46-bf93-48d9271906e3",
                                                "sense_id": "888e6abd-429b-3fa1-ba87-72e190a0d468",
                                                "text": "Les lingettes jetées dans les toilettes ont une double conséquence: elles bouchent les canalisations et polluent l’environnement. Le réseau d’assainissement du Lot-et-Garonne alerte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toilettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89a988ae-c0fe-3678-ab8e-ed44725399a2",
                                        "entry_id": "b9399f21-6f23-3fb9-9819-cab44870fc2a",
                                        "glosses": [
                                            "Pluriel de toilette."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9eb018-aea0-4f4f-b176-bd7934d7615f",
                                                "sense_id": "89a988ae-c0fe-3678-ab8e-ed44725399a2",
                                                "text": "Pendant que le juge dépotait, repiquait, arrosait, marcotait, greffait, mariait et panachait ses fleurs, madame Blondet dépensait son bien en toilettes et en modes pour briller dans les salons de la Préfecture ; un seul intérêt, l’éducation d’Émile, qui certes appartenait encore à sa passion, pouvait l’arracher aux soins de cette belle affection, que la ville finit par admirer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toilettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37b5ce1d-ca55-3faa-b443-bbf49ad46a65",
                                        "entry_id": "e72aaff2-1867-337c-8b48-97a03efe0171",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’indicatif présent du verbe toiletter."
                                        ],
