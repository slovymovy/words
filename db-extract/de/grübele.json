                ],
                "senses": [
                    {
                        "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                        "entry_id": "9dcad2d3-6de8-3249-ae09-5f991a1df63c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713596c6-febc-4960-b252-1e6d82221f91",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Frau Grübele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "48c9a1d9-cced-4090-b2d0-e296f96b4735",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Herr Grübele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3d2653ae-78b1-4e1f-9429-e400e9feea46",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Die Grübeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9ce5ba6f-87cb-4bfe-9d35-705a0706c6e0",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Der Grübele trägt nie die Pullover, die die Grübele ihm strickt."
                            },
                            {
                                "example_id": "edb28aa6-7d2d-41a3-bcf2-f60e57e4a005",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grübele kommt, geht der Herr Grübele.“"
                            },
                            {
                                "example_id": "eb06bacb-b5ef-49a0-ac28-08f0746b8fc3",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Grübele kommt und geht."
                            },
                            {
                                "example_id": "c3b63cfc-f016-45ac-9375-b2c3ce3b9fe5",
                                "sense_id": "707a6fca-4c7c-38d7-b6b9-1edd3931475a",
                                "text": "Grübeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
