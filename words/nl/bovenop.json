                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het boek lag <w>bovenop</w> en was makkelijk te vinden.",
                            "target_lang_translations": {
                                "en": "The book lay <w>on top</w> and was easy to find.",
                                "ru": "Книга лежала <w>сверху</w>, и её было легко найти.",
                                "pl": "Książka leżała <w>na wierzchu</w> i łatwo było ją znaleźć.",
                                "de": "Das Buch lag <w>obenauf</w> und war leicht zu finden.",
                                "fr": "Le livre était posé <w>au-dessus</w> et était facile à trouver.",
                                "it": "Il libro era <w>di sopra</w> ed era facile da trovare.",
                                "cs": "Kniha ležela <w>navrchu</w> a bylo snadné ji najít.",
                                "tr": "Kitap <w>en üstte</w> duruyordu ve bulması kolaydı.",
                                "es": "El libro estaba <w>encima</w> y era fácil de encontrar.",
                                "zh": "书放在<w>最上面</w>，很容易找到。"
                            }
                        },
                        {
                            "text": "Ik klom naar het dak en ging <w>bovenop</w> zitten om van het uitzicht te genieten.",
                            "target_lang_translations": {
                                "en": "I climbed to the roof and sat <w>on top</w> to enjoy the view.",
                                "ru": "Я залез на крышу и сел <w>наверху</w>, чтобы насладиться видом.",
                                "pl": "Wszedłem na dach i usiadłem <w>na górze</w>, żeby cieszyć się widokiem.",
                                "de": "Ich kletterte auf das Dach und setzte mich <w>ganz oben hin</w>, um die Aussicht zu genießen.",
                                "fr": "Je suis monté sur le toit et je me suis assis <w>tout en haut</w> pour profiter de la vue.",
                                "it": "Sono salito sul tetto e mi sono seduto <w>in cima</w> per godermi il panorama.",
                                "cs": "Vylezl jsem na střechu a sedl si <w>nahoru</w>, abych si užil výhled.",
                                "tr": "Çatıya tırmandım ve manzaranın tadını çıkarmak için <w>en tepeye</w> oturdum.",
                                "es": "Subí al tejado y me senté <w>encima</w> para disfrutar de las vistas.",
                                "zh": "我爬上屋顶，坐在<w>顶端</w>欣赏风景。"
