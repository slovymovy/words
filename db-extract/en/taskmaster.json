                    },
                    {
                        "translation_id": "bba319d7-0bb9-405c-a37d-397179a8aa0d",
                        "source_entry_id": "7cdbceb9-4570-3feb-af38-3f4172884ebf",
                        "source_sense_description": "Supervisor",
                        "target_lang_word": "Aufseher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufseher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Dinge bewacht oder Vorgänge überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5805d0-c546-44bd-94cb-92ac7f8fa069",
                                                "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Personen (meist: unter Zwang gehaltene Personen) beaufsichtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a3decd-04b1-49c4-98bc-7f3d20c23eea",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            },
                                            {
                                                "example_id": "6945fd09-d457-4a74-b6e8-b8288b428ed3",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "Im Gefängnis als Aufseher zu arbeiten, ist keine leichte Aufgabe."
                                            },
                                            {
                                                "example_id": "67cb0b89-3d67-4fa1-bf77-abbe83d51740",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Die Aufseher haben uns auch gesagt, wir sollen schreiben, dass wir zum Arbeiten noch weiter fahren würden.“"
                                            },
                                            {
                                                "example_id": "49a4d8d6-a14e-4599-9ab9-44b20b4f18b0",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Ich folgte dem Aufseher über zwei kahle Steintreppen und einen langen, weiß gekalkten Gang, vorbei an langen Reihen schwerer Türen mit kleinen, vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "a1d1f9de-8d17-4479-8941-bb3e33402bfe",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Sie strickte ihm auch einen weißwollenen Schwanzwärmer mit roter Spitze, aber er versteckte ihn vor den andern Burschen der Kolonne, weil er Angst hatte, die Aufseher könnten es entdecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
