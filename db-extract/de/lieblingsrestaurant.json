                                "example_id": "a158277f-6174-4bc4-8663-ca779b8d30fb",
                                "sense_id": "85a67490-1e75-35d9-acc5-9a4478e19b82",
                                "text": "„Nachdem er ein paar Stunden geschlafen hatte, aß er noch ein Kebab in seinem Lieblingsrestaurant, bevor er am frühen Abend weiter zur Botschaft fuhr.“"
                            },
                            {
                                "example_id": "11f2b4c5-cedb-47b7-925c-655e2cb71df9",
                                "sense_id": "85a67490-1e75-35d9-acc5-9a4478e19b82",
                                "text": "„Sie gingen in sein Lieblingsrestaurant, das ›Bizerca‹, wo er, der kleine SAPD-Kaptein, Austern bestellte, in dem Wissen, dass er aus dem unendlichen Jammertal heraus war.“"
                            }
                        ],
