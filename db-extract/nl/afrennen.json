                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e050d787-c46d-3cb6-94e6-64f104383936",
                        "entry_id": "f5bb208f-caf9-3690-a62b-be5fe5fcb03b",
                        "glosses": [
