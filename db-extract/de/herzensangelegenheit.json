                "senses": [
                    {
                        "sense_id": "7162a66a-c1cf-39c2-aff2-d512a67d82cb",
                        "entry_id": "9af6f69f-7ed9-3449-b61c-d05f113cd819",
                        "glosses": [
                            "Wunsch, dessen Erfüllung jemandem besonders am Herzen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae5f556-826a-42db-adac-03f2b05be6fc",
                                "sense_id": "7162a66a-c1cf-39c2-aff2-d512a67d82cb",
                                "text": "„Für Lady Belinda ist es Beruf und Herzensangelegenheit zugleich, Ehen zu stiften.“"
                            },
                            {
                                "example_id": "61ab111d-38b8-4acd-ba0d-eb624e0d9802",
                                "sense_id": "7162a66a-c1cf-39c2-aff2-d512a67d82cb",
                                "text": "„So war es ihm eine Herzensangelegenheit, diese Tiere aus seiner Liebe heraus, auf die saftige Weise zu führen.“"
                            },
                            {
                                "example_id": "2070a6c6-2003-4c39-9daf-fe351dc394ba",
                                "sense_id": "7162a66a-c1cf-39c2-aff2-d512a67d82cb",
                                "text": "„Der in Herzensangelegenheiten nicht eben glückliche Busch – Johanna Keßler stand ihm damals noch in ihrer Unerreichbarkeit schmerzlich vor der Seele – versteckte sich gern hinter dem betont schnodderigen Tonfall einer scheinbaren Distanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
