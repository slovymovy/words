                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение слова или фразы путем пропуска букв."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "выпадение букв или звуков в слове"
                            },
                            {
                                "target_lang_word": "выпадение",
                                "target_lang_sense_clarification": "исчезновение звука или буквы при произношении или написании"
                            },
                            {
                                "target_lang_word": "элизия",
                                "target_lang_sense_clarification": "лингвистический термин для отсечения звука"
                            }
                        ]
                    }
                }
            ]
        }
    ]
