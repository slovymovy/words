                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fce97347-7d88-3201-a0b6-c74cc7d7a44a",
                                        "entry_id": "a28280d5-fabb-3d49-80e6-8a3894aaacd7",
                                        "glosses": [
                                            "das Zarentum betreffend, zum Zarismus gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebe34e3-13e5-4a2c-aad8-c343ebb1ab97",
                                                "sense_id": "fce97347-7d88-3201-a0b6-c74cc7d7a44a",
                                                "text": "Der revolutionäre Prozess, der im Frühjahr 1917 den zaristischen Despotismus hinweggefegt hatte, mündete im Herbst in eine Entfesselung staatlicher Gewalt ungeahnten Ausmaßes."
                                            },
                                            {
                                                "example_id": "5142f429-fec8-4a24-80d3-880bfed1a653",
                                                "sense_id": "fce97347-7d88-3201-a0b6-c74cc7d7a44a",
                                                "text": "Denn lange bevor die weltbekannte Dynastie im Jahr 1613 mit Michail III. erstmals den russischen Thron bestieg, hatte es zaristische Macht bereits in Bulgarien (ab dem 10. Jahrhundert) und Serbien (14. Jahrhundert) gegeben."
                                            },
                                            {
                                                "example_id": "dc1e7fbf-ec0c-43b9-8a96-d54972e2c0bb",
                                                "sense_id": "fce97347-7d88-3201-a0b6-c74cc7d7a44a",
                                                "text": "Er wurde erst 1859 von der zaristischen Armee niedergekämpft und dem Russischen Reich einverleibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
