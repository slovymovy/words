                        "form": "die Neuner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d137d5c-ce8b-3f1f-a634-aa643add4e5f",
                        "entry_id": "8d12a536-a5e5-338b-a056-aed3c2d02a9d",
                        "glosses": [
                            "etwas mit der Nummer 9"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "72cac7d7-48fa-4f30-a645-32b047e41658",
                                "sense_id": "3d137d5c-ce8b-3f1f-a634-aa643add4e5f",
                                "text": "Fährt der Neuner zum Bahnhof?"
                            },
                            {
                                "example_id": "8a701b0f-a85a-444f-8888-3d1c93e40c51",
                                "sense_id": "3d137d5c-ce8b-3f1f-a634-aa643add4e5f",
                                "text": "Der Neuner sticht den Achter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "661eabf9-d395-378b-a63c-34b1e4808ef2",
                        "entry_id": "8d12a536-a5e5-338b-a056-aed3c2d02a9d",
                        "glosses": [
                            "die Zahl 9"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "08665d95-01da-43a2-8801-e29036be9ba2",
                                "sense_id": "661eabf9-d395-378b-a63c-34b1e4808ef2",
                                "text": "Hier steht ein Neuner drauf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "53274b7f-f7bb-31c3-89bc-5d699e7b5bec",
                        "entry_id": "8d12a536-a5e5-338b-a056-aed3c2d02a9d",
                        "glosses": [
                            "Spielkarte mit neun Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40cd8550-a12e-4858-9fa3-05456f70becf",
                                "sense_id": "53274b7f-f7bb-31c3-89bc-5d699e7b5bec",
                                "text": "„Der Zehner sticht den Neuner, Achter, Siebener.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "1530a3b2-8e89-3003-8b08-120f330479f5",
                        "entry_id": "8d12a536-a5e5-338b-a056-aed3c2d02a9d",
                        "glosses": [
                            "jemand, der im neunten Jahr eines Jahrhunderts geboren wurde"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                        "entry_id": "8d12a536-a5e5-338b-a056-aed3c2d02a9d",
                        "glosses": [
                            "Fußballspieler, der in zentraler Position im Sturm spielt (welcher früher und auch heute oft die Nummer 9 auf dem Trikot trug)"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "e5fcab53-2cce-4c77-bbcf-1a5af08f5a4e",
                                "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                                "text": "Hauptaufgabe des Neuners ist es, Tore zu schießen."
                            },
                            {
                                "example_id": "00f66e43-6a04-4e8b-86f1-bf9c1be2cead",
                                "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                                "text": "Berühmte Neuner waren/sind die Brasilianer Pele und Ronaldo, der Ungar Ferenc Puskas, die Deutschen Gerd Müller und Miroslaw Klose, der Franzose Thierry Henry oder der Pole Robert Lewandowski."
                            },
                            {
                                "example_id": "fcc5afed-a68a-4302-884a-f222f8f367d5",
                                "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                                "text": "Der klassische Neuner verwertet Flanken und muss dabei sehr zweikampfstark sein."
                            },
                            {
                                "example_id": "6e03b0cd-1507-4028-8324-3fe50d94bfe1",
                                "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                                "text": "„»Wir müssen in der Ausbildung besser werden. Wir reden seit Jahren über Neuner, die wir brauchen und auch über spielstarke Außenverteidiger«, kritisierte Flick nach dem Spiel gegen Costa Rica.“"
                            },
                            {
                                "example_id": "73b2be36-cff9-4116-b2c9-226ccd101b5c",
                                "sense_id": "4d4ef80e-f5ae-3af7-a067-9b169d285a3f",
                                "text": "[Mario Gomez:] „»Es hat angefangen - natürlich aufgrund meines Vornamens - mit Super-Mario. Dann folgten Torrero, Chancentod, Stolperer, Weltklassestürmer, richtiger Neuner, Strafraumstürmer, Tanker (lacht). All das war ich bestimmt schon mal. Das bin alles ich.«“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
