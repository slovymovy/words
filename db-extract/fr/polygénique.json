                "forms": [
                    {
                        "form_id": "190dc84d-1908-4386-a5a9-8aea3a815631",
                        "entry_id": "fee6d6f9-d10c-3c52-bdd9-e898da5b3ff0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "polygéniques"
