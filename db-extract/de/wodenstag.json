                                        "glosses": [
                                            "een dag van de week die na dinsdag en voor donderdag komt"
                                        ],
                                        "tags": [
                                            "tijdrekening"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7719307a-268a-47b1-bfa3-a679890c6ee6",
                                                "sense_id": "7d05f196-a211-3b0e-9b77-dedc207a4acf",
                                                "text": "Op woensdag hebben leerlingen slechts een halve dag school."
                                            },
                                            {
                                                "example_id": "95f3793a-5b3a-4fab-ba94-35d10615362c",
                                                "sense_id": "7d05f196-a211-3b0e-9b77-dedc207a4acf",
                                                "text": "Op woensdag was ze er nog niet, maar Pamela en ik hadden het zo druk met de voorbereidingen voor de opening van de tentoonstelling dat ik geen tijd had om bij haar langs te gaan."
                                            },
                                            {
                                                "example_id": "135ccf49-ade9-44ce-83bc-0ed76dbe532f",
                                                "sense_id": "7d05f196-a211-3b0e-9b77-dedc207a4acf",
                                                "text": "Burgemeester Ron König zegt \"buitengewoon trots\" te zijn op het team. \"Go Ahead Eagles heeft echt voetbal laten zien zoals het hoort te zijn\", vindt hij. \"Heel Deventer is uitzinnig van blijdschap en terecht! We gaan woensdag het elftal groots onthalen en huldigen.\""
                                            }
                                        ]
