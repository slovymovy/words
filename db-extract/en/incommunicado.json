    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6b90a3f-4933-3255-bca1-1b3f8bac91db",
                "word": "incommunicado",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00516f05-bb39-3573-9f76-42b0bdc5b716",
                        "entry_id": "f6b90a3f-4933-3255-bca1-1b3f8bac91db",
                        "glosses": [
                            "In a state or condition of inability or unwillingness to communicate."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02b08ef2-fe01-4f34-92b4-5ba11bd88e2d",
                                "sense_id": "00516f05-bb39-3573-9f76-42b0bdc5b716",
                                "text": "The father of a woman living in the incommunicado world of the Big Brother house in Australia has died but his daughter has not been told."
                            },
                            {
                                "example_id": "7cd553b2-590c-40e3-adaa-8bce8ec45a8f",
                                "sense_id": "00516f05-bb39-3573-9f76-42b0bdc5b716",
                                "text": "As the storm, described by the National Hurricane Center as “potentially catastrophic,” moved toward the Virgin Islands and Puerto Rico on Tuesday, little could be learned about the conditions on Dominica. By early Tuesday morning, phone and internet signals on Dominica appeared to be down, leaving the island virtually incommunicado."
                            },
                            {
                                "example_id": "b4de7af4-875f-4da4-aedc-f93cbf7189c9",
                                "sense_id": "00516f05-bb39-3573-9f76-42b0bdc5b716",
                                "text": "Navalny, who has been sentenced to nearly three decades in prison, disappeared from a prison in the Vladimir region near Moscow last week, and was suspected to have been transferred into a “special regime” colony, where he could be held incommunicado under Russia’s harshest prison regime for years."
                            },
                            {
                                "example_id": "1a65fa6c-d129-4077-b42f-c98d9563fb3f",
                                "sense_id": "00516f05-bb39-3573-9f76-42b0bdc5b716",
                                "text": "He is believed to be holed up, incommunicado, for the fear of being assassinated by Israel. Even top government officials apparently have had no contact with him."
                            }
                        ]
                    }
                ],
