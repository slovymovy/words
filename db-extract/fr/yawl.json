                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9738447c-7cd8-4e23-8750-ab28dbfe1e38",
                        "entry_id": "da022a17-9a7f-37ee-bb09-49cf4ff0bf6b",
                        "tags": [
