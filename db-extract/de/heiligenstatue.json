                "senses": [
                    {
                        "sense_id": "7a0bf6a6-7525-353a-999b-b5ebfa49fa37",
                        "entry_id": "f5a2b93c-577d-38ca-8cd3-bc85d7d57d31",
                        "glosses": [
                            "Skulptur einer heiligen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf613d5-0cec-41d1-9d56-66e133bfefb1",
                                "sense_id": "7a0bf6a6-7525-353a-999b-b5ebfa49fa37",
                                "text": "„Aber damit man mir später nicht sagen dürfe, über dem Pflaster könne jeder schwimmen und es sei nicht des Erzählens wert, erhob ich mich durch ein Tempo über das Geländer und umkreiste schwimmend jede Heiligenstatue, der ich begegnete.“"
                            },
                            {
                                "example_id": "360b8e34-dbc1-42cf-8604-a2ce80d00430",
                                "sense_id": "7a0bf6a6-7525-353a-999b-b5ebfa49fa37",
                                "text": "„Doch auf dem Balkon blieb alles finster und still, genau wie hier in der sala und dem Raum, der früher ein offener Speisesaal gewesen zu sein schien, bevor DLR ihn zu einer Andachtsstätte für eine bescheuerte Heiligenstatue umfunktioniert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
