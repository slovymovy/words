                        "examples": [
                            {
                                "example_id": "15d22932-4c19-4108-b8dc-9e60debac8c0",
                                "sense_id": "212c833c-b2f9-3eac-894b-8eac723d729a",
                                "text": "On tenta aussi de donner, à l’un seulement, quelque chose dont tous deux avaient envie ; mais tout aussitôt, si c’était chose bonne à manger, ils partageaient ; ou si c’était toute autre amusette ou épelette à leur usage, ils le mettaient en commun, ou se le donnaient et redonnaient l’un à l’autre, sans distinction du tien et du mien."
                            }
                        ]
                    },
