                        "entry_id": "a432000c-b2a6-3ae8-b980-0d808d4ad609",
                        "glosses": [
                            "Médecin spécialisé dans le service d’urgence d’un hôpital."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "4675c340-7588-455e-a6a4-976d523e9fb0",
                                "sense_id": "775f4647-5dd2-3b44-b345-4a6c5365da19",
                                "text": "Ça peut arriver qu’il n'y ait qu’un seul urgentologue disponible mais c’est relativement exceptionnel."
                            },
                            {
                                "example_id": "eda4ff8c-3e6f-4ea6-ada0-c193b18f2237",
                                "sense_id": "775f4647-5dd2-3b44-b345-4a6c5365da19",
                                "text": "L’ex-femme de Guy Turcotte est urgentologue dans le même hôpital où il travaillait."
                            },
                            {
                                "example_id": "b3f6c484-55cc-4c23-936c-581747cc1816",
                                "sense_id": "775f4647-5dd2-3b44-b345-4a6c5365da19",
                                "text": "Hier, l’attaché de presse de M. Couillard a répliqué que son patron connaît bien le réseau et qu’il est prêt à rencontrer les médecins urgentologues pour régler le problème de l’engorgement des urgences."
                            }
                        ]
                    }
